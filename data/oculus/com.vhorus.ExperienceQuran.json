dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gysteL8Gx6QQ7kNvwGOEDjX&_nc_oc=AdqtSzL1qpQC5gblw2y8fgCGDwTKuWRHl2tClkVQcXm69J9gPgfK6yqMlT0mDoG2AMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQj_QO2ebEisdtFJf8ZomqCJi-NNWhtt-dQZl5Jb4_bg&oe=6AD25991"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCyiEUs7xM4Q7kNvwGqMcw6&_nc_oc=AdqD0X79j8kIL7c9EXjnAsTegqV0_Gpd1Gd3I_PBmSnaCJuO_quEViOp8cjHkDfVgBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsBvT66jCzWy5PUizOqId9Gxp68qJgZe9hAcqwCDngRg&oe=6AD22E74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btd_ruTEup4Q7kNvwFXbq_8&_nc_oc=AdrT2zysxUfd4OPZFUq2jHiZgnpA-mpUcxC5mz6epkbngesQVOMKvJjHfHJS3-UDL_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjYm8Ayl6vAxtf69bIBZ2mlRpoPNE8d0j37YOFW3lrKg&oe=6AD22A76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_pUuQcn6wQQ7kNvwFieUNe&_nc_oc=AdpwY7lWKVoJ8T8V-G8SIIZxMwKRcCrH0TxnqcJlazDNj_ehZtlwvZo-UCUc4xx5cUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNja19sR1Y1yXMCsHqUbpCwVyWmnf8YLChHdg7ziAq1jg&oe=6AD22B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf8Kb76NFcgQ7kNvwHvmLFp&_nc_oc=AdqVZkNpWaSYaK_a6Bu7xNdxQlKLClEs0Qc_KFJVdMsWjw22t07olwuV41Q7dQbsv68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXFya52iDxCgDJcWvlmsf1hgcnaPvbqnn-_wmXBCpeiQ&oe=6AD2251D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
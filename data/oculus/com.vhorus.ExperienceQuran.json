dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmZ86WseWs8Q7kNvwF2Dhk2&_nc_oc=AdqgW1gJfRUxkEVLb8N5oPlr_GG_2AIcEyZxZYVgNVmxYz9Jkkm3wsDnbOpT7n-phGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QRQ1lxYXFksZ_f2G1Tt0bG4E3Jom_G6Y2Y9VTpk_-1w&oe=6A0082D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Bao5cV2WmgQ7kNvwFLnojL&_nc_oc=AdraVj2VORz0S7eY2pROuMiu8oqgun1WsjJ0SEQHqfb7M1mbhH1Jg1xelHu_oyFuItM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gTEX6V9mXmALIF3cQB-yKcZmS2uS8r5LGTVtCzk1hDQ&oe=6A008FF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCT_OLYjibYQ7kNvwEne70S&_nc_oc=AdqVByjIkZiS-jNi3Zt7NjgcNTf_owJTJoOSX_DS7ZlIJ5Nu_6_44wnll4OecqnNxbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZysFkBbEcnjIjDZ8vN0MDC59akmv-CTygv7ES9TqHNQ&oe=6A008BF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i12S99nhsfIQ7kNvwH1-Lje&_nc_oc=Adq_DKQ9R_x3dKU_t-E6BFwVWnJIndMBNaNYuVUWKkrbT8hJLLLlw1UviGnHe4qgBn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AFZAm7gx73hXOdBxWBXIjqudkY5Xmj5g6mJ3_W-qS0g&oe=6A008CDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPLwZbuZeBcQ7kNvwH_8FW6&_nc_oc=AdqWtcqAP0XtpgVsXUZGsPm6SniDNh5jjKPOBGcFIMMRgyvJesCmUnZnRsne-h-ZBvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rxnP1nEqoGASi0g5EBsBxAjzFPzPDXz_HcZcktng0zA&oe=6A00869D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
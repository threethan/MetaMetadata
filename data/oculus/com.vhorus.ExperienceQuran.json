dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFp6Rz9LZv4Q7kNvwGgn2jq&_nc_oc=AdrIvqz66jFegOEoZ17DBqzppY3RNkkcAB2AFwv8Az8IGtksnqgfHEln4p7nKAZ7v0A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rYk2bw41qZyKsNn0EZAy0-vJy1_VCQLJ2NpvrhYXibQ&oe=6A0F0351"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uDImorVvVkQ7kNvwFT5ika&_nc_oc=Adrdmf7mqP-rKHvdcfZUIHiyh7k5wan5y4deDlb3wOPEABWLKEcCnMnlcFO3CfQA-mA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jfLXm7FxDhGHTuWFPCjMsvURCm5gCFKbzvG1beNKizw&oe=6A0F1074"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLxXhh4ficYQ7kNvwG8C1Q6&_nc_oc=AdrOKOC_qcWELD8dPslRgqCsHCtPVF97KueP87yYv7CZ9XRlWhHqq_Z6qy4wuw6XOP8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NBRqMFf16TJdb8_FC8B4yrm5p4XINfewxQkNW6cyG9Q&oe=6A0F0C76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54Pcp1XghOkQ7kNvwG-llCl&_nc_oc=Ado5exMSdPuEArkhtOjkTTAV8HLblwbPv6gKEahRew_DKQwiQ_lHNF0f8G97pu_nVQs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H6Few-Slw8OAIe57ljBNmQXeypvytH5DWmc0IoiM1pA&oe=6A0F0D5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1Qtd9Gcp5UQ7kNvwHlxx2n&_nc_oc=AdqNZb1_YLcv97xgZcaYtmpvCnmPd4p9SfBxZg8hBTrXGdkoXsvh6iktbhW71hycM8o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5he_caXIstCwI6p9XBOlv4b4lwXkaHtv9saxS6dkjBJA&oe=6A0F071D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
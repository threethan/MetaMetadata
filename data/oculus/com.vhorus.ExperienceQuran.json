2346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMDZW6wpfRQQ7kNvwFLXQcV&_nc_oc=AdqlCqktxykRzs6FORKlNsLb8IZBgiADpPvbYc_8TSDJDwfiGz-bSwvpAR6xvK6Ii2c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUZGxwKHtNk9OxPChyTF0CceT6QkXTN3z9-TkS_cA6Kg&oe=69C13AD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptF3GvXCCCwQ7kNvwFfVk4f&_nc_oc=AdrZza4Sawko-3o-dW4i8j5p1WUcDgEKqZmFEcUvqXSQX1uP_0EFWCEOSQquWTg-gng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyt9hSFQSAML8L4EgzfypzqjdID-0y2_tNknEjkOtphXg&oe=69C147F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fBHXDVkqUUQ7kNvwERQCaE&_nc_oc=AdrWxuVnVcd-Sj-UvK02tzV8GcGGSdE-kUco12ySlBM3x0Rzd2xHSUd8NofUUmt9Eqo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCS-vKYBNPGmunoXNS2V59NnUqBHvIPOgRq-hCqDMAnA&oe=69C143F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBSkE698SaEQ7kNvwFZYOzq&_nc_oc=AdrocDT74DlSHPf-zRM03qob-doWoWctZEvmyK-8deJmzo8WYRsRakcrFSCMaSQ6YRg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0t-9X79L1qazQI0lQZleSvrSHZ5_tnaq7HIWvgkOb3g&oe=69C144DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEJenN36JPkQ7kNvwERVLMx&_nc_oc=Adq1AH80qwpP1RleJLUHZuz613qsh8djpr-7qfUAXRr01hwd29EQLhpUyVD9sDM0IoM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTA0q2JXxdNnIw0stN_dDEGsXLdyVu_hzJAiVKagCWxA&oe=69C13E9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
0a&_nc_ohc=q8M0I1EWIX8Q7kNvwFBElxy&_nc_oc=AdnIpq80DAxA-rH2FuxRZE6JiMgSOs7ZvBd4XeKFE07MsaLt59ndGuTLWsyAwmMVcic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftvW6c56QEZAgzGoyg7XX08xtVWmVExh65cW8_V4JOhlA&oe=699AFF51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdV4mBZvIlQQ7kNvwE9-6SS&_nc_oc=AdlSObMJdxLS-roGkwE_kvMNXIgix-bxCRfOlHL-DFi5RoALl59DHlCbNtqyF4CAxTI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTar4vx8D2A3dBThnERsVyR1vJfrpDkAriE7-sOfqa1g&oe=699B0C74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuJ7BamQQ_cQ7kNvwH91u67&_nc_oc=AdkItIPLwfE-vEFONWIMeCmDCfezUZLkPBQH7KzKsXFLkLNIIFZog0GDzGEFTQsUFn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvO-qakz12FEaTkatHjpEnCsrCtXSbbg6uFuu64FMPCCw&oe=699B0876"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWq2ZvuOsRUQ7kNvwH69UTM&_nc_oc=AdlhqtdkTzG4ORXGAiUoCCRbhNIJ1hJOryba-s1mdHvcBNCql7uU7j-mTEBjZ_EIdig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfspjHNB8nC3hgQiKxAcUn6_SkZ8kSBMe_tScAp3Zmr6UQ&oe=699B095F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ft4n0pfbl-UQ7kNvwGxJkne&_nc_oc=AdlYtLqypRA2ec2_79oocQ49GBNZL0yCXdbC4bLbsMsrP41EQKipCAlIQoFTq7jjEu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuCQlP5P2uPf6BdppV8ImO2DH8Dlqwkk6SF14eUhPr9Eg&oe=699B031D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
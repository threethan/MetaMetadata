dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6ySHniifeEQ7kNvwEKYlkY&_nc_oc=Adr5VKH-dyAa4koWQWIbslH-zmHdPx6zgSzM3P6rUqj-7Ic0FfowA4EhUkHVDaLNcLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqq5EeCk_GvWOkR-EH-XI-UcmvmZPnxhwKVHRKmCTb7g&oe=6A8C41D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqd4N3PyUpYQ7kNvwFBxnmv&_nc_oc=Ado8OL6sODO4vbT2GJONQjSxzb4_z9zshU-grnL96-yhF_kB3kk-MqE1aHqUMZQssY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEICtJp7bsGx3YuAjrmQ8n-lm9ThNkiwBibpEk8gJ1kfA&oe=6A8C16B4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYENsLcKMI8Q7kNvwF3PbT-&_nc_oc=AdpDoBrcUrsuPtnd2dO9OtPYjLzRimbOI72ZtapWXUJ0B4I5NCKCeDphDDoEREhPXzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWe6w96nkHgsuFEYwJRCun1Fmtvc-wU9n86IDslU9KMQ&oe=6A8C12B6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stjItahrQUUQ7kNvwExjvbC&_nc_oc=AdpIyZ3GKaMZXFLqRvDZ3WmKgqAIiAQs1wK9xrs2Wf8aEYSdh4zIXuGn1ak153TIJJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEio6KfAVB3scSleR1E1yzl4WGNsoUsJ2hSI9HalpxAYg&oe=6A8C139F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwlwicFUPgUQ7kNvwG4R51a&_nc_oc=Adr58QEYW8Ic4M0SooLAj1y4LCX_XiYGLtCoUCXa-G-RChRh64DxCL11NPp9l30nJYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7p8E0BKYD7qyNf6rosMKTEHl90ZqKJDUJoVqhbed2pQ&oe=6A8C459D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
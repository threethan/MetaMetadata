9lqPrO9k-U2yqoETrIgwZW4ZSUyCJ8Rn0WTauBTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWEIlvLy1kkeTdpKmoijvzTHTTm3FgjSXpEvRC0nsG_8w&oe=6B1053CD"}, {"file_name": "Screen4.png", "id": "2324239707932833", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245818_2324239711266166_5891120503920111153_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00mxNjBJZz8Q7kNvwEtERq1&_nc_oc=Adq_-fOcok0r9JRhTNbr1fBmauPVQnjcB_AMk6FXxITBquYfif8mI-aWpnFJe4TpDq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOujSXE-B-h77Q5PH6m5bELA-Hny0N8VHeebObGe8ZPA&oe=6B1058DB"}, {"file_name": "Screen6.png", "id": "1796223534537974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001697_1796223537871307_3260435573851566362_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT4Oc3TH348Q7kNvwFcCX1X&_nc_oc=AdoEKl9o124YMHktI0ysNLde672EyIlZM9voOhqnYOBbWWpD5K3WaXAxhP9YD9lNXHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZW4zdN8uSAOeGO7LMU9qcUUYzpB-M90BhVkahpqnIWw&oe=6B105131"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Florence VR Walk: From Duomo to David X2", "keywords": ["tourist", "travel", "italy", "vrtravel"], "long_description": "Immerse yourself in a relaxing almost 2-hour VR experience exploring Florence like a true tourist, all from the comfort of your own home. Your journey begins at the impressive Duomo di Santa Maria del Fiore, where you\u2019ll be mesmerized by its stunning architecture and the iconic bell tower. From here, stroll over to Piazza del Duomo, where you can admire the surrounding historical buildings, taking in the grandeur of this historic square.\n\nNext, make your way to Piazza della Signoria, the heart of Florence. Here, you\u2019ll be surrounded by the monumental Palazzo Vecchio and the iconic Loggia dei Lanzi, where you can take a moment to relax and observe the lively atmosphere of the square. Take in the lively art and culture while enjoying the timeless charm of this central spot in Florence. Afterward, continue along Via dei Calzaiuoli, heading toward the Arno River, passing the famous Uffizi Gallery, home to Renaissance masterpieces.\n\nNext, cross the legendary Ponte Vecchio, enjoying breathtaking views of the Arno and the surrounding architecture. After exploring the river, retrace your steps back toward the Duomo, experiencing Florence from a fresh perspective. Your journey concludes with a visit to Michelangelo\u2019s David at the Museo Nazionale del Bargello, where you can admire the iconic statue up close from every angle. Enjoy the city\u2019s beauty at your own pace, discovering details that many tourists miss, all while staying comfortably at home.\n\n#travel #tourist #sightseeing #vrtravel #italy", "short_description": "Experience a relaxing almost 2-hour VR stroll through Florence, starting at the Duomo, across Piazza del Duomo, past Palazzo Vecchio and the Loggia dei Lanzi. Walk along the Arno, cross the Ponte Vecchio, and enjoy the warm sunshine. Your journey concludes in front of Michelangelo\u2019s David at the Museo Nazionale del Bargello, where you can admire the masterpiece up close. Relax like a true tourist in the Loggia and enjoy Florence from the comfort of your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Florence-VR-Walk", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_g
111", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "1936533703500639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_1936533706833972_866962653554410659_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ABJxK3EwbIQ7kNvwH3Ajlx&_nc_oc=Adlia5xwkXS-7EKC4kWr8_8xIpWgMdNK5VKUDgovYhupcn5nbbbHH4DQNQhDRooM7SY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1eXD4HVIGrTaDwlPQTBoUJ4a2fWMmyb6i0-pqOfjUbA&oe=69B2ADFB"}, {"file_name": "Screen3.png", "id": "8800160280032000", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_8800160286698666_5905078862887189967_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBnduUPxY5EQ7kNvwFsZo97&_nc_oc=Adkymxeml8kU0jgciX_xTyvs06JVGKz1BK_mIG7wVsqpSoyI78xc0TkdWrhz_a1AKe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxkb-Mnbrf3Ds6OzhBj-SLlUsVhqfUIGpsU_fi6bY5VIA&oe=69B2BB2E"}, {"file_name": "Screen2.png", "id": "1081114946889993", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_1081114953556659_704086076123541358_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEEB334_OYsQ7kNvwEIiagw&_nc_oc=Adl7DW_iP3h9uUFUdOlEO8S0_8p0wlhwjcgqteZGYlqznexflb7AOeWnY2SMI80_Cag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUajCqt04WToo0Vj-YRbhVWmMtS9wvIfWFvvqPJI0uyw&oe=69B2BE0D"}, {"file_name": "Screen4.png", "id": "2324239707932833", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75245818_2324239711266166_5891120503920111153_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8aF7RAsxgEQ7kNvwFuNPGF&_nc_oc=AdnS8ro7BpE0_zY3Ynq66Z891TKCtmE_xQVIGZVM_Wxl2x_o488Y7EvsA25egrncRIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJDHYBQ-E3kQ2SEne3hiIZ5aSIpmLAYt4i_tEcpHhXbw&oe=69B2C31B"}, {"file_name": "Screen6.png", "id": "1796223534537974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001697_1796223537871307_3260435573851566362_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9blXrm6pNAQ7kNvwGfXb7L&_nc_oc=AdmXwJRPEQbaXfupJYNfkOGMg7PJ6QCmwsalxF5fGHpr0NqNLtKlprC38R0Ah5qlt2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzu3uTK6Y_FilgDT9n-Yy9oiY0i4boJ0IswRLmr8SME8Q&oe=69B2BB71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Florence VR Walk: From Duomo to David X2", "keywords": ["tourist", "travel", "italy", "vrtravel"], "long_description": "Immerse yourself in a relaxing almost 2-hour VR experience exploring Florence like a true tourist, all from the comfort of your own home. Your journey begins at the impressive Duomo di Santa Maria del Fiore, where you\u2019ll be mesmerized by its stunning architecture and the iconic bell tower. From here, stroll over to Piazza del Duomo, where you can admire the surrounding historical buildings, taking in the grandeur of this historic square.\n\nNext, make your way to Piazza della Signoria, the heart of Florence. Here, you\u2019ll be surrounded by the monumental Palazzo Vecchio and the iconic Loggia dei Lanzi, where you can take a moment to relax and observe the lively atmosphere of the square. Take in the lively art and culture while enjoying the timeless charm of this central spot in Florence. Afterward, continue along Via dei Calzaiuoli, heading toward the Arno River, passing the famous Uffizi Gallery, home to Renaissance masterpieces.\n\nNext, cross the legendary Ponte Vecchio, enjoying breathtaking views of the Arno and the surrounding architecture. After exploring the river, retrace your steps back toward the Duomo, experiencing Florence from a fresh perspective. Your journey concludes with a visit to Michelangelo\u2019s David at the Museo Nazionale del Bargello, where you can admire the iconic statue up close from every angle. Enjoy the city\u2019s beauty at your own pace, discovering details that many tourists miss, all while staying comfortably at home.\n\n#travel #tourist #sightseeing #vrtravel #italy", "short_description": "Experience a relaxing almost 2-hour VR stroll through Florence, starting at the Duomo, across Piazza del Duomo, past Palazzo Vecchio and the Loggia dei Lanzi. Walk along the Arno, cross the Ponte Vecchio, and enjoy the warm sunshine. Your journey concludes in front of Michelangelo\u2019s David at the Museo Nazionale del Bargello, where you can admire the masterpiece up close. Relax like a true tourist in the Loggia and enjoy Florence from the comfort of your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Florence-VR-Walk", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8762748530475980"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1626215425075896"}, {"status": "PUBLISHED", "id": "890515210342745"}, {"status": "PUBLISHED", "id": "1151073196863364"}, {"status": "PUBLISHED", "id": "1373952070843546"}, {"status": "PUBLISHED", "id": "4344984285741060"}, {"status": "PUBLISHED", "id": "1914868625756359"}, {"status": "PUBLISHED", "id": "1410721179925347"}, {"status": "PUBLISHED", "id": "1707689203293848"}, {"status": "PUBLISHED", "id": "953511823555377"}, {"status": "PUBLISHED", "id": "1278942563145266"}, {"status": "PUBLISHED", "id": "1642540869943105"}]}, "baseline_offer": {"
2516886481", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUi5f6HwaJEQ7kNvwF9bBOI&_nc_oc=AdqKlCZa2hFGRE_kozvSAF0ds6reQVP0p1lWQlH8Om1_Jt12nBcnumYiOz41qxtbvqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YWneFf-ZGVGhhQ2m6JYQ_j0BQ7G_Z6otT3z_V-cGl1Q&oe=6A428184"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxBb-8JMaHEQ7kNvwFmhx8T&_nc_oc=Adq7rS-9-juA4SNpHJNDtwrwmNU_A8WdhC8VBzoxeKLFgdct-x2x9mxU5BiCeIh-rvg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XHsKpy5WuFTUlH_kP0r8An3Cfd_hDlbOUrbiFH95b2g&oe=6A42611E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fJBtbAd3mMQ7kNvwGag-kd&_nc_oc=Adr9LE91xmQQ3C1hx12HWZhfGqUc-0V6NtR8c7M2YXI3Z42GvehgGVgcAdTFvWzfi6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ps8DO3iCxV6vF892jct7bC_ZV25PMdWfkqSriAOApOw&oe=6A4288DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iciF5fd3KPoQ7kNvwEkt0j3&_nc_oc=AdoXTMZMwK8KVZctw0BCG3YOvsJVyVy-2UVJMfsAT7B6J_kauidjZyK9mUjawsdJ6zQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fL69h5RCTp2zWK2nPfxpEFRyzNuI1N8kfDxVxyTfeIg&oe=6A427B29"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
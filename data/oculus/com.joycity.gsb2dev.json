2516886481", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRVc6T6QRZQQ7kNvwG1TE8-&_nc_oc=AdpOnzP8RziaDsvbWi8_4al-FS_glNP06Nur8wmefA48SRlqqVP23EsvP9RVrnTsdwc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YNUrP-kNL7ki5wks33NSvbdREbT3t-QaI5Lle4U0vvw&oe=6A300C84"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSqQ2mjq-uQQ7kNvwHKWTE6&_nc_oc=AdptwQFnU4TgueNiIoxZb9Bz72Tzkl5O6Br41IkhLT3bEXqp-QHdStW6QQvUExgUd2c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96-zxen5bI563s8tsQv3VDf2FnP01drY_Jo5K3JEDK1Q&oe=6A30245E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRkDLbXO4ecQ7kNvwHk_0fN&_nc_oc=AdpTeN7y7go-KTs3uB8UaJrvnxsa11E4nAZw-GP2HzMAAGfHHlCFt5pkYPRxEA9i2Wg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yN8BLWAX-F1Nqs2v1aGkOm7JhDxUSnHWO69JTuB7wEw&oe=6A3013DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh8AZ_Y8PQwQ7kNvwFAVNvw&_nc_oc=Adoo3SamOfxH8Tgk_yb38E5wsDYfwlqUiGIyquBhI56l6WNJX7yf382I03UG3_PfeQ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6LBxrFuV24rxu_inowXZIQEd41snS6ZF8pp41F2iZTA&oe=6A300629"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
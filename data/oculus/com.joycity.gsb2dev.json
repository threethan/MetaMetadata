2516886481", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsegG-3bJagQ7kNvwEk1oNt&_nc_oc=AdpkSqbOsorETuRKtgzUNfCMg2p8H4kvRcRvV0RutoN5l7P29yKwQSgFC7Vcl64S8ms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMU_zMD-0hdnm8j5oMrhhGc1zJV7WaKJioeE2kk0Easg&oe=6ABA7A04"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC1OQ9rUxB8Q7kNvwHCu1s1&_nc_oc=AdpD33zxKv0NTKlApcPv97eZIQ1gbeZi69MrUsHRe3ZTP2_Fa5Etl2TN5Zxmg3y84NQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuquPliYTSQOCSgpkGbZlJzEzikKUksawZnodqW4MSDw&oe=6ABA599E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5eXOUsI6t0Q7kNvwGDn4Og&_nc_oc=AdpZcSITdxQ2tIkno5i3DZWAy65T8fDHrpyUq6QwE1ug5mQIcQ8bNJi82Mfm7xVsKCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEQcGwe40uCT_JebvH049p6JmgNw1ziubGUozvhg3elg&oe=6ABA815C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjJqwCkJZJ8Q7kNvwEb1jrx&_nc_oc=Adq9IGSDxttfKdoNPQKLMsLC1zhFbuVAJ3LI-LSO_FLXimhLW3z7CAgOhWUuYLDlIqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtY8wBYNnJpLJE2JPC3bvK4C8r8JIKGFbC4KrN8sgu3g&oe=6ABA73A9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
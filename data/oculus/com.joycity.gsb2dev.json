 forward to experience epic real-time story scenes and enriched story.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "460191438938762"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1115391635285155"}, {"status": "PUBLISHED", "id": "136916676936651"}, {"status": "PUBLISHED", "id": "194963397880549"}, {"status": "PUBLISHED", "id": "239668839779711"}, {"status": "PUBLISHED", "id": "2338596406226392"}, {"status": "PUBLISHED", "id": "1897200823880942"}, {"status": "PUBLISHED", "id": "1911906019056482"}, {"status": "PUBLISHED", "id": "1826961704279058"}]}, "baseline_offer": {"id": "239668839779711"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1539068400, "status": "PUBLISHED", "id": "1115391635285155"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1100116090115959", "version": "1.2"}, "id": "118271471968672", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "97885
2516886481", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mIiAHysvp0Q7kNvwGPzTeS&_nc_oc=AdqR422JmgtFPnM1qpe0Ahat1wgmf0ZI8r2j9InHI9cfxkulOlghK0GpjQBY21HNGNw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlmvCyhlNwchi2Ts-YjzCHl-yg_NPTe1rIaBray87bvg&oe=6AE0B584"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSZsXCBd7pQQ7kNvwHUXJHB&_nc_oc=AdquQb6cNo8m4yVuUglbe6Q3m7FbcYavrFICefcBac7tEAk2sMbF8U6uTt3CXjDz_mA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEPb5hXttkIqwyL-Rq_9GufHmvwufETPh3oCJzD8-U2Q&oe=6AE0951E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZKgwS_c0DwQ7kNvwGmwvwr&_nc_oc=AdpB177LrtyO_wUfkp6kekaZc55A8tyVE0vFWgDt-iljXpyJuvFdc8IyHNZ11DjWIl8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI3q00T0ePj5cK6iiJaIckT3g_B6J3Ai1fDF-a1Gjtsg&oe=6AE0BCDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gix6SRJ6VWAQ7kNvwEKmfFX&_nc_oc=AdpRkVdGxk03olu9xZEHYGCS00esyEb01qMQaW6k9wctVwWYhEXHzHnOk6DMWiNJEqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjWcqrYUQSoLa-EoGn5gYoStJhjSR9rXhVRJt32qgClw&oe=6AE0AF29"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
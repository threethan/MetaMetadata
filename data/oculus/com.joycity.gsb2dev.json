t-iad3-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg6WAbUKf8MQ7kNvwGfke4b&_nc_oc=AdmeVmHywoauOLVYCGUgqsLKkrPwCbH-fYmLLGPT4mNOsfyXN5h-SfjxHsYz4WhbkrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkHhHLtQsJI_ip--4WOjy7meR3ogslieTb2qyB3xCV3Q&oe=69BFFD04"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLHS2qWjxW0Q7kNvwF01N2W&_nc_oc=AdnXSV6QhLN3DtWDePN3UF-kZgJrT3p-26v-kwZWwmcRdvtNi-_knY0TGGlpT3UNviA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFO_QGwrEsIYsZyqKnWds9-vVtG7AqffKLdNwBWrYbYw&oe=69BFDC9E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2KZzJHAxBAQ7kNvwFIR9jQ&_nc_oc=AdkNWPxuY1N9JFRAdTmt3GEUTce6ERzUqMW5Opsj1zMJUXZphd3FkAZccv0l2HNmWOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsTAdj5_UlQ2bcvK1Imr_ihiD2MuZpgYrP03oo-OYvHQ&oe=69BFCC1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j295_K1sY1UQ7kNvwGhIT9m&_nc_oc=AdkO25uJsRMae5_UfNz1mmuSB_ENu15vTi6_YleSflow0YLxS73_Eyz8SEUZ7gpTmM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxstYQ0BCNtGtvzv1DFqrTykhbFSbmCGYzkZm0fbmJhqA&oe=69BFF6A9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recomm
2516886481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL9R-BE2SysQ7kNvwFj6cv7&_nc_oc=AdpPqDVjD5mHcI6qRT-MzyH3b7Ae6WmvSj_SdSkgRP9ztlpEEJtqdZM1FGgf5oJAVK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymD2QW_iw6pG8dwOyoQUjz-TcvUew6LW5shkg1SraGrQ&oe=69C2A004"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQRG7Hk7sdcQ7kNvwGxTbNj&_nc_oc=AdqahCzFTBrhEipdZ0TzJUOgq2DmSpglx0NaGdE1mUdXOUOaZzFzduJu6BIQPj2V5v8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyN4CXuxvzB7leGnZDxlixu5Yfxg8ZfGtgXcVs-2G294g&oe=69C27F9E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2KZzJHAxBAQ7kNvwHaMi0n&_nc_oc=Adp40ik4JKMLLy3VODvcfWJ3KRB7dTQyutzCwkbIzS8_VT-bhKZKQjeyudVlFt73Gt8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7cuBkEUPifOyd41bRk__E6Oes_7U6TrV9YuiMHf6ukQ&oe=69C26F1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIqvZO3ldyAQ7kNvwEwH7tK&_nc_oc=AdpdEXuMDe6fjysmzTlxT2LFNMIffJR4tgdD83QScRcuchkEEIBgwB8N4PZ-0IiqfOQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhxuH8pZ-TQiHcCysJAmWihOJrVcnCnAoODLsrgKj9mA&oe=69C299A9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
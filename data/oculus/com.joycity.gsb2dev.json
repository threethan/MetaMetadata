2516886481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X3cdMIEZXcQ7kNvwFJEw5n&_nc_oc=AdqMR4yXNdnDPF_UVPES53xYj2MfLMYsoOYUlreZ8xQVmzpBR675LVbUsMO3FNVXEVo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BWu500rxe1oFZLWLIsTyP9b1zzZa-7eSQrK6L-25Qrw&oe=6A19A304"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FZtXedBNvUQ7kNvwGrSbux&_nc_oc=Adq5YHLCYsf8YDAyuJDkNy2AptMReiwctmE-ZCs23b7T4GRh-V7zPwTDsLdnR2LguE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AhOv2jI8Y5dil1yya8slDo9MaumvulDHb8lnDpr5c6g&oe=6A19BADE"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epECj3ngx8IQ7kNvwH_tiRv&_nc_oc=AdoUr9g838FEBX5yqykaLck6ydkw7VdygqrB9e-Nj3oHCJXpXKHyxl6bPXxLCsy3z4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hsj9-Z2sihyhpS9huslIRtCRZIlBcU9gKFo2z_5uk3w&oe=6A19AA5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCVtSGebSBUQ7kNvwEvPlbJ&_nc_oc=AdrT5jXwvhkRiZhgEDOqgfD7EGeQEVtjEWw4F-bxsQ9F1f8Es0NPagDRtsU0L9gMrvk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k8YaKjyLq1VkKCMaI_9JV0ti9d-DitwJdURZGAxukqA&oe=6A199CA9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
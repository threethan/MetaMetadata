2516886481", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz8Sv9IFQPUQ7kNvwF060bV&_nc_oc=AdrNEATpYCfnk3MXj3YwgRnyZbVlNzDn3UCB2MX-K8ZW7aOp82xmSf5-MwbSEyqtSVg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNRlCmZChKoilrcY2rlHCIrBuMiglK7EmPCvnovCPj-Q&oe=6A749A84"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wl7_8P4Ju2MQ7kNvwHHGskU&_nc_oc=AdoNp_7tU9cQG0NIXyM61TjnDOeYpiINQ0FnIzffzAAewVyBWsH9qDdpYtdW1l2GG48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhLwUU1H1L7Xq_ol8jkxT6gAayG9buUIXfcHLoNKqRVQ&oe=6A747A1E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxJhs-F-ujIQ7kNvwEjySMT&_nc_oc=AdpQokoeGHuspiNUGIGsWYuu_Wpnc-f8bpzSHB3asvZjF-pyFA35HaSJHrploMnpsFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvQEjcmSlMhYU2TD13bPVObLcsy4O_ac8ohSMSI0GqLA&oe=6A74A1DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tIiWH2QVf0Q7kNvwHQu7TJ&_nc_oc=AdrRjThuImTexvgQBJfOHLuRKxYhFU_w_dlBidm_azuuRiURzgyi7Li63ApVh8WP_R0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF57ANI3tXbWTJQP0Tx9R7LwXaV7zR5AKWBsecyz-ctLA&oe=6A749429"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
2516886481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GoXfcnLLzYQ7kNvwHo7VOX&_nc_oc=Adq4LHDdwxJIYOs9msNFtDdpXnMD8XwnKGX0IIsDgFYQWCOEG2xjdBt8r3SUpa_aTy8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73xkgrlDcHe1_8YfQg8lZVUBwmxvqvPeICnL-aIT5G_g&oe=6A145D04"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xjln-ESteCUQ7kNvwEOfgPt&_nc_oc=AdrHYF-2FuWQLYaPgTmPY2DHTWBTQ8Qx4o9Pz5WJ3NT3RBA8gFEyZeb8Fo4IN7iRGcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a2HewDyDXe8LaISMRzxMflKh3fh-rBUTYNjiu3h9QGA&oe=6A1474DE"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WmQ0x2UK0wQ7kNvwEHpJlB&_nc_oc=AdqcnqkkB9nq2SV0KyCTwkI0qT39REoRiJbiukW_anIG_MALSa-pL4ddizDK5yTi3B4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T-WA5w-30XcDRSVJ9qqGCfbZ6_OKheS961RksxaajaA&oe=6A14645C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZtUIboY588Q7kNvwEbt8NP&_nc_oc=Adp2oniWgpDMjC3FSvf7vlkLvK0U5csARj7B5pud6oi2lgOzc1iOiqsUponAigIOb9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73YjJpN9xmKPEjkfkJvhS4UiOYvwQDh7AqnU5UcOugNA&oe=6A1456A9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
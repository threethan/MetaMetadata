2516886481", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YZBkrzqmhMQ7kNvwET4wtC&_nc_oc=Adp_z2XkOig-VctBLpfwJilOUwoUCMZeCW-NoEJsAnqagwj0gVpcDJsfWIZXEk8CxeE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWiTrkE5fcJ5cZUzBI-Y3SFFMPDed0R49FqARp0hDjww&oe=6A5A3C84"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwLeK4zj0qYQ7kNvwEPSUgJ&_nc_oc=Adq3F9aW1btroau7ilXDMTTGLUBOz93P_lzpptKiDx39PFEhz-kbXvfgNacFmFX8e7c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7IiRHMuxDwIzF9ZAqk_7bXguoUsjbG4vCviuJdZUMWw&oe=6A5A1C1E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-DSpkWCoRQQ7kNvwFMQtfw&_nc_oc=AdoWyooT74BZUVtuauRCCtrTZRYXDxXX45EYHPxzqFG3cbs7vlDiDVvXGlUEvsn3Vfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRxFJOHAS6Vfe3_r4cp--wG5Y7BbFN5YwGeWIpO4b75w&oe=6A5A43DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0ncgmWgoUgQ7kNvwFEJgxx&_nc_oc=AdoKzG3DiQL03LnE9EsGDa3OmTjwulu_3lhIvu0j44wS_7SZKtcFPzp1WF17TB_cW-E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRUGBGdn5g-95Nc7MWEPdRwJbtUhyDAXgTKbQRrvPu5g&oe=6A5A3629"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
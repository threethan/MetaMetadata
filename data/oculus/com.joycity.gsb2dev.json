2516886481", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQbwKKteP3UQ7kNvwHbNy-_&_nc_oc=AdrSBYcScsUYxM2QNM9fJ6w2nAgPvCdqhRT0yMD4QOYXnMPgePYLwym12-49C0kPJ-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdKO6yhqtQP_XE9VUnFkd01ALtkWAetMgszCb5hUK_xw&oe=6AEC9304"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlpEb2JQOtkQ7kNvwHA9xov&_nc_oc=AdoicDJij1aOtYksjTGgeDayvFbnX0QAYqpIkpdw6CKGmA3En9YimGjK0TxLVJtiNJk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvAq7BR9leubMkbsPyU6u9WlxR8mU5F0j3AptlZiiXbQ&oe=6AECAADE"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnqyqmSyg5UQ7kNvwF5WxBk&_nc_oc=AdpD6FJI4xZyh1rlpxWpCjzmBIhmBfrVvqrpG9MBkNi0e1Bq-7-_jAs07efj2sMtLeY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdW689DDFVMAs9-WgLaOWQz9Zmt5iF0N9BZnW2nRpmMA&oe=6AEC9A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd4Q5o0b37gQ7kNvwH0SM09&_nc_oc=AdqW2K6NUnaxtmPxl-zckMN5Fu_eWnciU_Co-3SjFWPZ51ShMBe3J5Ca3J37PeP5V8I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl17VggxlptZ4Enf0eeMx1-CrXGeWIHtZTaf7wwES7KA&oe=6AEC8CA9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
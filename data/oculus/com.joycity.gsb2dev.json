t-ams2-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOsltaSrwtQQ7kNvwEzhPWQ&_nc_oc=AdmEmSggDYDotsVW3bf0KU9uNW3b9yPRYwzqf-YkTgGftDEucGaRW3zxbNInMJ19U18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuHfzYOoGjk5a7vEcDq53LLBeytbh9lKbqYSjBUHvIYA&oe=69AED984"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X318fLqYiIQ7kNvwFJ1r-v&_nc_oc=Adn5RN7xmjmXU8qCMPy0jtd8SMgukHoUAfgSVvTHOv76pnFydKvHvRpMEPvKUD_qWL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNjFYrLp0SEge7w4ILo6VU9hhZm6Xp3AmeHz0kr5-kBg&oe=69AEB91E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejcguIah7xgQ7kNvwEdjUv6&_nc_oc=AdmP_Ll0eJy5F4e5ooPbMpwlki7YWnILTrwKWXE4rd1YZ3ALqndwI8e8gyabsHWA9kA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4-Enl_pt1rFa4qg9TbC3i3WyMbLBFCPucqg1bFeJp5A&oe=69AEA89C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTcrSYVXUbQQ7kNvwENcLah&_nc_oc=AdmzPOifZcIRVz-3XwRAF9enN3VeD9Xpg7w4_l63l8IiuQlR5LLF6h8e8YK0T4lI-JY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzwkv9hk3lbwueKFNEBZwODTbveQlIh5aEo0aDerimjMw&oe=69AED329"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recomm
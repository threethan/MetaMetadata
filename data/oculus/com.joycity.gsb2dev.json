2516886481", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_z2uJf1MTEQ7kNvwHLysg6&_nc_oc=Adr3rXbKnTFLqkL_XjfJB4n2JroKK_L5CgWVn031q4aecWCKfQOVTJRYpmvu0PVcP-g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KzaM76W15U80PYtP1s7aenkc8wisa6ouQmpThZ285VA&oe=69F36784"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLC2XJJa5z4Q7kNvwGQvrRa&_nc_oc=Adp20jVU-gLabs9I0BYRlIoG_FoQiNAVa36MHN_yCsk805Oy-sL503usVFkH2rBvdjM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jdl4YH2bflAy12dDVjVkuQWTtftBoMLK-uK87OIU84A&oe=69F3471E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1kJsrTsRPEQ7kNvwEXv5Kv&_nc_oc=Adpn-4xiScyMoXjm-mVeaBeojC-bFWqMw-tsv_0sqZlcErV5E6A-haByadoVPvEO2-U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27WndOmLYHo0IILuUcJunzO6vtjXNr4kMHDhEYF3GKSA&oe=69F36EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEXlgE2ZmDEQ7kNvwEAUP3b&_nc_oc=Adpyan1nTkZbHNkbDHVA08uRpB-mDL1TRhmPBMqdx7UiW3kJkQN81AI5l5T7ByPkqAc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JxfFos4S3RpHEPBotDIzEH0xCmhmodvjof8vBxokvgA&oe=69F36129"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
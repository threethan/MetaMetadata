2516886481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYgFg28iVHAQ7kNvwHqBwgn&_nc_oc=AdocAFffDqhpNBuS7GG1XIr6xqLO8bC36DmuxdK4ikCdX93D1__xuRVCPMSSBsNxcbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4uGqb2BATEPsJfqVjgVtn64jsS6sk3qBKcYZq4njgtw&oe=6AEF3604"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwzmps-5Dh4Q7kNvwH5Vtwe&_nc_oc=AdousYH5TmOO263DPDxN-yZiZ_AE1znTT4z_Xm-eA-L82PdJneU-Tkk_Q6KZZLedbko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd30bwEr1vlqO64s-fg88ShjFBx2qOqHVdtjttJJoTEA&oe=6AEF4DDE"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnqyqmSyg5UQ7kNvwGx8lwY&_nc_oc=AdqAL3iIncq-3BA3ti1MKH_2pe3qNR8v3M5xGk1-YatjeeL1Ai_rZpJ1u716kaVvUKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWRgzbzxMN9RtJhgS8lf9q3Pwe-JY8XkBqEVPa3Iuexg&oe=6AEF3D5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VT-PkbIJWEQ7kNvwFNWuI2&_nc_oc=Adoi-6RGAG7nm94vnwMrXtm1gQ8eMeN64ukD9DUUXeNWTNUaQJvbX6v6NmcPleUvA-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl8WFfgBH6r3DXBin6WHKWs9-X9lj85tIzzH0CtxAJrg&oe=6AEF67E9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
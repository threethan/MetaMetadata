t-ams2-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOsltaSrwtQQ7kNvwH7RQgH&_nc_oc=AdnyvAYbpuw1iR-UfAS7R7_m_G_SCreQFtG4Z0FdYGEkMwoyTkpx-8DzMMHyFt9QyRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUJxjuBPN-BIAtYDYR7q6ElORwAsH3vuEj7Z2wJdR2Og&oe=69B02B04"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X318fLqYiIQ7kNvwH1GIsQ&_nc_oc=AdlcZCfN-BHlfJRzfo9sxYLpYcUg3tXjonsnHlanGnjsua8C5SrxDr-S-bi6NcrR1AU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfypnbpfFNLjBUDJ39I1JWfIarIzHtw1RYQf6p8vhds_gg&oe=69B00A9E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVPu4VHcl7EQ7kNvwFvv_Ok&_nc_oc=Adlx_SsCx-Z3eIXGyshQxZedkYvTH42coiFsQ2d0SVQCxvaLQTT-9IcLH3t5rn5zQ8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSnl4MvSXyekC0h339t1ANQHW85HDUBZnBUWmD4wkjfg&oe=69AFFA1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTcrSYVXUbQQ7kNvwFig4vV&_nc_oc=AdliBBfUZcY8hEBYHk9dVgP481A3MpA-1rSBKDkO3vVm_4nZxOj5tBuJtZ8Z5Ca-z3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYJmh53GeMcxaEw_TlBxGZD8pMbKNDMPODgNlhwJxxtQ&oe=69B024A9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recomm
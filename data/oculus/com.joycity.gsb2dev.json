t-ams2-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQJJOjKFUckQ7kNvwHO79Vx&_nc_oc=Adkvt4Xqoh4sZBPixP0IuQr2WFOV-aEftzT-pDsrD71qG4WMeZUMKKdi7sxz_jo5488&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsRMrCPCkFl0p7JxpB1wwuBcA97ob2WuEZmd7XRAhiwiw&oe=69A809C4"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ica5_6cmMPQQ7kNvwEovJfT&_nc_oc=Adm1FE4VymKnSCP_Majaac0X2aGTd59EaldjoGoVouRS6XjkPFDwCZYETFLkvS5F4nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvndSAEpXV77o1GvNbkLSEqB0jhDXlLVYghd7BJ2OkE0g&oe=69A8219E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2Su-wWXvDwQ7kNvwG-JmI1&_nc_oc=AdmcQ7dHECbCeWy-QbdKu4nT_tbW3dkM03qCVzn9K0DxAjALAuS4SjlMxzkO4eG-wYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsrxwm8Dgt06BYjx4VyXfalLeZaDTSSWOMcf2qGHaifEQ&oe=69A8111C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTJCsMbJAc4Q7kNvwF4dNNI&_nc_oc=AdmdECegFSt1NGe7oAf0XOlU7cDlW0MYokTuFMRmAXbTE9n4kujtgTlW4zaWsnzZAWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv8BpxJtiC68LWEyAc7h94T3KdWN87jMSPe4mdfowKPKw&oe=69A83BA9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recomm
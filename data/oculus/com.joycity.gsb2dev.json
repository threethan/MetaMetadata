2516886481", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsMtoO3iIXoQ7kNvwHjiU9_&_nc_oc=Adr7OSrBgHLKV3rBVSlgv1FYlFqcpezBcZ0DeBmoBSBe01fUaCBwnxvjIvGJmXegn1E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gh6IK8W-rT6xhbtz1-qiJBadwT0CcbzdATt2MITOD0A&oe=6A32AF84"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSqQ2mjq-uQQ7kNvwHBSQ39&_nc_oc=AdpE6hizfDaXkfgMvEU5xS_k0rP71sElPRhxrGl6oEod3gTzWI2a0Cc_XVx7bcQwWVo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82mzGNFTcO9mW_AHyTnm0GwTb5zW4w7xUjzEFNvIgIlQ&oe=6A32C75E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IM5aCM4_aUQ7kNvwEdn_im&_nc_oc=Adph1IyyZRIXDtPrxn8_U-aaZUYRAcMGFxgVXRGyUjtLdFHPlAQKLHue-Dgey2PcOXA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WKH1mxG11a4BYSil8Ffn5rn7mUHyDd1zs2ijyFZd3vA&oe=6A32B6DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh8AZ_Y8PQwQ7kNvwH7bV5G&_nc_oc=Adrtg_lBFWNWBMdOIjtPvxmymRkDwTDz4L_6HYRbBPPzjRDIpvNJdQvVhiXleYc1cDI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ugzpx1MvL7uf6zClKpW5w9AAxbb6k1Gj6W1NDYQncuA&oe=6A32A929"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
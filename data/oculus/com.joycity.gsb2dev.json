2516886481", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okJbMVbF89gQ7kNvwEk8U3e&_nc_oc=Adq0jhL60Ta8BpEZN2xs3pcLj1DRWe3N_Vb5XxbPgjBfidaCRkpgB4_YogbPuz1MLpg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mVEotPxdWrppZlo5kxZGS0TZIyZB_646QmfYuU6W_IQ&oe=69E24404"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxhhM1ChvV0Q7kNvwGgzfMc&_nc_oc=Adq7TJ7Kq9kVG3TggV6HZhlYzoblvE0ALU_WklUeEzEhYHeCxlrJQCpZDkH30ymVNCs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u4o8o-onvfq087YFxeiUPpgdoZl_-yDzTiTzEfQ_i_Q&oe=69E2239E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w1iELEv3ksQ7kNvwEOhep_&_nc_oc=AdrImDBF3Nu5Q7H-7RsyUNSA8wOTCBQOwGOtAf_fFYJjXnIBnQVciDi6dd9CNCmKhc8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jDt1Rxfilab2IluG2Fg5B6LDsndKTHKegvtzKelC7Hg&oe=69E24B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3t-4EHLEvgQ7kNvwHiAr-I&_nc_oc=Adq0rFAy9l8hzj29I3AEdONIU0WXgo5U2eQj2ox8IT6TjXFCwIc1c2wIoRzCmxeku1Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27i7cEAfmaNudzteG3Y0_YHlpEJBxLl3z32Ew7sgrcAQ&oe=69E23DA9"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
2516886481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138960_1799000723696639_9142652619062247424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZvoBjhLarMQ7kNvwEfra2B&_nc_oc=Adon9c_eWUK1w0n_oSjSxG81H3Zco_ffEd4SeUARRAbrrQS9Eq1s_xcdww47t7mvITw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zfBekamwK4OymiriBmwbbQSQFnn8KpgW68r1mRMsJRQ&oe=6A087F84"}, {"file_name": "migrated_image.png", "id": "225239052214494", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602128_426858367651889_7639333702329171968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzDaB1M1muEQ7kNvwETkZWN&_nc_oc=AdpmC8c4UlsXGZwqN5piJAEVAgorqxoRof8lie3E_Lnbro7gWVomdxTGFP6mbdfhiSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xpR2O683APSkfVztD22bMJah-MIx5GGscvfAl3G7LYw&oe=6A085F1E"}, {"file_name": "migrated_image.png", "id": "210818436825632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727894_274923422942057_2211932651638489088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpuwLc-fTzkQ7kNvwHA-kMp&_nc_oc=AdpCSZZRK51iaWj89Bs2WHBvn4xqpyi17BOdX_HjNrZRHJNMlMVkv1tXDAE3K-eLbuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L0iR0B6Xibwpp0vD2eVqLdNr7a64nTouEG7QYYItXKw&oe=6A0886DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/VQe8je", "id": "1894026403988971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504685_1894026407322304_5980951768832409600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-p2gttEyNEQ7kNvwGdbsER&_nc_oc=AdpFDapyEUH7p3p8nY4w50XR64NGHpNKBCFV5jAkX_UZ11L42xRAd-o1WXPMxK7rhng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cRdukli3mRKSVfcQZXaq7oMSzXt6E8N55J8kd2DW8Iw&oe=6A087929"}, "display_name": "Gunship Battle2 VR", "keywords": ["military", "cockpit", "action", "helicopter", "story"], "long_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but a full-fledged game. Indulge yourself in this action packed journey now!\n\n- New Features\nReal-time VR story event scenes\nFull voice over for all story scripts\nOverall graphic upgrades and new cockpit visuals\nUI improvements in menus and in battle\nPerformance improvements and user reported bug fixes\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers\n\n- Story Overview \nBecome a former ace pilot Dylan participating in a top secret government project. But because of it, he lost everything, even his family and his memory. Before he has chance to recoup his life, the fate of world rests solely on his shoulder. The experimental gunship is the only chance that Dylan has to save the world and avenge his family. You, as Dylan, can make that happen. Get to your bird soldier!", "short_description": "Take control of the most advanced gunship cockpit on the planet! Complete with episodic story, VR cut scenes and immersive gameplay, this game is not just another VR experience, but full-fledged game. Become a former ace pilot, Dylan, and dominate the sky in powerful gunships!\n- New Features\nNew VR cut scenes and full voice over for all story scripts.\nOverall graphic upgrades and new cockpit visuals\n\n-\tController Compatibility\nSupports Android and Gear VR certified Bluetooth controllers"}]}, "developer_name": null, "developer_privacy_policy_url": "http://policy.joycity.com/en/provision", "developer_terms_of_service_url": "http://policy.joycity.com/en/provision", "publisher_name": "JOYCITY Corp.", "support_website_url": null, "website_url": "http://www.joycity.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
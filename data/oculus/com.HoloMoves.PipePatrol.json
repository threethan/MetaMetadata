DB"}, {"file_name": "Screenshot2.png", "id": "1151349473203548", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8TrOOSCiXYQ7kNvwGIOQvP&_nc_oc=AdqtJHSIjM61Z0ecpJjDVzy3kOEglWcn-C2udj6f8vJM_GUZ1a8wyIdOezxUOCGyswY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAprbRVXUopmAxybSMhsRHBLwz4FEqRgrl7JVkcaH0nNA&oe=6A58E670"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiqGLUD4JMQQ7kNvwF6-f_M&_nc_oc=AdoCxQiu7imDzJdoho-i5yXj0S58kpux9JeCVjCMeh-oSmegWTAkWXjr7ghxAzQFeew&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs-vqb5S2W4g0e4wfbaJ2G8UAR1CqravcoHkB2jrDtFw&oe=6A58D97F"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbUsir7_ZZ4Q7kNvwGe0XPo&_nc_oc=AdrgrBY-1Im_4AASABQ_yzH-e5YUcflg4Ku5tpjDQqbQw6198zCoJ6VdG3gmJol6r74&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2njui_51YptqUPiR4ryoakqfH99bjatXbN4QH9ZW4_Q&oe=6A58F13C"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNpywtFTHx0Q7kNvwG9yEt_&_nc_oc=AdqnmVfAZAadvTRO7NlmwZIaniGSSsHJTiIDvAD453GF4o146-3XCNIviyDa3pxCMnI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeIc8p-rIGEfwn50NxjBjuJGJso5l_xJ0XQbKYH-RPyg&oe=6A58EDDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "intern
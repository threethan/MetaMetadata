DB"}, {"file_name": "Screenshot2.png", "id": "1151349473203548", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qjyI0_b_lwQ7kNvwFl0C66&_nc_oc=AdqGXbRWJujKvxqhVW640KRTtvrmkbOv6kjPpCfE7UrDsWlOpiyEbLZl7qbOh-uCWNk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPXFU94sgtGqZdI6WSI4mv4rXtghJKBbwE99qAvzJXaA&oe=6A882430"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HEOW0-wLVYQ7kNvwFqtxg7&_nc_oc=AdpJRgqHGVWW-GwBYlYOnhqBqhztyClQ9K-gaskdgPQzf31atNsW6gS4qIqzOiCg-Ok&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG9In60L-ZDIuOQurMCmDRDnvltwd7jQRldjYob0ZtXQ&oe=6A884F7F"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SoRNqoC9nYQ7kNvwH6gdKn&_nc_oc=AdoWXYR3pqmS6fMP4q-FZOuVqnqh-LuoOiEWu13FofnV4nlwqLaly2KFOi9OcGPDY4E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP0hvQZWHaaYhZYX1xZhqxgoR5d_rfc34UxH-Fd7PLJg&oe=6A882EFC"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xjrFspP0RQQ7kNvwHPepFy&_nc_oc=Adr1icWx4h7gUSW7rvm8luttbdLtIOtpN-9TcRvYHuIS2roXy_PwfwMA8dawqtpyYjs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-rP2Bhln4GaBjkN5IR9PqBUrK8_h1FVFunLyFDYoy9Q&oe=6A882B9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "intern
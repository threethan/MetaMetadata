25/473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsXaz6MoLlgQ7kNvwEiu2ZH&_nc_oc=Ado1MEdiUp3wreIfoB1_Z938JaJqp3DHmcOgYrSSF35M8mRMIpn2tGbHcrU0KAiBawQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZaJBaZ3iqDtun_NJBkYWdU9S1SMy7SypeYEK6Ziab5w&oe=6A22D8F0"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArJpkG3jRyYQ7kNvwEqxmVH&_nc_oc=AdrHLngh5ambMt35eGDerKtd58m4V4eWFLCsLtDVm7fBjt64cb7EpVY0DVYz3-bE5rU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aX3aVgNCLInQZ2wLzQMDpC9DBW8de0bOXO7DY7g9pmw&oe=6A22CBFF"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QBuVESzszEQ7kNvwG63Gb2&_nc_oc=AdpTo00LrX2SlO81q3QBWVh_r9-QMivGzadxxCMxnpY2dNdJC5KMpL26G1zE083_m6I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mtk-e9xvIyfpw7TXeivepc4ePWu0Bo2n0kD57-g4KyQ&oe=6A22E3BC"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R59WEUsXHFgQ7kNvwGh-0LP&_nc_oc=AdpVRXiRsOrRUQJcD5Pd1GMyJ1I_dxhNa8ZNIEGOAk3Si8MWbCssLuXFt9vu9_7IrdY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wg9IiHlub_7v9YfZG3AcYryjF7H7fbD36ZXf5kRYFZw&oe=6A22E05E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
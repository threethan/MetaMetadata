f&oh=00_Af3WPZz1Y6Y3USktt_iDHvX28tw_lKIoEvt_KgJME2xp9g&oe=69D26D70"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4OVA62YDKUQ7kNvwFPcr-h&_nc_oc=Adp4uVZWRlXQQbXhUGLZ9WdQgUM_-C-_96zz1vZn9iIWda30PpnCVtiknttlvLhxvbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gmvWwlREcOJ0tMH98wBq2ra-cp3JugIYj4CkVihLCPQ&oe=69D2607F"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYFWo4pzfJ8Q7kNvwFJd2ln&_nc_oc=AdpoWKzl0Tuuz5QaTASa89NlIbxTcF-tKlL8c-cnYcvs1MB3zK0G7pEJvjC2QDCrnFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DwasiMF0Yau_Fu2YMdmj6woKtzwVOgQ9NZ6HbFMTZkw&oe=69D2783C"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4d0KnIWWsMQ7kNvwEjavLe&_nc_oc=AdqMA06I_3TOL06eoUK1cgO3Oh-1_PkNylMXNuZo5yeh3FX5DFUQpAuxb67xh-kokS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hAwXW9-IuV8Wcgem1E5IXM1nwjDsHKWk_o_LHfd59ZA&oe=69D274DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "92104294790378
=AdoelrnYaxsNfBQsMvB3HCdomEw6Xn5y0hZuCC976Mh320xcm2yXOPOtFyHUzje55po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZfN5kORoi5lzPU5bQOfAGgWYPuvHFTeyZ7Q2w5Zj0sg&oe=69DBA7F0"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzXyCyB8NpYQ7kNvwGhSR7F&_nc_oc=AdomU3mTAQ2BgK-dMd1-PCzON7m4aodZCd8vo3C8IrDDjXwep1NXyEGmX7qr-1gq74I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ovs-6Np91lcIg3X3OPiOzc181QS8BajMEoQqYYUZmhA&oe=69DB9AFF"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1ozf4c0_JAQ7kNvwG4VjjF&_nc_oc=AdqS2YFWAS4WDgeuR9wfWoqSTy-5T-zM2Bu6_4VGHRzDUhHJh-9H4Iy1NafSZQxq2J0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lWZIn6rIvCybVe5l6bKUznVd4A3bg_fivhAZ86irD2w&oe=69DB7A7C"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC-G_3m9XvsQ7kNvwFQs-PM&_nc_oc=Adr-wHSL4hdBo4czbPiNAd8kmrSLHEOj1jtJCH34iUlfgIucPdedHAm1peF2uJ2QOFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af253XvrPN_fWOZesZk67yeIpCv8uQJQbNIlLEltF7lfgQ&oe=69DBAF5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["HAND_TRACKING"], "supported_p
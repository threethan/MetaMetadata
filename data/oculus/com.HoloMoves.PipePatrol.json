OD1EXcey5fq3bQ&oe=69C149F0"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR6t5ux9eWUQ7kNvwE21kZk&_nc_oc=AdojUFPftO5gz9_vsjCvSkOLvlSMfWwzL5-LQTjucIyjyK6FTLdiRiFdMMFcGAFO_jE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxlboO8GSKLtsn5yNNcwmgxLimeJU7ivTjoVHbDAH6ALg&oe=69C13CFF"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDOLCdwLnqMQ7kNvwHdZH0T&_nc_oc=AdpGfcVq6rD2Gsp-dz9l5aa9wTh2VBZwCI6H2r5jCCk721WULuoYhHPNZLuodJ5TLTY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwH5yiDDfNWzoaZskYKirMWLjRAyMRTMT0aD6fsAGJcsw&oe=69C11C7C"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qXCefVq7iAQ7kNvwG6pVwj&_nc_oc=Adp-5bddvHmPO59jg-ko_wlHi10URVqGbkR07oMUtB1nllS85wRG2_ETxGE3hrooTcE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIIFSHt8egU8WmQ-itIiaYXeK60lGod429VFQo4CostA&oe=69C1515E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9210429479037840"}}]}, "scheduled_offers": {"count": 2, "nodes": [
25/473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoHJ_SJaRAMQ7kNvwFactxA&_nc_oc=AdqMHVa-lFyLaLC4N6flKEFHE0mcfsmgSOpV1wXpjIJl0oJjEHiUMCBfJbcpMRNKpRU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-owmOHbWzMJrI_0_Mr6I12bSOFGLGTrkLs4lE6piClQQ&oe=6A369F70"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6wWM06FmycQ7kNvwGppPxH&_nc_oc=AdoHBEp5k8P3UfzETL43l5D1gIxFY0gYoELYBkykE_x2p4gJUVb90hYw9lbPU51bdUU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sBlz6JxFJW0mIgqiMst03OP0p6zuLGlXUTHNnIZn8aQ&oe=6A36927F"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TvPfYxt_MMQ7kNvwHEDQl4&_nc_oc=AdrtMMLB6YsN8Yg_Jc4ZuNsIPOB5bopQ3FgoLRRkfppLiLALwSLWVOCNrs6zbrHFC00&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lKaSLmaIgRw36FRgFzKQvoMO7ol-m5xqc0G9vmB5nDg&oe=6A36AA3C"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL6r2cpiUskQ7kNvwHQY9TY&_nc_oc=Adqna3QfuG7_R1TGdzHRxfZz9VWtJla7CD-JdzUitbFr22182Xo3nPtXUlhCHJVJ9ps&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vUnlF3TomcvfESY1AScbc68r26-F08eFD9lHFc-nLPA&oe=6A36A6DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
evCQ&oe=6A85AFDB"}, {"file_name": "Screenshot2.png", "id": "1151349473203548", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7UFPLL8gekQ7kNvwEXeBB9&_nc_oc=Adpn7-8nJuplqxgRG2Ajc_qLu2MEe7aR5sSIUomcpQPSOLwadi0pN9BgRn0WdF9ajOs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh_R5IlHVIDRkEWtWKE--1xcLPt_Kv-N4zaalfdD7Apw&oe=6A858130"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sELupe2eUtsQ7kNvwEzIic-&_nc_oc=AdrUMFWsdXNI4odTPdRD_zrjtQ--JEuYpiYtOcVEQRPr7LGxdSpj2nChILZApKDdcsE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXNx7GW3migyBagFGiz6cK9TxlIVircwLxhbA_OhGoLg&oe=6A85AC7F"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTvDo_0wEj0Q7kNvwFgiWqT&_nc_oc=AdrJxkb02Wkq0I0Vv1Pq-83veLqPRpXQDGoYBAcr0lPvrBlE4bBxaXgcMwElIZoyWuE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1GMTcvMk057fx0ahi0NabATddC2o1quQPs0LpaMBjEA&oe=6A858BFC"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5pbHxrbPlgQ7kNvwHpd67_&_nc_oc=AdqjPaRJ6I4Wq1nIK9l2ApphBCOYn3n-nb7NqSUtiHM_SvqYHi5vEVG-s-affWoaHHc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKVVtrIbVQoar7P939h6qbTVJ_n0LGGY_765zXTnkOSA&oe=6A85889E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_a
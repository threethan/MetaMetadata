DB"}, {"file_name": "Screenshot2.png", "id": "1151349473203548", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nodkAYJhN4YQ7kNvwFKxIFY&_nc_oc=AdrQp-Mb9hm3CPB1yUavJJaW6xF3bYBORNoQNxDVuZMLh56saBPablApRD3sdbiIyEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0WqfOUm_zAmCY76IOqm5RfPDKSDi85QwvV7b3dydzlQ&oe=6A5E2C70"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICPHXGBLAC4Q7kNvwF3EFFf&_nc_oc=AdomYpRWBM97opJ3f83tocnx2TGfh6GWeDzBXlKOEYy3yglzvtVF9kuQh5-4o9yFe1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCluy7PTZsc81cahiN4ojhKnPyifEDRXg9J0dMKnhmyGA&oe=6A5E1F7F"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R90IcszRWEQ7kNvwF8jem5&_nc_oc=AdrKCAO01NphePzkgyj8W96gy1VxyY0wubYYEBDLMi3DCqdKv7PSl3l3Yj1d_LuUPRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCgZ3pXBBzRtrt5BLTPmbTNTG--KVmxy0SlmdHqHSkGQ&oe=6A5E373C"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YotjNyxP6LIQ7kNvwFCwNmV&_nc_oc=AdrLz_go7gIwBQuFBZPRCQHja2jyIMjylC-kH0YXxcQJLSyG2Tbkgft9FZhkwHkBG4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLlzAk6AOWCK_w-UAM43MK2AIRWyZSgxxV8NUWMwlAYA&oe=6A5E33DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "intern
DB"}, {"file_name": "Screenshot2.png", "id": "1151349473203548", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qjyI0_b_lwQ7kNvwGx6NTR&_nc_oc=AdokO5zwk63PvMRVpOmnvhRa6uQHtEjfj0KyMOry2hXBYRHAIdB4hQdccJiEfwXISIo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK0juxBZ0oj0Uefkp0mGuKt3WEqMvIhGfQ_FsD9WFSeA&oe=6A8AC730"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS37xcgGNGsQ7kNvwHBwJb7&_nc_oc=AdqbHeX7JMkW0rMmaGhxR4wvKpnKt1D8LmrquHKqtoypvHFUbR7y7oA69S7i0Ai-KR8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuV2OgnwrkFe2ZDXtYXGnRf8QJ526iV_SMMvgF7MxX8Q&oe=6A8AF27F"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SoRNqoC9nYQ7kNvwEDr4wa&_nc_oc=AdrJY77ZftnZd5zsjTg3wI5YoQZPKWbXLD5ZchE0S7iIta1RRRfDKdFbGoS_QyEtpy0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa1bsTwWQpqGheqj47i9KvZgDLjY6g7K3zVtxrfC3GoA&oe=6A8AD1FC"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xjrFspP0RQQ7kNvwFsotrS&_nc_oc=AdoqH_WJqgnqcs27jhBiy7LzUqZZ6WsUBugzQtT_q1BPDnObwI-PPHTsxxDHPjxCS84&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd2kq2aqVAWZaVUptpHkzEa62Hv78GIDqTjhxkO2yEMQ&oe=6A8ACE9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "intern
473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBBNSrjne90Q7kNvwH49fqs&_nc_oc=Adr4W9TXajWmoUFeLyH2YMK9l7JpGdObadhldR3atla6KzJyFwTSnrxRN_0Y-fvFEvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jm3c5vTBWcfefD0MbMGu9M0bkZsDuVE66Bm-VWfZDxg&oe=6A451FF0"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE5hhdYlWa8Q7kNvwG9DeKl&_nc_oc=AdoaH7d6QhCqt_ZB5W3P36DFTwzk_55lIOqrDxwL6JiBE4MbeXBa4ao8snvIZxw2GLw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ihozSAAiXb0Bq5Y8hiwNp6MkdG5B4yMKXxVmixXE0rg&oe=6A4512FF"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c1k7rKFvjwQ7kNvwFgUR9_&_nc_oc=AdqVRGiKxuuROdbbLnhwFihCfn_pL7iYCB4hlqYaKEe1AnVhVminYNRujWhVpp2jgwU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dxDW6CJyzTU2kHBymNQKIgFDbaJha1Ll9aywjB0bRuA&oe=6A452ABC"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4X3PAuo3PgQ7kNvwE7A4kU&_nc_oc=AdqfHnFblPVYfEB--mLEV4uhlUeym6C9Uc9XYN6_jRS2oWuL0mbvOLLOBdWizPBgl6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UrAOLXO79ZOYfgSZERYJUv_7kI6nb7P4-2B_WixrMCw&oe=6A45275E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomm
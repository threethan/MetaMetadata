473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSx5aBoeOUcQ7kNvwHFjvoa&_nc_oc=AdovuX3f4RisWXTxbEVEu18bqe9dICAIUBdvnO4OiqqNaw64_DHU-8ra3nvSfcFStmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45G1QFBO_9eHvZaFT92NfOJLaF6RBBHRiVNCL9HYBaqA&oe=6A184CF0"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0lDXPNgYoEQ7kNvwE0XUsV&_nc_oc=AdoPhqcXsrmUwdE6jL8giaYr7HhYeCuINhxmmCrpdPTvHwDfCQF-z1htqfTxM00WnDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J9FNYeb3RfEf_cECIdPpqPdLAvwD-WhQ_-A7csbl-FQ&oe=6A183FFF"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZRhbaTK46cQ7kNvwHTJe4-&_nc_oc=AdqvM-wvyvUKT5ReYCtdex2XlAuFrHdzYS43XxqjLg8Ma5_WTxIsATPhdJkKrA7jcTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Sd0ORmpWWV_W8vz11WqV2ng3jjKcfiC05cwwe1gcfA&oe=6A1857BC"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iOmS7gQ5eEQ7kNvwGonj9k&_nc_oc=AdqTsM_pOMC___nyJHgwGUKlfvW2ECeuj8Gj1IpsfFootKng7nzRb7DVIBcfTVRG2WM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ozqrOsMgpr3k_Ll7UMib-4CPkX_xO6sZSuN80zaJctA&oe=6A18545E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomm
473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svnLo8kyhGEQ7kNvwFCXPr1&_nc_oc=Ado7DLlDo13Cb-S5s8_zdw3iG6Y7x2FSHfMDKCgYuCaYBWh9U_rSIwHJriINZmHOAXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xb64A3eReI9tNxUGboC7z1Co2C_kWYQAXWTQv7-ojDQ&oe=69E0EDF0"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqExbMK1X_EQ7kNvwGyTkS_&_nc_oc=Adp3NpD1TSxtFh2sW7wwvYd9nljJVU_6ab0GW_7UmEkK6lwn_67l6-4dbP4Q-wZXZv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EubgtYN5jj2BudU2sfraD0Bq2TWl_GV-F0LRZrwi_iw&oe=69E0E0FF"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BJouona_f0Q7kNvwHIpg_M&_nc_oc=AdpOQQ-4ZQJ1hJFWt_fYxP7XPh-DyRdSwL8RHfFrxwEDJMESQ1d55cTY3_TlVQ39nQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q79sITmF494cy1BY6SD45qboPf1j54eGJ2LMlMCSqUA&oe=69E0F8BC"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUJZTeK28nUQ7kNvwF3Cq64&_nc_oc=Adq54PnAbp-ku4I0X6ijcz0YnZKytMvduYGj9uO8pArJH-AcC3jrboWvGCnwCQ86wmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DXurDCAvDRkyp1jGeSwffMmhUJNyaesLQfyIA2p0QfQ&oe=69E0F55E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomm
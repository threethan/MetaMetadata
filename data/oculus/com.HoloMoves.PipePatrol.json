C6DB"}, {"file_name": "Screenshot2.png", "id": "1151349473203548", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391739_1151349476536881_6185883255065323199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is_JRw_tbdwQ7kNvwFD91mA&_nc_oc=AdrkPeQlCgsZvaMJm-oNIeEINhNr_68reoYqWwsCy0-bLGvIefvuSvqtlTI5ThbaG00&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA5XI5KIHaHiNYL_maZcwNpDGQZkBgIJq-9rYyjvxgKA&oe=6A7D9830"}, {"file_name": "Screenshot3.png", "id": "797894832558511", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473397265_797894835891844_1951232065727376623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dtwbd9itq88Q7kNvwHc95F5&_nc_oc=AdozopXDl65Zmmd9O-oLCuNELLW8ZrdEEfaLJ6-aQ4kGbhdlChG-psIkryWnJeZIe3M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9xF36AxK3rKCofki5eWuGmueSTgRGYPgFDNR6i6vC9Q&oe=6A7DC37F"}, {"file_name": "Screenshot4.png", "id": "1750407428856956", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391842_1750407435523622_8715962427695670258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPjHISo72DwQ7kNvwGV3-f7&_nc_oc=AdpYIITNb56KA5gEcrsMZKxPdfV3xcnVmCG2qOuZQzUztbJ6ltsp2f99M1p0t82JZPk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRLhv7zZEEqxhQo6LPHYiggDH6-a9_UAuf3MeC1i5NJQ&oe=6A7DA2FC"}, {"file_name": "Screenshot5.png", "id": "2150405402024330", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391829_2150405405357663_6258296577663658199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7F6ETiNSj4Q7kNvwFn4Hm6&_nc_oc=AdqVijFBDSWzP_yOinvyVAKEeu4dfpgU6EDScr_oZKAceKsD5tW6lmREBvVu7UqL2-c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAlzME7tGO0L74Xpt1zgxMGyQmK0iz3F0XPmhv8hzuJQ&oe=6A7D9F9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: PipePatrol", "keywords": ["holomoves", "pipepatrol", "pipes", "waterleidingen", "exergame"], "long_description": "PipePatrol is an innovative exergame designed to blend functional movement exercises with engaging gameplay. Players step into the role of a pipe repair expert, tasked with fixing leaks before the pipes rust and break. By reaching, bending, and turning to repair the system, players practice essential movements that support recovery and improve flexibility, speed, and mobility.\n\nTailored for rehabilitation centers and physical therapy programs, PipePatrol offers an exciting and interactive way to practice bending and reaching, PipePatrol transforms routine therapy into an enjoyable challenge. Its gamified approach motivates patients to actively participate in their recovery, making it an excellent complement to conventional exercises.\n\nPipePatrol is part of the larger HoloMoves subscription package, offering a range of exergames specifically designed for rehabilitation and physical therapy. Learn more about how PipePatrol can transform therapy at www.holomoves.nl/en.", "short_description": "PipePatrol is an immersive mixed-reality exergame designed to support rehabilitation through active movement! Players take on the role of a pipe repair specialist, fixing leaks by bending, reaching, and turning. Act quickly to stop the rust and keep the system running smoothly! Perfect for rehabilitation centers and physical therapy, PipePatrol encourages active participation while targeting leg and shoulder exercises to improve mobility, flexibility, and speed. Repair the pipes today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves BV", "support_website_url": null, "website_url": "https://holomoves.nl/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "in
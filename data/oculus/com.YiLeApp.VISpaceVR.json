AdpVO3J9qT1p2vug-7ln5wU_cS9MhIwpBUAMHmI-TeGz4_07AvNQ0VvFQHKbVOiEbS8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkGvnvt7_6ZnoiFnEPJisWbedT_ujxivnMtRxYMk93ag&oe=6A8EEBA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2\u56fe2560x1440.png", "id": "1091212039036413", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982480_1091212042369746_8781357413014802291_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqeg56-IUP8Q7kNvwGTd6q9&_nc_oc=AdrxLSS0653lbpRmbybrZCmMn5_fkIgp-i-fFjRAy7_9Vpe8tETudJOL7h889GTxgF8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzQrcQ3BtXSGiqmiw-SsCSkXloS5uTt9up0WQzvDthLA&oe=6A8EE07F"}, "display_name": "Vispace", "keywords": ["vispace", "Interaction", "VR", "AI\u4e92\u52d5", "\u63a2\u7d22\u865b\u64ec\u7a7a\u9593"], "long_description": "In this virtual space filled with exploration and innovation, you will experience an unprecedented sense of immersion. In this dynamic environment, every corner holds infinite possibilities waiting to be discovered.\n\nWhether you participate in virtual meetings, join creative workshops, or engage with like-minded individuals in new social events, you will find that traditional limitations no longer apply here. With just a simple device, you can step into a fascinating world and enjoy the seamless connectivity and instant feedback it offers.\n\nIn this space, you are free to express yourself and unleash your imagination. Through virtual reality technology, you can not only witness vibrant digital creations but also immerse yourself in the fusion of art, technology, and culture. Each interaction becomes a part of your journey of innovation, propelling your growth in both personal and professional realms.\n{2589425984600045}\n{1255949142209638}\n{1305237230639676}\n{867005371879956}\n{946670170634642}", "short_description": "Immerse yourself in a virtual space where creativity meets reality. Explore, collaborate, and engage in a dynamic environment that transcends physical boundaries and sparks endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oss1.yileapp.cn/vrfile/6dbe8da7-aee3-4c6b-ad52-314bea15577f_en.txt", "developer_terms_of_service_url": null, "publisher_name": "Meta Quest Developer Hub", "support_website_url": null, "website_url": "https://www.vispace.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8831635813559656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75622016_531985209638043_8440470822282322068_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfOhul9NRfsQ7kNvwHf7to8&_nc_oc=Adof_p8Ix_35Pi1xbwDzTNJH_AYSFEzlKO7L3hvujV62l4yNUmz4A3JWgOMBphvpbrc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxCYHQ1uM3pz0UdBQ0-SUkb5L9SpnCR5PD7p0Ldrykuw&oe=6A8EE3B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vispace", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1730942760, "lastRevision": {"nodes": [{"id": "8744996345556937", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "i
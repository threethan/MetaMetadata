c_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg9LTkRwDJwrP7-iqVsknIG3n01TQ1CwEBYRNQI5rNBA&oe=6AE342C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aporush.png", "id": "3378457728997316", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499311572_3378457732330649_7283948756899600978_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H88jb130b8Q7kNvwGHKKno&_nc_oc=AdqsanTC9Z9KZwxWl7vAT1MyQdScw39jHcOYOfDcECDfJOKhuP7ip-Ap7TQtwGSG100&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg0skX0Bg_WuF59J5WIVwmoGRltZmT4zuCKoLaJnUuBQ&oe=6AE36125"}, "display_name": "Apocalypse Rush Racing", "keywords": ["racing", "apocalypse", "zombies", "death", "race"], "long_description": "Apocalypse Rush Racing is a high-octane VR combat racing experience set in the ruins of an abandoned nuclear power plant, shattered by disaster and crawling with zombies. What was once a symbol of power is now a deadly battleground where speed, firepower, and survival collide.\n\nYou play as a racer recruited into a ruthless underground racing gang, risking everything in brutal races through radioactive facilities, collapsed reactors, broken cooling towers, and zombie-infested wastelands. Every track is packed with danger\u2014from tight industrial corridors to open, debris-strewn zones where the undead roam freely.\n\nYour vehicle is your lifeline. Customize and command heavily armed racing machines equipped with mounted guns, rockets, and defensive systems. Tear through enemies, blast zombies off the track, and outgun rival racers as you fight for dominance in lawless, post-apocalyptic races built for VR intensity.\n\nDesigned from the ground up for virtual reality, Apocalypse Rush Racing puts you directly in the driver\u2019s seat with immersive controls, intense speed, and relentless action. Victory isn\u2019t just about finishing first\u2014it\u2019s about surviving the chaos and proving you belong at the top of the apocalypse.\n{1225734575614088}", "short_description": "Apocalypse Rush Racing throws you into a high-speed VR death race inside a ruined nuclear power plant overrun by zombies. Join a ruthless racing gang, pilot heavily armed vehicles, and blast your way through radioactive tracks where survival is just as important as speed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/10e53668-d475-43c8-ac02-a0f0a20e7edb", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26001265976228895"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1097373035847988"}]}, "baseline_offer": {"id": "1097373035847988"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770133560, "status": "PUBLISHED", "id": "1097373035847988"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26070662889289203", "version": "0.1"}, "id": "2023938844833959", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Ap
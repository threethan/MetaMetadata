"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000086128.png", "id": "4211930052272819", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839702_4211930055606152_2112031543291208635_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPAUY7pLZgAQ7kNvwGULqgW&_nc_oc=AdqdbIbxPFfVoiNSyPM1KvATUYAnQ7614yULTNz2khIUSid4WYlFvpR4ebv_tYBxlwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSs9xiKujnVLzEG-y6LM7OoAvupms9XFMZaAbP53Q4mBw&oe=6B0DADC5"}, "display_name": "I am Bee VR", "keywords": ["simulation", "bee", "flying", "fly", "Bug"], "long_description": "You are the bee, a VR bee. Fly through meadows, orchards, ponds and a palm island, land on blooms, gather pollen with your own hands and carry it to your hive. Wasps hunt you and sticky webs catch you, so swat them, grab them, throw them or clear the air with a Buzz Blast. Fourteen levels, four ways to fly with a casual free play mode, a Hornet Queen boss fight and hive upgrades to earn with royal jelly.  Bonus mixed reality level included.", "short_description": "You are the bee, a VR bee. Fly through meadows, orchards, ponds and a palm island, land on blooms, gather pollen with your own hands and carry it to your hive. Wasps hunt you and sticky webs catch you, so swat them, grab them, throw them or clear the air with a Buzz Blast. Fourteen levels, four ways to fly with a casual free play mode, a Hornet Queen boss fight and hive upgrades to earn with royal jelly.  Bonus mixed reality level included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "https://www.zosustudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "
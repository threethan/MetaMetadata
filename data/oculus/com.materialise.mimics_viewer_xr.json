3774099919086558_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff1ENxMFSD8Q7kNvwGACKSd&_nc_oc=AdpElBUl1K6LFTjYYGN2En9Ebe8PglO43ApRLnk7A1K8zklTKU-H8ToCMAoUYVlSwRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo4GYtyEKBt6xbLAMXyD7tTOW0rzhRdgtST9Mez96wbQ&oe=6AE612DA"}, {"file_name": "Screenshot_meta_ (4).png", "id": "698164293039254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_698164296372587_1088371834390832919_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7Fms9GtZAcQ7kNvwFLDI6J&_nc_oc=AdrNwLVQHFjBTr2piwzABcR2wx8J9cZtORLgH8MNO5wLAMST2l9CIwd4p82yWzGkuD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMczCr0sy8mlqjCCb5C8hGJ-vYUMvKqhc5DDTL6MJw0gQ&oe=6AE5FFEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mimics-XR_Cover_landscape.png", "id": "1101385992255473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830441_1101385995588806_2689232868693625701_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BabBCFW3n10Q7kNvwEMkB0x&_nc_oc=AdpPd20E8yAjIg-Sc2jDJhlHgg2_nbJpPyHgxpFZF_WFfgv-suypEKpPucsvzd_5zgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdAZY9aebla2Ly6yjQXrPdsyMPSBrtEWVml0_lFlGZig&oe=6AE5F0EB"}, "display_name": "Materialise Mimics XR", "keywords": ["mimics", "materialise", "medical", "viewer", "anatomy"], "long_description": "# Description\nVisualize 3D anatomical models from surgical and procedural planning in an intuitive extended reality environment. This easy-to-use application helps make complex cases easier to explore and understand. \n\nDesigned to complement your existing 3D workflows, Mimics XR supports case review, clinical communication, and education in a more immersive and accessible way. Use it to engage clinicians, patients, and students in understanding surgical or interventional treatment. \n\n# Contact information\n- Support: mimics@materialise.be\n- Address: Technologielaan 15, Leuven, 3001, BE\n- Phone number: +32 16396611\n\n# Medical device information\n- Medical device name: Mimics Viewer XR \n- Intended purpose: Mimics Viewer XR is intended to be used as a software interface to assist in visualization and communication of treatment options.\n- e-IFU website: https://www.materialise.com/en/healthcare/electronic-instructions-for-use/mimics-viewer-xr\n- SRN:  BE-MF-000000034\n- UDI-DI: (01) 0 54040280 0049 6\n\n{2188296155284403}\n\n* Materialise medical devices may not be available in all markets because product availability is subject to the regulatory and/or medical practices in individual markets. Please contact your Materialise representative if you have questions about the availability of Materialise medical devices in your area. ", "short_description": "Visualize 3D anatomical models from surgical and procedural planning in an intuitive extended reality environment. This easy-to-use application helps make complex cases easier to explore and understand. \n\nDesigned to complement your existing 3D workflows, Mimics XR supports case review, clinical communication, and education in a more immersive and accessible way. Use it to engage clinicians, patients, and students in understanding surgical or interventional treatment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.materialise.com/en/privacy-notice", "developer_terms_of_service_url": "https://www.materialise.com/en/legal-terms", "publisher_name": "Materialise NV", "support_website_url": "https://www.materialise.com/en/contact/support", "website_url": "https://www.materialise.com/en/healthcare/mimics/extended-reality", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, 
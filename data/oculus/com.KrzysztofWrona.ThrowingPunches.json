ohc=pDgFqIEQs4YQ7kNvwEykTM9&_nc_oc=AdrrXIawUXJGqfg1KrW4cfaRG1oxD8rHf_v7qenp9pUA8MhnEhiArRV4aDLNu_Q1C1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy784CnVw4e_JaQ40_HwZ-TkEpH5hytt4ZC4Mj1WY3LqQ&oe=69CD0AFA"}, "display_name": "Throwing Punches", "keywords": [], "long_description": "Throwing Punches is a boxing game where you can punch your opponents from a distance. Throw your punches and control them in flight while dodging enemy attacks. It can be a real workout! You can slow down time if the situation gets out of control.\n\nGo through 12 levels consisting of 4 stages each as fast as you can to stand at the top of the leaderboards!\n\nTest yourself in Endless Random mode - whether you clear the stage or not - you never know what comes next!\n\nExperiment with modifiers - make your fists go faster, disable gravity, or change the slow motion controls!\n\nNow with three ways to control slow motion: manual, \"if you move, time moves\" and \"time slows down when bullets are nearby\"", "short_description": "Throwing Punches is a boxing game where you can punch your opponents from a distance. Throw your punches and control them in flight while dodging enemy attacks. It can be a real workout! You can slow down time if the situation gets out of control.\n\nGo through 12 levels consisting of 4 stages each as fast as you can to stand at the top of the leaderboards!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.throwingpunchesvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Enver Studio", "support_website_url": null, "website_url": "https://throwingpunchesvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "inte
JtsmtE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJxV5-_Gpvm3LJpuTKI1TDrYGHcjYJA6Tjv8MhWb6jpQ&oe=6AB29EAC"}, {"file_name": "SCREEN5.png", "id": "1399961844688301", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1399961848021634_2571649058256890100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tueX_WS26LwQ7kNvwHB6wOm&_nc_oc=Adr2Hug5dF2-fGWkqbu3bVqJTHNBBjVKVZmLsELUPE1Sso3DkGXlwAJaT8qHC4Twwdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1w_2IJ1hTwI6lRwTVSuh6e4A-rFiCxELJKDBzKh2Bfw&oe=6AB282BC"}, {"file_name": "SCREEN4.png", "id": "2741667486017764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822893_2741667489351097_6561293814754979234_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cs6AQ0bsgAQ7kNvwHOBXAk&_nc_oc=Adrm2eMC4-KWnXJNgwVBNZYHifO-kW9Ua8h7vPmJ7F_yhKfOUNOvO1FfrPGlS5qQ20g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLj5_nNHuwGI4V7Pl7f3c9SWxiyiuPgLW5nH7UhKgLRg&oe=6AB28FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "650350337840768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821212_650350341174101_8166205700106355028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT7C2pu0QG4Q7kNvwHKG5Xn&_nc_oc=Ado9TSvmvQDh81dOcWmW_AYU_tLj6miR9IwDVAiOp5hnOep4nMHoK1RYVog4cwl0i2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk2ci3g9Gh8n3_l9ju1cduJZQzEiONsjxKMsiTadzXIg&oe=6AB28E1C"}, "display_name": "Zombies At The Beach", "keywords": ["zombies", "dead", "action", "shooter", "fun"], "long_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nIt started as a normal day at the coast: bikinis, barbecues, beach balls. Then the undead washed ashore. No one knows where they came from, maybe a sunken cruise ship? Government experiment? Too many tacos? Doesn\u2019t matter. What matters is that they\u2019re relentless, and their digestive systems are somehow still fully functional. They're groaning, stumbling, and squatting... and you're the only one who can stop the mess.\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d", "short_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "http://www.biims.net/zombiesatthebeach", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "http://www.biims.net/zombiesatthebeach", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29674985145425760"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830409_683729447359543_8402771687437330
: "1399961844688301", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400716_1399961848021634_2571649058256890100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD87gPb4IhcQ7kNvwFqW12c&_nc_oc=AdpWoaRAyernPuSwuY4DcbwcXZYWVVJg6GAMlhu8UWLF_irpB4l322lk8V5FrtDSZYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iMkMFQSUtJmkA8S2tKI_ZhbIsBuUmTg-dbBBh9cJSiQ&oe=6A00883C"}, {"file_name": "SCREEN4.png", "id": "2741667486017764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822893_2741667489351097_6561293814754979234_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqeMXjj_yA0Q7kNvwF9Hl6m&_nc_oc=AdoInMGc_djp57-EkVd6xcMdI72bwbWLNMIs1O7MUI0SecmLWsCpkIQUTh9NubECcvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yBhW2dt1Lpcr2z0nrId51YISmB9Rl6kNu_A5cEanCtQ&oe=6A009553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "650350337840768", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821212_650350341174101_8166205700106355028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyL5C7gDtZQQ7kNvwEu3vRy&_nc_oc=AdpJPSNCyMij9uRu-CquJtKDyp4azvtO3b8meCii31OXbVSHUZl4E2ZzsV4iYwBCEqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CryuF7Ouhs2vQLtYlFLvQV2gDtKV7RwS5xCPFOWiU5A&oe=6A00939C"}, "display_name": "Zombies At The Beach", "keywords": ["zombies", "dead", "action", "shooter", "fun"], "long_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nIt started as a normal day at the coast: bikinis, barbecues, beach balls. Then the undead washed ashore. No one knows where they came from, maybe a sunken cruise ship? Government experiment? Too many tacos? Doesn\u2019t matter. What matters is that they\u2019re relentless, and their digestive systems are somehow still fully functional. They're groaning, stumbling, and squatting... and you're the only one who can stop the mess.\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d", "short_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "http://www.biims.net/zombiesatthebeach", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "http://www.biims.net/zombiesatthebeach", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29674985145425760"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1741771553434682"}]}, "baseline_offer": {"id": "1741771553434682"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745333880, "status": "PUBLISHED", "id": "1741771553434682"}]}, "liveChannel": {"nodes": [{"latest_supported_bin
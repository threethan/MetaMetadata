_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830409_683729447359543_8402771687437330740_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lB0RVn-fAjEQ7kNvwEXjarC&_nc_oc=AdmriSJU-p3EMHPizm-Gvf2ZgMePbKEaz18ciNtwm_RfojvGCEPOcf2gClG9ahxAcsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNoxN72TmRZh1jZJ0qN8nIOwwiDQE8AMFzW9s9GPtkMQ&oe=69AC1110"}]}, "id": "629915703367582", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "533473996224803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394220_533473999558136_5809267742029165673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkdtePJ3AmIQ7kNvwHp-2m3&_nc_oc=Adnc0MkxJCH5WRUIzgMPQaFWXMoN7LFeKsV75x8vKdl5OIXliyH-Ta26hyExfk6QB_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxL4azX_IwMqqHYMOW0tvjn5ofanbpAiI1D4Vkqc9ugw&oe=69AC3576"}, {"file_name": "SCREEN2.png", "id": "1313754953041847", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392200_1313754956375180_1939830155282889688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVq78VlKO9UQ7kNvwFvLdF5&_nc_oc=Adm3AQly4NksAd564Mq4shG1wyr4Of07P68T5shf8xDAJkjNaP1QUK52OPH54dw24v0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwh5RiBiIZU9PRcORqfvGXd9uWDNiDdn4_aiYZfrqTkLA&oe=69AC0DBF"}, {"file_name": "SCREEN3.png", "id": "1358119508569360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393831_1358119511902693_5908074355393884106_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtVIVJPaDaoQ7kNvwGEe_Rv&_nc_oc=Adlj8AhxitFVMv71d-ANg_FjhoobzeGTmsKPDRHXbpdYjzTzJ36P5IJjHiFys53mLZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy14h4-Mjf2b-yjS6piKlTXS3JOAfg_eE5oABSNmU1RPw&oe=69AC0BEC"}, {"file_name": "SCREEN5.png", "id": "1399961844688301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1399961848021634_2571649058256890100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6wEFbpQ-1QQ7kNvwFlL0Ac&_nc_oc=AdkkaeLD-PV_xDpb4sSdQKUpXXj969m-8EOVEdBa8m39yOVbyZ2na77-bug-l934G4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGJNTnmfhhEKQ-7AqvvCPjpuMwMSULB4APFQpD1rtFsw&oe=69AC283C"}, {"file_name": "SCREEN4.png", "id": "2741667486017764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822893_2741667489351097_6561293814754979234_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUs90Npisc0Q7kNvwFexwMv&_nc_oc=AdlJ5bCh_B3f_0J85fHS3j-hB8jWCrr2DGYs_7VOOBEUtPXLMm5WkV6og4YeGTrw6Po&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxtSuMzhcrdqMumA0hpJoqZla36Q2G6Zq3Q4_vdOvSbkA&oe=69AC3553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "650350337840768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821212_650350341174101_8166205700106355028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltK-uqCV8coQ7kNvwGsnm8A&_nc_oc=AdkCam4Iowtf8AK1tkMQZhxG7ODWruNYYUJwZfo53mr6sbAKwHivb_o9BdV1Ar_ekpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzvt8fwLG0EFmoBdjgVFuRbrctUSZl5zKhedujlHI5w7A&oe=69AC339C"}, "display_name": "Zombies At The Beach", "keywords": ["zombies", "dead", "action", "shooter", "fun"], "long_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nIt started as a normal day at the coast: bikinis, barbecues, beach balls. Then the undead washed ashore. No one knows where they came from, maybe a sunken cruise ship? Government experiment? Too many tacos? Doesn\u2019t matter. What matters is that they\u2019re relentless, and their digestive systems are somehow still fully functional. They're groaning, stumbling, and squatting... and you're the only one who can stop the mess.\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d", "short_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "http://www.biims.net/zombiesatthebeach", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "http://www.biims.net/zombiesatthebeach", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29674985145425760"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1741771553434682"}]}, "baseline_offer": {"id": "1741771553434682"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745333880, "status": "PUBLISHED", "id": "1741771553434682"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29693811876876420", "version": "1.0"}, "id": "1334269894511154", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"no
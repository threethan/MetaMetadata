100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJZdBYTwlNcQ7kNvwHkhAG_&_nc_oc=Adpb0Z9v0fZLfhI8JGJA481hP1ZDoopGneHneJGFsgThSZTlwyqOZHyE9rWwRbfs2Ac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl2YB8H32rbpwyPLsL9-XYwChw6-TSshN-vV9uexjvrw&oe=6AAFDFBC"}, {"file_name": "SCREEN4.png", "id": "2741667486017764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822893_2741667489351097_6561293814754979234_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xX0tRjISYUsQ7kNvwFjN5U6&_nc_oc=AdoVaCbtKtJeHpqNIowasRJeJtIzvOXQMjYKpzTbZZI9GLTR8xuOssjUcj0auQYA-oI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2KnmLY8Zd47Bls7LgMBkbn6zq9rXedm-ds-C0f3TX8g&oe=6AAFECD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "650350337840768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821212_650350341174101_8166205700106355028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mZAbTb19mQQ7kNvwEPnD7e&_nc_oc=AdrhBjDAPBbczDznEjp6vIyZrSRan62_RCrwJnb7f_oTlXlOHQ3HeThvupcv9a_hD8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4TpYtV_gjoDhmzVTjz-hMQJTxRZB46RgQ5BMoVr3FZw&oe=6AAFEB1C"}, "display_name": "Zombies At The Beach", "keywords": ["zombies", "dead", "action", "shooter", "fun"], "long_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nIt started as a normal day at the coast: bikinis, barbecues, beach balls. Then the undead washed ashore. No one knows where they came from, maybe a sunken cruise ship? Government experiment? Too many tacos? Doesn\u2019t matter. What matters is that they\u2019re relentless, and their digestive systems are somehow still fully functional. They're groaning, stumbling, and squatting... and you're the only one who can stop the mess.\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d", "short_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "http://www.biims.net/zombiesatthebeach", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "http://www.biims.net/zombiesatthebeach", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29674985145425760"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29693811876876420", "version": "1.0"}, "id": "1334269894511154", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary",
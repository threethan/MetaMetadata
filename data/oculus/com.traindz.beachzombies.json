_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830409_683729447359543_8402771687437330740_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL0Qev1dkH0Q7kNvwFxcc0E&_nc_oc=Adky5LdI4TCqnKc5su4JETCJx_dTTkveW6ZiaAERC9W4wKl5OLPCJT42ove642eHH80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdCNnGd6MlEzYaYnEt8IbGVN7v07UhsOUl5pRpn0HzEg&oe=69B94010"}]}, "id": "629915703367582", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "533473996224803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394220_533473999558136_5809267742029165673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MennhAaKJt8Q7kNvwEx8yqS&_nc_oc=Adkt2k09WD0CzhZA8gCxTEizoowIJHUo_N_xJkUfQXlIKRzmnrp8wF0TC07-VLE43Rs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDXebVakuuDZsM2yj1c-O9kcdOn1TiLRsnzmApS8HcEw&oe=69B96476"}, {"file_name": "SCREEN2.png", "id": "1313754953041847", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392200_1313754956375180_1939830155282889688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2RagHQTjUcQ7kNvwEh8D15&_nc_oc=AdkB3cHX4vTSNflRqwdHppZpB3rdinLMZ08zhkoulaatJdL6wlD8mG2rPNdAvp1YxwM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZQy3gspXOYLqbjSCKzp2zhl9IAkjmk2RsRixVpjQdhQ&oe=69B93CBF"}, {"file_name": "SCREEN3.png", "id": "1358119508569360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393831_1358119511902693_5908074355393884106_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPG6OscQ7CIQ7kNvwH8If7L&_nc_oc=Adkh4XmmfrYmGkVKaBdk5zPXVzNB0VVI4y3xNWpdKlIECI7gI3SawEIq0XMktV4kUJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxux4rWAblQmUiKhXYgSB_WUwzfHo-Nk4TzNi1k1Xl0Lg&oe=69B93AEC"}, {"file_name": "SCREEN5.png", "id": "1399961844688301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1399961848021634_2571649058256890100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Wly85QQzcMQ7kNvwEeCXAZ&_nc_oc=Adl1XmlSyrSN1Q3e9qkj3LWTAJHS478E_6eh_ZtrHBFbdz99ETa_PIVSVhKL-9SbE38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYNdTRQv99UNuHcgPzOOb34DWfvrKE5pNr3GpFNJYm7A&oe=69B9573C"}, {"file_name": "SCREEN4.png", "id": "2741667486017764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822893_2741667489351097_6561293814754979234_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7u8-Kwi_1gQ7kNvwFZWheO&_nc_oc=AdlrVZgNadl3hhd08GQ6U7t-MtMVKZgwNkNxFRO13tlvK5ti9YLD7MeLid2kNaSPb-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzkbhsgfUBYOahB_TzqdFka8M-0yu6lapUqsKiDNFCuw&oe=69B96453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "650350337840768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821212_650350341174101_8166205700106355028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqSX2MJ7U6EQ7kNvwFCKlDh&_nc_oc=AdmpmhE5rDn_YU_PLwtDYRVQ4GPrvk4aJ_gL5IpVNK1LwYXhiYX-SBl0OWkwX25QBi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxlSz0OB-t4iUAxDaW9-0xK_7S8ma-Ea8ulPxBVJHT6oA&oe=69B9629C"}, "display_name": "Zombies At The Beach", "keywords": ["zombies", "dead", "action", "shooter", "fun"], "long_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nIt started as a normal day at the coast: bikinis, barbecues, beach balls. Then the undead washed ashore. No one knows where they came from, maybe a sunken cruise ship? Government experiment? Too many tacos? Doesn\u2019t matter. What matters is that they\u2019re relentless, and their digestive systems are somehow still fully functional. They're groaning, stumbling, and squatting... and you're the only one who can stop the mess.\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d", "short_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "http://www.biims.net/zombiesatthebeach", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "http://www.biims.net/zombiesatthebeach", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29674985145425760"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1741771553434682"}]}, "baseline_offer": {"id": "1741771553434682"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745333880, "status": "PUBLISHED", "id": "1741771553434682"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29693811876876420", "version": "1.0"}, "id": "1334269894511154", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"no
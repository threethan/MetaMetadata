_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830409_683729447359543_8402771687437330740_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGYNaWyxzaEQ7kNvwFfb61G&_nc_oc=AdkJ7R3Tm5Wua_RFJFSC7K5okvG-w_xEKt_VHwuv6b5Q2CN43TKD6_PMBH0x1rs4SqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFr-ayRFGiXJpoW4-3jvv_1OTaKFJfhWDDJRkNKjA15A&oe=69BE8610"}]}, "id": "629915703367582", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "533473996224803", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394220_533473999558136_5809267742029165673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35Elq8LoYl4Q7kNvwHiWpbQ&_nc_oc=Adl-GoVH7k5XQzATWXSTd7q1sUXKqnbPAqOsVLCRlZnSbNRhDk7MrJn21m458mJ2G5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-K5LboJ__Xax-57xvq4PYEl-zUlaBtXxKJATcat4VYA&oe=69BEAA76"}, {"file_name": "SCREEN2.png", "id": "1313754953041847", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392200_1313754956375180_1939830155282889688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIzdaDHAlaUQ7kNvwE4Y-bC&_nc_oc=AdlQTHxj_s63Nj4IO97b6VZNQNNqERag_vJHPFuFYxOWRstjCkT6kiFs9Wib_N2R25A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfzW0EHr5DVUl66CIUSacYZDbAS-fC5jcdsMbYrw7_zg&oe=69BE82BF"}, {"file_name": "SCREEN3.png", "id": "1358119508569360", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393831_1358119511902693_5908074355393884106_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcUjDdcwmdUQ7kNvwGz42g7&_nc_oc=AdlXHzootpXStnwhTvFNVKN6MLTys3CdQ5ik9CQbyezD6D9IV8XX8hqKazXBN3888Ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzK5cSmJolo6EY71OrvoKwgVLCLGbNkz035W1xU2YswdA&oe=69BE80EC"}, {"file_name": "SCREEN5.png", "id": "1399961844688301", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1399961848021634_2571649058256890100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-biQl5YfXUQ7kNvwF5325Z&_nc_oc=AdlOL7RsDN2i6oE8LVZB13j803bN814C_VrwQJdkGE_Gf9EXNV2hKU0wucXqu182k9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkUFweKKEnyrg02YDX8OdsqM4bNk8mZK6qQAqxB5XP7w&oe=69BE9D3C"}, {"file_name": "SCREEN4.png", "id": "2741667486017764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822893_2741667489351097_6561293814754979234_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Svft5L_u518Q7kNvwHQp-uI&_nc_oc=AdnxYKdw4sMuOAONVslyMIMbYWd3mYWbZZFsz-ms40hzErHD3SfM8_9pOL9lgM39IUQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvRTJjw8tyaR4EEdA0nIneIaR6g12Cwe8NitJfbnzGmA&oe=69BEAA53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "650350337840768", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821212_650350341174101_8166205700106355028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5EDhFe-SYEQ7kNvwH1ZXig&_nc_oc=AdlMkBbAwU8eq-KqFl1nyIj7CJJ4QWffZxqz-i8_rh14YQngVCcjY8v0sc6acET96RY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx44W-BagWMy_s9j5G2fToRDi49yLO_AYwmztDjDHAFoQ&oe=69BEA89C"}, "display_name": "Zombies At The Beach", "keywords": ["zombies", "dead", "action", "shooter", "fun"], "long_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nIt started as a normal day at the coast: bikinis, barbecues, beach balls. Then the undead washed ashore. No one knows where they came from, maybe a sunken cruise ship? Government experiment? Too many tacos? Doesn\u2019t matter. What matters is that they\u2019re relentless, and their digestive systems are somehow still fully functional. They're groaning, stumbling, and squatting... and you're the only one who can stop the mess.\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d", "short_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "http://www.biims.net/zombiesatthebeach", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "http://www.biims.net/zombiesatthebeach", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29674985145425760"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1741771553434682"}]}, "baseline_offer": {"id": "1741771553434682"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745333880, "status": "PUBLISHED", "id": "1741771553434682"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29693811876876420", "version": "1.0"}, "id": "1334269894511154", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"no
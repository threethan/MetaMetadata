1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jwjMZS04ucQ7kNvwHnLzy1&_nc_oc=AdoiDOhs4BM9M6CqKcua7BRBFYXKgI_gY3rv4jt7g40X3hiSd6BRBDdur3OkE-nYAoQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af582KbW5puPHIZWSirByoFt0cjHe_4hdSf9hCgeY-0j-g&oe=6A170DAC"}, {"file_name": "SCREEN5.png", "id": "1399961844688301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473400716_1399961848021634_2571649058256890100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSwRAm--wjoQ7kNvwHYlgyR&_nc_oc=AdpL8DEOew9mHZx3iN5rXghk4ja9X3SFHnAX6Cr8Svr3i06v3DBF_B4q-022PNnAed8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IbL7VJezWw1GV3Z6bOknalU6EVut5GJQKmIzXKJ0QXA&oe=6A16F1BC"}, {"file_name": "SCREEN4.png", "id": "2741667486017764", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822893_2741667489351097_6561293814754979234_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zz4jBOG2KpEQ7kNvwF5LfYD&_nc_oc=AdphyyFqeopJDdjSZttphMAwne5gXmpvnl2lnRbamaPpWHSR6tUvHCvW5eTQk2NM1Vc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eyKin8ziy6R10fIpiFD-Yh995x-SwVI8aMPGHtkXzbA&oe=6A16FED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "650350337840768", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821212_650350341174101_8166205700106355028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CAE3wFD-1gQ7kNvwFEL-0c&_nc_oc=AdouJTk3kpR_5EuM1eNDtFtI5jTGRx5rvC4-nW6WPryOHo7G6N7n9jZtGreNa3YSlr8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af410mqNkkBnbP0D4mgDtx7VhUglCc3EMK4QZirWiZS9WA&oe=6A16FD1C"}, "display_name": "Zombies At The Beach", "keywords": ["zombies", "dead", "action", "shooter", "fun"], "long_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nIt started as a normal day at the coast: bikinis, barbecues, beach balls. Then the undead washed ashore. No one knows where they came from, maybe a sunken cruise ship? Government experiment? Too many tacos? Doesn\u2019t matter. What matters is that they\u2019re relentless, and their digestive systems are somehow still fully functional. They're groaning, stumbling, and squatting... and you're the only one who can stop the mess.\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d", "short_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "http://www.biims.net/zombiesatthebeach", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "http://www.biims.net/zombiesatthebeach", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29674985145425760"}, "review_messages": []}]}, 
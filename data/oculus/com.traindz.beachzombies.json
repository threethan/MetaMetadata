_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830409_683729447359543_8402771687437330740_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W81WB9CJaWIQ7kNvwFZCBIf&_nc_oc=AdmZudgLVx3_LXqpurJwyCEfUfH5_MuKtul63GGhbx4CTcOQOxEIhlh5FEKyHTjljFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWLdkr9M96NyGdRFoZO0Yi7Fo-aitrslkStB_-VU4Waw&oe=69B00590"}]}, "id": "629915703367582", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "533473996224803", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394220_533473999558136_5809267742029165673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5SNcwe7mMAQ7kNvwHIydf2&_nc_oc=Adk0QJ7LhROR9uMURVjsYq5czcWr3B1K6m--VSSkjgtm4nmEROYmjBfWwq-YZJMQfpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1JmLznIhgOeikcWlx6pvpbd-CL7D2aLj83q8DFuZrUA&oe=69B029F6"}, {"file_name": "SCREEN2.png", "id": "1313754953041847", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392200_1313754956375180_1939830155282889688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpnIbbRu0roQ7kNvwEPO9FF&_nc_oc=Adn3uJQBrNovl3mWScKIfOoVp__xt8f78n45bdYk0JDDuFLYkuUTsfCdRvMd11Riz3M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEd9Lrga4k6kPjuOWGWy-mFWUUiBf0K_drm1bGQ376zg&oe=69B0023F"}, {"file_name": "SCREEN3.png", "id": "1358119508569360", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393831_1358119511902693_5908074355393884106_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_WXzN3Kp7UQ7kNvwF-sftC&_nc_oc=AdkLxLV3LVUkfaOVEfUoNM4MJleEbSCzLePt3D3sGCLoz2sDntn-e3dlraFTpNv6kPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEzzFrgT6G9CYWw4PCtIBcnAj32kTe_RZbiDFtEtdh6A&oe=69B0006C"}, {"file_name": "SCREEN5.png", "id": "1399961844688301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1399961848021634_2571649058256890100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ERvkCsJEQcQ7kNvwE9CrAE&_nc_oc=AdksPZUkaF00OobuJ5GzuPxFP4EQRHQj6u1tz_Ctt012UeKcKM-M-ea1mHvlykocV74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1ny4LeRsbGysnbf7-Z0S2KGeDCJhE5inNQdyHu80LRw&oe=69B01CBC"}, {"file_name": "SCREEN4.png", "id": "2741667486017764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822893_2741667489351097_6561293814754979234_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hte6aroaOZQQ7kNvwEKnrhh&_nc_oc=AdnMc8X6RIJSmngTEOaVlJ0VeN-HtBF5tDmSnROkzYABOdAKpSbr4SBNcVvMH0VyqcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0cGEjO3GQHlzUrAAI7aJ4OlEGB6eYNHk8m6QEV4rGcQ&oe=69B029D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "650350337840768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821212_650350341174101_8166205700106355028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmpSMoNS3CUQ7kNvwHMZfLh&_nc_oc=Adnb0CLNHcrjQtwIgWGgAXXOWVTmIM__UBVzVHuFJYm-_ZVzABWMuhhba2ldqzgtaN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxy9tNHRxzWxiL7LJrrlKikzIJCmDuHYY73zT8gPweEPA&oe=69B0281C"}, "display_name": "Zombies At The Beach", "keywords": ["zombies", "dead", "action", "shooter", "fun"], "long_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nIt started as a normal day at the coast: bikinis, barbecues, beach balls. Then the undead washed ashore. No one knows where they came from, maybe a sunken cruise ship? Government experiment? Too many tacos? Doesn\u2019t matter. What matters is that they\u2019re relentless, and their digestive systems are somehow still fully functional. They're groaning, stumbling, and squatting... and you're the only one who can stop the mess.\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d", "short_description": "\ud83d\udca9 Protect the beach from pooping zombies \ud83d\udca9\n\nYou\u2019re armed with dual VR pistols that feel fast, fluid, and incredibly satisfying. Blast zombies with precision. These aren\u2019t just any unread enemies, they\u2019re beach-crashing, brain-rotting, sand-pooping fiends! No one should have to walk barefoot through a zombie\u2019s... \u201cgift.\u201d"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "http://www.biims.net/zombiesatthebeach", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "http://www.biims.net/zombiesatthebeach", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29674985145425760"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1741771553434682"}]}, "baseline_offer": {"id": "1741771553434682"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745333880, "status": "PUBLISHED", "id": "1741771553434682"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29693811876876420", "version": "1.0"}, "id": "1334269894511154", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"no
.com&_nc_ss=7f20f&oh=00_AQRrEyYsGvddKNiExSPDm_oAGWTAPPAFG6crhogiTX8WMA&oe=6AFF0F0F"}, {"file_name": "processed-img-1790049714815-198.png", "id": "3831163530349106", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499314648_3831163533682439_7320092904155507205_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o952TERe5yMQ7kNvwHj6sGz&_nc_oc=Adq5I_nf-oDz6NHEad8nmJ9wpMQs6pRJAgPI9lul8vahEqE35tqclPdXKSSOVsSJymY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmi22pjbie-mfTfMPtOoPp2MPBJdYFzu87__5PHly4bQ&oe=6AFF3136"}, {"file_name": "processed-img-1790137483695-482 (2).png", "id": "1633910355194949", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831569_1633910358528282_8250063529848375700_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTDDwyf_RoIQ7kNvwGfxlqY&_nc_oc=AdpWvXaWNkIo1va_CCvAPVNnfM0NbttrjbTkZDh6uiePJGggfLxc7P8Rmt7V36YBdMY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQDiXfdQfi35LZX0sJgnhOL4feJF0IxcHnt1dOYTV0Aw&oe=6AFF2ADD"}, {"file_name": "processed-img-1790219221511-887.png", "id": "1010297202072150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646413489_1010297205405483_8419396754624184203_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9SNu9EPmYsQ7kNvwFT3qpP&_nc_oc=AdrCatbYrtrCKfhMS1pWNsslXBOCNYTAogvDgkjXM1UQOg6ys7YcFdwi1JuV_yHsLwo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRisJK79OyLqxw5JG5dME5q4ywdgsAGmfuXxRlaFVbCZA&oe=6AFF1268"}, {"file_name": "processed-img-1790223482169-395.png", "id": "962414339538103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/747795579_962414342871436_2162973041907870572_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssDC2keQdrsQ7kNvwFPDb3z&_nc_oc=AdqhvP-1mj8pS2qMjXNAZumHrZcrjN49JBt61OhlZQuUlAjzSrcsKNN2ShZkzvDwF-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKBbMJ_YIz7HTj-2j4Y4KItLWZW7vTP7mWzcGmziXS_g&oe=6AFF27F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "No Way Out VR", "keywords": ["puzzles", "escape", "horror", "thriller"], "long_description": "No Way Out VR is a VR escape room experience built around puzzles, exploration, and discovery. Play alone or bring your friends along\u2014the game can be enjoyed as a single player, but working together makes the experience even more immersive.\n\nSolve fun and challenging puzzles to progress through each level, discover hidden secrets, and buy cool cosmetics from the shop. Every room has something new to find, and every puzzle brings you one step further into becoming the best test subject at Neurox Labs.\n\nBut remember... there is no escape.\n\nThe journey doesn't end with the rooms. Story Mode is coming soon, bringing a deeper story and giving players more to discover about the world behind the game.\n\nMost importantly, DO NOT FAIL THE PUZZLES! If you do, you will be turned into a  horrifying monster, then thrown out, just like the others, left to die alone...", "short_description": "No Way Out VR is a VR escape room experience playable solo or with friends. Solve fun puzzles, progress through challenging levels, discover secrets, and buy cool cosmetics. Playing with others makes the experience even more immersive. there is even a Story Mode coming soon. Just remember\u2014there is no escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1eodekAwAaiV2XZIuxE3gzN1YflMG5eDMtgByvNihoeI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HiveMind Interactive", "support_website_url": null, "website_url": "https://chimerical-lolly-5bed86.netlify.app/#contact", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id
.com&_nc_ss=7f20f&oh=00_AQQiiEwjbWWQQhLlcgK2JNW904QqSn2zd4abz7ZZ_rY54A&oe=6AFDBD8F"}, {"file_name": "processed-img-1790049714815-198.png", "id": "3831163530349106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_3831163533682439_7320092904155507205_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o952TERe5yMQ7kNvwEJ6pKj&_nc_oc=Ado6jRjj9FJ3QPR8W7H3QsUb474B283jbRKriiJGMi_L0_kDakBa0wBJxDyjYClIrzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtfNBIEewS-87wkB7Z2r2uTAP6QU1kXriUfvdCmm8-Pw&oe=6AFDDFB6"}, {"file_name": "processed-img-1790137483695-482 (2).png", "id": "1633910355194949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831569_1633910358528282_8250063529848375700_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixfXHlkuNpsQ7kNvwHesFoi&_nc_oc=AdreeRZQLRXQWxj7doo4HOh6H0V9mQOpfkNauMbXXzvZDa9JdHQ6liqCeB2kVOjjtLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiHBLc330MYhzvx77MVE-YZrF_sncOwKuPzdY9JTlSig&oe=6AFDD95D"}, {"file_name": "processed-img-1790219221511-887.png", "id": "1010297202072150", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646413489_1010297205405483_8419396754624184203_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz8nLGx9OdcQ7kNvwEFCYYr&_nc_oc=AdpuTxJoXqba6OsG6sPEartKa2NOiEp8zAERiPvhp3fpxJYCcj6RI06tY8cgF2sB7f8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5CY9NO4vDJgfWhwMhcHn74fpbf8HUTXtb9llYoiXBVg&oe=6AFDC0E8"}, {"file_name": "processed-img-1790223482169-395.png", "id": "962414339538103", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/747795579_962414342871436_2162973041907870572_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssDC2keQdrsQ7kNvwHeo5YS&_nc_oc=AdqkPnMROlU-b4po6tw6aWjHAaFYxcV_p-5XN0dfgEsoj8vRQpuMEhGR5L5U5zCww9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFRanGKn4uJ5inGDNe1b6wx3OsUYeXngNdxY8r0sRErQ&oe=6AFDD677"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "No Way Out VR", "keywords": ["puzzles", "escape", "horror", "thriller"], "long_description": "No Way Out VR is a VR escape room experience built around puzzles, exploration, and discovery. Play alone or bring your friends along\u2014the game can be enjoyed as a single player, but working together makes the experience even more immersive.\n\nSolve fun and challenging puzzles to progress through each level, discover hidden secrets, and buy cool cosmetics from the shop. Every room has something new to find, and every puzzle brings you one step further into becoming the best test subject at Neurox Labs.\n\nBut remember... there is no escape.\n\nThe journey doesn't end with the rooms. Story Mode is coming soon, bringing a deeper story and giving players more to discover about the world behind the game.\n\nMost importantly, DO NOT FAIL THE PUZZLES! If you do, you will be turned into a  horrifying monster, then thrown out, just like the others, left to die alone...", "short_description": "No Way Out VR is a VR escape room experience playable solo or with friends. Solve fun puzzles, progress through challenging levels, discover secrets, and buy cool cosmetics. Playing with others makes the experience even more immersive. there is even a Story Mode coming soon. Just remember\u2014there is no escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1eodekAwAaiV2XZIuxE3gzN1YflMG5eDMtgByvNihoeI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HiveMind Interactive", "support_website_url": null, "website_url": "https://chimerical-lolly-5bed86.netlify.app/#contact", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id
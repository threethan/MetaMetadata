.com&_nc_ss=7f20f&oh=00_AQQ7rZwqrN8jMNV3hv-4CjSQLS52esJOiUnEbXKEnNQMJg&oe=6AFC6C0F"}, {"file_name": "processed-img-1790049714815-198.png", "id": "3831163530349106", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499314648_3831163533682439_7320092904155507205_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o952TERe5yMQ7kNvwEfNWGF&_nc_oc=AdoaDpu61TEmo5Q2M8r5XiK-eao3w-bF9MZpjq4-Y3zuop36YCH7UiHEPOi_ZkuBiV8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSxlEg_18d38w5HeYJHlnyqMukZoI6ZNIL9Z0VYDrerA&oe=6AFC8E36"}, {"file_name": "processed-img-1790137483695-482 (2).png", "id": "1633910355194949", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831569_1633910358528282_8250063529848375700_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixfXHlkuNpsQ7kNvwESsl6v&_nc_oc=Adr-m7usoOZEwXOrVtq6YuLtglp0tCVRV3JRC56N5zlFTeZIMWWM6o3h8jrOCePcFo4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMEsmcjscUxmDkybaJTVDofOOIi0SjYQVZlGUY5Yfx1g&oe=6AFC87DD"}, {"file_name": "processed-img-1790219221511-887.png", "id": "1010297202072150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646413489_1010297205405483_8419396754624184203_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz8nLGx9OdcQ7kNvwGOiTbZ&_nc_oc=AdqQoXmRhKHgUkxt1RGsOJ5NjYiYpJhzD-G3IppvvN0yXFwMlOhUygDgYfFhyTHGGHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlfPNwXN1edlWShroWGxinziCZxMXbBQhGkRMjz16EGQ&oe=6AFC6F68"}, {"file_name": "processed-img-1790223482169-395.png", "id": "962414339538103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/747795579_962414342871436_2162973041907870572_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uyfp6HlYhjwQ7kNvwHpWCBc&_nc_oc=AdpLrzJZAZarwYdmOQcJTkgDs37cU6qt4mMCYThj-T2Mhv7Oclxhj5F5qL75vpPnjFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrxs3PIzU25ypfGsqoDaKo03vjpWtebZCmtirmxfzDdg&oe=6AFC84F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "No Way Out VR", "keywords": ["puzzles", "escape", "horror", "thriller"], "long_description": "No Way Out VR is a VR escape room experience built around puzzles, exploration, and discovery. Play alone or bring your friends along\u2014the game can be enjoyed as a single player, but working together makes the experience even more immersive.\n\nSolve fun and challenging puzzles to progress through each level, discover hidden secrets, and buy cool cosmetics from the shop. Every room has something new to find, and every puzzle brings you one step further into becoming the best test subject at Neurox Labs.\n\nBut remember... there is no escape.\n\nThe journey doesn't end with the rooms. Story Mode is coming soon, bringing a deeper story and giving players more to discover about the world behind the game.\n\nMost importantly, DO NOT FAIL THE PUZZLES! If you do, you will be turned into a  horrifying monster, then thrown out, just like the others, left to die alone...", "short_description": "No Way Out VR is a VR escape room experience playable solo or with friends. Solve fun puzzles, progress through challenging levels, discover secrets, and buy cool cosmetics. Playing with others makes the experience even more immersive. there is even a Story Mode coming soon. Just remember\u2014there is no escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1eodekAwAaiV2XZIuxE3gzN1YflMG5eDMtgByvNihoeI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HiveMind Interactive", "support_website_url": null, "website_url": "https://chimerical-lolly-5bed86.netlify.app/#contact", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id
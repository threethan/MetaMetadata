content-sea5-1.oculuscdn.com/v/t64.5771-25/499314648_3831163533682439_7320092904155507205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_gY-Mt4EcYQ7kNvwGuSDHB&_nc_oc=Adr-1e3OpvzQNpqOL0nzt4E5u-Gk3CAqlXvVgpiFPxnzjowWqr5vedT231WdCW4mIkU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNWqMMJGpvV21P9ideDgYI2d9pqhfwBCZriD4Nlw5e2A&oe=6AF353B6"}, {"file_name": "processed-img-1790137483695-482 (2).png", "id": "1633910355194949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_1633910358528282_8250063529848375700_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEektQotnYUQ7kNvwGykGNz&_nc_oc=AdrOQ9nNHikhIMIy8EJVFwxet77PlLRlv1DXiuXxxKb6wdLjEVkjq-aJiNYTe_ewZho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVadttw7wz8Gv88uX_03tAvM2v0J0Yjk6gWuMI_zBBwg&oe=6AF34D5D"}, {"file_name": "processed-img-1790219221511-887.png", "id": "1010297202072150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646413489_1010297205405483_8419396754624184203_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kw_xyJSZqQQ7kNvwG0lKW7&_nc_oc=Ado-rgMsVx0TiFrhKUO4-o1uejAbLHXTgxzbQUo6EhqYivE-e8yh-C2sscXOF07-_NY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYdFwk2hMC_-DjGUcT41ffo6idGfwUsobtLQFi8n7Fbw&oe=6AF334E8"}, {"file_name": "processed-img-1790223482169-395.png", "id": "962414339538103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/747795579_962414342871436_2162973041907870572_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=878yOw118GcQ7kNvwGQZtez&_nc_oc=AdoC33wEBu_M3VlOr-HtaIb68xNoPdDuQlkkYWsoIec-83mEtW1bvIdBJHKyedEGQzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSE3_Ch9VnXuRbseh8s84Oms7G048a3d3OJ2B2LDyQ-Q&oe=6AF34A77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "No Way Out VR", "keywords": ["puzzles", "escape", "horror", "thriller"], "long_description": "No Way Out VR is a VR escape room experience built around puzzles, exploration, and discovery. Play alone or bring your friends along\u2014the game can be enjoyed as a single player, but working together makes the experience even more immersive.\n\nSolve fun and challenging puzzles to progress through each level, discover hidden secrets, and buy cool cosmetics from the shop. Every room has something new to find, and every puzzle brings you one step further into becoming the best test subject at Neurox Labs.\n\nBut remember... there is no escape.\n\nThe journey doesn't end with the rooms. Story Mode is coming soon, bringing a deeper story and giving players more to discover about the world behind the game.\n\nMost importantly, DO NOT FAIL THE PUZZLES! If you do, you will be turned into a  horrifying monster, then thrown out, just like the others, left to die alone...", "short_description": "No Way Out VR is a VR escape room experience playable solo or with friends. Solve fun puzzles, progress through challenging levels, discover secrets, and buy cool cosmetics. Playing with others makes the experience even more immersive. there is even a Story Mode coming soon. Just remember\u2014there is no escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1eodekAwAaiV2XZIuxE3gzN1YflMG5eDMtgByvNihoeI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HiveMind Interactive", "support_website_url": null, "website_url": "https://chimerical-lolly-5bed86.netlify.app/#contact", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
.com&_nc_ss=7f30f&oh=00_AQTqK9EG0TbZuidmheTgIhLwjxHnBfK-TagS5g2ZuWtC2g&oe=6B0C764F"}, {"file_name": "processed-img-1790049714815-198.png", "id": "3831163530349106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_3831163533682439_7320092904155507205_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7-IgjEGR4gQ7kNvwFgzEWw&_nc_oc=Adq6deKy0FAaXZUnlkf6p4ZxJom1A7gfneuZz5yhTD2yqkBzlldqDJg2aXf8Ppywy7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAVNh00NUlD-ONHDuO1pENavKsB1_Uz9ZE13FGOGt_Ww&oe=6B0C6036"}, {"file_name": "processed-img-1790137483695-482 (2).png", "id": "1633910355194949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831569_1633910358528282_8250063529848375700_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMOeFPtIdCsQ7kNvwHYqfBd&_nc_oc=AdqtaMD91JLvHela1XbGovgAzYHTbuacZzfAJKNpQ633rWfNRo7tjQrwc_IQa_h-Dfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTwIBxaGEKoZkMN7QQ4s5VK0-DmgSksinSi7ih0so3edw&oe=6B0C59DD"}, {"file_name": "processed-img-1790219221511-887.png", "id": "1010297202072150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/646413489_1010297205405483_8419396754624184203_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWaLjZqFL3UQ7kNvwF3hniS&_nc_oc=AdrpP5CAXqaQoXkuocXxS0RWZJ5EBwwBNenN7d6n-pm1lPgnxli7b_PWM-Mv5oHPCW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUH_1t3VkJHiwvPkpOuNLn-qLoDnww_fOfeBZQhMP5ow&oe=6B0C79A8"}, {"file_name": "processed-img-1790223482169-395.png", "id": "962414339538103", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/747795579_962414342871436_2162973041907870572_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHSLDfsF7d8Q7kNvwGWDx0I&_nc_oc=Adq9iLih1SA8v_2-UX639TUD5VuyBRN6pm6nwj9ReZWCP2MImUgVA3Qdf2_0flmkMO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-32nbpstNCH6dHTJzfXM1ZhdnRT3DglrdUzecz2jntQ&oe=6B0C56F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "No Way Out VR", "keywords": ["puzzles", "escape", "horror", "thriller"], "long_description": "No Way Out VR is a VR escape room experience built around puzzles, exploration, and discovery. Play alone or bring your friends along\u2014the game can be enjoyed as a single player, but working together makes the experience even more immersive.\n\nSolve fun and challenging puzzles to progress through each level, discover hidden secrets, and buy cool cosmetics from the shop. Every room has something new to find, and every puzzle brings you one step further into becoming the best test subject at Neurox Labs.\n\nBut remember... there is no escape.\n\nThe journey doesn't end with the rooms. Story Mode is coming soon, bringing a deeper story and giving players more to discover about the world behind the game.\n\nMost importantly, DO NOT FAIL THE PUZZLES! If you do, you will be turned into a  horrifying monster, then thrown out, just like the others, left to die alone...", "short_description": "No Way Out VR is a VR escape room experience playable solo or with friends. Solve fun puzzles, progress through challenging levels, discover secrets, and buy cool cosmetics. Playing with others makes the experience even more immersive. there is even a Story Mode coming soon. Just remember\u2014there is no escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1eodekAwAaiV2XZIuxE3gzN1YflMG5eDMtgByvNihoeI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HiveMind Interactive", "support_website_url": null, "website_url": "https://chimerical-lolly-5bed86.netlify.app/#contact", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id
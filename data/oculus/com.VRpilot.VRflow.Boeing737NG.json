U3X4sEkQ&oe=6B0DC95F"}, {"file_name": "Screen5_VRflowB737NG_Demo_2560x1440.png", "id": "244650567208824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982617_244650570542157_1386516099652708795_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q90oMCyKm0Q7kNvwGL6qoj&_nc_oc=Adror9IWI5KhhkPjER9dI73vBCmJ2-N7tOMrvLgX3UJv3ys4zaurre8ao_d5tiPOzPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS--ze38FAH7bUK-56cq5aWBGSw-4lIjI3sQVXayTcfsQ&oe=6B0DA37D"}, {"file_name": "Screen4_VRflowB737NG_2560x1440.png", "id": "175198641330686", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001667_175198644664019_6768489818616860112_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EluZiDvtCvcQ7kNvwESuXKI&_nc_oc=Ado9y3YYxs_TdZvAVaOem_8G8IxT_1rFIC6vPrXqcjjd4LbefJn_2zozelE5vh18GUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwYa13l5Kb9VpGgtYN-R9Waa5qV-JYRqM5ZCf2hrnX1w&oe=6B0DC1EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRflow Oculus Store trailer_thumb.png", "id": "1611511202379733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974745_1611511209046399_4755909789788347758_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwbtESXKYvwQ7kNvwF2YArj&_nc_oc=AdqBbR72VWfUDZ3A2EfsylGOTQAcha-nTr42M3jNYuQopOwhzVqJAULuJsBxruombjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRMxX6zvshrEMVwNY5FfCcoRDMAhxFCFbP4G4b1qMnTQ&oe=6B0DAD0D"}, "display_name": "VRflow B737NG", "keywords": ["737", "boeing"], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow B737NG is the interactive cockpit procedure trainer for pilots. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, train with an automatic crewmember and much more.\n\n14 normal procedures and 12 memory items are included with dynamic checklists, step by step explanations and task sharing with the automatic crew member.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow B737NG is the interactive cockpit procedure trainer for pilots, used by airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their initial or recurring type rating training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27262422533342600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982685_339987801142652_8292519
=AdpRkJo-6X218H0NVeNW7LDoUZLoG-Z_Fu2xwmiRMySPgN8B9U0JzPioJGYh_4hxmuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXy39sJM5bxkgzQ7Cd69HPmryqi3xogGHWfl0nDQQfgXA&oe=6B0F1ADF"}, {"file_name": "Screen5_VRflowB737NG_Demo_2560x1440.png", "id": "244650567208824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982617_244650570542157_1386516099652708795_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q90oMCyKm0Q7kNvwFohOYQ&_nc_oc=AdoPcXmRHTLRpTsltPe9FtT0lBkwePHwtXYMaGqa59J6tA1MHa7YA34pxUzNzm_JtUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXdD1-hyq6AqtwOvCIO02X4v7Tdk6GDsT9HY7KPRzXCw&oe=6B0EF4FD"}, {"file_name": "Screen4_VRflowB737NG_2560x1440.png", "id": "175198641330686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001667_175198644664019_6768489818616860112_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YngQFeYfT10Q7kNvwFAASYH&_nc_oc=Adpr-zKPoEdtS5eUWN5utwYacodj00ZfbRFtDfqFinzFJssyz9MUJs0nb6tFX7bKF6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVkjSovSsUGYx8EpN16d0wPHGJv2IuTjOWCrwzE00D65g&oe=6B0F136B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRflow Oculus Store trailer_thumb.png", "id": "1611511202379733", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974745_1611511209046399_4755909789788347758_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etJ1-jjXNBsQ7kNvwH6zuxL&_nc_oc=Adob-Tm7uU_xyWn26KIAEZTercBoXGrG3b73BCPQSCdrkdKclu1KrOtqzRbncFWa678&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYjpr7x1rwxL42_BQPppHMRGw343noGXcpBUr8_LkM4A&oe=6B0EFE8D"}, "display_name": "VRflow B737NG", "keywords": [], "long_description": "VRflow B737NG is the interactive cockpit procedure trainer for pilots. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, train with an automatic crewmember and much more.\n\nThe following procedures are included: Electrical Power Up, Preliminary Preflight, Preflight Procedure (F/O), Preflight Procedure (CPT), Before Start, Pushback, Engine Start, Before Taxi, Before Takeoff, Takeoff, After Landing, Shutdown, Secure and Electrical Power Down.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.", "short_description": "VRflow B737NG is the interactive cockpit procedure trainer for pilots. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their initial or recurring type rating training.\n\nAll purchases of VRflow will be upgraded as we add more procedures, fix bugs and make VRflow better."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "357082555987214"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "
6pZXMGgA&oe=6B084B1F"}, {"file_name": "Screen5_VRflowB737NG_Demo_2560x1440.png", "id": "244650567208824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982617_244650570542157_1386516099652708795_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYctyfOfAu4Q7kNvwGAQgB8&_nc_oc=AdrvjPem538FQHNY0kJJEuNQ2mKoYh8UTYLc5WHBinDEEFE38A0JUCabf1Szw11S5ZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFo5URa0x5JlGfPYNknu4qS263DXe0yJ61gBM2wUwBjw&oe=6B085D7D"}, {"file_name": "Screen4_VRflowB737NG_2560x1440.png", "id": "175198641330686", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001667_175198644664019_6768489818616860112_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1W7u85WMKnYQ7kNvwHb5ULQ&_nc_oc=AdpRTpMCGLGBJ8XKjL7w3gPFpQbt7j9T2OctoRkxK0CxSmcRySaK-gQN4nHliRl_sCU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD4hhQZhCy1nLCdj-gYZ0dEtjTXO1PAFFWivJ1M5x7dA&oe=6B0843AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRflow Oculus Store trailer_thumb.png", "id": "1611511202379733", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974745_1611511209046399_4755909789788347758_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-m8rKQTnJLAQ7kNvwHvmIbe&_nc_oc=Adpy06ZdublTR_-UBTjDqd1V-gOdy3I4BIo-ymujPzbcE7D43W4SK5zz-WI8Wdwa67A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnqjzvFf3AZZUKoQZ6u1uRQYo2lo7v1KEHM2C2EBIzDg&oe=6B08670D"}, "display_name": "VRflow B737NG", "keywords": ["737", "boeing"], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow B737NG is the interactive cockpit procedure trainer for pilots. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, train with an automatic crewmember and much more.\n\n14 normal procedures and 12 memory items are included with dynamic checklists, step by step explanations and task sharing with the automatic crew member.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow B737NG is the interactive cockpit procedure trainer for pilots, used by airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their initial or recurring type rating training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27262422533342600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982685_339987801142652_8292519
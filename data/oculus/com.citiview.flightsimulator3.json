25_317339590204860350_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLi1ux40AwYQ7kNvwHCkhmR&_nc_oc=Ado7q2IV9m-DIP0ROm9RtfiAFdGUCdpwVorRW9cCfiCwlhAWPeUyiVA0LlhQnMq_pbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQegW21CgyUo90fQc7v03iSZEZQ27IMDqL6fV_ZoZm0_Q&oe=6AFC84CC"}, {"file_name": "screenshot_1.png", "id": "28737286969235960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299928_28737286982569292_1430250830569870575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8BM5Lvh5E0Q7kNvwGeiwQf&_nc_oc=AdrT713GwMn_2YwE4QtwQiDNATnGEpbbraIQe_fG9z3WeB_SfX8nOeMDpnLHyqkAfiw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvQFFDeR8HyjedsgBH0tGhg1lNeFhaywKo2UCIo-UnyQ&oe=6AFC7129"}, {"file_name": "screenshot_4.png", "id": "1732723714451165", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499294644_1732723717784498_415327055193591706_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwsZV_3ZvWAQ7kNvwEUS1S7&_nc_oc=Ado1_TALv2HICdzcafobvJEW_usZMwlz-pd8k4A3VcB2PR4OR_SRoK5eVO-F6RWFrqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4O4Sjx_YS4lD8zc1YSzuYTcoymIND3HgyELxK7ArSkQ&oe=6AFC69FA"}, {"file_name": "screenshot_5.png", "id": "4521976018016981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/748811223_4521976021350314_641741987773345721_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPbdmYZJ8RUQ7kNvwGi_u1F&_nc_oc=AdpPDmnNpsrS1A1LfbTv3MJHeAXHNWWYOTyNBH4NutTXf4r34umEHa3qJ1rPwyHruqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSV3NwkMFjqtn4BvIBzHISzytFTSBjk_dS-nPyaY_KhA&oe=6AFC8B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1102852679021159", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825497_1102852682354492_2299460739969351428_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCs77hP8OU4Q7kNvwEMw_6e&_nc_oc=Adq2AW0ZTgQFx541sXL5YEiXbk9KQaxsZ29RGk36gz20sK0hY9e5f5D12miWxblDhIQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeZI1Efz2LYVTwVhY1_DsfDeAEca8XOhoyHIpym3-nrQ&oe=6AFC7768"}, "display_name": "Flight Simulator 3", "keywords": ["flight", "simulator", "airplane", "helicopter", "multiplayer"], "long_description": "Flight Simulator 3 starts in your own hangar. Walk around your private jet, helicopter and fighter jet, climb the work platforms, and make each one yours.\n\nTHE PAINT SHOP\nPick body, trim and stripe colours, a gloss, matte, metallic, chrome or pearl finish, a cheat line, pinstripes or a swoosh - or one of eight schemes. The new paint sweeps on nose to tail.\n\nPOWER WASH IT\nYour aircraft come home dirty: bugs on the leading edges, soot behind the engines, runway grime underneath. Grab the pressure washer, switch between pencil and fan, and blast it clean wherever the water lands. Get it spotless for a showroom shine.\n\nTHREE AIRCRAFT\nA business jet with a glass cockpit and autopilot, a helicopter you can hover anywhere, and a fighter with a live head-up display, 9 G and an afterburner. Break the sound barrier or cruise at sunset.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code, up to eight pilots. Join up on a friend's wing or ride along in their right-hand seat. Friends see your paint job. Voice chat stays off until you turn it on.\n\nMISSIONS AND YOUR LOGBOOK\nScramble, Sound Barrier, Airshow, Formation Flight, canyon and city runs and scored landings. The logbook on your hangar wall keeps your hours, landings and pilot rank.", "short_description": "Your own hangar, three aircraft and a whole island to fly. Paint your private jet, helicopter and fighter any colour you like, power wash the grime off after every flight, then take them up alone or online with friends. Real working cockpits, a head-up display, afterburner and ride-along co-op."}]}, "developer_na
actions and assembly processes. Experience the joy of assembling complex armored vehicle models on a physical tabletop. Once assembled, you can showcase your masterpiece on a virtual display. In our game, you can encounter complex and exquisite armored vehicle models, offering an unprecedented immersive hands-on assembly experience. Get ready to enter the world of mechanical engineering, showcase your skills, and assemble stunning armored vehicles.", "short_description": "Mixed-Reality Armored Vehicle Assembly\uff01"}]}, "developer_name": null, "developer_privacy_policy_url": "https://modelmaker-412202.firebaseapp.com/", "developer_terms_of_service_url": null, "publisher_name": "YIGeudio", "support_website_url": null, "website_url": "https://maker-4112202.firebaseapp.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8577198372332587"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003286_1856552141492003_8902766803572104914_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I9n658PwFUQ7kNvwE9FebW&_nc_oc=AdoUNmABqam6ktDXQc0T2Rk7R-KSRid_lXY9FLPn2IrN2mU45JK5cuE_VHOjt_UTIw4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k1CnsyQxl6QA2fuU4PMnC8t7UGpJZQ_OXdq2xnj_-DQ&oe=6A1AECB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Armour Maker", "platfor
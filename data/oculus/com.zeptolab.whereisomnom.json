8r-Oj1UueO0Q7kNvwEZ3S_k&_nc_oc=AdpXKDKmgdueJDpO8gKImWPNH3Es86zZKthHU8UEZybRe0MDGlgeYd73nbHoKG11234&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjREFVrnC9R9yPznuDVRBodLr_D6G5ti-EsKz-_2Z4cQ&oe=6AEF3131"}, {"file_name": "migrated_image.png", "id": "531294454476899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_385051651912026_6693593581766049792_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEiN55TQU7wQ7kNvwGj18T4&_nc_oc=Adqw2mAEuPzcIgZFW7XMQboJ2W96p07glvZ5s6--BNNzlrTXxT-pdZ9HxfnvttZkJOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCRVZRw0pb-fwacuqY-h8VLnlbpFa7Y71pWTOURcBFOA&oe=6AEF495A"}, {"file_name": "migrated_image.png", "id": "202082287734132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_133063643988103_767992490996269056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjHQTSkuylkQ7kNvwHH0Aq3&_nc_oc=Adquoq0dGbPmrlGkaH-iuJQ3UToov9f8t1Y4WthYuhnmQ5dvsT8hIl7Lyuq0TOvNzdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmmIrlco-U1B8tIxS087fIHDHz8G3jDdqW7ehtHSIpAA&oe=6AEF4289"}, {"file_name": "migrated_image.png", "id": "193310761966067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_711651919020572_122350372583899136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDGj1JxTYfsQ7kNvwFp_yg6&_nc_oc=AdpgF-Zng8G2QvoiATBjT5LwpokY4Ja5ur3zfAN_eVAJgsEMqEghMZbCH-4S1oZZ0LI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6q2QWAkV7B0UaV2JGy_arkDcNGD_DfQZB_fBZGMCx0g&oe=6AEF530A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where's Om Nom?", "keywords": ["puzzle", "games", "hidden", "object", "adventure"], "long_description": "Oh no! Om Nom broke the portal in Professor\u2019s laboratory and fell into it! Follow him into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games. Enjoy the innovative transition of your favorite character from 2D to 3D in this unique VR experience!\n* 5 breathtaking worlds to explore in 360\u00b0: from prehistorical forest to the future city and even Mars!\n* Innovative hidden object mechanics: try to catch Om Nom and tame him by feeding candies, then find all objects on the level to fix the portal and return home.\n* Randomly generated tasks in changing environment: try to spot 3D objects under different perspectives, find Om Nom in the darkness and use your hi-tech flashlight to see through things on the level.\n* Cuteness overload: watch Om Nom\u2019s adorable reactions to your actions and surrounding locations!\nPlease note: Gear VR Controller is required to play the game.\n\nIn case of problems write to support@zeptolab.com", "short_description": "Follow Om Nom into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cuttherope.net/privacy", "developer_terms_of_service_url": "https://www.cuttherope.net/terms", "publisher_name": "ZeptoLab UK Limited", "support_website_url": null, "website_url": "https://www.zeptolab.com/contact/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "313914954033858"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_345757019187972_5897521152934281216_n.png?stp=dst-png_s360x360&_nc_cat=100&cc
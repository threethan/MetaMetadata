com/v/t64.5771-25/11162690_711651919020572_122350372583899136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjRV7vk-ff4Q7kNvwGqbIPF&_nc_oc=Adoh_SvuoBrnMeEqNeLKHh6tVPYBHTBYol0bHZ0vbS7Hx8JlTxdjDffzz4U5NTYGoXY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3um1XQPosV_wFCDWc7dPSUJbgSw5N5oNU41P2ACzB_dw&oe=69F1FACA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WhereIsOmNom_CoverArt.png", "id": "1732345657068483", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162693_1732345663735149_5600184518402113536_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLK4UYDtjHoQ7kNvwF5RyRV&_nc_oc=AdpPidy2wAQyQVBmRCnqfqsosb5WM6m6KAiOloU81I7_BPJyKpDTTWGF70Pn17zzQLc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0fomyqOb4qIigK2iNqSjMlE8zxdDnWx4slf59UrGRxzQ&oe=69F1F0F1"}, "display_name": "Where's Om Nom?", "keywords": ["puzzle", "games", "hidden", "object", "adventure"], "long_description": "Oh no! Om Nom broke the portal in Professor\u2019s laboratory and fell into it! Follow him into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games. Enjoy the innovative transition of your favorite character from 2D to 3D in this unique VR experience!\n* 5 breathtaking worlds to explore in 360\u00b0: from prehistorical forest to the future city and even Mars!\n* Innovative hidden object mechanics: try to catch Om Nom and tame him by feeding candies, then find all objects on the level to fix the portal and return home.\n* Randomly generated tasks in changing environment: try to spot 3D objects under different perspectives, find Om Nom in the darkness and use your hi-tech flashlight to see through things on the level.\n* Cuteness overload: watch Om Nom\u2019s adorable reactions to your actions and surrounding locations!\nPlease note: Gear VR Controller is required to play the game.", "short_description": "Follow Om Nom into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cuttherope.net/privacy", "developer_terms_of_service_url": "https://www.cuttherope.net/terms", "publisher_name": "ZeptoLab UK Limited", "support_website_url": null, "website_url": "https://www.cuttherope.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623733895385385"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id": "2702007596485764"}, {"status": "PUBLISHED", "id": "242232709859611"}, {"status": "PUBLISHED", "id": "563422604280076"}, {"status": "PUBLISHED", "id": "282098393167098"}, {"status": "PUBLISHED", "id": "221386668793711"}, {"status": "PUBLISHED", "id": "2025619674363193"}, {"status": "PUBLISHED", "id": "519298431861307"}, {"status": "PUBLISHED", "id": "2028742524012135"}, {"status": "PUBLISHED", "id": "485951705212117"}, {"status": "PUBLISHED", "id": "2669921916392299"}, {"status": "PUBLISHED", "id": "501341386939583"}, {"status": "PUBLISHED", "id": "666374067380209"}, {"status": "CANCELLED", "id": "167881650479920"}, {"status": "PUBLISHED", "id": "2467327429957394"}, {"status": "PUBLISHED", "id": "346459149534415"}, {"status": "CANCELLED", "id": "1556108231150634"}, {"status": "PUBLISHED", "id": "1719585528072981"}, {"status": "PUBLISHED", "id": "1220947551379190"}, {"status": "PUBLISHED", "id": "1894816920847254"}, {"status": "PUBLISHED", "id
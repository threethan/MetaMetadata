t=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfviTt2j50oCaQ8f-mFXzdv-3KZ1WdjK_oRsybpVNWTR6Q&oe=69986B31"}, {"file_name": "migrated_image.png", "id": "531294454476899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162686_385051651912026_6693593581766049792_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfSs0lOSfL4Q7kNvwGqlDmu&_nc_oc=Adl0RTWWtHmxq5Z_2LYSOg5PqFifNURDhSdqhp55v5tpLAmw83W_8jaYTSeNMhuW8lE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft8EzwJ_RoY0YAXW7ifq0tQFVjFvlNrmuXUmQ07mfz2og&oe=69984B1A"}, {"file_name": "migrated_image.png", "id": "202082287734132", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_133063643988103_767992490996269056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL5ytIMT6YEQ7kNvwFL7nxB&_nc_oc=AdksALKxyzpTu641szU4_jqxlcJe1-v8kz934rcdkp4Xy8QF-h4Wq_2LaSWq0wY7l_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuA1ne4t0FfQ_Z95k3C12TKMdRSS46BP4cyeAJUols0hg&oe=69984449"}, {"file_name": "migrated_image.png", "id": "193310761966067", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162690_711651919020572_122350372583899136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMGevp224tkQ7kNvwEcCvfl&_nc_oc=AdmbYNDqalZnDFkWIyIqDAIy25B80A0RtEhrT8Zn_YT2agwCUzSuBQL2y_JO5RPN6Ls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvh3NELxLLyM6CotYT1MgBhkA5gmULUJ1Pvs4WA-wSPxA&oe=699854CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where's Om Nom?", "keywords": ["puzzle", "games", "hidden", "object", "adventure"], "long_description": "Oh no! Om Nom broke the portal in Professor\u2019s laboratory and fell into it! Follow him into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games. Enjoy the innovative transition of your favorite character from 2D to 3D in this unique VR experience!\n* 5 breathtaking worlds to explore in 360\u00b0: from prehistorical forest to the future city and even Mars!\n* Innovative hidden object mechanics: try to catch Om Nom and tame him by feeding candies, then find all objects on the level to fix the portal and return home.\n* Randomly generated tasks in changing environment: try to spot 3D objects under different perspectives, find Om Nom in the darkness and use your hi-tech flashlight to see through things on the level.\n* Cuteness overload: watch Om Nom\u2019s adorable reactions to your actions and surrounding locations!\nPlease note: Gear VR Controller is required to play the game.\n\nIn case of problems write to support@zeptolab.com", "short_description": "Follow Om Nom into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cuttherope.net/privacy", "developer_terms_of_service_url": "https://www.cuttherope.net/terms", "publisher_name": "ZeptoLab UK Limited", "support_website_url": null, "website_url": "https://www.zeptolab.com/contact/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "313914954033858"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162718_345757019187972_5897521152934281216_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa33QGpxUD8Q7kNvwGKE8nO&_nc_oc=AdkMkF-Qkv03XUpVkfs3tCLW8xxrYmpTVwXLWw1Dqoz_9p_9Qnz1qoZ3oJbNQoVP3ac&_nc_zt=3&_nc_ht=scontent-sjc
t=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs4Fzd4wtV1e98m8H3kxGuByovvvjhaKP2Z6nD8lzn6Og&oe=699DB131"}, {"file_name": "migrated_image.png", "id": "531294454476899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_385051651912026_6693593581766049792_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZBcpEYu5mMQ7kNvwHp-0EF&_nc_oc=AdkTpC4WRb8SOxmVdaChOnm-x92weRAPJksPxi6tHpzAbDZ95AMEBsyeXcE0jDaa3MA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0S-ZKzd-Tiys3EMDGPKWtIeAAuHDelMhcNYHATqVHNQ&oe=699D911A"}, {"file_name": "migrated_image.png", "id": "202082287734132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162707_133063643988103_767992490996269056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elSY4FAoQJQQ7kNvwEWpoYM&_nc_oc=AdlcG1dvkOCoGEsMKY3E8tiVXLvIMjcNPhj5UcQhc6d6-YlmGQkjjmFHSuXKugxoWXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPYYNlDkc1FEg0mMEAfD06pnBlKhZI3uExuvFqqT74-w&oe=699D8A49"}, {"file_name": "migrated_image.png", "id": "193310761966067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_711651919020572_122350372583899136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KoZM_BVtGkQ7kNvwEICYrV&_nc_oc=AdlhaIxBa8eB8xS8njLzw21Ukvm-CdH9TpVYfOGK5esyMYUOtnKDQFJKL_rw41l8-98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstLEDtKP_LEZE8P-R3LN-8oVwiGr3sxvuZjGZeSzvbVw&oe=699D9ACA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where's Om Nom?", "keywords": ["puzzle", "games", "hidden", "object", "adventure"], "long_description": "Oh no! Om Nom broke the portal in Professor\u2019s laboratory and fell into it! Follow him into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games. Enjoy the innovative transition of your favorite character from 2D to 3D in this unique VR experience!\n* 5 breathtaking worlds to explore in 360\u00b0: from prehistorical forest to the future city and even Mars!\n* Innovative hidden object mechanics: try to catch Om Nom and tame him by feeding candies, then find all objects on the level to fix the portal and return home.\n* Randomly generated tasks in changing environment: try to spot 3D objects under different perspectives, find Om Nom in the darkness and use your hi-tech flashlight to see through things on the level.\n* Cuteness overload: watch Om Nom\u2019s adorable reactions to your actions and surrounding locations!\nPlease note: Gear VR Controller is required to play the game.\n\nIn case of problems write to support@zeptolab.com", "short_description": "Follow Om Nom into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cuttherope.net/privacy", "developer_terms_of_service_url": "https://www.cuttherope.net/terms", "publisher_name": "ZeptoLab UK Limited", "support_website_url": null, "website_url": "https://www.zeptolab.com/contact/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "313914954033858"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162718_345757019187972_5897521152934281216_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSNT8catx9oQ7kNvwEHuxNg&_nc_oc=Adn9IVYhWYabhBDF9jRRW87hLn4qyKCYa520Ngiphw9meiQF-ES-8tbJRkqVVtuqlxU&_nc_zt=3&_nc_ht=scontent-iad
xyFTnu5IrH4Q7kNvwFYJ38v&_nc_oc=Adr_0p4nderzkEwk1Jxa4kjbWEnnGjV4I6lp8iYXLOvgMo4VNN_ekIDC-X1sBEgRMI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9EdRhoVjNMgx4e_Tn2MFc5uz1mUfGh-dycVRUAcm-fw&oe=6ABBC6B1"}, {"file_name": "migrated_image.png", "id": "531294454476899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_385051651912026_6693593581766049792_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLIOD5CVEekQ7kNvwG5PUNp&_nc_oc=Adoj_PpQBiJNR_SSR0NZQEHUUADTNQhUvQuVqQ1E0rhPFlNap52Z3L53u_2aSiYf048&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWMEmyL6jC3fB_qypnrhzFnjGNTshDgnx4-8jjKqGv1g&oe=6ABBDEDA"}, {"file_name": "migrated_image.png", "id": "202082287734132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_133063643988103_767992490996269056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5E1AtQi8MoQ7kNvwHu6K5W&_nc_oc=Adrzd3xaVghHGr10T6DBjgn0mWLGvscoM-ATq2Z-eeidbIu5-78LxNaAGLUS-JXDCO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAADOjtv_bZ3QZxjl7YuVwEMZsTaVksV1k3XbpmjUhHQ&oe=6ABBD809"}, {"file_name": "migrated_image.png", "id": "193310761966067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_711651919020572_122350372583899136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o1I8tOhyJwQ7kNvwE8hGAg&_nc_oc=Ado0H3rcpsY6I3qt56yk_7Y6iw2hWqRg5edgnoVJS0hwi2LFc3vstxrEX87tV2Duvtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdVRJjOTldKE8svaZrbdIRg89A5NLuKUHxkD23DtwWtw&oe=6ABBB04A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where's Om Nom?", "keywords": ["puzzle", "games", "hidden", "object", "adventure"], "long_description": "Oh no! Om Nom broke the portal in Professor\u2019s laboratory and fell into it! Follow him into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games. Enjoy the innovative transition of your favorite character from 2D to 3D in this unique VR experience!\n* 5 breathtaking worlds to explore in 360\u00b0: from prehistorical forest to the future city and even Mars!\n* Innovative hidden object mechanics: try to catch Om Nom and tame him by feeding candies, then find all objects on the level to fix the portal and return home.\n* Randomly generated tasks in changing environment: try to spot 3D objects under different perspectives, find Om Nom in the darkness and use your hi-tech flashlight to see through things on the level.\n* Cuteness overload: watch Om Nom\u2019s adorable reactions to your actions and surrounding locations!\nPlease note: Gear VR Controller is required to play the game.\n\nIn case of problems write to support@zeptolab.com", "short_description": "Follow Om Nom into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cuttherope.net/privacy", "developer_terms_of_service_url": "https://www.cuttherope.net/terms", "publisher_name": "ZeptoLab UK Limited", "support_website_url": null, "website_url": "https://www.zeptolab.com/contact/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "313914954033858"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_345757019187972_5897521152934281216_n.png?stp=dst-png_s360x360&_nc_cat=100&cc
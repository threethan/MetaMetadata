ame": "migrated_image.png", "id": "609107586308785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162686_1825494211095034_4503160166316769280_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHaeM8UkSn4Q7kNvwF5AF3b&_nc_oc=AdpYdxdfPb0g8j51Oxdh9ytb_cRLOeh_p_IIIxRiLqEVfFpUdUQhfWS75cw7R9pXjTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqdDtxRWXy5UW6TQ7JLhRHu2isyFL3pX_XNKh88huQnw&oe=6B0054B1"}, {"file_name": "migrated_image.png", "id": "531294454476899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162686_385051651912026_6693593581766049792_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DxnfGpXi4UQ7kNvwHDtfqr&_nc_oc=AdprIsRKj4QSOJL9Bgvhh6rDvfQcwEWC-S8XOCd4sN_uBURvsrv_0zsvH8IatxGbnMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3oQ9-pr6Cr1AVszwL9NifaAoBNFsIqoX8m34G2TI6Kw&oe=6B006CDA"}, {"file_name": "migrated_image.png", "id": "202082287734132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162707_133063643988103_767992490996269056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KQTLAzLCkgQ7kNvwGivYhZ&_nc_oc=Adr9fTFkHwlUzqXyR8Lokznf8TTKgh6lCNb52sC_A-5QFk2EH9sEG5n61M5x5LkbdkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRldo9T84dU9smgJtrSqNwQmZ2yI88TtKBjTx5jzfoL-w&oe=6B006609"}, {"file_name": "migrated_image.png", "id": "193310761966067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_711651919020572_122350372583899136_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGxqhApg4pEQ7kNvwGTI2VM&_nc_oc=Adqr91fBkA_aIq1ucdixTXX6qM-bA-jMax9UfzBKKbtgZdNsmQPpASyRkrmkwx42_IA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa3DQxEMN6zyGak5seRc7k41tCuDzzaBy9F7tN0Wui1Q&oe=6B00768A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Where's Om Nom?", "keywords": ["puzzle", "games", "hidden", "object", "adventure"], "long_description": "Oh no! Om Nom broke the portal in Professor\u2019s laboratory and fell into it! Follow him into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games. Enjoy the innovative transition of your favorite character from 2D to 3D in this unique VR experience!\n* 5 breathtaking worlds to explore in 360\u00b0: from prehistorical forest to the future city and even Mars!\n* Innovative hidden object mechanics: try to catch Om Nom and tame him by feeding candies, then find all objects on the level to fix the portal and return home.\n* Randomly generated tasks in changing environment: try to spot 3D objects under different perspectives, find Om Nom in the darkness and use your hi-tech flashlight to see through things on the level.\n* Cuteness overload: watch Om Nom\u2019s adorable reactions to your actions and surrounding locations!\nPlease note: Gear VR Controller is required to play the game.\n\nIn case of problems write to support@zeptolab.com", "short_description": "Follow Om Nom into the unknown, explore gorgeous 3D environments and try to find the cute green creature from the world-famous Cut the Rope games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cuttherope.net/privacy", "developer_terms_of_service_url": "https://www.cuttherope.net/terms", "publisher_name": "ZeptoLab UK Limited", "support_website_url": null, "website_url": "https://www.zeptolab.com/contact/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_pla
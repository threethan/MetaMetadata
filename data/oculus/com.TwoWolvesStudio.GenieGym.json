60_1446696446115271_1504869821126930430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5oqBZsEDvcQ7kNvwGpP1vh&_nc_oc=AdoJ7GCIPf9bOD5pXoih4Nrm75cnuryniu2246WIWAUPCk6MzIsS6-mGNTYbWfZ_qDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3sNPQ5hDG-9uL-CaS-2kSQaBofyHlVh7xBRf_v3kcSQ&oe=6ABD1268"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd_kOT4zv30Q7kNvwHuGZz-&_nc_oc=AdrRGfiSsMMWKjVNWbzmL0239x5q9jJlVkZloh5oy5yszLSIH8xWwdBE-mhR0_NxpCQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_qeNHt9MNx9QnVV8uWvZvdBh7qOn3oHFxPfMAT1zhZw&oe=6ABD0BAB"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9RYoCAjxjsQ7kNvwGj0ypx&_nc_oc=Adq3KFwxdOdw6lgl-Bh7MZponl4QPpsxvlC9_1Hdiujh2W83_O-PNjmkJKoSSPAScPQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6Hcy2lg1_NyKAgypBGYw8PfRca90RzliNXxRQs6m1hg&oe=6ABD2BC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHTAwQFVz68Q7kNvwGW-7Wy&_nc_oc=AdpTLjJJD69WtSQyNdp1Cmv6KlvpGqj18P-sGcdKATrk1Nbj8Eh-mgoEe6DmBCzwOyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMOL29lIhwXgg-fm12p3dRhwiy2shkctbeUBNSrmzPww&oe=6ABD3842"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "27114431424836845"}, "review_messages": []}]}, "cover_square_image
oc=AdmRyIePr-BxviAC8ejd1Njbado28pGP36WKBiWOg1iUYFqXhmn1hABa-gUqYAQDy04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuw4MwPplotdcuB_J3lcGlVRQHioLOQ6_r-WlFHhXaztw&oe=699C59E8"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX8YHecVggMQ7kNvwGRNkp5&_nc_oc=AdnfqBV4d-Y2j8LWBOS4Roqj0UGdtabkv9zC4gbWwsOMyfQ9li9LUBDv603K0X7-Hbk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfshOenRypO5ssP8GLA1MOWT50HH76hAg1_sDEvj9NDx_Q&oe=699C532B"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OhCNa5bzUAQ7kNvwGPxBDZ&_nc_oc=Adl9i3v7xx4nc7lJTBeER5QP7TmExXx2caU1yM4fIInXBWkjcLjbQ5wuaV8nVTMX87Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs-dxM1BOmFo9AdRpe2xhtLaaNshEDuz97MVy4eykq3TA&oe=699C3B08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEyxcFKeNMAQ7kNvwFG-ZK1&_nc_oc=AdkizKqRfLg8Rc1rL85Ikoqlx2S5yCz7F-cyJFI3T7Gzwi7h4Eb757loxxQcN4cXfb4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvSM-UcKiYli8T7KHxesJMEQefeZ2sAlyP8LI5B4fS6SA&oe=699C4782"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "27114431424836845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036631_3668543670083977_3134814342871428072_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a
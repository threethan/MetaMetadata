k6VVmKquoPV8gsZDtDiahkcqQ0GQFHWA9pvEvGd1s4Z5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8rDhlLeh56rHWD2EaQlPfMNNN70YcJUOABt87LfDIEg&oe=6B09C739"}, {"file_name": "HoleScreen.png", "id": "1446696442781938", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75462960_1446696446115271_1504869821126930430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhdCsanJ52YQ7kNvwFMcQP1&_nc_oc=AdrZMLsU3d3GQ5A3RdB4fjjB_v6pttN_XihLU_nFRJ40Vbbh7ct4o1WiK104BO9aBAs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvXI0TbBQhCFAA9TUqaEiEgjhGCenWUecv-OOmWSndyw&oe=6B09C1A8"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHU5Da0ioY8Q7kNvwGucOtu&_nc_oc=AdrPpgu2cgCyq0ruLBHpmJPK7H99-jnzvRCr4mJaqO_hFgTBWgVwPeWrfXHHWIOlRhc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW9Cj7SYaXEkoNCZcFrAnSXsTxUVvWII9poDeKOCphSw&oe=6B09BAEB"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr46ovRQ3iMQ7kNvwEoWfe0&_nc_oc=Adqiu0bdC4GUYO_6oLNq6NTQZ4PbaFV5FeyimifxdEhaecXsFrgFDIgsAY1Nn2ApFhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnGdS2kL26Qn0UsJKk3IVohqE1-Q477h7yZRcUgr7A3g&oe=6B09A2C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX8p0tIK1vQQ7kNvwH8soFQ&_nc_oc=Adrah_pXZj9I1ZxAGTGHeNHuuY_ljTIJFkLG_mQQesO11Wd_XOpl9uAvFl3j1LYEQCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_nXGs20LW-uoTe93RNc4DnI6JIydUfYyJlxYgFnrKHg&oe=6B09AF42"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
ilI-10OwTegi8eOe8GaPy4cq6lNN3j4b5Z7i6ci3PIpgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8l7287jKCX20-9lnBVVsM-QfnHVe9683MnxK4qvwxHg&oe=6B032FB9"}, {"file_name": "HoleScreen.png", "id": "1446696442781938", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462960_1446696446115271_1504869821126930430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wP_GYZdn_4Q7kNvwFIVHuG&_nc_oc=AdphtcRsln31vAsu8_ezohTrPgE5SS9M-7ZYKkZj7CJdnJMYwtsj9tT7S9DTHBUwf5g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkjtBn6yFaOZpGoetGsJi-aR0iX156XGYf1W9t4xSrig&oe=6B032A28"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxBZTkFi7SYQ7kNvwFHWQnX&_nc_oc=Adocuw-Mb9V4uYlrLOBIG4k7AGZbX_BlHw6nKcWJdpSfB5pCKdcqIywi-ev8A8im3pc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCQsgNwNg1bmDnBPHWyhncJ7pOafnNNhNpXkBiYyxtdw&oe=6B03236B"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ptcYeZvQTkQ7kNvwFmfyvN&_nc_oc=AdorWxMZ7hjuRlLd2qgSCxJ3FI66lesR3mfm98agm96JSAWYeJOLbT19NNE69SkkzZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf2gqAoKzrnOkCmj1EOSjogHZYCAnTgzBJhCCrdO5MKQ&oe=6B030B48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoFb0_yXwHsQ7kNvwHZEVSI&_nc_oc=AdrZMdd5hpSll8kc09KjpftrVS9cnjKlkzb2DTdyJhUwDwdC3M90yKzGqStZ5mtQuuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTcKPIuXYuxZrvH4qitmslUw-53HROQQ-eRNQOui-rJA&oe=6B0317C2"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
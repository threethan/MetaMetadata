content-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpqilJXc_WxhRD5lPu934RyV79gnemaH2GL1K3FsIFlA&oe=6B0B18B9"}, {"file_name": "HoleScreen.png", "id": "1446696442781938", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462960_1446696446115271_1504869821126930430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLV8Rwggaa4Q7kNvwFgbwOZ&_nc_oc=Adpxe0ZO3unJupqrFfxniGDlDxtO2BKcVJD205Zexodrhqjv-Oavz-_OViLZkE_qEvQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDLU-r9BafiLLOxFwS-07IQeFVISsDKzi4fCqBJZsI3w&oe=6B0B1328"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riiG8Xye5pAQ7kNvwG96FYZ&_nc_oc=Adpgbrqod1hoEoxUmouNhpeLHEA_9JcyMWKpxxU3HHf5y2hVs-8zHUtk8Kp5UVcbagg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJn8824zAlaA_kNoMqWG-8DS0S766xffPFD4OVhiBiaQ&oe=6B0B0C6B"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr46ovRQ3iMQ7kNvwFzvLDe&_nc_oc=Adp3XCNDyPvIAHf6I-LsLZBqNGbQlp8r1tOvkYIqB9hYl6qHvx7JfkC8wKLWS3v6dn4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQ9tmCFapJMM5s5BJU8rDh220Jb_8VVqQhY0QWt0fccA&oe=6B0B2C88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7o8znPtQ8gQ7kNvwGKs7y5&_nc_oc=AdqRp-0pcGw5fHrXyFTkwFx6GzoWbvlfj8w3B6K2aBS1US4Xs7mnCSAD1H_halZ5n8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVSeDYiIG1ZwS0L3fKCHTw5jK0qF44TatP_DR6XXPt9w&oe=6B0B3902"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
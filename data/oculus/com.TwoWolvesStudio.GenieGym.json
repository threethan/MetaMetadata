60_1446696446115271_1504869821126930430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNEJy3NoFYcQ7kNvwGkvJbL&_nc_oc=AdrUaoiVpVmU9-1xxabmBS8DTGSKFsKDKFNno8KT2VOnysP4NEYaZAWb9OWGZ6P0WEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw71lDublVhtlYuQYF8gM22fNGOBVDwbmwU5QsvT1RldA&oe=69CBCFE8"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNs1caZ0cQMQ7kNvwFJPBmK&_nc_oc=AdrNfSIWGzFyOQMYV_MrCETKznMW-Ar12DPPmD9Syi21kTv0IWKvUImag6CCCNppR5s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5CrkqW37wIiPJaqjtU1qTLZR0LT0wy8Nv5nf_BDaDPg&oe=69CBC92B"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5USasPW33QYQ7kNvwH7IWr7&_nc_oc=AdompQ26rXbWvOYiB7kfY-lxcIRYyJTXGJb2k6NiQTK42GGKPqu70mQJPZoEx_oI8BI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_vxWhb_cv1xZDUCTh8S8k1GePkc8Yl5rL3AwRUtmJrw&oe=69CBB108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouvIp7nJFAQQ7kNvwEdp0-K&_nc_oc=Adofu5vCh5cLYkXHcuwRwYCMrJNGdtz13S62QLyv1R2LupzSDvHM9wr3pXQNEzSjJmc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZw5tdhH_0l2uxim5JIag-mnCdZJQF0CGa5Jh_mO112A&oe=69CBBD82"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "27114431424836845"}, "review_messages": []}]}, "cover_square_image
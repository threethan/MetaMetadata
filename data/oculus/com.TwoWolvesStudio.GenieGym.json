EnAd7WZb_bSy9O6g3vzn2SGjik7F5fWJbjUjrCjVH7Dfs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScxf6cyugNwY80uyKnQ6zS2OfE-T2HyuaQ88VlY-WnAA&oe=6AFF02F9"}, {"file_name": "HoleScreen.png", "id": "1446696442781938", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75462960_1446696446115271_1504869821126930430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoehKGnuC8QQ7kNvwHPyZwZ&_nc_oc=Adp_0FaoX8Mgt6NQ4rjcculcfxwFV6F4w5XJALnIk8MWuvw83M3uI6sBcoPCyUTbot0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy7KTww359PoEOfs1cs5iIcnCpdPmoHRkibmawVVW5SQ&oe=6AFF35A8"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp_rGWcDFXQQ7kNvwFaMPzV&_nc_oc=Adr4ggx_awksukiNSTSJ6AjfWehYWXc_JOdaI66XTmhHqPEDqr7SPU9-iFyxDtnTtEs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMnfk68fotLp6d6qHszXuoVVZjKt8JWEbE4Tx1FAioqg&oe=6AFF2EEB"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrWAB8zGdhEQ7kNvwEP8GgP&_nc_oc=AdoQr9SUmKUqwSrbx5BN5o0bDB3cEUIO-pD9k3i9sbK2wQ-8v6PCr7cQQmz9ES_jp34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMBen2mo08E615_bz-3Ydl6Efa8GrGsn3sTdHjqxfExw&oe=6AFF16C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0P9PzluVi0EQ7kNvwHPVaH_&_nc_oc=AdpVEk3RVJsxkNzLPMXmF7UuFmDK4GwkdJlpXLSH-TYGLWYO7mYLnMcgdLThh1GGNv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPCjpTTpIYUUtoWswEkHqwvCujY1K_UTwIXXQTvq2DMw&oe=6AFF2342"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
60_1446696446115271_1504869821126930430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7RWvI8v4OMQ7kNvwH6Zkjv&_nc_oc=AdoUgKXJZGKuFUZOfEXgtglAs-GNrQVQDsS_J4gnssSmXBey_pzozeToSVBFzXJje1U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DiRivjoRZrS6i7YpxkCvKnatMDxqETnC-F4zAs5xp4A&oe=69E62DE8"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZnvbE6zDMMQ7kNvwFitA1L&_nc_oc=AdqfpEWbKYcdofWVqCPm0AeqAhpqQ8oNSTI3teDmRcpJQTocVipCC1cqXgkFe6Vo4Wk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DZ1zDOwDPe1HwarHA7qDCP6Oebs2gUiioOxdPUmJvPQ&oe=69E6272B"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kPeEyL24McQ7kNvwF-91sM&_nc_oc=AdoPTZQJ98sEXIRskXCX-S2cfGsPxi1kq0Se1tXoZxh2VZ9dFpsGeZHzECeMD1uOw94&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0neniV-em1TzhoiTw4ip_JB9xRSTM_5RjY5j3FjyevnQ&oe=69E64748"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEK-q5Y5_WkQ7kNvwFFpP5G&_nc_oc=AdpSJ0XCYWvbhT0kaU6gP1OBScrV4NNi3Rf39O2H6xc6RjC9sP5XuF-Vh7m34p4V6kc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10QgQ_oQjBBxRnrpfxQ6FJ4YbnDmU3k-B0uOW3YiAA3A&oe=69E61B82"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "27114431424836845"}, "review_messages": []}]}, "cover_square_image
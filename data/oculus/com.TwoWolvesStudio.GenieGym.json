HYzKTvg1lYRIKJM3wT1dNzC9MrBuNKEON74iJQ0Y-jjEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKKclYqLQCn8xDY_xzruUtWuncj19edd_xGdgQHPhr4Q&oe=6AFC5FF9"}, {"file_name": "HoleScreen.png", "id": "1446696442781938", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75462960_1446696446115271_1504869821126930430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgCScEe6TuUQ7kNvwGtoZQs&_nc_oc=AdrXs4hWmSeNuS0jRzAYGLpJsfWXxvkGoTdSUFsVB4EZ9V9XK6mBbVk1N6rAcDqxo30&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvqGm4n2XJ2gL0OZ2SeZMCX1Q84Y2sE6O7EifrXzDq-g&oe=6AFC92A8"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nXM8jxqPzkQ7kNvwFC25lg&_nc_oc=AdqlKF-wZ0GxVPr6aNNa8pEeNLeBphAxciTAfL8dFVhJxkky0Ws7IhNmfCHfrXFZPMw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhaKHL0QpeUwtFP1x9FEw_StnzHC_rS64cxbfLcClDtQ&oe=6AFC8BEB"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrWAB8zGdhEQ7kNvwFis_5M&_nc_oc=AdpSyb8Wn2-zGV7Hel8JPeN8dpIGuJDQolQclIn6nNch-SsoNGi-AAhsceojbvBusbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPBHXEcM8QHgkUIb_O6scKrQSk5pzr5Jtn9KY0fcTifg&oe=6AFC73C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJhm2wTCtWkQ7kNvwFeU3gX&_nc_oc=AdpOKDzm6Z_ziOGjSPYoYjiRZ7Meo0eqPonXj8APSf6yPSMoTFdDge_QylkPxLdrzLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWbR9bxFqc2XdxuCvWSI1ic0bYexRydYWXJjQZx_Wfgg&oe=6AFC8042"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
content-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9fRIxKAR_p6OI-yAm_hiwHY9b-dkXjg4hZK4-pv_8kw&oe=6B01DE39"}, {"file_name": "HoleScreen.png", "id": "1446696442781938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462960_1446696446115271_1504869821126930430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoehKGnuC8QQ7kNvwGVMGlb&_nc_oc=Adqfbn1Gs611lN2yhWkyBxfDIkNhAsZoDoMV56zxAMywAqWTWWypf-AigftaGuFeHOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdkuKhIgiyeeyQa-_1L3gJIRS5CwyDr7mdb311HHbbjw&oe=6B01D8A8"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp_rGWcDFXQQ7kNvwHbJQFS&_nc_oc=AdrHsdCvpZsr8-cwb3Gya_JBBayxi2_PD1N6PncJJOY8m9PBEh5pCFeHPCDU8vnj1Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReqIIwUdxk3lwt0bnVQN_kx0Hz8FFtyJEGVB-ZaDbSIg&oe=6B01D1EB"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ptcYeZvQTkQ7kNvwHV4DPA&_nc_oc=Adr7Qp8uE5nV-Kz3kEKl71VWLQ1yk4n1CvRB5uLtdV6Q4201BjSBoRs7CeDh6ELvxw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToS3JtwIX9EjNZetNZmw6djvBgNxjiJJCmfaPfeIC28w&oe=6B01B9C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0P9PzluVi0EQ7kNvwG0T41V&_nc_oc=AdrDQ9TI02172TmwxNLIhxmnLDaXS9rqmsGtVpHgOnHaw4PzUVOCnSalGQA5_NwBD3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2pnQ69YqSi_Eduawgn4HczuxJEhidPoRjriKO7zZcRA&oe=6B01C642"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
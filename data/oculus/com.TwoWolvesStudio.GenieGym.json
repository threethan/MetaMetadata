content-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKG2HY0eGpGuITvJAUPDBGAgfmMTMCyT_IhumAu0kfTQ&oe=6B0C6A39"}, {"file_name": "HoleScreen.png", "id": "1446696442781938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462960_1446696446115271_1504869821126930430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLV8Rwggaa4Q7kNvwHMiYgV&_nc_oc=AdpU2ZwjGkh4gaDQZcc2KnrCXtsVP3_W7UpZM9de5qOwiMWEA2lekJx7VCmIJwt15vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_I-y_325XCaXI6zQ20NbTRmP2odwFvQrt7IwbAOUnJQ&oe=6B0C64A8"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riiG8Xye5pAQ7kNvwEDRQI8&_nc_oc=Adr6RYQdNtf-eJNfat4A5rGBk9LX5IZJlbnScYyE89dtU6ncIn_GtPwVCDW9v-9X_Dg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmlnuSnZvt5Zs9DTl1TfS2mu1P_utRlBpLcmprBwAGDQ&oe=6B0C5DEB"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7JUogVSG7UQ7kNvwEMigFB&_nc_oc=AdrUU5ovOkUPdWmzAl6R6kG6tIEPLmTUk6H7o5Y76AWE6Ta61lYgsKeLljFb0sNKXGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeLJwJQXWaW-hJ3uk5QxIGQHnCi-lD_vyq-8wxx54iiw&oe=6B0C7E08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7o8znPtQ8gQ7kNvwHDYGqs&_nc_oc=Adqr503UppleDMOgZnRJX3B06EPtNZi4TGfItyz9tEOYzI_8RPPeMOe-rSbdPey2QQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRB4KD7cR0itaIMxTAxIuPRVvzgb8C_5rXDTvMJhNvH2g&oe=6B0C5242"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
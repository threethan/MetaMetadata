IcG14E6p60s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvTgzd7P3nIDJIntyUOnItvHpNRjF1A7y5TKRYBuSzBIw&oe=699B01AB"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OhCNa5bzUAQ7kNvwE_qqFw&_nc_oc=AdnO5MbxB2r3XtmKyZ8qZUhCCvDskc_TKdoWR8AnwJgMsp1c7FxYTpmVan7b99HL4PQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuIwDQZTWMbQJvCdBtYPk1-QB9Bgxyvrp5W0wKUxuIlvg&oe=699AE988"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEyxcFKeNMAQ7kNvwEFcLXM&_nc_oc=AdkSqXGcF1Vp1sprZVlWp4XcTOH3t-SV3SpSmVGK6hK9luEo03yzXfJ_T6FmQItsIu0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuQ7t7XGfWKir44r6R4RtpMFMnG2nTUoQZJi-IZlRDqjQ&oe=699AF602"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into 
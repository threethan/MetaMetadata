content-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG2ZB5Lh4x9Vxz-HTbk5FsHwGSAkKvrRnay6cbFVapcg&oe=6B083D79"}, {"file_name": "HoleScreen.png", "id": "1446696442781938", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462960_1446696446115271_1504869821126930430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhdCsanJ52YQ7kNvwFmnxXL&_nc_oc=AdpkJWiPqJ_Ics1csckuKlXiIS4KmzrK1kMcQrQPbIFhpfKK_GTn3s08DZl8DIb9HK4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgntLt548pqq1j2vCio1nvEZFLqxXKqMAnM7BjKNVXEw&oe=6B087028"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHU5Da0ioY8Q7kNvwFxCcLN&_nc_oc=AdpX28kA9WSJUCJ0BGnp0qknOej2Sk8C09FIE-JSnD0Tya0mP__plJflrnrEmDgWl98&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXjo0dCpD6vLfcR0SF_6Z6yXCeLs4nzPpTr6BDrHMPfw&oe=6B08696B"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr46ovRQ3iMQ7kNvwHZKqiO&_nc_oc=Adp2UzhF7k2ROEC4dIlLIzEcGMMp88Z03QYi9Ffk6X5LF6wH9zKNnPvR_zPhQNMKe2I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3o1ca7ZqUklk5nox0xh_iLWfRFycjKGJ4GBFKkrSX0g&oe=6B085148"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX8p0tIK1vQQ7kNvwFTEsTa&_nc_oc=AdrE1E47Wgprep11NCvoVH1s8gWt9PJeiYaWZkICEPw7j3fm4lDUNsvFdk2W4l3dhF0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfSmpu_KPIqndUpFiUGop1cMg9bCd8LITLDiUkJKLXbg&oe=6B085DC2"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
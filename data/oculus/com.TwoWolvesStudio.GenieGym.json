60_1446696446115271_1504869821126930430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GxDBNcBC_EQ7kNvwFA_974&_nc_oc=AdoJPfMZ7_ut5_wz77-OEedrncJCEW1_aG3t9jyikBaORKdD8As8tCsbHNcS5q7UIq4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Kc0jwQ5jb4M6nAE8owXIwZXUgp2Qc9Sl75vMlHxm1xg&oe=6A2C0D68"}, {"file_name": "RoundScreen.png", "id": "221669187563733", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974883_221669197563732_673204419216604099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glcZ8TlTi9AQ7kNvwGMUuGK&_nc_oc=AdoBEOYXXBLYdXXFqK8XQFx1Gjv6FNgrvz9B0qx4PNklV5nNJFl8QyBY7FcNzGsoXUw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ln5OQvdIRUHpVhIPZsehhpVBm6FV1CXc6Qm-N8RVOaw&oe=6A2C06AB"}, {"file_name": "PoolScreen.png", "id": "243997814869068", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982675_243997818202401_35384399934413085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7lGENrapaMQ7kNvwHVAlaU&_nc_oc=AdrWHrSr_qZoSvRr2LI_kacTrFx0PNjqb8Ic0TiF8aZ5a34IOCHrdtbcTcIsfQxdwOc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uhN3vNRJRfy0njIn5Y0hzM4PRvXNCFR_hi_qe5Jc_Rw&oe=6A2C26C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GenieGymCoverLandscape.png", "id": "328896759640837", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75203622_328896762974170_9218873658952822499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuGbkxIK9SkQ7kNvwHFo0vu&_nc_oc=AdruzQI-Ep5ACbMnyZJHc_HLf72rKY7W6fF1mQzX3RdB26JBkimE_kjWOKeGVcJUUj0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ejCTWEaXj_puEZCkPXDHotIapzMaItHbLLgcaCyXdRA&oe=6A2C3342"}, "display_name": "Genie Gym", "keywords": [], "long_description": "Are you looking for something more than a virtual copy of a traditional game? Want to play something playfully unique? Genie Gym is a reimagining of popular sports games for the virtual world. 3D versions of pool, bocce, and cornhole offer a casual experience, while 3D versions of pong, tennis, handball, and spikeball offer something more fast paced. There is a game for everyone!\n\nTrack your wins on the leaderboard and improve your skill to become the best. Customize your Genie to match your style. Three themes are available to choose from: solar, stone, and metal. \n\nFree updates are coming for all players of Genie Gym that will bring a variety of arenas to choose from and play in, additional styles of game tables, matches, rule sets, and multiplayer variety.", "short_description": "A playfully unique game with traditional origins. Enjoy seven game modes that turn the familiar into something new. Play in Single Player or Multi Player (1 vs. 1) modes. Sports such as tennis, ping pong, bocce, pool, handball, cornhole, and spikeball inspired these unique VR centric games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/Genie-Gym-Privacy-Policy.pdf", "developer_terms_of_service_url": "https://twowolvesstudio.com/wp-content/uploads/2023/09/TOS.pdf", "publisher_name": "Two Wolves Studio", "support_website_url": null, "website_url": "https://twowolvesstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "27114431424836845"}, "review_messages": []}]}, "cover_square_image
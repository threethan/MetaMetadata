?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIJ-0v29kD4Q7kNvwHi23gz&_nc_oc=AdoR9QQ_nietJ1C2IfjBTxoKLZK3IU6sEPcw63uWTSYAlnoosd1aKCYnznDbvApU8s8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhfXpNHN1wdr87i0tSjVBogBAJr2d3iyNGA2b9Ti1JAw&oe=6AE9E442"}, {"file_name": "com.oculus.vrshell-20261015-040627-0.mp4_20261015_164814.969.png", "id": "1070719389109591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312439_1070719392442924_1554715530642658877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClWMRu1VWv4Q7kNvwFNsN4X&_nc_oc=AdoYSmfJeOpJ4srk3G0qv_ijRVq9n6N6pjEGYyT6f6Ddrs67RWZT5EYLKnjsL9O3oWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcoO-ftzByecLumxO1LaeJ7vukVQoNZ6B_WSROcBIf0Q&oe=6AEA0EAF"}, {"file_name": "com.oculus.vrshell-20261015-040627-0.mp4_20261015_164716.002.png", "id": "1292494172969973", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_1292494176303306_9168577416591604225_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IYCo9djBNYQ7kNvwH1k75Q&_nc_oc=Adock4Bqa7eOXU21nTzAQ8b38rWfgLqlHDHS79fRgSKUHdI1dK8rcdcliySQUa3lnII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBhIDMQWZyKx-niHrqbzYmC2Y4n-xzdPmjWorGdUnHnw&oe=6AE9FE71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Desktop", "keywords": ["pcvr", "desktop", "virtual", "steamvr", "openxr"], "long_description": " # Prism Desktop \u2014 PCVR Without Compromise\n\n    **Stream OpenXR and SteamVR games directly to your Meta Quest with native resolution, sub-frame latency, and zero runtime bloat.**\n\n    Built from the ground up for sim racers, flight simulator enthusiasts, PCVR gamers, and spatial computing power users, **Prism Desktop** eliminates\n  the clunky background services, translation layers, and memory overhead of legacy streaming solutions.\n\n    ### \u26a1 The Direct OpenXR Advantage\n    Prism Desktop hooks directly into OpenXR swapchains and composition layers. Frames submitted by your PC games are captured and handed straight to\n  hardware encoders without unnecessary format conversions\u2014yielding up to **35% lower motion-to-photon latency** and rock-solid frame pacing.\n\n    *Playing legacy titles?* Prism Desktop features an automated SteamVR compatibility bridge that lets you launch your entire existing PCVR library\n\n    ### \ud83d\ude80 Key Features\n\n    * **Native 2700\u00d72700 Per-Eye Panel Clarity**\n      Push every physical pixel of the Quest 3 and Quest Pro displays. Experience crystal-clear dashboard instruments, distant track apexes, and sharp\n  text without the downsampling blur or compression artifacts common in legacy streamers.\n\n    * **Effortless 4-Digit Local PIN Pairing**\n      No cables. No third-party account registrations. No cloud relays. Just open the app on your Quest, glance at the 4-digit PIN, and enter it into the\n  lightweight Windows host app. Your headset connects securely over local Wi-Fi in seconds.", "short_description": "Experience PCVR without compromise. Prism Desktop streams OpenXR and SteamVR titles directly to Meta Quest with native 2700\u00d72700 resolution, sub 10ms motion-to-photon latency, hardware AV1/HEVC encoding, and zero-VRAM virtual desktop environments"}]}, "developer_name": null, "developer_privacy_policy_url": "https://prism.nohtv.shop/privacy.html", "developer_terms_of_service_url": "https://prism.nohtv.shop/terms.html", "publisher_name": "NahomPromotion", "support_website_url": "https://prism.nohtv.shop/support.html", "website_url": "https://prism.nohtv.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
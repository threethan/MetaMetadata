8317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m_N1OcGwlQQ7kNvwEu6Xmr&_nc_oc=Ado78ZN2BmrGbikrJStoiXwq7j_GwdIsJcyvWrtAeoMb69q-nG_ZmYBkpKkUvC6epBo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEViAJRwxjg38LDlgvE5WbPn9or0OcGoDMJtuSExyUDTw&oe=6A8D8449"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W23YhPcnM4Q7kNvwEWYNUg&_nc_oc=AdquMhu-bamFYL7ru8ZlCdIs0n11At01mrCt4ks3bY1GlwirDh4RUPRWNiXP1lhrpY8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuXG3PvA8TgY37wXkhFLvCcyY07m_YCBOpgGkxqlrx3A&oe=6A8D868F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPrWrrlYbFAQ7kNvwFVDzM2&_nc_oc=Adqf7cTf62v796GQGFAdRDjWOVvGjMmo6XNHzNHFDkt7RWWl8KpbruBHpfUg9u_VtVU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOJp1BN26sQ9GXgTPYNGtQyeekzqbHHWZJ6A7MxjOq6Q&oe=6A8D95C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVksDggpE5kQ7kNvwHrN1-4&_nc_oc=AdqfuAomSbMK4HOpOLSJi2jKJmGeSJvdEwN9r25SqulFRpXQj7ePQmvvfFzChTY8uRY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLdP9GfOsIl69qQRF3jaDCTukgib_afydVs22n8TFSfg&oe=6A8D9622"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448233043877213"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1886169081587626"}]}, "baseline_offer": {"id": "1886169081587626"}, "is_approved": true, "firstOffer": {"nodes": [{"sta
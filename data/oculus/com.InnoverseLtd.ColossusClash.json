97314348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOQF428xBDwQ7kNvwGYaRq3&_nc_oc=AdnpAsAHJ-735B7yPjsFfAywcur5OfSibpqj1Do7GypLPewocc4CUsqRuwBvsK2wX0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudEna9SIJm86WZ3ECEXCvnVdXP2uMH6LMeDU6zTRYCDQ&oe=69A2DB8F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYfHe1_AGE0Q7kNvwFamGIb&_nc_oc=Adk9UQjnFZEVnJf-V1S-DXYrvYq-yPjWWDe6_Dm5TtjQuea-TZPAViSHf_ntEXFnfOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudjTVEnu7Q8g-Vyp63uZktxnAovm7T1I-txYnGKFISfQ&oe=69A2EAC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjW6PJIYVN4Q7kNvwGzyuNb&_nc_oc=Adkd2R71hxZIte5hzjl4QzPjEnQa9IMzn5M5i0z0hCxaKAvgl454HDTfY9mTxq4qJ2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxomCFjDShuclXTqHQRxK0O7UD5TbW1sXdYorSV05OJw&oe=69A2EB22"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448233043877213"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1886169081587626"}]}, "baseline_offer": {"id": "1886169081587626"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1661854200, "status": "PUBLISHED", "id": "1886169081587626"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6646313368747238", "version": "32"}, "id": "1101734870455315", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typenam
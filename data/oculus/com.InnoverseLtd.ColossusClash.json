kaFiPrQmX3zXrCi5n7QKT9rRufesIXCCokVVU-yG_9NpIMKwyfNAkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxusNnhJb9SthwrmLFc_3Q77hneAdCOmED8N_m4pxxlxQ&oe=69AEB6C9"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8qfZVwto4YQ7kNvwEadcSH&_nc_oc=Adk6OERvCYGoJva_0a_oEm30yMpB3J77Ajps4IsXtTON5V4ozpIfojZtp1OnMmnrEZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5kdy9EHMrYPHlOPNbpwp9okqFYXM15YRsYl_N_KDeqw&oe=69AEB90F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk9yH6HjLVAQ7kNvwEz4xBc&_nc_oc=Adl8gLl0aSMUzKJmMlbSP6NLXZPiOS22OJqu-1BdyH9cSDSv_87WJfibJVy4mHUskas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwve9mCThkALPupssH1Dc0Nle1lIPxtUAoP5zR0DSS3oQ&oe=69AEC844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93X3-rtbo3cQ7kNvwF8d7lq&_nc_oc=AdnAs_mDH727IIeiR2lRx8JKanmCM-s1hercp18hKExIZghELVAAJv8ow5fnl72Fqus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaK-0LaXPt3eb4SWz288Lg1029NI5S2KUvCKzeGHDuFg&oe=69AEC8A2"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448233043877213"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1886169081587626"}]}, "baseline_offer": {"id": "1886169081587626"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1661854200, "status": "PUBLISHED", "id": "1886169081587626"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": 
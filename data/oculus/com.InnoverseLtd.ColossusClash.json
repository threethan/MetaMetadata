n.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJy1bISd3hoQ7kNvwEF5uuK&_nc_oc=AdkMTvCQIK-62sawjq6fXeQ0ZV9ogu-lFBZcB4NI4M6PywWpHGgyyEUaPSlkQs_RGjc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftWhA2RDq6a82-erXW0w04op_OB1dQgsL1zkfuWge7pJA&oe=69A1A866"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0VGA84WDS0Q7kNvwEnm5MB&_nc_oc=AdkULaH2KvdQ5BKpXyVH3gx5tbEaT3QHnRBSwrhn8bBhIV4G2elT05c2rqaYMNEuddw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afus2cBdldeNarsM6NDyZrLc6WgO0S2N-fWy3WYOPTLMsg&oe=69A187C9"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOQF428xBDwQ7kNvwHpmN5k&_nc_oc=AdlTLP3paVxJRACICpkatHaQejTH1YTB0_Zue0JIERIItjrS60HwTniXTu1nR4IqUAg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Aft4o9l0KZBGk9Huzj3Ohl7wWQIaVpC5Tc5XRB_VLKehZQ&oe=69A18A0F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3ai_GVBf8IQ7kNvwEec1yx&_nc_oc=Adncdy1qC6NrD6k9JWLh5tm4T47auRpp9IBWs-9gcW4ZIJ19WwV-DnQu7MYUnMTJ_po&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs_Pa2BETUFP3Gh954ry3UtSLQm16wDTZSL4NrvSQGDzg&oe=69A19944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjW6PJIYVN4Q7kNvwFt9qHh&_nc_oc=Adnl-P96zMuiBrBk1x0Sl9wKEXGWeWIR5yYPT3D8nxj_8ZHCZ-foj5CpJVgxRl2vVcE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvfILlgMA0Jfl2bkdgEgP_cU0cVCjQ8ZWkpSgKp92AkCQ&oe=69A199A2"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
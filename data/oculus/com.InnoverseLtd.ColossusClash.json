n.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJy1bISd3hoQ7kNvwHWI2CY&_nc_oc=AdnilKxYVKO_QDOzFZ61U7jDIA2KUJ4WPJpuYSKZphuT9qRyfb97dLknyKfjazJNmO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEkhrFncYGpBJ26OELQSlc6Cp9oWemn1H6l7pCWO073w&oe=69A056E6"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pByFV568kxYQ7kNvwEUxf9L&_nc_oc=AdmcsSTGVlAdw8MJj5IE2Pbug0zmc7shcWfxYEYOJ1jS8QN54FwMhDGhgLsFl1mvpEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsy1wj80IdJdDbQ_ZJOlPzEk3UEML8qR3WutPaeu6ExvQ&oe=69A03649"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOQF428xBDwQ7kNvwH1sBQm&_nc_oc=Adkqx8DdJ2wmr0vycm5sWd-0TrOii_TpBSEJJz_jKse8LXMQoqn9h6vv65HbRW79rLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfslSmMtMM7rZM8WOlFlOvgb6YMQru6ss2K8r_MGb0d2SA&oe=69A0388F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3ai_GVBf8IQ7kNvwGE5MrI&_nc_oc=Adk0YEuZWlAx2J6fOByWFC73qb12dkFY1xCFpYTpPHgLkBibHSK9rmShFr4HsguBkFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsboXNQY9fKIzrMIE66_PwSxfsABXl0YnFG4f1Y_4qn4Q&oe=69A047C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjW6PJIYVN4Q7kNvwGtU4dH&_nc_oc=AdmT82xo01MPyKhwyI7Lv77YDiQEhpAbvw1Czn1lrA5O28aQRL3FqViklsNnQJQqkQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsq3ZcdpphhwGsu0nrx9GKLF3VgNPRaOeIszCYtOQloUA&oe=69A04822"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
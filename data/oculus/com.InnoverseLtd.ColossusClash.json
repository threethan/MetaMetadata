oe=6A32C29D"}, {"file_name": "1.png", "id": "1026360174725848", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-owaZDFjSuMQ7kNvwGHTznv&_nc_oc=Ado9CAH1tbu29USto9h3cozu1MlqecvLdGkywPeSnzJKdqG63rdRuySfa29MWWQQR7k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8chTMDdIUM_PKlbxsSF2IOpwty165VmWlWjLWmQEsU0A&oe=6A32AD66"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwp49o-JmxkQ7kNvwGbZeRK&_nc_oc=Adp5IEf8gppcKwuKCUjvVMu4haIANqG2xZR1CHYS3GBlQqubox5j-iLLR_2SQEPrH3o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AXjigePLUMO2m-2ZXSvUiNLwX15Im-crw_9bFwMQ1SA&oe=6A32C509"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ormrm7MQ5-UQ7kNvwGp3rUi&_nc_oc=AdpIWibW6bBNz8HBAkYNmND-5LnTND3Wp4E3jjILXL3rj4BIuT2spxi3Zh_CiHyTgU0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95p1hopogsqo85hrRvFPptYCXybIEWaBunMAe4NRANiw&oe=6A32C74F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuiyTCLgL9oQ7kNvwG-3Wdx&_nc_oc=Adqis2gfvVz9B8tGA83nRUXhXNW_H7xhsJnIsgz6R_BHfH06ed82eHac0sL4Jk7dKGc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ysNvfjcQVkraMD2T24FQaTA6KsPRuHU1wtATdfCbu_A&oe=6A329E44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk_Ef82zmacQ7kNvwG5ns5E&_nc_oc=AdoWNnC-POhFq1_bbcPzBHWY-PcPPh6oz2fUllFi6x4OfnKZa61_8wJClFL94gw1ALk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rTuvsGz84Nnr9hueukOdJR_uyHKe5_zPAhhP-q5X_UQ&oe=6A329EA2"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "inter
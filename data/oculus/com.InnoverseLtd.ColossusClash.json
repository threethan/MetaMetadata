.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo1LvPoAZVsQ7kNvwHxy-yO&_nc_oc=AdqOjTJMKOeJ7zewx56lN3E_c6r_V0orGb0yPOYOQEb5E3gBgbijP9JwXkMD2-2ryAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe45ChwOoW69GELV74JQ1FZgygY9aXYcoMoLVTh_SJIg&oe=6A511789"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36aW_NK_50QQ7kNvwHNSHDV&_nc_oc=AdpunnlTK0Ad2GihYnNyAcu_KiRCwgBPpIabE9u2PCoBshefNudnnqlZOX51PAiVLIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlzoAl4rVx3qKt7t3ksUOdWVFki2eoLMoDAlbU_S6Feg&oe=6A50E18F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shUaCaZ1FAsQ7kNvwHPpdbT&_nc_oc=Adq-mr2bpGwkCvx4lIKW7X-mvlg6c3Uw9631i0EXpTUMTCeq00W53ne-_uuVh8DKuRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5OaZIuzTA5njA-m3N6TLwM6SwEqRo-asz_QuluNusCg&oe=6A50F0C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODcF8nDu6SgQ7kNvwGWd_2h&_nc_oc=AdpRU4DI622P_7U1fn6WFk0nXgxkdhItt7RIGuuDCncLB8BIfxzmyITHYT5YZ5TFs0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRZznWnBjx4XvmNXk-6cDd-xZUtjcMNAPHKdfYk0n-WQ&oe=6A50F122"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "448233043877213"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1886169081587626"}]}, "baseline_offer": {"id": "1886169081587626"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1661854200
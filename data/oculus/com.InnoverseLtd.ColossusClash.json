me": "1.png", "id": "1026360174725848", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwbRxBQA4TMQ7kNvwG0Er6i&_nc_oc=AdmSEOCoR4TPc1X5qkWICoP0kHQyvIky1VrGofhz9BWJj382H_nAxKcC8v7A6Y7umEY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvggnIffj_YklqRa6i1L7lCk77cVPtcqWhg0UkvsZzDw&oe=69AAE2E6"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqsHajEYSNYQ7kNvwHryJba&_nc_oc=Adm9XuzwAiMLWgjtHjpFTnEiR3eOfpm9LdauVBELTuVh7AUdTpmaIis4dsMVE1hH6Cs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGypYurESX29rx4OUd6Xrk8HNEixsn0ZhCMaEJGb2KvA&oe=69AAC249"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjeWHQ6Hh4MQ7kNvwF1CGBt&_nc_oc=Adl24NO_JWdb30nx7xiuP4A_CkDMdvGRVG-7mYak-9qoQ97F0ecgDkRXPL1x-0Sy3JE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzn81eaUAepZ1uYIrwrMHVcJCiDruQUeMx5qkMkOEstOw&oe=69AAC48F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yaul02fu_BwQ7kNvwHWnYXB&_nc_oc=AdnFMxEopgy6tnprUiAaUX5Eh__xUm48o9Rod2suw-LzeQc7Qx1PPcUkxvVx2qvGp9g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzK1KEnyCZ3mHZjRpLmidIKk8IE5jf3eIeZkMijbNl8Uw&oe=69AAD3C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWbK64dTWbEQ7kNvwH5Jllo&_nc_oc=AdmYon9F-dgXg-6lwhm37IbdHa7NfTE4UuSd_vrP5y9UT0kAJ_NmFRD701OxgPZVbpw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPwsNlnNnXOSfPW3Au9ovdFhV82gqUdpvqZ8ByrCHzgA&oe=69AAD422"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
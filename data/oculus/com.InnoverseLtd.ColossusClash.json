n.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpmLSNv837kQ7kNvwFYwLDs&_nc_oc=AdpU7GJ1MTT4-xJM9eylFVMXw4CoJhRSAi5I-rto0KinWslHxqjY5f-4KtdFfMbSsQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0LJJsTJpYnNNg8FpePUlLlB0bY4CFyiiAmSsNRQDmFbQ&oe=69F0C266"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD8peDvpI9YQ7kNvwH2rH1J&_nc_oc=AdrWvRxRW6nQCYOogZ55jImdPpTdAU7_WnGZQ-PEoUX0iMAfxThk9WTHZzYMQaS1Ep4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2-2dAqef0kQ8YguqeO9JBYzmbVdVThhcz5nMQLI-AgAQ&oe=69F0A1C9"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ehK2HQ5ni4Q7kNvwFCqxr3&_nc_oc=AdpoMyJP1kUKjD27Deeolwj4EbiqRmfmLiOz4Ms04FU3O59g4v4hovMFJbiy7UtRNfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2sRvC_6nP9cVwIU3uyT0xNt46pP1qOQHEomiWUyMOjtg&oe=69F0A40F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_9ay6ToReYQ7kNvwHHHe7_&_nc_oc=AdrhwNT80hpgDVVTW6yUzUwJXB5P9p95DWKIbab45jfVtIpzLwNKS8rjsIHxRQqr3-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3SyJqTEsLBdLZ2K9NJejTf6cpShWfmjqwA2h6EyDxNIw&oe=69F0B344"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6vLfr-fRykQ7kNvwEPhGet&_nc_oc=AdqXlPkGB3IXrIVAIMLpWVXeUYGG8XH7KsOJrDgId9ZPv6pTDblEdFKU4xNdt7AsjUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3C9wq_kuzdvJXSh-1j5Ojjm1Ifpx_2rPRJe2bcdsbdQA&oe=69F0B3A2"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
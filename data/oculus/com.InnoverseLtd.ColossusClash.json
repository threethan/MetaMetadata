uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea_LFsXquBMQ7kNvwHE-mzk&_nc_oc=AdpNdhwTNAR1QpvzpWMgisZqMJGgYDtv00BkDkOUvYBKA_gaB_w6_fg4kA_PzheBd2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1WYEkupdefY84WPdTJthhtFvBt_h_f4TyAb9FBdMvVMw&oe=69F213E6"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD8peDvpI9YQ7kNvwEuAyCr&_nc_oc=Adp18mqR936WtSZzWx3ykwu2VXAI80L4QSO2UQZFxES1CF8Q9W9W_U2ewZIFgPduuNI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dxAdROdnQocsOOaRz3HYMYkVYqZ-ImhflInnoRqhV0A&oe=69F1F349"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ehK2HQ5ni4Q7kNvwG8F9Zb&_nc_oc=AdoCKDTcE3ZOylwC-rzIyF-a8vkgI7QoH-JUCcVwymiPf6HDvzXlpgqtZX5iv_8f-XM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Q2i0yzFb8Sm6nYh6lmIRcu69fKab4YG-ME0jyLFUmfQ&oe=69F1F58F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aimOS0mVy4Q7kNvwGmI5-J&_nc_oc=Ado3ZkyybKCOyXGYAqMvwBCIt6Bk-D4b0dt4DEjR01lSSrx8m9caBaTkuTem7_Hu4Rk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1V4Ww0eknI6Rxl013T9cDX574CTqSQ0zMuSk6NmVS4eg&oe=69F204C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6vLfr-fRykQ7kNvwEWfSy9&_nc_oc=AdrJBJ_iYwyI2pQ4dBxljrIUJf5AIBzV1m7uTKLYXK3BexJWtQnqTyeMuVMJUlIf3oY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3OH-hEOligPGeR3E-Lx8SL4bB_Qu4e1Mlft-kjVFC1ag&oe=69F20522"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "re
n.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq9OcyEW6YcQ7kNvwEWCe54&_nc_oc=Admw2ysCQ6axgaCbUJjfQL1VpL0eVXKjsmdfM_uQwAKdoijIDn9yUWQXzLwrVXbTGSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftCd9q2pzpAvThSxIseAoHZq7pnevqN8Hyuo0qJNnYpfA&oe=69986DE6"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pCe8NZ7gO8Q7kNvwFoxH_j&_nc_oc=AdkmYWC59ARPRWXdyK7jQpucxlz8yi2E2HHzZOCT-wWVcl4N8vVbrQOUGZbdEiKv3VU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvbbU3UUoIsi9LEjANHOAAVe-wxGA7JPmFzyhd9pEIeIg&oe=69984D49"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRzbOGtssvAQ7kNvwHlzsTR&_nc_oc=Adkb_zuSwBdipxAXNHZHSNGUvL6RMAGUZ9-oq2acja8O4tZcjHJF7vW00N2xSVr8HaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvob368fJAjsmSRLoZxCtsK7rPWplaor6Tsz-GH7Iztag&oe=69984F8F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENycM8bZVVUQ7kNvwFUMDk4&_nc_oc=Admc582raU5aII0uD8MLDcDaO1_BpBluUzU3cbevifDtAeglxuDAnC_C11Ve3QYuL_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftEl8KianstUNUSJgx3BUEcTPAhy1EocX9Ze3GU12WumA&oe=69985EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RrNV9oAaAkQ7kNvwH7KZ9S&_nc_oc=AdkX6MYv8wAHgnm_OWyGDxRFNv5x0i3Y-ty2M6US79nwAhFmL1X1zV9otoTA1bl-8j0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftgrVPBeJ7NgPAcyzEeujaloJRQACBDGalJR_E8Vgexyw&oe=69985F22"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
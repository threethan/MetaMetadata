oe=6A07411D"}, {"file_name": "1.png", "id": "1026360174725848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc4NVHjLDh8Q7kNvwHkOuHo&_nc_oc=Adpb0m6Zp9rBVBUl8JecNdhJjm4xIFXLn7pz4XjmavD0qgPyt4XOWG6xUk8dh7wE1ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6avne4G01jqV10YFoXBT0qCEN8zYlp7KsjU7FcQcw9pQ&oe=6A072BE6"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o7cw9ZYVUcQ7kNvwE8LCXf&_nc_oc=AdrE1g_vc-aZHKcwU9gxWoHXSCjwtF5wvvVm7jkLUBfVTkUlUv219z_U_PrBcpbrfaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af733C3oOhwE15ni9bSAgmfLSkjN7GyNGGbE_ckp2rH4xQ&oe=6A074389"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtRHKNypU_YQ7kNvwGb4XpX&_nc_oc=AdrlY9o_4ZEvcjE5BddurEdh1v_PBoDK6KuylMwPA-ek2itIMLOYhsAnpYxv5mj17fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kgx93u2V_fE_aXP6OFL7QJmZlEQsVuYH9wURteUZxSQ&oe=6A070D8F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKiuRIPykqcQ7kNvwFn7AEj&_nc_oc=AdqSXc4GGxTsXJB4PmLRig5PiPL1ONr0q0WJCq-eP3x99-SboWFFktcjgwPnaiJkrVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78e2iy4KE6i5O-tw--0hMmpuq78yb7dsgDYJ_xGXJMOQ&oe=6A071CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcF5CKTyK8YQ7kNvwFQKrSl&_nc_oc=Adq74Po2_7NFaktmdHvX_pDw42ys67845o8082hWOjvyoKNXfn4F4P3ifLBZsW7pZnE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R_psNyW5ckOkNkwXPF41qOaDe8v2WGCvwV-NF0lPviw&oe=6A071D22"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "inter
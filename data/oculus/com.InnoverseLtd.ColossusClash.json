png", "id": "1026360174725848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edFQu5OAzyMQ7kNvwGHUADk&_nc_oc=Adm3tZVKkWIWOq2sDLNSqd8IosADwX1dSc6svyi39rjF6m4sxgsbmtvEiuG7fuRbABQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyuocr9VhZ8kF8Ap1s6SN-f3NJrm7Qc9SzrZ6C-_fgA-A&oe=69B56EE6"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZ_icLw5MksQ7kNvwHPIxI1&_nc_oc=Adnh-z8qCkY1kYj5lkUXeo1rv7v9zA-bzms4z9OHl7_pv4L5npGsiTkhQ067TA5mNfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9F0eMsw403dFoKl8P-8t8YEEWQAJ0n6et3KL7ywVWOQ&oe=69B54E49"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jxA-l3Apk8Q7kNvwFI-cPh&_nc_oc=Adk-BfjYNjT9a5pmRP4FnUrml44d9p5O4uVOjJ-pVxXtpUtA84BpiMkvkDPk999HeEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9JClF8tmfhhyfEH0DwgtfGHuGcHUUMuOrnlChPDqOIg&oe=69B5508F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3rIETDx7LsQ7kNvwESskKK&_nc_oc=AdndxVvD4sL-GRN_q1zL06HmMxf0dPTMSPfbU04nU0gavBfawVTX29loDAcqAlxyOdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHdnGJA1d0gx9kTgfPzKvhjN7lhssbR8e8_fmgMHTk7Q&oe=69B55FC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDgyttQ7vSkQ7kNvwHhxcxk&_nc_oc=AdmX3PDlUY3V-aqJ3vwab_AZxNSQJZsDBdmyaAL1OzVoEn6NaVLhl3ADvKtslMlDowQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzz2e_V9gu6uiQDdubAMJNUEmT-4XbyzYmJaRCgYEzj8g&oe=69B56022"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEM
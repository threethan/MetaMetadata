n.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJy1bISd3hoQ7kNvwErIFVZ&_nc_oc=AdmtX2tzdpudvhioY1BGsvvERwqAZcPdei4W2rbV5HysAR91rIOqnYSXTOVuLjwR9_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvqB8qFqfPpLLZdbsbR1Q-x7uXqbUZxSGzXU1dvF1KnKA&oe=699F0566"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pByFV568kxYQ7kNvwEPd4HZ&_nc_oc=AdmQVZBkGAMKSDHrvrCRk4ej3DoezP6fycm9gUpZHKmq02HRTUbKYuJZyepwxEInUyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv996C2deh2d_M4wIw4-3ugVNND15CwKmuMoqKtfgvAqg&oe=699EE4C9"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuM-9UpbbBMQ7kNvwHCNWzE&_nc_oc=Adm3HH-geAKvilpxh6XfraCxjZNl5vefxkSRkLjk7y6Wf8-fbqIsQ48YMOky_ZVrX4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftu-AKkFNOoSHjQCbj7wSLeTzge2zEBoI9tkzxJo5hC3g&oe=699EE70F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3ai_GVBf8IQ7kNvwE4bxWa&_nc_oc=AdkIIoQ5gSKHup9lANn3IKrJp-JeQPcIMaHMoYi85YPqh_G2TwlVB3SHR6ortMEokEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu8xz8hJ2gk1sKWWk32pipOlWl-iaa6mvb2FUR46p9jqA&oe=699EF644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPNkR-45SVQQ7kNvwENQj3E&_nc_oc=AdlCZab0LJzNbh2TEiO17o0RTwtH9nAetVFg6UK2Ag9q-aYfdoQaOWNHgSfey3zH3sg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsb9SdqK2g4vRGJNYcd3a8AkQl6qP0xUv0s8nULcfxLjg&oe=699EF6A2"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
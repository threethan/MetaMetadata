oe=6AAD5E1D"}, {"file_name": "1.png", "id": "1026360174725848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEPeAYTjLi8Q7kNvwFAIDRK&_nc_oc=AdrSLzuFDbE0YaXBH3aRNGljrzJhyWPZTxsWXP-wA8AjWEuawgXi1ufBhHsiD3tPqqI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrlASYR1XjObOzfGj8EtgO3SDZ1OuY5n-zuJ7-zW7OVg&oe=6AAD48E6"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPTEHloe94gQ7kNvwHawgDE&_nc_oc=AdrJxDUftRA3OKQHCXekFkh8Y8YFkXRZ701kiO0trbfaTmuCISLNYHOG57ACqJuifLk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAR6QziMx1gNdulxIoDA7iL7nsa6iVMEqPBrc86Bj1_A&oe=6AAD6089"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6pjnHIy-04Q7kNvwEsYPtt&_nc_oc=AdrQbCGzhSatDWbGk5R1SQT8xlfzD8W7BdcEgQdpwZSO93S84Gtq9JvOtx8Q0BU4uqk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ32pCxBq5n1iM-TsN758dp6shPtBnaAuOIbdAPxhf6Cw&oe=6AAD62CF"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWhY4H4oyHgQ7kNvwHccEdH&_nc_oc=Adrrqb_kpU_kpBLJdseh5l0DUyxLiKdZy0K1StWYgeMi-90YewUB8AdL1jXRAsIiONw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW4_qkj7AFJSoRQ_P5oat4R59ZO-_b2OWIbu45KRRu6Q&oe=6AAD39C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M45tOmRQOLYQ7kNvwEuCzPW&_nc_oc=AdqP37-R7LZNs1-1eYEiyWIANJ9OkThTZKiAO81MMkTNfqX_FCB656GfF6SR3WP4idg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeaB25bHmrtHaM-e6a3bY4FHXYs6NPslpzDU6c3EG8uw&oe=6AAD3A22"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "inter
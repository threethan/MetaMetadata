n.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq9OcyEW6YcQ7kNvwFLIsIF&_nc_oc=Adn_jpwqeYYYq9IrFowHZ6c_OOZ62K4MfuzplGmUCWOdX3YrR-Bnoyji4Ma5gv2hS9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1OSdoWkHQrhINOHwh3i1PjDVLUbkwnU7LzutPlxrz4w&oe=6999BF66"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpOHbW0xRbAQ7kNvwFI3tMQ&_nc_oc=AdmPXMDsx2WrgHBT-kufHqZFd7_cvFdoKBt6UgXdPlSaVwCMXuEyVxhqXSO7g8jXtn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJ1sp8a_Esy_QUR45mblUZdN7P6ys2Shaj9hDKjWNOzA&oe=69999EC9"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRzbOGtssvAQ7kNvwEWP6Jr&_nc_oc=AdmY-iSd4jj3fvvwqU59MBosk1ryLIThJo2rqXIAQNpeK-8lRIeGmR6i0016VK2DYR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftsklvcelfS1tKg45i083zL8iqeDg_PboK4C3D9M20MPw&oe=6999A10F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENycM8bZVVUQ7kNvwH6sFPa&_nc_oc=Adl2C6YKa2Wg44EKVJ170hfDPPdwirtQ8myIUCmUHrQdvCAmIza0fUJ5rlgWxM6uRKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCsueFscWp375aG2fHeGN8xgh-45nC6tm7z17Duygcqg&oe=6999B044"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RrNV9oAaAkQ7kNvwFHSPaV&_nc_oc=Adkh9p8ihe1R2lVtaPFdWVi6DA6BFQu_8Lv7t72mIosRltOwuVi_H_Bcb8HFMIcVQQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3h4vrVkni9De-Eb0xWex0lFWk7IhJP774LMT5OBbHcQ&oe=6999B0A2"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
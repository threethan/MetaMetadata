oe=6A55099D"}, {"file_name": "1.png", "id": "1026360174725848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031501_1026360181392514_5772972101124728440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9176DpbcYO0Q7kNvwEbs9Z-&_nc_oc=Adqye_p2QRuufaf_nbp5saiSu3fazHNJ4BWzgUqL9kee6NnLiO5D5ae7CdW7WCaTFYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Y472DSyMFU3XrbN_6bX2KYJwCePA7LeC8hD4YA0YYQ&oe=6A54F466"}, {"file_name": "3.png", "id": "5356464177777667", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031315_5356464184444333_6610078317675759136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6XaWCnDYowQ7kNvwGdBuVh&_nc_oc=Adqjw06NpasPA0TwibM2woJG6964DYRR9dRrSRqDDvDjOYQ1CsHcE8_hRGRVBUXVCK4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3z2e0MUzMFxlqMR5TVgXmurAGzwA_VYIweKD3e0Lhfg&oe=6A54D3C9"}, {"file_name": "4.png", "id": "1431335497314348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031486_1431335500647681_1686344886073852064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uodt-ABwJ60Q7kNvwHarVmN&_nc_oc=AdqnxsOblrbT4FK085waRLEe1xdjMRmabY1sjASgtq-3HLyYA1Qu0PViFqFJqBpxGUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTOSTfDBoUdHvZkwjCKcpBG_4-lBarzzhz8KwtKk9aPA&oe=6A54D60F"}, {"file_name": "2.png", "id": "419920313503397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_419920316836730_2738687825154909892_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF8vsPwv4NgQ7kNvwEJICWk&_nc_oc=AdqyCZwAQvfzphORA6G1EbOc3bTBwS-dhW1EbzdvJR5MunZcOaVyZzh_RAv-ZdYoVVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMA-lBPfWrGZpW3wmmAsSb5ONupcITAIMJJUlWKYBVTw&oe=6A54E544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "335759385433334", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982685_335759392100000_4345801136256239976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwNM4JULtxoQ7kNvwFbdaSi&_nc_oc=AdrkYTwHBUVn9L0NcvVde_yantNYp65Zq7q104NYneVoGHSjiblCQMQ7bba3SPJoRuc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWErsTUn1jA2HmGBq76HHVkuobwa2BQFQ7AEc6Gg4TXA&oe=6A54E5A2"}, "display_name": "Colossus Clash", "keywords": [], "long_description": "Take the fight to the enemy in this VR destruction based fighting game that puts you in the place of a newly arisen Colossus with freedom to protect the world from the other Colossi, or use the buildings and vehicles to your advantage to take down your foe's.\nBuildings collapse around you, as you attempt to defeat the enemies that want to take over.\n\nIn Downtown throw the bad guys through skyscrapers, use building equipment to dismantle your foes in Construction, and drop them to the deck in the Dockland map.\n\nColossus Clash comes ram packed with ways to demolish the environments and destroy your opponents so if being a hero isn't your thing, then find the hidden weapons to smash down your enemies in style. Use  any weapon to hand to hold enemies at bay with differing difficulties in each map, and challenges to complete for you perfectionists out there. This game is in early access so lots of content is still to come!", "short_description": "The ultimate monster fighting game. Put your skills to the test in a world full of giant colossal enemies, where destruction, ragdolls and chaos is around every corner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "inter
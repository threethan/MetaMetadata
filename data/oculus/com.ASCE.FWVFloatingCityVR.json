0hYxYNfACA&oe=6AA804E7"}, "display_name": "Future World Vision Floating City VR", "keywords": [], "long_description": "As sea levels rise, imperiling coastal communities, one form of mitigation will be offshore floating cities. What kinds of innovative, resilient, multi-modal planning will engineers need to do to take on the rising water? The Floating City leverages innovations in ocean engineering to create an urban system that operates in symbiosis with its surrounding ecology both above and below the surface.", "short_description": "What if cities didn\u2019t retreat from coastlines but moved into the water instead?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.futureworldvision.org/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ASCE", "support_website_url": "https://www.futureworldvision.org/contact-us", "website_url": "https://www.futureworldvision.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "197986333103063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001719_743873853400787_2407302067103929787_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYEwjaxwUgkQ7kNvwEnbbkd&_nc_oc=Ado9zxgZazxvMBK1QYnTkY6TqYWFbx4xzsOGk5gU8mJSripsaonODUh-g32cYGY8kms&_nc_zt=3&_nc_ht=scontent-iad3-1.ocul
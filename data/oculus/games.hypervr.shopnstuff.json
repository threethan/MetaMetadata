SxeEHzsur-p0pwfaW4qriDVYEpO6UI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2viCpueMNL-wB_TaBbJHNq5jr1l3SezABhDeHpyG7ePA&oe=69DF7610"}, {"file_name": "Sh&S_2560x1440_4.png", "id": "3424310577727128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_3424310581060461_313656183049817363_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MEm32MB6-QQ7kNvwGUexu0&_nc_oc=AdrdgWXf2nF__8QndB3kzkKAKOdUL-mG701mFQuMigo44jQ13eVNzHmq9ORHbk-chhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sJnDLM7brO0KYjuAxt7xS6vdMh_ZVtrkwxiss2ZH2oA&oe=69DF6E13"}, {"file_name": "Sh&S_2560x1440_2.png", "id": "1204082218560414", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823341_1204082221893747_7101865768131432857_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtqmTmXcFe8Q7kNvwGGQ2-a&_nc_oc=AdpkySl_vCwut2lZLvy9cx88Nj3I9uq2y8wDxjWbXlY1307QTtYIeN6XYWuImHIox38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J4LXh7T14_izu32HzEwRyK8QMc5eKRxl6YZ93yD8Rxg&oe=69DF8DFD"}, {"file_name": "Sh&S_2560x1440_5.png", "id": "1237990471846703", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825345_1237990475180036_2949744428210187998_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JopZ6hRJH38Q7kNvwEJd27n&_nc_oc=AdrtlA5b0urguv5-mKs-Ii-A3k-zqvoN4HqTR8Usz8r3Ec5lGMUtJRkdcBAd4KbrSQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03HTWJa_y36wuqWwbOWqSncFymRivp8M4GZZS18KSmrQ&oe=69DF9BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sh&S_Landscape_2560x1440 (11).png", "id": "1617745229177532", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1617745232510865_644736359716390760_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIQXoqc2wpMQ7kNvwF6HTbo&_nc_oc=AdoxHhG6jpaFG6GPnAoVQ7Fi70W3oREd8c2IzMogaqrik33zybbXoAQODHbY9WnNfMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yd40utOyxfLo8Myzrvd3Gsh81p-dI2YjZlgds5VYK-g&oe=69DF7371"}, "display_name": "Shop & Stuff: Supermarket Simulator", "keywords": ["supermarket", "store", "shop", "market", "simulator"], "long_description": "This isn\u2019t your typical  supermarket simulator \u2014  it\u2019s full-blown retail chaos in VR.\n\nWelcome to **Shop & Stuff**, a store where customers argue, machines break, shoplifters run, floors get messy, and now everyone talks back.\n\nStock the shelves  and react to unexpected situations,  or watch your shift collapse in real time.\n\n# Reactive Customers\n{2073024840220942}\n\nAll characters are now fully voiced. They comment on what you do. They react to spills. They complain. They provoke.\n\nCustomers no longer just shop, they engage with you and escalate situations into hilarious, unpredictable moments.\n\n# Run the Chaotic Store\n{1472643141225138}\nStock shelves. Scan items. Handle rush hour. Miss a detail? The chaos builds.\n\nFrom impatient buyers to sneaky shoplifters, every shift becomes a reactive sandbox of problems that demand fast decisions.\n\n# Everything is Interactive \n{2112883662879804}\nCustomers now bring fully usable objects into the store: frying pans, Nerf guns, squeaking toys, cash\u2026and more.\n\nEvery item is interactive. Every object can trigger new reactions.\nWhat starts as a normal transaction can turn into total absurdity.\n\n# Mess is Part of the Game \n{908739078743810}\nSpilled drinks. Dropped food. Mystery gunk. Ignore the mess and customers react. Clean too slowly and chaos spreads.\n\nEverything is physics-driven. Everything affects the mood of your store.\n\nGrow from a tiny roadside shop into a fully operational barely controlled retail machine.\n\nFully voiced chaos. Reactive customers. Physics-driven disasters.\n\nCan you keep your store running when everyone fights back?", "short_description": "Shop & Stuff, the quirky VR supermarket simulator where chaos is just part of the fun! Pile up goodies, charm wild customers, chase off shoplifters, and deal with messy spills.\n\nStart small in this roadside mini-market and hustle your way through each day by keeping shoppers happy. Bring in the bucks to expand your store and purchase new equipment to streamline operations.\n\nCan you turn your little shop into a thriving business? Welcome to Shop & Stuff!"}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/shopandstuff.html", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25972729195745171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312068_1613126036593630_2566299218131665820_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k7p0KVipzEQ7kNvwFLyuVr&_nc_oc=AdosHRIIsOSHzxDLB-xF9Pk4hOtjUo4-tFF0pjxiMk_IiKNCZxiNR108uUPR6iobn2Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ff103rw0kwubF0tO5EN4KH6blUNDOmaOKdfxxbUj-4g&oe=69DF7635"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shop & Stuff: Supermarket Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"to
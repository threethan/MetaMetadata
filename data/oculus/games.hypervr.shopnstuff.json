05966_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9qbAM061AYQ7kNvwFxJm0e&_nc_oc=AdrlkhovSE3DG8z5YUwEGsaxyUoYWWy7I5ssYgOACQi0PEUfr0wmqSzFV-WSZmwcAMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16xNrSWxN9TgnJEOyUxFozO_DcAlbGO9Ao-g2JB04iMA&oe=69DF7F63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Landscape_2560x1440.png", "id": "672789002250426", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400714_672789005583759_1774806635818746210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLm4yXxCPUEQ7kNvwH3LS8K&_nc_oc=AdqQeEWwLeAyEFFk65nfFgOZtc8VRumX0nuaN2rmpKHueTXLjA4BDFUFkyh4wwC4G4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e0YLmhPgU0e62GJy4V0rYmPJnMgu1tDVlA76tkQZ48Q&oe=69DF9129"}, "display_name": "Shop & Sell", "keywords": ["supermarket", "store", "shop", "market", "simulator"], "long_description": "Step into the chaos of **Shop & Sell**, the quirky VR supermarket simulator where running a store is anything but ordinary.\n\nStart small in this roadside mini-market and hustle your way up by stocking shelves, satisfying bizarre customers, and surviving the wild world of retail. Chase off shoplifters, fix glitchy self-checkouts and clean up unexpected messes to make it through each day!\n\n**Run Your Chaotic Store**\n\nPile up the goodies, charm customers at checkout, and keep the floor shiny, or watch chaos unfold as shoppers slip and track mystery gunk through the entire store! \n\n**Keep Up with Wild Customers**\n\nBe ready to meet all kinds of visitors, from curious browsers to angry complainers. Keep an eye out for shoplifters and kick them out before they steal your items. Watch out for ice cream and pizza slices, or clumsy shoppers will turn your floor into a disaster zone.\n\n**Level Up Your Shop**\n\nYour goal is simple: keep your shop running to bring in the bucks and keep shoppers happy during opening hours. After a hard day of work, invest your earnings to expand your shop or purchase fresh equipment like the self-checkout desk or coffee machine.\n\nGet ready to turn your little shop into a thriving business in this hilarious, unpredictable VR supermarket simulator. Welcome to **Shop & Sell**!\n", "short_description": "Shop & Sell, the quirky VR supermarket simulator where chaos is just part of the fun! Pile up goodies, charm wild customers, chase off shoplifters, and deal with messy spills.\n\nStart small in this roadside mini-market and hustle your way through each day by keeping shoppers happy. Bring in the bucks to expand your store and purchase new equipment to streamline operations.\n\nCan you turn your little shop into a thriving business? Welcome to Shop & Sell!"}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/shopandstuff.html", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9706128839498465"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2675707116149555"}, {"status": "CANCELLED", "id": "1214536254070518"}, {"status": "PUBLISHED", "id": "2596091950768934"}, {"status": "PUBLISHED", "id": "1833407617289959"}, {"status": "PUBLISHED", "id": "1102797238693935"}, {"statu
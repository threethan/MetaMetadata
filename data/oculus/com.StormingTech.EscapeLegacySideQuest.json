8_431539111299390_2301478161739990019_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVtsG9ihawwQ7kNvwFXAWFe&_nc_oc=AdqT4gq2JJbT6cIK-PwSfTU16e08A-0r3DNToL6COi1dRJN-eCyaMIE4PH2Hcj5Z9QQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWYec9FK0E8iwRxDMkoPtv0MaXEHW0GjKffkX8syZ_cQ&oe=6AFB4973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "201670918371185", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392880_201670921704518_5789896785211617000_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DEQb-AUiXUQ7kNvwHbtYVY&_nc_oc=AdojFnrW4JWAZUreVC93RGSarkZkVv3OjXc9zuRqIY_ehr0Vpnx3wyUYmmQ_Mm3q3AI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVsHSUUivcFHTRiX6Yn8HWVvHfM2js0-bUiz_a4XKvUQ&oe=6AFB4A7F"}, "display_name": "Escape Legacy", "keywords": [], "long_description": "You Play as Erica who follows the adventurous steps of her grandfather. Find all Ancient Scrolls while you trying to make your way to the escape door.\n\nSolve series of Puzzles and riddles! Explore numerous rooms and locations, find hidden items,clues and escape before time runs out! Play with a new fresh type of Realistic Gameplay for escape rooms!\n\nForget about Old casual escape room or point and click games... BE IN THE ROOM! Begin your Adventure today and make your True Escape!\n\nFEATURES\n\nMovement : Locomotion/RoomScale/Teleport\nAmazing High Detailed Graphics\nPuzzles and Items Change Every Time you Play\n10 Levels with 80+ Rooms to explore\nOver 10 Hours of Gameplay\nChallenging Puzzles\nThrilling Music and Sound Effects\nPlayer Interactive Gaming Enviroment\nIntelligent Inventory System\nUnique Scoring system with Global Scoreboards\n\n*Please Note that a network connection is also required for submitting your scores. *Game Progress is stored Localy, please backup before uninstalling.", "short_description": "Explore numerous rooms and locations, find hidden items,clues and escape before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stormingtech.wixsite.com/website/privacy-policy", "developer_terms_of_service_url": "https://stormingtech.wixsite.com/website/eula", "publisher_name": "Storming Tech", "support_website_url": null, "website_url": "https://stormingtech.wixsite.com/website", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6976420849144788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203627_423659809087847_6676187450228084112_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ooi8FP1xghoQ7kNvwE1ORjr&_nc_oc=AdoKTbNdv6QNcVDBO3mniPgVn9WPN6upKc58PiAOvxXMq1D5RiMh5nKB6J4QatjX8DI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxyT7-p40zsH6MbQhF43cpDV9tD3wR7mWAHencZfTHXw&oe=6AFB1D1E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape Legacy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1618284337, "lastRevision": {"nodes": [{"id": "561206384837208", "release_type": "SCHEDULED", "administration_status": "A
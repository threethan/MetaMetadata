, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "201670918371185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75392880_201670921704518_5789896785211617000_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-VNB2g95rAQ7kNvwFhUESf&_nc_oc=AdlmIt2b6kBYIPf04hDMMGWCGJowYNZqsBLLNQa7GgyQMRUxesCeOXRJdG_8I6yXc-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOUnTwB6RQ1z7gjDGzbnD8FfROPDaMDijqjWU0oUZPeg&oe=69AC353F"}, "display_name": "Escape Legacy", "keywords": [], "long_description": "You Play as Erica who follows the adventurous steps of her grandfather. Find all Ancient Scrolls while you trying to make your way to the escape door.\n\nSolve series of Puzzles and riddles! Explore numerous rooms and locations, find hidden items,clues and escape before time runs out! Play with a new fresh type of Realistic Gameplay for escape rooms!\n\nForget about Old casual escape room or point and click games... BE IN THE ROOM! Begin your Adventure today and make your True Escape!\n\nFEATURES\n\nMovement : Locomotion/RoomScale/Teleport\nAmazing High Detailed Graphics\nPuzzles and Items Change Every Time you Play\n10 Levels with 80+ Rooms to explore\nOver 10 Hours of Gameplay\nChallenging Puzzles\nThrilling Music and Sound Effects\nPlayer Interactive Gaming Enviroment\nIntelligent Inventory System\nUnique Scoring system with Global Scoreboards\n\n*Please Note that a network connection is also required for submitting your scores. *Game Progress is stored Localy, please backup before uninstalling.", "short_description": "Explore numerous rooms and locations, find hidden items,clues and escape before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stormingtech.wixsite.com/website/privacy-policy", "developer_terms_of_service_url": "https://stormingtech.wixsite.com/website/eula", "publisher_name": "Storming Tech", "support_website_url": null, "website_url": "https://stormingtech.wixsite.com/website", "categ
8_431539111299390_2301478161739990019_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKypoLrkFGgQ7kNvwE_wym9&_nc_oc=AdrLfHVuUMPT77NqZUlSt8l24yZf3OLOPU6zFlr4jH3GKluOCeGSimZPzLDo-laI0DE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-3fBawOz9p76zd4Unof4zaC-dFjDqtFinSR47Tdh_ug&oe=6B0F0FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "201670918371185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75392880_201670921704518_5789896785211617000_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3L7hoFZ0VgQ7kNvwGdLMlG&_nc_oc=AdpBLGSovYS_ghZu47nAXt8QG6yJnIAUy1LSPy6ipWqVpN9xcnN0MY5o3P9xK3QTJfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUKi3CadkBdSihh_BodZXigeYSIHWBG7ZtEzTlQbtc3UA&oe=6B0F10FF"}, "display_name": "Escape Legacy", "keywords": [], "long_description": "You Play as Erica who follows the adventurous steps of her grandfather. Find all Ancient Scrolls while you trying to make your way to the escape door.\n\nSolve series of Puzzles and riddles! Explore numerous rooms and locations, find hidden items,clues and escape before time runs out! Play with a new fresh type of Realistic Gameplay for escape rooms!\n\nForget about Old casual escape room or point and click games... BE IN THE ROOM! Begin your Adventure today and make your True Escape!\n\nFEATURES\n\nMovement : Locomotion/RoomScale/Teleport\nAmazing High Detailed Graphics\nPuzzles and Items Change Every Time you Play\n10 Levels with 80+ Rooms to explore\nOver 10 Hours of Gameplay\nChallenging Puzzles\nThrilling Music and Sound Effects\nPlayer Interactive Gaming Enviroment\nIntelligent Inventory System\nUnique Scoring system with Global Scoreboards\n\n*Please Note that a network connection is also required for submitting your scores. *Game Progress is stored Localy, please backup before uninstalling.", "short_description": "Explore numerous rooms and locations, find hidden items,clues and escape before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stormingtech.wixsite.com/website/privacy-policy", "developer_terms_of_service_url": "https://stormingtech.wixsite.com/website/eula", "publisher_name": "Storming Tech", "support_website_url": null, "website_url": "https://stormingtech.wixsite.com/website", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6976420849144788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203627_423659809087847_6676187450228084112_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9qMsmfAf1gQ7kNvwGSiJ3s&_nc_oc=AdpYOQutwZvckWPCwK8TWDqdEICuDiR0Q2se6VXwX9LS7WuaHWLIJi7PbszMWEKU2S8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWzHPD9srYbEpWC4l_Pe-YGVLK5yCl8lqNJC-i3iG4YoQ&oe=6B0F1BDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape Legacy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1618284337, "lastRevision": {"nodes": [{"id": "561206384837208", "release_type": "SCHEDULED", "administration_status": "A
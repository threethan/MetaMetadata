 "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1402797376250045", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1508749235654858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2180658269149197"}]}, "change_log": "\ufffd 98.1 The Dragon \u2013 Christmas Edition\r\n\r\nRelease Notes\r\n\r\nVersion: Christmas Edition\r\nRelease Type: Holiday Update\r\n\r\n\ufffd What's New\r\n\r\nAdded a festive Christmas-themed design throughout the app.\r\n\r\nUpdated the app colors with evergreen, Christmas red, warm gold, and winter white.\r\n\r\nAdded Christmas decorations to the app header.\r\n\r\nUpdated the navigation and notification card styling.\r\n\r\nAdded a festive holiday greeting: Merry Christmas!\r\n\r\n\ufffd Improvements\r\n\r\nRefreshed the app's visual appearance.\r\n\r\nImproved color consistency across the interface.\r\n\r\nUpdated profile accent colors to match the Christmas theme.\r\n\r\n\ufffd Technical Updates\r\n\r\nExisting app functionality has been preserved.\r\n\r\nExisting API logic remains unchanged.\r\n\r\nPrepared for Android Debug and Release builds.\r\n\r\n\ufffd Thank You\r\n\r\nThank you for using 98.1 The Dragon!\r\n\r\nWe hope you enjoy the Christmas Edition. Have a wonderful holiday season! \ufffd\r\n\r\n\u2014 The 98.1 The Dragon Team", "created_date": 1795755576, "id": "1508749235654858", "version": "2.0", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1402797376250045", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1508749235654858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2180658269149197"}]}, "change_log": null, "created_date": 1793668545, "id": "1457469240782858", "version": "1.9", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1402797376250045", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1508749235654858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793665652, "id": "1457402187456230", "version": "1.9", "version_code": 10, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1402797376250045", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1508749235654858"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2180658269149197"}]}, "change_log": "98.1 The Dragon \u2013 Release Notes\r\n\r\nWe're excited to bring you the latest update to the 98.1 The Dragon app!\r\n\r\nWhat's New\r\n\r\nImproved overall app experience.\r\n\r\nUpdated account features.\r\n\r\nEnhanced announcements and notifications.\r\n\r\nImproved app performance and stability.\r\n\r\nGeneral improvements to make your experience even better.\r\n\r\nThank you for being part of the 98.1 The Dragon community!\r\n\r\nStay tuned, stay connected, and keep it rocking! \ufffd\ufffd", "created_date": 1793566223, "id": "1454831874379928", "version": "1.8", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
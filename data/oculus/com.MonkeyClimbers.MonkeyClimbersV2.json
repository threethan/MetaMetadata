449014820233_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWxZIDHk6kYQ7kNvwHpSQI_&_nc_oc=AdnulXQe_rdgxgd8Rj4oSYDOT2yYYX1MDV0uUzakMvS4MbM6jir65zboKo9y8DQ9EEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_I9E-r13V-ySx0esR7jJTGy2VWs6HcvZ0r4SGPJ7p1w&oe=69A2E72B"}, {"file_name": "output-onlinepngtools (58).png", "id": "25306342905645443", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830147_25306342922312108_4817324827406440128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDr97Nlm4YAQ7kNvwF9hidW&_nc_oc=AdmtjzLXBIAJS_Rrhou0DXbdHS0WXjthy_zwVTIKVEAJQygxrhzArPoxhs_YY5c3b4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQKzzscg6ZjFjWmExZo8NpX_HKV2Yd9EgHghFm1zu89g&oe=69A2C918"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "output-onlinepngtools (53).png", "id": "1604826547202577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_1604826550535910_8579648378988267442_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qVGm2rGd0UQ7kNvwHBy6mX&_nc_oc=AdkZ2g74GQ8sqEizG-ya54NXHlTkn-xMTu1xJJMhMuggB0KKyses6vfWgh4Qhx7DHK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHNkHhRx144KWHKD0UoibQOaQU9eVF3kQdmZt3EOM45w&oe=69A2F6FE"}, "display_name": "Monkey Climbers VR", "keywords": ["mcvr", "monkeyclimbersvr", "monkeyclimbers", "gtagfangame"], "long_description": "Welcome to Monkey Climbers VR \u2014 a chill, competitive, and constantly evolving multiplayer experience built for the community.\n\nSwing, climb, and vibe through handcrafted maps like the lush Forest and the all-new StartRealm \u2014 your gateway into a growing world of monkey mayhem. Whether you're showing off your movement skills, exploring hidden secrets, or vibing with friends, MCVR is built to be fun, fluid, and full of surprises.\n\n\ud83c\udfae Key Features:\n\n\ud83d\udc35 Smooth, satisfying movement mechanics\n\n\ud83c\udf27\ufe0f Dynamic weather like random rain\n\n\ud83c\udfb5 Original OSTs including \"StartRealm\"\n\n\ud83d\udcbb The Idea Computer: Send your game ideas straight to the dev\n\n\ud83e\udde0 Quests & Challenges coming soon\n\n\ud83c\udfa8 Styled, immersive environments with regular updates\n\nNo Discord? No problem. MCVR is designed to be your space \u2014 chill, competitive, or chaotic, depending on how you play.\n\nWhether you're a first-time climber or a seasoned monkey, your journey starts here.\n", "short_description": "Climb, vibe, and explore in Monkey Climbers VR \u2014 a chill but competitive multiplayer game built with community at its core. Discover unique maps, complete quests, submit ideas through the in-game Idea Computer, and be part of a constantly evolving experience. Whether you're hanging with friends or grinding your skills, MCVR is your space to play, move, and grow."}]}, "developer_name": "Yoda's Gaming Galaxy YT", "developer_privacy_policy_url": "https://sites.google.com/view/monkeyclimbersweb/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkeyclimbersweb/terms-of-service", "publisher_name": "ClimberSpace Studios", "support_website_url": "https://sites.google.com/view/monkeyclimbersweb/discorddownload", "website_url": "https://sites.google.com/view/monkeyclimbersweb/homepage", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32044540068527828"}, "review_
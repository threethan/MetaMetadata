om&_nc_ss=7f20f&oh=00_AQGpNCluW42WaxNoBS6yLyydX95FvKqvSA7NPB7dG9MA1A&oe=6A8ED519"}, {"file_name": "output-onlinepngtools (57).png", "id": "1329860709180793", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819281_1329860712514126_3013819449014820233_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X05KdEWR2j0Q7kNvwGnVSh7&_nc_oc=Adpnz9fcWgwK_yl-fYzdK0w9KBXelKjuQTrX6PFNl5n-J1IUhXQJc5lcuxqPFS_lCiM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjSRLCjq6OLS5hXrN4E_ZRZoOZMWUioKCtC7TY-Vvk1g&oe=6A8EE3AB"}, {"file_name": "output-onlinepngtools (58).png", "id": "25306342905645443", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830147_25306342922312108_4817324827406440128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArmtVEy7KyQQ7kNvwFFE8kI&_nc_oc=Adr6cFa_abvY4K-xO2w9yC4-7XLTzGG68t9tPbKzLQ6cFFCzgdfbH-Ns4nODQw0EofM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH32OKwnm37S4764pykKcKzkOikNu0fZtuSW4ywhKD_vw&oe=6A8EC598"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "output-onlinepngtools (53).png", "id": "1604826547202577", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821099_1604826550535910_8579648378988267442_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUDtIF6Uvg0Q7kNvwFUsjTH&_nc_oc=AdqZn2ZNOvTXNUNEhwjUFUMEl3ZD6ndO4gYn7ornMG0yIQonJKX5WS9o2gAV7FhLgEE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6hg-uDO7cSgLMPv6X3H8qNXlGu8UvKYXSHXrYvGvPJw&oe=6A8EF37E"}, "display_name": "Monkey Climbers VR", "keywords": ["mcvr", "monkeyclimbersvr", "monkeyclimbers", "gtagfangame"], "long_description": "Welcome to Monkey Climbers VR \u2014 a chill, competitive, and constantly evolving multiplayer experience built for the community.\n\nSwing, climb, and vibe through handcrafted maps like the lush Forest and the all-new StartRealm \u2014 your gateway into a growing world of monkey mayhem. Whether you're showing off your movement skills, exploring hidden secrets, or vibing with friends, MCVR is built to be fun, fluid, and full of surprises.\n\n\ud83c\udfae Key Features:\n\n\ud83d\udc35 Smooth, satisfying movement mechanics\n\n\ud83c\udf27\ufe0f Dynamic weather like random rain\n\n\ud83c\udfb5 Original OSTs including \"StartRealm\"\n\n\ud83d\udcbb The Idea Computer: Send your game ideas straight to the dev\n\n\ud83e\udde0 Quests & Challenges coming soon\n\n\ud83c\udfa8 Styled, immersive environments with regular updates\n\nNo Discord? No problem. MCVR is designed to be your space \u2014 chill, competitive, or chaotic, depending on how you play.\n\nWhether you're a first-time climber or a seasoned monkey, your journey starts here.\n", "short_description": "Climb, vibe, and explore in Monkey Climbers VR \u2014 a chill but competitive multiplayer game built with community at its core. Discover unique maps, complete quests, submit ideas through the in-game Idea Computer, and be part of a constantly evolving experience. Whether you're hanging with friends or grinding your skills, MCVR is your space to play, move, and grow."}]}, "developer_name": "Yoda's Gaming Galaxy YT", "developer_privacy_policy_url": "https://sites.google.com/view/monkeyclimbersweb/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkeyclimbersweb/terms-of-service", "publisher_name": "ClimberSpace Studios", "support_website_url": "https://sites.google.com/view/monkeyclimbersweb/discorddownload", "website_url": "https://sites.google.com/view/monkeyclimbersweb/homepage", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
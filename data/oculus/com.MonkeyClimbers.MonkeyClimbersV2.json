&_nc_ss=7f20f&oh=00_AQJmHMGPY1PDtt0p9_zuBJde9h_ITU7MyPvXXNsYyq2sHw&oe=6AAEB159"}, {"file_name": "output-onlinepngtools (57).png", "id": "1329860709180793", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819281_1329860712514126_3013819449014820233_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_jMe_j3cusQ7kNvwG9TAqz&_nc_oc=Adr4sNOJqfPGVt7nNA1akUjDxhpS8Of25oTBx9fGMP3iFxvnGu-GtIg-M5R55Q5FkIA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJADEgvt8L4DpqpGz4Bi7IkHHssY49ijWujpa_GQRDBg&oe=6AAE87AB"}, {"file_name": "output-onlinepngtools (58).png", "id": "25306342905645443", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830147_25306342922312108_4817324827406440128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ogocp8bU9lEQ7kNvwEhzc5C&_nc_oc=AdpeRLvycVOM0qrNUOy0FFw94C3yvNJoSaF34NR8yT2aPjfdn_fhSJfgnNWP7R9rRKk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqDbOherwGhpkhVkskRZjYFMSvXItIyK06EHRKaclTQQ&oe=6AAEA1D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "output-onlinepngtools (53).png", "id": "1604826547202577", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821099_1604826550535910_8579648378988267442_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBL5tPMiTx8Q7kNvwFPaPOb&_nc_oc=AdokOfb2Gt1T5JrPSmuqV_5zLgH7rOWIhHahkatWUbzDB4kl70_qvKZ8Hl3-UwzBiNk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS8FFTPsyQtj1g-_vzQWj3Qp4A1WtD4jOSQkPOPvXjpg&oe=6AAE977E"}, "display_name": "Monkey Climbers VR", "keywords": ["mcvr", "monkeyclimbersvr", "monkeyclimbers", "gtagfangame"], "long_description": "Welcome to Monkey Climbers VR \u2014 a chill, competitive, and constantly evolving multiplayer experience built for the community.\n\nSwing, climb, and vibe through handcrafted maps like the lush Forest and the all-new StartRealm \u2014 your gateway into a growing world of monkey mayhem. Whether you're showing off your movement skills, exploring hidden secrets, or vibing with friends, MCVR is built to be fun, fluid, and full of surprises.\n\n\ud83c\udfae Key Features:\n\n\ud83d\udc35 Smooth, satisfying movement mechanics\n\n\ud83c\udf27\ufe0f Dynamic weather like random rain\n\n\ud83c\udfb5 Original OSTs including \"StartRealm\"\n\n\ud83d\udcbb The Idea Computer: Send your game ideas straight to the dev\n\n\ud83e\udde0 Quests & Challenges coming soon\n\n\ud83c\udfa8 Styled, immersive environments with regular updates\n\nNo Discord? No problem. MCVR is designed to be your space \u2014 chill, competitive, or chaotic, depending on how you play.\n\nWhether you're a first-time climber or a seasoned monkey, your journey starts here.\n", "short_description": "Climb, vibe, and explore in Monkey Climbers VR \u2014 a chill but competitive multiplayer game built with community at its core. Discover unique maps, complete quests, submit ideas through the in-game Idea Computer, and be part of a constantly evolving experience. Whether you're hanging with friends or grinding your skills, MCVR is your space to play, move, and grow."}]}, "developer_name": "Yoda's Gaming Galaxy YT", "developer_privacy_policy_url": "https://sites.google.com/view/monkeyclimbersweb/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkeyclimbersweb/terms-of-service", "publisher_name": "ClimberSpace Studios", "support_website_url": "https://sites.google.com/view/monkeyclimbersweb/discorddownload", "website_url": "https://sites.google.com/view/monkeyclimbersweb/homepage", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
40.png", "id": "1803045914166801", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619374_1803045917500134_3990702522058874222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQt1Q-sHGCcQ7kNvwFFG7BG&_nc_oc=AdrtRXXi4eD_Bh87J-OtBba7WB-2U7PGL3XXMFQ6NnW53GzGqZYgB4aBnQVIkdTnES0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRME2uY_M3QlCYvKXPoNz1sh4eicyfcuG3u5ZnVVP2elA&oe=6AFDD4C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AiRhythm", "keywords": ["rhythm", "chunithm", "colorfulstage", "nightclub"], "long_description": "The club is packed, the lights are down, and you're on the decks tonight.\n\nAiRhythm (Air Rhythm) is a rhythm game played on a DJ controller in the middle of a live nightclub. Notes race down the track toward you: tap the pads, sweep along slides, hold your hand on the rails, then lift your hands into the air to catch air notes as they fly past. Air notes can point up, sideways or straight down, so your hands are always moving.\n\n## Play your way\nPlay with hand tracking or controllers (hand tracking is preferred). Nine difficulties run from Easy for your first set up to Pro and Star for players who want three- and six-hand patterns. Tune note speed, audio offset and visual effects, including a reduced flashing-lights option.\n\nMultiplayer\nOpen a room and play the same song with friends. Everyone's booth stands side by side around the dance floor, their hands and headsets move as they play, and whoever is in the lead appears as a giant hologram over the crowd.\n\nLeaderboards, replays and clips\nSign in with a free Satellite account to post scores to the leaderboards and download community charts. Watch other players' runs straight from the leaderboard: their hands appear in front of you as the song plays out. After any song, make a shareable video clip of your run: landscape, portrait, or a follow cam that swings around the booth.", "short_description": "(it's called \"air rhythm\")\nStep up to the DJ booth and play the night: tap, slide and throw your hands into the air to the beat in a nightclub!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://creativecrew.xyz/privacy/", "developer_terms_of_service_url": null, "publisher_name": "NHK Creative", "support_website_url": null, "website_url": "https://creativecrew.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1245757851963744"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1846345640062260"}, {"status": "PENDING", "id": "2310346933100165"}, {"status": "PUBLISHED", "id": "2295250121239434"}]}, "baseline_offer": {"id": "2295250121239434"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2310346933100165"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1310163895523139", "version": "AiRhythm"}, "id": "963417036080155", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1245757831963746", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1310163895523139"}, "release_status
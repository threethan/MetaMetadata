e": "screenshot_07_2560x1440.png", "id": "1797120648066899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604310912_1797120651400232_7297877668371350543_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tUnGXTW_EAQ7kNvwHfjzh6&_nc_oc=Adq__7TuR7l4KL_04TOwj_y0WVoRGld0kKhD63fW8Jqgw7OLgajHKDuVGFyyCymkmB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSazNS4nSdDhJqtubGb6C5MKAwY5Lnd8f09SXsZmsuS1g&oe=6B0D9E67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1038538269284284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673511715_1038538272617617_8451391160610049029_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J91II0djcnsQ7kNvwH3OI1B&_nc_oc=AdouXczMPtC2X4llJod0lCryiCchS_mIxa8IXNeEzkpa49YVBvtLfzpN6BQLCQmQjxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtiul4xJQUG8A1elm_frei8idMbsW8ToUi8-4AkxBkaA&oe=6B0D9D5D"}, "display_name": "Space Ranger VR", "keywords": ["Action", "Shooter", "Space", "Shooting", "Arcade"], "long_description": "The galaxy needs a hero. Grab your blaster.\n\nAn enemy fleet just dropped out of hyperspace, and you are the last Space Ranger standing between them and the outpost. Stand on an open orbital deck high above a ringed planet and fight in full 360\u00b0: scout drones swarm from every side, meteors scream toward you, kamikaze drones dive at your head, and a colossal mothership moves in for the final battle.\n\nSHOOT, DODGE, SURVIVE\n\u2022 Real blaster action: aim with your hands, pull the trigger, feel every shot.\n\u2022 Threats come from every direction. The 360\u00b0 HUD warns you where the danger is.\n\u2022 Can't shoot it in time? Duck and lean to dodge meteors, drones and enemy plasma.\n\u2022 Chain hits for combo multipliers, land critical hits on glowing cores, and charge up piercing shots.\n\nBUILD YOUR ARSENAL\n\u2022 Unlock a growing arsenal: Zapper, Volt Zapper, Scatter Blaster, Pulse SMG, Nova Thumper, Rail Lance and more.\n\u2022 Every weapon fires differently: precision pistols, close-range scatter fans, full-auto, piercing rail shots and explosive shells.\n\u2022 Choose three weapons for your dashboard slots and swap between them mid-battle.\n\u2022 Upgrade each weapon separately and watch it evolve from MK I to MK V.\n\u2022 Collect skins for every blaster.\n\nEPIC BATTLES\n\u2022 Three-phase mothership boss fights with escorts, plasma bursts and a dramatic last stand.\n\u2022 Shielded drones, splitting meteors and kamikaze dives keep every wave fresh.\n\u2022 Ranger powers: Shield Boost, Chrono Pulse slow-motion and the screen-clearing Nova Bomb.\n\n", "short_description": "Grab your blaster and defend the outpost! Shoot, dodge and survive 360\u00b0 waves of drones, meteors and a giant mothership."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spacerangervr.blogspot.com/2026/11/space-ranger-vr-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Game Creations", "support_website_url": null, "website_url": "https://dreamgamecreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1435059719696596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-or
/t64.5771-25/57569446_423905457193075_3386428171821116355_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1MI-yXlZTYQ7kNvwGLTmcu&_nc_oc=AdpRoi-6hM0F0ptLnqmHS23oLEYoqOrL1gWrtEoC5ydUWnfjGm7B0IWutMDrzPqN_kU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSs4rJ2A1Sqywre3FKT25O7_koJ7cAUmeRFU92dnQUbg&oe=6AE75240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "I am cat  2560 x 1440.png", "id": "968901731212026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931336_968901734545359_472725170425619285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_8rlxZ1nS8Q7kNvwF0om1Z&_nc_oc=AdrFGCPKVoyRUmYaJx5c7Em9UtCHpZNKnLCQrA_WFvnQcrmrtrZFnag_XbdAKe6UC3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUPMwLS9LjCjRNt2yqh1tsxFGI0TvfADd__6zUMFQfzQ&oe=6AE743D3"}, "display_name": "I Am Cat - Early Access", "keywords": [], "long_description": "I Am Cat - a unique virtual reality game, there's nothing like it in the world! It's a sandbox adventure centered around a Cat protagonist bearing. A captivating journey where you embrace the role of a Cat. Immerse yourself in a world brimming with diversity and excitement, awaiting your exploration.\n\nOur standout feature is the cutting-edge locomotion system tailored for unparalleled character control. Experience an innovative and engaging mechanic that sets our game apart from the rest, adding depth and immersion to your gameplay.\n\nI Am Cat boasts a plethora of content, from expansive landscapes to captivating quests, vibrant characters, and interactive objects galore. Dive into a rich tapestry of possibilities, where every corner is teeming with surprises and challenges to conquer.\n\nI Am Cat is the epitome of coolness, offering a gaming experience like no other. Prepare to be enthralled by its charm, depth, and endless entertainment that will keep you coming back for more.\n\nCurrently in Early Access, the game will continue to evolve with new content, exciting locations, intricate storylines, challenging missions, and compelling characters being added over time. \n\nStay tuned for an ever-growing world of adventures and mysteries waiting to be uncovered!", "short_description": "Meow and purr, in this virtual delight, I Am Cat - an adventure bright!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221474260512660"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1976607036306098"}, {"status": "PUBLISHED", "id": "1250784703702139"}, {"status": "PUBLISHED", "id": "885984993953776"}, {"status": "PUBLISHED", "id": "707214502035628"}, {"status": "PUBLISHED", "id": "8609730325804598"}, {"status": "PUBLISHED", "id": "432733266138847"}]}, "baseline_offer": {"id": "8609730325804598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1976607036306098"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26409091448740461", "version": "1.4.0.0"}, "id": "1000601100950978", "
095349220686_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN3IFYDDx_IQ7kNvwGWmeJO&_nc_oc=AdrH3bkBLdt9kHAwbmogxRzC_bs7fOs2Cv4V3mtpvNXV9EBtUgdgf2T5DQ0PtUNow0k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1KL58X63zGZjvwqhDYGBJeryF1Jd5fG2HRCt7wVoslg&oe=6AFF1C5C"}, {"file_name": "3.png", "id": "423905453859742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569446_423905457193075_3386428171821116355_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_D6DPAV6uUQ7kNvwEBOWry&_nc_oc=Adpc1HxvoPPQa_MIdm6FPcaOjhRRzr6eB35JKvbggDdn88Ca7IjalKhDlJK1wSB2ljo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR15hp4LghzzL_C3FjJnYUF3ogQr5x-7tdom5BL38jJyg&oe=6AFF0D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "I am cat  2560 x 1440.png", "id": "968901731212026", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931336_968901734545359_472725170425619285_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRMXky4pFiYQ7kNvwGZgkPc&_nc_oc=AdpXdY5dW_7wfzW1uLXz7pIoqYuFe1CR9od_XpcNuDdmOIAc-v0FD1h-sGvT12H-2cc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgF-9Yl_S0eT19clYL43RKARxZlfW14Dmw0pz5ZeqO_A&oe=6AFEFED3"}, "display_name": "I Am Cat - Early Access", "keywords": [], "long_description": "I Am Cat - a unique virtual reality game, there's nothing like it in the world! It's a sandbox adventure centered around a Cat protagonist bearing. A captivating journey where you embrace the role of a Cat. Immerse yourself in a world brimming with diversity and excitement, awaiting your exploration.\n\nOur standout feature is the cutting-edge locomotion system tailored for unparalleled character control. Experience an innovative and engaging mechanic that sets our game apart from the rest, adding depth and immersion to your gameplay.\n\nI Am Cat boasts a plethora of content, from expansive landscapes to captivating quests, vibrant characters, and interactive objects galore. Dive into a rich tapestry of possibilities, where every corner is teeming with surprises and challenges to conquer.\n\nI Am Cat is the epitome of coolness, offering a gaming experience like no other. Prepare to be enthralled by its charm, depth, and endless entertainment that will keep you coming back for more.\n\nCurrently in Early Access, the game will continue to evolve with new content, exciting locations, intricate storylines, challenging missions, and compelling characters being added over time. \n\nStay tuned for an ever-growing world of adventures and mysteries waiting to be uncovered!", "short_description": "Meow and purr, in this virtual delight, I Am Cat - an adventure bright!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221474260512660"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1976607036306098"}, {"status": "PUBLISHED", "id": "1250784703702139"}, {"status": "PUBLISHED", "id": "885984993953776"}, {"status": "PUBLISHED", "id": "707214502035628"}, {"status": "PU
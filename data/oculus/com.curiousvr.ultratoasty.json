.com&_nc_ss=7f30f&oh=00_AQRgjitzo9vtlFZHBhm2pJeqRMoybjkKBOWhRmv1qKI7EA&oe=6B0DB76E"}, {"file_name": "UT_screen2.png", "id": "2877285799304521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618937_2877285802637854_4100794329895227896_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBOuCGtBKYsQ7kNvwEs3_i9&_nc_oc=Adpyf-zfI-PSBULrGUV5mDCgj2rUUsxnyzLo8XRMrqiU3G8zOY5cpRQvukFFnKaq-UA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSn666PibWxiHd8juemZsyWAHyFicAU4xh-PUCJRq6Oog&oe=6B0DB1A4"}, {"file_name": "UT_screen4.png", "id": "1553431129750338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623400_1553431133083671_7831241000677474474_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeZDpsbsGh4Q7kNvwEOSw3B&_nc_oc=Ado3VtEoyLeg-HN9b6SxCRY_5fhzHQIhV7jOFEz9fDYhlXU7HofXzlw8Jet3Q40z-So&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAZNhZ4e-5rgsG0fhCHOM0xxDYZMSxIF9dzXYHqiNWpg&oe=6B0DA2E4"}, {"file_name": "UT_screen5.png", "id": "3484499275039346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_3484499278372679_1102271104388577076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8JKnbhwWogQ7kNvwGU67VR&_nc_oc=AdqX5erWFgZa3ng1VueYYu-rHT1qlssIq19SIMoGnZDbw5czrDIYP-eN2sxMjsen2V8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqqeXtZKpzciW6VuOCE9gmTU3MGDExjCeWbw4uiZH3UQ&oe=6B0DBC11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero5_2560x1440.png", "id": "2172266766927413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595143057_2172266770260746_7548746232922056706_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T7H4ZJFTHsQ7kNvwE5sKR3&_nc_oc=AdohTJVSFCuTSLxhaaoX7hsEdDaCF9sCE6DKbPIsJdZJI7cYgdCU_VQgMA5fUJN2PX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9yfBP57vHjH80srJFZU6jDiSsEF3UqbomqAVtPmRVWA&oe=6B0DC974"}, "display_name": "UltraToasty", "keywords": ["ultra", "toasty", "ultratoasty"], "long_description": "Your living room is ground zero. In UltraToasty, the robotic Legion is invading your entire home... but as a legendary Time-Lord, you control the clock. \n\nDive into pure arcade action: trigger epic slow-motion to dodge lasers in your hallway, line up perfect shots in your bedroom and slice through metal in the bathroom with your sword. Shoot, slash, and bend time to destroy the robot army. Turn the Legion into scrap! Whether you are taking cover behind a bedroom doorway or holding the line in the garage, the digital environment expands seamlessly to fit any physical space in your house. The robotic invasion knows no boundaries, and neither should your domain.\n\nAs you push back the mechanized threat, the true arcade challenge reveals itself. This isn't just about survival... it's about absolute mastery. Survive an endless onslaught of increasingly aggressive enemy waves while constantly chasing the ultimate high score. Fluid physical maneuvers and perfectly timed strikes will help you dominate, pushing your spatial awareness and reflexes to their absolute limits.\n\nTo aid your endless defence, a deep progression system awaits. Top-tier performances and high scores reward you with powerful unlockables to customize your play-style. Earn new enemy skins, upgraded immersive modes and entirely new temporal abilities. \n\nThe time has come! Fulfill your destiny as a Time Lord!", "short_description": "Your living room is ground zero! In UltraToasty, the robotic Legion is invading your entire home... but as a legendary Time-Lord, you control the clock. Dive into pure arcade action: trigger epic slow-motion to dodge lasers in your hallway, line up perfect shots in your bedroom and slice through metal in the bathroom with your sword. Shoot, slash, and bend time to destroy the robot army. Turn the Legion into scrap!"}]}, "developer_name": null, "developer_privacy_polic
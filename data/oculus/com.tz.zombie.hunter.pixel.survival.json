/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=792hVOg3lMwQ7kNvwFdnwpZ&_nc_oc=AdqomwhCyCluUdLao-mWgI-XwRhDaS1eRtLVpf8BRlHOWv0TG9H0-B8VLiAsYpNSqwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89PHAFbbwZlzpZ9jmcag-LamL95qBay7wkcDQXTReiuA&oe=6A2EB004"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ilUqZCNj8kQ7kNvwEIt1Bt&_nc_oc=AdqRupZmAYh3qCElz0ORWvo8zJdjXyRbXEklHS1DfGM_cG8dbI43TL6bHcdfFpKM1wU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xQIWsd1UFSxQrIMoZV6YRGRYjFDTzHNRP_m1ft-FlIA&oe=6A2ED1D2"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNzuKeonsdsQ7kNvwEWnvZQ&_nc_oc=AdoVH8ZU720MAcAM2h7O6fFXGReLMO8ahOXY6RvQSsGdyCmKZtfHhbrS-LVwx-2xtCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CZGRbdjw30tnErrXgAlO-IlYTr4he9X7sDjuep_S_vQ&oe=6A2EA662"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4z10CaETtcQ7kNvwFqFXDX&_nc_oc=AdqAQaHdZva64NnwsVg28VzE6JPuXnnlXIgSY7RPrpw8RUxHuyH2NVtDl3wnXLJn39g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeCh9fDgnuxHjx-vWlx-cKrlvuSRMmIvESRwP9XGXPBw&oe=6A79BF12"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6iEfC05H6EQ7kNvwHFUVvE&_nc_oc=AdqwVwmjZMyLDrsX8-Bqc_xRDlMognZgkKU7ZdY61Rlv0BYA0y_vSXblbFihp2k072Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0b9EBhlMZERhnVlV-Uyg-F9K5h2aX_71mBpbX5W6o0A&oe=6A79CBE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n{1771815273708088}\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n{781851854389742}\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nDive into retro-inspired pixel visuals as a true Zombie Hunter, with immersive VR shooting mechanics for nonstop action.\n{765738352719996}\n", "short_description": "Be the ultimate Zombie Hunter in VR! Survive pixel zombie waves, rack up kills, and fight for the longest survival time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vr-privacypolicy.php", "developer_terms_of
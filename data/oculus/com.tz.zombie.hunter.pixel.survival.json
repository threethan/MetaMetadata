/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4rAi5M0qEIQ7kNvwEsvkb8&_nc_oc=Adq4gPbd-NbVjHUt3nzb7-C63n7INM3EhPCuW1wvF8gyQb8VWKCP18j1Z5ZvQiCyq38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EOehKXT4wT6_0ITPZURsl_0qb3TppGt6heiypQ39gjQ&oe=6A3E8204"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fPGttZa5EcQ7kNvwG2BB-6&_nc_oc=AdqTOd4HPs51PtHYz2QtXrAUQYOH2IRHUT8OdavjeKahV8VH0uei-XhxHzQ6K_G1lF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E9nYLgb5Tx6EfDgP_u8j3APPpJmy0YSSLZqIa85D4FQ&oe=6A3EA3D2"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VujaxL_SugQ7kNvwGrbRUD&_nc_oc=Adpj5Dr4wy4U6gMjQ_Vl_w-0TjaBVQazUsWHsLom7cK0L9Nr6MMORAUfPffTaYy52p0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s90D_VkogvfTkxmEk5kmKUcFTUBltUv-D_GASy-v9xg&oe=6A3EB0A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
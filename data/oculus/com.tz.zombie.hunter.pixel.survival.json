/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=792hVOg3lMwQ7kNvwFT8wNA&_nc_oc=AdpbI_XO1JeD3zHaVNj2Vre5sJ6VbNPkVjAKwXtmtOiUs3_TlEJhqCvBoTqwJ2NVyOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JDfd_HucfPNPUXBaExWmG12RLEErwpoXlXGB8daZHCg&oe=6A2D5E84"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdCGFWt24p4Q7kNvwHC71sD&_nc_oc=AdqAFwZryq7DTyzfv_5WHEj37eGrnVDEAd8NoYjkTS7496qjZ6oZumcQXf4gfuyp__U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bm890Iwb2WrCVHwFLz61zaJQkdTDCmAHM2bI-y1WZJw&oe=6A2D8052"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNzuKeonsdsQ7kNvwGcbWco&_nc_oc=Adpvnp1bShgnIuE7s5hvmuBrUTODNGmxeNS7a48rRoLb4MxI1fr1wZs7jlInuUrYSwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HJJShCgKsOJzm0ALd5-jlwuIeBNqXRiRLVlB6grulyA&oe=6A2D54E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yf8Wp2_McIQ7kNvwFOOdqD&_nc_oc=AdrMLJus0L8FRXXMFqHYtKiuEaKTzn35iiYsyVANqpN1-FqCdJlI3gUrwJY_Mt8ZbRQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XQLFhTpc2Nj8t-95d9aFnjH8YsUEa0sDD7HGHyeRY7A&oe=6A354784"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyl2P9Vt_XkQ7kNvwF2AAnC&_nc_oc=AdojcKxzDHRIXOKZkbwlDzPxh4JkTqB2WvXpxFeid6u5gHOgYNHG1rDwrsOwQyKPc1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jkEt6GzBYNfx9hcDFOmJM6ywt3ogvfhzVopNJRWCMOw&oe=6A356952"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtrQCcgzhtcQ7kNvwHIf1Lx&_nc_oc=AdoEq74GS0SPiH8o9YMX0NYYa1WOH4136Q6sVDBWUCb-Pz---OxumniVj5wrOcRES6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BYY5UOgLlTRrXBCl96U3tfcvySZEvo28wHyqNfbPXbA&oe=6A357622"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
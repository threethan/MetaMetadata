/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN9AI1D1_H4Q7kNvwFC2MDI&_nc_oc=AdpQU-kia8s30LlZ3mZ4_c2X0TMFKv6k5sDjD56vYISwkTedO0vJjAG87G7X6rs8qTw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dXCBbHy_Qh70tgVYklt4N6dhhwPe_TqmcnKa13hG_fg&oe=6A0C6904"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5UEXbR4yZwQ7kNvwHTcbN3&_nc_oc=Adoxpi2qKSZ-TXDoWs7Tw9-witF5sXKUXzmOIERnZAEQxLbcA9sG5oYtGFQIIxa6uTw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TGoekBRrKCbsp-DLbIcf6fYkYFU5oDVye0uTqo1Vk3Q&oe=6A0C8AD2"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEkMFGloWzwQ7kNvwERwLQ6&_nc_oc=AdrC9mCOCraQ7ftrC3f8g9Ylkh5VRHeRuI_vMBLCXF4Aamv2X2zjFfaxCOF8aCRz5Rg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af773jBfRYyIUriP8vRPLEALq-KT67CUvViz2QuDUl8G9Q&oe=6A0C5F62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8l9RTDuGpgQ7kNvwFEwB4R&_nc_oc=Ado6gg2RgatV6rwYaAF_FE8AXzII0GJm0e6Vp4hsSqCbnPdVsXT1QaRywcPaRZe6Cb4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-krZt9vC0fOaUiAetnne9S6HciVT_n8GGbOk6JuuJdwg&oe=6A2C0D04"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdCGFWt24p4Q7kNvwEDyoKz&_nc_oc=AdrlupJKNP5vVl4IXZAp_4WNU3Cax894YNDf-hYsof5H3hB6dzVnO2Kr3QYetKxg4CE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vsK-nFsLTQP-cFBUIOo6R62q2cPPSr_VPs-3pONEXRQ&oe=6A2C2ED2"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMcWqk6ZPvMQ7kNvwHGn0R8&_nc_oc=AdrSvjVpjhylO2dFUX3dIwcR8-MiLyGagQYk-R73k1cgIgfTSR0AiVV6G2p40PrHpGU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aTWdSSZ7bqkHQ-JmUKN_A3lpXNXl1jtQ_fVHRpdDBfw&oe=6A2C0362"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
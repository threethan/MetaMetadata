/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg9CV4FbNsEQ7kNvwFsrOzN&_nc_oc=Adq8L6uxfzD6WWktcmUsx1mhaxEi-oygMkCkqLRHxVaUxsk6iHam2Hrk4x8yWdvQp7k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76dyzAfkM3xxQdZKU34mMtRS5g1ZqJlvPn4bC2J5jxZA&oe=6A130084"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_whJeSa-JgkQ7kNvwFDrDJt&_nc_oc=AdrFTZVgb_7cEjLTDLyqqEvA60Bwp81dWQoymgNHv10Y-6Vqtxs-mfAq3gwosMa99fg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xuVHqd0pP5C-mPbtQwc12cGuw8OEBDvWOpLnA_6LWyA&oe=6A132252"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIYVJNqmi3gQ7kNvwE7DOvM&_nc_oc=Adq9vt_B1VLuB4fufrr4KVJvrv9eVOAB7ef2WSWeSxNjgAQWH1hqoo5tK84FjwAog6k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Anh3_GNcKml5nvyDYg_eCsCxI6BOTllR9TW4rkIIz_g&oe=6A12F6E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
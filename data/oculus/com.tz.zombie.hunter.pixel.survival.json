/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt_BioFVosUQ7kNvwGspOQy&_nc_oc=AdqsbLKDCnj714KfGYI3Ll4I7IC8zM8_D12hGqatkzNgomtKHu4oWMZeFfvqut7EB10&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cjDGbPUCCzEnVQkFDslO0ji9IOIVLE9eqpvzEy20V7A&oe=6A412504"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fPGttZa5EcQ7kNvwE5ea5o&_nc_oc=AdqotIOZnJZu8bN2OmiIaB_lIi09NjVLMO-7EDC4W6_krIm6wMyecfbrLGb4XALzDGQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zI1KvHOjO6iibJWUyaTG2wOybImnAb6IcIQONj7FPBw&oe=6A410E92"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8R9z5Z1f6EYQ7kNvwFmpCRa&_nc_oc=Adqp61wJE9C_oCgdS5cxN54OlEvdDZOtcMvLXSY-kEsQWACAM0pLj7pKZXLPVJ7GBsY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4o7AxrJ2BLCyQyGSUWGJLRAY0ZMxrjzPn8T-44h7_Ng&oe=6A411B62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
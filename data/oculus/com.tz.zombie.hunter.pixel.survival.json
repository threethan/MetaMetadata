/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGebllE2dkgQ7kNvwHn_GRS&_nc_oc=AdozU3eStaT8Bqs9PnrocjlPwZlxvpZ_wa2aVfbHQClMhcpTkoCchpE76yLyBeXCqIA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w7K7erj_p5ykxJOVEaVpqRS4EIhdUBIRodO3wCdzfxg&oe=6A218104"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7GaiYVww94Q7kNvwEVioYW&_nc_oc=Adp7oNa4qEcWs4LdnuIjn5Z9PlqPHk_25J20n2h-wJFqw9QcsjHiskerXsKlYA31ees&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ODAiFiDRq6rFas4w3q7VteHE9mqWS9IjodywnXHWjIg&oe=6A21A2D2"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHyY2-nBLIoQ7kNvwENdnre&_nc_oc=AdoNRLgaGZ5yuYbO0k4aKyZdI_8HJjRrdyz-RE2ivMZLaDP8T34s061kYzkXu2ZViKM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TqRrqLr5zc1OM_8jPj1KSCB9TWvfH4AMGDNl4uOIO4g&oe=6A217762"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
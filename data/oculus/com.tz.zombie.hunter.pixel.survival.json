/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q34dCYUQDugQ7kNvwGBR-po&_nc_oc=Ado57vesG3c_KxXQQpXOlWGNiruZ_qZWGhXzAnMSiirNzf1ymlEhrJcLfiWH7cbRcSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OjHKCkRUd3vttLkt7KwWbFlLSIGZ7EEIP_Ipsv4Jayw&oe=6A202F84"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7GaiYVww94Q7kNvwFs7iOL&_nc_oc=AdrwtQZwzo-FZhrVigmnpEwiqy8E-4jBzLtTO9QRPjCPMKz7Ms50_5AutzdAIAzDrpA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79NbUjHx214LeByNbE-6jRfPL2zUE1SshgnTPGVYJfvA&oe=6A201912"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZoJpwEBjzQQ7kNvwErZawo&_nc_oc=AdplEdvZkWUjVvIP30bscZJcu7ywnHl79i3wXmx49upjvqnPBSW_AYi0w_-6vM6TXWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ciAHTiMFI1GhvdfNKlZfxFxvK871Wjup4uajO9IDVow&oe=6A2025E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
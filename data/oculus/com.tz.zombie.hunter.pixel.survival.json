/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO4VMXJ8r-gQ7kNvwHwSFpB&_nc_oc=AdqndunpYUmhGFPMJJt4FRF_cLv9abE4X_KC3MZzmyyRyh5DSRo5Ry-XKH6U-Yb77YQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rlh37pc1KiPhDu9zYjZKQ7b6tpM37xl-kY-zAUKcOKw&oe=6A32A484"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyl2P9Vt_XkQ7kNvwEcMoQO&_nc_oc=AdqtUWvrV6bL4TNz-xdZIJfSUYr5okAn0IDkc0v5KvWCj-0xiDEXW7lYWws5sznlWhU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IiY0lzML1NTIBdhLdYqaBFrDiptagjI9yLbOwcXvUgw&oe=6A32C652"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdt8D8m1txYQ7kNvwFHtbDW&_nc_oc=Adp7OmFkImcr71-Vl58MghnqPPP6zBaDlCXeQA7lBKG9cMWHazOlWdJZ1W82A5VWA4I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6ukNT9h7hvgkmjA_yeuXF__G7I9pGdH7Ey0fpDuOjxQ&oe=6A329AE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
uscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siv7sbk6owoQ7kNvwE-a6VB&_nc_oc=Adpeag8nWPUIYR4o01gu8j1BWemwTuXwQxpvkRXAIvRd8wqs9XsD7PPCOfBuoGojJW0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP0eCWHXZS1mfohRRwFtaNn7ht0T-VoHX4aJHWBIAm1g&oe=6A8ED712"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsI1UJtUS5IQ7kNvwF83CPK&_nc_oc=AdrClzWzCmYrQaWW_EaTkhZCtZDmYNriCSXSKor_NMIopxjzd2pfdHu0aGuHT4J3WuE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXExcLM7XbdV43m5O6nOfs9xml-pYku3Y9v5vzPgD6Zw&oe=6A8EE3E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n{1771815273708088}\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n{781851854389742}\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nDive into retro-inspired pixel visuals as a true Zombie Hunter, with immersive VR shooting mechanics for nonstop action.\n{765738352719996}\n", "short_description": "Be the ultimate Zombie Hunter in VR! Survive pixel zombie waves, rack up kills, and fight for the longest survival time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vr-privacypolicy.php", "de
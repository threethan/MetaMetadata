tent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0JJfOG1z1Qw6vEfxWDMQnlqJ0draoAfPtcZd-Uh1Tyw&oe=6B085952"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AJ_lYgGpwsQ7kNvwHnWder&_nc_oc=AdpDmh77VMswrJfPCiWw4EnhDKnoPxBCwPI2b75IEhrosfhw_MyHRBHvaE2yjqxcpyU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrOzd2POm-MW3I4v15X8yMMBziCthW0OhIQqv8lHIxxg&oe=6B086622"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nDive into retro-inspired pixel visuals as a true Zombie Hunter, with immersive VR shooting mechanics for nonstop action.", "short_description": "Be the ultimate Zombie Hunter in VR! Survive pixel zombie waves, rack up kills, and fight for the longest survival time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
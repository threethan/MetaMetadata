/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxhsFfAILycQ7kNvwGy9pds&_nc_oc=AdpCs7NEATgom9YCSX6f0N1KJ29s-pvJEEkQy3HxODtcuDqANj4APxLVQQKDua0BEoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MsysqbZho-6Ys6AYudcL1zxINkBpqFbvddIb0AtiLzQ&oe=6A47BC84"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPcgB0TeaKkQ7kNvwE4yorp&_nc_oc=AdqGGC6wfiFXaPushbsyB0I7ubfJVKNzC-GPffUSxA1o8ttE_W2QekOSGQX9cAwzHzU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R_GvQ0VcdcrxgjWytc9LuZIuU1cKveEQBOgZgHL4euQ&oe=6A47DE52"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sh3ZWcu6_IQ7kNvwFOi4C9&_nc_oc=Adpg7xyBc6Pg87KhxRUZDWTsSXia2zR3TBEb_32GF0-UEIA-v_WrUgn8qFIGgE0kskk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5cJvfSPKBr2GDP4dA81yecUymMHk99BDm-npt3REU5A&oe=6A47B2E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQDpRa7_TpgQ7kNvwGfpEHj&_nc_oc=AdrNSOdWEciyOeDBw6DaJa6XkPfOnblmAtEpXbzau893syOEdbssf5eUd2tWRkmIb3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q7WF7pf2V_47Gyz7vkXnVjhm55MbL2iRx1rkmY-_Qog&oe=6A3A8D84"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMlnWsJKzQgQ7kNvwG4qBW0&_nc_oc=AdoJGTFK4m5-eyDNdSncE63lO841ZpsmFX5aa8eoJxJBOBsoAgUoh7HQnUlqzhxk93U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84AQBHRRiRHEvh1xef0YZ7NYhYM5oqjVCkBRfZLqXubw&oe=6A3AAF52"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IH1tguo1Z28Q7kNvwGLtVln&_nc_oc=AdobrLFtde3gucbUdFP8i83oKvWB4hXUWOqgCu9ehaJV9NGTQzRVn4Glqr0eYBKQR38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tVGg61c_WyVe0hc1HpfWsEtkLRLu3hqK5wYvXV1_MAQ&oe=6A3ABC22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
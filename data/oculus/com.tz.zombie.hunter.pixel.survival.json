27703_24541742265438073_1901620125045198282_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNB43aVR3-4Q7kNvwFLHXlr&_nc_oc=AdozbZW6xPMfBsNmbyoyJZ_LTuz9CjRVtkhArnjRDS3K76xdw0xUDLmU0UEPe5hGTbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24zF05UABzH-akmCKwiryESmnVC4vFHbNeI725ZA58-g&oe=69E4E90D"}, {"file_name": "vlcsnap-2025-08-28-16h48m55s014.png", "id": "1287647082766116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831382_1287647086099449_8177043000463979908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvv4SVLwrXAQ7kNvwErgXYf&_nc_oc=AdrayrGeQDYnLHXTYshMxci6eIUYNdwTr2s1bsLvRw2P76Lu1quh9471Qg1HTtZu5Ag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JeCiSrEpB8flOF6kDF_QjDJjl7X-xS10nJz9nsZcDeA&oe=69E4CFE4"}, {"file_name": "vlcsnap-2025-08-28-16h50m39s799.png", "id": "24191698033792170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beWsgYKpNZ8Q7kNvwFLNIVT&_nc_oc=Adq4DkF0WWvgYUwj_ITAy2i8mGG-QJ97mESUWMrw5s2qpSSxfE5qfk-L494aLZg080w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K50oCeTSgKFykjDw3YMEMUz8v54JuKeYlZO9BXlK_2A&oe=69E4DC04"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN-QZT_izdIQ7kNvwH0D0kG&_nc_oc=AdrLvXz2r2achEbxQ2qr9XFuN79jymqohq0gKdOG7W1tWM4sYW16qwQA9-6nWstGnTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DnWrv6sFAAicc2b0eiLhhSGRnEDTVXL_yW00UG0BaBA&oe=69E4C592"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kappTDwvz6UQ7kNvwHvBn0A&_nc_oc=AdqRNQ9DC55krEG7ERcn9FecbEeLo-eS19ciYAwwYaOm01J24kU1LhjO-GEEb13TYIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3be5nTwSLcMYMyp43yaIB21tFVv7vandDWPVSk0OGZtQ&oe=69E4D262"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n{1771815273708088}\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n{781851854389742}\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nDive into retro-inspired pixel visuals as a true Zombie Hunter, with immersive VR shooting mechanics for nonstop action.\n{765738352719996}\n", "short_description": "Be the ultimate Zombie Hunter in VR! Survive pixel zombie waves, rack up kills, and fight for the longest survival time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vr-privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
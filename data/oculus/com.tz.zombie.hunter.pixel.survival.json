/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP6gPaHVCIsQ7kNvwF9rAPC&_nc_oc=AdqzxoavTKuHpJIubuh5rlBWLAJjuN-S7iKwLBrOfQAZVayaFt1Xo-BzTOfDz8rdVEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EIgcFE-qwTvDjeF4o0NA3Qm2X5KFckYzx_cyEgrPJNA&oe=6A184684"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5opCyOH5naUQ7kNvwHT7NH-&_nc_oc=Adpp99FzBU_-4pH7j8yFi4232owhHETaIerXackXZaKUM6jhCoHq021U1zecT9Op-qU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56Gr3C__llb5AONT8MhYuSgjq37ed7kEgZefgF0t1xyw&oe=6A186852"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4PmgbGTGUIQ7kNvwE7Xab2&_nc_oc=Adr4fAr6wg9exzn8cXigG4rxn_pVz8MME3kTo0waXVfWIjoCQOh3O_7-AUPHJB92QR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7giQuxILGFojkL2uNneg5u0qN-gw0FjfLsC3BHufqCRQ&oe=6A183CE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nD
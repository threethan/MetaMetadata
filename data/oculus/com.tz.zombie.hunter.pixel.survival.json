e": "vlcsnap-2025-08-28-16h50m39s799.png", "id": "24191698033792170", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821955_24191698063792167_5483341582359519705_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8UJu3XFbRgQ7kNvwF0I7jw&_nc_oc=Adpee1QpjGmWDvXVPcsMQh6Ye0OhNhWiiVS7N55ePSKr-DJC3okIKCtYiqWfPkx5q9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXk_yfhBvd9GDj5zIrjIKxYf45wdWG0fK-BCvzEFckowQ&oe=6B1058C4"}, {"file_name": "vlcsnap-2025-08-28-16h51m46s655.png", "id": "2238013483316119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307602_2238013486649452_1705657585715078351_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL9uwIPYzVEQ7kNvwHFFh9q&_nc_oc=Adrl36qWTiQLXX4AWq_0Ifs6pTKD1NDAAHYE8M4bsdXQFC1V1dhTz1i10yegI7dwzCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdBv2jTcpSCYaP5cACbBlcyLg4aXZF2iYFpNpRar1tbA&oe=6B104252"}, {"file_name": "vlcsnap-2025-08-28-16h54m10s543.png", "id": "787783233690659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828806_787783237023992_610498081522419934_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daupoaa12_YQ7kNvwEgb7h8&_nc_oc=AdrE7Q4j45zctvBA2eEolI4EZGDRFXqARX9x8yaeYgyBuVOe7C2xuePvFuU-9hO0Pjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWv_hx5Me8a8oUZKRdQLJGvmj5_EYAUIK1_GNhAo0azlw&oe=6B104F22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Hunter VR - Pixel Survival", "keywords": [], "long_description": "Step into the danger zone as a commando and become the ultimate Zombie Hunter. Survive endless waves, achieve the highest kill count, and prove your survival time on the leaderboard.\n\n\ud83c\udfa5 Gameplay Video 1 \u2013 Zombie Hunter Waves\nAs a fearless Zombie Hunter, face relentless pixel zombies charging from all directions. Aim sharp, shoot fast, and survive.\n{1771815273708088}\n\n\ud83c\udfa5 Gameplay Video 2 \u2013 Survival Hunter Mode\nEndure the chaos and show your Zombie Hunter skills. The longer you last, the higher your score climbs on the board.\n{781851854389742}\n\n\ud83c\udfa5 Gameplay Video 3 \u2013 Pixel Hunter Action\nDive into retro-inspired pixel visuals as a true Zombie Hunter, with immersive VR shooting mechanics for nonstop action.\n{765738352719996}\n", "short_description": "Be the ultimate Zombie Hunter in VR! Survive pixel zombie waves, rack up kills, and fight for the longest survival time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vr-privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25809451968694378"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304131_1439875863931492_4454229453235326860_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvxqGKQpn3AQ7kNvwET4GEY&_nc_oc=AdoA2BL9MeXzkdp5miTbEwi6qrLuxGQfPjQ8Q033UrAF8D8fOonvIeXaXCMiRDfM2Ow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdHxFQdU2EpwGtsmfgxIgL8jbn
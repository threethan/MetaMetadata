450133867_4145391056965252873_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P1IyKLCfNwQ7kNvwFbANd6&_nc_oc=Adq5dl4wIVQ6tP7s8AKfbdY85_W8ogoj6bZN0mJl8cAy_5l3g3p4JSeKR-ol0dt3QYA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3yfaFAvX6IVFEdxuLHzx8ckXf7bxoMkwMEW5IhuSLq3w&oe=69F1FEB8"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maGnFDQp-ywQ7kNvwGv1QED&_nc_oc=AdqpnGeMpSVGZhR6BbD7ibM5ezp0AI296U9rcLZGIplo-TSEC47Y4ETTUR8G-ZFnZjM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0dnP3-bwj2JagswYGD-d9riV_FSC6q9S-ISkMacKxI3g&oe=69F215D0"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khh2MeW1jx4Q7kNvwEmFTns&_nc_oc=AdqvKvYWwN25bK1-h1uarDHbp2V_rjcnkzzbMhrmKy__jVtFhONYT8P0lj4V57V_6OY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rVOZh_lv0gyzxJEriKZrZmwZ80-4DmTsiYCu3592J7Q&oe=69F1FEF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEMz-zeRHnkQ7kNvwEo_2dW&_nc_oc=AdqXsWqOnZRo3Cng9Q21-zug-Ufeg4Rg1Brs6yWrZwRUbYKVc5klXvXL30FVFWxE0gk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KMJPlMKrIdmQs346vaK-tiGcQDmADjH9IceSDokY4Dw&oe=69F1F8FC"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes"
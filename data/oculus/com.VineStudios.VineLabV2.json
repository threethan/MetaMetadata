&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5PVI2r2SDQQ7kNvwFx2JOU&_nc_oc=Adq73aX70MDvzcPc7bEkJ2eyespzmh5NsyCxK0a7YAPf5DJTKvXokSkTsZ03q45LSYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC_A7DQOXPgfmS7vMQUEiwZiFCUFjqlxGEwyifMJRxng&oe=6AFC8851"}, {"file_name": "Main_Custom..._16.12.2025_14-05-15.png", "id": "1142331657982278", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819356_1142331661315611_2086116991573940662_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHnzUEhp9B4Q7kNvwGHsHeK&_nc_oc=AdoOyghpfLbMmKHQS4wXcYU_sdIRJ94PHTeXSKPsTkSCHnoPMefJAq2WybQpBe4_6z4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-es0ZvbWymNCStR7ZF1HwAKkpNt_diKVgaN_ACbl0wQ&oe=6AFC8026"}, {"file_name": "Main_Custom..._16.12.2025_14-05-24.png", "id": "795981446800534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618221_795981450133867_4145391056965252873_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA122SnwM0sQ7kNvwHrRc-r&_nc_oc=AdrXwSmNUolfdIhugdRlnT3BRbh88maSqVj8-6TGoWEukcVvlSzt-ihWGsjocoos--s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7yO_0v7wVFB-H7Zo6Qf0Jb60Ko3_IunupZOpAZ9gO-Q&oe=6AFC85F8"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSxnW_hgTP8Q7kNvwFxbMqo&_nc_oc=AdpOvJ9jZE8gqTCf8AxENtWVtA97sw78SZZAWGF_sJ1hhNWbNRUypxaS-otXu5yZuKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjLwD-cULjBqbB3_4CIaYEkqvGZndCrkOEuYInXgaLTw&oe=6AFC64D0"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdtOK6PMk-YQ7kNvwEJM0Aa&_nc_oc=Adq0nf9m-EJrFHevn7Wk4coYXYjvSIKdAPsvCT5FTQyB_-dqMPNLgOV_pU48DY3rkts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz7egmfCT9B_VFQ9c_GuNgtHlWvZPMAp40z5BRtm9vZw&oe=6AFC8636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0dgx6F50gAQ7kNvwFhSK7S&_nc_oc=AdryhHVif1p791Ow2MHdjzmRwRZ-zL4VwfA_Ickeed2RlaYkJdVlbsXcT9VECEgG5GU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxxQYxlHBSEegW5HV4c62CgpIsFy_uhIHDlL6AzW4FLg&oe=6AFC803C"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25290385173951870"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499617680_2249316225479610_1589134271485091043_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2IyFXBwE7sQ7kNvwHUXd1X&_nc_oc=Adpb_VqKoSMqZhn0--aNN3ggD1bBPNQsUsa4FSOoIazjmt6s3vdLwOxshVo3-2NSOqA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVzZxviHnCgcxrYisticiPMlHoLxIeqOxW9t222CBJJQ&oe=6AFC73B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VineLab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "re
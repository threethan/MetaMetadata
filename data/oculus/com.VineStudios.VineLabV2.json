scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AMuyOEeNIXTyoSTK3WW6hYduM0GDxmQrBgj_N6PdENg&oe=6A3AB3A6"}, {"file_name": "Main_Custom..._16.12.2025_14-05-24.png", "id": "795981446800534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618221_795981450133867_4145391056965252873_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8nya1TSPskQ7kNvwEKJXxd&_nc_oc=AdrjskGowpFcHtg2gxPuRKYELE2q5OjWQDt_iGEk8Z7zhwi8-KKVfFg55uNfQgDCJ2k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qjY94itMDUvYiTRkKJwS_Xt3hgLDjoS0WLMBfXoz0og&oe=6A3AB978"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3LN_MZc7rQQ7kNvwGBS1sY&_nc_oc=AdrjBQpV8kRJPU2UudE0WqUbvkK9Y2lqKzDGarFLrSvy6_koSa8VHT9d8nJghLryENc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91VdXZal-9XSsPan2S9BwGuBV9BAUEqYCPR9pqd3IVNw&oe=6A3A9850"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY2rA1UQwSQQ7kNvwHDccpw&_nc_oc=AdpzDzHscLikBDFrQsw7PpFnfIQ81tMkA_0tqwCpWZZgEEI0j4zt2BqKmOOzJKb0Q0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ioai2D9aCcHbEykLXSbvmWxwC_B2EhQ7Ox6ZMpIeQ0Q&oe=6A3AB9B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXopz2Dv9Y8Q7kNvwGbNk-1&_nc_oc=AdqcxmPzxLqsgQ1lxR9_BNohH4KJ5eFnn1Bxk2q3S-c0Bsc21p18DrH0HFZwhmeccUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bcBL638Qm1MuSLXSim0eEQt9yeweAMZ28vDp-1BNzfQ&oe=6A3AB3BC"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
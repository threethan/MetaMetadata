scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc_2JZ80OjBVpI22DketysCfZxErlFsFuXUOE_0PEQyA&oe=6A5387E6"}, {"file_name": "Main_Custom..._16.12.2025_14-05-24.png", "id": "795981446800534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618221_795981450133867_4145391056965252873_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcIgHMIiposQ7kNvwHF2kVp&_nc_oc=AdqBPjpC6NMl5taPnTe0nnw7wKyTX2v54pGHau1SHLJa3bkkHyJZFTpjsChYpCCOasU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl-mpvJ2k0odAWgRKgWq8xPa2ZDwf-hlGNA6wsS95ZWQ&oe=6A538DB8"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIK4jmDH6OMQ7kNvwHmETJW&_nc_oc=AdqhsL13iFxEUZECSC1Rm94jSqdW7L8dK3LtbIv_UBxQw8QtDydetwUiSmG-ypxL_O0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwQsHSh3Wc3c6qWTzx00Dl_yP8kn-SLt9gAPdDSd_dMw&oe=6A53A4D0"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCKmQA1i-QYQ7kNvwFkbzms&_nc_oc=Adr_1lNHKOBK2v1eNJL7s3YP2pbXmZfHelSQIFBGyEihJZfN2bHbgj2aA9bwArTAOyk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiSw2D7L0I7_HqrrOVAKqVsXsTxPN8cer2vJpK-KAkbA&oe=6A538DF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoTvSGmJVCMQ7kNvwHMmomH&_nc_oc=AdpFGwmAZt62y7aPIIow5IHbD911mIc8LSXfJ70teRsxUYmDtBFpxgOtpS3-zbY126E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2trgSKCvjkqD-bf_XNb-xxrugmVh8hQYU2MX7_xZ4Bw&oe=6A5387FC"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
t-iad6-1.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0RVyBBmVTAQ7kNvwHBlMdc&_nc_oc=AdpAJvN8kZJ1u7usVbWW0gJKPCc7d1sUVHuCzrC-HALcRzAd9ddC2pygmFr2z0dnb1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_33H5mTYCI50AaXkKX16bEpUB62UfpWyYEJdE70vGqA&oe=69EE047C"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25290385173951870"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617680_2249316225479610_1589134271485091043_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Noe1cdqwTJgQ7kNvwGC3_ii&_nc_oc=AdqD-GO2FWRTYPWVc3kGKppV93GJE_BSx60YQZ2gEMzJjVkKGGg--coPcGB2Xqc8t70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QnTXUV-MnjRRCGddS1t7DBBJb_pdtwEQZYBKIy8oYYw&oe=69EDF7F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VineLab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1768335900, "lastRevision": {"nodes": [{"id": "25223930883930633", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25223930837263971", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1564022371462399"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"
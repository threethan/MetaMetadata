scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VrWNFVFJ5vEZphLUPy63jq_VN6DklbV6pK8tklnjSvg&oe=6A2411E6"}, {"file_name": "Main_Custom..._16.12.2025_14-05-24.png", "id": "795981446800534", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618221_795981450133867_4145391056965252873_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=242SRRwtXWQQ7kNvwFTRWp_&_nc_oc=AdqMuL-rAEGuOoOk-AXiBSFWqNXClAcA-a-Vdhyh-7GTgwy9gbc-EOXstvWLOB1O-AU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LAoDyJ3lLji6vVakBqCd9xW07GBwZzsas-BO7aRuAKQ&oe=6A2417B8"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiLjSnEX6mYQ7kNvwGuOmJL&_nc_oc=AdqPWKfonYHea0wjqxR-y7KAumMr7QMmK8oUELsRDrNSpfFLs2w2aL4Mse0_5p-z1ow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_upIcJx5bbpvIQf_I6Q9_KGQZl87sibk1oEcUs7Tl_Lg&oe=6A242ED0"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXddB5C0cPwQ7kNvwFB9jG4&_nc_oc=AdoovYGwMsKfFcfDdRtYlSR8-PrGYL7b94AH6BYiS922gKC8C5iJHpwziH36Tg3nQqY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_deKyUMac2Nah5nvh-mOFavOjy4WTuuZjxhw_kbHA6QA&oe=6A2417F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbwIn9WXyiUQ7kNvwENskzG&_nc_oc=Ado1Lx0v_nkQcY2YRDdPhbV1K6IYjWK7qrM-u7ugPCy88YsBjNlnsCLKMogx6ywmULI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bkLKX-htJu8Q_16_ErjDTn-6ciQPiuIPjD2jHUk_OTw&oe=6A2411FC"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
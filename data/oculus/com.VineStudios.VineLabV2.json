scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VYsAoxYN-WepaH06mhLovayKz5maa5UUH5Tr5r5msYg&oe=6A3027A6"}, {"file_name": "Main_Custom..._16.12.2025_14-05-24.png", "id": "795981446800534", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618221_795981450133867_4145391056965252873_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryjvzPw1pIIQ7kNvwGOAwwS&_nc_oc=AdqC4bxwn40t0FqdCrBnAeBkcp2YPDbTNpwdZWjm5hp9wEEWR0QZ4svZ_lE5Jddwf9c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lGLpq7c9rGWB2fgk3cU1ogzHe0ehVa6vtyQtPh-nYBQ&oe=6A2FF538"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imvm8NVtSm8Q7kNvwEpLPMQ&_nc_oc=AdokPiJwma7bVKFEctGySrgFi2dP060Est9ZktOMM8tNo4EHRqIm3M45s9O0v2X1Gx4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o9QCOl0tflgcU-I7lUm9bmWTK_Y1mB3e7Y_kz3UULOw&oe=6A300C50"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCj1-JJf3woQ7kNvwGXrR4Q&_nc_oc=Adrt7D24VHhoxlFv20fNZgrIZph7Zaw6Rs4ufdOD8yP7COzkDX1-64y9_R0YGQ-dC1s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Avi6kSLuYpuopw0Qook7jd4z4jeFLfwnuMbims95QUA&oe=6A2FF576"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2dMdW-peG8Q7kNvwGQGL8l&_nc_oc=AdpXZ4nNiNqdMaoGg34kzdHtzz0lRDh6UGmUkhkz8X9YLNXX8Osv0v31Vnzfva_0mQg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k1QRWr1CeBQTFiWYZWhidEQozQWn16eFg1k7fC6Yeng&oe=6A3027BC"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jX8UOAQTMOwEsPNzWTtNxe_HSnMIgYUgrAg3-mxb0Ng&oe=6A3EA826"}, {"file_name": "Main_Custom..._16.12.2025_14-05-24.png", "id": "795981446800534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618221_795981450133867_4145391056965252873_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pdnqGbISLoQ7kNvwFsvZRf&_nc_oc=AdodjwRRBTI__EN45_kugmW_M_Hy1uIi0FFvKweRmG3m0o19dDUWGQiQ8kfmd7dhzIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BwMprGJvo0XIjbIL4L6rEanTY6aQjkM_RznTOKi_pTg&oe=6A3EADF8"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Znjw_LcQYtcQ7kNvwFcUFVU&_nc_oc=AdoXxAz7NV5dmg2k0V59OzaZMuY4JImoCaRdGxAiaI4Cg4hSMp-wsyUOaJtP6UNxxGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zv612j0yiCa648J_h35Ym6fVD9Hb0H0xNx41B4BSryg&oe=6A3E8CD0"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTULYJxtnN0Q7kNvwHU84JK&_nc_oc=AdpO15kS2JeDOMmpJ4UlUssJagZbu5e8NYPOQcDnMUNsO2vSLiDtxJ2ptfTTLV7k5jY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zd6q3tFcmOjhddXrpcrZrVKe9g7fqLZZ9RDg-RSo2SA&oe=6A3EAE36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT8yqqmx-RIQ7kNvwHMwKCG&_nc_oc=AdoAtSw4X17_yw22KTSnC4VE5wEC4dlkqlLemJA1iL3o4bvp37qjSpVtTnetXvdYKz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qhYWjh0erD8rYXiRmKln9G0GkBNiRwLDW-KcMGQbPEQ&oe=6A3EA83C"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
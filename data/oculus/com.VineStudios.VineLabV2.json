scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aj3KZ8NDvgBLEuZ2EX2CWmspkPhcB1PiUWYwOWFmGeQ&oe=6A26ED26"}, {"file_name": "Main_Custom..._16.12.2025_14-05-24.png", "id": "795981446800534", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618221_795981450133867_4145391056965252873_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB8fsVVUN5IQ7kNvwGoFfk6&_nc_oc=Adr-Kzna-Sxpr4n-vV1DGa3KVTTO6K-f-uSFRTCnHKGooS5hyxKCnhs_3W-elqSDAZg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__BlLweeIZmiyN0_XAU4gX--U0OmdVghnsHyRf6C-4Rg&oe=6A26BAB8"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiLjSnEX6mYQ7kNvwGqR4x3&_nc_oc=Adp6C_MsxSLF_pnUqskTEqDwNX9YqLG03q55_wmhsENinGoxi1b_5JlZNrPMbRl8fGc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KiQjuyfTSDSWBt1ljxmLiFOaQsxbNgT9H1kBxdUm5xQ&oe=6A26D1D0"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3ofZ9LIZ5EQ7kNvwH3bTdS&_nc_oc=AdqGyynibHXYSBiQHw7YePqQyE-8F7n8PpD8C--FvhLow5WRcxKKX8T-j5CYttLFvnY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D7pkCJO9x5exAbGoVeekjctzHRv0N0pm10rYs1-bX1A&oe=6A26BAF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbwIn9WXyiUQ7kNvwF1O1HP&_nc_oc=AdqOqZcq7Zpka3-SQCxT4rrdTlnbV-kzyJNdqEk-8Ys3YwW57zMmxed3Fl_ctkjpUz8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OiO4xHMFQYBcuh2Qc1VqdXQbPsRXWvTAXNojNfr8qpw&oe=6A26ED3C"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkXTifVIhUMSGRNTjiwzZ-OK5my8_Hxun-fLDoLV0J9Q&oe=6AD25026"}, {"file_name": "Main_Custom..._16.12.2025_14-05-24.png", "id": "795981446800534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618221_795981450133867_4145391056965252873_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq2aCVEKuPkQ7kNvwHHW7_K&_nc_oc=AdoAZa4b8T0tLwesOvBcAwuqEObVtqxmLeHLZvkIHeJxMxZFVxHlAv7cYXAwyt9m2Ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7VUOv6FMlAi20u_snzy_Nz10Kd-qf6HUX6EfbSVZl-A&oe=6AD255F8"}, {"file_name": "Main_Custom..._16.12.2025_14-05-20.png", "id": "1568377221030561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_1568377227697227_943900691160173038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0D0FO0De4gAQ7kNvwExwDZ0&_nc_oc=AdqaGroyXMGATl0H_CR2CdploJBLAeYlMm1Xxdt7L8FMqICJfrOLLjjwBTUDnTt8DuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm0FnyBhi0eh0xEU50UVYxau4-w_tYo258-ACl89ClQQ&oe=6AD234D0"}, {"file_name": "Main_Custom..._16.12.2025_14-05-08.png", "id": "1337148394828829", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819323_1337148401495495_6708094042312522348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN8dGmMUYEgQ7kNvwHfwMzW&_nc_oc=AdrSP-28x0GfTF0EUO-YyqW9gKuY1mtMlvBjT5jFpt4Bse1TruNYp-CFR4d3K5SfKwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGMeheSSP-FAIblbar5m2A7p6Au5ruD7wzj3DuKpxv4w&oe=6AD25636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_2411968639200643_4272182678020372351_n.png", "id": "1662507041140344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821719_1662507047807010_2487855262715308229_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ebo7tJ7gRkQ7kNvwHzK7GI&_nc_oc=AdryQPNU4xWcdiyX4ARSXdhdOvEIFZUJhfv_2tua7DO4z_6ALWvkqRh3uTFh7g6bOcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuIqQdd9O2eOeKQrYC8Yqv69_nQnzLQpwwYebEvZbrvg&oe=6AD2503C"}, "display_name": "VineLab", "keywords": [], "long_description": "VineLab \u2013 Multiplayer Horror with Full-Body Movement\nWelcome to VineLab, a terrifying multiplayer horror experience where survival depends not just on your instincts\u2014but on your ability to move.\n\nBlending the tense, cooperative gameplay of Lethal Company with the immersive locomotion of Gorilla Tag, VineLab drops players into a series of abandoned research facilities crawling with unspeakable horrors. These forgotten labs weren\u2019t just shut down\u2014they were sealed for a reason.\n\nYou and your crew are scavengers, sent in to recover valuable tech. But each trip into the lab is a gamble. Strange noises echo through the halls. Power flickers. Something is watching. And once the hunt begins, your only hope is to move \u2014 climb vents, leap between ledges, sprint down dark hallways \u2014 with no joysticks, no buttons. Just your arms, your body, and your panic.", "short_description": "VineLab is a fast-paced multiplayer horror game that blends the chaotic teamwork of Lethal Company with the full-body movement of Gorilla Tag. Navigate abandoned research labs, climb and sprint through dark corridors, and outmaneuver terrifying creatures using only your reflexes and physical skill. No buttons \u2014 just fear and motion.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vinelabsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WTXGigo", "support_website_url": null, "website_url": "https://sites.google.com/view/vinelabsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
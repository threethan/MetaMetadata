-iad3-1.oculuscdn.com&oh=00_Aft2wkgfRpTlMrHPg80lFKKFWTLFp8Jx7wkIDCmKX4pP8Q&oe=69A6C1BF"}, "display_name": "Runmaka Cricket", "keywords": ["Cricket", "Simulation", "Immersive", "Training", "Batting"], "long_description": "Runmaka provides a unique immersive training facility for cricket batters. As cricket coaches, we believe batters need to hit a lot of balls! With Runmaka, the opportunity to enjoy hitting more balls has never been greater.... \n\nOur aim is to provide a readily available training environment accessible whenever the batter chooses to train. In the app you will receive a delivery every 5 seconds, 180 deliveries every 15 minutes, giving you the maximum opportunity for training.", "short_description": "Runmaka Cricket Batter Training Simulator provides a unique immersive training facility for cricketers"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irp.cdn-website.com/23528e00/files/uploaded/Runmaka_VR_Privacy_Policy_AUG24.pdf", "developer_terms_of_service_url": null, "publisher_name": "Runmaka VR Limited", "support_website_url": null, "website_url": "https://www.runmakavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8568989799866502"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363518_1991751727964186_23165741
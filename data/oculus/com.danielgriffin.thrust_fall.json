38331", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618284_1733914357771664_8168130711066677204_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C26W5ZPxsVoQ7kNvwHHytVA&_nc_oc=AdqAhd2J68zTYLsk2nmkyutDQeLL9QcS7xVhF4HBo2VOLCL5VaxQliYTMwURcLmfA0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdl6OTEG9UJRk6C11eFQCotJEPP7fCkwsxkVQaMIYHtQ&oe=6A5CB5CD"}, {"file_name": "com.danielgriffin.thrustfall-20260411-150225.png", "id": "1666039871084399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830815_1666039874417732_7640769749634163466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5EOVfWW5c0Q7kNvwGe4J08&_nc_oc=AdqL2fozEb3_td2rnGI2wzDHrfQ01GXUhEjEd_k-C1dEspV2VqJE_TxmNzKjpzVKApU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-KRnzPpCPP80U6Ef_5bCuU1n_ANehwDLQ4Q7UHS2xwA&oe=6A5CE305"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2kProcessed.png", "id": "2912787519062248", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_2912787522395581_3408424204446317595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx1-wEh1l9UQ7kNvwE61JzT&_nc_oc=AdqEaQf3ugEmBY7qK9ZUlXoqCwQCsJG6QUINPa8rDNxuQihUadgU2BhJNz0yI8sg0rM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8_Up1y8Te6ceIR3LCCo3XBDj2tephXnTQ0drssb49fQ&oe=6A5CAE37"}, "display_name": "Thrust Fall", "keywords": [], "long_description": "# Whether you like chasing podium times on the leaderboards or floating peacefully between the stars, Thrust Fall meets you where you are.  \n\nYour VR controllers become your thrusters. Push through razor-thin gaps at breakneck speed, then slow down and let the silence of space wash over you. Both are the game. Both feel incredible.\n{4454015504874296}\n30 handcrafted levels take you from asteroid fields to canyon runs, speedways, ancient colonies and the infinite, weightless void. Each one hides a secret collectable waiting to be found.\n- Realistic physics with momentum, drift and  gravity\n- Thrust in any direction at any time\n- Feather the throttle for pinpoint control, or ignite the boost\n- Manage your fuel consumption and grab Fuel cans to refill\n- Time-trial goals with rank progression (1 point for finishing, 2 more for beating the target times)\n\nFind the collectable hidden in each level!\n\nAnd remember, float leisurely through space at your own pace. Being alone in the  void can be surprisingly cosy :)\n\n", "short_description": " Chase the fastest times at impossible speeds \u2014 or drift weightless through the quiet of space. Thrust Fall puts you inside 30 handcrafted levels where your VR controllers become real thrusters. Carve through asteroid fields, race neon speedways, explore abandoned colonies. Go as fast as you dare\u2026 or as slow as you like. How fast can you go?"}]}, "developer_name": "Daniel Paul Griffin", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/f8c532e2-5548-4f33-95c4-09c33d5003bb", "developer_terms_of_service_url": null, "publisher_name": "Daniel Paul Griffin", "support_website_url": null, "website_url": "https://danielpaulgriffin.github.io/thrustfall/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27871919789075236"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.co
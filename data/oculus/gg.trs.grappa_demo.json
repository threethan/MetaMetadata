, "id": "659792291455726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974452_420624008684758_5196437084109275136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfgC84woxLUQ7kNvwHo1EbA&_nc_oc=AdqOCzBtPSmIBRFFQJTfASTs1csscJhbUkKWekwJ_XAsnwfYSHRBrrQ8cVCNJXKoCOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3TXm9pG4BAaT4Pwf2vql1rH5q4dQUoMuY_gJbRie2RiA&oe=69F0AF88"}, {"file_name": "migrated_image.png", "id": "681752365970308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_368454127327197_863113659981758464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUcyzjx1DZ8Q7kNvwHQeECX&_nc_oc=Adov7Y3AE44yi4AIgaiC7LX-bts5PNMj1GJXR8P3cApHG8gyTT6guEiddImjaSYBeY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1rM7wfoZcfDgoe74H5pZ9JR3b6MZev7mAt5wCQw61-mA&oe=69F0B96C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ObvH6a", "id": "376168566306791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001727_376168569640124_8465287721877766144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI0g8oStzKwQ7kNvwFtDocw&_nc_oc=AdqejBjYMYgQteHs4OmElNyhfmW6agL4Y_jAsyD9qAMfXoFefVAjJIo8xGprWZNMqb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2eBF8mYKuwa7uuzBTuvDhCCFFkDCBiAL1r6JI0GTUzzg&oe=69F09B9F"}, "display_name": "Journey of the Gods - Demo", "keywords": [], "long_description": "The chaos moon is coming, threatening the peaceful inhabitants of the land. It\u2019s up to you to unlock the power of the gods in your battle against the encroaching darkness. Become the hero in this legendary VR quest against the forces of evil.\n\nBefore completing this epic journey you will:\n- Explore a wide and wondrous new world.\n- Engage in ranged and melee combat with the sinister celestial servants of the chaos moon.\n- Solve the mysteries of the ancients and gain the mystical power of the gods!\n\nWe are proud to support Cross-Buy - buy the game once and play it on Quest or Rift/Rift S!", "short_descripti
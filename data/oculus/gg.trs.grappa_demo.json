, "id": "659792291455726", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_420624008684758_5196437084109275136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZcTnQ345_IQ7kNvwH4UcuW&_nc_oc=AdlnvPRkMQEpgTxbnAO5_8H-2GA1JYuhbCz6IXR4976CQGSTy9vGhDbg08c4FtSCSiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBxiyu-23BrTZcNkaLTEg0CJa6CPmRhra9q3zXaQFGZw&oe=69A04408"}, {"file_name": "migrated_image.png", "id": "681752365970308", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_368454127327197_863113659981758464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53UoCkH4tzsQ7kNvwG2yzXx&_nc_oc=Adn5zN08h9l2vBrieC_VwmiQY2MZvuHl4-jggOzN4NHrPAvy84UN6WaVs971bLOW6N4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3iePWKM6S3Ip0x2qpva7Z0qshKaN-jAq9KQeMA21YKA&oe=69A04DEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ObvH6a", "id": "376168566306791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001727_376168569640124_8465287721877766144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvV5PEiGNTwQ7kNvwGaJPrh&_nc_oc=AdlAqBSEzTIld4IS9FWHbHyfiMF-NYvsG8mx1pGQYtfFf4F9teU5yoz9WnWxy9TBZ74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCkDiqwBhgahNg2JTgoXg3zniywjMPOxaSO5bGp79VSQ&oe=69A0301F"}, "display_name": "Journey of the Gods - Demo", "keywords": [], "long_description": "The chaos moon is coming, threatening the peaceful inhabitants of the land. It\u2019s up to you to unlock the power of the gods in your battle against the encroaching darkness. Become the hero in this legendary VR quest against the forces of evil.\n\nBefore completing this epic journey you will:\n- Explore a wide and wondrous new world.\n- Engage in ranged and melee combat with the sinister celestial servants of the chaos moon.\n- Solve the mysteries of the ancients and gain the mystical power of the gods!\n\nWe are proud to support Cross-Buy - buy the game once and play it on Quest or Rift/Rift S!", "short_descripti
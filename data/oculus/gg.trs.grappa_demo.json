 you will:\n- Explore a wide and wondrous new world.\n- Engage in ranged and melee combat with the sinister celestial servants of the chaos moon.\n- Solve the mysteries of the ancients and gain the mystical power of the gods!\n\nWe are proud to support Cross-Buy - buy the game once and play it on Quest or Rift/Rift S!", "short_description": "Fight as human and god alike in an epic quest to rid the land of evil moonbeasts and stop the impending apocalypse. As you journey through a primordial landscape, gaining allies and unlocking ancient powers, the black moon draws ever closer."}]}, "developer_name": "Turtle Rock Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "https://www.turtlerockstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "265859945669128"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "143052543280497"}]}, "baseline_offer": {"id": "143052543280497"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1557766800, "status": "PUBLISHED", "id": "143052543280497"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_r
 many cosmetics that you can pick and choose to style your Monke! We also have epic items like ModMenus, SizeChanger, and Soundboard (Requires purchase)! If this game seems like something you would wanna play, go ahead an download on the Meta Quest Store!", "short_description": "Welcome to Monke Tag! This game uses the Gorilla Locomotion System. There are fun modes like Horror, Laser Tag, and Tag!!!"}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/MLSGIT/refs/heads/main/Monke%20Tag%20Privacy%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monketag", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26441934068754165"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035344_1956832518100406_1382433572107163388_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8IStr988V0Q7kNvwFHr8TW&_nc_oc=AdqR55PIJhqeDMqVQErvkv_zUekM5C_cCFA-eEG6w45Hlh2o1dSYZ96bNkX9QMh10vo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mE-UDCyn6ea7Ir3LM8tve9qnqm-nTCZkr_oGjwbTNQQ&oe=6A11A87D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monke Tag", "platform": "ANDROID_6DOF", "context_catego
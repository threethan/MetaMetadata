lYNlcHvfhriNeSgI3bfqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1hlvD83ucszKJQSK83r8zXl2XXZps1mzSZfFg02zI1A&oe=6AC130ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-scaled-down-BG-move-cleaner.png", "id": "1387874676313489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1387874679646822_7321874149456102296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCJBuRYBV_wQ7kNvwE0-77e&_nc_oc=Adrzq6tjBgQV2tI8urxqhyWgTqAFNH8LKOBNk6WKguQue1-xJdGvUEwr0_5i1Fh0HOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBUqPZvxMBiTu-zgaOEev9cp4lMblPUhXhfoKQl3fEPA&oe=6AC12F42"}, "display_name": "PullFit", "keywords": [], "long_description": "# PullFit\n**Resistance bands required**\n\nPullFit is a mixed reality fitness app built specifically for resistance bands, using hand tracking so your hands stay free to train.\n\nBuild strength with structured workouts, fitness tests and progressive training plans - all from your own home.\n\nWhether you're just getting started or already train regularly, PullFit helps you stay consistent with guided workouts that fit around your day.\n\n\n# FEATURES\n\u2022 Real resistance band workouts\n\n\u2022 Beginner, Intermediate and Advanced training plans\n\n\u2022 Full-body strength training\n\n\u2022 Fitness testing and progress tracking\n\n\u2022 Training Mirror\n\n\u2022 Individual exercise practice mode\n\n\u2022 Multiple user profiles\n\n\u2022 Hand tracking controls - no controllers required\n\n\u2022 Mixed reality workouts in your own space\n\n\u2022 Cloud saves\n\n\n# TRAIN SMARTER\nBuild streaks, track workout history and monitor your fitness test results as you progress through your training journey.\n\n\n# TRAIN ANYWHERE\nNo gym membership. No bulky equipment. Just your headset, a resistance band and a little space to move.", "short_description": "Build real strength in mixed reality using resistance bands, guided workouts and progressive training plans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://j-hough.github.io/pullfit-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Huffy Media", "support_website_url": "https://j-hough.github.io/pullfit-site/support.html", "website_url": "https://j-hough.github.io/pullfit-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1360226613844036"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1754879399133557_5685118007436916795_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f0g_RpsRnQQ7kNvwH-ht_l&_nc_oc=Adpcwn3_qjmauYs-SyC3lEuLdBy69FDBGivkyaq_4RQUsefLAL1NnmkhTI53my9195k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQhN39imJnS2_QH_P1wOVX5nLpjEHhAAMo-9ExWZX_SA&oe=6AC110E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PullFit", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1790434320, "lastRevision": {"nodes": [{"id": "1360226633844034", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1360226600510704", "is_first_
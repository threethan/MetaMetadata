me": "store_04.png", "id": "1749438819473007", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825345_1749438822806340_3991680243995943994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOS34nEDNskQ7kNvwHVepSu&_nc_oc=AdoG6hYKZgW7RdmqPxTW2Tjc68xibjdwz58knGv2_6_sDkL5Wk6BRjaDKLXERO5FnsY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzDBBmUD7Y70nDdDG-EVBOIn5tPaDlWIVdge3J4Q-msQ&oe=6AC919ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-scaled-down-BG-move-cleaner.png", "id": "1387874676313489", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823366_1387874679646822_7321874149456102296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9x6ahrvSL-UQ7kNvwEJaQu5&_nc_oc=Adqo2i_JKT1nYtORQtAv6ohjGqZEC8zuOBbVE8uFNRS0-Q69HZ6e3RMOoDprKAnIrBI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDIesUQWhQUUmbSuI-xuJBNW3RDqL46Tb-yMRAgbwVUw&oe=6AC91842"}, "display_name": "PullFit", "keywords": [], "long_description": "# PullFit\n**Resistance bands required**\n\nPullFit is a mixed reality fitness app built specifically for resistance bands, using hand tracking so your hands stay free to train.\n\nBuild strength with structured workouts, fitness tests and progressive training plans - all from your own home.\n\nWhether you're just getting started or already train regularly, PullFit helps you stay consistent with guided workouts that fit around your day.\n\n\n# FEATURES\n\u2022 Real resistance band workouts\n\n\u2022 Beginner, Intermediate and Advanced training plans\n\n\u2022 Full-body strength training\n\n\u2022 Fitness testing and progress tracking\n\n\u2022 Training Mirror\n\n\u2022 Individual exercise practice mode\n\n\u2022 Multiple user profiles\n\n\u2022 Hand tracking controls - no controllers required\n\n\u2022 Mixed reality workouts in your own space\n\n\u2022 Cloud saves\n\n\n# TRAIN SMARTER\nBuild streaks, track workout history and monitor your fitness test results as you progress through your training journey.\n\n\n# TRAIN ANYWHERE\nNo gym membership. No bulky equipment. Just your headset, a resistance band and a little space to move.", "short_description": "Build real strength in mixed reality using resistance bands, guided workouts and progressive training plans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://j-hough.github.io/pullfit-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Huffy Media", "support_website_url": "https://j-hough.github.io/pullfit-site/support.html", "website_url": "https://j-hough.github.io/pullfit-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1360226613844036"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1822919335386608"}]}, "baseline_offer": {"id": "1822919335386608"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790434320, "status": "PUBLISHED", "id": "1822919335386608"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1403096709557026", "version": "0.1.13"}, "id": "2634800806967067", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "13602266005107
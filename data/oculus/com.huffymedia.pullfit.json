D"}, {"file_name": "co-location-2.png", "id": "1104409711988745", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1104409715322078_5387567400713819615_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDHnWLl1hEgQ7kNvwHZu5pX&_nc_oc=AdoZA_WuIeGw-4kUHSvWo5S7qdb6vMdKG43Zd6GbJGZvhafEWaPXYYnBXfretjxcbpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzoD6gGbGJxbenbY9dflUg1EE8jsj0Gh6rHIYf_uv7Hw&oe=6ACBB13D"}, {"file_name": "store_01.png", "id": "1587020202910061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1587020206243394_7825630047418286225_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OpeDYeU6DMQ7kNvwFC7X7M&_nc_oc=AdrL0avKWx8V3oLj90E2KZZKx4mbgTDIyzVX_K3crzGmwOKKARJN3Y-tbITRWeuIIgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3ch2Gtobs8w2Xj8wr8T73MOWePLcwGoubVBkQ_TGPqw&oe=6ACBA7B9"}, {"file_name": "online-2.png", "id": "2312142969623802", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_2312142972957135_7995320655853622997_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiGOD3e5dVkQ7kNvwFcwLyz&_nc_oc=Ado_sUGfODaWCH-AjmBEVlPP4NJrw7KImSzGy3NPd5eMZwp8THiCEl_16i7FI6gy47E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrNtESGr_5YpPnnWWWSYJMSi1gyEA1CaMYGhB4My_Fzg&oe=6ACBAFE5"}, {"file_name": "store_02.png", "id": "1091002216797318", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_1091002220130651_1065635981620922906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nepbMRSLHNkQ7kNvwG2IJz0&_nc_oc=AdpSnFvxYmz99DRhpi-omn_haBtWNbdZzc6H3qkj5PvTnOllAEDw63oglw-yC1bloKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgtaJND-jDYYd-Z4gu-4Ghwf62GRpo7PNIIvRw5g5bog&oe=6ACB9591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-scaled-down-BG-move-cleaner.png", "id": "1387874676313489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1387874679646822_7321874149456102296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjzbQcM2cbwQ7kNvwG9vLcT&_nc_oc=AdpGKz6ylMrVwLQwWYOhGoCH2RIWNReqDMeSzuxvliSwDKK8ywa9NYbR_0kc7XstF94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWnI3CdYTw8f6TiBKQMokaj5w3yrM_4y3-dZg9TQgx0w&oe=6ACBBB42"}, "display_name": "PullFit", "keywords": [], "long_description": "# PullFit\n**Resistance bands required**\n\nPullFit is a mixed reality fitness app built for resistance bands, using hand tracking so your hands stay free to train.\n\nBuild strength with structured workouts, fitness tests and progressive training plans at home. Then challenge friends and family, in the same room or online.\n\n\n# NEW: TRAIN TOGETHER\n\u2022 **Same room:** two headsets, one shared space. Battle side by side or work out together.\n\n\u2022 **Online:** battle or train with a friend anywhere, with voice chat and Meta avatars.\n\n\u2022 **Pass and play:** one headset, the whole household. Take turns and see who wins.\n\n\u2022 Invite friends from your Meta friends list\n\n\u2022 Live scores, handicaps for a fair fight, and a victory celebration\n\n\n# FEATURES\n\u2022 Real resistance band workouts\n\n\u2022 Beginner, Intermediate and Advanced training plans\n\n\u2022 Full-body strength training\n\n\u2022 Fitness testing and progress tracking\n\n\u2022 Tweak any exercise to fit your body\n\n\u2022 Training Mirror\n\n\u2022 Individual exercise practice mode\n\n\u2022 Multiple user profiles\n\n\u2022 Hand tracking controls - no controllers required\n\n\u2022 Mixed reality workouts in your own space\n\n\u2022 Cloud saves\n\n\n# TRAIN SMARTER\nBuild streaks, track your workout history and watch your fitness test results improve.\n\n\n# TRAIN ANYWHERE\nNo gym. No bulky equipment. Just your headset, a resistance band and a little space to move.", "short_description": "Build real strength in mixed reality using resistance bands, guided workouts and progressive training plans."}]}, "developer_name": null, "developer_privac
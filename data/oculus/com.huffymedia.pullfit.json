D"}, {"file_name": "co-location-2.png", "id": "1104409711988745", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825305_1104409715322078_5387567400713819615_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmUAEk4I7VQQ7kNvwHly2OX&_nc_oc=Adq8_CJeqe2uiraSufAR6yimPYkS6zJko_dVcgu-fv-Ap8sroOuOSeH-CQNDBTG9oyQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL2dztCX5-O94niyf3_vwzBTuW6oUXuBzmDoz2upGsFA&oe=6AD39A3D"}, {"file_name": "store_01.png", "id": "1587020202910061", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824318_1587020206243394_7825630047418286225_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkCOs7FFnWYQ7kNvwFC-FGR&_nc_oc=Adqt1HYp5Usneiv0ogOKAozbfbLHHkQszuEP2_acFayjx36gQ7iBlqcrfA7sAOYzW_g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-71PPVAFLlmKND7vWxqfpGeJmbEJdbWC7TBMN_azKIw&oe=6AD390B9"}, {"file_name": "online-2.png", "id": "2312142969623802", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824741_2312142972957135_7995320655853622997_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f86CCvq7hcQ7kNvwFEZGrw&_nc_oc=AdoUF4ELFJ33SFFUOxu1RCSiANUK5R6oLjcngBvOdVKoRGRgYFWuf9KCZqvVT8jKARI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvCvDiAutqrjVlpfSkGMOYlxgvVmYkWUWiDt71Lkm9bw&oe=6AD398E5"}, {"file_name": "store_02.png", "id": "1091002216797318", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828038_1091002220130651_1065635981620922906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JqlI-xpq_IQ7kNvwHbsDEC&_nc_oc=AdrY1AeJY-kYwhChijOxWJ1hH4T8FFWTjJl1YGC-3OoWQl4SiTAW-cmTs6ZfpNa1_Fc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHwTU6NOFbISrkSQ_O98ni-s59TXV5Lgu2dllVZR5omA&oe=6AD3B6D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-scaled-down-BG-move-cleaner.png", "id": "1387874676313489", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823366_1387874679646822_7321874149456102296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1pnoP3oVysQ7kNvwGKNuE4&_nc_oc=AdpzgonUO2mjJQjcuh5zIJI4L6y7qEs1PmEelAGpkR09X0-ORmo3I_EeN55q9OsfpKY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFyieCLjGyeOKcjGfvpVBGyGnAC4CGuQ6ShOxtVmjy7Q&oe=6AD3A442"}, "display_name": "PullFit", "keywords": [], "long_description": "# PullFit\n**Resistance bands required**\n\nPullFit is a mixed reality fitness app built for resistance bands, using hand tracking so your hands stay free to train.\n\nBuild strength with structured workouts, fitness tests and progressive training plans at home. Then challenge friends and family, in the same room or online.\n\n\n# NEW: TRAIN TOGETHER\n\u2022 **Same room:** two headsets, one shared space. Battle side by side or work out together.\n\n\u2022 **Online:** battle or train with a friend anywhere, with voice chat and Meta avatars.\n\n\u2022 **Pass and play:** one headset, the whole household. Take turns and see who wins.\n\n\u2022 Invite friends from your Meta friends list\n\n\u2022 Live scores, handicaps for a fair fight, and a victory celebration\n\n\n# FEATURES\n\u2022 Real resistance band workouts\n\n\u2022 Beginner, Intermediate and Advanced training plans\n\n\u2022 Full-body strength training\n\n\u2022 Fitness testing and progress tracking\n\n\u2022 Tweak any exercise to fit your body\n\n\u2022 Training Mirror\n\n\u2022 Individual exercise practice mode\n\n\u2022 Multiple user profiles\n\n\u2022 Hand tracking controls - no controllers required\n\n\u2022 Mixed reality workouts in your own space\n\n\u2022 Cloud saves\n\n\n# TRAIN SMARTER\nBuild streaks, track your workout history and watch your fitness test results improve.\n\n\n# TRAIN ANYWHERE\nNo gym. No bulky equipment. Just your headset, a resistance band and a little space to move.", "short_description": "Build real strength in mixed reality using resistance bands, guided workouts and progressive training plans."}]}, "developer_name": null, "developer_privac
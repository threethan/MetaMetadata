D"}, {"file_name": "co-location-2.png", "id": "1104409711988745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_1104409715322078_5387567400713819615_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmUAEk4I7VQQ7kNvwFN4BmI&_nc_oc=AdodwL1BWo9j1PT7UNcb9b4MP8f7aSKVEF7jDpUkLze8CN5cj3V_BgZc8skY_SWObis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnY8pwJppa1WKsQeSyuu5W1nxX6Rt4iVAV0IF50SzKnQ&oe=6AD248BD"}, {"file_name": "store_01.png", "id": "1587020202910061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1587020206243394_7825630047418286225_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkCOs7FFnWYQ7kNvwERxK1N&_nc_oc=AdpHry-op1JhC9VbjOVcMInxpOzG3hD7FFmReri0vOhEiEbYKYmbPfOzNraN0gE5fzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqAkuDU8PYYHGqujyrgHJb26fqT-EDpJG71HaXT2AJ7A&oe=6AD23F39"}, {"file_name": "online-2.png", "id": "2312142969623802", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_2312142972957135_7995320655853622997_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f86CCvq7hcQ7kNvwE9rnV5&_nc_oc=Adp46TERbxPvYxkNOXW3ihqVZOFmaM2IQG-LqYlCt1DQWoUKIhVhooqM0tyMPl8CIh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP63bJLTW5uq9_AEbcJLFj0iIyxYnDerTiZ5D3O_58aWQ&oe=6AD24765"}, {"file_name": "store_02.png", "id": "1091002216797318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_1091002220130651_1065635981620922906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JqlI-xpq_IQ7kNvwFP1WT4&_nc_oc=Adriq_4rCi4Yz8GsXPI5QsoNPh4qkCzDZPdQXYEx8CMTmMGAqLBVFiOsgDe9_1HgFDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN31D4zEJOzXuIvEhEGI5BteVXwHr0SsX0U8PYLV2KIg&oe=6AD22D11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-scaled-down-BG-move-cleaner.png", "id": "1387874676313489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1387874679646822_7321874149456102296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1pnoP3oVysQ7kNvwH-NJ-Z&_nc_oc=AdpHuZUGG3r6RHkbWnu5sxighPs4L8AjxiaABAPep7qPV38Sdaex_FXjeuyFq8hZgUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDpktXAPx_0PgzsWmL_0toeDRUXG7KNUHAAULomUQOrQ&oe=6AD252C2"}, "display_name": "PullFit", "keywords": [], "long_description": "# PullFit\n**Resistance bands required**\n\nPullFit is a mixed reality fitness app built for resistance bands, using hand tracking so your hands stay free to train.\n\nBuild strength with structured workouts, fitness tests and progressive training plans at home. Then challenge friends and family, in the same room or online.\n\n\n# NEW: TRAIN TOGETHER\n\u2022 **Same room:** two headsets, one shared space. Battle side by side or work out together.\n\n\u2022 **Online:** battle or train with a friend anywhere, with voice chat and Meta avatars.\n\n\u2022 **Pass and play:** one headset, the whole household. Take turns and see who wins.\n\n\u2022 Invite friends from your Meta friends list\n\n\u2022 Live scores, handicaps for a fair fight, and a victory celebration\n\n\n# FEATURES\n\u2022 Real resistance band workouts\n\n\u2022 Beginner, Intermediate and Advanced training plans\n\n\u2022 Full-body strength training\n\n\u2022 Fitness testing and progress tracking\n\n\u2022 Tweak any exercise to fit your body\n\n\u2022 Training Mirror\n\n\u2022 Individual exercise practice mode\n\n\u2022 Multiple user profiles\n\n\u2022 Hand tracking controls - no controllers required\n\n\u2022 Mixed reality workouts in your own space\n\n\u2022 Cloud saves\n\n\n# TRAIN SMARTER\nBuild streaks, track your workout history and watch your fitness test results improve.\n\n\n# TRAIN ANYWHERE\nNo gym. No bulky equipment. Just your headset, a resistance band and a little space to move.", "short_description": "Build real strength in mixed reality using resistance bands, guided workouts and progressive training plans."}]}, "developer_name": null, "developer_privac
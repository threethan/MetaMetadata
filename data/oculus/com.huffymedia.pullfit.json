D"}, {"file_name": "co-location-2.png", "id": "1104409711988745", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825305_1104409715322078_5387567400713819615_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaVsX-fNKXsQ7kNvwEjfH1I&_nc_oc=Adp434CJPGTe8dwDlY6aXGy9JfSiKCqvH0AjvdrojdPch5ypYhzoR9Whz2NhDfuEMco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqwdKDf5GV-meMKs08_qQtmOyWNn1NhnWb3vjSE1EjNg&oe=6ACFA5BD"}, {"file_name": "store_01.png", "id": "1587020202910061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824318_1587020206243394_7825630047418286225_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYOzWqaRvd4Q7kNvwGgSVsK&_nc_oc=AdoYHVUpXh23TfjpQW-Bem2P742WLiqGYgivUkRFBJBhUvf-zpw9YeFoNzgcXxetp9w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBMjM4WqBhHTQZxGUg1oOGz3Q6veleCEaikTMX73seCg&oe=6ACF9C39"}, {"file_name": "online-2.png", "id": "2312142969623802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824741_2312142972957135_7995320655853622997_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhzuartBRnYQ7kNvwGJcl5i&_nc_oc=Adp-FGVC5XSloPuusKje2J2TltstoFFQUp-ujVlP-DR0OXSGeXLO760AoRTivaWw2qM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuKczqLSh5TF3PpJSbvG5ZilRRBfkjJMJFRVvw7dCiWA&oe=6ACFA465"}, {"file_name": "store_02.png", "id": "1091002216797318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828038_1091002220130651_1065635981620922906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca4nh-1uQ28Q7kNvwHZfTT6&_nc_oc=AdqY2v_xo3IOqF_8p9tbGLI8vWcFAFCsThsEnXqaJtHpq4eeZ39LdcDqH8_L9KbaMs0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPFko8eMgQbYx0sdaM17dVM9-Yf0Gcq6gAAr-zuBYS8g&oe=6ACF8A11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-scaled-down-BG-move-cleaner.png", "id": "1387874676313489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823366_1387874679646822_7321874149456102296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAnR5j3IL-wQ7kNvwF2-FBb&_nc_oc=AdqHJb4knqBq5GANbf-k-DYEz7v7Lfmo85BNlBGurfvoHRW-SGmmGfcnx4m6caZW2jI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkv-CjwtrS8Mqlq-MHD4wtovFvNPpSJ33TU9S5kxIUnQ&oe=6ACFAFC2"}, "display_name": "PullFit", "keywords": [], "long_description": "# PullFit\n**Resistance bands required**\n\nPullFit is a mixed reality fitness app built for resistance bands, using hand tracking so your hands stay free to train.\n\nBuild strength with structured workouts, fitness tests and progressive training plans at home. Then challenge friends and family, in the same room or online.\n\n\n# NEW: TRAIN TOGETHER\n\u2022 **Same room:** two headsets, one shared space. Battle side by side or work out together.\n\n\u2022 **Online:** battle or train with a friend anywhere, with voice chat and Meta avatars.\n\n\u2022 **Pass and play:** one headset, the whole household. Take turns and see who wins.\n\n\u2022 Invite friends from your Meta friends list\n\n\u2022 Live scores, handicaps for a fair fight, and a victory celebration\n\n\n# FEATURES\n\u2022 Real resistance band workouts\n\n\u2022 Beginner, Intermediate and Advanced training plans\n\n\u2022 Full-body strength training\n\n\u2022 Fitness testing and progress tracking\n\n\u2022 Tweak any exercise to fit your body\n\n\u2022 Training Mirror\n\n\u2022 Individual exercise practice mode\n\n\u2022 Multiple user profiles\n\n\u2022 Hand tracking controls - no controllers required\n\n\u2022 Mixed reality workouts in your own space\n\n\u2022 Cloud saves\n\n\n# TRAIN SMARTER\nBuild streaks, track your workout history and watch your fitness test results improve.\n\n\n# TRAIN ANYWHERE\nNo gym. No bulky equipment. Just your headset, a resistance band and a little space to move.", "short_description": "Build real strength in mixed reality using resistance bands, guided workouts and progressive training plans."}]}, "developer_name": null, "developer_privac
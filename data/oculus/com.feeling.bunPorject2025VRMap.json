28hOn9w&oe=6AF49F38"}, {"file_name": "25601440_5.png", "id": "1741565877047369", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624577_1741565880380702_5926074298891279952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXPGNv-xdeAQ7kNvwH3UEG3&_nc_oc=AdpzMCEGRqow7gvxnRQk7VQZ5INXPXLf_OLpMytZTGY9PsYPMcAokfheb0RyxAzMZIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT782C2Z01ZfML2SU5a5xx1WvYW5unX8KmPUVv4wYEVMQ&oe=6AF485FC"}, {"file_name": "25601440_6.png", "id": "1078110521826087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_1078110525159420_4004940896138565894_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrJiUxVVttcQ7kNvwFH14wV&_nc_oc=AdqA4lcplox2GYzXKXVRE-zVJgToEmAgGT1Ukfp9WbB07icRVngg8USc9P0uD9mMstM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpKCTtZZ7Eq26TX22E16-exErDvZc_FS9mVDtqyxwBzw&oe=6AF4A114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jiao FestiVerse: VR Agora \u00d7 Museum", "keywords": [], "long_description": "The Cheung Chau Tai Ping Qing Jiao Festival originated in the 19th century, when the island\u2019s residents held religious ceremonies to pray to the deities to soothe the souls of the deceased and ward off disasters and misfortunes in order to drive away epidemics. This tradition has continued to the present day, evolving into an annual, large-scale community event lasting five days and four nights\nthat aims to pray for peace and prosperity. In 2011, it was inscribed on the National List of Intangible Cultural Heritage.\nCurrently, the Cheung Chau Tai Ping Qing Jiao Organizing Committee represents the island\u2019s residents in organizing the festival at the Pak Tai Temple Playground.\n\nThe Cheung Chau Tai Ping Qing Jiao Virtual Mixed Reality Platform recreates the festive scenes of the 2025 Tai Ping Qing Jiao, showcasing every aspect of the festival. Through two interactive information stations, the public can gain a comprehensive understanding of the festival\u2019s traditions and rituals via multiple 360-degree videos, and travel back in time through historical photographs to experience the evolution of the Tai Ping Qing Jiao.\n\nThe public can enter the Virtual Reality (VR) Market \u00d7 Museum to experience the festive atmosphere and learn about the culture and traditions of the Cheung Chau Tai Ping Qing Jiao through ten interactive booths.", "short_description": "Festival Overview\n\nHistory: Originated in the 19th century as a religious ritual to ward off epidemics and evil spirits. Inscribed on the National List of Intangible Cultural Heritage in 2011.\n\nVirtual Mixed Reality Platform (2025 Edition)\n\nFeatures: Recreates the festival via 360-degree videos, historical photos, and 10 interactive booths inside a VR Market \u00d7 Museum.\n\nAccess: Available on Windows desktop and VR headsets, allowing users to explore traditions and past history interactively."}, {"images": {"nodes": []}, "id": "1076759268587198", "locale": "zh_HK", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u592a\u5e73\u6e05\u91ae\u7bc0\u6176\u5143\u5b87\u5b99\uff1a\u865b\u64ec\u5be6\u5883\u5e02\u96c6 \u00d7 \u535a\u7269\u9928", "keywords": [], "long_description": "\u9577\u6d32\u592a\u5e73\u6e05\u91ae\u8d77\u6e90\u65bc19\u4e16\u7d00\uff0c\u7576\u6642\u5cf6\u4e0a\u5c45\u6c11\u70ba\u4e86\u9a45\u9664\u761f\u75ab\uff0c\u8209\u884c\u4e86\u7948\u6c42\u795e\u660e\u5b89\u64ab\u4ea1\u9b42\u3001\u6d88\u707d\u89e3\u5384\u7684\u5b97\u6559\u5100\u5f0f\u3002\u9019\u9805\u50b3\u7d71\u5ef6\u7e8c\u81f3\u4eca\uff0c\u6210\u70ba\u6bcf\u5e74\u4e00\u5ea6\u70ba\u671f5\u65e54\u591c\u7684\n\u5927\u578b\u793e\u5340\u6d3b\u52d5\uff0c\u65e8\u5728\u7948\u6c42\u5e73\u5b89\u9806\u9042\uff0c\u4e26\u65bc2011\u5e74\u7372\u5217\u5165\u570b\u5bb6\u7d1a\u975e\u7269\u8cea\u6587\u5316\u907a\u7522\u3002\n\u73fe\u6642\uff0c\u9999\u6e2f\u9577\u6d32\u592a\u5e73\u6e05\u91ae\u503c\u7406\u6703\u4ee3\u8868\u5cf
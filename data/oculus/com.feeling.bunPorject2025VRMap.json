a5xx1WvYW5unX8KmPUVv4wYEVMQ&oe=6AF485FC"}, {"file_name": "25601440_6.png", "id": "1078110521826087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_1078110525159420_4004940896138565894_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrJiUxVVttcQ7kNvwFH14wV&_nc_oc=AdqA4lcplox2GYzXKXVRE-zVJgToEmAgGT1Ukfp9WbB07icRVngg8USc9P0uD9mMstM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpKCTtZZ7Eq26TX22E16-exErDvZc_FS9mVDtqyxwBzw&oe=6AF4A114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u592a\u5e73\u6e05\u91ae\u7bc0\u6176\u5143\u5b87\u5b99\uff1a\u865b\u64ec\u5be6\u5883\u5e02\u96c6 \u00d7 \u535a\u7269\u9928", "keywords": [], "long_description": "The Cheung Chau Tai Ping Qing Jiao Festival originated in the 19th century, when the island\u2019s residents held religious ceremonies to pray to the deities to soothe the souls of the deceased and ward off disasters and misfortunes in order to drive away epidemics. This tradition has continued to the present day, evolving into an annual, large-scale community event lasting five days and four nights\nthat aims to pray for peace and prosperity. In 2011, it was inscribed on the National List of Intangible Cultural Heritage.\nCurrently, the Cheung Chau Tai Ping Qing Jiao Organizing Committee represents the island\u2019s residents in organizing the festival at the Pak Tai Temple Playground.\n\nThe Cheung Chau Tai Ping Qing Jiao Virtual Mixed Reality Platform recreates the festive scenes of the 2025 Tai Ping Qing Jiao, showcasing every aspect of the festival. Through two interactive information stations, the public can gain a comprehensive understanding of the festival\u2019s traditions and rituals via multiple 360-degree videos, and travel back in time through historical photographs to experience the evolution of the Tai Ping Qing Jiao.\n\nThe public can enter the Virtual Reality (VR) Market \u00d7 Museum to experience the festive atmosphere and learn about the culture and traditions of the Cheung Chau Tai Ping Qing Jiao through ten interactive booths.", "short_description": "Festival Overview\n\nHistory: Originated in the 19th century as a religious ritual to ward off epidemics and evil spirits. Inscribed on the National List of Intangible Cultural Heritage in 2011.\n\nVirtual Mixed Reality Platform (2025 Edition)\n\nFeatures: Recreates the festival via 360-degree videos, historical photos, and 10 interactive booths inside a VR Market \u00d7 Museum.\n\nAccess: Available on Windows desktop and VR headsets, allowing users to explore traditions and past history interactively."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/3df20f99-3ea0-4379-bb32-d754b63261dc", "developer_terms_of_service_url": null, "publisher_name": "GDLab", "support_website_url": null, "website_url": "https://gdlab.hksyu.edu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35758868350394427"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1470306164917720"}]}, "baseline_offer": {"id": "1470306164917720"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792549860, "status": "PUBLISHED", "id": "1470306164917720"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4001194611508
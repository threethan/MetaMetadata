SNeFW7_V6yIH1HIe0J4na6y6A&oe=6B0DBA7B"}, {"file_name": "In build (4) (1).png", "id": "656456480846075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831056_656456484179408_3236689812329758739_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CjtOEzdJloQ7kNvwEyGYao&_nc_oc=Adqi9M1ymNOLH85OmmHyHYLwDd2-SJvpIsRYd8alz7qrHuvPDvz4n_XgPFUo-eJB5yY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWE--ttdOk3ZFnOMmWcLLJORnb-wLLbV5PMakluvatDA&oe=6B0DAF98"}, {"file_name": "In build (5) (1).png", "id": "4062740687298462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818938_4062740693965128_1503838996103708464_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAi44ewMY7MQ7kNvwFlW1EV&_nc_oc=Ado8RrBS5YrhdHSVzQJ8qNBJfFFOkK5K6DiLxMljtoSFQFm4wvcOqqVySSza6Zt1-lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvSQLIXzXjdpidTGCQfSlM9S9wZkUrEKaAdY2pHY2quw&oe=6B0DCA7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DontZcare", "keywords": ["Scary", "Monke", "Scare", "Monkey", "Gorilla"], "long_description": "DontZcare is a thrilling VR horror experience that throws you into an endless maze of shifting backrooms where every corner hides both mystery and danger. Trapped in a surreal world, your only goal is to survive and escape while being relentlessly hunted by bizarre creatures\u2014most notably the unsettling \u201cScary Baboon\u201d whose deceptively goofy faces mask their true menace.\n\nWith immersive environments, unpredictable encounters, and an atmosphere that balances fear with absurdity, DontZcare challenges your instincts and courage at every step. Run, hide, and outsmart your pursuers\u2014because in these backrooms, hesitation means defeat.\n\nAre you ready to face the chaos, or will you discover why the game is called DontZcare?", "short_description": "\ud83c\udf0c DontZcare \u2013 Escape the Endless Backrooms\n\nStep into a terrifying VR survival experience where reality twists into endless hallways and lurking shadows. In DontZcare, you\u2019re never truly alone\u2014because something is always hunting.\n\n\ud83e\udd8d Beware the Scary Monkeys: goofy-faced creatures with a dark side, unpredictable and relentless. Their absurd look will fool you\u2014but one wrong move, and you\u2019re caught.\n\n\u2728 Features:\n\nImmersive VR horror in surreal backrooms\n\nUnique monsters blending comedy and fear\n\n"}]}, "developer_name": "DontZcare Dev Studio", "developer_privacy_policy_url": "https://sites.google.com/view/monkesptprivacypolicy/inicio", "developer_terms_of_service_url": null, "publisher_name": "DontZcare Dev Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/dontzcare/inicio?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24394800990172962"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1147953793789394"}]}, "baseline_offer": {"id": "1147953793789394"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766786160, "status": "PUBLISHED", "id": "1147953793789394"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25404280259225025", "v
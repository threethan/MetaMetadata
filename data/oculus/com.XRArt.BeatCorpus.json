wGKDd69&_nc_oc=AdqepkKSxnczHpSns5z8ZKS5ownmBpk4jUNn-lC7-Mfg_nKuRHk2L_ceT4MDqRI1-dE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1Yv1_Sf_qnI3ixqrcehdiVFLrYssnP9HKju_FV58pltQ&oe=69F20782"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW3jQjR_nI8Q7kNvwEfD3Lo&_nc_oc=Adp99d4CncVTaFBcJ9_TjafKp57r4Ub65HipbwZBFD31uGQ4M09EI7j41gDkvQVrAQw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-VqoSUlz8O5safOnzrfZsLXlyo_ndE1TCOwkAMpJqHg&oe=69F1FBD7"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91owDrFP6h4Q7kNvwFZmx7d&_nc_oc=AdpFZ8YhINarWXjUG1UyJ8DODX9H9K9GaLlCrv9mRpwOUIODESRVMV9PJN_tnhUXHiM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2ZhVRDpaOkEBJpA2ZIRwFnbhCU2sFCb27o_jWklqW8TA&oe=69F21225"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHuXv1d1ga8Q7kNvwEljTA4&_nc_oc=AdrWoNBm_XGJEE9l_Ho7CiuG7w6gN2OgFfiLXdflDrBh4MpDSkZiTlYvhyEV-Pqtmgk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JacVLyNOWJtWCfQh8qc2CGGkemr7SWdZK0UTKbjgIRw&oe=69F1ECCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9530868510310900"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1815345505920558"}]}, "baseline_offer": {"id
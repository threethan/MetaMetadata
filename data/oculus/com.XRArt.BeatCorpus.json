name": "screenshot1.png", "id": "504055162799864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031378_504055166133197_1784207715624662017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoy0qv3HcsEQ7kNvwGBqkiF&_nc_oc=AdoCuXMbwKQD6GubHQdUnHSdfZWB3bMTLk-lscX9hp-nWMB6a9wGzR5Wi2BgFFX66zg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQafcj_CdudfrexjlJP9V8Tvim8zkpg_hpwYLQF0Qxag&oe=6A7F01ED"}, {"file_name": "screenshot2.png", "id": "3836892209897058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641342_3836892213230391_55603269186542008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbOBJZ3lMWIQ7kNvwE1bUxS&_nc_oc=Adqgv9xKXQRQk-algSs1BKKQdx57whf5iElbk64GAIb2bNYK97FUwmIXzhS8dVGOaj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy8r-ALznXxb7dgn146p1oLMiFukd73KdL63fnqvCSNw&oe=6A7F06CB"}, {"file_name": "screenshot3.png", "id": "1025976459571113", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974860_1025976462904446_8335510565936844776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJJA4JAfl8sQ7kNvwGXgS7T&_nc_oc=AdrOOXTQ9QGQoodo6dx2ftajOXbScSGKNAoDc-OZKy24iW5sw2jcYFP1_4XvXFcfkz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiotCiBQat9qjo1SFzexGdHG71UKcPGoMx-YORO6iOsQ&oe=6A7F1538"}, {"file_name": "screenshot4.png", "id": "1147275743748493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031577_1147275747081826_3155684496091330574_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNjju92BurwQ7kNvwGPVWme&_nc_oc=Adr9LEw-ODKbDJaUDLBYQzfAdLanJCAv9Yv7boGkxGI7hAkdUmwL4YA6BkpeDm6ES58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN0Tsx8vapbyQPrr68e2QRBCJHnbH5GitC105RuTEk-w&oe=6A7F12BF"}, {"file_name": "screenshot5.png", "id": "471053949115541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001733_471053952448874_3202784361879606422_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0saftiMggJEQ7kNvwG04F-Z&_nc_oc=Adozw0txZ6kP7tQFEbpFHGwqjtoddl_D0R_ay67vGvYJU9cVwTVZjN-gHTMY5QLmw9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCMuefL7pwAj-41uqAnewVO6cg_Ence4wkP_bBP9e7eQ&oe=6A7EF717"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\ube44\ud2b8\ucf54\ud37c\uc2a4", "keywords": [], "long_description": "\ube44\ud2b8 \ucf54\ud37c\uc2a4(Beat Corpus) \uc18c\uac1c\n\ube44\ud2b8 \ucf54\ud37c\uc2a4\ub294 \ub9ac\ub4ec\uacfc \uc2a4\ud1a0\ub9ac\uac00 \uacb0\ud569\ub41c VR \uae30\ubc18\uc758 \uccb4\ud5d8\ud615 \ub9ac\ub4ec \uac8c\uc784\uc785\ub2c8\ub2e4. \uc5b4\ub9b0\uc655\uc790, \ud53c\ud130\ud32c \ub4f1 \ub2e4\uc591\ud55c \uc2a4\ud1a0\ub9ac\ub97c \uae30\ubc18\uc73c\ub85c \uc0dd\uc131\ub41c \uc74c\uc545\uacfc \ud050\ube0c\ud615 \uce90\ub9ad\ud130\ub97c \ud1b5\ud574 \uc9e7\uc740 \uc2dc\uac04 \uc548\uc5d0 \uc7ac\ubbf8\uc640 \ubab0\uc785\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\uc2a4\ud1a0\ub9ac \uae30\ubc18 \uac8c\uc784: \uc5b4\ub9b0\uc655\uc790, \uacf5\ub8e1, \uba85\ud654 \ub4f1 \ub2e4\uc591\ud55c \ud14c\ub9c8\uc758 \uc2a4\ud1a0\ub9ac\ub97c \ub9ac\ub4ec\uacfc \uacb0\ud569\ud558\uc5ec, \ub3c5\ucc3d\uc801\uc774\uace0 \ubab0\uc785\uac10 \uc788\ub294 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\uac00\uc871\uacfc \ud568\uaed8: 5\ubd84 \ub0b4\uc678\uc758 \uc9e7\uace0 \uc9c1\uad00\uc801\uc778 \ud50c\ub808\uc774\ub85c \ub2e4\uc591\ud55c \uacf5\uac04\uc5d0\uc11c \uac00\uc871\uacfc \ud568\uaed8 \uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uad50\uc721\uacfc \uc7ac\ubbf8\uc758 \uc870\ud654: \uc0ac\uc6a9\uc790\uc5d0\uac8c \ub3c5\uc11c \ub3d9\uae30\ub97c \ubd80\uc5ec\ud558\uace0, \ucc3d\uc758\uc801\uc778 \uc0c1\ud638\uc791\uc6a9\uc744 \ud1b5\ud574 \uc9c0\uc2dd\uacfc \ud790\ub9c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\ube44\ud2b8 \ucf54\ud37c\uc2a4\ub294 \uc544\uc774\ub4e4\uacfc \uc5b4\ub978 \ubaa8\ub450\uc5d0\uac8c \ub3c5\uc11c\uc640 \ubc30\uc6c0\uc758 \uc990\uac70\uc6c0\uc744 \uc120\uc0ac\ud558\uba70, \ubbf8\ub798\ud615 VR \ucf58\ud150\uce20\uc758 \uac00\ub2a5\uc131\uc744 \uc5fd\ub2c8\ub2e4.", "short_description": "\ube44\ud2b8 \ucf54\ud37c\uc2a4\ub294 VR \ub9ac\ub4ec \uac8c\uc784\uacfc \ub3c5\uc11c \ub3d9\uae30\ubd80\uc5ec\ub97c \uacb0\ud569\ud55c \ud601\uc2e0\uc801\uc778 \ud50c\ub7ab\ud3fc\uc73c\ub85c, \uc5b4\ub9b0\uc655\uc790\uc758 \uc2a4\ud1a0\ub9ac\ub97c \uae30\ubc18\uc73c\ub85c \ub9cc\ub4e4\uc5b4\uc84c\uc2b5\ub2c8\ub2e4. \uc774 \ubc84\uc804\uc5d0\uc11c\ub294 \uc0ac\uc6a9\uc790\uac00 \uc9c1\uc811 \uc5b4\ub9b0\uc655\uc790\uc758 \uc5ec\uc815\uc744 \uccb4\ud5d8\ud558\uba70, \uac01 \uc18c\ud589\uc131\uc5d0 \ub9de\ucd98 \uc2a4\ud1a0\ub9ac\uc640 AI\ub85c \uc81c\uc791\ub41c \uc74c\uc545\uc5d0 \ub530\ub77c \ub9ac\ub4ec \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n\u201c\ucf54\ud37c\uc2a4(Corpus)\ub294 \ub9ac\ub4ec\uacfc \uc9c0\uc2dd, \uc2a4\ud1a0\ub9ac\uac00 \ubaa8\uc5ec \ud558\ub098\uc758 \uc644\uc131\ub41c \ucf58\ud150\uce20 \uc9d1\ud569\uccb4\ub77c\ub294 \uc758\ubbf8\ub97c \ub73b\ud569\ub2c8\ub2e4.\u201d\n\uc8fc\uc694 \ud2b9\uc9d5:\n1.\t\uc5b4\ub9b0\uc655\uc790\uc758 \uc5ec\uc815\no\t\uc5b4\ub9b0\uc655\uc790\uac00 \ubc29\ubb38\ud55c \ubcc4\ub4e4\uc744 \ubc30\uacbd\uc73c\ub85c, \uc2a4\ud1a0\ub9ac\uc5d0 \ub9de\ucd98 \ubbf8\uc158\uacfc \uac8c\uc784\uc744 \uccb4\ud5d8\ud569\ub2c8\ub2e4.\n2.\t\uc2a4\ud1a0\ub9ac \uae30\ubc18 \ub178\ub798 \uc81c\uc791\no\t\uac01 \ubcc4\uc758 \uc8fc\uc694 \uc774\uc57c\uae30\ub97c \ubc14\ud0d5\uc73c\ub85c AI\uac00 \uc0dd\uc131\ud55c \ub178\ub798\uc5d0 \ub9de\ucdb0 \ub9ac\ub4ec \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n3.\t\ub9de\ucda4\ud615 \uc6d4\ub4dc \ub514\uc790\uc778\no\t\ubcc4\ub9c8\ub2e4 \ub3c5\ud2b9\ud55c \uce90\ub9ad\ud130, \uc790\uc5f0\ubb3c, \ubc30\uacbd, \uc2a4\uce74\uc774\ubc15\uc2a4\uac00 \ub2e4\ub974\uac8c \uad6c\uc131\ub418\uc5b4 \ubab0\uc785\uac10\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4.\n4.\t\ub3c5\uc11c \ub3d9\uae30\ubd80\uc5ec\no\t\uac8c\uc784\uc744 \ud1b5\ud574 \uc2a4\ud1a0\ub9ac\uc640 \ub9ac\ub4ec\uc744 \uacbd\ud5d8\ud558\uba70 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ub3c5\uc11c\uc5d0 \ub300\ud55c \ud765\ubbf8\ub97c \uc720\ubc1c\ud569\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "tr_LogoBeatCorpus.png", "id": "3567053780267444", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982480_3567053783600777_8213747801081039316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG-h4ve3AgEQ7kNvwGzLzLE&_nc_oc=Adp6yK_YzMu-mwS8JmeII4m3RItwu68b4yd6onDX-hi3QJRe9Wd8OL2XDbVacqg5nWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqmJTwBuNKkKQ1Bo_ZsLhebTyjnKhkhvHCzQD6hEsCig&oe=6A7F26A3"}, {"file_name": "[\ud3ec\ub9f7\ubcc0\ud658]BeatCorpusIcon.png", "id": "1767336497454756", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974913_1767336500788089_7908135678038564213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RikLQ53ylEQ7kNvwGcSXGq&_nc_oc=AdoEXFdKbxuvuSSR0f-6zo5B-oWUGQS2idF6hrjaumXFYkJnv2zwCiHByFDpBiMNHq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeJ2t2lLjOUXZeWsEYAd30aunPR7z0HBbWO7BIsdMmAA&oe=6A7EFA82"}, {"file_name": "ArtCover_1080x1440.png", "id": "1184581173408648", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75520131_1184581176741981_11197673817713959_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Odphqw4lgFcQ7kNvwFBUuKo&_nc_oc=AdpONCdlZHsaup-71Ju_XheG9FgHcBznidvJ-0j8pxHRWLYKaSqI_8DF-2y94K2g5eY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESt_ZWJRkA-eD86ymknV-vHYaeEB3cufoZHFifq6DrlQ&oe=6A7F02D7"}, {"file_name": "HeroCover_3000x900.png", "id": "1164670238565242", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575352_1164670241898575_5876008033631265344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shPlQ-Tk7s8Q7kNvwGK2OLy&_nc_oc=AdqAnk0679zkbVgRk9icBVJ7dIktEjTZxdFKat5yK7mETWZ3rGiDd1pVEdQMF4oYhh8&_nc_zt=3&_nc
0f&oh=00_AQG-1OXPPaRHVz2WGotc4h3RIAmrpHvZLgng3sFCdm-dsA&oe=6A93FA64"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp9HfVoTujEQ7kNvwHK0qKM&_nc_oc=Adqdb4jLe_VwnRJ7QL-91dMHotr_uJZOCFTuFHDIrz4cPEDY7DNf0Zcst9Z225Su4CE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_1bhLvKMg9IbTVUIEqxv9J1ueOufHe1TIEMGrUBY9aw&oe=6A943002"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqIT1-6rgdQQ7kNvwEx0M3L&_nc_oc=AdoaRpMeWFmuS9boYS5d_kMrRl1TofMLx9dOHmZdAB25Dv5ZE-v790Qzh-RF9lq8d2c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIhqrFgCWmgWiRiEFdqymDxqILHS1SKE5PzNLAoAyU-Q&oe=6A942457"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7Vzz-qmTckQ7kNvwGma69i&_nc_oc=AdryQBmwTGTUReXIfpIHinBV7wiSEGsrpfZ4xhj6RqOSGI7Yz6G5dQNAj9UZdgptmKA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaxRlH09gp7P6NOt_8uw6FnrEXQXhtzKT5fGAAWYcGeg&oe=6A940265"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXc2LCYkCc0Q7kNvwFFH8r3&_nc_oc=AdrCipv13QGCL5LA42_Xzi3foILaU__QuobX8fXFSfAFbHfTKU1aEMSD-3eujbYBkoM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKewNNBHODApQhhPz_5VzJ8iWuI0Pbiww6CFAUQAVeww&oe=6A94154C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "support
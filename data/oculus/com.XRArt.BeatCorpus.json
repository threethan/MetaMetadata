0f&oh=00_AQQ5-29hrUVEuWAzetFiFx4apxyKOI--RxqzL0GZriGsig&oe=6AF9B624"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R1SeMpzCrgQ7kNvwFp1HA_&_nc_oc=AdrsFO7oGVQ3K8WCqkizbGmbV0KWY3QYnLmV2WIV9nisFPnNrMEkz6vL78_Ii8UDheY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDwXlIytPN_8p6ZfZaJiSLH1qsWxo4bs4EUeFt6iRqLw&oe=6AF9EBC2"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI4EjKp7zawQ7kNvwF13SBU&_nc_oc=AdpnelxB5gQd9QXSVn7EvwzA7T-_11mSrZ5YdqMv1ufIhku9AFuuEEEZ1uLVI54FwP0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJt85arIOdOk9yn18ssvWWGapL759aAVZgbPJLeuM_Fw&oe=6AF9E017"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai_0pOrzB5oQ7kNvwF9qVnc&_nc_oc=AdrGiJ7U7WUQMVKAs3tiADXYwdsbTIF4-UdW3jn5UFtft0wXEI-erB0ciAXWvbYxhZ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9au12ILSKEiywUvtz7ZHSsUiNy5PbV5o4xzFtpoX34g&oe=6AF9BE25"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI29TZjhkFgQ7kNvwF0VkBy&_nc_oc=Adqca48Qf04ZkS13-1ofSYYzUPUUwTRGUt-nUnuAh432v6mXKejRdCNZ0hIfwBePmC8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNOG3boB0NaMjZ1LZ6Tv9Bb7bBEknea8MtQwsp49-X_g&oe=6AF9D10C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "support
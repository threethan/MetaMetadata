.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg5iStdG2xQQ7kNvwE3gA8Y&_nc_oc=Adm6ke7osxvSG9jTlWji29GZZOq-sZjLM1HFZ0R3gN1eiNRSuD3Oamm1kVS9Zn1JfZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJCRUVhL5qqZYAuDPSySodUXc6i_FhYGRopWfd5MMNgw&oe=69B56282"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYSo7-FgGdkQ7kNvwFTQPcX&_nc_oc=Adla_gSqgljSRG5idlp-ea3znPAiyfwoMzNQs2JPG0EWnJlp6RfttF8qjEnbJ5YWalY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAqhDcGeMrypdsD6FffZ71FvO5hMgea5Dfy6FQ7yVXoQ&oe=69B556D7"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmG8xnp4MrwQ7kNvwEdvueZ&_nc_oc=AdndF_zhb6aaTzeAcMgcp5e7fOVMbJWybvUYKCjqSp01wXe4Yhid3OsQ9qzAxxLzt4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzsjsj1wBwOvTu5UFWA8WpdPEnQjSCYqRSR0ws3dZj-SA&oe=69B56D25"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a5dOpSRbO4Q7kNvwGanMSc&_nc_oc=AdkDFZOu0-GuzxHySt42xIq8woshZgKz__si0DNfFYJkFlyIqutIg2P9QXG6GK8zrPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyfnJH3PBMrPcc8gVsC4DTu4NNrN2qNtAZLJWzJlPhSA&oe=69B547CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "953086851031
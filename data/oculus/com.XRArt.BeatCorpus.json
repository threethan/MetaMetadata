0f&oh=00_AQQ6vXfF4YY9FJnHc0SGZ_c0UwhrsoW7EODi4k_DbPSQ2g&oe=6AF356E4"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6JcMxViSEUQ7kNvwHQ3p7d&_nc_oc=AdpeXzYBcp5E5rvMFln3GJOLF32meiV0H-TUcItw13a70UmeGC3cuaSJ01uKmDFg4Jg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVA4lOBv1cU-bl1Mu8SVV53IRxThei5iX-k5eMOFTKEg&oe=6AF35442"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THAX88AnP-sQ7kNvwE3RJJA&_nc_oc=AdpmsHlCTGR5lA8XUE8UyC2_WAx37bofD7z14rmaCYGVKA_3sTk7N-9NQIqpJFR6N9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWtnfb7dk8cSW6lqi0mtoj6PzNUm-eIRef1Mlc3agybg&oe=6AF34897"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6actmuRSV0Q7kNvwF6MPKe&_nc_oc=AdpavcQyZuhIaYogLhbpgyuKwBYRZaekLDPDu3tac4ORXRw2eqWwCT7ZXG8yN0ZIZiI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9cI52wpPFeIJXyy_0OOoHq2J6dG43F-_Lqqk02M_wqA&oe=6AF326A5"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5RoYRi8XNgQ7kNvwHEbtTM&_nc_oc=Adr52epHjXA2eMUwW7be-ftY2YPRbEZxzc3xrey1RtX48wPWa8Lo3hPKOdbYNmlpx58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgnWnrwmRMwy9VurXac1wuY1ZlXb2XB-DVbQDK9erbxw&oe=6AF3398C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "support
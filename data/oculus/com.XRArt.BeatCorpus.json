0f&oh=00_Af6BqM_JPJC0Bk54WrIFsbnDd53Uh_Xh2-XBw-H0k7E_Gg&oe=69FDE7A4"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mJi5u700Z0Q7kNvwHdkSFG&_nc_oc=AdroA3ydhiWlWRZr1EbqBn25RRShZjgbwI5JrZkXMjKLB96yVmupqQ5YUzsvSVss9iE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af618Vtqxzgjpc_BPNp7OK9ViNFGC497DZllPH3SrDbwMg&oe=69FDE502"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9fyMSMaaZIQ7kNvwFoXavf&_nc_oc=AdoIkjflHNcSUhW7noB82R26Yiv3mgdeLTmOh3Jehp_2OicwT4DzGPqo4cW-lWW07zk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tZy9raxo-GzyPgIgVJI7hFPJK9sWl4zoIc1dPoCyrdQ&oe=69FDD957"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojaVLFddVwYQ7kNvwGAPZNu&_nc_oc=Adp_uHWQu-f7Me6wjIhAa9BpMv6UX8B6LZQsCbBNqtGjEAOIFVQs-YvT9yBm7KbaVMU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_H-j4fVKB7JQbTiST2Nshr4DrGs2nJDUMNGxW1dkNdg&oe=69FDEFA5"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaLFboEyXBUQ7kNvwGMSwCa&_nc_oc=AdpaKx-IKW816SLPOMktZYan7YQh_kQMBQT4ayc4p50gEMJIGIbSE7xBZ_-t_sf0_fE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IH89_uvkg0eIZcgTnY7_3l6G7De42gHKgpK6_5Z3FbA&oe=69FE028C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "support
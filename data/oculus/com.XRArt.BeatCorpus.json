&_nc_ss=7f20f&oh=00_AQDv2QPrGSqVGfOUqMrbUe1Jmpej3kxji9O-pQqm-2gNnA&oe=6A48FED7"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTP5Jnf4mS4Q7kNvwHCe-ZG&_nc_oc=Adq5uFWrXKq0wePxgNZLCCPYu_s3mFfD_EomWS6H98Or_v38I81AyH_YJ_QKTfgEw3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmjBQEYwTLo4fFomuSxg0EmGpJJrW9IEaBEmI0vzTtmg&oe=6A491525"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEsUmaTBZ68Q7kNvwEh_kCW&_nc_oc=Adpgy6LOoqp9NhWI9pLuWCIMXapeSt6fbYUxKXQOguenhEv3hEENrOtjp0DMWVtC90I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeVtNsjFU5-AAiJgopPD5oTx3Vf_Lr-UNf6Yvhvg5tSg&oe=6A49280C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9633926003338483"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_605338945482422_4334034414798206429_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbdTegZ0T60Q7kNvwH3b35T&_nc_oc=AdqJCnLl7ynsULnyTc6G4GSeQO0LWllesJab9rlYCc914V3qI606Ivk2NRl4lNn2UE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxLdnVatTcpJtHhRrsw6S03yq84_BJiisbkyZIyIxZpQ&oe=6A491816"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BeatCorpus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context
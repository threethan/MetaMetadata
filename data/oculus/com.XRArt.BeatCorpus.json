k2rJ1JZF9dAJP-FddWdDWOwhD4b8eFB7eNZAZXSkjDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_SQxtI_tQlCK3C5QDEzVe6YllJZcJgYdBp_xcSN2StQ&oe=6B0DA697"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gTntng25B4Q7kNvwG51SWQ&_nc_oc=Ado9lJaKXI24Do94D6vtnKZKNE0sgOCd8VgKL8dsgKTjD9cHEF1xB2hFqyvA9xRCLk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRF-SufRuuu_2HVYrYnrXhLxI2FUlYvLzjK7X2N7CKHyA&oe=6B0DBCE5"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvMWetff9IcQ7kNvwFzjOuv&_nc_oc=AdpmUB4OTbE1bymp8D8qaP9vqniE5Az20zqi2bZFyY-HC2K8AXsQb8cCEZJ7LvgCy4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRE0XuFEQXOzgFy3GYumuNSdp5E8-cOBiFEyumvnDBsJw&oe=6B0DCFCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9530868510310900"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1815345505920558"}]}, "baseline_offer": {"id": "1815345505920558"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738426440, "status": "PUBLISHED", "id": "1815345505920558"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9530868633644221", "version": "0.5"}, "id": "570213302503915", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fals
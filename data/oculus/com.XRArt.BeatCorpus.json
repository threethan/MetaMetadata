name": "screenshot1.png", "id": "504055162799864", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031378_504055166133197_1784207715624662017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUhfVFEdmrcQ7kNvwGzYJe3&_nc_oc=AdrsdKmQfaIaa50ib8g3sprDl6JIRS8sfYcZ9SnAOEV1kY-bPcWIwhvMQcJr43m3XXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyJaFRB-2hlRPZwdLfFu8Cc2u5SKUk0ILj1GMe-bDb-w&oe=6A90256D"}, {"file_name": "screenshot2.png", "id": "3836892209897058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75641342_3836892213230391_55603269186542008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSwiNCVjhjgQ7kNvwELfoKH&_nc_oc=AdqdRM1Y7hzohc6Lp0iL5G5Q2QhieF5pNrUB5niOZmcUd02-YONc_gr1hj_6uvD9_X4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEom-lZ6S51gZyJYhNPXcDsJ-NDOX3yQcvZylsbpRc6w&oe=6A902A4B"}, {"file_name": "screenshot3.png", "id": "1025976459571113", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974860_1025976462904446_8335510565936844776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzkPxCJfB1kQ7kNvwFwYO2X&_nc_oc=Adp8c0fPqFDDVUWk_FJ-2tssHSLVBe93JoIHY8uvyHomeHUbqJ80mi68K7nTSnTUvvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdWushfWfvO1eIMp0M7vanDbiWiOv5T9BsrVVdTEpGTQ&oe=6A9038B8"}, {"file_name": "screenshot4.png", "id": "1147275743748493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031577_1147275747081826_3155684496091330574_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NilEn4-U9fQQ7kNvwHFw-uf&_nc_oc=AdqHRgIOjWWOtbpxverV-T2fYsNBITJ8qky6w2gdEKBfuzOXZeWtuMLnSgkCb_KOrhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQaVdqABaWR79AwR9bcDLmrC72NPn8HFcHs62cI5zSFA&oe=6A90363F"}, {"file_name": "screenshot5.png", "id": "471053949115541", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001733_471053952448874_3202784361879606422_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhsS5lnvZXwQ7kNvwESNgRm&_nc_oc=Adqu-7SjuJp_smpac7Oao2QDtuzUHUQy1ig1aFKq3RrnmgUo0X_lpSMggIlHdai6niU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzxwSAQ7kakzmQi-3gVZmSeWoVaIJRkJGLN2RsWr9zEw&oe=6A901A97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\ube44\ud2b8\ucf54\ud37c\uc2a4", "keywords": [], "long_description": "\ube44\ud2b8 \ucf54\ud37c\uc2a4(Beat Corpus) \uc18c\uac1c\n\ube44\ud2b8 \ucf54\ud37c\uc2a4\ub294 \ub9ac\ub4ec\uacfc \uc2a4\ud1a0\ub9ac\uac00 \uacb0\ud569\ub41c VR \uae30\ubc18\uc758 \uccb4\ud5d8\ud615 \ub9ac\ub4ec \uac8c\uc784\uc785\ub2c8\ub2e4. \uc5b4\ub9b0\uc655\uc790, \ud53c\ud130\ud32c \ub4f1 \ub2e4\uc591\ud55c \uc2a4\ud1a0\ub9ac\ub97c \uae30\ubc18\uc73c\ub85c \uc0dd\uc131\ub41c \uc74c\uc545\uacfc \ud050\ube0c\ud615 \uce90\ub9ad\ud130\ub97c \ud1b5\ud574 \uc9e7\uc740 \uc2dc\uac04 \uc548\uc5d0 \uc7ac\ubbf8\uc640 \ubab0\uc785\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\uc2a4\ud1a0\ub9ac \uae30\ubc18 \uac8c\uc784: \uc5b4\ub9b0\uc655\uc790, \uacf5\ub8e1, \uba85\ud654 \ub4f1 \ub2e4\uc591\ud55c \ud14c\ub9c8\uc758 \uc2a4\ud1a0\ub9ac\ub97c \ub9ac\ub4ec\uacfc \uacb0\ud569\ud558\uc5ec, \ub3c5\ucc3d\uc801\uc774\uace0 \ubab0\uc785\uac10 \uc788\ub294 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\uac00\uc871\uacfc \ud568\uaed8: 5\ubd84 \ub0b4\uc678\uc758 \uc9e7\uace0 \uc9c1\uad00\uc801\uc778 \ud50c\ub808\uc774\ub85c \ub2e4\uc591\ud55c \uacf5\uac04\uc5d0\uc11c \uac00\uc871\uacfc \ud568\uaed8 \uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uad50\uc721\uacfc \uc7ac\ubbf8\uc758 \uc870\ud654: \uc0ac\uc6a9\uc790\uc5d0\uac8c \ub3c5\uc11c \ub3d9\uae30\ub97c \ubd80\uc5ec\ud558\uace0, \ucc3d\uc758\uc801\uc778 \uc0c1\ud638\uc791\uc6a9\uc744 \ud1b5\ud574 \uc9c0\uc2dd\uacfc \ud790\ub9c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\ube44\ud2b8 \ucf54\ud37c\uc2a4\ub294 \uc544\uc774\ub4e4\uacfc \uc5b4\ub978 \ubaa8\ub450\uc5d0\uac8c \ub3c5\uc11c\uc640 \ubc30\uc6c0\uc758 \uc990\uac70\uc6c0\uc744 \uc120\uc0ac\ud558\uba70, \ubbf8\ub798\ud615 VR \ucf58\ud150\uce20\uc758 \uac00\ub2a5\uc131\uc744 \uc5fd\ub2c8\ub2e4.", "short_description": "\ube44\ud2b8 \ucf54\ud37c\uc2a4\ub294 VR \ub9ac\ub4ec \uac8c\uc784\uacfc \ub3c5\uc11c \ub3d9\uae30\ubd80\uc5ec\ub97c \uacb0\ud569\ud55c \ud601\uc2e0\uc801\uc778 \ud50c\ub7ab\ud3fc\uc73c\ub85c, \uc5b4\ub9b0\uc655\uc790\uc758 \uc2a4\ud1a0\ub9ac\ub97c \uae30\ubc18\uc73c\ub85c \ub9cc\ub4e4\uc5b4\uc84c\uc2b5\ub2c8\ub2e4. \uc774 \ubc84\uc804\uc5d0\uc11c\ub294 \uc0ac\uc6a9\uc790\uac00 \uc9c1\uc811 \uc5b4\ub9b0\uc655\uc790\uc758 \uc5ec\uc815\uc744 \uccb4\ud5d8\ud558\uba70, \uac01 \uc18c\ud589\uc131\uc5d0 \ub9de\ucd98 \uc2a4\ud1a0\ub9ac\uc640 AI\ub85c \uc81c\uc791\ub41c \uc74c\uc545\uc5d0 \ub530\ub77c \ub9ac\ub4ec \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n\u201c\ucf54\ud37c\uc2a4(Corpus)\ub294 \ub9ac\ub4ec\uacfc \uc9c0\uc2dd, \uc2a4\ud1a0\ub9ac\uac00 \ubaa8\uc5ec \ud558\ub098\uc758 \uc644\uc131\ub41c \ucf58\ud150\uce20 \uc9d1\ud569\uccb4\ub77c\ub294 \uc758\ubbf8\ub97c \ub73b\ud569\ub2c8\ub2e4.\u201d\n\uc8fc\uc694 \ud2b9\uc9d5:\n1.\t\uc5b4\ub9b0\uc655\uc790\uc758 \uc5ec\uc815\no\t\uc5b4\ub9b0\uc655\uc790\uac00 \ubc29\ubb38\ud55c \ubcc4\ub4e4\uc744 \ubc30\uacbd\uc73c\ub85c, \uc2a4\ud1a0\ub9ac\uc5d0 \ub9de\ucd98 \ubbf8\uc158\uacfc \uac8c\uc784\uc744 \uccb4\ud5d8\ud569\ub2c8\ub2e4.\n2.\t\uc2a4\ud1a0\ub9ac \uae30\ubc18 \ub178\ub798 \uc81c\uc791\no\t\uac01 \ubcc4\uc758 \uc8fc\uc694 \uc774\uc57c\uae30\ub97c \ubc14\ud0d5\uc73c\ub85c AI\uac00 \uc0dd\uc131\ud55c \ub178\ub798\uc5d0 \ub9de\ucdb0 \ub9ac\ub4ec \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n3.\t\ub9de\ucda4\ud615 \uc6d4\ub4dc \ub514\uc790\uc778\no\t\ubcc4\ub9c8\ub2e4 \ub3c5\ud2b9\ud55c \uce90\ub9ad\ud130, \uc790\uc5f0\ubb3c, \ubc30\uacbd, \uc2a4\uce74\uc774\ubc15\uc2a4\uac00 \ub2e4\ub974\uac8c \uad6c\uc131\ub418\uc5b4 \ubab0\uc785\uac10\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4.\n4.\t\ub3c5\uc11c \ub3d9\uae30\ubd80\uc5ec\no\t\uac8c\uc784\uc744 \ud1b5\ud574 \uc2a4\ud1a0\ub9ac\uc640 \ub9ac\ub4ec\uc744 \uacbd\ud5d8\ud558\uba70 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ub3c5\uc11c\uc5d0 \ub300\ud55c \ud765\ubbf8\ub97c \uc720\ubc1c\ud569\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "tr_LogoBeatCorpus.png", "id": "3567053780267444", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982480_3567053783600777_8213747801081039316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6DKb6HKNwMQ7kNvwH52TVQ&_nc_oc=AdqUf5f9olgFNRgdcADng03Ft4Hloi9Oh35rOnAQ0SjAsJrimuNKQH0ZdxqlBMEldkw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSh62UVHm4TUrJeDavDD_a_HiJBq2IvXqxKj9Da06FRA&oe=6A9011E3"}, {"file_name": "[\ud3ec\ub9f7\ubcc0\ud658]BeatCorpusIcon.png", "id": "1767336497454756", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974913_1767336500788089_7908135678038564213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_fD9iCr87YQ7kNvwHya2Rr&_nc_oc=Adqy5fwaj3Rw-njaG7_quAPCkR79XTK5MWmlYprazCm2N9MBuCBqjJYtVaInyCasguw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFM0qRyMX8gNsOKM5f-0TtXt9FOLid9U1pHDAb1dKCRw&oe=6A901E02"}, {"file_name": "ArtCover_1080x1440.png", "id": "1184581173408648", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75520131_1184581176741981_11197673817713959_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnP3D-QAEnMQ7kNvwEixA2l&_nc_oc=AdrpQ7LZUfokf4pnB-mOZJ-2_JtPJ5M6ZdmHC5KplsdtqFkQ9I5XL9zk4zVuI2IX1bw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd4Bq5qibo7LmVBLyMHpvE_1EM-hLRuNoLT33-gQiJcg&oe=6A902657"}, {"file_name": "HeroCover_3000x900.png", "id": "1164670238565242", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57575352_1164670241898575_5876008033631265344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOi6AifJEoUQ7kNvwHcx-JU&_nc_oc=Adqv5ti4FpxkCDRoq1Ugg4fBTDEVuTxWNyGG5W91X87nYAJ3nVMVvrH4RF_FMR821X4&_nc_zt=3&_nc
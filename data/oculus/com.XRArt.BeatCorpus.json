n11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xh1tqpf67u5N0NJqTO75fXRlLKdg6gE1rvFp0EKywPA&oe=6A22D1A4"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ1FrhUe7CgQ7kNvwEYpprp&_nc_oc=AdpnEQVMKAaYUyP_XLy43M2IaJeLb88UEG9C_zy_Ay8WJywDRSYzYibMoyGaFcWoubg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q5EI02zPkIl7_KIOsoxhRTNwy-3T62kGkhEB5Q5FapQ&oe=6A22CF02"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ_PODzEHLEQ7kNvwG-t__K&_nc_oc=AdrKwpvEBAnEWRGwG73XKMVVznusNjc0U7YN4u0-V1Y0Q2jZq-tIseCP-1RI8p4pVyY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pfM2wqrwoaOM3V9sDsju0h3EL9hAW6Dy28aSvuadSiA&oe=6A22FB97"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhDTthRU264Q7kNvwGgUfea&_nc_oc=AdpZMU_Cw91_iWy9FBMNdF3TL1D248Y8SELHcxQVx84loN1ZwqCmNL4l9nOYE0J_iaw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ciawl6KhANMsXIcRIH-Yzlsxg6P8SKyv9ZNc3HjMoOg&oe=6A22D9A5"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm2dQjyL0kIQ7kNvwGnwQ_I&_nc_oc=Adp2d2vhqyggfF6GrK0H4P-rxPURsYDbX9C0qDpdpuKroAciBj9Px9N9hdp6IOrLdi8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-__3ovp6LlGixiZGT_-aEs5-uK_j4pZQuInqyJgTrUew&oe=6A22EC8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
0f&oh=00_AQOKC9H_ABnoN6oE-EGhiYjWyiKeWNOYuiyUkYdqgIMZJA&oe=6ABFB424"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti26fUsQK1sQ7kNvwF0q6IH&_nc_oc=Adr5kEPEyf2fglqnfVXoUXw1uFaAnXyWYyrhG4a7YCzCgjdduIsXuSRLAy6Ggnlbzls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO54y4daOdB7aIAM-BaiD167y0ODef_TXHzF-9JdXgUnA&oe=6ABFB182"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0xUl_v-GY8Q7kNvwGFbjc1&_nc_oc=Ado8UNrvj56d7WTyz9-obOPl4mo1hxSnvHh_0uIlVRvv1x8-fnIHabGMHaZ-O3MU5GA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyx4Lls6ey3ueuXZECWqPduzV_0rbRCV8esO7H4NinJg&oe=6ABFDE17"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnqm1WcP2UsQ7kNvwGKNOaN&_nc_oc=AdqtvKE0xb-u7rFMK65EMEFBnX3FMZEUndjBVeJlLI7-gSm3HMGcfqJwsLahVQ1DYsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMLour2a7e2rgq8X8unW82bMA6vpOd73hgDceoSxMi9A&oe=6ABFBC25"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fJcZdQFt2EQ7kNvwEYnzsx&_nc_oc=AdrIIwU8nVC48Sw_M6mx1C4gAKFW1yybexNJCleYB6l0txyVwSRla1drwafS-WXEB-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj-yQ4Fa7x1Y-WsAOA3htqXGYvPiYA157lbyYRzCDFwA&oe=6ABFCF0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "support
0f&oh=00_AQPvLtKOHoZaHUF4tQPlHk8SCKhEkD900gEaDGkzpKvmBw&oe=6ADCB524"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq-EqlW10ngQ7kNvwFa7lLD&_nc_oc=AdrGfcWcVzJ6p_7KWF6PtulDNrXhIcV2Zq7z1QAbQmpC3e3R7algOK9ifYdK-PUnewo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzgY0fn6WUYA2_XzJw4f---7nWpte-U1IZIGWyv8LdOw&oe=6ADCB282"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOSSbNMzR9cQ7kNvwHb5fUD&_nc_oc=Ador7sT0cloM5jWsG8cC1oA-j0I9b_qYS8C9TpR3-UIoBJ-ZcK0oaeUwD8ahZEqMJ9I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ-GP5okqMWgTHWl8rqi_OL8lMSqV_koQNTThU3iyJ9w&oe=6ADCA6D7"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtViC2sSYrIQ7kNvwGR2UK2&_nc_oc=AdoKXS0gw-rrmYEjUqmrtys--phbeU_h8qFb1GjvrZVty3zRJqri-Qd2-wl-Yo13-zE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5oG1KGVgAcyrW39WO42SZZPg9No2RAuQkGul9hRyyww&oe=6ADCBD25"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LpIHwzzeC0Q7kNvwECAYIF&_nc_oc=AdoczDQWHTPuJgYmy7RaOWYzDblXFHdxnW1i4A2CFNUn4tBlkCo60Ba4w2YHZppATJw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFfdTTZ1m1teztcyube38mywqBi53PIUepcv5c4aXamw&oe=6ADCD00C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "support
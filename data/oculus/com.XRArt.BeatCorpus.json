A0s1jnnm5GRrpYoaTk7pLmwp1kxSrSg2pXhymYr-d_lLFZ6MXGbnzODFaUqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOZgb3lPa0KdiFAgCQfQ0o_q1VO9zINQ1gJMjPawrLLg&oe=6AFC8EC2"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI4EjKp7zawQ7kNvwHyRG13&_nc_oc=AdqWYXFOCgF2-WTXe47E8GosRPpdyGKODS7IL58wcZI0m8NiGEFt_VAasSBmbr8Xo7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8gh2FsPv2Z1TR6II94Uh1pkAp3yTXG-IkKcqZPrXC0g&oe=6AFC8317"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWmvy675Bl0Q7kNvwGkLk2S&_nc_oc=AdqmVIf_JFWELe9oQFxOXh_hNrZD0W2x14mI4j2AqObadcN5HMZB4-8DR1DGJM_OHAg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaa3inXcaadBRYR5iSUnh9cVjrZFsGXC-fQ6f55PpdcQ&oe=6AFC6125"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI29TZjhkFgQ7kNvwH_znon&_nc_oc=AdohaxPvJKZOqBITyN6oQK18ctUTj_2rgg-9-Qv4OpHtNfxqm-6qajUDe9G9QAjpgCg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1_A2DhVkRwHUiLdak7ENhqCX-UZZ6FVwLwbZNJg3VoA&oe=6AFC740C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9633926003338483"}, "review_messages": []}]}, "cover_square
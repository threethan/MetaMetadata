0f&oh=00_Af50CNb0XuO8NvTa6KPLOTHDmFaE3hWlodP86utNFY0EHA&oe=6A16F424"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dUjT6GPwKkQ7kNvwEv6_bp&_nc_oc=Adpnw89H_UoayL0QlEJ5JCeOz2QhVR12qDXbSkbwU9gf7FLkE07FlVlc5YTWE-DYMz4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u6xB8ERxnDXNbSso2LS0zbo7zbuW-MRpS_SNkQWQUug&oe=6A16F182"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsnZ5Gnf2lsQ7kNvwG_SSxw&_nc_oc=AdrWmjU80Rms5Q2MoQnj-tApfEiaX5Zsgi7hV31MCt7wxZNANdTnjI9TB402xUdJwLw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cCE3Ub0Nz3sVqr-gZcrnUpbIx1BTm5psOACYWLOLHBw&oe=6A16E5D7"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaYMFeEIwlQQ7kNvwG_rbTo&_nc_oc=AdpPxqvoG_Ou1f3RJEAkPIj2iHyNA0qNhHA1VhDYDzP1ipHljbtUzm450Wz7af84XQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Noo2WI3olDxl5bM3bqUdU7rwkyIKazc1RNbOckBN5KA&oe=6A16FC25"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTBrA4A6F7QQ7kNvwGAlIas&_nc_oc=Ado9DCB7R_strG5_6AsLYAxyXqih2jSEovllslRlpPOJShyReYfvstzy5k7HISdwork&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65TVbFH0DIiam6NMMeNUMxD2sh7A3oU_MtNTNJvCwlZA&oe=6A170F0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "support
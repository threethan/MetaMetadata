0f&oh=00_AQKIT8Gr2vDJ4c4pa4I5UrSYduHmJKXS8HR2l4CjmfOPfQ&oe=6A9C1BA4"}, {"file_name": "screenshot2.png", "id": "586842810723679", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641342_586842814057012_5423061536006985881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzZfJ9ZiGLAQ7kNvwEINClD&_nc_oc=AdqZeP_uZCSh2_qzcFuPkfCAIvPjEymKw0XzI-tynUWDs5zehNjD5x9KKFas7hDADwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcHmbqFlSDT-WIdv9wwLgGuLj_OrX7cJD2Ray56X2RCg&oe=6A9C1902"}, {"file_name": "screenshot3.png", "id": "1704119490164934", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630186_1704119493498267_6995259969759849409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uniPrOTv6ecQ7kNvwGf8x6o&_nc_oc=AdprKYH4EYggHJd9-kj9sr4HvKa_0kH5BUnAz_yYBw34gGQXIdJOh0q6nZSEhUediTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLanNySBCe1gf185sGz6OB-blkNbhh8qId10kcNVtdqxw&oe=6A9C0D57"}, {"file_name": "screenshot4.png", "id": "1678507819685526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1678507826352192_2546708466104713916_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSI8OuQwRrYQ7kNvwH3v-z-&_nc_oc=Adonhx6ruXIKiBy3sVXfvmq1DHlwSHi5h9AmMKs9cLRGwIA0Q__pkX-Ctj1pso45-Qs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN5VpSUg6N0KMEZzEDXWpyVWFq27kgvvrzDBjRQNjAPg&oe=6A9C23A5"}, {"file_name": "screenshot5.png", "id": "1304644157395190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612008_1304644160728523_8643885763428198359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70zgdq1TWHAQ7kNvwHJmiVj&_nc_oc=AdqaTfOcjFmbk1pid7N8dC8GJuTKh3YZpKmIsHyoqsOD9W0q3Nf4plt_-GLt0vf2KQk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_eu49bZPXNwzAfkZQSkFSmTfWTr2fvOsa_IktVfYvqQ&oe=6A9C368C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeatCorpus", "keywords": ["beatsaver", "lilttleprince", "rhythm", "beatcorpus", "story"], "long_description": "Introducing Beat Corpus\nBeat Corpus is a VR-based experiential rhythm game that combines rhythm and story. It provides fun and immersion in a short time through music and cube-shaped characters generated based on various stories such as The Little Prince, Peter Pan, and more.\n\nStory-based games: Stories based on various themes such as The Little Prince, dinosaurs, and famous paintings are combined with rhythm to provide a unique and immersive experience.\nFamily: Short, intuitive plays of 5 minutes or less are easy to share with families in a variety of spaces.\nEducate and entertain: Motivate users to read, and provide knowledge and healing through creative interaction.\nBit Corpus brings the joy of reading and learning to kids and adults alike, and opens the door to future VR content.", "short_description": "BeatCorpus is an innovative platform that combines VR rhythm games with reading motivation, and is based on the story of The LittlePrince. In this version, users can experience the journey of the LittlePrince for themselves, playing rhythm games with stories and AI-generated music tailored to each asteroid. \n\u201cCorpus means that rhythm, knowledge, and story come together to form a complete set of content.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://delab.quv.kr/7", "developer_terms_of_service_url": null, "publisher_name": "https://delab.quv.kr/", "support_website_url": null, "website_url": "https://delab.quv.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "support
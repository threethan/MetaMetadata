 {"file_name": "4.png", "id": "2237595140361945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293669_2237595143695278_8190139885926361803_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viVtmauoFqoQ7kNvwE-eWKq&_nc_oc=AdrvHUwx3AfNDF-AyvsyZxRCpr9r0OBkGx87xPPPu3dW9APfnqf2rOidfAauDK7XKdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBbvQVt2AyWxUUnRdfqHOpoPLUUCMgenYrcSkLMxuf4A&oe=6AC3B0C4"}, {"file_name": "5.png", "id": "2495162507613157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298281_2495162510946490_6821240917379426230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhlwWJ9xGcwQ7kNvwH5kqjp&_nc_oc=AdqXE566c2B4HKnSJ1t58D99pk5L0UTroAO8jgegeg5wvGkEcUpwjDOfkfobzoxwK1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5tVng6EsfMPmGZikV2xmEZYqcWhVUbIaa6JMoo_5y5g&oe=6AC3BEE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DEADFALL RUNNER", "keywords": [], "long_description": "A horror arcade where players build their own claustrophobic levels. Create your personal nightmare in seconds with the built-in editor, or dive into the default levels.\n\nThe action unfolds inside a dark, cramped labyrinth of towering walls linked by ladders across multiple vertical floors. Dim lighting, unsettling sound, and constant pursuit make every corner feel dangerous.\n\nDig through the ground to trap your pursuers, climb to escape them, and grab every skull scattered through the maze. Once the last skull is collected, a hidden exit appears somewhere in the labyrinth. Find it before the enemies find you \u2014 because they want their skulls back.\n\nFeatures:\n- Build your own levels in a fast, intuitive VR editor\n- Multiple ready-made levels to play right away\n- Vertical labyrinths with ladders, bars, and diggable floors\n- Trap enemies by collapsing the ground beneath them\n- Atmospheric horror: dim light, tense sound, and relentless pursuit", "short_description": "A horror arcade where YOU build the nightmare. Design claustrophobic multi-level labyrinths, then survive them: towering walls, dim light, unsettling sounds, and relentless pursuers. Collect every skull and escape - if you can."}]}, "developer_name": "NIKOVR", "developer_privacy_policy_url": "https://nikovr.com/privacy/deadfall-runner", "developer_terms_of_service_url": null, "publisher_name": "NIKOVR", "support_website_url": "https://discord.gg/6Te6gfYx6q", "website_url": "https://nikovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1091853357034862"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1598489368686373"}, {"status": "PUBLISHED", "id": "1931872598116494"}]}, "baseline_offer": {"id": "1598489368686373"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789702140, "status": "PUBLISHED", "id": "1598489368686373"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1092152257004972", "version": "0.1"}, "id": "2488231545014185", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1091853343701530", "is_concept": 
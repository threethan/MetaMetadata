nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzBxUSZAJQHVADIsuCB4yMAkqesgUNN8-7tN9AiWG9sA&oe=6B0C68AE"}, {"file_name": "3.png", "id": "1742184903459062", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302344_1742184906792395_4319153997883957112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRAKKe1mkowQ7kNvwHveI0u&_nc_oc=AdrhxOmZyrWt1CKk1p6FCxftkWRg4Q32H0SV0-yFqiTvRtx9uQfpGTQE_24lppcVa4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjntSxy_VvV5NzPBpmj5mQEhpea0Z9Ex0voRRTRyVDMA&oe=6B0C7FB6"}, {"file_name": "4.png", "id": "2237595140361945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293669_2237595143695278_8190139885926361803_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7DB_OEmyzwQ7kNvwHPMlD7&_nc_oc=AdoufvC6yyKOhbTaKk021TSB6WCrAV1_CHXR3wljjWLpx1SLksIj9EGW_JNRoSiFavA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0ey0QUWnnlRx7e-CxpwV32vRtyC1mNLn0utL9Xy8zow&oe=6B0C6B84"}, {"file_name": "5.png", "id": "2495162507613157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298281_2495162510946490_6821240917379426230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeFX38YdD1QQ7kNvwFx2K4b&_nc_oc=AdrAiu1NJe28lT5SK0rxXgK0_IvRYuZ8xysEhcpp47xd5ciW_d1qnzaXHzP3OxzGK7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMDe9E52I6VxZ56iTb-rkJS2y1HT2uIbUOwtas9oVwcA&oe=6B0C79A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DEADFALL RUNNER", "keywords": [], "long_description": "A horror arcade where players build their own claustrophobic levels. Create your personal nightmare in seconds with the built-in editor, or dive into the default levels.\n\nThe action unfolds inside a dark, cramped labyrinth of towering walls linked by ladders across multiple vertical floors. Dim lighting, unsettling sound, and constant pursuit make every corner feel dangerous.\n\nDig through the ground to trap your pursuers, climb to escape them, and grab every skull scattered through the maze. Once the last skull is collected, a hidden exit appears somewhere in the labyrinth. Find it before the enemies find you \u2014 because they want their skulls back.\n\nFeatures:\n- Build your own levels in a fast, intuitive VR editor\n- Multiple ready-made levels to play right away\n- Vertical labyrinths with ladders, bars, and diggable floors\n- Trap enemies by collapsing the ground beneath them\n- Atmospheric horror: dim light, tense sound, and relentless pursuit", "short_description": "A horror arcade where YOU build the nightmare. Design claustrophobic multi-level labyrinths, then survive them: towering walls, dim light, unsettling sounds, and relentless pursuers. Collect every skull and escape - if you can."}]}, "developer_name": "NIKOVR", "developer_privacy_policy_url": "https://nikovr.com/privacy/deadfall-runner", "developer_terms_of_service_url": null, "publisher_name": "NIKOVR", "support_website_url": "https://discord.gg/6Te6gfYx6q", "website_url": "https://nikovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1091853357034862"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2026126028053324"}, {"status": "PUBLISHED", "id": "1495132342539
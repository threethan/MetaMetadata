XFmejhlgIu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQclp4kBWYkIg-2woRycxW1isPCc_9XVRA2hjwH1ujw2w&oe=6B006C0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1234 (1).png", "id": "1608511106794258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296388_1608511113460924_3498293566838355922_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4HNtG76Dn8Q7kNvwFl9Dpt&_nc_oc=AdoGPjhjDs_FEss0zKAzJVZPewoBzeap4tFlv5-wgCALnfimrGXKUfYChLVkmhRh-XE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0dLdv1KeE1P-GfBI2gi2iXiUBf9vnmTX2YyBjAq7-HQ&oe=6B007363"}, "display_name": "Clumsy Crew", "keywords": ["Platformer", "Physics", "Clumsy", "Casual", "Fun"], "long_description": "\ud83c\udf89 Welcome to Clumsy Crew!\n\nA physics-driven platforming adventure that spills into your real-world environment.\n\nTake control of a wobbly monster whose every step is equal parts goofy and unpredictable. Resize and reshape the game environment in Mixed Reality to fit your space as you jump, squish, and stumble toward the finish line.\n\n\ud83d\udc5f What to Expect\n\nBounce and tumble through colorful obstacle courses filled with moving platforms, hazards, and surprises.\n\nSquish silly enemies underfoot and giggle at their squishy noises.\n\nGather coins and race against the clock to beat your best times.\n\nResize the entire game world to fit anywhere \u2014 from your desk to your living room.\n\nEnjoy lighthearted, slapstick fun with physics that keep every run unpredictable.\n\n\ud83d\ude02 Clumsy by Design\n\nThis isn\u2019t about perfect precision or razor-sharp control \u2014 it\u2019s about:\n\nHilarious, physics-driven stumbles\n\nCheery, cartoon-style chaos\n\nThe joy of seeing your clumsy monster somehow make it to the finish line\n\nAre you ready to join the crew and embrace the clumsiness?", "short_description": "Jump, tumble, and laugh your way through colorful obstacle courses as a wobbly, physics-driven monster. Squish silly enemies, collect shiny coins, and race against time in this lighthearted Mixed Reality adventure where you control the size of the entire play area to fit your space."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/clumsycrew/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/clumsycrew/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31805240542454646"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1335232425236686"}, {"status": "PUBLISHED", "id": "4280920688829401"}, {"status": "PUBLISHED", "id": "945996577754769"}, {"status": "PUBLISHED", "id": "1108593647847112"}, {"status": "PUBLISHED", "id": "1862954627766020"}, {"status": "PUBLISHED", "id": "1322040092832777"}]}, "baseline_offer": {"id": "4280920688829401"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780513200, "status": "PUBLISHED", "id": "1335232425236686"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31850274781284555", "version": "0.0.2"}, "id": "1157694996248051", "channel_name": "LIVE
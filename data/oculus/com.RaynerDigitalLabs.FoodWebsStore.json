n.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS3Rt0jEAzsQ7kNvwEOTJkW&_nc_oc=Adkq4b6Qwxwot9pcH50XJZDEIrToXuHqGTCT-TDDslg1FmtbYb20J9KHPvn8bQ0lPJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTlmlwlaGQC5BhQq98QhFhCQ_uNk2Dd1Ureum-gu-GXA&oe=6999A2FF"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnRSSzXfGwsQ7kNvwG0HdUX&_nc_oc=AdkhTW5O8hHiy51xa9n399IHvm87Ze2qvsD-TjuOotYeUeTji3Tw_Ae0Tn_WI5EXdaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft0CUd0fAov-2Ppy9YXWLfaOGhRgNhgQQo3J4vN-vLBeg&oe=69999D0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through nature in an engaging, hands-on learning experience."}]}, "developer_name": "Rayner Digital Labs", "developer_privacy_policy_url": "
"}, {"file_name": "Screenshots4.png", "id": "1269803984859190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_5SjDEuRW4Q7kNvwH7CfM-&_nc_oc=AdrGcbDMBfhy6FgDhoJrCfquUqtasWSCbhTIGUnAGjkxHVLgBKIsDnPjW2qRz4e6AeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ql1FyDe9v1OkQ32jziircfZYFK5SCPbkbC6soyOCfAw&oe=6A29567F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBoZv64c_4kQ7kNvwE3Wxfr&_nc_oc=Adr11iUwk7L6XcHAgBWbOtjXa9Dr2y2lpNSqsGo96u6VH207YoMZg6y-E_I9fwfwAhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B-vjmWsDarWCgDfnz4OYsdrGsTewA7Cx2XMC24lwkCA&oe=6A2988CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through na
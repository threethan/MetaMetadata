n.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLXOobW2BrkQ7kNvwHy77eB&_nc_oc=AdmvWg00uQWpl_l9iKGsSALpYmBIF0-8pEQsji7YlBMXTh-oALWAJF6c0lHq6P0XoQ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftXnXeLlRtj40lmnzrPRba0FZ5_ZAdpWClBSt0nrLH-9Q&oe=69A5807F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQ7nNTnpDEoQ7kNvwEC2Qbl&_nc_oc=AdmWjNBeMaiHGntmnU7sFNI7XC9PVEhp67RSNwKa343soNt28dkL-5mAR22BVloseP4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvfWli1zrCRCGCCVxTszrc3dwOZnMX3pO7wxP3zMLExkw&oe=69A57A8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through nature in an engaging, hands-on learning experience."}]}, "developer_name": "Rayner Digital Labs", "developer_privacy_policy_url": "
n.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5-avm3Pd0sQ7kNvwHOnziw&_nc_oc=AdkS9xrNTHP2nmaIEwbJ7SRmx_AQDQjR9kNOhlFqQQFoBmH5_j0jfKKy8jqDPjQiAlo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsi8FP3M6saGSM8x-SVxqwse92o59dneZzl_NOgk2kFGA&oe=699D977F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzYHSeDJc6YQ7kNvwGg0fMh&_nc_oc=AdkarGmzgGpyWa4a7T-Yw_ppFM-pwoWzcLhqsaMvgSfxjmIxj5d6g0AOcuHj5fgLLBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufXiW9oRBQnFCVUUdU7LpIH86n1Lb37fqkW4PpeCDX6A&oe=699D918D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through nature in an engaging, hands-on learning experience."}]}, "developer_name": "Rayner Digital Labs", "developer_privacy_policy_url": "
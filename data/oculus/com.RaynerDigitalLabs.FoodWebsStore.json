"}, {"file_name": "Screenshots4.png", "id": "1269803984859190", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKoMzi2VqDMQ7kNvwGRRFjM&_nc_oc=Ado6AKGfGb11Mb2tem9lx8Q6bnEWUAp4CB2Td8mvSkLZmh4wWCVMD-rI27K5pU_PI1g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGX05dccmd54wrc1bdE3bqMGQge4n0KtSF16x42NDf5Q&oe=6A88427F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcJtmLvjaeEQ7kNvwG0Jo26&_nc_oc=AdoH8RbJlG6Np2ZFC6IrVE_WOiFOh73f9KrXnUhlFHm_JXOF1lJSQRs887O9fT0NZ1Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGssJ21rWNaUsZe-HQiInt1emcLul2ie6qu16Yw69w7kg&oe=6A883C8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through na
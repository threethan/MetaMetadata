"}, {"file_name": "Screenshots4.png", "id": "1269803984859190", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeSM7wTIsp4Q7kNvwEiOIk3&_nc_oc=AdqaZ4CHODiheb_Bh8OEJZs2VPbgtLl5i8LCyWZA17U7DgVbMu_nPq9mYKRG1IZcFXQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6EjQ35MwN5fEsutAC7jOct0ikX1LoCCB1q70wuVT5KQ&oe=6A9FFD7F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEuYDXn0fTUQ7kNvwEV3i6r&_nc_oc=AdqcOmsn5CUO1-ipoStVwanIKeoJVmrP9x1sUNrjgVWaQVQH8G-1_NI0LGyIXM6Iug4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb0ZZIp1EqlZSY4dD5J6-7hfmjKM9bjWeIENZv5cHEXA&oe=6AA02FCD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through na
"}, {"file_name": "Screenshots4.png", "id": "1269803984859190", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80EvTJY2vF4Q7kNvwHjhEyv&_nc_oc=AdqmSfQDVXyyx5fbLR5DYrBSXLug-kKtPl4FshBOg6y6ikjIVeeEcpQiuqfS-vB5ioI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_B9MIMZilnDStRQA9-8DA9aCyhCBu7xDmcwidnZUrYQ&oe=69E76B7F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhnypCcGdKMQ7kNvwHI1FQk&_nc_oc=Adp7kG0Z_MOxAULHfSGBhQQy5spCH0tAwetIE_RX5v4LFqIxqy44gzru7Tj3603PKqo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gxZxE3qEclEmeExyHak30-zqkoSRE44mkCgqACwvzNw&oe=69E7658D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through na
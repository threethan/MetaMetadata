NvwHHNmfp&_nc_oc=AdqNsnn6FFLqmLrWhxPZ4JINBunjreKI1ORDCu7zjZImWAso7p8hmHhLhgI0lbURDkE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEwFCPlkWSeP6cYrF874ns9thAl09BXfuRdgj29f871A&oe=6B09B2C3"}, {"file_name": "Screenshots4.png", "id": "1269803984859190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdkMmqlSs-kQ7kNvwHrbP2z&_nc_oc=AdrMNRN8OOfREsWpAUvF_PFpQJzDtOoQuctycmc9hWY9jgqT_E0t-zsKs7YkNex2Mmw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPFifYI2Af4QyK-t8QLCIysvmjQTT-8Ld_5blW2W99_w&oe=6B09ADBF"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBenrBexmioQ7kNvwHSR6Yi&_nc_oc=AdrPo1wSeSUo0F9BS7_VokBGUEStn3XRqHAa5cLWiEsZdfF-XxGMJQ4WxwzxWySo8co&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkwU7MeukYECvDaXziEKas0QzfBKz0J4vOVNSlfq1n_Q&oe=6B09A7CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through nature in an engaging, hands-on learning experience."}]}, "developer_name": "Rayner Digital Labs", "developer_privacy_policy_url": "https://www.raynerdigitallabs.com.au/_files/ugd/3e48ba_7446c3becb1b47b3b70d95ced14393d0.pdf", "developer_terms_of_service_url": "https://www.raynerdigitallabs.com.au/_files/ugd/3e48ba_cd6d3b3cc0074520a904a888bc0157fa.pdf", "publisher_name": "Rayner Digital Labs", "support_website_url": "https://www.raynerdigitallabs.com.au/", "website_url": "https://www.raynerdigitallabs.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24524705867214291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618432_2647910548880189_7351819689791816849_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cTxR2eXntEQ7kNvwEx9xfS&_nc_oc=AdooV_MwbuM1WGQAP1T84GLLeuA-hjwdp5xWqNWii6KjpqbRPF4RbPgPz3rk7r-WHUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz-ioT6soL04AfmU4CN87M57xSeNuE-Qx12GygEVMkPQ&oe=6B09C39D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
png", "id": "1269803984859190", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVEOzh1XqWgQ7kNvwHEF_Bk&_nc_oc=AdlXA1MFtsE5dvAHZyltiH1SNHKZlKp4ll1hf5v3j-VLtGKO6g7UrpxRBbINWO4SEhs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfeRzYjceIrJIvL_DG6EPHVG_mz6MxsMj5FzUEkhJVbQ&oe=69BD3B7F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qH3mLXMvdAQ7kNvwEdvoHR&_nc_oc=AdmNnVZ4ZognvfVdRKNdpPhpbbzA44HilxIqJeJP_MV1y9L0BmVE78eHJpAlumN3uOY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGpdbzXP2Od85dKp9UPSqGmnMt3MeV1ibArnXj4holBQ&oe=69BD358D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through nature in an engaging, hands-on learning experience."}]}, "developer_name": "Rayner Digital Labs", "developer_privacy_policy_url": "https://www.raynerdigitallabs.com.au/_files/ugd/3e48ba_7446c3becb1b47b3b70d95ced14393d0.pdf", "developer_terms_of_service_url": "https://www.raynerdigitallabs.com.au/_files/ugd/3e48ba_cd6d3b3cc0074520a904a888bc0157fa.pdf", "publisher_name": "Rayner Digital Labs", "support_website_url": "https://www.raynerdigitallabs.com.au/", "website_url": "https://www.raynerdigitallabs.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24524705867214291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618432_2647910548880189_7351819689791816849_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaF8yZD4tUIQ7kNvwGifaH0&_nc_oc=AdnBOEGgi_EZoqkDuFAFKrO294Ed77x1Fosd2Bbz3uVX0uHcKApawGrFwHeB9QGvVPU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaedGGQZ5XyoXvgF9NhG44kjYqQ3DUPxawIAp7Jiqh0A&oe=69BD515D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Food Webs", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1761607080, "lastRevision": {"nodes": [{"id": "24504900635861481", "release_type": "SCHEDULED", "administra
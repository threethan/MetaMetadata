E&_nc_oc=AdqUVI1muVd9eHuo6T2urSlDy4cjkTfoKGekzRgxD1y9DbnZ-JgQH5la9uemwX6bn_g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jzWnWKX2Sd0kjpYm-xC18-G1lf61I3sWixgDFUSWvjA&oe=6A22FC43"}, {"file_name": "Screenshots4.png", "id": "1269803984859190", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugv3fbjXqV0Q7kNvwEf6e_p&_nc_oc=Adr7Gb5FAff85IveUabloSvh2Qt69eJZwDXi-VTUXw62pjjjkXcQ35v8B2rW4pIrrpk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z7G-TtLscREu9yRivvihMG88BAgo_psia0ghg3G5V7w&oe=6A22F73F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpYjiLquEBUQ7kNvwFAhAg5&_nc_oc=AdriW9gF6SJXTf_EVCr1RzgF3Otz4KePPWaut-ZBzQPVydBANIisNwc2UKSTwR01454&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x4Lt35SBVI_2dqAqTDBXa4-gss3wKY1P_kIp4Y1ne-g&oe=6A22F14D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_desc
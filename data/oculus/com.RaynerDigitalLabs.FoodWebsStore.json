n.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLXOobW2BrkQ7kNvwHGEABh&_nc_oc=AdmCRaJinPrGYam2hSrV6QXEwR3fCu-dgJmDeOKDMzi5rywAcxSGFBZeeJV5ah52bdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBWBJKQGtpcGSMOCezvhVDE1yoETuNjf9UjKRAhz0oYg&oe=69A42EFF"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQ7nNTnpDEoQ7kNvwG9c6-U&_nc_oc=Adlyj9hoGk6y3bUWDqZen6blqZxuouyTHVdRR9hEv7d_F7UlnPkBNrOQaWgG7dOv4Z8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs94zg6y0VZ_Nj6msbYsNrMcRoZCkqNY0y-qsmZo-Pyjw&oe=69A4290D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through nature in an engaging, hands-on learning experience."}]}, "developer_name": "Rayner Digital Labs", "developer_privacy_policy_url": "
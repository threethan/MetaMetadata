"}, {"file_name": "Screenshots4.png", "id": "1269803984859190", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619145_1269803988192523_7358506301693808216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvyVGnajrXEQ7kNvwHK5VuR&_nc_oc=AdrETxDz7LP2dkKNX8vVpr2_1v2jIK7VR7eCC37RU50m8gCrgFWHQjeRKKQEvPAixaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xfP1PSIaYlIBEpUCQb29nFAa1LlV3Q0Ref7Di7q4UkQ&oe=69E4C87F"}, {"file_name": "Screenshots5.png", "id": "1697364774275319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619594_1697364777608652_3302251479540279271_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg7E3W1vPWIQ7kNvwGfzZqb&_nc_oc=Adr2wCxNaXqVDklWfrHTCo_FdOQaJT1WCC7IytDyEdWUcMdTBttj-ontReg3a_-KwHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16zVeBoBbqVASWpUeVixS5_elcO6TyaOdGSb_5kem6iQ&oe=69E4C28D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Webs", "keywords": ["Education", "school", "foodwebs", "science", "biological"], "long_description": "Students explore ecosystems in an immersive VR environment, rotating producers and consumers on interactive wheels to create complete food chains. A virtual tutor provides step-by-step guidance, giving instructions and hints as students build and match food chains to ecosystems. Differentiated questioning challenges learners at multiple levels, reinforcing understanding of energy flow and ecological relationships. The app includes an integrated email system for educators to receive student progress updates and feedback. Engaging visuals and hands-on interactions help students understand how organisms connect in ecosystems, promoting critical thinking and inquiry-based learning in a safe, virtual setting.", "short_description": "Explore ecosystems in VR! Rotate producers and consumers on interactive wheels to build food chains and see how they connect. Match chains to ecosystems and discover how energy flows through na
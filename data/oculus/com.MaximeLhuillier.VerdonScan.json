content-lga3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bp4BaX54egQ7kNvwFQEHiW&_nc_oc=AdoP7dxIDifUJD2QWeyo7CuPQ0uHy-jkp6Sqcc5sS0GSDefxEMPPGjapoUtzxT89-qU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jZnlkO0blkDV_uG0kBExuXv_vjbeYd408U3C9FlSOvA&oe=6A0C6A3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4_14WpKzx0Q7kNvwFqnloJ&_nc_oc=Adq_ur2QlyfW3SwooQotzNlNTXOZnFeuqZfd33clbMw3Kfs4l9Vno17b_1FPw0htd80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YGfstUdn37SuGu7rf8DWAkKbXrpkFJw2w-VSnuMHuHA&oe=6A0C6AAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTBGyw_w-a0Q7kNvwFJdhNF&_nc_oc=Adr1E0lLCw0M7RxdwKKY8Zu-SG6E-cHvXa6h_PfscxnY79x5YUKuPKBagTAJ11FdSFw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-qp5BW-v5dduBDxjqMSaqzP5xFN_usltLnkcEQiTW_g&oe=6A0C87E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDFAdOEyVoEQ7kNvwGSy4IM&_nc_oc=AdqsDYVYD_MT0et8E6xQ3GwR1AFDjn-pB-KVtCL3D4zQYjjrPaiZ0UQRrweU85_j_ZY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wkCblWevm-8chPKGadzMM7L08j1xcPWLVfOIplQrM7Q&oe=6A0C5622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLtmCwx9V1EQ7kNvwHQyH3a&_nc_oc=AdpzcLnby3_PbCJUK-JiUw-tx3todXeHCXeiilYdL-Pmqt_GqV-8E64vxj9ggYkGwcI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qKq6jy-N-0A_2H6FLMedRfYHL_96BUwXmRAYoVeSABA&oe=6A0C6DD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
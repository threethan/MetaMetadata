content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr5ptQsgy3kQ7kNvwHuLw98&_nc_oc=AdqGC4Sh3qH40ig_DnnXB3EEMSDnnEwkQMQxVOIG4hxhnheq6mIqaFIU0lp1fSgHY1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV3Y-rSlg30F0Tcuo9rxetuqm835LHoKQcix9AkyPh1Q&oe=6A4D03BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0vE9RTNKCMQ7kNvwGKfMDN&_nc_oc=Adrd8gRjG5NmVIrTyqL0wVOpLRNG2au4Dac5oam_KXs-IDm4-faxosI89ZpTlgVY1ME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmIw7TSWdlWO9_BmklPmf_0m4Y6hlxFDZSOEbtgeap0w&oe=6A4D042B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdBqvyP0ijwQ7kNvwE7z7tZ&_nc_oc=AdrQuMrf7dWR33FtTej3p6Q9PTZezfXfNTU6b59oNCm1_1TXCahNmKU7Bb_EnIDFrvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuKPO-oxlfvoEDzBVgTBXKtm3J8tfLW-7znbK6S127tA&oe=6A4CE929"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcBne5PzwnIQ7kNvwEBh0_E&_nc_oc=AdrARodynJIkmfWEXCnvaKWJUGMm3CJUBi-uChpwrDnigySJu4Ur7NPiWniKVRmOyZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTYuBvPhWcZHHdXCclQc36XuXpk-GGIazyURmM0qpMtA&oe=6A4CEFA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezj-Okz-YlAQ7kNvwGPYxj6&_nc_oc=AdrX4HZLW-LSMBWwyYjwzlnp-S14bkxNvtO0F9UJ6JYQgf88Bd65pyhmi0yp1nKRA-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN8lR1pSOH56iX3gMO-68UL1quYjkCwZsBa_OdDjdytQ&oe=6A4D0757"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
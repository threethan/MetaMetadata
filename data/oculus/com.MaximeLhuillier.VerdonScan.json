248820165356", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKByvrsSC4IQ7kNvwFHWQ_z&_nc_oc=AdrH6BLJuYgZZiED_S638V1_awQx8Azw0GYFkkeBdvTmJ_ZY29yIH_ibFQC8h4YmcgA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBMtKgqtAn8mdFL4uecnugW9ypY87PQ-VxKunvrff5ow&oe=6A857BFC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HaFP0U3S0EQ7kNvwHf98nq&_nc_oc=Adpea66va3-flPjh60NHWFStRVIXvWHy1NcjfOw1c8LhImBrVkTfj26wlY8BKUtYIPw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDGCVRthkIBav_rNwIsyRk2mbDAF2REF87oWShKvWYeQ&oe=6A857C6B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waMowBhFiL4Q7kNvwHWWYQr&_nc_oc=Adp1m6PLJwIYnDndFYvteIX4pkVTLkYss_FBMnWNuonOmyGdY8JvJFAFo8_bMcFuE_I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFojKsZFq6fS6-KFAn_nJrtOKPYF50z95fqpkJgQHF_iw&oe=6A8599A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM3_JJ1nVzsQ7kNvwFj4Vga&_nc_oc=AdqyVrbHBpWtVbK3StHilTmHNbiyNdl6u2nzyh6MAqESqdknzWQE7Op5ZC9QKx0ZSWw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzNqsmt-6le4dSjtivIgWf-vYav4xhtqcGnVTaVOmUhA&oe=6A85A022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA0VHIwUJOgQ7kNvwFJu6Kn&_nc_oc=AdoyLub5WiZZ1Gf1jxDhojmeXp6WdMgNJh9FHuv2mLbYGQKIzEEbOGh4MBgQUMxsoyY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG58aWIAEW2_NC3GlB2Bz53zuRWNJlzfr_NoaGw_A2brA&oe=6A857F97"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id
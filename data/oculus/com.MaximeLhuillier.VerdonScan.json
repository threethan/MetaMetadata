content-sea5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5reUA6DWhkQ7kNvwHKnMaf&_nc_oc=AdrgqSpBJaawd1Jt6Qq8mrmIz3mryF7IyQUwNGHdU63NEQ48fGsi5vgrZA1k8b5pjIU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7de6CTFfEKREJ4i6DsiAcUD1o9nFol888R6U4TmLh0gA&oe=6A15A4BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8a5x2I_tQkQ7kNvwHHioCW&_nc_oc=AdqwCHghg4PKEgAw9D-daTH5uRsXKoDgOnODQacBThAhitk3WeI9Ge9lpPV5QC-A7fc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KlClGjWvsgOL4lpYk_g54YJ8Tpr7KEFXOa2AXAAKt8w&oe=6A15A52B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHMIh1PG-9oQ7kNvwE4HgJC&_nc_oc=AdoZvLKXNa90VeDtP16PSjgnOmtIjrf8l5A68qfy5yNiIlBSWKyX7c-PkxqCBRfbvgU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mJFhfkfPwceUORlVsoPNW_lodnqHDimlDh3NLJF2SfQ&oe=6A15C269"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro9iTyS8mLwQ7kNvwEsN-ZQ&_nc_oc=AdroPAv8yXWtpfmRAUE92MocvFHKnW7HaD_K1m9o1WdUBafAeGf2lUrEIWMIuAFnnxY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-cy4_RZeTzaDaJ8NQ9fa1coo2bqjSlPNlFAGH2wTrcA&oe=6A1590A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y82Kx2BmqdMQ7kNvwH3cSPd&_nc_oc=AdqGAerbj-nFcKdXqp801OJXAj2f1P_U88wwcWh0SXiqG5wjXPfHijLa-uFF02kkXe0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VqEgGvrSwK1FSX_0dz5ipVGSUEPJNzGnl8fitSpbHMQ&oe=6A15A857"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
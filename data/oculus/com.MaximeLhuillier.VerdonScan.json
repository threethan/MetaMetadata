content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKByvrsSC4IQ7kNvwGN09HQ&_nc_oc=AdoolghtjP4FZCOTCCtJW-Rp4Eryvxk8r9pbdkB1Ly2-G-n1MG1YTrX3EXloQAvCMc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFspjUcqYVmvkAtfPyI-g2sbN_gcnhX4gLqJT3dpmjVug&oe=6A83113C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s097SUTCJPUQ7kNvwFGfizI&_nc_oc=AdoJ76CrM74mL3O3DN9Va42xZfh-bKmreWtK1GsOVAav9KARP-GszKIxel_abo3AUpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC9nqBVTdcK-W2WMB7O6vHzdSvBmylds7glA-2SyGPbw&oe=6A8311AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6gIB4veTbEQ7kNvwHbzgji&_nc_oc=AdpaUYgTteSGYU3YsOZ4XIsasBECIT3SEgs8GXS9Cfd4r9Dy_6VavoewzAXI3WD5ubs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl_b7zBpkUAevNEItN6NpuYOEmxXhQ9YIg_z5o7w5JCw&oe=6A82F6A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM3_JJ1nVzsQ7kNvwHZYeh3&_nc_oc=AdrhwZmTFmA05aNdvHJ3iZlsIMbmhi_1MjN57xb8GVoD0C5Fg3Mo6jZBRw4TM_B8-nc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElvQ8NskJFYV5K4-bMwecQpk5mb4E15c3AMYehV77pxw&oe=6A82FD22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlTbdkXo69gQ7kNvwEV82T1&_nc_oc=AdqR36fG79rXMYwiEED3gfnmzfYLxrdb6VCi9vCAZm16t8ynNqv3tF_trTuncKRWn7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6lNnyE0wLEqfgxecdYV_5xI-zNhN9ja2oyBKeT_zPkw&oe=6A8314D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
ps://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3GZPddFTgMQ7kNvwFYXH2i&_nc_oc=Ado5xCpig-RPmNdZtGDRpsXFmoL9v4mw5m9JaYYKaFzWeuNPKoEqrg6xZ85CpQu-zbk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi2336KEjwAcyuXiESkSDpOggnEPsEhwPdiz12aDFrOw&oe=6A7DCB3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7-9yi_54Z8Q7kNvwFee-oX&_nc_oc=AdpW1qcL4D8yIzApeuEdf675JgdOBvLEDLGBJ4W1GTVHmMWTSRH5Mm4w_4IggJXm9HM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3mTYsPXJCq1GnUBKGsP1eCQHPqkby-Ckd_Zk5l-76wA&oe=6A7DCBAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTTaaKVywPsQ7kNvwH4car9&_nc_oc=AdoxzEMvC1vgBdtVX91sySWSD2YDAeWIOecMxVw6yatcDvPg3E_7YYq-WNBSnazkvV0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsj0osPoZ0YcY6KLrNrx1-XkYeTqkxga8VJn8AQLMrGg&oe=6A7DB0A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM7CfopNhuQQ7kNvwEw7N3f&_nc_oc=AdoP98ylQ3Gh0ebRaRCDZaqWaAJwGCYnHGA65QSBZiafSzrb2_9Djsa1muuVvZZXc5k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-jKA3gW1jde9VL2bP5HkI55YwybwxoZLeyfabCuotmg&oe=6A7DB722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iztLBoAqaU8Q7kNvwH7Z235&_nc_oc=AdqcIInadlX6vwPZESiaOcswYBeEbIBuqAk9wUnyz-JM_3A7n5ziTKAdrKeH4RRDUAg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeiACmPtQzVlDyWombGL2-N6Q1pdBgHhvIObTrCVxCnA&oe=6A7DCED7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "exter
content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEJfUnXq1TEQ7kNvwF-OuV-&_nc_oc=Adqi-3K9wZzfes_2yBj8DJbvd5ZX7oGwnZqE_kyX7D2l6Vp0n3F0UX9CCUIqQFNWBAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3a6m4_D9DQ3Ho1ezTUqYLrVhc-ptG2NpnBgJv5BwVmA&oe=6A37EBBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeKYVM1bhskQ7kNvwGAd-ql&_nc_oc=AdqdjOEA-9xKlqNCAicdfUAprGf1nuwgSQXhtK3rPH_7IXpYlsgVhJBILr-VNjdufd8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c5qtGIJDiR1-gYTd_QMByeDnza5r6NPl99xa1un3uug&oe=6A37EC2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES0FXPhXAp8Q7kNvwHThcEy&_nc_oc=Adq0WKJ0YsCYP3WfAXfWYizFpJy_OdFuyKxTqED4B4Rpa5TsECIbU3ShSJZWScVe2eI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NzE7YRSYoSRVYpnqwGx8cYT3NV6nBYe-IFioW-RBa9g&oe=6A380969"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGfaxCGB1bYQ7kNvwH0euB9&_nc_oc=AdqcQ6ozsTqSjT7XUOJQG42G0MTkvcpNHa3xrzl_CwOHVxnLvLj87qW-konlspqyf4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_44Lt1_jqbPT9QFvz9eQQ5hReC8DljQ9xR5P4s3JFv1Q&oe=6A380FE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afzoRC0m4J0Q7kNvwGgO6uk&_nc_oc=AdoVYd3igcggWAt0l_6UF5sJj0QM9-NgZ4NowIZTaWsxbyszdyy4-Bhx4vaY_N3bLis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u7F5LCg0fBfo_FvJuGVa_lsnn5tofEVjXzbovedxOug&oe=6A37EF57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
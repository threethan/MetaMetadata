content-dfw5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3mLMYNo_MQQ7kNvwHc5wZU&_nc_oc=AdrA8Bvd5X7kAebvpDnVl3AXqgNmVEXhDZRcqe2j6i62wM4z003vwsg9IZPAU6XIbLU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Q4EIjpeRgRhKdkRpa3AQlLxmmBF4AO6FVXBoROv4izg&oe=69EF693C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzcFhNFz_BMQ7kNvwGL3kSd&_nc_oc=AdrrsXdFl7YmOzwMHDxlXeFMGiI1sMqH-swmbw8aGLNw7ucL-ee4uMetmyUh3jbo_rw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NoDKKAUy3tw-DE2K9Bh4Kw0WL21Zysie2SU-qNpmspg&oe=69EF69AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDmeIxpDWPMQ7kNvwHiwaxR&_nc_oc=AdpqsabgeoaexBJQhVhJiaJtftnO9Id9KxUDz8li2R9wEeh0y-gs083W3XNTDEzxYeo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3buYBvqX1MKUeUzAw4UU7_kfULcFndbilBaI8MT43X9A&oe=69EF4EA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwNymdy7QxoQ7kNvwFmGbal&_nc_oc=AdritqA4fXzeqPQ1tHOWtiNEzFdU1a_aJjbz3U4HoVZqGUl7GW_AO0fq6pswP3n4tu4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2twsK3jFlQv16MxdaEwCILole4Ar7Y4KmneQoC1SaJqA&oe=69EF5522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3F4xV1f-m-sQ7kNvwFD5vLc&_nc_oc=AdqsSxThkFzzZnmXGjlyM7UmIVl1_XUrdW_AWsI8mV-Fxj6h_z7WNoSgLt876dB07Kk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tQx2bVOuUmxFHkJlXieOISIM1WB-WWE3bhD8Nxj6CyA&oe=69EF6CD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
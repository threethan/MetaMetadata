content-ams2-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Jyk8XrOGSoQ7kNvwHNQCMN&_nc_oc=AdrOtPIwH77XfF6S1QI6EWn9J_U7FAYK-RPxm2-Tcn70ODEJ-wEMwVcZTEFXWjHLk18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gENf4tySuQNJn6VE9MBZNIhQMk9G5mOb68aIHGIak2g&oe=69FB46BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMBdRWePZqAQ7kNvwEfCCy6&_nc_oc=AdoD1svyLcLLUT4nfah9n4vauyEi5wiPohExpHvRGn5TvOvqOAzYEj3yutLJrSUEKOo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77ISPbuyEGYAyKUSEVbfOudjpKNSC27WAzrcZmgT_P4g&oe=69FB472B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNdqk701IWUQ7kNvwG5A-71&_nc_oc=Adq-5YKnh56qJf38ZtjbhkOEr2gO4By5cr3sopz9jnJqKK4EqdaygimKuZJLZhyxGYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70kgbHrK3eNHKwHP3przC2E2TyVTqQ9MPN3f2fKTvOMw&oe=69FB2C29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59nGp_OxhjIQ7kNvwHkb_8C&_nc_oc=Ado2QzRvWmNHzUa7Nw18x3iET661G7lvLrTDTPJRxRUc6Ky8HjvAVgATulrPwZxp-20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UiaVz8EtekTP1HnUzUUJ_mieRUUBGw8gUZHqOt9VEDA&oe=69FB32A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oDAkJxp7RUQ7kNvwFAtGEj&_nc_oc=Ado_wL5UNQUzWcZ5Z1svlGHatevwCLOuyEEKLi3zHvFNKqy95sNGvKPQvsWbzCecyQc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M1RPOnIqNCBFrSmCOJR2c4XAsztRHgFqsJk7AmWLGuQ&oe=69FB4A57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
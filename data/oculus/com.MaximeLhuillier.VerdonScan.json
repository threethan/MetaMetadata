content-sea5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z37C6uCkJIIQ7kNvwF2Au2R&_nc_oc=AdpRbv353x4zHbruNHLXb8ExZCoQOdTNNB5cNIYS1G29l1Qdq-OSomZENkfLbvFcXFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf5N4dy5yZxVydD7YADiIWIzCo8Kggl8WqyCfmCGr2kA&oe=6AE1FD3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPPnKvy72ZMQ7kNvwEDji0S&_nc_oc=Adq31LWXGGTLfl4zvOHDdd43rBMx05881jz2PuhazolsPDwW_121CqcclKdYossGhmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpXNSysHXNQsYvfpUvtn4BY-K7fuXPOhwp23PLObkO1g&oe=6AE1FDAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zjz003U42WgQ7kNvwEqYGpN&_nc_oc=AdoknzerrYPzuMFaz9eFh74qAOT5vKtWePhjpOuEDMR5qHEPg56CesUBwMmzsnmuq_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmT--TmhOFBYCrlOnMXBXAyl0IPIqMawwqZhGmFII_AA&oe=6AE21AE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-AX3b4zOioQ7kNvwHFvypl&_nc_oc=AdqyuVBo_MGzmT4BBwjzp2TLjRcAFwJWsSPLaF_v9IoovxB_WsORBt52o1c9j-gaBxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtGWRM81mO3_sEYCZKhiWMvNeOpYI8AwEwyNNjPvlefw&oe=6AE1E922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYpjzk4TcokQ7kNvwEP9Dam&_nc_oc=AdqIqICh17iCt4yv3KbAc0T8ilgXzkA8XJnFU_kyWcWc1-PCLtIlV0HxYt0cN5FFq4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgiY-Dz1sISuJdxbSdE66lp6w4MJrnZZVBs-oewXuwKg&oe=6AE200D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
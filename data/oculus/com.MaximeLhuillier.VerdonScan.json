content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBXJ-9kceCgQ7kNvwHqdr1V&_nc_oc=AdrZhTlZb78LzNtX7UiEx06A1AfnX3cmA8tZY76q3ClEIxxZDRvsE9U6E2MWB-z8UMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeQK-5-ZC8i_WoZRT3-rzirn0clmvJXx12KJa45V2hng&oe=6A7733BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAfP5_0PyToQ7kNvwFX16hC&_nc_oc=AdqvAQLf_YP-uqZldsrXVgL2wMY8OplW32dihLvHaI1d216jCBRCM7Gtf6NSzU3nMKc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmvJpOGgWP7fkTwbyRX5U90vKtkl3clyYa24OQIgy7uA&oe=6A77342B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skFlTf0jo6oQ7kNvwEZZa7i&_nc_oc=AdomKWAYmbOYCT-HjPQlKNR410PaA3Pi3J2w00cxFLmGnlMhbhyRqL0EhXrafJYIp6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcEzdR8EaMMksxPlq1vvsB9hQtQS7QaaC5ySZQrZAuvA&oe=6A771929"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpZ_zIAuGpAQ7kNvwGdBduk&_nc_oc=Ado1VVnfafCf7hYYMgaXPa60oLnHrs8pQc7HYczXAKM7IPtuq2b73tO-osBVMIGB4Zo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4iIiC4VYEi8Slfe0uPkx4NTR5SG3H_JX0jZQUdrogEg&oe=6A771FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wJiTgJDjigQ7kNvwGixBuD&_nc_oc=Adrshp0CFX8WUyiB4w6td3OJRGrmAzHxCmQju1_a7RQJ001B2jCw0VLHuvowvKMQV-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3Jh1OrF_o1TXYYSegkjLJw2j7cuS2Hk-Ju4-W39dxIg&oe=6A773757"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
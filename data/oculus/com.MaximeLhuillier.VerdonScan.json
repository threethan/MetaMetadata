.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9rwcny8flsQ7kNvwFCnq2d&_nc_oc=Admx5-vZTitF0nY8Teq1AIyrn-fUNTUrmiI0_-ujkE8i94pMS14WFlvO7n3JBRO0A0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3SOBcQMCn7SnWpj01u0dADCDOSmq55VNAaU1fTo09OA&oe=69B80A3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpvkSAkrtygQ7kNvwHY4vC4&_nc_oc=AdldwB9QW3nhkGIKxu53nWeeg0IX2mlmlreS9D1x19fysakfKILnkwVY3KR2LIG1xAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3OKPTDVxZfJQgDNLw6-WLQEV3ooFcEKCAvbqQ18mJlw&oe=69B80AAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAYexEg-OaAQ7kNvwFTiuTu&_nc_oc=AdnFtVxEmhCXh0DDEZ00pry8ohzZoMwHOUj-jx0msdFqVigHGPaTcD8EMmp70TSVuis&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyztzu1DOFshYObWjc4m79swFtuxhZU_U0Nwb2yceznew&oe=69B7EFA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hih5bYlPxxsQ7kNvwHA6U7K&_nc_oc=Adl15gScxyPWBgkAxZsizAx-_1XwJUkt6rNG8EZIMzMGLgycjlHq4YzC3ZOuLZCKlTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx57pWTnM3Ysb9aX5l9Vc_XfF2oPhVcV1ZelCotyo9DPQ&oe=69B7F622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf71TFWkKoMQ7kNvwFGkwNX&_nc_oc=AdkRg6oQp_9JsRK7pKL51almmsHpGIVYv1TPivZZLGQplDrPNxafnazoXsE3O06JZnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnG4UuyC-TICDFvNqviTu12el9SeQsqIvG6XOLBy_zag&oe=69B80DD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5rP-5BfqYoQ7kNvwF2c5w3&_nc_oc=AdrBg_X42oiaTcWsqkBRZevULAXELdCf5s44xovmcmkdIUhE_Pf7m_NxmFpy5EohRO8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8kS30-FlcwFtn5lMFjwZGE76MoaHJ8v1X3jiKmC95Vg&oe=6A5F78BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRsGWIeR5FcQ7kNvwHJlXwp&_nc_oc=Adp-XXLF0OJzeamemM26vJDTCK4tODirCYOtNMEp7NYUmTPHSFODCG3-X_ZZQz9MqUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCezgds-f2UWJSdoNKGbrKgn9civ5QmkiGJ2B97B-fDYg&oe=6A5F792B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvwytcMO1d8Q7kNvwHp6Byn&_nc_oc=AdqzsJ1tIT9W-vDWtRgMyY6JclykZBPfujAgoHqh9HsDt3sbVkaiM9SJgV1tdmeQuY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiu8QJLAWcfpesmz0RDY1QCKpbIwt9scgV9aZNuvzNWQ&oe=6A5F5E29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6V-rtE1-VYQ7kNvwH9UgNo&_nc_oc=AdpR_7Si7xt29FpgjTjREE0oAKJB3PqMzrwLTZr7W0yJnxQXrOaKkWkuAf5bL54HESM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxF4hwNgJ79fze9pUROhfZUZ5zDOTYlPmKwZbNk-MEsA&oe=6A5F64A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6jIPewndeoQ7kNvwFRRdPp&_nc_oc=AdpldWkJyo_ItQkusACbpO9D9ewn-6vhpzMWjyJwXvPSqN9ABuO_rnfRKCG_aPZiFGg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCugc7msuKGhTMVspyMmMOgJePSsgWmgivAvDXcV22guw&oe=6A5F7C57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
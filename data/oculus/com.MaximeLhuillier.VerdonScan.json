content-lga3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bxQ5yJ68YgQ7kNvwEI4XrX&_nc_oc=AdoSH997aXgHRmT-g5nE63-WUTwmEzTJZVh3yKD3iTzC6y-DWHtZldIJFHKbO7ZJqL8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZzsQl-oXUBVABGvKZqXMWoB-KYrnjgCwlQTeSUBRFNQ&oe=6AC8F0BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHify30CkfIQ7kNvwGefz84&_nc_oc=Adp8RN6Awj_aPvzA2VMXsTfqq19WDmLMKEXhBrBwR0zR3SsKAW5yxg402kUbi0-_j_k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCeu-ekPjGBB4kybvPQ-rJNp63-rgkzIByMcyqFDtSOQ&oe=6AC8F12B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s3bStcTV1sQ7kNvwHzyShC&_nc_oc=AdqnN4_BWTqKSw-AwO0xkpS1rB5n2WfreEZHC99W-VnGCtoSI8n3Ce2VtLUpdbaFawQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8R6xleVHguTT1qfyxyU0vS-6Sxvt9qqa3KyP3QhUSxA&oe=6AC90E69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR_3IykGqMUQ7kNvwHPceMm&_nc_oc=AdoNKmQIb08Wy-xSTXURxLIsl8vdxtYik6iIevH5SWR5KewfkDGmf3KYI51sWwYVo6w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU08NTb39sPqX7d8UZU1WrlZhyj__matHnTmG2H7nv5Q&oe=6AC914E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy6E9tYUGyQQ7kNvwEsCuxl&_nc_oc=Adq_MUGA1cBEEd_ez9jG5aKhKPyGiMg1xtLvI50S2D7S6V-i-cuDMXX9RBnizxUFm9M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrGoJT8XVEBIVOAjm6FWPkbzwIULQZC6ag9Sbhxa6Crw&oe=6AC8F457"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
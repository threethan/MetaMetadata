content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FxeJMmL_JIQ7kNvwE7LMeC&_nc_oc=Ado6arzifO5IUO16Gtyb9vUEjwV7aKnBvnuGeXF660KlFKmGg_raHu7EabDE649i7t0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UssPqYS0E5HLUGDqWAdWRdGlpc13rNqvI4WpLZc3siw&oe=6A3FD4BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otwgZeJI6CMQ7kNvwHq_uxZ&_nc_oc=AdoPFXGdYrJW7XEeSrlcmaRbPv5qJ_Fs4r7D4jZuxrsv9svAmw3T8NgZ25_QN-O_nsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ov80YwkG7BLJlQ7dVg7dy3HiydNOz8NXFCXeTyBpNsg&oe=6A3FD52B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmK1Q02KRNkQ7kNvwFJWb5f&_nc_oc=AdrFeOMy5SjZn7MJTIpeu5hVQ-uHEK4OcU6tmxW9qnnIhsXesFldGsAVGaU81gkm2LY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HkKhzuKVMjkREqujAn-HvvCeLGr-ODaOEmg-yF17i7A&oe=6A3FF269"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rVzBizkRiQQ7kNvwGCSDe5&_nc_oc=AdokzBHgeMwYsLdgzIgKYXryGF7-e7DZy-0BlFyFz6oGOiEYT6pkVyCbHwaI0XFmg44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m9eFigk7WNc4-fItIeVzu1_OVycvUW7RFP7UHbT5qIQ&oe=6A3FC0A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6q56ZMxJqUQ7kNvwGFTDyO&_nc_oc=AdrC9cypYlfg6L_wqK2MEKtvjRfDxKdxGVMoMNwyM6UgyUJz6xQOCn53FmwQjZomb9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uB5D7VjaNvSlUoHCfAVLWoS3tVL7Hy8RdckbFIRJJYw&oe=6A3FD857"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
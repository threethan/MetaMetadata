content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhVBY0p1-XgQ7kNvwG1sq3T&_nc_oc=Adp6bH-QEt-tnFHA4UuRp3vMBi8M8VDn13LJBJsCyi_PMmyh5qtvwhKrGMQjaZ0qsO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RU0RKc7JEjuKxIlyG7yyjjs14VNVJBGFWCM1_gdo3IQ&oe=6A2D5FBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7Vcd6bhRNUQ7kNvwEt4nUB&_nc_oc=AdqQmsOy115_X7RctLwFcLHf9u_FTdH99S2ZW3cy7THbQ_lYRlb8RikevkZhgxJwvpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80zatzke4rMISPkLa8uAbkI6CpScNgTR0r6RT4H9x0qQ&oe=6A2D602B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPYLxQAbCr8Q7kNvwHUPAJL&_nc_oc=AdoMgICsFwqBkTe8q123SfBGs08zDYV4rn55IHUJPyFMr6UFkaj_h3NH7cZwKGMFhqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yo8IWhQUOVhmUyT0Tq-ig6_j1HKDLc9O8WR-Fwwbi0A&oe=6A2D7D69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox3-DG0KU98Q7kNvwHjxcu6&_nc_oc=AdoB_PuoUin2BswWUoKLYCWrB5gJwWzLfNKSBMugYcSlzYHs_E9yyD7uNBxatfb9_2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ipwx4503ZxM8-t8-0GsV59DXvVNCmOyrhxhiuLVmxMw&oe=6A2D4BA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0-zhaFE3bcQ7kNvwHSgJGH&_nc_oc=AdovN_Ub4k2IG6dj59qvmAvBOs9Mg--INOkR30WrFVKCAWwdON2epwhvB0XAER4ntKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a4a8gPgYevsMkTZZlYfNPRCwePkr1_H2FI05g60yRzA&oe=6A2D6357"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
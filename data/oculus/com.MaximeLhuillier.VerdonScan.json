content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JlpM2OrjckQ7kNvwErfDEF&_nc_oc=Adq2ljjWwfZf6IsJjt9KZaTwHYc5784xCzcnlL2jQIDzFw3LSHgz7ZDbpInrpvG4tnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM68CtoqQ32KZVfdyNOCXZgEVNqLM3d18eP5D7cfXnwNg&oe=6AC64DBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIfOwBrEKsIQ7kNvwGyp-AZ&_nc_oc=AdqJRaBoL7CxMzd4Ny3zu0J5lsuImlff9I1A7sxKdpXpNdIONorbTDTklPfaRKdVKxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8pMMOH0_JzjyJadMs1HrcVOffSy9cH1nv2UmuiBKq_Q&oe=6AC64E2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzJKds6yuwkQ7kNvwG-PFcd&_nc_oc=AdqzrMAKUmxXkIwKOT0xxMsmEpD0RXFQviL1YXTekAaLxH9FZz7f6qrL2vZw-j67VuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe-JByYQv76PAyb-xE6rRDzZLzvPNgx1NfrOIUnKGyoA&oe=6AC66B69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR_3IykGqMUQ7kNvwHHYYnt&_nc_oc=AdrQxjsIgNjWG3m5GQdVbsy7ZNxAIHxDgIWJZJBsUvCRbRjThJyRhQFKWQxkzeBYsZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgBqZCPauPPpYIAJbuC1VjnYcOXzh6TSS2q7ox-bqecA&oe=6AC671E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5jrSfRNi90Q7kNvwG9-9Qk&_nc_oc=AdpEf0yiIHDQVNMKTsgBlWekh0dfykTOhbSVn485IhZyjxs6c1lWOJl_Taf3ID9Xcnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR1FR9COUtm9TE8Uj3ScrNR7-WG-jacrJFNvvv8cAoAQ&oe=6AC65157"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
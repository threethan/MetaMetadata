.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8TD-wyzn5IQ7kNvwF-JowS&_nc_oc=AdluQe754-1SU1T31r84BJb5hPhMsC-udaWnPfYnU1p1QWmyxUGgZsyX-_TQm5Q5YLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyumbbhj-pe9pkTIpKrEeWiPnjYJEx-irzq7wFqS7qNmg&oe=69BFF33C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwrEP4qyuWQQ7kNvwHX_N3v&_nc_oc=AdmLXdMz-CMCl0pud-S4_h3MoUT0tgr5pcvScB_Simq-gUaW2sIqw6hWd7fgPqDfk94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyqWzZzrymKBnPF_c5Er-oeLIBMoS5dl-yCknYrboGzrw&oe=69BFF3AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-v4hRnOeoUQ7kNvwEHvyMU&_nc_oc=AdkONPUdmI2mHyGGlbQta7UlY7Pgv7-Yb6pnQtQCSqxnKn_gkEm469gNGkOU30dd9JA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPKB0zfTLluoT4v6jExuyHol__jYw-_VOyRXdokxhi-A&oe=69BFD8A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNKzo986tfoQ7kNvwHWiPfK&_nc_oc=AdlLq_32R1Oih7PDz8kpiNOkJ28qjW8ug8xO2ypWuVtTCjtzVdTGHxsCBt00dPsDbok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_nh4SvvKCBOe_d7DwJdFvB4w8eQ8tAr_AGEehGJlXng&oe=69BFDF22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1pzxjS1-PEQ7kNvwGc4nVJ&_nc_oc=AdlGcRRk_ubwiPJA8VAF-13okUPLxw7lo-2k3Txbbl1_n0VxVYUG3NAc49_yluGvCJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxymaSopX_TLz0fGaqx2HrZ0F-EsWSgwG3-912rYRYaA&oe=69BFF6D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
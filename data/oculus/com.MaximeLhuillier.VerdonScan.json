content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuOa8RbWp7QQ7kNvwHaclBa&_nc_oc=Ado_GdFiT8oVDM42OTIluQq3AKsdlBzO5Sn5CX9LYaXoAHcvdmhFtzfD3xgk5XOR8KU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDazNgR1aS9Ta4U2jfUYKF9J-fh1lZkLJRl7BjNKaCaXw&oe=6A490F3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zayUewSn0YIQ7kNvwHRJKSK&_nc_oc=AdonKWu7XTdts2Hiv6mZBlGY2rZPUGmUTv5HXQMs2lEn-F9oR5Ku4MQ2h7P3jJV2lzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdpYNoQLAAwxhqiQXPC_4UpW1SH_PM7gRC_H2iIj5D0g&oe=6A490FAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3d0Cp5s390Q7kNvwE8xKon&_nc_oc=AdqQ7a-bEialgsep_5ebxALgEQuiAU1b6kJ6zlvrMEv_4v6YOd7D2VFQhbZhLByzy3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHR1rUTWQ8Lswf9KK0sP4u3D5aezHGEfxFm1qIGKQcHQ&oe=6A492CE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bj07A7WXZJgQ7kNvwH4XPn3&_nc_oc=Adq3aJ8m2C0jwGclqBkhHi4wuFrc7r33cntMYRacH6K58igdrkHwSgsU_6kI03zmTC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzjD6TP3YFpC-T5n5ISKHp8zi8WyRnyfQTsmT7UlJHLA&oe=6A48FB22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-xl4aHMqZcQ7kNvwGpA9ig&_nc_oc=AdrlrB0IYHl1U1OKYEJnzR7n-B4CEE-xgyX5FQb7XEkF8MQRH-0qKey7c8-Nv_X25DU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAuAhLLZpND9hmie2Eamz2OaaNLlVwjM2O4CrSCKVm4Q&oe=6A4912D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
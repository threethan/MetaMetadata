.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt6oQOp6_KQQ7kNvwFZOmEZ&_nc_oc=Adm72SDvh9mnwUhwSuVO2QvPVtJmLfkxSlfRoEz5sXG3fLMGp4nffMQFjTgilpNHX5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKrIo7L_AF79ks140V-wskOj5Pvlcv-6yCP7_kvBHuVA&oe=69B0213C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4elsL7C8vMMQ7kNvwHfuPLr&_nc_oc=AdlULyQDNaWeJ5kljOJvWCZtrjZzTeOV3SM3Ex3dMstfN876zecXJMDLVAq6QCsVkjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYoHsLHa7-gr5M6Bqpu7kMeoOwVDM3JZAj_-smlJPiUw&oe=69B021AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzN-Kl4XNYIQ7kNvwGjVMNM&_nc_oc=AdmyixtBo3z533JeXIthmYpOqnYLYtVYvGziZK9xXCuMVEgID6AtsPh8PE-uniDteb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXOHv5YXBhpYjqE5edBxnVdxBzji8_HIKOFX2qLAHYKg&oe=69B006A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_YjF3Lo7dAQ7kNvwEHbg-h&_nc_oc=AdkMyYvPvMwvLc4awYqchCkjqzTOHeCoQuxlyVaHOO_zlo_-1akxTj3so8fhCjSoxqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwy7dt7On7bnA1uVNtL5yHYo1oURKzg-RfO4RLbK79cfw&oe=69B00D22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-YOEY2GhRMQ7kNvwFVwPZi&_nc_oc=AdlG7N59pX8Qeo-G95Qqi2NZVSC0ffkikmXJ9XbBfa4TWJ85jiifeAWWpkf7CBuaPE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxbq3Pb0aei2uV5x9KUPbua3jA6gl6f6mTNJzq7p2Yy1Q&oe=69B024D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
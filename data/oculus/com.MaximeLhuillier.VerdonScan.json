content-lga3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JlpM2OrjckQ7kNvwFuNzGL&_nc_oc=Adr21NlttabCbXGJ4THAn5Jb-ypIo27AkWkktfMOIth6tdr6oVdOwW61phtCacAjxKg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBAQRJQljUiAYWyFy3rcxQ3CaazIODkzf0boagxuuY0w&oe=6AC4FC3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIfOwBrEKsIQ7kNvwGbuvOC&_nc_oc=Adoy6eydrdyVjm0GhkVxNOj__82H64ORJsuJa-xG1Qf0C0pXTClKP_km_M1rpLK5p6I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcmy_-PELTRW8amqswGTXdXHiPcK22QtbHmfj0VGHgrA&oe=6AC4FCAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzJKds6yuwkQ7kNvwGa7Q5t&_nc_oc=AdrkFf8dEa7qnv_aE9dYRSuYiLP1pwDzWmPj2MkoLgZ4E4C94a6ErtihClwF-i7zgCc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4F9NzndyHxOp3Wq47UxKei19RCmhXRv4r8IJMqHvsKw&oe=6AC519E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VA6tb_NfPYQ7kNvwFllpcC&_nc_oc=Adqctyo-mCW7S9VSQHgLwpi2lop5ntQWhOPIPMgkfCe24dPenrikOlcpxd6Iv6uyjYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0fQdm0TRffbQCO0JWsHDcHkHwPD8FqlHR9BO4mQAw5Q&oe=6AC52062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5jrSfRNi90Q7kNvwGtHXAZ&_nc_oc=Adrwn2Pt9j8GFcfH1Vc-2Rw8gk-oxhiGxXuIlFzLESuNNl2xuQN9HzDmDK6qbOo83o0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe7qMiK5e7MdJou3BVDYtwuORe9riFsButyL3Y9a59zQ&oe=6AC4FFD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
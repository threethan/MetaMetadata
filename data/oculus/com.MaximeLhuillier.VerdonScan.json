content-sea5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3Ct9TmzKykQ7kNvwHBqusK&_nc_oc=AdomghTk6ptuZstih6ma6VvwsuSrwOkllZZ8-ga00sK_2dMOD9maxWR8rct_lC4opSE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4KT5KIJ1VgfBMWNjzLoq6exdOSJm-fDWAAyDLFsfIQA&oe=6A90403C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWeapvlv-20Q7kNvwGwC5LK&_nc_oc=AdrZup6IiyYwiswMoN7EeZ9M4odUgeGN_tUeeuueObnS1EcsiYqtouKLCAboYm2iXWE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZuQKCV3-DVzs2mpydRN9t5eguJwe0s_dG2M4xfodifg&oe=6A90086B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz5qCAPm2s8Q7kNvwFPNS7i&_nc_oc=AdoaavN2lioNprnvU9bf6wrOgskcDis62jUR7dEYBzAy1ZOMQAfpa5bkpfv5PS-NoGk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5_z9BmC040oJc0At28DTBMvPphhz6ZX2s_07QURVrew&oe=6A9025A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUqWdXuBoh8Q7kNvwFwJpF6&_nc_oc=AdrFHvHh8FiG49QiGMlkq4bB9NNDbv4oQ1899Kr4c8xnhiBXVmB33I-9tKkt5jSneww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExz9UHipOUvh9a2XfPnEm1DqXID2-RUYs1Uj6bWCQ65Q&oe=6A902C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aekQjHdcbDMQ7kNvwE8ICYr&_nc_oc=AdojZ0fKAWAhP1__6ByG-LdzL3VCE9RFd1c1oqqQTmNKXjljn5ljz_Ljr_sG1amrPJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUjUwhZbP_dU0lGjHbto0yuH1g1NRVn0VgSKF4LuAlWQ&oe=6A900B97"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
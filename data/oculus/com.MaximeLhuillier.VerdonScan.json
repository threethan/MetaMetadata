content-ams2-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uamv0wSmDbkQ7kNvwG5A9Pt&_nc_oc=AdoK0mJbqeUV8qv3Z-vOjfE6tCg0DsMeS0sxv-pk5_MrHjp7p3aoJTw0qlKMPaZTcKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dKVCxBCEeMN0yztHlaQ6cH-cxjYZRtCmSvXFJthhROw&oe=69D2683C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E-YnLRgkxQQ7kNvwEN-g1I&_nc_oc=AdrHcMHpSdKhQZIiuHHxWanLUu4ZY0RI0VPmGUTTBfHC7Q62j2G0x77kMoZTSICXIAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iWYT_KfeprMU_rfWHhISRJ3rviXuOu1PpVchKk5n_0Q&oe=69D268AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3W9HqB6m0IQ7kNvwGnYpWl&_nc_oc=AdqvWP83D0z2R6cusmxHcA7cS6zxs3NObWQKbpCvp81guUPat9r0hfgT3Jii7E7zt9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21yaALrQLW_GoF-XWUlMjwP-goGJFpuz8v481GNLjexA&oe=69D24DA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsj9NI3yyOEQ7kNvwGXEAgI&_nc_oc=AdrIJxvReXAK_3WrXlvNxttztvL5eUMr3e71HfQ_ha6ygciaf5mZv3VhatpuQ1tGYiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10WO65bn69qhD0GjcCuiJ93e4Jt20LbIvrOmjOUsPuvg&oe=69D25422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHNnVJf0crAQ7kNvwHl27eb&_nc_oc=AdoZUHJ_6nqp4VpzhLX0YPLOr6zYxKpP8yCvjV85duvuvk2efpRQtWjw46Qlof3Y2_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T6l8WHXtLpsfHLltLXou9tqWDAh3yZr9CBqhbfMI8nw&oe=69D26BD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-fra5-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKByvrsSC4IQ7kNvwFmmvz8&_nc_oc=Ado5lroc1dvFltjg2lZaH_ykHk7xOl7EMBugxTIRK-4SsVeNN0QPAJI8xS1fcHGYwpI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHDJqSq26EfSF7XVXi42WTzqv0rrDl4KMZF_xDp_R-ew&oe=6A81BFBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s097SUTCJPUQ7kNvwH8jqMX&_nc_oc=Adr3nddfDLaMF_floSRE4f27vso4PeVZ6jh0zBvi4M8pY10W2hPLKoIIqmmsPWEwSVg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEp_Vo5LCWiKhiIt5IKiKQ4nUuerQcVquALwBelOSc7g&oe=6A81C02B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6gIB4veTbEQ7kNvwEwTSuM&_nc_oc=Adrig6tkLIqJeAwLVEa2GTWi8pOKmdh0Yw4PB8VGPpxc1qP_AjBXmrQ8TyadwuyLWqA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0pQ4MKmT2pb6SFT1ubq4Q_XlYtSgYBSUu-YIO9jtMAA&oe=6A81A529"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4_Hl0fsRH0Q7kNvwEPvvyB&_nc_oc=AdpiN1H7HGSRB99eUP0ngAYCeqQkUjKPiuiTwAGXL_agdZE3ceV_dT0w4ddZ2qIXM7w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhBrW-j3FPHfDspiNNwvMWKQiylgIMc1ZzajDwY6gpMA&oe=6A81ABA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlTbdkXo69gQ7kNvwGPgW8-&_nc_oc=AdpOcWNiHfznM_5HGn7S2O3QylT3efaSbk20PC1D4CFGtPrEi4t8oAVyKFqzhYQypXo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQnfwS0KHMcD2p7-uFOpqQLP6y8XUR6u6gwcpJEhGBew&oe=6A81C357"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
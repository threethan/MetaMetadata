content-lhr6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIvMRiqyYYAQ7kNvwFJgjK3&_nc_oc=AdrN7IhWOVm1ZFxOuSJjeWGl2V1elOECOpTGhRg8uD3Wg82UXkGZLkOklmrnogq4hkk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r0q0Py470NFS7CeeXOG4Hao0847eleU2IJ_okIAP6UQ&oe=69E23A3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzeIch5mqyIQ7kNvwFPAo3u&_nc_oc=AdqaFYerc826FLlR3CC724YcfoyYzrL-O8pIXrApwWaoc3jXiJdZG8vJfhbSpYnUwSU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Sm2jSGrGLwtmZuPsdUxWfH0KeF6bkde_Nt8ZdxLn7xg&oe=69E23AAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mblIBBVCk7kQ7kNvwHTEXjG&_nc_oc=AdrZwwrWCPeht1SvHG9rBsZQbhud9ExomOQcn5JiA1AorSx3pN3S1_SQQSceT3oMMwI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2chdKIfDSAWo5t-eNcV66jPYgopPKjHzpP5BZDtyVb4Q&oe=69E21FA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fku_wgFIrpoQ7kNvwG-hNe4&_nc_oc=AdorhnYpuwDnS1cB1NDsdJ7_dRWTMDVcCRxar51-p-Suq8AEqq28oRyDhJv912RFhrs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04WFgyXrQ1fc8w7rgC7t3xV1aB_eHTBF21dZxJtaJksg&oe=69E22622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eq4BDhTgT5sQ7kNvwF6V1YA&_nc_oc=Adqt01WRCmobqVEvRIO59hju86BXQRZjEOLHa1FijDf52AS9BErMJxv7bLl1ZXgWdxY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af213w3SL-V4IcnnOIihAGeBI6gXYM6Z-is30ZIX2QM8iw&oe=69E23DD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVKtU2sLSmwQ7kNvwHjcbSp&_nc_oc=AdpAVTlqGfONik0wDccTFXrsr7l8Qj2GMKAS1aFQVjtIQwndpOQiaK06wiHFZ67FNjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYY7Vb1BXsxmXzK6rvblu7vZkMxcPhksnudfWdGJzGDQ&oe=69CA7F3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0D5YYle8IIkQ7kNvwE3e4CM&_nc_oc=Adpoj_ErI2DOlmwdQv_lb-5Rf4WGzFaGyr2z-jAKloULAEBsf3iUI15m9No8is44Cn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNxoOMgpuDzc4QaweHreMYV43NtnhtD5rfJ88dFFoMEw&oe=69CA7FAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ3JMNreng8Q7kNvwHRquXF&_nc_oc=Adpf5NhwGncxj_cX_4E0kz98lVXlX9RVuIyDRRurBesjiPY2valle2k3Hvrh9bATOKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6MTpr_VHS1ymkVHVWzhzAWAvTLCaFMofsVe0EWGShEw&oe=69CA64A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBPOTQztUgAQ7kNvwGgr6ez&_nc_oc=Adp_wl8nRacsbfbNgU2BF-Pblp2UpvhCgtNBUhVGRRSH4QXLmOW8x6SqCyDNW3jULd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7sRzOq3wx605N1_kMtiSxbmWmdvnQcv8ePKtWXOt-8g&oe=69CA6B22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhSC9tFRGcEQ7kNvwHvqE8j&_nc_oc=Adqe5qW6lKiVyMcSjajylqS9oE9UJOyayamTvb2QhY-KB9UPukhKqu2mqPCW53_y8Dw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwb5YLMuY-MwIl_wGDosgYNP3TDD52g_vGWGkx4pFsKbA&oe=69CA82D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-sea5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4z8wPVUK2UQ7kNvwELSOMC&_nc_oc=Adrh64zG0gA6SzgvueWWQWWRHtGy6Zw3gWonuiscWUFjClES2df6VKlTohIYtQFw7mY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH2kyXkCletV8ghScQl7om-dCAacj0IskPTi9s1W-kJQ&oe=6A92E33C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWeapvlv-20Q7kNvwEKCkkk&_nc_oc=Adq5XaO0g_nRJS3y9_6f_2VxHWI2eQSDcuALX_qQrXxjsS9djdwcg0ahaDOmQ_cXZVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdJT-LmZ4p4iRAPcpEOe01N1_-Vl9LQMO6p5skrh1U1g&oe=6A92AB6B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apJb0h0L1AUQ7kNvwFYYkdw&_nc_oc=Ado6oh9MyJaD7K2MWLq80dxSq2nry2qvEMkdod_uKqB8f3SBau9d_bCGw1uB7dP8HvE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKv3-Xe3j_yv1yovbqPWqrFkNTrHoARUwl--XkbJ1HAw&oe=6A92C8A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D4x6pJHMDUQ7kNvwEZ_oOx&_nc_oc=AdqZEA025RSbYOz6ogZ8iXGVUfME4ITcpAM2e5qRK4qNN-QzA8tmR0Yqc5t2_dBaxVU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIkQIG9ws2Z3y_pQBbKykLBR_zbYbGlqU4YWixxZvzfg&oe=6A92CF22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aekQjHdcbDMQ7kNvwFXQfS4&_nc_oc=AdpJIo8yDivbduQbws04Fm6tyQfk9F5DX_ipVFXtmVkE5PDHiyW6wJfbU3-7z3-LXq0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKKviu7ieHBbjsy_JfCNJKZadn3tEMdFGUsHDeGfLuUA&oe=6A92AE97"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
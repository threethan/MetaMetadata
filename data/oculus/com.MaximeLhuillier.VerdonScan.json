content-lga3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaPQkG09T9cQ7kNvwHqQHue&_nc_oc=Adqi0Av336Sv9I93nGxxk316FO8NgYaQIV3jRYUkG3v8nHgF0JZs8AY-JahvDBiVDHw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHGkYpQfghmHboHmGkz9v_pbmb7DAQPxx9xAYt8bAhGQ&oe=6A806E3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s097SUTCJPUQ7kNvwF-hKKb&_nc_oc=AdpgQEaynDhhLCfGxLFzYfD0rx5SFaqfulK3zAcPwJIWnahjRj_skz5F-9BqbkmTIrc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO680y2xpILrDnOzfNvovMnyk6AZKWEa9tb5abDJWLEg&oe=6A806EAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTTaaKVywPsQ7kNvwEReuxM&_nc_oc=AdpnzQ1DKEVVIBiHGqznGYrn-EapD7yuhlGwUYRP4ArNUoRD5XEka5o4Mi746OWcYOU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFynsoWFocIoCAihlzc3n7hZyHQxQVisSgPkNCNiS-7tA&oe=6A8053A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4_Hl0fsRH0Q7kNvwHSv6Zo&_nc_oc=AdocPmZt7c0lhf_-kGgzUBinA9-Ms2s4XqaHoY7X1aGRkkC_KWXQ2EYD0sIfwwJCZTA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9t_AR2mlYTfAGz92azlA2KlFUrzlQKwZWY2xORtKTpg&oe=6A805A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlTbdkXo69gQ7kNvwHR9ETF&_nc_oc=AdpKKufeZm-T3w2bAnr_9dt6NyaXg7Q-klksbaVfjcpS-nHOGHSeuYoVWee8bySzpLg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-cdWT-fyf_e0RLtLFpmMSMN9vQc5LxfreTYp5NRO9mw&oe=6A8071D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
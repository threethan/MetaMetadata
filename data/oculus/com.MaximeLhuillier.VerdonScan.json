content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0ykj6c1v_kQ7kNvwGNFq-V&_nc_oc=AdpTIjquWPwuR9c1-bDeMGAZRS4Dk6Iidos6usBI-1mg6qBmT31QctdqcWgF32yNiXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZCI7vdf7ZkZpDAzxlamr1ScF14obe8ZJ0nPAYOULEjw&oe=6AF4723C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC5lBalVJ68Q7kNvwHK-wk1&_nc_oc=AdqiZKfQwvH3B0lpaDbNEZ3wFD0waRLQrURD5p0wIA025b2CmEbMF0KR_q2i-c0ZIBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo2-KRI1YCovc5ri5PjWgWg3eZZ9bql0GllYyGlJri8w&oe=6AF472AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn6lSjGeTl8Q7kNvwHMdnl_&_nc_oc=Ado0RliqMeVC9Uh6Hxn3RTP3xk9YaOcNyogO7mkqev7vqS8fGLWi52PtY6sOA98aSCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ77QoCl9kqYxE194F-mj79n9Z5oszaGw8wVlBtB42CJw&oe=6AF48FE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rLrjjQ9OUUQ7kNvwF88N1b&_nc_oc=Adp_dfRpfqoC4xtgKFfMBZ6DYb7DFDXJJdw_YWi7Bl0-dRRNHw5KlrR5EfazBvjjTDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRBiS_b7Dl0jDZtTFX4PhsiDC5k7rZPWLMi0bJcc8wDQ&oe=6AF49662"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRMLifnFUeoQ7kNvwHulsOP&_nc_oc=AdpT3-z5YI0JL5WqjNjgZUI0U4SqbJgvpYZieNW0CPqmO_mh2rgpIZyp6FYGl_x_5vE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAIvOq_ddE53ZSQhi1ra4sa-X-l6_fvbmlp-9RMwBTGg&oe=6AF475D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
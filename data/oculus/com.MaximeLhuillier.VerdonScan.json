content-ams2-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FxeJMmL_JIQ7kNvwG1pzc2&_nc_oc=Adrhu9ffIOSSMuAWl4j1FvAN-JoaRzQFyeePMl0iCUeZsDURChNN4UtzrzCdqAK8OLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-LXaxvRddgHISkfJ8_iuGO_mpbHHvU6Tg_i9oI3RpzA&oe=6A3E833C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otwgZeJI6CMQ7kNvwG6B43Q&_nc_oc=AdpM0-iedP-KGfgcAikewko1CwcA9uRV8eo4K_GlLGtkjzEvDKPwWguxkBMOze1QQoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af938R-6fiJ8jvIwgM0c9WQDgd2E91Yr_KynDHY6mX3V1A&oe=6A3E83AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmK1Q02KRNkQ7kNvwGgJiWi&_nc_oc=AdogVDwF3GysmCbDDrVbKMi8slUx5mFK3hKz_pvriJmislXyseRKMKdyrUBNpEYYMiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8i3oFZEECY62KU9YUGGixA_tC_1SEaZ8MgUqA-6ObNA&oe=6A3EA0E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0R7b3UpbIoQ7kNvwGDRuCP&_nc_oc=Adp7Lgt6d47-9QECweyaN0g0GxTa3MTgj4l24cX9c-n5avNsG4mlVHWru2CiRKZiUO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PcEaCM9F_iQCyxyQ8-SZ7o0Lr9kjxf-MPxGdXcLb7lQ&oe=6A3EA762"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6q56ZMxJqUQ7kNvwHmJpM7&_nc_oc=AdqboZhvgcIgCtKrZEjeZmyB5FSl5QQDvalhpZggghMPelqQzv4fC3DqZ94PCSGkA9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MZ5NOy1Sb83otbCw6fL0W1W8mvfTFbgEWyILeN1u35g&oe=6A3E86D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
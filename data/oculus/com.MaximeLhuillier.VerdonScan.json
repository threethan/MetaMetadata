ps://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuOa8RbWp7QQ7kNvwGR2S0s&_nc_oc=AdqXioJpXerpieVS0_jNwXg8b76xCA2z61oBN0nrX5WYLWu6l3m2PgHU8nSgQki5qD8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Hdajv1lmaSNnbTDhSUAuSy7OTHdLyXYb6OjuFraW-9g&oe=6A466C3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBxfKH1PeW8Q7kNvwG2NvV9&_nc_oc=Adqu5MREWkx0iOoSIY4y54cWRurJDg92bJBcZMdZN4H24D3rVLceDX_ukd1ymlB3Uhc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fCxDMceUTqSt48yltFsscvj2yviz-5BvHWqlI88vNjQ&oe=6A466CAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3d0Cp5s390Q7kNvwEwSyxt&_nc_oc=AdoL4gwcRnPCmS3KT5SkTDPE7KcX0lCqhjgq_Ilku675Uk7Hmo57Him6WQtWL1dQHr8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TlMw5GZpHZFXsTDzCZWbeYoskCWvKdXX3vrrzxKPd1A&oe=6A4689E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmJmyPx_VTsQ7kNvwEPT1H1&_nc_oc=AdqeKU5wmPqvvHnJagVWuZ0xw2IAS-wd8p2rVYGq3q259KIVkGj0ehiLySaKQLpDn2Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-SRKMhN-ooPYCwIkRQXvQsOhL62tZxgpdbWIvAoQ0gw&oe=6A465822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTJnix4W-LwQ7kNvwECdhk0&_nc_oc=AdpelEegcDmigt3xvCF48QFVYFF6sYfE-4c-6ipeN-4magSYVCG499yGdeLg8y34LJY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99iaMJBXTvSYtcdHZJ31Z_GbZSBzRT3sKtuX_Yj7P0Ug&oe=6A466FD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "exter
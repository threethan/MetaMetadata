.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9rwcny8flsQ7kNvwEBOEHc&_nc_oc=Adnr3FK7tSkDbl1aP5Y7-227_h3iTBhV1yz4fQy_NgTKjiK0ri9n-p5cED4IvMWQ85c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEgyr9fAVJKPylIghvjE4c0JlPj1tSFONAnGngkzVryQ&oe=69B95BBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpvkSAkrtygQ7kNvwFlEuF2&_nc_oc=Adnc9x680YN2ibIcBMBeP8M9jc1dU-b213OpKj0CBiLjfq02szBNmAQsFdzQM6w5oT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsetZXWUvP0ihEKXEUoIcLgrobs5BV37BJ-T7iDwQGZA&oe=69B95C2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAYexEg-OaAQ7kNvwGg4Idf&_nc_oc=AdkYFVaH9eGUtK95c4I_B-DMe3xDcqZvL5ETRH83UJN9LrRUcmCbypyrdiqyh96UJlk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyy0WtKcrPtWkZEZH-odDrldZsGB62ksi3tkUlZNm0ojQ&oe=69B94129"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvQODfOMhaIQ7kNvwGgAMU8&_nc_oc=AdnI8vnk-hdY7O3Qf2mq9o-sCZHtgwQLRmTxj23LH6CgsMbVYgO7b3QidBdwmrkforQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx63vAaHOHwFgeBc1LAVEcRwF2jqAXiqmwEUcgUpAFinA&oe=69B947A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf71TFWkKoMQ7kNvwH8tzQq&_nc_oc=Adnc5XtAl5gUvSav0wb8a_h1_PR9K7blpSHB860Z16dkr5bQQ2IzHBGIRsg7k74T1Dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlzncYeGcfOZmhujVW_zNtagntsrvfyXE8Yn8rSBqU3Q&oe=69B95F57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
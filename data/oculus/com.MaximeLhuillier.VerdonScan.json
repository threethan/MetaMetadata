content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0ykj6c1v_kQ7kNvwF2iDj7&_nc_oc=Adp-b28DfdSTUNOYi8AvIn37YiHSditMn3avg7TKmgKskEHTctu3FTJiYqDgufqdzCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTas3nRN-SC4WIaH-npawndeW83bJaRHh2Dp7ePZONMIg&oe=6AF7153C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03FwbOKq5DUQ7kNvwHVXlkX&_nc_oc=AdrQOVa9a8MI0gNR8p4VKoUbxLbZJJkdJlgqgj6NeWWnANjuFFw2b6BS-8n3csEl8Bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_6b1kp2gxYUxvjKXI0enPKKzLFvVT2tiBhoTB6evFJQ&oe=6AF715AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn6lSjGeTl8Q7kNvwG2F9s4&_nc_oc=AdqiVK-ymUnTR-xJvaO-H_IGlrwIW4On7jB3cbzwuvroLlFsVXwhNucjSHWsJDu7bcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyaW3TKgCzlBCkqC_gILSlCP2p0yqToAhkGAuEH8rneA&oe=6AF732E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bRl7aeHmrUQ7kNvwFdqDOl&_nc_oc=AdqrrnhRQGJiRJlD6QN3N1H1185lYqOS0-zInpJBv-QKbuTd1wj5Kx1v0BYzP2CtaLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZvxj-YJDmbAbKLCUq_NdvCPwxaiHa-saVQfjUiiw4kw&oe=6AF73962"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IaV89-wP5AQ7kNvwFQG5Kq&_nc_oc=Adqyf-NQyjvI42SHhBxwZJgZ0UBp23sBDJzYJ7TGiXqTyj-bUUQUv0Ll7ctNKnv9itU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh9BIXDJnS_xviICqdYpYKMqhBhqaxQBqt1ybcFMWBEg&oe=6AF718D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
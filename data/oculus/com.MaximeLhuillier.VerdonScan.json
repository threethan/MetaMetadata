content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLYAKkdQrrwQ7kNvwHFwhHO&_nc_oc=AdqsWpbvIGFe1hoR1_k8bPOg-5f6PLyWhGaiGsb1yZA4YsoRhZ6cdJ0NWCfmTh-WeiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlQlG6qLlDp0o9-F3SwJ0f8crmwp6_uS7TvzXN_Q_bUA&oe=6A5B843C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJmCOPct4BQQ7kNvwENLRJt&_nc_oc=AdqCzy1sL9ufDi2UkAbG6AMcXceP9WBOHBHlindOkrT4HywOZ61yjDHAPLQ05_ZsLIs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0QeDuRmC_m96StWWzmdmv6hQIh2b_UNjNWIOBfOX4zg&oe=6A5B84AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mShokwFx9VIQ7kNvwEk4Pl7&_nc_oc=AdoJ6UnHOpz2_aJwFcP1rdAHTObMUHWrb58A81cYyYgEm2gvz_ronsY0IkzBcqH4lBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrbWw1KLYMGudsucuV61qQ6jZSyazAbzhEyQ-mSAhZyw&oe=6A5B69A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF-wRo0ZagEQ7kNvwEcYDzX&_nc_oc=AdqCvvNtOrb_1gnW_17nQL1OwycNJWpzbCXf4oRZg4mRdXPw3zbT8K3aq2gmOpKIbrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQlwvuJ5mWDr68SsVMUfDBH4_gJKg0K9k8XAtFaUkEjw&oe=6A5B7022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0Dr-eKMYacQ7kNvwGzhxtX&_nc_oc=AdokkOn2xZE0QvQwu-2nB0nJPj8azaCglTEiYSdyePx3M9MJQblVkicmUVx1mpscyek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTKioKUlLcjCs1WF0ID9JXl6zYtx7ZNA5vfequAq0NUw&oe=6A5B87D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
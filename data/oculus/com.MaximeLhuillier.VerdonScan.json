content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8_2IcdrJGgQ7kNvwGzAbje&_nc_oc=AdoHdGNmDo-HPBz3mv4uLkKU_DEWHNmFn9SK41_iJBVl4ZtAgKWmwFB6Jc2WXo7XxWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJihvB_UQxZ3qLHE2P7WxqeHeRulR5EzMGKdllpJONKzg&oe=6AB3D8BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqMYHCLQ-p8Q7kNvwGxvIxD&_nc_oc=AdqIDdzROGZef2i7Bd2KmItc2RL5Y7vEP_SEAwJ2Xh896DsVSEwDd98UwCV_iQUUBkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ84ZwXzfIpruiRMjKF2RdWH8WPf8H1DyHm1-smKCPD1w&oe=6AB3D92B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsjxDmj7qi0Q7kNvwGXwTOa&_nc_oc=AdqWZCJ7ZWBhPViKfMx75wOkxvHLpwdFIBNXssP08EurGoXU69yGX7r0hqRiwuN54Eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn6LGdnrRYnsl_Ejk23aPKk6fZztOSLp6JSAIf7GnC9Q&oe=6AB3F669"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7G0gtzOxc4Q7kNvwFbSMrD&_nc_oc=Adp8y-r7W-kLG9XLczIb4QX0Tm0duUkH1CskZxDZaLv-xsotbQ3JEPAEvwspbkRPEhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEYU-OgzCVba4ZwNp39Z4IhqATDF36x3rvm4EbLqMGrg&oe=6AB3C4A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xFIqlBS--gQ7kNvwE-ma5g&_nc_oc=AdoOOm4OIpEHfrKh8n_7cyg3WC5TNCVtUmWZk5hdQ04JnNGGZyA6ctG35ox_NDGBjpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0akgYzDq0o0YfXPIlZyGlmZ2CPeO8H2nrkQGxA_02sQ&oe=6AB3DC57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
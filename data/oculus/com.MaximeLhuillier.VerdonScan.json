content-fra5-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVKtU2sLSmwQ7kNvwFk41oM&_nc_oc=AdopgWDX9pE88B3G4BLAVihxxFtwm505PwpQ2s9aDAzgXFi85opH9B2_oHzUvYD4hUo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuVggw0M1IPdJSPXsWk_3VdPiCCn5n95BL5zKHwDFopA&oe=69C7DC3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfkdZTh9mrQQ7kNvwE3Ilf1&_nc_oc=AdqpzrZ7HxSigEEmRA4aN01BK9JjIOrwNLtvjfgCwLkX5bUiR7-c6M_QJBbaRxJZgZI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwnz0EOs2yYKzkb9CQWMzmWagw49EHu-FCs4SDiXRBlcw&oe=69C7DCAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ3JMNreng8Q7kNvwHDHRPD&_nc_oc=AdpKW68OMo0I7EFLwMHQuGdc-vXi4Q_O6olY0dE4Mwi6er9UZSGkJ5RkBJltiKSz-tw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXnxwNCjyHq0J8R0Xg7BLI53AoCLhKo7AMsEfc3n35XQ&oe=69C7C1A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWEgxgdb0uYQ7kNvwEYkOxP&_nc_oc=Adowl6xuDP03AimtsbHkdoqXy2JRlfiogp1fGY2tunN34bLZ1Md8nU8G7bfAMRTQPmM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyg8sBvPM1LEQNxvp9rddlLABn7KI7nfFlRC_ynHdhaEw&oe=69C7C822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--d7ZHNGYjYQ7kNvwElMuXO&_nc_oc=Adr5CvkcsiS-x7jKHGBAPyF3y4WiGrZ953jdtH53cOa-LqVWpk7jd1K2-j69LBuE33s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywD-maqI5LbUnOnQ5ivNFBvjXJiVhqLHZqYq5LKz5l3g&oe=69C7DFD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-sea5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi97jXfHSdEQ7kNvwE7FcU_&_nc_oc=AdpalvDNLAjfn_nRRyGw6cBuYN7p_HESeohZkyCJupFucZ0oGcuz_0O9EjrO7a6N-PY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95f3L1uW_w439iez66e2dQI5llfreJaw7VWKYCIylqyg&oe=6A451ABC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBxfKH1PeW8Q7kNvwHZAqpS&_nc_oc=AdqJMFAh5xxtBr-VbLKKuTYAKKKw4WEsTko4W3zswgXiPYpBZBJKlPQbMvzyxCV_l_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7TCJZj6OpCUzD1ukDCErlx0TAiFnrolphEYt4MIsQbg&oe=6A451B2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6YYdT_wGogQ7kNvwHcgX-M&_nc_oc=Ado-h212b7R9RKJ-IfObg3eJkvLAwX8pjbVqvkCrMOhjFI9ihYnopglhJ8f-5IkSfr8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yA3YaormMF_6cDb5nCL062TgKlzxD0uceB5H-GLYAWQ&oe=6A453869"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmJmyPx_VTsQ7kNvwHrp2QV&_nc_oc=AdrdDyz2fYw2tHGYs2-WUhF83jM7Ht4mNkG5R-s-2whaJw497qpvgXf4w9apjbcXtCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v8xD9ypEU1erV6veqPsy-qUs-5C-6Nk0SgxiQfZd96A&oe=6A4506A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTJnix4W-LwQ7kNvwEyTEBg&_nc_oc=AdqjYqkleq91x4jFptCMKwu3Bh-iwXyT2X-OtS04hmn8BZtST9TF1xp6ThMZREAPkEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QZrHOOCf-J2LaKWgEr4kRzrj9dx3SaQagkgeTYNKs_w&oe=6A451E57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzy2L0GEL84Q7kNvwFBZz9Q&_nc_oc=AdoOJGxXMPyC76Ir860ZDLIdIYMCMIVbHvK-PjZh3XULKR2-BDH5v2vYYUfjtNUXLw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XTP0IeqwixzwBCfnEvc3_XmxHjSgfDsdMTpm9FwmI6Q&oe=6A3A8EBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiulRDDceVsQ7kNvwGfAY18&_nc_oc=AdpI1noYBvY2aV9kcUL2SH3DePTMUpor4DnAiNF1NfCw6OokA0-sJhIzhoWj1xxPgJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6iso5oBdJSXCu7cua4vNejaCKAs4h_Wj9fVILOFAiHQ&oe=6A3A8F2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSzeCTvgh-8Q7kNvwFHhOwg&_nc_oc=Adq_VGw8bi6iqCYr3L6qhuTNCLo14NcAWHY5KVZ4OrtMXrJT-CI8rwG2OVdxtZnyGmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DBP66AJGbEpAl9ybJcQRv3Vxxc-fk1xmdsgekD3NgEA&oe=6A3AAC69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGfaxCGB1bYQ7kNvwGT4RyS&_nc_oc=AdpdkUrzRGnPWd1V84p79UvYSFa1IfhNj0D2fYh9PXk6vEqFcYG1jjmHf8loLevFsNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pGD8vGuNfAADovtCdRNlaUPHp9oIG7a1V9zbOIyz3xQ&oe=6A3AB2E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYMLE_AtO6IQ7kNvwGrEVza&_nc_oc=AdqZlybg9cEeG0yN9U35WR-PS-NswEgOyjNI4m9sy54_v2GBj5DWC_-X5Jb6HLQ7l_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-IMejrCqpMezrFAG42G_8l6oQ16CCN6fxcdS1yX883g&oe=6A3A9257"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
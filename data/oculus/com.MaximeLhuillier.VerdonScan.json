content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBXJ-9kceCgQ7kNvwHjdS88&_nc_oc=AdrQGq1Jp0VVd6XcCHJhBZCGEQMr-vX-M7eFFWmNLXZcO-ZsbwUcwF9YrYL_pOYxvV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1AMc35QqIzw0Q4nZJXDDLIS3-YQBxTsC0YOGQENBsLw&oe=6A75E23C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAfP5_0PyToQ7kNvwHL-cIJ&_nc_oc=AdocASwqEoKXg1ohbYKQnQ-bF-Yv-IbrBv2hiyPYqHKps8BbibUyGEyylQ19qTK5O4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH196OZJIqDqGnpUMlkjOTvWM49GZjpAJMYNsDMaScBHA&oe=6A75E2AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skFlTf0jo6oQ7kNvwHg6Cz4&_nc_oc=AdpxJtknKQrhMKWDcsehiTND1ff7EfxX4hamUsWZyZs5tvmbosArptNOOC4Vteys0IM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwb8XqQ-c38ievTeW8qAu2GIANDZkgQsjlyEz4SmkGkw&oe=6A75C7A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pdvuMhuBu8Q7kNvwFuTYZW&_nc_oc=AdrPbekB1tFhKtKZQI0yV7Ipsf0l4KlDdyqBZ-YuOj44GN60Po_7mtV7MWoAxuzMXaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpiVNVzEoqcxGERuSzK0KYp5iXdqklw_dsMQfVppU-bA&oe=6A75CE22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wJiTgJDjigQ7kNvwEmCeuA&_nc_oc=Adqe4JZFq5RSzNupFK-ex4UVDyirhY1PXH8FAcvilMvjE0qbRhtjpp6zokEWKpQiMkg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQCPoH7G0vb6wICLOwGJthmbFfd63oRiQikggLqDoueg&oe=6A75E5D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
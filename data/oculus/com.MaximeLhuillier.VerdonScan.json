content-atl3-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FxeJMmL_JIQ7kNvwGKP2k4&_nc_oc=AdrDOgWIfYORLucxliHGGYDfKIN-n3gAiv_zk-GF3F4R6-eKue9EgAAeUM3TwdFd6zE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZvdQLVlTV8OVMzI-LYeMwicU0yoxzBVOKwBciPsIA5w&oe=6A41263C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p57GDSwWWYQ7kNvwETfgMs&_nc_oc=AdpoVbA6m1Q84r3BBK_X_ufO4z-NeiVkwmQEFqMMBHMD5ymMPdzrInD0oAfL028G4gE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zY8t0S5HgagdpHuglt0-xiu9gBpCcR-SlBrK9nLvoNA&oe=6A4126AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmK1Q02KRNkQ7kNvwHTKh37&_nc_oc=AdqH506npaZX8-Qe0k1mTCMa4zedKFOzHusk6W3nC5pQwo62GpzhfG_UHsWZS6ov9n0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N3n-R1BP08JEfQuhgOj3vXfWyrDtsWP8JJflrSwR3pg&oe=6A4143E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rVzBizkRiQQ7kNvwEL1h76&_nc_oc=AdoUlfqfiUa2BzVvh8GKOB5Qly6Pb4_ZniaHtkVhxGRjVUYrCDj2R9-PebflVqtG7iI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4BH9UdhmHhWjr3p5xzSdk_sqLxCOMiQ-znF88wKnsAw&oe=6A411222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw0s8kGat6oQ7kNvwFctGuR&_nc_oc=Adpsu5sg2RGi6KO1ZzhWARGEwk6vHAi5gniJXL7hmj-kyHGeOfld-CHZ8Un34m1Lr48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ADDYjABZh_vE3MI3p33k-4SqKu5F0ZySyNFY5ioU_Wg&oe=6A4129D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
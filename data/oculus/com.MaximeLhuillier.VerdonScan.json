content-dfw5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wopP5q2zhkQ7kNvwF2urAk&_nc_oc=AdogXqKd66brI1KY03YozbuMZZ7HC0dx9mg5x13ssuTXeZWjIbBXqqG9CujCdTNBEcA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UoBBIc6Dih_fMWdA0zmORZm0x6NXQMQE5QTmFLPpUAQ&oe=6A26C83C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl-BV-m02RYQ7kNvwFf3wzM&_nc_oc=AdqfyzaxM1uqTQOxMDEOJtjcU35pa7epG_ks9n1s90q3HRxjCzigFMLb31eCAM5Uie0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t24A1lOl2agSZ1TnKetnXZJ1RCOWBHKwPReSwijzD1g&oe=6A26C8AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXguled2KH8Q7kNvwFbUKPR&_nc_oc=Ado1rSr0S6hsSPlURLqI7ClsskP1cIQUm-hRXc_UZLWArvgkc6nCdY_SknPPR9EnbeM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BDG4IqGDqcOOqmQMOnD72cCBnhTpy2zS_Lgj1uzcqIQ&oe=6A26E5E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYprCkAXVcEQ7kNvwEsC1dh&_nc_oc=AdoUuVAz-BNqes9aYKC7bJBxt9SD3Zw5R23MIUfNiQXdSEL0xrPBxeedcDno2yffi2Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EMTeOIIdtN_KTlqxb3HD3T13w8ZooKWWXJXftgrjn8g&oe=6A26EC62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5An3HVPYSqcQ7kNvwHbALs3&_nc_oc=Adpe-vUaCKSTFLTEdeYdiEwY2gUdCxlRKe_lc2YDgW-v_TdE5SyLemblgBPMnI91WM0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--uVDdDGPtG9vsXwA6c3VBd0bpVEqr0H5BJnBtuah6dg&oe=6A26CBD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFArvpyxqkgQ7kNvwHNlYHZ&_nc_oc=AdqEInwBgytKIn11jGY0p2qltnni-PSUPTSx1Ct1_8fsZxCeIru1-6ZXlVW3KnrOuUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5Fk1z_AjyTvLmIisy6tpziBBFF-mVS0Yo5fpmiFE6yg&oe=6A4FA6BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0vE9RTNKCMQ7kNvwElcubh&_nc_oc=Ados9FedbCSdWBnKNpsJI3UdtLbYwYEB5qzqkGwtgGK8LetOKFkgNmq40SpM12WXcHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaJlQcMnEAjNZEzrskjPmC9d3cfsWQsk63pSo1L-zGiA&oe=6A4FA72B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2g9V45NFU4Q7kNvwEUC6KU&_nc_oc=AdpXjGgerkWb6YyT_PnnN8YuxeFoBoguBn7hPL4XIblPKKsr96Ojp0UkvNljdc4hOV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE3wTy3AYEB1Dnq6gUr2ZBzYQ14CM4fi4GlGhcqMtZjA&oe=6A4FC469"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPsCj_ZVAKsQ7kNvwG3tBAB&_nc_oc=Adr6cgHkbvadav7yVyd_cLr5wjpy9GduPwDOGEkC383NsMmaeKpEYxSTw5v5H1nuznE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaqRYmyXe3blP669ubowPGcKShqV0LewD0gQ0Vl2Fa1Q&oe=6A4F92A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezj-Okz-YlAQ7kNvwEtFgks&_nc_oc=AdrmRLucGRMIzjMCg6J233LfBjC0KCKNRau0YBvSL-cFvEUJnDnCSipzUfZt8tOqMms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-9e8m72OA9F13u4uNRKXioQAhWnec_mAAmKYj_LUBrA&oe=6A4FAA57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
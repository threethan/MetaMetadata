content-dfw5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR-1CQEkzFYQ7kNvwEGWzSs&_nc_oc=Adqy3c1jCXmUmabrTh2ftGC1D-1a6bzUx21WiQu7W96pBaU2efe82Al1Fw6j25b0STs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUQk0C9ZkZZXFw7N2orPjgGJEFCgAbAXwGwpRN08Y00Q&oe=69C5393C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDC79eP7BaEQ7kNvwGmfJns&_nc_oc=AdpfGhHsR_SfzwZ6p2Sy6z9xb6mXSc9TYmPRSmmeQl33idbqEAJbt7LbS-3q1jHmH28&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIACOUSBXclrsAcgy67Y9rbuz5Z4VTJMPNCjaR4l_npQ&oe=69C539AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs90c6RKpzEQ7kNvwHT7mKg&_nc_oc=Adrak6XvDeEEcCMKp5t7o7jZ_b6qceC_BuXiidXVMP-iH-bPlTikgudQ25ixNigT3p8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGt-BXor26peKKW5wQ_pwVnJSdFtKpccl2n_QPROHcnw&oe=69C51EA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWEgxgdb0uYQ7kNvwEx3Xm1&_nc_oc=AdohJLyEeTBeiba5y_zM6TAhoFSv3FDTbCVj3HqbThjoMIyZTG-GUVjL_zYcmh-uJwE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwR6hBt9OKRnhLwSRrKOK3Y5k0GZmPXNndWP_iAIlF8g&oe=69C52522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcZe3EM5XPoQ7kNvwH1QR4c&_nc_oc=AdorNLe2sPOVjXtaWrxtpLN4wSD9gJXT2ZDnZoASIZyQ91Odv6r2Ppp2wM06YLWsdVE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnoauoMizTeXS--QUkopnPuc2B-kcoMIaGYWOKod1lUw&oe=69C53CD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCrzhoi1YbMQ7kNvwHdL0Xd&_nc_oc=AdmuNU2mwMxt6_SLnDFjKVBGjCAxoEvZQRq-4uAdAEdxkVRHUw0MIyZX9utmtKGVInE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwT4r4gGKJDRTmyxKO-POSz5-AMrXxImbFUlgybF9iUOw&oe=69BD503C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ry4ELlNjvoQ7kNvwHbdQ9V&_nc_oc=AdkV0b9GCJzZqbNiSDjLVRam_X6ItoihrbzqEiEWvmWMHRlYX9PPMdgOc89W2tc7y-k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmQMnq3b4Jr0YVuR4JD22ekci9PMY4EBS7w_i5YlZp5g&oe=69BD50AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erfwPX2ycFgQ7kNvwFub2Ok&_nc_oc=AdkSbAu_19Ps-IKG9-qVLIcRJXuT-RtF36cArpx5uZXaxhTZPG6f4MXSO2BjNexRj9o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwfNGmE3JeVbSuYjt6vwI9IUwc_isnTcBaghGNoadqtQQ&oe=69BD35A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNKzo986tfoQ7kNvwFJEG2S&_nc_oc=AdnW1ywKejixAUz5jol2CYHIQxrRHNaNOf6VN0iwrKI2OSuvfL4xg3tqI-1gKu1exuw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSPXMhfpvA0UGP6DpEr9wQrQqiXRigiFknKKPEr2c6yQ&oe=69BD3C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1xBQuu7q1EQ7kNvwHtC7wI&_nc_oc=Adk7vaeY1xuwEa-c6NS8GpxADjucg6oxDSD7l3EUJbZUQrm3JnP75Jsm9HKUQRVgalU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjABZpEzbCctgx1fAva277tCam86l_ZZPaB-h4es_OKw&oe=69BD53D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
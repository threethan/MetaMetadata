248820165356", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEhvCXWadmAQ7kNvwEvHPwV&_nc_oc=AdrNAgMxpfdT9Y43ubNtrOlv7lSAMMBBLarFtkmMx6rIb6xQBu-jWVx-RTL5C_bws3U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-fxeXQTWvYBk74EmwGMG1VAEcHvHCVZTzeAMwFktdnQ&oe=6A8D64FC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ0gAwMzWmIQ7kNvwHOdqZ4&_nc_oc=Adp10OUVRray9VgvUkvMR_5Yel_Mq_wZ5_kum4y5Zwk9P1_jo3-JPwy5iVbu1PWskCg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5aI8lhtssSd4KzJUdkRbEQ5rFt11wlYxf-208xz4JJA&oe=6A8D656B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz5qCAPm2s8Q7kNvwH2uAcc&_nc_oc=AdqYBiborLRPnvEoQd4CKpB_sRPUijgEPGZVX9Ic18su3jmRCexypeR73zX5BGGLtQE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx5sms-f6nBGSzjOTPRKlJ8jpHRSU7ZMiJ-LLZHvA33Q&oe=6A8D82A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-a04Av9uhoQ7kNvwEHP5nn&_nc_oc=AdoDQCGdtRsPtm97UcfZFPgNZ15ZFxxGSyKEJRcbvD0h3LAjEGTzhPLboENx49AUafw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhIotBEznICLtvetYHEI3KbGhgMCXWfTnqJdHzWcN6Zw&oe=6A8D8922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGO89QvrFX8Q7kNvwEjdX8r&_nc_oc=AdrPP2pKAThE-2lPkMkxUs4tKLGsEBcu20s0fWdykMvFIY3bJevr_9X3YnHEXYScf7Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIi9WzEvzenpbtCruHzYnNQpdyTBCt7ucApVPaLjuUkw&oe=6A8D6897"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id
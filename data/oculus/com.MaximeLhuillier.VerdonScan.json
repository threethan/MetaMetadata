content-atl3-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR-1CQEkzFYQ7kNvwGgHBZn&_nc_oc=AdpY__hd060-ToCwX6X_TqPkavpjtVnG4IEyA_ho18bi0_4z5Xr7yU1ZN3Kkyeu-n2c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afycvk1WolySyt3zcgxwmzZJ-rL6mSqi07TJ0wIg_kVpNg&oe=69C3E7BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDC79eP7BaEQ7kNvwH2SMDE&_nc_oc=AdqGCd53WvJv4Uppllhir1168HCkxKWQjK70LlgqqBtOC5Fm56itkXWVP_s19stUtTM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxosGsQz2Gd7Lqt62oEaaU06W9jsMhv0txqT5jXlxFuVQ&oe=69C3E82B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs90c6RKpzEQ7kNvwGvJfa9&_nc_oc=Adoqg1vw9cbC2s-DunIdEyharXSERuN0AB3JKiz7ZaekakPqDaEgnZnpRQ2D9cUTj34&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaA1tKl2_Iir0tWfM8HQzHnraOUDTzY3dpiU813_5Yeg&oe=69C3CD29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoqLGgzRH8kQ7kNvwF-GHdX&_nc_oc=AdrVRKejiImQ_-OP358ccM2itFtASk21Zb_IQJrct8-qB6GLbVbDd2SB60kbBpZ9r8k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWHbPt2VNsCE2ATLQQKOnp7W7F72RJT3BoS0ZD7S-7-A&oe=69C3D3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcZe3EM5XPoQ7kNvwGwj5wl&_nc_oc=AdrD9SCQwaeZVdZKNnnRWDBlCK_OGHloYhkGkFQCNOPRMuQ2TAtFPPUi80YdBHq1YHo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWAb-7BOxF6NvKpBdZKKn0Qk-wT_jWwHwU2NA51bDCnQ&oe=69C3EB57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
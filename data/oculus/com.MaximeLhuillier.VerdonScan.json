content-atl3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZuZqqCcdg8Q7kNvwHjuFZ9&_nc_oc=AdpAlC9OrexOWSiWsh4247YXxuOqDy6D92EQpgGpzvV5CmMzX2QMuqogS8ypDfLEFgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMAhBs_pNv-Ormf2UEPRerdlsHCOv8cp8YyAQBE2HA8w&oe=6ADCB73C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frCxtbgNOioQ7kNvwH2_jlP&_nc_oc=AdqKwM4qU6anrdkzxDrtG9rjlHTChCAZHosgxVWYQ5z7CMCJh_YmJYnk5YW5PXoYezc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWEqH7t_9dZmRiebDo9UOiwUuiPPvVptgM2L2BOzqAwA&oe=6ADCB7AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvselvTC1PEQ7kNvwEHW1tm&_nc_oc=Adpk4QadmpLq_tP3MUmzaNkke6k7ntgWUxWkhyyrV9VJ7UwPLEMCKSpnpR3xrKculBw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvUHHpr_D6DZnCuIYcSESRqlzFcc6qFw9hW_GMLoRPqg&oe=6ADCD4E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ST3HAil6gMQ7kNvwE-CVgP&_nc_oc=AdrlECJChrX3K0ajWGJ4oDboWgryVOo-CpWRJ2SjO9Z_f-eLBymoqqh1Z4BYBnXaJns&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGPcfwxcuk-CMUC4qy6VwGxDfw8ziNVgtQOM98dmivkQ&oe=6ADCA322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8BPiLHzmnkQ7kNvwFDFy3G&_nc_oc=AdrPRi3N1YS8FceZSMC1x3tlBZYoMJ0OeZBbYFM4He61NTGMxxkWvFgjyRawpZhnPEI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLruSg_3dHCvuX6vdMd8GHl6lAm3fdR29MuOayenK3ag&oe=6ADCBAD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
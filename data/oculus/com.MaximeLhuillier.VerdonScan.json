content-lga3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1LvQjIDvPoQ7kNvwEAd0-R&_nc_oc=AdqFywR4qqTCh_zlF-G17m8pR_5j4eXVTT2J9L0MlyaDzMknyaf3KE8gOhnp56GBmAE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FmUkwFjhf3YDgJqaGt4B3yY2Ya805hfnla-cpiB2aGQ&oe=69E7803C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_EbYwR5jB8Q7kNvwHq4f0N&_nc_oc=AdphfQ8eYW1i_VQauSNL45fbQkolOY1F1otyKAXkwDrPbfFe7g_ynm4vDYHUEwqolEQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ha_z7fPhnPc3_nAdM5naUyXroFWIzAxszMwJr7EAc4g&oe=69E780AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz0cvtT43Y0Q7kNvwHo5NlI&_nc_oc=Adpi7rsfUW_C7VjP-PfDYw_M5KejlqurcnNM-4jR5oUFOXVv9FiDqxXktWuSMT_0Who&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Oi4TpwSumMqMoAesbxzEofGDuXkMnq0t8oVlYglbTqQ&oe=69E765A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHwcuCC-onUQ7kNvwFUmXos&_nc_oc=Ado9n-e7GATcsFWjjWHmoAIBJ44SnNSoNVT_jt301rMb5z_YN3zJS0YJJGyv6YKKjzs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DPpVzeHVYvO2_ZcmGYTmoQHxJgelrOvG8oW3dule1gw&oe=69E76C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aPH_0zObQkQ7kNvwGX3PfW&_nc_oc=Adqp3JhvkLIPMTG2M-Ijzm2DHWdlRWW9h5B5ZisYBeMnugTAZu4O0zWCH4J6Znc8bBA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1quz5vxATGYDi0JyIO9re7e4GDFuaVGrcbl7LyO3B-tw&oe=69E783D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgcDe05gfXwQ7kNvwG_a4HM&_nc_oc=AdqrLuIjjOsoO8mcQbDWgHHh_JCzikoxBe6RXAdgyjP5FbWlNxEue2-F7GA9vu6FP8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwD53W15hYV2G4BA4Z8CAYQ-lpeiGvNRjpa3UFI835EeQ&oe=69CE73BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k84GSiJ-fHkQ7kNvwE3OGq3&_nc_oc=AdogmLvJpKbbxk3fWU0H2wZWomCKzVz94-mYrTpL0jpCUznVJHsuMcjzl5wuXl4VqOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1roz2oXlg8ElP5P4Xo1w0Tl7x6L-la5XkJ1_JpJFvdg&oe=69CE742B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7tS1yfjqUQQ7kNvwEmo9F_&_nc_oc=AdrjlHkil1eAetRqZz4RoHx1gEH8fPV7p65dJ3QKGy5VyrathQCIFE3mAUqPgx6wH6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2PTDJaY9F3JGZtrNOcmkvOJ_WeD1AOGdAxfM790bR9w&oe=69CE5929"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwbfhBo2r6EQ7kNvwGb4EGC&_nc_oc=Adp3UYqp0pR3a_Wp6K3kCAs36yow8Nopy97rWMMMvMLXj8P3tTwadkCKCCpCmfrsRHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx38BPaDzgXuYAvM3cBnqsyssufaa_KtYg1PTT4yH90TA&oe=69CE5FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66JO5Q4DQocQ7kNvwEHrExH&_nc_oc=AdqogAQ1toGbR4_w1gPSStkMDZoflj7fS6tBLeP2o7fi4LY5AuBzPp2KufuPtEybC1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBma_te52LO7gxJjf7b5kmDkkwUwPNc7kdNQHrYVQYYA&oe=69CE7757"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
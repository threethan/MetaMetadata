content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFTQWvuWXfkQ7kNvwFNl9T_&_nc_oc=AdpyFBaEsT__-hcaJRz5D0bW-1_Zdt_cnv-wDvxagY95VKjRGwQi_tCZ7vGTyXwwB6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yrevFG8BLCw7F7qKp1ljbW7mZfqbHk46RKCbACshRrw&oe=69DBA2BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f80xBlKMo-gQ7kNvwFL_0Oq&_nc_oc=AdrrPpe7eRG2J0bAN68XlWh0eus6RZBaPUmJ5zuE30xmnKy-jxP4mP6kgT8Si_4Jjoo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2t1Rvf1V04w0Gr3_XbCLoEpUCrsnp2KAq_N_oDJOV_sA&oe=69DBA32B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n89Be4mXL8AQ7kNvwEq0vfk&_nc_oc=AdqWJ4JVWkw0v-n_-rxFiliJbQlmCbHPp49Z4eTJJ1n3rLVjbT5M-cdMoPZCvMm5Omg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bNE_dBoN28zfrdbqpal3klrTSBLOQBcEviHp0d__JmQ&oe=69DB8829"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ9eVJQoqOMQ7kNvwGVa7Ej&_nc_oc=AdqfUA-C9sLZVKLyAU6IzXN-ZRUxNE5piKhArJtE7rFgoSWQAt3CNGXEChJdKQA0pPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J93P47837nRiW4hs_d-UsGtO3pcsGKKiZqCSXPoBSXQ&oe=69DB8EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjBGZWl2PmEQ7kNvwGhzyJn&_nc_oc=AdqKtQVdVAvvPftnqPaZsPH4rWl4ghSAw2GvGvmcOh0ks1FzBfqUH8MgPlBaXrNgtc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AebWL6drjklb_4W54ixKyf8uvoFTTmHLLaE3ZbW_qUg&oe=69DBA657"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIvMRiqyYYAQ7kNvwHXdj1x&_nc_oc=AdpciUc_dLRH2zQqfURM0P4K_2XjR0AdOJmvWL1TLF7mMmEanwTcX7pMyu3cqPfK2IA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04QhZiX6ExSFgUyAhprZ90IniX9SXlcstQLalJLFrvhQ&oe=69DF973C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzfqTWJ_RSAQ7kNvwFGaggR&_nc_oc=Adr5zM5pg-dOJ1zIUpc7cz5RCaxVMxNCQgabfGHtyKoSVqMQqo0losmIv0u-EEf4tyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BNwRKV9yk9IfGJ772JcNHHLwI5QQ9RBc8BIaXjh6QQg&oe=69DF97AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mblIBBVCk7kQ7kNvwHgDuhX&_nc_oc=Adq3H5fcezaK0Iw2T8ywpC41qtcvgBHUPVPQjJW5B8v-y4m01hzw1Qp6tI2Qi5-wqj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Csm2lbl0aQz7B1ZrpnWRdgyNyNDH-OCYiUh_mcfhENA&oe=69DF7CA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roylF9rRfo8Q7kNvwEZFnL6&_nc_oc=AdqlNiVsBQ2121y5W-d2bP8TfaDW1LvnNM3XvpoHxEStYU_ufq3HdE_MM9qv36o7x1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bgyfaPAR0XiQ_1SYhN-4XYXwdyOKiahzNcRFJEZJYNg&oe=69DF8322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mcvuwrftTEQ7kNvwFSt96_&_nc_oc=Ado7UK39ewsZM1C2DqigLHdwDy25Aw-PiNChluDOakoB7rk-KHcbu-SBSwnxg_ZKQds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A2z54aerWKVel9GG2SPheaS8UtI2K85BW_dX-3F9ErA&oe=69DF9AD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
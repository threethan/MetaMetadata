content-dfw5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Jyk8XrOGSoQ7kNvwGTb2U-&_nc_oc=Adpb1OII1qLZy72s5lGJxcJNNlS-tU5NMKkRG-1dmqzMdcECdfzzfvD5a-0En3UTz0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jc4xB9MMgOWBi0e0lfF2c-KV6bXSaqDfbgzogXpOW2Q&oe=69FDE9BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYx6V5zgdsQQ7kNvwHVuEzV&_nc_oc=AdpPaOyqYf0CjD0HBxsAxttoGtww1LJSXhctFpFupOGr9zTE1aVH9cJOGJYVHLrjebo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RAz6AdFZvsFMNNLybKQAfSwviV_V6pSOHLBdM8Gg6dA&oe=69FDEA2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNdqk701IWUQ7kNvwGfxMkH&_nc_oc=AdqkEvvtRdgclHSm31AV5S7FKXNK9gsPe-d8PronfGPoUx0m432RWwM8gUeLaEnP_iQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mm0yf8XEg8Qcht82Uy-NY7ZMwQ-z3Hygikh6sh8uFpg&oe=69FDCF29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vVy4U4XRSwQ7kNvwFS9Ibt&_nc_oc=AdqoD6BlBTwjiO_UMXTDU0RE7ceubWetxT_gFdDN9TBwKBgHpMu0dmGc3zFbi9T4xgU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TegVRM43DmsgbqMZCs4-ue_VWKX4ffzPgA4v2MDx4xA&oe=69FDD5A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dl5JSRPA6cAQ7kNvwG8M1tz&_nc_oc=AdrPSygbLGipENd57WH7bEhLY9vcV1DhBRn7J1Q1qc3oDShBpIU5KWk8RSP_jH8PdZ4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J81yocHu8uGQ4O4PgYHkp0P9YMDywVomkK9Y8Ix34-Q&oe=69FDED57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
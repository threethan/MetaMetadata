content-lhr6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkEUxwxLcPkQ7kNvwE6jq50&_nc_oc=AdoDjhGII9KhPJNK8QiazbhXP2O4oceRRYjlTNKF0Sjt6V3-wbFig-0xaxq8ZBSU6ww&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4epRym25o7IiJnfhTOZnOxOULSIXtbOjTYWGscHziqaQ&oe=6A105EBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY6KcOBx9PYQ7kNvwHlQHnz&_nc_oc=AdqwVbWKfb4i6hZk5o4Upa4YJihrgWsIYaEhCqwV4CmCNUrJnwyKpSFbWpgbI8GPzTM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L_7CZUE5UaBJe3jQaZFQRs29AYLMcq2WIhaSUhfbmzA&oe=6A105F2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbemdeCCt10Q7kNvwGPn0AV&_nc_oc=Adrk6wQ29J980OEBK_fzxBTxhTu5rSNOh4MDkI6IuZ_7aFyEHZN-BmwSXYI9EExh1J8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44Ab3tUVD1NwiZAqoFXGmxiDFYN6vtBdUMxb7YsYLeLQ&oe=6A107C69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l99wQl8rnMYQ7kNvwFzMce3&_nc_oc=Adr-sRbQvDOrBGzEeMq2ob37SaALCupEYwOeoKUe7izOemiedpB8n_7nxHuUk-BJw0U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XRztNi9tOYUmDsSXJt48Kf2M7GUlEa4BDlVJSxIctTw&oe=6A104AA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFZA43Qq4fgQ7kNvwGHy7mc&_nc_oc=AdpNqaTlmsuOBFElx8YxiDXspxUNs83_uTrNeYswfgK-pQ1fqMY8ifxTHWIgUYmtTTs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58h9-3nbJdjgRVFNr-hxOtDXHAn9vsX3DUnjjHmNnATA&oe=6A106257"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
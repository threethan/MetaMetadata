content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biJ5c2l1ZtMQ7kNvwEEznz3&_nc_oc=Adr4YvNHgqIbpwC55vlmXsi3Jcqvm4qJj2_UfF2-pkPhzFlm_O93NYBLI9_nX9ZhWl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnGTk6aBtZdK6qaW4z3oBzHkEvoBIlUcJ5lRRIA4EHBg&oe=6AA5583C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCDBWWDm6PAQ7kNvwGuM8S2&_nc_oc=AdrOE2txG45u5AuCFS7qxI34wfzB19YZB6Mm4crBsO8_hkNPuoxrLMgYnGCzpXFNTWk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnQ06D2MtQPU_cg6Oy_iMWgIzGZ8A6a11X_MdAm0hH0w&oe=6AA558AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-4kKUVw-4oQ7kNvwH-xG_5&_nc_oc=AdpQgelpwS2F4UWvLCWcGZlnLvyKIgtk_tw2wt8xDaSaBjfVZ8bv-3TzRpptXrJZr9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6BXLvb0tZ10aWIT2W9a2YsEdBjgYS8wpkaejYoS7FkA&oe=6AA575E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTng2V1UP1oQ7kNvwEeRI7B&_nc_oc=Adoj2hUJzynRl4woXfjjLcYRALL8dfawUtnUNGf5TX-lnyBOvAScdUAKT9sj10RjVlw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNklCd792nkbcECI600ameADwcoLBMTWkPHc3lJKyZ-Q&oe=6AA54422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBoMchVxgOUQ7kNvwG5Lppk&_nc_oc=AdqkOtHIwJkJzj9JNSsHBBm_0It8xxyohJOlzrxgTlBtczQF5BvvoHfvVJlMyfKZewM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwAZHWLBXXWdD9lp2v-0WWDEgCLChFPhJn5WSOxpL8Zg&oe=6AA55BD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
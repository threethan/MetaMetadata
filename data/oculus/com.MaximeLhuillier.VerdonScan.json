content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRfKO7ZZLTkQ7kNvwENFYKz&_nc_oc=AdpQTIPxNdBV19EIWlp3IclBGvSzFhVmGCn9wT0Giq4U0wCERNIjO2IEBz_GdQ8IRdo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2CwPS5KejvMbXvOcKhHtgVnkf6gP7TJkQcVkrxuigqA&oe=6A9D6F3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-aDABgiExUQ7kNvwHfrkBW&_nc_oc=AdqCffTIKOP_2JDhiTQ7B9OSRVzi1iqcTxqFRPmxY-0bg2J2NZpC8bPu5j9Sc5sZKnE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK4EwBUc7sQ63whgBfTVKt9hXLRTXLi6pwe4qO-gCgKA&oe=6A9D6FAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXhRfUTn9xkQ7kNvwHnoBXH&_nc_oc=Adr7W1AoKZRPG9PQbkJWYdYkgyyrNQwY9FQ97dID1AGdoAq5l_wJaJUgWH1T-MTI_N8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICtUH6b3S68mLVqaUT6__BvZLGWssK7QzOYRWdKTrLNA&oe=6A9D54A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=134ID73p9aUQ7kNvwEUEhEi&_nc_oc=Adou9ml-oO72UriQZcoFzn3DQtEqW2VUVXGGfgW2p9-POXguTQWsQeHP-UW42-g7Nc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-1Bvj5AqGP_6FVqX_i498A34dJ4NClOQaM23znuRhGg&oe=6A9D5B22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0YsNGLgt9EQ7kNvwFWp-PX&_nc_oc=Adpw8SxqsEkIUZZU_Va1zxC5tPdP6MHNkUhM7eh3-2vhzYKVdK_LfB_wgFIm3tbGsAQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkNKg1aY9njXqYR321duI1gpedL4LPeorI8Wl9L0cSBw&oe=6A9D72D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
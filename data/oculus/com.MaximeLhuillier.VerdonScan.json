content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPW8qVtjfFQQ7kNvwEcL0Ze&_nc_oc=AdqU9hbHGdt-T-U2WSILyVqq0EVF67y898ckVvaYjpkGurAgevaaJO9NNxLcrW8OWEU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iw0P1_3RdkSSEHrw0Sx8AgQvLG8sXVvRIkCN0mlQqNw&oe=6A032FBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78gW6wiyt8MQ7kNvwFM0GyW&_nc_oc=Ado_vUjXrD4rP4kqEp0JhYqwgbf_RPpZyP_8lJSq7CppKbvNXXmT7rQFrNE2Xi6BnlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P6Evak2GRejdcG5BQ7W-pyXmDgJ3Ooe_A0wf8I2nk5A&oe=6A03302B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPjRQvZBAr0Q7kNvwGYlfV0&_nc_oc=AdpsY44gVcM0UOdrY1wOF8Kcw_Z02alP_XZpMzFFckmpSmI0uGUeOj89KcuMWRkVnBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xZthfQ88Dlclda1Sw4n3esdexyDF086t01Kj9qJFEkQ&oe=6A034D69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXiLzPetJu0Q7kNvwHIN-E3&_nc_oc=AdrzR0gLWLE7af54p_G2uvaj-RuicBPA36p8ppa6YqslY3pGX5p6RR-0I_Z6jUSAUl0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-c2rbbaIBmRSa4JoAvAjbY7dPKd20lSNhkUAgw0zkNA&oe=6A031BA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNGfX2mdey4Q7kNvwEZPbHG&_nc_oc=AdrRDW93oge6NIC-CXjzlRsQ8KQ_r0AKqFjabDOFiov9n1VUcsxK_Jq070LpuDmsSyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ew3Wj21KYYGGFHeSzAAMt0Gf57toV2699sgJXi6WVeQ&oe=6A033357"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
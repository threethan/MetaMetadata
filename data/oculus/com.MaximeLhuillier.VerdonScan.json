content-dfw5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkEUxwxLcPkQ7kNvwGo4Ch1&_nc_oc=AdofowiZcqacjns_o4MzYRlOhgr_E0Eg6P3JIBKKKuaIfPz346Mi1-8Mrdvgd7GES9o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LpJDwt74Crkb3IoMEaTNQz6XvJkdONjE7nqzXcVAxMw&oe=6A0F0D3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY6KcOBx9PYQ7kNvwGYvkBA&_nc_oc=AdpGGUMo9EIiupTCbm05-wut2sP_jnIOw_SM6NE-potiFlvuyscNLfoJR8zVvvBr6rg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fJ-F7z7VXOuA-PlezsutokP-8vp6IMLekoKyIn65OXA&oe=6A0F0DAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbemdeCCt10Q7kNvwE0KD5g&_nc_oc=AdoPIhBsGRpVwVY4IRz_jUg2ugXobJC7-7HDP-ec4FG2P3fQjbQ9jF42vWPc9-UHH0o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_yhL4OH_HE0K_2Y1cFPyxMqevdmI-_Y7_OuTjtRkBXQ&oe=6A0F2AE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDFAdOEyVoEQ7kNvwHmVYH3&_nc_oc=AdoOtyT0VkjYHKCZh1Qa2WeO880gTLgV45gvGVhyGSp_WI80xwcGPHfcIzzqLoeEVF0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vS6Y5cxBuK0q62YxMUYHtN0Eotul3_J8L57e_CVn3Zg&oe=6A0EF922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFZA43Qq4fgQ7kNvwH8XEHa&_nc_oc=Adq7EqN1mec6emG3TKp9D482JPRT4pxWPQfAYEjDfAhXDP0KJMEZBTVmTb3i8osV3Ko&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o6rlZhozFxBtS_BCB7cj7tvuOzicApfHYTzG6eJKNNQ&oe=6A0F10D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
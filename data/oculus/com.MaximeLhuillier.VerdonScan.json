content-sea5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkNOaVQASQYQ7kNvwHdGeze&_nc_oc=Adr94V8rJvNVK25PGk0BStw2JtlGUXcuY8r1usZUhov2IeVDF3XVb6DdXMQt9J-9ytc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKwjZ1M98Cgu_yBjeVe5oAlSat5NVFLJ2AwvajOawLeQ&oe=6AF07DBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7H253KDx1UQ7kNvwEWx6-U&_nc_oc=AdqaOBjTrVAPlJfp-7pk3TU-T_uVsx8reHCCdRe1kpfslqe2xug5vNsNVXXB62Pg1zg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrROpMuRPK9-XKoHCyxzXedZ6Sgs6v7pdT6j4m8AyLqg&oe=6AF07E2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4-n6y8fFy8Q7kNvwHdaCjA&_nc_oc=AdpUY_gI4eh04viOJRcnN5Ps5s6haUVnuJ7PHVwj8Bqts_W1JtqClGQ4Qr0THrR5ecg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_P8ktUy-YYLM-np6VX278GZyya6Pydg3VapTBIBInSw&oe=6AF09B69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dBgXerXYjcQ7kNvwEAY1eJ&_nc_oc=Adrf0Oc02OiVjQjl6g6R6dKJBg-GJOFxTOqD_lMb3y87DdG2LfHc1ykXVIDZLXWxcn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2jdlbFk-3uYEcHTWHZC-NE5N5fU8w34vtdulRTr9Tug&oe=6AF0A1E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqmShQeWjFEQ7kNvwFdhu8B&_nc_oc=Adq-ecrAP7P338faZK8vHg0JEmufPd81y_9nOmK4Oo2wT8oBNpRBATNceksPNOkV3ho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT19Fzsw-ToggA0L2wP35lWSQbL9y4u_5HdjzFP5hu7sA&oe=6AF08157"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaPQkG09T9cQ7kNvwFJgEf7&_nc_oc=AdoZPAaw8ZTXMlvaEmI5FEpnwkRxHETCA1ZxyUJWR5NXBDqTyFC8ItPHGZ7XRhvidTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfnIzVClfBuoCkjYzRW5vYYfboGiyYztKFk-rBOLYBVA&oe=6A7F1CBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7-9yi_54Z8Q7kNvwHpSccT&_nc_oc=Adq-SitVvKiSO0ChqPpR-Mw_aXnPRNUwah_ISmTh4JOAGOfnEqnOzniTQ246LxtVVCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOWhcN2kCBvdFP8dY8J5QEdNqbs4eHY4IP1j9Y4Jtzqw&oe=6A7F1D2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTTaaKVywPsQ7kNvwFNS7kr&_nc_oc=AdrsULPoQMdNxM_7-bzKJoYq7favjdgKk6hbPCFXUD9N6AvU6lW7TAb1zuvi-GFbiL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfCpJoUJAblOW4USDwkgS6pkQfJgQU3xmGca6kAAyhtQ&oe=6A7F0229"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4_Hl0fsRH0Q7kNvwGnrkZx&_nc_oc=AdrwB0-72ZrFT08tZfyaJyaQpHEarSBUpIg1vwA5G9xexE3pvJ3SjpyzHt4vCz1dsO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLOVrbepSyEeqSXDTCTUqboYYMR8GOuRbi2x8t414eUw&oe=6A7F08A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iztLBoAqaU8Q7kNvwHb3N4F&_nc_oc=Adpu3_gaZJ4C_dR8ElcGoyBw0gAPDFOKCOAK0Pxml7d4WJTECByq6L8BgcXdQ0JAwsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKlym-nJ-OaWzD8EIxgBW_EPtXqnW8p8eL0SS6ma5oTw&oe=6A7F2057"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
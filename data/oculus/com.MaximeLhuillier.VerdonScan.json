content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ6IQOZM-wQQ7kNvwFiazZo&_nc_oc=AdpNxwSDOOjGWgNeTB2Sp0-Pb53anwMM_k0YSdeF6f-pOkXCBUNZ0BUY2BTpZj-k9oQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vqWTuT6Et4PUhTQDBJbtA1CCQ9jCUkVHgru4XWAI0Pg&oe=69FF3B3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYx6V5zgdsQQ7kNvwFsqUr-&_nc_oc=AdpU3STPLK_O-gBn4of4sTmDZ5jObgxKu_gWx-wPT1-3_6yIQyjeMcPzn_652HoolHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qd1zQwKYg13HM4JdbIOvgl3klbahBziAklhHNTO0QdQ&oe=69FF3BAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eViIpp2yaT8Q7kNvwE_1Q9f&_nc_oc=AdoNdqigwPHq6aIdyTeGz86cR8rG4EX6BS7QtbHxF-Bd_w_ysUFTYeVacEscjct5GG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-VURfRuEsmYMYol7Iz-YEj9MsacpVp12Naa4M0rdmpA&oe=69FF20A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vVy4U4XRSwQ7kNvwGhzWb9&_nc_oc=AdqBDHv9-HZnOSMJ8w8jn4ClGiYYSk47EQvsmxqyHmSWM_JPH3NDONFhemqYFYxqk88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NXZDcN8BkNqdxSPAhfPuyInKPnyk5nASCXfNPKF1Nkw&oe=69FF2722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dl5JSRPA6cAQ7kNvwGrwkJx&_nc_oc=AdrtNKy4ra-9YQUK6czVrLYT0iYoN7WFxtVs7zelbopxrd50G4MTF9lp59UmP9mB1Vc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k-YZ21MDP8RIgYij9Qf1nyqnylh7QC1ue9wJxynqwbw&oe=69FF3ED7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
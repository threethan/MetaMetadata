content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1TAIZcA_egQ7kNvwFBHV6z&_nc_oc=Adrd-75bGYMwdBLhqj0nzjx6hZQ1DcOJz3TVMeuvWrZDVYvXNkHV9PtD3xn2YZEmbV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINb2FFx59qTa40UvF1VBA5JZewwcybHAStjDI3R-CPUQ&oe=6ABA703C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjNhNN0E17MQ7kNvwFqlYm7&_nc_oc=Adoe8NLWDRQ4ZkNXY8EikivVyv8EXXOUdzNI_ss2JVIPVrXaLVVtkpU6p892gK9eK6s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAMtkhymART_-i7BTf8yeiIyW6tgE7jvjJzcs1PGfFDw&oe=6ABA70AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yuU5tU-dfYQ7kNvwGIqmxH&_nc_oc=Adp7qMdU5O6M1ejYaSTgX0wGWnPm-5MXyhKJRCL-w9UES1JRb8un1ZOgiWsMGS8gbIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqt2f2ZX_i6LiqidO9KH39LV4Xqwb29Ho4yqvOzbezvA&oe=6ABA8DE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vJuM3ynksQQ7kNvwHosNWC&_nc_oc=AdqcLAFdRhLZTGq2vuie-g8a723Q5zLfbnfdhwX0Q6gLwbJT7cSNZMohAfAycFxJR1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqu9dfcJU3OR-ZApLvT8Igm-5MhpSxXXoE4erUDtEekA&oe=6ABA5C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ell8UNi58ZsQ7kNvwGeR50T&_nc_oc=Adoa2CKGvG8brtzNvZNsdhBlpU5fWtN_jg8NkM25dp4gae3CKRof0DPIbcKoK65qF3w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEmS-T6ACoje63Naa5W8bAUlnQhKEh2APQEK-KCK3EeA&oe=6ABA73D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
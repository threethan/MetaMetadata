content-ams2-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFArvpyxqkgQ7kNvwHvN3bB&_nc_oc=Adr7e7pSAQSSdNFjjXc-t9-yzDnOv3AVFeAWmz0p8wH_JlTycy3wu5-l8qARRf_O_3g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvVF6oO7qFhGCeU-RVB2V0J4WHkcVMXMH-KF4tt63ZXA&oe=6A50F83C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msf5KGrHTTEQ7kNvwERmz0w&_nc_oc=AdrYSux9RF2__LNGJDVz9rZnn7f0uqe_0n_bCWzYO4nnmu1rxg_NA-dVGX8KoccE55E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk6DTHbE4P0SCjbp0XQg0G807oKRTNXH-E719U_BZUow&oe=6A50F8AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2g9V45NFU4Q7kNvwGPVH3S&_nc_oc=AdrgfvvT7VmdtCe16RCvO7Bfkmc2HWogyqQnJaeFsj_y6DpU3zGzp8MZZXfJifHV1Vo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1FRE110vkxmJOdL4bPkD3pQ44niJ_t2V-8xSQOi3djQ&oe=6A5115E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPsCj_ZVAKsQ7kNvwHSt3mw&_nc_oc=Ado683J3TxCtiNOs8EvtLey3WPp5moRLgI_V86reSpWV7TIlEmye7ChDi6e6n3woYZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2waFeksJjv3haXOFi8pYknvehlgyM2hoCDiDbNTdqHw&oe=6A50E422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rUJrYoePVAQ7kNvwGuIgTv&_nc_oc=AdrGBGq7ic1rIv33oINda9jahwCrhtH2VJfLZvOGL38-mgSYyDE9SXYvmMLsqKKCSIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4hJF389jOaU5EvSYwCYEtDXKPZ0KejhNdF3TcmR5_UQ&oe=6A50FBD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g7xDr0ehdoQ7kNvwEvmXpr&_nc_oc=Adr5CxmXzuNYXy61lxVJkJ8uUBPAnf9aPrgyT5CtHqyW7zxu84yBa3XNf4OSJT1VUos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1QTALRCI7v3cbkEtX25ORqf23Pl_7uQ-AXakTKZhuNw&oe=6AEF647C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7H253KDx1UQ7kNvwFrwwIi&_nc_oc=Adov2TiqTbhnpbyP0bcmq33I9QmHR6KJXzutNO87loLFkNWOr6jHnRK9BltrzWxDHhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZYFDyN4P1XqvYUjFOuxMEeXWSFFxD06n1KCimvgiHgg&oe=6AEF64EB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSKC8BZdoL8Q7kNvwEQjx-e&_nc_oc=Adp-xX5CroUlojXUy-l9ZITDApnDtaSXSoiGQpERflmBPXuuNWnXSL7drVfkzV_w5zA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIbdDXroZz4DGBNcXkbTTYyKSBm3oClJYAgFkBuk3jQA&oe=6AEF49E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dBgXerXYjcQ7kNvwFnm9HS&_nc_oc=Ado0c-oSmHalFYnOw4X5F95pfgrDqTv-3tzNapGmnZJiErMMAGRWqIpuk2BgnqAomd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuHEl4IOflIZsJW2_uULETdpCjk1-pdF0VruGil7wuUQ&oe=6AEF5062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqmShQeWjFEQ7kNvwGD7a-P&_nc_oc=AdqXaLmsv5qKW92tpnvYKbIl4leKGfwxzInTPrO76i-VdpvcqwmNzhjH14qs03_qlWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlZd10-XO1hxpN455vduN-TIlQWlCO7VDp4nffabWYug&oe=6AEF6817"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
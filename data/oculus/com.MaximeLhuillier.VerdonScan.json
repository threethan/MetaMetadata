content-atl3-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYWdvtLNMZoQ7kNvwHlEhIL&_nc_oc=AdpxR6PXoiqHWdy2ZI5DZ726_pqSn1hqwXNFtQPqKlVV9_luqcgQqE4q3ph_0h6rt7A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoSNVMIpvJCgwSSdTtReBEgD6t-JaxoyDAIKR1RzlIqQ&oe=6A71EDBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNYeSJi5fFsQ7kNvwHADYw9&_nc_oc=AdpmVEeVYwlzdw_ZPiehboG5BxEY2DXtACc_uaR_iGrZC4sXwUHKaZu5Wa67XuP0yQI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLA7TFeDPUi7aJsCHvF3MkYwJGvEbeCT4lwyt6PAyQLw&oe=6A71EE2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2XS4sZktAkQ7kNvwFsXAOl&_nc_oc=AdqDkRjGxKtlTh-kGhz_u811HE77BiFSE_4xb0G22bSv8cEIQjeeN5EJ38RBPXjtcsU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN0HkB38GybDZ6HJIT4uOy9-EXKJ6QibmHnBdyFe9ksw&oe=6A71D329"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E41W_GYWwBIQ7kNvwHCZspk&_nc_oc=AdqFd3gIjfJmmQvduzNzOhbfUyb1hCxt9HNAlvejj_0sSqNTI9v25sednjQXCEZ8300&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnWeIcsDkubR3LBmQvSpAEt6smdLfwnyEEPVrpaYD2Ag&oe=6A71D9A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7Xl2UdvYAYQ7kNvwHOmV_i&_nc_oc=AdotBKEAH1d_B4dv8TeLpS5Q7tlxdkUWEUpZDywFPCtBvBLBlnaJzsPWTydJ2bS6W6g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVQTRCLjrDlZFbOPEN6T7kEsDI366R6UfTpSUAce0Jug&oe=6A71F157"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
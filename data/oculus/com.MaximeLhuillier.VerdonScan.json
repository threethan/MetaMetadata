.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf2v-w26c38Q7kNvwHsmWSE&_nc_oc=AdkiumTb6-m50h92U6QaYaTIxCJEH37f0ad33_hPkEkDR9fTNU2F8HIzKoWEAFJmKYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsbunBMQL3zhlvmmVBdnOXtAc74C5CbA45WfGcXVgGwbA&oe=69A8383C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5vlu0sNSBsQ7kNvwHJ9ol7&_nc_oc=Adnaf72-Ghgs64bj5fgT8EDvVxS08eeY01oU2LGRixfERxzGtY-yPo1cxB1zmWhv9lY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft4xAefGzhRrCoqs79C4DBarcAhZxLIBO6H_cJCi5rCaA&oe=69A838AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aqQape3qtMQ7kNvwHC8oVZ&_nc_oc=AdnOt7G4GNqZZpjYTZNK7Q9FzjwMg8xpIBwVT1ST75RvJ5wU-JBGsvt4Xdg_wfPdJeE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsSIWDZHdA_zt9x_fc08UJmJZmvSbaU1sogJjT2hAD9fQ&oe=69A81DA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GqBWOfnDbMQ7kNvwEA0zeo&_nc_oc=Adlz55SioWe6FhhgkHyDAu9xSRz2gDyY1P8IqiMgY_ZnYDUckpmJbrwQaiCbDmXh-jQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftLiQRV7ysjCmbgdDiKr7qqTI0NoyZjA7_CYU2y7_r1xg&oe=69A82422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyN_OcrrTv4Q7kNvwFVQeJv&_nc_oc=AdmycSkiD_uIVyRR1AIKIT8jtPoqzisx6OrecPtUKA4wQfPaApuRsqkjq9__Ful5zeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftE-9Rfztp-cQ2MssrJAxER0poRHIlCeLcLhvseNelqDQ&oe=69A83BD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
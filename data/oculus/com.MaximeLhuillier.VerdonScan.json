ps://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkEUxwxLcPkQ7kNvwF1HeQc&_nc_oc=Adrib8A3XP9qxukn2r24vx0Htdv2Ush5oRoJOPJAxrFXcLfiukYD6FhXt155yf9n2IU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l0PMJTjLVknN5Q1VYzip8UpSztUiQQy2Z9kR6Xu6K2w&oe=6A11B03C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4qbNC4ccnUQ7kNvwFfy7AO&_nc_oc=AdraITI-MHQkiqEYpJJEVY5WBdZsRfJBBSWE89XExY4GnqjFlxtZhCPHT9lelRnSbE8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4du5dQCLCG6uxMY8qwvpyTZqUtuciaLrqlH8ueaDNXAQ&oe=6A11B0AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbemdeCCt10Q7kNvwGF6uDS&_nc_oc=Ado4_o4u8rWhFVuRE6bu2SfXxoXeHnOiaOIDR6G6oHf6n_in8G3IumggFl9tp24PEus&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R904tL3wkMnhDbmf_SQ-2YZY5Mk7807dC4q4Y14a-4w&oe=6A11CDE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l99wQl8rnMYQ7kNvwEqcDjM&_nc_oc=Adr3BL-ISJ_WnEnDbr8cCPchTxCWZG6SPaQhA01_3-I120p1E435OOmM9cx0Q-sd8as&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P0_H6jBi66fBETqAHR08_-laD2B6XBicygzTfVyY2Kw&oe=6A119C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkpsVVkG8ooQ7kNvwG5gPtu&_nc_oc=AdpwzhdHCzmgHMfJkOGyOhVUU2sfb97vODlsTHrUQVdLXIF380sdhHVus5vhJh51Cog&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Eaqzl6go5tdGkaPPeaWNLLATIxqj_-dR7UUHUYQQvSg&oe=6A11B3D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "exter
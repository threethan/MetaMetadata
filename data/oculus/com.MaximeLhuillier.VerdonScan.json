content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8aTlU2sRlQQ7kNvwFAOpSA&_nc_oc=Adp8YVEeagEfcV1bduAF0wrIqVrHzzpr4mpMKqsbQSjaaKzdbTzYmVbq1JrHTRcQ6N0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ_MeZ-CrOtqwkkV_HRnSQ0eZBH4if4S5RT8iRX9g3Ow&oe=6AC3AABC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIfOwBrEKsIQ7kNvwFWZk1U&_nc_oc=AdqjR51XXwCfMT1pN2A65ucOORx4aCNcHJNhYkEkJcz5dLms2Af0GRe6czloHCwTItQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiJZ1NLe3rV-KY0IBikqpIeMEC-843nvh6y_oWO2xlhA&oe=6AC3AB2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqff2CS2TBgQ7kNvwHB-UBp&_nc_oc=AdpNz4luocBK9Pqq0c9QJqBiumKCj0Rv-trtH_phcQFUduFvwb0fl9iXz-V3bDJHoKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZQJJzmFpoL3D9qz68OobnfssD03ocCtzbRY_EaBT1Aw&oe=6AC3C869"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VA6tb_NfPYQ7kNvwEB57Os&_nc_oc=AdqYQB_37GyvEf-WNx87clAjbTpWS_EK8qCVRFx32r3frXEkS0TmobFTH4_2XKRPNGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8Qsa0bNxVEN_o87weZBJOl6YMXbPUQG_JZ4dGQwgReA&oe=6AC3CEE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5jrSfRNi90Q7kNvwFC8MrY&_nc_oc=AdrO4pGI2X_0lxrs2ZXdTQ85A_hDjHK-Eyfl-eLXYfRikTDLxkje0KIbW5rk4hO4ee8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtySbnZB92S2s84hMqtF8JapP9HFIXtD6VxeK69ymDqQ&oe=6AC3AE57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
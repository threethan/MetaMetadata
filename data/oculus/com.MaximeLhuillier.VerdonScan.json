content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkNOaVQASQYQ7kNvwF2_9Q4&_nc_oc=AdpRRhBTiQF2MyQnpQJIsGjRt4DDyZcGIBRMzrN2M8M6MI8PDZMng9uwUaYP5IVYYpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrI8KI4WGqIhYPeJRp1Etrrme9IagpWA5xH6ed2FZf9A&oe=6AF2077C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7H253KDx1UQ7kNvwEa4zjZ&_nc_oc=AdpWPLIh8gtQ23azRLXQ1CZ7b-a2GQw4IueDtdZ8NaDRwaNKJ04UDd8Qhj2w816Uqlw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREv0vNTvj1CMewkPpNAGFbNpRhHNmnHqydRP1iiteD1A&oe=6AF207EB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4-n6y8fFy8Q7kNvwFqGDRB&_nc_oc=Adre4lTKWCAYk9GKkiAh06bBP4d1CfLBtghtjYWuf-NnUyyVe1Wj3-5SFJ6BY7AeA-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLaWmACYeN1LavAeEgmJgIutHW3GqDTpAhH-AXNiCtzg&oe=6AF1ECE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rLrjjQ9OUUQ7kNvwGzopFs&_nc_oc=AdrjWROtwylVsr8YMYGP0ATQg8uOsxhtc2SEE-Z5Zwr_XnBs_OWysODt4Ekeh0sX_VI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvg3cgnORwX7JUg_AgIGRDxU1Ko9RglTVMNvUynlmpEg&oe=6AF1F362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqmShQeWjFEQ7kNvwFK5OBi&_nc_oc=Adq8U197AQjF21lUdkz1aWscOrbpSTl4HW9AUuArGzZFB5vISKgi021BOwebqa7cWbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv5FE-LI8ThIyPNOqHQZPXqtKtArUbY77GEyzjUwF3UQ&oe=6AF1D2D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
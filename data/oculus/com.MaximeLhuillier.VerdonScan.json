content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CWvaixnuyYQ7kNvwHUuezs&_nc_oc=AdolcV9nF3uDrEmwTDXskEISmkWDywVl5ZE1g3OdlVn6IZ6APDcukVU4P7oxFkXD2yw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpLYPBLk0uRXilG2ogLyRGKxTLAC_WowTBeNkmvPXf6g&oe=6A636D3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijnEHf9iSJoQ7kNvwE4e4VS&_nc_oc=AdrAAmbyE3kzixpnls_SycScqvNGpej3I-d_uhi6pIye_apxjA8ijbdFGSC6jKgRyWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfV10EPXC2Nj9SNAiN0QU3r5V4GOggcWdPHJqyFIKfXA&oe=6A636DAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72Ne3TFQCr8Q7kNvwEMGR2Y&_nc_oc=Adp6zx63F48NFTVkmFJhKFVNjg6L1C4KHlY1trA0-CnwrXcEzsYwtI1m_Jb1STVNpF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTs8j4NixWvOSQkEljrJylmNKoOchWgOkY-k8tTiARDw&oe=6A6352A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQwDjR95uAAQ7kNvwGDQcOM&_nc_oc=Adr6tYxqjR69sK4U8zu_t6-CinjeS_jEaSQnzc91EKfn7l6H3E9uZHb4xxX2Wc2cEzY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbWgTmlTvW6gWYWBi8XRB6oZOpGxFRWofqKsVYXLtowQ&oe=6A635922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YsTTM4xqD8Q7kNvwH_5-t9&_nc_oc=AdqX7XdWt6R2L2UT9wuYN7lCoHmfFJoTZ7TIkaihC5KdHDgig9Yk3VnKY2yClBGW8bU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzkjugfnGm1TBCuVPpM9AZlOtAZGgerf61QDBuphp8Ow&oe=6A6370D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
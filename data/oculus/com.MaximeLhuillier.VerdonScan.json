content-ams2-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wopP5q2zhkQ7kNvwHVSJGp&_nc_oc=AdrfsjAWLGdTZI_bVs2bX2LtkQbckDXesZDWvKBNOo3-6mfaS2Tb2VbkMtU2wBBaVn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XlR22gexIgKk2Hz4KMFe2DSMvpFfInSHVmts_ExwcPg&oe=6A296B3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld6uiVv5oywQ7kNvwFj7zDD&_nc_oc=Adq1WOQNnBPhq0CNB7hZP0Ah8xLLCM5-NrmvOgXW4k388xyMRu11QUHQ7FH5c-4Hm1E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DTj15LMpEyK2iPpDIeio9V1JTufPzEg9JrPl73M-LPA&oe=6A296BAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXguled2KH8Q7kNvwFSdRV6&_nc_oc=AdpsWm-F2_iFF9LHoL8XHv_FB4mKAhT4iSRSaxT-bElP-m3I_UuZEMCioOmzPtgUEkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ORqTMnHK73HGeMt4TFNVVYSsArpDrn3KqD599tumrHg&oe=6A2988E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hulSLcBAdB4Q7kNvwFE4zlc&_nc_oc=Adp0Ns7w6BLv2VbS5o91RwIA2gRbNsgaleo9Ow7Z3QhVJpmYAgxwLB0P5pZBsMsyfXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XD9_U0nHeq1IpX-zAFg3KJSZVD2j4SsLzVbQtRIznhw&oe=6A295722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhDVd9Xq1_QQ7kNvwFm9jc8&_nc_oc=AdoxJNywC0vG9t4TydOlSlXCBzZCgh1e0HdTqkHj6gxj_xBidRH5GW7su-0GVoPMAvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aketl9JX04Q0YFPNkFLrEISL-j3buGg-9ty4Iq2g4ig&oe=6A296ED7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
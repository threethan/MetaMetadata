content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wopP5q2zhkQ7kNvwEVz4_D&_nc_oc=AdpvkdvJUzv7W3VEbg_GEcsOxujvDuNIHKNe5PgZTXYWtR05_3Gkk81QoJ1T5oAo3Dc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99k5w7ZXIadtktqPKdNVy3FnqkZlGvcywLShzSB8vHWA&oe=6A2819BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl-BV-m02RYQ7kNvwFJEZ5d&_nc_oc=AdryWdk2k29bg_K7J8rie1GrvPjqvvuFu6VA2PbC8PDlsVQKP0xvCrxeNaUXe-p6I0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-btktlW3iseS6eyCQGfGmbrFxuW5Nhd2nUWTBueqV6Pg&oe=6A281A2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXguled2KH8Q7kNvwFV6olf&_nc_oc=AdpNTJWOBV3z_loOht_Or3fX3gaz-8-aRZAl1qY6-gkx7vWBZT7X_DeLWZzS-jq-kWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q6xx5pMzTOxteDKC4QDzop0_O9aiUcF9_YKOX5OmNcQ&oe=6A283769"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hulSLcBAdB4Q7kNvwHiCSvJ&_nc_oc=AdqTUG261VjzYv3SEzpB3qaio1LyN-P5YS4K8hmlbj9uY29TiXmrb8nvpYBC8hFZCIw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8La_7dV-Jghd5qWJwN3XYGcIVkgTFGsrFCKzaJOsMAZw&oe=6A2805A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5An3HVPYSqcQ7kNvwHaka7t&_nc_oc=Adpyr0gFxbqOs_YB9WukRtNLFWvRdMbFyfJ9-MQePLDVnjNAN4NK1ASEhWkiCOYEzZw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f6TTD7h1LDVzXcHw5i905fOYvlFyHwE3zmA7J2AZCLQ&oe=6A281D57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8TD-wyzn5IQ7kNvwHjPF4q&_nc_oc=AdolQrDD0OUgAKcbBitboflb2TB9dUQGgbG7JfORe37lJuBnbxv6rp_O5KfpWkCuV7U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRmUR8F3aVgX22IM-Yry8aw_0MHNyUeG3U0-iGgN35Ew&oe=69C144BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwrEP4qyuWQQ7kNvwHA0cM9&_nc_oc=Adq0qoqTDAjzhnt82QBUIW52JhPGKiHjx85EbRxO6uyLf_1LnmES4rrUd-5rrL6Utt4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymvrKhlXdZN8TCP0VQApyhc1ZLps61O9HlQk_RuWUKtw&oe=69C1452B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-v4hRnOeoUQ7kNvwFqSqWf&_nc_oc=Adq5ignXVBXFgM9IzkgcfbwldGdm51Ilzao702vCUipVJRsDmpnzqiWIkTGV7f5PI4M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw12QCw965tVDXfWNeg-AXIyASjKWI2lDkm8r3PFmM5SQ&oe=69C12A29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoqLGgzRH8kQ7kNvwFj1rqX&_nc_oc=AdoRmvzrKZVSCU4RfTNq9rv53LE9BV9iLqGww0iOmZ0lrSojkPfH3CyIfLl7egdL-bk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQoYXhaUWZhZ01YE_wfYJ_nYoqJEM4xPqlR_ZFQFfIGA&oe=69C130A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1pzxjS1-PEQ7kNvwH9apcw&_nc_oc=AdqcC8-gq8ja6wIyyqWwISZlPaETqUfOmxSG7ZGmcMJauM6XE69SUuWIDWsQ6p8c3h4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_tGqyNsylfmHjI9r7dKpiwPwaCKNj7s91mamgFmTfbw&oe=69C14857"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
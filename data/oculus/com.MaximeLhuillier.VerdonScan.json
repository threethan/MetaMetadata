content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ6IQOZM-wQQ7kNvwFR6n_e&_nc_oc=Adp1aVTPJyzXtW1ed4IyXFGEEXHM7AE7wZzRL_QdN6kzuOek0kD6Y-8-jKfUN191zAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zr7wz_cgyt_01zl3zaiAM45KWiV7AcUowNuXHek-YtA&oe=6A008CBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYx6V5zgdsQQ7kNvwGj0rQC&_nc_oc=Adow0o-VvFXy2SWGiF4HbW-VH8BCwR9uJRaZPNnaaFWoxTSy1_uqLBfg5UZjL3tqq84&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DjL_dJaixq28Rht3h3RfAkD15lCOdrSmOfQI-hPaPSg&oe=6A008D2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eViIpp2yaT8Q7kNvwGHdmks&_nc_oc=Ado75_uuQqbx1_DZ9IFzRHP95qvKXgcf4p1-roqzNIyAtr-lyX8Hug5tNta8AZraMqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60F5uAZfAHhCbUltI4YiUobwohLEA4aFqwL8m9nYXpCw&oe=6A007229"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXiLzPetJu0Q7kNvwHw1mW_&_nc_oc=AdpCmHCWjhbIixu17ekjiVugG5KvQUMa2VBBNXTVBn86P4_fAUoWrb4NaMuzftJRWjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L3B0mpS7pLNUFfMdK_ZbeRiXRdeamnQzv-yYrRxwwjQ&oe=6A0078A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dl5JSRPA6cAQ7kNvwHAVuYI&_nc_oc=AdpovyOmLzz0uI4QiVmrLsttW3etSBhUiqfQkaPWJ5F2vqY6VBgeDSqLgGr-Xs9xL3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oBOUYnwfC1WruGAPyyNmQeAkY6oSnR-R6VFn7zdzXiA&oe=6A009057"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
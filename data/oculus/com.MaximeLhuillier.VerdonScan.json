content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGm8gGRPbC0Q7kNvwE0lwsy&_nc_oc=AdrOWlui6K4thHCirVlvnqfK6KD5fT1T2P54dI1k2_ArMQtRYsLhzCmvOrVGOV-yRAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tWF50qNNtPK7ecXXqRXck52TEsC0gHMSawYIO6_Ciyw&oe=6A1D8DBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3pSsncUWNsQ7kNvwF6AbLN&_nc_oc=AdpKi6zMsuWmEQcSq6D6D4rTM5apqvcvcLEkQsfu0GRgBbaJzrd6WeOuYbkuf0nD-LU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iCjl8uyZgW-fxYZ6dUgdAN6lJj_SwZ3rjOweumcla4A&oe=6A1D8E2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox4-pAiook0Q7kNvwHQb0E1&_nc_oc=AdpBxIiy9RbogXbzIgqch_JaAxOiLFU36kZ8GgRiv1yPd-tQxpa-_gebkLTUpicyUFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NLd2w5wiAkHxrT6iEFMYEIFZELNYQDHcYHdf-p9ALaA&oe=6A1DAB69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSfFiJNMp3IQ7kNvwG0fJLS&_nc_oc=AdqYHNywyIHvKl1VDdk9wp8DxnpL15kuxhk7ByY53YmTo3pQu5RJBr4rL8us-Rmzh5A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oxKe0_Mf_cbbk_m7lTfKYpD2RdyBAAZK294N7Gz_fRg&oe=6A1D79A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk2T-9sK9fMQ7kNvwFymwC-&_nc_oc=Adq4sKHmvWluBpv7URUaGZTWPZrlERj8_ef4Br2mVkflTRn7GEPhvtJf5PvXsrtyNgk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cOZ7EeGEqJteV5C_R8_xe0NUjv_aD56y2rn6GriIuQw&oe=6A1D9157"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
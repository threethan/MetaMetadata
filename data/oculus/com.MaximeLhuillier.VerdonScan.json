content-ams2-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uamv0wSmDbkQ7kNvwFlaj27&_nc_oc=Adr0rk6Hklzw0isPSNPdxr3psPQiOQ1Dn19NLW36rZhASjBUStDE7wpGqvXI-Ugccz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsqNaR25sW02oBS3X_keBh-11MbvoERSu5zSigg9XjaQ&oe=69D116BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k84GSiJ-fHkQ7kNvwEo6Wfk&_nc_oc=Adq_xXgUFRFIT0BvibG9s29Aw88nPy3KNy-UkxZirD0GVLTp91P3UFCG8wR_jDGe_f0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6MT-pPP6WvUcVR23UHpn5m9tI5NoisFVF82MuLJGazQ&oe=69D1172B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3W9HqB6m0IQ7kNvwEgmHGs&_nc_oc=AdrexMse57G5IENpYfIkX5kjj50XF7ClK3rIkznEsEPVVBnIea9_WoqqYOkFEujBweY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxf8zAmdMxyADMChhGVJYfPBbb8FdYjo6-KJjCiAVLZmw&oe=69D0FC29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsj9NI3yyOEQ7kNvwGSeRxY&_nc_oc=Adozk8FFN8km4wjKqq4YRhBSqaUthIIUdfASNhq_LurzBxYuZFjOl2ua_mQiOxoJi34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHusIR5iuZc0R6Qx79Tv12uw5-a7VGFkwPMN4srm4mkw&oe=69D102A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66JO5Q4DQocQ7kNvwHFRrBp&_nc_oc=AdrA4q9m8jOuTXQ0JX6TGmzNn3c6QKd2DkNpdxN5_CEyHOTxxGO-b_VdN2jLPX-k5Bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRQzj0YtbdHwLqqTQwfSMfSrrGyaHLu16pvCR-PteiGQ&oe=69D11A57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
_AfvqB0J5ZsJc6SZ1-dJvsGfiXoi5HD3BPU2ns8fdDDZr_g&oe=69A443BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa71GP-szOQQ7kNvwEuhXV4&_nc_oc=AdkHsdPBlZOeheh3dCvFda9HTYiJuc1uaCKFYApUigWC4jJ9Gj9Pjd_ZXR2PS18dtPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBCYNbPPoDZv9UfogY17f4veIPb0vhcy1tBySKwSiQyQ&oe=69A4442B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA8AufCVMxkQ7kNvwHJZOdF&_nc_oc=AdmkdXG-8FxPpZXvFkxVq9mcJCsGcgkI8aNbc5PCfVq71p2AI7-bxmOaMu8bSMs01tQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfthJkp6vmCGCY6fz1vSECDfrPY0-tAgu4CW0P_skk0pHw&oe=69A42929"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsJxqwHXsJwQ7kNvwEAf9ZU&_nc_oc=AdkNTvhBbALadN--9SNO7QwpYJf6-qQuv_oRD2ABNQW9eJL4D8WkfQ1yviQArESTNwo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsz3NAlkuLvsSP8q6tBHNSha4FrIEkdP3OCDR3BJ2Wr9g&oe=69A42FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdwvcqgUgikQ7kNvwHGQI4g&_nc_oc=Adn-PEfsyms5O_uwTSv7F_FYPLpa5J_uFsroqJyp5d20oZtQkNAsyy1oOjAD-fT9R3I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsrZxybOLqZc_NMIhwrEEHOV-HsP3KorSVzoeeyEoB5WA&oe=69A44757"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
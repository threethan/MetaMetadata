content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9zL0do_odsQ7kNvwGm1NWu&_nc_oc=AdpwffG0rgsFNRcyG8jCTqMRPDwioREiTWWC92Git6f87bnylF5IszqpAmZpHhFztyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm2WZPsEEXijJ0cg5Nhme1VqCNF9QZCMttUIeGPMJJmw&oe=6AAA9E3C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftuFey07m8kQ7kNvwGbGUxb&_nc_oc=AdphHRw85S73uRLludUQciRs2N-g8jOF3t_OdO-0Kph5kk0J860BbP3YdejIjLmoW1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsLH2AbwLpgw0XLrZtEOGsnhi0HzNMcOObV2WJ6z_3qg&oe=6AAA9EAB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCRLIObrs7MQ7kNvwFZIAov&_nc_oc=Adp7y0VruvOqQ6conMR9-rfHtRWEJOAy6jlM6I9HAszJH3_bGLJuolWkRkdY5EtDymw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDsKrCZ0-WW8Uy0LQf_C2jiZDQgD6_aQJyxbeWVpbxCA&oe=6AAABBE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_Ze0fpAxO8Q7kNvwEVbl93&_nc_oc=AdqqdZ7eJMR9YQbkqQbZJ3OXVty2KUkXVhg_VML9-nG_8hUrNcIM8ZTqb1dlyGSFT0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLielbKsYIGcQOeS8MZL0Ha0CihJBdqwTruJm1ECLs9sw&oe=6AAA8A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cylVdv9huO8Q7kNvwGdTSc2&_nc_oc=AdpewVhOXiQlp7C6iMO9F__wzLNrSvU4Y2uxjN4wzF0Hakn87RDjoMlnrxEtkQ__Pd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzuF8Ug_UshJKEFzoa5WYAU7wpsdNCGgrYQgj53-DQJA&oe=6AAAA1D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
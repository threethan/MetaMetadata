content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzy2L0GEL84Q7kNvwFfSal-&_nc_oc=AdpzvjjsIsivCjavlKkCfDQ_OFVtwJRFDnjOozDlFJwyIKgB8dG4jc-qAbfRJLTHi9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y-QMo8-mnDJZj-MrXwk14UbFJQ5aU__jCykLkNPvIUQ&oe=6A3BE03C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiulRDDceVsQ7kNvwF4Zbdg&_nc_oc=AdrdH_KKxaP4VeW-0rr4fniknEXZ91tFjE3tXJ_WhTHyNexJPq0Gt7naNcBJHbhZa-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S_E152dTTrSqQvpx5214T7DBNbCRtTg7BVYOR7nH2EA&oe=6A3BE0AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSzeCTvgh-8Q7kNvwHML3Dq&_nc_oc=AdpmnyMt0Q_m7WU4IrStRRK_XRjFABvHZ_1UhPM8NyU03L9AXtLGjHm11_vYp3tYiM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9igsH0yt9xH76f3z0_FHzuMb9PB2uOw3_Tw26jRNP-1g&oe=6A3BFDE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0R7b3UpbIoQ7kNvwEJLpsq&_nc_oc=Adr3cRL8EhpaQkILjZ8IdqYlLoeeCAyUv050qBwFS5-nA5-Vzcui4zu-rQrJznzYgjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R1SbvZG-F11jtNrwMO0iVHTJ96kv88_q_SPcSSmiq2g&oe=6A3BCC22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYMLE_AtO6IQ7kNvwGN07a8&_nc_oc=AdqnY_TDTfC-GaXvvQApCQYWm0dDsMcrENJtr023nSM28_HDbXKjK3Hw5-2nq_OgZAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ztpm-p9FdvsDQXLlJ9FRqYxHYuMvERY0O1buSZH1g-A&oe=6A3BE3D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
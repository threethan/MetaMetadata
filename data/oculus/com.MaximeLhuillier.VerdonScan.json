content-dfw6-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLYAKkdQrrwQ7kNvwEbb8Vo&_nc_oc=AdrQPxbUHnEHi5n8tiXJXMtxBIh7SCOVSPwAA7wYKIbtO2YCJ6dt_QJuiXhqXbVDT04&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5bePgH8tmil15o-thc47R3nupUpx4n7LAf4HazwQhvQ&oe=6A5A32BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJmCOPct4BQQ7kNvwEQiui8&_nc_oc=AdrhcTtocV_poVhZAUCS6TK1ciIfvg1s2IveVWyjQzE6X-YM6wBQG-7kNrsn5KLTRNM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVqf-VdW17QbfWar3-V6acbqwr4cbXs038kub3lfBZzA&oe=6A5A332B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mShokwFx9VIQ7kNvwEH2zO-&_nc_oc=AdrntbuJX2ya-btkncugGFMo3jKQlwdhZk-zpMLVm-grXAcvT_bXIqAhXyjhDxOhscQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL57tKNOP-j3-_xa_aZrGiJkWe1h1PtVRY1pXbQDqaMQ&oe=6A5A1829"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYULPgqlrTQQ7kNvwH6M73K&_nc_oc=AdqopZ-ElUstMO4KehABoaTXRmFwVMjTxUiYDxneDRVZYo3LFss74N14ERLvXZcZGG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_C7oKUqdsw0SbBR0ij-JqfH4xkeGAJgXGDB2dh2Lx6Q&oe=6A5A1EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0Dr-eKMYacQ7kNvwHcH-Oi&_nc_oc=AdqS84Wf25PzLWrljyysoecNVsVSG3odMOByCBlUwsHTxX99kEorcyEMEE1w1P_HRg4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQdG5sF6kL576K8sT1Q1xUfuGi0WHEivH3F1XQvTLPMg&oe=6A5A3657"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt6oQOp6_KQQ7kNvwFqbaEE&_nc_oc=AdlftF7HVe73xmedT3OKlWktX5zodbBAYN_6KgtjopNEBbb7Fb6LeDSnq1ERGttDGo8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzd-w4RL_JclqctN-bbj9kmMh3LjoA3VsI7oE5TzaSLcA&oe=69B2C43C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8n-u-ddnCcQ7kNvwGavFWp&_nc_oc=Admx9Efe6hOe4gjVq_sapZEASoDng22uLj_4TchucfVrAcOxmnNKs0aqqSbAzTC5t38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWETkK99FmAPi7oLAnat1SUvDrsMub2mo7lClc7m3XFg&oe=69B2C4AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzN-Kl4XNYIQ7kNvwHF7mYI&_nc_oc=AdnB9AYY_iTFbCzpsNAA2EdOP0leqFJ7rvIMhybL3NFgtF7juZVgS93KmPfH8xFC7r4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfycHST0huaYcUCfDU74a5Y6d0QAObSlO06CD2aROSGouA&oe=69B2A9A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gus5sLljEJAQ7kNvwFsi_Dk&_nc_oc=AdkvpEJUQNTQtmrY6aw0YLqzUq_cfu2DAgHFbZUNrspteysurBpzFT0ATgO21ZGdYFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoZi_6jYqZZzhWie5bWh6GRvgHFX45hsQmEV2bfQka1g&oe=69B2B022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyWYI9_0h2sQ7kNvwF98yQG&_nc_oc=AdkkjIsSjMv5TCLG_2zNENf0mTN09G7KimfbmwQAPs2l_bfhW2xlY6svkixpevQRxL8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_RM5SNfobkh6xvxDGJ32BTZj1vNXSenF7VyNVta4PcA&oe=69B2C7D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
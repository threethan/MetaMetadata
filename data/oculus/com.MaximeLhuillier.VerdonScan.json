content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws1wd8uZGcgQ7kNvwG-13iv&_nc_oc=Adr-QhWrSnDZgj1WyJl1Umz6TF7n4rCBuLyJ_l8nD04So-LcVGI0bhn2U5kFwMEy62I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37M5iPAIyCY-GMwetk0Yb8xCqfy8_NKq-Hdqo9pDT6mQ&oe=69D8FFBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgHvMlTbSj4Q7kNvwFBlV5Z&_nc_oc=Adr1QolfxaHGNqVJfcOmPIcU4qAES-jZqFY4ZNVfvWG1au7rETeTawAB_BtXRqscZnw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HcbPZet7eOrdQS-8636Z7LsYuPKoaFrFh-N0ujBMvTw&oe=69D9002B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IbmiofNj68Q7kNvwEaEk-z&_nc_oc=Adp0AFe2Ynbg8aX1kaNqGJyNfzDLqdYJsapsSlJ99R2zKcKlwQaVPU2Ma0aFVTb4Jdw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tzyBHRiSYm-8oqlITsCaWVJDpK02Rr73DJs1GfK0Ndw&oe=69D8E529"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ9eVJQoqOMQ7kNvwHvBNZa&_nc_oc=Adr5EusGN6rlZO0gVyrouthqBYmnbHd-0nbD5PuncJDBxYaRXRKDvzBwd8jjjidO5-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JgTUqdmNVK_YHf9Dv8ukCT82xvY6TiIQoTJZk81ABKg&oe=69D8EBA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqHGP36pV30Q7kNvwHSj4mK&_nc_oc=Adr7Vq7NDTeEDVnvmRoyNO4udZHwtdxeU_tPvsgXqw4C-PPluW-t52t2omK9jNfc2YM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af308vVFuE2aLSiri-rWy0L7T6d0rarLI8v7OUaDqAlo_w&oe=69D90357"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
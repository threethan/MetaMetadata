content-lga3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5wykCU8paMQ7kNvwH81OO4&_nc_oc=AdpZrxA0Ew40SCPIGCPPTQo_8MTZb4hpp0mrGYqoEmNKUPvqOrcpxZM6f-utD4vllbg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiJoyzj5Hz3QSu43f0XwgkqfGWutSDHkl5qnFfIsskuw&oe=6AD0D9BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgb89QX2zgYQ7kNvwHyDGTW&_nc_oc=AdpSECkc5eGSjbFNmRnFNlXTm3sXG3o_MRtLEBOA4y__545UCBaxAUi0fu5GLmxj1l4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcZHGirdyfkchKtDQ_KgJ3kJg1LNUcZwzqeFRVvQkmjw&oe=6AD0DA2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMdo7yEW4cUQ7kNvwErlsQG&_nc_oc=AdpfaSGVyly_QvU-mJiYoBdwy2tB5cLaCIlfySDDr7rlMdEtuaCXF6YdjNt8dsS9G7o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIGN1rpe1JRityTbLrudIxbzKxB8_tWK1ZkSarhIap9Q&oe=6AD0F769"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXP8a-clHlUQ7kNvwGoMKp6&_nc_oc=Adob2bPpQzXZ-ji4vPfsmIAZoxunzAYXg4Fyj-7giHod4PwPCV655G5kTj7e_UQYBQA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-8OnxkHuF6R8ewywMT-aFhWTzh79X2zEvnxQIrgB27g&oe=6AD0FDE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS7bXzMAPEEQ7kNvwFQMfcn&_nc_oc=Adqyw_EWBAXjNDl6kW_395nj9E7RUgsxemYr6X-BXALVzLiAwXbrfPDPECFErftlpg4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ--OJbm-xIURB_03uYtrewaQ-aI4QXkwrXVSMD2R2Iw&oe=6AD0DD57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2hArfS0cGsQ7kNvwEaHUst&_nc_oc=AdnF_OjtBafyws_i-BrS_5MsmCM1P_4P194PO2RB4nm18LPNVqV3Y67Q0b_QbKE8tW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnAnPrr_URZMUEzsa_VNN_wWVXG7HfOs5O2bnGEsKsEQ&oe=69B6B8BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpvkSAkrtygQ7kNvwHaZ4as&_nc_oc=AdninRLcvl3rKK7XyxeztYazBpQVkWoCkC2-YcSQFYbXeGK3a0bAk93Hkb1ncf6jgiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKNbQEWR5EdwAwxHlK6DpLGvnKR5_KdDKM5LoJacv6hg&oe=69B6B92B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOhOOtThJ38Q7kNvwH2ph04&_nc_oc=Adm9ZX8vB4BOyyBvvKbe0IH2JaDp-42llKsJJPaCCvX1I73YXENoxTr7ya1wvPuHTLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4KYCuIAcYlcnI-ChVd2XQEBX8zWnbhs3emBmHsIP1cw&oe=69B69E29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hih5bYlPxxsQ7kNvwE0CXf5&_nc_oc=AdkEiZjubT4XyzkQ54PBhPjY8cYonrnEQMMjSnZp8or8eO-Szj0MhjrcgHV_3x-kSuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWoJZi4H8W44aQORXMT-r-f361_M3kADAZKAQsCaSFBA&oe=69B6A4A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf71TFWkKoMQ7kNvwEI3Dro&_nc_oc=AdkLWxjXZwuCYg81sRX3PI-MoxAC64BTcSY1UDTauEiXLcwvZ5VCkUgJS-hFYFrcSuo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4CndtnaZ0IXgfFFIrTOnhWdt8pzX_lEH5Y2WyJjRfZA&oe=69B6BC57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
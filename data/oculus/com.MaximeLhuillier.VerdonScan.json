content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAM_xfSr82oQ7kNvwHNlbBx&_nc_oc=Adppd09XDTgl6Ws9oZEI3dmDoPZeKsDN9xj4V02nug2wiw2RMj8N5w-sXdS6vd2yHGY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ajafvOdMYk0oht1pJC0M2c7_lcJHxGxcHqecjQYb1Ow&oe=6A19993C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUf1jJHeNaoQ7kNvwGncuU7&_nc_oc=AdqRdyvXpbzxdeZV9vEt1EsN_ANAUs9H1Zdn6C9JR9FA-FPogNzgYZw8PG1N-uM3dtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51Pu6dK54mQAisLSfunwVvR4EmjBT9NI6KMKSFAVjTaA&oe=6A1999AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6OcYaCY1iQQ7kNvwFBllv_&_nc_oc=AdqkpZP88aX8i0w59Uhw5clfAr91N7s1IssDDws8emU_1kX5cH9uStkmZj70nrZjwps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63BkTn0me5U3D_gRBOgNSQQIFh5nTVzxrr1xNC3ybJ8A&oe=6A19B6E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0_aJ2NkOZkQ7kNvwHQpfzt&_nc_oc=AdodRRk-g8_WgjkeK_9r8jcOwGpyzLumUujyum0e7oRmKDYbruNlOIHW3TWW094pP0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PQLT9LNABztLZ1Gy8-oJHKeca5eO3NZSgedfVN67v8Q&oe=6A19BD62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xI1pCeDpDA0Q7kNvwHs4T2c&_nc_oc=AdpL7HZoRvEZiRfAfGZrFY6ZTvZe4j7aCuejXhywuK9XrHoIa53ZvFFutSdA4OV5RbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vFP-T-Dx6bv6HhYhnozU-KHH56bfvA-dzWeSafoLkKA&oe=6A199CD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
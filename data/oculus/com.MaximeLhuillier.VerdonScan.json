content-dfw6-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldoLYU10f3wQ7kNvwFAuRHg&_nc_oc=AdoDBSYrrnMjAS9UJ9jHV38ChoCmDbINqTrlb-P77f6nF86JZrUpUqplFQJO93i4ygs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5JiNCHHHwe39HKeKyYrgxTSPZxFhAj991O0IZuOUJTA&oe=6A66103C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFOzlJDM7a8Q7kNvwGVuYxO&_nc_oc=AdqnyewOQIPn4SKibprEOSAGhOZEKgzM3Q6EvLzOJymfT28ABXGL1_hGH6sysyIWXro&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6kBvEtwdnRcJIUJKSEfSPBpa1OtH9HMCOZTy3Ykm_QQ&oe=6A6610AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0vNFU3irz8Q7kNvwH5328u&_nc_oc=Adrm4ZDvZGrdNl-fh4QFXFfVYkXk_8bFoDhYfOlyUk2OkSfHiozAXImxJG2vesWWAJ8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPoMi6VI-3FGD5Y5s-LXWrBOnZOyt0zkKvEdZxV3ZaOg&oe=6A65F5A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQwDjR95uAAQ7kNvwFK86KF&_nc_oc=AdrGfVOqwoew7QFihRpzwZelEHEW2hsVmKHwsArzJ-UxUixZadIpUv231o186H3JB7s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT2QWc_6OYwOVTKhmSOQyRL8v_aJZfzukLCWzgtI2maw&oe=6A65FC22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvQDokrgnnoQ7kNvwFYLQPK&_nc_oc=Adqo3XscVeJB2qOG7FyaqmC96EQOkzKz6K2qEQJW90UxHhkQRIZaHBYEipnDZx9EIyQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH5ofjnYeb5_bG9qL_tZ_aFqxdM1CI8CiZs57_40tSdw&oe=6A6613D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
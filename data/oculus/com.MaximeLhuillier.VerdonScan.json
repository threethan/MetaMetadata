content-ams2-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws1wd8uZGcgQ7kNvwF1bpbl&_nc_oc=AdpWcqHzRkzbd2NIEZTVmniiOYNJSCJ-4Q-eyRCVcr7h1pF7XVcIJGbThWjz3UssSEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EwxvNrpBGt6Ltm94hcbJdCJsWK8dEW5Bc4BHb821YpQ&oe=69DA513C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f80xBlKMo-gQ7kNvwEH0g0R&_nc_oc=AdqmjPaUGPv8s9XaMlHcEbh-k9zKhGViZYUmh0aBIyx7-ox-4vQK3liLOuQiPQA1W4I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r1h4NkssvH9CTVECwRVaVptShKy9U2kU4N8BTQhKs-A&oe=69DA51AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IbmiofNj68Q7kNvwFYfD-d&_nc_oc=Adpj1slnGN_70wab3-AbKSc5PEEYLrIgH_oTs_h5JH0bX4Y7Wv9ea-ezoq-Q3bs9VTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MM7f3LaJDErdQdRwucu4C8V-2-K3YoYGvgs3yxiSx8w&oe=69DA36A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ9eVJQoqOMQ7kNvwFmgqkS&_nc_oc=AdrlNpl_jGMfxAyNMFa1kC3VRgSRlWMOgAelLmP2F4OMUPQL9I8qYY-UJy9_6wwBYk0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RpQDTpZsMwEUPlkUmBxRUSCIWskTDbGYwS0weSW_vLg&oe=69DA3D22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjBGZWl2PmEQ7kNvwFktpDh&_nc_oc=Adpx3MbXO-vb8BHkbQqW9a-JqvNhJWeRilofxYDAPIjmpDKiiQE-RhWL8AeQLrxHREQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LUU-e1Fcye49SdrfwjjGo3o65moj7Y83Mt4dj632I5g&oe=69DA54D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
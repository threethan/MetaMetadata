content-ord5-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFTQWvuWXfkQ7kNvwFNJ_rD&_nc_oc=AdrFzlSxXb9anSMFimRYYHfwyBoaPYOWUWCm0JD18gvdbHWgVr1d0WV3uAs8qF6LvRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q9ARjcdwZ8pvInHrEstFMDeiYM5v-kAPDYtyhk_ypVA&oe=69DCF43C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f80xBlKMo-gQ7kNvwHQcUyR&_nc_oc=AdryCpc0cbQXePXMQh_uuE0_l-EV_Yo1PdOlrJWfunbSQLG0qQNDw6NItS8Vp5C1YSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30u8ZvwI2ai9L3HU3mAZlzip4Su8j-8EhI0r83ZS-eRA&oe=69DCF4AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n89Be4mXL8AQ7kNvwFZ77It&_nc_oc=Adquhugp1av6rW9QZWQ2As4OwzNXyX97xpW8KhPHlJmYvm8N0rcvsXo0VQmyYJin66I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oIhvCfTLGwVdOyHt0EaOC8ZUwGPlGIo-m63D0LIbSbg&oe=69DCD9A9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roylF9rRfo8Q7kNvwEHyHpq&_nc_oc=AdqK9Z60ItY8M1uQFWI6RVVLL4IrQlFXLS1gja9zkjTyxnIWFP-W-S58n0mTQg7XPNc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YLtiN0HIsmygeI8KcIS-gGGFuvwJVy1nVHvmlXL9R7Q&oe=69DCE022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjBGZWl2PmEQ7kNvwF3wBRV&_nc_oc=Ado4ngQUSOSVlPRTDzxo9n4Lcw9TmVMAdTb-h2VtwR0aRB1UZT-MV49LUbbMTZkgJW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2quPUBS2THgKSUg8V2Yb3m7H4TteNjqc1zXj0TAKPyYg&oe=69DCF7D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wijapPGjIxQQ7kNvwH1ekv1&_nc_oc=AdoroDvsKFQuWnfKaWg7ayTP6aiaZ4Cuaz4irp31EkQjnPPVmPULyShSerBwa3uHe54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObu7Zix3YhGJAm_JKIfGmgDbW59CYVxXtZyW5Sm37yHA&oe=6AE5F1BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fCDOjdY1CcQ7kNvwHg-Aea&_nc_oc=Ado_ft_V8BttcsN7sHCMsPp-PeaPyPyDvTe77a14vjGli2URJXra8lXkYfV4tAfnmwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6Sej0cEOsLOu8kGQWtjNMXELG66oPGIJ57GeLCvKzoQ&oe=6AE5F22B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwT2l-YT3RgQ7kNvwFj_g-Y&_nc_oc=Ado6wD_ZrTGCCjCSJsb6ExfRhGqBW67VtnORHS45y5Lj4IKicfretQ8FD-Xo66YcmEI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfT9dH1hRlBkLWW4DKXqs2dXcrBhF-AUr63YTP7bKZ6A&oe=6AE60F69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gblEN4d4qsgQ7kNvwFhhS0k&_nc_oc=Adryiki-he_pHOFhOgedPoa4r9QvVoUMZdibFUwItiKhnkizJ8H-ldLvUD32ifDRX6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-z8X_NiaL4fWPh1KUEGhMnHqd4eCDZ9h0IUgpnti9Jg&oe=6AE615E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XbspO0pQEUQ7kNvwFTULFL&_nc_oc=AdqaCQo9AS3PiigPGem5DCqSO74CO-8h70hm0Fnt_pYJ2xYaJ_wZPe0_FtWg1yczT0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoTqkaQ01iuwrOpIoMjNsYkObmRKnYq09Cvojbj6qlfw&oe=6AE5F557"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
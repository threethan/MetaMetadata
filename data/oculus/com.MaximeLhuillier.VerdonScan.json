content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6r13ZYhuSwQ7kNvwFvUW3Q&_nc_oc=AdrC8CPUmHvNUgcKSTqsITJcd4MBmMLIsUIGpUM8tsp6sa0gqAEhhXkbQWX5G2jb4KY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrRfU4iglQkM3fnzDdjw7VojLVaBzFv9w_kr-yLoeQXQ&oe=6AA2B53C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LT5DgiBuksQ7kNvwGRfS9m&_nc_oc=Adqe-LHAj2ES69TYpaoe8TLIern5TblBVMqGRnEUmkGMKql9uJf1fIMGm9Zyvp2u6UQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjC2JiWW5IeonpbCeyBvVznBDHSMM1zUCwoqmN2bU1FQ&oe=6AA2B5AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=819W9H3zb-UQ7kNvwE7uC8x&_nc_oc=AdrVlXSA6-KnH_Z3yYi-RHFp0_M26rSlA38zFAwyzBgS5CfzQa6vlrOvk2YVaX-o86Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnhhXPyVNpTcqnwdAmMZ1ObdBwp4jiXYU4d32aPGJGKg&oe=6AA29AA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTng2V1UP1oQ7kNvwF-Xksp&_nc_oc=AdonoZc34aWOEYzGp-CQQJfxNlarGmdf5WL72IdJr5Gu7PCz6KUHDfVt8E3CVEHhy1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVMfrEkEp36z5Os4KJfIr39W-R99Ka0acxflMI4dEFSQ&oe=6AA2A122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvWg6qZL3moQ7kNvwGaULxV&_nc_oc=AdpzFvKxYi4DLcrkUdUMvDxhQ_00uQZtMD8lkm0P2JSM13fJFYOdKcJL_tISuC963M4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3gHvXK4scC5ggtBEcJOuzsz81UcdTSQlP_5SwWZdHsQ&oe=6AA2B8D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
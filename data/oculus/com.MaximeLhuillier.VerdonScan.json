content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAM_xfSr82oQ7kNvwE26rld&_nc_oc=AdrGAEZRLWzXL4s2N9H8ZMMyvQMLgmos-xkZSGWrdXmmN-IqJLp5mDaWfVjIb3BrUcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Hlve3Yu2xjhc9QU0RFGtxXQghUR4SR-MNyP_JQvMOEw&oe=6A1847BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8a5x2I_tQkQ7kNvwEMyUmV&_nc_oc=Adr5iITS4IVwsF-31HlDc93Yz3PQrKaZDa6zYq0X7z6jNpraRUiTmxbK_BQyyAuI9EY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67XmMSR-NMMiXfH38euuAqa8W0hHSY9lED430RI-2i8A&oe=6A18482B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6OcYaCY1iQQ7kNvwH3cMe2&_nc_oc=AdoDxhIHKPPJVDFho0Us2rZCtDFoI8JM9uwA64Pf-gzp4mp3jZrTf8Fl_x6gAypYMqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Kmn3BGnWNcAJCEKxH3ZOM_urtM3dlXCmQCUEd3h09Qg&oe=6A186569"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0_aJ2NkOZkQ7kNvwGncng0&_nc_oc=Adova4ei77r6HlC_5_n2eGe5UVvB04XUORb0k-YW9qTG2Q8Y-CAH6WN-jh6Ety5VQpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zb93Xcwf0ObtUonv5YgV8skh8ECMiM5xTAZvgPjoB7g&oe=6A1833A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y82Kx2BmqdMQ7kNvwE2dkYE&_nc_oc=Ado5LmbyN8HpB-6XO6aQgGstvovz3ezlbgVjNC9rly-Gxxlmzv4az55mGiw0e8p2UaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xLp2v1-aKpdm3Ui24AeTcSN1S61-DRtL28xu6YHFrbg&oe=6A184B57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
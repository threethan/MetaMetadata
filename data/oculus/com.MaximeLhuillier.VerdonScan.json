content-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wijapPGjIxQQ7kNvwHjNvBb&_nc_oc=AdqWWHQ79TQhdFBBCLehzPxBlbaK8zmwj6vBWPeVHQ_VvqMkeR-7K6zD_okr43YReFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgZbDm4WYv3ifkScxX6U037kOoLSzLVdZNESDYISjpPA&oe=6AE4A03C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fCDOjdY1CcQ7kNvwHqrXLh&_nc_oc=Ado_ZZ7qwnE-a4_kiS8SzZNVvR4WAuZ2yaZfj_EMpVboOV0sC4wYrnNnQs1YbuR_BQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpsOdAklxgyTTRIq_FHSyoi5Ks2m-SstSDkF31H_ch7A&oe=6AE4A0AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwT2l-YT3RgQ7kNvwFZRBn6&_nc_oc=AdqoNuEwaixEl6AuEou82j84lCVeuSRIydabTvaNEQotrl9r_74LWwJLzX1IhdSTK1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtRLoQmLHtPVynLf5ytIGZ8INf4nMEXE1zS3wlQGaTsg&oe=6AE4BDE9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-AX3b4zOioQ7kNvwHxh2sd&_nc_oc=Adr1QJwz9_rCIvyEOeLRgypXGOZVIzX4oVbfvMuFYZvsPuiFTQaHnSj1bCAnhcDULYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4xhpUQTDlBKYtlkxPsRDEd_tlKSEisiRj1WmRiIz_lQ&oe=6AE48C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XbspO0pQEUQ7kNvwHjMHbU&_nc_oc=AdpdqbLWv5MluzVD-w6ylA6hpTU7Q7KCjzlxzEueBmPp7zfVkBJPIJedVSY4HhrREus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAdl8FVtKA81Sc_v1sfB3YOfnzqCFh_xcsH6-uu3tQyw&oe=6AE4A3D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DzYn5jkO2MQ7kNvwGOMhBk&_nc_oc=AdohFWWkwLoePRHoA0z_lnGrN2N9vkSxL0uXfPQ6G3IeENe9DmSr1KdZbLHUL0LJRo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GsWhRBCD6cztWU8EP8gEo2vDEbugS5q2Dr67uGdth-Q&oe=6A2030BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3pSsncUWNsQ7kNvwH3khER&_nc_oc=Adp6VsmAvsZXTsPlJoJ8170_FqOuePHLmOIHrL7YxCAauPqdfoL4YrYR_rVwDv-akk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79DJwDTgBGh8QoAD1lk9u5Q4aWJyTlqR0PSUSbicZC5A&oe=6A20312B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYigLmL_lBwQ7kNvwH0nUfe&_nc_oc=AdoYTdn_RMmpSizj-p-tIFr9jRU0k86zw-EwrsB4Mleyi2-_dAU5KqfXZwWffLV1S-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R0WulZiAy-EkWAClKgn6Gd9SYqj5ZVHUDGVtE0K9DyA&oe=6A204E69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utdLkn07r8AQ7kNvwGWngpg&_nc_oc=Ado3rb3CX_wPOKWG9q3Vz_l-1lEgtLFJVDv7ivC1TgEgpLU5bAr_2xgMlKrzBwGNcWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AQqQvHxobpY_0qFzHc1cyvl_p7kqvp7GAOV3zcYpq-Q&oe=6A201CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk2T-9sK9fMQ7kNvwGoFqe6&_nc_oc=AdqopjCiKcW1poTL9Z7-9eoie78QlUnvqmIiwm7fmy2SGyxP-qyTr8sMvx-nn-yu8yc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af468W6QZugZWygYD4iVzvzYxYOz_E--XAnEli6OTHNxIw&oe=6A203457"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
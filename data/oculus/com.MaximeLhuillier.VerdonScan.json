content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA-GyQg_kxUQ7kNvwGVoeKD&_nc_oc=AdpfYLSdtuBd78FBYO3YGZCp7QG_F0DRKA0GOX4eOoVtBYyHff75uXWTUfBCBX0U3WA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxSN-ZTlzrdhD2_aMuQHI9Iekuo7_zD2rSSH5sst3BPA&oe=6ABFB63C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uoDFKk3UAQQ7kNvwErQIc9&_nc_oc=AdrCxhRW1mZZtutwoPn0wRaraPKd0HawM-osdeIVJMgywU25EIfyQ1NqWyZ3PqJdN6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONFa_-L_S9BTik4I_tjvivvbqkCpxcUSOlukuFoRNlFg&oe=6ABFB6AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQKhx7FotO8Q7kNvwHYO0Q5&_nc_oc=AdqDbx8FpnX6tCWGpcQvUURa5bACp1c5efCjb1ZzY6TlBmTfrKxJ7WqV7G2sJc_8CBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3XwKWkaBvypHO-MqtjANzM0aJ_sXxfDEZ2TTD1uc8xQ&oe=6ABFD3E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCfTn6DuxawQ7kNvwGTGw4v&_nc_oc=Adrwc-Ajv4KRwqexEE_03fbsvlq_pJ285DXNf0VdU5bwHX5yxVKk2ufqfY13NOa_edY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSoy3Wb38jZO_7frNojSLTj1JYe9fENaFG757mORh46w&oe=6ABFDA62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jylq6wi_tegQ7kNvwGzugEb&_nc_oc=Adpo47ho4m8edrVBfppyFTTNtr5hEtsVIHnS134PctIW9DcdEi1-4DR2QqlGrPTRylI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbrOQcA3ed2S-8gXQUxeqWa2EtkWZcmifMJnk1Zv3r8w&oe=6ABFB9D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
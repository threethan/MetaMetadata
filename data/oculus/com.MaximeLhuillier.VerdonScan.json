content-fra5-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7RUJwX7tRIQ7kNvwGXH4Sl&_nc_oc=AdqsRKHSegXtuqONAjtWKcK2Zwgtsjy7FOnss-CATp-qYmYcDReH6GcvtXpemzFztRI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4FEs1oewlnsnP_41EmmVOr490_WGgcZKY__rgFD_96g&oe=6A881EFC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76ZRpK3nimYQ7kNvwHWMzT9&_nc_oc=AdqNPFeCITgLO748rxKQ_k1fyML6qMLvEKp6CNRnLQgFnsEraPDtAbytRyrySvVWA-g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsl_U93WnIsJTKxPOMfCB66Fdm3VB9qF-aB8xLCje8FQ&oe=6A881F6B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waMowBhFiL4Q7kNvwFjN-_g&_nc_oc=AdqzusldbmTPmqGu7e0cgBkpwQgixK2ptyi84tOIeaaC-RfOfXbzKgJRpejzngfeFfA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYsdAjNRdKz2KW_uYOQjYUApAzw1_KLaO4h7Ykgs8bvw&oe=6A883CA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocGLIOj0kCkQ7kNvwHR3pZn&_nc_oc=AdpOcILI9sJqneXDF1H151K2mF8K5E8-8wq6-4TN5TtemPOpF32t3qHNTRmu7UUMO5E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_xJI_YRaaoJp0eHaObSXCBLjIs-A39mz8vtDLapkHWg&oe=6A884322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jryYLnbtXNUQ7kNvwG3GBnf&_nc_oc=AdqgTJuWnnkXpmnDTolfIH684_xicX-v6ymTiKAlvrPaJ2ocw5p4CUrfUWz7k1mZH3o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKuml3UsZRdclz1fa2IDGuwXBbapSAfqoTH68P5E9JkQ&oe=6A882297"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
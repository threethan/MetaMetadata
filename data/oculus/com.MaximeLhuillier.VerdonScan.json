content-sjc6-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4wD9EpbO5cQ7kNvwEH8rDX&_nc_oc=AdpChEP1HtawXJxAjiInym3vfQz_jEs-Wa3Y0kZwcVVFvj7y3UtlRNYPmV69gGxj72k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0auiw8nKTdZIHkhXMoJnH846qcyiaBlUnQVJ-qr69naA&oe=69F8A3BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0z2d68szT8Q7kNvwEsKuQ5&_nc_oc=Ado_55XpVv_tZugfCinqi8Y0zaVWNssFEEuspONrxXRAOP3GmqodGisDFWvjX20qIhI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2veXh9mOLqzVQytLKOJwab2tHzTSeazg3XvcO5Hb9qbw&oe=69F8A42B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Irol5VdsGYIQ7kNvwF-GAei&_nc_oc=Ado-sLfDyG39RDdJnka6_xnrCxtaMOGdk-wSB5EKjK6SoGLWJ_Bz8pXPuNS-xNG-jf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CZQvezZVk6l-_Ju7ThTJ4odlxrAo8YKLhToM5UUwDpg&oe=69F88929"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59nGp_OxhjIQ7kNvwG1UuSH&_nc_oc=AdpckM2-u5BP-eLGmB6f1Ej68pWHcyMwj5LEfgQTduCQWSd8tHirDHsMDKoyNmTDhIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Zj1Qq85k0HHaWWQyUDx4qocq0Xyf9IQZA9CESjf1OpQ&oe=69F88FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oP_Aaee4aG4Q7kNvwEJc6ot&_nc_oc=Adoolg20F8C2S4n15edea7JZUidGCl2Bl-ID_CGGpKrBgZTAy0Y7fpJ2x3Hp9KiRslw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uIF80S9Ie5kQ2VgCbCM7Dg7rFOqMKeHDkIR_biv1D1Q&oe=69F8A757"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
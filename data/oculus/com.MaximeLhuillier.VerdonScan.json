content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bxQ5yJ68YgQ7kNvwFMw-fo&_nc_oc=AdrBQfWIHE1pFcMp8WUVO3yRN18ir24zCJOrj2RkT4gwecj6JYLYK0OgwNQomvNA9xU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy-bFsPHtbEW6dj4rEM597Dgrzh-qlNRICNRuZ8ztvzg&oe=6ACB93BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnShGy7svlIQ7kNvwGGZl6t&_nc_oc=AdpcY3r2-E2wnSP3q5VF77cUAe68aK97f8WlELACiG8XomF2C2z97ZrlLcipenR_cTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrCr8POjHRTfX-8tCGjtdOHMGe9_xLCIBiW2NEZ93iYQ&oe=6ACB942B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s3bStcTV1sQ7kNvwGBxCU2&_nc_oc=Adr-gaS-iaoLGu9iDwTHufZs7tR17IC6yRTCLkB8lxoACt6HGf4wFX8pWO9Me81AOIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmRmQ5wHyN-o4dXH0ta96p-DfUkVbXdlox8DuwJcQzIA&oe=6ACBB169"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31cSXs3j694Q7kNvwEawfUM&_nc_oc=Adp2YFL1UTmHeFOTXwwI-oEYjQ2jd6lzuLsTKP7nHVZVFhWZFK0I_rfTwcoiGio0ZW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUdFbr4lBQmym8os4kr_MHEq7GkQidVEmTOpCHGw1TDw&oe=6ACBB7E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUo8yK-XSI4Q7kNvwHWcP3j&_nc_oc=AdpHK0iUJUzd0afcK5JDbOaHPu2zDsQGrFRWJOb7ckAWcCI0MtM_yveykY8K3FATaTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNskng3ou6ZaQXw3O2msYXqsuuhUFGMPqttal3eb9NRAA&oe=6ACB9757"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
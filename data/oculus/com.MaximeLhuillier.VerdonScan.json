content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPsWEytD0QoQ7kNvwF8sc1-&_nc_oc=AdpchZb8fE5s5yHHc6S6boPk9J8po00LRGmny4VJw04r_g4buUCUtYbLcfgT53TczNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeK8WT3KyCwqb_2oca7tTh1ECWDsmTXOcwaAavO2CV2w&oe=6A95BE7C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WW_-GZ2JedUQ7kNvwFWWvVV&_nc_oc=AdpkX2qejHjIQuSShsD94iO449Xs1kskivMQlKzmA4AzBN4hRn5_9mSbcSEsoPOnNgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz-wWFuXY5TLWd_lWQ8hcqfY1x0fmeawTCoX_84rmCSA&oe=6A95BEEB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2AD_2v3yfEQ7kNvwFAtmlR&_nc_oc=AdrCE3a4zj3K4skqWuKdXZ5jC7qJPirbCdOdmcE9rHfd8z_5FqbbRe7p9d5bGqX72HY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf4rJIOQiVdJIrM7bgg3LWY5wX5BRF-e2IX1tptTMTdA&oe=6A95DC29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D4x6pJHMDUQ7kNvwHJ3Hb0&_nc_oc=AdrX63xNAD63z8PsmklknRK2wPF8ah_CDgcwlEW34M4d7NxvMzPPrOkPAE_eVr11HHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRaeNRyXOQ4rtANBkGy2cIQMQV5gbl60nOS728wqWULw&oe=6A95E2A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqmPDOq9t1YQ7kNvwEw04ej&_nc_oc=Adoy4wo31SgH523MCHJNmHXpIVd-cw7u2Le_Lji8k2fc_of3MV6z-SoBbUq_L3JuTTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjE19-u5Cdj6r0oCqDAYsQmamJI97Ncsrgutmvw2JC1A&oe=6A95C217"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
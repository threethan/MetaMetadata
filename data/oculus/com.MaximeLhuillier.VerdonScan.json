content-qro3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4z8wPVUK2UQ7kNvwFfg1H5&_nc_oc=AdoyvsqMBpucuugXs2F4QF5lm_NSE-RCq8tduIiatGQjQRWBpYxwlNdN-i2F-KCXlc8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0qm268G5Vfg9JN_ujI1-lTtEeO4aOepdmbRk9gTdF9Q&oe=6A93FC7C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WW_-GZ2JedUQ7kNvwFeLcn6&_nc_oc=Adr5Sk2fmUufZgUDIlsNM4tpL7G9PgUouKGDInfnCVtsUiKvBVMxUF8w_L-zTSwmsic&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHufpqV8v-QF8Rpezd75sepyjWIVGZOo3xtrSSEhdx1ag&oe=6A93FCEB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apJb0h0L1AUQ7kNvwH3MTrA&_nc_oc=AdpXbh9C2diTEKulJiNphqQVmGoUCaanKSqKVrRpYwOtSHfAWqp6sF98aOxJsQ4I2HM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxnOVkFZOJWpl2tKX6gLU9BfDJv5UH08x1c4FFFZXGMg&oe=6A941A29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D4x6pJHMDUQ7kNvwHE31pE&_nc_oc=AdqYrxW6OMSMOR8Ltnx-hU5IlPHvsMD8TB8hPLY7vVHhXiMhVOSFytoYX9Zd_wgOxdg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEU7dXgtmgPLjH2pl-wSP9IweRqlTsQCSsz36kh55Lmg&oe=6A9420A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqmPDOq9t1YQ7kNvwFQkx4D&_nc_oc=AdpfMQOnqKbKJlR2ru7uBNJS7Kb-c8owz_qO1rQ5D2oGG5_P_31YkX0psrPvX_9ErHs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAmFiv7kwbiz1_azr2vd6wcxsgQfUVavfm_u3YXRTQ1w&oe=6A940017"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
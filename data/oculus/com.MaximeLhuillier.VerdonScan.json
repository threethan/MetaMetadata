.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCrzhoi1YbMQ7kNvwEfwoLC&_nc_oc=AdmWEr6HqHASAslh78eogtTDFOKjKS161LtaNQpfjuiq2QVERsQoqxgoG0Lg7BCtNj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwryNROMufkbxMS1ubtHVgAFW7-tXCohTVcapywD1bCw&oe=69BBFEBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ry4ELlNjvoQ7kNvwF2alRX&_nc_oc=AdkjPURT0iLVrqSOyHdvxZqOG5NpdOU_74zIP_RqRCAb9Ctljgke-Q1lEGl01HWgj9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9l8rri2X5iHCiwjCW06EQcSt8a6aGP9J7DDFX9Oo2Ag&oe=69BBFF2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erfwPX2ycFgQ7kNvwHlv03D&_nc_oc=AdmIEKvSeqoyp6pvIQuTE-jlKkdzB4foWuXz7j8EYkbxSUBP_VeHCmcHsesQ5OfdP8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxj12Z3cp3_7efkQmxiuvuyQtaOelmKp6-bQtUbaJ0s_g&oe=69BBE429"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvQODfOMhaIQ7kNvwHmOKfK&_nc_oc=AdkOtU8Z-A7fwkncbQ6gwHPBskfLHTePssCRtKHTo9l9AL8Yqnk9cPKjWoSh0Cc5STk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzwKdIMaSkY862n4k-xBlM7U-9Xo2usHTqsIaFV-O751Q&oe=69BBEAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1xBQuu7q1EQ7kNvwGDT0Ol&_nc_oc=AdkZYXHrNSHP7FH9jVacjHELECUAnKtrvdC9r0UTEwstrG30h8aX_9WcglifE56aMOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4clgjOG9_Ksb5XO9ov9fG9bD2PTt4SuNPAuSZ0uYkSg&oe=69BC0257"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "N
content-fra5-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU-HUYjZaMAQ7kNvwGkPzRz&_nc_oc=Adpb4eh96woetKZIQUmnHtX83qCrANZ-3UmA2ViiLiQ-foshMz0GJioylHcM_GZP1sM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_hKkO-DV-HmA-LFLqjdJ6Lj-xTPNCcEg6sAKD4RtxTg&oe=6A32A5BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ufZcbv3KjIQ7kNvwG66if4&_nc_oc=AdpcYH-SDwv7QGW9ZWgJxsrB4Q4iVJqFIKzTKDCYPrrQ517GAHcvn097HoX36gVG5bU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lzPlEI_H_2J1EmaLfQU9yCCPC8zW0JDMkvO0EVXf-Dw&oe=6A32A62B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwBicguSiXcQ7kNvwHxe0Or&_nc_oc=AdocXndUp5Rplr0Sc347IwCAhV8dEmo1uofUSGJYy0Yc7nvZ2r_q0LkPP58rOz_CaBk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LVV3gQKnnh6Zk-q3lqOYeLBkfd_8MMwGNvKG93Aioew&oe=6A32C369"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsfcElkwagwQ7kNvwFRsyFU&_nc_oc=AdoYLey7X-bsN6JgPPaXGeQq6JZDpQf2oI9yGysrk81mO5ZmtGptj6HRsVMKh_3ehng&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ILuWAb6iAVM80lheKLmEj1eaSQWH10rWE6Yk2JawmMQ&oe=6A3291A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luqsfXY-faQQ7kNvwGnB3CF&_nc_oc=Adrh28OWXugw6d6WidHOYc_VXh-OpqNc70IQpoCx_ib5tDdJIutJvu2dDJvq9jHr8yQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E-YPJ5Tn6U20Pyk2TmLWdV89l9zMhnGGrucdaGNK6Aw&oe=6A32A957"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWQDBmxiOB8Q7kNvwHhL_1o&_nc_oc=Adpx0FW2gDW4tUtJiV8ojeA12dpvWchQy4HvvjIE8WRHFQewTww-8jU4w7eU6kN54-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRgFZ6e-aVnGhjCnjq3Q_RVtWg1_K37gKKLER7rGG2hw&oe=6AE9E63C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLCzJ8x49i0Q7kNvwGgBn5F&_nc_oc=AdrAFH3Hs7lXeViuVKwFnYzB21XT1JqEeAEOP__eVBQIUxKM1pJOPG76Ndk8vgccFFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT37_K5F1vrxIqXpuaF6ioXMJf2t6kPx6Q84BOpFe7-_A&oe=6AE9E6AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFAQy4c2YQEQ7kNvwGVdNz9&_nc_oc=AdqUzo8WhIjZ7lKKzGxaKru-7McC-DhzQKv1sApEkFII5XqhRr6tYjQFXrpyXT0axog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdImEq05wPEeNP5rwGr3DtWgNmdcYbUgNSHZ3xqfSpUA&oe=6AEA03E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgvgsbKUYLEQ7kNvwERu27X&_nc_oc=AdrIxW8Ng_Hyfpy82AegrEyNM-6lbYpuGNYkna_Qgoc5g61CuZoupINnziDJZIX2SZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-3gGmbC65QwdPOUlfDUCwxTaDleiWInErjbd1n4PlpA&oe=6AEA0A62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4b8s7QhDhYQ7kNvwG5sCB3&_nc_oc=AdqqhV5kbmC-pBWvjzm6uIkd5LNNwFAyxOjgvEUFKnjAOBK2MY7ak_CFQQpjDcJocK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvootkYhId7aRkBXDvbbyCKo3j_G8IQimDLW6Gb6LXFA&oe=6AE9E9D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
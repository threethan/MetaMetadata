ps://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zyMKwGat8UQ7kNvwFNt7LM&_nc_oc=AdoJU5Xs_IuM9CrI2xnlkArzU1nINzgZOMscB61687dfJUaoL_qjxVadOgJnhJ-Zp3w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOu1TEc0exAtBsFYET1VVkVGd3U_21mUBjEFKDMgxlig&oe=6AAE92BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeJmxlISQjMQ7kNvwHGYqbK&_nc_oc=Adp6qciEfH3prKAoI5BroMhuvx-M9ForGBz5QeOT4cpM8cE8LsH36ySYxWVrqwJcsQ0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0FzK8dtCd_GDbX3_eZm4sOvH8jcxJtOGW6s1uiyQekg&oe=6AAE932B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvRRG6mBemQQ7kNvwEUxn66&_nc_oc=AdoJYn9bLnF7tKk2nefnJ8xKoADUa3n-xKuYcs7ppylLYHArwsJ2IdHCk9hmtjOuL2I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0G-FZmzhezzTXqw3z-UOenQN-_kZWgthcF_7Mi-G4VQ&oe=6AAEB069"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e48RGV6_HbwQ7kNvwGEZmlV&_nc_oc=AdqU1lerc2etYeqqGN35a0Y4kM-lNs_2Obl-bSCeEkD98A2c9oN4uGtMSiRSULwP-tE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6ScGw5ZGiKBwfvTN5Lnq9OH7UyH5CLsvYIuFoOsljVg&oe=6AAE7EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ImFERFOUKsQ7kNvwEuAAys&_nc_oc=Adqtkavph2PGOfg5_Q-FP1CjwQvBGkRqtN8N0KM5bDophBZzzoVFoktqGM4zSiFBsGM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6whY1AyIMAmWGkTiDNIw0DF7zlezeMb2cjG-F10WZ7Q&oe=6AAE9657"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "exter
content-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8aTlU2sRlQQ7kNvwEoksuq&_nc_oc=AdrgrBGOjdtUZOEJeDlzIm0ShMeHO6E2Y276Ks5h8AtvAiKSJTmlN1m70QRHRtcZ5TE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu0aE84IKQrIILCShAWj7dZVLjgg69Aj8m0LYFdsLWSA&oe=6AC107BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uoDFKk3UAQQ7kNvwHwR5bO&_nc_oc=AdotRsZrBqygbIu3BkUfhHeyjY2l_nQXo8kBmPSUa38wmEg3P006sNPyvLiYvhwtRLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNvBMj-ky1Dl_ANI9v_wIzi0--dCank0r1q2xYQXa1ew&oe=6AC1082B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqff2CS2TBgQ7kNvwFNWbYb&_nc_oc=Adqjzo2OFEvRq8dSa5r-8VfaItaOIv069ieHtw54GS_ZNL-F5U-ff_JvOViDciksn90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeTQ0QLshidu__WzLDwh_76Dusaw1r4Cop0R_KEJN4mw&oe=6AC12569"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCfTn6DuxawQ7kNvwHXRYqK&_nc_oc=Adp5G4WpgohxUefX3fITsPSxFNvk5IAAwFJ1UFR5vdtZ8sZ7XTEJ8oPwxaDAJa8bW14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP53MiDgBnLKLRZPTTd3kzfekEhGjYJNfPJsJVbsqj6iA&oe=6AC12BE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jylq6wi_tegQ7kNvwH3et-4&_nc_oc=AdqYHNb7MWjcBfJufVjuHXSybVHeSbw5-Uz4W-kn13JVjQvCq5l0Ud3dowdHVL6fc7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtK3kGhaWNk49yj71AQhwYuNtm52PQF2Gkszsbep7wxw&oe=6AC10B57"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
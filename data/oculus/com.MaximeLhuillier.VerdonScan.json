_Afsgfno3QUC1TXe-xlM9NV6_of0ltuVCFQtg_RlDqbfN4g&oe=699B093C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXLA4K57RpIQ7kNvwGecgUm&_nc_oc=Adl6AA-0esX-XAPrUm5vjMwCenjF-hKO6tAydyzXyQqukWDANxl-V-BYKN-WUJdAnaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfspwnmIa4MLCS7jfPtVbVPyG4pNtzf9dnoJAODTFpWb9w&oe=699B09AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXvI361rDg8Q7kNvwH2BTh8&_nc_oc=AdlwXxkcvcfvO_ysbC6PMWqSOd10v-9cXWHSDwLbmwl430CvtE0v4xzD3R-O77Xk9E4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvPFuHyoNLejQjG8fSwOZCIgzNkNgn-kQ_yqYDcNb6P-g&oe=699AEEA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWzunISueaMQ7kNvwFzmfw_&_nc_oc=Adl4kM17bxlzJb28BtiYVNIF7lKAGC_71w7c1NNUd0JnnqMbb8Df9z4GwGFg24jCHm0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsn8VS32AC1a7c8Y13HM0FVmhocHO2HYbeG4NV1a6bFTw&oe=699AF522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQSDdpU9T-oQ7kNvwHbxXZ9&_nc_oc=AdkJOqeIo7x0lC-u3FtbpvYOHmkA7YQMF5iuzg9MfEOZWF-HReHiXvQLynmP-SqdhTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvxa1TQ_ZyuF98Rhlih2jPg66VItlPH3kI0rFGRUhq6sw&oe=699B0CD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
content-hkg1-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3Ct9TmzKykQ7kNvwEf-sPy&_nc_oc=Adq74gGmSmbi7bNDy8aN5j2PsD9AbVMnWo6YWpP_zGJ38P53_lxUEg5ikN1TaRcRfS8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeVcIjyrGKDEiUX-ld6sBoxHigjObZQdznr7nSoJVluQ&oe=6A9191BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWeapvlv-20Q7kNvwGWHtI_&_nc_oc=AdqKDwWlGhHZJrJ0oix-5tL9mor0vOpviCUcvU82hYwRbWgftCnSbID4FlMQlO-GFFQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaSLaKOCMRoLsinlo0oGXOsUHyvo2YsBZEtMFgE8fusg&oe=6A91922B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apJb0h0L1AUQ7kNvwF_2tDO&_nc_oc=AdpOtVBx5V7f65CYDsS8K1tQG5RSUNnNb8n7lvbHVPeHkILTI0-BOeSz2oIWeNxB2fs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-5lyGZ99UlsecPnFaZMdY1qWN-fAFSu2sySVaLyl7-g&oe=6A917729"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUqWdXuBoh8Q7kNvwF8Vhi_&_nc_oc=AdoY7gumRGURdTib4ajNRr0IZ4YzY7X0FHOQJIIk92SKm94yqEjdj-lgWroJzPd4pbM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU5ebMjB87aI9OPDW6-iZ1NKWJuxo3PeZghsot4CxQTQ&oe=6A917DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aekQjHdcbDMQ7kNvwFJEDC6&_nc_oc=AdrUcupkUjjQxiJ-alG5kEzZB_01mEJf7S7Y3X6YdOnofqoKXTk5KMdRqh33oJ2S23Y&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD0YrpbrH4g3ZwwPE_-I_5uJHWFZziGm4NhoOl8nVYAQ&oe=6A915D17"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
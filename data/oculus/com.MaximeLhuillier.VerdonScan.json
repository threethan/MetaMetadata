-bWa2jp7ZixIEPVKrR-PTCEXmv66o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfshmLvXG3m10-H-2BnBue7t1r-IfNhKXO-sfUxqUwKpnw&oe=69A588FF"}, {"file_name": "Screenshot1.png", "id": "3001248820165356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf2v-w26c38Q7kNvwFzrTWb&_nc_oc=AdmDpSmMoYzlHqljiIGkZkS7tPISWbJjYA-xGhRNGzIPSjwMBho9HIbblgVVznl0IPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu_7erE1XluRf-p8Cy-iU55D9mUcBWzPtyA0bqxayAe3g&oe=69A5953C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa71GP-szOQQ7kNvwFVCe5b&_nc_oc=AdmciiCXGHtF3QnvA32iIsed0gEyQlHbWnSM_1AiCcl0WEVaZ4NZn72N7sGr5SFwNbY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfspV-O0IWwhVHctwb5sw1xfzqTxBr585pmwzaSpSlq5HQ&oe=69A595AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA8AufCVMxkQ7kNvwGj1FPI&_nc_oc=AdmTS8XSUBYjz8hbJtVvbBzjeNw5h2FeShAhE7rM2wzzWVYgyD2nX9qVfSMAYZTdfNg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft5NdDFVOwjOGNfyNQkErvftdUYynjOSFxacvgagNUHqA&oe=69A57AA9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GqBWOfnDbMQ7kNvwFKYD1X&_nc_oc=Adn2-4n13XChPluou91meuFFU8qHjyQ6hjSgn39DdR-TFkzYv05r4piMZNq0OEZL4Fw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfueIroyA6OqCaMlRz1YZdCOFJ8RLKWaAWIKgGcZwOIeMw&oe=69A58122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdwvcqgUgikQ7kNvwHPoFUA&_nc_oc=AdmpGS6ejtE8DxNvF2LLEpLusM7XiH8hcL5YrqLeo78r_NLBdcDFP3p3Li4GcAUys6s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftWfoftSSkQN5mpzDlJYl8W-eEArVqZvaBIdi1MtDi7fA&oe=69A598D7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26915388004771951"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001667_1213455862769266_6318729815187685553_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqmbJOP8rwcQ7kNvwHEzar2&_nc_oc=Adm7uu5pWNurlz4o-8waqSI5oKwG4s6ISoDY9EY1JviUaV2WPOF6q3d6TzSSyD22Esc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvggjf0lc2IcGvCyM5Zg1gd95X3A-j8YiVCXh3AUpjdqw&oe=69A57BB5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of the Verdon's canyon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1662050229, "lastRevision": {"nodes": [{"id": "8038095429594493", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8038095376261165", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1226878741435860"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Logo2.png", "id": "1727928950896113", "image_type": "APP_IMG_LOGO_TRANSPARE
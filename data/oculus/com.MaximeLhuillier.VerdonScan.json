content-fra5-2.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-OYJVASXukQ7kNvwHUepaL&_nc_oc=AdpE32DwyzfT-1xqsKiU7rhslPph5biwKPGVXyAOknQUlYQZwDWUiTvnv1xZWMlQbb0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0R6QJXtUZ-Pf7WoMFY-2yREJqwjfRVSVj-NpPib3c4KA&oe=69F600BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0z2d68szT8Q7kNvwFObKht&_nc_oc=Adr3G87wwBxtOVC7VcsZuPLH6R6TEMJWtD3MHhk7h4ifO1IA_bKi7kBZCZlPNjMjRxA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RY2ycQDvcgUz3qL0CI13t3Dx-SjRsuAeFZ2erPR4kQg&oe=69F6012B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f3tWdDn1TkQ7kNvwFFahK3&_nc_oc=AdqX0fUa01B352TDv7Gk2e6lK1o5HiV4Z26h-1IIavX5mU6-7Xt8pjQ0n1vCqfy-kEg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Z3kIFvo9Y0xOqvJAIkyoUiWnk_vqcQw7_ToA6PL0nzg&oe=69F61E69"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWfVDvnHEB0Q7kNvwGEnO57&_nc_oc=Adqp9LIEPGwLEcHdUd3qPKvEoYTpbL8Y0MsECziUW5axEqvQ0yyTGS19C8oEZth3n6U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MwG_zC7bYMWTxliLK28StktIHQ30GzpvajFM-Z4-6qA&oe=69F5ECA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oP_Aaee4aG4Q7kNvwEsQudh&_nc_oc=AdpTinm7sTG78l-AK8SHzuHsmauLHBsonvFBIDce9MJ8VwL1Pa0juneQinOlIHWQsnY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UEOVoN5D2nKd8a8_VDuJV99Z5kISzp81NHtuIRrU_sQ&oe=69F60457"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
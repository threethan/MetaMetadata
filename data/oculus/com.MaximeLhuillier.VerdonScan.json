content-sea5-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M05-0-t9K9kQ7kNvwEv_0i1&_nc_oc=AdqZJqE1tKjK5gZvUcq0jP_brelONicqk_vkchqCusNK5ZfCDvnwG7M4JBxpN4ATwvo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOoDLFHk85xnu4MpWXNHWC4Zs377XjNvJ2i8y7YmIlUQ&oe=6A54ECBC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYTKMcBPbXAQ7kNvwEQeVlT&_nc_oc=AdqbW0Ovb1SPd_8N_JS0Z9kHDRQ2e6oHscwtFwFzwxn6kzK-KTAn8pRtHAxgaf__pCQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0GSEhZ9-99YGfmkm9XQzsC-QH-KCVfxos2ubXgxAb_Q&oe=6A54ED2B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sWOjX9aBKAQ7kNvwHVFElP&_nc_oc=AdpLVi5orVuZMg3WmjtgDQZESXL_EDHSG4RsOC1Udu70Z-IU2dcQQrRGg-R8pk10Yhc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCADiOTWHY13bfnamjMU16BHwPFMXVvWCf8yyz_i0M0Uw&oe=6A54D229"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GubW6xZPsKMQ7kNvwG217R5&_nc_oc=AdopieBphm03ePHe3EwQvU2pt2Vn9okrzvkWZy4b2NaMRE8_MVvv-Jnd8ZCPcGV21xE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuAgQDGNAwlAffcivCZzdtfcU8hHV_CAcQM8JKFNEGVw&oe=6A54D8A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3pYpC-BHQoQ7kNvwGKl74I&_nc_oc=AdqtezEwbqBtj5Q8L_5QJbr5jA_3HK0kPq9uEo3VrxdFuTqfZNZ4kAOWdWtelqXJfOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoKIxOwNv88XMNyDLjdnHyPCL1aMroGB5fhahO_DvGtA&oe=6A54F057"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
content-ams2-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFTQWvuWXfkQ7kNvwHlrgUc&_nc_oc=AdqO9jfJdNNOZEuVciI9nO3zFT28QA73UqY89OzTv9q6E6dcxWhClDrUnGV22iHPS9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pWqusYGBvFAAroU5ldGg2-z1lX_C2UJR83Gl4V8KIqw&oe=69DE45BC"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzfqTWJ_RSAQ7kNvwEySOvQ&_nc_oc=AdoKtmAojhmJldyWQDeECjo-DfQ0WrOFjEQoBcL990WwAWBiZ3Q4rYPyj-aXs3c9RVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mvUJM2OAe9UEvq5XyB7CikJUB5EZ48gVtLe7sIDtalA&oe=69DE462B"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n89Be4mXL8AQ7kNvwFNGvc_&_nc_oc=AdqX_sk93VN57VrcZrxa7tjzrpgc98wRrbUhJbYfy1zzKqvqd6h-yk0O27oonD0olFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yPSjOsY71tK_KzK4YgiVt8d9tH-fKodxi6auz0c5AwA&oe=69DE2B29"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roylF9rRfo8Q7kNvwGz8oHe&_nc_oc=AdrgHfOiZUW60mCUZY7EOdQtEOT4R9wS7o-IANqyMhl1yXX1XFwNyN4SjcaTZE_oYv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P4n4gcwbpPPpZeE0cRv3Bcon0FqoiT-c0Q-3Xu5jHzA&oe=69DE31A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mcvuwrftTEQ7kNvwFcWiie&_nc_oc=AdoiBdKEWutoHAt-J0govQWYslMHQouogIFeqjrytKFYeenWAQOr4v_rjv2k8Q2az94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YENqFp9__3cbB_cD_Gytiw6RPWr-ZgVRLN_9qAaA-iQ&oe=69DE4957"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
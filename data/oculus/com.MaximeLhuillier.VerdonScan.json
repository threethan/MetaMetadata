content-qro3-1.oculuscdn.com/v/t64.5771-25/39035382_3001248823498689_57092404722974294_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4aifXx9Bp8Q7kNvwHuyrgE&_nc_oc=AdoOk93wXXD2mCMdVCYbeQEoWg09FldioONFYYNpclJYQzDIuZW7iE3yHKuN8IRWU4Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GHXpN8F0e3G5pTvM7WgoV-nLfrIIV3LZfRWQds4xd0g&oe=6A09C73C"}, {"file_name": "Screenshot2.png", "id": "1227522898033770", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982464_1227522901367103_7496718729731117090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4_14WpKzx0Q7kNvwETK5b2&_nc_oc=AdoBZdeAdtHQ_xhbKnywGKmy2i8WW7KrUCwcY0s5LxnGthUQyCFdf61JbmDc8ivC8v0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TZr12OasFvXQ807ARJYt9mFn-VUEwQIKZuhkPKZszvQ&oe=6A09C7AB"}, {"file_name": "Screenshot3.png", "id": "400523685352869", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974515_400523692019535_8401549706537711147_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FolvzrdV_-4Q7kNvwG3yh7r&_nc_oc=AdpKLJoGaN-cSs72kf0XHgw9UjqqjGydgsmt57N0sp4rtsfQbML4Qcq1FKZgH-Ueasc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rvZdXGOuXHp-q4NJpI4Zvt2MMiFtmXItx8GeIuctv_w&oe=6A09E4E9"}, {"file_name": "Screenshot4.png", "id": "1301425357334121", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982678_1301425360667454_2162183305064303310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDpBjJHMLk8Q7kNvwGYqNMG&_nc_oc=AdpJRZ90W3sq-8Gd-n0wMnAe0077FnqqN5ipfNabcYvdfsSxR4lWxaToN8CXma3ZCBw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QnwXEKhlkFU062w241BiaqR9nO24X3YnGILKgGnapHw&oe=6A09B322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "443437561075004", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75580070_443437564408337_6207399824729004018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLtmCwx9V1EQ7kNvwEMEUyQ&_nc_oc=AdpkglFOVRgeKta_enr-ZALrXY15EijIsJXjTZdWJmJTqY3mr4_O330IelfOe0CeJRo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jCWIT_OvYJwa3MHZvnxcxA-m33Gd72708n-ACNeVt6g&oe=6A09CAD7"}, "display_name": "3D scan of the Verdon's canyon", "keywords": [], "long_description": "Move like a kayaker in the canyon of the Verdon, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 2.5km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a kayaker in the canyon of the Verdon, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by kayaking about 2.5km."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subs
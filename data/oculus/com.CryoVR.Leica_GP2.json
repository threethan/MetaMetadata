IuypzvDAxke8j7zsaQdg&oe=69AD788C"}, {"file_name": "com.CryoVR.AutogridLoading-20220107-145104.png", "id": "344730354394045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282166_344730357727378_3410918617486119495_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuF8vVHM-bQQ7kNvwEpF8lt&_nc_oc=Adn5FByxQfGE0UOhT5jw9MM923dXwmHMAnBTvTD_L_KWlAe2RFj7lS8hYFLeMUB4B30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEYq3Exm3OM6bEMqzprCA2LXYOkpcDmAoT1K0XobKkFg&oe=69AD6ADC"}, {"file_name": "com.CryoVR.AutogridLoading-20220107-145152.png", "id": "730129534805385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974506_730129538138718_4720827372597581404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oc-X-oZMhgMQ7kNvwFmAtEe&_nc_oc=Adm4kGKhQw_wZ1ZlJMwu7tcKtjd7w7A9WHUsj6syV-HSILpRZ_kYUCLCDBVigaCBVFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQUPsPxRgo0hkFqUcNZgFerNRtzLvJpd4fIgVAHySSxg&oe=69AD5A5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CryoVR - Leica EM GP2 Plunge Freezer", "keywords": [], "long_description": "CryoVR (http://www.purdue.edu/cryovr) is a suite of virtual reality training tools developed at Purdue University to familiarize users with cryoEM equipment, such as microscopes and sample preparation equipment, through a safe and accessible, virtual environment. \n\nThis module, TFS Vitrobot, covers the procedure of Plunge Freezing using Thermal Fisher Scientific\u2019s Vitrobot Mark IV. The procedure complies with the standard operation procedure developed by a working group from NIH funded national CryoEM centers and curriculum development projects (https://www.cryoemcenters.org). \n\nCryoVR is funded by NIH (National Institute of Health), award # 1R25EY029127. The project is developed by a collaborative team of Purdue Intelligent Visualization and Interaction Laboratory (https://va.tech.purdue.edu) and the Jiang Lab (https://jiang.bio.purdue.edu). ", "short_descriptio
jmIbSoDXvXo-lyuuuWSQ&oe=69BE9C0C"}, {"file_name": "com.CryoVR.AutogridLoading-20220107-145104.png", "id": "344730354394045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282166_344730357727378_3410918617486119495_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Q--t7DHPAQ7kNvwEdUO3g&_nc_oc=AdmYbzt_ZC0dutTUQRVHNc9iZVSInSBh70VfZxLHsNm95SqTYBTu0LjYk_vD9JziPvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNRNij_TMDrRLxj5J9O72YizqXPRzPcNV1ZqHtNk35Pw&oe=69BE8E5C"}, {"file_name": "com.CryoVR.AutogridLoading-20220107-145152.png", "id": "730129534805385", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_730129538138718_4720827372597581404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwh9jYXGvaAQ7kNvwGJC9wT&_nc_oc=AdmirMYKPzOAuC0JibnWZmkD1UAIvfdYt70_LIn-6fm5KKOaBE9iyQDNjf2ULG5Ib6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afye9So65L8YrYmBH5BQxD-IeBy8yz8oEzdWe5HG1lNcvA&oe=69BE7DDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CryoVR - Leica EM GP2 Plunge Freezer", "keywords": [], "long_description": "CryoVR (http://www.purdue.edu/cryovr) is a suite of virtual reality training tools developed at Purdue University to familiarize users with cryoEM equipment, such as microscopes and sample preparation equipment, through a safe and accessible, virtual environment. \n\nThis module, TFS Vitrobot, covers the procedure of Plunge Freezing using Thermal Fisher Scientific\u2019s Vitrobot Mark IV. The procedure complies with the standard operation procedure developed by a working group from NIH funded national CryoEM centers and curriculum development projects (https://www.cryoemcenters.org). \n\nCryoVR is funded by NIH (National Institute of Health), award # 1R25EY029127. The project is developed by a collaborative team of Purdue Intelligent Visualization and Interaction Laboratory (https://va.tech.purdue.edu) and the Jiang Lab (https://jiang.bio.purdue.edu). ", "short_descriptio
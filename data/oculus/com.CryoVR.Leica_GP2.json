R.AutogridLoading-20220107-145104.png", "id": "344730354394045", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282166_344730357727378_3410918617486119495_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKOmsIy2a8kQ7kNvwF2IxXN&_nc_oc=AdrcLhnE5JuluL0BlmV-kPnA1cHocx2pRUR8P6-7FQBnGcaC8tQoiBiuvci_ArkeEjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EBWUvrqtrdD8mh4qhtcPhEZLfF2dAlN7g55qTzsLeEw&oe=69F1F8DC"}, {"file_name": "com.CryoVR.AutogridLoading-20220107-145152.png", "id": "730129534805385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974506_730129538138718_4720827372597581404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip6DSWuZEiIQ7kNvwFNwQjD&_nc_oc=AdrlD2dRfRU59Tz0g0gYVxYISS5IfWd4hb2bbaIUhfB4EqL8yT539gxjCapZcwQ9JOM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tqG581S-YjQ1GalCq9dFLw6HDxH7jDvaL4jA44nA9aA&oe=69F1E85B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CryoVR - Leica EM GP2 Plunge Freezer", "keywords": [], "long_description": "CryoVR (http://www.purdue.edu/cryovr) is a suite of virtual reality training tools developed at Purdue University to familiarize users with cryoEM equipment, such as microscopes and sample preparation equipment, through a safe and accessible, virtual environment. \n\nThis module, TFS Vitrobot, covers the procedure of Plunge Freezing using Thermal Fisher Scientific\u2019s Vitrobot Mark IV. The procedure complies with the standard operation procedure developed by a working group from NIH funded national CryoEM centers and curriculum development projects (https://www.cryoemcenters.org). \n\nCryoVR is funded by NIH (National Institute of Health), award # 1R25EY029127. The project is developed by a collaborative team of Purdue Intelligent Visualization and Interaction Laboratory (https://va.tech.purdue.edu) and the Jiang Lab (https://jiang.bio.purdue.edu). ", "short_description": "CryoVR Leica EM GP2 Plunge Freezer Module"}]}, 
n.com/v/t64.5771-25/39031347_410392380722651_3556236390870518779_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL90WLv9qg0Q7kNvwFE7Zl2&_nc_oc=AdrTFs9O3O7qKI2B7AgurFGgpwwniYQ6ih8gn-f3rg5lKxgQiJGc5PE4Owiqq_ise3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0kAgjgn9jaaBhO99Ss5hoNQLCykejerLHi6Nl8jULeg&oe=6B0F02CC"}, {"file_name": "com.CryoVR.AutogridLoading-20220107-145104.png", "id": "344730354394045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282166_344730357727378_3410918617486119495_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDz1YTgL7hAQ7kNvwGgknax&_nc_oc=AdqDQULgMHExFv3LgUFsc7NwIwibfBlDaYU3GMcWqgW5hnvgm5p35lpXBdIiiXTmoCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_p3ve0nkZOxrccb4snnpGxFALPN1iLFmtggiOBhwX1Q&oe=6B0EF51C"}, {"file_name": "com.CryoVR.AutogridLoading-20220107-145152.png", "id": "730129534805385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_730129538138718_4720827372597581404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EcsyO0a9sAQ7kNvwEo61US&_nc_oc=AdpKYECQWuqokUB2Lof_z0BS8iDzktEX6tiMdeFJARqStpiDLoj4wdePpPdWQLzuZCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUbJaeT-sH5CTYEXhlihORWyPEhPnqbKA6Urb7XtgiChQ&oe=6B0F1CDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CryoVR - Leica EM GP2 Plunge Freezer", "keywords": [], "long_description": "CryoVR (http://www.purdue.edu/cryovr) is a suite of virtual reality training tools developed at Purdue University to familiarize users with cryoEM equipment, such as microscopes and sample preparation equipment, through a safe and accessible, virtual environment. \n\nThis module, TFS Vitrobot, covers the procedure of Plunge Freezing using Thermal Fisher Scientific\u2019s Vitrobot Mark IV. The procedure complies with the standard operation procedure developed by a working group from NIH funded national CryoEM centers and curriculum development projects (https://www.cryoemcenters.org). \n\nCryoVR is funded by NIH (National Institute of Health), award # 1R25EY029127. The project is developed by a collaborative team of Purdue Intelligent Visualization and Interaction Laboratory (https://va.tech.purdue.edu) and the Jiang Lab (https://jiang.bio.purdue.edu). ", "short_description": "CryoVR Leica EM GP2 Plunge Freezer Module"}]}, "developer_name": null, "developer_privacy_policy_url": "https://va.tech.purdue.edu/CryoVR_download_file/CryoVR_Privacy_policies.pdf", "developer_terms_of_service_url": null, "publisher_name": "CryoVR by Purdue University", "support_website_url": null, "website_url": "https://www.purdue.edu/CryoVR/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "962313327799783"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "561950735919868"}]}, "baseline_offer": {"id": "561950735919868"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681771140, "status": "PUBLISHED", "id": "561950735919868"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6959165467494007", "version": "22.0726"}, "id": "1316769695516678", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primar
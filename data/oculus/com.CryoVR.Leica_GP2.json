ded national CryoEM centers and curriculum development projects (https://www.cryoemcenters.org). \n\nCryoVR is funded by NIH (National Institute of Health), award # 1R25EY029127. The project is developed by a collaborative team of Purdue Intelligent Visualization and Interaction Laboratory (https://va.tech.purdue.edu) and the Jiang Lab (https://jiang.bio.purdue.edu). ", "short_description": "CryoVR Leica EM GP2 Plunge Freezer Module"}]}, "developer_name": null, "developer_privacy_policy_url": "https://va.tech.purdue.edu/CryoVR_download_file/CryoVR_Privacy_policies.pdf", "developer_terms_of_service_url": null, "publisher_name": "CryoVR by Purdue University", "support_website_url": null, "website_url": "https://www.purdue.edu/CryoVR/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "962313327799783"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "561950735919868"}]}, "baseline_offer": {"id": "561950735919868"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681771140, "status": "PUBLISHED", "id": "561950735919868"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6959165467494007", "version": "22.0726"}, "id": "1316769695516678", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primar
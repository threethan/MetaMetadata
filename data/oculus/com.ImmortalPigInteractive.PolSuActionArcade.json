43329939669639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031525_1243329943002972_1797506910149041625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaaZ6eLRAYoQ7kNvwHwF310&_nc_oc=AdlNJwXtJXCGB8Mq5mxsOlyDvf0x30c70X35D0Mwh0ZsPcbrH08yFWJ85hDgC2zURpE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBMQtE2CatJUh0RlX1OOcYShTDrloiIw5clKKTH5-5qg&oe=69AEBF55"}, {"file_name": "Screenshot5.png", "id": "2373553396166107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974499_2373553399499440_4384832356136875769_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wH90AWX7jhkQ7kNvwEzqbpN&_nc_oc=Adm3b_m49t_Tv36hUfPhisTWeOyFGnz0gIrv3bByHurc07ZdTtFclZ-nfHqoCJ0GMM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxgc8wpUpg3gY5-UT9Msh-V9evH9U4P-PDASOavep1icw&oe=69AED9EF"}, {"file_name": "Screenshot4.png", "id": "1068803837477632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974692_1068803840810965_580883726076618374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QzBgBuLn38Q7kNvwHq1kz4&_nc_oc=Adlcpl-2lBfgxfXADEOrghl5_pVH_y-6WxktoV7vaFTJ9HLXh7kaPOiM0WgkjrebyiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIt1RwUgKVd71QEfCgYee7C7-aY0Nz_xH7R1dhXNEUcw&oe=69AEAC59"}, {"file_name": "Screenshot1.png", "id": "357209106727776", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974482_357209110061109_5900737474594792494_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEAZW8BMwXwQ7kNvwEUzFOt&_nc_oc=AdlMBCTaVrr6BBji1x7yngl0weRDue_bUFD5I9YoZG-Smf3bmPBN2lw4XQEinfITr4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1ZbfGJe6hA7kCi2940tuxXELaGneiUXQUEKgqpOROxQ&oe=69AECF87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PolsuAACover2560x1440.png", "id": "1935237810202901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974577_1935237813536234_5807073168415599227_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzJ4P7y63lkQ7kNvwF4zjd2&_nc_oc=AdlyCfP02MC0x80ePBJfNeYZogQQgXRkbWFMf66VAXOaz8ZxqyRhetnr5FsUlLMDT70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQJejb35xnp30BS2yVohOGdZtiKoFmdx0G2NHRg6Od_A&oe=69AED5E6"}, "display_name": "PolSu Action Arcade", "keywords": ["Action", "Arcade", "Casual", "Party", "Chill"], "long_description": "Clear the dust off of your old 1-3 letter nickname and jump into these three arcadey party games, which have their own distinct atmospheres and challenges. Play for high scores or pass the headset around for friends and family.\n\n{1750232159179260}\n# Voxel Blast\nShoot incoming voxel enemies for points. Difficulty increases over waves by modifying enemies' parameters and amounts. Extra points rewarded for accuracy.\n\n{688160063994299}\n# Rune Dungeon\nThree lane endless runner where you need to light up the way of obstacles. Difficulty ramps up over time with faster movement and changing obstacles.\n\n{1734200850516834}\n# Momentum Trials\n10 unique levels of time trials. Use jetpack and bouncy mines along with various physics manipulators found in the levels to achieve the fastest times.", "short_description": "Compete for high scores in three party games with old school arcade vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/immortalpiginteractive/privacy-policies/polsu-action-arcade-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immortal Pig Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/immortalpiginteractive/polsu-action-arcade", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics"
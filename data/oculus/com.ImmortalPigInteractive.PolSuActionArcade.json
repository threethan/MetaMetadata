10061109_5900737474594792494_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Owlo8237qEQ7kNvwEAN5v5&_nc_oc=AdqF3ExoIqqbcsZaEiLFdY8KwkogWUyhqMNKRhxHj-_y_Q9PzA6lCkIPQyz4CS-ku7I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQwvithMLUar3cZVVzajREEJSczdgzoQsAhhHXsXsGTg&oe=6B0870C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PolsuAACover2560x1440.png", "id": "1935237810202901", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974577_1935237813536234_5807073168415599227_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIH9U6chxRsQ7kNvwHN2xVS&_nc_oc=AdqTlZp57FmPdjCjSX8fUANQ3v8hSeTx5h8-bKZSm8AOrRhl48uObKzCHpaCBZl5UBc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiy2A8EqbxQajeOPSCdC7W4tl5tTYTj3n-gd3wP-bcHA&oe=6B083EE6"}, "display_name": "PolSu Action Arcade", "keywords": ["Action", "Arcade", "Casual", "Party", "Chill"], "long_description": "Clear the dust off of your old 1-3 letter nickname and jump into these three arcadey party games, which have their own distinct atmospheres and challenges. Play for high scores or pass the headset around for friends and family.\n\n{1750232159179260}\n# Voxel Blast\nShoot incoming voxel enemies for points. Difficulty increases over waves by modifying enemies' parameters and amounts. Extra points rewarded for accuracy.\n\n{688160063994299}\n# Rune Dungeon\nThree lane endless runner where you need to light up the way of obstacles. Difficulty ramps up over time with faster movement and changing obstacles.\n\n{1734200850516834}\n# Momentum Trials\n10 unique levels of time trials. Use jetpack and bouncy mines along with various physics manipulators found in the levels to achieve the fastest times.", "short_description": "Compete for high scores in three party games with old school arcade vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/immortalpiginteractive/priv
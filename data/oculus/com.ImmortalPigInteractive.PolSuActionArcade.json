43329939669639", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031525_1243329943002972_1797506910149041625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAciWJ9ZBUkQ7kNvwFhTru7&_nc_oc=Adq3QBq0oVMoIH6pGP9mJisoi7UGn6GbEKsm6C2bItX3sm6_fiOqRt_Ddr9MFJlyZcU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJO39TNccFlpQosqfhQo8EfW6tNW3_nDmg6igJjxsJRw&oe=69C13455"}, {"file_name": "Screenshot5.png", "id": "2373553396166107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974499_2373553399499440_4384832356136875769_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1joWP3m-LZkQ7kNvwE_DOAF&_nc_oc=AdrCn2sZY5qKiD9p3dJYvOoNOxnYY5XSmUw-n7mygrw87IvDJssiX_ADzYMucpnjF54&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwaJ4OLwwC2MCsHHkJnAHBwQrWO-Yh8r0_GbjNx_ffc4A&oe=69C14EEF"}, {"file_name": "Screenshot4.png", "id": "1068803837477632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974692_1068803840810965_580883726076618374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k3R206B67YQ7kNvwFhY5AE&_nc_oc=AdoJz8kMSIwnVmm2GD4rOq7tJ7Ce4uAE4ym0PF6isbqLNN4c2xp8dmCGxCxbV97IzuI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHax-rXCdiJ3VQ4j3AZ3oRkswtn3_xaslJCHIGmmwptw&oe=69C12159"}, {"file_name": "Screenshot1.png", "id": "357209106727776", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974482_357209110061109_5900737474594792494_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGGits8nFW0Q7kNvwH1yAPX&_nc_oc=AdqXZH9dytHEabHN6NmuifT5VIae0_csIUvKPPj0s7dg_ZD9CGmHqY7H1rF6lXpWdvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyBrvaiaaelyL6aFNPJ0KYnn7W-a4mMmNayPFv46BgCNg&oe=69C14487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PolsuAACover2560x1440.png", "id": "1935237810202901", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974577_1935237813536234_5807073168415599227_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVW1dEU9NvIQ7kNvwHzfWLW&_nc_oc=AdoqlD3OctpriRTFP4lgp9gmP9u_5zfSbETCHGFiHHBWW8DRvZkOVjelPKh6TBLFj-4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxG4ttezz_jnkNVhAWwbejyeN9exoBn8ATKTmnIdElu3g&oe=69C14AE6"}, "display_name": "PolSu Action Arcade", "keywords": ["Action", "Arcade", "Casual", "Party", "Chill"], "long_description": "Clear the dust off of your old 1-3 letter nickname and jump into these three arcadey party games, which have their own distinct atmospheres and challenges. Play for high scores or pass the headset around for friends and family.\n\n{1750232159179260}\n# Voxel Blast\nShoot incoming voxel enemies for points. Difficulty increases over waves by modifying enemies' parameters and amounts. Extra points rewarded for accuracy.\n\n{688160063994299}\n# Rune Dungeon\nThree lane endless runner where you need to light up the way of obstacles. Difficulty ramps up over time with faster movement and changing obstacles.\n\n{1734200850516834}\n# Momentum Trials\n10 unique levels of time trials. Use jetpack and bouncy mines along with various physics manipulators found in the levels to achieve the fastest times.", "short_description": "Compete for high scores in three party games with old school arcade vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/immortalpiginteractive/privacy-policies/polsu-action-arcade-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immortal Pig Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/immortalpiginteractive/polsu-action-arcade", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics"
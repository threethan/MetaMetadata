43329939669639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031525_1243329943002972_1797506910149041625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JI17jD2HDEQ7kNvwGjW3YP&_nc_oc=Adkm0UTZSkyGUoBXumGuQ5m1dftnx1Ptq85DBwKqC7ga2wRwStbJlJ8Vty3anwa2IlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfurCyTTmeoii5eQtRvTvm-BYv3lG4X2c7Yby9V7lZnCIQ&oe=69A97955"}, {"file_name": "Screenshot5.png", "id": "2373553396166107", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_2373553399499440_4384832356136875769_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goggFcCkA-IQ7kNvwE_zvAu&_nc_oc=Adl3rzgS8aqBv2CPZmL-7ICTkvSv62LDKftzOEwDtg7Z_8oNO53WAIbyrsAq_iqsARk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_hZ-DIGtqyIIZSLvGY6w2gY9Bn8E4GAmxzjzFxE7ABQ&oe=69A993EF"}, {"file_name": "Screenshot4.png", "id": "1068803837477632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974692_1068803840810965_580883726076618374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAT7tQztDNMQ7kNvwE7FqKB&_nc_oc=AdlQqXLrAE70eJgiupNsiqlOalng8KFrWkqkgpDuKfSKMqKItd1dA3jE60RO2q2gyOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuhjpfLve_XI-cmtZmyK532T1FOBtbMH_2V_UGpHwEyxA&oe=69A96659"}, {"file_name": "Screenshot1.png", "id": "357209106727776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974482_357209110061109_5900737474594792494_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyfvWKlwMhgQ7kNvwFsZZRe&_nc_oc=Adm0JU4TrMsTyUpphVrCU_pvDOwm5F6prjHXLgu3mo6I4qj6KwO7BY_bnnXMjyVdG8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuDgAVAV0qi_SCZMOLbRcB2qgo-24EBnZwf1D0BI3gysQ&oe=69A98987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PolsuAACover2560x1440.png", "id": "1935237810202901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974577_1935237813536234_5807073168415599227_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cYG2BhyYHwQ7kNvwFjAkeJ&_nc_oc=Adl3ldp0moJng74AzOANw6TIUWhBm3kovLYK5Fw9bj38Ta64HvFIuthTrvMkENmlQds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvLR8JRn8NcIpsERPoVxDPvIXEWj8GkQzfaufBHRVkmwg&oe=69A98FE6"}, "display_name": "PolSu Action Arcade", "keywords": ["Action", "Arcade", "Casual", "Party", "Chill"], "long_description": "Clear the dust off of your old 1-3 letter nickname and jump into these three arcadey party games, which have their own distinct atmospheres and challenges. Play for high scores or pass the headset around for friends and family.\n\n{1750232159179260}\n# Voxel Blast\nShoot incoming voxel enemies for points. Difficulty increases over waves by modifying enemies' parameters and amounts. Extra points rewarded for accuracy.\n\n{688160063994299}\n# Rune Dungeon\nThree lane endless runner where you need to light up the way of obstacles. Difficulty ramps up over time with faster movement and changing obstacles.\n\n{1734200850516834}\n# Momentum Trials\n10 unique levels of time trials. Use jetpack and bouncy mines along with various physics manipulators found in the levels to achieve the fastest times.", "short_description": "Compete for high scores in three party games with old school arcade vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/immortalpiginteractive/privacy-policies/polsu-action-arcade-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immortal Pig Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/immortalpiginteractive/polsu-action-arcade", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics"
43329939669639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031525_1243329943002972_1797506910149041625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsOWU18Gr58Q7kNvwE1KFTE&_nc_oc=AdlpXQ7SSCJ9BK08-aRsrXoGGHIl-6_-9LS_GIW9Ya5k7iaIwd2_nlwmR8LRQkBoWcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLPXfrT1M2smZrvR2l7NxF_oPtp9ICzBCPtSygYoYPYQ&oe=69B556D5"}, {"file_name": "Screenshot5.png", "id": "2373553396166107", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_2373553399499440_4384832356136875769_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTQMa0oIgHAQ7kNvwFyQgj8&_nc_oc=AdmuEnJV2qhZGiPZwp1RegxDyNdvvOYUhE9qzsPrOrhTVs2Axo4v1tT1iYJC083NQHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afymj7j-M192y1VND7S7FMjpYZfIDZ1kqbB6zi6eP8Eleg&oe=69B5392F"}, {"file_name": "Screenshot4.png", "id": "1068803837477632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974692_1068803840810965_580883726076618374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHvYUz1AT5oQ7kNvwFRfGQg&_nc_oc=Adk6UVUTTQ7wbw6TXYr8pEvGbTvSlMfXacYfdTMXVxSNqwWVC0IZN4o-I999ZWUs5mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmPNfrhwrGuJoGwWTwXatlC5_ABApAArDgVwmq8Wj4sg&oe=69B543D9"}, {"file_name": "Screenshot1.png", "id": "357209106727776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974482_357209110061109_5900737474594792494_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHN7nXCzW_sQ7kNvwFKnCEh&_nc_oc=Adle2KgO37qETrcmV0OnJO_MaIpYiq54SdpXr3TJ2y2nHT7XDz8LoEqOdal1h3gIZ4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOOHAIJMM8iBeX1suTWrQHejhXvsc1GG86m17WqtDjCQ&oe=69B56707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PolsuAACover2560x1440.png", "id": "1935237810202901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974577_1935237813536234_5807073168415599227_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_NIBu1eJj8Q7kNvwGJZJ6r&_nc_oc=AdnNK-1UKT3fKJwNi9N4VLeOhBMcJ3m2kug24Wapdk6hLFejnsiWqFLPBBy7QjINpBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeGTtLmav0rxwOrBt4WV2OxK9fDmw615SJkucrg7AuDw&oe=69B56D66"}, "display_name": "PolSu Action Arcade", "keywords": ["Action", "Arcade", "Casual", "Party", "Chill"], "long_description": "Clear the dust off of your old 1-3 letter nickname and jump into these three arcadey party games, which have their own distinct atmospheres and challenges. Play for high scores or pass the headset around for friends and family.\n\n{1750232159179260}\n# Voxel Blast\nShoot incoming voxel enemies for points. Difficulty increases over waves by modifying enemies' parameters and amounts. Extra points rewarded for accuracy.\n\n{688160063994299}\n# Rune Dungeon\nThree lane endless runner where you need to light up the way of obstacles. Difficulty ramps up over time with faster movement and changing obstacles.\n\n{1734200850516834}\n# Momentum Trials\n10 unique levels of time trials. Use jetpack and bouncy mines along with various physics manipulators found in the levels to achieve the fastest times.", "short_description": "Compete for high scores in three party games with old school arcade vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/immortalpiginteractive/privacy-policies/polsu-action-arcade-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immortal Pig Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/immortalpiginteractive/polsu-action-arcade", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics"
43329939669639", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031525_1243329943002972_1797506910149041625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPQ9DYqb6rIQ7kNvwEE3tna&_nc_oc=Adm7IhB91H95qGnn04s1mTIAiqJQuDf4eaem4FQ3I1UTm7xL_k80Vd5AfMobmMVx2-Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwG5N-_5iMNdkwqMLyQvfro8L9S8ont7mYDJKcNJd-_NA&oe=69BA9CD5"}, {"file_name": "Screenshot5.png", "id": "2373553396166107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974499_2373553399499440_4384832356136875769_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0CLEQNNyw4Q7kNvwERONto&_nc_oc=AdmZpigttg3oTxv91DsfCCNG5KFBB84VZSJ8S-I3Mh8QQ9Ajpkrkmr8HKPU1CdVQHE8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxMbG6R3-BF3VvrASEJnjdWj9dkz5CwVkwSApYipetMw&oe=69BAB76F"}, {"file_name": "Screenshot4.png", "id": "1068803837477632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974692_1068803840810965_580883726076618374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNfShF8rJLYQ7kNvwGMFw9k&_nc_oc=AdkHm0tH3vNcHRHNoyJxrJruo3bMoI1sECIMGXzy5pHal9GYVArR98Oh6wZE2WWLqZU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwI9DSMsNgt7gu5g62l2Y6iet4a71TCbb359ZMJGrUu6g&oe=69BA89D9"}, {"file_name": "Screenshot1.png", "id": "357209106727776", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974482_357209110061109_5900737474594792494_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0b9N9Z5Qy8Q7kNvwEPLTd4&_nc_oc=Adkoew1-1FpTHcTvcuhgraL38w8qXiKlFgNQTAwbuIbrPziRE_UthTBz4rZfjMKAfd0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8wUvFlwQVn1ejjgVyEqmHx-c5p-d7bHMZH_Zt2axwgg&oe=69BAAD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PolsuAACover2560x1440.png", "id": "1935237810202901", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974577_1935237813536234_5807073168415599227_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkAKEbrUVIcQ7kNvwEdoUtw&_nc_oc=Adm9b8pDYG7VBoJhihq2HhXxSwA6aPWpgJP54IlIW17i1Jo6gMiKCEIudpTephd6USo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQQhdaR8rJgjmnoT4RnYr7YuPeEhGTRiMzFMFswySMng&oe=69BAB366"}, "display_name": "PolSu Action Arcade", "keywords": ["Action", "Arcade", "Casual", "Party", "Chill"], "long_description": "Clear the dust off of your old 1-3 letter nickname and jump into these three arcadey party games, which have their own distinct atmospheres and challenges. Play for high scores or pass the headset around for friends and family.\n\n{1750232159179260}\n# Voxel Blast\nShoot incoming voxel enemies for points. Difficulty increases over waves by modifying enemies' parameters and amounts. Extra points rewarded for accuracy.\n\n{688160063994299}\n# Rune Dungeon\nThree lane endless runner where you need to light up the way of obstacles. Difficulty ramps up over time with faster movement and changing obstacles.\n\n{1734200850516834}\n# Momentum Trials\n10 unique levels of time trials. Use jetpack and bouncy mines along with various physics manipulators found in the levels to achieve the fastest times.", "short_description": "Compete for high scores in three party games with old school arcade vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/immortalpiginteractive/privacy-policies/polsu-action-arcade-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immortal Pig Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/immortalpiginteractive/polsu-action-arcade", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics"
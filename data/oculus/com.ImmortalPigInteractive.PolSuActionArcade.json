43329939669639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031525_1243329943002972_1797506910149041625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JI17jD2HDEQ7kNvwGfmBC-&_nc_oc=Adkay0y5sUNqfBHwMo_LtE9fz3zvlF6VlMUcFH8ycGvVnj2oXUslKbEr8ay9HsmDgSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvg7YT5PoKWDlRQc2COkwnB1BtWsUW63ZKe4jvGXSPKeQ&oe=69A827D5"}, {"file_name": "Screenshot5.png", "id": "2373553396166107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974499_2373553399499440_4384832356136875769_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goggFcCkA-IQ7kNvwE5faC-&_nc_oc=AdlnhTeHMCCTBDoncIFEWA7_PSSuJHFJZ2ZuEhaJsDZPqoWvA7g-8vHt0zoLR_p-2k0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7sREFnqjHxA-7uqdNF-hSfyG7PXprKbf9RwEMQ7-1qA&oe=69A80A2F"}, {"file_name": "Screenshot4.png", "id": "1068803837477632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974692_1068803840810965_580883726076618374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAT7tQztDNMQ7kNvwG76ROg&_nc_oc=AdkS87YkLk-Q3Xw-FV_vqEmEByIbfndLhIHj8UJwJjXQCBy6bYMgGYZzAvpr4ebYa0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv83B2luTKffytLgczdk09oQ-6E2a17k767WsnA-b4xYw&oe=69A814D9"}, {"file_name": "Screenshot1.png", "id": "357209106727776", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974482_357209110061109_5900737474594792494_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CqbUzYKt7wQ7kNvwEmsd6F&_nc_oc=AdkRshIWVZLTipm1-Unx2gSkUE0OuPxE0kJPH2_ulyh58KS8hHTaKLbJSkfZ6H7P62Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu-010aMy4Ne1SBfSiv6R-DkW285k8QRQyGuNmzE0Oi7A&oe=69A83807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PolsuAACover2560x1440.png", "id": "1935237810202901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974577_1935237813536234_5807073168415599227_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cYG2BhyYHwQ7kNvwEXKx_o&_nc_oc=AdkxTu0fDOOjXquH6Luewsm1JDM9s74n-_drxIssvhtzIxgd_2hINKB7F-kmMYplpL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsJJ9BTaXIbGUrHk6cZcQrqV_LwrABxD6m7RiMSwasPDg&oe=69A83E66"}, "display_name": "PolSu Action Arcade", "keywords": ["Action", "Arcade", "Casual", "Party", "Chill"], "long_description": "Clear the dust off of your old 1-3 letter nickname and jump into these three arcadey party games, which have their own distinct atmospheres and challenges. Play for high scores or pass the headset around for friends and family.\n\n{1750232159179260}\n# Voxel Blast\nShoot incoming voxel enemies for points. Difficulty increases over waves by modifying enemies' parameters and amounts. Extra points rewarded for accuracy.\n\n{688160063994299}\n# Rune Dungeon\nThree lane endless runner where you need to light up the way of obstacles. Difficulty ramps up over time with faster movement and changing obstacles.\n\n{1734200850516834}\n# Momentum Trials\n10 unique levels of time trials. Use jetpack and bouncy mines along with various physics manipulators found in the levels to achieve the fastest times.", "short_description": "Compete for high scores in three party games with old school arcade vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/immortalpiginteractive/privacy-policies/polsu-action-arcade-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immortal Pig Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/immortalpiginteractive/polsu-action-arcade", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics"
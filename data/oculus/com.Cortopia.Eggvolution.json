less fun.\n\nThis is a Cortopia Studios internal game jam project winner created for creative dexterity and developed in a very limited timeframe. As such it should be viewed as a demo that is currently lacking leaderboards and a save system. There may be bugs.\n\n\ud83d\udca1 Do you like the game or have suggestions? Feel free to drop us a comment in the reviews and we might consider updating the game in the future!", "short_description": "Eggvolutionize! \ud83e\udd5a Ever wanted a classic combine-game envisioned for VR? We have you covered! Combine the eggs into five different tiers of creatures and ship them off! \n\nThis is a Cortopia Studios internal game jam project winner created for creative dexterity and developed in a very limited timeframe."}]}, "developer_name": "Cortopia Studios", "developer_privacy_policy_url": "https://beyondframes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Beyond Frames Entertainment", "support_website_url": null, "website_url": "https://www.cortopia.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7208632385822784"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1928679080836672"}]}, "baseline_offer": {"id": "1928679080836672"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1696516013, "status": "PUBLISHED", "id": "1928679080836672"}]}, "li
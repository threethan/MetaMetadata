_nc_oc=Adr13htOaHjrlpDRtKGIiUdCub-ryVAHNN8-y171h4bBfe17baSjyBRe-mXavGI-q30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZAMOCnC0lujWMsy8emd1z9K8jrZLWutwmEOaw4nunVA&oe=6AE5F5EF"}, {"file_name": "wildwest_\uc2a4\ud06c\ub9b0\uc0f7 (4).png", "id": "637694745795426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392051_637694749128759_5407104749343449975_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zrkul5g3i4kQ7kNvwGX_pxk&_nc_oc=AdpX4oHozssE08PgFxlVCnL3nd_CduZAgWdqcZ0oJ4Rxbh3cnqSUzJkuO-LBA27IKdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAGb-GvhSnumzlny6a38pl-ji6Fo5gthM3-mvNSZjS4Q&oe=6AE60677"}, {"file_name": "wildwest_\uc2a4\ud06c\ub9b0\uc0f7 (5).png", "id": "1212432466892634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393759_1212432470225967_7491130092166667827_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wibYUSPdFAQ7kNvwEjkYzn&_nc_oc=AdpbFFVPxJoLr7PD6WeUbM25-HFJVxc-y3j9qnVXqoIFrjXDYAhAq6Fs2z6X-JbqqJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHSOhgiw0QeUBuGg8ISe8mZ046zt58JzhkyxNkWBo8tA&oe=6AE6093C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "706576122033706", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392031_706576125367039_6103392196325597596_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lprBJUxT2T0Q7kNvwF6RB_X&_nc_oc=AdrcgITqXJOS0-oMsO8FYXzTtdDLFu0uNrVaT7TTl76bCGbVDNFcsRT_ZhY-7uWJNDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOueJ6ez9P1Hc-ynf6BNUYK-mblOujea9_5-xoIDkkTlQ&oe=6AE61057"}, "display_name": "Wild West : The Last Cowboy", "keywords": [], "long_description": "Wild West : The Last Cowboy \ud83c\udf35\ud83e\udd20\ud83c\udfaf\n\nWelcome to the ultimate Wild West showdown! Wild West: The Last Cowboy is a thrilling VR shooter that puts you in the boots of a true gunslinger. With charming, Brawl Stars-style casual graphics and fast-paced action, this game delivers an immersive Western experience like never before.\n\n\ud83d\udd2b 1v1 Online Duels\nStep into the dusty streets and face off against real players in intense, real-time gunfights. Your reflexes, accuracy, and strategy will determine who walks away victorious. Every shot counts\u2014are you quick enough to survive?\n\n\u26a1 Fast Draw Ranking Battles\nTest your skills in classic Western-style quick-draw duels! Only the fastest and most precise shooters will claim the top spot on the leaderboard. Draw your revolver, aim, and fire before your opponent even blinks!\n\n\ud83c\udfdc\ufe0f Explore the Immersive Wild West\nFeel the sun scorching the desert sands as you roam through rugged frontier towns. From old saloons to dusty roads, the game captures the spirit of the Wild West, making every battle feel authentic and exhilarating.\n\n\ud83c\udfae A VR Experience Like No Other\nPut on your VR headset and step into a world where you're the hero of your own Western legend. Whether you're engaging in high-noon shootouts or climbing the ranks as the fastest draw in town, Wild West : The Last Cowboy guarantees an adrenaline-pumping adventure.\n\nAre you ready to prove you're the last cowboy standing? Grab your revolver, take your stance, and show the world what you're made of! \ud83d\udd25\ud83e\udd20", "short_description": "Wild West : The Last Cowboy \ud83c\udf35\ud83e\udd20\ud83c\udfaf\n\nBecome the fastest gunslinger in the Wild West! Wild West : The Last Cowboy is a VR shooter with Brawl Stars-style casual graphics and fast-paced action.\n\n\ud83d\udd2b 1v1 Online Duels \u2013 Challenge real players in intense shootouts. Quick reflexes decide the winner!\n\u26a1 Fast Draw Ranking \u2013 Test your speed in classic Western quick-draw battles. Climb the leaderboard!\n\ud83c\udfdc\ufe0f Immersive Western World \u2013 Step into dusty towns and experience the cowboy era."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dmong.net/ppr-zomvir
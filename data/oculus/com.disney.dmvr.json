dn.com&oh=00_AfvMK9qfkxicOFLZsLtSDdeVMUfQmabPwWwD4px4HoeiLQ&oe=69A6DA87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Trailer.png", "id": "329991854066124", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331034_329991857399457_1617919300004216832_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNPU-EdRTJEQ7kNvwHRPune&_nc_oc=AdlYMRundzDGzeXcbsK-Uz7rSuC8BGNFNpvBSRl4Df4KB_7yLVhT-QhGxglVq3VP0xU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftkLxFbLZqOYyLGW5eVQ0f3WRnNhzTH-iGvCXav9N3Uqw&oe=69A6D3BF"}, "display_name": "Disney Movies VR", "keywords": ["\u2022\tDisney", "VR", "360", "360Video"], "long_description": "Transport yourself into the wonderful world of Disney from your very own living room with Disney Movies VR. This app is a fully-immersive experience where you visit themed worlds, including Disney, Marvel and Lucasfilm, and interact with some of your favorite characters in their natural environments. Choose from multiple scenes in Disney movies and be a part of the action! Disney Movies VR is your ticket to full immersion into the many Disney experiences optimized for virtual reality. Brought to you by the imaginative minds at Disney.", "short_description": "Transport yourself into the wonderful world of Disney with Disney Movies VR, a fully-immersive Disney experience where you can visit themed worlds, including Disney, Marvel, and Lucasfilm, and interact with some of your favorite characters in their natural environments. Choose from multiple scenes in Disney movies and be a part of the action! Brought to you by the imaginative minds at Disney."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://disneytermsofuse.com/", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "co
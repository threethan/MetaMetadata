060_1379639860866336_6895084330969149911_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dld88ZdgfFEQ7kNvwEo8lxp&_nc_oc=Adp073obmeQWxkQWV-OpoBL68_VJjaW35-VHQypMUvOMQzr8ezb3TpWkwp1umI0KHzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXWDeAImMuWcU24HVc2zeTkoVf-OlVIzfi0Dm00F94Eg&oe=6AEDE7AB"}, {"file_name": "Icon_512x512.png", "id": "1066318472713262", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620599_1066318476046595_5068872888334949884_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9akE9AII738Q7kNvwHWUFV1&_nc_oc=AdoTrKmvexWED3ghFkcKuqvYh3piv1InPi6i0S-OkWM9Xx3N-gW7MHxVcaBS39OTlDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIidgL9SrZ3bc-qxoLlX31NQKHVuaunHOFkje4eg6eVQ&oe=6AEDFA43"}]}, "id": "1556823512583924", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2_ten_ghosts_one_different.png", "id": "2247852236007152", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620414_2247852239340485_5042458803102634054_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQnqkHz4QdIQ7kNvwGN6i8F&_nc_oc=AdrpXkBVrKtAfSoQ4Py0tZUwpx5ctwHdAHxUx9kwFJvqNDlkTgqnpdSLXXQSmnOnh4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg5LlGlfAzM-vLbhDOqnV8oeqj3jET2goDdyjTmEvYow&oe=6AEDE2EF"}, {"file_name": "screenshot_1_hologram_ghost.png", "id": "1789354575633538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593767690_1789354578966871_6817640666793552587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsOO0SLSr2wQ7kNvwHuC5d_&_nc_oc=Adp0J62BQZjNehOvYplg8XVJ2s5v2RrtlXVz3Lhd0p0GHQjl2Ttj_dNHTmiFoXmeG7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL0PAvuhabILtUxq-zVDbXc2g5XvegbUG4UrBXhXDtlw&oe=6AEDF897"}, {"file_name": "screenshot_3_stairs_of_light.png", "id": "1373285431586043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619374_1373285434919376_3958771873627141249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gde3M9U0C0cQ7kNvwEHKGnw&_nc_oc=AdonNUhAUg6Bleyuvjm-V-AGfKstHON3ChBRnvad_JAjozmacDoKQKJMKUQovo62y6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCmg7tC-9knvicKsFK0kX9_t_qPv1xGR5nC0ZIqNJvxw&oe=6AEDDF68"}, {"file_name": "screenshot_4_ring_of_light.png", "id": "1413456557550502", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622195_1413456560883835_3379989720686156818_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGjGnCy7PgMQ7kNvwEEDoJX&_nc_oc=AdrqzNyZo04Vv8uNb06ijkxBxKimHG62-EwpSjhpfZXghlv1XUaAqv8N9L0j1tBTNmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv6WdRDh9rtuhzcvC8xn0g9eUOvdSqI10FjTvKNCGUtg&oe=6AEDE698"}, {"file_name": "screenshot_5_lotus_and_vow.png", "id": "1398864782190420", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_1398864785523753_8023386678578750478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hU9vJDkbAkQ7kNvwFArhfR&_nc_oc=Adpzw4T-MuJnaOl2car8MFWSQcFdwegUtszJQiovCbW2Hxlsg42sUtPtI8S7-7qV1Tk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzOsceOJ4wI7kU36N269ybRJZ0f8yRWnBaBBR6tVMgiw&oe=6AEDEE24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1097027546186229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593718973_1097027552852895_2914204180715256591_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1UTucu0aXoQ7kNvwFFy7vQ&_nc_oc=AdpEbMaHoWL4GXYwilzXIROAHOXTYMgmSpbgZf-q4TiH1iOhLtf0t-Ehbu5qN0sQuMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbENhIfETjWPCZvJ6kLz1vsweuxmwOv-yQDxSYb3541w&oe=6AEDDD3C"}, "display_name": "UNDERPASS 666 - Cyberpunk \u4e07\u706f\u4f1a", "keywords": ["rhythm", "horror", "lantern", "shooter", "cyberpunk"], "long_description": "Shoot the wisps. The lanterns are not targets - they are vessels.\n\nThe abandoned underpass of Route 666 runs 104 metres, then begins again. You cannot stop, turn back, or slow down. Cut into the concrete above the entrance is a line from Dante: Lasciate ogne speranza, voi ch'intrate. Beside it a sign reads: LENGTH 104 m, EXITS 1.\n\nMando-e (\u4e07\u706f\u4f1a) is a Buddhist rite in which lamps are offered by the ten thousand. That is what you do here, with a flashlight in each hand.\n\nPale wisps drift in the dark. Shoot one and the soul is drawn into the nearest unlit lantern, which takes light in its colour. Seven colours, seven instruments - wooden fish, singing bowl, hand gong, drum, staff, bell, and for the rarest a temple bell. Light one and the same colour answers from further down the tunnel, so a single shot returns as a chord. Every hit plays the next note of Debussy's Clair de lune.\n\nThe ghosts are holograms, tenants more than enemies. Shoot one and its soul rises as a wisp.\n\nOnce every lap, something here is wrong. Spot it and the tunnel gives up lamps.\n\nAfter three minutes the tunnel slows and ten ghosts stand and wait. One of them has different eyes. Find it.\n\nBehind them the flashlight becomes a pilgrim's staff, and a stair of light climbs out of the tunnel over dark water. Nine lotuses wait on the steps; shoot one and it opens with a bell, and a ring of light grows at the top of the stairs.\n\nBehind it all, Beethoven's Moonlight Sonata - worn, and worsening the longer you stay.", "short_description": "Shoot the drifting wisps, not the lanterns. Each soul you catch is drawn into a stone lantern and lights it in its own colour, and the same colour answers from further down the tunnel - one shot comes back as a chord. A lantern rite held alone in an abandoned tunnel that will not stop looping. Three minutes of light, then ten ghosts stand and wait for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chihuahua-games.chihuahuagames.workers.dev/apps/underpass-666/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ChihuahuaGames", "support_website_url": null, "website_url": "https://chihuahua-games.chihuahuagames.workers.dev/apps/underpass-666/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1277484275451476"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1024112020261278"}]}, "baseline_offer": {"id": "1024112020261278"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789311240, "status": "PUBLISHED", "id": "1024112020261278"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1275179665681937", "version": "1.0.1"}, "id": "1025310126971183", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1176421118891126", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1275179665681937"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1025310126971183"}]}, "change_log": "UNDERPASS 666 - 1.0.1 (code 44) - resubmission after the requested changes. VR rhythm shooter set in an abandoned tunnel: shoot will-o-wisps to light stone lanterns (mandoe), spot anomalies, then a 3-minute run ends in a statue puzzle (find the green eyes), a walk up stairs of light to a ring of light, and an ar
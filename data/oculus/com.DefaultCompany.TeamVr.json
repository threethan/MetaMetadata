=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItwI_u4C_iIQ7kNvwGcagvW&_nc_oc=Adp9ILvyC6UE18vi4l1NZ_MNOKVsoAzH4pGKSYpW-dEt6O6B37VpKdxA6XsYTaWvbsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStV3c0J78SCXqc8m2Dhaw6a-FnHYWcJWg4jrCLtoNYAA&oe=6B0C6B08"}, {"file_name": "Untitled design2.png", "id": "879949104589065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829165_879949107922398_150352037690977134_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQx7fRv29e0Q7kNvwHk-CgI&_nc_oc=AdrGb8ErslHlMCHhOkuuAj8uW5MzWXkLUxtqVEl2erK6rrljTvvPeVl7pHaToSaUKjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMv0pimyWQkD-yOlVcINVEfp-F3H3UzTW0tgXCHxM3Qw&oe=6B0C8138"}, {"file_name": "Untitled design.png", "id": "2443359759484190", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_2443359762817523_6321409342160207543_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F6ao6RQwYgQ7kNvwH83HAj&_nc_oc=AdpHK6cwYdau2-x0waEgqOVtrOyZLziC45j-H0za-6NGhVtDCwIuHsZvF3axfOYcvEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGq3wbOzNexpPFPwV0n7zW-VKUswEz7vQEN_A57X8DFA&oe=6B0C65C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HorizonLearnXR_landscape_2560x1440.png", "id": "1077175378395281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1077175381728614_3234958942851533594_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zOYnmo0r6cQ7kNvwF_sM-5&_nc_oc=AdpQLl4e4jmlPdkQ9MffaHBNU_Zt9rYXC34K-GPqHU-FhoNrirBkVcnG09_2moZomH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQq-I7RcB47jUhHqyZuAtkz7RuKYDJ75grf2jbTENI3nA&oe=6B0C823E"}, "display_name": "HorizonLearnXR", "keywords": [], "long_description": "Welcome to HorizonLearnXR, an immersive virtual reality learning platform designed to make education more engaging, interactive, and accessible.\n\nHorizonLearnXR brings learning to life through virtual classrooms, interactive simulations, and immersive educational environments that help learners develop practical skills and knowledge in a unique VR experience.\n\nFeatures include:\n\n\u2022 Immersive virtual learning environments\n\u2022 Interactive skills-based learning experiences\n\u2022 Access to a wide range of educational content\n\u2022 Engaging simulations and practical exercises\n\u2022 Self-paced learning pathways\n\u2022 Support for schools, training providers, and independent learners\n\u2022 Designed for both mainstream education and specialised learning pathways\n\nWhether you're developing professional skills, exploring new subjects, or enhancing classroom learning, HorizonLearnXR provides a modern and engaging approach to education through virtual reality.\n\nStep into the future of learning with HorizonLearnXR.\n", "short_description": "HorizonLearnXR transforms online learning into immersive virtual reality experiences, combining interactive classrooms, simulations, and skills-based learning in a fully engaging VR environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-policy-for-horizonlearnxr.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Adrian Treanor", "support_website_url": null, "website_url": "https://www.horizonlearnxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
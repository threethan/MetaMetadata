=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naj_A-WLwK4Q7kNvwH46nOY&_nc_oc=AdrvvP5mfEfQhV9pD_Nei8OodmhnyCqaoOVckyPFv2PDSah8Qe0IYmOVokLq_MGVV-g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNS1oJLRyfsTo6MZWNCK-Gu3sGOhaOgiSNQsfEoo8FDg&oe=6B083E48"}, {"file_name": "Untitled design2.png", "id": "879949104589065", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491829165_879949107922398_150352037690977134_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kihIQuABUjoQ7kNvwFa0CWC&_nc_oc=AdoF3z_BvWJzir57AY9Rg0V3Q5JSzHEBk0xG6pzwzhpJkUhOs-dUjD1wEYNttyMlAgo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS09f0T_N0DniBhH5R944ZdrEUhaAEK7qiNCnf3RUeHkw&oe=6B085478"}, {"file_name": "Untitled design.png", "id": "2443359759484190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823341_2443359762817523_6321409342160207543_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f48VhchUrfMQ7kNvwEM9CqC&_nc_oc=AdrOfzNxXu9WyvNk_cdRqKgsdquyYsTrx3_a4Q_lv8x7jQTrWLiJxvEdspY5sVmvEnM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWaHNyKpQPl-7ADNck8XT8I2oJKbro1N7YZmDtrQlvmQ&oe=6B087144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HorizonLearnXR_landscape_2560x1440.png", "id": "1077175378395281", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491830904_1077175381728614_3234958942851533594_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7L3RDkTwOYQ7kNvwHEQ3DJ&_nc_oc=AdoDgURlMIwtbN5FuEXr_HBiRc8Cgv4W4UkyVkl0yn5YJAKvwNUSxncdsWwT3-EqpiA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnMjFFoQFLzj9wJno1OBCFyKNE_wRNSdmY6RNKe6mDZQ&oe=6B08557E"}, "display_name": "HorizonLearnXR", "keywords": [], "long_description": "Welcome to HorizonLearnXR, an immersive virtual reality learning platform designed to make education more engaging, interactive, and accessible.\n\nHorizonLearnXR brings learning to life through virtual classrooms, interactive simulations, and immersive educational environments that help learners develop practical skills and knowledge in a unique VR experience.\n\nFeatures include:\n\n\u2022 Immersive virtual learning environments\n\u2022 Interactive skills-based learning experiences\n\u2022 Access to a wide range of educational content\n\u2022 Engaging simulations and practical exercises\n\u2022 Self-paced learning pathways\n\u2022 Support for schools, training providers, and independent learners\n\u2022 Designed for both mainstream education and specialised learning pathways\n\nWhether you're developing professional skills, exploring new subjects, or enhancing classroom learning, HorizonLearnXR provides a modern and engaging approach to education through virtual reality.\n\nStep into the future of learning with HorizonLearnXR.\n", "short_description": "HorizonLearnXR transforms online learning into immersive virtual reality experiences, combining interactive classrooms, simulations, and skills-based learning in a fully engaging VR environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-policy-for-horizonlearnxr.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Adrian Treanor", "support_website_url": null, "website_url": "https://www.horizonlearnxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
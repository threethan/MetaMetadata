2037690977134_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBy66D8kJOUQ7kNvwGDSonV&_nc_oc=AdpaKpgLmhHn7E_EUj6_EMA70dAqAw2OB2GnmK1bGHSl8fwIqhoX_cnAbAnjbIM3KSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJljg9LumoejmeT7yGZsmsdMnG6UuL7t2auEZQlldCHig&oe=6AB545F8"}, {"file_name": "Untitled design.png", "id": "2443359759484190", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_2443359762817523_6321409342160207543_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA_nLvLmi7MQ7kNvwHiPJzu&_nc_oc=AdqzKxFv5xDKHzMjMG5Z2m39Nywa3GgmyMQyzGnLiqS9GK-TYUZXuOeKfaWfX9CETNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRcCP8KCmSZ05KCxaj-qRc3K0pfX6qh3Kj0fi9LROHJA&oe=6AB52A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HorizonLearnXR_landscape_2560x1440.png", "id": "1077175378395281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_1077175381728614_3234958942851533594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rJzkbN3RJUQ7kNvwH8LyRS&_nc_oc=Adryu-vx79mDBaXVNvN98LnDI-SHcqkBwdFna3k2eSMHSU3DX5BUIRsaaaKDXg1NmC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQw6vKp7fYa4TIwXb1AimkeCc2_kk4qtTNG-XVwr7WNg&oe=6AB546FE"}, "display_name": "HorizonLearnXR", "keywords": [], "long_description": "Welcome to HorizonLearnXR, an immersive virtual reality learning platform designed to make education more engaging, interactive, and accessible.\n\nHorizonLearnXR brings learning to life through virtual classrooms, interactive simulations, and immersive educational environments that help learners develop practical skills and knowledge in a unique VR experience.\n\nFeatures include:\n\n\u2022 Immersive virtual learning environments\n\u2022 Interactive skills-based learning experiences\n\u2022 Access to a wide range of educational content\n\u2022 Engaging simulations and practical exercises\n\u2022 Self-paced learning pathways\n\u2022 Support for schools, training providers, and independent learners\n\u2022 Designed for both mainstream education and specialised learning pathways\n\nWhether you're developing professional skills, exploring new subjects, or enhancing classroom learning, HorizonLearnXR provides a modern and engaging approach to education through virtual reality.\n\nStep into the future of learning with HorizonLearnXR.\n", "short_description": "HorizonLearnXR transforms online learning into immersive virtual reality experiences, combining interactive classrooms, simulations, and skills-based learning in a fully engaging VR environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-policy-for-horizonlearnxr.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Adrian Treanor", "support_website_url": null, "website_url": "https://www.horizonlearnxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "38244813488467582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_1412353264371715_8313434092045912645_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRyHXpcZLxYQ7kNvwGrks4p&_nc_oc=AdqI4t5ieP0oB5y5R2YFXpMbgy5UnCZc0AwUrC1zCHL-abC_E6rZ9y0L5gqx5yBE5d8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDtnVXWgz_TYyFzH4hVT
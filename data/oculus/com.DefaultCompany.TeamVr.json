2037690977134_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH2D1k4TQnkQ7kNvwFasjJd&_nc_oc=Adon-9nAqyjWnAmlUftpPnPKuI0yhL63f8ObHy9-DySxJzvlvlUYEGWgdqo-VOOEifA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThdP5GDq5Jtg8jwxk0F_eZSdrvmq1fIA4Vb0ChDKLvrg&oe=6AE75EF8"}, {"file_name": "Untitled design.png", "id": "2443359759484190", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_2443359762817523_6321409342160207543_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXBqcJ_jsLYQ7kNvwFb5lOt&_nc_oc=Adpkr1piYa4ZKD8jsSzL6k3v-iBUe2iMai76DeuX10dhkOfBlML8Rxbdd_2XlNxPaSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZG77j851k9ZHU4Gh1ssjiUciHwSsf0DdRj9szMkA1Iw&oe=6AE74384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HorizonLearnXR_landscape_2560x1440.png", "id": "1077175378395281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_1077175381728614_3234958942851533594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-a_A3zlMw8Q7kNvwH4Dqfs&_nc_oc=AdqDvX9ETdwWprkfQb687LB6fgrgA-sp8oJtZNoIfJQS5VKgPQcQRSJuGO00LZJy_S8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd6Buv8nITrM1HVHF9zBxBc6mannyPQlv-fu434tTbqw&oe=6AE75FFE"}, "display_name": "HorizonLearnXR", "keywords": [], "long_description": "Welcome to HorizonLearnXR, an immersive virtual reality learning platform designed to make education more engaging, interactive, and accessible.\n\nHorizonLearnXR brings learning to life through virtual classrooms, interactive simulations, and immersive educational environments that help learners develop practical skills and knowledge in a unique VR experience.\n\nFeatures include:\n\n\u2022 Immersive virtual learning environments\n\u2022 Interactive skills-based learning experiences\n\u2022 Access to a wide range of educational content\n\u2022 Engaging simulations and practical exercises\n\u2022 Self-paced learning pathways\n\u2022 Support for schools, training providers, and independent learners\n\u2022 Designed for both mainstream education and specialised learning pathways\n\nWhether you're developing professional skills, exploring new subjects, or enhancing classroom learning, HorizonLearnXR provides a modern and engaging approach to education through virtual reality.\n\nStep into the future of learning with HorizonLearnXR.\n", "short_description": "HorizonLearnXR transforms online learning into immersive virtual reality experiences, combining interactive classrooms, simulations, and skills-based learning in a fully engaging VR environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-policy-for-horizonlearnxr.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Adrian Treanor", "support_website_url": null, "website_url": "https://www.horizonlearnxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "38244813488467582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_1412353264371715_8313434092045912645_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8VYfMi0L-MQ7kNvwEErOp-&_nc_oc=AdpvpnrgwKZZAb0zbWOCOatYHc0b60Ky_Nt2-RQ4_VSWoBUqOBahebKu1hfNskc7gjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1jck6izOq5v_1luPNPJ
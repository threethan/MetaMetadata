=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naj_A-WLwK4Q7kNvwEdQ2ag&_nc_oc=AdrKZM3A8F8O2iStXId__E1ECPEgPPkWX7Nk40vW06ydtZvxjHg9JOzXi-wLpbkw_MQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmrVvxfZy2ohmsZALCgjSYNi6Qi3fXge8DEMuAJFGZiw&oe=6B05D388"}, {"file_name": "Untitled design2.png", "id": "879949104589065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829165_879949107922398_150352037690977134_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itrKe66rnssQ7kNvwHpk7p9&_nc_oc=AdriZiBIpBXLNY55eBD828ttM8NyLjnaUHgIrzLO4j-z8xwYwoXIxGhnhN5KbOvAMbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ82UVMJV5iUM6d_5w_AycgdtVHmQadjpZtiPcCY4x-w&oe=6B05B178"}, {"file_name": "Untitled design.png", "id": "2443359759484190", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_2443359762817523_6321409342160207543_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f48VhchUrfMQ7kNvwEMS-Ii&_nc_oc=Ado8gXt8X8VjQpgZQjPMqpsTQ8dJOQ1BjKyxGfpfiwKGDTCl72KgCcEKajbLTG478gA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWrWA1KzEytIBmGOQuMwM13OyB-e9HxVF7KI7gxy4iTA&oe=6B05CE44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HorizonLearnXR_landscape_2560x1440.png", "id": "1077175378395281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1077175381728614_3234958942851533594_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7L3RDkTwOYQ7kNvwG5AzLw&_nc_oc=AdoRiuVdVERyS_SYRBV2hILhKYigtKqa47n4qQa0Xp1dfSN1JBu6J6LC7Yh-1nprjMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw1xo32gHzdbuuiIdbgveVWVdjrCBTNlA03Pf7T6Ci1Q&oe=6B05B27E"}, "display_name": "HorizonLearnXR", "keywords": [], "long_description": "Welcome to HorizonLearnXR, an immersive virtual reality learning platform designed to make education more engaging, interactive, and accessible.\n\nHorizonLearnXR brings learning to life through virtual classrooms, interactive simulations, and immersive educational environments that help learners develop practical skills and knowledge in a unique VR experience.\n\nFeatures include:\n\n\u2022 Immersive virtual learning environments\n\u2022 Interactive skills-based learning experiences\n\u2022 Access to a wide range of educational content\n\u2022 Engaging simulations and practical exercises\n\u2022 Self-paced learning pathways\n\u2022 Support for schools, training providers, and independent learners\n\u2022 Designed for both mainstream education and specialised learning pathways\n\nWhether you're developing professional skills, exploring new subjects, or enhancing classroom learning, HorizonLearnXR provides a modern and engaging approach to education through virtual reality.\n\nStep into the future of learning with HorizonLearnXR.\n", "short_description": "HorizonLearnXR transforms online learning into immersive virtual reality experiences, combining interactive classrooms, simulations, and skills-based learning in a fully engaging VR environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-policy-for-horizonlearnxr.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Adrian Treanor", "support_website_url": null, "website_url": "https://www.horizonlearnxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
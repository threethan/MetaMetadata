2037690977134_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVkX_YIIcdoQ7kNvwHKNrGN&_nc_oc=Adq9rNE_7BWupWDOdrWrVef9oYcz_q7lgS2w1MwNyjfD4w4o7nOGPqAF9-zhFXpMFRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM2qSiG8jDfDXsi5XRTy_7GKlVsbSGs3cloM_tyH12Ew&oe=6ABA8BF8"}, {"file_name": "Untitled design.png", "id": "2443359759484190", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_2443359762817523_6321409342160207543_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH4o-nTVXpUQ7kNvwE95QWH&_nc_oc=AdrDW5k9mDIy-2Myw3cVclueAMddfMNoA_es-RG8PXjoRnzfs_I1WnE13K-Co7gnyjc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvbMsaZnNCDgSQFAbHypZeoD8h7PBFg8I359xzPEJCaA&oe=6ABA7084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HorizonLearnXR_landscape_2560x1440.png", "id": "1077175378395281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830904_1077175381728614_3234958942851533594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGa_rdP8pHAQ7kNvwE7J5QC&_nc_oc=AdorzJxB0mT1j8_gxR8FlOaZ8qbZzGF1tBNPbkKjJAbQcV27YzCrAoDtxJA1Y9wNcQU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoNT8uzTm5WU87uckKcmkKNYku9gEfi9xsKqeTt8IjlA&oe=6ABA8CFE"}, "display_name": "HorizonLearnXR", "keywords": [], "long_description": "Welcome to HorizonLearnXR, an immersive virtual reality learning platform designed to make education more engaging, interactive, and accessible.\n\nHorizonLearnXR brings learning to life through virtual classrooms, interactive simulations, and immersive educational environments that help learners develop practical skills and knowledge in a unique VR experience.\n\nFeatures include:\n\n\u2022 Immersive virtual learning environments\n\u2022 Interactive skills-based learning experiences\n\u2022 Access to a wide range of educational content\n\u2022 Engaging simulations and practical exercises\n\u2022 Self-paced learning pathways\n\u2022 Support for schools, training providers, and independent learners\n\u2022 Designed for both mainstream education and specialised learning pathways\n\nWhether you're developing professional skills, exploring new subjects, or enhancing classroom learning, HorizonLearnXR provides a modern and engaging approach to education through virtual reality.\n\nStep into the future of learning with HorizonLearnXR.\n", "short_description": "HorizonLearnXR transforms online learning into immersive virtual reality experiences, combining interactive classrooms, simulations, and skills-based learning in a fully engaging VR environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-policy-for-horizonlearnxr.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Adrian Treanor", "support_website_url": null, "website_url": "https://www.horizonlearnxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "38244813488467582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596149727_1412353264371715_8313434092045912645_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lizZLV0Dc8Q7kNvwF4_V4g&_nc_oc=AdqwATbkJfx6O_xBRsgXqPQIl2MeibgOuyAfH21PVYXDAbqo84fDLK8v8tVZN-s9nWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2ke_nnAzo4QbiELHfLf
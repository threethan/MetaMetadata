2037690977134_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH2D1k4TQnkQ7kNvwHIr6bJ&_nc_oc=AdpfqX_ATgOfZxcvZch0OhOYVHBEtBXtM1DCHIi9CjUXo-eYEwn_ISwakbQxKhtGfpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7RRlgd5zEV0mDEfU74NBheE8Y6w7QkpltNmok5q18Kw&oe=6AE60D78"}, {"file_name": "Untitled design.png", "id": "2443359759484190", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_2443359762817523_6321409342160207543_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXBqcJ_jsLYQ7kNvwESpLBq&_nc_oc=AdovYJBenN4kzklt94L8rr_2iHm75bE2QV6Yv16hGOXEPU5ClCm80hQmAspIJchxQ60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTutNjiWEXhSL_C114G11KPJL5xH-XeXD1-g8p1g72Fw&oe=6AE5F204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HorizonLearnXR_landscape_2560x1440.png", "id": "1077175378395281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_1077175381728614_3234958942851533594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-a_A3zlMw8Q7kNvwHB4zAe&_nc_oc=AdrltY-s67UnAHssA1t0WL2kqAECWsw1xXrP7hZzY8B-ZbNUEvpIOAeHtGqK8HO7s_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoiuFdCTgaBlU-IZugx9IeLxfMljB9VmFalnH5lsXRKg&oe=6AE60E7E"}, "display_name": "HorizonLearnXR", "keywords": [], "long_description": "Welcome to HorizonLearnXR, an immersive virtual reality learning platform designed to make education more engaging, interactive, and accessible.\n\nHorizonLearnXR brings learning to life through virtual classrooms, interactive simulations, and immersive educational environments that help learners develop practical skills and knowledge in a unique VR experience.\n\nFeatures include:\n\n\u2022 Immersive virtual learning environments\n\u2022 Interactive skills-based learning experiences\n\u2022 Access to a wide range of educational content\n\u2022 Engaging simulations and practical exercises\n\u2022 Self-paced learning pathways\n\u2022 Support for schools, training providers, and independent learners\n\u2022 Designed for both mainstream education and specialised learning pathways\n\nWhether you're developing professional skills, exploring new subjects, or enhancing classroom learning, HorizonLearnXR provides a modern and engaging approach to education through virtual reality.\n\nStep into the future of learning with HorizonLearnXR.\n", "short_description": "HorizonLearnXR transforms online learning into immersive virtual reality experiences, combining interactive classrooms, simulations, and skills-based learning in a fully engaging VR environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-policy-for-horizonlearnxr.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Adrian Treanor", "support_website_url": null, "website_url": "https://www.horizonlearnxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "38244813488467582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_1412353264371715_8313434092045912645_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8VYfMi0L-MQ7kNvwGVFeKw&_nc_oc=Adplo9yXmKlz51Bbemzimw3XtWZBe9wTbNbhwQg_wTDnCpVEwmS4dfsIkC5UuXjOn2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8bDuBsZTmtB59_t2DVd
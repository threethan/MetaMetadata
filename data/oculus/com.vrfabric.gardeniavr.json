=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bZQSVuPaIMQ7kNvwENJAYM&_nc_oc=AdrWtLqm4Ov7vV-FU-V1_xp_94AUnADigKuCkQVQaMf-Zy0mNqY2WqsGPHESUwfVRks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHSjmE-Of3gGeljyqTbGP0XMP-Daz5LhTaqbvVVJ-Iyw&oe=6B0482BA"}, {"file_name": "38982500_1744360005915299_4679405036742276943_n.png", "id": "295492253160542", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210392_295492256493875_6265661070974573467_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBKCcTolYIYQ7kNvwHpAODN&_nc_oc=AdrplrNk6LfWQfw3hVdZEBfoUmfdmO6bL5cdDTNclhPMuTqkCC4nEWvwYSxo9rH1Gf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkr_vC3GxsREf0OPOMzdNZoDYsporE4lZKa1pZiqoT2g&oe=6B046D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "57569423_1054771248755892_3702692832221211990_n.png", "id": "129256166877255", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_129256170210588_7978277858508373575_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB3sz2n3QU0Q7kNvwEg5dW_&_nc_oc=Ado77GXihWjkQrY-IViOgOOp4eLJiEraAtxqANsf_0ovh1Ul8iwznDmcDdf1pjr1Epg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdg3_Hpr47BNHJLHS8x9DtUqxz8Im2KxHpNwYr7vNy5w&oe=6B046ED1"}, "display_name": "Gardenia VR", "keywords": [], "long_description": "Gardenia is a FPP gardening simulator with elements of platformer, crafting, adventure, exploration and more!\n\nDiscover a beautiful place that is carefree and full of holiday peace. Find treasure and magic mushrooms that will give you access to the most interesting locations. Collect raw materials that you will use on the magic crafting table. Arrange the garden space at your discretion. Make friends with fancy inhabitants and find treasures!\n\nBut remember, your main goal will be to solve the mystery of who is behind the pollution that appears on the island.\n\nKey Features:\nAn atmosphere of relaxation on a distant paradise island\nArrange the space the way you want to create beautiful plant compositions\nA beautiful story to experience and a mystery to unravel\nA unique crafting system based on the Magic Crafting Table\nDexterity elements (magic mushrooms and their properties)", "short_description": "A laid-back combination of a gardening simulator and a fairy tale adventure. Help Wood Grandpa clean the island and restore its beauty so that its former inhabitants can return to their homes. Take photos of your garden compositions, relax and discover the secrets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrfabric.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRFabric S.A", "support_website_url": null, "website_url": "https://www.vrfabric.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "es", "it", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "260993976732242"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "550286324413798"}, {"status": "PUBLISHED", "id": "313943214373431"}]}, "baseline_offer": {"id": "550286324413798"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732095240, "status": "PUBLISHED", "id": "550286324413798"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinar
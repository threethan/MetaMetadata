cb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbf66YeihLAQ7kNvwFgdjqZ&_nc_oc=Adq6VpoYoofdXfHb9ZoeP8_1zSkM6eaSc6e1H2xT5kkhXSd_fu6MnEEJPb9nM6rk1LA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTalEyRps1J8a4yBSVb_QaOT8H6KZfSN9Bo79xmKF3xiw&oe=6B0078D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "57569423_1054771248755892_3702692832221211990_n.png", "id": "129256166877255", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_129256170210588_7978277858508373575_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99n21W7CowEQ7kNvwFzg0Vx&_nc_oc=AdpKqfNSMYy5Eb5LmMMZteaIp-0d7EZtRfxRckqgqaSpVIv8Li9otxslz7xQmIX4tJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPJYqJMC9gl3XkxOkmk9QoCiBG8M3_8pqsYzPlIk9gFw&oe=6B007A51"}, "display_name": "Gardenia VR", "keywords": ["gardenia", "adventure", "3d", "platform", "fantasy"], "long_description": "Gardenia is a FPP gardening simulator with elements of platformer, crafting, adventure, exploration and more!\n\nDiscover a beautiful place that is carefree and full of holiday peace. Find treasure and magic mushrooms that will give you access to the most interesting locations. Collect raw materials that you will use on the magic crafting table. Arrange the garden space at your discretion. Make friends with fancy inhabitants and find treasures!\n\nBut remember, your main goal will be to solve the mystery of who is behind the pollution that appears on the island.\n\nKey Features:\nAn atmosphere of relaxation on a distant paradise island\nArrange the space the way you want to create beautiful plant compositions\nA beautiful story to experience and a mystery to unravel\nA unique crafting system based on the Magic Crafting Table\nDexterity elements (magic mushrooms and their properties)", "short_description": "A laid-back combination of a gardening simulator and a fairy tale adventure. Help Wood Grandpa clean the island and restore its beauty so that its former inhabitants can return to their homes. Take photos of your garden compositions, relax and discover the secrets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrfabric.info/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRFabric S.A", "support_website_url": null, "website_url": "https://www.vrfabric.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "es", "it", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8623778464335776"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/229368333_1223190672021073_6337572030077464088_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Af77kJN4QMQ7kNvwG_J7-1&_nc_oc=AdoheZxlHlTmQIiuCPqqtLT6X4hhCqWOhW6ze2VymW2pvGEN0Xzm_SCO75diP_BxoTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9YkFaLiJ2yObPBWcIGVhR4jtU0LFJmR6H7HyeIPtD6g&oe=6B007AFA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gardenia VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}]
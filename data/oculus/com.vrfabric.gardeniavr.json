=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llpyOymkHjoQ7kNvwGBWglS&_nc_oc=AdotrI7B9xlz9a3Z0g5RUp74Bb8ywIdWTKoP1gPdx1NngRC5Fb7yuXUJbeMVHDcCXCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9eC_0uI643KnLF5UtC8ya9jMgrcCqyqa5RKlIsIDtPQ&oe=6AFDB2FA"}, {"file_name": "38982500_1744360005915299_4679405036742276943_n.png", "id": "295492253160542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210392_295492256493875_6265661070974573467_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbf66YeihLAQ7kNvwH6CqH8&_nc_oc=AdrIoPoYapbiZB7ULHvCfCJZUzj0g0gTr2-YD8XKp5175ERq66WGk_bb_LVkBpLaeWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx053ZmBEMaj5fedxHUd6DRj0nOCCGON8g8iirF9-Uew&oe=6AFDD5D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "57569423_1054771248755892_3702692832221211990_n.png", "id": "129256166877255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_129256170210588_7978277858508373575_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Tc5LCPbEQQ7kNvwFSVXdI&_nc_oc=AdpKYLTLA_7MnnmLfviatt4V6YpDyHkMt2d4bUY-C-Nm3HU58Oqg3yxko4N9S8ApCbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsSJAJrhO1DCNlpI5MSLPp_HUOcjn9DB2OKHI--sH3EQ&oe=6AFDD751"}, "display_name": "Gardenia VR", "keywords": [], "long_description": "Gardenia is a FPP gardening simulator with elements of platformer, crafting, adventure, exploration and more!\n\nDiscover a beautiful place that is carefree and full of holiday peace. Find treasure and magic mushrooms that will give you access to the most interesting locations. Collect raw materials that you will use on the magic crafting table. Arrange the garden space at your discretion. Make friends with fancy inhabitants and find treasures!\n\nBut remember, your main goal will be to solve the mystery of who is behind the pollution that appears on the island.\n\nKey Features:\nAn atmosphere of relaxation on a distant paradise island\nArrange the space the way you want to create beautiful plant compositions\nA beautiful story to experience and a mystery to unravel\nA unique crafting system based on the Magic Crafting Table\nDexterity elements (magic mushrooms and their properties)", "short_description": "A laid-back combination of a gardening simulator and a fairy tale adventure. Help Wood Grandpa clean the island and restore its beauty so that its former inhabitants can return to their homes. Take photos of your garden compositions, relax and discover the secrets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrfabric.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRFabric S.A", "support_website_url": null, "website_url": "https://www.vrfabric.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "es", "it", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "260993976732242"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "550286324413798"}, {"status": "PUBLISHED", "id": "313943214373431"}]}, "baseline_offer": {"id": "550286324413798"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732095240, "status": "PUBLISHED", "id": "550286324413798"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinar
WB_7i4Vf4DCJLbzdBM-w&oe=6A6897AE"}, {"file_name": "4_Tutorial_2560x1440.png", "id": "1109301977534038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982571_1109301980867371_5850168589010877267_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iw6bDlAK6aQQ7kNvwHXb_Iy&_nc_oc=AdrV-usgcaCSGCEvdcTqmWo4eGWKDnhjNwAqsTFx74fK7_LF6ycfD2nE_AHYv6TgNLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVs3PREbmNcUQZK8nSxSnHQqPH6NO67lK8oFu58jzrDQ&oe=6A68A8B4"}, {"file_name": "5_Playback_2560x1440.png", "id": "1631285457804128", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982571_1631285461137461_4302012558881163548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbbRC2N6LJwQ7kNvwEVl99c&_nc_oc=AdrCWwehEq7eYGMMDQeZUjhBe0TzV8_Uf3zqqd1OlK5eNAjaZCRxs0Xdf3p6Rr2hMns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADsFiJEogkym_VpcXlZbvD3ALb7UOZNYaIeeWKEBjtLw&oe=6A689C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1040588121135362", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974508_1040588131135361_6327032771678843995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5zFKpE8XHkQ7kNvwHMbgjJ&_nc_oc=AdpBsdZLrZ7BiAO902vqEmrrNZQDf1UjeFIdeBSn6n4ePIMfR9WZZWfXIYA3Tbjr0V8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsrAjh1FFJ-IMCYPrpsG6M58Q_cpW-4d2EXLfQMeDW-A&oe=6A68942E"}, "display_name": "Theater Elsewhere", "keywords": ["quill", "art", "media", "story", "animation"], "long_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  \n\nFeaturing:\n- 2400+ delightful immersive animated content\n- 6 beautiful immersive backgrounds that can be set as the default browsing environment\n- Intuitive and fast user interface\n- Freefly Mode that allows users to move freely within each experience\n\nIf you would like to share your own creations, test your hand in the VR painting and animation app, Quill by Smoothstep, available on the Meta Quest PCVR platform, upload your content through Meta Quest Media Studio and it will appear in the \u201cNewest\u201d section of Theater Elsewhere.  \n\nQuill by Smoothstep\n\nhttps://www.meta.com/experiences/pcvr/quill-by-smoothstep/5910229332328230/\n\nMeta Quest Media Studio\n\nhttps://creator.oculus.com/manage/mediastudio/\n", "short_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/supplemental-terms-of-service/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://www.meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MEDIA_PLAYER", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8831553686891049"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031516_2111865989208545_6
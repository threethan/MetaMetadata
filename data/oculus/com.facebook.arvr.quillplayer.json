982571_1109301980867371_5850168589010877267_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmv-Bxjs3vcQ7kNvwFbUPRj&_nc_oc=AdlhJEMnp4VuQDL4tMha0z4CZJVRzqwdjzjfCF51U5xQ0bUnVaThSGYuEejBDZ7b1KI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRlh3O5iJWOn8FiTwioY2H3M51nZdUDqppbuHQ2s_FVA&oe=69BFE8B4"}, {"file_name": "5_Playback_2560x1440.png", "id": "1631285457804128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982571_1631285461137461_4302012558881163548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wnFuFpmk3AQ7kNvwETP4xW&_nc_oc=Admh0OsEO6ZnDQqtaMdiT9zZVSgo6UV3-RXnQpvG8HqWyXdcgkAvQJhzeixri4SZ_XM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_q0cf7gZWEFc-V1eexWnarZPEAz2I9JaRycBBmB0l6w&oe=69BFDC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1040588121135362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974508_1040588131135361_6327032771678843995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I431hse1jJQQ7kNvwG4u1Mp&_nc_oc=AdkMaTpFKz_NrKFrgTc3yq-fQfq0LKEUnMfQ_OWPahd0RpuiBs_hHj26cT3Pc3MCoSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0XzfXBXOn0nSerIBbOqKx026G661V4ENpw2tHeRgVUA&oe=69BFD42E"}, "display_name": "Theater Elsewhere", "keywords": ["quill", "art", "media", "story", "animation"], "long_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  \n\nFeaturing:\n- 2400+ delightful immersive animated content\n- 6 beautiful immersive backgrounds that can be set as the default browsing environment\n- Intuitive and fast user interface\n- Freefly Mode that allows users to move freely within each experience\n\nIf you would like to share your own creations, test your hand in the VR painting and animation app, Quill by Smoothstep, available on the Meta Quest PCVR platform, upload your content through Meta Quest Media Studio and it will appear in the \u201cNewest\u201d section of Theater Elsewhere.  \n\nQuill by Smoothstep\n\nhttps://www.meta.com/experiences/pcvr/quill-by-smoothstep/5910229332328230/\n\nMeta Quest Media Studio\n\nhttps://creator.oculus.com/manage/mediastudio/\n", "short_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/supplemental-terms-of-service/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://www.meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MEDIA_PLAYER", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8831553686891049"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031516_2111865989208545_6490604774794830650_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y79ru3XXZM8Q7kNvwHWknJL&_nc_oc=Admd_7MUpdV-WpMcObdVforI-9Uua440dqfNzhjWetSwpff1DfKgNt0W8JpR
 "media", "story", "animation"], "long_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  \n\nFeaturing:\n- 2400+ delightful immersive animated content\n- 6 beautiful immersive backgrounds that can be set as the default browsing environment\n- Intuitive and fast user interface\n- Freefly Mode that allows users to move freely within each experience\n\nIf you would like to share your own creations, test your hand in the VR painting and animation app, Quill by Smoothstep, available on the Meta Quest PCVR platform, upload your content through Meta Quest Media Studio and it will appear in the \u201cNewest\u201d section of Theater Elsewhere.  \n\nQuill by Smoothstep\n\nhttps://www.meta.com/experiences/pcvr/quill-by-smoothstep/5910229332328230/\n\nMeta Quest Media Studio\n\nhttps://creator.oculus.com/manage/mediastudio/\n", "short_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/supplemental-terms-of-service/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://www.meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MEDIA_PLAYER", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
axsioacDWvDVU1wUzVTg&oe=6A6F2F2E"}, {"file_name": "4_Tutorial_2560x1440.png", "id": "1109301977534038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982571_1109301980867371_5850168589010877267_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnalBcV_6r8Q7kNvwH7uRvB&_nc_oc=AdoN3Kr4IPoe2-5x8zixv07fb9OlRZLSGuH2dB3bS6cAVPFsY4i2CkOiU_Gu1GH0qEw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCViByAY3azY1Hn-0i5djxRmGCuVsati9wueVrRilQ_pA&oe=6A6F4034"}, {"file_name": "5_Playback_2560x1440.png", "id": "1631285457804128", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982571_1631285461137461_4302012558881163548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UybREsbZw0kQ7kNvwHVyKas&_nc_oc=AdrLorNXmLmPrhkWDkgTo0JEauYDTLUSikPR3ChLpzNsg2rcLVjncZAYgYo5tK_FfVk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEbot9uZgdoVwqub_-d1DPjSt1E7ZEE6z5EjBngC33PQ&oe=6A6F339D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1040588121135362", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974508_1040588131135361_6327032771678843995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCIDGRLhzC0Q7kNvwFHCLzx&_nc_oc=AdpcYvp2PVF9MRZtEoX8alkcjZ-L7y7PTKNg2hW7YHyj6h3JzYUqDi0j6AFrK3oGj3M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDn1yIe5bqOnjDt1Qw46g2BUGe85HRahZDBFHeC6L1fA&oe=6A6F2BAE"}, "display_name": "Theater Elsewhere", "keywords": ["quill", "art", "media", "story", "animation"], "long_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  \n\nFeaturing:\n- 2400+ delightful immersive animated content\n- 6 beautiful immersive backgrounds that can be set as the default browsing environment\n- Intuitive and fast user interface\n- Freefly Mode that allows users to move freely within each experience\n\nIf you would like to share your own creations, test your hand in the VR painting and animation app, Quill by Smoothstep, available on the Meta Quest PCVR platform, upload your content through Meta Quest Media Studio and it will appear in the \u201cNewest\u201d section of Theater Elsewhere.  \n\nQuill by Smoothstep\n\nhttps://www.meta.com/experiences/pcvr/quill-by-smoothstep/5910229332328230/\n\nMeta Quest Media Studio\n\nhttps://creator.oculus.com/manage/mediastudio/\n", "short_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/supplemental-terms-of-service/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://www.meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MEDIA_PLAYER", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8831553686891049"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031516_2111865989208545_6
inting and animation app, Quill by Smoothstep, available on the Meta Quest PCVR platform, upload your content through Meta Quest Media Studio and it will appear in the \u201cNewest\u201d section of Theater Elsewhere.  \n\nQuill by Smoothstep\n\nhttps://www.meta.com/experiences/pcvr/quill-by-smoothstep/5910229332328230/\n\nMeta Quest Media Studio\n\nhttps://creator.oculus.com/manage/mediastudio/\n", "short_description": "Dive into art that lives elsewhere, hand painted and animated by creators from all over the world. Enjoy expressive characters, delightful moments, and long form narratives in virtual reality. Theater Elsewhere brings the magic to you.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/supplemental-terms-of-service/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://www.meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MEDIA_PLAYER", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8831553686891049"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031516_2111865989208545_6490604774794830650_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuWOOFJp_lMQ7kNvwEeF6uk&_nc_oc=AdrmTenj
946086_7795938437472235889_n.png", "id": "1907925483364704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_1907925490031370_6928981877358636246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD1zvGFgPvAQ7kNvwF_CO55&_nc_oc=AdpFvm5F79ul_ZpCvI1PSoeHphLcY961HT5id9RpnWDNbCR3rrmmyPxPCJ0GwRvCWl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GCPyP4DMrHP8qQbnJqAI_CIXVeO4Lqh0lCtroJJX6eA&oe=69DA5D7B"}, {"file_name": "491824012_1260451822124149_3969356052079845229_n.png", "id": "1220327949732302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825546_1220327953065635_2134864463801686871_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSgHsY7P-yoQ7kNvwG-QjCX&_nc_oc=AdpFua7ISzirR8ygaGCeFA2lK9og9zRW5C81piHVDH4kZN7fSlOhSTXaXm346oueYQo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lpAqAosWtf4oS4wLks2RRZR-KRKZkyfpd7VJ-mUvpDw&oe=69DA30E4"}, {"file_name": "491824594_1615303349166198_664041616935848413_n.png", "id": "653388517748545", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827585_653388521081878_7850382452985636639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpgZyzPUQvcQ7kNvwE6RbfZ&_nc_oc=AdotDHOAqlVLLN6ISJJy0IGDnco4CC8GtJiibnQBun3SNmuGU5K0Dm4G-LqxE0FlPaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y3hpJjDr7tvdDTeFx67VCHpki7WsNN_1aHif-j8lG1g&oe=69DA3A35"}, {"file_name": "499619127_699718026175758_7230833041550056953_n.png", "id": "745958517788853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821782_745958521122186_5715738513469103078_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vheBqFxiDQoQ7kNvwGazg8L&_nc_oc=AdoIqhpLxmjR_C4IyHUXY0m5bDcM1vEOgDlb-R22lXWhvCQ6QKe_5WhGlqsvnLW5lkg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pkk4lECRemMv8DGbuW3lzHTe7FEcPoag7cAN8DCN-fg&oe=69DA3EE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capuchin\u200eAlt", "keywords": [], "long_description": "CapuchinAlt\u200e is a fast-paced, immersive VR experience where you step into the agile body of a mischievous monkey in a sandbox-style environment. Swing, climb, and parkour your way through lush jungles, urban maps, obstacle courses, and chaotic minigames\u2014all with full physics-based movement. Whether you're flinging coconuts at friends or exploring hidden areas, CapuchinAlt encourages creativity, competition, and pure chaotic fun. With expressive social features, mod support, and ongoing updates, the game offers endless replayability. Join a vibrant online community, customize your monkey, and dive into the wild and wacky world of CapuchinAlt\u200e\u2014where no tree is too tall and no jump is too far. Perfect for players who love VR freedom, silly antics, and social mayhem. Are you ready to monkey around?", "short_description": "CapuchinAlt\u200e is a fun game where you are a CapuchinAlt and will have a blast!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/capuchinn/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noah", "support_website_url": null, "website_url": "https://sites.google.com/view/capuchinn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24280299238275579"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830441_1
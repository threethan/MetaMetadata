RtBm-8JxPg&oe=6A5B6D35"}, {"file_name": "499619127_699718026175758_7230833041550056953_n.png", "id": "745958517788853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821782_745958521122186_5715738513469103078_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCpb8nMTn9EQ7kNvwFuuBcD&_nc_oc=Adr__pQoUXHXU9i3w2GCdv6RmXI6jNAn7TqGWptdD1tyBo1C2f46mP2jdknRbO5ODH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpjgEOf8ElVX63Va7DqfYdRgZ4wMZOWltPngH6YCOr-w&oe=6A5B71E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capuchin\u200eAlt", "keywords": [], "long_description": "CapuchinAlt\u200e is a fast-paced, immersive VR experience where you step into the agile body of a mischievous monkey in a sandbox-style environment. Swing, climb, and parkour your way through lush jungles, urban maps, obstacle courses, and chaotic minigames\u2014all with full physics-based movement. Whether you're flinging coconuts at friends or exploring hidden areas, CapuchinAlt encourages creativity, competition, and pure chaotic fun. With expressive social features, mod support, and ongoing updates, the game offers endless replayability. Join a vibrant online community, customize your monkey, and dive into the wild and wacky world of CapuchinAlt\u200e\u2014where no tree is too tall and no jump is too far. Perfect for players who love VR freedom, silly antics, and social mayhem. Are you ready to monkey around?", "short_description": "CapuchinAlt\u200e is a fun game where you are a CapuchinAlt and will have a blast!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/capuchinn/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noah", "support_website_url": null, "website_url": "https://sites.google.com/view/capuchinn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "c
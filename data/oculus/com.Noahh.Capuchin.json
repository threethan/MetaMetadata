Q7kNvwG3JIXT&_nc_oc=AdmHs7sw08U9L1S8ICPFG45wPID_vIaffQv4uPgXTu5he7o_BymV0eg-NQY0-Cc97JI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHRHyx-YqCkMtM1rW0QvUbOk2hU6iap91rnFh8XtFcHg&oe=699D99E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capuchin\u200eAlt", "keywords": [], "long_description": "CapuchinAlt\u200e is a fast-paced, immersive VR experience where you step into the agile body of a mischievous monkey in a sandbox-style environment. Swing, climb, and parkour your way through lush jungles, urban maps, obstacle courses, and chaotic minigames\u2014all with full physics-based movement. Whether you're flinging coconuts at friends or exploring hidden areas, CapuchinAlt encourages creativity, competition, and pure chaotic fun. With expressive social features, mod support, and ongoing updates, the game offers endless replayability. Join a vibrant online community, customize your monkey, and dive into the wild and wacky world of CapuchinAlt\u200e\u2014where no tree is too tall and no jump is too far. Perfect for players who love VR freedom, silly antics, and social mayhem. Are you ready to monkey around?", "short_description": "CapuchinAlt\u200e is a fun game where you are a CapuchinAlt and will have a blast!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/capuchinn/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noah", "support_website_url": null, "website_url": "https://sites.google.com/view/capuchinn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
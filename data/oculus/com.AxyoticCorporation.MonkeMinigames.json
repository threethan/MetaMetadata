id": "2303679686822646", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_2303679690155979_669193042960672129_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KdqqxmwY7wQ7kNvwGskpCv&_nc_oc=AdpNYb8OXTX6tXI_81gsSYtD8lUr055hU5Xakho2jDNQ6kr3jsBnpeQWHV8hGxGG5Mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqDyZdwY0JnUmhsFAz-zvjKcVTcHGNEu2ky0imbxTAJQ&oe=6A4FA4A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u041d\u043e\u0432\u044b\u0439 \u043f\u0440\u043e\u0435\u043a\u0442 (9) (1).png", "id": "1322752930058493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828008_1322752933391826_7297452703349430952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7j1bqfhVZcQ7kNvwEOA-6S&_nc_oc=Adr5KHp6fSWT9FDt_v6YygpKSLf_mi4RRMGAf561LkxFn_fGjmPMNVEa_U_4ZHnMVUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUimcN8r8x_ozhiVDb8PF6xCPePNueDTgx93ftQiEpLw&oe=6A4FB647"}, "display_name": "Monke Minigames", "keywords": ["Monke", "Minigames", "Gorilla", "Banana", "Games"], "long_description": "Welcome to Monke Minigames, the ultimate arena where agility, speed, and strategy collide. Step into a world of diverse and unpredictable challenges designed to test your skills to the absolute limit. Whether you are navigating treacherous obstacle courses or battling for survival in high-stakes combat rounds, the goal remains the same: win at all costs.\n\nEvery victory earns you valuable in-game currency, allowing you to unlock unique items and showcase your status as the top monke. With a rotating cycle of different game modes, no two matches are ever the same. Push your reflexes to the edge, outplay the competition, and stack your riches in the most chaotic playground ever built. Experience the madness and prove you are the king of the jungle.", "short_description": "Master the chaos in Monke Minigames. Compete in a relentless series of fast-paced challenges, outsmart your rivals, and claim your rewards. Only the fastest primates survive the grind to earn exclusive currency and dominate the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monke-minigames/privicy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "AxyGT", "support_website_url": null, "website_url": "https://sites.google.com/view/monke-minigames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27360698066888578"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_955405380737443_2173086466029370114_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRRXRg379PsQ7kNvwHi5qaf&_nc_oc=AdqBCDdjwNIymb4-PZynCOqCXV3ikiIGbGWfQUJN98m2BLSttLEWyoHuFDrQqHc-m6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-SfdexuPhNXDSQwUB_elGJ4ftBSGmL21dynJ72WIa-A&oe=6A4FB597"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monke Minigames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 178
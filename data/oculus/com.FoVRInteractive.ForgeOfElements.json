31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfpiPPYdBToQ7kNvwGwVM_o&_nc_oc=Adm7lOQbW1lqoCYUOVCm_MCq6CUcMnpCXLUTELA9iJljXTAoI2HmdHakEIUm-aG8kYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuaLU52If1QCEpdY6iDvhMoRlO9FMIoXwqCTHyeeq-aLg&oe=69A836C0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3UcseHh6fYQ7kNvwEnVYvD&_nc_oc=Admm9XjgVOIkI1LPOrD-EuosfJoQzqpmyd876MPhTa1lhVFF7td7QDAe3keVP89E1_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsJINZBavp-V0ywyxwBc_Rb2OqmaGFP6rYjNLwp2YaKUg&oe=69A81F6B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsmfhbbVVGAQ7kNvwEjHUPa&_nc_oc=AdkzE2xrFZ5tz89PWG-ofyYZUF68AUG68ZtChdiVBnhovH22iCg2hvawLIcIuAG49So&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuDiHa75VbxJGM0KHEFIrkcAB-oX8eV6WIR74WQzyAFDQ&oe=69A8095A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guMqbFp88dgQ7kNvwF5DXfm&_nc_oc=AdlKh3YRRLpltD3E4efZNRuKVQ_R9ejiXSg9U9tYhemG6YnNkY3bGhucWUgxJNQHM7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsrj3QbdJlMwE7AWTlkC0m3EXaiR89tROU-d-29Iy6tvQ&oe=69A83176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZd8LDJ7L2MQ7kNvwGyKq9-&_nc_oc=AdkKHh3nZgVwZ_WLhGdM53nJn-CaHFaHFHUiixC2v9Ght2pMgCUqaFr-qG9fqfxTT6o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsDp-pge9gTQESzSeTBDrm-HfDs_u7MIDbozgQgZljKlg&oe=69A82CB7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
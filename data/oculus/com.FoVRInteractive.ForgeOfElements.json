cdn.com&oh=00_AftgQPsbzoY34qZ7Zi-tGWHm7g9KOJKR2DKKaWCBKj3ygA&oe=699DA7E9"}, {"file_name": "world view 1.png", "id": "1364445567950437", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499621345_1364445571283770_6472993857710405284_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcWxB3cVsmoQ7kNvwFRwSGx&_nc_oc=AdnWuDMeTmyiUBtuh0rvru2B6DPLsDrDROlJDN0PQaQtU64tgylqzwWLHX_RevFilIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrCErBIuEK63drK6g8uMXhw_l26OV-xPrgnZN4fZYlHA&oe=699DAEE3"}, {"file_name": "world view 2.png", "id": "1233056034860034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308324_1233056038193367_5957161634553778139_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEgIITwLZ50Q7kNvwE35qJI&_nc_oc=Adk4RFvQbFNjxGrk1iOt9GuwgL5FaYliTJHaALasGLpp7IzIsKTIo0lErNEYOB9tSow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNdv_Ybh8JnfGV5R3M7zki6RGlklIKMzwRh8Bvo7ZNdQ&oe=699D894E"}, {"file_name": "Alamanac Combinations.png", "id": "550753497912251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620516_550753501245584_7318506694734715515_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGse5eGxwzYQ7kNvwGYm-fy&_nc_oc=Adk6Wdraf02aNdnMdIja1YWJrcDiW7mc3djE6VUwVexrgVLP3AyxNIlYcK9x8vXp7HE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshNhrG2MZRRUA7XNVzAFfAWL2gHycw4Oq2LWyFrxXcbg&oe=699D8BF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "3306346616169973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310827_3306346622836639_5645990380599859009_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2-eo7s6YtYQ7kNvwHXEEwx&_nc_oc=AdkSZnYNDgS7M9tf7vJh2VbWCtV6Wv4hzGw649DMd9TRs-jrp2xOFlVrCLXeuEbCy9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlFGhQN3voM4dpPxXfXtOERyRz-hFrSBzJm7yeohDhGg&oe=699D9AA9"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "Combine elements to discover new creations and breathe life into enchanting worlds.\n\nAs you experiment with different combinations, watch your world transform from a blank canvas into vibrant, living landscape.\n\n**Combine and Create** \n\n{2576554876034717}\n\nMix elements to unlock new creations and bring the world in front of you to life.\n\n**Themed Realms** \n\n{1503568004012607}\n\nWith multiple themed realms, each with their own story, watch them flourish from a blank canvas into a bustling, living landscape.\n\n**Unlock & Discover** \n\n{972357928379025}\n\nExperiment freely with over 100 elements and combinations to discover.\n\n**Relaxing Puzzle Gameplay**\n\nPlay seated or standing with stress-free, intuitive puzzles designed for both hand tracking and controllers.", "short_description": "Combine elements to discover new creations and breathe life into enchanting worlds. Experiment as your empty realms grow into vibrant, living landscapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24590134354005720"},
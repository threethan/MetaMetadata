cdn.com&oh=00_AfsekStcnuCn9i9GPAtGjcKIf76jVb_pVGEWyG0hrY6yyg&oe=69A04AE9"}, {"file_name": "world view 1.png", "id": "1364445567950437", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499621345_1364445571283770_6472993857710405284_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey7PTEqYgCwQ7kNvwEpX48c&_nc_oc=AdmbzMh90yN0icYLASXEo9YHBaVSzLbC_KFOI3ySs0vc9FWMR7DmTdhZlwWNo2BWDlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvS_nLvEecgcwkf8wr5eLd0jpSgIbtKBUHk9g8XJcArg&oe=69A051E3"}, {"file_name": "world view 2.png", "id": "1233056034860034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308324_1233056038193367_5957161634553778139_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wD52n7T3g8UQ7kNvwGXTvqP&_nc_oc=AdnnADl3HDf_Q2QfIvNRohYG5b89FCw-KM7eECZXeg9yrL5xI8bpaIpt8d0vsLZg3Ys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQvnLbNxk8QwBNI36hr2d_OWQzz1ZWZ1OiLDe9uXUixg&oe=69A02C4E"}, {"file_name": "Alamanac Combinations.png", "id": "550753497912251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620516_550753501245584_7318506694734715515_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGse5eGxwzYQ7kNvwF2c0Sm&_nc_oc=AdmWfb_kEVoWjZIFowwc2AVU-w0_Ve1-AGzGlSJoV_rooKigzCJaa_cfbyrWDc-ns7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftoj2P1Xfqfc1I-H_YAFlkcVyyiTyaPzDP9cBXeT--YKA&oe=69A02EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "3306346616169973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310827_3306346622836639_5645990380599859009_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70KOyIXj3FoQ7kNvwGal2hF&_nc_oc=AdkAjWQrSCk7UuZh8Nx9V9zqQPc8_tUIPCRSEqIMywffwMrN9jdIb3g6FVD4-F1z-MU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCgcfYEmWfA-mqNu9oCl30l6422FDCYjuxcu0mzWKJjA&oe=69A03DA9"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "Combine elements to discover new creations and breathe life into enchanting worlds.\n\nAs you experiment with different combinations, watch your world transform from a blank canvas into vibrant, living landscape.\n\n**Combine and Create** \n\n{2576554876034717}\n\nMix elements to unlock new creations and bring the world in front of you to life.\n\n**Themed Realms** \n\n{1503568004012607}\n\nWith multiple themed realms, each with their own story, watch them flourish from a blank canvas into a bustling, living landscape.\n\n**Unlock & Discover** \n\n{972357928379025}\n\nExperiment freely with over 100 elements and combinations to discover.\n\n**Relaxing Puzzle Gameplay**\n\nPlay seated or standing with stress-free, intuitive puzzles designed for both hand tracking and controllers.", "short_description": "Combine elements to discover new creations and breathe life into enchanting worlds. Experiment as your empty realms grow into vibrant, living landscapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24590134354005720"},
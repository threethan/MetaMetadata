31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WplRnhwjhJsQ7kNvwG3GzPa&_nc_oc=Adm-h6llKpG5pJ5ZH4YCtSSufJbrAL8V4l8-DJybLsdX-iqq8xbgj2O_KUVkyn-4JGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfydNAL7OAjLXeKUXqXKXXW5CtBfnTniLzWywTkUYUgSyQ&oe=69AECE40"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxzkcLuRd6MQ7kNvwFPPmUU&_nc_oc=AdnAq3FLfGcIeFlfFccer_6xFRn_IC1zkWmzj5s1yjAHUw794QiQFrG6rdBZSD6YwUo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxc6URi6xOA19GQ1GJCeTiIzZz7VYgl8hPC4L_H9DKy9A&oe=69AEB6EB"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPdawCffFAMQ7kNvwHQO8yf&_nc_oc=Admms6m0xERIn6xOSR7q5WjuLC2WXbkEdDBxr-FrhVPcgEfGH5Uu6r4gtL8RD4XYtQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDMtxlQdigBUhACMC0_d8QJcu80KabnK0aNf3_UPt9cg&oe=69AED91A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59EibkbXIPMQ7kNvwESZfIe&_nc_oc=Adny65_X7yk4kXCEpVFDzditJSCf0-dTZGINvIhDUL9WpGdHIr73MIzlP1qZRIcXTuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtuC2LK8VYZaIXbRBAoXqwXjG2zP29QLLjgrJnoDyM9A&oe=69AEC8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE-LjnPSvQ8Q7kNvwHVIzz4&_nc_oc=Adm4x30tCrDID5tQuhuqKkBeGje-GevEK1j7nNjq1q90fH0PvzGYWfTLoGqJ6on9-qY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpvBMYqkb0pgra_4aO6KqMHzQ_upCe8PFPZ6B1Kskicw&oe=69AEC437"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiIH1YlHv4AQ7kNvwGO15E8&_nc_oc=AdnqCB8rWtRY4fMuu9dzyOo_j2alkLad96Ku2yADu9xKJfbtA_CNe0-S3gRhcfQJnuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhXCigwL0hP7RNx34dTZLgTDUdJv5uRetqwIC5iCGkYg&oe=69BFF1C0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=026yOfdE-UEQ7kNvwHfGl-E&_nc_oc=AdkNDpbtHN4p6U9AXo8SKV2YkuNMbH7WEbMj500MLw0C5xWnMxOZpiLcwbroW4T5sb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfwzoJw4OhDq29wykBcplteGU8Tr6pNnb0wnUsPcRfKw&oe=69BFDA6B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYrKgCpiEowQ7kNvwGuNDsl&_nc_oc=AdnaTA_cm8oDpgULX8NPy_j_Zg0uaTTE4Lfn5EXY5WDfXsAfqEWwoQJmyld4GHfnbeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuexN6aFpyUtMgebM7O75JU1V519xCafqwXSz4DUoY6Q&oe=69BFFC9A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CppRfTGt3OIQ7kNvwFaypwL&_nc_oc=Adk4d4m2d61133GeRdECxDU310yy2nzKjUcxYgpqQkIqwZ1T4FWQMnwT_6FuVCYcSsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1Lj1QRQMiApUsien6ehv63y18S5KCYehcOimlDQZx3g&oe=69BFEC76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSXFuinKUC4Q7kNvwEQjf_A&_nc_oc=Adk-o8K_vdTIRy3vkChTkP0EnVvni7b74a8pemUSaOAqfrEuRZSkY-o-SbNQkEDxf_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaabADIWqD-Od_nw1LbrSF4Hk0HUtitXD6t2J8aTN6XQ&oe=69BFE7B7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
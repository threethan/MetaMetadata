MfJjw&oe=69A19F40"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiJ0a0AqDuMQ7kNvwEt46wi&_nc_oc=Adnc_IXm1eqxq7kyvxNWnhFFIlfE1qe1fAvNc24NL6yi3L7lSR21e9x8yYfzwbt3OLY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuvcyOoZy7jy11d_13ukteHWnQ7X45oZgiSQIFc8JYVDQ&oe=69A187EB"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEbzgBdoR_kQ7kNvwGUlUd3&_nc_oc=AdmEU81dmrcvrV7dsE5SlW-vrYz9eluZwQmQBVE2ut_SidSxiVkdgB1tgHRKjxoBqvc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftVhqhh2n_XuLxjH_2t6nNwiD37f04HnOko6k_K6-IgBg&oe=69A1AA1A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHfWopKfHuYQ7kNvwEqBbRp&_nc_oc=AdkpqiIHeAMlke_FsMVoNonUG24Q9irRvQumUdpOc0JCOuBzrJygtiuihM462IlS1xA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuXQL15hp8z5OklRE_Db3fCNo_J0j2vvToBJcAFmB-LMg&oe=69A199F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jf3Cll_pllsQ7kNvwFQpTQY&_nc_oc=AdlXP_GGnlQ0wruU5bPaIgERM4quaQnchXyJ3FX6Ous87HocfYoyx8k_QHRsbLJLQCA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsH8b0rLfEjm9KW0_MbSsTnFoiqLRPkPPNLglwnRrtw2Q&oe=69A19537"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_
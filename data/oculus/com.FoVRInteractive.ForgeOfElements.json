31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiIH1YlHv4AQ7kNvwGSFnCd&_nc_oc=Adl4iGp4GPcizogl_R65bOEAhtmLBu1hTZboyyYEu-dFFmZfEcwRJziDSlBD6lgzafw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1qlcaUmIuLmCWgfLvpBnHEyZtjQ20n7pStR27recdqA&oe=69BEA040"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=026yOfdE-UEQ7kNvwE88-JE&_nc_oc=AdnY6YwF4uBFEn-mcxjg53UROtzVy1QvqpF5WIhjBrfAQBQ45CYxiLv-y49-WeqfMno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfztCeWgD8eLrbafB5G_4inkbjf2Dm-ejCJVRRRiNMzCdg&oe=69BE88EB"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYrKgCpiEowQ7kNvwHfL1Dp&_nc_oc=AdlFmbpDMwgk23YlMFhi1IaduedgPfq2lWdINErN83dWyexMYAgNp3I4w16idMyz8iA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGIpsLPbSBSIkNmN9w4AK8WC7AVM1M90Sd4c0ePMNvhA&oe=69BEAB1A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jOxHSs0OQ8Q7kNvwFqoCKC&_nc_oc=Adkv1enOleUg6kQG_zeqpaCW_kvad8DucQKcKz-KqjKxop6u9enSTKJ9QGgAG_lIfbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyB_EtPA9p8U1TjXuapOhko2KEQkvYODGRotAGSb43_Hw&oe=69BE9AF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA2PrW0HVxIQ7kNvwEclOc1&_nc_oc=AdmYFsIn6h6cV5JrK7xA0Pcf4M6u_YvwttLt-6g2-4uhtjtpzaquGHbj1-muYsQHqIU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe8xpB2R4FhqREE0qzH9-4tAa7G1QgC-J0J1-1n5bezw&oe=69BE9637"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
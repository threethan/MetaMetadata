31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN1ltNuPOEIQ7kNvwEFfzLd&_nc_oc=AdmWQQT_rMau6TitGRIT8X3CDIxo7mAdV6FeJ41MApzC2G91R4v8uMMFBqnjsQDVbHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuWilG4vGXrufV6Ygx0XrlnsatrbBv5V2In3Nem8AMNqQ&oe=69A98840"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3UcseHh6fYQ7kNvwF8zIHq&_nc_oc=Adnyi0qfD3zSJGgj8qskrtsukBmb-5DKXrawjCwqymaIetM9NTfYI6c_kXo-DVezAjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftUgzwecnq7NQWpkXjyaWlHpHCdfNhtTX1hGcHa8baVuA&oe=69A970EB"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsmfhbbVVGAQ7kNvwHxF3rU&_nc_oc=AdmJtB8qsWrfzSJdaX0BSoW24KutgikptFrJQUJaAVuWWPFY7mrxx7zSkYXfLUJ0zcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftYz337wCA9SaFhFWRbwawf74_WH2K_26TGAqB0kogzag&oe=69A9931A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guMqbFp88dgQ7kNvwHdKnUK&_nc_oc=Adncfub1S6aRQJdYmenK8hQz1v_7-2Vn6N73rJVdCLpFO4m7vkusm0IAmWCmJoUY1v4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_k0BI051Wy6aO0myOOrubcNO4FMriFBPGSCbzfjj0uA&oe=69A982F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZd8LDJ7L2MQ7kNvwFRgXRN&_nc_oc=AdmIpFh3VSDvQhgeSj67h66z7hJujapsiwH-ZvxSXVjrLXbnk5uMymzF2AGgzYq0_zA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuIr85Q4NyXvl7Sl7Uw4qVHGxJ8ZB7MRVHkRqjE_eTrYw&oe=69A97E37"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
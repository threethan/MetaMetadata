31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGWYmp64-q4Q7kNvwEZiREm&_nc_oc=Adr3F-K0KmOPh9DGNnui6X_1vYA6-m1dbq5q6iY9zMytE_KvmtPB6BgBQpzJKU_5qg0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfckxNb9O_hZ1QSPlb67ZFWXu7RGyY1pVu5_hRMnBKRg&oe=69C14340"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=026yOfdE-UEQ7kNvwHCefUk&_nc_oc=Adri__BpO7QSKvFiOazd7MReyc0o0KvUBrKev8xgq3e0U9S8wn6iDoJDEcnU32TTXBM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyP2yxoUOe7HJ-7E1Zig4D6N3nNbRiKZ4hvU-FEx-9z0Q&oe=69C12BEB"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYrKgCpiEowQ7kNvwHjlejQ&_nc_oc=AdoEDt436-EIacJgMpBuJlWnfiAn8EcKyQo2SuAz0is5rayVZXknjeJrLoLbXhyI6mY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyF2ZELZaVBu2OWOXdnb27U3k-AsNlGV3EYIBc95s9BMA&oe=69C14E1A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CppRfTGt3OIQ7kNvwErlQU4&_nc_oc=AdqVJcQDM50qxnxOJhTYZPjVde9OR_GVA8Fs8yUiyhoEHsF7oyeOeP1OdM6LGuFz4kM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyErs1B9zuDEK_7zr7tiHjPuwxYOFs_PAkDcgn1XL9W-A&oe=69C13DF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSXFuinKUC4Q7kNvwHcTs39&_nc_oc=AdpKp3uJjtgVKtyn9MXa5qKy5ITo24Tse8lezHXTW8p2Q3VCM8U8OnzLuyWx24sIrEg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4drwcF_gfiJmAJfepcn_xAez9PIWV7QLqD3RKGv9vaw&oe=69C13937"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
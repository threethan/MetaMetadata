cdn.com&oh=00_AfsA9eaflpW0Cq89H_DoU8RQ9GXrpd_r_Yl8JYQ9N0hIDw&oe=699B04E9"}, {"file_name": "world view 1.png", "id": "1364445567950437", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499621345_1364445571283770_6472993857710405284_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhXCXOvIVY8Q7kNvwEwQmD8&_nc_oc=AdkXsW4xhmn5WbOCEM1UU07qkdkil7Ko449PNq9pyC3LfsOIRGopTEmzSZbUy4GPT5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTCv1Hgy7yAfU0o1OZ9lWTKa_n61nCFmQzSv04vR_hpw&oe=699B0BE3"}, {"file_name": "world view 2.png", "id": "1233056034860034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308324_1233056038193367_5957161634553778139_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz9ner_2WvEQ7kNvwG0VOb4&_nc_oc=Admc_uMIPTGwHlDCJKUKTWyVkDzJrFtifIvtvayshAexFvJEvuKvLq0holmld-xZkeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft3RXMTdkCLs12XfKnLZy7YdlwuuEKuTlH0Pkv6HW0f-g&oe=699AE64E"}, {"file_name": "Alamanac Combinations.png", "id": "550753497912251", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620516_550753501245584_7318506694734715515_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDYarQliPe4Q7kNvwHO24xF&_nc_oc=AdnF3mxYIzWBlU_S3-Oar8nogXyu8EOJn2Q_TxPty_zj0C4BLsIbJ3p4n4M35mRxHZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsORehNO-QZczvR4Eu34vuvvTAzXVWMx1_Aj-gfmXNE_w&oe=699AE8F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "3306346616169973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310827_3306346622836639_5645990380599859009_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2-eo7s6YtYQ7kNvwHWY1V1&_nc_oc=AdnfihyXuguxIFFhdEW2uVWuV9LN0ya6K8jviyOzWtw4QGWYFaIgbS_ZcJCH4MmNJ-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvzHvrfUw6BL_0K2sldX9BZ-FTXPY6qI0mnN5MsQB-T4w&oe=699AF7A9"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "Combine elements to discover new creations and breathe life into enchanting worlds.\n\nAs you experiment with different combinations, watch your world transform from a blank canvas into vibrant, living landscape.\n\n**Combine and Create** \n\n{2576554876034717}\n\nMix elements to unlock new creations and bring the world in front of you to life.\n\n**Themed Realms** \n\n{1503568004012607}\n\nWith multiple themed realms, each with their own story, watch them flourish from a blank canvas into a bustling, living landscape.\n\n**Unlock & Discover** \n\n{972357928379025}\n\nExperiment freely with over 100 elements and combinations to discover.\n\n**Relaxing Puzzle Gameplay**\n\nPlay seated or standing with stress-free, intuitive puzzles designed for both hand tracking and controllers.", "short_description": "Combine elements to discover new creations and breathe life into enchanting worlds. Experiment as your empty realms grow into vibrant, living landscapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24590134354005720"},
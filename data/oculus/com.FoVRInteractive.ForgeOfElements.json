31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67k9CgBH6OkQ7kNvwEmVJuW&_nc_oc=AdlEa9lAnuYip6BDSpsuLkwdm9zCGikv9ViNjt2g8UvoQe4baxn00LmtpAvCBSFCepk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiREurarPu3WpkANAqq1C5YaCrGhR-qpVz_FQ8NUlHaA&oe=69B808C0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WYoMs2X5KsQ7kNvwHWIIy1&_nc_oc=AdlhMtELdeAb9lSawTEajFZBixoHf6F7kx5f4T1CDQQQAcq4dPBRyGjDOnt6m_4rnIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxsar8x_ZET3M0MB2vPTmDGJjqTlGa_V1bXvz_hbUyLAA&oe=69B7F16B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzW4C76OtLUQ7kNvwFIMJ4D&_nc_oc=AdkFyCE7j44UsL35h5FNBsHxNI_IJvUoBvHp2a0mCughOQwoKbX9GyDRYUSZ-LH-eX0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afww3ZyEcZD8jV5DmF92vGi8tFpW8-LWUcmES9aqw8YsPA&oe=69B8139A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kddm_2ZAVcMQ7kNvwFn7A3x&_nc_oc=AdmB0TsF1ecdGu90e2Iy-8nUCMTOvlySbjsGMiwglbRT-MeYmH4nxBhh3LENTTLBu2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9MVqjy_89vy-8leqZzJqKsPWoMsd-H1DzwRwnALJV4g&oe=69B80376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hJ2WAprhxwQ7kNvwEC3slG&_nc_oc=AdlFZStDn2GzJRy40fQycN03Elog9o-KbDR2643oWwd0_ojGSMKv10A5A5pUOwsSu7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6BrNGyg6OvT4xl0t4BNDYGmbTRlxVXPL_BSBAkVhSVQ&oe=69B7FEB7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
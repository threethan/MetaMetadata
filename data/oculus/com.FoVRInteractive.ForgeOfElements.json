31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNnPLhPceNkQ7kNvwEKT-ks&_nc_oc=AdlCKpSFMpEvSPohbkGuF6qbcwTHZu8bCGVVKl0K53F7vMPePp9Cma0Dt_n1-s94z60&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzrO2txFnLcIFdm_Rd4oqEesLoxS7zqkFoFwjXYjbyRKg&oe=69BAABC0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZpwOwG57ucQ7kNvwGApnDq&_nc_oc=AdlSLCOSXWEXyQJVGQcgDlGGe6L3Owugs5lPi-Hfadpkiv2DYx5INTV83hzFkS_QZYI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxEINwY8HTaqcUXqRYxX9TXwM6mZ4i12nI8Wz2nM5o4A&oe=69BA946B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mm5Yn9iwQk4Q7kNvwFsSEio&_nc_oc=Adnp84VT9sCRNGYYRqN8yrUzFldFVLAPPmZvJAaGI-owAWgXGNM2bNBDpoNttpgANck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmxJfPqmjF1SGmWMdXnkuqi8BLN46rk2SUAqeyQljekw&oe=69BAB69A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kddm_2ZAVcMQ7kNvwFO6SvW&_nc_oc=AdnuwrLGQaffud3A0mPEtbttfSahzXgbGmua43a_4Vp3lRiGCZNMVE5lcrAZMSjTirw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYl_-Qoz7LvE0-onV-SCYXcdDzKmUeTQ_oGB1pDesbrg&oe=69BAA676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hJ2WAprhxwQ7kNvwE3VpGu&_nc_oc=AdmEZsmMuJQO_uCSMs0qbk900C7C4sZLjlR5Uai_LeaP2TOBdA6nXQi5O-aB3nG305w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-8i8bVDJf7dW38BgzLCytXyLHFvPUqfLsOYcobXjz0g&oe=69BAA1B7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
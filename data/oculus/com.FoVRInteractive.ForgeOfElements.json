le_name": "element spawn.png", "id": "1684492395829975", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473397331_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55sC_AP_yA4Q7kNvwGK2ZPk&_nc_oc=AdrmmVhTOVY3glcpUGO9jr3Vvt_EbPd9FziNzw8ix1181hOR4E1R45x1mre8Ss7X1Rk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8p2vPGm60C2vB3iZtDRVCewaNHuNe2WnpSzDBqkfPkA&oe=69CD20C0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uTJOMCzKIsQ7kNvwHIDA1m&_nc_oc=AdognyJI8qjb2CD9pi9W4FhDLqbmrg9KtjhT-0q43imo_9zBEgbYWVNG8TSQTh4Locw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi6LoGAV2Cnnd3KsbWzzueiX5Mkx4zwGwlDgPH4CwKbg&oe=69CD096B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FlEMWvAxDYQ7kNvwFiV9TL&_nc_oc=AdpA-LzD2cORIFgU0AX2X5moNLMRmi8UiyXZB9ACt6zxahAId7ZFwZgOmB6LPKjGz5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyso7KK-BXUHolEBElwh-ciMBV1fJ9KJ4XzVo5dEXyO_g&oe=69CD2B9A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27mxpBlVg-cQ7kNvwHgBjXj&_nc_oc=Adog2tqem7E2GfVCNCQYXcQGPvuE16_bh46o5sHkpe6qppYWwjwJ0qgj2Ba2C3wzOVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvODnCiozzbcMWuigkqWCMTa_rhD1IMl684UAmfHrygw&oe=69CD1B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hg7hz3CaZAQ7kNvwFaEajm&_nc_oc=AdqXEsH1hc-Kes_yF-0d-PLhc9u6_uiwxgu9eMNEc7RV5208c6_6QW1eFMtN1RLg5vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNnNHMXsS7-wXVYYBNBTZsRrEhqh5qKOTw70hqy6wiAw&oe=69CD16B7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9333084390137298"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "822377666914210"}, {"status": "PUBLISHED", "id": "1099314775515631"}, {"status": "PUBLISHED", "id": "1223848369046896"}, {"status": "CANCELLED", "id": "1018734907098376"}, {"status": "PUBLISHED", "id": "1642011893854425"}, {"status": "CANCELLED", "id": "624503600408551"}, {"status": "PUBLISHED", "id": "647582707991995"}, {"status": "PUBLISHED", "id": "962604179149882"}]}, "baseline_offer": {"id": "1099314775515631"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "822377666914210"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24245912081761284", "version": "1.0.8"}, "id": "1724705701668919", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7956388831140201", "is_concept": false, "latest_relea
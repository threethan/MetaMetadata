31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67k9CgBH6OkQ7kNvwEaXb1z&_nc_oc=AdllrilP3_HCNN_CN9ziWIwunUQizQyJs78L-ekXTEEQCvbdP7I-lBvhfWjxvfbMxso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpW0eCKVi3ZGuUHZ1Yjz6rx4oD7ko3kjsYa_8-eFmkHw&oe=69B6B740"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WYoMs2X5KsQ7kNvwF8ydEp&_nc_oc=AdnlPvDaY6SxRMKvWRQ7I9J-Zi-BJFswXx-QcE9otRwxzQEfls--ymlIArZ6s6f_3HQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_1fI3Pyjxq5y2-krkzK93HnF1DM9QlAfMXaxhNCQCSQ&oe=69B69FEB"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzW4C76OtLUQ7kNvwFYcVwd&_nc_oc=AdmAP-HZDhXKW7CqCejOdPulwoq7ThNmnLBTaffi2FncN99XdnbocK-F81PadO19IGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqJmM4LvanP4eCwG3ZkYmvBpLKWXPQBIDPy1s5g4mBvA&oe=69B6C21A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdGQ3YcztygQ7kNvwHTWEib&_nc_oc=AdkuB6ZZXSy6XtWAUuIaYU9a7YRZqe7z5w3pmbaS5J_VOO6nISlvCpUWzgbpZ6ZyTBA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl7nx14R-RuEaGgl2X2BSPF02B5ui3WE9HS6ZrGZLK1A&oe=69B6B1F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Yop47bjqZ4Q7kNvwGAEjSQ&_nc_oc=AdnMENNyY0oAM7SEu5dA8vRZ1vyQleef05jQMJqbt77cv2RvBrXqV2pnUK8eok9c_Og&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyY-LHlY6DyzDX1T-cY1suO26U-u98qvB3n6Wd-yDyqNA&oe=69B6AD37"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
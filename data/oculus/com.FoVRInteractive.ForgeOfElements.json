31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiIH1YlHv4AQ7kNvwHAlFBk&_nc_oc=AdnJEFyTAsuJKc_-wVMopOQXUmbTlcGcZq18_r_ckxKmsG-t5e3A_av0asIFZmp9i9s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw08Fo9GNtclc12-BtEOMM84Hlhm04vyLvLI6WvYAJIVQ&oe=69BD4EC0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZpwOwG57ucQ7kNvwFDfv1F&_nc_oc=AdmFUEU3IFJb86n9cz4PwM1Ye3Ls4setVUP1_ZDY1IloLZ7segUzSZ2_Y7-H_NyQ_pk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK2XLcyHtRV4k7S1jAd00GR-jNJO3R3lav1VE9paGc9g&oe=69BD376B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mm5Yn9iwQk4Q7kNvwGRCb2_&_nc_oc=Adk-8WXwyuxVKWgBTYyFbHHrIL-i-71NT39LR5o2IwD54e0uWnPbbmxQwNEBUc0I11I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7ZEnhaRcy07sQGGgWGQLgp_vopD2tAhynYXsJNJwGdw&oe=69BD599A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jOxHSs0OQ8Q7kNvwFqXxKt&_nc_oc=Adlq3ohGq1rSkHgLqV0mqk68IdjjRhYoq_avaaU-fY3UZ7UVmV4bsBF23td8ydkvW0M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx84lfu32sPA3OKunWGBPfSP3U8sFmRRsc90s8leiHBXA&oe=69BD4976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA2PrW0HVxIQ7kNvwE5TEHP&_nc_oc=Adl9R8wH6ALkHxIOlRxIfvWsrKv88MQ5cZ3_WxDnzjnaxPDCk9kXQjh0wLRXITuUniM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfZI3LoVSFGrknEhdvJr9w6LpoNcVKfmAGj4u4UhlfnA&oe=69BD44B7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
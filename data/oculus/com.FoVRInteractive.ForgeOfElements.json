31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVB2Qs78bnAQ7kNvwF2eq9q&_nc_oc=Adm9DXWyecvG7J7HyuyY7EHmXr_TPWK1CP89jeClgOgouIqChARNtB-UNOZNu4BzdXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywSM5-EP4IW7GAsibp7bpjX96BxzOGGGdbsottCKDszg&oe=69B2C2C0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLbhb8dB7CwQ7kNvwE3BDRp&_nc_oc=AdlGjY-XaV6pA6wUv6SPKHgpk3UK5wL1LC2z8RPYYkiGOnU2NXsqEggNiNUkpMOVY8E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUC2nr5lbzeKKPB7v6BoxGkQGIIUL9IlP3l1xvtqENmA&oe=69B2AB6B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Av1Qo_m18Q7kNvwHvnrcg&_nc_oc=Adkz5rYiT1Jif5tN7FFhgXN7BDWfF1mICf4wF-lD1OYH4IFv5mT5kbXZbQp6zf5yt38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOfgZpF1R67Z7XpXWrRjFZnsE_qqit3e1YMdWBx2XiOg&oe=69B2CD9A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbyu8-Keu7IQ7kNvwHsKMFw&_nc_oc=Adml5KZPP8RgrQGHSp4wEcG2F9AOQU5xS81RPiigWg_9arOZkF9KifSqip_DjdnI3Ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxXGcMLjlj17NwLTxap62xXauvb86f6kQ8yKW_lI7paw&oe=69B2BD76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cwYnkRNoFQQ7kNvwF5Ec1j&_nc_oc=AdmU-rshJDi7n9ZkhYVRZUBTzHgEqwLUHk6AMPT7yIDCASb0BnTFyaALWt1hRQemr0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzzjkh6XYHx48YX2Kdi3s50t3JctRq01dAkN8AYsjMxtw&oe=69B2B8B7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
jG0Fw&oe=699B07C0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUBH1bvowMcQ7kNvwHUklNg&_nc_oc=Admv_sAbIDFJOtmNwRHqdCZ6ykWisSaVNwVPXQbsdH4G42i0cMKbCr2W4A2RQn4yclU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuOMy1qtwkfeIwVHMKX26fI1ei2Nf5bWvE6JE_vxVeIXA&oe=699AF06B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ynPpQ6QJWsQ7kNvwGLxvZ2&_nc_oc=Adm2VpL2mXQ2ggRAO3uppRndeL1dcjFeTjzPwnnA6D19-L6T_tkrtx7O7WqAgjElaow&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuspvMaYEsu3RibAUK1iL9VLbdHZf1DsS98xlcXzAzB0g&oe=699B129A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGCRwsKmleoQ7kNvwHXOr2q&_nc_oc=Admbr266wyb-szyEsCTr0nT2DjnRsdCPAvcSq1AnK0mqRv2689kgdUxjbxpoJLZb0kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftC7OPcEzvSvqGfmL2Khczr4KDK-g9xOtI7WEIJx8Qbtw&oe=699B0276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srK-uxqPU-QQ7kNvwFlJ7gF&_nc_oc=AdlXVNWnVrVJ-LihTV_BxG2w_CrcTCgMX7henNXLQAXIj4-5ICl5LohF6WvvzxMYMeQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvi7fhKrlJM6vktHH9oqQH45bZf-PicAVmA-AYUNP4xsg&oe=699AFDB7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_
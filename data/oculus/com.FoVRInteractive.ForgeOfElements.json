com/v/t64.5771-25/473397331_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN1ltNuPOEIQ7kNvwF9msYC&_nc_oc=AdngzzsfGbdFET2eis357aeIcy8eEshEojI7Jmz4toyZYGNkVQzqknKeX3iSSbomVwc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrS3TwDCJbSViR3ZdugFXZlK3p5cIrag1zrIO3TjYNWg&oe=69AAD9C0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inFdA3p4IGAQ7kNvwGNfFCT&_nc_oc=Adn-LltS6riwuoRDww0rutkwcOQCZDa85dbVvglRX4NttLxdOZ-OyHw3DjhOEP2QIxQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVmPHe2b05zFl6pOBrgyRZGohVcNlSJwb_c8PCDgHzbQ&oe=69AAC26B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WNxRkttiPwQ7kNvwH1e-r_&_nc_oc=Adm33e9ZPI3H-GEK82j57cRDf5Ya8NvADgH9-Ez6kTwK_2-L3B2URyuo8sC1a5xSo70&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxFq7F7u1FNIHqwERs3fFpLZfXRVm_njmUjy154chZBuw&oe=69AAE49A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guMqbFp88dgQ7kNvwGFJ9Nw&_nc_oc=Adm7tjqN-ioQkc0ZeTKWQKqvCbbNFD9xtNZLFEpN0FOBWIUMxoGVXyg4En4dcKWBDqY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyfFVkR5iX7vAemxa2PKeMWWxGIPDZOpzpyb7uwyGJFg&oe=69AAD476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZd8LDJ7L2MQ7kNvwG4cnFo&_nc_oc=AdlyUprIIYAsyocSedBw4UzWcN8EZ_Nv8T4id69l5u3KgaeJ4iIFK1oGGqjs7coCuZ4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfztcRd22GQDioLlU109OnXhLjiUXVO60dYEO2ZEuH5X3w&oe=69AACFB7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactiv
31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WplRnhwjhJsQ7kNvwF-fV1A&_nc_oc=AdnekZtGiBCjHtds9tMhHBtJy0L7tiNZHUsx3lvSFpbNoPuABJj_WmHDZGYw7FFXZGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLrZFRW2kRqHBxNk5OoRk4Hie4r57vqwXbgU-9XBnnjw&oe=69B01FC0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxzkcLuRd6MQ7kNvwHWbb2D&_nc_oc=AdlupcPydAAfx2coy4mplCdR2jWNV0x8Quy4qLkyYMCNQoRUov36iw3ZqiqdW8s7MQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9F5ewMM21KCBJqH3ei0cD2WHOTNBSPfmP_Qh_XLrT4g&oe=69B0086B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPdawCffFAMQ7kNvwFvy_S8&_nc_oc=AdktGzzPehITCrYEhFtqDhAxRRk2NAcc5keF2uZ1IGeaJ2Q5E2vhOysvTZbnAe2yn2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvBlfLtDctcsiZ7nOP3cuWhx4lIhyDVdKCprbnkdA0Sg&oe=69B02A9A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbyu8-Keu7IQ7kNvwFYUAlR&_nc_oc=AdmTi5uGuQWGUzr19uT_vGOiBOw32faMV9YN_pl9UslUOo7Kmxhz0EvrOrOs61tqdyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNUMx-Xy5T-ie64wUFtjFvaQuMed9XnpxFd3-sl9wqYQ&oe=69B01A76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cwYnkRNoFQQ7kNvwGdHwFp&_nc_oc=AdlA0WzAtmqO6Nq8loLztigZkh6ux5W7rZoBBtFvSfTbzVkOn6RArmWwAtBW9bvVbC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDNtwYpvnI89tAaHBYVHjChCRYhLPMbPt8Of4sHnusSw&oe=69B015B7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVB2Qs78bnAQ7kNvwEW3F87&_nc_oc=AdmpFhr0DTKrT34jOvRlIlLbwbpJzHaJMANiqe2VgzL8SnK3DPQJ7n-tTZA5aNiRP1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyM-CglNLzCesduS3G3ffBPCKUKXd5t7rFhccAvDKG-FA&oe=69B41440"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLbhb8dB7CwQ7kNvwFHsGx3&_nc_oc=Adll-Ygd_xSBiwoP5BguxFb0HVvpCFJxCjGVf-aGNmveHcyFSKb2YbDug3NDUfU6vQY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afygf9ZjquaEBjR4I5zG-mqUlTnWRhKAbDqDvn_Zitb1kg&oe=69B3FCEB"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Av1Qo_m18Q7kNvwHKwEtn&_nc_oc=AdkR1EAMhE8uCbzeW-gpHiPK7z9aF1OsOkuWOhiT-C79g_kh7fx0UIB1oetfVt-1Pms&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxW369uBCoVa84jfMScxAzJOcYGEI2VvGSaZ9TzJRPizQ&oe=69B41F1A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdGQ3YcztygQ7kNvwF8HAGO&_nc_oc=AdkhuLB0LEb26oXmyXE1tgTC17lkFVicfLf5q6wdXLJsmmcdBKU0c4p3-VB7tI5LJaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkIaNAOGIgTeMDNlPWams_CHH5k5CKWt6fXsSd-tPETA&oe=69B40EF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Yop47bjqZ4Q7kNvwFvIMae&_nc_oc=AdlNGrZ33ivr6jcfq6Lw6OU_1GXSRqWGQ0kjwYRT2gpXWjROFMgijbNilerbxpmDc8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyer-frhhLqyFEQL5Uqc44Rzasgnygi4gbiZXTURSY19Q&oe=69B40A37"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
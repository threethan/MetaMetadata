31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVB2Qs78bnAQ7kNvwGduyVH&_nc_oc=AdmW0AVZtI_W-0ISsKrnB4x14tZV9umNiksDVvLq2G2N-0Bp0RCo1rW_SOdErzDak4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNlL1vKfcmtMIwAiclrPPyfJres7Frf6pJSS_mY9bKCA&oe=69B17140"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxzkcLuRd6MQ7kNvwH487xt&_nc_oc=Adkjx51VvwUa__dCl56h4qQo5jmikxBpPOdtVlS2BPtq7Y9oCYMpslV5t-b93y1TYEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVb552RsNoMti_Z3V6Q2QfNEA9haAg4yQIs3-ZFWE_Iw&oe=69B159EB"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPdawCffFAMQ7kNvwGc8NOx&_nc_oc=AdmzhuUKtgP9AWunNOmLXN4NPX0-mL6BC6nO3kzA9B_LRVvF9nfbATpCnEbqMu7dzDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfygD5EAe-o6aPv6G0j53eH8LhpwqFOumWWeF3PxDz0H5Q&oe=69B143DA"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbyu8-Keu7IQ7kNvwHAc26w&_nc_oc=Adn9Z54Y4-VSt-LAwF3km_rmY5OEnOJ5qB-H3UapEhs_Dzck7jOHQY4iYrg56qCUQu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaUuNBW6G08443AZxds6GgJlysW_K-15rs-FGvh93fqA&oe=69B16BF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cwYnkRNoFQQ7kNvwFo703s&_nc_oc=AdlsjZj-BFXaRq41tF-sacx5E2dk6IPOwzqwIztDerH63rTfl8ctnPrnNJovm2g8AD8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDVDUPbEV7dSdv5h-fZrVEf5NXANve6BedmceFKsufVg&oe=69B16737"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
31_1684492399163308_91059627126569173_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WplRnhwjhJsQ7kNvwF94pV5&_nc_oc=Adn4Q5XTUDZLVaGb31RPYFj6Yt9Zo5ecEvG3NoH5_ezvY67E2Q0KxED6aQ6PWYZPrME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGZg5hy1Olk8oqmCSKCiJ1Ve7bM675MJZdRjfMitXEMg&oe=69AD7CC0"}, {"file_name": "empty world.png", "id": "2104324946696143", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392062_2104324950029476_723673365065223541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inFdA3p4IGAQ7kNvwG9e0jp&_nc_oc=AdlN1WF_ICho8Wtn95wh7kbpar7U8nM3v6xz2S-gV1i3N3df4Uhj9b2BUsTN_z7nnBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGbnrh_p4lq8hB2BongzY5GktiKtcdYuW029ii0Ul74w&oe=69AD656B"}, {"file_name": "world island.png", "id": "1072182871602238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392062_1072182874935571_6211521127061682190_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WNxRkttiPwQ7kNvwGhfj6J&_nc_oc=AdmeUnvorqUEAxag_qgX11N0PExj-d3OBdpWYstVkZORNyMfQVxtlb-VjmF3pVURUjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz55OPDlqJayUn8db9e7qX_yPZet4fGM9uf8SQsJc3f_w&oe=69AD879A"}, {"file_name": "combinations.png", "id": "512016225258564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394021_512016228591897_3705242004039050722_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59EibkbXIPMQ7kNvwEOBapx&_nc_oc=AdlL9SThsfy08j9rbpWSwqnBeUukBGEgm7_tNxauGp3LJ19JmJzqoKkruIcZ15_rvfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUsjU4NLgp2DkGcHgytDbUOUbq_LFw6Bxa5LxUOw1aRA&oe=69AD7776"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1314091656603025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394159_1314091659936358_540670610373119619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE-LjnPSvQ8Q7kNvwFWu5Zj&_nc_oc=Adm1HSq4tBvEM_Gk0wgY7NOyF61se7RdUVsyXLKMS2FpGygm5IKIadRkeSmw12onqKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMGDWqKIJQ7n4L2YFYVlgFHCb_VuQXcGTFd4xH1JtKbw&oe=69AD72B7"}, "display_name": "Forge of Elements", "keywords": ["Cozy", "Relaxing", "Puzzle", "Crafting", "Creative"], "long_description": "# Welcome to *Forge of Elements* \u2013 A Cozy Puzzle Adventure \ud83c\udf3f\ud83d\udd25\ud83d\udca8\ud83c\udf0a  \n\nYou are a **forge master**. In your peaceful grove, your task is to combine elements to create new ones and help shape vibrant worlds.\n\nStep into a **tranquil realm** where **fire, water, earth, and air** are your starting elements. Discover new combinations and watch the world transform as you apply them. Follow a **path of elemental discovery**, uncovering delightful surprises as you progress.\n\n## \ud83d\udd25 Features  \n- **Unlock & Discover** \u2013 Over 100 elements and unique combinations to explore.  \n- **World Building** \u2013 Journey through 5 handcrafted worlds filled with crafting opportunities.  \n- **Relaxing Puzzle Gameplay** \u2013 Simple two-element combos, designed for calm, creative play.  \n- **Immersive VR Experience** \u2013 A cozy, stress-free environment built for exploration and wonder.  \n\nFrom summoning rain to growing a mushroom forest, to forging tools and shaping your surroundings, every combination brings your world to life in meaningful ways. Whether you're crafting, solving puzzles, or simply deep in the magic of elemental creation, *Forge of Elements* offers a **soothing and rewarding VR adventure**.\n\n\u2728 *What will you forge?*", "short_description": "A cozy puzzle game where you mix elements like fire, water, earth, and air to uncover new creations. Explore five handcrafted worlds and enjoy relaxing, creative gameplay at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/projects/forge-of-elements/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": n
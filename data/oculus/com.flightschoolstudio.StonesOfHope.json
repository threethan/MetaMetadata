uscdn.com&_nc_ss=7f20f&oh=00_AQHNKvdX67rNkYGU_gGpJl6_M8oWx23CBTLrDltnDxJ5zQ&oe=6A8EBCD3"}, {"file_name": "NITT_Screenshot_5.png", "id": "665083618492483", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974716_665083625159149_1064865793251564261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdiB3QyLiYMQ7kNvwGM3AhD&_nc_oc=Adps9WijlAQ1kpYxBY8MSzc3RZ_gAa8iXCYyJG8Val4Y5P0CMVrjjLs0k-IBv5tv4zg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRUUSPfG2S_6Qe2f8iaygWulVdHSxM2jB5A-G6AT83fw&oe=6A8ED05F"}, {"file_name": "NITT_Screenshot_4.png", "id": "1849346928758200", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036672_1849346932091533_7796005936924380429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAC-arWm_2EQ7kNvwFzLQDA&_nc_oc=AdrBMiAy7KWNydq_nMPZY9dFb3f-2jneZs1HRJr7H7PBuGxdcJnXYhCjFEyddXvEUsU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKDee_DkNbADp5kCR9prfqO8GVoyi9TLRi9yaOYoWuhw&oe=6A8EDD51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NITT_DigitalAssets_v05_HDvideo_1920x1080.png", "id": "942459706719818", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035433_942459710053151_7882200148446536338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9_5en22XA8Q7kNvwGfgs41&_nc_oc=AdqpCfR8KioPkldz8pdtwq0vAiiLoTwWxCsR9TuYqXI-mqQpQM-XWrYKPapHH0cVOSs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZKVDtaGscRTYWyU6wA8bareAt2u9NVpmRxrlrBzCsJA&oe=6A8ED3C5"}, "display_name": "MLK: Now is the Time", "keywords": ["civil", "rights", "dream"], "long_description": "** WINNER: Audience Award: 2023 SXSW XR Experience Spotlight \n** WINNER: AIXR: 2023 Social Impact Award\n** WINNER:  Webby: 2024 AI, Metaverse & Virtual: Public Service & Activism\n** WINNER:  Webby People's Voice: 2024 AI, Metaverse & Virtual: Public Service & Activism\n** WINNER:  Games For Change: Best in XR\n** NOMINEE: Emmy: 2023 Outstanding Emerging Media Program\n** NOMINEE: 2024 Producers Guild Awards: Innovation Award\n\nIt\u2019s been sixty years since Dr. Martin Luther King delivered his iconic \"I Have a Dream\" speech, but the messages from that speech resonate today.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists. ", "short_description": "Dr. Martin Luther King's iconic \"I Have a Dream\" speech contains messages that still resonate today, sixty years later.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "https://www.flightschoolstudio.com/now-is-the-time-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TIME Immersive", "support_website_url": null, "website_url": "http://time.com/nowisthetime/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
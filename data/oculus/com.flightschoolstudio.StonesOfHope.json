ss=7f20f&oh=00_Af5qyGLdClQCCsa057JutUNGfKSbRFXQ8PvuPNtnHc2Cjw&oe=6A106513"}, {"file_name": "NITT_Screenshot_5.png", "id": "665083618492483", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974716_665083625159149_1064865793251564261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQC_QwEloG0Q7kNvwGQgwYG&_nc_oc=AdpuKe6i1jE6WNWj7ca8JAnQnUqPe2mc70_FrU5GiKFh0JdUy1ISlXc0x8s-d-rAkvo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gm1YhlWQo4zCdN_hLcSt4wNILdfizqGn0NxsbW_2IGw&oe=6A10789F"}, {"file_name": "NITT_Screenshot_4.png", "id": "1849346928758200", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39036672_1849346932091533_7796005936924380429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6aQQvjCNaYQ7kNvwGx22Na&_nc_oc=AdrNlNzffIE7AR2nuru59ZMEzyQ8XU1UNCx2HlbHMz4fklyvtMP6USdbyAqWAXMUihM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mv32sj1rXg1C1mhjJc7SoJp0i51B-glQT7lCPwsYpQw&oe=6A104D51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NITT_DigitalAssets_v05_HDvideo_1920x1080.png", "id": "942459706719818", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035433_942459710053151_7882200148446536338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ltvaZupjl4Q7kNvwFnn9Vy&_nc_oc=AdqUEvGcfj4p5QX1F3tWZg7ZlsbMPseNGt2lvAqV5Y5QoVOFMvErDtbFGxQpJuQPQHU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hH_qnY-AJVfsZmtKrq5Gev43LuRIGBjSmYSMfBdcOMA&oe=6A107C05"}, "display_name": "MLK: Now is the Time", "keywords": ["civil", "rights", "dream"], "long_description": "** WINNER: Audience Award: 2023 SXSW XR Experience Spotlight \n** WINNER: AIXR: 2023 Social Impact Award\n** WINNER:  Webby: 2024 AI, Metaverse & Virtual: Public Service & Activism\n** WINNER:  Webby People's Voice: 2024 AI, Metaverse & Virtual: Public Service & Activism\n** WINNER:  Games For Change: Best in XR\n** NOMINEE: Emmy: 2023 Outstanding Emerging Media Program\n** NOMINEE: 2024 Producers Guild Awards: Innovation Award\n\nIt\u2019s been sixty years since Dr. Martin Luther King delivered his iconic \"I Have a Dream\" speech, but the messages from that speech resonate today.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists. ", "short_description": "Dr. Martin Luther King's iconic \"I Have a Dream\" speech contains messages that still resonate today, sixty years later.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "https://www.flightschoolstudio.com/now-is-the-time-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TIME Immersive", "support_website_url": null, "website_url": "http://time.com/nowisthetime/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
_1894909554187819_1925674753099679481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0FmwDbmhmIQ7kNvwFV73uj&_nc_oc=AdmcVowLtBb7TdrrR_PZzQCpMsooPDMaq4G5sOKXCNUZRplACrYzE7po9tb-p_o00m4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOkWLJ-W1yDWhlR1fbdZvfa7Tju5l0JtPsrwP1kWcU2w&oe=69B17913"}, {"file_name": "NITT_Screenshot_5.png", "id": "665083618492483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974716_665083625159149_1064865793251564261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3kXvvn0ZaQQ7kNvwHTtXoe&_nc_oc=Adlrp4eK60ejJaDIJkj4CIBA6Rw-OBIr71N1ussIdrC6y4RnQB0ok-durqgGu5YSUE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXgtrFMWU2QEYgjKkiDSx0Q8PmPxmQDbeyV_6PdimYzw&oe=69B1545F"}, {"file_name": "NITT_Screenshot_4.png", "id": "1849346928758200", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036672_1849346932091533_7796005936924380429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4c9n9PaMBEsQ7kNvwHXF12y&_nc_oc=AdlWpfnZcq8DK-ZZYRyUoKz4KFin_V55upoSPfb09b8wOqYU-IMzH42zUOwTUetIrVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW6qsCPg0BXMVaKHgE5SIxjNIVmi6xhaoUfS6Tg37K-g&oe=69B16151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NITT_DigitalAssets_v05_HDvideo_1920x1080.png", "id": "942459706719818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_942459710053151_7882200148446536338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y22YjSam7CIQ7kNvwGIvCce&_nc_oc=AdkyfT6bKkC7y5hKwIJU4fVxgRWifJ9bJo2KJA_97CNvQ2bt4d5PJSnaowWaWgbCwio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeZ4M7Z-XYdYximrUMYGjAr2Y2bwzZuMZAdEzsIKpqUw&oe=69B157C5"}, "display_name": "MLK: Now is the Time", "keywords": ["civil", "rights", "dream"], "long_description": "It\u2019s been sixty years since Dr. Martin Luther King delivered his iconic \"I Have a Dream\" speech, but the messages from that speech resonate today.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists. ", "short_description": "Dr. Martin Luther King's iconic \"I Have a Dream\" speech contains messages that still resonate today, sixty years later.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://time.com/nowisthetime/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "TIME Immersive", "support_website_url": null, "website_url": "http://time.com/nowisthetime/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "496618139167721"}}]}, "scheduled_offers": {"c
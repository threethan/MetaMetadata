ss=7f20f&oh=00_AQHL1vX2PYdrXekqsfb0gKSitdqKB6XOMwZNISm3LJQyCw&oe=6A75E893"}, {"file_name": "NITT_Screenshot_5.png", "id": "665083618492483", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974716_665083625159149_1064865793251564261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKjokCsjsGIQ7kNvwGoe0tg&_nc_oc=AdqgSG3T7Or-B06-UlzyB5XW85rikFXLIytfsFT6Ztwt0ePFFleLFIfn4vCoIl32qsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzHyDv3uwep5JR1mguuPf86Mx_04pbOeWjOUbSZBTCBw&oe=6A75C3DF"}, {"file_name": "NITT_Screenshot_4.png", "id": "1849346928758200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036672_1849346932091533_7796005936924380429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNFpaBpMG3kQ7kNvwEwh4vd&_nc_oc=AdqONzZuhGYCl3yHrMtcwvDOl1il9FJ0MXkjYuHc-5RH8c6zvgY7WKIe3eO3t8c8ZLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf2lP35ZlEJJ0w3tUxclPmL4HxsS5I2HQH8yYsUHV4_w&oe=6A75D0D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NITT_DigitalAssets_v05_HDvideo_1920x1080.png", "id": "942459706719818", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035433_942459710053151_7882200148446536338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0F8QbhOeNIQ7kNvwGP6pHQ&_nc_oc=AdpQOSF-fXfC3QiSQNzvk1uZGfg5_ci_NK6yxENAbuyPhtygr3a713RNqV3PF4AAvNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoaGwrOkGIn3t3Gxs4dD1kSIfWMSmF9JuWoJff8qqljg&oe=6A75C745"}, "display_name": "MLK: Now is the Time", "keywords": ["civil", "rights", "dream"], "long_description": "** WINNER: Audience Award: 2023 SXSW XR Experience Spotlight \n** WINNER: AIXR: 2023 Social Impact Award\n** WINNER:  Webby: 2024 AI, Metaverse & Virtual: Public Service & Activism\n** WINNER:  Webby People's Voice: 2024 AI, Metaverse & Virtual: Public Service & Activism\n** WINNER:  Games For Change: Best in XR\n** NOMINEE: Emmy: 2023 Outstanding Emerging Media Program\n** NOMINEE: 2024 Producers Guild Awards: Innovation Award\n\nIt\u2019s been sixty years since Dr. Martin Luther King delivered his iconic \"I Have a Dream\" speech, but the messages from that speech resonate today.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists. ", "short_description": "Dr. Martin Luther King's iconic \"I Have a Dream\" speech contains messages that still resonate today, sixty years later.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "https://www.flightschoolstudio.com/now-is-the-time-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TIME Immersive", "support_website_url": null, "website_url": "http://time.com/nowisthetime/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
_1894909554187819_1925674753099679481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMoqHPmUaF0Q7kNvwGGEotW&_nc_oc=Adkzx_tk6rB1pZjCLKlnUdkcnXZ5wkOBXRfeF8nOznbkga9GjY4xvEx3nHvaAiJkC5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHPIGmcTZlRP0c8FFnNTcKmuAEAqI6TigjtR1fihKAXQ&oe=69B56D93"}, {"file_name": "NITT_Screenshot_5.png", "id": "665083618492483", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974716_665083625159149_1064865793251564261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASovSRcjpf8Q7kNvwHNSlsH&_nc_oc=AdmQZNImmU2GAqc6XIWb7z-IdAOSCV22nItTJvYkp7JgQN0f76LUZVnPlqS7G6IuecE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz70ZxODEIm6Hb-bdkaYGXBzUwTJx3_j58TpJSCyWUL1A&oe=69B548DF"}, {"file_name": "NITT_Screenshot_4.png", "id": "1849346928758200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036672_1849346932091533_7796005936924380429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HigwP8KwzswQ7kNvwFOHXW5&_nc_oc=AdmRMfoPE0vOo7GcC_4PgGcB8ObTPVInhEWFlqL7s1IJZ9R5s61ZRq9vOaeBF91MUGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjpX1V9_NTvM28mVfg4gv1c_AdofBQtY2yCxYs3hHjSA&oe=69B555D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NITT_DigitalAssets_v05_HDvideo_1920x1080.png", "id": "942459706719818", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035433_942459710053151_7882200148446536338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUCvlFhHjuQQ7kNvwETcMGh&_nc_oc=Adk4lSTVBEuYX_nv68MlUslqVKC9nakDVo3QF9vniabnVjkFRmdodAmHiuGrfGz21Gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAiN3_E7Msiu_HyBITbv9SgyNTE6wLgzbgZNx_j0rcQw&oe=69B54C45"}, "display_name": "MLK: Now is the Time", "keywords": ["civil", "rights", "dream"], "long_description": "It\u2019s been sixty years since Dr. Martin Luther King delivered his iconic \"I Have a Dream\" speech, but the messages from that speech resonate today.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists. ", "short_description": "Dr. Martin Luther King's iconic \"I Have a Dream\" speech contains messages that still resonate today, sixty years later.  \n \n\u201cMLK: Now is the Time\u201d is an immersive journey that explores key themes of Dr. King's speech and highlights systemic inequities that persist in our society. Through first-person stories and interactions, \u201cMLK: Now is the Time\u201d drops you into a thoroughly modern interpretation of a contemporary March on Washington that will inform and inspire a new generation of activists."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://time.com/nowisthetime/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "TIME Immersive", "support_website_url": null, "website_url": "http://time.com/nowisthetime/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "496618139167721"}}]}, "scheduled_offers": {"c
63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFC0U96KMM4Q7kNvwG_CrYp&_nc_oc=Ado4cRntqOLFX5RIByQ8CoWJM70es-AUN53AkCH1BvLmkapPQ0pcIWD6F0GlDtrt178&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpusQjfRfvaal-00wvDyxY-viwY_hPRjKO5-rpK4kCNw&oe=6ACA5E42"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bi1geh-9dYQ7kNvwHcD865&_nc_oc=Adrh1FSpVI2MdifhC2Vvl6Im7uDLmOuC2IsqcKmwK6OifbUH-jxs7LJtASR8kxsL7WI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdHKMOn1beVRoRldRkMJ4jVRIs2hzUPSMWxsYRDrMoew&oe=6ACA44A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDwcdOsZAgUQ7kNvwGkiL_a&_nc_oc=AdrHD10aLmYVjqJLoOZdA7fCsxBvbnSseeQx1R1F8mdZ5RQI0jmIldOymHHYnug3iRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBsk6AmmFlSf39yje9qF-NnJatxUIOS5hUtEJ1_XpY8A&oe=6ACA7338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F1fN7HmqRMQ7kNvwEeY3LA&_nc_oc=AdoUktRKp8RZL2YgrgNO-TcdiBOS4cYY5zatsQ6_1bmZvwsb7xuaG6JpfAdK99b4mO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZlLXERiNFPK31wWu_Fn6H7YF0nou8nXBRcHpECjYNlA&oe=6ACA5F03"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cV5hvEQ-VM0Q7kNvwH9JAZ_&_nc_oc=AdoAFMenRRd1Tubke6vgVFRFRtr6XG59TffEvLoGsRHixOD_3_kTtVR7Gs_JTMIRSxo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75qKXvCk9POe-NBIfe5iKW0Jou5anZ4P2By3y7S9ypDg&oe=6A0F2942"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB04DOiChsQQ7kNvwGq9R-C&_nc_oc=Adr4ZG7c8qihLTsGp53ZoQFvJXpE_h9eZ1xDbP3ul2hqLsAQYiYcVY-XC57MN97b4xo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GfXZ4wc2ac0iipza0yAYYlb9K0NwigmY1Nlkd4lgPNw&oe=6A0F0FA0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvt4k0DF01kQ7kNvwH-keHx&_nc_oc=AdpoeKLMazKW6LHIN0s19vNqMP8lyCDnbFJymXmnnJbhcrafs9C_yjbSKuX2d6ROTJ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66A6CU_QXCQml2nX-lihwrvRhzefkZiRd_6z8Fd2qL5Q&oe=6A0F05F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ9e_yJdWLAQ7kNvwFfCweY&_nc_oc=AdrYm2BmG_CNIhqVTr3KfqRTp5aJauNTmTuXXCQzfdaxbGgiuT3ll6tnJwFrn40Fxwk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xipDjM_Csx0iUd7MnYwz9uRYDVdkKwA9tYlJrv98pGA&oe=6A0F2A03"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
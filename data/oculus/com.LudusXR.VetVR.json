63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg8bhCPsUEsQ7kNvwG7qU0f&_nc_oc=AdpmvIN77nPX1MqFw0XnS2gsrvk6cyTASKRCfjpcPiwsR5uwlpbtrtBKeGzGPUIjs4I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FGUy7ArTAAtcA2hBwoBXTigsZxoCSpM2hzw206h2z2Q&oe=69DF7B02"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsCHl3sfyboQ7kNvwEKIqiT&_nc_oc=AdqCwSptI_4pUyDckz6H01bCE5Dc6nBD1zNJhp5WONmm2psGO1KoQNEfJ3GW88Hr8Ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zti2qG-Zb5MKQ7_7DgdunootvfelvHvVY1US7DhhvWQ&oe=69DF99A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ww5BUMKQQbUQ7kNvwFD0YJ0&_nc_oc=Ado1PiOj3pb9UBkM5hU0H6HiO-LS4sv2J2CaIXbB5XVSF7dMe_AXz8BNv8DWOVmu1b0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OZIiiv31-pD53pZjFFXOHJ-VkBgq7R-86930nXhrcnA&oe=69DF8FF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv6WnX2HkNUQ7kNvwHPhUIy&_nc_oc=AdrDztoHBqM3AO5NhEhA0gcZ1sS2vCS_HlgnBgKuMri2EO2vla9vuaBknZjUw_z7qNc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DDrYv1nUTC08eHhv-cs85vMb9hWnNnEkPjuMgeeMLgg&oe=69DF7BC3"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7432967543408207", "
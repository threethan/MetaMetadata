63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzGF_Ioh14MQ7kNvwF87pw1&_nc_oc=Adqgr7gD-_gSctOZnXLOb2YPt5Sd9HMPeHRqkNiBxfpDFFrCexyMcEdipTna7sBjsvU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mG-QYwrslxPMuhpAXyi-oIbm4O00LwkdySWqmOcB7EA&oe=69F34182"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hdq_fACzHKAQ7kNvwGOQkOz&_nc_oc=AdovhYBtIQLMTrbF991SNh5QxaMQfEcxkt16NDCdwuJrQWTtEBfS65NUvxSFyxPP87k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oVNbKjehEK530qXh3a79CaES-eUo_awHuq_IEprYtzg&oe=69F36020"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8RxjrfSzHkQ7kNvwF_EnfW&_nc_oc=AdppeaDI-amMMQ6xoS0KKpfrLcsX1r09UqT9afhDdGGHvIgg6m2xDAqbCT3IPd0h4m4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZUwKjZxPkdg-Ns3-XdHc7hT-L1jv4bhGr5TRkWSPyYw&oe=69F35678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAcbj6pGcQkQ7kNvwFXNglk&_nc_oc=Adrwcg8SnK263Ppxgn-DYpNGtaCK_IFEe_l1VLFoq6fVmnX1aSbUlUJVlg93hdRflTU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Q9UJEVbVwUUPLZ2gMX74J8W4uvdPmhE79z0CgzqADQw&oe=69F34243"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
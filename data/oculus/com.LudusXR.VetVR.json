": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974896_1534347870649560_6333670791754459890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDZT4E44MXAQ7kNvwEAMcIW&_nc_oc=AdlGcYj2XOThfDlrgpydNvDncTJHcSL-Zu84xfYAIAc7YfUwATvqw2IFr1Pe6jjhVxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3Uc2fkXCtBvheX31-jUYIiN3-l31hpQwc1NPYcRFifg&oe=69A2CA42"}, {"file_name": "cleaningWithSpray.png", "id": "1522108965030930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031478_1522108968364263_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc_yxS3GQqIQ7kNvwHHbHaK&_nc_oc=AdmFVznIqrft9QGccbKe93u178nGdsp0cKCkqCLxt3V8wHIu3d1WGKkAP1Am2FgjV60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftodP1SQy4pV-ep0ud-iHyDOZTlEki2bcQjQlZBLzPjpA&oe=69A2D602"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A82Rs6Jceg0Q7kNvwHiXTak&_nc_oc=AdmU1olbcYqG_n8OGqUNpN2GxcftGtWLcWZBKje5cujPz6VjbEWIrleTgcTqdg2MPyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs8gvtwUgWLQ9Zn4GBiYQCH8Nzi3dF556-MdSIxwa6xHQ&oe=69A2F4A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMONlCnbi5cQ7kNvwHNz-CG&_nc_oc=Adnd_0RYPBgApUSHtdwUXAB9SAI9qGrZM5ws11s1pqw_7FWW8KrZaHFsShV2O7isy5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvGgICM-BDiWSdr-P-BjxgaVxbq-TT2gYlNxBNSUZNRCA&oe=69A2EAF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZelkToW4lIQ7kNvwFnVDSi&_nc_oc=AdnRCYjr2OUF3KcN477VTjtJaHQF-fRx7FAm1AoikYwudIjMipwH1tCPXafgKzb3iT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQNT8ZYgv8jrK4hs_OSDujoNMpyvCEmBHMomCPzlB0Vw&oe=69A2D6C3"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_in
": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974896_1534347870649560_6333670791754459890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHWEIMf4QnEQ7kNvwHp5h_O&_nc_oc=AdnNhz-0qnz_W0mLZmi6vdOJIZLUqFy2fqWkB0QmC4NVKR1OsZNYQL1kcNTllgLPnPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvk5bgee-j2jz8vx3zjOYcEkyh1CJ9nJtq42yDzP0UQ8g&oe=69A6BEC2"}, {"file_name": "cleaningWithSpray.png", "id": "1522108965030930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031478_1522108968364263_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2unh0Y8z7MQ7kNvwHYu7ph&_nc_oc=AdkHIuUc97OziYEKjAMn18zYv7GLO3SWBeyv7JIIyrdzU7da2m_jVWypv5qUVyy90w0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv86gOc_tFMWGz0EKFlFFCkRMxnvdqGywBjWdGJP-rlcw&oe=69A6CA82"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K53uIZ88aRQQ7kNvwG7TbQB&_nc_oc=AdkfxkEsNwxb-rGchv6eUhMVFXP00hPEWrcPMmbz40CmtbCb-uxNCqRx3AM0bFUvty8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLbT80iSeX3JS4i4Rv1aCO9UPqXaMK3AmrSPNo5czRAg&oe=69A6E920"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmZIhZ4-lZQQ7kNvwEllNOW&_nc_oc=AdnkFjBTZFeBnSzQoHPq_vb8fTc_kaUJlHXU4bfe0oKzcz6XQ7BHxuLb4clQb1K2CKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftOxy4hZGi2AreudZpWjffxQ4yqER-2DGQa89L8Akzcng&oe=69A6DF78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc6B7lQy8tQQ7kNvwGE_J6e&_nc_oc=AdlxM1eojU3s7iusDqA8LftVT_Zlq3G_Msf0Yq7MJzTaoEBGTjl3sKBLLl_lg-EKkoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTaMy9WTp0-vzgu5Rn7SCfgysalS8cG7XGxNP0ax7-1g&oe=69A6CB43"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_in
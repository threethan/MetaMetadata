63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r61qx7rD4BMQ7kNvwH-seHA&_nc_oc=Adp1FSA8886UNaqpU8C_d1oK1eM2K8ohIGfAK5FqnDXRTODswLJJe7Hq72IirUHy9hE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoLR7DYGR3uZc-7EMDHrsw3OgjQ_CO7IvrCr46HGmTLg&oe=6A7F0082"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XVj0ptUjbwQ7kNvwF9eLRT&_nc_oc=AdoU8WEIoMgOq-RuE1xl2s10b5SInii-1EXq2dTUZldpqLguswt1MdkON_nrQhBzSMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSBFoRB0piASQMfK2B1fARKvtJWPKUbfBb6QbkORzxXg&oe=6A7F1F20"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac59gwstOCIQ7kNvwGuazB-&_nc_oc=AdoII3xPvLM0qqO-DhR6Ww8LJL2da8WMG96UkNqcfb49McRap9dCgTolAD540GI9DSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErVPrPVRq84vPO_TMisDdxTDoX6IXHPEUBdLTxAinD_A&oe=6A7F1578"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ij606SMTCyAQ7kNvwENw9nr&_nc_oc=AdpOts3bjx6djZZe_RnW3DjRBNXWkqc9XkjuKaqgBVUUb2IN6QeJjTUcev6AHQftdQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQRadUrawYQGn3GHtBZdp3pPlvM2St4NxF3Pi7OYpHTg&oe=6A7F0143"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
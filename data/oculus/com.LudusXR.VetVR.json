63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWs8jIW1BEsQ7kNvwFD9KVp&_nc_oc=AdoJawBA4Zw3fC39800kH2vKDWvOfVNUYI5EXZe7rXEfObYxOIU9Rv1stb1sBocgpdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D2cVY_SnHT5UL67BpvPJbCMC2qjciSMGOCHAQ7sgdRg&oe=6A19B542"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcxZbaTJ3HkQ7kNvwHlPRUl&_nc_oc=AdoiCioScaJGkiWpHSbYmcfOYCRu5XP1rQ_d2H4xAyTtLKYhjriEBLza2BdMBy_3oxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_ItX4QbhxRxTcMiU4rDBVurbXxuT_d00iBIDWollDIw&oe=6A199BA0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3N3CsZ3ybcQ7kNvwHy3HmH&_nc_oc=AdpuKivuJ0y9gGd_jTKEq57ODhAD2YLMpfz6E13_6VYG5fPVYsbMZKbnaDiXYsZ_IyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41MebVWOW0YmrO_v4F9sWPx5HC0XMGVjmrftLnuzNqtA&oe=6A1991F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLyqTqPv_-EQ7kNvwEFP9NZ&_nc_oc=AdqGvj4HA0M1AwL4xlnSdBj-ZXZFZUFyg893VYBssH_CBz2o3KH4HyesAvlw2B2Mojk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dk5blMNCmkekDghw2C6gbtyZ3OZ8tEoDmG0s1lKzgjA&oe=6A19B603"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
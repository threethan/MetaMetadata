": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974896_1534347870649560_6333670791754459890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhQNhdpXBlcQ7kNvwGyP_zp&_nc_oc=AdlRdm7cfeMIl5MFDKV3uPJhpjdvP3tVfp3SbAWs_rjMLcnPkslRxC0h67sD_6Aga3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9YYTZNbt2ncg25MVrz4LYLIVXggI70sfu618ZPs_DLg&oe=699D8442"}, {"file_name": "cleaningWithSpray.png", "id": "1522108965030930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031478_1522108968364263_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3vRpmBOIQoQ7kNvwH0Ohzf&_nc_oc=Adm49n9Ow3f3Mth9uvBKTpjOCpE_B2-rBvQso-xBbG5oU4rFLGp4cdOxvvxaDl_NHXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfskHJRPKRGN8A6-YWP4DYlH5ygfaBESPUS69-_IUi5-og&oe=699D9002"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J_lqC5MzoYQ7kNvwFdK131&_nc_oc=AdkFY6aGVlFJle8srrcD3uWoT77W-4JIkbF8jt6FojUZqlsnb9ldNQEub6nUGz2v4d8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqIs9JLr1FZKtiB3Hijv9TeugyqID3VSy-eyySuiAiUg&oe=699DAEA0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6GHRouLt8sQ7kNvwHi_Roa&_nc_oc=AdkDIXRyLXjJjh6iRet2_xsXxmznMk_k2v8QEWywWabVsiHn45YDHB2P_FP_CjU3F5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs6ab16PWR1ID1AFHKRpaKnUsKfs1J9ZQHQTsjzj-51VQ&oe=699DA4F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9Do0nvqrE4Q7kNvwEqPAqF&_nc_oc=AdnrYzHFDoXREmQza6kKFKLaUyFrYhtSPWO1NQxY6VDMmLgFbIWR9NfvNtU5tRus9Yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfscSLW8kvuqEHif0y2y6p60JhEXXYqpZXSqFf-1poTYTg&oe=699D90C3"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_in
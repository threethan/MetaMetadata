": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974896_1534347870649560_6333670791754459890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDZT4E44MXAQ7kNvwFq5rjy&_nc_oc=AdnH6b7NKy7RbfycGsN0Y9-2JHCx2jj6cv5ap4jNHVvYyXPCHKn8b2Cvh92dw-zC0ZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJGfi0GT-B1YZWNc-91BQN2SmIzEiuUrMvzZlQLQBs5g&oe=69A02742"}, {"file_name": "cleaningWithSpray.png", "id": "1522108965030930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031478_1522108968364263_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc_yxS3GQqIQ7kNvwGzK5_v&_nc_oc=Adm0E6Zd3k1PxQa8vF0ZC1ohaZylpoRXz7hgHI3Z90btWEBWD7OMz9Bl0NnHUW3pSrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvM8QA3rV2MZDCcE0n7Txj6boHp0xIxour202aZfcqNJg&oe=69A03302"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj3qY298hYIQ7kNvwEzoHSF&_nc_oc=Adl3WUnO8lNsEx4299kB1r3baEvAyB-TIsAVm4MJN-g4xR3GjprR3RFlYt-Hk9kiPeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpLbbwZ53XAAVOmLxhTss-U8TnHNh7dGT6UvrXcbD0Cg&oe=69A051A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6GHRouLt8sQ7kNvwG9Ojd5&_nc_oc=Admf111aP56_LaYfIetCv1d7gau3k5ftdF8cODfnGw4iYR8HiUtZBQnvu3n0pshvFsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftMHDfvi_guU0FiP32G1MWu_V9VYZg6Cr_AT3MOKPPOOQ&oe=69A047F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9Do0nvqrE4Q7kNvwE9D3Xk&_nc_oc=AdkzhB_bXyAYLyNRvqAmnMEvApjBWEwkBvPTUPxsD4Qk7c_QSdJHpuhEo03Fnhn_h2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2tfln2DaC9VYlv7Mqh6TXSgv8uzdNx2rzKW3dvb2Atg&oe=69A033C3"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_in
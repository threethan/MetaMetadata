63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFC0U96KMM4Q7kNvwEvpWyk&_nc_oc=AdoEc97osSEtmtV588R9Peg8na4blpCiEq3Y_oZ_hd0es4IEFQKeFEeUFAcuRyU-Auk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoE5LNEmjJMLuckDpH2Q6S8wHm1Rot5-_cH2gPqKKoeQ&oe=6AC7BB42"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bi1geh-9dYQ7kNvwEn0o5X&_nc_oc=AdpztTKoGIBLenFNW6LHqPNzEKF2GeuHioJ2NXUegg3X3Z7WBq9KKfG5XqWrEhIOv0k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOy1UeACBd_FtA2dx1a7wNNE49zI5K_aiI-X5urXRpXQ&oe=6AC7A1A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB7_0VufY1wQ7kNvwGU2MsU&_nc_oc=AdoVG9Ry8TLnSr6-c_85lyYmYE3W7NhwUE8bfCv_oKmNjKVNNg8Ld2z6lSz4-4jvcgo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq63K5_TuPxsoEhaL_AuBzoWsiQx6zSUob_V7Nq98N4g&oe=6AC797F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVSA2y9vf-4Q7kNvwFbE81D&_nc_oc=AdrM1-qDO9CDx1N-83XThT4BSC_pK0VX7d4vqjp_SG21C6WJSlzVp-UCpheQvEdo9As&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWrlPleIOvfm_EcI0XIUdN5GzqkDF8INSk-4yEMIpIOg&oe=6AC7BC03"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
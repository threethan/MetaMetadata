63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bXfhAWJybYQ7kNvwF9WDEF&_nc_oc=Adr2RV9cUwfrAfhOMv_L6g8GXCXFMt0eDV5Vbz-NT9sjhdNjFUpB05vLXiGLRMxX1A0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQmV_DaOQcT-e2JmHCM5BoQeJMIirMEo2CDFBl5z35gA&oe=6A8C2F82"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLSDMRF0BEMQ7kNvwFN8ya0&_nc_oc=AdrL4YI7S_Z9CY_LlmSkciyObQCQ42ldmdaORQ3Sij420vCEQAv2f1h5fuc8lFEdNHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5x4p35J2IbCtlzi5WxGoo4QwGm9mgXU41tB6vL2PLOA&oe=6A8C15E0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0LeH5G-zBIQ7kNvwH2WyL2&_nc_oc=AdrxjXViBoXROvcuGH-fxmHifIP-1dA5ATvRHZyXwJC2i6kgFArywJUTbYbpUl_EIJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFksmYo0_cUsC3mqsmfSfrcWSy709ngCN4NGvxB9ZjyOQ&oe=6A8C4478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q31LqWCqvsAQ7kNvwEg2Ynl&_nc_oc=AdpocZxIoqqOXnJ6eA9AID5w3RrT4RPtghhDaojirxyR_AyhTEbyRSVDKGmKIWqBYwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQEeCHzrgFHoOkrIaGdwvG9gSpV8FPW4WpKsZYI60USA&oe=6A8C3043"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
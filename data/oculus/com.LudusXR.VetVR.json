"flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K53uIZ88aRQQ7kNvwG7TbQB&_nc_oc=AdkfxkEsNwxb-rGchv6eUhMVFXP00hPEWrcPMmbz40CmtbCb-uxNCqRx3AM0bFUvty8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLbT80iSeX3JS4i4Rv1aCO9UPqXaMK3AmrSPNo5czRAg&oe=69A6E920"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmZIhZ4-lZQQ7kNvwEllNOW&_nc_oc=AdnkFjBTZFeBnSzQoHPq_vb8fTc_kaUJlHXU4bfe0oKzcz6XQ7BHxuLb4clQb1K2CKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftOxy4hZGi2AreudZpWjffxQ4yqER-2DGQa89L8Akzcng&oe=69A6DF78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc6B7lQy8tQQ7kNvwGE_J6e&_nc_oc=AdlxM1eojU3s7iusDqA8LftVT_Zlq3G_Msf0Yq7MJzTaoEBGTjl3sKBLLl_lg-EKkoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTaMy9WTp0-vzgu5Rn7SCfgysalS8cG7XGxNP0ax7-1g&oe=69A6CB43"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7432967543408207", "version": "1.0.1"}, "id": "537003161323319", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "b
63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07G1ImpU4SgQ7kNvwGajZ75&_nc_oc=AdoGK0rGskaS2uemuTIXMlVC0I9yT6dfb4EE0adswDYDOORxGCxQ2CsTU3R86sRFhnc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuIMP4ygf-rNuTq2v2M76sY-TQWnrVv0WbPSVZNCc2_Q&oe=6A6C8B82"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ybraRBV81AQ7kNvwFkypAi&_nc_oc=AdpPbMjAs4wF87ZDgBZ8sAdkhz6Oz_zV5Y-rCcSNSfIo9eeBWO3NGVGomgvEd02I7fM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyDlTnhMlJ_5KWjpiRM9zSBp6tGaElxq-wqm5yqOAPxQ&oe=6A6CAA20"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0qfK-bkHGYQ7kNvwFVmcd2&_nc_oc=Adr1FskutVfTnD--XymXtAHaHvGJFWvG6lsEXp5M1DnRGsAhP6BJ1POBHhrPYok0xas&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8pvvHzC1xou-Mr0KB1P_MgA-dw4y1i8CBHhVK5qH1ew&oe=6A6CA078"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFwxIoBVO18Q7kNvwEDEzYD&_nc_oc=AdqOp5I1IhFLsDuZbZB6Zx6C7WRdVjTGlxqrn99MjWBmnYqFthwuzUPuw0FW3pMIXgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD4yZ4krrGXw9ns4oUwvbT2Y7MJ_OIpVUIHZVAQ-5QIA&oe=6A6C8C43"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
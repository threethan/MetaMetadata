63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWs8jIW1BEsQ7kNvwEZtjz_&_nc_oc=AdoRtRXEbXoT_zjMU75JRe_pBT0OiuwK7CIhdGaGQIt3o4Ko5H8oSChRlLVYI3xd_j0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qE_TwgRKUO7AwBGM5oyxj2_IQUHAPwRsDiR7odceFdQ&oe=6A16DA02"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7GvgBelnXUQ7kNvwEdeisi&_nc_oc=AdovXnLz1vnFzpfXVJmZdndm3Z3Lhbk41Z8KU_kMwd2cRj37EUukmmMydgN_QF3XE_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iIAUIRM8lMQLxnbKjeHa5tzcWUY-XxM-eiZ1TmVjZWg&oe=6A16F8A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XloGlXnkOgAQ7kNvwF3ZrbE&_nc_oc=AdoujE0OmIdW1Qw_jPzFClDudwd4AyuFbUGL_z3sb2jXkVbikq7Olu5FV-T_vUSHzAg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZBqJFFBSIIMC07NjmKpsLHz0Na7mtxG7PVs0wXZSrFQ&oe=6A16EEF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmYHeydVHFUQ7kNvwFeQe4x&_nc_oc=AdrIJ8i-iOEsT0rZ8nwO4QgqHUHyFXKHdxbn6V5Lx8YuSfEMJVRfJRfM7mbceXULdSU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42TUEmabDqZ0Z0No7M0AZHDs3PYLZlDLWSWg_T63ePcQ&oe=6A16DAC3"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
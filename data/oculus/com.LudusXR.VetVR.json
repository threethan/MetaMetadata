": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974896_1534347870649560_6333670791754459890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHWEIMf4QnEQ7kNvwHYi6pN&_nc_oc=AdlFam6v4981iViiOiczmqwtu_a7rWxZCfnrGudoQbU1r3tnjBfupDIv3UbhjDP7Cp4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs3xC0lzhht_jEJRRsTZK2wIoqQOl947bH2R9o4ZTTIeA&oe=69A56D42"}, {"file_name": "cleaningWithSpray.png", "id": "1522108965030930", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031478_1522108968364263_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2unh0Y8z7MQ7kNvwEwXc2g&_nc_oc=Adk1mZSxLtUlnhueMX4eycvoAoINjb-RnHFO8jprmmgghv989k6bSiOLmJUpul0jYMw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvqHxoNnzotr3MAuVqsmrZ7K4gh4mqqFNtSLSf3pcIs2Q&oe=69A57902"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A82Rs6Jceg0Q7kNvwGefc8C&_nc_oc=Adm3M23kzpefsMRBEvx-NJ83P6CHwonCIo2bOk5r77K3lL53GPXoJbXq483zWd6CONE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvQknLKAmVkaRMonZXwdmbBFrjH283stfC4GGtutOsWjw&oe=69A597A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmZIhZ4-lZQQ7kNvwHChJqT&_nc_oc=AdmVDikvvhroqGQN4QgMKuh1J6p5CdGgAnUoZosU7V_bCuprdqYmq_7m5DvCQUG3fYM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvYi3wQsdaMXiTbPX5cYqtisaIGSJLgrudxeaK1HGa2YA&oe=69A58DF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc6B7lQy8tQQ7kNvwGvgzgN&_nc_oc=AdkfpJkr6gPtsSguQ2gCVb2Ml4glGH_vhhGvEUdmlpQM0dhpXfa4T6Zp1oX8u-Ak5Jg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv1MGYK_pemfIvQmClEjrxbUgGu_37n4CEGC4_DXK1IxA&oe=69A579C3"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_in
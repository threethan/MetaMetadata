63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC1VWpMlY1kQ7kNvwE2Ocjm&_nc_oc=AdrfE9enQEh5ma4SWt97bJkiv1BV4sARRHdeRKAqCD_tXNGxQc0GuFUm4XE1WxZdYSU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TxHc80Dpr6f3mh761mrqdc9iTud4Oz5EdB4Kl6IrAWg&oe=6A1C5842"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcxZbaTJ3HkQ7kNvwGKnTF0&_nc_oc=AdqxyMTuryPfyRDlZMGg3pEvclJiJA5XIm5oUHoUCgzf2RLs95_G_IWrusLxG9o7kWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g2aeyiZkWxWsH-GEP9DXsxXjv9HWNBnAIAqZmbIttAA&oe=6A1C3EA0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJGpkNk6aRgQ7kNvwHUOd3f&_nc_oc=AdpzwLfvtjIjYW3h3_YyFdHl14zlue9NamHu_iXdwYf9C28kYt6uxK-u09d-uAkUsG4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZOWNdfCo0dVg--qu2qyM7pPhSfamJStFmmRTHXDW6Aw&oe=6A1C34F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzTl-lKFVI4Q7kNvwG7jKwm&_nc_oc=AdrmCriiPv1rVi36sihpT82k-5zDhgs_TmBuPajY9ZovEl5U6L9NN34V9DHr3B9cOpM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KSzPnqd2IZ8OVcFm1BC0T761AWreJk5D7kXDX9HfGsw&oe=6A1C5903"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzNsQjkLRfsQ7kNvwGAW7cp&_nc_oc=AdryGHMcFCdTM1u7LLBvjBaOtl1sn_fFwZBfUNQ_veTD6XSzKxqZhyVF9Z_-0B_rvzI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I1jH-fNe7kdW3UbC1GR_68W2qBoLkPGMbTQIbjnZhRw&oe=6A341342"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKSB_RIpNXgQ7kNvwH_T3lo&_nc_oc=AdrQ6sV50dV9HlRseQyVSum4t4BAswH4dmkc7nTXBRTE2PfZrTuZq6LMUpJ_S2f790Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1CiZZ2ynfbQb1LUnU5KTnPYBxZY938AZoEvFhB10zeQ&oe=6A33F9A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca8i2i2WLnQQ7kNvwFXuHHD&_nc_oc=AdoUDuuws8zu-nOE2TyCq9YHq4fqNXfiS9DudFKNN4kepbMA3YcTB0gtIx8IKaKpFTY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JSfhnPjEPHrhpiYuQgNUqXx9NswXqEJy8XJ3cfDjtdQ&oe=6A33EFF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOVfWxAO964Q7kNvwEbQOSK&_nc_oc=AdpWMQ8m_C6wdehK9Lb_SfDniBRMQBKvui1G5DMrIMF68zBDuaTp3pjH9kIf2cQigBI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jOVMhVL2_HwHn_MPxNfCHTDr45gYSRuu6XS8rrOUcjg&oe=6A341403"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974896_1534347870649560_6333670791754459890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-fe3iHb8lIQ7kNvwEVDRZI&_nc_oc=AdrbE-FK6pKtk54AGywQNBbRJKiZjgkPXAoR88Du4uXL1JcD1MVNtEnPhC5ikDbQV40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1ABxsdghLi9TAWjXQynaAImQCo3gVrtFmrwh0FV8_A5A&oe=69F0CB02"}, {"file_name": "cleaningWithSpray.png", "id": "1522108965030930", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031478_1522108968364263_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX3zXupzgc0Q7kNvwEKUizs&_nc_oc=AdqvB6Qp-OZj7uOR6CluNh7Msz2VGAd4LXoFxuCjbdQ9U8X5OFryoaufOYQypNoOmdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1svdmku5-mMUMJuFHIQoz1RhYZ2psLMLC9ZiKvcbcpZQ&oe=69F09E82"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQWB-BzTFPEQ7kNvwFywXVG&_nc_oc=AdrG-aRP-W2MXJzUmDagsSi5PNMuie5zSbIDFVwBW8mlqlFYUc1TmGvftXhK6Zp4UL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af32-JgcCiDBWj6Ly1RaPc4vGsnU4H4eXCE9hIdlWgErvg&oe=69F0BD20"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8RxjrfSzHkQ7kNvwFji2Zl&_nc_oc=Adpn6rIzrS-GbWrh0_FPc-ZDefovIrBH86Oij4r3MQt1C0kLUfxY3WmmDd_AnsjzdXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3M7F7-oBfMQYGkSxxNHt0YJMNRQPefvW2wa_YfVniglw&oe=69F0B378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAcbj6pGcQkQ7kNvwHG7mV-&_nc_oc=AdqDp3BOfzlbU-rqbvdEgD51XKJnaWDnBrSKNAD7uQ8JafYIqjDSZgDAm3oBAV6YxF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1zgM4IgZRienCEXMq_L1S9A8Ptopslz2LZIinh3GFtAw&oe=69F09F43"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_in
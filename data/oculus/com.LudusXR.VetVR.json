63_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWk0rDrNI7YQ7kNvwEsp8GH&_nc_oc=AdrKdb7lmQZeDTu2KDL6ceOZ8_xIHia19hCV1et4pu1LfNX8Sy1oXYCgK6SMyxtGQT8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmjR8ubWdV36i6Kg3QfLRKlnDh0Jzussm_1C6pi-Y6gw&oe=6A65F402"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmozvOymm1cQ7kNvwGFyz9H&_nc_oc=AdoJEaMSjj0SqtXmPcvObOjO07y5Dve-ejtvKcZbYOg_wz4scB4CnykG2iRx6dtTAcE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPKnKDTEHfKfUZ9WyUiIxw03l7UOjD8qqQypNjXBq_Sw&oe=6A6612A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCTzYW-NCzwQ7kNvwGOTel3&_nc_oc=Ado8yqov-wMchEZ8I_KT5zPiM-mFQJg_dgmSWnimQXquphWQMm0cYmdGBdjwHZbTiiI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXGSKGedKE5_pUGkpNQIdX_3OwMjcU3Y0hzI3nSrlTxQ&oe=6A6608F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=go8QMI8w1DwQ7kNvwFGwkN3&_nc_oc=AdpoWk9JE1NbEB2z7OlioUc-8URc9m1i2wfVhL9Ez4QaJBNS2OIrKfjbMvtBOAsKCsM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDdTqBhtwdJ2b-fhfiPAic1eq-10dreTqnleSN0DIofg&oe=6A65F4C3"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7128837230487908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085235302515758"}]}, "baseline_offer": {"id": "1085235302515758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710417600, "status": "PUBLISHED", "id": "1085235302515758"}]}, "live
": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974896_1534347870649560_6333670791754459890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWCtN1A4vd8Q7kNvwFyBZpY&_nc_oc=AdleGYMcuXjFOPnk-fiifAnrEGqQYTWDukvaoDOssdXdBD4G1hfmgwRUT5Eugoeuz7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftarTt14XfZvTETzT16G5z5TB_wSu1YxKPFOzJZbFkQRA&oe=69983E42"}, {"file_name": "cleaningWithSpray.png", "id": "1522108965030930", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031478_1522108968364263_2379337462933560857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9tu695JYUsQ7kNvwG9pAWQ&_nc_oc=Adloj7aX-Olwm-yVcGcQbTlOwSeIFOgiK5_kXGydILRMcD7kExmQ0cUFJ8qf6HQokFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvAgBUlN-gQxjGVab8r_rDDKgNb3GBBzXypOlpfxwx5TA&oe=69984A02"}, {"file_name": "flambeePancakeFolded.png", "id": "729022662083229", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982675_729022665416562_4352407388892751409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVgJyr5pPRcQ7kNvwF_1dDC&_nc_oc=Adl3_v05M_VOV0P0Njok8R9QH9kTZnWf3ypNuBrr0oG1omISBjLJ7793LDczICXT6-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftLt_GVzMpPbMUvpJSmIcuhCrZCFZ12KS-xUbc9Kb0b7Q&oe=699868A0"}, {"file_name": "settingTable.png", "id": "877912063715289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269587_877912067048622_4839175162248191766_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpbQYWPvCp0Q7kNvwEED1gF&_nc_oc=Adl-uMtsZZzcILGA-jgKYDuqJzEvs4FBojnlUKMJRS5SxIOA93er3Gg1PCuWhYdOde0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsBGYKZAu2gKr236aXe3JhTp3LRhDWPjR_tpb_1ZY-mhQ&oe=69985EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "393947329643140", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974580_393947332976473_60093802883359770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lxg5dQ7zix8Q7kNvwHEnv_l&_nc_oc=AdmEL3PQpzY2FFsVOdqutQ3y5s8XIqdUR47urDA3sHg-DInfMEtb4YSJOA4t7Ivsso8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftUjuXtkjYLAIzEOWP8YPxKF6RwB1-x-NsVTzQ8MsTZoQ&oe=69984AC3"}, "display_name": "VET VR ACADEMY", "keywords": [], "long_description": "VET VR Academy is a supplement to your internship as a VET student. A long with curriculum co-created by five different teaching institutions, you now have the chance to immerse yourself in a virtual world and apply your new knowledge. The restaurant will challenge you on the following:\n- Proper attire\n- Hygiene rules\n- Different table setting styles\n- Mixing cocktails\n- Mastering culinary showmanship\n\nAll content has been tested and approved by teachers in the respective fields.\n\nThis product has been co-funded by the European Union.", "short_description": "Introducing our exciting VR game designed specifically for you!\n\nImmerse yourself in a virtual world where you'll navigate through different rooms, each simulating real-life scenarios you'll encounter during your internship in the restaurant sector. \n\nThis game is acts as an addition to your VET studies, providing practical training and enhancing your skills in a virtual environment.\n\nPrepare to level up your learning journey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privacy-policy-for-vet-vr-virtual-reality-app/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.vetvracademy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "de", "fr", "es"], "supported_in
thaRUBM7uG8jCuXpmCenFCk3i3Xs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FAriCB_ECvV1Xut2GeFh5T-FTNRSO_TEngrYTux0Tdw&oe=69DE2B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "couverture EN.png", "id": "2797379100575384", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_2797379103908717_6714222051980406816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lB7shfpF8ksQ7kNvwH2_M9m&_nc_oc=AdrHsSpKSogpkQdLr7sUd9aRKoCcd3DAInHZJZDj9q3yBhN2AaKuOSw5JlAOvsuuIHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bxIDu1jLgHd1aOzT_tKK8QJVWOneflhkPylOAMlsKYg&oe=69DE22DF"}, "display_name": "Natur'360 : Immersive well-being", "keywords": [], "long_description": "Take a time for yourself is essential to maintain a good balance in your professional and personal life.\n\nNatur'360 offers you a complete solution, an immersive bubble of escape, relaxation, meditation ...\nChoose the duration of your session and let yourself be guided on the chosen theme while traveling through 100% natural landscape only for you !\n\nKick back as you admire the Northern Lights, discover wonderful waterfalls, or fly over Mexico, unless you prefer to take a breath of fresh air in the mountains ... or choose from many other spectacular landscapes\n\nEnjoy a extraordinary and personalized experience, let yourself be taken away for a well-deserved break of rejuvenation and escape by putting all your problems behind you (stress, sleep, confidence, fatigue\u2026) and reload your energy.", "short_description": "Let yourself be guided for a relaxation session, a real immersive bubble for a unique experience in the natural landscape of your choice."}, {"images": {"nodes": [{"file_name": "Portrait FR.png", "id": "748890555812628", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_748890559145961_91784861105521089_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=465tJTLYcRAQ7
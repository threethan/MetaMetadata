ontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk_q8l-_x8YFfTUQHmFrYZR042M8GENz9YacDlfJmRsQ&oe=6AB7BCBB"}, {"file_name": "Screenshots 5.png", "id": "1399985180371968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210398_1399985187038634_1966755391793966900_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MikfSSjL20Q7kNvwFbqX7B&_nc_oc=AdqN9VtEmUksBI-8HcaDCN_QYOlyObvRxjnuuvaRw93jqMH8hnv58CLQQlyDFk0f13o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZKXB96RkW2jC7A3D-7Fjwg2VSleyWOpyLlJqoDEo5ig&oe=6AB7EB12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "couverture EN.png", "id": "2797379100575384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974879_2797379103908717_6714222051980406816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUssvbA-PHgQ7kNvwGofswE&_nc_oc=AdrVHsajUm1r8WvCHkz7KrpiZWo61KaZEDUd1nT5PLYY0ZQV9FDmtZ4pyn_QdbogTQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4rDr_5-yxszGnjfZLvltv8Hvn9dUOHFGtqEGbEyH19A&oe=6AB7E29F"}, "display_name": "Natur'360 : Immersive well-being", "keywords": [], "long_description": "Take a time for yourself is essential to maintain a good balance in your professional and personal life.\n\nNatur'360 offers you a complete solution, an immersive bubble of escape, relaxation, meditation ...\nChoose the duration of your session and let yourself be guided on the chosen theme while traveling through 100% natural landscape only for you !\n\nKick back as you admire the Northern Lights, discover wonderful waterfalls, or fly over Mexico, unless you prefer to take a breath of fresh air in the mountains ... or choose from many other spectacular landscapes\n\nEnjoy a extraordinary and personalized experience, let yourself be taken away for a well-deserved break of rejuvenation and escape by putting all your problems behind you (stress, sleep, confidence, fatigue\u2026) and reload your energy.", "short_description": "Let yourself be guided for a re
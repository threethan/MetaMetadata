AdLQ2YWTHGuYsH0bAgFzHfQNbtcbL9O9cmP_QmHV9apg&oe=6A491A8E"}, {"file_name": "Boom Lift Safety and Operation_Screenshot_05_2560X1440.png", "id": "3555138181387216", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196221_3555138188053882_8378332905791165409_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9FbV6MPy6QQ7kNvwGBtMA6&_nc_oc=Adog-0C1ChlwcZryNBvnXd4MLXav-WhHKGd1ohTwCPnvqJaAYCj6s0_f9XB9EJeMjWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlDZzApSmJrybPAw0Dx_nhvW0WAGAhBbMZW9c9INI-QQ&oe=6A4925EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Boom Lift Safety and Operation_Screenshot_04_2560X1440.png", "id": "1771221069973483", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036676_1771221073306816_8991018096220753362_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wr6zE018tgQ7kNvwFP0_rW&_nc_oc=AdqecRiIFXRS83Fj_bBKSrxY6c8G5nyOa-Wdhqfbc5BUTfhYqM7sTl7mLFdGVrlvCps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOJamj1Q5IvybpZqprSN5XPSgcWATgG-ftwOXMIUx0mQ&oe=6A491590"}, "display_name": "Boom Lift Safety and Operation ", "keywords": [], "long_description": "Boom lifts are heavy-duty vehicles that help workers reach heights up to 150 ft. safely and efficiently without the need for ladders or scaffolding. The lift's platform can accommodate multiple workers and carry heavy materials to great heights. Boom lifts are versatile machines that can be used both indoors and outdoors, even on uneven ground. They are essential for construction sites, factories, warehouses, and commercial buildings. \n\nBackground Primer & Activities: \nAn overview gives context, identifying lift types, parts, safety worries, tipping lines, fall protection needs, and walk-around inspection basics. Participants then sort-and-match to learn central controls and startup steps. Learning outcomes: remember, understand, apply.\n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn and practice safely operating a boom lift in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a thorough walk-around inspection of the lift. They must then navigate through the warehouse, collecting task items and repairing them at heights ranging from 45 to 65 feet. \n\nBenefits & Key Features: \n\u2022Manipulative Simulation: Hands-on practice in a risk-free environment. \n\u2022Instant Feedback to guide participants.\n\u2022Transferable skills can be directly applied to real-world scenarios. \nRealistic 3D tools, equipment, and environments. ", "short_description": "Boom lifts are heavy-duty vehicles that help workers reach heights up to 150 ft. safely and efficiently without the need for ladders or scaffolding. The lift's platform can accommodate multiple workers and carry heavy materials to great heights. Boom lifts are versatile machines that can be used both indoors and outdoors, even on uneven ground. They are essential for construction sites, factories, warehouses, and commercial buildings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_mode
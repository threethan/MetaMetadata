ale": "en_US", "screenshots": [{"file_name": "Boom Lift Safety and Operation_Screenshot_01_2560X1440.png", "id": "843830973843664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031481_843830977176997_3134700478605035792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2AFemCPLk4Q7kNvwGmzjov&_nc_oc=Adk7KuNv2WsJ4TLMl2T5cGeKNEqv7B7iXtPs1ncKmXfCs21NQ-gxm9R4Ubv-Yr2zwP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfueYRyHxc-UxL6V6KlwpYkj93Cj7kbUekIOpNrQOtP4_w&oe=699AE947"}, {"file_name": "Boom Lift Safety and Operation_Screenshot_02_2560X1440.png", "id": "785699576574591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035353_785699579907924_7786402068025568389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUPXbQgFkbQQ7kNvwG97-kF&_nc_oc=AdluGGP7LzeEmXul0mlMYZ1aqyPK1VtDJa57TzFAspqGptNmkEfIi6Gnz-07URD6fws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuTCwrnMD3eYjOlfXIanNjFm35BzAfxQ2deZDi-zLQisA&oe=699AF4BD"}, {"file_name": "Boom Lift Safety and Operation_Screenshot_03_2560X1440.png", "id": "1055972599102498", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203615_1055972602435831_3159382185849287131_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyVTpQ3rV0EQ7kNvwHk6VjY&_nc_oc=Adm-nv33DEa45zYHEPklVFQRtbQG7nYletc-R478VtxMs27JAQnBQplLJExKSUlMsgg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afud6qdaJkaWzH-UEypR2cy5p8VpRDZYO8yxDb4oBQE8ig&oe=699AE191"}, {"file_name": "Boom Lift Safety and Operation_Screenshot_04_2560X1440.png", "id": "807929337706824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375748_807929341040157_957096003013476505_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlp241CGEZYQ7kNvwHuTsQQ&_nc_oc=AdnAeDz4VIO3thRtXNcCX6w5shX2lKs5UN6mOBnbfDMbUZVOSheMdpdG4-4T4qfu-nE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJGIlBGCYbGoCO3bJX-anlnLluY3bpNaNVFLtW_tn-gw&oe=699B148E"}, {"file_name": "Boom Lift Safety and Operation_Screenshot_05_2560X1440.png", "id": "3555138181387216", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196221_3555138188053882_8378332905791165409_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKMIeGXH78gQ7kNvwHg7WYC&_nc_oc=AdlDGbCGbYAL-Ctn2uD6RdPtnpJNyoAm39tm7tfzHNoiz6CGYYrj2TQEvvQ2En0FV_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuptoW4PmUx2I1O4kwYOYYqKSdaWp7C2r6qZzKAA9ze7g&oe=699AE7AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Boom Lift Safety and Operation_Screenshot_04_2560X1440.png", "id": "1771221069973483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036676_1771221073306816_8991018096220753362_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07ENJ_0GE2EQ7kNvwGDYoJX&_nc_oc=AdkYArtLqw9IO2tYB_qNp-cASxVkSFgUDvSiinTcROQ9OXCFZoWiuog8t7LwvcN8uy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs5oZ-0BpFajWByriLPQlD--dLV7bixReCf-PM3iNfl4Q&oe=699B0F90"}, "display_name": "Boom Lift Safety and Operation ", "keywords": [], "long_description": "Boom lifts are heavy-duty vehicles that help workers reach heights up to 150 ft. safely and efficiently without the need for ladders or scaffolding. The lift's platform can accommodate multiple workers and carry heavy materials to great heights. Boom lifts are versatile machines that can be used both indoors and outdoors, even on uneven ground. They are essential for construction sites, factories, warehouses, and commercial buildings. \n\nBackground Primer & Activities: \nAn overview gives context, identifying lift types, parts, safety worries, tipping lines, fall protection needs, and walk-around inspection basics. Participants then sort-and-match to learn central controls and startup steps. Learning outcomes: remember, understand, apply.\n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn and practice safely operating a boom lift in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a thorough walk-around inspection of the lift. They must then navigate through the warehouse, collecting task items and repairing them at heights ranging from 45 to 65 feet. \n\nBenefits & Key Features: \n\u2022Manipulative Simulation: Hands-on practice in a risk-free environment. \n\u2022Instant Feedback to guide participants.\n\u2022Transferable skills can be directly applied to real-world scenarios. \nRealistic 3D tools, equipment, and environments. ", "short_description": "Boom lifts are heavy-duty vehicles that help workers reach heights up to 150 ft. safely and efficiently without the need for ladders or scaffolding. The lift's platform can accommodate multiple workers and carry heavy materials to great heights. Boom lifts are versatile machines that can be used both indoors and outdoors, even on uneven ground. They are essential for construction sites, factories, warehouses, and commercial buildings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "990501565490762"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffe
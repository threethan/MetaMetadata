culuscdn.com/v/t64.5771-25/75375748_807929341040157_957096003013476505_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnVunVwRDyAQ7kNvwHHH_ok&_nc_oc=AdoS8jjww_7Q7vp_cFO4LDBzmvuJeBcAWskmSYXH9waY9xnqaxR2rDLbWsWldDtIhDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3zAoR4zsEvXIgv3bdu-8u0VUTRwe3lVU_dgvx14Idqg&oe=6B0DC24E"}, {"file_name": "Boom Lift Safety and Operation_Screenshot_05_2560X1440.png", "id": "3555138181387216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196221_3555138188053882_8378332905791165409_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9V8KUsM-XwQ7kNvwH2o9zU&_nc_oc=AdpX-tMSu-DgTqtTozvNC4T0vplnlEEWveR8yGadjHL2hmSItgkjgvhf1LXymO_VMcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSaxx1Oq9fYcKWY0UK6r66EFJ53Cdc4D2TnglAxEQZcg&oe=6B0DCDAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Boom Lift Safety and Operation_Screenshot_04_2560X1440.png", "id": "1771221069973483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036676_1771221073306816_8991018096220753362_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxgd8s9Tr1oQ7kNvwEkc-Cj&_nc_oc=AdpqXBD_nLBswDJNSAbOGg5Nn40XqrmSWUdZd1O49kKAKFFfYRfcEjT4IlxJwKamwM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQR4DNkHLyaqxdqnlGLG2sFfPw8N_Yifv2gFVH8UtiPsQ&oe=6B0DBD50"}, "display_name": "Boom Lift Safety and Operation ", "keywords": [], "long_description": "Boom lifts are heavy-duty vehicles that help workers reach heights up to 150 ft. safely and efficiently without the need for ladders or scaffolding. The lift's platform can accommodate multiple workers and carry heavy materials to great heights. Boom lifts are versatile machines that can be used both indoors and outdoors, even on uneven ground. They are essential for construction sites, factories, warehouses, and commercial buildings. \n\nBackground Primer & Activities: \nAn overview gives context, identifying lift types, parts, safety worries, tipping lines, fall protection needs, and walk-around inspection basics. Participants then sort-and-match to learn central controls and startup steps. Learning outcomes: remember, understand, apply.\n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn and practice safely operating a boom lift in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a thorough walk-around inspection of the lift. They must then navigate through the warehouse, collecting task items and repairing them at heights ranging from 45 to 65 feet. \n\nBenefits & Key Features: \n\u2022Manipulative Simulation: Hands-on practice in a risk-free environment. \n\u2022Instant Feedback to guide participants.\n\u2022Transferable skills can be directly applied to real-world scenarios. \nRealistic 3D tools, equipment, and environments. ", "short_description": "Boom lifts are heavy-duty vehicles that help workers reach heights up to 150 ft. safely and efficiently without the need for ladders or scaffolding. The lift's platform can accommodate multiple workers and carry heavy materials to great heights. Boom lifts are versatile machines that can be used both indoors and outdoors, even on uneven ground. They are essential for construction sites, factories, warehouses, and commercial buildings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "RE
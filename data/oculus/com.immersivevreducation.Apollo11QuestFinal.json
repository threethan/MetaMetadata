": "2875107789237565", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974687_268583764097023_3325461124228317184_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi5t_-5tIecQ7kNvwF6uHtZ&_nc_oc=AdrQncoW6ZeLgrmrW-uHAsI3Ee-9nzuGW3al_hwAkKiG_d-Erj1tFtBaCd5HyfHMLdc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiRbQEk1ySmVnX-dwCm9i5HUAP7_1xGHeup8EAhggQIA&oe=6AFC85E0"}, {"file_name": "migrated_image.png", "id": "147395369896944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_319654398702089_6310404446522179584_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKyaqU0qSnkQ7kNvwEh9r24&_nc_oc=Adp_EQ3wWIWPYZFqdcfsoFlawRx3SOb6xXiiDKdWrg3pPkgKvIsv4L1zWHvc4WoNUaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX-pNklm6yBXU0kkzpZfxFCOBuWmV3BZb0To4YECXKFA&oe=6AFC7994"}, {"file_name": "migrated_image.png", "id": "160740215024528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974911_654696958298667_5728724402716016640_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcDwSlyJ9FUQ7kNvwGaQdXB&_nc_oc=Adqh3ftouUveFlSrNStJnVpail2uuwWR5iABE-CrA38Kj4UJlTUABhz1DkeNFhxLBpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFlhS6W6gwS8tasTt1zHFQVt13GBNo_1OcbNonWV51NQ&oe=6AFC61D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11", "keywords": ["Apollo11", "Space", "Simulation", "Flight", "Moon"], "long_description": "Apollo 11 is the story of the greatest journey ever taken by humankind. \n\nNow you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music, get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era. \n\nApollo 11 is a complete remake of the very popular Apollo 11 VR which was a launch title on the Oculus Rift. \n\nThis new version has all new assets, new textures, new animation, new lighting and revamped audio.", "short_description": "Apollo 11 is the story of the greatest journey ever taken by humankind. Apollo 11 is a complete remake of the very popular Apollo 11 VR which was a launch title on the Oculus Rift. This new version has all new assets, new textures, new animation, new lighting and revamped audio. Take one small step today and climb aboard Apollo 11 for the journey of a lifetime."}]}, "developer_name": "Immersive VR Education PLC", "developer_privacy_policy_url": "https://immersivevreducation.com/privacy-policy/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education PLC", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "237025298507313"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_294199208169902_3421954539559845888_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7
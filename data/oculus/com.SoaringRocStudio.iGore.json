4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziYz7zxKV3IQ7kNvwEJxLgR&_nc_oc=AdopGD5fzqf3NCNHPUpz6q5AjjIZ74XYQjDp6neqAIl-HcZuEpJ_K--dEpEZ5FPfLVM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbG_PYUyqVOe920UULJW23LglHg_Gnqh_IKU3s2OqdVQ&oe=6A971C85"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L7AXDKf0CsQ7kNvwF18Dp0&_nc_oc=Ado0YVOGC-gGFByvWKPtL5KSSJKHaKWUXzPz6azHs1Hz5a9-SNeY6oJEJ2raj3XyLjQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxgRUDhXtbi9cUQ_ISYMW6RtKTnRqjzO8xUyTCQ-tyzQ&oe=6A9748EC"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PpRyCGu5ZAQ7kNvwEbn_1F&_nc_oc=Adri_21GNw3bWP5yvkOdi0v0l1SYlaB1kzdrOZZ9mXiMQAvA_zVeQCzev4PR2l0MPDY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF1bjSwB0lbr81DhOBs3wnnu8xxWjFNQNNrId2wvC3iw&oe=6A9726F5"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUEgExcHIjIQ7kNvwFQUk4o&_nc_oc=Adpx9V-8cuvn970goiUnvmiVyICLJIYQgWD0qeXuLwBknnAoo73pCcbzlfzQrfFLEqE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG78LNPTRhiYrhCy2jr1W5l_UctRjk7CULnazcCbIYupA&oe=6A972C60"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZemhBcDKqjQQ7kNvwHEn10r&_nc_oc=Adq6RPmbtvKRbeyDfUpb6F3PC6SXvK07n2FWJzemLyTToFc4pVRded9vlbMPq2fmTIs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKuR6uxmoMBXSC-hk1W-RH9cXbkgoWCoLIksdXFCfZhw&oe=6A972866"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYvkkgfhnDsQ7kNvwE21Emf&_nc_oc=AdqHDY-fHDp4qxO2sqTGoA5584xLbTKoQ747RZ3f3kCdaksJ7IWtWAdOW7TsfSt-2-A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRT6-mKZgvLpUH6QOgy0ju-u6c23lhCMBDluxtLaPZbQ&oe=6A974FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oryxQsc40_wQ7kNvwFc1SEs&_nc_oc=AdqN_NnwbpLmXJEBpifvCXzIA-njxz0chnisLoYvhqerbF5YRRvu3YbYv8kku4ItQWk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp6kC16_yCGEmZUg18poEyi9QLf1FS0ikWEBloLxH4Mw&oe=6A97430D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DALgaNj8d6wQ7kNvwFQKSJF&_nc_oc=Adp0mgE9rfM_Q8UU7fRP3NJDnd-Mk9Mq3qbwai1rzaG-qsTWADb-csk5GOMsSDuesRw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGbrXq6Rg08Aaa-XK5LVkySZiFID07zQJxrQZDP03vzA&oe=6A97482A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
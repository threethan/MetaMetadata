4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auaS05GaX5AQ7kNvwEnCdJp&_nc_oc=Adr-7bc7nCBZKpR7QJpwnbPLMhCgWMpkIFMNp3hmMjBh7GnujY6_jQi5CNNAwRNlecw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW7SRqq-JO2qTj1VHyHH1zFKqSQ1CYkPYfkjuwZHHDcg&oe=6AF9C4C5"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKzPvcklpgsQ7kNvwHEs9Xl&_nc_oc=Adodtk6bA-7TzJVHLfJmNLZ6KOeXhROFLNYvOL_oLcV_fdcrTP2nTmXHF9Ri0nE04Ko&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNFzrbSRpeqjl7Ygu3U5bxmPmns7GxI98NfHQ_AH3YXw&oe=6AF9B8EC"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7uqEReW4dsQ7kNvwFEwpJl&_nc_oc=AdrOb5VGWcoZdhuB_FJ7mo1-t7KwHND8-pT-TfM8eC_jpAAyvUiy1r1FmuZEOMBUFYA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE93Ew5tyGirYEbr00iDs4wtmsEav9iSBZcEKpebrjiQ&oe=6AF9CF35"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmJyeCgISNEQ7kNvwG0Z3Tj&_nc_oc=AdrIC6PLjnHAalgVGZobGg0m1N63WhtJXGaLPQ7WjTG-6yyfXYGfZ7ZeK4mjyfQlvy8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE3ZLESQazRZMx8PcqdmoT15_ehB2qXIscD1fsF9Ouvg&oe=6AF9D4A0"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK8p3C1BsgQQ7kNvwGZjuEi&_nc_oc=Adp10PsUcSjJyOZYMVbOmB3g7wlxGOGnEr-dgkGQ3DndQa3jiItFHxOSmFQ7zTaKgno&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7_vx5evrwEYb8PgsEtaOSAzOTOkugUNwOYHLtjO1WKg&oe=6AF9D0A6"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL0LqKlUdnwQ7kNvwGoTdLq&_nc_oc=Adq7aZm39ot93S9zbPhmYVpgC-H-UfMVceEZ-6wZCt4bTwoNZ4TjF-SWY6UjCggYU_0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxfVajkLXS0fMK6b9UElx13VueRvmc79hx7-hxUYWrag&oe=6AF9BFCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RYU7Ne9LW0Q7kNvwEfH5Go&_nc_oc=AdrNQ3ZfNcaT3_q2uOfP290ECppwkJV1VjPabAJaXtSf6jGOMEqiEJU56uX92GJ3lVM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT281E0uVmAbmdIbSxwYfE3j85s2QWdR9ipT2_LdgW3zQ&oe=6AF9EB4D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MYT99XCMWcQ7kNvwH4t2F4&_nc_oc=AdraPh27-3JS2X1UEmtz_mTaGxqBD7WbsWy_9IZAn6C1yNsFSYrtbCMd8vEBsRb06f4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5vYAfzKbbeqXk6ZHsn0hMUVp6QKjoTVxwyLMErQ1qPg&oe=6AF9B82A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
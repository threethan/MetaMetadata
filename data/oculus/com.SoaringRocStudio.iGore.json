4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af_zRU2XsXEQ7kNvwFxRm8Z&_nc_oc=AdpabzSe0Sr8zr_hK4pv0M7_oFuaL4Pgwxrx-h_zkmX35CnT_42oq9hC6CyNQNGw_mw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPp181f8wjVTbADooLfdCcKuYm5DU4tg7J_ZTHTG2NdQ&oe=6ABD1FC5"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh0V7UnH0soQ7kNvwGzOssl&_nc_oc=AdqJmerwZQB9-GiARe_nLxxqFMH270SaML-kkZwADfzRhVA8FRzKZRfck97YP5_6nP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaQt03D96WwJnKGQsugn0cgYgn4HCAuhdf2cU-q7AXUg&oe=6ABD13EC"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zhnrh-D7qEAQ7kNvwFXMUN6&_nc_oc=AdofF8O3dC1EF3INsnkT9O1VE7eA96iBco8dNL-nOQxOEGHi92qBuQ4fMLcoEwU-pUg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXkiAEvpYrWdyjdIMm3hTuntYBfBrOYTvXXbu7WhQSSQ&oe=6ABD2A35"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7OaRmajrrQQ7kNvwEbnxFd&_nc_oc=AdpPFO9Q5EwSmvju0NPj3OKgWPCd2_IbTMGNdU9ucBZ6PIOWJS_n91_sVyrvo5_B8w4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6pZl0MR2oZFsF8K1kksPEhEKLaBB8c7Sf4ZbqvPHgAg&oe=6ABD2FA0"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bphUpjHDc8Q7kNvwHKu45A&_nc_oc=AdqxzWMxVrmLgjczmnq1vvq5tEmF0HWRMq_BSrPR7InUGlT4fs5XEeGfprjaiFIpRSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQxTuT9WV3EE3lNc14IGdihUPifLLjbMhAeJzo6b7jww&oe=6ABD2BA6"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyUWW36krt0Q7kNvwEnNV4P&_nc_oc=Adodd2eOzB2qYEVrk4_ebN4iV2H7v4cwQsQ66oPX74-jrevh0D1x2mojpNHkRDIYx4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzeAZq4dHwj6YlCV-SzH0oPcLMb_mhRxKokQMQQsMaRw&oe=6ABD1ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBpp_qyscm0Q7kNvwESFJ_d&_nc_oc=Adp0eZ05zJ0QKrybFmeem-VGiahFK0YoYVoNdIvofm51pDnmL1-Q3TEd1lJEiSwSTMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_cE_4y6TEvkJxhLeN2zf3ARf1FFs-DKCwH71uFZcCuw&oe=6ABD0E0D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTOccaWV6iMQ7kNvwEYYvWt&_nc_oc=Adr0Q34KQ4HQCVFezKZyGg0XnZxBjp7x6q2-aCKTB-wQSyVdjInWF-gJfFcSPOhl_m4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBut834DkzpAbI6wWXkhbxiG1cpbjZu_BAr4Qi8ct1QQ&oe=6ABD132A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
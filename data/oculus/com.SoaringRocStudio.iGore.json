4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsmCBFa8_yYQ7kNvwGStyQZ&_nc_oc=AdpOqdd283StqRGlqCwANaF_OjxfICLU6UXmU1g1V_4RZEtC5ggjF3BKEivBJCzK1gU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_1A4oyc161df9mYqymrcH2WHts9HWxW_GZDNT8UpI_Q&oe=6AE35B45"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82xDtMQMn9IQ7kNvwGV2K21&_nc_oc=AdoWfkAfEnrU7Xeaul5pTQApRbj3Ip4jg4sBfsly7fwzYMkR6AWgM1SNYD5s0C9wMO4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuI0a6O_bsljNvyeb-60ibqB-Pfo-lJjJfYXrahaEG4A&oe=6AE34F6C"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4olX6YOiwQQ7kNvwHb7yd3&_nc_oc=AdqstaM8Yq4mJh-YtLFoUrJrw5rCuF3qXBVM56Wsk1Zqoa4pftC62MRZQ2PC3HLMwAQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5TSueGgZHUqxo0Jw4O8Eu5kLOBlOmQ-JJQVHH4oX4-A&oe=6AE365B5"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tE4pO4FQBUcQ7kNvwFm6zkZ&_nc_oc=Adpg8_JRLkH-fe3gWS1l6beyFmey1C_U2rbsvAMRbD37H2EzzP1lRf9kr5j38MelCbE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAyS0023vzsr3JPmEhXxFrlrsWkzHDavCYILUCypeElA&oe=6AE36B20"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQi7FAIBJoQQ7kNvwER0j2l&_nc_oc=Adoonh8C8KfSmDcW75kIZJvPvbRLCmwFV7BvE-SlNAKwitUb35EaOmSoQ9xStlxVCFw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpNY643NGaHhKbcEQVHeVBdW439rsVzUsvWe7omp1bXg&oe=6AE36726"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZzf8TDK1ZEQ7kNvwHUlock&_nc_oc=AdptMI5w5L1nRdZobT_LdHz3hYfzWjNL6ALsjaqsxif4-cyYzDwRJi0d2jqbFWc_Bws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0TpKvNg_i2vzSEMhIZAc-27Hyn-cU52xCfw38ll5iFQ&oe=6AE3564F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QREsc77ZWuIQ7kNvwEoXjeE&_nc_oc=Adq_m-X5TRjmtHWE3Yx93l5u4w26V7-3yDomRy4ODy78rSewu0crS5dPM5AeePYjERY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuReCsQYZ8FFmvFPTF2Ewi9648beHlop_Q9XeFtvCAZw&oe=6AE3498D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8MWlHCt_cQQ7kNvwEgXC-D&_nc_oc=AdrWeGHZTYUtQHNoeg8p_Mc3Fs0JJDSAKeExxvxfZewpnnCNekctRRVfk1uL91pG13k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1AWqlCG9-Hs2aeW9yMD44k6WWcy8sRnGH1XsRLfP9fA&oe=6AE34EAA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
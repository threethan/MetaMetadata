m/v/t64.5771-25/499300575_1332368012133067_7552598107378778678_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs7aPVwb95YQ7kNvwF2FOJS&_nc_oc=AdqVB3Pf0xrJzt40yv8-7e-mLBu5NrONqbgRxjimaTzAQ5I680aBgfKLK_JnRCzXh_c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyR3CBJUa9Ha1Mh5vyqhsd7Qy1EJYuYr-HQQZ04D3b2Q&oe=6AFC8DCC"}, {"file_name": "ss3.png", "id": "1800448227583180", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499304764_1800448230916513_4072217733153786445_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40eJK-sfZjoQ7kNvwGsrGuE&_nc_oc=AdoLnR_qjf8uK4K_XWwx_HeRHiB5lRyr7NXDixoCrPewWZ8U4JiqAoc4CD2b0m1cndI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsETTGSfHElHAObtuqryF5CLfq0BpqTG3Dk3hwlX1bGQ&oe=6AFC7439"}, {"file_name": "ss2.png", "id": "995882359792394", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307931_995882363125727_7317693918217977930_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktryJdrmgc0Q7kNvwFwRKq6&_nc_oc=Adp8GhMoUtsvo2sE9fOAJQvqRCWW1TMMErT9XH_6VoyuoEMMy7p9VSEYinny-6QjLes&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKkR8X1_aF3xEZbhsOIMKAo-1WTT-QCXddvMbFx_8Wfw&oe=6AFC6EBC"}, {"file_name": "ss1.png", "id": "1653989859056894", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293690_1653989865723560_8570996415321479693_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuynVoYoL-AQ7kNvwEiE53z&_nc_oc=AdorRHSHL3MLhmBzUW0W4dvqebY0BeYu94fUUfgHKLeWlolFNlM_Dzwikr8RnystTEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZfESqxRHVpwzpt_GVgipTQQI4Tei2DFKqECVAmcToFw&oe=6AFC5F95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "976701284853688", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499293690_976701288187021_1850393074367308315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmXQeMg4OD4Q7kNvwEl6E5G&_nc_oc=AdqsC3lxOme2i3-iK2QrqEYz5WoTsloGsv45ta4Mqjw3vexMbi33e2ZDeg5mAZb8e6g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzBBH_PuaE6xjDRH2ZdJ_1lWitYomEmDWG3vW454V33Q&oe=6AFC90CE"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132
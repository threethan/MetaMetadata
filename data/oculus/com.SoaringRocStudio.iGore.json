4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e098epOY1lMQ7kNvwFApI6s&_nc_oc=AdpJ6lfq_r-ay2sLWpjg8oGwADTI2cZNZ5bBh0pfGxhVZK2MoDRZK9K-JmJ-KW_HgCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3zbxuSQvc4U7p-neRbGOBbBRaQL_6IFqsqYg5XOlppg&oe=6ACCF1C5"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhNKFY0DQzUQ7kNvwHevaXb&_nc_oc=Adr9YE8jzihDSDGNwAGgueUGm3V2uDUMa-0pb5AdbiKt7MGo7feZ57V8Hh5HNAIlOps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuHTbjwfnhGP9V-MxvzOXnlnaV8O3_U4DnawOyO1y1yw&oe=6ACCE5EC"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K0q-hS42msQ7kNvwFxBM-Q&_nc_oc=AdqD_AqbxEvE2rjVoP3b1_WDB8vCmLvgqFIRKK5mKbbJN9Y4dWmERIQUoflIqaOEy68&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG1MuFEl3wmWAXEsMhoQCCkyLbXEuavL_1yFMHYIQjSw&oe=6ACCFC35"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQK0VZlY_-EQ7kNvwEVFR2M&_nc_oc=AdrBsHcZVumQJ2JsTs40kGf-LNgam0CjA_iZJz3xdX59FLS9MgwyduZHMUDqV9hskzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrDP30ws18YbhHv9rpYEIWPjYyropUp3askDWwQ_VjSQ&oe=6ACD01A0"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh-6hOsc-BYQ7kNvwHm8-sv&_nc_oc=Adr34YVqtSzQL8Gz9RRTL6MbqKfQ1YJZUPFUPVVpRvohJ0B5nqFFS0DhV5k402tzkzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiM9mr9gTIZuXkUQvVHTP-jnKwtGxeafwrKWgkWOfJgQ&oe=6ACCFDA6"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_Szm0epDu0Q7kNvwEAF3qa&_nc_oc=Ado7qT-_LR3ARl2MDkXd7i2HzTCKDX5RlyqhCJEDq8d9zCkY-GKp2Yiar_2DAFPb0Pk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkt0tgRGTrcFX9DVUAR4yaTtj_71WZZuc17KTOEMHw6A&oe=6ACCECCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk7-XK2Tz8kQ7kNvwFu7a68&_nc_oc=Adq8yCYgPFHEKoi191mZc9r7rqtIKCyDduIQKSHHEbGcxmjVoGFVU-d0GwPmFYe-rnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWGIQ24VEqBbpK6M5lb2JTZgMWQ53CTyUwzYkGrJq1GA&oe=6ACD184D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T58ZKnoeN9MQ7kNvwHBttJ3&_nc_oc=AdrokIZIQcTuh8pNoGEaLW_nKOnvdT58vlke4LKM5bo4MPfAKwuSTlzTa9bAXOrxEP0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM8A9uA78oW9qM2RhWWdxUvFyl44JMuxnTL_mxeoE7jw&oe=6ACCE52A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
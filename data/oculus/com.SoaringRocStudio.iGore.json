m/v/t64.5771-25/499300575_1332368012133067_7552598107378778678_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrYuJM-hiacQ7kNvwEAFSGq&_nc_oc=AdqowArTKuD15Z18X_hHFjexOMa6XJp4nofDXOd7VmqM9aoxDbx5jkfkRZ9FRQCGQVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoa1Zhrd7KictmzCo40AiYIqGf3XO1W6eqPmwK5ejHpA&oe=6B0476CC"}, {"file_name": "ss3.png", "id": "1800448227583180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304764_1800448230916513_4072217733153786445_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWetNpix7n0Q7kNvwHFfKrX&_nc_oc=AdpGvCYaAKmYT8YojnKfqahawCaV5q7xysdPGaaOPdzN2WVS4gzOFPGBAjKF4YhI4C0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4LU1vI3cFpy0ryQclvM42gM2ADIfJZT-ebmqx6rwnYg&oe=6B045D39"}, {"file_name": "ss2.png", "id": "995882359792394", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307931_995882363125727_7317693918217977930_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N_R9Hx2l-EQ7kNvwG0DYV6&_nc_oc=AdorffGL_CStUVEeqfQUEouIvfx7g9Frpo2Xinbst2FIWWQrOqzndPRrgBOEYxc8lIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQOe5NwSmbGq1XsoF6zJp3HniHilxjPC4f03SEs6J3lg&oe=6B0457BC"}, {"file_name": "ss1.png", "id": "1653989859056894", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293690_1653989865723560_8570996415321479693_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs_SkOjwXscQ7kNvwFxrUrd&_nc_oc=AdqVaDN9-4MQnmkE-X9HX86hCDRQTS1BYHe1i1Tr3uPn66xkQ1iitl3ZUAMBF3s6Si4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyZLJq64gGKzCX6iH3NL56PAEQ5JmOn4kAQKiSPfVbrw&oe=6B0480D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "976701284853688", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293690_976701288187021_1850393074367308315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYDPhJy_dakQ7kNvwHmI06r&_nc_oc=Adr1Ukt5QGDjvdHcsHWAC4g9YEm_iVXw__3Y2OlhNR_sV7xdCOa1BPquo-pREbY9IRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKlQahlv1y52g5yp72l6KjAR17yL4j1OPv58uTuAVnqw&oe=6B0479CE"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132
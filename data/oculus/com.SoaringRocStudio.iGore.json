4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgWeTlw1T4gQ7kNvwFwuidH&_nc_oc=Adr91wwFjD1RD0tDYDdA1pQobmlBOq5Pd89FQku1a3JKOCDb2MV2xWt2wGdGzgdugAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFFJ3ckwDBW7HPy9Si9nGQ41KLi9WgYjwVm-nph6WDTg&oe=6AE9F2C5"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f2QfftF1PMQ7kNvwFwWKJI&_nc_oc=AdosbPDNx7Bz0PTks2WNpUZtrWhNW8PPoNOodOTnlD9jLKIgTP1kc3cNKnUKt3GyTYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5v2oBwR04NHDFFH6PfJnPK9AawjbeC6dtHWEFiNrVjw&oe=6AE9E6EC"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U95TC8diUNYQ7kNvwGApkhW&_nc_oc=AdpPPKCRmrtPsY0n0nkurswERwaLfyGk10T0Jy11Uqzf-iPPwfnCBzhMEL7aqkpHpBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw8zth0RqxjpWRoBXWbfGWsrXyccW5zTPP5_Blyyz36A&oe=6AE9FD35"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea-af5V7A8wQ7kNvwFBB6Jv&_nc_oc=Adp9KtvNppCLrYUw6SRd9EwQf4vtpmZOHGq4zZ0oY15e3PJowKfrXBoTyOZR51btUDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSPHK2JbcNGc0j_Dhjx8OenLqCYHJ-XtOygN_qJEkP1w&oe=6AEA02A0"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TolecHCpNRcQ7kNvwEipqan&_nc_oc=AdpH_ZU63duvqEJ8TGUMLERNUcFGFRxJSqzw_MB0v1_Y-HwTl6yVKyv916jIGvYtD7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLhEohSSSsMyGf-TvAutiV6pRJ12ZuPNeHlLB8m0h9jw&oe=6AE9FEA6"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNL4ehZUxT8Q7kNvwEdhvGp&_nc_oc=Ado95ptM6Ptm6zrYEZxvVNZYwgmuiUPUsRXUUpETn0a3Lms_OtgQ4mUWUCGmgv_2ZCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGRN79XPGJIFri1dCGfd7e4DwwjYTbsurpksKi73vnjw&oe=6AE9EDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xly3RPKP5sQ7kNvwFVxTlz&_nc_oc=Adr1gqz1tAXZvGLB05WWFuyBwAvcOu27j7bxghf40wVK2yI44KHo-R54TBqaqifr_YY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFvFcyHReXFGKbcIVvzYafdMWEWmaVMYbOYV6TSrbMfA&oe=6AE9E10D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHdLko-Ov6EQ7kNvwFJsflz&_nc_oc=AdqdqZ74n0ZykYV4JWJm0I1aWax3CR6hK6r6LrVZXO4sMBKTtOBVumNoia0CWDhRM_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTknr-QLpeZi-gTX7jo3kTwldz_h6swyqLpRMV82VsaFQ&oe=6AE9E62A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
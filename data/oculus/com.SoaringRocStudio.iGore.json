4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM1F-u_SPDMQ7kNvwFxiCfs&_nc_oc=AdqWdLtU6fATgcrQW1iz0YKVeJwfMe9VTmyZEmTLeqW8sk-NAxZaBkmvynVGpFlQTPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhk2-NkfifCTBEj4jcv9zpn4VQ_n66g9Ad-H73qupqXQ&oe=6AA2C1C5"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt1lP-9MLOoQ7kNvwHO1vsb&_nc_oc=AdpamuLeTvlU7K2x5HbnAcQESMXncaYrMgRZNF3_QV9zmcBLezOV10O71UjYOlpXrno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBLxqdGOL-7EmR3Pq5ZgPj7YsuJ4HYkVf0OZtnKQU9yw&oe=6AA2B5EC"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCS61cuqpVQQ7kNvwHCfhhp&_nc_oc=AdoZY1Vmr-nu4xsSb8zZqjE68xipSPcUTtRUHiSUfHHbchfmC8K5sfZr2RHhA_J_Xo4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5HmwnNgU2RfD4a1o8xT_h1YFIg_8lJ0Oh8hen4LQYGQ&oe=6AA2CC35"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPiHYEvK3ZgQ7kNvwFYLdi9&_nc_oc=AdoTXubZuPLqtMD9aA2yjz3i9hXudDCSYXGkQ_2vj5ZDhbuYqHkbByI_MxzQkRqSIqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5nUgwsxmkiY7YcxSmzXYk_N5COEB5AcNxz6nsjpG1QQ&oe=6AA2D1A0"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBXBpoipOF8Q7kNvwEgD_Hr&_nc_oc=AdrQxmQVdXtPc-6CsyZsW3bd4ANJYHyCAsKTKj933mGihcUpV2iEMLmV9QTK1XxUCdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlw5H-z-_ZibQPSYHr0D5GXaAcwykUdbmJFS88kV9Uww&oe=6AA2CDA6"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH8slFs3Sm4Q7kNvwFKtE7N&_nc_oc=Adq3eKBUpM8ZXdX8Py4yW-7V_ufST-8uoS_PMILnnkwvf99cL2yyYLorhsh64DREWSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHfLCHtyQi2dopbQVlIe6leOn6jQteoKCWt6K3k2nhIw&oe=6AA2BCCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hK5PRgSCPnoQ7kNvwHfRlCj&_nc_oc=AdpbpMuEQBAQuYYLLyb3W03lqdatskeGvXB-tiK6HtwHyre7RFLwFhSJWQZtKLgb0JY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJko3H-DiUMGw-vSyPFzAr_eZubpeuvzFIriv7_5OkLTA&oe=6AA2B00D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Tp8g543WGcQ7kNvwEA04AM&_nc_oc=AdoUiG0vahlLBAQKvv4lPWqgoSSvghY2dbXB_ChvLipTLlgP5-x-VxChjU57dRexsyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYrxtRScqQyoLgc_teHPaeX1f6t5prnlvnluxCRvO8IA&oe=6AA2B52A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
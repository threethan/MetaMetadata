5_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Pv0qJoE-0Q7kNvwHyXeTh&_nc_oc=Adqw5aPwpBoYeoZZV5MfGz8cFJ-blUkmo70M5BotU1Lr5fhxmOqc_A1G_g9v-E36FQk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4bi8kYmTLOVWoGn0SK3zwk1AaIaSPlW2qyBnOgM8XIQ&oe=6AF9D139"}, {"file_name": "ss2.png", "id": "995882359792394", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307931_995882363125727_7317693918217977930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktryJdrmgc0Q7kNvwFS7Wxn&_nc_oc=AdpmInSVfu6lLxF6jZ4KJ_odkFYR9VTxLt4jzpMGLuczAbpjIG3TE7MJCV3pJvnJ0wg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJXveAsV9oyF1n_HjQiowwllKQcT7ifScRGw7SsW635Q&oe=6AF9CBBC"}, {"file_name": "ss1.png", "id": "1653989859056894", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499293690_1653989865723560_8570996415321479693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwLxPrQBlAwQ7kNvwFTGLXz&_nc_oc=AdqXPqsS3z1-XziFKxKWY4DPb0XWXPQIP4ygLPrtPxwQcK7AAhQ3eujJANTk7fOzsvw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc0-gISvaNU16fMm_hSmkbP7oWwtSctHdMy6Q_kAFSsg&oe=6AF9BC95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "976701284853688", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499293690_976701288187021_1850393074367308315_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmXQeMg4OD4Q7kNvwHfxUZD&_nc_oc=AdrREDnz2-k1TmEgQBGtAZ_9Vau3A86JEse7b0JUVHqImQdjiOMrua0NfWF5qbl4RJw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI3p4ZlOHk-WeRM8HSHpnqERPuZWc7Atol5yMs_qKdvg&oe=6AF9EDCE"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26569891192683134"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1518582189924637"}]}, "baseline_offer": {"id": "
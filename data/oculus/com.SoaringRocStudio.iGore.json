4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTSbheztavsQ7kNvwHqnDRR&_nc_oc=AdrN6kThphDctWWj91ViGkJXwTj0FJKNO7SCz6EFBB0hxui8SW6xGa--RUK6YXP2dGM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPklU6hrm7EktG72cZQJyG78QZmESaSwkpE88K7R6BGng&oe=6AD38945"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n2ExLorvcIQ7kNvwEbVBC5&_nc_oc=AdpzE4K3C8yxym3boGnjk73OqSwEB4UA4dEhERFxG0wjNjh6rj28chOFq8rdF0-t2x8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiFlE7DBIp7IbHGcgIlneQlZ2zrmge3fgORWPMy3YT4w&oe=6AD3B5AC"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjGpi28JllEQ7kNvwHSIyOP&_nc_oc=AdpFt5lubN5hiyEL8ItGj85SlsPFrr9bgYdKG2PX8spRaO84VnIeP0qQHCEZ3UbIe0E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2d1YTJlPJO06bqdVYXuJV6e5-vMMgaAxOWxmt9HRqMg&oe=6AD393B5"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE5aM36aclsQ7kNvwE4ggxy&_nc_oc=AdqxoWe-k3TdRh0lmMc8asS_woP2xVliFBZZfFbMGvAoptIdOMB1XK6sd2LUw0o1dko&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeFi_jw4cASoxcNq5iOgnXJXmvpJf8myPDMbG2lTiNdA&oe=6AD39920"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVMCg3GIx3kQ7kNvwH6Lw28&_nc_oc=AdrPxrAstsmEYVW38XMQuXsNrRrIvF4ZmiU4XdPW-fKiSy6rB7McYNHtvhet3lfpQLs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiypGJFFw9nqX-NQKbAJYiubMSWEsGc5Hxv_3r_5SH7w&oe=6AD39526"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkaDOKnYEC8Q7kNvwEfwRlR&_nc_oc=AdrOld9jTE69qRlCihlHPoKlD-evWu9FmgdKbIOFohgB3NOrOKMyfxxBABS8xLhg8iA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLPNkDLo69lthf1bKxbUcQR9Td9GaGdMUHQxHmCBaxkg&oe=6AD3BC8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8hkH4umz7UQ7kNvwEez_qY&_nc_oc=Adrqe917KKssOocIY7o7uUOL6AyrWJxz5Seric1lA-12jSNUzSkxYBQ5gaNKQm66cPM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEY-izoaz3GVZei5f8myIRob_mAzVthjOX5-RP1nO6RA&oe=6AD3AFCD"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nSivotW2mYQ7kNvwFUyjw6&_nc_oc=Adq_b1_fsZQRHnIA3zNbYrNZo0by5mGO2yscrfEteF3QDgBqKFEy3znVXIMAsNQPbsA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwx47sX0TIGUDgzBb25KAWhOPwc-GdOx8ZU65pkJ7LbQ&oe=6AD3B4EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
e-mmqyGxxUE9CkTE5ScG23Xo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FT8LRST6C8RTRn6qYu3DN9aJK4oy7jWhoAlexx8_5zw&oe=6A1B03B9"}, {"file_name": "ss2.png", "id": "995882359792394", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307931_995882363125727_7317693918217977930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui1gqydOP2UQ7kNvwEXN7CF&_nc_oc=AdpiO8Z-XS_ESboZWgNuM9QoU2aXr08AEifw_4TigLpzKVOotdI5csPGGUMwLCA2zXY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hlQ6rqqYBhCe5ZGAv6u2FtkskeTwEdBrhL2WgSFIxSA&oe=6A1AFE3C"}, {"file_name": "ss1.png", "id": "1653989859056894", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499293690_1653989865723560_8570996415321479693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGehw6G2fJgQ7kNvwEO3g6v&_nc_oc=Adoj1D56rRIWZ99ynpDmnUEBrlVJxEUgnbQFfJBnw_CeXKy9m54rIWm2gQpohKxIPyA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62XIPK9hhQ6EFtGa_I5Lo2_3IR_aMItHyhV0nzkKQeRg&oe=6A1AEF15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "976701284853688", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499293690_976701288187021_1850393074367308315_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QHvfArJwp4Q7kNvwGS3sVG&_nc_oc=AdqU_nFNJMFLD7M2UYDFMIAY4RvQm6UplziQhNDuYgDA6F2lhDf3pOv9FL3CGKkDq-o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VKXCnFwQ2es7WR-cTxVBJtROFMjh414T3Ui5C6Xxp5w&oe=6A1AE80E"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26569891192683134"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1518582189924637"}]}, "baseline_offer": {"id": "1518582189924637"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778897340, "status": "PUBLISHED", "id": "15
tps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOOKPD7jzNoQ7kNvwGzCHIK&_nc_oc=AdpuZ4li8wIhIFZYuiiSdeCg42lQe8htCCus26W1lwfUeA96Y2srhXMwq6MpqIlJjn8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cMfeL4w1WdgYY6WSuL_usT6FBwgC7NcG4EhIHEbbY_g&oe=6A412DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=121lk6h7hOcQ7kNvwEp85fv&_nc_oc=AdohM8LLfPGzBBUT_rYKIaDqpL2h-UrPN2lyCkS9TsnhzRMOPF4wJJjMcbWJUKy-oP8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8llzEEeoyucKhE6FRPCt7-fmZOkKl_UNl6zvmLi2zJcQ&oe=6A41210D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbOP-YvqZhgQ7kNvwE8l041&_nc_oc=Adqh-mqPEVaEr-pgBHS7hvExc-SX6FLnjFgaXg62sZxqoGtohbunHP8RQBNHOBYQWpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GWUUDAtRvVCN6qXr2xQ5-zlPYVL6vyMpbpsKrmpxJCQ&oe=6A41262A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1778897340, "lastRevision": {"nodes
m/v/t64.5771-25/499300575_1332368012133067_7552598107378778678_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs7aPVwb95YQ7kNvwGN1i3z&_nc_oc=Adq0dqYQ62xJgCSM23xmlqmIlyzXddiXuXPOSuaG2YapVHGMikCWw8sK2BrqZk2TAME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0X2IFtg5ENaMvHS5wp-Bb3ao1vVZwIKHHAhTPUwEdJA&oe=6AFDDF4C"}, {"file_name": "ss3.png", "id": "1800448227583180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304764_1800448230916513_4072217733153786445_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40eJK-sfZjoQ7kNvwFjjMnS&_nc_oc=AdqMu3HPlf9Jrt85NnfRNYFWWlMQwhzuj63WI8H_USka8J1wr6JVluFTv-WO9ZYWlq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8ossx02P6U6_8A-nw0MxSrv_desDWio8KB20wtFrcjw&oe=6AFDC5B9"}, {"file_name": "ss2.png", "id": "995882359792394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307931_995882363125727_7317693918217977930_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_CDLEPtuHcQ7kNvwFdBphj&_nc_oc=Adpu6PU2XFng8yOhCj7gOK6UF3TGWa-HGe04M9Q1_AiulcODU10JXy-IAT85Zp2Lvzc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfjZX_FJEIyzDD7IZptScoT-9mcMNBx9zKfI2TWybE2g&oe=6AFDC03C"}, {"file_name": "ss1.png", "id": "1653989859056894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293690_1653989865723560_8570996415321479693_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuynVoYoL-AQ7kNvwEIJxgb&_nc_oc=AdoYyH-0x_u2-0xb6LjucnfJKMq1yvjzeIfH2K53GEr9u-KX2xtk1TTnxX3wS1o1HA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH3zIdQ-M65jyzIrfDS3nUbo3avjVQcS7QfMXhkZMhTg&oe=6AFDB115"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "976701284853688", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293690_976701288187021_1850393074367308315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr44_UXZ3T8Q7kNvwFP4IDe&_nc_oc=AdrOTtitsBH-d64WNrAFbtww7DXyE7doe0n071fU_BQ9Xkxkvbjz379jZ3mky3Seyl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmjoLRu1Bnu2YS9eALle6-INVeVApwBlgbQdbNhj8oeQ&oe=6AFDE24E"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132
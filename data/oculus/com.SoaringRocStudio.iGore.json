oh=00_AQGdi445SfVVb52TFexUG29M140wo8-DQzRUorYowaTloQ&oe=6A95D6E6"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vHu0ao_1WYQ7kNvwEkKqYC&_nc_oc=Adr3XutLdMiymC_kG45JfXbOO5vBekPZrcV7ooJ_QfMDJaGswGIRdBCZdvkflgHm0fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJYy7V42wp_djbkiPjZa0gMbSmm37oZH6FGaMpMgSC_w&oe=6A95C60F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oryxQsc40_wQ7kNvwHuLd6b&_nc_oc=Adp9-JK8JXXQpbGe8qNTzySGzlTNjCMnQwOByLyjClWFF3vM_eItwbiWzEILb2I_1SM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMPB2CxSZDCkliFB2nk6xjkMze9VpjXcJ8WRMAwDX9SA&oe=6A95B94D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DALgaNj8d6wQ7kNvwE8jKZP&_nc_oc=Adrpin7vLU8nR3Kl4ratOmo24vw-7rL_5-QZE8HGlXpv68MqgZjxZglWbFFGCJBFZiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBA5TVgJeG7KKus3Gs5P400E0tn23v0ufcWoEhf8vbCA&oe=6A95BE6A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
4_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgk2MIA1v4MQ7kNvwGI_3t9&_nc_oc=AdqUW01VBLPprlFyqFh4ja1jyA2tuppSo2szbc0GfLWsMsMgauM3BIqUNzGBH-kvrhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU7GooLHj_q1RnQk0oldrj3VNEb4osiq6abOZaDZ4m0g&oe=6AB293C5"}]}, "id": "971360209217047", "locale": "en_US", "screenshots": [{"file_name": "ss2.png", "id": "990631940046092", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_990631943379425_3731983253815702489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7Schd7HrroQ7kNvwGR0RX4&_nc_oc=AdrDFTl0KbXIUGlGfUAB3gR3QAHwUo2zKfX0F8t5-uTXVgQwIjSieOZLGwnahlPPubE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZDkNQGgTErqj_ScuJIcOSNXbMmWY61j9kNh0J5K6Taw&oe=6AB287EC"}, {"file_name": "ss3.png", "id": "1485683016669653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_1485683020002986_6714529994453357799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDiXaWS-OQ8Q7kNvwFQ83AU&_nc_oc=Adq3g_ZBK8YMZl8_2k5DfMCeG0uBMFJod6hEgubnROisOaT0H9Qr7l_Jh4zbqTyylaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-qEEJcKaMWmkajdxJazzIrwTuwJyMWG_4nkI5lr45ug&oe=6AB29E35"}, {"file_name": "ss4.png", "id": "1297173799147350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623443_1297173805814016_2812403187531409145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cSr558kGLwQ7kNvwED9r8y&_nc_oc=AdoEafyUQQ6Ptbl0aePz_GE-fQQ6hNTmMZn7wVdywrBv_fwyoq5aggyBLuZjkXvKb8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvYYSh7gclSxmKRduMRX9lJCeTAnTDyhsxw86ZsDFcew&oe=6AB2A3A0"}, {"file_name": "ss1.png", "id": "1529565055460969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673689288_1529565062127635_750951132849829612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlxX0FtwEFcQ7kNvwFnpMD4&_nc_oc=AdpEzZMaA6hw1fjtri5QKn7cfUjofTH_V0d0pgO6eQLldPJTr_iBcDoqHpHb56FdIJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLphnpC10-k4DIwUtMGOxzxC5mv3Pk5VZuzzvBXyfbcBw&oe=6AB29FA6"}, {"file_name": "ss5.png", "id": "1510912544033623", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624990_1510912547366956_4590106713295306962_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r4qUHi-JN0Q7kNvwEqbXdu&_nc_oc=Adqc_tuDYGaQ8FQua-06xS5TXSoYmUg2WWcEw64g_TSKB7AwD_Yfpigyf7HN85EInW0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBO7-7WLL3ESX6IHoyIC3RggojuswcDJ0RGvxNgfRocA&oe=6AB28ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "955766867311586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_955766870644919_7753763477596168253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oxp9XkFFXcQ7kNvwGfp7uc&_nc_oc=AdruO-npiahiaEewzxiTElwkRN61uffNt8ekkp1wWYP8sd7a2oQQkqC-U_wmA1AOrZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhSXrGH_EGlbU1xiYivBnQBB4_RsGtehJN59QTvKCEHw&oe=6AB2820D"}, "display_name": "iGore Lab Assistant", "keywords": ["ragdoll", "buddy", "gore", "physics", "sandbox"], "long_description": "You are iGore, a robotic lab assistant left in charge of The Good Doctor\u2019s latest creation : a strange, immortal humanoid with a surprisingly soft heart and a body held together by experimental science.\n\nGuide, repair, experiment on, and take care of a fully physical creature powered by advanced procedural anatomy and locomotion simulation. Watch him stumble, adapt, recover, and react dynamically to everything you do.\n\nPerform bizarre experiments, test his movement through interactive lab environments, replace damaged body parts, and discover how his anatomy affects the way he thinks, feels, and walks.\n\nJust try not to break him too badly.\n\nFeatures\n- Fully physical humanoid simulation with dynamic walking and balance\n- Interactive anatomy, damage, and repair systems\n- VR sandbox gameplay focused on experimentation and emergent behavior\n- Explore a strange sci-fi laboratory filled with tools, hazards, and tests\n- Surprisingly grounded biomechanics and locomotion simulation", "short_description": "Carry out the Doctor's twisted experiments on a layered, physics driven test subject"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631639779841608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_4296626153886558_1008635365467779584_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjeHwvVaKDsQ7kNvwFf-eXR&_nc_oc=Adq5fZQopQjeCFkkutfTqHeYXGnQjHOz7SUquHgTDPsxw4tPN3MCA2J66QlSgU-PjU0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMYXbBUEg99Pz5hL6IsIYc2_XhqKgKUY_MWPBLMODuEQ&oe=6AB2872A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iGore Lab Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "i
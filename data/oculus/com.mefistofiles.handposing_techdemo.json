_cl5MS6aLHfIavmi2JnsjpP4spxBB_w2B-8tEJ-wHPdEpwkh8rS-Ls&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oW8t_UpsUOW5jXqxDDkGWVDIJ7TZRqK3FVHdvPnvTBw&oe=6A1316F6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtpE1iCKDmkQ7kNvwFDUcWc&_nc_oc=Adrc4lzhGadls8ugYH_rxjUyeDVqJOqM_3qAEEuKPpdg-LO_tRvLoVlnqY0R85EMgDM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vFd-pQXxncSFyOR4_MzTWGDmgQ2JeFVIbtT_u00_nlQ&oe=6A12FF98"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrW6G_OSnP4Q7kNvwG4NLCJ&_nc_oc=Adp0grtK9f_Dzc2dxuKKI7BkVIkbEwLDRHHCCRAYn56XGV_iw7TXUSyGoQR_cbtBEQQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z9VgP0od9s5HwhSTTfPOH4-_Vv-e4jUdc1_W8NXxBkQ&oe=6A12FED9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXpXa8gCWEwQ7kNvwFtejMs&_nc_oc=Adoe4FuY5Nl5MNuqoEJbILRX4WMtxejo6XEFmF3SAm1iGNBuW9FluC7TgHLoA3eqEhs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af640gg0Fh2t1j25fiTAilgKyK4BCM4msWwQIudCFg-U9g&oe=6A13028F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8dDAfw1KrcQ7kNvwHvWDXl&_nc_oc=Adr6ppoQ_hSnXVmHtpY9JuEDs7PYXuygPa6_7EMfU0e4D4Oah7cZNEwZWOT53HNiYFM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tSgGU6pSeUF39WUnNjekYNJceWHFer6HHJooAKJJ7Nw&oe=6A130EAA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "UTILITY"], "has_in_app_
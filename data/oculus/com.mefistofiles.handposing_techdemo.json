_name": "screenshot2.png", "id": "203452318231939", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-Ygul42vRUQ7kNvwE05WdZ&_nc_oc=Adnio6hrgdPhKyPiDLv2kHJ8RTXgJ1pxdx_115eGVna8bYtBhRtTC5AFLNlgPrkpass&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBR7k6RPZZQInIU20unpM936KLWCzu0Ip08DlEs9ydBw&oe=69BFD036"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxDOMTY_h0EQ7kNvwHkHnGM&_nc_oc=Adl57BV06kYe5ti8YS0UxYRCXA69cLotDJXFPrC8TZ8A_QnO_IRIZwY-vIdM2Y1IJNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwZ-k3yLlMFvOnce7MrvlcFsqb4v5ewGggLKPrWNdJfw&oe=69BFF118"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myC-5U8ymNIQ7kNvwHEAqGS&_nc_oc=AdlN8jvIgDGd43xlgZkjfd-gCMU-qqkACgQDmArBFeIjMeoEnK7v1jtqncTicPpbFeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0qntxr9JMVWQ-MAUoIniTib9l-lKDDEPhFBHIKRb31Q&oe=69BFF059"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekuzpDIog3gQ7kNvwGcqyhS&_nc_oc=Adltw6YPvGK7ZYOElXEp8i3MGlIkLDKSkJ9YZK8lxc6aYwBtnlIRgx1ORWD4CDFKOuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN2EHhWJuQmR37yj88nrOkzNJ0QTLVdMWN37LQKk-gdw&oe=69BFF40F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpXhKUkjp6MQ7kNvwHj1XCV&_nc_oc=AdlJOCFATjBNmaYBCGlE_VpKawZaU2vuT2cQR2KGYKsl0ugobTOvOhqSfwGVQ8qqy4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW_fd2E6UP0rrMx66c_yQWAAkJ7xCx4CfuclkgyXak5Q&oe=69C0002A"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_ta
_name": "screenshot2.png", "id": "203452318231939", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uDLx1XPNVQQ7kNvwHElAff&_nc_oc=Adn_cqvzBkFXoRYtTvJ5zO6YzrqkmrWaIAOX46ISH6LrTX9nnVc0OSLk3ZSX_8qiQ1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNsxrvQNzNZX7dXHJFsEgmswSEnwMpj5AuydyVMsjY2w&oe=69B938B6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y06EbQxmxsQ7kNvwGPnxF9&_nc_oc=AdnauX3i2onPjgAEPIlaPUU9iruytPd2oD88slc95FXCqbivrrkzr8exLSr0QS093-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPTjfvkSUR4D48uKt7jFkMevu1rhSysJhaOaKwmblnDw&oe=69B95998"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mXJVqNdH_sQ7kNvwGF_SvU&_nc_oc=Adl6Qm4iD2waaNaxNZwDORJ09xQQeDgXWD97H215_LCAvnB7IHPtkK2UAr-YeQ78P5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQJq_O5UHKqeWeKd_jhXjq1KpG4vQ9HPTE4d2nwKg5Jg&oe=69B958D9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mt_U-k1YeIQ7kNvwFvv4mF&_nc_oc=Adlv8ycvw7v-P1p-cj3kldwFq_314EvjKtAFbAck9WrOtoWQS2biUdNZKF80d0FhCcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIrm17CTo8aMrzVeOYSlmG09H2Gze9aHZtBmHYzC_URA&oe=69B95C8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G00KzLfAUe8Q7kNvwGRHgfk&_nc_oc=AdkPzWV6kLfnT8LfJCpIBXmFMc9oRwq24yMLauIsTFVFqeHPIvqjPTvIhx0PdubJBuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU3p2lp2p0JMjDwCvsFzUmLnr1cCzd7t_LEsy8amO-2A&oe=69B9306A"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_ta
EyOJDTFky8xCFYTItuD79Budcni8glJeCxjwOs0r1eLqLhx8XyBWqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z4x5s24SNBKMXmBnZYwpKRxAPHsyufss73JoLr83Hrw&oe=6A2D74F6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUeuz_r2_8sQ7kNvwFBpDVQ&_nc_oc=AdpJeEFYDV0ikMWc6aQ2f_NZjDcnBeNkBu8NNqwBzTriDjQCBRJC2L0hlih3-SGAcjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86bTyTncx8KIJQWc8iKFc7hryFeQgSzbWWC-2lHK--Dw&oe=6A2D5D98"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctq-j4ADpKIQ7kNvwGqzKIK&_nc_oc=AdqMseVLT90j4Sp_j5VnQUOw5g5xCC6GITaN51ejkkfzSxSegKsZq6Xj7S8FiwUsSiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bqOq2GiOYgA7PAFDc3Uo4nBGyk-UgqKj9r2ig1rfRxQ&oe=6A2D5CD9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5dOqjiCRKQQ7kNvwH0FTn2&_nc_oc=AdqLK5KUG6In1vsjN72vtWVsdvp1TOEBQZr4Hs5TuzouOPoeVDOHnVz2SniFozGoTqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oaToikJp-wJ_40W7bpOLsXRINRU8N9AkTufKFF17ruw&oe=6A2D608F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJpuQFS-H5gQ7kNvwEPbgMS&_nc_oc=AdqmMO8-xsDvShNCOkMsuCEsNgVfwB2Md7aaNsaa993e3WjDVCEwUcKMCl28-c7Y9Ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SLSFlqjHzsR11_bJsJNt-D4YyEsADlSKa70HImlMBmw&oe=6A2D6CAA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "UTILITY"], "has_in_app_
tent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84de7_Y3MvgQ7kNvwGrKsjJ&_nc_oc=Adm4MvH8Br573nvMtMqs0Rcs32CHpswfSaECLP3Ol9yXaG04pKKOT30vp5vXq46W2Ks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuZjyUUqUIEfMsWivuNoazLFS_RqcCwLyroRJV1eHSofg&oe=699AE636"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uY-VSwfGKoQ7kNvwEzW5E9&_nc_oc=Adk2SzzVoBd6ThtPKkxQCO1x3x0m996yL64zON3KKwbzt6hccTBpQxr0GPIisI-PJHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftE0LDyGcGyeqpsVcwNzPkA2H46uzbNiu5OVUuCUcwrdg&oe=699B0718"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG56RPUF-mAQ7kNvwH4A6wG&_nc_oc=AdkvAdi8O4IgTkiXbLDCW4wspssGDjLZ7HfOW-Nu_G1iogrG3IKMF01pq5o4KcgWtOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs-ZigdVNN1sw5K9p27jzGX1g2a8_BmlCQ-u9MrDXztxQ&oe=699B0659"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GloeP0pm4vAQ7kNvwE3g91o&_nc_oc=AdnC6d9hHB5kLiiSguug3pK5NRkrcM3axzx5GuMO1dWObI8MuP8orPCx4yvY2-dfmtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuoKZe68zrF-AceygSuHagyTsodznBFNGD34m6X8qhc4g&oe=699B0A0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5i7K6p856CQQ7kNvwHTDqI-&_nc_oc=AdnXPXicY43L0x_Rk6V66qYeIKv-t2O2WxeOgYgd-RlYUELTKRFlrAhX70INCjkGJSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftgRdsHnpkPCfqIP50hjYYbleiRXuQaDhT5hZ-PbcpHxg&oe=699ADDEA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990
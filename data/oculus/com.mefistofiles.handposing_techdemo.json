/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUkmtUTeJvoQ7kNvwGlKhWy&_nc_oc=Adne8z9KbfSvbuGkjQmlXlieNyxLk2lQdYSUU0J-Vvi91P9LvbmA8yHRnIRtsLsq4UA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsoYckpP4hbJIEFs5-9vHZyCNafAk3xiJC73GBMxbdMGg&oe=69A04D18"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mORgVNabbZsQ7kNvwEJuRtd&_nc_oc=AdlkcH47txtucExO6C-9kiGM0T8to6i87sEiHoAmxEjTnRnyr-I0WaQvzZbMnTnHR2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsH8kvv0mwan_S075j3mIUsCFektLwnHXVkz9Fd2mHsAg&oe=69A04C59"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5-ChNyzFvoQ7kNvwEH6wJt&_nc_oc=AdklfgsTYFpopMQyIQr94lV5SL5fgLGEEttav0u2TwvML8EobF1-KQO9QIT1zRwTH1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfueXJ9Xiipv4EgC8j1sIAmUuUQKP8iSyIdNEFiCM3MLtw&oe=69A0500F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCZzBmD430sQ7kNvwEdiK64&_nc_oc=AdkLjr07mhgVCEEs2hmVPCZg0IlsKLGOLmrIVuwOvXcPBhR5X0pkpIeFG43xCW-UiVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfseFOOPBbbnXQJ8Xcx1E9PqBwXtYAuXU01ks4rfcDMlDQ&oe=69A05C2A"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_int
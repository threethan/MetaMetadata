_name": "screenshot2.png", "id": "203452318231939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2lAy6aKDDcQ7kNvwFIUn2d&_nc_oc=Adm5VOMXqOYoiQzx7QnbCoMFrm6bSASt9Mp1G149dlzmkR53CH3Q1sNp9LHUEwbR4vY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsr-dEaVJj4JqLeEsDZ6I3Dlq8yJHjMUeE62L1ypU7WCg&oe=69A81536"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZRCVYSxO4MQ7kNvwF7fj8b&_nc_oc=Admk1wF664tt8Lo2rEDEBqyxEBk7pqjIDFZbs-Llo3UuyLwTaheDSy31HHZL3Lr5XfE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsbq5blIpJGi83Up-hgayIxGIpRirnMtVRDp0G-6_ZTCg&oe=69A83618"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UONY7fiGaG0Q7kNvwFmGANX&_nc_oc=Adndsp_nWz2s-uHC76KmbpxC-iaDTO9vtZeSYXt0D3iWvAqlX5Ap0oiOZG3jH7meTI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuCEUBVrWjp3Swc_K95ZWI56OVXg4zbKiR38OKHFaiF5g&oe=69A83559"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5taC8kasb-UQ7kNvwEHEEcs&_nc_oc=AdmHfHrtafXYMQCCQcst6NglwTxfmm2GweR6aC6G3Eek4a_VLwLrljl3l1LqrD2UA6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu2JqrwRy2SRYdMjeW4DfJ4tMNE2_9eGhsR4UJ0NNFfyg&oe=69A8390F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx_kneEdYekQ7kNvwF8rzA7&_nc_oc=Adl0TvKWSbS0Z02w14bVAaliiQmZB5Vzp1OwulX2cOEfhMzH3lXXDaHIcy8HjMDxvlE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvuJGIfwP7QHsgCLyHlDlM07Zl1ZdIqjKkCZdGNyOULFw&oe=69A80CEA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_ta
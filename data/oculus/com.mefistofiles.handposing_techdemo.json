aVCBHh4t4hTn37Sr_P8eOkLpfjsdRkorFO9kBcmWwxR-XXL5lRltmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjVJi2wmUxwNN5OyerzHfHS5pcGs7LO_CU6YiZNid9mQ&oe=6AE606F6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fkm09BwW0EQ7kNvwHzyn8H&_nc_oc=AdryYrngKM4_xDczTfbiB_kVLTjmpte6liDTWMvLBB2eo0qW-EhVs5PxvIlzBS7n4gQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1FHkFHgNK1X0GNxFaczdCoGanztk_sbH2hIN6M8jK0A&oe=6AE5EF98"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ybqtsk5qmg4Q7kNvwH7XziA&_nc_oc=AdpyKCcqF152gDt60wgBWNS8pVGSzRNvHr6RJf0nr071BlfrGAGoXaD0Dj9LqdCCCj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXI_pDkDwde3FozDTwxr2-mz4y97Ia7pnC4oAHFjO9iA&oe=6AE5EED9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_LG4aynsFIQ7kNvwFkQ9qP&_nc_oc=Adpd8WeYCGxOx2czBKRhD64Y0_ZrkVLLFdO_C3sAX6on4g_pvMGg7aojHCJwYhR9Ql4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwhwxHMJWda6RWb9XBwJD04I0xmv0moGvlnS6_tsmOlw&oe=6AE5F28F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxgfBOUBxqMQ7kNvwE1rIPl&_nc_oc=Adq_pTrapozNq1C2fLfGouSqNYAXo-vXpGN_9DmIAx004TWPH4JmLxC9gs4LLvh05bA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkp43wgQqyqd-2YdrODytkZsS4yN4ol0d53FiHGXOU8A&oe=6AE5FEAA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "UTILITY"], "has_in_app_
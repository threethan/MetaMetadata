ulnN_UpwrA&oe=6A1ED188"}, {"file_name": "screenshot2.png", "id": "203452318231939", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_r73tDZRuUQ7kNvwEHO2BK&_nc_oc=AdoUfwg-yEbWmqgIWv-NddA651DCzlYmFw894RXG0EOn77JhXQnTWV9Wwv0zwRTA308&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A4zyl6Ts_4TMYWc8A2WyKgnCjsgawicW349bFtzkESg&oe=6A1EF476"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-p3GewlU3vYQ7kNvwFkRVdG&_nc_oc=Ado0sFYd8PYq6cphQwNZj3xtkRsS1YLGapcWj_k9iKywwUGTTGgfr9Q2rpKkG8aPuYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KV2yIyIshd2X3dFBIe3-U3wt4ZbkjB_0sWs0mx3l7nA&oe=6A1EDD18"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q-I4rAAtccQ7kNvwF_johz&_nc_oc=Adph8Otoip52uZYDV8ylYkb87AnKwe5dmY-99QYZ__AlAcCmW-byEV9lxk0PXTruntQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54eMQ7GLRhY7vkbI-HG0qkQ-KB8HqeR6usZMWQP77qSg&oe=6A1EDC59"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gGspP0KHzUQ7kNvwGa7Mci&_nc_oc=AdrhQgFsTcmyxlcNhnjrchSVj4ZxlZbKxGQgAMbtLeZ5XdlgAmtw-RCzsGOIry2F1hg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FMmrb-ZtZ7W5EmqVosNoVQQM1O_D-MLrTqbK5XOvkQg&oe=6A1EE00F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgBqYAPo3zkQ7kNvwF6lLPY&_nc_oc=Ado5gAfj8qqMAMg-hRaY4iMuTf7fCsZqs1d-mE1sUjBYiosNGjx7M17uw_aG5nbVK3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IzGrFeoJpANrDtg7mf_B-OPXXrmQAjB8dhP_wruhyOA&oe=6A1EEC2A"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category":
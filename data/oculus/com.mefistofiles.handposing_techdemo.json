_name": "screenshot2.png", "id": "203452318231939", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMXPVTAGNrcQ7kNvwFkTEyC&_nc_oc=AdlvbiDocmQE3rTk6Euw0RnMOZwqHCfwfuOUZcNBEJzQhmfx5MDyrcOct3bFQ1qA3JY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiuyAV8PyXSpE1m6RzBRj9n905kXvhp8WfAVCM79jS1g&oe=69B14FB6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=448tWGfZLLUQ7kNvwHvsKXb&_nc_oc=AdlUsjyfC8hmgioYu4X2sa33RQuQQCfEH26rGWW6Ao5CuOLdufjYY2pG-n2RYgyEceY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgJpSaoczN0kpQB_n90GrHBuJha5ZG0FVIYkKlCFJp0w&oe=69B17098"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08vyoZt9rQQQ7kNvwFTcr2k&_nc_oc=Adn_nxG9myxnnLyEO8MXsAbp1wy1d04affWRVYNfnvy5bJ4h6tteANhdg6u5o86u8Zo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9cXbBBSXN0fzh-PpD6-LCqXNbtIu9JVvPLO7RE9iw4g&oe=69B16FD9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM3lx7BfagkQ7kNvwFbzItg&_nc_oc=Admz9Et_T_8YtRywACleZQTOyj6soZr8mO1uTeIsdlRri6T_NqaNGyDyYX2pdp0v8A8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJ-nkRClllBcxTRh5HaK45sU_yFcwNO5eUDHKUzVgnxQ&oe=69B1738F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1FrP_f7iWAQ7kNvwFlA1xY&_nc_oc=Adn5Z01NbALJwGbDmeEwSFm8YbBfG7_cYEto-HPI8orECqNWC27tL6qU1rRTrk3DXUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyErR4gS4gUG6JrFxPWZTtmQEH7VfePc-97xndcgw2kqw&oe=69B1476A"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_ta
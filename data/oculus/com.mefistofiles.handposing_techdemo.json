_name": "screenshot2.png", "id": "203452318231939", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjLMsEh29hgQ7kNvwFd9BQ7&_nc_oc=AdlJN5RrzZl4vrZdlFNmwJZ37tgvy02Iws73Edr8CyX0_eeYSoX6tJqpCrsw746UunA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-Zu640nNmI40qLWjLScq_YYnGfut9a6RiQkZcaghlQA&oe=69BBDBB6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWqkunKR3eIQ7kNvwGBL7TP&_nc_oc=AdnZKssXig3N0dQMAWte3W74jmVKP1mxsBCBXmAzQA_TOa5mB0dwAFVFx96ZREe207E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwMftqe77qe8f9EMWY-196cvbz0M_7B6kLWNy4ua9rI8A&oe=69BBFC98"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mXJVqNdH_sQ7kNvwFFc5CQ&_nc_oc=Adlmwa9_1abKMqjLvph7pLaexdFQuOljCwDm0IQTgkE4QpnGPWeM7OVG6U5CO7s3iIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6GW_WiydVT14ku2XAKx2fXfGGFkM-gjddUa-VromCbw&oe=69BBFBD9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbAfuLo0rE0Q7kNvwEK3nCZ&_nc_oc=Adkfxx67KjHE6rj_J9cMw-FmjbGcveyPOTqf12GnLQQi7Kjxp5ygl-xurIxHjRCmNs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxI9QxtqADJAn9JYZURWsEizNUk61kL8SG-LEZ-ILeSXQ&oe=69BBFF8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hPlzIcjzTkQ7kNvwEQyDsa&_nc_oc=Adlw0KCK9MJKa36cyLWZ9MgLV1jxKEGWm3BlVy7DAr6pe4Vgw3-4TakjRhnpr9UJsGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afygxfl8P52Ujg3GIlYylVuHdPyEhxLuytLKi3zk0oceYg&oe=69BC0BAA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_ta
I5Dr5usa0ep4FJ1pzQdFCKMh-tWogw-LWfjB4JckK3Q7sAG8VKlhdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRvAegFppzh8I4bvI4eeJuBcNTASzaAvZW3DVEQ_seFg&oe=6AF5D8F6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwQPlXpasSEQ7kNvwEt3Uh0&_nc_oc=Adrl3obyaL0xVPM0aob3VqZxXP7gy8UNcO5kCeCJNte27q9BC9IZa1_ftNHM22nuQcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7F2s9t9oJDPt62MGTqlXMw1fdYrgoUQXEXZjTOs4enQ&oe=6AF5C198"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-smv1nwH5kQQ7kNvwHsmaos&_nc_oc=AdogJYnTOss0T1GwOzCxVsaJRPEWo1VpTpdpAJOQv2D05Ye2iaB6ZIIcKI8DoI4zOHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfWCs3kDT289f3FvmDtTjXE3JaROjnySwauYL3efWq7A&oe=6AF5C0D9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6OTvIPxkWcQ7kNvwHj3SK1&_nc_oc=Adpg5-2XYK2tTcf0VqlBro8fSTXbFOMCw0qNyxm_u-5pNmne6N9taYJHMr_xBkzEg9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDkpUp7Qw8oo0py__pV103ICHyV9X0CDW7j1_bYySAew&oe=6AF5C48F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQTYWhZte4cQ7kNvwEgOsJi&_nc_oc=Adps9FvdMOxPU1zTvgqKMWNP2b4J_H30wuMxVuLAqi-8tCXVgHXSigbMm31eFdNQI9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKq8mZztt-eLRa5HwZrt4rw1_LMya2yf9w07OgqKGOlw&oe=6AF5D0AA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "UTILITY"], "has_in_app_
dzV4X7_o1heH2Q4y-JgFXWaeDbU6--0mTgFKaVbfdIR13RSdlasPlA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a6HtNtjDqODcyAQsSp-rJ3BhNVD3SSP5TGi94MX7D3A&oe=69DE22B6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLkswwrxihcQ7kNvwEO8U7G&_nc_oc=Ado0vTmqPNeA1dst1h4cO16UF53s5Wq_CZHVRkoCXTLLL8Wrp1ofPGhBHAbnBEqze5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ek8cs_YB48OUqCBtBXKmHf5KCKgoIYsQG3Md69VEe0A&oe=69DE4398"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dynFqfrzIG4Q7kNvwGCvivL&_nc_oc=Adp2RnrmYJR4nM9r0Pg1MPAI7vrCnMiawQq34RI29J8Vp8e07N7zVeR-RyVawJaqL7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38LHgKsItIDZ37njj9B0PGHzJ_I45QFFKJdR3pYe2J_g&oe=69DE42D9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC257_x2zFMQ7kNvwE5R7p-&_nc_oc=Adp8i21GlCV2_3dJrLPjO4tv8BfCQNIwxF0vva-0PigJUeCq1ao_Akmfkv6NYqtOxE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iBAgwUwKxsMDGQYY3NwW6B5zzuKOYdc8HiJYGt5mOcw&oe=69DE468F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gLJY5knXYAQ7kNvwFvbxyn&_nc_oc=AdrUuPhVgA1SohWjKUlm5V4ocbQwaQKt2FMkF8K7UiyQtHfyHJBThFyc7MxUu_OuD5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04kJSFgevccGmZlcQXUXz-tiPp_L13QudZCKQtTeU1QQ&oe=69DE52AA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "UTILITY"], "has_in_app_
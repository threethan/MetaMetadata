PT_G1NqVm3NmeTYfd-aML1llSCcRP9_fqmRLP9vprNFnYj_wl2nENQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hfe958aL7P7ybHUvdvB7a5l5lC6hiY0uH2mNSn1JCyg&oe=6A3BF576"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I12UZ0cFUQEQ7kNvwFx1PiJ&_nc_oc=AdqPP9I10cVTmwvs_k3sX2NUYYFWxwHFxnusPHqtYIvrzTKl3s2QQY9jyVMTpsHkpjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mdijWHPG3OEKhOuKQhPzZ2mTk6ICR__GxAMZgzobb2A&oe=6A3BDE18"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu3MRj3umWoQ7kNvwG-jJmv&_nc_oc=Adq8jiG0TFD01XMdc6jNGvW7fnfahpzzrc2eKvfJCC1WGuxm5coSXx4yVAegXYCjE5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JAWSVXFUZkZveYHqZr7xAYb_LLQqdPWqMZFyvWtdD7g&oe=6A3BDD59"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3xrBBMCKeoQ7kNvwGCEVyw&_nc_oc=AdpJ0FmLHhwqu2AoYxZDED3NCZqbtGV80baYlqh48LvtDOhuCA8JgEhc3LI3LSO0oKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ep2bCFMuFgJWScExIZjAehAZH5rxQUkzNa7MFGss3LA&oe=6A3BE10F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0ACo7VicSMQ7kNvwHwwsKy&_nc_oc=Adqd3Q3LGx0bLQV_OZMuR9K-2fiUoyXsKEgrvA-pwqFGh58IQZvLUzsa2Gzs4LcDxpc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iv2ZRwsYPOIhB8vxrP6hASwtXYL8R_YTEE4Np5bg7kg&oe=6A3BED2A"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "UTILITY"], "has_in_app_
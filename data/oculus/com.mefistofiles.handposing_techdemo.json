_name": "screenshot2.png", "id": "203452318231939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMXPVTAGNrcQ7kNvwHWsMNb&_nc_oc=Adke2IfBm46ADC2G_pbp8FaR8N60mj0GZ3T_X6LOSdOj0yzC-QmzmSE4gxytqgLF2eU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEBIFa0ZIVA6M4CgmySgUExg7XKln_lysm2V8_TJTzEQ&oe=69AEACB6"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7reQcTyFjJUQ7kNvwFp-jOk&_nc_oc=AdmtJYSRDo1S9fqp6ONLCzEjZL9Fbz4xgWN9Sr6WGDWQ0azPiDRbx9Js0-LLBrZCZJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuAxwet9grubq3YoDy1Jvf8g_KbtTVqP-rsNVaXhIb6A&oe=69AECD98"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__3LWgICG-YQ7kNvwF1LjN3&_nc_oc=AdkpLadxpNkkZYjtjjqM7s7m14z6-lwNFcgRt_xDHo9lfYHgQmj2lKSp6HLIoYsz2FA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwtv7gBvF4_oRy_RtxpO2mm4DMABRtjy1wg0IBnETlSfA&oe=69AECCD9"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM3lx7BfagkQ7kNvwHChvkD&_nc_oc=AdknuuscqgjAGIvtWeUzgExr2mJCUTQnRxShJw4j03aW0E5q7U4fA9yCO8ZQUsPMdMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz49c4EAE_nvcV76Cq_M6VeczSwcRXJrQ_U9btE6z9YtA&oe=69AED08F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIcmbCGUGfcQ7kNvwGJxLve&_nc_oc=Admb6k3P7JV9RsFvRC9XPD2Xn94CQ1X4_2B9TzCoj8VgvI_ZJxUI6WynLi9nO5NURgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBSJercFRcHDfaF3fCE-bx24vg1BHS9ArmsDbUUaNQng&oe=69AEA46A"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_ta
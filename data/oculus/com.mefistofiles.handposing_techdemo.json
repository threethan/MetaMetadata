_name": "screenshot2.png", "id": "203452318231939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_203452321565272_7347886069464974400_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho7Ttv7WTbEQ7kNvwGmpA5z&_nc_oc=AdlfY5pgO105NuJ9yd6V-UCkhaZmiTeN3SlcA7oZ4TrgmP0JWrS0tktsvyAFg3-_vRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybAV4SIbIfbSffOMV06StVuv5--sjGJ0qhed9bFvrPYA&oe=69AD5B36"}, {"file_name": "screenshot3.png", "id": "478524209983030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974547_478524213316363_1989849985391818017_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7reQcTyFjJUQ7kNvwGWHFqW&_nc_oc=AdklytoAqhUxqvcpEmSLSrWib--5C6oGydrR0z8MmiJLr4Be3sT0qv3ZU-wCo8oKHHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afza72X_QHewZueGPxYk6UYSLjmvylWuI_ELVTsBjAeJPQ&oe=69AD7C18"}, {"file_name": "screenshot4.png", "id": "283250356523121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_283250359856454_2921559541139155323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__3LWgICG-YQ7kNvwHPiGxj&_nc_oc=AdnILnAU1bvsbcsPNUYTnJ0oF-BLIo7Qm_d-JH6gPK0521tL0ZR8QmQhOgRwJ4EDvHk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLXLsVB9LQZU6HPszsoQakqCfmoAianUpqMV5TH5trbA&oe=69AD7B59"}, {"file_name": "screenshot5.png", "id": "245135363995272", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_245135367328605_4296663532035826671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDOSXdOeIzIQ7kNvwE06uup&_nc_oc=AdmtyeT00LUGYoS71t7VuE5oIafmonXKyCD-tetxrUUgUUEZ_l1e8yP37EbxDwQi3Rk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzZ0kVovuWQiiyeaHQwlPKaOyPS3O8U1dqEpFcmUn1Hw&oe=69AD7F0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot3.png", "id": "179993550326299", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_179993556992965_8693053316888867930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIcmbCGUGfcQ7kNvwHiesQT&_nc_oc=AdkN4IQRqLPwKJRj_PEhn4lEcz2VXXpQg_odQPp3XoLNPFb_cWZDh_GZZrU3K4LAHzU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwyCw5_7XQpEcVUcADofIT8Rteg7FLvvbw0Z2VW2Ut4Q&oe=69AD52EA"}, "display_name": "Hand Posing Tool: Pirates!", "keywords": [], "long_description": "This is a tech demo for: https://github.com/MephestoKhaan/HandPosing an Open-Source tool that allows to quickly author hand poses for grabbing objects in a realistic and solid way. Works with controllers and hand tracking.\n\nDownload the Unity project: https://github.com/MephestoKhaan/HandPosing_Demo\n\nThis demo is intended to become not just a collection of real-use examples for the tool, but a feedback and testing base from which to gather feedback and grow, creating a more useful tool for everyone.\n\nGet on board and grab all the different objects in this pirate ship to learn about the possibilities of the tool while having some fun, then get the Unity package and add quality grabs to your own project!\n\nFAQ:\n\n-Currently only smooth locomotion is supported with the controllers. You can experience the demo in room-scale.\n-The project is in active development! We hope to bring many improvements over the next months.\n-This project uses anonymous analytics regarding grabbing interactions.  ", "short_description": "Come aboard the pirate ship!\n\nThis is a hand-tracking experience that puts our open-source tool to full use. So come and explore our ship, fire the cannon, reveal its secrets using your hands... and when you are ready download the entire Unity project to learn about the nuts and bolts!!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mefistofiles.com/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MefistoFiles", "support_website_url": "https://github.com/MephestoKhaan/HandPosing_Demo/issues", "website_url": "http://mefistofiles.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_ta
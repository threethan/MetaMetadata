6iLBWkidvG8snYaM0Bkg&oe=69C93799"}, {"file_name": "Screenshot_com.vreximmersive.neuropilotvr_2023.05.03-05.03.52.png", "id": "691595909402376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572750_691595912735709_528798436949234517_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mPVJYtsbFYQ7kNvwFwoP5O&_nc_oc=AdrF6FhxBz3wsjkEothvH3tGZtAaXTVoV_j3L4nPV5vyqY14dhrqA9XL6GFxsmDvAC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxK694kayw_Jy5uSS5j4kysRkc5MMmF6UC4V3Wtxc08Q&oe=69C92A75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NEUROPILOT", "keywords": [], "long_description": "Step into a new way of recharging your mind. Neuropilot VR offers short, guided VR experiences that help athletes and high performers release stress, regain focus, and build mental resilience.\n\nEach 5-minute session combines calming visuals with immersive audio to create a quick reset for your mindset. Users can schedule sessions through the companion mobile app and experience them directly on their VR headset.\n\nWhether you\u2019re preparing for competition, managing daily stress, or just looking for a mental recharge, Neuropilot VR provides an accessible tool for performance and well-being.\n\nSessions can be set up in sports clubs, teams, or personal training spaces, making it easy to integrate wellness into high-performance routines.", "short_description": "Immersive 5-minute VR sessions designed for athletes and high performers. Reset your mind, release stress, and get back into the zone with guided immersive experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.neuropilot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
oC2jIPfsMD9H1r44vsj2NcNx4k6g&oe=6AAE9C99"}, {"file_name": "Screenshot_com.vreximmersive.neuropilotvr_2023.05.03-05.03.52.png", "id": "691595909402376", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75572750_691595912735709_528798436949234517_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N0dNTDfrN0Q7kNvwEJY7xN&_nc_oc=Adpt7VgHdhNYBy7r25Odd4-zAOzgtHL7NVM3psrBrOW0ifBQX9ILJMHgPXa-V5OQaQ8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIixGhcX9EGq3kvV_KmeG2n-VoAo5_9ZP88g4ELgRdE_A&oe=6AAE8F75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NEUROPILOT", "keywords": [], "long_description": "Step into a new way of recharging your mind. Neuropilot VR offers short, guided VR experiences that help athletes and high performers release stress, regain focus, and build mental resilience.\n\nEach 5-minute session combines calming visuals with immersive audio to create a quick reset for your mindset. Users can schedule sessions through the companion mobile app and experience them directly on their VR headset.\n\nWhether you\u2019re preparing for competition, managing daily stress, or just looking for a mental recharge, Neuropilot VR provides an accessible tool for performance and well-being.\n\nSessions can be set up in sports clubs, teams, or personal training spaces, making it easy to integrate wellness into high-performance routines.", "short_description": "Immersive 5-minute VR sessions designed for athletes and high performers. Reset your mind, release stress, and get back into the zone with guided immersive experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.neuropilot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_catego
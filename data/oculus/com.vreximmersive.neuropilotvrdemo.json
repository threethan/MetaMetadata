DR91rICRQRs24cgHe0NA&oe=69E24419"}, {"file_name": "Screenshot_com.vreximmersive.neuropilotvr_2023.05.03-05.03.52.png", "id": "691595909402376", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75572750_691595912735709_528798436949234517_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QP8WRxTfsTQQ7kNvwGetzXH&_nc_oc=AdpSPVcPFHMNmTHeMobThFtwUdX9xtB7LDxFq4tsnJ2w-6Chw3eBv3TtiB5Nx-Ez9cg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LsTF8IV8_3ITEOu1GR-X66NWBQZUp2UOVIkJgxbjA6w&oe=69E236F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NEUROPILOT", "keywords": [], "long_description": "Step into a new way of recharging your mind. Neuropilot VR offers short, guided VR experiences that help athletes and high performers release stress, regain focus, and build mental resilience.\n\nEach 5-minute session combines calming visuals with immersive audio to create a quick reset for your mindset. Users can schedule sessions through the companion mobile app and experience them directly on their VR headset.\n\nWhether you\u2019re preparing for competition, managing daily stress, or just looking for a mental recharge, Neuropilot VR provides an accessible tool for performance and well-being.\n\nSessions can be set up in sports clubs, teams, or personal training spaces, making it easy to integrate wellness into high-performance routines.", "short_description": "Immersive 5-minute VR sessions designed for athletes and high performers. Reset your mind, release stress, and get back into the zone with guided immersive experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.neuropilot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
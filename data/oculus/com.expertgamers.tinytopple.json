 "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499627527_1589774689580068_2499362924672558528_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykrvzUCELB0Q7kNvwHRWziq&_nc_oc=AdpTNwgZwdw2QbBzVcm1ACDBHT78hnEQIWEM31LF6dtTAveXtzE_vAInUjSC9mI_nj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLjiAGqXAKN6JhYNp_nZNo7XQtkZx5E-dfQ_aGtoAFSg&oe=6B0C68A4"}, "display_name": "TinnyTopple", "keywords": ["MixedReality", "tabletop", "slingshot", "puzzle", "casual"], "long_description": "Transform your living room table into a vibrant, chaotic toy kingdom!\n\nTiny Topple is a physics-based destruction puzzle game built from the ground up for Mixed Reality on Meta Quest. Using intuitive natural hand interactions and precise slingshot controls, launch an arsenal of specialized balls to smash through fortified block towers, trigger explosive chain reactions, and topple targets perched on floating islands right in front of you.\n\nKEY FEATURES:\n\nTRUE MIXED REALITY PASSTHROUGH\nPlay seamlessly in your own physical space. Place, resize, and rotate your floating play table anywhere in your room with intuitive hand controls.\n\nSATISFYING PHYSICS DESTRUCTION\nShatter brittle glass cubes, shatter solid timber beams, and blast heavy iron fortifications. Every structure responds dynamically to realistic mass, velocity, and gravity.\n\nSPECIALIZED ARSENAL\nMaster unique ball types with distinctive properties:\n  - Rubber Ball: High-velocity standard impact with ricochet bounce.\n  - Bomb Ball: High-explosive payload detonating on contact to wipe out clusters.\n  - Iron Ball: Heavy-duty wrecking sphere designed to punch through dense armor.\n  - Bouncy Ball: High-elasticity chaos ball for hitting hidden targets around corners.\n\n20 HAND-CRAFTED CAMPAIGN LEVELS\nProgress through whimsical themed worlds with escalating puzzle mechanics: from bobbing icebergs and cloud sanctuaries to sliding sky platforms and explosive domino pyramids.", "short_description": "Turn your room into a playful toy battlefield! Slingshot physics balls, topple miniature block castles, and smash targets on floating islands in MR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdullah-arif-portfolio-alpha.vercel.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Abdullah Arif", "support_website_url": null, "website_url": "https://abdullah-arif-portfolio-alpha.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1960293478721785"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1805037620771237"}]}, "baseline_offer": {"id": "1805037620771237"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795025820, "status": "PUBLISHED", "id": "1805037620771237"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1962621428488990", "version": "1.0.0"}, "id": "2517188915432797", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1960293468721786", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", 
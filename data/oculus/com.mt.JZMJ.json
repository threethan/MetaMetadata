c_oc=AdpK4ZgcVWG-8xli5-0avlYv64yjIJQaeP27l5wcV5FxAaVz6g6OaXrrWaJxObagyJA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBoal-Nf832Gz-gidoeTFPsBXj2CAwaT1MlsixWsMQyA&oe=6A5B6A3D"}, {"file_name": "04.png", "id": "1355655656484222", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619680_1355655659817555_6164939190172213635_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py5dm0gNfEsQ7kNvwFi4Me0&_nc_oc=Ado--Ac7yKZs1OqdIDsqcLJT8qJLbxbCAPrhFfJntajbHXI4jagxG1WwiEB3aBqloug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiITfi9fqF7_29LaRyFF3IJaFLzkuausQtTyB9nz2QWA&oe=6A5B74FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dreamscape VR: Hidden China", "keywords": ["Travel", "Nature", "Explore", "Relaxation", "Meditation"], "long_description": "Leave the noise of everyday life behind and embark on a dreamlike aerial journey through some of China\u2019s most extraordinary and rarely seen landscapes.\nAboard the mythical Sky Lantern, you will drift effortlessly between earth and sky, floating above golden deserts, sacred lakes, snow-covered peaks, endless grasslands, and surreal natural wonders shaped over thousands of years.\nMore than a travel experience, Hidden China is a cinematic journey designed for moments of wonder, stillness, and discovery. Through immersive first-person flight, breathtaking stereoscopic cinematography, and spatial audio, the boundaries between observation and presence begin to disappear. You are no longer watching distant landscapes\u2014you are moving through them.\nGlide across the vast dunes of Dunhuang as the desert stretches endlessly toward the horizon. Float above mirror-like alpine lakes hidden among the clouds. Soar over snow-capped mountains, winding rivers, and remote wilderness rarely experienced from such extraordinary perspectives.\nCreated exclusively for immersive VR, Hidden China combines ultra-high-resolution 360\u00b0 imagery, cinematic storytelling, and atmospheric sound design to create a deeply relaxing and visually spectacular journey. Whether you seek a moment of calm, a brief escape from daily life, or the simple joy of discovering places beyond the ordinary, every flight invites you to slow down, breathe deeply, and rediscover a sense of wonder.", "short_description": "Float above deserts, sacred lakes, snow mountains, and forgotten realms in this cinematic 8K immersive VR flying experience inspired by the hidden wonders of the East."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gisocn.com/sys-nd/61.html", "developer_terms_of_service_url": null, "publisher_name": "Guangzhou Ocn Internet Technology Co., Ltd", "support_website_url": null, "website_url": "https://www.gisocn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150561588147379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_1529481842039519_5410162594904905541_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk7aQjvE9LUQ7kNvwECaR8f&_nc_oc=Adq_Xk84ri0Y9Hd5s7wrLmNUkbglYWxmhlGoeLDDOXKkfEA-tB5b4KU7tbiIgR_8W9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh30p51DtWgTGX2_9cEzlq_1u6shffttq2l60YrP-GfA&oe=6A5B8495"}, "is_concept": false, "is_
t64.5771-25/57569445_4028137637418163_3222471549387519108_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQC_ksEDJ_UQ7kNvwFzWL50&_nc_oc=AdoxrTbeM7SZaXnF8s8vRc10b-5oUMgivXqzvSJgD4ap2P6-rdxPDYrpFyIwoPZlFZQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0CMQchs8IBwYjmuvmW5lmfXXtTNni0ldfTiSFtavxRg&oe=6B09A4D1"}, {"file_name": "ScreenshotsArtboard-5.png", "id": "967738765273706", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/86624299_967738768607039_2069059455721822543_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-7SasD2ElAQ7kNvwFgqTKB&_nc_oc=Adowcf0cbyHexu1D0W7be74FpVHARzYy6p7LUBtfj2Ib3yO0VibA7Zwv7-LIx-GiRt4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWIWtPTLYd_GDlzMcJF22XPqYLril8-zg8Q4wlxBqNog&oe=6B09A2AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR.NDI Untethered", "keywords": ["ndi", "resolve", "premiere", "video", "editing"], "long_description": "VR.NDI helps you use your VR headset to view immersive media in your favorite programs like Premiere Pro, DaVinici Resolve, After Effects, and more! It takes any NDI feed and delivers the correct VR projection, both in monoscopic, stereoscopic, VR180, VR360, and spatial video formats.\n\nYou will need both your headset and computer connected to the same network and a way for the computer to send an NDI signal. It is not recommended to go above 4K resolution for real time playback.", "short_description": "VR.NDI helps you use your VR headset to view immersive media in your favorite programs like Premiere Pro, DaVinici Resolve, After Effects, and more! It takes any NDI feed and delivers the correct VR projection, both in monoscopic, stereoscopic, VR180, VR360, and spatial video formats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lightsailvr.notion.site/Privacy-Policy-17448bc6dcfc80749771cc038d722887?pvs=4", "developer_terms_of_service_url": null, "publisher_name": "Light Sail VR", "support_website_url": null, "website_url": "https://www.lightsailvr.com/tools.php", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9342031822514205"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1104313455295407"}, {"status": "PUBLISHED", "id": "1107907530652374"}, {"status": "PUBLISHED", "id": "1134672884855414"}]}, "baseline_offer": {"id": "1104313455295407"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793160900, "status": "PUBLISHED", "id": "1104313455295407"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29691810733776348", "version": "4.4.0"}, "id": "1159324561694701", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6966949150022496", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29691810733776348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1159324561694701"}]}, "change_log": "Aim with your eyes on headsets with eye tracking (Quest Pro, Meta VR\nGlasses). Look at a control and pinch. Settings \u203a Aim switches between\nEyes and Hands in one pinch; holding the menu gesture for two seconds\nalways returns to Hands.\n\n\n\nA new look, made for gaze. Bigger controls with more room between\nthem, round buttons, and toggles in place of sliding switches. Every\nbutton changes shade as you look at it, press it, or turn it on.\n\n\n\nSettings now holds Aim, 10-bit output and Extra IP addresses; a\nProjection button opens the layout and stereo choices.\n\n\n\nPassthrough in 180\u00b0 and 360\u00b0 until a source is playing, so the room\nshows instead of black.", "created_date": 1795368288, "id": "29691810733776348", "version": "4.4.0", "version_code": 2026112201, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6966949150022496", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29691810733776348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1159324561694701"}]}, "change_log": null, "created_date": 1792537357, "id": "29229773203313439", "version": "4.3.0", "version_code": 2026102001, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6966949150022496", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29691810733776348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1159324561694701"}]}, "change_log": null, "c
words": ["ndi", "resolve", "premiere", "video", "editing"], "long_description": "VR.NDI helps you use your VR headset to view immersive media in your favorite programs like Premiere Pro, DaVinici Resolve, After Effects, and more! It takes any NDI feed and delivers the correct VR projection, both in monoscopic, stereoscopic, VR180, VR360, and spatial video formats.\n\nYou will need both your headset and computer connected to the same network and a way for the computer to send an NDI signal. It is not recommended to go above 4K resolution for real time playback.", "short_description": "VR.NDI helps you use your VR headset to view immersive media in your favorite programs like Premiere Pro, DaVinici Resolve, After Effects, and more! It takes any NDI feed and delivers the correct VR projection, both in monoscopic, stereoscopic, VR180, VR360, and spatial video formats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lightsailvr.notion.site/Privacy-Policy-17448bc6dcfc80749771cc038d722887?pvs=4", "developer_terms_of_service_url": null, "publisher_name": "Light Sail VR", "support_website_url": null, "website_url": "https://www.lightsailvr.com/tools.php", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9342031822514205"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1107907530652374"}, {"status
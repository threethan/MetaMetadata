t64.5771-25/57569445_4028137637418163_3222471549387519108_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD8grQ9uJscQ7kNvwEMwVan&_nc_oc=AdoFBgMaLhj1Zegz0Gn5UpScjTL8fZPyJKCcyx2JU7jtm2u3WYPhJUtyb-0YBSsI2Es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWQqKvnTsSWfwg5i05QBmC9YBZhDtOmwLaeAr29Z2YMA&oe=6B0DD191"}, {"file_name": "ScreenshotsArtboard-5.png", "id": "967738765273706", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86624299_967738768607039_2069059455721822543_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUszzKRPmcsQ7kNvwFD5DTC&_nc_oc=AdpNIistmEvjv02FjOeVRDMRrsPOzzyBAbo9ie5FWHNnCmafiZz6_3UMftsHmii7j5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTreAwPfP8KyJRJS7oo3lSulCNMBBMk90fdm5GxdjpJJA&oe=6B0DCF6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR.NDI Untethered", "keywords": ["ndi", "resolve", "premiere", "video", "editing"], "long_description": "VR.NDI helps you use your VR headset to view immersive media in your favorite programs like Premiere Pro, DaVinici Resolve, After Effects, and more! It takes any NDI feed and delivers the correct VR projection, both in monoscopic, stereoscopic, VR180, VR360, and spatial video formats.\n\nYou will need both your headset and computer connected to the same network and a way for the computer to send an NDI signal. It is not recommended to go above 4K resolution for real time playback.", "short_description": "VR.NDI helps you use your VR headset to view immersive media in your favorite programs like Premiere Pro, DaVinici Resolve, After Effects, and more! It takes any NDI feed and delivers the correct VR projection, both in monoscopic, stereoscopic, VR180, VR360, and spatial video formats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lightsailvr.notion.site/Privacy-Policy-17448bc6dcfc80749771cc038d722887?pvs=4", "developer_terms_of_service_url": null, "p
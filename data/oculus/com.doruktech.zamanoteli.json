77848009546_5202995474446142563_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iFHHYkMR-IQ7kNvwHhdlRM&_nc_oc=AdpzvdtiC3qKn1_uUgnIqbbBnpSkaX2p06z_N6Xsh9GJ7GZ6OrsjdbfEjEZRCSzooX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi7t3PVWun9QJWdlvhASql6bhVr-EZQ-ob8fD9QdwsbQ&oe=6AFDD5D4"}]}, "id": "28821260794205385", "locale": "en_US", "screenshots": [{"file_name": "v3-1-mercek-piyanist-en-2560x1440.png", "id": "2138644196750710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_2138644200084043_2831822291942114955_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGaPzXg6FHgQ7kNvwGZoGqH&_nc_oc=AdqoJMrR6BVODi1RzIEwWmg6hPQ9eo3qfPSPSJpfBjGjaBuH-_9NVGC1HaeBDIEfxvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn7fcZFdk8r_367JIPqdAka6LbZbpa3Zk69IbTQczyjg&oe=6AFDC983"}, {"file_name": "v3-3-hayalet-vals-en-2560x1440.png", "id": "1849455472714410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1849455476047743_3242783139481434230_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6hasniHFQcQ7kNvwFYacU2&_nc_oc=Adp-XRWUbjxubIaJC9AyyX-U6IQunHR5oL8EUC-3rp7pW532kX1kswbUV8oYt_9vI-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxlHhU7ZUfAcuVS0bQnL6JAVYYbYRSlTmuUoVsoqkHqA&oe=6AFDD279"}, {"file_name": "v3-4-oda307-en-2560x1440.png", "id": "1524384470752846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1524384484086178_5350749701887157566_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-8svD2QZ-4Q7kNvwFTuvOE&_nc_oc=Ado_fOAAee5Mk5h9vwip8tMGI1m7bLsqTJ6lM6rVTmbx32ZtNI4C6UfdFzBgtZby2rk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmHKbr3-9Fz4HvbhEccQJ-kME9m6hPaIfYPt9FNrDFgg&oe=6AFDC862"}, {"file_name": "v3-2-kandil-levha-en-2560x1440.png", "id": "4224901510977243", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_4224901514310576_7021450404258684737_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjUKIy-uXzoQ7kNvwEYbXKJ&_nc_oc=AdrnNmKyL48UZwKHInuJzE32kP9DtaJJ91YOyXQ2nMyQHgMR6F2P4PWl7nelEeW7B6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvWlPyi7nWc-cvP7NOs4rnOdw9c5DPZkjUcVBO-_fjDQ&oe=6AFDB3A6"}, {"file_name": "v3-5-su-saati-en-2560x1440.png", "id": "1097199022921559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_1097199029588225_3758555969746464650_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKRypG_k_F4Q7kNvwFFvXst&_nc_oc=AdoR82b-HVrkGVimaH2k7L2NLmZx-pniYOKOgG0MvjbKI93-RqekS4fLrZ1NECSXho8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQitKUjQW0L0ino_14BUpG7FMuLPsl_KwjmZYU1pasDDA&oe=6AFDD2CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1639752484345086", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1639752491011752_922267668351467354_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkI5DekQbgAQ7kNvwFr1U8D&_nc_oc=Adrkn8z_cX96hZU5qXeVpBH7RuvfHCIgCmCaDKfAqRXXF3-r4SgUJeqS9ea9nzop99k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXSj_HqDD7Dem9iUGZ9bdft2cZIWDFgM0cHxuOBHklUw&oe=6AFDDC04"}, "display_name": "Zaman Oteli - Time Hotel", "keywords": [], "long_description": "Time has left its traces inside this hotel. Pick up a mysterious lens, examine forgotten objects, and uncover the story hidden behind locked doors.\n\nZaman Oteli - Time Hotel is a single-player VR puzzle adventure built around hands-on exploration. Turn mechanisms, connect clues and use the lens to reveal details concealed in the present. Vahan, the hotel\u2019s clockmaker, narrates each step deeper into Leyla\u2019s story.\n\nSEVEN CONNECTED CHAPTERS\nBegin in Room 307, continue through the Music Salon and Clock Tower, descend from the Attic Archive through the Boiler Room to the Deep Foundation, and end with The Last Chord.\n\nFOUR SEASONS\nThe base game has 7 chapters. Expansions: Frozen Carriages (1934, the Istanbul\u2013Paris train, 6 chapters), Lost & Found (7 chapters with an hourglass) and the new The Source of Time (7 chapters in the cistern beneath the hotel, with an oil lamp that reveals erased writing). The first chapters of Lost & Found and The Source of Time are free with the base game.\n\nEXPLORE AT YOUR OWN PACE\nLook closely, experiment with objects and ring the hint bell when you need a nudge, or play The Source of Time in Detective mode, without hints. Saved progress lets you return to the mystery.\n\nENGLISH AND TURKISH\nVoiced narration and subtitles in both languages; switch from the game\u2019s menu. Played with VR motion controllers.", "short_description": "A mysterious hotel. Traces of the past. Puzzles you solve with your own hands. Explore seven connected chapters and three expansion seasons, reveal hidden clues through a time lens, and follow Leyla\u2019s story in a single-player VR escape adventure with voiced narration. Play in English or Turkish."}, {"images": {"nodes": []}, "id": "1502124568488509", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zaman Oteli - Time Hotel", "keywords": [], "long_description": "Bu otelde zaman izlerini geride b\u0131rakm\u0131\u015f. Gizemli merce\u011fi eline al, unutulmu\u015f nesneleri incele ve kilitli kap\u0131lar\u0131n arkas\u0131ndaki hik\u00e2yeyi ortaya \u00e7\u0131kar.\n\nZaman Oteli - Time Hotel, dokunsal ke\u015ffe dayanan tek oyunculu bir VR bulmaca maceras\u0131. Mekanizmalar\u0131 \u00e7evir, ipu\u00e7lar\u0131n\u0131 birle\u015ftir ve bug\u00fcn g\u00f6r\u00fcnmeyen ayr\u0131nt\u0131lar\u0131 zaman merce\u011fiyle bul. Otelin saat\u00e7isi Vahan, Leyla\u2019n\u0131n hik\u00e2yesinde att\u0131\u011f\u0131n her ad\u0131m\u0131 sana anlat\u0131r.\n\nB\u0130RB\u0130R\u0130NE BA\u011eLI YED\u0130 B\u00d6L\u00dcM\nOda 307\u2019den M\u00fczik Salonu ve Saat Kulesi\u2019ne ilerle. \u00c7at\u0131 Ar\u015fivi\u2019nde izleri takip et; Kazan Dairesi\u2019nden Derin Temel\u2019e in ve Son Akor\u2019da otelin s\u0131rr\u0131na ula\u015f.\n\nD\u00d6RT SEZON\nAna oyun 7 b\u00f6l\u00fcm. Ek sezonlar: Donmu\u015f Vagonlar (1934, \u0130stanbul\u2013Paris treni, 6 b\u00f6l\u00fcm), Kay\u0131p Emanetler (kum saatiyle 7 b\u00f6l\u00fcm) ve yeni Zaman\u0131n Kayna\u011f\u0131 (otelin alt\u0131ndaki sarn\u0131\u00e7ta 7 b\u00f6l\u00fcm; kandilin \u0131\u015f\u0131\u011f\u0131 silinmi\u015f yaz\u0131lar\u0131 g\u00f6sterir). Kay\u0131p Emanetler ve Zaman\u0131n Kayna\u011f\u0131\u2019n\u0131n ilk b\u00f6l\u00fcmleri ana oyunla \u00fccretsiz.\n\nKEND\u0130 HIZINDA KE\u015eFET\nYak\u0131ndan bak, nesnelerle denemeler yap ve gerekti\u011finde ipucu zilinden yard\u0131m al; Zaman\u0131n Kayna\u011f\u0131\u2019n\u0131 istersen ipu\u00e7suz Dedektif kipinde oyna. Kaydedilen ilerlemen sayesinde macerana daha sonra devam edebilirsin.\n\nT\u00dcRK\u00c7E VE \u0130NG\u0130L\u0130ZCE\n\u0130ki dilde seslendirmeli anlat\u0131m ve altyaz\u0131; dili oyun men\u00fcs\u00fcnden de\u011fi\u015ftir. VR hareket kontrolc\u00fcleriyle oynan\u0131r.", "short_description": "Gizemli bir otel, ge\u00e7mi\u015ften kalan izler ve kendi ellerinle \u00e7\u00f6zd\u00fc\u011f\u00fcn bulmacalar. Birbirine ba\u011fl\u0131 yedi b\u00f6l\u00fcmde ve \u00fc\u00e7 ek sezonda zaman merce\u011fiyle gizli ipu\u00e7lar\u0131n\u0131 ortaya \u00e7\u0131kar, mekanizmalar\u0131 \u00e7al\u0131\u015ft\u0131r ve Leyla\u2019n\u0131n hik\u00e2yesini ke\u015ffet. Seslendirmeli, T\u00fcrk\u00e7e ve \u0130ngilizce oynanabilen tek oyunculu bir VR ka\u00e7\u0131\u015f maceras\u0131."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zaman-oteli-time-hotel-privacy", "developer_terms_of_service_url": null, "publisher_name": "DorukTech", "support_website_url": "https://sites.google.com/view/zaman-oteli-time-hotel-privacy", "website_url": "https://sites.google.com/view/zaman-oteli-time-hotel-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1363797923486381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_1932951964332749_4997354537691590052_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoyBbD0fQ6MQ7kNvwEZcfak&_nc_oc=AdqjcfA2Fd_gL_EBDPFbiI6852nb_AOarfKsW1kNDY9dUDDvCPxb3PTHglXvSyV5cJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDWcp8iRoFZFGjzmYRFGRpt2huPvrGh3PnUReG8-WiCw&oe=6AFDE3F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zaman Oteli - Time Hotel", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1791915480, "lastRevision": {"nodes": [{"id": "1345239018675605", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1345239002008940", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4037010943270605"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1821539355534417", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zaman Oteli - Time Hotel", "keywords": [], "long_description": "Bu otelde zaman izlerini geride b\u0131rakm\u0131\u015f. Gizemli merce\u011fi eline al, unutulmu\u015f nesneleri incele ve kilitli kap\u0131lar\u0131n arkas\u0131ndaki hik\u00e2yeyi ortaya \u00e7\u0131kar.\n\nZaman Oteli - Time Hotel, dokunsal ke\u015ffe dayanan tek oyunculu bir VR bulmaca maceras\u0131. Mekanizmalar\u0131 \u00e7evir, ipu\u00e7lar\u0131n\u0131 birle\u015ftir ve bug\u00fcn g\u00f6r\u00fcnmeyen ayr\u0131nt\u0131lar\u0131 zaman merce\u011fiyle bul. \u00c7\u00f6zd\u00fc\u011f\u00fcn her bulmaca seni Leyla\u2019n\u0131n hik\u00e2yesinde bir ad\u0131m ileri g\u00f6t\u00fcr\u00fcr.\n\nB\u0130RB\u0130R\u0130NE BA\u011eLI ALTI B\u00d6L\u00dcM\nOda 307\u2019den M\u00fczik Salonu ve Saat Kulesi\u2019ne ilerle. \u00c7at\u0131 Ar\u015fivi\u2019nde izleri takip et; Kazan Dairesi\u2019nden Derin Temel\u2019e inerek otelin s\u0131rr\u0131na ula\u015f.\n\nKEND\u0130 HIZINDA KE\u015eFET\nYak\u0131ndan bak, nesnelerle denemeler yap ve gerekti\u011finde ipucu zilinden yard\u0131m al. Kaydedilen ilerlemen sayesinde macerana daha sonra devam edebilirsin.\n\nT\u00dcRK\u00c7E VE \u0130NG\u0130L\u0130ZCE\nOyun men\u00fcs\u00fcnden iki dil aras\u0131nda ge\u00e7i\u015f yap. VR hareket kontrolc\u00fcleriyle oynan\u0131r.", "short_description": "Gizemli bir otel, ge\u00e7mi\u015ften kalan izler ve kendi ellerinle \u00e7\u00f6zd\u00fc\u011f\u00fcn bulmacalar. Birbirine ba\u011fl\u0131 alt\u0131 b\u00f6l\u00fcmde zaman merce\u011fiyle gizli ipu\u00e7lar\u0131n\u0131 ortaya \u00e7\u0131kar, mekanizmalar\u0131 \u00e7al\u0131\u015ft\u0131r ve Leyla\u2019n\u0131n hik\u00e2yesini ke\u015ffet. T\u00fcrk\u00e7e ve \u0130ngilizce oynanabilen tek oyunculu bir VR ka\u00e7\u0131\u015f maceras\u0131."}, {"images": {"nodes": [{"file_name": "portrait-1008x1440.png", "id": "2193133561265928", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_2193133567932594_1651852098035815117_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5b622w1w6IQ7kNvwH1WShW&_nc_oc=AdqiGYuKNJt0_jT6Qn5ftUq3kKpa9bAOZHnHww93c-JjM6yvVcmLRhh4g24i_yXupeM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1WwpznsqE8WVJai2uh1Lnsn_nfqPbqdkiz5-pFh385w&oe=6AFDBA60"}, {"file_name": "hero-3000x900.png", "id": "2135772460386852", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_2135772463720185_666203615023643778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTTt6p-fw9YQ7kNvwE3LHj5&_nc_oc=AdqVAKqLzE9sNWa9oz_rdTq-s5Vkh8Sw3ne-Qd7DVMvfRDwtBzJLVec8IFB7jo6ilR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqH64L2IWZKLIwY5J8IpoGswS-8GM0uL0p0LxSZHKapA&oe=6AFDAC2C"}, {"file_name": "square-1440x1440.png", "id": "1932951960999416", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_1932951964332749_4997354537691590052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoyBbD0fQ6MQ7kNvwEZcfak&_nc_oc=AdqjcfA2Fd_gL_EBDPFbiI6852nb_AOarfKsW1kNDY9dUDDvCPxb3PTHglXvSyV5cJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP55efNX9SAYBEm9vGiTjxSxE9Gq2KGqUBTOP1vQVvYA&oe=6AFDE3F8"}, {"file_name": "landscape-2560x1440.png", "id": "1416047686645561", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827646_1416047689978894_5322629995145584797_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JaJjgkA4v0Q7kNvwEh5dNZ&_nc_oc=AdorfaHOtJiJ6WwnKGqUJeruOeBd8VUwAGWvk_5N5wY6hE5MrDYy4BmRgwn-irYgn5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_s
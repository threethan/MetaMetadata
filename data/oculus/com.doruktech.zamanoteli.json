7f20f&oh=00_AQQHENSe_73YCKuOZL98P2Z0qiS7Q_yNBD9DR_d1d0Xc-g&oe=6AFDBF1A"}, {"file_name": "quest-kazan-dairesi-2560x1440.png", "id": "925682550364713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_925682553698046_5986807888027865400_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FM7RTYJqPQQ7kNvwEGLpuK&_nc_oc=Ado7ZH29r3nLm9gQQ0VkLv_wg4e2MK1wFOXDkt2wvDK-yQic-T45my5DykS755zwz7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvsLnbrXMKR0Per2dx5RgJDPl8IZ1ydWtHqj5fqGtHUg&oe=6AFDB89F"}, {"file_name": "quest-saat-kulesi-2560x1440.png", "id": "1273886104869476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_1273886111536142_7525463403861594985_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I40adfd91QEQ7kNvwEr5FYQ&_nc_oc=Adq3p8B918Ln0oWiGNG53GEPpiIKdwZZ060wPWFXbxcYaIBvvfrnCHy3sdaJHs2rFGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ4KLFVxSFcwd6dimYs30zPDN8ZOtd3vwOXboklc_WWw&oe=6AFDC938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1639752484345086", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1639752491011752_922267668351467354_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkI5DekQbgAQ7kNvwFr1U8D&_nc_oc=Adrkn8z_cX96hZU5qXeVpBH7RuvfHCIgCmCaDKfAqRXXF3-r4SgUJeqS9ea9nzop99k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXSj_HqDD7Dem9iUGZ9bdft2cZIWDFgM0cHxuOBHklUw&oe=6AFDDC04"}, "display_name": "Zaman Oteli - Time Hotel", "keywords": [], "long_description": "Time has left its traces inside this hotel. Pick up a mysterious lens, examine forgotten objects, and uncover the story hidden behind locked doors.\n\nZaman Oteli - Time Hotel is a single-player VR puzzle adventure built around hands-on exploration. Turn mechanisms, connect clues and use the lens to reveal details concealed in the present. Each solved puzzle takes you deeper into Leyla\u2019s story.\n\nSIX CONNECTED CHAPTERS\nBegin in Room 307, continue through the Music Salon and Clock Tower, and descend from the Attic Archive through the Boiler Room to the Deep Foundation.\n\nEXPLORE AT YOUR OWN PACE\nLook closely, experiment with objects and use the hint bell when you need a nudge. Saved progress lets you return to the mystery.\n\nENGLISH AND TURKISH\nSwitch between both languages from the game\u2019s menu. Played with VR motion controllers.", "short_description": "A mysterious hotel. Traces of the past. Puzzles you solve with your own hands. Explore six connected chapters, reveal hidden clues through a time lens, and follow Leyla\u2019s story in a single-player VR escape adventure. Play in English or Turkish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zaman-oteli-time-hotel-privacy", "developer_terms_of_service_url": null, "publisher_name": "DorukTech", "support_website_url": "https://sites.google.com/view/zaman-oteli-time-hotel-privacy", "website_url": "https://sites.google.com/view/zaman-oteli-time-hotel-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345239005342273"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2389346141804792"}, {"status": "PUBLISHED", "id": "1405582134975232"}]}, "baseline_offer": {"id": "1405582134975232"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795464000, "status": "PUBLISHED", "id": "2389346141804792"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1363619830170857", "version": "1.4.0"}, "id": "1596701538864152", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345239002008940", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1363619830170857"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1596701538864152"}]}, "change_log": "Zaman Oteli 1.4.0 \u2022 Sezon 4: Zaman\u0131n Kayna\u011f\u0131 \u2014 otelin alt\u0131ndaki sarn\u0131\u00e7ta yedi yeni b\u00f6l\u00fcm, yeni alet kandil, seslendirilmi\u015f anlat\u0131m ve iki sonlu final; ilk b\u00f6l\u00fcm (Mahzen) \u00fccretsiz. \u2022 Dedektif kipi ve usta m\u00fch\u00fcrleri. \u2022 1., 2. ve 3. sezon yenilendi: ger\u00e7ek dokular ve Vahan'\u0131n seslendirmesi. \u2022 Tabela, etiket ve yaz\u0131larda bir\u00e7ok g\u00f6rsel d\u00fczeltme. \u2022 \u0130pucu zili art\u0131k s\u0131n\u0131rl\u0131: her b\u00f6l\u00fcmde 3 hak, kullan\u0131lan hak 10 dakikada bir geri gelir. Time Hotel 1.4.0 \u2022 Season 4: The Source of Time \u2014 seven new chapters in the cistern beneath the hotel, a new tool (the oil lamp), voiced narration and a finale with two endings; the first chapter (The Cellar) is free. \u2022 Detective mode and master seals. \u2022 Seasons 1, 2 and 3 remastered: real textures and Vahan's voiced narration. \u2022 Many visual fixes to signs, labels and text. \u2022 The hint bell is now limited: 3 hints per chapter, and a used hint returns every 10 minutes.", "created_date": 1792581878, "id": "1363619830170857", "version": "1.4.0", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345239002008940", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1363619830170857"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1596701538864152"}]}, "change_log": "Zaman Oteli 1.3.1\r\n\u2022 D\u00fczeltme: Men\u00fc (sol kumandadaki men\u00fc tu\u015fu) a\u00e7\u0131l\u0131nca konfor d\u00fc\u011fmelerinin yaz\u0131lar\u0131 g\u00f6r\u00fc\u015f\u00fc kapl\u0131yordu; art\u0131k do\u011fru boyutta.\r\n\u2022 1.3.0'dan: yeni sezon Kay\u0131p Emanetler (7 b\u00f6l\u00fcm, ilk b\u00f6l\u00fcm \u00fccretsiz), final b\u00f6l\u00fcm\u00fc Son Akor, konfor men\u00fcs\u00fc, yenilenen g\u00f6r\u00fcnt\u00fc ve sesler.\r\n\r\nTime Hotel 1.3.1\r\n\u2022 Fix: opening the menu (left controller menu button) made the comfort button labels fill the view; they now appear at the right size.\r\n\u2022 From 1.3.0: new season Lost & Found (7 chapters, the first one free), finale chapter The Last Chord, comfort menu, refreshed visuals and sound.", "created_date": 1792094343, "id": "1353878317811675", "version": "1.3.1", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345239002008940", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1363619830170857"}, "release_
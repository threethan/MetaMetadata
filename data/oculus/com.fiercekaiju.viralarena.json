19977754624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i5uIUD2kagQ7kNvwF94rTp&_nc_oc=AdkORo_tOW9MVOHzKbV87DVaHlPqTNMvnhjkvOA9a5YzJrjDNzJDRmSp_Ji7W0Ro5cM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvGR6Jff9S7QOyVRSY_wJW6HL-hzqViz7AhI8jAhZebJw&oe=699EFD36"}, {"file_name": "migrated_image.png", "id": "218567699223637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602128_206436006497753_932409139076792320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JXezrniIGMQ7kNvwG_pKjQ&_nc_oc=Adl5v5xfvdSGGc5lUsXoDcgdiZCBwwVfum4E8amfLQvx02Jm-s6Nh6rZ6a9QNAQJQ2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftbgDIyOq4t3DkefCP5SLv4efbBRTuItuMIwJDlEJJiUQ&oe=699EEDA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quarantine_MainImage1.png", "id": "114408292441125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_114408295774458_8479061205254668288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9qJXGg3ozoQ7kNvwEaqqxL&_nc_oc=AdmHPOm8leFXb-Br9UQeBioNDQwyRfV3erHJpTHluLEDX6Jqhax8z6ULsqgxs-EovuM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftcNNhUbp2gDWS9GIwJESZH6zQolfHXacYBEun977N-Lg&oe=699EE80B"}, "display_name": "Viral Quarantine", "keywords": ["Viral", "Quarantine", "Fierce", "Kaiju"], "long_description": "The follow-up to the Gear VR classic \"Viral\" is finally here!\n\nWelcome to Quarantine ...  \nA huge expanse full of dastardly Viruses, traps, tricks and hidden secrets ; the only way out of here is impress E.V.E by scoring big. Don\u2019t worry, there\u2019s a brand new arsenal on your side \u2013 the system may have a headache, but she still wants you to have fun while you\u2019re trapped down here.\n\nYou are threatened by new foes, but comforted by new weapons too! Use the tactile Manipulator, the devastating Guided Shot and the hilarious Lure to clear your path in the most satisfying of ways.", "short_description": "The follow-up to the Gear VR classic \"Viral\" is finally here!\n\nWe
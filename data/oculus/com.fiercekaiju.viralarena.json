a0a&_nc_ohc=GEfFWntmSeMQ7kNvwHwMHXY&_nc_oc=AdlurbPnwrNpvRwfP-ctgZSfnn_vAygAWk25fBxZmyj-YH1sshOoyKdK5DYG0NFd2cU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz645Q0VV9wQWzzcFsJLXiWZLRK40y3Lb5kqMqqqhTbIg&oe=69AC170B"}, "display_name": "Viral Quarantine", "keywords": ["Viral", "Quarantine", "Fierce", "Kaiju"], "long_description": "The follow-up to the Gear VR classic \"Viral\" is finally here!\n\nWelcome to Quarantine ...  \nA huge expanse full of dastardly Viruses, traps, tricks and hidden secrets ; the only way out of here is impress E.V.E by scoring big. Don\u2019t worry, there\u2019s a brand new arsenal on your side \u2013 the system may have a headache, but she still wants you to have fun while you\u2019re trapped down here.\n\nYou are threatened by new foes, but comforted by new weapons too! Use the tactile Manipulator, the devastating Guided Shot and the hilarious Lure to clear your path in the most satisfying of ways.", "short_description": "The follow-up to the Gear VR classic \"Viral\" is finally here!\n\nWelcome to Quarantine ...  \nA huge expanse full of dastardly Viruses, traps, tricks and hidden secrets ; the only way out of here is impress E.V.E by scoring big. Don\u2019t worry, there\u2019s a brand new arsenal on your side \u2013 the system may have a headache, but she still wants you to have fun while you\u2019re trapped down here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fiercekaiju.com/", "developer_terms_of_service_url": "https://www.fiercekaiju.com/", "publisher_name": "Fierce Kaiju Ltd", "support_website_url": null, "website_url": "https://www.fiercekaiju.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_
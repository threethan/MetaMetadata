19977754624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i5uIUD2kagQ7kNvwGkypoh&_nc_oc=Adk17mkGvt1CsDrLvjWQniCOdD50mhZ9D4rI8CGEZYZaOHvkG34hM1BKMzqCMJHVyBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8N8kYVmnieUzS61_VINegEW5FUwhNbsgaXxVcrWakzA&oe=69A04EB6"}, {"file_name": "migrated_image.png", "id": "218567699223637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602128_206436006497753_932409139076792320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JXezrniIGMQ7kNvwEB7NQo&_nc_oc=AdmDQa9wdouN0_JInbxa4bAV6wY4VqfBTnjkvm_uCyEUIlMf9u9Q1VrFIUDiHjgqCD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYs8EuEeeF_O_o5gHjVZsNR0JCMFagG8FaUXXUiiAQDg&oe=69A03F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quarantine_MainImage1.png", "id": "114408292441125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602290_114408295774458_8479061205254668288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9qJXGg3ozoQ7kNvwGz3bY0&_nc_oc=Adk8GivBQyzep5QlhUqzAM3mtRhwLdwKEUh1uZ1of6OfIRhcu3bKPHuMQXIp6ksObPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxKFQc53FsWMRIPp7v_5arP2q0tul97W1kE8ZvWQgayQ&oe=69A0398B"}, "display_name": "Viral Quarantine", "keywords": ["Viral", "Quarantine", "Fierce", "Kaiju"], "long_description": "The follow-up to the Gear VR classic \"Viral\" is finally here!\n\nWelcome to Quarantine ...  \nA huge expanse full of dastardly Viruses, traps, tricks and hidden secrets ; the only way out of here is impress E.V.E by scoring big. Don\u2019t worry, there\u2019s a brand new arsenal on your side \u2013 the system may have a headache, but she still wants you to have fun while you\u2019re trapped down here.\n\nYou are threatened by new foes, but comforted by new weapons too! Use the tactile Manipulator, the devastating Guided Shot and the hilarious Lure to clear your path in the most satisfying of ways.", "short_description": "The follow-up to the Gear VR classic \"Viral\" is finally here!\n\nWe
4Q7kNvwFzY_ul&_nc_oc=AdqngcR-_o__eu9yHZx3jJtFOqiCg-aRNX4UHb559uBzsK7gYjgLOsEAQgCFsAvTAFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA3QQhKTHmX1TMXKVC2ciibiQ1jsT3hZWCCk5Lk6TLrw&oe=6ABBD218"}, {"file_name": "resized_16_9_0.png", "id": "2197050367499218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_2197050370832551_6252559744345102753_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrRWseBkrNUQ7kNvwHxq2qM&_nc_oc=Adr374Xj-1H82-ZQ75wmaRbjZJzyrpzgO5AghfgMLOWWAZBvHtrZAJGyvLqqZ5i1WHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvKA-10W-d5aNaEvpEqLkPrJ7qWGJPeuZYVFNYrbBKLg&oe=6ABBD729"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DashVerse", "keywords": ["fangame", "Hangout", "action", "customize", "Fun"], "long_description": "Dash Verse is a dynamic and immersive VR experience where players can hang out, explore, and play together in a vibrant virtual world. Whether you're relaxing with friends or jumping into exciting mini-games, Dash Verse offers something for everyone. Customize your monkey avatar with unique styles and stand out as you express your personality across different environments.\n\nDiscover a variety of interactive spaces designed for fun, competition, and creativity. From fast-paced challenges to casual social areas, you can choose how you want to spend your time. The game is built to bring people together, making it easy to connect, chat, and create unforgettable moments in VR.\n\nDash Verse is constantly growing, with new features, worlds, and gameplay experiences being added over time. Whether you're here to compete, socialize, or just explore, there\u2019s always something new waiting for you. Step into Dash Verse and be part of an evolving universe full of possibilities.", "short_description": "Dash Verse is an exciting VR experience where you can hang out with friends, play a variety of fun games, and fully customize your monkey avatar. Explore vibrant worlds, compete in challenges, and express yourself in unique ways. With constant updates and new features on the way, Dash Verse is always evolving\u2014there\u2019s always something new to discover."}]}, "developer_name": "PenguinStudios", "developer_privacy_policy_url": "https://voltplayz23.github.io/PrivacyPolicyPenguin/", "developer_terms_of_service_url": null, "publisher_name": "PenguinVR20", "support_website_url": null, "website_url": "https://camronswallow5.wixsite.com/dash-verse", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "26558813347090995"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_2770495143324558_837689957164103453_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoI2B_PekzcQ7kNvwH2VLOD&_nc_oc=AdpO748WFBcelnEcJJWx6CQ5cZVDSCjeYqO7UKO9y8iJxvplKGv7QsBhNRka5nGJdtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV_cz1nVGorNIWQhxlVbBFeNttki9AK5AE45Z68qL5eQ&oe=6ABBDE4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DashVerse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150
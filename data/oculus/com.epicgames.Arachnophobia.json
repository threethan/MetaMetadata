t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HppT4QpkvuMQ7kNvwHRW7qQ&_nc_oc=Adq6IMGHxi2IH94T5r2_DJycmwgcmCn-lwiUYA0DYdTtUPNhVBzcP_kOHtEZuW84x0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcs7_UnLT09gzSGL17UiJfWoNdNFpqA5ob4hBSahoztQ&oe=6AB12D84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spiders: Burn them out", "keywords": ["spider", "horror", "horrorVR", "spiders", "arachnophobia"], "long_description": "# SPIDERS: BURN THEM OUT\n\nGot arachnophobia? It\u2019s time for payback. \n\nStep into room-scale VR armed with a high-powered flamethrower and purge extremely terrifying giant monster spiders crawling across the walls, floor, and ceiling. No hiding, no mercy\u2014just raw, satisfying fire.\n\nThe year is 2095 and you are Dr. Doc Red, a very reputed scientist working for CAWC (Center for Alternate World Creation) where you and your team as part of realizing your organization's goal of creating much better alternate worlds for human beings to transport into, have now managed to create a small artificial room in an alternate world that doesn't exist in our reality. The idea was to then first transport animals starting from small insects into this room in order to test its gravity and other aspects. It was all going well until the experiment reached spiders. After celebrating the success of six spiders transferred to the room from the real world  perfectly moving along the boundaries of the room, one of your team members decided to have some fun and made the spiders giant-sized. This broke everything and to utmost horror, when these giant spiders get too close to the floor, they are able to escape to our real world and a new spider automatically generates inside the room. So all six spiders have to be removed quickly before they can escape. You could only transfer a flamethrower gun and oil barrel to this room before going in to destroy all spiders and save earth from a giant spider TAKEOVER!!!", "short_description": "Grab a flamethrower, hunt down wall-crawling spiders, and purge the room in full 360\u00b0 room-scale VR to save your planet from being taken over by giant spiders!!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rubarion.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rubarion Games", "support_website_url": null, "website_url": "https://www.rubarion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1362433750283018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673554902_1021387254074151_666907105183260844_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra63EXyaqcIQ7kNvwGqAO9r&_nc_oc=AdojJ__U_nX4AJjH829-1f-wj12If_TdjaPW-KjMUamILspOvp-nejiJ_MaL1A-z4o0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKroeuGbh6clfViglfeuO3gOriFd43gUMZX9Eq-ccQiuw&oe=6AB14F24"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spiders: Burn them out", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1786723200, "lastRevision": {"nodes": [{"id": "12
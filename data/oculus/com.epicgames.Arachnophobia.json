MExvELilEetG0sA2Q6_QjMw0Qmmgb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsHDNLlcvjmvd2rJIca8zvh4CB9g2Sk13-jIbTca92KA&oe=6AB14C59"}, {"file_name": "four.png", "id": "1765428411434656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_1765428414767989_8644408526652612903_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcOIDfEXlBEQ7kNvwEZVmpp&_nc_oc=AdplavxwQ0uM8EK1HYtcRqE28jP-l5CKxv84O14HByAw7u46sO_G4dgTc3vNPVBckjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6rQI9BZGxR7BVVO5NgC7w7xfnniGwJaDkIDsQdFXatg&oe=6AB130AD"}, {"file_name": "five.png", "id": "2119175968633652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_2119175971966985_942956258775036505_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7O0HuYUgcsQ7kNvwH2KrvL&_nc_oc=Adq-aJZC1s5jdKS6TxsDqjWa3qgIE4rGURTecCv3uRvc3GnKsgEDCrt18jTRELvPLCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_lb538-_JYjBybjnVmPQWt2EaeVW4Ow8GZilWTcelLw&oe=6AB147FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spiders: Burn with fire", "keywords": ["spider", "horror", "horrorVR", "spiders", "arachnophobia"], "long_description": "# SPIDERS: BURN WITH FIRE\n\nGot arachnophobia? It\u2019s time for payback. \n\nStep into room-scale VR armed with a high-powered flamethrower and purge extremely terrifying giant monster spiders crawling across the walls, floor, and ceiling. No hiding, no mercy\u2014just raw, satisfying fire.\n\nThe year is 2095 and you Dr. Emmett Brown is a very reputed scientist working for CAWC (Center for Alternate World Creation) where you and your team as part of realizing your organization's goal of creating much better alternate worlds for human beings to transport into, have now managed to create a small room in alternate dimensions that has no physical existence in the real world we live in now. The idea was to then first transport animals starting from small insects to this room in order to test its gravity and other aspects. It was all going well until the experiment reached spiders. After celebrating the success of six spiders transferred to the room from real world  perfectly moving along the boundaries of the room, one of your team members decided to have some fun and made the spiders giant size. This broke everything and to utmost horror, when these giant spiders gets close to floor, they are able to escape to our real world and a new spider automatically generates inside the room. So all six spiders have to be removed before they can escape. You could only transfer a flamethrower gun and oil barrel to this room before going in to destroy all spiders and save earth from a giant spider TAKEOVER!!!", "short_description": "Grab a flamethrower, hunt down wall-crawling spiders, and purge the room in full 360\u00b0 room-scale VR to save your planet from being taken over by giant spiders!!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rubarion.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rubarion Games", "support_website_url": null, "website_url": "https://www.rubarion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1314416098418117"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "10115628084316
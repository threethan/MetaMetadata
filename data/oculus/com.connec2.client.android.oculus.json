8554274830014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuVeA9tZWWAQ7kNvwGrUFN4&_nc_oc=Adkn_y9XkIxsIxNRtWgoucBHPcW09cS5Tvb8rxye7uiolmMBeJ0aCYQfrFjwgENrMBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSdQywDx0SR9ZF8Azw5K2CeSCgY7fGPYtqZCzTyaNjnw&oe=69B4157A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWL21NuQUYIQ7kNvwHjF9r_&_nc_oc=AdlbEpZhcerbP2c0T5GV1WV2C3qVirmzDq2kQKs2TZRQkT6I9YjQo_x11JFl6c4Fko0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFQOyoLsM09gHFkCa6EFAfJMOWcEUYV1hK9z_2r2xj6A&oe=69B3F3DB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kytKJJ-KnawQ7kNvwFjzoo_&_nc_oc=AdnE-wL71khas41nFADsM4iWvh5A52PPnGIfjwrsIwNjvIv-4ww2AgX1ESOT1No-qA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfycD2-GS4ameuninyMB4H2HJRMT58E4XVs1nswkA_dgGg&oe=69B3FE45"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tit-RCfVb08Q7kNvwF0i6Af&_nc_oc=AdmeEb5m8b_m-jPcwhZihKtR8cElU_wrlNzpqdheLq7grCjucuQssxEYduKSj6Wk-J0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKV9PqDMED0TvUuYj7eHOgoPlwovdQTwRcDy-ueP4A0w&oe=69B416E2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ioC18mnctQQ7kNvwGXvDi9&_nc_oc=AdlNJ4oYWyfX-TNyqCWXmqNzcG9uztw7rZTYgkA5znEvhaGC8QXm_OXXrFAie1VgavY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQI5FoTnSchf5fI2JLM2BJxvdHzS0chCstiMuvpbmdLQ&oe=69B3FD69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
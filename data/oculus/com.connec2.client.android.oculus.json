-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCs2Zit6VfcQ7kNvwG8BPLg&_nc_oc=Adn7K5Y1h6-H5KCmIBaljUBgxMxEMaoc4QWkOh5Nli0Em14PPJty3mjL7NjLgujGZto&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsilI1mL5PO7cRNZxG45kUgd3P8FQzhUhSgU5evOBMNgQ&oe=69A1A07A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsJnsXffEqcQ7kNvwFaP3pQ&_nc_oc=Admn5-YsPArVAtd2W4oPSs45bRRMDmuxweVJQO2twmA5a-YpMmyuUzfjHXA9uYoN6HI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvymmjqXZpmBrTgJbEgjUqLTlrhkdlVzWbLkmJs-dw99Q&oe=69A17EDB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWnhJyv_YkwQ7kNvwFj4f2R&_nc_oc=AdnPG-eUDYPAV-YeL2MflbRCyRm9ajGEeZCyaIBTeuL0lM7We_qVNffhw9rkarjKtiY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftdD1myIl4weF3eBgvJfk8JJzz6Bd3xwHYoX6e-JxUk_A&oe=69A18945"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVR1YAJaVSQQ7kNvwEspsaN&_nc_oc=Adk9fBacpi2EQXttip8sw18on_fWH_4M8a4XzJsyrLJgFAaJ1WcEC17tH9mdrwXl8qA&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvNN5Cy5s7dfeAKbr7HShqgT31plvwApeS__Yp3XKS0qg&oe=69A1A1E2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxKSN1oGoMwQ7kNvwHd1j-P&_nc_oc=Adne7e9a76lQ6u6R7kBCkbBUXtzCDICVjsTcVLCuyTUZSbKt4a0F3N6uUweGlYS5wBA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsKCuwTuMeA9LyU002SVDKmXKi8bIxXPXGxGNSHJn_4gA&oe=69A18869"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
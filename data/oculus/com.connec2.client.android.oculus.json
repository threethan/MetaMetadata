-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCs2Zit6VfcQ7kNvwEwqMxA&_nc_oc=AdnwbbYyWubEHVRd7byqGGUPOHJlcr1eQz_ze5gNiSLHK_182JrMdIai29vGw3Vq4Uw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuEdkkmxlhmS7gVs5sQZu_Zfp6d9V0YB5dGuhlXZWB-nQ&oe=69A2F1FA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqPdveqZXW8Q7kNvwFczEVb&_nc_oc=AdnEGS4CGHL9FmFegWUDo8QiNdWsYKvAl9vyC8-SGe6X8YlqSkMY-QvxZTvDw5EavnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvsGUC7e7brsIZZw5o6u2ZAffRn7nrRFxnyEukLV9v91w&oe=69A2D05B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWnhJyv_YkwQ7kNvwGaH-Ww&_nc_oc=AdnI2A6rEuge1YU222amaz_rcYD1Fi5iX-5agn-0GBRP9EmWm4dQq4SyYJnuXt8kejI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsuA5ivAsp0weEOyLjydf9SASHVowWOVKDlpvFbiB0Ckg&oe=69A2DAC5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVR1YAJaVSQQ7kNvwGOQlb5&_nc_oc=AdkvvAOfVHipy1KQbRSsKOek2O5Roer--pSowi7YTOMoop0iRH_s_xquUyOV00lb6jk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsbYFsP4qle6acp-7_3YAmwEaJsaCW-c0JxuF-vEd5Z1g&oe=69A2F362"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxKSN1oGoMwQ7kNvwHewpuV&_nc_oc=AdnePKz5abrrHFq6xj0wZnDoZeF4p2L1Lkk_j4dnGJxtMih7Z3BDfadPV7r2J_SAfaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afur4bL4PyKhuNk8vk6hAR_rDwNC5uYSCJHBxoL7DaWn5A&oe=69A2D9E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
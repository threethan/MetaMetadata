-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLlWOdUEq1QQ7kNvwE3pN2y&_nc_oc=Adl2QBoV_T7GRev8rDulW5Lke0HXkD_oFymW1nZPqdVGotEuSoQqjaYSPOwrzkvyIG8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsoRIsm85oCRhUGn47lNbH9bmaP_L_IvLOmnoIW8b7oEg&oe=699EFD7A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsJnsXffEqcQ7kNvwFqmmhR&_nc_oc=AdkIXhcOgH1psx5GLPyMK09QUejiRZRH6BLoc6dDilCsTSg0c6dS0A5CdNIjWFs24n0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afucnt-wHUO50jeGVpYgfenCjx7EUt4RQdLNHeKaEuxNww&oe=699EDBDB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=613PB4aiizUQ7kNvwHzYzie&_nc_oc=AdkHTOnCwwKJ47IPd5C8qFviI767_A8EZwhJjQYaLbxjsDbwsqqIeEd712T1HDuH1h8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuQlIljIr89o8Q4jzoMsplmPJInA9Pyqj9l3EIqnbV6UQ&oe=699EE645"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZWabvn9edYQ7kNvwG4H2UA&_nc_oc=AdmITnJCmxmuyE5RjM-Pnyw52B0SQuoie2_131rzTRmuHMEsfYROaOGh6QG17-g6tx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuT8ZanjV87JLPTQZHI8-yFGud5JGMHhC4MzsDHMF7WQw&oe=699EFEE2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rdg39ytF8YQ7kNvwF42Xnc&_nc_oc=Adm2v3GLU_HXnBqSPLFD-ppLhza-6mV0PXoJYh-ZWaDw9HFoHM0UhZPWDlFPgXh4NhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuWU-En1gu3c06BCdBAbriV9_0UmaZcPX47wYwGWWduoA&oe=699EE569"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrcA06MeXkAQ7kNvwFouWUe&_nc_oc=Admxx6VD8_zizeYiW3OaBsLMc4TeHPPpGFvWOQsbhCp8k99YwUB82DayenXHVBmawNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuiM_keVaCpU1C9juarSNBdsV2rJuzevICEDPHknWAAPA&oe=69A4437A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqPdveqZXW8Q7kNvwG16OVx&_nc_oc=AdmV9hp-kPpilz_7rzQvgIVLP1bJeuBaFG0gbIOByrDLjZ1dSU3SqCqsB618yC_RflM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsZ1cHnu7u81jQ1LL6-mSfPuAn7qtRUCPqu-OYLo2YvKg&oe=69A421DB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kRPgbaYmooQ7kNvwF7P68M&_nc_oc=AdlcwukIeWi-UGULen2Zr_Udx0ZM2OLM6Cv8QcfrWtS0PZlQyCBC8CQEldtK9I7fun4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs8ZCpdBIqf8bWLCyBL_Wr7O_gmLqBDDft6oiZBo3qNpQ&oe=69A42C45"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVR1YAJaVSQQ7kNvwHhu4gN&_nc_oc=AdlhKE4jp5bacmgisMBOwICqFZdmCUYXcfzOsK5vxzj6caM2aQdWuYJ_NMbFid_lpls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuzorXhIyCv1C0MaXbj5J4NWrIQQ_SMZ4nhG87CqcbttQ&oe=69A444E2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxKSN1oGoMwQ7kNvwG-7Bnr&_nc_oc=AdnNYPaOOMplleAeLn0xIoHW6TP7S3UInKxO0rLWSfZjpv1HpRlgG6TqFzmLYyZ1-Qc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftpMrApyPULKmzEBcUlCosTyi9NwbtarOynS0EYfxyNug&oe=69A42B69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
AQQ2uMwIGWcDj7ofsK8PMOWvIy5G6AKNzRNv-FthiEjyXw&oe=6B05CF22"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGm6ejhOPr8Q7kNvwFpUQBD&_nc_oc=AdpX2TSHHhx4vjhPWn0sHboVXF0tfMJATW8K5RY_9AVTu3mmm3-Kgf1oh_VZfwg7h_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRchZ2F0OSJwbJp5BVYEteC4wIEMUy9PPkrXarkfXiUeg&oe=6B05B5A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "656413212068355"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1246754416505945"}, {"status": "PUBLISHED", "id": "4467677703299620"}]}, "baseline_offer": {"id": "1246754416505945"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752825060, "status": "PUBLISHED", "id": "1246754416505945"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28287207267554534", "version": "2026.9.16-1031"}, "id": "3639844742793554", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581490358552901", "is_concept": false, "latest_re
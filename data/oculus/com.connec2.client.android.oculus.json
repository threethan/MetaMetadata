8554274830014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiMx0FIzPlUQ7kNvwGB_beP&_nc_oc=AdlnmE0TQnQO5yGCtO_e2qMGpQiLxnNDfpHuvHp5dqVg_1saBLM1c0oQNtsgVusq_Kg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu1ygc-LrZJ-QtIz6MnXlIrH7qoSigVr2LZPmR1_DFx6g&oe=69A837FA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh206Y_Zb5YQ7kNvwEETVNs&_nc_oc=AdlY1qpxzoNmZxTmxME0W4Z8d6wJgMOR1UPvjK48YEbJI-iqAqgM8NKRZUh291osyOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsPISwgjTVQ6vgmTB_NSp-0KhaiiiOrl4O6wZvoLSfXIg&oe=69A8165B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0vLInb7EjwQ7kNvwEnm9Af&_nc_oc=AdlOshIDPxrs8tSlUXn7DiIxwT3HxI7vkpUVuNJp8UIbrtYRDfU1FPegh5qeOdoyNFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_9OllS-firusrxLrpgSPA-KOnQE0ihaoJAzk-HWH0-Q&oe=69A820C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk2Jw3EJx8IQ7kNvwGedCay&_nc_oc=AdmOHdHbDMFTVwdtaFL5fdlS5mR_P--pLM45yjGM7pPsJRYwmAm6hTQ58DELlxkicy8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJKdpxZDoMa2ynBFEDBwnh_q0FhQ9RnvOjDhMCMhRheg&oe=69A83962"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RIReGgtTr8Q7kNvwEOGl4C&_nc_oc=AdntWI53yHPXJpfwm566xnCvpCM5xqRArrxe0qGGZOd8bE7ygjr9WNUKuAgG3Ybj7Wc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftyypD-E7ruxut8-GowuRKRu0KPDH-Ql6PloaSBsezO5Q&oe=69A81FE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
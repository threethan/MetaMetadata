-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCs2Zit6VfcQ7kNvwGXWrzN&_nc_oc=AdlbagWwr7aJukBKnNz2p8EKVCegr3qguxxrvdpuifXY71TfUOX1_CDVoM93_AfIB8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsAKkZJ4aDYUdtPEUVctEC6gqSbUziJ87Xz-Aex6hk4Ow&oe=69A04EFA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsJnsXffEqcQ7kNvwE1-9uB&_nc_oc=AdnswWNe8Md8HfnAcEJEWlznTfBh9h0hqNXnNm3JPVhrKj5gXb2mwRkcDUE-_IhM6zo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIYvV-bfqwilOZA0oDwrOXeZS_JRJQQIGvVUT1B4uo_g&oe=69A02D5B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWnhJyv_YkwQ7kNvwHEu4u-&_nc_oc=AdkbLMiv0zL4WZJU_d3s-MByK1j4xf5Aq2khtaAJMf8ly_ExHXoKu7NcgP037D6dINc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxQwyKNMd1SGIJCpS5q63-4sgU7CWl4xBN7glMFqPImQ&oe=69A037C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZWabvn9edYQ7kNvwHN4WBs&_nc_oc=AdlcM_tdL4wxm1nVMyW9XuFeBo4KitfMapqbUhfRyakhgXctHjSVVi3QzmjWWi6nnS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPVeQhvBUKaJHc5C8dXs9oV8oir6HuEgAjXtwIVyBOtg&oe=69A05062"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rdg39ytF8YQ7kNvwFckGpG&_nc_oc=Adl3hI0gcq1O23E8TV3gGen-vX_ya5m4q1lu6GtPthqUoGNEExgiVZ1U4tHWGhoKuSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvPucvrdAGS02I8z3I6menRhf5iMXAFybG9MMbNoR3Pbg&oe=69A036E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
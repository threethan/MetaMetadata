8554274830014", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePlA8oSkXZcQ7kNvwGehkCn&_nc_oc=AdoUNV_7VDQpEuRFKTvo9vc-Pv19vbK7jlO1xbhTVcDX76Z-ygomXpM9LIIcBx79LFM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6JTNpBE8vBjGCFmQgz9jWgt4FCYnd1CL_-noDX-vt-Q&oe=69C1447A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-2-oMpL06kQ7kNvwGLjpVY&_nc_oc=AdoB39gBdyHlLZitw5vq04iTRBclDYL9JW1K3bfsWtm9OMImNhMlb5Q9peTwD5Gqji4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfylOAy-TVhAc1FdEHgRICF07fz4IC-ivmKoUFWkKMynWQ&oe=69C122DB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJJaA-GoDIMQ7kNvwGVE2B9&_nc_oc=AdotS2W8HoWJ7YHgTUPO8cYwCH90JJsNtl47eWtzNJGylr_8kfeK1uD2n_EZq5DnVR8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzwS3vyqonC6OuemXCWsvdatScMQOEJWl5feOGgJPrr3A&oe=69C12D45"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7L5a3P0D7oQ7kNvwHx4DeX&_nc_oc=Adr3GvlCembbOUpXI1qCL4z1OzZvJAmmhG9em7hLNq6LhYzihNk1s8lU-tkEiWWLrSY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzF3jYhWvX98xAMeubkM41-lngw8zoO11p_PZJE9lwJSg&oe=69C145E2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnIJLsIeJ7EQ7kNvwHFdywt&_nc_oc=AdqXoofP37QXDyCX9Z2LFf63el81ZVCAD32X8aC0ShYS7kJEpeeVKa1n1bb57kF1zpQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaAMSdIdDg4bULucJhf4CgeOHMHQliLJX53tYj045nAg&oe=69C12C69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
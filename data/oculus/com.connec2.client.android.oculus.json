8554274830014", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtKwZ2H8VUkQ7kNvwH1_R7p&_nc_oc=Adnf_Y5J1RdIioE5E60LMH__AuSfX3qHvc5k0FHxUWPuK_cWbu-5mtIyNneI_JlHzWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRSH9MIZZEEIzkzYmhV1cNHGSvBxFli3BKdCPQhu5tLQ&oe=69BAACFA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C09URkETIYQQ7kNvwHZnfkQ&_nc_oc=Adl2AcCilF7c-KNNCwzyYHSJ_wLwXhvT6mzcIc7RZDPEjR-nPDVfF12epD3H2rzYOTY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0lqCJ7Hr29fFqHpFguK7Z1xzdFZKAMndNjY-Tb-CvWg&oe=69BA8B5B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvV3hOcLz1AQ7kNvwEljNQI&_nc_oc=Adl9xh3iJ0BA9_9hO1RuAgPYl1JHJw_8GHOySelziO2QMSSEMvJW88kTvYBYcw8dujM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJmP7B6Nsso-Pmz41AYH1lsa8brpT8W1-fhnlijtJiEw&oe=69BA95C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sxe6yeknLoYQ7kNvwESbr-f&_nc_oc=Adm5RfAFZAtK__sWKzfti3iun1Ni8weSiq2piKwDCWfSoz58f6Vhohl-mpTZlBN3v2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOa_RlUG453MvLqXMxpq2m95ZnId09aEmFRnQNhcKuGg&oe=69BAAE62"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5SyNAqVueMQ7kNvwF25enZ&_nc_oc=AdkWVPGc1jNXrBxhqIOFVOLdOh-EnRETTsoNirGgOueNVWj4WSpxw0i4pOVlK6UqZDU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt8BEy2IKU3hYYaR99wc3Njhp9aZYkV3-K8MRwvAHnxQ&oe=69BA94E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
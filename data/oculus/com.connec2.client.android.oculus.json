-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQxrRAmcFB0Q7kNvwF_fGXf&_nc_oc=Adqy0xh1DFfl7CBKpMM1NE7aiAFDvJ3x0jq9R05yUQVkqbKvTO2p5VVRLljNJfNFpy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1HwgBvf_oTGzmWuHbU442_ow-8Pha6HGSof_rl3FNmZg&oe=69F0BA7A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnmrfdNq5tAQ7kNvwGhsMsp&_nc_oc=AdohPCRU8Zhf8HVRpx-9iXu0EjRjN_PTInt-XQVEC5hylIlT43WSG44aWXD_smKMN2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2-v6tty-2hamM9jI7lB7etDDKlzaClfG7VYOx8x97bDg&oe=69F0D11B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnkXfx8qLb8Q7kNvwHb74St&_nc_oc=Adplf4d2HBjmPLMZUSd36z1IWaGBH8eRmZSl3CUPhlODoS_KBiCbS2YkEQ-AbW3c1lw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3peO8Cga1OVRSuRJsT-todGV-P5wYspDyUPExvzZjBWQ&oe=69F0A345"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxYgMZCVc4sQ7kNvwFWjSjO&_nc_oc=Adri1J-uwWy9CEGbAGQ0hRcxbs2Q1IgX6CDWZUJdKRBtzAfXyS2FRKIvzKAFRyoV59Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0sznjHcrxnXaC5Oa024pZgQllIOWlM2bVczhk3hA0xBA&oe=69F0BBE2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zIoenzduGgQ7kNvwE4NUTB&_nc_oc=AdosByeCC5pUNN2uUxIbD2Nat_cOAe5Jweu5H93_-b0uAMf_SnFZBAsUVXZMXnzAbeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3CBN-0OWKCJ8-GQz4cDbYCwM8AMcMWJuMiFrRGMU5Xtg&oe=69F0A269"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
8554274830014", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5osNaqpH5MQ7kNvwHnoGXa&_nc_oc=AdnaxzpJY262Yr6BeO3k-5GqXyo07w6WPs7jfsOQDRzSYeIb2mEqTX6Owm7qLNeehz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkF25TygCr5MzQ5G6ASxivShImsgpACb5KdPPMQLnS1Q&oe=69B1727A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJNEoPnORQcQ7kNvwGY2qV9&_nc_oc=Admq43l5UBIiSN8oorVKOu7ERx4bGtiQ82gUgPiWl-niOj2uXbgwXui3EQ6UlAT3Jy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4SfPAZGhK1xzHP-rqRIh_8cxRSjoaVKtbD1d32CFhPQ&oe=69B150DB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyQAsi0rRacQ7kNvwEx1VBl&_nc_oc=AdkErSYj-gfRzBxDj456D4GcZOlNnQD0IsXj5X598tWWQGzbOu5Dlm8pG1LKwA4vmtc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfysPR40tnMIBTcADhCS7MZa9deoByC7kEjULm7OUaCgUg&oe=69B15B45"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tit-RCfVb08Q7kNvwEHUE7x&_nc_oc=AdktULsh61loDC3Q-EF_L_KBfc048tZ8pKUuUMi8ah4CgZsHxC9ioYV14E1zYJqvqKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQE3u_03967ZDFz8h7cjs0KfipazG6N-p0HOMohoYYyw&oe=69B173E2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ioC18mnctQQ7kNvwHVMbCG&_nc_oc=AdmsO7XN-GteWgtVnvJ3S0NHRGGEY8A2O72B7mH3F0Eve8eCFkCpQfq4cp60sJPIsCM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzY_OqosLK6vJTY9nPW6nvv-4P1u0Ug3JouWgD3lOw9Fw&oe=69B15A69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
8554274830014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TBsCVfPhc8Q7kNvwEFBQc2&_nc_oc=Adkr9N-2fYghO-DjF_0nUeeAKkIqJLPpmi7jHHhzl6tD--p2knE6coZhitai-prwJGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3hA8TLECAbFJxPOepS8tfn1CYNkhofyPAX2XoLwVU1w&oe=69AECF7A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJNEoPnORQcQ7kNvwHHOSID&_nc_oc=AdlloQOIfj1avjRLYLTTuylX9fR55XsSe6UTJ3uCsOulmC3bPTbQTJG-Q8iyWvP964Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK8O3AQXH2FYD9z1l5lkh9iMMU_WzH88LmWiDbdTVD0A&oe=69AEADDB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s99q7zUf890Q7kNvwHRgqMb&_nc_oc=Adm7gUnChT89UeNAN_XdJtdZ1Tln9HuVv0i2DjD8eITCHqU1oVffN8oCDBYWKPay1J8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxF59TpNGEbX8X6wODiArsj2DAkGPVL47GKAII0APcTiA&oe=69AEB845"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6EOsUiB1kMQ7kNvwE7V4A-&_nc_oc=AdlPKiP1TpEZjqzwBFGsTPZAQNjD3TMrFCD1Ftp--3d_USml2AeyYJqjyyZp3VfMmKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIH94MQUmMXjaa5mSkavXcoVEGpIuFq1sK5yssaykDUA&oe=69AED0E2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr8kQvm5CIsQ7kNvwGtgEvx&_nc_oc=Adl19OVgqTPv3_YuS0V17uAnVWj0c6EfA8MGywwOWUE981OUfjzjX0Vc7P_RSBeMKp0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTAJZ6MI2P8F5xEI9ZyWKJaPlL1scS574JgbitehGW0A&oe=69AEB769"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtPAMnSB8asQ7kNvwEii_9K&_nc_oc=AdksOIigqKdAmsE4nuctVzNac03h3p15fUvDbx2YKWk_NkmbiqR16nYk58eJ-krcS84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvFDMBxIXBFFx_mmjVBjyrKz631sHEhVgJNJc0GSMSIQg&oe=699B08FA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRLN20lonSAQ7kNvwGCjMKs&_nc_oc=Adl9Nu1HT7-deuPjIZ7KIgfG-BmCAiCGfVMF5ig_CwwETgxiU-a18G6b7YZ1E2rlml4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftsYVqpFuyNuZlAZJULldtre_Mpw2iJxAuKm8M5iGhoSA&oe=699AE75B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On0L4Iyj6zwQ7kNvwEeONfG&_nc_oc=AdltcW1VHC8jE-vcIz0oe5ZtowI4mO7yEsYisLmUXMhLDGKqIQbzVruH5vlkKGlZoAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuU8XWyWOLw9YyEC8hGwtUcfk9yRcNEe4WJpRemLkS4Nw&oe=699AF1C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aptNHiIFy4Q7kNvwGJRK_P&_nc_oc=Adko6pJCXojynNpvtZxBX6L78AwxCmT5gtgo9aHXKBAvqAuTZo1wWK5nYPUXjJVxIng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvSAX5iThS5IbZL5omQ_grjrt0muWVj5WIH-_7SiupzFw&oe=699B0A62"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lDtPqMvnCQQ7kNvwEMxdu5&_nc_oc=Adl6WHfJF8YuB_LEwgGQwr6xmD6hY9FuRrwegM1wf2BL_iAq_aQupx58UUMFTK34vc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvPdl2YXflhCHTjt0BP7ehtgdVAk2OCjZpZnNyI1zHxww&oe=699AF0E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLlWOdUEq1QQ7kNvwGJhID_&_nc_oc=Adn4yRgyIAyBtoospE93TN_ieUNjkh9kQ4L2Rqs6APQh4uWek1IkTuWlDy7prxTIlK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvSUC-IU0gxd2e1Mj5j27LQo35uWgIH6ZgxXN79BD6DcA&oe=699DABFA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRLN20lonSAQ7kNvwF2aEVP&_nc_oc=AdndTJ9UH2-CXZZKiPhIj5ALik5u_tFmKbGq_vM3KTvUxm_Wg00arC4oLAXShF5ng7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfubfUd2FZyqtz5A_XQynm1lF_3iwbM7-CiBvKLL8b96Zg&oe=699D8A5B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=613PB4aiizUQ7kNvwEsFFLe&_nc_oc=AdmnrH4AbkcWvYpu66z7axC6JJXFHbOf4Gq5nvxx8r-OLPfuZvmRcNTbNxXqPHcaINo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuAQjjYwmBzxFcWVAallb0gwcIjMZ5s7OaUojSq1Pv1lg&oe=699D94C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZWabvn9edYQ7kNvwGk1o38&_nc_oc=AdnnlrT8ouvouthOLicJ4t3EHrnkVe4a8Roe76POdu7T2obH7Wun88Vi1iumcLI0a7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuyoQSCN-SPG1dz3LRFP9X33gnMREcqlxMCOp6g_szcig&oe=699DAD62"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rdg39ytF8YQ7kNvwFXkRIw&_nc_oc=AdnUbNX3NPNXN07nj3P9v1EoFe3S8iUY1442VLrfIOiOWtWNZIr4tN5Jap8b8c2f0tw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0z_gIjaEhA0Ez8ppwZBoBXq8PcXtYI8G4MrCqkRRDbQ&oe=699D93E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
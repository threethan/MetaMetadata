8554274830014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5osNaqpH5MQ7kNvwF-1Aes&_nc_oc=AdmIBPfqQoZNsWq3OA97SG-znkmssFTw3oKh6YHlvPOhsMydoSrwYtOWn6YlnUGxHAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEcvqey0gmkmoOElQGOUPif2hmmdHHQ4zNzD1LhVuDoQ&oe=69B2C3FA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWL21NuQUYIQ7kNvwEfCHeh&_nc_oc=AdnX4-7rtAj5QxvWAAyWfK3dmU3O-j3UhMAVgbBrBfBj0lIrILGdidLa9VlSDJU25BQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxD0BnfNhdN4eD5y16mOnX6ZBQo5IAuYglfUn_EeTnDrg&oe=69B2A25B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyQAsi0rRacQ7kNvwHLf1f7&_nc_oc=AdmznTkzU8zzb8EeswoAnlVS7xpAFvnrZesCc2ehvLPESjx7Z0_3xYUv5a7qylWu-nk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzraVEdrFhf-p7e-kYgS3eVaFFsG4qRb-q5WBULE9ei6Q&oe=69B2ACC5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tit-RCfVb08Q7kNvwF8UzPd&_nc_oc=AdleYYFpr20OB8ijRtwZyMHRF6IQJE_8xWYreXvsW7_jnRzJ450nxHD2zEGCCED-3J4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKzxeLCV-91fQo1f0JIFaAtvNjQ3ENnegIV0pjQ3U1rA&oe=69B2C562"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ioC18mnctQQ7kNvwGgyoct&_nc_oc=AdnR8uqKQXxWLMAeDdsyMkjdCwQNz6uKW5_2rFTOsUkKrafUyaGhw-tmCoi_DRBwCcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZ2gsydRk6jkC58CP9FQUfw_h3vc6uchm6eNfYYpNhiQ&oe=69B2ABE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
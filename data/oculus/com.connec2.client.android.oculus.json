-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLlWOdUEq1QQ7kNvwEHAViK&_nc_oc=Adl9V_YltVzBu-X77eGtQosV2Wr_CPF3qgnEe82T1ab9hF1ntUYy-WH9IvOKj_q2bkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftvO5M9voJ4X1dDTIA9CreuVLyqZ2lqtM1a4Q-B2C9_PQ&oe=699C5A7A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRLN20lonSAQ7kNvwEY8GqE&_nc_oc=AdkQWGA0cjdHXPIY0gNtz_oGi8u79XvqEeqbTTP-Vx3sO0D9hxMad3SOGxlmWuhiQ2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsksfFHLgnl9ciequcR1zeDVx0sz7o-ZaT4EfvHKCFp0g&oe=699C38DB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=613PB4aiizUQ7kNvwF2z5RM&_nc_oc=Adk_x7DQCl5VR0Kaa0tde75mYOFhmsjFWFVpBba9qZziMWKfCjyBemzeauTkatXdF_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsCETI7zgPBrJnKWYHROjMo9hMOeJ2Yx0I8mzeo2e20dg&oe=699C4345"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aptNHiIFy4Q7kNvwE5BZUt&_nc_oc=AdmSsey2SsbcPpmmFCYnrqGfAsEF8J2aytzSvtCJV9rSMDcAVk8GT23fmlLZZkD3m0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfusH3n51uE5yiUkYTQDU_dZQcFJ0f_jYh5yLOItfI8CYw&oe=699C5BE2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lDtPqMvnCQQ7kNvwGDJTf3&_nc_oc=Adkt49ftSIqRpjmYtwe9CGyhRtrogyJo4NwzIJV2V9f830NEML05VD3Pm_nKJZR0nfE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs4tVtPYylS9G7fO3q_Xd-jCK1TZL86LPRKUNtBZscWgg&oe=699C4269"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
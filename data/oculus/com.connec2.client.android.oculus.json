8554274830014", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty6p9idI9oYQ7kNvwFdjB1S&_nc_oc=Adn31g5WUrcAnCCvR-JZ1crmasvbsX6krnrzkbr1QX6ycGv7CThNjtW54-4ZIMFPqsM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcK_8VIlmsT2UtdnHRWtfZtFe9TsoDFBrrgSf3JCa2JQ&oe=69BD4FFA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C09URkETIYQQ7kNvwEM_Uwl&_nc_oc=AdlUFKtjtTECdrDRsvOe4c1dmYET2RujuXNOg4Ky3HgZ0u1DrGa4FERnGQfeWIiQa_Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwshvXzL2ZOJ-rbwoPrefUtvo8zpk6uPJkFG6b9KkdPgA&oe=69BD2E5B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgmCpSam1XgQ7kNvwFT5oJF&_nc_oc=AdlvKUMfyEB5V_mKwmma7iIrEdWnziYVjwbBasmowjy9LYykauh9W524Vrx46cWZJmQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZy7j9tSqQcXmdfIkv_AY2vJnzdYFQ9XI1TYgf4XtAOA&oe=69BD38C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilckuN532SEQ7kNvwEZe4EY&_nc_oc=AdkklkqFXvLFELwUub8FJCJZWV7kVD1CAYDC7PkoDgvJJQ3y9gM90KW2pBZPwoGtY3M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqtMmg7Dy3O17whZlyM9m3WBF_KdhFI_XeanA6H6azvA&oe=69BD5162"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vf2VvEmrLMYQ7kNvwFPI-j3&_nc_oc=Admb2iroOdKDCfENgUhl8napvfOU_XUE3_c382vxLBTIKKcEYeafa3suFd6tuDs0Gb0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEICGD8VOgOqWLmMz0q64Vb1GZvzMfVSsKOM12yiQSNg&oe=69BD37E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
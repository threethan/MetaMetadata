8554274830014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TBsCVfPhc8Q7kNvwENKe9O&_nc_oc=AdkeEEvGHyBljUx6YBoz-ktGYkA2T6tvf2ojbPVed5qXD4xLQYsGLDaTgsEQ9vDkKao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzR7XcEqDRjx1u-RR_nADv0Oej2s8jBoHrYv5E1YTftSg&oe=69AC2C7A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlp9Nw6KB-kQ7kNvwGwZqCY&_nc_oc=AdmY3Fw2GaGhYNIvbKbtsvh_rY43J3eNO6uSpxyu7MYPsmvilXukmaK-W1UBADFX_Dc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuuB4g8_phlvUndmiLTFQyfhQU8ekuAop2ZFa7VL169g&oe=69AC0ADB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s99q7zUf890Q7kNvwFBQkmO&_nc_oc=AdkcmULafcfhpx98tDIMLJg6zech27-haH6D58Cz75c7E_77aSzW6VQYqyBds6GUHGM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3x7kF3wLe5BpWy1ycP_4VrwmH4oVgA-dccSc890FaKA&oe=69AC1545"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkGP9jmx3CEQ7kNvwEP4nLr&_nc_oc=Adm4Mx_vu0w4VbX0VOWf7UUv8tfvCCXCUXTRLw3-douG8Shzk_TC81x91h5oASuS-Ds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7itq6nktG0OBanjnJFiI6WOXzrjWFPEHvBfBqh7QtGA&oe=69AC2DE2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaN5ZRvKXUQQ7kNvwEYvLaq&_nc_oc=AdmYhNgHu1eNRqlZrY-XlBZGh30Wo3QJpU_xmjJ2EjKkixGCniCawGrEdylopmFEmK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwNa8QqHC6OtVU4v_WI8chjFuzZ48fudDpwpkoFotniaA&oe=69AC1469"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
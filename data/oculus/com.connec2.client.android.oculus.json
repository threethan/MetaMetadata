8554274830014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtKwZ2H8VUkQ7kNvwECIKF3&_nc_oc=Adl9GtfnHmVQQa9hICsoLjcdbpDVSrxjE4Sflp78BfxgLjq-ccuC57ceCsmbb8xgOMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw37uWcW5T8fPwRycNtC2nRVUnpfq2WsAIXzVAPSkNC8A&oe=69B809FA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93gqM53l_EcQ7kNvwGOBpKU&_nc_oc=Adke_fupreiSWyquujVONluGBAqEkzFy_il-t9retqXVD2gqpb-muCRyT7Sc9AggR5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-l07d2I4WkcNp4X19-bl6x0hUTWnnZE-zidqZaylbuQ&oe=69B7E85B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvV3hOcLz1AQ7kNvwFJ8GGY&_nc_oc=AdlOAQ_fuuOk_OUKFBkGmxe2wYzeosK-6si5hbS6Mxly1r9JJ0jcQiUUgPCwdjQZmTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRlLPy4TsmHEVMHxY0-CPNZhCSVHKV-v2OFTuDOFbdvg&oe=69B7F2C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePo43tjVDMkQ7kNvwHfGKFb&_nc_oc=Adno8yu6xTdEkIuogJMv5R1p-aiGV3-waD8stfG0Op0wrhIp5bIzjdwFzy1tUOmkrT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXBkdj0bqdhnFiA2UGzoGuOmhh3GYeIGeYFhFBA1LLUQ&oe=69B80B62"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFUvoAQ9bi4Q7kNvwHtPSwi&_nc_oc=AdlZDcBrfa93YCtbyCu-g7XbSPaFersX2pZZNKKe6_kd7Z76EJ8aX4FBTdoD5nZqAy0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afycgoca-OTv5w5pAvhIZEK8rqGRh_7jbcstmIOBfOOTXA&oe=69B7F1E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
: [{"file_name": "screenshot-01.png", "id": "4118554274830014", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBHluSEK5skQ7kNvwHkEIYl&_nc_oc=Adq-xyA9VH6i4L8zH1SofWx7BXII1hK9146-8S8FchU2B046DPQdqcb3YdkspiPtKlE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWXmLiqfso116BupMaR19k_0vJHtSY1pwefCBAqovYbQ&oe=6A8EEE7A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYT0344NTQ4Q7kNvwFJD52E&_nc_oc=Adqw7TNEXwYxJTTZPsOTbKxNbfI3sS5j0cETYgOFjvJwZyRxs593yvHhlg2gNif_Q3Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcEN2qHna8C9KbqKypwR5PjtfY2rYBfSgZCQyJx4Kc6g&oe=6A8ECCDB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRaJrgXPnU0Q7kNvwEbFqmt&_nc_oc=AdoPhgyfVojCRb1owa3dCuk-epqqSGNo1Uh1ThKGlpoXlXNmLK07PTHDJoRIcnKcauY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2CnIR9GlAuhwIBluw1lktCG3iftwsg778pJlWBoeqqQ&oe=6A8ED745"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I9kzQ4tt9EQ7kNvwHvj4B0&_nc_oc=AdqwNLQn6NV-65Lru6vNWE0xBeNDXv5CWVDz-FeSt3OYeH4Ylav3zLrFsxTR9mY_7xI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3fH3cE4Vfq18bm3_PAcjRMDU8jBGZZM9vKUhucn29fQ&oe=6A8EEFE2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z89jRikLILYQ7kNvwGcjvjP&_nc_oc=AdqtVCT1DAgtvQH0f0-zRJQxCWSQQXWiy_c2OM9etIDb2f-qqoQPoDYPTlwPY3ZMuN0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESOTQWbpcuvRjkT55c9BiBLM4rN7K-0bL7rLYyMgUr_g&oe=6A8ED669"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": nu
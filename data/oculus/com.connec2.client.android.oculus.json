8554274830014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TBsCVfPhc8Q7kNvwEwyr6H&_nc_oc=Adn_u-CNPsOTwzUciLKsbxB9b2cNGN_3iOdsMwE6JU_nFsmDcVuGRryhwbK3kGw9kHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFiz7ep69xc8Q1t0Br3_Xbg5yYm9RsjnAHEpOZ7dVv4w&oe=69AD7DFA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlp9Nw6KB-kQ7kNvwGrPujT&_nc_oc=AdmwkOnUgr02vGRwM7PR9xJmLEsgMklU1m0Qrrl666vY6_9DH0ZhFuWpLPeXqIA6VvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLnlDDpgffNyrinnkvGWR9YpAvMq71pMcNFWFrYEXmlQ&oe=69AD5C5B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s99q7zUf890Q7kNvwHlbCaF&_nc_oc=AdlFF3Pr4r8vzuXOXUvkggsQ-2IoK_nteZoQy7R5OcecCIwTlXE5413Vo5S4flA8ST4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNkBfB_J3t59h-UmX8mx4EQ4u4eF7mTVITpyA00HVoIA&oe=69AD66C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6EOsUiB1kMQ7kNvwHjlUKq&_nc_oc=AdnK9SN_wDQ-Y0Vzomnyg6QwX0Cr6dxK-DQ_cQ6k5C8TdNP9ABEJl8sNn2vf11ZV8Qc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdrsMBowRD3CVJ7-AztTcf6dAwkSyGfZQYxZFg01t6rg&oe=69AD7F62"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr8kQvm5CIsQ7kNvwEoV0Jt&_nc_oc=AdnEVr6mb7nekQlMK9ksSE2o2X-yDXiil4XUaHI8hDwaZbaD7_RoGDAn-LnQYRQq54Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPiDvbliv7bSl7fGiVAKmV4xkOnW_efFQZWufzoQa9oQ&oe=69AD65E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
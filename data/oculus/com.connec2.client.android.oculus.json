: [{"file_name": "screenshot-01.png", "id": "4118554274830014", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBHluSEK5skQ7kNvwHQWDQR&_nc_oc=AdrocAuY8B2voF4ue_S4XN7KW9g_4g-sN8uPbVtO7qiLSDT7UaWSIquuU7pLVQYJUwI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqedpZIqExeO4ZUvTdDcwdZsSymUemRtDGEiC7w5mlwg&oe=6A8D9CFA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYT0344NTQ4Q7kNvwE1AV0X&_nc_oc=AdqNhSTW-sq2p9Fx2cWIW9W_lR3wzignDBLnQsfEJUBR1HvBtUetrnOmkdUbvqNvao4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8D_sh3C1XsCrk0hpbbFJ9NKDKT_57SVK9UQP6z-Njwg&oe=6A8D7B5B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRaJrgXPnU0Q7kNvwEd1khE&_nc_oc=Adq4smcgqEqJAbrYPSISM9nW3uR05-NEBQTGVPQniVrnQpM0PbPn9m90oTF6B1921Ug&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnFMx4CthUTzGgP8BJdjKjQxpUQl6EtBXH-7uQ6vTmFg&oe=6A8D85C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guQRrlbWvLIQ7kNvwH1h_ny&_nc_oc=Adpe2DZO35dVWE2CP1beWd3jMEHbTOes3_mfqssQrBPbS2woJGbCziQIOaeQsX64Gmg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCOb4pVPskimouWLRLT30VPSFRVYXAdn30L8Ky1Xou6g&oe=6A8D6622"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XrgwKCp1fkQ7kNvwE0KOeT&_nc_oc=AdppVgnYaHRyqd8jeIG0L4LKIcIa4H3aTJDOclcstrlJjxQLYDlNhIwVtUc7J6me1bQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2ORxz-bYfy-PxH0G_5selMHqL6UtUxNOwfbHbvsuBXw&oe=6A8D84E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": nu
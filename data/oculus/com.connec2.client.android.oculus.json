-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQxrRAmcFB0Q7kNvwHAlGmg&_nc_oc=AdpuSdGlRtQ7zzz3bng7uVC_HgA0uAvhYAxCKQnrAFUV-R4ebdvHjv70ggZ54pGl4Cw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aU_4XFqrBmRez2pjqPkxWWNnwKoVfkpJbSbOnmNiA1w&oe=69F20BFA"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDn6o5VYA8UQ7kNvwF_kWg0&_nc_oc=AdrzoucfkGo16ipKdiXiSfxZfiXFVSw7C-wiVVZBpG_niKvwm6cP9wgs1Z7eQFZ9kt4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1HTvVxhiKg_rMOufNCxq4xmv6tr0IywOWbK68y2PF13w&oe=69F1EA5B"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnkXfx8qLb8Q7kNvwGlJQiu&_nc_oc=AdpeHwTdUXsPYav_4YTpA9cIQ2n-KPAy00A2cHECec18_fE27OwhayOm3Ke3FSgN_r4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2gMd9R0nRq9LgfUvL3nqSiJ134rhJI4fSJYrV96Ut8cA&oe=69F1F4C5"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxYgMZCVc4sQ7kNvwEtPk4H&_nc_oc=Adr_8sheIAN9Kekh5SIcv6d8iCCFhbVGYpznc79ooXYM-pQVWtn5XtGusBfOsQ09foY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UdNfn11B8sAHsMHbwdr8dMDaiy_lnJV2L4Dtq4HW4tQ&oe=69F20D62"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zIoenzduGgQ7kNvwFMnV-6&_nc_oc=AdreC3cQDJ7RTuqd4lY11t79I7lQi3GbfVW3MGyYyyE8Yuj9sxRx5jBgq3Xz0QFTo3Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DaPHdYQcZStSEuYmXNxjprf6H6r4CF2hXNtrgyIhPBw&oe=69F1F3E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_url": "https://www.connec2.nl/", "category": "APPS", "comfort_rating": "NOT_RA
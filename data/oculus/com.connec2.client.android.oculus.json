8554274830014", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210888_4118554278163347_359283578949401058_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuVeA9tZWWAQ7kNvwHpM9JI&_nc_oc=Adkk5DylMzLwQVmIaKLoRMsFk4nyZZfj33u9Yg_Q0iMOXc0o2VybY9zIq9r8G16XYcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwencbhYc9Osljq0gqiTyPxMb_jWoYquQE5tA-dreddig&oe=69B6B87A"}, {"file_name": "screenshot-04.png", "id": "1346984442322978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75441575_1346984445656311_7706206679617229900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93gqM53l_EcQ7kNvwHeO0cL&_nc_oc=AdkZ057mPfhav33wbAsRASwn6XEhJ5xrj5dft4Oj1pzunxMwgfo79ghGETVi5d4eWpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpavM-RurVhjCpXyixfcyRRfFGglDEheV3RONucN76vw&oe=69B696DB"}, {"file_name": "screenshot-03.png", "id": "402747491024878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203616_402747494358211_2050101815381632839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kytKJJ-KnawQ7kNvwE3VeCl&_nc_oc=Adlt6ZYSOiqAQkOIolXY9QTIdekDgWat3KqtqUmZPIDjm-Jar0QA4jejIF0QOkJj5O0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzv69ZkKkceR-edjc6hH8Pc6n4YLxr9WrvS34sv1NRVoA&oe=69B6A145"}, {"file_name": "screenshot-05.png", "id": "256597249171074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223482_256597252504407_8202704261418037104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePo43tjVDMkQ7kNvwFNb03W&_nc_oc=AdnUnTAlfUgSgg1ajklbVpOU2elMAtzKqnDj6aI_hjgsLYinto7tvZ_fYFmLdcgNNKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFdzCwTFGvli2VuQtZ7TpLDry5749XyWdAizEhN-Tneg&oe=69B6B9E2"}, {"file_name": "screenshot-02.png", "id": "3851774684884319", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001667_3851774688217652_7403266085046640822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFUvoAQ9bi4Q7kNvwFIQ4Iw&_nc_oc=AdklErPOfMYGJwgQJX6MPYwSMagIFulOBThGYbR4FjtZCtU5mpy9SXcT0Bx0l9hZRZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoJj3GEb_ZzleGM7p5KbZ9SOOQfeWQJNYmiOX3f8_J7Q&oe=69B6A069"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Connec2", "keywords": [], "long_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers an accessible \u2018XR as a service\u2019 solution. Instead of developing expensive XR software from scratch, Connec2 allows teams to effortlessly meet, publish and share content in order to start implementing XR today!\n\nConnec2 offers both TEMPORARY and DEDICATED Workspaces to meet in. Both TEMPORARY and DEDICATED Workspaces offer all features Connec2 has to offer. \n\nYou can easily create a TEMPORARY Workspace within Connec2. Other people can join using its Workspace Code. Within a TEMPORARY Workspace, you can host meetings with up to 5 people with a session time limit of 30 minutes per session.\n\nDEDICATED Workspaces have unlimited session time and more users.\nVisit www.connec2.nl for more information about DEDICATED Workspaces.", "short_description": "The virtual collaboration platform Connec2 allows you to have a lifelike social experience in which physical distances disappear. High quality voice, precise movements and a low latency communication provide an endless productive experience.\n\nConnec2 offers TEMPORARY and DEDICATED Workspaces to meet in. Both are full featured.\nTEMPORARY is limited to 5 people with 30 minutes per session. DEDICATED has no limitations.\n\nVisit www.connec2.nl for more information about DEDICATED Workspaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://connec2.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Connec2 B.V.", "support_website_url": null, "website_
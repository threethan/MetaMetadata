93054218519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_1245493057551852_6351183302965020997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTMRwjDd6bkQ7kNvwFTJFgC&_nc_oc=AdoGCnnNIqeW9ItYpXxz1ZHOI3AGsp6zMaKPRV9yEOcdZRLPbPaAuF-qnCZGMmrYAAI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ToSgaZ7PiHiacdD_ZVOrx-8WLiL9d8nQ4mbT__Wr0sw&oe=6A159F96"}, {"file_name": "Screenshot 2026-02-18 140115.png", "id": "2140962966310042", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820855_2140962969643375_3475160287218354276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzDtTt1cOYIQ7kNvwHmu-FN&_nc_oc=AdpI_txQUiRV9FIrBKpkgRv6wLRZ3wiDgGLT_y9yE7BcSlP0NgDID9BAH9H-IvLkcTI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SPkdEtpwcCbiS3I75p7-vQ2v1ZEdUJNdjElaSDwCfzw&oe=6A15C5D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Company", "keywords": ["Horror", "Scary", "Fun", "Gorilla"], "long_description": "Primal Company is an intense multiplayer survival experience set inside a mysterious and hostile research facility. Players must work together to explore dark corridors, complete objectives, and survive while being hunted by a powerful primal entity.\nCommunication and teamwork are essential \u2014 every sound matters, every decision counts. Use your environment to hide, escape, or outsmart the threat as tension builds with each passing moment. No two sessions are the same, and survival is never guaranteed.", "short_description": "Primal Company is a fast-paced multiplayer survival game where players explore a dangerous facility, communicate under pressure, and evade a relentless primal threat."}]}, "developer_name": "Primal Studio", "developer_privacy_policy_url": "https://sites.google.com/view/primalstudio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Primal Studio", "support_website_url": null, "website_url": "https://sites.google.com/v
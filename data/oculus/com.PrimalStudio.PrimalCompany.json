93054218519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_1245493057551852_6351183302965020997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch3PL9QueSIQ7kNvwENnoiK&_nc_oc=AdqxFUm9B9eIfdCnj19mOVM4cvnEyf-FQo-HbV5wNWSokJyaEzxEZN7QWmQt_IgeqU8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HsjEWAQoHkmOwoZMA0mLqqcLYm3zp5n7-lhsEwEKM4A&oe=6A071F16"}, {"file_name": "Screenshot 2026-02-18 140115.png", "id": "2140962966310042", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820855_2140962969643375_3475160287218354276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh9JKfFWVmYQ7kNvwGUHCkR&_nc_oc=AdpeBcGpJvGQQWMe9RrtuAECbYi1t17vmqb7ISAAzUpiST4lWhdv1Z-dMFzK5jpGd10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k6j3EhO2S-He29GdXf8XnIu13znXkxjCw5BZff1XJ-g&oe=6A070D13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Company", "keywords": ["Horror", "Scary", "Fun", "Gorilla"], "long_description": "Primal Company is an intense multiplayer survival experience set inside a mysterious and hostile research facility. Players must work together to explore dark corridors, complete objectives, and survive while being hunted by a powerful primal entity.\nCommunication and teamwork are essential \u2014 every sound matters, every decision counts. Use your environment to hide, escape, or outsmart the threat as tension builds with each passing moment. No two sessions are the same, and survival is never guaranteed.", "short_description": "Primal Company is a fast-paced multiplayer survival game where players explore a dangerous facility, communicate under pressure, and evade a relentless primal threat."}]}, "developer_name": "Primal Studio", "developer_privacy_policy_url": "https://sites.google.com/view/primalstudio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Primal Studio", "support_website_url": null, "website_url": "https://sites.google.com/v
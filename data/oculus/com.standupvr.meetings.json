VNCYRMyXIrHD8sHwNj3KW8MAoO5D_2iualtbKYk5Dg&oe=6AE4BBFF"}]}, "id": "1129142299660187", "locale": "en_US", "screenshots": [{"file_name": "03-golf.png", "id": "1351766433561736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1351766436895069_2050890642447425682_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yI8p_0AlkJYQ7kNvwGdL3kG&_nc_oc=AdpFzhJERbymaV77WpNynTBqhnOh8CJjzdnW5tS_Ri7EuGp9nVPTllt3v_lZLjitVy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXX_0gl2gP77_zn6mQNuvchpYBI5UPY-Y7-tbZRtMlng&oe=6AE49600"}, {"file_name": "05-beach.png", "id": "1147822107922481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827646_1147822114589147_7265711112823890383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAtOKPs9v88Q7kNvwEE4N7Q&_nc_oc=AdoMj7bVZhecpGc0_vGoT0ukvhi3_6iibXmg_JRDDux0zXG5qe6yw_gZ7TXNUc7XIQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZuLYlOd-2mSmS7_cjSWX-JEBP9vPPx7kDI8rwxG7w5w&oe=6AE4A864"}, {"file_name": "02-lounge.png", "id": "2929890294033383", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_2929890297366716_3374565275002758143_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-_QYHP_2-gQ7kNvwGHrMmn&_nc_oc=Adorx4aKhmTkUbGgvVbOMz_5q6AW6xbjUD2g4JF-ktc3VW8lo9heArR5JBsWJiKIjTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgG8yZFLI18WiuP9kgEryUeIK9p5Jwlv9LDXKSZNOhzA&oe=6AE49A93"}, {"file_name": "01-studio.png", "id": "1095936856679975", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1095936860013308_8551270153675075052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NtnB9yjRqoQ7kNvwHTqC6L&_nc_oc=Adq5do9lXS2QVTYn88bqKMbF2fDfgCh2s1hiQw5r_0nSEmdLzd15HSIo7M8Qzgmu9AI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdmNcj46UfqQSOo6u-I1eKbuKh0YIZrtW62mP0JogzcA&oe=6AE4B4E8"}, {"file_name": "04-reef.png", "id": "1151850860711975", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_1151850864045308_31084685525528392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jLSamsQhOoQ7kNvwF1DtRO&_nc_oc=AdprHmGyVxC_9v76NT6HHeJ1pb4wky0QjSwMo3vTe5g_GNx-ZOEtAzfCgQhDcqstZdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUZiAYlkqhTZPHA1qxgnuqH80_fYgjWs19CWaZCoK7vg&oe=6AE4953B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nMeet in a warm studio with oak parquet, an ivory sofa and a slim stone table. Host an internet room, share its private eight-character code and gather with up to six people. Save the code to rejoin.\n\nPut Linear on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac and share a tab or window. No Mac app is needed. Each person can enlarge their view for reading.\n\nTalk through optional spatial voice. Upper-body avatars, visible hands, pinches and Touch controls bring you into the room. Mute stays close in the small movable menu.\n\nPass the shared laser to guide attention. Take the putter beside the cupboard: putts rebound from furniture and carry into a recessed white-lined cup with natural contact sounds. Scoring moves the hole to a clear spot. Use a trigger, grip or pinch for tools; thumbsticks turn 90 degrees.\n\nOne window button changes everyone's view: a garden with a river, lily pond and falling petals; a reef with bubbles, fish, sharks, turtle and ray; or a beach with pier, sailboats, walking crabs, gulls, a monkey and distant volcano.\n\nSettings adjusts shared background sound. Saved rooms remember scene and volume.\n\nInternet is required for online rooms; voice needs microphone access. Free-service availability and relay quotas apply. Personal Meta avatars depend on platform access; presets are available.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1362849600248003"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1438514494913094_375627150012950182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbC2EFCMkH4Q7kNvwFoE8hg&_nc_oc=AdqB0Jil0G9DES6M7BTOE-r5TEOpp1m33Ihtx6KOc9-Du6yc2m5YFubP2odh1Lupalg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIT1-9M4aK8HG-kt_4IwtAr6iwC-SYrZmVGdPc6KshmA&oe=6AE4BBFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StandupVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1792755120, "lastRevision": {"nodes": [{"id": "1354246951108268", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1354246921108271", "is_first_party": false, "enables_in_ap
A118A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IooMGc7CZmMQ7kNvwEi13jX&_nc_oc=AdougV8tAL6rZ5lidDq5qea_y0QwLjWUabGYKTRWvx3nkhe_EkAS_IsC4GnReG7PWB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNzpbq_6qe-X-lQneS_EJ5XU8sL0qz1vGsG4Rl37ER0A&oe=6AE9FF23"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIgd1_Et8HMQ7kNvwFQ8-gu&_nc_oc=AdrW6fjQ7QPR91l3bU8Q3KFqnwrIvkitnigUq9Gmc1rrylE9fJmpJX0k_W5f7kTAJww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQgVzXTn4nG1nTB_ts3UfWofd0Yr0-m3qKZR1lyzHqWQ&oe=6AE9E229"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg5Y6_MGO3YQ7kNvwHz01FD&_nc_oc=Adr4cKZbI7K50OzKXEXsrbcu5AliHXFm4pQPc8aW_49zCurhGxMtfPkM87eJXapV81c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeZLkyJCjgRCsd857sHa9nqr84tkfKYgrPnV6qyYUV8A&oe=6AE9EBB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1354246931108270"}}]}, "scheduled_of
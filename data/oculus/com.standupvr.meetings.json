png", "id": "1438514491579761", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1438514494913094_375627150012950182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tkxxxXYI1IQ7kNvwGq1g1-&_nc_oc=Adr-Dy9Z818bFIXpAC39XtQHjkfapiUQ647rJB_jyZTK4h5iYlZp9gVloHCFeF8SuEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs6GbtlsSil7PX8jYbp89eRcbN636ZCMWm-8nCuvB3Fw&oe=6AEA01FF"}]}, "id": "2183139772628350", "locale": "en_US", "screenshots": [{"file_name": "01-studio.png", "id": "1908740056957814", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_1908740060291147_6102894277546249540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ9OKfVqOHEQ7kNvwGjIjhT&_nc_oc=AdrkBmqIsGsRsbHpQA6tk_eJAdE9fjj7fzoLpZ8K056hZrU2NQzp78rIT4x9EBwsqfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsVverh-zP_rSObMSNFjT88OqB3sfdLztekFhFQFROVw&oe=6AE9DF48"}, {"file_name": "02-chooser.png", "id": "1790609112138292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1790609115471625_7170418732009412944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7G8Y_7W4D4Q7kNvwEMplvs&_nc_oc=Ado7n10iKqv8kg3XU4T0cndueORQZ8VYvyoxrZXM5V4EoMRNKuKrMq7OZALICBCWNrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAPcZuABXnwu358TFuz6lP-PCu3iENxJWzwYEq-q2emw&oe=6AE9DE28"}, {"file_name": "04-reef.png", "id": "1035374702959196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_1035374706292529_4696675643612899560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdm_8-m3pAwQ7kNvwE4GFpT&_nc_oc=AdoPUhRAKZyQVCsYrAUoyjYopbjrh-piArwFfYmMtZC8XqMc7V-F4RQSQIgfF5ibM7I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpIiSkXTmAR1e669Tm0PbDB78BMExkg6TIunWJL46yQQ&oe=6AE9E63E"}, {"file_name": "05-beach.png", "id": "1050828934642492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1050828937975825_5789532268597842098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkC56WYfdmIQ7kNvwGHy1Dg&_nc_oc=AdrI87PES5prksollRgh2ASEdpD1yhVGv4kDkFPwidfHDBSRI3qG-c3O9RCUL8O29AY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0voqoWwLdlozkHRbBLLWoS4ZLJZbDdpg_yad66rr3Hw&oe=6AEA0564"}, {"file_name": "03-browser.png", "id": "1644903533737937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1644903537071270_6649769477703179962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW6hWG0aOgsQ7kNvwH2VWE4&_nc_oc=AdoMWa153uENve-u6jWhtNubQfF6ZcIoRb1hHpd18I6j-DVjnu5cNpLoDxh4oU7E4Bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYwdcN02bVitPTkq0_3htEtH3z8YeWkNaR7nyEkS5zfQ&oe=6AE9E687"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nBring your team into a warm virtual studio. Host a room, share its private eight-character code and meet with up to six people. Save the room to return to your next standup.\n\nOpen a website together on the room\u2019s shared browser. Pass the laser pointer to hand over navigation, follow links and scroll through the page. Add named bookmarks from standupvr.quest/present/ on your computer, ready to open in Quest.\n\nPrefer to present your own work? Share a Mac window or Chrome tab at standupvr.quest/present/. No Mac app is needed. Everyone sees the same screen, and each person can enlarge their view for reading.\n\nTalk naturally with optional spatial voice and expressive upper-body avatars. Keep mute close at hand in the small movable menu. Use Touch controllers or hand tracking, with 90-degree thumbstick turns on controllers.\n\nTake a putting break, or open the window\u2019s miniature scenery previews for everyone to see and choose a new view together. Gather beside a peaceful garden, a colourful reef or a tropical coast. Your room remembers its scenery and background volume.\n\nInternet is required for online rooms; voice needs microphone access. External websites may require their own accounts. Laser navigation works in the built-in room browser; ordinary Mac screen sharing is view-only. Service availability and relay quotas apply. Personal Meta avatars depend on platform access; presets are available.\n", "short_description": "Meet your team in a warm virtual studio. Browse websites together, pass the laser to navigate, or share a Mac window. Save room bookmarks, talk through your standup and take a putting break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1366387356560894"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1438514494913094_375627150012950182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tkxxxXYI1IQ7kNvwGq1g1-&_nc_oc=Adr-Dy9Z818bFIXpAC39XtQHjkfapiUQ647rJB_jyZTK4h5iYlZp9gVloHCFeF8SuEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx2AmXiSzf7EsYeHXJTnULE6HFUz2v4D5TOKF5_o8vMA&oe=6AEA01FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
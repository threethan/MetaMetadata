5m5fIY6Nd7T_MypYfSCb3zfks_bg&oe=6AFB19E4"}, {"file_name": "scene-04-stream.png", "id": "1146752681353784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828583_1146752684687117_4448832087711528725_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEbl1rcPplQQ7kNvwFuZi3E&_nc_oc=AdqeZVEsiJmbQ7M4kW2KNluCj974-nIWj3hXh0X_ojrFAQCrQ8_DrsdBkV8JHfrFBus&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrEehf2VqOMDm_ezgoR3DWJFoFGX42bhuodkcb9GnpPg&oe=6AFB350A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4yQi1BkjsQQ7kNvwFQMvmd&_nc_oc=Adq6LSO0DJ9pUroIcpBPfMM8l5R-ME8IYlJLwAFP5hVLV-klSZ9xi3fPHEJ17Z_aeKk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbVgEIfKzbTrho6rosC1m5i2yMElOEK8dQS0EHDidqQw&oe=6AFB22A3"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLfZNqynSn8Q7kNvwFdswFE&_nc_oc=Adq1oL1FglLTKzY75Oc25mlBMR0bEFirSmarCN1p2zrOF8auiGvDYQUe3sNpjFhrrSM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyZg-MXNxG2lOUspa5Bw53GNTnrmKvVWm5Ieiq90HuXQ&oe=6AFB3DE9"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDxUrf3S7e4Q7kNvwGZEU7y&_nc_oc=AdoAQy2dsfoPmlHCuAIyHa9yi7gaYUECi_jdVaNt_3VMS-TNNnjfhKqCt2u4cClwY3M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSouIX_f-EA0PIbd-vb1sWVJhmc5R3h-2CfZwccK2VYag&oe=6AFB4779"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1354246931108270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1511354980826994"}]}, "baseline_offer": {"id": "1511354980826994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792755120, "status": "PUBLISHED", "id": "1511354980826994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1404196849446611", "version": "1.0"}, "id": "2739198379831530", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Computer chess now offers three hints per game, with robot lights showing how many remain. Hints suggest a move for you to play. Enjoy clearer chess feedback, cleaner golf and saber trails, three celebration sound variations with a five-second pause, and a personal saber easter egg with colourful wildlife effects and animals that reappear.", "created_date": 1794406546, "id": "1406037309262565", "version": "1.0", "version_code": 303, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Celebrate with three applause and cheering variations, immediate feedback and a five-second pause between uses. Enjoy clearer chess moves, promotion choices and robot thinking cues, plus cleaner golf and saber trails. Discover a personal saber easter egg with colourful wildlife effects and animals that reappear.", "created_date": 1794404310, "id": "1405965842603045", "version": "1.0", "version_code": 302, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Celebrating together now feels clearer: the Celebrate button lights up immediately and stays highlighted during the effect. Enjoy three applause and cheering variations, with a shorter five-second wait between celebrations.", "created_date": 1794393687, "id": "1405615219304774", "version": "1.0", "version_code": 300, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "A new StandupVR wordmark and short animated launch intro, subtle selection feedback and teammate arrival chimes, chess and interface refinements, and raft destination choices matching the islands: Lava on the left, Fishing on the right.", "created_date": 1794386354, "id": "1405423752657254", "version": "1.0", "version_code": 299, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Celebrate completed work together with falling confetti, applause and cheering. Meet the new lightweight chess robot. Bare-hand sabers follow wrist movement naturally. Menu and jukebox pointer feedback is more consistent, movement instructions are clearer, and repeated UI and avatar-label work has been reduced. Temporary saber effects now clean up their graphics resources.", "created_date": 1794333728, "id": "1404196849446611", "version": "1.0", "version_code": 296, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
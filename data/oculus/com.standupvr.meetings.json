Ny17zaH2Fs4pTlOk00pXR1cU7g9thQvdqvcpfBCjHQ&oe=6AE60D7F"}]}, "id": "1129142299660187", "locale": "en_US", "screenshots": [{"file_name": "03-golf.png", "id": "1351766433561736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1351766436895069_2050890642447425682_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOzggwiXXWYQ7kNvwHiK6bK&_nc_oc=AdpqH45IVuUeetIvOgxMp78kY5aPDHhQaE3EdBTxeUHglOR4bK4dxgoaG5UxmkHYGjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOknYpxzewBY5JYFR-BvLBOT_YGPV38drMfH3Pqca6ZyQ&oe=6AE5E780"}, {"file_name": "05-beach.png", "id": "1147822107922481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827646_1147822114589147_7265711112823890383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAtOKPs9v88Q7kNvwEC07y_&_nc_oc=Adqq1GW7ujymi8U_J-3WZjEstlqWcDWVlZz-6nXLq92yBGD6Rt-PJx9BBjvcRZvfJ9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3afYPx19kth2KajuzmBsbgYstKv6_VtojU7UyP629kQ&oe=6AE5F9E4"}, {"file_name": "02-lounge.png", "id": "2929890294033383", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_2929890297366716_3374565275002758143_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-_QYHP_2-gQ7kNvwEdN0BI&_nc_oc=Adp5-lEkUmJ5Yzwa0R04_8sjcQW0Qz38lKhs2Hm6M_9_FSPodaXXw0CuohhvA9O5viQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMO6DxVdHoadRZdPDH8es3BerlPXZMafLVnt-fxLPzUQ&oe=6AE5EC13"}, {"file_name": "01-studio.png", "id": "1095936856679975", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1095936860013308_8551270153675075052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NtnB9yjRqoQ7kNvwHY5QNV&_nc_oc=AdoHaswbc6YHmssAlzPApc0uEa0d8P2FFkHhjGXXwByZW4_qV_B7DPGlWxF4xiG9WhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj59kdLjsCALiVywAYaYkam3X3P5ND-ZTzN6mAYrU1WQ&oe=6AE60668"}, {"file_name": "04-reef.png", "id": "1151850860711975", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1151850864045308_31084685525528392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jLSamsQhOoQ7kNvwEbgbpq&_nc_oc=AdqT-e53LAatL6Tkxa8DlQjfP2Z8dDi__SpBTC3U-wxgM2KLJtiYrb6VvTodec7m8S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcdAvO4lIlHgDM5oa-OyMakr3pm3idW3ZLJtEy3Y0ZAg&oe=6AE5E6BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nMeet in a warm studio with oak parquet, an ivory sofa and a slim stone table. Host an internet room, share its private eight-character code and gather with up to six people. Save the code to rejoin.\n\nPut Linear on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac and share a tab or window. No Mac app is needed. Each person can enlarge their view for reading.\n\nTalk through optional spatial voice. Upper-body avatars, visible hands, pinches and Touch controls bring you into the room. Mute stays close in the small movable menu.\n\nPass the shared laser to guide attention. Take the putter beside the cupboard: putts rebound from furniture and carry into a recessed white-lined cup with natural contact sounds. Scoring moves the hole to a clear spot. Use a trigger, grip or pinch for tools; thumbsticks turn 90 degrees.\n\nOne window button changes everyone's view: a garden with a river, lily pond and falling petals; a reef with bubbles, fish, sharks, turtle and ray; or a beach with pier, sailboats, walking crabs, gulls, a monkey and distant volcano.\n\nSettings adjusts shared background sound. Saved rooms remember scene and volume.\n\nInternet is required for online rooms; voice needs microphone access. Free-service availability and relay quotas apply. Personal Meta avatars depend on platform access; presets are available.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1362849600248003"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1438514494913094_375627150012950182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbC2EFCMkH4Q7kNvwHyl0Ma&_nc_oc=AdomcJnrY3xOnVofAM72VNd690Ap6orrrLEjg-bIvwXj0m2u_KRpdbgu_FMwpOoxmf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3cn1OxxEzHxzOmgL2WENxplUk6-2JA8NkbWRlSplxZw&oe=6AE60D7F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StandupVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1792755120, "lastRevision": {"nodes": [{"id": "1354246951108268", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1354246921108271", "is_first_party": false, "enables_in_ap
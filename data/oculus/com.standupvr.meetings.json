684687117_4448832087711528725_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pAbiP_RrhgQ7kNvwFV73z_&_nc_oc=AdrGD6ywfiY3AgDQcsLrbUCwjsVNcBvmGBnaTB89nBic8g1fqNjM6y5x8e1vAtxieoI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL6rxoDeDQdxT_F8lH1_Lj9zvTVXDacuDokfIMicfR-w&oe=6AF34C0A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Oi5SUVAJxYQ7kNvwEoor3z&_nc_oc=Adq7Wu58hCZSSvVu7yjIdflZKK1d5inLwY-twgDq46hGoENRgQ_dd_Eev2HT_LQMp1I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2jX2rLCAfM2GMzVFKp7gJPZN1bEZ-MPtC_x7W4yaqVw&oe=6AF339A3"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMxnOv9x4QEQ7kNvwFc1hjT&_nc_oc=AdpCglmN6DyCzYBOYR_eCln3T19IS2x4Wwjci22Ey0XM6raMx-hXsB1LiOT9OkOM000&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4dBgRYKg8yJ3Ah17cVzDj_GgI4M5AuqN_xKGevuc09A&oe=6AF354E9"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUWGa9XwqpoQ7kNvwG9m91g&_nc_oc=AdpkZAJ4DnlE8LXSlqZs1zdrfeR42G8lkQGsMNSGR9eL-RHFgz2D7aN6pNWmfgmq9SA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRvO4v0KM-6G0BWwDdDRq69DpEb4B4e-LXSjc7JwDjRA&oe=6AF32639"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1354246931108270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1511354980826994"}]}, "baseline_offer": {"id": "1511354980826994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792755120, "status": "PUBLISHED", "id": "1511354980826994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1390775417455421", "version": "1.0"}, "id": "2739198379831530", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1390775417455421"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Sharper menus that appear clearly as soon as they open. Browse the web with the laser even before joining a room, with address entry, tabs, reload and scrolling. Choose your own saved room clarity in Advanced settings: Normal, High or Ultra. Normal remains the default.", "created_date": 1793791377, "id": "1391489894050640", "version": "1.0", "version_code": 194, "release_status": "PENDING", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1390775417455421"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Smoother sharing and more reliable meetings. Draw immediately in your own colour, with sketches fading automatically. Keep the shared browser session when passing the laser or switching presentation modes. Screen sharing adapts automatically to idle pages and movement. Improved avatar loading recovery, reconnection and distant voice audibility, plus cleaner controls and door-only outdoor access.", "created_date": 1793773458, "id": "1390775417455421", "version": "1.0", "version_code": 188, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1390775417455421"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "\"Added hand-tracked movement: swipe your left thumb to turn 45 degrees, and tap your thumb against the side of your index finger to teleport to a clear spot. Controller turns now also use 45-degree steps. Improved right-stick browser scrolling vertically and horizontally, including nested page content and when holding the laser in the other hand.\"", "created_date": 1793646860, "id": "1386914551174841", "version": "1.0", "version_code": 183, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1390775417455421"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Fixed the studio heading above the shared display so the screen frame no longer clips the lettering when viewed from seated or lower angles. Updated room imagery.", "created_date": 1793558921, "id": "1384675584732071", "version": "1.0", "version_code": 180, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1390775417455421"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Laptop teammates now appear as Meta avatars in Quest. Choose from six looks on the website, with cleaner portraits and a remembered appearance. Improved seated guest arms and hands.", "created_date": 1793556248, "id": "1384614864738143", "version": "1.0", "version_code": 179, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
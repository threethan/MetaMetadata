_ss=7f30f&oh=00_AQVxoVL-psYPA5bXKPObudOtpc205ONvo1r0V6f3IJBjtQ&oe=6B0F060B"}, {"file_name": "standupvr-04-beach-368.png", "id": "1541740937846056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771240_1541740944512722_6041790368438101784_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ogxImGzjsQ7kNvwHE6oI4&_nc_oc=AdqRVTYhq9fMNANmgJx_5-o4dpMVJaAkFL-5HAhiuDtAfdUowRDpIEtMMcia1ZA2Jxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU55ocbwQHC3VUOSxmfyxyvdGo6lCabFkX2_c8zwfcppg&oe=6B0EEDF1"}, {"file_name": "standupvr-05-helicopter-368.png", "id": "1514175940638029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1514175943971362_515073712687851247_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTPrxy7ppzoQ7kNvwHaGjw9&_nc_oc=AdpdlnyXrMAX3kyZ5vz9qG6gIyN6_VZlGbs5up6rgnLwn9PeSDBBlpexeb-jpcUuxSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRZ8yDANlwF9SfpRN-upgg0nGnl5A6eLDVUWQDj5jEjg&oe=6B0EF2E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nMeet with up to six people in StandupVR. Host on Meta Quest and share the room code. Teammates can join from Quest or at standupvr.quest/join/ on a Mac or Windows laptop. Save rooms for your next meeting.\n\nPresent a computer window on the wall, browse with the room\u2019s handheld laser, or draw together in your own colours. Personal Desk adds a private virtual screen and keyboard passthrough. Pair at standupvr.quest/desk/, adjust the screen and keyboard opening, and save their positions.\n\nChoose a setting for the whole room. Follow the Garden\u2019s stepping stones across the timber bridge or play chess by the pond. In Reef, spot seahorses, colourful sea stars and a patterned turtle. Through the rock arch, you may see the shark snap as it turns offshore. On Beach, stroll past palms and flowers, fish at the pier, or take a low helicopter flight to Fishing Island or Lava Island.\n\nTalk with voice and avatars. Use hand tracking or Touch controllers, and select your seating layout. Take a putting break, play chess together or against the computer, set a soundtrack with the jukebox, or celebrate with confetti.\n\nInternet is required for online meetings. Voice needs microphone access. The laser operates the built-in browser. Shared computer screens are view-only. Laptop guests can choose an avatar preset before joining.", "short_description": "Meet in a shared VR studio from Meta Quest or a laptop. Share your work, then step out into a garden, a coral reef or a palm-lined beach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1395699380296358"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1438514494913094_375627150012950182_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqy4gVT9rIkQ7kNvwHTg4Qh&_nc_oc=Adqf8UpOovsqFwLues1a_y4vomv36pBz2VylX_didW7RBW3zb_3fIXKvG
-tNMinifBmWkX33UGVCR5TQ0DA0A&oe=6B01E9A4"}, {"file_name": "scene-04-stream.png", "id": "1146752681353784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828583_1146752684687117_4448832087711528725_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OKkLHrrFRkQ7kNvwEM-2bw&_nc_oc=Adpi9Na1YQUp15Se2r-K7CeuF_hka7YCsqZraowGeCKoPWhQ5RkqA2EvQVA9cY1vNoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbSxE3RKDFXCjPr_fA_GLUp_DruSLkHZTFa5JL4hF3xg&oe=6B01CC8A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-9gKlZ9BF4Q7kNvwF28AqF&_nc_oc=Adpe_DygXlcgebYNMZExQqk9SRv7A4FILb8gNb-xJMVUD1AmpsaJ503Cb_r1vzSkaEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQehTsh3h1J-fyQ-rovdnCboBnlRAoGIQZ1omc-Y-wF7g&oe=6B01BA23"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVeok3HmJhgQ7kNvwHllaaQ&_nc_oc=Adrkcc9BQ7czmdwap-lmeTMalDry3giKu3kVsCgWGwKY3afiazmGut9NWgvAiJ4qOCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxK6lu0hlC6sByNDTjy9owvEPXqKUR74zyyQ1RZzXhtg&oe=6B01D569"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg876FXYyNsQ7kNvwG7ruAZ&_nc_oc=Adrtfglo_cnUwTAo8EnEwm4F1aVmQHP39WB8JYv0ptDKbHAeItuvM0MWvwzCZR5_dBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS9S1980F4u4VdoqqOeUk31KDqBFYp5QuA5TlWji7WFQ&oe=6B01DEF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922
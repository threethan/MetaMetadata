684687117_4448832087711528725_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEcbrNnaZ9MQ7kNvwHKKIDR&_nc_oc=AdrDvEwf7xixhir6fELLshx_gDaQq5L_Xnv8CUzFEQnjNIFDSpPKB4Q0BdFvJa095BY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-jqyMBPbp_DgUC3O3VEA5Zorh0hHRMM9f6Mh0O4bBtQ&oe=6AE76E8A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi-3nOMlEQgQ7kNvwHnBD1_&_nc_oc=AdqB8f2D-E6aIT1ZbCIyoM6iaJkE9PVrZ2TRTAVPR8pIZy3IuuNzygsvH79dB_k2no0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuUUDYVhNLzuzQOLegNF_O56tePunhsDsiUoppIAHVxA&oe=6AE75C23"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7f-vVIoxPrYQ7kNvwGAT4xT&_nc_oc=Adpa3jbc37HBjolzcvx1mORZamMvjgkMst6f1-1qrLYyACbv2F7zDj1rvDfKKwkJciE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNZutjlxTeT6U3R-66WfY37XHGWmqjU7SOxI5tCdha7A&oe=6AE73F29"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lozkp1pNMZIQ7kNvwGeQJAE&_nc_oc=AdptX3FuXg8hj-6ArnfTdwzE7at5r2kK8lkhKM9w1EI-JUMQKm7SzJxWKajqaGHggTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfdg_r1JgcgtGLlQGfWEzFVQD_8Gu0yjOAzngLUn63yw&oe=6AE748B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
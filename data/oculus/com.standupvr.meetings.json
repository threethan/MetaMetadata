52684687117_4448832087711528725_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEbl1rcPplQQ7kNvwGb-upO&_nc_oc=Adqy_trl1ek4rz227FqvX6C0tm7LHl4ha0kuks40TvnVcVf7Si3579o07PUYKBUR50A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwFDyFps3_ZejehE8Ak2qgxSmSpWKILItlt4cQFPnviQ&oe=6AF9E38A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4yQi1BkjsQQ7kNvwEL293M&_nc_oc=AdpF_XoptSao8xzNtSgksjlA468BJFB72rAmh3get0Rwvwz_UI9q5BO8pwwGQ-mYDvE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnxSrOPaX_BChm94z9KSop8UgtlSXCLC4GdJvW4CtpvA&oe=6AF9D123"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLfZNqynSn8Q7kNvwHOwvKG&_nc_oc=AdpruDqBBcsOjIluQc-2tXBVPy3K1yku8904hS87L-Z5Z5i35dQzqy1NtrRAvkOyAfg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSetrQisVW1SiQqaWWltK8EvNmvjkSXvnmNTgVGgEMqqw&oe=6AF9EC69"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDxUrf3S7e4Q7kNvwGerCFB&_nc_oc=AdpLAwWrGR7cFD7R-uR35aI-ggRdSuZ2rEC6Xf7uwUNR1bvQMxPLG18YQHfMPJk7-Ks&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDAybvQLHO9DCidmNUPdgbPS9-C5cngL6D4WYQFtC7hg&oe=6AF9BDB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1354246931108270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1511354980826994"}]}, "baseline_offer": {"id": "1511354980826994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792755120, "status": "PUBLISHED", "id": "1511354980826994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1404196849446611", "version": "1.0"}, "id": "2739198379831530", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Celebrate completed work together with falling confetti, applause and cheering. Meet the new lightweight chess robot. Bare-hand sabers follow wrist movement naturally. Menu and jukebox pointer feedback is more consistent, movement instructions are clearer, and repeated UI and avatar-label work has been reduced. Temporary saber effects now clean up their graphics resources.", "created_date": 1794333728, "id": "1404196849446611", "version": "1.0", "version_code": 296, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Explore both beach islands by raft. Choose Fishing island or Lava island from clear miniature previews. The fishing preview now shows the real island\u2019s rocks, sand shelf and two palms, with fishing equipment. Lava island has coastal stone colours, crisp green patches and a natural sandy ramp to its helipad terrace. Both personal raft trips, exits and return journeys are supported.", "created_date": 1794317530, "id": "1403724549493841", "version": "1.0", "version_code": 291, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Fresh garden scenery: look beyond the chess area to a quiet lake with naturally grouped rocks, soft shallows, gentle ripples and a few waterside plants. A rounded, snowy mountain horizon now surrounds the garden. The scenery stays lightweight for Quest.", "created_date": 1794308775, "id": "1403489596184003", "version": "1.0", "version_code": 288, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Garden chess now has a stronger computer opponent with Easy, Medium and Hard levels and varied openings. Play solo without hosting or joining a room, and use the Level button on the table to change the challenge. Saved rooms remember the level. The computer\u2019s occupied chair no longer shows a sit icon. Existing personal-desk stability and restart/rejoin fixes are retained.", "created_date": 1794304112, "id": "1403384756194487", "version": "1.0", "version_code": 285, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Build 283 fixes personal desk screen flashing, removes temporary timing logs and restores the same room participant after app restart, including jukebox controls. Also includes smoother hand-gesture teleporting, lighter avatars, a chess computer avatar, improved chess seating, palm sway and drifting clouds.", "created_date": 1794257521, "id": "1402465769619719", "version": "1.0", "version_code": 283, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
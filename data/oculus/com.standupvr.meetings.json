29_7495914660242070290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71FE77iPOGQQ7kNvwF3gd1v&_nc_oc=Adp4Wr5n1pJizLuXcqT-qtY0OEecIxAeU2izooZQifRvI2XwZ1rS7IL7o3nuh917YBU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4mbYPIhw3pNODGh3xTwN_ZvRe1Mdve7vjHBdcIItJXw&oe=6AE34AA9"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uix-OZ5USPwQ7kNvwHsMmzH&_nc_oc=Adr84X-IEEC3mKGXTHNo-0W2Qlgq81rWmDdD7-efe31oxrtKDtmEBOeC03s7N6Q9Q4Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq4vl5-9iy7EcuGdzKsET8tBqgwcbuQa_zYO96JnOwlA&oe=6AE35439"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations with up to six people.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin spatial room voice when you are ready to talk, and mute your microphone whenever you need. Upper-body avatars and visible hands keep the conversation in the room. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Pick up the shared laser pointer to guide attention. Either Touch trigger or grip button can take and return tools; thumbsticks turn you in 90-degree steps with the menu closed.\n\nChoose the view together. A wave symbol on the right window frame switches everyone from the Japanese-style garden, stream and lily pond to a colourful underwater reef with swimming fish, sharks and a rock arch. Select the leaf symbol to return.\n\nInternet acce", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1362127796986850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824328_1624280925832948_8935607331421516953_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW57DWT1faAQ7kNvwHEbzzO&_nc_oc=AdoYE9qSM-drpBH1wXOjRCB7LCB4QnEcH2jEv0OyakaIGJ671nEaEy-ckjI0LjWb1Ow&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSTwSUr2qcouE8AWGbnsZz1BGJcnh7WE_xh2Ub_uT7lg&oe
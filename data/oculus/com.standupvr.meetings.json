.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwl5HFvjmA-2myy8XerBuXo-u4CEraSuRdfL3gPqNxuA&oe=6AE341CA"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=290fHcj0pUUQ7kNvwEgrDO1&_nc_oc=AdqTgv5J3jAnWJ_uHQtkOxqDM2VfE0d6ktF7rkRSkgNzlxwg6iuijanMNjC-utNyego&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKNRNfFW50-yDqjKu2moUMkM9GlHRgNqZHtWvNn7pRyA&oe=6AE367A3"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71FE77iPOGQQ7kNvwF3gd1v&_nc_oc=Adp4Wr5n1pJizLuXcqT-qtY0OEecIxAeU2izooZQifRvI2XwZ1rS7IL7o3nuh917YBU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4mbYPIhw3pNODGh3xTwN_ZvRe1Mdve7vjHBdcIItJXw&oe=6AE34AA9"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uix-OZ5USPwQ7kNvwHsMmzH&_nc_oc=Adr84X-IEEC3mKGXTHNo-0W2Qlgq81rWmDdD7-efe31oxrtKDtmEBOeC03s7N6Q9Q4Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq4vl5-9iy7EcuGdzKsET8tBqgwcbuQa_zYO96JnOwlA&oe=6AE35439"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1354246931108270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1511354980826994"}]}, "baseline_offer": {"id": "1511354980826994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792755120, "status": "PUBLISHED", "id": "1511354980826994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1362135503652746", "version": "1.0"}, "id": "2739198379831530", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362135503652746"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Premium studio update: warm oak parquet, ivory sofa and a refined stone coffee table. Improved curved teleporting, stronger putts, natural cup drops and contact sounds. Golf equipment rests beside the cupboard; the ball rebounds from the metal table base. Updated app icon and room artwork.\r\n\r\nBalanced warm oak parquet with clearer grain matching the updated illustrated app icon; the carpet has been removed.\r\n\r\nSofter parquet colour, grain and seam contrast to balance the room furnishings.", "created_date": 1792888685, "id": "1364802636719366", "version": "1.0", "version_code": 77, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "late
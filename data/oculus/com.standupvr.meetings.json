vHg1WM1DR_nPQyXDUQYCi3zLzaIA&oe=6B0302E4"}, {"file_name": "scene-04-stream.png", "id": "1146752681353784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828583_1146752684687117_4448832087711528725_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OKkLHrrFRkQ7kNvwH21oxx&_nc_oc=Adr39_hVGFhK3WLRQxf05Bw7yMA_Bn6bM4J0sDSE-kjPCzJuNSijvNDYTUTzRl77X7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAHAo2yPmZd_BQ9yURvTR6bB1xeJdv_tmeueh6B1UwUA&oe=6B031E0A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-9gKlZ9BF4Q7kNvwG08-aR&_nc_oc=Adqt8IvB5bg1P0_zJcilpJTfk9a-Crybo58Ik6BFibs5d-uh3dJjlNdFjcCLU02qxS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtQjq6V24V25AkRhEa08Nk8K4bts0NXzsPpTgGdMCCdw&oe=6B030BA3"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVeok3HmJhgQ7kNvwFBPLcr&_nc_oc=AdpdSA4MINSI8DI2IXSWdF6NsK0ruqe44_lhVktzrKyZ50fQQFXPTs91F14c4pkLE0s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNv1dJ83rS_92UsaHGZnK_MVLBn83X5TFbfPSusDVRiQ&oe=6B0326E9"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg876FXYyNsQ7kNvwGQQSCY&_nc_oc=AdreTVA0xm_JFzZ2DDjjnHzdjUngF0z_9f_9tQs_bjLpP4VhkYGjUVLWvfrKMLuzg8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIWB5cjfED2Dy_uAes1RnkRCshKICdRjzPu8GX2Xx6-w&oe=6B033079"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922
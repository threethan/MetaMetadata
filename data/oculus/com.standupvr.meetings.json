ndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362135503652746"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Touch controllers: use either the index trigger or grip button to take and return the putter, matching the laser pointer. Click once to take it, release to keep holding, and click again with that hand to return it. Bare-hand pinch controls remain available. With the menu closed, move either thumbstick left or right for a 90-degree snap turn; return it to centre before another turn. Turning preserves floor height and clears artificial putter movement. Includes the shared garden/underwater scenery, studio polish and connection improvements from recent Beta builds.", "created_date": 1792756186, "id": "1362135503652746", "version": "1.0", "version_code": 32, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
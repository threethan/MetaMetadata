4U53ZxQ2eiF0wVznYTUQbw13Wf53J6t96xrA4H5ylg&oe=6AF0997F"}]}, "id": "2414827299327957", "locale": "en_US", "screenshots": [{"file_name": "02-music.png", "id": "2225835581659093", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_2225835591659092_6738411794983629543_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Esbj1_GrY5YQ7kNvwE1_wll&_nc_oc=AdpzMoiHZA1AsA1d2_yOeIUGWpTcGhLmJilb8cPD69lFNaq4_N-WWrsQhl-KL7SJC6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9IMccsyK7yYQhlkvzBtNoyOuO45sRMhDxD28f7keDUA&oe=6AF07D49"}, {"file_name": "03-reef.png", "id": "3008410922852222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_3008410929518888_7171916520030134424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCodE4Jac0oQ7kNvwGR_f5X&_nc_oc=AdoFHu8HJkNrZ9tTg-6U2l9YZH8zC7FT8oIN2SX6FiTIlMd7d5wtyDZa_zllHJTcUmc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_LbOlcl4FMw5EY-dTq7UUPDWR2zZNm9IyQcmTnQ20fA&oe=6AF09AC1"}, {"file_name": "04-beach.png", "id": "1786364202665804", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1786364205999137_5918418534352411720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kywxnq4UzjgQ7kNvwHQVlgK&_nc_oc=AdrLzHXPWfysnA-v5iQaSrvW5ZrFnN_VpCbrg9b1mMnyRZKu9-wvsfFkNiiSP_VKf1Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzr_cZI97LYC85uuJVTLB-vlYRq-DuxVKIEgkSuYgHqA&oe=6AF083D0"}, {"file_name": "05-lounge.png", "id": "1818765715934090", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_1818765719267423_8086652127661241801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ux-88M4oCPUQ7kNvwF-jnls&_nc_oc=AdqfD3EsHHu1qQKvpBp6cph-ESU3Ff5grrfs3b8MiZQrzYSeDE6LvK-m57W2-KtBdwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS18bpPEYRnZHnDvfmKup3aOr9f-z5ZPELqKHci_qMV3A&oe=6AF09DB8"}, {"file_name": "01-studio.png", "id": "973249048702431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_973249052035764_675228032214150183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Lp0WujYZd4Q7kNvwEJs_Xe&_nc_oc=AdrXWglSXwdlITiJoYTnR3fIomXj1Vigte6PvbqZMcMFEC_-iexTFWpzXcssBSTPX_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV3NnTluZbdtO40HkEgJRaHTq9n7ykvTZudWMxjhQrjQ&oe=6AF0AE59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nBring your team into a warm virtual studio. Host a room, share its private eight-character code and meet with up to six people. Save the room to return to your next standup.A little space to think together.\n\nBring your team in\n\nOpen a website together on the room\u2019s shared browser. Pass the laser pointer to hand over navigation, follow links and scroll through the page. Add named bookmarks from standupvr.quest/present/ on your computer, ready to open in Quest.\n\nPrefer to present your own work? Share a Mac window or Chrome tab at standupvr.quest/present/. No Mac app is needed. Everyone sees the same screen, and each person can enlarge their view for reading.\n\nTalk naturally with optional spatial voice and expressive upper-body avatars. Keep mute close at hand in the small movable menu. Use Touch controllers or hand tracking, with 90-degree thumbstick turns on controllers.\n\nTake a putting break, or open the window\u2019s miniature scenery previews for everyone to see and choose a new view together. Gather beside a peaceful garden, a colourful reef or a tropical coast. Your room remembers its scenery and background volume.\n\nInternet is required for online rooms; voice needs microphone access. External websites may require their own accounts. Laser navigation works in the built-in room browser; ordinary Mac screen sharing is view-only. Service availability and relay quotas apply. Personal Meta avatars depend on platform access; presets are available.\n", "short_description": "Meet your team in a warm virtual studio. Browse websites together, pass the laser to navigate, or share a Mac window. Save room bookmarks, talk through your standup and take a putting break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1384667754732854"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1438514494913094_375627150012950182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x--Y7HIDBmAQ7kNvwFC2t-I&_nc_oc=AdrseH5y9_2gjizj3LcFfctHWi6hXpiXEtihKqbX3XDK55k1UcYxlY3tINZNeN6FDts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG5LZJz-yaIRcbY4BSTVNxt-xh-n0Xe9Va0VtNeSCDvA&oe=6AF0997F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StandupVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1792755120, "lastRevision": {"nodes": [{"id": "1354246951108268", "release_type": "SCHEDULED", "administration_status": "A
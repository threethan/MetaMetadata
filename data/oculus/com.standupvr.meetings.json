ZJfM7e5k7GYGxCOpDAMuUDaXZNCQ&oe=6AFDBCE4"}, {"file_name": "scene-04-stream.png", "id": "1146752681353784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828583_1146752684687117_4448832087711528725_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L2VQeELHpcQ7kNvwE-vDKn&_nc_oc=Adq9EJ_ZeCY0MhWPSMKXS0XgRGX27pXun3vtWu5ctt8KbTKhJkhCl7dUFbV0kWoGCUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSriQ6taw7qaVH3cYHBP5zLqap7YYJRWC7E32aoMCparA&oe=6AFDD80A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkW6MrosZw4Q7kNvwGqdQUS&_nc_oc=AdrDPAJDsY-1SGKHV-WnO9P2lqzU4FYtq3tSS9WqlPSNgO7z75HAax6EfGiy-buvIoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeoSW84iL6eNu_H-ExOGMKdHDupO2brhDHi6EKJGVXjA&oe=6AFDC5A3"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKxtrLNQVOIQ7kNvwHAC97K&_nc_oc=AdrceuBc1Ho657ePk4k1agjyLO46Pxbhe3OR4tgdH7fDxVN4FuMGNctsn8MaxC8kmEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7BjXebR1xta_5hXGIi82n4v-za2F3ZN7wGBc3ZRdf6Q&oe=6AFDE0E9"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psPLJU1kn6QQ7kNvwEPWw-j&_nc_oc=AdrTeaiegEf9NULaIyE2rcc-CWnWgi84VtOklWLfB5xmWN4B_QrcmcO_tiNqs4WzY9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS19PynHhLsQzRtPSQFdfvX7CfSvVl_NBW60Tj0jixsoA&oe=6AFDB239"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1354246931108270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1511354980826994"}]}, "baseline_offer": {"id": "1511354980826994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792755120, "status": "PUBLISHED", "id": "1511354980826994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1404196849446611", "version": "1.0"}, "id": "2739198379831530", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Build 338 improves Personal desk startup and headset sleep recovery. Settings stays above your private screen, with the room screen behind both after returning to the headset or using the power button. The welcome screens now carry the matching StandupVR logo, and private video has rounded corners on all four sides. Includes the recent cursor, scene-matched welcome artwork, fishing-water and lava-flow improvements. Existing screen quality is retained.", "created_date": 1794601002, "id": "1410760622123567", "version": "1.0", "version_code": 338, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Sharper illustrated welcome screens now match the garden, reef and beach. Settings recover cleanly after headset pause and remain usable while room controls outside the panel stay selectable. Fishing bubble patches sit naturally on the water surface. Includes clearer personal desk setup, reliable screen layering, improved native Mac cursor support and continuous crater lava with smooth downhill joins.", "created_date": 1794582155, "id": "1410233805509582", "version": "1.0", "version_code": 333, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794580866, "id": "1410191352180494", "version": "1.0", "version_code": 332, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794566250, "id": "1409777305555232", "version": "1.0", "version_code": 324, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Smaller, consistently sharp menus, Settings and music dialogs, with matching rounded edges and close buttons. Hover over the browser globe for clear laser-pointer instructions that are readable from the sofa. Includes seated turning and stable personal-desk alignment.", "created_date": 1794490595, "id": "1407974165735546", "version": "1.0", "version_code": 318, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
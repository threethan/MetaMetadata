P2LAJg9evNlhQihAF9Dbr1QIZHmg&oe=6B0848E4"}, {"file_name": "scene-04-stream.png", "id": "1146752681353784", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828583_1146752684687117_4448832087711528725_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WtDpDFUeNcQ7kNvwFFDixw&_nc_oc=AdpyCFyjIaeP1IrcGNljOllIXB8XAghwOWZq38RgQE-AFy9wNsXRkiJDlwDA_Qlc4Ko&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSup0j6UZRsBng7mH0ze0pJiCa9hXL1JHoB3jHqakcotA&oe=6B08640A"}, {"file_name": "scene-05-pond.png", "id": "1094501120221870", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823341_1094501126888536_4297509524855189257_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kMERGWYuQMQ7kNvwGB10_0&_nc_oc=Adr_tDRBs-eSz4cXv-Cu48kuiwndepEhSkN_6Chj6M6PGeB8mnN5WByhbnp29VO5Owc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_wPrKOv_rOvazx3PITtCa4EGaiQmRzetmleyCbAYk-Q&oe=6B0851A3"}, {"file_name": "scene-03-window-view.png", "id": "1628101129361363", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824322_1628101136028029_7495914660242070290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJvTeykEyPwQ7kNvwFpwAcY&_nc_oc=AdqOh1eaiXuyr5fC9gUAuT-RPdDCBoB7cunD7VMAxpkg_MsMbsicUkcgOtWXrVyTGUQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44yPX4Xg7t5ER-pixMJu_OTOIbJ8k0HYTWOFyfV6HSQ&oe=6B086CE9"}, {"file_name": "scene-02-presentation-wall.png", "id": "3679401638902393", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491828050_3679401642235726_7411315610489581042_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1u0B7c2CdAQ7kNvwH5tpAi&_nc_oc=AdqukeVB8vvYF3Ao13S28DQoNufEm_LvIMknLkwBa1ccQeDtUkrISbHue7yEOrN7QjI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxWbjoWbwQh4klbumqqTBXZzD239-zIbQHkjwx6w1DQQ&oe=6B083E39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StandupVR", "keywords": [], "long_description": "A little space to think together.\n\nStandupVR brings a small team into a calm studio with warm timber, plants and landscape windows. Host a room, share its eight-character invitation code privately, and meet from different locations.\n\nPut your work on the wall. Open https://standupvr.quest/present/ in Chrome on a Mac, connect with the same code, and choose a tab or window. Keep Linear signed in on your own Mac while teammates see the shared image in Quest. No native Mac app is needed. Each participant can enlarge their own screen view for reading.\n\nJoin room voice when you are ready to talk, and mute your microphone whenever you need. Use hand pinches or Touch controllers to move the menu and interact. Joining closes the full menu to a small tab, with settings and microphone controls easy to reach.\n\nBetween conversations, take the shared putter for a few shots. The ball rebounds from room objects, and scoring places the next hole on clear floor. Or simply enjoy the stream and pond outside.\n\nInternet access is required for online rooms, voice and screen sharing. One presenter shares at a time. No separate StandupVR account or subscription is required. Personal Meta avatars depend on platform approval and availability; preset avatars provide a fallback.\n\nSee the website for setup, privacy and support.", "short_description": "Meet your team in a warm virtual studio. Join with a room code, talk through your standup, and mirror a Mac tab or window onto the shared screen. Hands and Touch controllers are supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://standupvr.quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://standupvr.quest/#contact", "website_url": "https://standupvr.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1354246931108270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1511354980826994"}]}, "baseline_offer": {"id": "1511354980826994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792755120, "status": "PUBLISHED", "id": "1511354980826994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1404196849446611", "version": "1.0"}, "id": "2739198379831530", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795188687, "id": "1423551650844464", "version": "1.0", "version_code": 400, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 12}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "The helicopter makes a tighter, slower turn before landing. The Lava Island cockpit miniature now shows lava flowing from the crater down to the foot of the mountain.", "created_date": 1795009886, "id": "1419785917887704", "version": "1.0", "version_code": 394, "release_status": "PENDING", "status": "UNDER_REVIEW", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 12}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "Visit Tide & Timber on the beach for a game of Tic-tac-toe. Play against the seated robot or take both stools for a two-player round. Look for the surfboard rack beside the bar and the practice board behind the surf school. Rounded menu edges now look sharper.", "created_date": 1795007497, "id": "1419725741227055", "version": "1.0", "version_code": 393, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 12}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "\"Personal Desk now remembers whether the keyboard view is on or off. If it was on, the passthrough keyboard window returns automatically after putting the headset back on.\"", "created_date": 1794994998, "id": "1419454851254144", "version": "1.0", "version_code": 387, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 12}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1354246921108271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1404196849446611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2739198379831530"}]}, "change_log": "\"Paint the studio\u2019s exterior walls in Garden, Reef and Beach. Choose any color, adjust spray thickness, and hold the trigger to build up drips. Artwork saves on the headset or with a kept room. Celebrations now randomly choose between two crowd mixes, and avatar color markers are smaller and sit slightly lower.\"", "created_date": 1794946936, "id": "1418567001342929", "version": "1.0", "version_code": 386, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 12}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
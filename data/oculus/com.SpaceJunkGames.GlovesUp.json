oe=6A11A42B"}]}, "id": "813386927786410", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UstY1MaEJV8Q7kNvwGhN9pd&_nc_oc=AdpJketTs0qwMpWJSKXsMM2GDBGaC6qE1yo0SqtzpR8FyzdfeQj4fYLSKFNfrwa4pFY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WvXYAE_t9tI5bLY-E1496gbWGVeqWwTB7ce53_gek9Q&oe=6A119BE9"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grRIcEloqGMQ7kNvwFB90p4&_nc_oc=AdpDl5kEPKMeviCUIpbteZuqQ5gvoN6G7npu0OchWZFEnT8oiGG8y2-8rGB-1MiSxpY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c6nEizD-B6_4ctaOYX4EPOF2a32uHReQcIifGsCvA1w&oe=6A11C477"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJbtoIkknKIQ7kNvwFvLd8P&_nc_oc=Adoy6Ogrm48fDiOuzfOUxQ2Na4NG40W6Sbcu21gogE-LO9YHFqWjtgIWtNZ_5x3IOc8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a6--zk5m_jzfe91sMj_WxEMzJw6wZC7hS0X0k9VRNEg&oe=6A11C545"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUBKiMX7aUIQ7kNvwG0Vtv-&_nc_oc=AdojdEYSFCce_gzWZLvuRbE4Nsp_nNPFiBnGD_5paV0y3RWriboCTsaqfpTbOMfgQL8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ObVi52ffNMHMdsRniS_WiwCLtp2Jify6evQcP8fCuVg&oe=6A11BD91"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej0G4G60g9MQ7kNvwHtEAvo&_nc_oc=Adp_T9MziXyjbSRg_DLrePByLFadMy6F9K562NMYfmlq6fZQ-bmyt2oErixkrCXX2ek&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55pEq6XixMgIKhJ0d_ftU5SrxqMXAeOMhP9OCGDbeASw&oe=6A11C4C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDkikPQC3nwQ7kNvwEtD8tv&_nc_oc=AdreVUDq4m2Q30xe0y3hN0ZNLKg8Pnl1T-RyAIQOBcm8oMIuNpMmRtl8I1MkFZMs1-0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i111r6i9Nf9Sa4fEP6TvzomNeX6bSamF0ZIbo5FO70A&oe=6A119E85"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ozUiVuTJIkQ7kNvwGT-8T-&_nc_oc=AdoWA5X-wPObnH
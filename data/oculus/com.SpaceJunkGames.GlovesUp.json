ts": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFiNJ4tTqsIQ7kNvwHQTDsn&_nc_oc=Adn_Ne0ZoK7iD8feBES0z5Jj29jhkikxfr16qxhv1_MrZDXF1nU92luGF1M17sCRCVc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfthX15ZlDOWn65XTlwA43oCO-OwAJTU14t-1BMmGykAOw&oe=69A18C69"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBaX-O39JrAQ7kNvwGmaEdN&_nc_oc=AdlBcz0gozT25KUM_O0GXO7mDq876CEhjNg_E260K3_ysY16Sn0ZiGyXsFCmf5_ykSw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuUFnlORIEt3et9FwweBxkmJUx2ClaqkiOydFBMVhNeEA&oe=69A17CB7"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqdFldsBnfAQ7kNvwECBZ7x&_nc_oc=AdlVnF9pm60S1GabMY1xsk4MqdARDxKdAvUGPwRdhq5afrXwCdA40oda7Muqpwy2MhQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftpD-KLtEetmr5wqN_xhuigWH7mONQNveTAyLAS13V_qA&oe=69A17D85"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxrD4pJcMj4Q7kNvwEuKPEP&_nc_oc=AdlkEtAdH8eGM5sPg2ctjH7pySQG2DEbj1i281skbRb8soeS9318EG7TDnn4uJkmAIg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsClqJF24_f2_Z60mSAVqqnWrK2D6SbusNrrO4_jX3Q9Q&oe=69A175D1"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMd9dGQOiG4Q7kNvwFbESHK&_nc_oc=AdmaMPgDE63Mf-ZvAm8zMCZdzFD65P7RT3Va4tuglE0Im11SwcwOCXoc6vhzcyaKP7Y&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvYOiMFnFV1bg94rY_JzAEfIxpqu_L960VsX5kJqtM3IQ&oe=69A17D02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hjjm03GzWHQQ7kNvwHSjG-0&_nc_oc=Adk2SQQvxlKXaN-_5dzx99L9YDaa0bGwEkNn_M1CupCEjjeq7lwEh6AfTwT7kN4M2eQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvnRIwwpEEOmysGl-lBddW9X_d0SC3dULnzLSdmabsd3A&oe=69A18F05"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GOePd3u_nAQ7kNvwFrbWZF&_nc_oc=Adn4TdHMDS7gbm6n5sXek0Bha4_BUZHqCYNfQa8RHBkHt812esBbSZTmm_pEQfMazCs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsnfk-C61d5-rMauaIxPu4cBfUE9Rqp_5YifqZLL2tGt
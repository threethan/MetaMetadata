ent-lga3-2.oculuscdn.com/v/t64.5771-25/499307444_1071721787948215_7381303741412865625_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew4FHZki_d4Q7kNvwGlJCbd&_nc_oc=Adof4RcHDJDzzfL65G0078o-uiwdtgUca_gHwBsGsxA6Vfim89AZivrlhIhp8OzdG3Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSI-0a2WmJoIGHbcwBMJQXPCuQVvtb2Sl42iYwvPvWCw&oe=6AFB1CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKl07oADpvgQ7kNvwFK_97B&_nc_oc=Ado1kJKQhxVhjC0Vbe-YWODI4lNzJcLvpFqqUcMw00RibmjblLz0aSHjVD1ZSimruyQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFo47fEeEqOhsnHEyJ3WeZp6J_CKUeZVbADr41z0cmPw&oe=6AFB3045"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "**Gloves Up** is a single-player VR boxing sandbox where every punch reshapes the sport.\n- Difficulty and power settings let you control the action - drawn-out tactical bouts to heavy-hitting combos that drop fighters instantly\n- Scalable crowd simulation supports over 1,000 spectators\n- Career progression driven by stats, aging, and performance \u2014 grow, peak, and fade across your legacy\n- Procedural fighter generation ensures unique rosters and endless replayability\n- 50 years of simulated fight history creates a living world before you ever lace up\n- Dynamic roster mechanics rotate hundreds of fighters through Amateurs and Professional divisions\n- Unlimited career path: fight 400+ amateur bouts or skip the spotlight entirely - it's your legacy\n\n# Early Access Notice\nCore systems are live. Your feedback will shape the future of the fight", "short_description": "Your fight. Your legacy. Gloves Up is a full-scale VR boxi
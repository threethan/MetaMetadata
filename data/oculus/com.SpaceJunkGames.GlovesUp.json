ts": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFiNJ4tTqsIQ7kNvwF6IzbY&_nc_oc=AdnXInwhdra5GgwhUIj6oxx_8cirx-JMKjIUJyNbijdZY-u5OePLQ-igp5txOoeNG2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIn6SdS_jKVwGtdsQ9wKCrtCcD63dkhWr6qem1lHhpmA&oe=69A03AE9"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5drOdsYMI8Q7kNvwHYXguj&_nc_oc=AdnXn5a1oYVaLqEe4U62y1OmTKlkPP6pMThmJ_fmMVnU7GSQNRQWfl7URsXwAZrQd7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvU8XZWhzmPKstO-cHZL0rYfGV0KoA7oZcTxT4HrqWXBQ&oe=69A02B37"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX0Z1skhWnkQ7kNvwECbUR-&_nc_oc=Adn4wlU7VgnVfpX9iFXULz2ebsJEYRTS9_wvtg7VPhYIGQ8TXBtVLnqtF_OYsSJNxZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvN3y2-0EWJl4NLFbEpyLP2ZwpThZ8wNE4kcKt2XPZvBA&oe=69A02C05"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxrD4pJcMj4Q7kNvwEglH01&_nc_oc=AdkjaqEpVY1zA4UfT7zWMktpVZFpuabjIQQ_og8MJ88X52iEhI8y8bFUJQoDuewg8mc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUrFmLBQNlXUnZucfUEufu_rFsTh-him6E69_9dg1bXg&oe=69A05C91"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMd9dGQOiG4Q7kNvwHd5eFP&_nc_oc=AdnsAyCck_ClH6CBq_g_O7XJR8wct_d_eAMBp2UYsvQS_sUETlIk-iPKUz8srMfMpeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGAU1QGCKtNNyqAR9Zg4m-BCoC6lTNyweI0SuJwh0e1A&oe=69A02B82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hjjm03GzWHQQ7kNvwHxOMKw&_nc_oc=Admqn63p-afJrhSjomWbLqdLrHfXvu5n7lqvUfzScBPzgg1q7sSxqjt74bOjFypNjTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_a3FH-IeaewsvC7aEGTJi6wg04nc5xEsItBXdjwahRg&oe=69A03D85"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GOePd3u_nAQ7kNvwGw9QJh&_nc_oc=AdnwVcoo_lpXLUL_vLbzyY0b6Hke6TKjJRBbtEiScQTcEl6vBSsAPUBKmxFnFG4jlXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfulNZUbiHna2AecnpqbCRh2aFATfdHSsCPOjq-3NBLy2
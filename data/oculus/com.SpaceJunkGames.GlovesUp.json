ts": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syAP7SijhfIQ7kNvwH18eqY&_nc_oc=AdmlSbB8s-a_Bkv4BP8xrsQoyp3YB7CpUX8kRnuHcmbM21EP2oATedPKw5EPkDaMbOQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs9KL3H7zWPWcdK1UB2e7aegOhv2VLUANVAjxTTAvQPYw&oe=69A580E9"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW8uXghyrNMQ7kNvwHPHY5r&_nc_oc=AdmODYjG0VCI33NRxPlwxHK8wj0gCBBSA3Oq6ajNVy6A--mNyhahz4Ey4QbUifRvZOA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft0s2PROz5SunfU1lgJfBxh17PRu64utNtJgOeCQ3nu9Q&oe=69A57137"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrZTDD0Foo0Q7kNvwE6JdIh&_nc_oc=AdmdgBR7Wqh80mJxZc8SCByeHEu5YiyT6ngiKKRig7zBtIgfhZ04L7gFdPoU-hrFJYM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuqtRwJ9szxpcv-qvNeVwBB6EmKvbdQg4BhbjOACDvTkw&oe=69A57205"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncwhv1E8Q7YQ7kNvwEfuX7L&_nc_oc=AdmuW7CHO9gfKLyT_TdHCexoN1cHIGScWy4O92JzVgJvA7NtPYtyoOSZKH78PkqVGqc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft5hlJQu99AIma9fj94Jd2InIUoWJgxiAnrI_-OyFrueg&oe=69A56A51"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOM9rdJ6vhMQ7kNvwExgz3G&_nc_oc=AdnRzgzkO4Iqmkl3FIcz5umkkdEQX-XlgGFldVc9zMYngjdRbusvFUCCulLigFCajNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afup7cxz92FwJMvJit1CvMbdmmRXBPiCode-9yZrmc4MqQ&oe=69A57182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II5BAHykKw0Q7kNvwHe7Sow&_nc_oc=AdlhXf9LWol7-MutzKPzzu7ZIs7KVRro_aFryPWB5p-8ISxfovPO2rvt3yU0RvUPd2Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfthqyEYGW-vnMtXoVjHLJH5QNnMv33RYDLmVP-Y0tjchg&oe=69A58385"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o955LdE2E58Q7kNvwEEwzCd&_nc_oc=Admd88KpCYYTB-jMB5iCOr9UAOXyn8LaMJCvrB4z_fU7BYTYymrl0TamofOtjIo_ZgU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftZTIdSaFOG8Z4e0nIbSBaQ5CpImWh-GwLEDd0O6jtGx
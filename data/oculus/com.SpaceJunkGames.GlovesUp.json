ts": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFiNJ4tTqsIQ7kNvwFvfYkW&_nc_oc=AdkJ9LJeZLha5wiH5A0u9pvoE7Q9Hlk_GiuYo-Dmsclki8d4Q3tjRlGceKnrhNSUJkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudHkycw582961-hPQQfh1g1bdY5FjQfPg0l9jYcDE9hw&oe=69A2DDE9"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBaX-O39JrAQ7kNvwFRWB7C&_nc_oc=AdkuX54rjhXMDC0DaHV4D2ZFfwgpKNGhVA7cCF-G225XeM0qu6XC-R3VC0xIx_T3xb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9ssYMDKu9PVBI13GP6OR9-8dUVWK_014n62E3MGSazA&oe=69A2CE37"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqdFldsBnfAQ7kNvwE8EWGp&_nc_oc=AdngDnCN3hJOf6bMQ3p-WGDKx3BxY8cEI4uQgxH03HAXgdiQp8bUSOGVwsVz1Y_6hZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttdYrd61YCcWgCAGO2lY-C0eZpvzHSrCXZQaJ2TAtKPw&oe=69A2CF05"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncwhv1E8Q7YQ7kNvwF4n_ky&_nc_oc=AdmKB_067PuR9T38Y3sHrEN0SD1hST8qXPy04v3RNTewoLGPRNEi822ZEEfliHahsZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfupUnQ3R_7E0RZ70Uxrapgp4biOZfL7cUfzjWVZu-GC4A&oe=69A2C751"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMd9dGQOiG4Q7kNvwFvdk58&_nc_oc=AdlSLVC1U0mN9B9uIQ66amzy7NphiiKNuBiXsWI7RAE0KcJiPU8v4XVRAbQOZB9S9_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvCARezV7c9342tcexVMr7ijYrN2dNsFbIn7ve45awnRw&oe=69A2CE82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hjjm03GzWHQQ7kNvwEWU1Rj&_nc_oc=AdmqJy9Bj-CoMMiT_-1YlBHV4I-skF1PnAD9KveXIB8suWT5zMEtuH8XH9f3lug9inw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQLk1nWK1GmzG6Hs5zjc_saysm20J1-luQKvcPPNuIDQ&oe=69A2E085"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o955LdE2E58Q7kNvwH3Icn6&_nc_oc=AdmkyqLxMkkn5KyKzs9nNO4Zg--jogAf4LQviT5_1tC69txOlLLmHONiS3uP-h0d2oQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftlMNOWavUDJhGAsgZBd6yLrEu8M8cWbV9pP8AntHG-B
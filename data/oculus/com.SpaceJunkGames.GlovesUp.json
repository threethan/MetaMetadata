ts": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrZKU2eN8eoQ7kNvwE4F478&_nc_oc=AdloAzh8VMNz4fDCk-0W5Mftqyp_5VuIJfjvbigSWTvYzfI4GQvJGlv3gqDeS-6btWE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuR9RPo_A8fRFDVVxOkvFHQED0PH2PN-uKmDoXgB6W_cA&oe=699851E9"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFpxzBB2HlwQ7kNvwHyYdMz&_nc_oc=Adk1f-TkeATjgCb9CMBqyyFd1ufboLlLWXHLE-QLdE_VqQkhFxeXGR7QzUFUBv5vHpM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfthHoikp6I3hoPhdTy8cuZBDHv1iZJw9JleAJFNdc9jZQ&oe=69984237"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmqcD2utc-oQ7kNvwFfr-we&_nc_oc=AdlMivUb80pSfz0MpfM6c2UcXK5D782UPZuSIBlRrx2CeTq9fcMPfn4fomcw3pQgqBQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft2FiHzF1-zWE6t-xqP_Djzj2elMkdvWjYbkbyGJ-w7-g&oe=69984305"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7oudzGBc98Q7kNvwGO-CnY&_nc_oc=AdlnJKsyloY8qPTSWgQ4ri4KKcFFdIyB9XBxdWXEK6B-KjlKc1Orh_hsY217Sc9_KXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvo-eG1FQ3o4tB5O9Y7BjumTiz2YLmGjh5VF5Hf7D78nw&oe=69987391"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q52BtJphWksQ7kNvwGxwfNQ&_nc_oc=AdnPfjkBuhFpkFMs6qxlrAra0yIszP4N36_Y4kv_QZ7U96joU-9EgliWwgrW7XtpZjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvq_RcJSK1zK3AfN63mr05KA-h0E00152oAKkTq2SgucQ&oe=69984282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqSnp1TYf24Q7kNvwE8V1f2&_nc_oc=AdlGeQdoXqHj458PzTUY7Rdy1p86uuIFtOoGz7x7v1_JdYjSyt82n3RUceY56G_ZbjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu-VRPrg0Ly8t-hJpd33H56tY1tdwaB1AeVulgk4m-gtQ&oe=69985485"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6SZDo9sM1UQ7kNvwGQDhY7&_nc_oc=AdnIAIDgykC1tyFSmaRArU6AL2ehvow1Mng0RBS5NEvipxMLgCizt4MZNnErFRe9uGs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvI3wBe-4Mu6UohheDgoclVNIKzWjvrTV2Ffvb0pNdVf
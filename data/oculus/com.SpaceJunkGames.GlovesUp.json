-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXu3QNQXINAQ7kNvwHRMvNt&_nc_oc=Adr-7RN-dftHA8Gs8LevG-p47TXYzlEETCNl8NkvEFrigPy8U4dbEWycJm8l49UrOsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_5lIBP0h0FARk9tiuumpyrwHVrS7SjZlTdFwHmcr3yw&oe=6A47AC05"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "**Gloves Up** is a single-player VR boxing sandbox where every punch reshapes the sport.\n- Difficulty and power settings let you control the action - drawn-out tactical bouts to heavy-hitting combos that drop fighters instantly\n- Scalable crowd simulation supports over 1,000 spectators\n- Career progression driven by stats, aging, and performance \u2014 grow, peak, and fade across your legacy\n- Procedural fighter generation ensures unique rosters and endless replayability\n- 50 years of simulated fight history creates a living world before you ever lace up\n- Dynamic roster mechanics rotate hundreds of fighters through Amateurs and Professional divisions\n- Unlimited career path: fight 400+ amateur bouts or skip the spotlight entirely - it's your legacy\n\n# Early Access Notice\nCore systems are live. Your feedback will shape the future of the fight", "short_description": "Your fight. Your legacy. Gloves Up is a full-scale VR boxing sim with evolving rosters, living crowds, and infinite career arcs"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"
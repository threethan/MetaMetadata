47838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqyLXXviDeoQ7kNvwEBWMBd&_nc_oc=AdpwO3V64wWgKvZZnp8fDFiBEjr20IQzvB-wD4XQDTJ-yWUIMAxYt9CXkiUmgFZxZV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45HioN_D6Og-eb1GBQm8Tftu94EfaU2e-ZsyRUZQQL2A&oe=69FF4FC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bj2RvWDTvQQ7kNvwGZSJRb&_nc_oc=Adpn8CovaLrl6Ba434FdNAPvDJkbaxT573x2OTB1t1iRmRadjIKh13q6tjDZGRTl_-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XI08EpLRCTSwckiJqG6XcTZc5GRwDqRhCUum1FC7DCw&oe=69FF2985"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmVnz-sOfC0Q7kNvwHc8VOJ&_nc_oc=AdpM_3msQmR-W3178sH2EE
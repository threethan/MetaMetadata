3386927786410", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zN2KhVm7OvcQ7kNvwH54FIv&_nc_oc=Adkk7T-hWB5iYhQlzZut0p7EjODkx6xXip3r15WhAyMusyxPs_aamXywo0-ZzlyYIho&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyODJzYX63827V8cG62XmHe_H3OGgiAwNoj5QWbcpFGDg&oe=69B6A469"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmpq0WhExJkQ7kNvwFG6Z6J&_nc_oc=AdmdgNM5tPDvONRTxiQmQhoRCl6bqBY-p5jhechylxE2GPndQ0b9fZ1CuY_oo5J2ePk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv-fpuTr0bcSJ-3W3qGzKoGGhwp-Moy6kHnwF2e8Dwuw&oe=69B694B7"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sFUgPg_4ewQ7kNvwGin9Yn&_nc_oc=Adl697nziSlLy0DG8V6tovQ6SRwXj2j8f9NhO7dYAUluc9YRwws08SAmrA4MACmIpjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkWIO0XtNxX3lfXHxEyA6g-COeGqtjb73AXtfa0g-iJA&oe=69B69585"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYVpWx-a9LIQ7kNvwFV6zKl&_nc_oc=Adl9z2C1JFvuR8Se2c9q47hjZ84FpM0qZDbDoUczzul1-WEVEuP4A2U8SNfoDKdq10g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0vNpaNa6Smdu53b1-6yyjzD7-W23zWJGpBREC70P9Nw&oe=69B68DD1"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WKMqczbPn0Q7kNvwHdSDq0&_nc_oc=AdljgFHlztJ2rZ98Mbyw83_ScOUAXipVxEEdbVNGSiTAxEZgWuNM66ufTG50WJuOdYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2ey1soxQ7PzQMso4QP7sa4bixCdPhZZhdAuJymU7bFw&oe=69B69502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mV5Mf2Xpd8Q7kNvwGfhIbz&_nc_oc=Adnp8ll39Qn9spKIFknarVxDCyRF8IT_6Q-lIhGMvbsy83fj89nmHEbfGSNuQEc-ZMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBz92Vu3K2cQcsdCownxg8pl_d434-YLHpqRrOzn8YeA&oe=69B6A705"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfIHwXAfV3QQ7kNvwFYydEu&_nc_oc=Adn9QKKia1r0ImXSnx-zbQnfXElvBB8Q6793M6sdavBhALcaqGJOkOWuLqy1qerHC5
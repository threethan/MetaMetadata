": "813386927786410", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07TZnyP93-EQ7kNvwHyzC_n&_nc_oc=AdnP4nqaArK8uHQ0jlaA7gSWjQra_LDBcnzE2NfCu0OXFbj43LQWqaDcACbxeSuJec4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNEosnHw3fiaDb39N5mGKLIOef439U18xzpnTVKtjJQA&oe=69AAC6E9"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbuRtGaGFkYQ7kNvwEFudqy&_nc_oc=Adkul2irRDiyFf_QhW6TCPjcjd2gkvY7YKqkzAGjsMz0HzWjXaUYt8cem5p3O5dmMCk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFMxgnjYQGlPfhUB1QbURSe90ylY8WCfehb6CAEGHRYA&oe=69AAB737"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLMd_KE-5usQ7kNvwG8-wo5&_nc_oc=AdnCcMCWD-Yroznd4NK58A69xxwTqmWOaecssPchobLhVoSVN2pbP4AX7_wZKTTnDRc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdIQ2BpMYtrU1CAci5XAhCdd2uZuqP2DGrGkSa2djcLw&oe=69AAB805"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb3q3unn5hwQ7kNvwGKShV7&_nc_oc=Adki1WKNxqzty8O96NfkFe_A_f7SszDfbSdBOqZcz_l2Ec_xEf45qtD4fB-sQLo6Ab4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZzRu0Vz1lBVVTuDw862kB714lOqXwB-cZb_8tA0tH2A&oe=69AAB051"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8udsCJHVNYQ7kNvwGqaxJK&_nc_oc=AdnbGkb8rV6rni0KXl6oE835ZocGapcUfmJzE-zeGo7MGy_zLvNa9anU7zJlDiTFqOQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzoMEpJvOiyvu07Sox6tcz1dBek__8MWqaztUT_wmtZaQ&oe=69AAB782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbmW3kuTjIAQ7kNvwGaoos_&_nc_oc=AdnD7wDMYTmenapBnRnz91E2jVOgaWOrn8YRI8RoOh-jt1AUQvkI7kpZ-3HcAlBa_Hw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx81LwKNVckFNrojz0k_AFGUwX3ZrTGfBFPhU5Zv8pU4g&oe=69AAC985"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gt8UQ_5DRAQ7kNvwGaRat8&_nc_oc=AdkosBGzU6EUkuLNRfrpWL-SKGhIFvbEnASPsI87VSQb0TnawLFJR5RbWb
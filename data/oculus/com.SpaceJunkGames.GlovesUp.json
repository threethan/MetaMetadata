ts": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqUnBj60hCkQ7kNvwGqMY0I&_nc_oc=AdpFHEyNT3tQg462r2HrecOe5YKlsXm3guid5WK4RVyCvgbfq5owqx4g0odYHAg5vUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1vzS-Hf3EGoaiyDaDa3EQwgvSJbjq5Z-6yi4WwAXemjw&oe=69F0A669"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVCL8Wd3-q4Q7kNvwG8Ys-g&_nc_oc=AdresPR47CqwQB-3Dmiaqf1-nmcwTcGhbzq3-gyUJVD6rut4_QiZJ52p56e63-M6IgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3S7eyWCSdyTj5KybOE0OCxPB2Zgwd9hNx4tWlMpgvJvA&oe=69F0CEF7"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fvwyMftBgoQ7kNvwEyElXy&_nc_oc=AdqNQUtmBqr4GZi8zzHUuVWsk9amzuOP0I8F2LfDCxMfoFluv_MIatqj4lujOINBG6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af29UNfArjc5YKSJypnmMepdw6MFrF_wxzJ9Z0os509DsQ&oe=69F0CFC5"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiYKXGlAqX8Q7kNvwEUlANp&_nc_oc=AdrFnaXLvoKAE5xQ7-UgVhYb_BqpmF12dWUX1KeM9cE3j9utfFul9F7qlKcEdzunM8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1XizVqknjO3HVunmfRdSJ-94Gvt9kX7sLfoIxsx0UKQA&oe=69F0C811"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMhhwXv32kQQ7kNvwF5Rfhy&_nc_oc=Adro8Bc5c7UWeKd4bBOqKf9oG2NUaIs-F0_itgS-wzPiMLZImofnFwwDzDIubLYD8eU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af11ZCDzRxghBV0QYMAlyKXlx3KZ4ITyi80BLNP7ngCXFQ&oe=69F0CF42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gH4UWttyE4Q7kNvwF_gOzF&_nc_oc=Adojfvh6roKqgJfo4HTyFq2CRtpwkk6xkVe4sEtDcvolJgd-_9tzcuC4bLE2L4AMOVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Wq9pltKwZQIH_utbdyqh_ewiaIk6GtlH4W6jQbwPzgQ&oe=69F0A905"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdFCxkUFQmsQ7kNvwFzUcyn&_nc_oc=Adot1HeWJ1lFoOt-S3kNVL0Gc9C8OpGahUc095HpwLqSqOY54Y_T0_VrVHCxEcMRk08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af277aFfIg5Xw0YXvsn_7C9uZYEk0zbj78u3LGFtZlC_-
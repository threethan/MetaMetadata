3386927786410", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A5TSXKmaO8Q7kNvwHqBC2j&_nc_oc=Adl6uX7BsLG5ijaZ2cLP6yxBB4quopWhBWSt1Gq9q1G6-DZpqsWbAoDYsqkyw33kK-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyx13KwGLCcWzgl4ugoX6YkErzfED-b7l-jVXz6qVi4jA&oe=69B2AFE9"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYFPdGUgyrgQ7kNvwG5kTLA&_nc_oc=AdkbOW5qy_KQWJ4SK8mfWlIkAe8Rz54W3jx-leEuTo-Y8rQkpilgU74fGk_N7K1c-Vw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLnRxw4-oP5YcV4LYLm9k_O8ZYvgwVGjz8yvpauZjVFw&oe=69B2A037"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoY55liNJ0AQ7kNvwGgD7Kt&_nc_oc=AdkOm_S1LmztCxx50MlkcuBI-YPwX2f1-pvfyv898aU8ViItLqmqpydFvb330CyItN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9_k6y5ydz0Og1E9Edy63ty-X0oi9XQJqWhWzsoAAyzw&oe=69B2A105"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9EH0jYe1GkQ7kNvwFzL4uA&_nc_oc=Adntm49qnAMjXvGIQQRsOa1f9EugOriPG6zAnr1YCLeNjKR4WR52XgKmvoBhSEEZvKM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw74thcbiklsC29n7SaimbTYcMAHkcFZGVxuehXWtwRWg&oe=69B29951"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7szP_nE19IoQ7kNvwEOJB1f&_nc_oc=AdmSW8zi9vmsd4zx0NVca5ybU8rPQqVFWZfOyyyyai_LWDupkkP-aK_zwktd6Wc3ScM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxgstSJKXmDCq4if0hn90ZrnwyFUh3PkjsC2u1f53WiZQ&oe=69B2A082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4oJMpKxcZQQ7kNvwEhHU05&_nc_oc=AdlW087YtSHZfiqbX8cphoJUp1XEYmOtcd2GNSAqphbexDQDx9uNDDbxVLN-p1wphmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxse0yZiBVztMaF1R0bGF9mgxwgpi5AerYQepxJ6JxOZw&oe=69B2B285"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEwsBX_hJd4Q7kNvwEos0iE&_nc_oc=AdmSgzbTdZ7atPLxRThQdJwg0-y6rPILrwfhXMi16PzxxUUw_Uw0UMkicSqhA9hTom
ent-iad3-2.oculuscdn.com/v/t64.5771-25/499307444_1071721787948215_7381303741412865625_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVby5o79rC4Q7kNvwHF8VfX&_nc_oc=AdqxywQx9NLUAaWG_IOnRGwiDeXTcZNirzSIpO_YE-UzmUUoN2f8CA8z7XLZolokalw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWNSl_4aodF8p4sCyfsi9iVBD4a8o4uhyfoTpXsjLyfNg&oe=6B0F1B93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57raOZL48qYQ7kNvwHVVwb3&_nc_oc=Adrbbgg-xryQKqeB6201e0111bdSuuUBVox-hcN3K7URKmTxJgc7TV54ym4YSZ_G41Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWILFB9uNTgQpc_2qppmif0OSF1xJ6dxNrst8e0X-QFcQ&oe=6B0EF6C5"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "**Gloves Up** is a single-player VR boxing sandbox where every punch reshapes the sport.\n- Difficulty and power settings let you control the action - drawn-out tactical bouts to heavy-hitting combos that drop fighters instantly\n- Scalable crowd simulation supports over 1,000 spectators\n- Career progression driven by stats, aging, and performance \u2014 grow, peak, and fade across your legacy\n- Procedural fighter generation ensures unique rosters and endless replayability\n- 50 years of simulated fight history creates a living world before you ever lace up\n- Dynamic roster mechanics rotate hundreds of fighters through Amateurs and Professional divisions\n- Unlimited career path: fight 400+ amateur bouts or skip the spotlight entirely - it's your legacy\n\n# Early Access Notice\nCore systems are live. Your feedback will shape the future of the fight", "short_description": "Your fight. Your legacy. Gloves Up is a full-scale VR boxi
38F2B"}]}, "id": "813386927786410", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_060_0000.png", "id": "1951250988995644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623179_1951250992328977_4077182840788099607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwD7fHjD3RYQ7kNvwFZCGls&_nc_oc=AdoWcGUHkpkKb08Wa7Q6KELNocPWm4tg5uEWjhPzuWdrdE-UVaY5Eog54h_DgG2vLMc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCysUuG4heZUmzFUYN2_NA8MO4tijAWKL0ZSOq1Cfx_DA&oe=6A5386E9"}, {"file_name": "ActionShot.png", "id": "1547131896455573", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619098_1547131899788906_756131324390421151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtoKJx9LkOgQ7kNvwG9M7Nz&_nc_oc=AdrM9ciZs0dP8bA3ujsM7FlBCao8bFyfr3UYk_oJmbz4bxB7oNslnlhTdCHjonaYXdw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0Dk1bs8pAiqDRxbBbJJ7IMmSiZSk5U2-td7dMWvEOKg&oe=6A53AF77"}, {"file_name": "Image Sequence_089_0000.png", "id": "805063061857555", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619808_805063065190888_1968071561341593887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-w7jZJwolAQ7kNvwFIYCsA&_nc_oc=AdpA9r2Jm72Ge-hUcg0JPqoiBMy-xDCgp_vJKczz2wf5KqeytHApGQXV7STCeE-dQ2k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTCgnu-SHMcZENE4QkBl4Ubs7r6vyi6TLpw06UWPeN4A&oe=6A53B045"}, {"file_name": "Image Sequence_032_0000.png", "id": "956237166638765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507827918_956237169972098_5262338259199021762_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4MCY0aBfD0Q7kNvwGPXSXo&_nc_oc=Adq8g8jk2nt1_nKfe0iUNhfjoEqg7GdcaV_EdsNUXA8bALtCH7wOPrxRi_LaYbirBco&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnT1WDIM66fi6PLR6ydmoZ7KSpPyKA5ZpWZay_MQOs8g&oe=6A53A891"}, {"file_name": "Gymnasium.png", "id": "1499719844505054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307466_1499719847838387_2905519117021823644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=984fm1w-L5UQ7kNvwEKGd5H&_nc_oc=Ado_Ei6soT6wPLMs4P2IjUfRRoy2IQWlTDQe5w_embmwqAZC5vloRxISAxEZVu73NcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGWfGyibufhStf-iesfkPPV-kjaUFDt6ASZvcEmv4P2A&oe=6A53AFC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gloves up_Landscape Game Cover.png", "id": "1104717774910712", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619829_1104717781577378_8494564826830694206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPlmeibl-4MQ7kNvwFBqYZY&_nc_oc=Adob8tp7aV_gIf2LDTkKIRjbJM6rMzAJx9ZNDkcNUYwYzpbEg9XPW0AU8zLp8vYI65c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl6Cv4Uu2Hy1QZd1CN4q3IFrF2BF_3y5WxUcRHdbOLNQ&oe=6A538985"}, "display_name": "Gloves Up", "keywords": ["Fighting", "Simulation", "SinglePlayer", "Fitness", "Training"], "long_description": "{1440165610621462}\nJoin Discord:  https://discord.gg/ZERYSbXXV6  \n\n**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving.\n\n**Define your legacy:** Rise, peak, and fade across a lifelong career shaped by performance, aging, and relentless training. Play as either male or female!\n\n**Feel the fight:** Every interaction runs on physics, from head-snapping punches to satisfying knockdowns. Even the menus are physics-based.\n\n**Train smart:** Build muscle memory with slowed-down AI in diverse training drills. Master slips, rolls, blocks, combos at your pace! \n\n**Dynamic opponents:** Each fighter is distinct in appearances and styles\u2014ranging from outside fighters and patient counter punchers to aggressive swarmers and punishing sluggers. All procedurally generated ensuring a fresh supply of new faces during your career. **No two fights play out the same**\n\n**Hype up the crowd** with ring introductions using your profile name. Scale from intimate amateur bouts to glorious pro fights in front of 1,000+ dynamic spectators, feel the adrenaline rush when the crowd gets loud!\n\n**Customize your career:** Dial in your fight style\u2014from quick knockouts to full-length tactical battles. Set round count, duration, break times and more\n\n**Early Access Notice:** Core systems are live and evolving \u2014your feedback will shape the future of the fight. Let\u2019s build this legacy together. ", "short_description": "**Gloves Up** is a physics-based boxing game featuring the long-awaited single-player career mode fans have been craving. There's no limit to the amount of Ai fighters you'll come across during your career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glovesupgame.github.io/GlovesUp/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Space Junk Games LLC", "support_website_url": null, "website_url": "https://glovesupgame.github.io/GlovesUp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905512202379697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618444_3798484617109750_3716370912452312485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zr_s2kgRPkQ7kNvwEqZO38&_nc_oc=Adrr797YGxsYwnQ42P7p59
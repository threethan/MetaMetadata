f&oh=00_AQB829bhsgwrSwZZoXI_i-Ud_PYFSNh6T8-JLCIAZCD_Aw&oe=6A60D8B6"}]}, "id": "541172737938506", "locale": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXROid17wRoQ7kNvwEoAadA&_nc_oc=AdrKBkquSELxbclwX1r1zkm0QsifDwPiTGCSkYvZbmA-UD0zedyDBRRkZrTfgWV9vdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUIDzhoqz5kzpcC95e4oT2dIfT4siuJBqeMNkAMEBccg&oe=6A60B0BB"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNd9OXahJiYQ7kNvwGmLtPY&_nc_oc=AdpiWT6a8L65sOrQYfk1iTVYPGaasq69wSkIEZkDRk6ZV8Bk3Uy8GA1DZE2usjoEXR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH_UF7dsWub-CiVptarnmthuG9HmBDJ7M0rOLl5pFSUg&oe=6A60ADFB"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjIDCTf3DlMQ7kNvwHbyOA_&_nc_oc=Adq53rCnpNWNOOE2BUtqjSVSUJ37VHB8rWC7L1SIYhPKsKV-yVXloI4KeYNiwxAVZEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb5ulGjppaB7iPQCUKUQq6PjyDOYjKgxeRMpnXfl8q4g&oe=6A60B587"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3LaEnn1h6IQ7kNvwHvi7ro&_nc_oc=AdoMM6XY48Spr6WZINFkwKcV65LVfaJjjRzFjrZMuaLpBgsj09BYLPBY-PUEPAniWhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO7lBneGb5atm2YgCUMBiThflno_chwgmOMeMqv00bpA&oe=6A60A81C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X8l263cRxYQ7kNvwETzsbD&_nc_oc=AdpDgCyVi52s_HN9eico83Rd_WyGv9H2oF7SW_pJjfZgrh3xF6oLpYFFxCzw9ZpIe2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpxb8oKv35dc5h9_jbh1snEV7lYoKj4vGZCmJYoVHBfQ&oe=6A60ACD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RAT
": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c1mu2H7lHsQ7kNvwE17YnB&_nc_oc=AdoI0vEQOJX0JZ16u6iCtcY83r2TLKx-o5ZM5X5s5GAtGZROnDriGXaCESleegRoU_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1TnQmsjCv6x6UcH4C5FvNC-UEy1iOg9vuk-qDJsqiysA&oe=69F0A13B"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJLK3QQxnpIQ7kNvwEGlk1D&_nc_oc=AdqN0Ca-WOsgv-7dewh3su0yAvxyAe5QEOGTyuHEpswH9MK7Y3VSflqnC8h-WoSt1ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2cVvQZXYFpSGwC0M7PxdHvi6QF0ifn-V9TiW-7qVCdzQ&oe=69F09E7B"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvkPg0HrmkIQ7kNvwG2Ko3x&_nc_oc=Adrrvzt6rJvev3Lptj0824bUpSGZmFGIMhlPFlQxUOXjcq6tTqUBU2eJZHGV1EKwP54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1etqPngxvFY3UUXf_XekuABHtItFTvGGlJGEVOL4rY0w&oe=69F0A607"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWvzKuplqr0Q7kNvwHdjwaJ&_nc_oc=AdqtQ9DB8u-vSjN44FjR-V-t3QCKoR0-gI5EwvkqG9pnd0W2-G6UHMn0YCAFHrXDT7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af31ZaJAx9iVLSl6sm38va01kLIlrs23uFMVufZQO2YATg&oe=69F0D0DC"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhm7xvMSqIEQ7kNvwESkjud&_nc_oc=Adqf12xd2mQBEGUTY4_JWP9G965-tt883Fm69BG9H8koyY-xZIdAH-DxdLIIq0n5fq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3CnTvxDyOuNo6EuS5DZ7bi0PfnbYxAyJm2Wid-bW4RDg&oe=69F09D50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2756292102028
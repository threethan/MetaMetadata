": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJAT_kvdcXoQ7kNvwFE-tR9&_nc_oc=Adm4Ecy01vVqZc2yT-zAgkM_Mwa_K_a5wuPZ0yW3M-r520IY2X2mWj_se9mNrz36yCI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfugNEW1lV4_sFlM-vqbxOQx_R_-iY5l09svEyYHJ0GkSg&oe=69A1873B"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyftAjSsvl4Q7kNvwFWKh1_&_nc_oc=AdmgSOSPLsx9l8OfBQmAZC5UoZ7PGkKwEVUBR_Gryfuph2ookQG-yN1mWJ_JbmoPt6A&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs0pHSZ0vh9sQeFbBFiZ_HeMFe956nZLYa-80ESrb77qw&oe=69A1847B"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efr6NNJdVIQQ7kNvwGQwQhj&_nc_oc=Adl5sLHVtvDsus_UsdGCqaMQtukTFCvN__nEkvZSYSqhjVJw2EhcYlxH91sCXoIPv0w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvTWbBIvICcFeXnrurICeRN-GIzMguSWbK1FwLfVoWp5A&oe=69A18C07"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gde8qRA6mEsQ7kNvwEz1FhU&_nc_oc=AdlMg91-TYMMbOijUv_MY6hgK2mhhXDbre-p7o3n6qTxnorbuaD0PVL0zQiQo8KelDo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuwPlEN9STE9AlhbYWrqlRR8iY1P7apY2OPM8to6R-2Ww&oe=69A17E9C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5UMcuhBkYcQ7kNvwH7NDEn&_nc_oc=AdlyarLRZAZJlt7vU59Imqarlu5YT1IUoOQ98-VwT2kCcntFX1qS2fxcSvIDQUSTRbU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfstgoZZkvAmaXc7NwSSB2QekIXOUYAQRYG5JnE2TfTItQ&oe=69A18350"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2756292102028
": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWtcHbO2W0YQ7kNvwE2uM9e&_nc_oc=AdmO9xdg-8LdYUhiV4iiwWkc6yCmaXYGKJxeyBf67-uBYX6miQjRBbLKy1_lze8eNUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsbODrGCc20A5GiuDCiNeAAbepivC3mcoocfJRf-KFcFg&oe=699C413B"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Il1QsIFpEdcQ7kNvwGuV3hJ&_nc_oc=AdlJRmdau6zrIpIdvQxMqOQVrvdFpVA-YBCy2N0qY5tV8wvR8GDm5OwxBzsvRT6AkO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvXACt7mJUB17ZKpvKKrLopWSPE8g6sZ0cG-8bCx0oodw&oe=699C3E7B"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjPCV9d7ba4Q7kNvwGlcJ6T&_nc_oc=AdmJU5NAxhBbhL_ZmBOzMKFh_5vortwWPHHuMUGD6378PiYCG0LBQXcBmtayVDx2kUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuhyUXP3cWijdZ1n1hNxpQZJHptYQJVg4bg81vWWOJBuA&oe=699C4607"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR47k_NLISoQ7kNvwH4iFJ3&_nc_oc=AdmSmQXoIrCppmWRzqVs-TSWOWVl-z4CQNdPeMxsBDgZ8hvZr6dOFDFYiYlYWlnSvZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftZyASO3k-yjTfRdcv5S1pR4Mu-fI5wdZDqTbNXgGoxJg&oe=699C389C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWFU5pwkEiQQ7kNvwEEw63K&_nc_oc=AdleboZzuNmmq-2mpuW4nmdFVK9AiBI05EJ8oP_ultkGvFGxX8stx4Xdlyv6MIdOxj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs2W9vay9BzIwou3vFAWKw2UmCJj5z5JkUa9eWgs627Ag&oe=699C3D50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2756292102028
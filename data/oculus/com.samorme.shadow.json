": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJAT_kvdcXoQ7kNvwHOL9aO&_nc_oc=AdlvOdc59pQ098rmpKf0FQCTSUM_GhxlryRHQhu68Ce6fjhTWAQeio03J1uQet9Yk24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9EOzN-J0N1DWNsNUOauGMwf8Eg1LuiDX4jgDBb2POww&oe=69A2D8BB"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyftAjSsvl4Q7kNvwH4MiOz&_nc_oc=Adkal2d-zK0yLFyui-MXste5DixcPAbhCCN_SzL8lkFivCdwcl-DxOtEmEcO1Fo1iFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu1okSm9I7wjfHVAu--g0BcMBFHhYaVtEvxOONJvlX2bA&oe=69A2D5FB"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDXtgOKQxK0Q7kNvwGu8HH7&_nc_oc=Adn7hMer0i-_tnDZzz4bbjFIOC9pYAXdJ5Mm79I0GAtfouckKDsWXONFKA6kM7uKgUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfssgATCFtfjVrriMPDOY_sheR4gpDeInf6yi_YspPB31g&oe=69A2DD87"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gde8qRA6mEsQ7kNvwFDjVVo&_nc_oc=AdkSFUxoYjolkYD4cNsj1a4mQ020V91PKdQ9KwnFilTSfNNlh27X_ktQOdxZENZbUjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsXm1qtKOOQalhjqbv_8_EUf2C-BksyyKq_9biNOh6E7A&oe=69A2D01C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5UMcuhBkYcQ7kNvwGyWo1C&_nc_oc=AdnCO7mKwm8KxpGFmqf7SMYPoEpewRhOfqPRbvMWlBCGwiRVjTH228TZCylIlsmum3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs4eVW9cI2KE5s8ampwKqxnFVj40q6Qg_8V8npa4ZF6QA&oe=69A2D4D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2756292102028
": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=589E98ANbHwQ7kNvwF-J93R&_nc_oc=Adlj8i-65h_6yc5p4Lgr1EurBgUMXI3dGZYjC0uJ3dYNzFPqDvPR2bh-9MlX25dAaLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-xcGaAnOW1Aa9z6EKhpho5gO7j7QYcMfklwz7M_M6wg&oe=69A6CD3B"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-rNCb6zoVsQ7kNvwHdFFMF&_nc_oc=AdlSIsUBn5ZRS7D06FSU0k6wS-tovqDEaYoVANPMJ4Q8vKuIMFi5m-47QAayD-qniv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQiuEQk4sa9Si-C0EX4ysBCNlhyTYcFpjoqX_WZwbcZA&oe=69A6CA7B"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRBzhA6Z2ccQ7kNvwHA2OzM&_nc_oc=AdlSDpjrii8l0RY8J0GZV64JPxtBMKEy9TjA858LWy2kmWtu6NxX_H_7TOQTfH21LNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu6IZ-BChP_7STgjI-pgOCzgw3dbQbxXNV9H4WL2AVhUw&oe=69A6D207"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgldjxAC9kUQ7kNvwHM8x9m&_nc_oc=AdnYu-5RXVMjeqoGrQ_7j6g8sxhAnxWxz_pGaM2TY-_PavsdSE4mbIA_wTYpxE2mLGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfthAsWy409AtOXddW3b9-dszSOCTFnjcMf-bTxJMF8sOg&oe=69A6C49C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oVZUAMZt3AQ7kNvwEzHcx-&_nc_oc=AdmADM5e_ZIQEBpvaASexoMfDbK9usAcaDpUiYM_FPUqbvG23O2SVAVOCfFP0HMdjWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsAbRg2F8EtWlbeIT-s18nLacT1_MLElVVODiB3JmBIiw&oe=69A6C950"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2756292102028
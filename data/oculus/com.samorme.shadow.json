f&oh=00_Afyhb0py3t_uztObrsbbfIT6OgaPJAkh1Rh9Qt6styQUHA&oe=69C26C76"}]}, "id": "541172737938506", "locale": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSbnQ6DE_FIQ7kNvwETmCL2&_nc_oc=Adqjw9sFxBY2w-4kcqewDVaLWaQjyLetLKHIcQ9SlrXgG78lV7JPkFAvSc3CwJgZ5tM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjMaKiRguID-QXOxlJhBaxiyul9gndht08k4sTBpPYXQ&oe=69C27CBB"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tGmjTSbRAIQ7kNvwFvC-QJ&_nc_oc=AdqPi-uFYM3QWJ3FI6GmYmQD2kuAxPSkr0VwcjdPIekN5SQCKT4drWx8rQt8rpIO4tk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybstuZgx0_Z2uI-OG8RhsLn1QHtyGuXCU_x993ZQWJfA&oe=69C279FB"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7_avHi3AyMQ7kNvwF2noOM&_nc_oc=AdoKmSEN2frMNeRosy0OOI4JbBRTBzerFKiwQMqA3_j1balT-Rgk9PfXV6DpVnESRBM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_AINoJVm_o6hbmpc78eKOxiskPJA2MR1wcJsHRpDsvA&oe=69C28187"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5UUv-piZuYQ7kNvwEIkPON&_nc_oc=AdrFh6ldjTSWZspVb5XIhTSv6yyHZYfbkOtFYNFMWzXvxfE9WLkHYTyg4foDuxAZSsg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afygw5U-Mdt-iuAXdZGEkvQqXLSrQfoVky-vZRYUYKG9uQ&oe=69C2741C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9U42AlQ8uQQ7kNvwEgGGUw&_nc_oc=AdoKKB9fQVYMJuU3s2U-bv95ynxn_0wdrVtlVjdMW3bUasIh2JIceK7l0fbHWCgMzO8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrGddkdIUUHId5EQ91bKom7-S68RDd200fsfyPjoZR8Q&oe=69C278D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RAT
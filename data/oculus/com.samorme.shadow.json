f&oh=00_Af0AEI9om8phKpatA2MgY7FHIKKV-wThQIBTxGT8uFX5mg&oe=69D7BCB6"}]}, "id": "541172737938506", "locale": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJOcq0m5qRcQ7kNvwH7Ho27&_nc_oc=AdrnQaRyX9HuQ3L_MdyqTS_8d6z1_-H7iwvrKCmknMrp32wAX69rMvKmlf-9dths0ws&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NIDeF9-6zIUqWELB4hntCUytnpKJKHkFVSiPE-O4I4g&oe=69D794BB"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJNKUBGgX9sQ7kNvwGa-JE8&_nc_oc=AdrPBWRmKcfyzZWP6Spv0XmMko690mTJeL0ypXVdI3GCFnirTG_TEz4UgKwqR89i3KE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07J7kg0LCYJFL-EWRl85UxJANZhy9eMdJlSdKHm02iLw&oe=69D791FB"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bZCUXio30MQ7kNvwHASHaZ&_nc_oc=Adr6p97loSxY_U2duwX2wyY167o489dDElBeLjtvxzVW5Ln3dxHGYTI-_A0C_VgJcYQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EtxL8Ty52n1m214uwVsvTHUUS6foOC2gxTDv36RjcZw&oe=69D79987"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZf60s01JtQQ7kNvwHFQFcG&_nc_oc=AdrAP7qiXa9NLWdgraARhS5YcYhOraUygh8ZoWsRp6d0FsafYxnCTNi8Sh0_rfy_yT0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03aPOKQGFArEo9nyOzaSPDYBcfmdqaTi0qUBb7uBPDLA&oe=69D78C1C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_40HKh18isQ7kNvwFg126U&_nc_oc=AdodN_cDD1i9yBl5YbvVau_s6aBlLdH7QxEoMi-8mpgvDFIt6vvcmeS2IbYIZZQXisM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Un_Z08Ehf7B6Z9scy02p3DTug9kIcYYsjeQt2WqwTUw&oe=69D790D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RAT
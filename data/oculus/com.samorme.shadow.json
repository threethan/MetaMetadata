f&oh=00_Af2EPVHiva30gZb6Pz8r5CWyuDtksWHaNFRms9bcS7B_mw&oe=69D276B6"}]}, "id": "541172737938506", "locale": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-EIRxCIxRQQ7kNvwHF1Oo2&_nc_oc=AdolVuZrMjWpvZ0lhlZUN25r_KRp-ks-I9HJ1lNX0wlfNFHrE6siV_b3IsqnxiDX8zM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1okwVLwo4vOF8CzmqPA0dJ_YfB9-__FcFjM1_oqrvDnQ&oe=69D24EBB"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGfa_IxpI_YQ7kNvwHZn3Ag&_nc_oc=AdpzRzl6Hj-lyFX4i3mmUHMomY5LnXNJwcw805z9S3FVb3PINaLvQ7OUfoQG62dz3aw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cSmow0dDzKoQTfFydUAI6Go1EiKKce_U8alD4K4MhrQ&oe=69D24BFB"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A0xYq73LUgQ7kNvwFRzhx0&_nc_oc=Adra9c6MaqpVJPjf29TNxoz5fGFtEDot0MfM0XLSuzMEuprhpubuWBUrpdH1bFCPSZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2krTMW7xxBerfLTbkZPcLFTtMN-lzctANwcOgtM3R30g&oe=69D25387"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDcnpqlivKIQ7kNvwEHCVEu&_nc_oc=Adr6_0Q0KB4HsYqtHGUeOoYoHkhhx8ApzZmaMhhPvpiLH4PB7EocrW3LocLPbOZ4Nh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04r5Ja8CHtXHVrriNBNzhGHvoSqLYj7B2huinOvszc0A&oe=69D2461C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7Cphg8CZ7AQ7kNvwHrOn75&_nc_oc=Adoorfp8Yo8QmkhP0cCtWL5LKFabrQJ6EDJzW1PP559TYdzE0YkxZhMfuIOdRB5zZf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RJbTYNM5WxSEYEZrwdO7MO9fq56F_JyeBDXKi54tKkA&oe=69D24AD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RAT
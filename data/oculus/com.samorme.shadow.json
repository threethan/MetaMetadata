": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWtcHbO2W0YQ7kNvwEkcYxL&_nc_oc=AdmaRihqk7HMtwpFoQeWCl3CRLr8-d3YihcN-yncQklY7YX2VqgIqIQpCtbmKtOH2r8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsOG4RwDcFVlO8b-XAeoNIe8eRYudobzdr8X-V8i0vFeQ&oe=699AEFBB"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Il1QsIFpEdcQ7kNvwETyizQ&_nc_oc=Adn0UqUVV87U1KA3UL_Kwaior-NVwELnict6w3tA--sAdFQm-6Dbeoa74gz8oeZr6-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs0bqcD1xlk8K4n6khdDXgW6YkQo8aAg4fRNrgY-Ex9mA&oe=699AECFB"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjPCV9d7ba4Q7kNvwHa2TkP&_nc_oc=AdkZV6a0JELOhYJl1sBREyC-bOCPsBZjFjfhcKlk7CgG5t5YoMOVkEoLm7CqAjDhDZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftJaksFZWQVoVM1ISO-mFjG-Iusdlon5oftukOq5Dfd2Q&oe=699AF487"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8u-PZVcfHMQ7kNvwHKG7rj&_nc_oc=AdmQbxSXcYeOX3nv0gr881dBCStkCD1ZqV__oKUPRkIgS6ypkXHe4Hzsn4er2xhUq1U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHaYxcdNaR6TmSdG4OeZwwZHvv7yw_pAuP59Bvd7-_hg&oe=699AE71C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWFU5pwkEiQQ7kNvwFAAMMj&_nc_oc=Adn9X9SCucGxVAcKzt1qHb8hox_eMnxIHUnEhrzE3m3kNWXw0XZvoi9kk6EBc-wsxb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvzuN_g40Hpf0vx1mGNka9cJsXIXzE99UjtG3e5d-1c_Q&oe=699AEBD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2756292102028
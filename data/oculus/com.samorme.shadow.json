f&oh=00_Af8aMs_XfnSF1X-c80-eHNhUTTr5kvtzlCxZLwqlT4cAcQ&oe=6A3E91B6"}]}, "id": "541172737938506", "locale": "en_US", "screenshots": [{"file_name": "blades.png", "id": "722073919129374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_722073922462707_8792623854923895983_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8elMv9TSdBEQ7kNvwE1B8WD&_nc_oc=AdoDbTChBWSpq2T6whfDvh0FJ3vbGkEZ7MG3Sx0mVUl2RLsm6142W6BagzLEjWZsQVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8inQnmB-53P13mSzfK77m4p67dcDdr2pNuFlETHrOUZw&oe=6A3EA1FB"}, {"file_name": "hanging.png", "id": "1200948237451705", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_1200948240785038_8011447553024896647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKq026NAfakQ7kNvwFtytGD&_nc_oc=Adrcl3kW1cvZwfi5RkhIv_w5o1D8dJkp-9bk9NNKAju5Z_QmLsl-umhQLn_sYdCFnyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hwqnFCwxRSekx7TqMiPOSX-rLEp4RkGWW03TQobqIuw&oe=6A3E9F3B"}, {"file_name": "bow-and-arrow.png", "id": "540687551526051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031560_540687554859384_2223023307864762140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CyGDRFw5zwQ7kNvwGOXmfm&_nc_oc=Ado83yMEROPf4ArnxHCMDkjRyJ3VQZ0lqm46LbCh8bf5KAQ7lAqfVA1QiuQa47le5NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-efmEqxasQp8Refg_V1bbhUzG4wua6qaAj2SK0I0moDw&oe=6A3EA6C7"}, {"file_name": "zipline.png", "id": "1004630790075228", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036607_1004630796741894_4051486913823091613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDVqgV1Ja5QQ7kNvwEwY0yd&_nc_oc=AdpIGiDLYjT1I_hNKv6PGQr-SwOSClD8faHRnt-jQGdSpYXVfTFCe7Z-_j3BMfLmE7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kAcP9r_5dL-09nuXScPOmjEt28VwWWFKx1GvaMLLuSg&oe=6A3E995C"}, {"file_name": "village.png", "id": "233090625855580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974888_233090629188913_3030239811315842344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MUhyA6P1H0Q7kNvwG3fzB9&_nc_oc=AdqIEGNO4E5a7GQchEdfqjSqEzyOFBI0LNeA3xjzoiBWlbsu7BvY7OJiJO5EHqqj31I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B2S2toH_dERoe4jDihLnlGw5xTSLtXxJdW0hc6a_zRg&oe=6A3E9E10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Out of the Shadows", "keywords": [], "long_description": "Welcome potential assassins!\n\nArmed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb, evade your enemy, or kill at your own risk. Use a variety of weapons including daggers, axes, shields and hidden blades to stab, slash and trip up your enemies. Some weapons are provided, others you'll have to find, steal or kill for. Enemy awareness is heightened as the difficulty level rises! Hide the bodies.\n\n\n\nOut of the Shadows is a stealth based assassin game currently in early access. There are 3 unique maps with various difficulties, each one has it's own challenges and objectives. There are currently 2 modes: Objective (Complete objectives as quickly as possible) and Overkill (Kill everything as quickly as possible). Not a stealth fan? Run, jump & climb around the maps without any reaction from enemies in Sandbox mode!\n\nThis game is in Early Access, to get the latest updates on the development, and give your feedback for potential inclusion in the game - join our Discord.", "short_description": "You are an assassin. Armed with your weapons you must complete your objectives completely undetected in order to succeed. Sneak, climb and evade your enemy, or kill at your own risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheshadowsvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sam Orme", "support_website_url": null, "website_url": "https://outoftheshadowsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RAT
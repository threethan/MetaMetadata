171872248936529920_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOPcOE0PwtkQ7kNvwHJF1tO&_nc_oc=AdqJqMapfWG1GKOxQg78Hu_H4Ie2WSWldU-l3VQlrOerXzuCC-lubzSTLeUWlJ1JxS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5401lwS5RqTrTjQXjphru1l7D4JOepLYhT4jvBOfcz1g&oe=69FB4357"}, "display_name": "Spooky Roller", "keywords": ["roller", "coaster", "amusement", "park", "horror"], "long_description": "Spooky Roller offers you an immersive VR experience that you can hardly forget. Survive the ride over the haunted amusement park, occupied by monsters and ghosts. Experience the combination of fun and fear while escaping the demonic train. Keep calm and stay focused to avoid deadly traps or dodge saw and axes blades. Find out where this crazy journey will end.\n\nReady for a ride? Then hop on as the scariest ride over your nightmares world is about to begin!\n", "short_description": "Survive a travel over the haunted amusement park, occupied by monsters and ghosts! Experience the combination of fun and fear while escaping from the demonic train, avoiding deadly traps and doding saw and axes blades."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.fox3d.com/vr", "developer_terms_of_service_url": "http://www.fox3d.com/vr", "publisher_name": "Fox3D Entertainment", "support_website_url": null, "website_url": "http://www.fox3d.com/vr", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ROLLER_COASTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3175192229471856"}, "review_messages": []}]}
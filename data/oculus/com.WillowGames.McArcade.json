med variation where the goal is to get each ball as close to the center of the target as possible without hitting any of the previous balls.\n\nTry to climb the leaderboards or invite your friends to an arcade!", "short_description": "Three variations of skee-ball arcade fun! Now with multiplayer!"}]}, "developer_name": "Willow Games", "developer_privacy_policy_url": "https://willow-games-4ed5ed.webflow.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Willow Games", "support_website_url": null, "website_url": "https://willow-games-4ed5ed.webflow.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26149709064637440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393483_485488484220329_5428222866815995946_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVYBVKWbY1oQ7kNvwEvTj6P&_nc_oc=AdrCYLuHZtEtCeARs_6_Q2H6M5YJRYF9of7VuOQv7lwN9jdSE1e1fkxjupDe--_wj4Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36DD8RcjqhG9GepkDaBdbpyFdL_Sd9zxtkQr6bV8dISw&oe=69DCD924"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skeeball Challenge", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_to
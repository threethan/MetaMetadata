5326078_996986952740197703_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXcnuuZastwQ7kNvwGtWH0O&_nc_oc=AdqK3g9mkITMhAnEIQvEoVi6jlKu4b5zrbgmXrUqhWrY36BW-cfVM0yX96K5AS52e8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNa8TdgdB1EIe9aAI4Bv0knUpks1qIJTcIJeqxg-qnOg&oe=6B047C96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "528381742347613", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210390_528381745680946_2957953616666394106_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqYviHirkOEQ7kNvwH4bB7_&_nc_oc=Ado7E3EQOdsJ9Wuh2-bzOckyKf6MSQT5voFgD0nSmJA-MAiceyxc13sde1ECnkO2u2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJz6XDi6DYRA_EEHD2ZPLvB1JRJwNbB0JInHcDlrcXuA&oe=6B047984"}, "display_name": "Time Titans VR Demo", "keywords": [], "long_description": "Time Titans VR is a singleplayer action shooter that allows the user to manually slow down time to get an advantage in combat. Shoot, punch and slice through enemies while slowing down time to unleash mayhem or dodge counter attacks. \n\nSlow time at the push of a button while you move freely to wreak havoc on the opposition. \n\nGun down enemies during the slow motion bliss. \n\nBash your enemies to pieces with maces, battleaxes, sais, swords and an assortment of other melee weapons.\n\nTest your moral compass as you're put through simulated ethical dilemmas to see if you're worthy of joining \"The Corporation\" to work as a mercenary. Your decisions will impact the story and determine if  you get the job after the grueling interview process. \n\nAre you the right fit for the job? Find out. \n", "short_description": "Time Titans VR is a Singleplayer action shooter that allows the user to manually slow down time to get an advantage in combat. Shoot, punch and slice through enemies while slowing down time to unleash mayhem or dodge counter attacks. "}]}, "developer_name": "Phocore Inc.", "developer_privacy_policy_url": "https://www.phocoregames.com/privacy-policy", "developer_terms_of_service_url": "https://www.phocoregames.com/privacy-policy", "publisher_name": "Phocore Inc.", "support_website_url": null, "website_url": "https://www.phocoregames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "527084549448629"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568726_577559877709797_2217561324757783160_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlE5NTJ--scQ7kNvwF5gv5Q&_nc_oc=AdpaO8XCabKb92RGUVyJ03m5fuKFpMR5u7cdTrbJDPufFYGgmHg_E07fLvwi5yg_s_k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ852HGvLsxPlA8kK_4M-BTh4TMqTP0c3vgMLt_VUIN8Q&oe=6B047A78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Time Titans VR Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1671732041, "lastRevision": {"nodes": [{"id": "5792121117474255", "release_type": "SCHEDULED", "administration_status": "APPROVED", "
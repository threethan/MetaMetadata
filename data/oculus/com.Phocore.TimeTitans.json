5326078_996986952740197703_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WG5BAOtqDpcQ7kNvwHvnZq1&_nc_oc=AdpdoxzYWYKz4tyt7DugW_s4NvPoZ-owbIZ1Uj2G-dAHe5oEqGquKzyTsPpse-0mnSI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxJSA9nINxNle2EPi00RFLOEIwkRreXhpA0CFqLBUYrA&oe=6B0B1416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "528381742347613", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210390_528381745680946_2957953616666394106_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyVjE2-arCUQ7kNvwGWg9cj&_nc_oc=AdriGbpL9QreWL00RPRhSHAKhoQPclymheG-0L98jwxq4HHxsyvFbnsEGuUvUuGV6-w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3jQS_kZ_Pj-4mdRc-eS2klVSe4eipRu2P29uFnnCvKQ&oe=6B0B1104"}, "display_name": "Time Titans VR Demo", "keywords": [], "long_description": "Time Titans VR is a singleplayer action shooter that allows the user to manually slow down time to get an advantage in combat. Shoot, punch and slice through enemies while slowing down time to unleash mayhem or dodge counter attacks. \n\nSlow time at the push of a button while you move freely to wreak havoc on the opposition. \n\nGun down enemies during the slow motion bliss. \n\nBash your enemies to pieces with maces, battleaxes, sais, swords and an assortment of other melee weapons.\n\nTest your moral compass as you're put through simulated ethical dilemmas to see if you're worthy of joining \"The Corporation\" to work as a mercenary. Your decisions will impact the story and determine if  you get the job after the grueling interview process. \n\nAre you the right fit for the job? Find out. \n", "short_description": "Time Titans VR is a Singleplayer action shooter that allows the user to manually slow down time to get an advantage in combat. Shoot, punch and slice through enemies while slowing down time to unleash mayhem or dodge counter attacks. "}]}, "developer_name": "Phocore Inc.", "developer_privacy_policy_url": "https://www.phocoregames.com/privacy-policy", "developer_terms_of_service_url": "https://www.phocoregames.com/privacy-policy", "publisher_name": "Phocore Inc.", "support_website_url": null, "website_url": "https://www.phocoregames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "527084549448629"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75568726_577559877709797_2217561324757783160_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pV7BXoc7v-4Q7kNvwG5XbHC&_nc_oc=Adq6yQ2-z0RBLJzk3Cd-sIeS-2FNoViNcS_kdOWqUwj7F8ZcV7e-wqCi6X3oxPK9imk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQL5n7oYBz0i34DqF32Ax3zT_hkOeXcuAOm_22ovmHyOg&oe=6B0B11F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Time Titans VR Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1671732041, "lastRevision": {"nodes": [{"id": "5792121117474255", "release_type": "SCHEDULED", "administration_status": "APPROVED", "
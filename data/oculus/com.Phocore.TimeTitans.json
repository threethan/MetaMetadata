lateLandscape.png", "id": "528381742347613", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210390_528381745680946_2957953616666394106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZK1rDEx4rREQ7kNvwGmy6No&_nc_oc=AdqJSUsYU2BcemP5qBYln9x2pL1Jkq-tNMoUyPBkymgdSKL21zGHQ3nbOSuCs4xjoq4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2rucIDEYFTHrc8dT_0Q9siFivlePMVmTaCS08gpbq4Kw&oe=69F20944"}, "display_name": "Time Titans VR Demo", "keywords": [], "long_description": "Time Titans VR is a singleplayer action shooter that allows the user to manually slow down time to get an advantage in combat. Shoot, punch and slice through enemies while slowing down time to unleash mayhem or dodge counter attacks. \n\nSlow time at the push of a button while you move freely to wreak havoc on the opposition. \n\nGun down enemies during the slow motion bliss. \n\nBash your enemies to pieces with maces, battleaxes, sais, swords and an assortment of other melee weapons.\n\nTest your moral compass as you're put through simulated ethical dilemmas to see if you're worthy of joining \"The Corporation\" to work as a mercenary. Your decisions will impact the story and determine if  you get the job after the grueling interview process. \n\nAre you the right fit for the job? Find out. \n", "short_description": "Time Titans VR is a Singleplayer action shooter that allows the user to manually slow down time to get an advantage in combat. Shoot, punch and slice through enemies while slowing down time to unleash mayhem or dodge counter attacks. "}]}, "developer_name": "Phocore Inc.", "developer_privacy_policy_url": "https://www.phocoregames.com/privacy-policy", "developer_terms_of_service_url": "https://www.phocoregames.com/privacy-policy", "publisher_name": "Phocore Inc.", "support_website_url": null, "website_url": "https://www.phocoregames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
MoQ7kNvwGF2z1W&_nc_oc=AdpSv5AlyPJxLrVuirnCKA14Nn3E7Nfunn4V9Ke9BNXy-m1bjupHvQjVB0paQZR6LKg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqtx1CnYPWIs-jzS0V0vhmHeFI2XGCpASwTepLQLQWmQ&oe=6AE35AEF"}, {"file_name": "ScreenShot5.png", "id": "354981366702507", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974892_354981370035840_4876678944108635233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReTUEd2XJUsQ7kNvwHIrYyT&_nc_oc=AdoykjZgznnoSaeMh2QG3COUR474H6ekCQiDvXrz5jsamJzTq8r0b5WKLbzgngKppV4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBSWwexiH_awaMfa9SorNtCN6gDuMArmBJZzYUcYwsxQ&oe=6AE36BE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUOfMqINnxMQ7kNvwHNWbnI&_nc_oc=AdqGTTLsazNt9IRZedluqQaF9k8M9EMiEvXrdtHcdiSWjyJoPnhiDOQmW71zRp4G_Fo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbKJpMMou6u5NBlDn4GcmA3UI1uEbHv9b0SHDGpBPZyw&oe=6AE36438"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles and foam connon.\n-Polish faded car surfaces\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fragilent.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fragilent Interactive", "support_website_url": null, "website_url": "https://fragilent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26360648236919573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566679_2544584275677447_4268185081810741909_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMmozKyPVSoQ7kNvwEyJf6G&_nc_oc=Ado7GAy8z4XgwEr-I8juTU5yaNxvL3fGbLV2U_8KXAw8btxudTi9vtPaU8XcyJsUp1Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3INcKrqejV9vmi0OwNvmU7eegXnFX2ARrigfY3ZDWSw&
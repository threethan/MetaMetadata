086710457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2akx6etT3HsQ7kNvwHS2sj7&_nc_oc=AdnLCsnckowm7UehoXUd6VtAVWbB4SJRvYnl3iTjgcWVL9xRJuMCvefT6VYxeqZs9bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0r3qST6kVjgSEmhKM6W7poL5_9gtGd1H6m4E7ilkM5A&oe=69B3F3DB"}, {"file_name": "ScreenShot3.png", "id": "1103455960295054", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_g_Ro47iegcQ7kNvwFNTst0&_nc_oc=AdmQtBpRs3wLtn2ng5Cb_l6YRv3W6TBnAZRnheFQbIJcCBkjB_vOatg3JVm8d5LgHKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzH4Bfo1RGe6R7VGxeo82cGaA1cUjd_DWXQfkp8EWMDIQ&oe=69B4115F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAIH1x5n5aEQ7kNvwEgr9rI&_nc_oc=AdnSM8G5w-0Ns9Kvg7KkMdzBREikX_DtX-P-s-7P8PYTeAYkON59oe-HqB8aDKY-mSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzwI5ucc2l-5-dwZFIwyu2q7n8Rh52NVjzqgxp-AH1iHw&oe=69B3F2F8"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://fragilent.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fragilent Interactive", "support_website_url": null, "website_url": "http://fragilent.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "782777289543267"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "905103108816191"}, {"status": "PUBLISHED", "id": "1435684137914355"}, {"status": "PUBLISHED", "id": "1699915968080036"}, {"status": "PUBLISHED", "id": "25182202881452028"}, {"status": "PUBLISHED", "id": "478691288234991"}, {"status": "PUBLISHED", "id": "1362160348345661"}, {"status": "PUBLISHED", "id": "10169595537244
scdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8C68FYvEAMQ7kNvwF3lSZA&_nc_oc=AdrC7fb2WUi1S-8fh-F8kbJ9BL-lluG7KBFuJeDPRKxviOYFCdUfocwlxKYagqnFw7o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pcZetXwYJ46CFCw6uX9ROJAp6Hou3lkz1jfNEJtA_JQ&oe=6A217DDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKtW5C6kSJoQ7kNvwF8v7di&_nc_oc=Adogmi2A85wB1f80dC2JnGSiGwG333_xCq92Eyjt7-vRPTI27TFxOrxADStHMxPX6hk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TFdl7s-BVrdg0uveakVwS5HAHB_aH1_uyl0T9v5L-Yg&oe=6A2197B8"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash si
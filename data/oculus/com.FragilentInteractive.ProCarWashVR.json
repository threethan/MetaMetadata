8-CFBf4hUDiYcbXdiqjLLN6ZHtlCCHQ1EEIL7N6w&oe=69A02D5B"}, {"file_name": "ScreenShot3.png", "id": "1103455960295054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HO8Y6O4m6cwQ7kNvwGVAVKN&_nc_oc=Admdn1byon4RPPY9qEHF8ey5XBr1KZWQUi1Y_hNwnJgXOliHknIW8w5vfNAwGeuAUNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxCAvnhp3BoVBBqrNAjVGocLlXrA8Pak4notDX0jw5LA&oe=69A04ADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3pm1FEFxOwQ7kNvwHbkzsL&_nc_oc=AdkyxjCabRthJZYtu1d3X6CVbC_55kFbLL6dN14wrTplQ-NgnPPzZkX-EDKUyUybF7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsfJlLc9l8llzSWA0WdRCXgiUuonpfO-8e0AkJ1jCg-pw&oe=69A02C78"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Ti
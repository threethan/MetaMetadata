k8bNw1p4Aw8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs0kBChMd1rQvpiFejM9Wn5SlZzepDKd6d71gUkC3cgrg&oe=69A43FE4"}, {"file_name": "ScreenShot4.png", "id": "1108517163420661", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003244_1108517166753994_2176767427399051795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2pYq5_8eAMQ7kNvwFhbMfJ&_nc_oc=Adl6eh5-YPM9niqPSbQ8gNHOvWlv3mNmxQtRZzQZ3c7cXh4XbQjdWvsrapaen5eCOMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftXRMeey4-4W1bu2a5Gnd4IHfQXb5KkmyF3raT8uQAXJQ&oe=69A44FEF"}, {"file_name": "ScreenShot5.png", "id": "354981366702507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_354981370035840_4876678944108635233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UvAiWVc4R0Q7kNvwFu-M2J&_nc_oc=Adl08WaSwXN6C1Rox-MfijJiM-FMUNHbVBCHgbc13azWaRTOrHFkSESffQcI_qUFakM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuz_VARV6wJZJMO9G2H3ZyeqjA_yfEI4dRygMqPFGuH4w&oe=69A428A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB4K2Jj7_UMQ7kNvwGNhXg6&_nc_oc=AdkMP1CLh4vutdl8rqYFJVttgoR4cKCE74ASYKeJWIHc7jkOfV56wsXJa7aSLA-0Nyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftIT-Wl9henjkGLdI20ItfVPJsPh7hz8A-7CpKxRCphAQ&oe=69A420F8"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles and foam connon.\n-Polish faded car surfaces\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://fragilent.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fragilent Interactive", "support_website_url": null, "website_url": "http://fragilent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9777394845671507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_2544584275
scdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBrLxb0qAl4Q7kNvwFN_tgC&_nc_oc=AdrMOoGictCYo4mwmOXjXz3PvbEFc_zbeH2HIc0H4TSGWKnrvm_3d1EQqb_TUYb2_5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-oqpTkFoNhcBk3SD3Fo-XsN65AT5825WCsgiN_Ewe-A&oe=6A032B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1ehToM31wMQ7kNvwGk1Bo6&_nc_oc=AdomTw3OAa8ebgMJgyFhllrGuWq9_OeCYYlyMdmMJlKSVYp5aTIv29eJ1jq7qfyCXsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U7IBQpbBJgOvYeUpyGQCo7ODKcusjUCsebOVzS1JqbA&oe=6A034538"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash si
scdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRTJ2mDU6VAQ7kNvwEi_LPs&_nc_oc=AdpbRJeEdpJkuD2Usn2OuIft705Is9k6LAUYYMmmPc8EYECxfRyTSX7WVH1F9JFieWg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu2aDqnepi_DROZl0MvMk9lPkIZdgOa3etEfpT44sk5g&oe=6AD3B09F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgnv4XfdsRIQ7kNvwFIn3z4&_nc_oc=AdpBqxjFXSXNXG_3335o_uuqSftoUxwruCeDA_xwxbhhtab9MDOYEDkVdzxOlPc5EgI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOES3-ro6OIp_GaeBJL_T_snLFq_nk-t0xmcIgdf-jXUg&oe=6AD39238"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash si
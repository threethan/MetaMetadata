9sQ7kNvwHLDBGo&_nc_oc=AdrD1FEXzaHylgxpn5YJ7q5rJoYV5_CtviZVZlIdsWAW6rdvFtIZYNzA5w7YXpqWwL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmtY58hENVePYQu4PQkfgLlQiRPCA0laiN_TtUals-rg&oe=6A64CAEF"}, {"file_name": "ScreenShot5.png", "id": "354981366702507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_354981370035840_4876678944108635233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvWpMpvlp_8Q7kNvwEh5sYK&_nc_oc=AdoEBF34l7j7tOfJdn-k3sB6OKhTQ3s0bUHhnoGPthBSp3Kw8zrGlWPwmNXRxEVst9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2oQXqcgp3zoaqvGkqR-NP5No2SaWwKBUj6xJZ8LfwKQ&oe=6A64A3A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG7OcT3-X50Q7kNvwFar7LJ&_nc_oc=Adp39YJAhkKzqX8v0wxfn4T2Wy9vaLDkEd7s9GLKwqSA9Pf-ZDctXwTv22G0o23eHis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeWNTMUQpd5EaP9nKg85vO3BDeu3EYAItIrnJ7gJkEVQ&oe=6A649BF8"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles and foam connon.\n-Polish faded car surfaces\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fragilent.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fragilent Interactive", "support_website_url": null, "website_url": "https://fragilent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26360648236919573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566679_2544584275677447_4268185081810741909_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgb8Zi8BCiEQ7kNvwF0DbRe&_nc_oc=Adq2vOwRbJq0BgDH_Dwhv5UO9N4sBw88XeQomQh5rfkAH6tieqlDsujkEt7nhjkz4HQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqpKhXepJCu2-tKlcJy_iP8B16vEzH8oY9AzXLFpeWaQ&
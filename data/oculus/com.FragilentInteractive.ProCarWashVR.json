5MBwVceoXcJen0pmVt40SI-1y0ru5DH8RdtqcLdw&oe=699AE75B"}, {"file_name": "ScreenShot3.png", "id": "1103455960295054", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZoqW2JJCsQQ7kNvwE-zU93&_nc_oc=AdkUlP-f7nuHrYbW7wjIRXWY1b7z9VIAtSN-y0sW12--ccclQeDccn9E6Fjou7KiAcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBWL4wd-D9i3S9uW4NGXTTTI619sadpRn_OQ8UFYMXxw&oe=699B04DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgkN2ye4lxwQ7kNvwH1e03H&_nc_oc=AdkbMf7dfEgrANQico4gMly7mGmae60DlKjiNMUQdG-1ALuoaPa5rUSKCOTriKAk2P4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsZhnrdWF8kRbsNHoISLw2T1cYvftn4Fw0z9X9gSAI_PQ&oe=699AE678"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Ti
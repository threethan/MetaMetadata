IjZkpYF_GuIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsREwp8gzv09wwMiOhEs7hktbXgdzfNi2AvbgHMFV-GGg&oe=69A04B64"}, {"file_name": "ScreenShot4.png", "id": "1108517163420661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_1108517166753994_2176767427399051795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoOTozskVPEQ7kNvwEGfQl-&_nc_oc=AdkFg4UklLJpcF4Ae4KaZECQtFfh7AYdgSnKoZffjm4Rkl8HyKHKWYdLyzJsbnSEHzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaH80asEiP3Sff-LS2tb01ocbeiqPb-OU5wh6Me5CFkw&oe=69A05B6F"}, {"file_name": "ScreenShot5.png", "id": "354981366702507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_354981370035840_4876678944108635233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iLJ-X4WExgQ7kNvwG9HNiu&_nc_oc=AdnX41r7TqIZqzEcwctnClhbY5b51pd3UIOpXOXO-oAvGV33gFSgoqZNo3Kiv70n00A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuK1h8J_rXYKePZut8TCljmAf7gJE6yKIJcJ1mjUiaNuw&oe=69A03425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3pm1FEFxOwQ7kNvwHbkzsL&_nc_oc=AdkyxjCabRthJZYtu1d3X6CVbC_55kFbLL6dN14wrTplQ-NgnPPzZkX-EDKUyUybF7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsfJlLc9l8llzSWA0WdRCXgiUuonpfO-8e0AkJ1jCg-pw&oe=69A02C78"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles and foam connon.\n-Polish faded car surfaces\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://fragilent.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fragilent Interactive", "support_website_url": null, "website_url": "http://fragilent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9777394845671507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566679_2544584275
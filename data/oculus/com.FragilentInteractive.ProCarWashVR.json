d3-1.oculuscdn.com&oh=00_Af0ClGZyykO4vwAoCKSyglcZ-7WV9Zg-0PwD8BwhTkhOZg&oe=69F0C6EF"}, {"file_name": "ScreenShot5.png", "id": "354981366702507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_354981370035840_4876678944108635233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-g0xJyuigwQ7kNvwF9i9H9&_nc_oc=AdoQnfMSCO8vqZ8wpWPX8K1zujn9eLACYr65sXK2TCAbiFPDluAX9ahxxROG9zUjtXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1jnW6ZQrrMavKyRFnRHl5L5dyAeXMMASeWk39uEytNVw&oe=69F09FA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q77-i0MQ1gQ7kNvwH_SY01&_nc_oc=Adp9ax28eghLIlzfV6JoDImRjlZIeKyr_ldciq_MMJ5H8jYJb_-F5E2Yys_9o2BjkQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3yEIPpb1s2XmjXqfWuLER6Jjy3pcCrklQqJ1jXxgUjnQ&oe=69F0D038"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles and foam connon.\n-Polish faded car surfaces\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fragilent.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fragilent Interactive", "support_website_url": null, "website_url": "https://fragilent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26360648236919573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566679_2544584275677447_4268185081810741909_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PAaMlcGqNMQ7kNvwGgcldb&_nc_oc=Ado4KNaGqlklyO2qew8x2QvqHOcGZXXHyov1KP9eftVG39O5Yiu3vpEyxY1ynU_JVCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1InhyI6D2CetBTYz7zTNX5SDHffxGUCfASPlMR1D3Fjw&oe=69F0C026"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PRO Car Wash", "platform": "ANDROID_6DOF", "context_category": {"co
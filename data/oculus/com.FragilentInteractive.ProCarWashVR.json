iffAN6gQGAus&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftL8yhnIb-H9a93Z_C0sFNUSenMb0Ao-jZztV1a9ZJATw&oe=69A59164"}, {"file_name": "ScreenShot4.png", "id": "1108517163420661", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003244_1108517166753994_2176767427399051795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVIVYs7QFg4Q7kNvwFhanIN&_nc_oc=AdnrNzeImOC258YbtPJDwGQ3qEh1kq82OugtCTtUQHB1CSDBLV7QfyjFLnTYVD7T92A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft5YzQWEbwT95BbpNsIcuMbvOYOl0h4Lm3kUYu6gP2iOA&oe=69A5692F"}, {"file_name": "ScreenShot5.png", "id": "354981366702507", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974892_354981370035840_4876678944108635233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UvAiWVc4R0Q7kNvwEQW5fR&_nc_oc=AdnCqSh08nXhellQXfhYSvaPjWaoE-MKlX0YTz1_GWBVcweiaTOyFGzzhpf6LGqgC1w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvr-WtNwlzG8qCCidPogqKj21lurIRqsBJO-UzX1o0GBg&oe=69A57A25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G8kHV-vnKAQ7kNvwFlNUSI&_nc_oc=AdnyqGm73Sg0BAyw5nQNdR2Vw33fhuzfBd8zk-YIEo1SpNVpV7RfkvNPgEyymsXV5pg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsXASBIxLAOYGIa9DPvK4zehLPGyUeCsc0wNTmrDUy1mQ&oe=69A57278"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles and foam connon.\n-Polish faded car surfaces\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://fragilent.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fragilent Interactive", "support_website_url": null, "website_url": "http://fragilent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9777394845671507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566679_2544584275
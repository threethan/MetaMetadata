scdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DACLiDC9koQ7kNvwF3W7JI&_nc_oc=AdpOWzqK4yCQG2iINpB5HVx1vjq6oeXt2xli30ATiqJI2PblZTl94pmypMi5Wwg8s_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KlTEdsTTbwpyvmWNfwnm2qGF0H-Aq50FOr_S_NtioQQ&oe=6A3A8A5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMEiY41yZ5QQ7kNvwEE7uqB&_nc_oc=Adq5ShftTO09ReA7d1CDQRyJ8Tg44aRbULAhsuqyulSg3WEyg3i4Ydg3sYqAvBqxvNc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-SOi0grR8x6cIX4CNCZSDjIwqtXn6I6-SXqNb0BwKeQ&oe=6A3AA438"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash si
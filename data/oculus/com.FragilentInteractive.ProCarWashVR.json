iSFdMiTq7zu_uySjWtSP3q_ES1Ia9BOvmBi18UoQ&oe=699995DB"}, {"file_name": "ScreenShot3.png", "id": "1103455960295054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgPhzcO6B54Q7kNvwFEzHo7&_nc_oc=Adk2dJHYxxAuGGOrGmtZE0VK-l9QAol00_wN6UgU6y6B8IsbxLDras3RQ74jkdq1pO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiJyyjmeU9tAYMfPfQZoxclwxCK5cdpCaQE_ZndhynJw&oe=6999B35F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgkN2ye4lxwQ7kNvwFmzcvo&_nc_oc=Adm2r0_ZR0JrToq-1VxwSCU0xwX2DC3VYmx-zCqxNuGF1jDpYZXPPmM7ASlvOwYcndg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvwfVXHgDaSyZNz1Ny_F8Ndc-Wy66WS8PsYkAOpPP5Zjg&oe=699994F8"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Ti
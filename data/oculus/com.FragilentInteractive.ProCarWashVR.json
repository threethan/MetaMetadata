4CIq28Q7kNvwF5XnqK&_nc_oc=Adm2y2VOM1nQGctbks00xo_pO_PnhUQe-2Cyru5rlUmxBK8B7uZ2QnvULZ2ultjdPkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZliOukbhYrHHaOaMikcWvatLEOOnTYM7S8OkpprIKzQ&oe=69B80664"}, {"file_name": "ScreenShot4.png", "id": "1108517163420661", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_1108517166753994_2176767427399051795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4qi7EySEU4Q7kNvwEehiS_&_nc_oc=Adkbuihv5vckbiYAJRe7woKurqM0R0JX33XQ4o3gdCsSnVyIo6-T9y-8h9Eqf7H4toY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytYIFJvA87SLecKsfbGM1ncisgQDJ0UBiFPQG5gFX5mQ&oe=69B8166F"}, {"file_name": "ScreenShot5.png", "id": "354981366702507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_354981370035840_4876678944108635233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpgN14b7zA4Q7kNvwF1iTV6&_nc_oc=Adlw8JJrUSf5H4pBbNafWsXlK4sq0YBthOMm4sjFjLoyE6dMZs3xtv5m2wYGJnin1s8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi4Jt9AAwrVhOdHx8a6NzSlhE0mIrvsgjmPM7h6t-JxA&oe=69B7EF25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK6BTJdTM8IQ7kNvwEkiIhW&_nc_oc=AdnmyeT5gHWiZgagCUHsUxz_43amiHNkMvNCxWgtIoyk-kVf-0XX_o1pIFMcMiKuroc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afznfr9K-Nss6PueKqd1FcV1hJYO6J8Fws3s78Gle-TXMg&oe=69B7E778"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles and foam connon.\n-Polish faded car surfaces\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://fragilent.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fragilent Interactive", "support_website_url": null, "website_url": "http://fragilent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9777394845671507"}, "review_mes
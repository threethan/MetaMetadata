scdn.com/v/t64.5771-25/39035326_1103455966961720_7616357045042388556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuwvQlAZ5iYQ7kNvwHi1vGX&_nc_oc=AdojwTGp6hPSjmNHqeYLyYFsj04IzSUte7V18apHiMLXIBTABSym_-OKqNC2WGxi3o8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImnHT3_qYjRip4HN2LlsmUy_hNse1V5WV4UriogGgJjA&oe=6ABD0EDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "838765437087449", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974526_838765440420782_7534785496759123227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FbBeu4HpUwQ7kNvwFd1UVj&_nc_oc=AdpAVK_dRTS2ZZH0_zGDc_jKIlccH1tmMII6FuQGhAYdN8nJQU4nb8UhcDw8KJsuF6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIckmR-RjIcnziZVilM4FDYVitwhivWMKW8DoLqMhwKgw&oe=6ABD28B8"}, "display_name": "PRO Car Wash", "keywords": [], "long_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash simulation game for virtual reality. Build your own car wash business. All cars will have its own unique challanges . Remove hard dirts, refill oil, and change battery. Earn Wash Coin and unlock new upgrades for your workshop. Complete satisfying challenges. \nJoin a relaxing adventure, cleaning will make you feel great for sure.\nKey Features! \n-Wash the cars with different challenges \n-Remove hard muds and dirts with different pressure washer nozzles.\n-Get your hand dirty! Remove garbage from cars. \n-Refill oil and change batteries. \n-Sell car scents or oil to your customers for more Wash Coin!\n-Upgrade your business with a better workshop. \nWhat is in the next update?\n-Military Car Pack \n-New Pressure Washers \n-Soap cleaner \n-Vacuum Cleaner for the inside of the cars \nand much more! \n", "short_description": "Time to chill with PRO CAR WASH! \nClean the cars with a pressure wash, complete tasks and relax.\nPro Car Wash is a car wash si
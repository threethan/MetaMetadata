006096378947285_9188508681872039936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km5sO2_2e2AQ7kNvwF_4unM&_nc_oc=AdrWOPlwc1HkHG29VFV6fbuMnuedrpiCGSb5UBKL3diRk5HwHkxME-bBbE66XuaSEBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8d9_MmS1lk_FOXwLDqE70VwhoVqtJBRD3Len2wZRrPA&oe=6A71EF46"}, {"file_name": "new screemsjpot.png", "id": "1659425652018086", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619680_1659425655351419_7367450683252569771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTCZB3-OFjYQ7kNvwGasZrf&_nc_oc=AdrlOatF8mRxRlanGvJOEqjkNthWN83EdnBTL8ryS2OqxE9emeONK93gl7oDRtv9WOo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6gXhMemYvA40Oqzetr2jd-2KBq0vmsmyvXY0clpPC9w&oe=6A71EE0F"}, {"file_name": "Gorilla Locomotion_Custom..._20.02.2026_19-37-26.png", "id": "1849062019079326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618264_1849062022412659_7255944440325575889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iHhG9O_9BAQ7kNvwGjjlsp&_nc_oc=Adq9Zl7ckaOdD0eu8-rpVBsB38hi1E8ncfsFlkNSHF5bPtYOuxK2PXbZb1LVBUR_z8w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLgV4iHdsrveuJ_qumOOkxsDNNKeq1pkuy6EA8_ML6yA&oe=6A71DC45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Endless Reality", "keywords": ["horror", "vr", "fun", "funny", "animal"], "long_description": "Endless Reality, a VR multiplayer horror game built from the ground up for virtual reality.\n\nYou and up to 10 friends are thrown into a massive, ever-changing world where the layout never stays the same. Rooms shift. Paths disappear. Safe spaces don\u2019t stay safe for long. Every run feels different, and you never really know what\u2019s waiting around the next corner.\n\nMovement is fully physical. You swing your arms to run, push yourself forward, and physically dodge danger. It\u2019s intense, a little exhausting, and way more immersive than just pressing a joystick. When something starts chasing you, you actually feel the panic.\n\nWork together to survive, search for tools, solve puzzles under pressure, and figure out how to escape. Or don\u2019t. You can stick with your team\u2026 or turn on them when things get desperate.\n\nThe world of Endless Reality keeps evolving, adapting, and getting worse the longer you survive. No two sessions play out the same.\n\nThe only question is: can you trust your friends long enough to make it out?", "short_description": "Endless Reality Is a game where you can explore the map, get guns, have fun, mine ores for profit, and kill your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ervr.carrd.co/", "developer_terms_of_service_url": "https://ervr.carrd.co/", "publisher_name": "RandomStick", "support_website_url": null, "website_url": "https://ervr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26717974124542990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619159_1406695097369499_3495622177559475719_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDukamsQeTcQ7kNvwH_FysQ&_nc_oc=AdpuwYpMzpJLcGnn16N1UfUfpT4xsV5zxtaqmk3GKiXSBJ4HcJEUkIGUnMhQi3AaVhQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
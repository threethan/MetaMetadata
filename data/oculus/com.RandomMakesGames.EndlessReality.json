"https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_889104087151460_8768546351189864430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0etxaj65m54Q7kNvwHtpp_C&_nc_oc=AdoX924CC6tSBUDoA1gFHIzHgH9PrvhPDK2dwfYP74seCoLO0yadWZkipBTFE7coSvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fibesK189C_T4mX3wpmD2vlUOVejlGxwMv6Y4fzIt4A&oe=6A05DBC9"}, {"file_name": "Gorilla Locomotion_Custom..._19.01.2026_20-46-07.png", "id": "2020464105479215", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618102_2020464108812548_7878699227809387973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1QcTRMUVdMQ7kNvwHPBRw-&_nc_oc=AdrWq2S5G5QKzJPM1taCKKyCXjrpuQ10h8kEF_3Xe76juL0dcneLBRlXaa-cANjBFf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cdB2M-51S8BYpDn7_PZzNqFN1EloOGBAwc46C_EdKCA&oe=6A05B937"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Endless Reality", "keywords": ["horror", "vr", "fun", "funny", "animal"], "long_description": "Dive into Endless Reality, a heart-pounding VR multiplayer horror experience designed exclusively for virtual reality. Immerse yourself and up to 10 friends in an infinite, procedurally generated realm of unrelenting dread, where environments shift dynamically to amplify terror.\nCrafted from the ground up for VR, the game employs revolutionary arm-swinging locomotion\u2014propel through haunted corridors and forsaken landscapes using intuitive, full-body gestures. Every swing, dodge, and desperate sprint feels viscerally authentic, heightening the adrenaline of frantic escapes from nightmarish entities.\nTeam up or betray in cooperative survival: scavenge for tools, solve environmental puzzles under pressure, and outmaneuver adaptive horrors that learn from your actions. \"Endless Reality\"\u2014the core horror dimension\u2014evolves endlessly, ensuring no two sessions are alike. Will you conquer the abyss together, or succumb to paranoia?", "short_description": "Endless Reality: A terrifying VR multiplayer horror experience where you and your friends navigate endless, shifting nightmares. Swing through the darkness with intuitive arm-based locomotion, evade monstrous entities, survive brutal jump scares, and outlast the unrelenting terror together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ervr.carrd.co/", "developer_terms_of_service_url": "https://ervr.carrd.co/", "publisher_name": "RandomStick", "support_website_url": null, "website_url": "https://ervr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24874843138856107"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25539547065719041", "version": "60.1.93"}, "id": "1321941499696833", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24874843102189444", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25539547065719041"}, "release_status": "RELEASED"}, "binary_r
uluscdn.com/v/t64.5771-25/38982609_637648641797078_1096763185904985223_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gge7xMZ30AQ7kNvwHu7aYe&_nc_oc=Adqz1ENxmfmJ_KVH5AWZDAwd_uLn_PR-cwHGfdzd3xpLtGxP84IKx3GdAZTXF4WJ0Gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2zNh5O_tnHy3Jl_UDmWlT9i--FV9zUnQnTlvVx8qqRw&oe=6B0DA9A1"}, {"file_name": "screen4.png", "id": "1334487554156930", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031595_1334487557490263_1375598664409495046_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaLCT7cNKuQQ7kNvwHkbRU9&_nc_oc=Adq0jTHRwqtA-5dOFNv4PDucYNgbwEwymNzRfYl_E4EOO3n_gPNvn5-_GtYzsf_dZbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjxf5XfMtYBsRLcKmuV-K-3mHI9L_x87cAJ-rziPa77g&oe=6B0DC05B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Canyon Jukers", "keywords": [], "long_description": "Embark on a thrilling adventure with \"Canyon Jukers,\" an Action game that unfolds in a captivating canyon environment. Monkeys, known for their unique hand-based movement, are pursued by infected lava monkeys aiming to tag and eliminate them. As the chase intensifies, the game offers diverse settings like a Jungle-like Forest, a City with quirky hats, and a spooky Cave with lurking ghosts. Each environment presents unique challenges and experiences, enhancing the excitement and strategy of the game. \"Canyon Jukers\" isn't just a game; it's an immersive journey into a world of action and suspense, where players must outwit their foes to emerge victorious.", "short_description": "Canyon Jukers is a fun Action game set in a Canyon environment where monkeys who move with their hands are chased by infected lava monkeys which try to tag the normal monkeys until there is none left. There is alternative environments like a Jungle-like Forest, a City map with hats and a Cave with a scary mine where ghosts lurk."}]}, "developer_na
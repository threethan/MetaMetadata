8ZfeR66rgiPOW-sDWmwXTjShvLZ2pFIQAN5_jQ6wNliQ&oe=6A33E9E1"}, {"file_name": "screen4.png", "id": "1334487554156930", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031595_1334487557490263_1375598664409495046_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6RtEL2cCqQQ7kNvwGdYmD0&_nc_oc=AdokbG8bq25DW5VBvphRvaq0EC35CmKtePR1mHPkD_4l3xAPi6n3G58TstRzwbuS_NE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__IP6_i6ase0HnQKSrZY6KSfl7CK4jTlfzMJ3erEmtZw&oe=6A34009B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Canyon Jukers", "keywords": [], "long_description": "Embark on a thrilling adventure with \"Canyon Jukers,\" an Action game that unfolds in a captivating canyon environment. Monkeys, known for their unique hand-based movement, are pursued by infected lava monkeys aiming to tag and eliminate them. As the chase intensifies, the game offers diverse settings like a Jungle-like Forest, a City with quirky hats, and a spooky Cave with lurking ghosts. Each environment presents unique challenges and experiences, enhancing the excitement and strategy of the game. \"Canyon Jukers\" isn't just a game; it's an immersive journey into a world of action and suspense, where players must outwit their foes to emerge victorious.", "short_description": "Canyon Jukers is a fun Action game set in a Canyon environment where monkeys who move with their hands are chased by infected lava monkeys which try to tag the normal monkeys until there is none left. There is alternative environments like a Jungle-like Forest, a City map with hats and a Cave with a scary mine where ghosts lurk."}]}, "developer_name": "Canyon Organization", "developer_privacy_policy_url": "https://sites.google.com/view/canyonjukers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mitrix Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/canyonjukers/home", "category": null, "comfort_rating": "NOT_RATED
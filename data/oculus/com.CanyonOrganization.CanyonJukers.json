uluscdn.com/v/t64.5771-25/38982609_637648641797078_1096763185904985223_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq3DYQAfOsEQ7kNvwHAj5uU&_nc_oc=AdrhdGnF0UUE6Pv79ivo68kxALy9FbreGeaXHhbFmhu2pfJ6YnLf6t3wUs8Vs1_KCT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi0c6mS-cpJiyUpb6WZtUDDTy13dhIUxjqEo4QjiuFXg&oe=6B05C0A1"}, {"file_name": "screen4.png", "id": "1334487554156930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031595_1334487557490263_1375598664409495046_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtLzAaT5hNsQ7kNvwEdRyM0&_nc_oc=AdpbzaN7bXoAwWPdoN8GIOhx7frzDLNcARmq5719zGmCpVWnxEXn9ZLs7Lt8vCxR_ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiJ6wd5_50MHzORIoEoTRIw1dDb5PU-v6uGZU39z8U0g&oe=6B05D75B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Canyon Jukers", "keywords": [], "long_description": "Embark on a thrilling adventure with \"Canyon Jukers,\" an Action game that unfolds in a captivating canyon environment. Monkeys, known for their unique hand-based movement, are pursued by infected lava monkeys aiming to tag and eliminate them. As the chase intensifies, the game offers diverse settings like a Jungle-like Forest, a City with quirky hats, and a spooky Cave with lurking ghosts. Each environment presents unique challenges and experiences, enhancing the excitement and strategy of the game. \"Canyon Jukers\" isn't just a game; it's an immersive journey into a world of action and suspense, where players must outwit their foes to emerge victorious.", "short_description": "Canyon Jukers is a fun Action game set in a Canyon environment where monkeys who move with their hands are chased by infected lava monkeys which try to tag the normal monkeys until there is none left. There is alternative environments like a Jungle-like Forest, a City map with hats and a Cave with a scary mine where ghosts lurk."}]}, "developer_na
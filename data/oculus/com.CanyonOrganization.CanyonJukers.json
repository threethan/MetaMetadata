uluscdn.com/v/t64.5771-25/38982609_637648641797078_1096763185904985223_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq3DYQAfOsEQ7kNvwFHpi-q&_nc_oc=Ado7w6Q9eJm6BW6X7UvmMs3NQsV6cOfiWDUJ4CR8y5fSF1wfmh9GDTGLZBdcXWp-M-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGBV43Bbw0J6Z_oexhA55opaPb4GWGuwGQPedRHI-RnQ&oe=6B071221"}, {"file_name": "screen4.png", "id": "1334487554156930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031595_1334487557490263_1375598664409495046_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtLzAaT5hNsQ7kNvwEGiOEF&_nc_oc=AdpH4fOCeLGUbmV52fjc-6KVIJ2aCMxA7gryUbkPRk3qaunbs1bl8tU8OwQWlz9-6zI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSKENB3cNgmAM3p1sWZWZEatTuVT57xlGJgxIlnj2_eQ&oe=6B06F09B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Canyon Jukers", "keywords": [], "long_description": "Embark on a thrilling adventure with \"Canyon Jukers,\" an Action game that unfolds in a captivating canyon environment. Monkeys, known for their unique hand-based movement, are pursued by infected lava monkeys aiming to tag and eliminate them. As the chase intensifies, the game offers diverse settings like a Jungle-like Forest, a City with quirky hats, and a spooky Cave with lurking ghosts. Each environment presents unique challenges and experiences, enhancing the excitement and strategy of the game. \"Canyon Jukers\" isn't just a game; it's an immersive journey into a world of action and suspense, where players must outwit their foes to emerge victorious.", "short_description": "Canyon Jukers is a fun Action game set in a Canyon environment where monkeys who move with their hands are chased by infected lava monkeys which try to tag the normal monkeys until there is none left. There is alternative environments like a Jungle-like Forest, a City map with hats and a Cave with a scary mine where ghosts lurk."}]}, "developer_na
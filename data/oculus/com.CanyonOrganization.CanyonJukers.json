uluscdn.com/v/t64.5771-25/38982609_637648641797078_1096763185904985223_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ete13Exs1kQ7kNvwGqlsFC&_nc_oc=AdprAGBfYR0WIST0d_YrpPmZCdix7M05RsD2-0rv3ZcX-eqHwKiq0pTdiF_HP9Z-Hts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTww_DS5_WNFomL5mEEC3b1btFfg4hPBQ5jY3Zy2LtPOA&oe=6B01CC21"}, {"file_name": "screen4.png", "id": "1334487554156930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031595_1334487557490263_1375598664409495046_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm6DuWx3josQ7kNvwGUcqpe&_nc_oc=AdoTz7ixl6CsI1SKnvkcspXs2YLTZIvhc2qVb0Am1Km5q24B1OoohKOnEdFx6jg5teQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyD5IP3P_y-0wlMf6tidEPWhuOVmokfn58sDD3-7TMBw&oe=6B01E2DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Canyon Jukers", "keywords": [], "long_description": "Embark on a thrilling adventure with \"Canyon Jukers,\" an Action game that unfolds in a captivating canyon environment. Monkeys, known for their unique hand-based movement, are pursued by infected lava monkeys aiming to tag and eliminate them. As the chase intensifies, the game offers diverse settings like a Jungle-like Forest, a City with quirky hats, and a spooky Cave with lurking ghosts. Each environment presents unique challenges and experiences, enhancing the excitement and strategy of the game. \"Canyon Jukers\" isn't just a game; it's an immersive journey into a world of action and suspense, where players must outwit their foes to emerge victorious.", "short_description": "Canyon Jukers is a fun Action game set in a Canyon environment where monkeys who move with their hands are chased by infected lava monkeys which try to tag the normal monkeys until there is none left. There is alternative environments like a Jungle-like Forest, a City map with hats and a Cave with a scary mine where ghosts lurk."}]}, "developer_na
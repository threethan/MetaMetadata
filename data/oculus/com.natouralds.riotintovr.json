nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPSrco9A0eFyrvl76D5ldjpRs7iDpCWy6m1ptReB-Yww&oe=6AE5FDBB"}, {"file_name": "img2.png", "id": "1017292537349459", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604317775_1017292540682792_6800868628932090804_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tf7OATfD74sQ7kNvwFvER04&_nc_oc=AdqjAyo8TfJ-xWE56iPa4mq3Mp4m_eV85Z4-fkeiTEVLdpX75Ps5VFu7_ktHeqaIgc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkRZ4ft5kpfvLTR-nbRkhDmXfOPygNdaZxuc3Yaki3dw&oe=6AE60E4C"}, {"file_name": "img3.png", "id": "27184140144581228", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_27184140147914561_2228711797656661093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQgbOYf3meUQ7kNvwE4EIhY&_nc_oc=AdrF8TZLF6_ejrAEgBTbmKOgLf1dWnIStAgpYMCUVJbmFB3wm2LNKnI6DeNaaampOWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTqaP5LtDjwryhKFEm3i5Uc0xUMRmrwKNt5M98GLHtEA&oe=6AE5F12D"}, {"file_name": "img4.png", "id": "1327951792244068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593909648_1327951798910734_4449505028039758110_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rmzCyq4cMsQ7kNvwEjOY9U&_nc_oc=AdrscCtreqoFejuy_GzwO1Vt96cCrLvDckvMdXsZVEiRgcg3i3AA-k1XcfqzkCZU_ac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvsLXcH5JCjhaYAVw-fhtng1cg9c2YLox0sCd6jfLj-A&oe=6AE5FEF2"}, {"file_name": "img5.png", "id": "1528012988731147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307470_1528012992064480_1477291769199768932_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJwfetqalbIQ7kNvwGvbHNW&_nc_oc=Adqy7DEdzPXLXDzqrMSUP9KeVdA8BsC55VwE8gE0jluwCFkMq-TijWwa9-JE9mHh1to&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPsXQXU9qbTssonpiY_xQ6jF9WyOX0Wmb0Q7BoVXhnqQ&oe=6AE6111F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rio Tinto VR", "keywords": [], "long_description": "Sum\u00e9rgete en una experiencia inmersiva en realidad virtual que te lleva al coraz\u00f3n de la historia minera de Huelva. R\u00edo Tinto VR te invita a recorrer cuatro puntos clave de la ciudad y descubrir c\u00f3mo Rio Tinto Company molde\u00f3 su desarrollo, dejando una huella imborrable en su paisaje, su econom\u00eda y su identidad.\nTu recorrido incluye:\n\u2693 El Muelle \u2014 Descubre el hist\u00f3rico Muelle-embarcadero, s\u00edmbolo de la conexi\u00f3n de Huelva con el comercio internacional y testigo del auge minero\n\ud83c\udfdb\ufe0f La Casa Col\u00f3n \u2014 Explora este emblem\u00e1tico edificio que reflej\u00f3 el esplendor arquitect\u00f3nico tra\u00eddo por la actividad industrial de la \u00e9poca\n\ud83d\uded2 El Mercado \u2014 Recorre uno de los espacios que mejor refleja el crecimiento urbano y la vida cotidiana de la ciudad en aquellos a\u00f1os\n\ud83d\ude82 La Estaci\u00f3n de Tren \u2014 Conoce el papel del hist\u00f3rico ferrocarril minero, motor de la conexi\u00f3n de Huelva con el resto de Andaluc\u00eda\nPor qu\u00e9 te va a encantar:\n\ud83d\udcda Contenido educativo y accesible para todas las edades\n\n\ud83c\udfa7 Experiencia 360\u00b0 totalmente inmersiva\n\n\ud83c\udfde\ufe0f Recreaciones fieles de escenarios hist\u00f3ricos reales\n\n\ud83c\udf0d Una nueva forma de descubrir el patrimonio de Andaluc\u00eda\nYa seas estudiante, amante de la historia o simplemente curioso por conocer un rinc\u00f3n \u00fanico de Espa\u00f1a, R\u00edo Tinto VR te ofrece un viaje en el tiempo a trav\u00e9s de cuatro lugares que cuentan la historia de toda una ciudad.\nDescubre Huelva como nunca antes la hab\u00edas visto.", "short_description": "Recorre en realidad virtual 4 lugares emblem\u00e1ticos de Huelva \u2014el Muelle, la Casa Col\u00f3n, el Mercado y la Estaci\u00f3n de Tren\u2014 y descubre c\u00f3mo Rio Tinto Company transform\u00f3 la ciudad. Una experiencia educativa e inmersiva para viajar en el tiempo sin moverte de casa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://projectsnatouralds.com/Huelva/politica_privacidad_TioTintoVR.html", "developer_terms_of_service_url": null, "publisher_name": "natouralDS", "support_website_url": null, "website_url": "https://natouralds.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1520548076518495"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1874814320140902"}]}, "baseline_offer": {"id": "1874814320140902"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782303780, "status": "PUBLISHED", "id": "1874814320140902"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1559727379267231", "version": "1.2"}, "id": "1035114729214961", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1520548066518496", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1559727379267231"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035114729214961"}]}, "change_log": null, "created_date": 1785929697, "id": "1559727379267231", "version": "1.2", "version_code": 3, "release_status": 
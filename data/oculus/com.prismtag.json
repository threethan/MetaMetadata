952_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li_KQHebjmYQ7kNvwEelKd-&_nc_oc=Adr2ZYYJPe7HFGoUh_Kmyx-l_GdMdg8tT9_P8AxoSwCpiYnaaQE60Z4qjl98rPPM85U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYAHcMwtMJFCQ56MJfkY0z-sMO3hYJX9ZmEBvqxm0Tpw&oe=6B046F78"}, {"file_name": "yeeee.png", "id": "1703776760859164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307931_1703776764192497_8494248378252095829_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFGFty_hk3UQ7kNvwEhvWUJ&_nc_oc=AdqOrbjy2suuSvP9y5qWMp_sthXRnfZ3iaku6-mXq4VkXAccrnxSp6zfkjS-QCMte9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhjx3-ss2oPMN1B-S7tcuuftzfbuYcgp-1_h-2NboHcA&oe=6B046276"}, {"file_name": "yeeee.png", "id": "1573362724416926", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298900_1573362727750259_8702039059774602885_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA0hc3NTF5YQ7kNvwFvGxhK&_nc_oc=Adpxf39ruKSzVceV2D4e5IQnd-efn49nZ9qiLw43icGUuAbJ18iv_kIdaJ55zDLIkPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYDL7IZa5uDHkw2lmYQtn21KjZczf2IpeFE4kwEIU4zg&oe=6B04568F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Tag", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Prism Tag drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Prism Tag is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "JKS", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hYEf1vBkkPNtDsqfL_OXBRrrTjioz2SfTjFN0eFddes/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "JKS", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-tag-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1222917380905521"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1447855995078324", "version": "150"}, "id": "2064534817770653", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1222917377572188", "is_concept": false, "la
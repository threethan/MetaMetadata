7DA662"}, {"file_name": "SS5.png", "id": "997655260901935", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982521_997655264235268_5942355324303180138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io18sECMrNkQ7kNvwF5LLK8&_nc_oc=AdqxlpcqIo7Mu9hdSXRm157p5sfvNzU7eCvHhcSV_kzA4QxOP9FQQUvMXCYvfu5WsYM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBzmpRnMf_2Ot23htjklVvo3tacL_9K0UhksxTl1lOCw&oe=6A7DBC21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_YDemo.png", "id": "598071861169135", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974862_598071864502468_8684961041275352394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiVYQFTSZcYQ7kNvwEqbA06&_nc_oc=Adqeb3C3AmJCwCfr8NDbnlAnP4uYtxDdgaJlx5p-VLQC1RIPPRlusLeRgBpmBuI4g48&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMVsDP1oAEgtBavwhRcuvvQdkdWSc3YF5LYEQuKRd-nw&oe=6A7DBFE8"}, "display_name": "Simulation X trial", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}]}, "developer_name": null, "developer_privacy_policy_url": "http
=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgEw-TscPEwQ7kNvwG0LFXk&_nc_oc=Adre0blApmcdCx7l7vyJ0J8EpOei9TuBYhHPTeUJDywxbqueZGIfxNCAh9DxMrL7GdA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mITlrE3tYD7b7JJE810Xiha-ePKopr-nqdobiOcSOtg&oe=69F2122F"}, {"file_name": "4.png", "id": "2031682293901788", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57570314_2031682300568454_7181790668181460473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELzdzhVrDV4Q7kNvwGMwiH6&_nc_oc=Ado6QA8MHt1SJT4-ubLYohjjtfeBBNX8_yy_KBvRH7Mz2igRQ7qNVa2asNmAHi3kJpc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0S6SToK0pe9cy4LEpAs0_CnkHCLUo_FsHGWU4BNsgbtw&oe=69F21A08"}, {"file_name": "5.png", "id": "1182641809455371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982685_1182641812788704_4892425978473987963_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YeJ4APrkTgQ7kNvwGRIWWv&_nc_oc=AdreMrRWeC_kIMJ4tH8slep0WxnQa5f2_lx2Xobmolv7-FLaecYMoylTlmAgTtrdSq4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3V8xF7GWBZ3PUJDbmOT7ZIIFduUx36MH52L8h8Drurug&oe=69F1F2A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9-2.png", "id": "7747279352020652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610710_7747279362020651_5612876263433505548_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7-tAj7soGkQ7kNvwGsaiIm&_nc_oc=AdqnV_uzRejzYsliX6yMOpObu5vcDNZJbhFhWEubga_XlEtFC8SJG4ittOUNJJsbcwo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0NxvreZ00q4s7_g3WDOd9Foy01RNt9FJ4S8RUy9SyZlw&oe=69F2109A"}, "display_name": "Void Ninja", "keywords": ["action", "platformer", "runner", "ninja", "void"], "long_description": "Void Ninja is an **action platformer** game that blends runner elements with a unique **\u201cJinba Ittai\u201d locomotion**.  \n\n\ud83d\udc49Gameplay: You're **always on the move and can't stop**. Use your hips and shoulders to steer on the path. Overcome obstacles and clear out enemies.   \n\n\ud83d\udc49**Just one button \u2014 let your body do the rest!*** \nYou don't need to remember million of combinations, or press something to move  - run with the flow.  \n\n\ud83e\udd77\ud83e\udd77\ud83e\udd77  \n\n# Key Features:\n\n- **Unique natural flow locomotion:**   \nInspired by the \"Jinba Ittai\" philosophy, this system ensures perfect unity between player and the game - you simply act as you would in real life  \n\u2796  \n- **Comfort / Motion sickness tested:**  \n 85% of players experienced no symptoms, 10% adapted after 30 minutes, and 5% did not adjust and we prefer not to talk about them  \n\u2796 \n- **Platformer / runner:**   \nFirst-person platforming adventure inspired by a certain blue hedgehog. Intense combats,  adrenaline-pumping jumps and jet-powered flights - this game will keep your heart racing   \n \u2796 \n- **Combat dance:**   \nAs you progress, you'll develop your own unique moves and combos crafted by your skill, not pre-made by the developers  \n \u2796\n- **Level reassembly:**   \nEach time you load a level, it\u2019s generated in a new and unique way   \n\n \n\u2795**21 Level-Stages** designed to test your reflexes, agility, and quick thinking.\n\n\ud83e\udd77\ud83e\udd77\ud83e\udd77 \n\nThis is work in progress version.\n**Share your thoughts, ideas and feedback with us** - let's make the game together.\n\n*rarely its 2 buttons, but you won't confuse them. Only 1 sounds better, right?\n", "short_description": "Void Ninja is an action platformer game that blends runner elements with a unique \u201cJinba Ittai\u201d locomotion system. \n\nLocomotion x Controls. \nJust one button \u2014 let your body do the rest!\nYou don't need to remember million of combinations, or press something to move  - run with the flow & help your enemies to meet your katanas.\n\nStep into the shoes of a hero who races forward through a treacherous void, armed with 2 fast katanas and razor-sharp reflexes."}]}, "developer_name": "Roman Yakimenko", "developer_privacy_policy_url": "https://void-ninja.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Magic Web Solutions", "support_website_url": null, "website_url": "https://void-ninja.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7846840572108730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223480_1389025115834181_7304722132984924112_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CljMky4U96wQ7kNvwHj_gv4&_nc_oc=AdoIZgiv75H4PfEGhRymoZlaNliySjDJZk8SqBnwW48jg7Mkx-AsZZdQGBMdRhzTay8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3H0Qxc7laA3fMpsjiyZw9gq8yWD5i0UKA2wOgX_uUWmw&oe=69F205BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Void Ninja", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1663177686, "lastRevision": {"nodes": [{"id": "5242571735868973", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5242571572535656", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2924889061095203
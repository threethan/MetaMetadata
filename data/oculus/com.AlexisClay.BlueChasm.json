png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tseji5V8I0Q7kNvwFBz8Tt&_nc_oc=AdqlBT2-c81Xg6VZCgJnB6vzlZFTsdxfymoEdyNhs4m0IomlS2FezCkMLUkt5hoJLLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1Ol8BdU3rEFXEMYJv2up_Im3SlgQ3knc2YsEZqJvfRA&oe=6ACF9506"}, "display_name": "Blue Chasm", "keywords": [], "long_description": "High-speed, skill-demanding action game!\n\nThis game has 11 unique levels and takes about 10-20 minutes to complete (7 minutes if you don't die at all!)\n\nControls:\n- This game is playable using only one hand.\n- Left or Right thumbstick - Move\n- X or Y or A or Index Triggers - Jump\n- Hold jump to go further\n- Left menu button - Pause\n- Cheat code: \"A + B\" for 5 seconds to unlock all levels.\n\nMusic:\n-FEG 18 fadescape by SOUND AIRYLUVS\nhttps://wowsound.com/our-music/tracks/feg-18-fadescape-full-loop.aspx\n-SCS 10 Never Love Me by SOUND AIRYLUVS\nhttps://wowsound.com/our-music/tracks/scs-10-never-love-me-full-loop.aspx", "short_description": "High-speed, skill-demanding action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6c42c178-8863-46b6-a0fa-825640742b60", "developer_terms_of_service_url": null, "publisher_name": "Alexis Clay", "support_website_url": null, "website_url": "https://alexclay.itch.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6556933
escape-full-loop.aspx\n-SCS 10 Never Love Me by SOUND AIRYLUVS\nhttps://wowsound.com/our-music/tracks/scs-10-never-love-me-full-loop.aspx", "short_description": "High-speed, skill-demanding action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6c42c178-8863-46b6-a0fa-825640742b60", "developer_terms_of_service_url": null, "publisher_name": "Alexis Clay", "support_website_url": null, "website_url": "https://alexclay.itch.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "655693332671404"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "995541745193218"}]}, "baseline_offer": {"id": "995541745193218"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1692136096, "status": "PUBLISHED", "id": "995541745193218"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9748427968532436", "version": "12"}, "id": "563301339346535", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9628178733890694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9748427968532436"}, "release_status": "RELEASE
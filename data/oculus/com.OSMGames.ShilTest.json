": "1413516417156072", "locale": "en_US", "screenshots": [{"file_name": "shil-gargoyle-puzzle-2560x1440.png", "id": "1677188183749311", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823837_1677188187082644_1364194236291986853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZzLfgL35rUQ7kNvwHcd33D&_nc_oc=Adq4wd0iAGAkjGNMBX3_v-Potf4eFx2JDX7xbK1uuTVhPx1hxKSdOGIGocOOJHT78EE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUNFxHlf5o6wR5ojLvFZZUWHRrAX3PXijqO3DWymPVVw&oe=6AECA254"}, {"file_name": "shil-ames-room-puzzzle.png", "id": "1137553158735774", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823746_1137553162069107_7796107690673808160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCnp17hrOF4Q7kNvwEKCMRe&_nc_oc=Ado29nd1J8eogpJ6HXTFZWtEZsIBcr7xshEGBAZiAhl6mH2HAvxh2DeHclqyw7nNiSA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbFmIRDat1lks4airy0stuJyIAXuPc0IY-ETYqwFuDRg&oe=6AEC9350"}, {"file_name": "shil-chess-shot.png", "id": "1512847027327329", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1512847030660662_5350781884415039655_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nQtvn8gPdEQ7kNvwFbbijE&_nc_oc=Adpb-pnK63mLGs5fjthOV5SJDNI_ed6Ic36zXRjdVMTPZjcR5LR3iVtWp1YRWGfAiZI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6hEYcynuQzCzb-zdDxGGbzYlr0p9mppx14iedE4GuDw&oe=6AECBB86"}, {"file_name": "shil-space-invaders.png", "id": "1996442227996814", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824318_1996442234663480_461902969601723572_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNRPC3wTsQ0Q7kNvwHTU9Nl&_nc_oc=AdphdyLTOkOagt22top2ZCqmyTo3JJOG7EmA8yHPqShqBn-uTIaqkCdo7R2av3VMI2E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLBOT6yux8CAsa1OdIhZhMEkS7SYVAh8-zYmWbvI39AA&oe=6AEC87F0"}, {"file_name": "shil-kitty.png", "id": "1141387365025213", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828608_1141387368358546_3778796479601811611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDqhojXJxCYQ7kNvwG3zWOP&_nc_oc=Adqg-X4EPaLbK7ZsltqfMDtO_wse0eHzEGFQ7ePgJNeS8XKDcQe8TP0LvB5M9X4ik98&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7I5JlLDkRNYWFJz6JjGo7CHKd0Fgd2yI0ecaRiKFENw&oe=6AECA03E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta-Store-VideoCover.png", "id": "1095248552951442", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823783_1095248556284775_4491311446201457387_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5U91ItLNuMQ7kNvwHoWBKu&_nc_oc=AdqYYMVt4yH3KuFru5oVMVGE8xfliugDYiEWYUpqU1_RuTuUJIDyusNIboIbSgu7ZBM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_eE0AyxJ9xL0GQP9eA3HyynwmuCRoUeD-0dIoyxOsHQ&oe=6AEC92C6"}, "display_name": "Shil", "keywords": ["puzzle", "adventure", "narrative", "indie", "action"], "long_description": "This game will make you smart. Not Oxford smart. More like microdosing in Silicon Valley smart.\n\nYou\u2019ll discover invisible paths, solve impossible spaces, and become deeply suspicious of your own eyes.\n\nIf that sounds like your kind of problem, welcome to Shil. If you need more convincing, the professionally written sales pitch continues below.\n\n-----------------------------\n\nPrepare for a mind-bending puzzle game like no other, and enter the world of **Shil**. Step through the door of the subconscious, where logic and perspective are skewed into surreal and undefinable puzzles, that baffle and contort reality beyond reason. \n\n**New Worlds Await**\n\nExplore ever changing and pulsating landscapes, filled with stark silhouettes and invisible foes. Uncover what\u2019s hidden, follow unseen paths, and discover a mind trapped within itself. \n\n{1656860132740611}\n\n**Hiding in Plain Sight** \n\n**Shil** is a stark yet colourful world, with danger concealed not in the shadows, but right in front of you. These fractured realms are filled with creatures in tune with their environment, strange weapons, and multiple unknowns to reveal. \n\n{1018353314357438}\n\n**Make Your Choice**\n\nUncover **Shil\u2019s** branching narrative, a psychological tug-of-war between humanity and technology. The AI that built this world acts is your companion and guide, but is it truly your friend? Press onward, make your choice to trust or defy and learn that even in a surreal world, there's more than one path to success.\n", "short_description": "Shil is a mind-bending first-person puzzle game. A secret door into someone\u2019s imagination. Unscrew your brains from every day logic. Shift your perspective, solve surreal puzzles, fight invisible enemies, explore the unimaginable. Beautiful. Bizarre. Barely logical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15QAW0q7M70oNtFYe4dgLR7Piy6BP1hCgk8iJjEDnJZY/edit?tab=t.0#heading=h.5tt5v4z60nrl", "developer_terms_of_service_url": null, "publisher_name": "OSM Games", "support_website_url": null, "website_url": "https://osmgames.lt/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "lt", "es", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28948995561418784"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825563_1406687598103
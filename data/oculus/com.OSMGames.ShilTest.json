5-1.oculuscdn.com/v/t64.5771-25/491825415_1084043617393159_5236578330907655362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4m_1wnNfH4Q7kNvwGf_ikd&_nc_oc=AdpHOcdu49WLLE-AMrREFjx2R_Tk7vCGouaCyKF7QYgzPHCVrbdBPVv72QfH4MxsX1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYQBtaWbK-SmDHH062LgOTU8yXdZp5aQ2KEo2azG9AhA&oe=6ACE61AF"}, {"file_name": "shil-game-cubic-enigma-4K.png", "id": "4356854277887279", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_4356854281220612_1722768112722928222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQB71gx2-P0Q7kNvwHQECKw&_nc_oc=AdpFBfrk5TbfPTnUaQkfmMp762sTJGZj0EdATeeKwjYs07gcA56chHXqdF07r6z0eu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAXqffEF7R8mlTAS1zcadFjmpCNgabwCiy4-ApUazmIA&oe=6ACE4F45"}, {"file_name": "shil-game-chess-boxing-castle-4K.png", "id": "1527584092502895", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_1527584099169561_4297798570450391176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9CiR6-aEMgQ7kNvwEVf28Y&_nc_oc=AdpBi2lPoaRTxUNNh7bALaGy6BQ56u2Sn6smlvH0Fy8RALBUQjJmhE0z-Xl4nJrGHVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPYdh7A6Z7ooTj2j3fKJgQw-fX0C_yP22Ii4Wv3vhYqA&oe=6ACE551E"}, {"file_name": "shil-game-whales-tale-4K.png", "id": "1075002195279406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_1075002201946072_6641415890465633521_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5Oh2x9xqoMQ7kNvwFXi1Dk&_nc_oc=AdrcstAR8AAris27xtVzguNpDzr55fISnU3Ov-EBRTx5Yf8OplIO8SfVfgVVVN0BtFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP85SjIZK2iiFf8gvY9f-c_R3ElU_W71jZ-YaQarfy6Ew&oe=6ACE6B55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta-Store-VideoCover.png", "id": "1095248552951442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1095248556284775_4491311446201457387_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6N2nfmcmtgQ7kNvwEGPziY&_nc_oc=Adogu2qyLHkev2obNbAw0ck64yzeiBGUvOX3-BpnuLrCvlYkiuPYcorseBDnuPN7foI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_FxBTSAICvJXyAwn7n5lDTzutbyrrO5KKmnYBT4p7zw&oe=6ACE4046"}, "display_name": "Shil", "keywords": ["puzzle", "adventure", "narrative", "indie", "action"], "long_description": "Prepare for a mind-bending puzzle game like no other, and enter the world of **Shil**. Step through the door of the subconscious, where logic and perspective are skewed into surreal and undefinable puzzles, that baffle and contort reality beyond reason. \n\n**New Worlds Await**\n\nExplore ever changing and pulsating landscapes, filled with stark silhouettes and invisible foes. Uncover what\u2019s hidden, follow unseen paths, and discover a mind trapped within itself. \n\n{1656860132740611}\n\n**Hiding in Plain Sight** \n\n**Shil** is a stark yet colourful world, with danger concealed not in the shadows, but right in front of you. These fractured realms are filled with creatures in tune with their environment, strange weapons, and multiple unknowns to reveal. \n\n{1018353314357438}\n\n**Make Your Choice**\n\nUncover **Shil\u2019s** branching narrative, a psychological tug-of-war between humanity and technology. The AI that built this world acts is your companion and guide, but is it truly your friend? Press onward, make your choice to trust or defy and learn that even in a surreal world, there's more than one path to success.\n", "short_description": "Shil is a mind-bending first-person puzzle game. A secret door into someone\u2019s imagination. Unscrew your brains from every day logic. Shift your perspective, solve surreal puzzles, fight invisible enemies, explore the unimaginable. Beautiful. Bizarre. Barely logical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15QAW0q7M70oNtFYe4dgLR7Piy6BP1hCgk8iJjEDnJZY/edit?tab=t.0#heading=h.5tt5v4z60nrl", "developer_terms_of_service_url": null
file_name": "Meta-Store-VideoCover.png", "id": "1095248552951442", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823783_1095248556284775_4491311446201457387_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5U91ItLNuMQ7kNvwHoWBKu&_nc_oc=AdqYYMVt4yH3KuFru5oVMVGE8xfliugDYiEWYUpqU1_RuTuUJIDyusNIboIbSgu7ZBM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_eE0AyxJ9xL0GQP9eA3HyynwmuCRoUeD-0dIoyxOsHQ&oe=6AEC92C6"}, "display_name": "Shil", "keywords": ["puzzle", "adventure", "narrative", "indie", "action"], "long_description": "Prepare for a mind-bending puzzle game like no other, and enter the world of **Shil**. Step through the door of the subconscious, where logic and perspective are skewed into surreal and undefinable puzzles, that baffle and contort reality beyond reason. \n\n**New Worlds Await**\n\nExplore ever changing and pulsating landscapes, filled with stark silhouettes and invisible foes. Uncover what\u2019s hidden, follow unseen paths, and discover a mind trapped within itself. \n\n{1656860132740611}\n\n**Hiding in Plain Sight** \n\n**Shil** is a stark yet colourful world, with danger concealed not in the shadows, but right in front of you. These fractured realms are filled with creatures in tune with their environment, strange weapons, and multiple unknowns to reveal. \n\n{1018353314357438}\n\n**Make Your Choice**\n\nUncover **Shil\u2019s** branching narrative, a psychological tug-of-war between humanity and technology. The AI that built this world acts is your companion and guide, but is it truly your friend? Press onward, make your choice to trust or defy and learn that even in a surreal world, there's more than one path to success.\n", "short_description": "Shil is a mind-bending first-person puzzle game. A secret door into someone\u2019s imagination. Unscrew your brains from every day logic. Shift your perspective, solve surreal puzzles, fight invisible enemies, explore the unimaginable. Beautiful. Bizarre. Barely logical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15QAW0q7M70oNtFYe4dgLR7Piy6BP1hCgk8iJjEDnJZY/edit?tab=t.0#heading=h.5tt5v4z60nrl", "developer_terms_of_service_url": null, "publisher_name": "OSM Games", "support_website_url": null, "website_url": "https://osmgames.lt/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8099575936787384"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2518196902009982"}]}, "baseline_offer": {"id": "2518196902009982"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791478800, "status": "PUBLISHED", "id": "2518196902009982"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28466755506309461", "version": "1.0.2"}, "id": "1881409855716254", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8099575933454051", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28466755506309461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792701317, "id": "28
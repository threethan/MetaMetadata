-JxvYzwUoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3otGpS9m2pWG67rZekRD6IpdIkXWkfG2n3jgn0vFibw&oe=6ABFC6F2"}, {"file_name": "ss3.png", "id": "1716259736019584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1716259739352917_2949981915797725894_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvV9eV_hnTsQ7kNvwHiK3M_&_nc_oc=AdoXRYhp8eTDKgWzut0LF4uXfukRU36W7wMa5G1BGUTfVmidKdLriDjNPRHjMIyizlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr6rIiuYZjg8RRyTYwR1NjtWVwevywh1XWoClDrE0flw&oe=6ABFE02A"}, {"file_name": "ss4.png", "id": "916930747582287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829165_916930750915620_7277291650115421728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZTDmTwaCgwQ7kNvwFoXoOy&_nc_oc=Adq07gHlnG3scRm3ahelfYXF1eNbXFEemSdOyMCL3vE22uBRcSpMc8CHJnyRHbJ45HY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM58kJbGJJ8yogid8Mf7hw0dxuHrQomWitiJcaqGkWWwA&oe=6ABFD54E"}, {"file_name": "ss5.png", "id": "1457600699363452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1457600702696785_6121833353732817699_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFvMsByy-OoQ7kNvwF-OVQ8&_nc_oc=AdqG7HH2-f8CkrHAfDTC_fzQmWrJIhdL0yMGXsMHW9g1SKpCpv9zivIJ1v09tojgE9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzFIvJ_qtpUBxIi-HKiLAWR99mH7Ubxj3iqBeyW-p7fw&oe=6ABFB6D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1561871294871899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_1561871304871898_5550008067414706657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3N9_GBsf7sQ7kNvwFlitwi&_nc_oc=Adq9B37w1pEK1BrDTdMvBmQgzZR97Z7CseVSSoxd63Ugtyc0ffophshUa6oPY6n0HZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN2kC98xsjKtbLgkrkdQtvOkIPIv4yH5q-WZl1mcwAUg&oe=6ABFD190"}, "display_name": "Realistic Car Racing", "keywords": ["Racing", "CarRacing", "Simulator", "Realistic", "RealisticCar"], "long_description": "Realistic Car Racing is a virtual reality racing game designed to deliver an exciting and immersive driving experience. Step into the driver's seat and feel what it's like to control powerful cars on challenging racing tracks built for speed and competition.\n\nIn this VR racing experience, players race against multiple AI drivers while navigating tight corners, long straights, and dynamic racing environments. The game focuses on providing a believable driving feel combined with accessible gameplay, making it enjoyable for both casual players and racing fans.\n\nEach race puts your driving skills to the test. Timing your acceleration, choosing the perfect racing line, and managing speed through corners are key to overtaking opponents and finishing first. The immersive VR perspective allows you to experience racing from a unique viewpoint, bringing you closer to the action than traditional racing games.\n\nRealistic Car Racing features multiple vehicles, competitive AI opponents, and visually engaging tracks that create an exciting racing atmosphere. Whether you are chasing the fastest lap time or battling rivals for first place, every race offers a new challenge.\n\nGet ready to push the limits of speed, improve your driving skills, and experience the adrenaline of high-speed racing in virtual reality.", "short_description": "Realistic Car Racing is an immersive VR racing experience where speed, control, and precision matter. Get behind the wheel and compete against AI drivers on detailed tracks designed for intense racing action. Feel the thrill of acceleration, sharp turns, and high-speed overtakes in virtual reality. Master your driving skills, improve your lap times, and become the fastest racer on the track."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name"
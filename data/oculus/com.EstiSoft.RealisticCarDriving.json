: "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_1561871304871898_5550008067414706657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3N9_GBsf7sQ7kNvwFlitwi&_nc_oc=Adq9B37w1pEK1BrDTdMvBmQgzZR97Z7CseVSSoxd63Ugtyc0ffophshUa6oPY6n0HZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN2kC98xsjKtbLgkrkdQtvOkIPIv4yH5q-WZl1mcwAUg&oe=6ABFD190"}, "display_name": "Realistic Car Racing", "keywords": ["Racing", "CarRacing", "Simulator", "Realistic", "RealisticCar"], "long_description": "Realistic Car Racing is a virtual reality racing game designed to deliver an exciting and immersive driving experience. Step into the driver's seat and feel what it's like to control powerful cars on challenging racing tracks built for speed and competition.\n\nIn this VR racing experience, players race against multiple AI drivers while navigating tight corners, long straights, and dynamic racing environments. The game focuses on providing a believable driving feel combined with accessible gameplay, making it enjoyable for both casual players and racing fans.\n\nEach race puts your driving skills to the test. Timing your acceleration, choosing the perfect racing line, and managing speed through corners are key to overtaking opponents and finishing first. The immersive VR perspective allows you to experience racing from a unique viewpoint, bringing you closer to the action than traditional racing games.\n\nRealistic Car Racing features multiple vehicles, competitive AI opponents, and visually engaging tracks that create an exciting racing atmosphere. Whether you are chasing the fastest lap time or battling rivals for first place, every race offers a new challenge.\n\nGet ready to push the limits of speed, improve your driving skills, and experience the adrenaline of high-speed racing in virtual reality.", "short_description": "Realistic Car Racing is an immersive VR racing experience where speed, control, and precision matter. Get behind the wheel and compete against AI drivers on detailed tracks designed for intense racing action. Feel the thrill of acceleration, sharp turns, and high-speed overtakes in virtual reality. Master your driving skills, improve your lap times, and become the fastest racer on the track."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34849110688009523"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2231380624305151"}, {"status": "PUBLISHED", "id": "809603575552447"}, {"status": "PUBLISHED", "id": "1700246327624250"}]}, "baseline_offer": {"id": "1700246327624250"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "2231380624305151"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34937135092540415", "version": "1"}, "id": "918103763950858", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "
60823384723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974468_2236760833384722_5674991780641263703_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D61z6oNDEWQQ7kNvwGwlCiF&_nc_oc=Adqr7cZzPe0gMlWRhmUhAZ9zVWnOrk5gZ6chFV5ul0jycdxt_PnQ--7gM3s_nVmcvMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTetC_AaxHJmAOyBlOy66ZO2D2sYh7QtFrcQEEf3IxJSw&oe=6AFF1ABE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-05 230718.png", "id": "1116966233205145", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031331_1116966236538478_1458636392308861639_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yqt2axLJBcQ7kNvwEKf4QC&_nc_oc=AdokX43F7fPCUvMA7Mytq4IMzBbtZf4nliDzWnJ-RGo0-VJn49DX7o5KrNOweV-rP40&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe_HYdrLJIFxcvqtxg6SZwxwfMlTN9rmzHwUb30Gl3HA&oe=6AFF0127"}, "display_name": "My Mini Market", "keywords": ["comfort", "arcadeidle", "idle", "casual", "fun"], "long_description": "Step into the vibrant world of \"My Mini Market,\" a delightful arcade idle game crafted exclusively for Meta Quest. In this immersive VR experience, you become the proud owner of a bustling mini-market. Start small, managing your shelves and serving happy customers. As you earn coins, unlock unique items, expand your store, and improve your services. The game blends relaxing idle mechanics with engaging arcade elements, creating an addictive loop of progress and fun.\n\nDecorate your market, stock rare goods, and manage customer demand to grow your empire. With intuitive VR controls, vibrant visuals, and charming sound design, \"My Mini Market\" offers an accessible yet rewarding gameplay experience for casual players and arcade lovers alike. Whether you enjoy strategizing your next upgrade or simply watching your market thrive, this game provides endless entertainment. Jump into the world of \"My Mini Market\" today and see how far your entrepreneurial skills can take you!", "short_description": "Dive into the colorful world of \"My Mini Market,\" an engaging arcade idle game designed for Meta Quest! Build, manage, and expand your mini-market empire as you serve customers, unlock exciting items, and earn coins to upgrade your store. With intuitive controls, charming visuals, and endless progression, you'll experience the thrill of running your very own shop in VR. Perfect for casual gamers and arcade enthusiasts alike\u2014get ready to create the ultimate market experience!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/my-mini-market", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9451788988187898"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1788755675739524"}, {"status": "PUBLISHED", "id": "1049650134207148"}, {"status": "PUBLISHED", "id": "1739698874075402"}, {"status": "PUBLISHED", "id": "1247271990600141"}, {"status": "PUBLISHED", "id": "4154541644823991"}, {"status": "PUBLISHED",
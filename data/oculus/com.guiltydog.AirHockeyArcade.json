4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7ksw--STlgQ7kNvwH5KYKc&_nc_oc=Adr1yWQ2-U9mtL0F6gy7XO2wBabZdwakzxw2cJRiuoKHpXPxbAtiQkPcidIJjp5v2-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29kbX6L6juW6YIuyQO9HCO_GFGKrInp_f3SEy8VMu3Qw&oe=69D501F4"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54fSglDrWrgQ7kNvwHOJLBp&_nc_oc=AdqgyG4jTepxSB3K-8OQOQGrziIv5-H_9YgN55u01rUSKGacuL9z5DR856zIPJ8Zv2Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33-e0rrZU8Hjh7j9kLUVmaIPNGjuVpqQXbKBhaSeqd9w&oe=69D50CE2"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KxTOPPE-40Q7kNvwGbLCV_&_nc_oc=Ado2R1RcRcFw7OQUnuNTt1WhvmnbFZHn0zGCU2dOpeeDkf67mmTilL_SgUACkUuCE3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y1_FQvovj3fgmCFDy-sjaS5lVRXKpCFG3bOlkQJRvRQ&oe=69D4F98B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyU8CacYj_0Q7kNvwHflwdj&_nc_oc=AdpG2D28uoqXZifI1dg1a_EE5I3a6qsfwCEix6mU7lTbhsyJYkvR_nfrr3NqUH-ywq0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bUOpegku_nQ4Rwmt_BQZSB4PTyrhP-Xp2qoHHaxMi4Q&oe=69D4EF8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pP3RaMoLRB8Q7kNvwEaT-Mn&_nc_oc=Ado_ha-7KbNA36mhbr2uzh9dz6_40QFaQIZuxMq2fqzGM4fEmFfV-uiaPB5hV4pIJu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sVY7KWMmSKEF_GvGANAQ288yXlf1C7lvXrwfeftn0Cg&oe=69D4ECD8"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
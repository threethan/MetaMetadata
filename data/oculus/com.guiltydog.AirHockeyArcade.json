tures:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "538288183868280"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "500124581036956"}]}, "baseline_offer": {"id": "500124581036956"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1622056200, "status": "PUBLISHED", "id": "500124581036956"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26407418182223951", "version": "1.8.13"}, "id": "422830308975458", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3795616697164088", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26407418182223951"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "422830308975458"}]}, "change_log": "In Mixed Reality (MR) mode, you can move the table using the thumb sticks. (Left: change position, Right: rotate).\n\nKnown issues:\n\nCurrently there is no way to end a game in progress.  This will be fixed in the next build.\n\nIf you change the paddle / puck sizes during game play, you may get a phantom version lingering about. but your paddle and the active puck will go through it.  Toggling VR / MR once or twice should fix it.\n\nThere 'may' be an issue in multiplayer if you select different paddle / puck sizes.\n\nThere 'may' be a crash if you cycle through the alternate avatars after a while.", "created_date": 1774537886, "id": "26407418182223951", "version": "1.8.13", "version_code": 55, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3795616697164088", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26407418182223951"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1770630962, "id": "25958514293781011", "version": "1.8.12", "version_code": 54, "release_status": "REL
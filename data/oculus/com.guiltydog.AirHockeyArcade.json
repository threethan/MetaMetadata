4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O8g-FslqFQQ7kNvwGda0k5&_nc_oc=Ado7lDHL5l-mveRyiH3pin0YkJ6lA1uGeMsKmo-mRWRyb40qBRCcJzMunxlx4jFVNbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqQRWPKqrC89QN87gnynu4hNiY17ohc7afXZmJ_5vCWQ&oe=69CE6A74"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeTRbqgj7Z0Q7kNvwHkhOD5&_nc_oc=AdqUj18QP8SXO_fQGNGXoJVdGvbgJputVHtia-Fftb9xMxwPfbWrZlWKAE9BmgkG7lw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr7-mOmyIjuuuotyVz0alZdt-quu5MJ0exl5IJSOOCnw&oe=69CE7562"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbM6xRhbclkQ7kNvwFT-6qm&_nc_oc=AdpaSYCi_q7sivhSw8QJFpKIOSlQdDU7Sn0BmgUyNTRLLD6MqLDxerrzJhtVHRUbimU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPvR89fAbTfI3eHfjTdnxBuwdiZeF82Xc23eqCkJ4VuQ&oe=69CE620B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rWr0uEbnLsQ7kNvwEJaW-m&_nc_oc=AdosQ92E2t475KQI7CK85fXMl00T40eO8QJJZr7Uq6HwtphN7ZXxz6vlcuVHLDC-77I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyK_ho3lRf8ZuKDiYgR123YT-z0sMNXU-CXWZlucnDcAA&oe=69CE580E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUdsjtuCqDYQ7kNvwE2_nHY&_nc_oc=AdrpFyTqK9VW2KJY7xA_SemrO8FXpf0Inzvr6vWhTSedM0FwbFq1l-pn908cVDgRkCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxEpQqgWa9YHIMCQp2ZCmnRL65Ie32vx0o45cqLsRwqA&oe=69CE5558"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
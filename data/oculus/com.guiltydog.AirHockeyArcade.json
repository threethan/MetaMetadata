4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edz2jdYvCmIQ7kNvwHm6WC6&_nc_oc=Adqp8XRfOQg8BCoYiLlp2W6sDq-za1aKp-qq4se7ZBjq09lOlseWedxxZNmYNLxNkqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4HGldvRBft13mHRN2hUecZaDb6Z9ptBg8KiVzpbVDaA&oe=69C92474"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88Gg7l1AVF8Q7kNvwHdsPV0&_nc_oc=AdqfFvXS3Neky3uQCuyvjtRbwVGLOi3U0DoQHdEksFMcgxTpmvPraYnsIOrtaPTKt9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxyqy1eODyr01i0_fo4PVJuGn2XPNDSghTxQ_nAZYbGMw&oe=69C92F62"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEOGgWd4OgQQ7kNvwHnF_0g&_nc_oc=AdoNiMSNBYVc0uGisp0pS-R-mcYozjaU86pJRiqPqCKBmOaHVAgCnHcW0YnPsuo8VKk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwaxsj_N9jqdkYEE9Dl48tTOhdcvMsoxeJEBSFfeeMC3g&oe=69C91C0B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtNBfB-rQ_8Q7kNvwGYxkrR&_nc_oc=AdqqT1sH-UaGCpRcZCjfnHd5CqMV2scqqJFi4tF4szaVBDIuDtk6XPb3na7QXpPA6aU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1qC-X_02gGMIptQ3GlwXH0KURyemOUJQTjdwAjSbt1g&oe=69C9120E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bueb2snMThsQ7kNvwFnZFon&_nc_oc=Adp9NtNEr34yKMnYwOGx9JHG4CcFXRdldd_7SnvdJJ028OStae_x4rra7DL3mIunQV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJvJOF-l2peuWm5gg3GZqp4TLvzarAknGK0HamByyoDQ&oe=69C90F58"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
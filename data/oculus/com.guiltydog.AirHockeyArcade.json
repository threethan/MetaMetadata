4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edz2jdYvCmIQ7kNvwFIxHvZ&_nc_oc=Adp40bqmpBvPNHvtdNVmx4mhrFZBQYL9rlAjX8jK8AbAp0lxsbRObEx6z0sZontzffU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYR6pMMfh5-JKcr4_OzkKly9UOyLvpdYSCiF6aAxKpSA&oe=69C7D2F4"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88Gg7l1AVF8Q7kNvwHI47XE&_nc_oc=AdrnjxQe2LNaCNYV4Fti0V8zHmhBy8QdUrZAZ3eNFJMbgzZKj166MsZkQxdOmwr2iyw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNwweZRCbhKAOHxgE-xYubmxCR4lLgF-p4J7XSJxC4Gg&oe=69C7DDE2"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEOGgWd4OgQQ7kNvwH0U0DU&_nc_oc=Ado8cANPXpOttuvRvQVxkmjrToSfaKFnAUy3rkSCqqzMoPOrgdSpeQhZJkA6e0xu0LU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWIqKuVdKvqws_Nk0vvtdlyUB0LLTYI9qfiGTShMbxrw&oe=69C7CA8B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvbK16a4--UQ7kNvwGvtrnT&_nc_oc=AdqKt-RmlRHDOOO8HOc1alt0RYcHphUBMVmtDKLjQUvNV1_TZDc2qpuXcx39zp5wUzk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9zsKuLVGbkRAO12781VL6hWXFgpgT14jwcCmWqA7GAg&oe=69C7C08E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-1NPtx7EbQQ7kNvwGgdiuY&_nc_oc=AdrXkC6SUCQRxMpvsytQUuXxNVAb_-45Tu8wEv2kgFHzeV0l7syqrSMBalu4WlQVGdE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjcNRljg17NjgETl9YpNeb-TuQeEx3eCxEM7o10V-2zQ&oe=69C7BDD8"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
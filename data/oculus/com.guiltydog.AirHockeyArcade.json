HJJWAE&_nc_oc=Admwadr4QumXDNLPM_EaeR59GVxZmIvXtpqfK1CRCRRJdE6KcawMU5B0Jy7j_GBdAsc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftvrYglteIHh8vugyPfmcnqRE_su-YtMHQDseF0H9r_7Q&oe=699C5174"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJdVpz1FfXEQ7kNvwHLO1JG&_nc_oc=Adl6K8qkW3gZGii6Vs2J9KrwbwVqtO0fNuZlFej7AcPJkq1pn1FZM7PpDdqAz09Kihk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs-VnfhTDTwWTCTLSSZ70NRNJ1kPuldd-77RUAYDYFg4Q&oe=699C5C62"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KsiLWDIOZwQ7kNvwEJPIko&_nc_oc=AdljsVjdzaNyJcv7f4LKzyFGVqBZOPICM-CRUNpUQiJH3bqMN-yTphXBuvnLXyhYbrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsNyr8JxlHFLjFjGULBwPMQ7ea-cwvFWj4dYs3r6ZZelw&oe=699C490B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTxFKhpMmrwQ7kNvwGm6sfU&_nc_oc=AdmPDypcdzSwGaDkLAoBKaV_jaDygDVIxD-WaZssbw961NRY0csy9Bm89-_-tx2tVtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsjrOrxc1Gq_7Yx4HtoTe6giIxJOXXBdp6yAlbr28-ryg&oe=699C3F0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVb2NqmXS90Q7kNvwFlKhBH&_nc_oc=AdmF2nnmZac6GhnIMeXtgawHPkFYVYxsZZ8s2DH18ObwApnryA0g4Vri0LzX84AeZgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsbFOmM3ovNZGVxP3KlPLr39G0k_8By3U8ysR8EvQ9JvA&oe=699C3C58"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "53828818386
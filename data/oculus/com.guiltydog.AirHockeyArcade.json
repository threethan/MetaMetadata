4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkhBaHMK1-EQ7kNvwE9EaJ9&_nc_oc=AdoW_ARRR7rh83eJsT7kKcTes1j590AyAHxpdCQWUHD1MiajOEkUjrFsO2h7VH7kHvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LOHnsE5_MrFvTF9Rw-adIzM80LTzE-_XwTSLIL67KAQ&oe=69DB9974"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESbQmzkbxr4Q7kNvwGVMBXS&_nc_oc=AdoeMj39kwDFoP8zh_L4VwAir5FeFPc5KoBgT2tIzcWWSk7UbbRB_tq1De72LWA97oE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S6jW6PH5gexmmiLlaj1XHv4NPtE8y3zIkEi0MmEW3vw&oe=69DBA462"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xapJTAEu7vgQ7kNvwE3bcBM&_nc_oc=AdokGjEtWVLyTB4lSaVw3QFn-8geNYy9eLFC99SyqmL_nR8qAjMSHdRm3eCypRpzAHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01EI_M7OSIBHx1MOxHt-5fWKgpFqfQEjVxlxw0GAbCSw&oe=69DB910B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7MGBeArI3QQ7kNvwFukVpA&_nc_oc=Adp7y6AjgbFPU9WuY8vWec0jLTp8G7x4RLd2BsitzYKzv7XtjKckNqcTXmNYKHCUg-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MLbkMVsIutcyXUVlJXPAN_LgHhU6Qm22ikA_c4evR6Q&oe=69DB870E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leW7V0_Sm9AQ7kNvwHfAGDH&_nc_oc=AdrMnYsQFaTIBuLy5LJO4WGC_gL2021mUf1OHzNgy_L7KsHEctgiGq9GoKqXWGloo6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u2n3N1Ti47PX3XhiHPvUNVJjWtWcRFmSdHVS1GBcruA&oe=69DB8458"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
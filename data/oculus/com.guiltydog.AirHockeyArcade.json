4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvix7me_TFUQ7kNvwEsLkPA&_nc_oc=Ado2zXDdX_aFkplyfiHzFtle9KK1olPh2OWMZGlJZjCWvHscnEtQJquoamgxA9b-264&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzhjj58zma_pCKWuqhzdT2rozCdoppxn0xfIY2Rxy0LOw&oe=69C3DE74"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq5gzf0MWQYQ7kNvwF01_iC&_nc_oc=AdrsRrp9-4H9gRHPJmg5U2417zdkrzyXP6GA0DNXY_cqCGpDmN7dX5czntIBK42nXP0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrElkZJ2QFJCbs4v4kUMQ8FnEkInvJk_7EnKGf5t8T1A&oe=69C3E962"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcVaEkR1vR8Q7kNvwHWu5DT&_nc_oc=Adp0lI48dF_m1ioyWddAfthpDfVG9ZvYCjoQ9QndF2XQx4_B8fzMG1oYZN1lzCuvELo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYwYruv6drabRhY2IH2uCq2tlpb-3rXIyZsHR37d937g&oe=69C3D60B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx8Z7_F2qP0Q7kNvwHPPJok&_nc_oc=Adq30ak8qK8lhl-1tbcAWqwFed_WQ3lqBmo5k6fJY6iIlwQ_I14Y2O18ie6o55R0Qeg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9L57hNm6sFmmzwLGggboeo-hWyEEDMtSCBxc1vSex7w&oe=69C3CC0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mowuepC7uyUQ7kNvwEPCV9G&_nc_oc=AdrYhcjcMZXi_holt5aEAaJdEpdUmB3AYFVA6nE5V-7neooqay7JMmF6tSTSuzMgJi0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz70DlzJKrqS6KUjlpnZbp0Aq77LByHbn9SjB_Ws4hCOQ&oe=69C3C958"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
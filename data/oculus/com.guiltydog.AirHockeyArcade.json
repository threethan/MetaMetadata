4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyntlE4PU00Q7kNvwElHqdd&_nc_oc=AdpFCK1LFggRraFfHYOJ1RCVw8w0N5JEBOYuh82a1hYnSHkTUXwHTi4py0A1Ir0n_E0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz_ErD2bDbTCqU1-N_Pu-xizQvCHuwmY9dU4dEhPdyGA&oe=69CA75F4"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88Gg7l1AVF8Q7kNvwGVDyuK&_nc_oc=AdrZopFcPR3vmAgiFvDsnVJ0HmWZXV5h9pEnJl3bVbBivL8tFtFj-49YE1PirJyWmY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9IFxWejJdYiPC0Ccr3TaucbkdL0w84zi8yekEOSaquw&oe=69CA80E2"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kkjcnf0TOsQ7kNvwGrk3gL&_nc_oc=AdqKZBAJp3BJ_3VvKeRdIFWvWUqZda_M58jSmfYLp3BVwEwZmGcaJ4aAz4E6HF55Wfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyccxIURDFEepS_iO9uEeoXTUBvL0787W6mGc6QFqtAiA&oe=69CA6D8B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtNBfB-rQ_8Q7kNvwHHTsij&_nc_oc=Adp2gEk62P44X9BJUeq2gP5N5ATWsYpWj4l7bmfTXtLT7a4bJ6e0XNGJOGRgoAsDzjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4jKTS6dPOhUgWcbD2gm7td369fEr8kDDv4W9jMVgAaQ&oe=69CA638E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bueb2snMThsQ7kNvwEE7fQx&_nc_oc=AdoB0BWSh0MwiUWRUmClFXiXeL07EepFu4fnU7JUMxPomItCxq6NBxvtVGu8klGm5o0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywAVGa8BfKdMflYH6f008e7d47l74C4jKJFRBJkWuJzg&oe=69CA60D8"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O8g-FslqFQQ7kNvwFr_2Cc&_nc_oc=AdoyYroIcn7kPZAkaXLpBijyP9eRC5k96PJOG-3dFSqOsfvNgXoB_arYmEFwmn00HIo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiQfanuL6DapheFuZvLs_JqfDt1fBqtXha8603aJcZFg&oe=69CFBBF4"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b06TSeVCowQ7kNvwF8ibrn&_nc_oc=AdoKmCE6YbEJhGfWQc88Jj3gOD0_kwtLbN_zQg8vvse5VddpAiRKB5dA97MT1iY0fkc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzkESeXD_TsstoRkKuS4qS0e4eaYw5cPMWCuV2QKO1SA&oe=69CFC6E2"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbM6xRhbclkQ7kNvwH4RWhe&_nc_oc=AdpJsvVIvOnB02fUu9xF6HN5UPVF0W3_NDmSYewDWe5XCyLCYxYwzmVH-dbZ0a2I_lc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGxUoQmqJ2w0APUEwlFBUDP9gXeOlWzpOr-I0HOhl9KA&oe=69CFB38B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rWr0uEbnLsQ7kNvwHvgVi4&_nc_oc=AdrCQXghbK-eqOB91HrFEQUvL4IeODlrai604pC4DTZi9okj9PrxXbBQgGOlwCl_lP4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaFOyT3VC0MI-0AjrT1gFvypCgNujhpajaHIMx7a4bFg&oe=69CFA98E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUdsjtuCqDYQ7kNvwHHFYWs&_nc_oc=Adq4NUEI4mzqCqZShsX8jMzEOr6xOy27a1Jms-zW-INJx2B_uqfy8ppr28urQxlGnDs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqcsndC6zzjVRT_0dvS2Afpq2iO1PW6z_vJkQearxBog&oe=69CFA6D8"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
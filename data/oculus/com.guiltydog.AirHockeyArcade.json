4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvix7me_TFUQ7kNvwE1Dg68&_nc_oc=AdpOmrBR-8dgUbQwewLc_oxZT260gbpmwnf0WkX0pYvba2QqkclxgjI6UjZE9jqo8LA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYbLSgXzyLOTvW4Prd60PBn_wnGjBzCZgn0HWd1K5EmQ&oe=69C52FF4"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq5gzf0MWQYQ7kNvwH34I-0&_nc_oc=Adow5Bs2K8Y6Id5fxV76I9kFDcTjBLfmtHQwznx1BoZIUci6TsYxZ3P5vYWNTS_I1W4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsIAyim3Eyt-Japwc83UmDE75VWP2vnP2Ke96K6xpRrA&oe=69C53AE2"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcVaEkR1vR8Q7kNvwEL7Nc8&_nc_oc=AdpOwxrCLt_Uf2tWyiAR-Pr_xKEukhN8OFSQ-rqzNtvyhAjYXuEPXM7QRDTuVtzDTiw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQ4FYDi-tYZ0o285FIBut19PnwoEPvGyshXLnNQJR7vw&oe=69C5278B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvbK16a4--UQ7kNvwGIQChw&_nc_oc=AdqdbgN-C6uMiV7_qjp6ec5VYF8kOAGfEv6nPnJjWdUQV6EmwhrQYAdAgGSLkqePwd4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5UGAo2j1PyQSZxo9krIpL8aFy78kUCGy1XXmVJ2CfoQ&oe=69C51D8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-1NPtx7EbQQ7kNvwH9GFdS&_nc_oc=AdoHgA2gs4NZ5hDTmtavPDbZ0S2UPsKCFxX1X4pN9NvqXIimjGaJ_Aj3-gh_b0kh4Vc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsL-WmG34WSz6Aevaj_NPXFUotn-V1wQz9lx3lJmL6XA&oe=69C51AD8"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
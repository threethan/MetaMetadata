GF87aV&_nc_oc=AdmyQLdpQFx8KbJL9mL7_w-Tpp1InZEUWOVlu7MfoXEwq__jLIt9JLW6A6TsGIOM1_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfssZsL7D_w97qha6e8HeeYfkd_BiGjItOmHCEmdEFMieA&oe=699EF474"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJdVpz1FfXEQ7kNvwEksxNJ&_nc_oc=Adke7Ywwd6yT9byHdKKiDu7kyyCAYHKJ5eVj0WJBwTxOQ6sq51U_U6_0OxRV4cpuJwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsanK6oT1sP3G2tIOxUguRWB5ITKmFJVqfKi-Patf82SA&oe=699EFF62"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYgFYy-tCIoQ7kNvwFJL3-z&_nc_oc=Adk1_uS0oa_piSWsQjHXkbz4QSAyz-XG9dtYwavEqaBjhbQj38xSbEjUSb_eRI4Exzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvXXWWCxIWuhSQzLayUt9uYT3wd00Gffb4njwC2i7xuLw&oe=699EEC0B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsXHVwPJKdoQ7kNvwGODhPA&_nc_oc=AdnDMXABwIMzhVXXxp_qFUB5lta_CtBjTuk7zm5jtRCq9j0x8q4uIM5J5YlP1PMn0ik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3WWRInrvpe8kYM4d1uYq1O3Z8Tvy423DzLruO5VK8Uw&oe=699EE20E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C18ACwKwF3kQ7kNvwGwzhoy&_nc_oc=AdnIrS-ePJrilbXCA-plWh6H2UKUKkj1SHfC_3FBmsv3wpB_v6eo5YaA7DruDHox0KI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsBw-3Kda9xJ-eYZc2ywuxzUKzLQXZnhkcHkhfYUcmEPg&oe=699EDF58"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "53828818386
4_297492405073910_5063694878301978057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyntlE4PU00Q7kNvwEDz1PH&_nc_oc=AdqNl2IRjZ1wZ6bvzdI_UxKCFKJez3ccQwCk3nq0DpVYkQEE0_iKWdqMsQIPjPKuiE4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoD2TXPuE1Be6N3xvc-AJHAsK4eeusOC5kPS0m80XIYg&oe=69CBC774"}, {"file_name": "AirHockeyArcadeScreenshot3.png", "id": "852266315502598", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003233_852266318835931_2742876315595565865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeTRbqgj7Z0Q7kNvwGX0we9&_nc_oc=AdoKNaMdODJQVTf4c57sm_aMybnpCTcSpz3WreG7vlIMyAenKuAEV_X0SKe9EQ4vKGs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDMAPiQBoQQUGH_KJuaU3W4n-vhLed7XKHpTDEQ-0Shg&oe=69CBD262"}, {"file_name": "AirHockeyArcadeScreenshot4.png", "id": "312810303547025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031587_312810310213691_1299256561633847988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kkjcnf0TOsQ7kNvwFSttvz&_nc_oc=Adq6U9y2CrHI302ArVP9JujR0ZLZkaKLelu-EsWMbO2bRxUmOKIwzg5Mpw4s5kyq9zU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4S_BstyJr-bLJBkv0NmKx1m_aWKiV2CugtUeffqfkQQ&oe=69CBBF0B"}, {"file_name": "AirHockeyArcadeScreenshot5.png", "id": "4017203708340181", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_4017203711673514_2516840246205928760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtNBfB-rQ_8Q7kNvwEAOuvP&_nc_oc=AdrTVzAOv2B_SsGorAISKd1Kx2UVaWw999rmQYBHEue0XfLxUcOJLXuq06O7z1FzzjM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI9M_JmUtVz2_GPKI4BGech5TZtHIH3vrES2srTYSQzw&oe=69CBB50E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirHockeyArcadeCoverImage.png", "id": "122261826479768", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221318_122261829813101_8985766523073963195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bueb2snMThsQ7kNvwHea0NH&_nc_oc=Adp4NCul31I8YnFYmy-7gvClKtpPg_norcInm8UnV2mD_o_zUswwA1bG-u44KNA1ui8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtQZ2tY-3oINbV97zsiyD1xnsr2r8cUcLtIo3HoEWwZQ&oe=69CBB258"}, "display_name": "Air Hockey Arcade", "keywords": [], "long_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your Quest.\n\nThis game is still under development, but we wanted to share what we have so far as a playable demo.\n\nDemo features:\n\nPlay against our AI opponent with 3 difficulty levels.\nReal-time Physically Based Lighting\nSupports 90Hz on Quest 2\n\nFull game roadmap / Planned features (some will be free with the demo, some will be In App Purchases).\n\nMultiplayer & Social Features (perfect for future lockdowns!).\nHand Tracking support.\nAchievements, Leaderboards & more.\nCustomisable / Multiple environment.\nMusic player (details to be confirmed).\n\n", "short_description": "Did you ever fancy owning an Air Hockey Table but didn't have the space?  Air Hockey Arcade gives you an Air Hockey Table inside your headset.\n\nPlay against our AI opponent with 3 different difficulty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.guiltydog.co.uk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Guilty Dog Productions Ltd.", "support_website_url": null, "website_url": "http://airhockeyarcade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
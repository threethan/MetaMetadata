1263685267.png", "id": "549435157995635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223470_549435161328968_3529584886776486611_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1cteWcQ_I8Q7kNvwHb84G2&_nc_oc=AdnBRw14p6wPTDNBzQrrisrHZG_UCZ2AFBzJ86_4f0NNn7yc459hzBPxof6SBQ-y2tE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuuf44fHyJnp2RZPooAw_-yRLfFQfJkC0FRsAd_yKAvrQ&oe=699C55BB"}, {"file_name": "Casting_Screenshot_1731263738694.png", "id": "1273579797292674", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568684_1273579803959340_2863982833097347319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2wfUWkXo3oQ7kNvwH4xQPC&_nc_oc=AdnEbktlTXXAGx0we_DQtMejXdqg7Ozu13eolBM-A43WBnS15prf3-feGePpM3IJ2C4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvxOovFcYqIyxKL5-BhfJTt-aNLoYQiZiBpnHsXlHt_7Q&oe=699C65BE"}, {"file_name": "Casting_Screenshot_1731263899894.png", "id": "1111233390576589", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974521_1111233393909922_7021881490964003905_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_6e_ke7UpoQ7kNvwHwoKEA&_nc_oc=AdkFPBjDPG6nly4onhtzCWTneHPOgkqYJuZILJEMSUxYU86cKYLWFUZa1m-PR_YwyxA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvoovY2iGsllNnTDsh_L3WEalVz8l1HO6CTeE5OzIlxgg&oe=699C66A8"}, {"file_name": "Casting_Screenshot_1731264109849.png", "id": "2544397562437353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2544397569104019_3329980150214300284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54XdLYTTXa0Q7kNvwHbXgE8&_nc_oc=AdkvU1kunNOpxVozTdIX-QBIc7PSSq_QmaXNJ_qecsIo3bBc7cwMaPs0rzLALZ9zT5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvL4ebqbOoyOZrCcd5ajTOUQ-9fYbPvxkJ_MY7KFQVwnw&oe=699C64B8"}, {"file_name": "com.oculus.vrshell-20241111-021659.png", "id": "941272651185986", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568684_941272654519319_9207263631330244128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-VkZDzW_I8Q7kNvwEr0t_c&_nc_oc=Adl_b8YNq34hUyalhabALOt4GBSOBCw5KItmPGgst8mY83x659pwkkrMqDLg16K0ysE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfutYnzSKi4h8rIhngGns3oYL5Ka1Xc4v4C6TNJ102lkHA&oe=699C3E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "2017605952086083", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196228_2017605955419416_20861878064377890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCVnmAAZSesQ7kNvwGuvjZf&_nc_oc=AdkO1hQXbyQJweuS8MxApQvmyNIRBF-vCoM8mc4sv8KDlv8nG1z901J8HKG7yEgHnV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuqSIatn2xRtQxTNkvobflXk7Vmv3A8QzcgmrwvrDXLzg&oe=699C41A1"}, "display_name": "Cube Master", "keywords": ["puzzle", "cube", "BrainTeaser", "Challenge", "Hard"], "long_description": "Think you\u2019ve got what it takes? Spoiler: No one has ever cleared all the levels! Countless players took one look at these 4-piece puzzles and thought, \"How hard could it be?\" Every single one of them underestimated  Cube Master\u2014and found themselves hopelessly hooked, if not completely outsmarted.\n\n**500+ Unique Levels:**  With over 500 meticulously crafted puzzles, each level is a new journey that will keep you challenged, entertained, and determined.\n\n**Minimal Pieces, Maximum Fun:** Each level may only use up to 4 blocks, but don't let that fool you. Some levels are quick and breezy, while others will twist your mind, leaving even the boldest players stumped!\n\n**Fun for All Players:** Designed with varying levels of difficulty. Regardless of your skill, there's a level waiting to challenge you.\n\n**Immersive Puzzle Experience:** Even a mere 4-piece puzzle can be surprisingly complex, keeping you engaged\u2014and sometimes stuck\u2014for up to half an hour on a single level!\n\nDare to think it\u2019s simple? Test your wits in Cube Master\u2014if you\u2019re ready for the ultimate puzzle challenge!\n", "short_description": "Up for a challenge? Cube Master\u2019s 4-piece puzzles look easy, but they\u2019ve left countless players hooked and stumped!\n\n500+ Unique Levels: Over 500 puzzles to keep you entertained, challenged, and determined to win.\n\nDeceptively Simple: Each puzzle uses up to 4 blocks, yet some levels will twist your mind and test your wits.\n\nFun for Everyone: With levels for all players and skill levels,  Cube Master has something for every player.\n\nReady to play? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.cn/docx/K1Hwduibmo3gPUxBUvDcMTzOnad", "developer_terms_of_service_url": null, "publisher_name": "IndieGames Studio", "support_website_url": null, "website_url": "https://kqh7q115do.feishu.cn/docx/TSEZdWyRxoTakBx9XCLcwGPXncd", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8827661537325436"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1135979502004484"}, {"status": "PUBLISHED", "id": "651776374637708"}, {"status": "PUBLISHED", "id": "1271705614595274"}, {"status": "CANCELLED", "id": "1486077652820847"}, {"status": "PUBLISHED", "id": "1265033108545687"}, {"status": "PUBLISHED", "id": "1166450235283098"}, {"status": "PUBLISHED", "id": "1358470942003371"}, {"status": "PUB
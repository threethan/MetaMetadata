bBCERY11fz0St6w1IH_g&oe=6A82E2F8"}, {"file_name": "com.oculus.vrshell-20241111-021659.png", "id": "941272651185986", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568684_941272654519319_9207263631330244128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7ryM0JEXzgQ7kNvwFIfrs1&_nc_oc=Adp_QHToYljI8qImGVKre6n9thjR9KNzQ3xyT7onQ4eCGxVkr0w5pYuaW1uTMKRQ8UU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5fzXu4TZjh_s9bBCfUDOEEXDQiiY9-sUYX9TAUfkjow&oe=6A82F501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "2017605952086083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196228_2017605955419416_20861878064377890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3gfIBOLKfIQ7kNvwF589Dz&_nc_oc=Adqg3wckRNk0swgkq4kmIPFaUyO56p1l5fXND0FRXHiek95Ks-q3MQxvE1mhMi0ms34&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3GJUmB5yqBhiDIQJoGVbTXfFXs23Fw3d2guZ9xLaz1g&oe=6A82F821"}, "display_name": "Cube Master", "keywords": ["puzzle", "cube", "BrainTeaser", "Challenge", "Hard"], "long_description": "Think you\u2019ve got what it takes? Spoiler: No one has ever cleared all the levels! Countless players took one look at these 4-piece puzzles and thought, \"How hard could it be?\" Every single one of them underestimated  Cube Master\u2014and found themselves hopelessly hooked, if not completely outsmarted.\n\n**500+ Unique Levels:**  With over 500 meticulously crafted puzzles, each level is a new journey that will keep you challenged, entertained, and determined.\n\n**Minimal Pieces, Maximum Fun:** Each level may only use up to 4 blocks, but don't let that fool you. Some levels are quick and breezy, while others will twist your mind, leaving even the boldest players stumped!\n\n**Fun for All Players:** Designed with varying levels of difficulty. Regardless of your skill, there's a level waiting to challenge you.\n\n**Immersive Puzzle Experience:** Even a mere 4-piece puzzle can be surprisingly complex, keeping you engaged\u2014and sometimes stuck\u2014for up to half an hour on a single level!\n\nDare to think it\u2019s simple? Test your wits in Cube Master\u2014if you\u2019re ready for the ultimate puzzle challenge!\n", "short_description": "Up for a challenge? Cube Master\u2019s 4-piece puzzles look easy, but they\u2019ve left countless players hooked and stumped!\n\n500+ Unique Levels: Over 500 puzzles to keep you entertained, challenged, and determined to win.\n\nDeceptively Simple: Each puzzle uses up to 4 blocks, yet some levels will twist your mind and test your wits.\n\nFun for Everyone: With levels for all players and skill levels,  Cube Master has something for every player.\n\nReady to play? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.cn/docx/K1Hwduibmo3gPUxBUvDcMTzOnad", "developer_terms_of_service_url": null, "publisher_name": "IndieGames Studio", "support_website_url": null, "website_url": "https://kqh7q115do.feishu.cn/docx/TSEZdWyRxoTakBx9XCLcwGPXncd", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8827661537325436"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "906385639056133"}, {"status": 
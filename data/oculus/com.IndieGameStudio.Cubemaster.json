71_492356837290000_885233091011069472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64QOk5lM8HUQ7kNvwH9HQs1&_nc_oc=Adoke5TRaMF5P3qbOE-yxCEuSJIlPUQVkT4TdVmBOoqU4rGvmRnWpPYoza0bsTE9Iqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP-XfpedDBRmThAiSQurlZ2nDfJuTMLVubQydFaPd7-Q&oe=6B06F8BA"}]}, "id": "1617753522469727", "locale": "en_US", "screenshots": [{"file_name": "Casting_Screenshot_1731263685267.png", "id": "549435157995635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223470_549435161328968_3529584886776486611_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfTdlNNFC2YQ7kNvwEuIZ1R&_nc_oc=AdrWzev8gEK76NL2b_vJsdXrq0A_mmoazYxrRZjYHDc0moYVDfDdOZtgBO64PDCIH94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4N1pMml41qbHfHA70dICdWXToNXJxAeirqLre1as8pA&oe=6B071A7B"}, {"file_name": "Casting_Screenshot_1731263738694.png", "id": "1273579797292674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568684_1273579803959340_2863982833097347319_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GL-pgOajgw4Q7kNvwFUgypf&_nc_oc=AdodMOWRPpzw1R-vBdZ20H-IxwaHMU_cMa3zbH8jRkYHK_tNwTdq1ZzeyLsYrvdOXgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_-_SlIk7x4qQNMJ3fomjTtfaUfIJVR9oWOyOttcu_xQ&oe=6B06F23E"}, {"file_name": "Casting_Screenshot_1731263899894.png", "id": "1111233390576589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974521_1111233393909922_7021881490964003905_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iSauKJ3lK8Q7kNvwEX-L-J&_nc_oc=AdrbpqAwo0GgwcGHpIN0AmZrWCODWJfE-EiohJ47aYX-BJuQCOLtZvljxKyfmJMgSJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk08sjf0XCsuTwnFn3JUnFHq_uBDpaUpeH110jHtIENw&oe=6B06F328"}, {"file_name": "Casting_Screenshot_1731264109849.png", "id": "2544397562437353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_2544397569104019_3329980150214300284_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q2jXdgegbEQ7kNvwHtpp81&_nc_oc=AdrJ22VlrAMkq9-tKYHtGh1a6oKOU0-sTC045wFBFra45xxQ4SAgkVFVkhqW1G7zHJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ541udQfL00JDdh11d0V8l81AaIOvLXJeW-k6hTWAZFg&oe=6B06F138"}, {"file_name": "com.oculus.vrshell-20241111-021659.png", "id": "941272651185986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568684_941272654519319_9207263631330244128_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_aKP_fukGIQ7kNvwGp2oYG&_nc_oc=AdqzFRUNkFeTPrkzqEmTHnRDOPIZbCe4pkvXYplibSCRqTPkoVVyK3qvkfCiYtreLv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKKxW8TC9dHrs6gLwgcNLEeL2vVoTzTZAZr9kVYsxelQ&oe=6B070341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "2017605952086083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196228_2017605955419416_20861878064377890_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmdfslZtbOsQ7kNvwER5hY3&_nc_oc=Adrp9G3gE-LAVaoQ6UTMS7rBfu-ccatZP6CMs7ECL92ER6IeoiUQFdwgLQ17z6CQP6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS45lDIsm5g5LmmRPSAtoNvy3wzhfglBGZuhx92ISnXrg&oe=6B070661"}, "display_name": "Cube Master", "keywords": ["puzzle", "cube", "BrainTeaser", "Challenge", "Hard"], "long_description": "Think you\u2019ve got what it takes? Spoiler: No one has ever cleared all the levels! Countless players took one look at these 4-piece puzzles and thought, \"How hard could it be?\" Every single one of them underestimated  Cube Master\u2014and found themselves hopelessly hooked, if not completely outsmarted.\n\n**500+ Unique Levels:**  With over 500 meticulously crafted puzzles, each level is a new journey that will keep you challenged, entertained, and determined.\n\n**Minimal Pieces, Maximum Fun:** Each level may only use up to 4 blocks, but don't let that fool you. Some levels are quick and breezy, while others will twist your mind, leaving even the boldest players stumped!\n\n**Fun for All Players:** Designed with varying levels of difficulty. Regardless of your skill, there's a level waiting to challenge you.\n\n**Immersive Puzzle Experience:** Even a mere 4-piece puzzle can be surprisingly complex, keeping you engaged\u2014and sometimes stuck\u2014for up to half an hour on a single level!\n\nDare to think it\u2019s simple? Test your wits in Cube Master\u2014if you\u2019re ready for the ultimate puzzle challenge!\n", "short_description": "Up for a challenge? Cube Master\u2019s 4-piece puzzles look easy, but they\u2019ve left countless players hooked and stumped!\n\n500+ Unique Levels: Over 500 puzzles to keep you entertained, challenged, and determined to win.\n\nDeceptively Simple: Each puzzle uses up to 4 blocks, yet some levels will twist your mind and test your wits.\n\nFun for Everyone: With levels for all players and skill levels,  Cube Master has something for every player.\n\nReady to play? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.cn/docx/K1Hwduibmo3gPUxBUvDcMTzOnad", "developer_terms_of_service_url": null, "publisher_name": "IndieGames Studio", "support_website_url": null, "website_url": "https://kqh7q115do.feishu.cn/docx/TSEZdWyRxoTakBx9XCLcwGPXncd", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "
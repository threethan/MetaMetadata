71_492356837290000_885233091011069472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVmRpUSvBzcQ7kNvwHRpYk5&_nc_oc=AdrRTGdXk1A2fyIE6UXWWuCfjyWa1xuDk_Vkg28PSrBqk67utB6XGWQMxcI0zInsPA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBUcwqIgn9RfDoqkSl-mtcHodqsr2Alc2VOQrFipmtlg&oe=6B0C76FA"}]}, "id": "1617753522469727", "locale": "en_US", "screenshots": [{"file_name": "Casting_Screenshot_1731263685267.png", "id": "549435157995635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223470_549435161328968_3529584886776486611_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5WAmDbs_fwQ7kNvwHyeDyB&_nc_oc=Adq5mkuUzd1xB7wjYvDKosjLvWCe5akYCdpnTzzHT3NuCRxhb1SDdk1FDUGFBVqNxHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpl9ljLY-GiTWual-kZiZxLeAAujChRcbnJ9oCJpMwNA&oe=6B0C607B"}, {"file_name": "Casting_Screenshot_1731263738694.png", "id": "1273579797292674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568684_1273579803959340_2863982833097347319_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymvH9_eClcIQ7kNvwEeBXaD&_nc_oc=AdoJDyKQeOjpqsMJuFWSWe-jqulCNm-e99v6LB_SqJ5XePjIIxGWvCA659DUKPJhnLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyXhpC3w8MXC9ZTgPqXoZuwpiCh4m-9VNZLq1uU0l4pw&oe=6B0C707E"}, {"file_name": "Casting_Screenshot_1731263899894.png", "id": "1111233390576589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974521_1111233393909922_7021881490964003905_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qoz__LSJckQ7kNvwGJDdSX&_nc_oc=AdrDH9c1xcJoGw1qr46_RurVc2bkkI9fBnMgWt5Zs9-2h8bkaFHHdBuCa3DP7U-mbLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN1WRS0KTpfvZrkEjjtlJW-r0jedZoBxgafibCKPCCEA&oe=6B0C7168"}, {"file_name": "Casting_Screenshot_1731264109849.png", "id": "2544397562437353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_2544397569104019_3329980150214300284_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HincIrxtYcQ7kNvwHbbOjq&_nc_oc=AdpCaOa-qsHsmsF57na78-ffWIiwpg_vAQT_diENg4A7Vk35JHngzK_KVbHHHsT8qAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjav8Xonh_6NpEOJ4Wr5XKEMKbrzg-rHnQA_PHYa5MRg&oe=6B0C6F78"}, {"file_name": "com.oculus.vrshell-20241111-021659.png", "id": "941272651185986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568684_941272654519319_9207263631330244128_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEmjC1zjYbkQ7kNvwHo2Ivl&_nc_oc=AdrEsdhQGQ0GRw5aSqFP6N29olw5ypWiWSiY5m3nVwDpGUE8Q3HiU4YaupKwF7E9CKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlCV2JEWLCGKyMjGSPCeaGaex_PorN432JNWrZxWJHyw&oe=6B0C8181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "2017605952086083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196228_2017605955419416_20861878064377890_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUxiBY3bynAQ7kNvwHJV8GX&_nc_oc=AdoK8lOurTuyXs0sA33DdiyQLG9v454cLJiCJdrxKBNBb0Ixrownj3XrjmA_Zn_yDa8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-79hWluwlBcfiGarOf3s9tPuifYGOxKkObTnQY4d8-Q&oe=6B0C4C61"}, "display_name": "Cube Master", "keywords": ["puzzle", "cube", "BrainTeaser", "Challenge", "Hard"], "long_description": "Think you\u2019ve got what it takes? Spoiler: No one has ever cleared all the levels! Countless players took one look at these 4-piece puzzles and thought, \"How hard could it be?\" Every single one of them underestimated  Cube Master\u2014and found themselves hopelessly hooked, if not completely outsmarted.\n\n**500+ Unique Levels:**  With over 500 meticulously crafted puzzles, each level is a new journey that will keep you challenged, entertained, and determined.\n\n**Minimal Pieces, Maximum Fun:** Each level may only use up to 4 blocks, but don't let that fool you. Some levels are quick and breezy, while others will twist your mind, leaving even the boldest players stumped!\n\n**Fun for All Players:** Designed with varying levels of difficulty. Regardless of your skill, there's a level waiting to challenge you.\n\n**Immersive Puzzle Experience:** Even a mere 4-piece puzzle can be surprisingly complex, keeping you engaged\u2014and sometimes stuck\u2014for up to half an hour on a single level!\n\nDare to think it\u2019s simple? Test your wits in Cube Master\u2014if you\u2019re ready for the ultimate puzzle challenge!\n", "short_description": "Up for a challenge? Cube Master\u2019s 4-piece puzzles look easy, but they\u2019ve left countless players hooked and stumped!\n\n500+ Unique Levels: Over 500 puzzles to keep you entertained, challenged, and determined to win.\n\nDeceptively Simple: Each puzzle uses up to 4 blocks, yet some levels will twist your mind and test your wits.\n\nFun for Everyone: With levels for all players and skill levels,  Cube Master has something for every player.\n\nReady to play? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://kqh7q115do.feishu.cn/docx/K1Hwduibmo3gPUxBUvDcMTzOnad", "developer_terms_of_service_url": null, "publisher_name": "IndieGames Studio", "support_website_url": null, "website_url": "https://kqh7q115do.feishu.cn/docx/TSEZdWyRxoTakBx9XCLcwGPXncd", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "
-25/908850587_1189229190111146_6929011253541855176_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k356tLP4sB0Q7kNvwHUmu6F&_nc_oc=AdoBVXuwGFGOrlP0pjbXHR5OMhA3vTwZ8Bte2tRst_IuaTtDE_Zy6bz0ZTSspXR6qhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXaPra_7P_QeblqvNlV2GxvEVpa5oefChOnU-PKWH6P3Q&oe=6B1050AD"}, {"file_name": "cabin.png", "id": "1430048339199723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842221_1430048342533056_7153560204489942502_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0IoP4k-ONgQ7kNvwH20ClF&_nc_oc=AdrSUeaFbcblLXrRdGaQ8u_Y-EkJHXQtp4sZX4tY5XoAC5dAGxL7gytZrvCF2rdcaRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUNYiD-OUS90pRycntDIEqwklIX66n0SGZOcRQLpt5e_g&oe=6B105F2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1795058324941120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842272_1795058331607786_2882703730986070920_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvC_lVkwkUkQ7kNvwHkjMWW&_nc_oc=AdpuKSqlH6BZCdwE28ZbLCvlz2zLCIjRDisdSWFXgFTvTRUFQEC-dvpOPmPnFKKt5vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8rYjnBX3732R-TuR_XzZsm3x-7bWKT9w6j8_XCjObAA&oe=6B106B8A"}, "display_name": "Relaxing Places", "keywords": ["relaxation", "nature", "ambience", "exploration", "landscapes"], "long_description": "Start on the sand at Saltwind Cove. Follow a wave as it breaks beside the sea arch, or turn toward the palms and see how close you can get to a ghost crab before it slips into its burrow.\n\nOpen Places whenever you want a change of scenery. Walk the shore of Alpine Mirror and watch the snowy peaks shift in the lake\u2019s reflection. Follow a creek through the old cedars of Cedar Hollow. On the terrace at Night Observatory, look up from the lanterns to find the aurora above the clouds.\n\nFor a quieter spot, listen to bees beside the farmhouse path in Lavender Fields at Sunset. At Autumn Ryokan Garden, step to the edge of the veranda and the koi gather below. Or stay by the hearth in Rainy Cabin Window and listen to the rain against the glass.\n\nUse controllers or hand tracking. Explore by teleporting or walking, choose a snap-turn angle and walking speed, and set the ambience volume to suit the place.", "short_description": "Wade into the shallows at Saltwind Cove, watch koi from a rain-soaked veranda, or pull up beside a cabin fire. Relaxing Places gives you seven quiet VR destinations to explore at your own pace, with local wildlife, spatial sound, and a choice of ways to move."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kwrona.com/quest-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Krzysztof Wrona", "support_website_url": "https://kwrona.com/about.html", "website_url": "https://kwrona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1821294908903525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842271_1464321101782268_2734677892397361905_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0FAXnhfxikQ7kNvwE4PHBy&_nc_oc=AdqSE3FvqftmPSXg9vYVEe3uPZbKY
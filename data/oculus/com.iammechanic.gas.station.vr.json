, "video_trailer_thumbnail": null, "display_name": "I Am Mechanic: Gas Station VR", "keywords": ["mechanic", "gas", "station", "repair", "fuel"], "long_description": "I Am Mechanic: Gas Station VR\n\nThe most realistic car mechanic and gas station simulator in virtual reality.\n\nEnter the world of hands-on vehicle repair, VR fuel station management, and mechanic gameplay in this ultra-immersive simulation. Fix cars, refuel vehicles, wash and service them, and run a full auto repair shop as a professional VR mechanic on Meta Quest 2 & 3.\n\n\ud83d\udee0\ufe0f What You Can Do in the Game:\n\n\ud83e\uddf0 Car Mechanic Simulator VR \u2013 Diagnose and fix engines, replace tires, change oil, repair brakes, swap batteries, and use realistic mechanic tools in a virtual garage.\n\n\u26fd Gas Station Simulator \u2013 Work as a mechanic and station operator: refuel vehicles, adjust fuel prices, assist customers, and handle service requests in a dynamic gas station.\n\n\ud83e\uddfc Car Wash VR Mode \u2013 Clean cars with hoses, foam sprayers, and handheld brushes in a satisfying and realistic car wash mechanic experience.\n\n\ud83d\udd27 Auto Repair Shop VR \u2013 Lift cars onto jacks, install new parts, perform tire balancing, align wheel systems, and complete job tickets like a real garage mechanic.\n\n\u2699\ufe0f Engine & Tire Mechanic VR \u2013 Repair engine parts, tune motors, fix exhausts, inspect car interiors, and swap flat tires with complete mechanic interaction.\n\n\ud83d\udcc8 Mechanic Tycoon VR \u2013 Build your career as a VR mechanic: earn cash, unlock better tools, upgrade your workshop, and expand your mechanic services.\n\n\ud83d\ude97 Designed for Car Fans & Mechanic Game Lovers:\nNow you're into vehicle repair simulators, car mechanic games.", "short_description": "I Am Mechanic: Gas Station VR \u2013 The best car mechanic game on Meta Quest! Service cars, fuel up vehicles, fix engines, change tires, run a gas station, operate a car wash, and manage your own auto repair shop. Full mechanic simulator, car service VR, vehicle repair game, garage management, and realistic car fixing in VR. Perfect for fans of car games, mechanic games, and auto simulators. Built for Meta Quest 2 & 3. Now get the I Am Mechanic game."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24464992479844811"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2007622109817784"}, {"status": "PUBLISHED", "id": "1422520772812356"}, {"status": "PUBLISHED", "id": "1599526151389783"}, {"status": "PUBLISHED", "id": "1138630108443551"}, {"status": "PUBLISHED", "id": "707085105758391"}]}, "baseline_offer": {"id": "1138630108443551"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "2007622109817784"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24849575581386497", "version": "1.0"}, "id": "1586327869195208", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prima
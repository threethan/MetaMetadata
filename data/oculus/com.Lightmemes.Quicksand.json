6A7DAF51"}, "display_name": "Quicksand", "keywords": ["Mech", "Shoot", "FPS", "Desert", "roguelike"], "long_description": "Quicksand is a fast-paced VR FPS roguelike that immerses you in a vast, endless desert. Take control of a powerful mech, race across sun-scorched dunes, and gather crucial upgrades to face relentless waves of enemies. Quicksand blends exhilarating mech piloting with intense FPS combat. Fight your way to the final boss and escape\u2014or be swallowed by the sands forever. Will you conquer the dunes, or will they consume you entirely?", "short_description": "Quicksand is a VR FPS roguelike set in a boundless desert. Pilot a powerful mech across sun-scorched dunes, collect upgrades, and face relentless waves of enemies in fast-paced combat."}]}, "developer_name": "Lightmemes Studio", "developer_privacy_policy_url": "https://github.com/CharminLightmemes/Quicksand/wiki/Quicksand-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Lightmemes Studio", "support_website_url": null, "website_url": "https://quicksand.my.canva.site/quicksand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9615557895130439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391878_1629175457972871_8605241197146627102_
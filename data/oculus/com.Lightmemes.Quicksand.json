60_452223151188518_8478078742349557097_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZchV4S8m6ckQ7kNvwGV7yfS&_nc_oc=AdoByTHMFkLy8grUqBgPCw8z7GQTrlO5hX0C0bA3L7eXISpaVNMp8QnQie84U-S6nog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFfBb5fCzfdezpktKwdC-d6Elfdig9G8fRq4vi5YayVw&oe=6B0C81D1"}, "display_name": "Quicksand", "keywords": ["Mech", "Shoot", "FPS", "Desert", "roguelike"], "long_description": "Quicksand is a fast-paced VR FPS roguelike that immerses you in a vast, endless desert. Take control of a powerful mech, race across sun-scorched dunes, and gather crucial upgrades to face relentless waves of enemies. Quicksand blends exhilarating mech piloting with intense FPS combat. Fight your way to the final boss and escape\u2014or be swallowed by the sands forever. Will you conquer the dunes, or will they consume you entirely?", "short_description": "Quicksand is a VR FPS roguelike set in a boundless desert. Pilot a powerful mech across sun-scorched dunes, collect upgrades, and face relentless waves of enemies in fast-paced combat."}]}, "developer_name": "Lightmemes Studio", "developer_privacy_policy_url": "https://github.com/CharminLightmemes/Quicksand/wiki/Quicksand-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Lightmemes Studio", "support_website_url": null, "website_url": "https://quicksand.my.canva.site/quicksand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH
579414_4549762878505302074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsrSKkkIxiAQ7kNvwGKYSVS&_nc_oc=AdlJ_csZ3VAvlRFG00HaFgDAPPnajVWX3yF3AlMns9vgSjA150DR5odpa9wR6Uk2MAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSePkft4TuKbbljbPqA0t_dWHsm6X6eUW-bX6Bq_L0dw&oe=6999AF77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "icon 2560x1440.png", "id": "1137679927840743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391899_1137679931174076_2847304108492654599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlr7L9V-8goQ7kNvwE1dJru&_nc_oc=AdnBp8wsq8dfUu-CxVs-7y8-ZFGEHrZQmiuOmUAU9PIksWb56cNN-iFL2sHiW3YMir8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs7IziKBpc1Huhi6EvAdDLmhHht8czJq0Su0zRbT5prow&oe=69999D36"}, "display_name": "VR Fix Supra", "keywords": ["supracondylar", "humerus", "fracture", "orthopedics", "training"], "long_description": "VR Fix is a simulator that provides an environment where you can practice your skills in reduction and pinning procedures for pedatric supracondylar humerus fractures.\nThe virtual C-Arm will provide x-ray shots to check the quality of your reduction and placement of wires.\nThe practice mode will give you score points according to the quality of your full procedure. \nAvailable in English and Spanish", "short_description": "Training module for pedatric supracondylar humerus fracture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orthopediapps.com/en/privacy-policy-vr-fix-supra", "developer_terms_of_service_url": null, "publisher_name": "Javier Narbona C\u00e1rceles", "support_website_url": null, "website_url": "https://www.orthopediapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
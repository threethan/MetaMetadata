579414_4549762878505302074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtSuqPMIl58Q7kNvwHGPutV&_nc_oc=Adm4Te2rnOqWTtLiaLbeeHHczxQYj2dDE8mCjJJRkBUQ1Cruj9uPGvOSfQoUxC0zedE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKY8O2wE3EIl5i7TQs3winaJ9hv-gPwOWr36DKHFFLfg&oe=69A2E9F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "icon 2560x1440.png", "id": "1137679927840743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391899_1137679931174076_2847304108492654599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjfloiZ1W20Q7kNvwFiYZiJ&_nc_oc=AdkIYHX6Tb5HsHdVa7_pecX3xx4nv5kbf0pfCIhupnvsrnifMtgoVK4HiQJNbolqfZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0kMV37KBYgy1NMqg5n-Hg-VRcpeOZf19B2L_4bZTiJQ&oe=69A2D7B6"}, "display_name": "VR Fix Supra", "keywords": ["supracondylar", "humerus", "fracture", "orthopedics", "training"], "long_description": "VR Fix is a simulator that provides an environment where you can practice your skills in reduction and pinning procedures for pedatric supracondylar humerus fractures.\nThe virtual C-Arm will provide x-ray shots to check the quality of your reduction and placement of wires.\nThe practice mode will give you score points according to the quality of your full procedure. \nAvailable in English and Spanish", "short_description": "Training module for pedatric supracondylar humerus fracture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orthopediapps.com/en/privacy-policy-vr-fix-supra", "developer_terms_of_service_url": null, "publisher_name": "Javier Narbona C\u00e1rceles", "support_website_url": null, "website_url": "https://www.orthopediapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
eJNtQfNll1NhIXuL97g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5BLoYJweKuR8PiXeDMAItmDFq7cypH-2tg_cSHZAt9w&oe=6AFB1DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StereoLift-Live-trailer-cover-2560x1440.png", "id": "2593592614471322", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825481_2593592621137988_244190539414191286_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpF80431dbwQ7kNvwF0Y6ZS&_nc_oc=Adok-tQiX4sNWRAZzGqpYALwS7SqJA2gKlQnscNNogq_BVs5W9hVwW3SwkYiFlC2aGA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0Fp4zwgQf87vCwiImccMausdXwQsvj_lnXidBwFNFHA&oe=6AFB2C1F"}, "display_name": "StereoLift Live", "keywords": ["3D", "video", "conversion", "streaming", "desktop"], "long_description": "StereoLift Live transforms the content on your PC into stereoscopic 3D in real time and presents it on a virtual screen in your Meta Quest headset.\n\nNavigate and control your desktop through a responsive, low-latency 2D view, then switch seamlessly to 3D when you are ready to watch. StereoLift Live brings the technology of our 3D conversion service at stereolift.com to live viewing on your own hardware without waiting for an offline conversion or storing a separate 3D video.\n\nThe StereoLift Live PC companion:\n\n- Generates depth locally on your NVIDIA GPU\n- Creates dedicated left- and right-eye views from your captured display\n- Sends encrypted 2D and 3D streams over your local network\n- Lets you switch seamlessly between interactive 2D and immersive 3D\n- Extends scene colors beyond the virtual screen with Ambient Glow\n\nStereoLift Live requires a Windows or Linux PC with a supported NVIDIA GPU (RTX 2080 or better), a compatible Meta Quest headset, and a StereoLift Live account.\n", "short_description": "Turn compatible content on your PC screen into stereoscopic 3D and watch it in Meta Quest. Control your desktop in 2D, then switch to 3D viewing. Requires the StereoLift Live PC companion and a supported NVIDIA GPU."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stereolift.live/privacy/", "developer_terms_of_service_url": "https://www.stereolift.live/terms/", "publisher_name": "StereoLift - Dr. Marvin Weigand", "support_website_url": null, "website_url": "https://stereolift.live/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28862677743356908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1853244249425504"}]}, "baseline_offer": {"id": "1853244249425504"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792882620, "status": "PUBLISHED", "id": "1853244249425504"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29293533596937985", "version": "0.1.14"}, "id": "1620276382857421", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28135362486088441", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29293533596937985"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": 
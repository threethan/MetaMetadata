ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8oqrkoOxHL420tQQZGWRRdOpO5JdrxApPtQZ6mJQtkw&oe=6A95BDE2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7l7drI8SQs4Q7kNvwGZ10ze&_nc_oc=AdofLFMsFZx_PlrSZM9C539tZTlLKn8_XH76TL1NaCScdTHuxpP45z77iFAaibxREjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGImR7U1VUtoLXMXk1BOyciiJhK8om33h6e1BwEkxIpAg&oe=6A95D4F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4YXJMktb7QQ7kNvwFXk5U4&_nc_oc=AdrRO19EcDyc3Js1f4UaLs_z4_tJwK1OeibIQVD3TXNOGCBklo4QNdeT1UNGy4ngzNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR7ClgfVrFW6Ps5q3nflbLNkwN-RFVgsE88tvwHqN1BA&oe=6A95E256"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
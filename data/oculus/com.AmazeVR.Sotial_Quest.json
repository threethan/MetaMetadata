ent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv3OQiVZdahLhRp-AyrRVBNFS5DM2OEOKuuCTx_Jv_Sw&oe=6AA16322"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCl8RoLczDYQ7kNvwHJVeMS&_nc_oc=AdrpA7Y7OXEjgKwAPmbEQmcxdEyseYAM0ZTO23mUi4ViEYgzwazpXjqlkKiA7Mmxsdk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlFv-nWJgLWU3bRr59Dbvfum_ct0vC_d0mf_qxk2fVzA&oe=6AA17A37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF6CAXRRCdIQ7kNvwFhV5-2&_nc_oc=AdrSvFYothLR_foc8SbcDMGMvFld7ukz6mc4LvWbtbTnnid5oEFEobQdrxJb8czKDzI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpFDkGAY_sXysYasrEN95b1nP9FhdmPEk9RIvH1kZh-w&oe=6AA14F56"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
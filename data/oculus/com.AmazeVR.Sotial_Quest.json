ent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v5YApR4lXiKKMDprEuonz6SCEcXUW_SNPbhQGCV8uMA&oe=6A09C6A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L823SsXfBaQQ7kNvwEyUnz5&_nc_oc=AdpGtxR262fnkG7f--X49BQDm6BagBo98yZ8VB9u0Iyc_2mJCPaEb5qY-jNAHi3cPZo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uMND0RKiVD_wyM3hf83LRXE0DB2MFHOXq7wHVn2sgig&oe=6A09DDB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhnxSV-8CygQ7kNvwEUx6Zg&_nc_oc=Adrh-kLoGoNIwd_Blvf4CSj2e8Dgc0ZEb7kyPudnOWiMR1zj-YRrStKFY4BTraYxCb4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50d2vWlWs2QT516WjXMe4ii8jImlu7OMGzKsOOPsr9PQ&oe=6A09B2D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
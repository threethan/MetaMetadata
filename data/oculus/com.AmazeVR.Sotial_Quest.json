ent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhAbv3Z8fLOSAWGKpj3V_MsYTx6gzYxhp2wWWHmCT7dg&oe=6A5E26A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw0OkG2TYAEQ7kNvwEabD0Y&_nc_oc=Adrl04zBx4RnoLZCkFUBqMV6dISvRcrJ3lq9VWCFBnZeg20FB039SW49YY8OFwqiA_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBmRj9vnmRvOm4oIV9gULNfpdLAokvRMD405XqJVRzIw&oe=6A5E0577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDzXN6HB3cQQ7kNvwGU-6DH&_nc_oc=Adom5gOm66L95SUCrNibvCkHZnnl3TBYa758TE1CtHGbilIlT1OzSK0ndQNUpjdC-t4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBma5LepKuVGBce6o4B89kOUT3ySHcK-ddysKRONuSKGg&oe=6A5E12D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
ent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcW_Ab1cmgLq1wj3QDoe-f_mEVyfaoh9dp2FQmcPnXgg&oe=6AE742A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGlHZOcjU_gQ7kNvwFq0MyV&_nc_oc=AdqmYGoWWRga8KIKm_gU5ichB3hTXjdBxDZ3LZ7JA_Y7dW3XI5tEkStSh0IOG3sqN9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Ch1FRYitV5jivL-1-fJnV0fTibj8jV1acpLje7s-dg&oe=6AE759B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2y1kSKLg4QQ7kNvwFXC4t5&_nc_oc=Adr-_7rxHnZ8c-agkSPKvh9aBBeb84Ti2aBg7TOW2-EUIDPZBA11qd7DRCBfuxUDHeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGMDvleb8JNrPQipNalwpW186Jn8LK6MvQivoWGbi1zA&oe=6AE76716"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
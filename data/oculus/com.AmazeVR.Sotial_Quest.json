ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0Ukzzji3QsOkMm3x0aeutHGe9qkU6hRrzci2OgVVMDw&oe=6ACCE4A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUiYTSoIqJkQ7kNvwGI9RZE&_nc_oc=AdpnkfTmw30Rjix3vCgiLscxunN-bkDu6RJCokU03GE0_hdPL4AenTy9urpWlXHAo44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9nlsp_7zeKxgtMF-Ug0Ia5Nlb6O2Zcs4485F-_lCtxQ&oe=6ACCFBB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdYcMajf4iUQ7kNvwGlfKJ0&_nc_oc=Ado-hvK5vSoQSuaDvPqy5MTo8CKfVrYc_JRex5YkC1UbBeWOHnoDDb5LWvMYSIUS0RQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRXjfxRspFbbFkrY9z0nFGtD5K5Yp7fINOO8PtpTleIg&oe=6ACD0916"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
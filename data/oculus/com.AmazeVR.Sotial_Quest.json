ent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq0WGoLkdyEOTvEM0S_mbrjEA2-PSlU14d5lWmWjhubQ&oe=6A9C1D22"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L04RFxR8XgQ7kNvwHFsqW9&_nc_oc=AdrezR3ERX-JugaP1XtEfB5TafaO2t7C7hIT3d_WqMrEwz44XgdbZoftc6CiJKeJegA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoc7XT6p4UBHAZHX3REg5rFE3dCkDkmJ_ro7iPYyumQg&oe=6A9C3437"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtEvRHLgoTwQ7kNvwERBd6D&_nc_oc=Adr-_TaoiX1XBs8_kRkfcl6S2enIsPPlyKQ-z4gpAogetKQHcTTe9059ldcRL0abrw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0SMt4AOEJaukxqfqiDAB2Z-qCC8RqesrWntecavNxMg&oe=6A9C4196"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
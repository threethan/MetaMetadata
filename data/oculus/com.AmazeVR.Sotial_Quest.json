ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjqA7kbCOmr0nlIL0ibaBEf4qSkWnGVcp2Vs_fpj843w&oe=6A773322"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNLejWdKDz8Q7kNvwEdvSv7&_nc_oc=Adq5dG9pkjuaUuMWzTdyp1m6Dl2hMud44j-K5lP_8ZtfaDNWKcK6g4bw5iId3PHue3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyN_FAm9rkIRunz5l255YhOZMt0WN3U04Jx1Bott3IFQ&oe=6A7711F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElJr60TiaoAQ7kNvwHzTAVs&_nc_oc=Adoqf9xu469Qg3LQaTB2fyYj_q9fV0XYLa3Nbq7uUdCwoTvG_z82aETXj7CwrUWEDO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtstxnevtkIkpXGJgMbBdgnOnT1E_8ES4OkiX1gF5O7Q&oe=6A771F56"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
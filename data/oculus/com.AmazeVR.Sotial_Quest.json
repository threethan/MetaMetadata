ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRqLnGr_bNc-dH2L0nhwaIPxvm-JyadEwENR5lcCxZkA&oe=6AB91E22"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0SKgQoticEQ7kNvwFtNdqv&_nc_oc=AdoF_w0kfK3t_zgu3_43iFQRLVUzb2wXK6pW4mTsICKcFuyZoqsJm2hFeKGIr3x3Dyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWcZ3xSH4QeeScvQmu0m-YaY391bm_mGL5I1BZ-8a2pQ&oe=6AB93537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYALh5Uz-GkQ7kNvwGXD_Ng&_nc_oc=Adrexu854f9AWxK307LCwhSisUylU1ys8vEaJxJ08aaL8V7nlhdcUNNeWAejlSoRH60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRTmIxfkN3i6mBl8TBoPWHo0s9BEzUWFMXClreAPM-4Q&oe=6AB90A56"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
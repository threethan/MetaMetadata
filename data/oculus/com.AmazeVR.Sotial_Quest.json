ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeFUN0NyR0rkga_UJoR_YUr6f7W8GEGATlN5IIQ_PkbA&oe=6A7B27A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPLkv4Ez_jcQ7kNvwFHEn6f&_nc_oc=AdoVv5fLDajrZbiin0smQggMqck_OFMUts6P-xcUKEGHUJ91qzUIGrEIPjGvnue5KgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWN2Oq-wx3w3V01PO2s256C6dydXXM7x63LEs83mQ7bw&oe=6A7B0677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYtoLSNdsJcQ7kNvwEFL_sT&_nc_oc=AdohIQqo5M-M2nqqz1CFLfTyCIOY3DTFGok2NDz8WblnllXwwtF3Nnd8hF0BOGHdJuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZhQlQ-L-OeCzON6BNi2Fqw6MCKTPaU0Chk96I1c-nNQ&oe=6A7B13D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
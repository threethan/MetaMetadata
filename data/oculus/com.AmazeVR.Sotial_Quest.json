ent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3-PFv4Ln-R3G2L8cUh4S55_KMXnX35WfobmVc3Abr_Q&oe=6A636CA2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-egbxG508RoQ7kNvwGQFTvT&_nc_oc=AdoySxjbxe0T1CXjR4YKrZiqhJGQNVJ_bVwcEGUOndNsOezON-ZBzs8_4JJprva1Qxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXMfKimVoYh6lOYLNzUn7RK0ear_j_uJjDkYxtWgmIIg&oe=6A6383B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa98SwOMbrQQ7kNvwH3XhlP&_nc_oc=Adr9OuP0yqZSDyTgtgDMdRBp9pG5WTmaBvKUOA1ZcYVOWoNvvc1DwM0SFq1TMB_z7jQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALAQzLAz1zMod-Mi5UjQ6J9PMhaMVWbw3DTflVMoHZLw&oe=6A6358D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO-gApMULzScTt8kI7pvpVNFHCQe96FsJK8u_mmY0-2A&oe=6ABBC122"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87bSzMqpFlkQ7kNvwFq5lCL&_nc_oc=AdrCrpzGvINJPrCjAiGr6QWCU3xjRoxMhSAKtGe5q0aRzaES0RsNUclYzPoX8NWRflw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpkdqfT7ba3QpH-37d-mjn9U0LtRM5dfLAhfzJhllRdg&oe=6ABBD837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKMXbMRzjPsQ7kNvwE_40wl&_nc_oc=Ado_1SNt80dzrVrkG0jlaqAxW0CUz84Gx2T-Z-HwRZnOEhUSAC_pxcDG3Q6srU6dIk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWqPpxTo6uvJr_SvDVzeYShNazygQHXRNOjdX5tJECuQ&oe=6ABBE596"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
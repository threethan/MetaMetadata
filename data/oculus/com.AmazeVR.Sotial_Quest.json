ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mjXTGM2y5vrjP9B2n8J6Q6EjEltLdgG68_UWrspEeFA&oe=6A01DDA2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3q_piEW2wkQ7kNvwG0qAh6&_nc_oc=AdrsSnmP3X3pYYhqhrWn8xfdSi6JqfkBltaTPq_gpLdcAYP4-uWY-xYxdT4eU8d2Ao0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N6w0yAqSxb7jEUYHZIEFQ1s92HYEZXJYgjHpCXn2swQ&oe=6A01F4B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6Q8symaeHYQ7kNvwGL_VCH&_nc_oc=Adp6P7tdw09UtJ19jlr8FKcScp8gii2nPmPKB41ZRvcePkyLqXOAIDXeTjMCKlvNzMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a4XIv8_RI8gh96_ES2LZgNUzDGj2lqkfJPJDfs9Ixkg&oe=6A01C9D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
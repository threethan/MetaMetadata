ent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6raBNfVIr5r7tOuDce0uKq_qZFMuDLo22KYGGwhoNyOw&oe=6A130122"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WkD34Ps-PwQ7kNvwFhqxbV&_nc_oc=AdopbSj-pLYUS8w1-hREWLxIsy3At7Tg1JXePsCGi61NiOzs4l-jhdIUPaouv1CYlZs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rh2PPzo7mwBWnZw_fLRU5o041VRZKRWsQ7aJILhCC-w&oe=6A131837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5Fsjtzcb_4Q7kNvwEdHvyq&_nc_oc=AdqB_r9q-KAzDx08_CNmBkwUhs6RYsaGjQG0KDTbbMiVjwWN2U9dUA8Epta9A2Ay8zQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HuOx9NRDlYXYikpnLOy-FPKVB_MmNjUBM7sCuP-Y3VQ&oe=6A12ED56"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
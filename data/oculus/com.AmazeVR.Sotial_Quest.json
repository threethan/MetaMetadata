ent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-PoHOfGiweWR4kLVn4G0vK72zJmbweKLFVYT5wJSQTg&oe=6A524922"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQb5v65XsMgQ7kNvwE9K0cH&_nc_oc=AdrjpMa0tcnqaX2NibT--WbEpQeOQ0A6OPRjXKY5d7T9r2qgwSFJQWCnFOv3JdQV5A8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3T37TIASKfrHua65RfD7xm04lEPDp8BxQi_01aJ1TAQ&oe=6A526037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wm2CSTRbxIsQ7kNvwED_TLn&_nc_oc=AdrNHdkMrm5qTCa00Am-UvACelV9qFswMJKjn2WyFX6_zTDNUneDDTdvMUcPfFvvg6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATvy1s702TMa3ZBWoDn-FAc_74Far_c2DmukxtgpRMjA&oe=6A523556"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
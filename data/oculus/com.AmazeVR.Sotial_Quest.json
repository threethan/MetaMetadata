ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT35QIFM4XzHdvAu1_UZR6l-98oMvQ_FHyWKen_nRFQig&oe=6AE9E5A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fkp-rQKYLpUQ7kNvwHLbpjL&_nc_oc=AdprPNNbIHb-Lvh95iDb7npZH8bVvR724UhLp3WNE_Kt_dugRFGBsy8w7xo3Mje7mEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8nYiU3r0UDEcRo4fs1JpveddoUZhTz3TfYs1Ol_Cl4g&oe=6AE9FCB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mhKTszp9TsQ7kNvwFKetog&_nc_oc=AdrpY_p4tmipqJDkooLzvxo6QEy_kqCjuA312dCkFjQ8QdashVCmcVUs4jkjkK88c1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC3nrl3cK9whCCro6pn3EgSV1b5rXYHzN-O20QFiWJNw&oe=6AEA0A16"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
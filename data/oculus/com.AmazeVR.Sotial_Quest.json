ent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-fLDJPNJFKa47Tj3r9QAeWL0JAiiPYKu-2N_fIV5LKg&oe=6ADF59A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO1XLEFLfeYQ7kNvwGGkX3-&_nc_oc=AdqAu2gfaTZfVzQQc57LMG5wu9HT1HZV_oVWDqCadkPKBXayhYM-E8PMMsG_11-ONzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8RDb4-kjUQuFj1L-4U38KAk9T3pWGH6U8e-BySGvsBA&oe=6ADF70B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNEBQ79B5RYQ7kNvwFXcg0w&_nc_oc=AdrgZvbRNUfJv31kAP9KbWI17V4peCR7HOsoGIsPV-Wg1b3NvXsR58eErFwg6DOUiQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-ThiA2wk0QgZMxPL5Dibq-QT4FgsMfYSWYf6mLTCvgw&oe=6ADF45D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
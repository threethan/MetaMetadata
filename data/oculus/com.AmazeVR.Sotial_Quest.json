eo_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbpTkFH_Ps0Q7kNvwHu4Qhu&_nc_oc=Adl-txl9WvU3w0-DOguEBN7KiQOOXB9MNKXWXZvSy7eem5cO3td2VHMJiNfM6r5v-KQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpPzCei0XUIG4ORu7H70ZBILQcns5RCiR14NvuW7NBbg&oe=69BFDED6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://about.amazevr.com/privacy-notice", "developer_terms_of_service_url": "https://www.amazevr.com/termsofservice", "publisher_name": "AmazeVR", "support_website_url": "https://amazevr.zendesk.com/hc/en-us/", "website_url": "https://www.sotia
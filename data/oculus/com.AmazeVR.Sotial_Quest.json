ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReyAGlE5j0mgSZFwFHSPy7O8o6w6OtiWQynDxZKExwhA&oe=6AF07D22"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPYDJ2cO0gcQ7kNvwF_1x6U&_nc_oc=AdpK0UbTqN--zW8g4zEPVku916Gab1k1q2Gs0KncmCZB7kfTLXo5ebqS95x2yWV5btM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTva1Dl7RUBbkOA0SsuW5f8nLkck1aNxJODb4sSeyfmqA&oe=6AF09437"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuHq6TreYCUQ7kNvwHtZnqd&_nc_oc=Adp_yLIwR6wd6SLzt562COP8uze3hUZ_MYRq-vKrA95_6KylksyBfG2t5Xu8srbUR6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDsO7Dy6Eetbnytr-1PyOkuF9_GWDCYtlw7py207LNdQ&oe=6AF0A196"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
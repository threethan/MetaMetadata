ent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtzKmBNXKle7YDS4VmUrWqOlXebs7GTdyVxPi31zx3DA&oe=6A919122"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCnK3lXsWoMQ7kNvwFWJtiA&_nc_oc=AdqOWWMroCen3Hp1ydfi3jy05l_L7uZOAIsUMuPKmSKRk8FJS1_G1amoiD-T81Be1Kk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFai5UpZkniJk-QmV28CcJqTmnXkk9JlxThwiVbSQuSbQ&oe=6A916FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3HwljtRVlEQ7kNvwFZZ7LX&_nc_oc=AdqkUxXCD5Ym57znsCIdHRLh4wTqtpcthME2n8du8luz4Km_VNj2V6W1pus0iFGcvP8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT6bLcw7Jm5zNSb5O8G9AJBsU-dq3x7ssiJve_nWoKDw&oe=6A917D56"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
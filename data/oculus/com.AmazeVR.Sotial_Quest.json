ent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4acF-AR6Rib0NOQ3SmK3eYN9zm1VsaB5s9sYPIcptz1A&oe=6A1D8D22"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdOX73YFD5MQ7kNvwH5_HfY&_nc_oc=AdqW8Vusm-44qU35dJIE21_IBn053UYjSgnGGN_rP9sdaZeRHOar9oeFv7BTuDepVj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af606mVGgwaufVQr8fUEBzr1e5m8XmSd46EG0iVM45acVw&oe=6A1DA437"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgdggjD2zNMQ7kNvwFQ_yn4&_nc_oc=Adr8KutPr7Xh0Hx63N-z1B5Ln_VJpXekG2JIo95Yy6psbSQlB_5e_njxioBlTHVa6dc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VRhGWYPZO9QUkamLuuSbaks-WKVbfWwYSStIZCHRl5Q&oe=6A1D7956"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
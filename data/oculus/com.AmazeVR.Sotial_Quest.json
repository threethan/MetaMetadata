ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0w6JWHpFWaax5x1dHtzKJemgf-FqZHpAcEaSI4o380w&oe=6AE1FCA2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUsUK5wAvKUQ7kNvwF0czLD&_nc_oc=AdoJSGKLmP2JnOK8tCcTHTLAOdI5dG9vHSOBuH9ap28zc59mbd56hLfMhlqGyoumo1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1YLy7E9FkMWKsHfGeMFN-deFwAE-FHUPpCTD0_5KP2w&oe=6AE213B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBuFBkZvInsQ7kNvwEiGJ37&_nc_oc=Adpy71Pi3o8-iFk_R5zSbZPLkdMHPEoMaC2scWjqM3og1Juzh-Fh_t6p4f0OO9TYnFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEggR7QzFef5nKzFix9Gz1AXxidbaKoXYi90gSM7su5w&oe=6AE1E8D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
ent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqFsSJq8PljQgsJJI9y8iSlwLHy7HuxqfQZbHnPBLBww&oe=6AF9B7A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbiPl6jwm9gQ7kNvwGuR7c5&_nc_oc=AdpGN9DKTgwOqwTJgPnRD4vh7fhEmeaDAMq4JQgphgCd7XqGvlX7mqvJ5q4m5K4FBvw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrZz50971v17_5vMPp9S8dyXDN9oC-sjRygzIuS8xXpA&oe=6AF9CEB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2QSWP-hVWUQ7kNvwGxKjGO&_nc_oc=Ado-4-W0t25mT_fDNVxRSINN-5lJ2HnL3kD2T-8L93UF9SOC0KcndQAiz4fypgMZc4c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb762CPNfG98D6bmkP0kGGAiQ-JDcG8of_QHBvSy5xTA&oe=6AF9DC16"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
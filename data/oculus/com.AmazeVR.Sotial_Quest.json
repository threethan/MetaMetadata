ent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G5vWD2N-O2IOEKllPz9ER9tpDW2obzES4L7hSuJ6sSA&oe=6A0C69A2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q-rcREPlxcQ7kNvwGXW8JR&_nc_oc=AdoX5lVNfmqhHdKAFbCorhKf9pNxGa282d3mIIWeyfO6prOhcnqbGYxMzEn6V54-514&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qFgo9SZ9JxAMg16Dk4fzu5DIPsUDoD6Jp9a4Mb8aFbQ&oe=6A0C80B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EkZs-T7ytkQ7kNvwH_5zVq&_nc_oc=AdroH8sOR0DfHxQGNXBzEeBp13zmJE9cA6MCgTRKvmI8TLYb_qchVfif0e76yB89QLY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JUQ5WUC2WV96wjbNMeA4_fovEtpY4sIaKMjFuZcplnA&oe=6A0C55D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
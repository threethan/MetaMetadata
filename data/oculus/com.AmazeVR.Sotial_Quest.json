ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX1GEipYP3VpefZuSjUo0vfnyeGjBDjdxhV6mo6DCh_Q&oe=6A54EC22"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngo-YpbzyiAQ7kNvwGOkC1g&_nc_oc=Adq_Lgt3wNU7Dm4iYjYg3y_gMN20a8qb77EeNlPvBXOGZyOEfGfib1xhX5JhPpn9c4I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNiDM_QQSo49cobzwiFJAg9VEzvW_zZafvGciwPiIpVA&oe=6A550337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgZp6hztT9kQ7kNvwGLzUjB&_nc_oc=Adrx1-GYbPqJ5DKWTU2AqMDDJ8sRtRC4x6HKi2urMWEaAymOa6-5hNATVyp2LsobqR4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1h9JPRKwBcIOq8Ahdbsz9ztR47pcB7zUfd6FosWKd1w&oe=6A54D856"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
ent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2Cf3Rpw2zID9ME59NQ-b5YI4RNxGCf4cjhcKk31KGPQ&oe=6A943422"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7l7drI8SQs4Q7kNvwG-UmHa&_nc_oc=Adqpe3Lz2E_-WDsGabBAIE9rm7kFbBb2UlyF_5PEY5S51HzD9PZngJHGNOVsk3s5cyk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERjxlxlsaMGEyBmNbiM2JcQJAyC3z6FybndpKSKX2Elg&oe=6A9412F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4YXJMktb7QQ7kNvwFuxt1t&_nc_oc=Adqe9iI2_gT4fh6aM8VqnnWJcVz-RFJonrkLto7DOqvlTB7_wz98jzAkVeAGBhEf9CY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnL9Zf7XyWUhMQiId3TRCXxPGthGYCIHaoWURJYzo9Aw&oe=6A942056"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
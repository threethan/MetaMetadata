ent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdgSX-NPdekTwsV6N67w52QCBJk6NKGpqYrH_O-MtSaA&oe=6A660FA2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-egbxG508RoQ7kNvwErMwI9&_nc_oc=Ado9yVR36SNvwuIG-XLTzeskDiWK2cRFwFRDZoeMaCZWeo6vyB3ABhjZGDYpK9HRx0I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0sBdc8_xZZYzewbh8OrDJYNQh1aRf0Dd2-Vc8Hx72mA&oe=6A65EE77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa98SwOMbrQQ7kNvwHY9QsA&_nc_oc=AdoPy2tp98NzFc2VuTnZx-Mpc0Btxyw2XvdT1JpG2yT4OyacgZiFu7D-EPGrnxAvNKU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBlq3wAQdYemXkXa6Qy8qhxriMDTQS2_y4sazoZ5qOaw&oe=6A65FBD6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://about.amazevr.com/privacy-notice", "developer_terms_of_service_url": "https://www.amazevr.com/termsofservice", "publisher_name": "AmazeVR", "support_website_url": "https://amazevr.zendesk.com/hc/en-us/", "website_url": "https://www.sotial.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7211517985577446"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7772188749510364", "version": "1.3.1"}, "id": "902010258107946", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7211517965577448", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7772188749510364"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "
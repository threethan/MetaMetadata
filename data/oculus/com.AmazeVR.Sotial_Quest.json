ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUGWXJq2c4OgN8e4eNDiu8OHtlnHoBfDOyzXfljrxr8A&oe=6A896FE2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xACsGEoORJYQ7kNvwGoNo-I&_nc_oc=AdrJYCgOxTnR5TwUK2927CSlb8m7dsvSN3WXo9COYjNyRtUXyVBRip6lGCW75u5p4gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKzNmhq2lp7CZWPDAaSmq7zy_wqrQoav1vyETHgQrr6Q&oe=6A8986F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29goLRAaX_IQ7kNvwHPUdD8&_nc_oc=Adrmr6wv3a_xj6qouGoJUS0UkT8Vg8MmAF74c-n0mh3bsom30GAmZh-Q9agOMH9YZss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0va2a7iHYnQ3TNYEufxGXuxhOPcuNxCuIHeBTUYZ52w&oe=6A899456"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
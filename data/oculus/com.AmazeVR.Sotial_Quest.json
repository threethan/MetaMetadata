ent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7az3CP9HT6gejkMEzS5fBGkY83hLYuKod5eDfuVx5VKg&oe=6A0F0CA2"}, {"file_name": "5.dog1.png", "id": "1159193075455803", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_1159193078789136_2594029155507028761_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q-rcREPlxcQ7kNvwHVg179&_nc_oc=Adqzad3i_7gWiFKBE5voRs6SN9X6Ap2D1v3drfb6UYfX_JmEg0odbFHt3XaaSQXnPjY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6scKDX5N15w7V4o3DURwXA5oqUZ1WIz5JUyRGI-1-QVA&oe=6A0F23B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_Sotial_Landscape.png", "id": "946248040391371", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974635_946248043724704_3567941048567794891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EkZs-T7ytkQ7kNvwEhoepZ&_nc_oc=Adp-RDyh-KrFeluOjr_aQFjIRctNKKNTE3lp0RdCj3XRb78OPUkeilClyR7mz_9_CQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61cAU19JXKl5WK4ot3Jx-eDipWAifIVREYq5xOugkQtA&oe=6A0EF8D6"}, "display_name": "Sotial", "keywords": [], "long_description": "Share and Experience the World in a New Dimension!\n\nSotial is a pioneering social media service that brings spatial video to your fingertips. From the everyday to the extraordinary, Sotial transforms your world into a captivating immersive experience.\n\nShare Your Immersive Journey: \n\u2022 Upload and Share: Capture a spatial video with an iPhone 15 Pro/Max or newer and share it with the world through Sotial.\n\nDive into Spatial Video:\n\u2022 Seamless VR Integration: Enjoy an immersive experience by watching spatial videos on your Quest VR headset.\n\u2022 Follow and Engage: Connect with friends and creators, follow their spatial video journeys, and never miss a moment in 3D.\n\nJoin Sotial today \u2013 where your world leaps into the new dimension of social media!\n\nNotes:\n\u2022 Capturing spatial videos requires an iPhone 15 Pro/Max or newer.", "short_description": "Share and E
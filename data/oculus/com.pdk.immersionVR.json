DE4C0B"}, "display_name": "immersionVR reader", "keywords": ["reading", "book", "immersion", "epub", "disability"], "long_description": "immersionVR reader provides multiple 360 degree reading environments to enable the reader to immerse themselves in the book of their choice. immersionVR reader enables hands-free reading with all controls gaze based providing an immersive reading experience. It is ideal for those who are restricted due to disability or related issues.\nimmersionVR reader takes advantage of virtual reality by providing the reader with options to enhance the reading experience including on-demand image display, dynamic table of contents, multiple reading positions, zoom controls and content linking.\nimmersionVR reader provides the ability to easily view the real world without removing the VR headset.", "short_description": "immersionVR reader is an eBook reader designed specifically for the world of Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersionVR-reader.com/privacy", "developer_terms_of_service_url": "http://www.immersionVR-reader.com/terms-of-service", "publisher_name": "immersionVR", "support_website_url": null, "website_url": "http://www.immersionVR-reader.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "UTILITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "458978375762415"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "509026282817470"}, {"status": "PUBLISHED", "id": "508638053009902"}, {"status"
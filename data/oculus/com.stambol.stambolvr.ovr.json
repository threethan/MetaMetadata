39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbp1QWwdC6cQ7kNvwGmuG1O&_nc_oc=Adp6iWYvEThHAxR49T7nmZhBPyhtPTWbp_AQZbNoGKfwEr0ibIbtC5KCjpnt95IuwFw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dV2AtYAV8f21m9GxMWYOlECoMeiE_FAMcof-R_bbDHA&oe=6A09E13D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GP-v3TA0qkIQ7kNvwHcynaM&_nc_oc=AdrmxjlKuPln4tp4II0Rv6NArfMYC9M1fK33nJadzm8Jtv0mXB5m3NDTF3NSQk9dOU4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sPORhg6j6aViYLX6OP3lV9iHTk9lKkUhIHSioTqpzrA&oe=6A09BA4E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orE3a1Gwo0AQ7kNvwH_tQXT&_nc_oc=AdqDf9mIPPjoSyOB4eIInP6GJfrnKK4UxCA-RuwDCRArj9FiiFtIb1JBxqkT-fV24eA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L8UnfkDdtVboMrFhcUq8ZwJCPhcllocXbAy1o8U8tNg&oe=6A09D8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckgZa2kI1AUQ7kNvwF7-RIU&_nc_oc=AdrOhwsdLiMv4gtZo6wtx-epq37bQnWOxJozDHqNVL25d8DMM_5W9mBD6aVlWl8mguA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b_LPdBTht8Gmeq-jaXnW5aN1SvOaU8uQwpi3_oy1kJw&oe=6A09C592"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw3Y3qT0HNgQ7kNvwHOv_gl&_nc_oc=AdpAYNqGcPOG4lcsH6kZFxbPEuGMeHcvQw4X5IJpoJd
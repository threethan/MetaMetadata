rcPH_Q5KpIKn9SU-ovYHv9lz_TFRZlM1hbWQ1xhrF91vcBGrghDAlfDo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvIlCKhoGRwT7e8iSpKvuDBzCXf_4lgjtba5Hlw2VTErw&oe=69A1827D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr08C9vEzcsQ7kNvwGBpnrx&_nc_oc=AdmQDW4Mie0R33EgZArdH5tGY2Dtsaa1d1XSMnTvSAWppxvtbr7QmeEQltW-s2uPIjE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afvpqx7tQK-iGS-DjxB5s1Ji_oe3UiyKwah8_6PgQwpFrw&oe=69A193CE"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhxuXL-sD6IQ7kNvwEV6I_E&_nc_oc=AdkW3c8IVgDN-y6bn-o78MMurNi0pQjuwqZ0v4iiMLDkIsMg6hmQcYcG6vL_5PoqcoE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvN2BkQPbKuBLBpYFNwLcTUVXmzfxHFawFEqbtME1KA5Q&oe=69A17A2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKYy-cSQUcQQ7kNvwEMRKd8&_nc_oc=Adl86IGZweN9sOolYBsVIotkVenSESPsSZ73CiyaxKqpMpuotiecEczw_VFF66O2wtg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvFRXyUGVrf0BVizgYupX-bLbJ7aAfpaSulXe9BFvu5FQ&oe=69A19F12"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWl0oku5rJsQ7kNvwH5GSfv&_nc_oc=AdkNgrFXeGVR13RtcENSMqECBsSuy0Q_H4hITERnf-Kz3b_HbsOP2PyYFJ_oAbI-vxU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsFxA8xPGHU3nyqZ43HK8nO26UzOKfNilfJdYfAYUG0Qw&oe=69A19C5E"}, "is_concept": false, "is_test"
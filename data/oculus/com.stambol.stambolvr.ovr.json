_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeeRXevhIiEQ7kNvwEuFt4Q&_nc_oc=Adnbrv1Vrk6FxBE57gTkg0gAMgKPAPbfz84vZ3gkqY5laLtlWSrwVZgbQyqVyxRX6eg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afys13p8SehJHOskXxCCfIDznP8B5-3XUY7k7S1EoCRMyQ&oe=69AABCFD"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykCWF28k8IsQ7kNvwEOmM_a&_nc_oc=AdlnyYJisQx1hkb8DrMZ_G2dNKRahduouQMxR9IYvAhjJdWdCGrWLc0Ib9v5B4fDvp8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDuiOX8cWC1_1Ddk47VE2uJAfI3a9lrlyWTcSFI2ahGQ&oe=69AACE4E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8D9Ax_RqFsQ7kNvwFFB2Q7&_nc_oc=AdlKc6sgF6o4Wyvisou9rZDLDnnRnpmRIskUsM-rogLj7ekGRotxg8EylErDAQLwS-U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZHDBx4hu0UawrHj16slfbi5tJUGqDg_bbCghvm8n0Vw&oe=69AAB4AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0sOxv95ThUQ7kNvwGj-SEn&_nc_oc=AdkfNcdr9trJJIkoHkRJB2KucMYVha13MWXqp-PpOq3XWtS5lBJmZnoePBApc9zgMKc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwF8DiA_NidvnBo8gfEhNYvin_svxGtqX8vsp_swVFCqA&oe=69AAD992"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4966vcKI6_MQ7kNvwHJ74X0&_nc_oc=Admpqpc9HGQGVf9K7wg28k-Mc3A1TPc37DQpW0-9Im0jj9R9Bu-scKi3JyRysQkdbiE&_nc_zt=3&_
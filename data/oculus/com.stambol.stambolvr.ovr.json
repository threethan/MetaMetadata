39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJZiesHto-gQ7kNvwEceHLq&_nc_oc=AdowemVsWosXYeLegShoTRJlyJNS9doUVZMPyq7X12vBzlStVHIfGD93GNcdcW_KpE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGLuHku1jT6jGg4gEUWhcmbuitxOJU6juomj_uLaeP0g&oe=6ABBDBBD"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX0er1orznQQ7kNvwE8jFuq&_nc_oc=AdpWycwZ-yK7-A4TE1cR9Qs8f_WRBRcP76wALPSFXCLVXSqvu2HCU4_8bbxCnYl_EtQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI49E_oQCU_pxKR6HbnAU3EprpUkTSf9F8hT4hJ34Q8Eg&oe=6ABBB4CE"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJTgT_2Sa0YQ7kNvwHKeNWw&_nc_oc=AdrYNik4CVvQkHGMriBBwMH52hmh8bF8zesfKnmUlMBcDmcaAo11EvW56l04h1-Qhjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR6UAB3x3TLOcO8dP9OPLii7Nd_DdzAOlHMhap7DY6XQ&oe=6ABBD36D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKPTbpgdtZ4Q7kNvwHKjclz&_nc_oc=Ado_eQ3prmWsIuxdzIFgN4fCVEW1BBxy3UEBEhX_oNC6SNhjgpouOG8uM3nc9n21IOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDiwfllSZ9tSyx_BWEKm7DdCLcXQL_Bhfg3rNPqT8mEw&oe=6ABBC012"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u0RlHaJ_gUQ7kNvwHM-mHp&_nc_oc=Adq8jDAb3OVj9w077hlOmS_5tBegZKfJ9tC_0xFZLYe
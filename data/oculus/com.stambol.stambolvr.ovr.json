jLuWZSm8Fp69DVCzmMqwYR-Kmk2w0WoA_Mgb9d0MKu4w0oZfJnmQxn14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft3Plim0Y3u_uT2s8KTSTJUOQbno8LyuDqL0iWdYP5pBw&oe=699AEAFD"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYzkWosXzdgQ7kNvwFUsRzW&_nc_oc=Adk4yskOpZPWAcTsYP_tOHvuiGChDbndGIcwk-9XgjbFFN_HoOIAbgMRTsxRpj0iBN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsJ0omqL7MLw1QhclRDakJIjXS-vkfPSaqARj6qatyXmg&oe=699AFC4E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jW0CyZ-9zmgQ7kNvwEH5XqH&_nc_oc=Admhd2XnoKUZFNCAUaOKLaPg6Hpld4196E4SqXSeU59KN8mWzfSfbZjkiZkPxyzPA6M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftoUdsp5XpOwBpq28eT-gJyiw_CQX6jVElI5v-wJACfVA&oe=699AE2AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L1XgJW28cYQ7kNvwG37NvG&_nc_oc=AdlLbiB_Jbms5ayQ9Uai5sjCNPV3BHTfpNgeDW3uHAz5lk6KTYZKWZd2ozcy7WGA7fc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvQRXfzEDoqJm2ef4HhDOFBGuVVq5yEd_dKKZfPXoUQMQ&oe=699B0792"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5gjhOAircgQ7kNvwGWOFmH&_nc_oc=AdmxKkwLZcD4bHSSHW5G4K1wt6EUdUBUyFoe2GORAISXu4zhz2l0QmASnRksaGx26Mw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvumxEMU-Fr67DLR7pMSqkONgB0p-PxzQyCjxsYkEEe8g&oe=699B04DE"}, "is_concept": false, "is_test"
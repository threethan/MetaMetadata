39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htB9-OrG0vkQ7kNvwHrwypQ&_nc_oc=Adr7xs1o3Ex94mg2E0mBTpNi2tb_MuKqDakNOY5cydrXOPhtymv5SxPQjlbYyswucBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq7VjPFhYljclPlTXgodyR6XHxOMilv1UWqBe4JEQxrQ&oe=6A60ABFD"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFQXCttvPY8Q7kNvwF2hTmB&_nc_oc=AdoIXfEcFgPz-3p2UfdoTKjqrW5GoO5Uij8EMfFfOXNRomiBU_XJcbfnu614tFbew5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqPStd3vj1oivVaWVEcqubtWooDUy5z4Ji4GVRAia5iA&oe=6A60BD4E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt4hwWsCMyUQ7kNvwGaNnVZ&_nc_oc=AdoYg9ajtChVpKoc6-sw8PBvJ3ABFoGmMOznFD75Oj_nc-9ZJe82SCEGSIemLlR-1Pk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9opIkH9A-JjJ8jTHXeMaLNxjnBXh4w0JAxT2V8gl7Zw&oe=6A60A3AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsZF2UwhGhIQ7kNvwFGMKz9&_nc_oc=AdpIa2CddeJOj6e3-CeemxASU_M2VD2MEdzOdmMIvEkCg8d9oiWsxoPz7QBVaZxX470&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfqy5Svl2iHpsPM-2UEs26Rdbc-A5r8HeM9BYUeHongg&oe=6A60C892"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TT-S7Js1iQQ7kNvwG_ya4l&_nc_oc=AdoxJNV0TW0HgCo0OIl8D0oIsCBX8fkYomM_q_Recs2
39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNUgtmfzANQQ7kNvwGCPLoH&_nc_oc=AdrWrUGnWGmjCeAQ4CvobJJuGZY2EXajqEBixiM631AYoea6rW1stXU0jtAejfgTua0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzJKlvtm4KhF72glqWxZque-3nANtefkkOVsIJGWPnMg&oe=6AAFFE3D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFP5_ZsmWk4Q7kNvwErJQ9o&_nc_oc=AdqfD7dMzgbStW0fKlZS7Yci61V831jx9MtAWckws372DD5XvzbiKIa1dxIvJWld-NA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJnrnIfXxjABNZ5zSMYyZoXJAaF_zU18lq_P3MsWi73A&oe=6AAFD74E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LXHlytPyBEQ7kNvwEiwFVb&_nc_oc=Adq2SWdehfRhcuM4kpoeW2IuBV3I6zc2U9YPtbVCGteMSgI2UBMVzPEETXxrCDH87CQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiPxSskR0YykG9ewKjZzpHEIoT_s3NABVAgR0WTBVMlg&oe=6AAFF5ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6aV2xlCB-sQ7kNvwFU8FvX&_nc_oc=AdppKm4U2wdzoT1WM4B3qbOf4kUMReNfv_J53-oWwraIjNJ3Q4IJ9eReRTLVOIdgPIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd5A4MQwC3nBmCFQLLmiTnQYZLy0ltfRGyr_kgCOffsg&oe=6AAFE292"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75guwrVdXKkQ7kNvwG98JQ5&_nc_oc=AdrUpXkUrFSumW3fECMk_-lrmVRKmRKFVafTDC5WqO6
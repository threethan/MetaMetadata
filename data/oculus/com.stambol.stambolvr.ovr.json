3YdCXirUpt9EAokEhkjrxpfrVbhuRvmxjt-_1tGlW_zMCbaAc_HGX0_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsUPzJb6ALOMQ6iOV62MlHaKpre1HEAk2_ok03ifLOSYg&oe=699EDF7D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr08C9vEzcsQ7kNvwE9zFgA&_nc_oc=AdkA2oXwwmnzemp-VtpQzL-TH5AnhQS_gJyShHdySA3NSigaOrHU-SY2WUS6p8dCHK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftZXwuBeYkaYkZp7nEFBzyn5XsnM17_QW2TUr5Zcq0Y1Q&oe=699EF0CE"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNqJYaSFsfUQ7kNvwHOCllf&_nc_oc=Adlck4gVtcVaGXrMFb-BMlYKU8DcrI1CMFQrirOmNhwb85rRXlLtQSkNOPQFxGAjihU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuD37dmYazWOIfpEill9CMLM480fabozUgHBFjMt6h2ww&oe=699ED72D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKYy-cSQUcQQ7kNvwHrB20T&_nc_oc=AdmO_fq4ai_OTB4EnwueKIQZtAwtqS3gIVDbJrbndZvD1DSiRS9o9nqHfPzz43LDBhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvMohKgbjcei_H8rY2NUmvNL-9Pzg8mV_jBXxzucOUdCA&oe=699EFC12"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWl0oku5rJsQ7kNvwFC6VqU&_nc_oc=Adka00fs7w3hYTCm1YW9KU_wcfh3rc5K0kouXjgGXHzRFeD9u0zplZfGEeGjJ1THMPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuk2jcpIfYsACnhMIbPInLyNq8GLKKXPd41HSHGM5tIbg&oe=699EF95E"}, "is_concept": false, "is_test"
Oc1v-OrPWLFwDRjOG4SQTzcRY3WBbwW05Xz4Dk004cg6QWJhPHwquhf0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvfqo8hwhK5sCaZQ3tBT_fu9abao0DexjskbYB1a6sViQ&oe=699847FD"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krWAAF-AVLMQ7kNvwE6_zOX&_nc_oc=Adno5ct5w05gj8U-4MYP7QZG1FQpwjTiL-4bCStQWAQ2HaFr6_xAnFTdNVnea07_Ajk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsyhnFO2MbRKxdvRS2rduNgxNq1vWAa2gf4lwbdMm2RJA&oe=6998594E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jW0CyZ-9zmgQ7kNvwE_ysEw&_nc_oc=AdmMv1FXAzeWeAC1Wobbox3P9VhwYehJrKk3jzhBPJq7OoDnWNm01N6J_FwQVNQ0vQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuDKXo3HrA34H07Peu6E1uSBYO60ocF3-AabQFwiSpjDg&oe=69983FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhQhqTBn1oMQ7kNvwF2XAZ8&_nc_oc=Adn59LZ5WfQE3T5ghIJx7h12d00ArrtOsCmMdftuT_mPrlgxEw7xMpexXqq4DnwdSNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfskJ1-fB1Jre2EYObslypd_9wM5axrDcMqhQdVXxShPFg&oe=69986492"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbBY5nhgaloQ7kNvwFPD56a&_nc_oc=AdllSqiozhssaeJnefZnCZMs1N2M0OJWNbTkTbVc9sWKUkmm70GicW3FIFOAMxoEIfQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuTGjvkJVpby1ybsOEWZBYH3_SrNV3gfTC5LRb00xCE2A&oe=699861DE"}, "is_concept": false, "is_test"
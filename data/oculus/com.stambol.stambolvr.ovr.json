39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYgW4zSNGY8Q7kNvwFIEazK&_nc_oc=Adqt1E3i-GntStSZ9c_RvF3A_FdvQmM9LPC2nSab4RRTy6bHGGawS9dnF46Ht2eJy-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GzdmPFpoCjfWgMjyrN3ZZr5ePcBSbjTJJG85uP0wBIw&oe=6A316E3D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T4mS8SJoxsQ7kNvwG5TFzh&_nc_oc=AdoYHGLZn_CNTwUq44UOGqWEphyj8oyrf4OFZqI_jVaUaIu3k_RwZmapgWUUkkBshfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kkyZwn8kTI52y7D7n7JUHFBnOutpFa2zZJsoiMTI37Q&oe=6A31474E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up7sQuZ547IQ7kNvwH6Z4Th&_nc_oc=AdqHnK32RTENHWq7FulFdVgBEvts5oD34FL9M50bIWvm36m8wCJs1GXai4XhFo0sgiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FgJSLTUN9gve4tVLGLGUdzhHgBcnvDAp-8CWfhtEJ1w&oe=6A3165ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6QgR7qGgk8Q7kNvwG_McJH&_nc_oc=AdpM3cQW6Bcy26S81XishVXEN30_chER9iPAE1gZr-x0KgVw8azPQGi6cOO8AguWImc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kUt8DkteGJO_SjLEdb9M8crTsOK65y1D2NQklFF1ojw&oe=6A315292"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxWzHRk1hI8Q7kNvwHhUSgY&_nc_oc=AdoNjp0dFgTOhALyq_8op2w6gKOD3p9OjmBGancr_7q
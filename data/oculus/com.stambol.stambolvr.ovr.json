39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dC-S7CUKe3QQ7kNvwF7eDuY&_nc_oc=AdqmtwNlS3hvfeb8MCAJ7XCPBg7abZnYXo41a1M8zXObAfH7CwUbRvYY003TxIAjsi8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74eXYeOgRVhW1tiGg9WZwDWm182HxMY8W_UNEkvtvRvQ&oe=6A1C563D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYnOZzzzeJAQ7kNvwG483_a&_nc_oc=AdrNgxd11Fsr1kBxhe7wXfaA_Q-VRq3-Ha28fsAqwDFazmYc8qsI_zCHsC-98aw2Wa4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Oi9iHEChL01KwWQOycmCq-yDn8Y0fygvHiEpdwGxmKQ&oe=6A1C2F4E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoJ9wXbwxgwQ7kNvwEwF6hZ&_nc_oc=Adrfs3nA8drtouRMUyMYun3IdL4tqj2av4jwzm54kj-3xQnnVikkSl4roM0Jeb0m1uQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RZvvE9gTvPx8n9N9GX9FO1Yywjz65CFok3G5WT1KpSA&oe=6A1C4DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qh7Zw2MR-2oQ7kNvwGHcJRo&_nc_oc=AdpkGbq8EbVvANdxkjuScNeDAyEodxcPCKf9I2j_ER9g2FXaYXeyl7kmX5Cfq0TisdQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41c4IMGi352SWeyfiETkvomm57H-6sLIjOyyQdNaOfPg&oe=6A1C3A92"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvrjtDSZxe0Q7kNvwGLyQzN&_nc_oc=Adp9Op8x-XI4iKtHHMkSyr1XoI5GjG6FrRLrCR3joq5
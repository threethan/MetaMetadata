39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU3Hsmc1Rz0Q7kNvwGJf2I2&_nc_oc=AdqrD9UARpmMhPpZe2G2zR8sUT9CIXYE7cGQOH-kx2_03bpXnje2rIjQQy5g0D7soMo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-avrlSbm_RMt8Nw_mD1Qay4lnPcS-TpIxgpsraGC8hVQ&oe=6A219C3D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJq-glwOABMQ7kNvwHLeR8e&_nc_oc=AdrWZGt1fi8chFFOI4krtXl5MxwAaDroyAH8agL2x0czmvtyru0a1S7XZ-EseIF5XCw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9njY6ioja8NlW9nHqYqdTuzIAbSby4rfjPbEci6pHNJA&oe=6A21754E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwIAf96D3YUQ7kNvwEzDJPP&_nc_oc=AdrkfVydzpAIL497sUPcmIzn7U_IjVj23FgkaeVq6LdaxsBJw_sBUXJ1zpGw8BRwuMo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lwj06gM0mjx25sowXrgdg1WbUJqIDHAuSIrJ7VPBpoQ&oe=6A2193ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8Wsr_ItP-EQ7kNvwE8Z7uj&_nc_oc=AdqSlE9p2aJGD04_tTPp1JmhlPkZlCVc63Sg8wOhGGBo6sziVhmqu75q7b3dEtiKJpA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PUiYINu_40PqKDPAD1WAvDdQhsh0q502WxbeQBG_WAQ&oe=6A218092"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n40EuAmtTvsQ7kNvwFWCG-L&_nc_oc=AdpNGM38KhF5SiBKwDEqJA3wh9IFCq-MiLwHTKfqy0y
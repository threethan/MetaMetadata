39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZTaG6oZNcUQ7kNvwEC0WKr&_nc_oc=AdrGRMgSHnt0TAS5ev8NqoCNSKVlSfYjjabbwW1s51QGqpLgL3VRo4s685RBF4IXsnA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMdua-sUGgCzj2gS23JwApm-dcsRnCFzk0uKfazqL8ZA&oe=6A9021FD"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjaEUn3UYt4Q7kNvwFIlOib&_nc_oc=AdrI-MRd8et_p7tFhlcqo8iw41V_5XXk_Qwdy5QP0dvBRmuzigZo4P_rn945rB3sSRc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvOOOA2i2IvCbLU0crytJdLV2MFsia7vBGExF0KoSHpw&oe=6A90334E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLQeMnk3miIQ7kNvwGc9hQo&_nc_oc=Adq88HHkK9BPZrdSD73RhaGv6fSGLSvu-c_LTNA3vGvAuLq6kveGnNCuOgNjFnr9NGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy27RyjpEdyqB0FswlF38Q7exxfz_huWaWbm_H0cNJyA&oe=6A9019AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YPfuglgmD0Q7kNvwFyOn5q&_nc_oc=Adqba3f2RS-mleYBUBpQGsXFonqrpEiq4B8cM8Dw3QG87arSY560l-3TwriIMKqvM-I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrkrsx_ShetVu5_Vh8YzKI0iU5MVqGMJr1LTFye2D6iA&oe=6A903E92"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bU3MbojEmQQ7kNvwHxamFX&_nc_oc=AdqRNy30eIAGgrxSVhXyZRd3gghiy5sJy7o7H_g8xDx
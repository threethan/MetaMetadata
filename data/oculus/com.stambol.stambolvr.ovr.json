39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQLChqAToPAQ7kNvwFnqlho&_nc_oc=AdpcZgGVpmbMxWitM8mFG6CxO2sUVo-rjc0lNmVyWgZGOSEQXF1xIhp6tGWA9r_yN1k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOAluNrMYNWwj-8zwHxIXr9HyguZ_mYrPw0BZB86L1Rg&oe=6A5CB77D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LRWs7sZ3P0Q7kNvwFsdqyi&_nc_oc=AdqFSdGb6QI9WXo8e-BlRQkrW2GzlVNieiY27LVy7XlqY-W-yKby-ZdDFuzFZd0qq4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNSpj3xQI2-YAtr2LDDc4UrzlEkwe9amoYytn1hqVQyg&oe=6A5CC8CE"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjnVNImnAfcQ7kNvwGQHkQp&_nc_oc=Adr-wGNZnlRhR6UCvNuUQnQ7J7KOfJYC5NSCyeh143MvUSgeoE5v99CgU-mSGCeGEbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPMN_xhsH7thifowrcglrjpbCjIi4RPkRSWJPsQvIjxg&oe=6A5CAF2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm9wEgkZmuIQ7kNvwHCl5lu&_nc_oc=AdoN5l0o5J836hsrOmT7_SS0TbMFTUqS6q3lYsPJAcQwkeMHLlbSWJrw8FDxl6GXR28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuFxKiK5CO-bA2r8ZGe6ZDfuC7ya3G3drWtlmXVVFb8Q&oe=6A5CD412"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7TITaH1SSYQ7kNvwHIrqfP&_nc_oc=Ado5Bw9PV2tkU4-ZkGiWmlCRb2P0iaKpZo7UNWxHqN2
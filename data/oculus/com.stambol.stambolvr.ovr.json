39340_1964427529049604096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut6igHdrvPgQ7kNvwFdpIZS&_nc_oc=AdpormbhzTWOrh6SUYyRR-UbyHCvSZ5p1QAC9DduWBhUPyTLyX8Qh0tm5W-c3tYTPVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBPewnDcqzsNnerP7MvjCeWh5okoBSM7v0_Z6cTBT49g&oe=6AAD5B3D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk6bO1KvnJsQ7kNvwEBURC6&_nc_oc=AdqVLt3IoVSYN7D8ufCWZ0KtJt0h6M5rmZwDg-7y-qxjwayilczIMlUn5MDsc7QTM9Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKheaRetXqVgW6gQOgVoRbl7ZLBTd0AMG7FZjRp4C4khw&oe=6AAD344E"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LXHlytPyBEQ7kNvwFbYe33&_nc_oc=AdrAAAchyMstT5ciCngU2K5_Ye5yHuhSNMlX7b3cvu_9TexNw4CkN0AYFRqfaEiE9Js&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZsyuhpMhpYKCRbBMikaMlZ0iICEwZ10pNmWmsaDGFpA&oe=6AAD52ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJgZFM7gEFoQ7kNvwFHkK0p&_nc_oc=Adom39elshSzxa5eKDzJQJx70qGw15DetbLacnbrwoMkOHtMpsi11pUeFUzUzRebJUM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU3_DZFC9gVDik4aSPhlBgXiEplBcV8IGvNaj2QCk8xQ&oe=6AAD3F92"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ij0SkNh_jeYQ7kNvwHVPO6X&_nc_oc=Adp7us3Q0QF31FtIIA63x6rPWao9sSrpbSKy9vAVTnp
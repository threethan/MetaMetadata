HrzSBH9Zl0qRHJKoQllOusJ3cq242CfuP__ovjiSpoWo111aFGEhOBFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsqRXpDoJ3P6_om-M8_PDlFKRP5UyOY_ly8IjqCupxzqA&oe=699C3C7D"}, {"file_name": "migrated_image.png", "id": "155536668958158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602254_981209695335339_405214895768862720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYzkWosXzdgQ7kNvwGKlL1M&_nc_oc=AdmRv2nhncNX6b7FmQO2ktfB4FJV2fI2AAUOpko5A4pbPAMpVELzOQbLNq1tppglFSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsJoe__wi-HScAqtvZolPBob8YO9Ym-3ddl4Lq1zm8YJQ&oe=699C4DCE"}, {"file_name": "migrated_image.png", "id": "773160073210997", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331117_1678828605762308_786336601260163072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNqJYaSFsfUQ7kNvwEguu_g&_nc_oc=Adm5W-Gwq8hOSgncI60EFegtiT5ICwKXeRSNIwlHphQH-Lyk1uK2vkgIW5k9Co4APXc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZvrsQ47w9h_z3FZ5RWZfw-QM22rHUd3B-f0dMzJzbLQ&oe=699C342D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "1388524317865214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602285_1388524321198547_272213987838394368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L1XgJW28cYQ7kNvwEQyYgg&_nc_oc=AdlTMsMzAS1ywUJQ9If5zvvK5PJVQv1SUkjB1ausnr6wlxPx0Oa426S04pmbal6jZmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftyxiFH9t_Kf2auw32dnHTAxDMlkOXvZZzz2RQEYQLVaw&oe=699C5912"}, "display_name": "Stambol VR", "keywords": ["architecture", "realistic", "interior", "design", "walkthrough"], "long_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. Stambol immerses real estate buyers in their dream home before even a single brick is laid.\n\nThis realistic loft you'll view is completely made in CG and has not been built in real life yet. Look up, down, left, right. Change your point of view or customize your home by looking at the little icons. \n\n5 Reasons to choose VR to present real estate and architecture:\n \n1. Immersive\n2. Modeling Costs Reduced\n3. Available Anytime, Anywhere\n4. Sell More and Faster\n5. Adopt Early and Get There First\n\nDid you know you can have open houses 24/7 with Stambol Studios' Virtual Reality solutions for Real Estate Marketing & Sales?\n\nVisit http://www.stambol.com for more information or contact us at hello@stambol.com to learn more about our VR solutions for your industry", "short_description": "Experience Stambol's photorealistic visualizations for Architecture, Real Estate Marketing and Sales in Virtual Reality. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.stambol.com/privacy", "developer_terms_of_service_url": "http://www.stambol.com/", "publisher_name": "Stambol", "support_website_url": null, "website_url": "http://www.stambol.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472678414299302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727793_1840425726190470_2940981136563634176_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5gjhOAircgQ7kNvwH_mcds&_nc_oc=AdmCR_b0rlloyXraU__B70dif66ajhVZsM4aS_HvSiO_n23r-laH5Spi14m-SeXZ4mU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftsCqZZvwT6CeHmIxCG117dh_1W_NdAAOG5ChdaDyszoQ&oe=699C565E"}, "is_concept": false, "is_test"
nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CGY4LaE_U40uWbMnkcUDtwzD_WRvzTzUWhjbDaahO_g&oe=69FC816A"}, {"file_name": "XR Anatomy - Screenshot 5.png", "id": "1395609431053072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974570_1395609434386405_1110856654319363664_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhC-wlX_HHwQ7kNvwFjxmLt&_nc_oc=AdqEAW75q27DhaO8hPLy-cAQ_vf2Dv2h-oCFs8Y797X4fWjaugnhbrNdQs81RXTELOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67AAwf9dZ7HZBaTJBKuYeZXUCIr8lfCwbkDHEfwHWEcg&oe=69FC85A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XR Anatomy - Screenshot 3.png", "id": "735343688567844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974828_735343691901177_4338889197309424732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB68pGYkRwIQ7kNvwE_OruI&_nc_oc=AdpnP4oFCQeYbiQDBFFQbNSxdsMWM1Tlk5LLvk-6OQmFIojD2ZFQvtgdu8srU5s5b64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aKu1fqGE6z5ZP9iy1IsjqLBUoxxK968pv1iZ2dQ6R-g&oe=69FC8101"}, "display_name": "XR Anatomy", "keywords": [], "long_description": "Dive into a world where learning about the human body isn't just reading from a textbook. Our interactive features let you get hands-on, allowing you to twist, turn, and zoom in on lifelike mixed reality models. It's all about getting a real feel for what's under the skin, making complex anatomy easy to understand and remember.\n\nOur 3D models aren't just thrown together; they're the result of intense dedication, crafted with precision to get every detail just right. We've poured over every source we could get our hands on\u2014top-notch books, CT, and 3D scans\u2014to make sure what you're studying is as close to the real thing as possible. It's like having a virtual cadaver at your fingertips, minus the mess.", "short_description": "Dive into a world where learning about the human body isn't just reading from a textbook. Our interactive features let you get hands-on, allowing you to twist, turn, and zoom in on lifelike mixed reality models. It's all about making complex anatomy easy to understand and remember."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xranatomy.com/privacy-policy/", "developer_terms_of_service_url": "https://xranatomy.com/terms/", "publisher_name": "XR Anatomy Ltd", "support_website_url": "https://xranatomy.com/contact-us/", "website_url": "https://xranatomy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7265284303540628"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "316890774697102"}]}, "baseline_offer": {"id": "316890774697102"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707750266, "status": "PUBLISHED", "id": "316890774697102"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7257541887648203", "version": "1.0"}, "id": "921821746147931", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7253096481426077", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7
6vaEt1VNp9j_uZNWzFg26Y9g27A0xTq9nRTYnc3KQ&oe=69C12DEA"}, {"file_name": "XR Anatomy - Screenshot 5.png", "id": "1395609431053072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974570_1395609434386405_1110856654319363664_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARwIix5P18gQ7kNvwGuhZ4v&_nc_oc=AdpN1tj19eRhD59VgIYoGyGpbDLqOIvq-_eyxjXDUiTUxqPpelKWgg-pfg43TctkHy4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxB0rh3rZZtHqE4f2O2IzDcor3rxvVK2Z-i6U22P4Svuw&oe=69C13220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XR Anatomy - Screenshot 3.png", "id": "735343688567844", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974828_735343691901177_4338889197309424732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGxKTWQkUkAQ7kNvwGsuLDw&_nc_oc=AdrvCmUOFJU8wQFgNnUuOlURrfbgQOquOKt9ZOcC4s75Dli1hc-PJlvu_fVvgM0du-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8Ky6nAZuNDbqO3BNLwCMQL9LlidlPuU2WGpP3z7sEKw&oe=69C12D81"}, "display_name": "XR Anatomy", "keywords": [], "long_description": "Dive into a world where learning about the human body isn't just reading from a textbook. Our interactive features let you get hands-on, allowing you to twist, turn, and zoom in on lifelike mixed reality models. It's all about getting a real feel for what's under the skin, making complex anatomy easy to understand and remember.\n\nOur 3D models aren't just thrown together; they're the result of intense dedication, crafted with precision to get every detail just right. We've poured over every source we could get our hands on\u2014top-notch books, CT, and 3D scans\u2014to make sure what you're studying is as close to the real thing as possible. It's like having a virtual cadaver at your fingertips, minus the mess.", "short_description": "Dive into a world where learning about the human body isn't just reading from a textbook. Our interactive features let you get hands-on, allowing you to twist, turn, and zoom in on 
EXOGHQH-0JbFlAccTudS0ZG8BJrnsUnEfMZ3uZA-g&oe=69BFDC6A"}, {"file_name": "XR Anatomy - Screenshot 5.png", "id": "1395609431053072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974570_1395609434386405_1110856654319363664_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARwIix5P18gQ7kNvwEu1xx9&_nc_oc=AdkPnX8_J5ycU5ibqCu5sajCOWnXll5LN-na-rSJjLbAVAzCMPn1FnRUYzh-fe4D2Tc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_qERIxXyuUICNqwVHOB-UHvuhwg6zb60RyFXISasQXQ&oe=69BFE0A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XR Anatomy - Screenshot 3.png", "id": "735343688567844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974828_735343691901177_4338889197309424732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iazgVsgRfQ8Q7kNvwEZC5In&_nc_oc=AdkwR4qlPISCE1SB_0Bz7lFHoC9CHuIV9ZLrnSZ_cqDnw8QEHXUJv-XULfHUZpjJJZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzndvWBE7aIUeWQCLZWawgEVda4t2e7s1wUi4f-mwoDGA&oe=69BFDC01"}, "display_name": "XR Anatomy", "keywords": [], "long_description": "Dive into a world where learning about the human body isn't just reading from a textbook. Our interactive features let you get hands-on, allowing you to twist, turn, and zoom in on lifelike mixed reality models. It's all about getting a real feel for what's under the skin, making complex anatomy easy to understand and remember.\n\nOur 3D models aren't just thrown together; they're the result of intense dedication, crafted with precision to get every detail just right. We've poured over every source we could get our hands on\u2014top-notch books, CT, and 3D scans\u2014to make sure what you're studying is as close to the real thing as possible. It's like having a virtual cadaver at your fingertips, minus the mess.", "short_description": "Dive into a world where learning about the human body isn't just reading from a textbook. Our interactive features let you get hands-on, allowing you to twist, turn, and zoom in on 
{"data": {"node": {"__typename": "Application", "id": "5997754983577827", "organization": {"id": "118627091066481", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7778145568911617"}]}, "id": "1239816683652672"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "5997754983577827"}]}, "id": "875203143507340"}]}}, "firstRevision": {"nodes": [{"application": {"id": "5997754983577827", "release_date": 1764871200, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 8}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28846052618321406"}, "id": "881616209633522"}]}}, "binary": null, "live_binary": null, "created_date": 1790935707, "id": "28939869535606380", "is_initial_release": false, "name_with_fallback": "v64", "pdp_metadata_with_fallback": {"version": 32, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "28939962525597081"}, "release_status": "RELEASED", "id": "5997754983577827"}, "id": "28939962525597081", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5997754983577827", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "634517912320521"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "HtG Group Picture October 2026 03-1 (1).png", "id": "1838851770862426", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1838851777529092_5805513534878971883_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1LQEtsQ9YgQ7kNvwEDtOc7&_nc_oc=AdqqgTPtX9m
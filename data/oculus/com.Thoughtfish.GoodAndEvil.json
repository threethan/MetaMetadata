3391952_614615914618583_9221092064796849028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF5Fyu_AuukQ7kNvwFnXD1o&_nc_oc=AdoNj3CyCLnbtSt0ZsniBK-lczEJaXfZ59upePIdgFK1UyA60nRdkQZijcyjaTsgmPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0bO-ZZJL83GyqoMpz9yVhI1J1duD1kZNSwEt4FTffs9Q&oe=69F0A081"}, {"file_name": "HtG-Screenshot6.png", "id": "670232985404716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_670232988738049_8661777643361940496_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo4DaZ68dtUQ7kNvwFczJZ_&_nc_oc=AdpUYZvqfgm6Z3v2sYne0bJVbHu06BDfs3mSss8zAjgQojAlW_G4fikPlEFYiyWh444&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2dAK019x3HSxypgd6yCss1Mdb884H93nd5zYQwfW8Pgw&oe=69F0C17D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_HowToGod_01.png", "id": "503564596107827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391899_503564599441160_3410755731160239682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciSjmdur7d4Q7kNvwGY2P0m&_nc_oc=Adr31lYsHty1FtQclDQlHTiXu81PHi-70GZgZkeqjWFZkM0zY7jUoV4OQtY4XyFds6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Wat1f9dCMSL3k7LGHK4yWoefUhjRw4I2PeSso2xPUNg&oe=69F09C2F"}, "display_name": "How to God", "keywords": ["sandbox", "creatures", "godsim", "crafting", "explore"], "long_description": "Will you become a wise and benevolent leader, or wreak havoc as a vengeful deity? \nWill you instill fear in your villagers, or reward them with praise? \n\nIn How to God, a sandbox God Simulation game, you alone choose how to mold your world. Command your own armies, conduct miracles, build upon civilizations, and make the choice between good and evil. \n\n\ud83d\udd28 Upgrade your God powers\n\u2694\ufe0f Battle against rival gods\n\ud83d\udc67 Guide your villagers\n\ud83d\udcdc Complete story quests\n\u2753 And more revealed soon\u2026\n\nWhat Kind of God Will You Be?", "short_description": "How to God is a God Simulation game that grants you the freedom to shape your villages, choose your alignment, and mold the world in ways only a true god could imagine. How to God combines creative, open sandbox elements with all the classic features from your favorite God Simulation games. Coming soon to Meta Quest 2, 3, and 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thoughtfish.de/htg-privacy-policy/", "developer_terms_of_service_url": "https://www.thoughtfish.de/htg-terms-of-service/", "publisher_name": "Thoughtfish GmbH", "support_website_url": null, "website_url": "https://www.thoughtfish.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "de", "de_CH", "fr_BE", "fr_CA", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9482929661726991"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1216935843969370"}, {"status": "PUBLISHED", "id": "25048857934742999"}, {"status": "PUBLISHED", "id": "1551077269214189"}, {"status": "PUBLISHED", "id": "789601640385453"}, {"status": "PUBLISHED", "id": "23969529562705662"}, {"status": "PUBLISHED", "id": "980141234053248"}]}, "baseline_offer": {"id": "25048857934742999"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1216935843969370"}]}, "liveChannel": {"nodes": [{"latest_s
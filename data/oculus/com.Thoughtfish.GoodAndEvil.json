95327_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaPgesgGzZMQ7kNvwGDd9VZ&_nc_oc=Adq_BpnHfk0hB81Ndp3m4Q0VqX3WQgC_7Sv9uMRW17c0q3lmCmz6uaScLWyKG-AjMzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU364uitgBhD-tNHbT8tElUZp6MRj2CxT74iKCJ3lht6w&oe=6B104893"}, {"file_name": "HtG_Screenshot_06.png", "id": "614615911285250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391952_614615914618583_9221092064796849028_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXxXQ8lG6w8Q7kNvwHMT0_p&_nc_oc=AdrKFvd7-tkrkV-9XFbfk6DVtHH9_oYvVOyJakBKDX_u26TBo-tMxS-t2QVMYf-foVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW3lzs4vDbf77rWLEudZgvfkA_zeWyt17l4YFTKngtURw&oe=6B103FC1"}, {"file_name": "HtG-Screenshot6.png", "id": "670232985404716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_670232988738049_8661777643361940496_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hc5CSQcCAwEQ7kNvwGYKNeZ&_nc_oc=AdonzTh6pChnr5oYPfjip7-1S2dk2_oKNChwYWxkbRLHaoL08DWSrzYC-tZXZKyQ_3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU61P0aaouqGstBqRVAWRP5RJt8kDxpw69zCr7p8-wHEg&oe=6B1060BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_HowToGod_01.png", "id": "503564596107827", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391899_503564599441160_3410755731160239682_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXrSwXh80LAQ7kNvwEy3bfE&_nc_oc=AdoIa6t7k_p_dT5Riqb15UzDHYasumKPrK1qHhzQLxFcBENVYsF-jo9eUwNbCexOJfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFD9W9Enwyg_BT-aRLwNSLh_Z-RxRlN9MTn0mBSzhzyg&oe=6B103B6F"}, "display_name": "How to God", "keywords": ["sandbox", "creatures", "godsim", "crafting", "explore"], "long_description": "Will you become a wise and benevolent leader, or wreak havoc as a vengeful deity? \nWill you instill fear in your villagers, or reward them with praise? \n\nIn How to God, a sandbox God Simulation game, you alone choose how to mold your world. Command your own armies, conduct miracles, build upon civilizations, and make the choice between good and evil. \n\n\ud83d\udd28 Upgrade your God powers\n\u2694\ufe0f Battle against rival gods\n\ud83d\udc67 Guide your villagers\n\ud83d\udcdc Complete story quests\n\u2753 And more revealed soon\u2026\n\nWhat Kind of God Will You Be?", "short_description": "How to God is a God Simulation game that grants you the freedom to shape your villages, choose your alignment, and mold the world in ways only a true god could imagine. How to God combines creative, open sandbox elements with all the classic features from your favorite God Simulation games. Coming soon to Meta Quest 2, 3, and 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thoughtfish.de/htg-privacy-policy/", "developer_terms_of_service_url": "https://www.thoughtfish.de/htg-terms-of-service/", "publisher_name": "Thoughtfish GmbH", "support_website_url": null, "website_url": "https://www.thoughtfish.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "de", "de_CH", "fr_BE", "fr_CA", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9482929661726991"}}]}, "schedule
_AQQr24uJNoNIhGsJxGH_RRb1FRUpY-tnwSS-TG-DZYuTxw&oe=6AEF4A41"}, {"file_name": "HtG-Screenshot6.png", "id": "670232985404716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_670232988738049_8661777643361940496_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfyp0jhln6EQ7kNvwGlNBVF&_nc_oc=AdpDmDV4RRujtbOZyXd3AZWHVsp9R3tZBJ7l-YoFtIRi7peONZwDd5bHt-KiG8UTct0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNe91DFUmWNLV9zdKnpujBtH7dbWFZTz3sibB6sZBwZg&oe=6AEF32FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_HowToGod_01.png", "id": "503564596107827", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391899_503564599441160_3410755731160239682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtvGjTn3HMEQ7kNvwFMUCgp&_nc_oc=AdpCtNvGCuZGVz3N75bD8NfybHJ0iNJO2dMP9gukQLQX4OYK8SChQEO6vbCOqZ0BslE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxy9ZQeW2626UEYVhDvoEZk-SI_n9dwR2IYvefphPOFA&oe=6AEF45EF"}, "display_name": "How to God", "keywords": ["sandbox", "creatures", "godsim", "crafting", "explore"], "long_description": "Will you become a wise and benevolent leader, or wreak havoc as a vengeful deity? \nWill you instill fear in your villagers, or reward them with praise? \n\nIn How to God, a sandbox God Simulation game, you alone choose how to mold your world. Command your own armies, conduct miracles, build upon civilizations, and make the choice between good and evil. \n\n\ud83d\udd28 Upgrade your God powers\n\u2694\ufe0f Battle against rival gods\n\ud83d\udc67 Guide your villagers\n\ud83d\udcdc Complete story quests\n\u2753 And more revealed soon\u2026\n\nWhat Kind of God Will You Be?", "short_description": "How to God is a God Simulation game that grants you the freedom to shape your villages, choose your alignment, and mold the world in ways only a true god could imagine. How to God combines creative, open sandbox elements with all the classic features from your favorite God Simulation games. Coming soon to Meta Quest 2, 3, and 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thoughtfish.de/htg-privacy-policy/", "developer_terms_of_service_url": "https://www.thoughtfish.de/htg-terms-of-service/", "publisher_name": "Thoughtfish GmbH", "support_website_url": null, "website_url": "https://www.thoughtfish.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "de", "de_CH", "fr_BE", "fr_CA", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9482929661726991"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1438499671703317"}, {"status": "PUBLISHED", "id": "2166556923929006"}, {"status": "PUBLISHED", "id": "1108478351903452"}, {"status": "PUBLISHED", "id": "1552801829689290"}, {"status": "PUBLISHED", "id": "1216935843969370"}, {"status": "PUBLISHED", "id": "25048857934742999"}, {"status": "PUBLISHED", "id": "1551077269214189"}, {"status": "PUBLISHED", "id": "789601640385453"}, {"status": "PUBLISHED", "id": "23969529562705662"}, {"status": "PUBLISHED", "id": "980141234053248"}]}, "baseline_offer": {"id": "2166556923929006"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793293200, "status": "PUBLISHED", "id": "1438499671703317"}]}, "liveChannel": {"nodes": [{"latest_supported_bina
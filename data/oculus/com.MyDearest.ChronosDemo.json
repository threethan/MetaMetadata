8cCQP6_W9XC5hf9RvWQAhaxgUtZ7GULQ57j9DAxGg&oe=69F1E9AF"}, {"file_name": "migrated_image.png", "id": "657271405099407", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982648_316758872517027_5208103800128143360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sZhSx8X7gwQ7kNvwGTUrrJ&_nc_oc=AdqbvUpJwRVXrvILwF3rKgbI3ZGaBANemDqRjJk-IZT8Lzi-GwrzVsKMoZFFlew0J08&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GndFmgnKP2Ujxr4VLLyqAZoFE_8vXiZ2WxFDPKgV5OA&oe=69F20096"}, {"file_name": "migrated_image.png", "id": "519317415684557", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982531_220086045483962_908401865325019136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbDoX5yEXiAQ7kNvwFSQ8i-&_nc_oc=AdqhJuYx2xE12XZcWCOgvSOS5WWtQ3p8-8yOJRCoXNma4DLnXWVJ1LZmxeYvZr2rG0k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0hI4O_OQb3wqPFk20pZxC0YAM2HXKvckro4_q3y-U84w&oe=69F1F347"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Zy0HSA", "id": "319522038770397", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974503_319522042103730_1108590084833148928_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnJ2gpsyKMkQ7kNvwGH7N_S&_nc_oc=AdoD3jXlkakjfvw75Vt_ofEBcJdbmXwC2mI2EQ1vnbaZ07MKdqIIJyo7jskJ0e9WTOk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dDkuUKve3DhIraCaqbIiax9V4V0e5P-W6jy0QBLmRGw&oe=69F1EBE4"}, "display_name": "TOKYO CHRONOS -Trial Demo-", "keywords": [], "long_description": "\u201cTOKYO CHRONOS\u201d is coming on March 20th, and we are getting ready to distribute the trial version! \n\n\u201cThe next Visual Novel awaits beyond the screen.\u201d\nVR Mystery Visual Novel, A story told in an immersive 360-degree world, an experience like never before\nCountless characters will come to life, right before your eyes. The story changes as you make decisions.\n\n-An empty, deserted Shibuya where time has frozen over. A mystery full of suspense, woven by 8 childhood friends trapped inside.\nA lost memory. A mysterious message, \"I am dead. Who killed me?\"\nWho is \"I\"? Why did we lose our memory? Who is the killer? \n\nFragments shattered like a broken mirror. \nWhere does the truth lie?\n\nTo kill, or not to kill \u2500 YOU decide.\n\n-Production Staff\nDirector\uff1aHaruki Kashiwakura (Motion Director of Expelled from Paradise)\nScriptwriter\uff1aKou Segawa (Mystery Writer, Konya, Kimi ni Korosareta to shitemo)\nProducer\uff1aKazuma Miki (Editor/Producer of Sword Art Online)\nCharacter Design\uff1aLAM (Illustrator)", "short_description": "\u201cTOKYO CHRONOS\u201d is coming on March 20th, and we are getting ready to distribute the trial version! \n\n\u201cThe next Visual Novel awaits beyond the screen.\u201d\nVR Mystery Visual Novel, A story told in an immersive 360-degree world. The story changes as you make decisions.\n\n-An empty, deserted Shibuya where time has frozen over. A mystery full of suspense, woven by 8 childhood friends trapped inside.\n\nA lost memory. A mysterious message, \"I am dead. Who killed me?\"\n\nTo kill, or not to kill \u2500 YOU decide."}]}, "developer_name": "MyDearest Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Sekai Project", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ADVENTURE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "493650642323490"}}]}, "scheduled_offers": {"count": 1, "n
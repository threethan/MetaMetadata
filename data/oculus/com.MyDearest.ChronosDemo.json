s://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982648_316758872517027_5208103800128143360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYMXpmJuX5MQ7kNvwFE_wAA&_nc_oc=AdkH8SBmnT_xV-gsr2bidH6hwSvOqjqcAx8gLZfP3koGRDhFeqecl2aiogSNSIRCjcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8vXRJDov34TiwfFuGEhbQN9XcFiFEbTd7u4k_W6BJig&oe=69A04396"}, {"file_name": "migrated_image.png", "id": "519317415684557", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982531_220086045483962_908401865325019136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVAjYTB2lOIQ7kNvwEUx_eW&_nc_oc=AdkgY_E6h74437z7Ui5FB2a5ExHWp1lrSssEHR0MiCqlr-y56yiZfUMF85c9FxrfggU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9cdiA36cq0_i9iXNDwQy3sYg6Jpomit_nmqmamK3B_Q&oe=69A03647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Zy0HSA", "id": "319522038770397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_319522042103730_1108590084833148928_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVf6rjjW4kkQ7kNvwF6-h7b&_nc_oc=Adl_YSFKKD_mQ5DRW0Y8pVagpJ82gWs37g7Kmzg0muEeruAKeky5omzMCn2hyrnXmtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3fNOyalMwmWXZXnC7LLlBSu1A4aRFbB07NplbN0cBJw&oe=69A02EE4"}, "display_name": "TOKYO CHRONOS -Trial Demo-", "keywords": [], "long_description": "\u201cTOKYO CHRONOS\u201d is coming on March 20th, and we are getting ready to distribute the trial version! \n\n\u201cThe next Visual Novel awaits beyond the screen.\u201d\nVR Mystery Visual Novel, A story told in an immersive 360-degree world, an experience like never before\nCountless characters will come to life, right before your eyes. The story changes as you make decisions.\n\n-An empty, deserted Shibuya where time has frozen over. A mystery full of suspense, woven by 8 childhood friends trapped inside.\nA lost memory. A mysterious message, \"I am dead. Who killed me?\"\nWho is \"I\"? Why did we lose our memory? Who is the killer? \n\nFragments shattered like a broken mirror. \nWhere does the truth lie?\n\nTo kill, or not to kill \u2500 YOU decide.\n\n-Production Staff\nDirector\uff1aHaruki Kashiwakura (Motion Director of Expelled from Paradise)\nScriptwriter\uff1aKou Segawa (Mystery Writer, Konya, Kimi ni Korosareta to shitemo)\nProducer\uff1aKazuma Miki (Editor/Producer of Sword Art Online)\nCharacter Design\uff1aLAM (Illustrator)", "short_description": "\u201cTOKYO CHRONOS\u201d is coming on March 20th, and we are getting ready to distribute the trial version! \n\n\u201cThe next Visual Novel awaits beyond the screen.\u201d\nVR Mystery Visual Novel, A story told in an immersive 360-degree world. The story changes as you make decisions.\n\n-An empty, deserted Shibuya where time has frozen over. A mystery full of suspense, woven by 8 childhood friends trapped inside.\n\nA lost memory. A mysterious message, \"I am dead. Who killed me?\"\n\nTo kill, or not to kill \u2500 YOU decide."}]}, "developer_name": "MyDearest Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Sekai Project", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ADVENTURE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "493650642323490"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1348043191987654"}]}, "baseline_offer": {"id": "1348043191987654"}, "is_approved": true, "firstOffer": {"nodes": [{"s
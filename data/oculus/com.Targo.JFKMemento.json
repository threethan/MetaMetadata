94DzB9MGxTeKChklyrTsHks4mQZIrA_nhtEkPhP7PmPndpHylenpdDEcwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK3mJWoUHOGUF3kuO4luEpVKqnBy1opxd7Ew-QeQYgkg&oe=6AABD9C3"}, {"file_name": "Left_04 E10thStreet_0000 2.png", "id": "1085984422766315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570306_1085984426099648_5861517826685563977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwMryeDXbmIQ7kNvwFpyi7f&_nc_oc=Adqqej7iowhLPee7SEj6CjC7rS5FWsKHxL_-UajOp8IOskCzjvkz3N3jExMAjfenuow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfU0znt8E47i69yb5Fl7QwLm3MXe6IzJCUHpxRkM-wUg&oe=6AAC03AE"}, {"file_name": "Left_18 StephenFagin_0000 (1) 2.png", "id": "1435938497137876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982575_1435938500471209_3984451363273342139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oNv4DknpMoQ7kNvwEG6vHS&_nc_oc=Ado0mNe32KkhKXSvXq90NBtna8wARyKcNorOafiMy-3qWfVCbD6MGXI-5eRl4jtEZd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUdgRBR177WDgDUuP8Uf0dEsRz1_ZNGHuNT9PyCPrLMQ&oe=6AAC0076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px (32-Bit PNG).png", "id": "885104619696300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540501_885104623029633_8379270054471369758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrgCGzS2J48Q7kNvwEUzp3g&_nc_oc=AdolYadVPZwA1_TnGRO9C9nu0mPeai3njzf_dC9LgfQtosq6WbVWZBd8GIvoc5GEykQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0JM1r3j9VcSNzQmCnRhIC931I0eRoSUBeJ_-8Jbik6Q&oe=6AABE6F4"}, "display_name": "JFK Memento", "keywords": [], "long_description": "'JFK Memento' is a 40-minute virtual reality documentary. This application is not a game.\n\n60 years after President Kennedy's assassination, \"JFK Memento\" chronicles the events of November 22, 1963 and the investigation that followed.\n\nAcross five chapters narrated by the last living witnesses, journalists and investigators who lived through the events, this documentary is a historically accurate record of these 48 hours that changed the world.\n\nDive into the defining moments of the investigation as archive photos and films come to life, re-mastered in 3D and re-projected onto the historic sites as they were back in 1963.\n\nProduced in collaboration with the Sixth Floor Museum in Dallas and with the support of Meta, \"JFK Memento\" is a narrative learning experience.", "short_description": "60 years after John F. Kennedy\u2019s assassination, step back in time and explore the 1963 historical events that shook the world.\n\nThis 40-minute immersive documentary takes you on a journey through the past illustrated with stunning remastered 3D archive photos and films. \n\nFrom Dealey Plaza to the Texas School Book Depository to the Police Station, step into history and discover the historic sites exactly as they were in 1963 through the eyes of witnesses."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.targostories.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TARGO", "support_website_url": null, "website_url": "https://www.targostories.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "fr_CA", "fr_BE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6910319762349700"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1481314437108806"}, {"status": "PUBL
c=AdoM_EPDPKvlXcxjEJKzT1B3gXhhSXhOA6T-AEiHVu07sSdHIqjZbPP_Bb5MQ7gtm88&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdekA96Y2Zgw7ZFX1O2qU67loC2ElDdBqfmWAmbAqF_g&oe=6AA3F0C3"}, {"file_name": "Left_04 E10thStreet_0000 2.png", "id": "1085984422766315", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57570306_1085984426099648_5861517826685563977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aEXGQFWQnEQ7kNvwGeE93d&_nc_oc=AdqcoNcd5PRwhAU6oXH1I97hdyNK0uU8wB5uOgOHngCpeYZYUS5_s2lP76cRIpEerO8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJujLfEfT0xNN9y5iNHPN_5EdZZXhNMUvxR1EO8I9wKiw&oe=6AA41AAE"}, {"file_name": "Left_18 StephenFagin_0000 (1) 2.png", "id": "1435938497137876", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982575_1435938500471209_3984451363273342139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2Ui6uRvvV4Q7kNvwERijuG&_nc_oc=AdqxaeDv3lZXdnK-75EIJ8s6hNJV4I8ZHedfkaySCpa_4KrTCKcxkZ3vE8A-m8z7V_g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo-YthkB8FiPFBQ2Xn2ih6Zl3WWjY4QYMDK_eP8TKr1g&oe=6AA41776"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px (32-Bit PNG).png", "id": "885104619696300", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75540501_885104623029633_8379270054471369758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AweQlPJaZSkQ7kNvwHNXVmi&_nc_oc=AdqQ-qIrFU9iunosFLin9M8pGVxvtyADXIE3Uc880-NAP5QwoeRJ_Th7_81Cc6NFOG8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI441lv2k2HdftHOmtTxmrU2xCYIIcGVvGVjMy8sb1WDg&oe=6AA3FDF4"}, "display_name": "JFK Memento", "keywords": [], "long_description": "'JFK Memento' is a 40-minute virtual reality documentary. This application is not a game.\n\n60 years after President Kennedy's assassination, \"JFK Memento\" chronicles the events of November 22, 1963 and the investigation that followed.\n\nAcross five chapters narrated by the last living witnesses, journalists and investigators who lived through the events, this documentary is a historically accurate record of these 48 hours that changed the world.\n\nDive into the defining moments of the investigation as archive photos and films come to life, re-mastered in 3D and re-projected onto the historic sites as they were back in 1963.\n\nProduced in collaboration with the Sixth Floor Museum in Dallas and with the support of Meta, \"JFK Memento\" is a narrative learning experience.", "short_description": "60 years after John F. Kennedy\u2019s assassination, step back in time and explore the 1963 historical events that shook the world.\n\nThis 40-minute immersive documentary takes you on a journey through the past illustrated with stunning remastered 3D archive photos and films. \n\nFrom Dealey Plaza to the Texas School Book Depository to the Police Station, step into history and discover the historic sites exactly as they were in 1963 through the eyes of witnesses."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.targostories.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TARGO", "support_website_url": null, "website_url": "https://www.targostories.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "fr_CA", "fr_BE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6910319762349700"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1481314437108806"}, {"
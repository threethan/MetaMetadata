eft_05 JeffersonBoulevard_0000 2.png", "id": "1525294334941304", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75222943_1525294338274637_5054014824171414919_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4-ah1SYXioQ7kNvwHeTjpM&_nc_oc=AdqV9qkx4WkWxQR-io2xknJgYiB4v2eYzK_6360fRSiprqeB21bu9SKdPhoA8wQOVpc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5sw4naz7k3hvrHqNBPsa7C2DeA8woRyXKL_zIsou4uA&oe=6B085B03"}, {"file_name": "Left_04 E10thStreet_0000 2.png", "id": "1085984422766315", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57570306_1085984426099648_5861517826685563977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1jN8kgu5SsQ7kNvwFPsiiW&_nc_oc=AdpZ6Z9RbhADvdjtacoy7SZJto3TiS_OO77XebJ6O0_CjxkR8o1sIT_lTwbe5y5h4i0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTYGAGX-tFBaJAaHq44r_4P2bvbyEJNH68xz3sFw8cnw&oe=6B084CAE"}, {"file_name": "Left_18 StephenFagin_0000 (1) 2.png", "id": "1435938497137876", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982575_1435938500471209_3984451363273342139_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7i2Mlgnyo4Q7kNvwFC7Tvd&_nc_oc=Adp6g0FkJyL7UXx-3ToIDHneLK2P14s4NAkWPLEN693OfvuenixPQlD2qjF0nPmwG9g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyLmxth9J35ynriNENJf35wJzUBBRCdm89Scl7Nicn1g&oe=6B084976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px (32-Bit PNG).png", "id": "885104619696300", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75540501_885104623029633_8379270054471369758_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-jPr0uamPIQ7kNvwFKivdI&_nc_oc=AdqqGUV2mp7FqKfIc5WWSy-J698qHUV0KXKIexcDYexPgrm7HhRM_v-WmasI5UKOVFk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTATFS4yECPyHTG4JTpoUT7BnJBHyUHNGsmz2nK0rZc_Q&oe=6B086834"}, "display_name": "JFK Memento", "keywords": [], "long_description": "'JFK Memento' is a 40-minute virtual reality documentary. This application is not a game.\n\n60 years after President Kennedy's assassination, \"JFK Memento\" chronicles the events of November 22, 1963 and the investigation that followed.\n\nAcross five chapters narrated by the last living witnesses, journalists and investigators who lived through the events, this documentary is a historically accurate record of these 48 hours that changed the world.\n\nDive into the defining moments of the investigation as archive photos and films come to life, re-mastered in 3D and re-projected onto the historic sites as they were back in 1963.\n\nProduced in collaboration with the Sixth Floor Museum in Dallas and with the support of Meta, \"JFK Memento\" is a narrative learning experience.", "short_description": "60 years after John F. Kennedy\u2019s assassination, step back in time and explore the 1963 historical events that shook the world.\n\nThis 40-minute immersive documentary takes you on a journey through the past illustrated with stunning remastered 3D archive photos and films. \n\nFrom Dealey Plaza to the Texas School Book Depository to the Police Station, step into history and discover the historic sites exactly as they were in 1963 through the eyes of witnesses."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.targostories.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TARGO", "support_website_url": null, "website_url": "https://www.targostories.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
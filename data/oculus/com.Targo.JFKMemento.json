xqlPTxTabknXlIWlPD-PG9tBzM1ODfpxIsM_cAdJgSjn4lFF7za5Yua3zg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EXLBFdRMPb7GD3TJp9GKdH9p9DkA4l7PmTZxvKa9h8A&oe=6A244783"}, {"file_name": "Left_04 E10thStreet_0000 2.png", "id": "1085984422766315", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570306_1085984426099648_5861517826685563977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiJJpnVTKzQQ7kNvwHpmWOe&_nc_oc=Ados89ZK2bR-Yt5TR2b5hdIlcS6trzAmA4p5m7vQu2Y85-ey2AVwZmNmvFev2SDiUuI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BPFLmFzChlEXg7FtaDDSY1S37gW22UERIAQzUstxcRg&oe=6A24392E"}, {"file_name": "Left_18 StephenFagin_0000 (1) 2.png", "id": "1435938497137876", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982575_1435938500471209_3984451363273342139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAW9gKvzzdAQ7kNvwH6Tbxx&_nc_oc=Adp1Q2x-vOAbJ8vt5Y4ttgUjLnmT3FXYJRD6trJQwtgc28Xp3RSuc1mGqd3AdgkRQiU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nRskMSCQHQ3-ooH2NgiXyyC86eAHbXfoGkce-SCetvQ&oe=6A2435F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px (32-Bit PNG).png", "id": "885104619696300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75540501_885104623029633_8379270054471369758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoejyAOnUu8Q7kNvwGy13Me&_nc_oc=AdpawjjoWz-gY25-jSco3iC-4Ql7Kno3HkRj1KlaHsLNmN8P3X6zfmr5Lwn1rHNv2_w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7d-Gqq0-M6kCMy1jbCC56Qsw5vpMqCbmKoDhnD8di3A&oe=6A241C74"}, "display_name": "JFK Memento", "keywords": [], "long_description": "'JFK Memento' is a 40-minute virtual reality documentary. This application is not a game.\n\n60 years after President Kennedy's assassination, \"JFK Memento\" chronicles the events of November 22, 1963 and the investigation that followed.\n\nAcross five chapters narrated by the last living witnesses, journalists and investigators who lived through the events, this documentary is a historically accurate record of these 48 hours that changed the world.\n\nDive into the defining moments of the investigation as archive photos and films come to life, re-mastered in 3D and re-projected onto the historic sites as they were back in 1963.\n\nProduced in collaboration with the Sixth Floor Museum in Dallas and with the support of Meta, \"JFK Memento\" is a narrative learning experience.", "short_description": "60 years after John F. Kennedy\u2019s assassination, step back in time and explore the 1963 historical events that shook the world.\n\nThis 40-minute immersive documentary takes you on a journey through the past illustrated with stunning remastered 3D archive photos and films. \n\nFrom Dealey Plaza to the Texas School Book Depository to the Police Station, step into history and discover the historic sites exactly as they were in 1963 through the eyes of witnesses."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.targostories.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TARGO", "support_website_url": null, "website_url": "https://www.targostories.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "fr_CA", "fr_BE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6910319762349700"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1481314437108806"}, {"status": "PUBL
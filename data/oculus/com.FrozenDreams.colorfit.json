42_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYADFqFy46YQ7kNvwHSJ9AN&_nc_oc=AdqYBWcvIzC3QPvW5wadJOIxf7arDHl4irOUAYkShd8yRkV7oKA0v74OqxMP3w1Byx0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuCyHg_K7e_oX4YtQ-wGRXd3q_IW1MTK37x25_QPVaIg&oe=6A8EC162"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOIQl3xHpAQQ7kNvwHAP794&_nc_oc=AdrVa5FVHMEKOBcaEbnKzU37qu6q5PWJn5IXWPnKKN0mX5vHreovR5SnWX2ATYEB8Wg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE41Q4zHkAO0vQPg-LyK2bbRnHoH59rFUhIbQKObX04OA&oe=6A8ECC9B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpDJJSsVEo8Q7kNvwFbcDQv&_nc_oc=AdqNvDLkFp8Uef0nQ4n7LyE-kxG-ilBCrids_jxddaQqLfgoqiwT-Tctvq_Wqo_C76Q&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfCE_NVWzZcbZ5ibDMupgJ7hFDHYNjsMvw-42Hazw5Lw&oe=6A8ECA83"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb6N8VkKR5EQ7kNvwFkhVEv&_nc_oc=AdoADlTuUZqceNwmHXz3TgxTvlT69KXSjXyjb8n8tGYJ5xx5AMtaSw0RLeJ6yFOanCo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvrGt4HAATnA9K0von5qXhTSXYqcJn7UlXCcCm5ughDQ&oe=6A8EEF8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpRPvKQqlIUQ7kNvwENsnCE&_nc_oc=Adr95sE91cjAE2dpXxz5jtXFS2Sjxn-O9BH4y1bvKqanV7g9mXK_kfcT-qbXP8tYKnc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIJt5RiZ_Wy7WBfm7lOu6Q0k6hv5vley_LG3pjrNA9gQ&oe=6A8EC2A1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads"
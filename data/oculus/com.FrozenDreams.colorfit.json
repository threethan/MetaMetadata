=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiNSzIGldrMQ7kNvwHluvBe&_nc_oc=AdoPZUJ1P7Eax_vh5KhXJJGX-vW0K0IG4Y0oYDhgPIpxQMqfb7sckWSqXikvJaKLkg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-kxqr-Y4yDeYrWLzgFqPx18w1dG0KyG6Yqhbyn0ucgQ&oe=6A033AA2"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9rvTY5sewIQ7kNvwF1XBuD&_nc_oc=AdrKDIGVN9O5IrCGHWwNs9bjSoqOubHILZvizyqCwnD6mUFPbnnvNqcSUcJjBaUG1Oc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SOsqD3G_V4PD2lMPWwI5KBWOE9nDa1Uzs__dyAD2PNw&oe=6A0345DB"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA8-mAbrpRIQ7kNvwF-MdTg&_nc_oc=Adrih8lmygNjHFPVsrOnoPspGj8L9lL35rQGIYHqzpoqh_RJrIDanGVyaEQph2NymTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Miln0XAgBIboKxsmzxNs57MqTfkFehfWi53NZo9cMsw&oe=6A0343C3"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBMAXu7BvoIQ7kNvwHAjFU4&_nc_oc=AdoDuQ3DUyGgPFNn5VVAOUDJvyOMmBntyUADRkyUIeP13OE3Mj1S5EsB_Fs9r7dqba0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45_87NikdTiN6CyOQPn7Qhq4biRw8fQSd212Ujyw6-Rg&oe=6A03308D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOcOEgmhdKwQ7kNvwH8yk6G&_nc_oc=AdomZleBgLT24xxGOshWsCPztQ7Oo37v5GUW3Hcm_ktrTMvZMwb0Gucsingl5s8GR8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gbBoPBKEe2YS61Rz6W0HfH16mdll9TQKRm5wsZAg6_Q&oe=6A033BE1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
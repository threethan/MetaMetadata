=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E762uKn1gugQ7kNvwG6cHHy&_nc_oc=AdoJXcZeU4vkzfWAxCjyK4oYgnn5vgcIGculz7aPXa-UfKoMtV4GQFtuTZKCRD2SoZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGuK1cxqRiGaKJtYXe5j7FC9TCoJQzS2mpSEpgnLw0Ng&oe=6A7B3322"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4kJIXjmcq0Q7kNvwGT93Sl&_nc_oc=AdqI-nhHlUNraggZABTEzVP_JEPZ-641GLT0K09gac_NLJZV14ELUtyTx1cDpa2JZN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDjJDAWgCi-A6G5fFzsLqt-waxCk-8IHLHMxgnONCUAg&oe=6A7B061B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhP3mFYKVykQ7kNvwE8h4Fw&_nc_oc=AdrNRhCY_7V50YR8AJlEx3RaqgHdkSkyizgzU0-39Zk9HJGpt_JFhX8YSqR-HkC-hbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqg1QvbuLDcVEjvH-s-JUOroqtDXtkKLSX84mxIIcNEw&oe=6A7B0403"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQlik1Ky_f4Q7kNvwGgg9qW&_nc_oc=AdreSh8AZ2u-_cph7pnKU16oNwx1-eERYb53GkcismSevKC8_eIXXLa7EtGwt7MV-rc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMW2rNxszIk-U1qM73Ufz7jJBEcdXJjFjXWnshzfF1hA&oe=6A7B290D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNBgl3XaoUUQ7kNvwEa-hvN&_nc_oc=AdrWTU3MXlySk1XXF94DnuSrZ7bm-JplgztwPgmC9bfsNR4VrhEOYZHIeCTPG5cCbxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUxt6Jce5AL12V1AblAwL1UFh3firMPjv90N85zvL_PQ&oe=6A7B3461"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
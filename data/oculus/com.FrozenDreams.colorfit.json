=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwetdwbybvcQ7kNvwHD4tlV&_nc_oc=AdrGXVZDYLUi78SlX0Ahlb-6aMc05qwSSRrV1nTWHM7eX8Vw2bx9i9ft0x7h7E0Re-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nSS_-uDGsbZ7PqT4sdP0IAHUtVDplM1E4dd7pu0JYRQ&oe=69E4E822"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a921vu1-rxQQ7kNvwHFI8Gr&_nc_oc=Adp3piepL5U2mrOKApKpnFei9YwcXIpE9TY8PLj3_kBGJClmmJbssUn5lkW5z5dU7jM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YB8e8j6_ooagX86xqzhs1QMKIaEjytaT0FeqHpLtR3Q&oe=69E4BB1B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z09MReOiXYQ7kNvwFAIEXl&_nc_oc=AdrXfTW56O4-N3BKNaNKbmcXifI8hX_Yd6yXLbTpYG9VCxFoAGL4ua8LJGFv6OBIqUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UbvmJCA8lmMt0LOsd-teSpQVl2AxmT0zTWqcfjmhh4w&oe=69E4B903"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxW8n-Lm9ZIQ7kNvwGQXL5E&_nc_oc=AdqoPYq8ipMpjUqxLthCU8h57UN6ccl8NhF9io2fyXr8qou0Ven4uwj-w3ZIKe1UY9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gfvpZIPHDpmoCi-ZLDyF8xIPiqzudnepvowsfsSbJyQ&oe=69E4DE0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paNPCttRhOEQ7kNvwHNPL0c&_nc_oc=AdqLPvfGU4nJRIoP3Uw-_qxBKiNDsofxIKOm26O4jAA2YILxPXCsrgj6XcoqUi1R0Mc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pKe62J639yDXmG_pZIagegw6sEVXSYSJx9-bKoF6QWA&oe=69E4E961"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
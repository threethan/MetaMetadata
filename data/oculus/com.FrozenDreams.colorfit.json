=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfx5l8OJeusQ7kNvwEASh0g&_nc_oc=Adqk4mLP7Up1Dbq9DwgW-Lavvygnu5DNb2n3wZWA6axcMhP40yA14-xq8gt4MQkrTtQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g5fF325EeUYzTiZC4PR88HiHiQiUdL2lsUu7uGzaiMw&oe=6A4525A2"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtX9-we25VYQ7kNvwFhVqAQ&_nc_oc=AdqXcD-9HZkoauMT4uCYQLcT6g6ZIYwRjIXs2uKi6PeTaggNO8g7gKx87afAONcEO5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zE8alI-rsm_gtlSNIz_8eQBB373YvLWBzmhGUczbi0Q&oe=6A4530DB"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o_py3_M73cQ7kNvwE2T7tm&_nc_oc=Adrd7NWfFh-JcB_ME0fFa69rs9tX1W6GFSsi-X0Y2WyfzvgZ-X70IBTl9-dyBU3M5do&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HmqMpwRaLxSh6zxVfs3q_Q08fkyMJevBDcitbnKpczQ&oe=6A452EC3"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBFueAzOLdkQ7kNvwEWvc8n&_nc_oc=AdqsV82SGBUjxLoz8yJLxVIAy_E1ihQrk5jE2aXcpdJcvxw1UmnZozNiLhonvEIVCS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FrStrPzz0rKkoV5GWH7O4qNe0g_OODsM5mYqvdh0eTA&oe=6A451B8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H0JTtpQwMYQ7kNvwHqs3WM&_nc_oc=Adpkai3qr7Sq6Xpdoy94WvGy5v9CN7ZMXCHuhGJKbU69LLPbn2VSZGYdwdhLe0mXf-o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gQtHMc3GIPuNXGxNO1J-ktZ3OlIGWvwvv5Jm4X6rBiA&oe=6A4526E1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
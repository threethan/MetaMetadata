=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDz3kEl15PAQ7kNvwFn2cC3&_nc_oc=AdpzhE02cPHMSjk1dcAKPWol7x0pxmei11uZRafI9stf-4m8rInJH1crNPf5o_9RUyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2Kq4E4NArSjh4zb6hm9R4nIuFztTLlvgdPMXKNIwAXg&oe=6A897B62"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTSHNAw26ogQ7kNvwGERWbA&_nc_oc=AdpjSKF21np4TZg8l0p1U6OAIBPgbyh49O-jQGDch6uXxosAoKIy_9xnGitOvw974kg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVju-55Bow1kNHk7gXzxzX9ru4aqpvFGkInx188OadAA&oe=6A89869B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKBdvvQMkiEQ7kNvwHvfrro&_nc_oc=AdrKP0azykfSfJ1zQIsoMamNuanJpZZPCYtZqYpdUchH8RucnmCKCkUDetSb5UFE3sA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0miZImLBVhCo43_LrQBCkysNWA9rAuGnF_iIqKcFblw&oe=6A898483"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYUqpYgez6wQ7kNvwGA2PEu&_nc_oc=AdqkuY2QZZxVENvvc7NMLWz0oRpuN7AfwqSraMAJOL8MiUrIlsv2Ay2VYHZVmKoTMKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEO89J0356mMtmKL6i2vHQnn7ppW8_GRi3glwWogLwag&oe=6A89714D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1gLx-1QPO8Q7kNvwFzuGbo&_nc_oc=Adphyi_lT5gYhfYWRP5Y-Gh1kv743fqb2sBFyl04MQWR2IQ1O7BQ3jRXV52jdjP8rXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNW6alq7HbMV4ZkMFMpuz2YVDaS9sAEMh04M15g_pAmQ&oe=6A897CA1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
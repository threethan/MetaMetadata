=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89VP9N4KZqEQ7kNvwHHxib-&_nc_oc=Adpo6kT7G0RuI7OxSLwwhVkdIRdH61nMFeG37JFsUu4C1xMFThZ2n91Xinz9cRxi7cQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_woTLOjbR-YVcTWUmtq398_hN48fgxfEQherfZjjGVVQ&oe=6A300DA2"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OecJX7vZhYMQ7kNvwFQvwFV&_nc_oc=AdpwRTuCShRk892E_QEL1_xpFvhGjhYlj5KafU4Sj965MD0N4JVLNs6_ZUUPzUoj_gU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CEz2AoqtEQruezouHPihrhs6uosqsTOO9rVgYDqp6PA&oe=6A3018DB"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FrVIwxnGeYQ7kNvwFKhaqt&_nc_oc=AdryHQSv44EAbjLlyJTbwMI-5NGbx0fEzGevpr2S3M8sf43BaxFdlXSOkT1fU2v5qoM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h-VKaIBnBxpU8kXlD1qbjYb1wFEqGV0LNbi6OT0LgIg&oe=6A3016C3"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxKQRBXhVvsQ7kNvwHbi5F4&_nc_oc=AdrgduJq1MeFEerhXeC3fRxpWSBEZXhlup-ZycBJmMg6lH12KrUDwILIyZ02zIeR2Zg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kxwCn1VjifupOKXwVnBS4SsjxcM5LlOYhLYCQaLgobA&oe=6A30038D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5NsGnENC0QQ7kNvwGCvbds&_nc_oc=AdpurePugv7KshHbEJntYLphZXRCzf5Bf-LI3doD66S9PmUvRQgDqI2uKoLVkk_CSbM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C5elC40PxsbdqZ0fTiyIDU5rJvaQgQCMXWrwhzYgIpA&oe=6A300EE1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
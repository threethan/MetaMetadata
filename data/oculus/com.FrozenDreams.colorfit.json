=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVEcg99_S9YQ7kNvwHAExNG&_nc_oc=Adp3TsSD78_k6-pqRParGD24hMtIVYM1HWJIKBR-vNQLlQtr21t6mgRTQKgJA1IB8xA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V_wU9H2wRUGI9aibBRfsCaPb7t6yGPtGrwTItlryf7Q&oe=69FB51A2"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DigTicPIB3gQ7kNvwE0e4cw&_nc_oc=AdobvSBQZi1QD8n8jIIcV6ivt4VYeR7HnqRMiwyxyTdLoBG72A2x42tFmAAwzgJMPrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zfyxj1XGvbTQ95E15jEOzDAUgWaDb-FqcLVAJPUbsAw&oe=69FB5CDB"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_pP58ISPgEQ7kNvwGRBghn&_nc_oc=AdqE1cUN19S_0v8wYgw7NBwXUL2v-LPunZ6TJn4Oc_SZ-7Gp2qt8_V3HSsUn89qv_HQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yF-YyRipqpXhXVpi-tpOCEj3FoT9jXqo82EGGUeKAow&oe=69FB5AC3"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tNhbcjNjkYQ7kNvwFKoGq4&_nc_oc=AdrXrO3SUe0Hz4MKan4YQm-Soxm4cxQV5Jik-NPlhO96ikONUMqXq1bUx3VNW2Gxlyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fsyXttngb_TLehvupY3OClkuZaco7gVVqYFJasYjI6w&oe=69FB478D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkOy15avOfEQ7kNvwERrMKR&_nc_oc=AdrH1ii8_o0co4S2QAfSDjL-qs3-0CJ45VkJMW0gsrP8_jKTSwdSZRlWlBHaaqKraRU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TLRLlqvmF17s-0YSCTXnGYKgYQHXqqePBqoWYUgbBAg&oe=69FB52E1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
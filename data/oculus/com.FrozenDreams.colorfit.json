=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4ScQYi3uo4Q7kNvwFin76I&_nc_oc=AdpIdJhvvDaBlOMlUNcnyyKJcz7QEzbAdRa-m8sl_K68Uyc2RBKi_ztUUbfRx3cmutA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVCRkYAanRbt6-PwIJe6apX8vBW76D4gpaK-nJJacj3Q&oe=69CD2D22"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0QE7TbSK1QQ7kNvwEPFDdX&_nc_oc=AdoZ7KAVxWXyCLhU8IgB2Kcib7aEuJNPE4LW4HfZXV-bfEpAEkZJUX6wzOX6XL73JSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWnDuy9JGGDjEC2AqAENa4HrI_6ElIB7DKKZZlipryqQ&oe=69CD001B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cbYQubf2NUQ7kNvwHcdWRf&_nc_oc=AdpKNhICqoci_vUEygHz2pgkDUWa0nbMStnqdaNfv9-o-WMIiTItpFA61fzGT3CoJdg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyd88h7zGS0-aO4iNa0Z6lBwekgGGx9rWpNi-3ERz9e3A&oe=69CCFE03"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVH6sjAEZrgQ7kNvwGiWrIt&_nc_oc=Adq_IrZDTZbmnn9Lzs9Gos56uodVRrfysddIwYsZEYCWc-QRVJNHWqr1SAX2W6ROJD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxVayi4Hw4OArPjcDYdvoesDV3reuj6SX9lG4UjWjsyw&oe=69CD230D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPr-qTU7-PIQ7kNvwH9Z_dv&_nc_oc=AdqVBxzvIOgNye7odkyPxlNHxD2_5yPSA4kGBcr1H3QybAyF6WZYyJzIOS2Al-ox50Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzISD6vJ0tGbg6ieS-8jMQhaQRBMhG4lpkLqnKMT6rjmg&oe=69CD2E61"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
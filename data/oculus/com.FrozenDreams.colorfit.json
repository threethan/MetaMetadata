=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqhLA2_ZvfcQ7kNvwH8_K8L&_nc_oc=AdpWHl5JtGo9EXa5BINnITVidlLJVtK-2X72fhclLHkiTFotI9L5g49cA5SheO8KJbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6toljS1FExGt2xb2ArK6M472BiCyZ0FSen_Du1cMzpsQ&oe=6A048C22"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0McqIq0ae1kQ7kNvwFc4TCW&_nc_oc=Adp0Z0vfn0xC_-4u6IUZM9m-jv3dqnHprui2vJBZAsMYyaKi9RcMRkM-JcJFqj2-nCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aHiYi6gOYLhwR2mrDLqp2uH6UGXelrViN6oUIoXchVw&oe=6A04975B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLfccC6FXyUQ7kNvwH3WN8R&_nc_oc=AdqubqOu4AJL7KknAHoY6MxMXTaEan_g74jzAZ55J7yc0g-h3HFDRnYl8o0sJ2JQY6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73D_RaB9YhDr4BM1RSsDUNxz9EBtAUFLDi_lIXa6vo4w&oe=6A049543"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBMAXu7BvoIQ7kNvwFCSSiK&_nc_oc=Adr9WxtaW_LuicmHM6AZClxDXQb4AJ7hfkzCB6bXExyZwkJMqIWKIyUVa_GM9E_NNgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lsWbx3NP1H-PZE3U9iHuwDGsEmPrsNCZe1Q_o-Lr5Ww&oe=6A04820D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceTGa-elxLAQ7kNvwEK36_f&_nc_oc=AdpovfXBsmTTn2JtsNbh9CCOIar5Q8jWjYM2IgcnDKnRVRM6s7x_Q7EqTpdsQvBcCUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qCdQF6BAswPt2TPT2caNT4kl1YhzlTE1K_k6JvXwqsg&oe=6A048D61"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
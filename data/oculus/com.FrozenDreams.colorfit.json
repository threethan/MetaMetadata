=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiNSzIGldrMQ7kNvwEHUIMS&_nc_oc=Adq8MrMC435YCGNy2RCc0zhQHhruI67JBnEJoAB7wjs1aZHMLD8N5s8W6SFPzcP5yUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LpPLsFDowfl9GwVmvDq2-Yn3wvcOEWO1lJdkqhtlYKw&oe=6A01E922"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9rvTY5sewIQ7kNvwEp4fCp&_nc_oc=AdrSnhvCc_MGAQhM9-aYFLF72jqnheUJuIqpLaxtC--e3Nfx_q3FfM827zQpDayIdMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s1A0lQBcpmk9vL7vDehgyHKEtq_w3-QQylBWvXTBX3g&oe=6A01F45B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA8-mAbrpRIQ7kNvwE9i2Hv&_nc_oc=AdpRj-ywi9ZI4svTLwuHMZI9pgATdtmDLjOa533miG348Rqa-XfgilQpLXPaAqwmoRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af718oRszE0JM__Nuu5tSY7ctaLd4p5AP8KX76L6fmqRVA&oe=6A01F243"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC_7s8XjGRcQ7kNvwFHBmUA&_nc_oc=AdqMU5bBxCI42DJrwJdIBd7d4QRsGyYmaQk58eoo2PQkp56MKgaO9MvDVns0DQnorTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jjIOy8MMLoH7Vy5F5Q2rwU5QNl7EUFfxX447nzr2Ksw&oe=6A01DF0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOcOEgmhdKwQ7kNvwHjt7FE&_nc_oc=Adpapo3tKrQ8dp2SPYFPHqliW04A4IAo-fIf1rcCVHvS9jTSEVVvlPSpTqXANA5cNnc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af419zsNgeSof6V8ZoosG_t4PKXs25fHQ4QNfnGKNPeMew&oe=6A01EA61"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
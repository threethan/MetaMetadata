=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwesYy0vrz0Q7kNvwFu6z6e&_nc_oc=AdpiLyNGGvX26IAW-lZQdJovD3YI1mHSQRLAPnPaj4XRZJ_lMinmhWiMbQDa7MsE1uo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-kBqhRKnjQyoOob6xgDDEbq3lEU3-L4BR0sLpPuoKpQ&oe=69C2A122"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU8FciC9TgoQ7kNvwHrh06f&_nc_oc=AdoFNNjqzywpvlH8txHb5xvWOAeq5jSI3brr5a2e7Uxm3FYvQLA8paSZEDUbP5e-wOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGRvjagIEPrTJ4hgLlNv8nolgeWgdRyzD1Xy8o9xW2lw&oe=69C2741B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u18XZl-bwZAQ7kNvwFYg-WD&_nc_oc=AdrNB4RjBWgyRnwFa_adntt8vjaC27JbV2sVo7hLUtvFejUuIsud4DcHksT0DdDuiRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzmw49s9WKXkhO-l5CtgDAx0R2trrMHgfIhLsTh4tzO9Q&oe=69C27203"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn6jMllY_fsQ7kNvwEHJGrq&_nc_oc=AdokiMW8oNVEVMQ8qA8fXM7P5gvegbL6eAoKwk8gndnFcJpmQvx5sQoZAYzyESvAQZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhZchZ62qf3VDYWresKJcPq4uD9uQYMMzVT9u_2U2v4w&oe=69C2970D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bDP_UFU8yoQ7kNvwHnpzVX&_nc_oc=Adrrzd1ogGBhywx_s-jT7BQPIjOtNkcBYfNTXfXH4rfB8XLFH9-wHWLyy_y2V-TrYuU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkDvAS7VwttWWAim65IQFx319BgHSMt_nQu5LIbPjc3w&oe=69C2A261"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a1iedvr7JMQ7kNvwFKCuII&_nc_oc=Adqj8d5c--SqqKC3aeq1yd9-avqxQoGDb4gRN2KgiZQ4p5HUt1zzoKUla5lZUC24ApM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGGTVJyysMcj-qqmz6TtKsSRzVxDJl6zBfnmICwafxQw&oe=6ABBCCA2"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T83e4lvHbEEQ7kNvwHpfMfX&_nc_oc=Adq12sFy7KfjuD1D_B_dWnKDCk6mbFtkFZbQyhWh9WHX7ynY0kpl_uFZXX6aOP3SHuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9lIDal8mV8UPigyJFlP7VyPnH1OjY7P4mklDv-UT7EA&oe=6ABBD7DB"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPXMbpaqgf8Q7kNvwEhWfrw&_nc_oc=Adp9vQ_L9zrQREIZZWzWumWBD4x26v2mPAoZolImjMPrSfMRQvxPBdrPyrB24lCq_EQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5evj0zDCsNerpgb6Crl5smx7IFerauXUuId5wBc51Nw&oe=6ABBD5C3"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWSp9CicEeMQ7kNvwEnI01q&_nc_oc=AdoESeAgJKlJhx0p3fdD7pqn0CWIlM_3u_FMPpe1ZPpYIJRh95HuliMvmi0CezLb6m0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNAMkyY5FE6ZXZc5wZz6REyblGiCRJ716ZwGhdYvUbqQ&oe=6ABBC28D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6pOeeUWDdEQ7kNvwG0Dl1p&_nc_oc=AdrNT5_75g0wVQlwNP2K_R35NjLA8C9WTPCdJo4NU69IloENpFj04-mHkMZXzoZx5dQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpHf6x235jAwJLb6ch9jfI1Uk2drwTTGObt-3y_EOJ1Q&oe=6ABBCDE1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E762uKn1gugQ7kNvwE8a6ru&_nc_oc=Adq5RhW1ebacVTu817p9l0Q_sNy2SNI_okfAjGV5CE7NGHVq5fXEhu_K2_KUCvzgPKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpek3np1W0qzw10eqMrkjAo6tRUhhzb8SbEBwJNE8UsQ&oe=6A7C4C62"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4kJIXjmcq0Q7kNvwG5LnPi&_nc_oc=AdoZfN8yprEwkIA6DnpKzUmDdOUHTwTcq6WT9a8epxl8KVOeoYE9g_GSPKA3-6bsl50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkqKrg8y5Xfmkre4kHkgwxBbvOcxeAye2CnIqvQYlDOg&oe=6A7C579B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhP3mFYKVykQ7kNvwHTreHL&_nc_oc=Adp1XhX14aTARzhzzF6B3PsEAtZYwcHv2Oiu6H1emZnORNlwhZ7hmllx1Ec_mC7eeeg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq3wau-wCxEOttspfVOCf8uL3iv9uxPG918-lD1T3oBw&oe=6A7C5583"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQlik1Ky_f4Q7kNvwFPP5ym&_nc_oc=AdqoUrUovvEJ0bJjTpXCNc3uYXMwUjL5UO5LUTpVhPuRKhR_kxUoTLP897ZDHMVyCHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2ZXuTE-Fm0DSeYACTYo4_bxogELhTrnqvujECxiAjkw&oe=6A7C7A8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNBgl3XaoUUQ7kNvwGTj7pl&_nc_oc=Adpjdp4JnRRAQceQcx9zS_6WKGIOengi0M-TcgUUGp32ADOwrM261p6OiEx05kjtOTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkA7paNSUtv8IRo1UavZd8Fjo0Pgg8GW0Dr4ofFomycA&oe=6A7C4DA1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
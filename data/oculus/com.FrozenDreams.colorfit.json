=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjSGLuLuvyIQ7kNvwGAS1Eh&_nc_oc=AdpgCeG5JSHf6SZKx5HTQ8rmCCxik9qd9405yXHCXqDLHS-FK2978ZN8JWzULpb5WVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjAlywNvK56-VEUURSU7I3TM1BbfJqSV-uG40pql93lg&oe=6A843562"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpfMYpK0jfoQ7kNvwENWWXh&_nc_oc=Adrk49V2feVkL4qsaZLKNdzV2-MGjOqSX2d-pxRGGlgKYgK-yhDYRntfR1KqnC8vWXo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh_Ky-I9SfPuY0B-9e7q2pbGEwWVAXStEB97_ofTI8_g&oe=6A84409B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aEtyr4_zjoQ7kNvwFQh_ot&_nc_oc=AdrSrFkzmt_wxDkGMPyHjKXxSvvyDOOtmJfzZMdiBBn8JyGAni1CNlz8t9U4o6zytlc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt1NG4JDwOSQdlTJvAUEYfQZFtEpnM3Q0ELMrI4r5wCw&oe=6A843E83"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8pLH1wB3OYQ7kNvwGwKYHN&_nc_oc=AdqYrpUT2dK2a2NsV63OY2BwJD2-SCBnLEphGmgbgjfgHsDfnu3brF_2FkCnJHSAMTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ744tGbr728_C2P2YrIqUx4zRN3yemAfkpgiQcLx98A&oe=6A84638D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLq5NwJOhmkQ7kNvwH93n55&_nc_oc=Adr_0JanxnqkXEZCqBHmE-Y_LNHpETfGH8XZQUgskSVO2hscWuy7jWcAvuUCtKMf_SE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAg_0lsbA1Vd9iviKrvwj7EWaTFBF2KoNaTJMUfISymw&oe=6A8436A1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1NLelJW3jEQ7kNvwGKx6oH&_nc_oc=AdqsyVQ3DBSPYudXXDOy-UCO7I2M52JE8gRvdiOAYG-rKNp2c3n5rTC1TQ1ROCuvDBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5woeOoj2pGJsg4ADpEmzPlGd0diEPUd9kjyjgEE2awQ&oe=6AAAA922"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Gv_vPf1Ce4Q7kNvwE5svh1&_nc_oc=AdpM-77VLA-I99mcBt0evWXnpuSyntRWjfTxx7p-2WdOk44h0aBgmj3cGVJ_Okhd-Os&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD4aQeTd_Ur6WblQGQxL4XM58b6o_4TniiW6fJ1x4jrQ&oe=6AAAB45B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knyXSnI6zWIQ7kNvwGjSJyf&_nc_oc=AdrmZPrOtVOwGwxApjxXDI-aQjJD5fmK_3TKhivGf6wdTGemLMBq7GT-R2nnbS45bTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1ryDMde6eDw0n46hcCTWh-efNsjswovIMsEzWwrzmyQ&oe=6AAAB243"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5mAQO7H8EMQ7kNvwFz5_sX&_nc_oc=AdqcePJMo7KwTJA7Il06gNtX6oP7_VVZUxPBMd-oCWZMD5w8FzPnX4SCPejhc5yCMlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiR74TSX7Eqwl0S8sKp2WNx3zreGQsX9vl3Y-w9XQ6QA&oe=6AAA9F0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onIWhvsad0oQ7kNvwFmvXmV&_nc_oc=AdpEmUA2KI53Or5xrC1yII7QriE24vgjmnQyzPH-Jo3jxNNoxE3AOPsZRPi11uIVI6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVpxl6w1SElkToORHqfATUK4Zz1OPBMS00v7GeX7CNjQ&oe=6AAAAA61"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
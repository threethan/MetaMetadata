=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89VP9N4KZqEQ7kNvwHPTK8W&_nc_oc=AdpojZUJGg0M72uJO72qu_ScjKYEip1vBowpfMALOnZgtohLgPVOz8_DWC-ZqSlZnp0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C4RCNsKCLoVVjZnIG8Z1K4iz-HHzyx2JwgouDgt9VoQ&oe=6A32B0A2"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OecJX7vZhYMQ7kNvwHJk_tq&_nc_oc=AdrSrq0oZAP-fttoe_2xrueY5Bwnj74fZOcfRO959v4qBRrDbmeSUqjW0_aM4I1_0as&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B5O6IFIhOQcspj2ytzPQYbkna4abhMIBAeKi5kz0pvQ&oe=6A32BBDB"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FrVIwxnGeYQ7kNvwEmPdhp&_nc_oc=AdqAPNeOffvVa4mO2TzYrNRlkDt389ijesS2mSRt369H1vMBJpRlFbPqRcMqUWLiBw0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99iLWqFwCQYfgjkatQT2ojkSF6i-H5xYZjWj_JO9vfAA&oe=6A32B9C3"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsTEAhdxxQsQ7kNvwETj0qV&_nc_oc=AdrJpfVfVUvaeiETihNXyVKLQ9Jhpndyv1Fd42Jz9ou7LNYpeC1BKJlL7s-MhG2T2q8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__EsNZrs0OMFMuqRuYT5WygcyZczo2fXcHQA4_v-zA3Q&oe=6A32A68D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5NsGnENC0QQ7kNvwEUm8W2&_nc_oc=AdpdlmJu4ixGL4aNFuEkWoEUcSFFZgg49CfcZFKdbCivKWo1p21fYE1Im4LFgejk17g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mlEf_PdgJY7Orr3AMTOIX9qoGq-yJQ3w-jJZTeim8Ag&oe=6A32B1E1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rXO2lAg9WQQ7kNvwEebArb&_nc_oc=Adr0fg-2sUxU_G3D5jBR2xx5b7tW5t_3jHTUySEn7Bf-JsP95cjxq_dWuQGNdiHNq14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRzxB9ZOPzYDqLbtcRwXxOMmRUvY6F-TFgzXQVE3mBKg&oe=69C938A2"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAaYlRZpN-cQ7kNvwE1sqUh&_nc_oc=AdqC7NJkLv53nZj6PZyer8QCpg4GAWnAbdXqN9DL1cQwDjpGxB_IOW1P8SBhKlsGHNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPDho89cwyI5oE4iaf-U2KutCNzTaqVVbToG2B9ItOlA&oe=69C90B9B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taOrFuWXwuAQ7kNvwEigxwq&_nc_oc=Ado9jMwMl43V-1UOPRK6yyIrThqls67HDugT6aXSKjGfbLkGyV8wL5dk7kHFYLz14T8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCq9Tzir5PQXXGj8687saJXrFzK5_PNJsGTBln6XzNmA&oe=69C90983"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujN4rQ-nwFUQ7kNvwEcVrG9&_nc_oc=AdoyHroskq_gMausnienLP6xGXd8KDyWwwdhXcGhA3CaCaVEBaSvSdivJltxHaAPrfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJc9b7gJzjmAvJfZXnumLjzZF08UhT0g6VQLMVpxTNAQ&oe=69C92E8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJtvaGYHtqsQ7kNvwFXEWoR&_nc_oc=AdoALjmEs4NR3SYZxZihkGszAhGCBRHoZh0gth_UlDyoaFW5yqFbLfYvqhBaCxqe1f4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1XyQkM9ojEEuK9Oyo-6oQhqv9JgJM6QBdPotPhQIEaA&oe=69C939E1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqhLA2_ZvfcQ7kNvwFwtVgH&_nc_oc=AdoW7TP4u-ypFmaTVOGQJmmWlILCr0PVcxbroY7dzF1xkyy-7sknhtPkUA5sQOvX8ns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t8goXj7yUI3JskP3C7CdSNrHUWFKrHOihp4Sf1WcDuw&oe=6A072F22"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0McqIq0ae1kQ7kNvwEjNF2F&_nc_oc=Ado-Ingu4MkIl6LBmsoVt3w5sYm_BSlvYQ-3txMM4-KX6XJ-cb9MZZaNiEx68Qu6iUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pgvL9PDyXwSx0fWgZ05A81TMyYFw_WF3pQ8cetFyEEw&oe=6A073A5B"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLfccC6FXyUQ7kNvwFiEfRZ&_nc_oc=Adr4hBoAAZaFuHVOBYaJYdl8oHOSBt21GC1wKluGusoa77CbGHlt5a0qKF6Znf4ueRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rEExpQeP2TLISEgYABYqZ5JqAHctSyr0xA5uF7ZpNDg&oe=6A073843"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ombtsTcXNggQ7kNvwG0ssh5&_nc_oc=Adot9ux8RNgFshyOtzrjwOcvCmcncfKu0aZdizDt-zKGxPAs8UFTMp5Lx9RfsE48Pl8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l6YXguFIWj7xHtlobuJmGscytyVMZjw-28iyrq8f2BQ&oe=6A07250D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceTGa-elxLAQ7kNvwFyJ5-6&_nc_oc=Adq3tGygWm8K5_AqO9hzWE9c82Dsks4kWqKxi2G1FcKCPkT_1JB87WgI8HP5UGlUx84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jCbRtGTMkKbgIVKAatVrePWxaPrYolr3Qf-f5ACiGJg&oe=6A073061"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
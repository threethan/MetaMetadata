=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRJjWmrhM_sQ7kNvwHlE209&_nc_oc=AdpXdr_PjZf03q4T8_LOrJIU3qRGqVp8BeUuBCA4obTFwYC1EpkWSxJ-xDyk5S0cS9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyZAkxj7wQwUUQbuq11SrkT1Ata0lVPjXKlBy0ogXIgg&oe=6AB686A2"}, {"file_name": "4.png", "id": "1172020885147247", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1172020888480580_692345647249940391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xftp2tMub04Q7kNvwHu7Fjg&_nc_oc=Adqku3X4Kl-ssOD3qZR9d5km9Tt6uXZl5ZP1ud4kZuIuPpfzqyIjI9_4dliUEnd_nMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMLURgheTROMVDfMR0HsRHAQNHJIiDzv52U1JhGnxMSw&oe=6AB691DB"}, {"file_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hSDFKk77vwQ7kNvwHLDqrQ&_nc_oc=AdozOl3zHi8OCMDd9LJHw8kvOhsvvmbeBl3zLFgWGeBGhguGUGHx6Mrr2M1-BvLRrXE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj0KFnbdQaz8-4Dj2tXed81nKLPSWoyzhs18bCJANucw&oe=6AB68FC3"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_qvy-YcdWgQ7kNvwG_UUWS&_nc_oc=AdopbQPU41ZM1fXynYt4QVxO9nubPArvY6A7FoioWjDlEbQx12rUTCVFCDn3UXMJQM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhJeQi9JdpD2OqTnyRtWeQuEyJzzts2h2_HW-igRiePg&oe=6AB67C8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yRB_ipH1tsQ7kNvwHLrfXq&_nc_oc=AdqlBBqvU6iXHAOeovgw5jlREsekiHi0zHcOUuv2hW_JanSwAM26yphLioy2mnXbg44&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaDF6pD2ulO64HrGOTxcXNrsk-LgQzZQkm2V-W7InCPw&oe=6AB687E1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
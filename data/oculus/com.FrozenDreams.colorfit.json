ile_name": "1.png", "id": "4304358083159714", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821115_4304358089826380_8892091282160833163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd9uSn4ce0oQ7kNvwE-A3_S&_nc_oc=Adptuaden1auteSDFtBYxMWr5aeB6R82vsIOTNzY2sAtoxWaR1X0bR6pRSDkVk7mHcM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUz1wnKKTucCHtAPOgH65vBufVJ3UDNq_q49IxiR_w1g&oe=6AD390C3"}, {"file_name": "5.png", "id": "907692608367260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818885_907692611700593_4674589555727649664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X57I6aTPtIoQ7kNvwGg4i7e&_nc_oc=AdpHEYjc3taiE1W0M4v2DBXyz9qbeKqoUCba0_IF4BogB_nuU1yG98sPMw_Zpi9g5qk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe5Xx0r2e0V5IrcAvo380J7w9mPfEb0iL9-7etvnDRmA&oe=6AD3B5CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1202186154717486", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830021_1202186158050819_460802184064812121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx5VeY7JE00Q7kNvwFc4vXw&_nc_oc=Adplml0gq3H6ONKNTOCV73sx42n696g-5rUJVFoQSdnohtd-seLetq4zQ4L_tXasGc8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONVB_78VyT_rWaDV8xx7_jU-DCxz6J_0KikGgRRWPLUw&oe=6AD388E1"}, "display_name": "COLOR FIT Mixed Reality", "keywords": ["fitness", "workout", "boxing", "mixed", "reality"], "long_description": "\nAre you tired of subscription workout apps? then get this one for free.\n\nColor Fit is A mixed reality workout experience that gets your whole body moving. Break boxes using hand tracking while encouraging full-body motion to warm up your muscles. Ideal for morning exercise. The physics-based gameplay makes it surprisingly addictive.\n\nFeatures:\n\n- Room-scale mixed reality \u2013 No motion sickness, no hitting walls, and no tripping over kids or pets.\n\n- Hand tracking \u2013 No controllers, and no excuse for breaking your TV.\n\n- Dynamic shadows on virtual objects \u2013 The cubes feel like they truly exist in your room.\n\n- Full-body movement \u2013 You\u2019ll feel every stretch (and maybe hear a few cracks).\n\n- Built with purpose \u2013 I made this app to help relieve my back pain, hopefully, it helps with yours too.\n\n- Early access \u2013 Expect major updates and improvements over time.\n\nPlease join my discord to shape this app based on your feedback. I need you! https://discord.gg/ZGAHEuA", "short_description": "A mixed reality workout app that gets your whole body moving. Smash boxes using hand tracking and full-body motion to warm up your muscles. Perfect for morning workouts, with addictive physics-driven gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25893328707026965"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821682_916575924270371_6514931208615496936_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWXP9QnB06gQ7kNvwHlU63G&_nc_oc=AdqElwVDUjP2tWfpzZrC
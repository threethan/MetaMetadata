=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjFc6ZQS0z8Q7kNvwEeM5fO&_nc_oc=AdqMOI1usGND_HHMe7ganj-Wl_9X2-YTOVhpV3sPDYDHmNOpJY7pyzTXnLUL362Upu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu09WRiCDhqSZg1YQr3jCd3pj74e_wynd6SENtbtujKg&oe=6B01D84B"}, {"file_name": "04_mothership_2560x1440.png", "id": "1152644984381082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295992_1152644987714415_8387304013446587289_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuCQp_cREo4Q7kNvwE-ypho&_nc_oc=Adqz6sDVOJfNmRjGTAgGjO3KEO8-1rdEQ2-XtK_-_FceY_qhyrxHvtnROWV36OyRmDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQei4TcbIACqy5elVCPOTG_6obIieVICOyT9U3SFfIvUg&oe=6B01E1A3"}, {"file_name": "01_comets_2560x1440.png", "id": "3047168519015295", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314660_3047168522348628_3770096979514153041_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOzORssj-58Q7kNvwHjgyJb&_nc_oc=AdrY26brVBrL2vVPRUaVGSaTcdFJvi-dX_13UfzHjD4evHqiyRA0IhjEHedANByDTGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9zVEfTAf7VbaopxBJWk7IhVXIPm1G8ZOFc7yAKP_cYw&oe=6B01C98C"}, {"file_name": "03_dark_level_2560x1440.png", "id": "1708608570665779", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/767772105_1708608573999112_6836275056972939936_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASMYr0eDE-oQ7kNvwFQT4wn&_nc_oc=Ado5ryGHweVKzOMZjG8IAfDNnv2o2Bs0nLgcNFqUlJpVWMqhC3LI-jhfJpOAW2IQyE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlb86_NxntDUAqO0gn4VXi4wnTj-5l7VsND29tl3WeTQ&oe=6B01BD0F"}, {"file_name": "06_moving_blocks_2560x1440.png", "id": "2187701258551651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313107_2187701261884984_5488818464906277594_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsaWRSXCNkoQ7kNvwHfeEhn&_nc_oc=AdqbYr0QI2ZHi7-UZrmSrHCoMoXGbgc6zICuuEhSmGaGXn-XIG_c58dUD-dv_gx95DA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYisROojwGpz-f15sjJiRZ5wmdENXePdm5WUw3XdSbhg&oe=6B01B82C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "30330354553219693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293803_30330354569886358_1349203297930826278_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPJIy1cThDgQ7kNvwG96pEE&_nc_oc=Ado_gm1k7bFu5YBF4EEfXxp78LgwhkaXFfEMicAT4ITVMn22zVAUg1_oCsqCHgH2ROE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjnYBpkPbDRlkn90LjMfUQe6o_9EvstfCR8km_5l44Rg&oe=6B01EE80"}, "display_name": "Comet Corridor VR", "keywords": [], "long_description": "Comet Corridor VR puts a whole arcade maze in front of you. The board hovers at table height, lit in neon against open space, and you steer a small fighter through it with either thumbstick. Clear every star to finish the level.\n\nIt sounds simple. Then the enemy ships arrive. Crab-clawed scouts, spinning blades, prism hunters and manta raiders patrol the lanes, and comets scream down whole corridors after their lane lights up. Your ship fires on its own while it has energy cells, so your job is the route: where to turn, when to wait, and when to grab a comet charm and dash straight through the danger.\n\nFour sectors, forty levels:\n- Outer Rim: learn the lanes, the comets and the dash.\n- Nebula Drift: moving blocks, teleporters and planets in the way.\n- Comet Belt: switches and gates, and comets everywhere.\n- The Core: big mazes, faster fleets, dark levels lit only round your ship, and the mothership.\n\nEach level awards up to three stars: one for clearing it, two for keeping every life, three for beating par time. Finish a sector to open the next.\n\nThe board is yours to arrange. Grab it with a grip to move and turn it, hold both grips to make it bigger or smaller, tilt it with the stick, and the game waits while you hold it. Play seated or standing; your view never moves on its own, so it is comfortable for everyone.\n\nNo account, no ads, no internet needed.", "short_description": "A glowing space maze floats in front of you like a table-top board. Steer your ship through 40 neon levels, collect every star, outrun enemy fleets and get out of the way when a comet comes streaking down its lane. Pick the board up, turn it, tilt it and resize it with your hands. Easy to start, hard to put down."}]}, "developer_name": "Guidry Games", "developer_privacy_policy_url": "https://guidrygames.com/privacy.html", "developer_terms_of_service_url": "https://guidrygames.com/terms.html", "publisher_name": "Guidry Games", "support_website_url": "https://guidrygames.com/support.html", "website_url": "https://guidrygames.com/comet-corridor.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29759217133684755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303100_1854473605685864_3033049301614742634_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGVVo1CLMlQQ7kNvwEj5mNn&_nc_oc=AdoBySsC550U4MA6Q0hYY68cADIYslP4-2D5BApGaSD7DhS0N_wKVPzWpOoymgMzGAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f2
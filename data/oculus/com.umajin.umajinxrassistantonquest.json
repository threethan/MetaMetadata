40570295075_5423419112469224138_n.png", "id": "27160890120196631", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_27160890123529964_4281524337490452343_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv1IrMJyLowQ7kNvwF5Prf4&_nc_oc=AdoOkE4RqKKlTrzjxAuPpzhORX6jF2wQ1Jh3pU1simbArLl7NVPqk3RlAHE3CrtRf5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2OQMlMh_uqdUW4eF4uj8fbIoD4JcuY6ifrKL041iHkw&oe=6A68B7BE"}, {"file_name": "720329579_27065570553113248_4379511861832974770_n.png", "id": "1276318744658299", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619681_1276318747991632_6998945428882788483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL2TqAQpUw4Q7kNvwEqBz7U&_nc_oc=Adr3dvz7MqmGxcjVyM6KGLC7Ix-TUsDi2M_pER2ODgr_yvWy0Cog0nm034S1rm9qA-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKrGxjOa6bW3KX-eYDdbCH72JBKFtG_Zw80fda2Skv5g&oe=6A68A8AC"}, {"file_name": "718982774_27520695737565965_85305282834411954_n.png", "id": "962256539977721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623601_962256543311054_1705884100269807397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS98nThoLUQQ7kNvwH5FevS&_nc_oc=AdpgE8I8TWP4cJojpaKR1LVYF7yo04VfHEliQGjEh9tGG87Bj7gIb54DG4gBEkFNveY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU4dNwEfd4gwYVDdVv1WhGFsFGmB1Lg7RRNegHjpVciw&oe=6A689DFC"}, {"file_name": "719071521_36034309209548455_6534863013853344857_n.png", "id": "1192521079634297", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604298355_1192521082967630_5386072686858867747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFMOYXRiaMwQ7kNvwFRgZhI&_nc_oc=AdoxQyXwObi1Vxmk25ViUMvv95BRqHjj1r8Kb-lPipnDS3tVkhRT8Wbu84PQk-z_BuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqYxrozQiOkIGCwf1dEqFfNCHXjXGqyhi2SqvCJPzNfA&oe=6A68A6B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "942562678434743", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_942562681768076_9202067955229425019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdfy8p15FHcQ7kNvwH0wBl1&_nc_oc=AdpVWyWUzKW9qLeJntO9YVX5lMXDKnEhByzV01Rs2d5vX5roCRSXczxtx0AdjD2pJiY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByyHF7zdPifn4ySii-MDuIfnWBml9GFujwMFpibSeHJw&oe=6A689B50"}, "display_name": "Umajin XR Assistant", "keywords": ["XR", "communication", "collaboration", "assistant"], "long_description": "# Real-time, expert guidance, delivered in extended reality.\n\nUmajin XR Assistant is an enterprise XR solution designed to support frontline workers performing tasks by connecting them with a remote expert through real-time 3D collaboration.\n\nThe application supports two user roles:\n\n**Expert**\n\nExperts can host a live XR session. They see a real-time 2D view of the worker's environment and can guide tasks using:\n- Live voice and video communication\n- Create spatially anchored digital canvases in the on-site user's environment for collaborative problem-solving and training\n- Visual guidance aligned with the worker's real-world view\n\nExperts can point, mark, and explain exactly what needs to be done, eliminating ambiguity and reducing errors.\n\n**Worker**\n\nWorkers use Umajin XR Assistant on a Meta Quest 3 headset to receive hands-free, immersive support while performing tasks. They see expert annotations and instructions overlaid directly onto their physical environment, enabling:\n- Faster understanding\n- Greater accuracy\n- Increased confidence during execution\n\nUmajin XR Assistant is designed for hands-on tasks where precision matters.\n", "short_description": "Real-time, expert guidance, delivered in extended reality.\n\nUmajin XR Assistant is an enterprise XR solution connecting frontline workers with remote experts in real time. Experts see what the worker sees and provide guidance via voice, video, and precise 3D spatial annotations. Built for complex, hands-on tasks where accuracy matters, it reduces downtime, speeds issue resolution, and improves safety and performance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrassistant.umajin.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Umajin Inc", "support_website_url": null, "website_url": "https://www.umajin.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "36791786797086251"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618293_1603742114209460_1227917793939361601_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eac8cBowuroQ7kNvwFx2rpw&_nc_oc=AdqU_FRgO5KYxMpFw4BU_mNgVvoktLBKKsfj4uNosm-z_eyF-q1MIOJuXfgxCpAnqR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALd8FryB0w5Y-UcVHUJu8vwLE5x1T-40xN8W6GOdITEA&oe=6A689B62"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umajin XR Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1781036340, "lastRevision": {"nodes": [{"id": "34342741621990793", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {
9C1343"}, {"file_name": "j4.png", "id": "1654937055498210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818852_1654937058831543_2540131821370492559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQhIXSXvak0Q7kNvwHn2uZT&_nc_oc=AdqRU4A6y1M58uRgINDUYAzVUI5X7B5M3I6sXn4E8ktGVxYq7rNhHf0HmJUC4AivU4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA97wT15scgy58ItHUnWnUaL1GMOoYLVSY_ipGN0N6yQ&oe=6A9C3BF5"}, {"file_name": "j5.png", "id": "1355347856418720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_1355347859752053_7632188702947526703_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQnWi2fjJ-IQ7kNvwHZLIMK&_nc_oc=Adqk9xAFE6OdmglNy3_nUTj5WxuLJECBfbzvSN90BOHALT0nD2hAbBGzDzItg7ipzPU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBRq4ZQKzMAiq7mQzUPG3np-wgI_oPOlqCGYx16I7TqA&oe=6A9C0E35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jannaty - Islamic", "keywords": [], "long_description": "Welcome to Jannaty\nJannaty (\u062c\u0646\u062a\u064a \u2013 \u201cMy Paradise\u201d) is an Islamic app designed to help you access useful Islamic knowledge and daily worship tools in one place. The app focuses on learning, remembrance, and organization, using technology in a simple and respectful way.\nWHAT YOU CAN FIND IN THE APP\nDAILY WORSHIP TOOLS\nPrayer times with calculation options and notifications\nAdhkar collections (morning, evening, sleep, and daily supplications)\nTasbih counter with basic tracking\nZakat calculator for general estimation\nQURAN FEATURES\nQuran text with available tafsir sources\nAudio recitations by different reciters\nTranslations with synchronized audio\nBookmarks to save verses\nISLAMIC KNOWLEDGE CONTENT\nHadith collections from well-known sources\nSeerah of Prophet Muhammad (PBUH)\nStories of Prophets mentioned in the Quran\n99 Names of Allah with meanings\nSelected Islamic books (fiqh, aqeedah, spirituality)\nLEARNING FEATURES\nIslamic lessons for different levels\nDaily reminders for learning and worship\nFamily profiles to organize individual progress\nSimple progress overview\nAPP HIGHLIGHTS\nAuthentic Sources\nContent is based on recognized Islamic references.\nFor Different Users\nSuitable for beginners and learners at different stages.\nOffline Access\nMany features can be used without an internet connection.\nPrivacy Respect\nUser data is handled with care and not shared unnecessarily.\nADDITIONAL FEATURES\nCustom reminders\nPersonal dashboard\nMultiple language support\nNight mode\nBookmark synchroniza", "short_description": "Jannaty: Your all-in-one Islamic companion and way to Paradise."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1WwNdSLBQuRIQ9L4eXZPUnADJuXFYqfahMz8EKxxcFZo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mehvan", "support_website_url": null, "website_url": "https://www.instagram.com/mehvanjemal", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26557207687205014"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823910_1835874157248896_3320114718665521411_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDPHP_ZZv3QQ7kNvwGIHw1G&_nc_oc=AdqsKSaKbXEBXunhw1KEaV0_-mLdQW5k0tcR9Ay8QC2jCxJRU2-biyh1MVmKz
H4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT59VXACAH7hQGvztgh18jMFFrf-6qyEFCCVwVuxg5Oxw&oe=6B0C63FA"}, "display_name": "The Haunting Closed Alpha", "keywords": [], "long_description": "Step into the eerie world of The Haunting, where every shadow holds a secret, and every corner hides a chilling mystery. Welcome to a spine-tingling adventure that will test your courage and wit as you navigate through the labyrinthine corridors of a long-abandoned laboratory. Available now on SideQuest and soon to haunt the Meta Quest store, The Haunting is not just a game\u2014it's an immersive journey into the heart of darkness...", "short_description": "PLEASE READ:\nThis version is the Alpha version and will not work anymore, if you would like to play the full version, please search for The Haunting - Rework or download here: https://www.meta.com/experiences/8237638906365090/\n\nWelcome to The Haunting, a horror game based on gorilla tag. Choose multiple maps and play with friends. But don't forget, there will always be something lurking around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/applabs-odt-adt-ltd/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "The Haunting Team", "support_website_url": null, "website_url": "https://sites.google.com/view/applabs-odt-adt-ltd/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "
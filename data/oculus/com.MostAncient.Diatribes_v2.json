}, {"file_name": "mourning_rm_01_2560x1440px.png", "id": "828679355598500", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewWXShWVDaAQ7kNvwH5crCJ&_nc_oc=Ado_FS6erwznk5Dc2TecD4Ig1Ct1wnzxSFTvpUcnVKTqFoZ_ZVAWDl-V01NkCLN6ljc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eQbHV2RkwUEVaXfU677JXZm_uRD4bgnsA9ETQAhRN8Q&oe=69E4EE57"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mXDozKKEtQQ7kNvwGCmcGG&_nc_oc=AdpujclkEoNAV-59jXYEUSjQCKhWi-vbNUxcuw7VmlCGfsuUIPAMWtT1UwbVJYrlOu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TGYiMA2whBY5rwnCUa95iWOKg_3U_-0fucK8QTWk4hQ&oe=69E4C8D6"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxebHTn0CrIQ7kNvwEnVV0-&_nc_oc=AdpHynOAb4b053KXqY1U1XBMZQm7sWhwhdvBYFiw46LtfObKKMLVdGw6oLBMO7lhMiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06pPG_F_XbRSYwU37jT4M4Txwzn0AMaxawqffxSgZMCw&oe=69E4CBAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sdt2VOUFLtAQ7kNvwEJ1LG5&_nc_oc=AdqWCAWMzFEWYXetTbEgHXUd05sQw0TG-dKj0aWkaIq40YuH-yngyxVHioa7Ic_aVak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af346jUf8YqSBts_FTfW-EB2cwkz3_gpxOQ9B9Uypox9Kw&oe=69E4E02D"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
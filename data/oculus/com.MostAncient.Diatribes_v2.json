0x1440px.png", "id": "828679355598500", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6LAbTbyNCEQ7kNvwGHiQLY&_nc_oc=Adk1F_gIqFCzSmoaZ2SbWc1tizlNSgI88_8fTfsjzsgvLsEI-eyMpEvgf3PeLYW3uaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCwSDGuId8kRmeSI_hmeux0BJEJ7tMPv3kG9RNW8NbLw&oe=69B7E317"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI5xELQmNacQ7kNvwEjlv6D&_nc_oc=AdmCmmvBZIJjLjWhx5Dsc7tD6wya1LEd2LBUsBVfyYDLGnn6RejVO6RM3RSr5QzSBos&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYPrL5TJ87QRhdzQXf0iDXpQJjrw_MKfkLAJMn8y9N1Q&oe=69B7F5D6"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_wzg0jOocQQ7kNvwHl33Nh&_nc_oc=AdkcXTClplM_h8OiEz9Mralrw0zyXYUSdTZF0YwMOVS06oFsXBcN6TeuK6sKc-b6KaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzn3XR4YWtb4lYg9WcXkueAvRnwzSO8_ERTA_YXZLbtOg&oe=69B7F8AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcRTbV5nX2cQ7kNvwGFV5Z8&_nc_oc=AdlhJAu2s0Cx-Z-B5Ub2ns03kv3bUR0uvLS6N19xDtRa4N6PLbfDfIfMxlYC3-lpvNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQDJYyjpE8So-Z1dT0cu973-QtMty5LV2hjECil4ysNg&oe=69B80D2D"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
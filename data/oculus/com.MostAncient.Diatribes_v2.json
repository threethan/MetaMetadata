}, {"file_name": "mourning_rm_01_2560x1440px.png", "id": "828679355598500", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-VGkZbLGs8Q7kNvwEOV_gd&_nc_oc=Adr7p2TBGd0rMRagLocMa1LHcHT9UzgJb_ihgCuRWlx420DmFWYgBL0k-PBaFahU6l0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3mIxJqur7bispcPTOBASMlwvhR49dfYgrK7BB2bO0ZA&oe=6AE20E57"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O98ZJMfxkOoQ7kNvwE0Bzwj&_nc_oc=AdpeFef3UQhymJbbOvior7PlKU3SdEqsJQYFaO7QuIWKlPNqBsbOf1HPzZv-PjI85l0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM6Q10id15ftX7zKiSwae50OBs5OyTB-pAVHnBkK4isg&oe=6AE1E8D6"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccRU9ucHrpgQ7kNvwEb4bHf&_nc_oc=Adqu3g5QpCCKkbZNV4AiyCQiNINFdiJgWWY2FCpAqZnYECrAMR28f4x4wMsr1bGZvoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqlPrX-sripWw4pKzSWF6PiHLDiDh5qfwBINeHHf5YTA&oe=6AE1EBAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEX-yLgll48Q7kNvwHKyUvB&_nc_oc=AdoWUeE3m-m5IjCQ2yAAYaZel_zIRcVHIY-2U4lm5TCpNOr6f3O9gYg1e5g0LZU1Mk8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1f6w6JFP-w5DLMveffB9wMztJaXqaSVKMK-DOK6HVqQ&oe=6AE2002D"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
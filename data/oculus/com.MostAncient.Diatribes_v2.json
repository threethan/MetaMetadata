.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usaTkrO43WIQ7kNvwGIn2Ev&_nc_oc=AdnS40ZrLc6OQVZsnTsxkQkow22pFouMFbQLZEQ9rinBoFBfEDUsiqcWAlLc42SdLfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsEnzYKJcT6hsSPBSoW8UJ_fnRs9XZmNoBpyXEuY9DRRg&oe=699AE217"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv1xCFDbT14Q7kNvwE0ScXO&_nc_oc=AdlUT1ZAa9LLPNfxLpnzP3-yJI1qzOvNaCz8cpERI6bR7Qn2-lzPrbW4dGUFsrb0IVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu9w1iCy0x13blAT2UfAnHlrt2k-10t_rQG6QprPh2TGQ&oe=699AF4D6"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxbI8WWIz9oQ7kNvwFJe9OU&_nc_oc=AdkYi2OvHjuyudz30Ekz3zlNL2j0iPkEQPKhZzBSgY5xWi7zbvz3gl2V1CkLW09EU9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftKIaxCP85RH3iJ30kiQpk4zvtej_B9hENs4zUHGqD8Gw&oe=699AF7AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmsHtY9y-oMQ7kNvwHB0cBz&_nc_oc=AdkuigtwgeItmTi_l_kXCTQednz4Tfnc0yk6n31LgSYcHJIvACkkCg-BtfSN8t1EG64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftsF7Z7-BPRoOl_u3q3jFZmBcvZj0CYZICdKKaX6WCMMQ&oe=699B0C2D"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIR
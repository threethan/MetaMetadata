0a&_nc_ohc=EHYm_kplSX0Q7kNvwGyKd8H&_nc_oc=Adry9aI8yFwgkOfBpiuI6wl86o5wh834YPdvSiz4ziYzuW0XV93veeWEvX6d4dZVGis&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8jorAJO9NT0Ubd5-OSguT0n4eRoik_CDNK8pq37ClZA&oe=6B083CFD"}, {"file_name": "mourning_rm_01_2560x1440px.png", "id": "828679355598500", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAdzWdfA44IQ7kNvwGYs8xh&_nc_oc=Adp95r_73gMobel7kwDKcGcekz-Sv8DBWDeMWt7TU4sOmHZXLKyGSc9mGKvujr7VajI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRugANNdFjFoWUVUJbjj2zMp1__LClynJiJta8LajvjYg&oe=6B0849D7"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DqgnkvZ9tEQ7kNvwEvVZRS&_nc_oc=AdqMEu8kR9noO6qYeyud8InusHuTYdC0ojwwnUQTp5IA5UiVR2Hvvn6udM0PItE9zZM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkyiJSYHioF8BDaEnFFw2ZqwJzDm5neaSjbaVrDeK7Vw&oe=6B085C96"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBjXeSFn4VwQ7kNvwEziVGt&_nc_oc=Adowx42x5Jkxtn_J7b2F_hWwZVk3fnSUtjxcmiLZqAtzwk8gz-kPCryqdtYmOaWnBzk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0ceZIgEgxbKLSsYksft_3RtnZy97sMJ45P2ztrDMe7w&oe=6B085F6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySOuk1ksSw0Q7kNvwE_4aB5&_nc_oc=AdoiSMiZyHv5IeOnUDNhnt_PzusIazO0lR70TOWeL1PX7EIfAzqv0ND4xJF3t0sdXQ8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe_fa8iNYQrp9-w0vmEug1UbLuCOY_KNaljcDxLddgOQ&oe=6B083BAD"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8911091035656774"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75481468_1049638970121808_6965157291160928163_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mvNQjmU2TUQ7kNvwESJMYq&_nc_oc=Adr6aDRM1wbN98nu_4gx68hS_xlFESmZoFhaDmx85iFXQPLbqJiqmKiRv9fKe9N5ITI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlcN3jJdVhxitIEkAfwsY6FL4sNARapAihqUhBs6Q2PA&oe=6B08525D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Diatribes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1731261600, "lastRevision": {"nodes": [{"id": "5936055276465884", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "40977
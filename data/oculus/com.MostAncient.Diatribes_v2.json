}, {"file_name": "mourning_rm_01_2560x1440px.png", "id": "828679355598500", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLwTtolibvAQ7kNvwGTQp9K&_nc_oc=Adr1q-E29KWMgUio-aBdmvivBO8B_pwbN7AboMgLvCp3YJkxZ-npULgrSp7eCabK618&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJsMWiliNewJZNJSAYcqDAYirZYhBSIi_WdREGxeq4eg&oe=6AD0EAD7"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGHyThE5-swQ7kNvwEwlZFG&_nc_oc=AdpPAHLfe2rxvqub0JQqRiiaesP25m5Y_vh1w0-I0ue4M0xqSQ6FcyEaVCg6GTJZ9xU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_cirYm7vYCAC7_u7tsXg4ervVs_c8HurnTjEOJDvwZA&oe=6AD0FD96"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwVsEs_KfmsQ7kNvwGmpLsu&_nc_oc=Adrn0vKDbEgkiCcbeneVbnSeTHyRTGjJSKlxLLMQYKseuPXE5u84ca1sc7LG9ZSGrMA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7KeLl3JsPqo1F__f-a_djb1zZgxz_I7h96hlC9PkuMw&oe=6AD1006C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA2ULf2Yqi0Q7kNvwGfIrta&_nc_oc=AdpfYrne2GhoQm7qOT7261l6d0j2bvZcbtG4Zmd2ECxCDBiVl4ufoiB0n7iOr7Bu1yE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPL983eu62NA53wJhJev4u4dD-i8N2gxQEswdf8JzFrQ&oe=6AD0DCAD"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH-Fq5I8FNMQ7kNvwFqgTcu&_nc_oc=AdkgYJ9oMwl4Nfx6Gguoe8GTHyr2SA9UOJ4g5MlU-MYBKqd1xokfGiGvoj7RsD-NWpU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvrOMd8WPh2-o2EzUANW547smfM7qnuQdrmP1zM0SG0ew&oe=69A17997"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TudAzHVIvqMQ7kNvwHrxzLK&_nc_oc=Admo-K5Duk1cY5vJfFiipWWv7h-CRO8llZzkW6WvsOUbXLTJUk9m-v1Q8z2l6d-hVPw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftIVz2uJaXkOjPNU28tlcY2yFbgkTT80w5RILiyaePgyw&oe=69A18C56"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqvM_2aSTS0Q7kNvwHP0jCQ&_nc_oc=Adknov3x53uthSpSiNTwWWGJG0trFPnnCDe9rxKuSxCgnZv93RwUdhMUPwu3kKg1JQk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuxkFIuGkXiHFsFWh_kz711-eYk4_6t7I9QggXdI6BwxQ&oe=69A18F2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwLqXn8b6OcQ7kNvwHq5UpT&_nc_oc=AdlGzrQ0H5ZMvLB9tLshXTyv0xcTLwkXya_1dA6lY0mGX8U6F_LNQ-X9AAGlI2-0vx0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvN7ZDKbKWfW1Xu5bL78P76bOW-X16hquzg60vs77gypw&oe=69A1A3AD"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIR
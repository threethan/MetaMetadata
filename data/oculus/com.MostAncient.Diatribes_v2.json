0a&_nc_ohc=829398gp9-IQ7kNvwEMHwBm&_nc_oc=AdqZnU-taD0q2dwV4lltWKx72AzRJ8Rlh4TXh3XFUnGF2xYPTFDdwSVieuj5ZpGQ7N4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDJNRp-_ZuQKSNqFC_uvozGE0M8Sk0WkIztozz6FOCCg&oe=6B0C69BD"}, {"file_name": "mourning_rm_01_2560x1440px.png", "id": "828679355598500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1lPi3OEwYoQ7kNvwE5FD2j&_nc_oc=AdoNnPRtmtAGc8-nSs8Z9Rb2boYmuw4fxfalF3ejFCuyK0CcafUaiwTivY8zycGEuuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNY2Ukwzk1Ra1BF3fb1GZGshdyqPIW5TOcNxGMrl-q5g&oe=6B0C7697"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enlPrPsb8GUQ7kNvwEcbO7K&_nc_oc=AdoUnMyHbcGM3Lh6Q1bTbedNL2AE0-9Qaz8vfm_qAr7E1B2ovpCa5P_J61l4AkUltsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTq-bh1lQ9q481_02Vim6TKP3aBiPjKUnclCV9bimfp6A&oe=6B0C5116"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j-IjEwqhPYQ7kNvwE5ZbXr&_nc_oc=AdpB6FkepOhKyDadoxZmZKkPB3w3Pc96Q15bGjgB_sPnxtu5YHps6lPWVkJyFHWK_4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTITXSgkA6Agmy_lDGX_tASPD3Uk6ZZcNJakr70XCrbKw&oe=6B0C53EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0vp4u1eol8Q7kNvwFRtEnk&_nc_oc=AdqSZUcNZX0Gtg26jEGPPDB3s2YvK4L0kn0_pv4pZ3AXbA9cWVtvCeV4U9_wbfxoQh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgWiaQ_-C7Brhlgap60Pk9xV4J7BJAoZvg07cy1kxxGA&oe=6B0C686D"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8911091035656774"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481468_1049638970121808_6965157291160928163_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZGomP9pAI0Q7kNvwF75Upl&_nc_oc=AdqxPmRy4E4sluZ8nqmCxTl1uBt5WcYdIfnXOmjkxkKudLERfQwfo0z9vQ8OJO1clJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAu9SeWW1-2p0fdZZdfa0HIYYST9ogATYLaDBFZ1Gx6A&oe=6B0C7F1D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Diatribes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1731261600, "lastRevision": {"nodes": [{"id": "5936055276465884", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "40977
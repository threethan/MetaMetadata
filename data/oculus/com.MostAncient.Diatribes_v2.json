.com/v/t64.5771-25/38974456_828679358931833_3011204547726050894_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbZzN9pMjI8Q7kNvwGxyzDk&_nc_oc=Adm0N2g2TNyZbmEVhyQMuL7RLkYyshczJowfhmGqHH5e0A0msdUwKrfSTHhKlHJsR0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvM4wsLPy-Plfb87v_kuD-mnqI77evzPMi329EwD6utjw&oe=699ED697"}, {"file_name": "Ending_path_01_2560x1440px.png", "id": "837834994962310", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974700_837834998295643_3756978601296916131_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TudAzHVIvqMQ7kNvwE3OJMu&_nc_oc=AdnHTa0-5wEWkVZY1nxaTyeNnndIk-KA3LsENIScO-gY7-P5ObplD8hbDveFQ-4hg54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuyan-YR25U2NnelSrm1EEbVuOXeLYqWpBkjMsCUN5igg&oe=699EE956"}, {"file_name": "Ending_rm_01_2560x1440px.png", "id": "1243891963632743", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982575_1243891966966076_83278742145522198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50lB_Gq23WgQ7kNvwFWVKxX&_nc_oc=Adn9NVp8FldRe2tOAyVMrXDaGxh0W_oQlc_Yu8YHU4KbZYNJOZFS4FSlThnOYG3Vpi4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv8IlgypvpzAqguBM5IDzAU1McQiqPUInNKmf0nZX0lVA&oe=699EEC2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1890122448136653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982527_1890122451469986_6246999544261691533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6RCRm4MAFIQ7kNvwH5aGpR&_nc_oc=AdlBepTKQlDhEXHC8TDXrnBgDCbgRdH4HwzK2Df4nLYsfPkOtyAPYeQ4627VLghmOf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuIjzc1Grdghh5muDrQiKoFS6d6mUp4_8l8SAtzWqEjRQ&oe=699F00AD"}, "display_name": "Diatribes", "keywords": ["climate", "art", "surreal", "physics", "short"], "long_description": "\u201cDiatribes\u201d is a poetic VR interactive narrative that explores the internal conflicts surrounding climate change. In a 15-20 minute experience, players navigate a surreal mindspace filled with distractions and emotional turmoil. This dynamic world transforms based on your emotional state\u2014sometimes inviting contemplation through meditative tasks, while at other times thrusting you into a high-stakes gauntlet between Nature and Civilization.\n\nAs you journey through diverse landscapes, you\u2019ll unlock ancient myths and receive guidance from a therapeutic companion. The experience intertwines personal reflection with broader climate issues, encouraging players to confront their anxieties and envision a hopeful future.\n\nKey Features:\n\nInteractive Narrative: A deeply engaging story that encourages personal reflection.\n\nDynamic Environments: Settings that change to reflect different emotional states, from serene to chaotic.\n\nMeditative Tasks: Calming activities that foster introspection and peace.\n\nAncient Myths & Modern Insights: Timeless narratives that resonate with contemporary challenges.\n\nTherapeutic Guide: A unique companion providing perspective and support.\n\n\u201cDiatribes\u201d invites players to engage emotionally with climate realities, discovering personal agency amid uncertainty. Can you navigate the distractions and find a path forward?\n", "short_description": "\"Diatribes\" is a poetic interactive VR experience that explores the internal conflicts that arise when we\u2019re confronted with the reality of climate change. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mostancient.com/diatribes-privacy-policy-meta-horizon-store", "developer_terms_of_service_url": null, "publisher_name": "Most Ancient", "support_website_url": null, "website_url": "https://www.mostancient.com/projects/diatribes", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIR
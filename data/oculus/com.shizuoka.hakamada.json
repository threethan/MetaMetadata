dn.com/v/t64.5771-25/38974577_1116705442768967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TCCVju48dIQ7kNvwFwVSO3&_nc_oc=Adr5DVwCY-KvNhj-wIU2L3K5tiwQJ5GX0fV-fIu6Ss8gQDfmIsj1sOkqQZ3Tt-0u4kM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsIQU64VbCNPhhxWLbjgzyp1dyJR1slqmmPNXqtjL9pA&oe=6A7D9B2B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwsVJX2y-PcQ7kNvwFn3x95&_nc_oc=Adp58rEP5j-vw90KjX_JtHVwHCeCoG5Wf_88IHAVZSR3utAKkUzzqQTcE2u2jlWyiqY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKpHbtUH9i3CqK-GdT0i5emnw9RKNJNu33n5ma9qKdwA&oe=6A7DC502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LybWdvQ_OFsQ7kNvwHBNcvz&_nc_oc=AdpNf6RAg5xOwNkjlor3AgNDKpHEM1Nycd2nZw-I80lzqYmJe1eTq0AEH-2MxGog4jg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-r9ZcftnU_NXRV1j56EGO4kUDLXPaj8F1r5F_gZGULw&oe=6A7DA221"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cms2d5gVYdAQ7kNvwFmnj4Q&_nc_oc=AdobTCa-GSpP0uiAVthJcTnHfZTm3mg1lIXORUw1nkoTlVqdT8hh0qYaS00USbIoIAM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBprLIMZ0s5RoO3q89lyugxgtXAf1dDI_DKxQa37rd1g&oe=6A7DA631"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1Z5ffdtl7gQ7kNvwHU4vzw&_nc_oc=AdoLJ8Gd3MejkWRsG4gc_Dy8L8ucSSqhYRq7NifShxdQQund059-QGIDZvqYZBdQ7js&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM9kqPtmmWQvdFeF3yovpYuZDDfuU-T6RTsZmTgqETdA&oe=6A7DBA9B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwBQjUk6ITQQ7kNvwFr7De9&_nc_oc=AdqJm9tD5VnjaEQDaeNlG27e9t2VGunHm_4MRpdEJ6i2Jk1BP_CHx0ZdspvYoJah2lY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz31D3UY2jd2F1gzuox_50aO3kQfW5bcW4dbVpdBcFvw&oe=6A7D9B56"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "ima
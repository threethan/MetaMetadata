967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_JFUKcdvRcQ7kNvwFnX8AX&_nc_oc=AdlIP1AxfBUUTomAFezxy1Gdm1g20HAbe-cuVUdlTPzXPGXadwo3OdFtiK2yAuODtkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZt8dzT8fqCpvITPwpAzw10O1I6Xex9UAqvVEHOqbByA&oe=69B41DEB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFHDoRZVSvEQ7kNvwExYk-x&_nc_oc=AdlztV67CXWkQn7kkl1jFNbgft3t4TXIpDh9pLwGGCink4jj-qrYTwOkWqNis-F6oog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEQT9ZrAbZy54_9X3Ebzyf076P5c3krdrBaedBsraaDA&oe=69B40F82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5j_bogKlQwQ7kNvwEoK-a-&_nc_oc=AdkSQNbfV1E6fYFatyzmcbO3IA1jx6j0Xo37KwB45iRWIJERassjdVVYZCRRscoYH2Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPkflTMPpOn0T_vOLKeD_wBBWF5qQmZSleG8xZRJBqog&oe=69B3ECA1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYJt8Alb0MQQ7kNvwEWHOkr&_nc_oc=Adn32R6WRmsUQ-pI_orJiQsQARmML4nFRyRvsBYZ59PHmpre4iOK4jgDtdsmuhL7lto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNr1t6v_ZsL-9I6Vhs9mpUBqEqXhfvO79odJcymSF00g&oe=69B3F0B1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIUJrgHXKjEQ7kNvwHnZFv0&_nc_oc=AdlABz230jgbSiN4bl37gbi6iF7mrPIh7JvKdEOTnz518W-v6-v90kgYKvTuooOrsdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy43RH1LqNwlK_mmdQkXk1EF15Xfn_UkLgC4OgyduabsQ&oe=69B4051B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ1soF5r15sQ7kNvwF6topo&_nc_oc=Adl1oJq4zYC2OJpsNVRT4zcFUrKIzjr1nwqIK5TnX1gz4GYayPEJsVbYs3uDNp_yyw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKalfvzuHvZqGh_ywRe3is6GsdK8a1039w9Ow6D4jw5g&oe=69B41E16"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/
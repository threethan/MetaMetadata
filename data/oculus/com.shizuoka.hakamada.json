scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CHKMUgk9eUrAhg1A5auLqD_hpdo3RK6T2H1o3o_u_fQ&oe=6A2C0802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmkuzdfdpxQQ7kNvwGglkou&_nc_oc=AdpT3G-bth40Ce3f5Q29cG0JxpdlnHXZMiwptycaIWotHQQ7war3J2n68R7QrHS_7P8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mW9t9p6pHL-SL9fDREuWMAtxB_t_DS4SkVZlPAGZnoA&oe=6A2C1D61"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-
dn.com/v/t64.5771-25/38974577_1116705442768967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhjrPlUh1RcQ7kNvwH_PWB8&_nc_oc=AdrBC7p4dQvybzN9HCJ8BEFLZduFEn8ThqOWbJDR8S09cGuqc61pjbdDh2YatY0SriE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRCHQKS41r_1yZkElZKS6oAd3mp6MQ2xNnqjod5pJGWw&oe=6AA40EEB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFXlP8nGku4Q7kNvwHVkrOl&_nc_oc=AdrT7C7m3BpRD7Y3PgXas28sEIXy-W1cxX9uFAcHwImupoEjqALiLtm0P6wnVMaMfjs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKerdVSlWnERVBtPLTnjV0RnTKnkeOo-RvKTx3Dx2LjSg&oe=6AA40082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzmA2NlagP4Q7kNvwEM6xte&_nc_oc=AdpgYeJkHtOzvqGF7kZt-ZbFeV0RvnoNlkwbn73_bx1HUCMkxQs02H6wO8Xfq5v8QWM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcwIKK_KBHkdC5Z2AA3cWAALKk2hS-Av0GgEZExUS-kQ&oe=6AA415E1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3omOMoY8seoQ7kNvwEAkBc5&_nc_oc=AdqxriBfV227sZsaGgiABq_lGBPpsbwlwqYRkyvl5Er3otRa8J9hcGjvuvfr_2M2YgY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOHxohaFVe7KMXWj0XGOTd1MQioAwQ5g3TQzn_gwnnfg&oe=6AA419F1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uTjHo6aOZkQ7kNvwG2H0IK&_nc_oc=AdpyHyMW6c7F2VYmQjJksWxbiTdOQWcAn2J1OCirqDZ99bo00U9Zv_Td5qsUYO0_1NY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp5vG7pC_o-OaiYt7gFqgqIqVssBWHlXZIlBCk8j0X6A&oe=6AA3F61B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlZGguHJMEgQ7kNvwFxi5Ob&_nc_oc=AdqPdvRk5cfakZEJLGamPtsJfTDm1OZQdGtr-016C3VRaAQw7WSl1DtKfV6InMGiqCQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmUfvgIfwhWz7CzsWtxi0dcFFvSu6-iNmwO4rkwu60dA&oe=6AA40F16"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "ima
967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_JFUKcdvRcQ7kNvwGaQxhc&_nc_oc=AdlQQkYy-rcsCFUADQwICY_KIjutorgPiPxmSO7HXnmbfcqav4Q4IIM1nBKCaktk8BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZst-dxVJJ5VAk_3D2fIEaTlJl_e8C5JuI-QM_qIEdLw&oe=69B56F6B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyKVUpFFYMoQ7kNvwEHMug6&_nc_oc=AdnEhfirlPmXctAWoYc5Ns-lerI6K26ETYB9re9XjcTOzI9PaS_2SYxMkX394A41tNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz65PyRtatF2aeXmPR9zfXKpgAcy1n1LOvLqTfjqNaJ6A&oe=69B56102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5j_bogKlQwQ7kNvwHxBOwL&_nc_oc=AdkgQ_hEisxyn-RIf_qj5aYw0gfOCOmZR9lfAASs6i_05wD1drsg4Rvg0Kn1TZzdOWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwizBbVBUj4OrRtnoPCZqsixwaFnzA_nk0w2zGyMDfULw&oe=69B53E21"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYJt8Alb0MQQ7kNvwHhlKoz&_nc_oc=Adkz_6TAFdx2Ajd88X9NG4MBEloaqplzNlT8RcXN6N7bZD4TTNChbfyXIYEUarJWAlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIw9aDPHLW7oYFEYSlqdvgffIHBpqZsxyopmCQTdJUjg&oe=69B54231"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIUJrgHXKjEQ7kNvwFtiQ_m&_nc_oc=AdkBEjT1cAxEyEEpUYJ87cD0XLBZ6mLvRCmokLDpWlYQW3fu74Wuy75viSYgJDWnqfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDBwmNyfQgdHX45kjndlVZrA-C8ASPjIq4v7ob0Yutbw&oe=69B5569B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ1soF5r15sQ7kNvwFnHxJV&_nc_oc=AdmVaW9-8OnaC1s_7fG0-_j9G95MAWc0pjr_Ksggi7Xhd7M-klnsu7xEUMbVgGNETu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwfOIPdpWuQUombMuV8fmAnxGWR931JM64Zsk5lBJ-gPA&oe=69B56F96"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/
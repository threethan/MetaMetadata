967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsxt-HhQx0QQ7kNvwFv9KvW&_nc_oc=AdmX1KzjSSaaf9DhmAondX2lKpkhv061jLehFM8GmgVW_cfgkGphRn1LqyTPOAEFgi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftSPEVCTLbBOtN-qeZknOilZCJou14h8h8yxYMVZp05FQ&oe=69A991EB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wraPuPxpVIQ7kNvwG_w2oP&_nc_oc=Admxq-iSeE02MADd_SLnqqRK-_Lg5zogugu9c-OZCSJ_sfJzssU8juEe2jNAFEvr-oA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftkME6u85L2AhSdPLRnSj31_WHVdUF4A__FT8bzrnQrGA&oe=69A98382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ayZWDgij2EQ7kNvwHVcAwT&_nc_oc=AdlhRUPtNoogw7e7I6AVVdHnZ2R_6BQhlhW1cBk8C9XXScnJ9ZS3QkrWpEKWq88UBrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsNhFiJlqd6sF9_8AmmPVRoL44YR92YMQHROspktkdYtA&oe=69A960A1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5--PsyWlyJ0Q7kNvwHjX4u1&_nc_oc=AdnOW_FTp9JY_lxZHLfG-0ZB_8_rTrB6oz8U_vfwbQpue6sC7HYPSNRnNO_zLgnl3bI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvdv95zY_nsRK1s-IEw92DEvgO0P6prTRq4MTB5SwJA0Q&oe=69A964B1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjwQ8Nc8ihEQ7kNvwF3r9dA&_nc_oc=AdnyD4m9hYPzxIZqcVZQqVCruDWS1Fgol54PSVQ51wGATTC_PKKEUrRcUqhQTtzBHog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfveiIIg6Ih5wl8OmLsfJdxXNZM9U1CdJ0XLCWrS03-oaA&oe=69A9791B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmuDKve9QjsQ7kNvwHkMY-w&_nc_oc=Adk1TMOif75rfW201tim3tVTaGwef1_IAfH-5QpoAXy9croC8e9FTWxusjqX39IT2SU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuODoduFyzkFylND4v5zzPkzHLgYYUCOaTkoP8g2Z3Arg&oe=69A99216"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/
dn.com/v/t64.5771-25/38974577_1116705442768967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSLDbMKzJCQQ7kNvwHMePzf&_nc_oc=Ado7yjjvWCzRJdoz7Y0m3rTHngxYNnHnUiToU1CV5tTeS6dXpVZCU9uFVIfVcz9xBqQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uEmav3laA_vTyCjXCtqiqRb4tI5Eb43gl23PZEYr1Cg&oe=6A36A26B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B12jhgl9IXwQ7kNvwGb1MRT&_nc_oc=AdorQ8sdhjOA3bbuu48f9ic6-lFOk0FJLEkzBIF8uprmZ2veHdWGrn-TP4TPCJ_YD7A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80x07jdIinA81kkoLKz0LILBd5bzjMc1c9Dg502C78dw&oe=6A369402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bs-rrA4SvVIQ7kNvwFdNxhP&_nc_oc=AdryKTEEc5i2GKYjEMXHEt1SWfZEPqLg69LqmZ30WrKcOFiFclU4ThaWAFT4KDhAv8s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fdF5i_DI1xJKOGPVpcFpaFkSqPODoFZxyhtrWbHFsdQ&oe=6A36A961"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ivW2m5TCSwQ7kNvwGRS8sL&_nc_oc=AdocrLMWk3BH4C3wp7s_zO44mx0Vk9wXJv3Z9uxAQ09Acz1aHOoTgmA24Itc0mnjvsk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DrK2FgW6upi_WAH8q7Cr2qK0N-USQnhdVafLHHGrS_Q&oe=6A36AD71"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTATucbxrj4Q7kNvwEVdZCb&_nc_oc=AdpBS0Jpjz9IWolR-nWSwPgrbRwmd-SZuP-j3k49wXsSjnWx8Sc0r_D5MuNd4YOD4Ho&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jdoPRmnwyxTCzKRCPWivkFw9Q7ogn72PymfUiC_mAFg&oe=6A36C1DB"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJM8ZzGTRnMQ7kNvwELElXs&_nc_oc=AdrHYwfiiHKCjpkGig2-OgM4ffAW7ra-3hTFuGDTWrrQQxbjHyF2uaSV_GoVjTDWbWo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iTqlrcMbRWsnHRQS1JhjfyYL5EQv-tdS9M_NGCE5TXQ&oe=6A36A296"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "ima
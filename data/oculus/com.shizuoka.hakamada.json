967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbgmOXjj8ZQQ7kNvwFqeGd0&_nc_oc=Adm8Big8czrI3BD4mqkOrcutmonhdamicdXo7GPqj-MMJEdwbyo3LB7hUneut3APJJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPlKyizmOk7ap8POy5OXooKa6t5JmZ_nOcACopuEHOtw&oe=69B17AEB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFHDoRZVSvEQ7kNvwHoBIJw&_nc_oc=Adma5dJQPbKF7881W2x8rhS07Zg40QC8WER5dcefE4oAmIPchz4-OzZWVgywGPDLrT0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhCTEbTfv3Oqg8B2-6HEEUc2isUmK1sO8TeA5XUOLgWA&oe=69B16C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjAFlBhaqZEQ7kNvwE0wji5&_nc_oc=AdmllRPSrwtvgBdIrKjhQE0-l-YK9v8WibfMWAzNa07JkAUF6MssrjYvFNWy2OsmDqc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3DlEneJTYDf7d58vMkq9X-cqKw8v7-WUJvKfqVhWfcw&oe=69B149A1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jxiw1zBptDwQ7kNvwGubZZA&_nc_oc=Adm-tbP2DGYEhMnsBaheJ_bGAml2yGbp57kQRYe_9Zn4VE-ZcMXync1NCrIZhXVT4Sw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzM2AkfbnNbYp93CFMxAia7PYIt81t5_0nnlCHlDyJdAw&oe=69B14DB1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LizvpVb1FcUQ7kNvwFJJjes&_nc_oc=Admvaci54de8x3bmPUddqQGOxBbYd02Nboqi42_yuSdM3xb3EPOwfrUmm1ai7u7oMDk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGjbQNTCKmL8VXQ1tk1ysFRjoxZHrL-ciGA3mS6J5qlQ&oe=69B1621B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tX8ninq7b8Q7kNvwE2ftem&_nc_oc=AdkJ6Bg4oQAFdKv0o8I4iqG8WFi0eonowYz-kEOBRwoavx48Jy6TMfMHjsu4aoacw50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJYCAeQELVLBChkIPWOwGdDvv0k9EMhgHMxpD1Uxstqw&oe=69B17B16"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/
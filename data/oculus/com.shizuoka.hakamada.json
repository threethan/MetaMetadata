967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF8Nw8pZajgQ7kNvwGkn3Qo&_nc_oc=AdnicqYINy1eYZ1iTVCW1EGq68Gx14RcjUh2-UCHJxCvQQT0OKc5Bz6ozuBtKAmNgS4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLhZ530MWsmVPQNJezpp1H7XwAwUofJGXiH-qlNGUn4A&oe=69BD586B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoORNX47FMgQ7kNvwGl74Ya&_nc_oc=AdmqvF2y7k_k135nURsIcTfuHVUuKLqGs39ejIYLhZyYCy4dla6RQSEadBWorndnQjw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyae58Tj6wqSuTF7NGnHovUxL_G2ddXkpyAVpuhkomosQ&oe=69BD4A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_orP_H-_SkQ7kNvwH3mVKT&_nc_oc=AdkSFp19cNUrG7o3TUh5jfQrjTtMRmgeIW6dy2J8eNp1fzzP_5WWY99n2o5XKQKw-zo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy39s-FEVfG_f0uTnw_aVq6zpC9goRz9E7nqYy0O7TPBQ&oe=69BD5F61"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyIk14cf9A8Q7kNvwGUGbJZ&_nc_oc=AdkiT7RRN72M5Qc1qTOMcjhQ3dEwCvEvN8-DM7pVV1OsXMpafnISHVD_EtFVW6b49b0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzi8LPxC_r0bpnXhlMaeSO8Tn-1zpbM0dLAs_tkHqqPng&oe=69BD2B31"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZeIk5U2_D4Q7kNvwGD2Ndm&_nc_oc=AdkZbTU5UrTXX6RJfUOVQgJyWwtw6gVQGDdSB81hxF3p76YWTk-dzg_Gi7_K0ibcdnY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7LVaX8jxuJIcsf_xNpXBlVQQqDUBZSsFwuBfb5Gvgfw&oe=69BD3F9B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_v2RQ9ZF4QQ7kNvwFasujk&_nc_oc=Adn3BjS_sz7XX4EYVWI9q7YFoZmzC7q2L2VLN2wL-iT1vzvzrdiquxOgX0G98nKTl-U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvASztLiKRdx7hxlYaXRUl1aNMlaV__HG46_zAahwSWg&oe=69BD5896"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/
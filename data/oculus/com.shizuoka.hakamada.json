967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF8Nw8pZajgQ7kNvwEFCqt0&_nc_oc=Adn_YpTD4d3tJzYToLEi0FMaQvoHAyblmjUNBV7cDeN4BgutMPbEdIM2epfW2BYDJZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPeTDuVNqGq0Jwi7MSEYKGxGFJCEwYSJVR9SV2mfhBhA&oe=69BEA9EB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoORNX47FMgQ7kNvwELcd_s&_nc_oc=Adkcvf5wapX_e6lcHy3SM2KcpYSOlPWbTHoKEsVZv6CbXRUR2EA0UWnOsdE0GSuIhz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVUDmOovLVZ-SqGuJPpJgXmFgsJKVVg1nYGyJnQM23Ww&oe=69BE9B82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icFBetHeGtwQ7kNvwHNvWxK&_nc_oc=Admth_Ocao9P4kSAb1V1UJsrBl44cIQXbK9eaZqe0rxmcDvi5NL2cWB6xcqOa_VJFaI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0u5u76CWQ-MHPAMdXLqHAH9bFjt7jqUtlU0DXD10MWA&oe=69BE78A1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyIk14cf9A8Q7kNvwGFLVjG&_nc_oc=Adm9PloChU6k1ARa__iJpSy-C_uGFErzAdMcf2VP0aYNHbkRdOeAhoHNjQP0VCbE0Sk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeQcI10FCFw7tvIPWdpu3L2iiRhV7SJx05sRGC99YZAA&oe=69BE7CB1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C5fwl70364Q7kNvwFLpHct&_nc_oc=AdnVFyDmUeYQuHALFH1VeJ7eSPR6sK9JURyRgp4cL0zNTRrbaQgW3ECSmyCQ6tguIwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkKVKGqanWqwIj-X-uBhbfyY-CkRzTZCnAHsaLIg-t0w&oe=69BE911B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weIWddQLRSgQ7kNvwHcaSCt&_nc_oc=AdneBB7qep_tJP5uGT4U01rHR9o3pjK2cyK1RM2PcVvTH0Hax5Zx5yy_2DwxzrT4L-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi7KOc02C3YOgiYZ2MlasqnK60IAHSDwoX4AuhQBBzOA&oe=69BEAA16"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/
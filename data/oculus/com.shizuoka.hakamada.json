dn.com/v/t64.5771-25/38974577_1116705442768967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDtxFREeqMEQ7kNvwE1rQgk&_nc_oc=AdpqRM9HWrjkPvjIOdl3GpNMyAuYtsFzbAqyBl7fojDCOcDyVg77cnCiiiSAqd_yNbo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXmR_jj2mWFV5Ysqo9VP0TUDy8-wyhBJryjBvhfYHYfg&oe=6AAE9AEB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMKpL_15BjAQ7kNvwF7Fp6x&_nc_oc=AdpajvvIZpujUNppRj3TohWvqs9v5WqsG_O2ZLgzymqTk3v-UlfYoqRsKV7gmNdchVE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCwLmu0kH-aJhbSIkTLb5zvNnu-AyunI1NcPtelEgG6Q&oe=6AAE8C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICRyhK_2sqMQ7kNvwF8SkQF&_nc_oc=AdpGR01Nl2ly1dsXvIi8eJEaB_xj6Iphv9ioTgilX-XxKR2p-0cRaGohXVkx9AnSnXY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqIY7GIQF6DWtOS_iajNb5qNH9NIDpajq7Rm4_72weWg&oe=6AAEA1E1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-QibuqxKK8Q7kNvwHohro6&_nc_oc=AdrqbPaGyJHNYF6Kn9ddTY8OG562_Q_vc0sSQLUDf5NzfjjBZ4lBleAYh_l80XYsqSk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzkJdYZTRCii_zLmqS3zAVfNJ7xEnB-16FwLprgr9gcQ&oe=6AAEA5F1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp5gXfAg7psQ7kNvwFm7Odv&_nc_oc=AdoR80iQzMvFn5X3Fp5PbVE7zdgvf8X6C27DO6YJK6ZnOIKLPs6CifSzipFQPaCcCjQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBnVYjNNjffyqOeHqbWnu5D8OCFLKutYkkfKaMN0GrUQ&oe=6AAE821B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cpqrc9ZA2l8Q7kNvwEGmpWl&_nc_oc=AdqdmKrdiyGi3YceEAvMvcKGytYGEKsM5PSZLSBD_9L2Msw5sr1FGFlkC1UynCWnQh0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6Oc3EmQLE2FwT0xmPhqyNYzP8kQEH1UPgbi_mhMhJ4A&oe=6AAE9B16"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "ima
967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbgmOXjj8ZQQ7kNvwFOwBnc&_nc_oc=AdnxmWMxvqU66Eb8-reG6mQQrQYoqp2-fg6tEjAYTEBLDF_NxmyGeiqNh9TI6TvBt18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLbwHTvw_sC08E3LiuV95N7i029Ai27AsZjLUa-8TtoQ&oe=69B2CC6B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFHDoRZVSvEQ7kNvwFjSxk_&_nc_oc=Adlk0b4uWJxyaJP-NiP4uI8O0DL3ln9mnraPPJz_ovfE5_6CBAY0IGbglUDAWyOPl4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwO8-tVHwXZ_XRBLAsfhEom-_SKdOwdTEJ5z5owuyS1gQ&oe=69B2BE02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5j_bogKlQwQ7kNvwEQoDb0&_nc_oc=AdkzIm4yAsgdrHjsSBviDjstn8v_Hj-eJ29qfVWYlOjjTUrcz_aS_Ro1ecxNRDwdmDw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyCaV4-FpN3V3SgIZa_2i8SgmdkifGEKNocAM_jT3rpUQ&oe=69B29B21"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jxiw1zBptDwQ7kNvwGa5aqu&_nc_oc=AdkwBxDPuWdKCQ_KEzQSVbqyZqd5N4Z-yt7NigpUZhcqxumNhejzHKBs1vROPh-5alU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzp8TN3NfGhf0Rr47UnzfX6AgCQYacnNNmcXLBN0J9wfA&oe=69B29F31"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIUJrgHXKjEQ7kNvwEH_G2s&_nc_oc=AdlPkIk3UYqx_x0-SpyYoga5rUbgmjFwkUj8MmMetxjqARsU0as3xq9FhdzCamahUhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrLVVjLeOny76niSzhwOYZ9cbUYRVnAIOdSw77YStU0g&oe=69B2B39B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ1soF5r15sQ7kNvwFVzbHc&_nc_oc=AdmYrSgtKRqfayGI8IJMYV33aCh5CYqSQFhgB-koZDy8xM1p9MtcQCZ3n-aZBSIkG_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNKRmIl-cebHAId7xNHlq0jKyuUh8D1SOEnwZdOH7WGA&oe=69B2CC96"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/
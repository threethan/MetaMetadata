967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX0-JJe3n9kQ7kNvwE0BXzU&_nc_oc=AdrItuXPgdnCthe__asgxJWc_z9F1buWMxVrAYaIHqVE_KQbpSPMzgdhDpZ29soAhy0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwFO7V2hk7IU0ODE9AHS1_btDP4F60_y0xiEXsGsk_EA&oe=69C14CEB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7--7Lk7wP44Q7kNvwGYIZQC&_nc_oc=Adrbnjj73eA_3zuKz--8JAGIcg0iwl_XjntW0eUF-DyfLjTXB_oZflyZdWPE_6P6PDI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afydge_R0UnzQjM16WFugEC5D_4xB0oiRe6yIBKTq4Ve2A&oe=69C13E82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icFBetHeGtwQ7kNvwEzsEYi&_nc_oc=AdpvnDQpKtJr-MysLiO9WK-gn7ipI_sqJ6jU_ECdVCcYohPuAnCGPYYZZd1v_0RpFJM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwk0DCU6R3XeIfJ1LWvbVAMe4Q3qEKbJvU_TnJKAhpm0A&oe=69C11BA1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q6_MXsGoZ0Q7kNvwFZkf6W&_nc_oc=AdqrRzP_vhFFJYD3H0AXucL5caiIelYLgwemQLiicMyipQbCBtu3wxucQ0RQRIe0_58&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzesX22x3QEaaproh2bv_ct89ipMSb1QC10uksrt3uFSA&oe=69C11FB1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C5fwl70364Q7kNvwF3H4nZ&_nc_oc=AdpQsiqfbr11Nd41Zn35hN6ROGZpuTsHKOcC_Bx0QWQpruUwrmrY6bxkUL_hUkJwG4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBtTQLm--kbnF69bApyRPa0aYWXT1yO5JGe95C7UqeHg&oe=69C1341B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weIWddQLRSgQ7kNvwGKMhdO&_nc_oc=Adopwio61LJswSlHbi8A99IpITnZgqH-y51dqgkZNwg3RFWWo9kUFU1hc-upYJAAugA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyM_2BMVs6aCKWvxcSvCYfLYwsFy8YHPhU6svYcVg1pFw&oe=69C14D16"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/
967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3QVYbHYFnEQ7kNvwF48k0x&_nc_oc=AdlVhUG-UWTLym7Lvv2PFAdnBawEf7v3Yx56eflnamykn4EuY4gswq3ll7sm00EToP4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_ZInk42cZRVBJ0lFAdYRIxLp8kahzDW_pPHkkbh7kYg&oe=69BAB56B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WqQR81rKnwQ7kNvwF12dhh&_nc_oc=AdnLXNx2I_QqQZ9guVdWQV9LqNk0X1jFIs4J9Q1wVCC5F71csF7djWMeZSqMyhJ5jyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxbASNl_lB9z_HWXFtdp5PLUGBcWflJK6-DG_i-Zs49g&oe=69BAA702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_orP_H-_SkQ7kNvwE6VZTb&_nc_oc=Adl-PMqULa-vdTM6TO8XgKX7xMzFjVQbKKTJ6xryKs1ADdxhudL4xWgcyzC91vxMy4E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5QKgnHzNUozcN4RIZ6G1lb3bx_R66jWfKo2iujZ6aYQ&oe=69BA8421"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZA6_f6wHU4Q7kNvwGLMIF2&_nc_oc=AdkbAlEhKRuW0A6pQivF_jHPNephn9vrA5XnV7L46GLNaET5mZnNRm0hK3Cq9PmY65A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbHLyBSFwCWWif30xMPUtWX1cfQJH3YAXYXno6DPzS4w&oe=69BA8831"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZeIk5U2_D4Q7kNvwGqDE7q&_nc_oc=AdlTIB0nuIs7eb57HVYZ12PG4Zz13KyuQUHp1LyjYrj3pSFXh5f51Qax_y6Mk4Wostg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwc8nHS4iOZdONq0W4bU8mxfMvlRmyGV_dCg0onR6fYew&oe=69BA9C9B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_v2RQ9ZF4QQ7kNvwHJVgAz&_nc_oc=AdkT8XiYHWFwEpZDJpj4Ux_lZQUyJvp_Be8zD9Vrqnqf8YoajQ3vIEdsmT95J-_PlNo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8YmyRvY26RvpwvoXa3WIv254efOkGTCD3U631lMDyqA&oe=69BAB596"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/
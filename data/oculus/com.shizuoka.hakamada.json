dn.com/v/t64.5771-25/38974577_1116705442768967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuzMT_MVPVQQ7kNvwEMjQ33&_nc_oc=AdoHwfiKXbGFeeh6fQD6AxG9DOjwbQgeVQBWvX0kkJr8B_m5Jo2SrqpH_Dbm_PB7AOk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GMpVu4Wz-5QPWqWKIOyBcGoDnKB64wAzskAHygNyWeg&oe=6A46746B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccVDNKIQVHEQ7kNvwFW5R8v&_nc_oc=AdrIqC5wedoZnTmgl03xcoWjSxpqYw44oeYEJ25erTDXDkigfrPHEY917BmEQ5NwJK8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b2IXz2xOxPq552T3lIV5dgua1i8hCPkcUBYIO1ODDrw&oe=6A466602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3COq-WSoSIQ7kNvwF3a8YB&_nc_oc=Adr4Ada0XxUbRhyY6-FdJxv5e8rRn7YBVxJ-LRmmmck400KwIaFmH4izBUvPThHD0U8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-YXtVA59o0XTfYCLmg0N_tKiek2y0RpACn9Ed7zzC5Q&oe=6A467B61"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAICIzpAalAQ7kNvwFcKj0M&_nc_oc=Ado_Yr6ql_6JOr6Z55k4kwWvdlITlaEQ2aHr5yDPY0vrOSuUQHg4YNrDevVefbHqjDU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KrBlTu4TfNM74n0UkD_-BQ0A-vSwq4idMmkQK-LKOaQ&oe=6A467F71"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy7GoBhaM1kQ7kNvwGpxukN&_nc_oc=AdoVlqlyTQZ87E2Fqv1KQR0ep2KQB2xRsowb4PgQTLWHeLjvjrhd4bk9LYWARnYiapY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sdKxgprE0yf-0uNOK5PlTFH5MJLKt0HO0ggugxH_JmQ&oe=6A465B9B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWEAPYCxqwsQ7kNvwHtOCPE&_nc_oc=AdpxMnmetXftr9sX5MGSarwQ2NafBE7HTAXxjm8bxvVtC8dQwc_-bPQaQDiw83-DC1Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MF04dMLcfjoU2SJml6LUR52JypFZKHBSDaKEzlcwvqg&oe=6A467496"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "ima
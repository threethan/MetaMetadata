967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbgmOXjj8ZQQ7kNvwEp8eF7&_nc_oc=AdloekTC_YfGtAPgbEzBr4jQB99x3a3-fHnyxGlqR1-QlyOurSuAJKw21GlB-li9wKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzoy6H_aQ4cFH9bZrE8nJw7H0INJDI-WspMJaDLyX04jQ&oe=69B0296B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh1N-kCW9yMQ7kNvwFZF1s6&_nc_oc=AdmSV-JRsMoNYH9BcKJs3EG9z89JYV5_O6q4ec2r9pknJX_df0OglVX6s90D3fUt_zY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-Rp8tweC2sT7G3EVa1OfcM5bXvgnWWLaZc5RFHMpchA&oe=69B01B02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjAFlBhaqZEQ7kNvwGcsU4k&_nc_oc=AdmOwHaMshMy7h60NRaWBcPnk_zJX58YEKDQ6-fwsw60ii9xZ62nJq-dnd-jIAVx-hk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdEyfIjeGvJf08eiSRbx1bmL2jQC7e82ASTuGf8DlyeA&oe=69AFF821"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jxiw1zBptDwQ7kNvwEL1bzX&_nc_oc=Adlkrpkc8qssWos0hRvQaIuhk3dQ0bA21ZzM7wkB8FIlBEncRuW0f_AQvEQ6WnUqL74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaOwcNAbEqElI8nHRgx1MPzFpNC3sPX9Sfqyi-Vqc--Q&oe=69AFFC31"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LizvpVb1FcUQ7kNvwEhpMew&_nc_oc=AdmaVmKBGVXv0Biu4iJx2ftJx7izjVSF0qRNncn0ZnwBndi8KrjUKuGiyofNEXFyURI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyn44Gam0wrwYMjNQIy9Yi0zXtFvSpVOxr1sRk5uendhw&oe=69B0109B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tX8ninq7b8Q7kNvwFEn9iV&_nc_oc=AdnY8ENoVKC2jKGwVPh8BkdEMqplXesFDcHvUK_HcsoyALdji8CtamIkuXx2My9FOMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQBAdEzcgwkkLS0bpkVRP9umnS3WBFEb0kB9w1jG4S4g&oe=69B02996"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/
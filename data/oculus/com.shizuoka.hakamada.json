967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3QVYbHYFnEQ7kNvwHJJWCE&_nc_oc=AdnnIYjyS48DbauIbiwZwS5gDNlkOGSNl7DUgXtWns7urX1YA78XZ0lYLwOl9OL3Uh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEe1Xp9C5uzXH6QSY32U8jrhhkiKgllHY2DWCUHzRzAQ&oe=69B8126B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyKVUpFFYMoQ7kNvwE5DWFi&_nc_oc=Adkt2vy5GPdihq_-Fa5q_gQk7OhVQZWk3ZGQnxco401U0ISO7alOMixP0pDhgb6eP6k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzxwng_-ZfHF5mfbdWzez7Hr1muZKpNzxcQGZH77sAJcQ&oe=69B80402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-ORUFBT8GoQ7kNvwFDorqW&_nc_oc=AdkpeZPdFWLJUhw5Kt3-klafsYZF1QjArQTBcSdIPrhKVn9yCgh4VP3CZC_qFl9tVw0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_i5Kswz7x7xkPIj5YwSPV3WvFt5iK9v-E0I22PvTb6g&oe=69B7E121"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZA6_f6wHU4Q7kNvwHqpCrG&_nc_oc=AdmpXbNjITXsM53n3JqnzBFpfL-FFBNMU2s9hPp1n05sWe9RQf5SVkAAeh4kdV2Obfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2UXW2WiJFGFZBlqsPLqsdIbG5UgddrXwDSc871HZI-A&oe=69B7E531"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh4Giwb22-gQ7kNvwFVjTVH&_nc_oc=AdnZIGFxbWo_jvXLVVhtrlqZTDffWTrQ_pQJghRGsNkNC5qotnIOGBxVLR_HlgZY-sk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0kGfRdEb7KFZPNzTmg9soIxF83s3o80cefEMPhjSGQQ&oe=69B7F99B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adMlJxYL6dAQ7kNvwF3P2U0&_nc_oc=Adkts6yYC1pwJ2Kzbj4jz7V-2xBLL__2y1BpFsRU1hsyiShJBZj1MvcqGm4DRkrXCZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGqzQuSGEqFZ39AzAZIS9QHf_BskUPfQmkLI7qkSCZFA&oe=69B81296"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/
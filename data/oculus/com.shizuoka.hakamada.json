scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-wq16-4IviiVa_XrMzNnL1fYlH5uNEBlO_Zw41u9YfQ&oe=6A918B82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W87dZe5mrEQ7kNvwHZ3uT3&_nc_oc=Adq6U9E431CNqpolqTWSSwHDE-a9fHRQVviPcIVw5MvTQ8KQkMr4LqJA06yCJLglCeo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6mpfQeycBa78WJemVzyaUi6EGmr-5XgbpjhizmnahkQ&oe=6A9168A1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-
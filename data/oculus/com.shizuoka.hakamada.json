967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3QVYbHYFnEQ7kNvwFEyo7r&_nc_oc=Adl-SYsl_Lqgw9NHcf2QmLDHYbXQyx5jMxZZ491pWEUtrlHYK4fBUAliUNrk_mVb7Dg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzCaSaypUWBlxG7bZ1kkfqdJYv4vCL_O3hAS4Djk3Jfg&oe=69B963EB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WqQR81rKnwQ7kNvwGbWK1D&_nc_oc=AdkRopWfbvRhcK551jWXSDSUIJt2dIgZ-v8zZiHdcQeETftzak3WojhOn02d39nSqKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzmjbpe6d5oVzHpSZL9ZdzU-rf2x1bIiZFJHWdBeeihwg&oe=69B95582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-ORUFBT8GoQ7kNvwFYsqTr&_nc_oc=AdlR0Kt9y6I5j46Gyj04Gj456IRYsBo9vnMRNFg-BhI-pyeEZ7XUxoMqA0Gkt7YPSXc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSBd6BYQM5HUwbRgxqZM55JIb0gDfmOZ56ibtR9571TA&oe=69B932A1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZA6_f6wHU4Q7kNvwEGNUrY&_nc_oc=AdnqGm-1nh63AXbsHebQ0k5OwHX4TKyiNgFfwW2o18_4iI9JjK700go-_uJUeYAAQeU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzYId7zytYy8vuBjUfeBjeN9aRNsf7qQ6B1EPqAXcIdHA&oe=69B936B1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh4Giwb22-gQ7kNvwEI2PGM&_nc_oc=AdmW0lVQJ5evuxn5Io7qmHrhlvx-gsCgpSRP055tcUi7CqhvPDMh_LSSDx-o95WFhwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPzObiHuGHdlbovO1IaUT3IrSkcvzpxHyN7vwhiwptSg&oe=69B94B1B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adMlJxYL6dAQ7kNvwGo1yBN&_nc_oc=Adk9ZIA-lDxz5mqcwinm1zPxJ6P9Ydd_XPbWuuChJeNFXZFs6_TL_Od4raJB1LrhbnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjAGt_f83tdMm5P4-9SbOgIRi8qAYkBFKH9_q8J0QKjg&oe=69B96416"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/
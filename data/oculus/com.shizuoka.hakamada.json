967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFgHwqDOMosQ7kNvwFKMNeX&_nc_oc=Adn_5E12I2nWHNRMnq7rd-7OUZr0s2oraFXFK9miOJC2W7gPhiA_jRS0VTkNamEN_eY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-p9rQhx1PZDiLmgWj_wA_Yfq5sLDIK1LUrPbX1B4iPw&oe=69AD866B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh1N-kCW9yMQ7kNvwFr5rG4&_nc_oc=AdkX_AKPjbz0i-SKGkv4QCXYfhiXhHHWmcZsjLNdIJZo0hQIBO45Dn5Er68VDx6Pj5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIek8YBdZG3QdgDbLIwTu-s6n25twUxoXcdQbXFjajfw&oe=69AD7802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94macDQqsJAQ7kNvwF0oBg9&_nc_oc=Adlq8213ceHoGsGkshWyksbiuP-iLS7c-TqfBnKFwFW641GbuMwT_WTkVfQVB0jtqIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4S5j0nUcdgQiybKfLdcJPzOxe6GEvkRAz9HqlywmfJg&oe=69AD5521"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud53yAQYY3cQ7kNvwE_5jDW&_nc_oc=AdmCraZHXuG-6eBvvVKe3YzETzImlGo3GH0-PwpN93HWdcC2N3mb-5ipKgsgwU_s4mM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwy4J3QarsOJEBqDzZytQb-CzfImJfJThtp-Cjb2F3eUw&oe=69AD5931"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB9xtDi6StYQ7kNvwEm6BTZ&_nc_oc=AdlPqBOUKNbMIX1Ubj2yRGQvkFE3WdoLIukWxwnQQAXcj9lh1h09s_VfuWzrPlt9NXE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-u6rGGrR5QLib-e1wKYRuJyUIEB4pdYNUbLvBqMSmeA&oe=69AD6D9B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUMcQCk_kqAQ7kNvwHNkbx5&_nc_oc=AdksPbENMvWEPTjXOEnTqERBZQmuHCH9SqUThKrhvaRtPzvvXKgMGSThMJf2cRApBBI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrYh7mD5UqeJZpmHi5_C-L8ZZIVK4T8-djDJxxdoGmLQ&oe=69AD8696"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/
967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFgHwqDOMosQ7kNvwG4Z1x0&_nc_oc=Adk_u8k1xiRoflEe96zDR-WGsQ0ys6X5OGT_Mwmdmt4CeFoDz6bFCdBhXNdD0M1-TH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOw6Vjci098lNv96-tAQ7ZVonCWh2F591eLigaM-CZNQ&oe=69AED7EB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh1N-kCW9yMQ7kNvwHrSPI-&_nc_oc=AdkstUwiKNdRYYM70IkFULJHEBYjEKlMT8uA8kqfdyIymAo2D-WHt06LisbUVW6pGUg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNyuFgcB3Ak6WnmZmtDjrKtAcO22TuAzZsncBXZKmizw&oe=69AEC982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjAFlBhaqZEQ7kNvwFjhZKD&_nc_oc=AdkWgAF-Dk5srA-L9NwQOsiY3IgHuz-RiAAq-kv96g3CPoQxf8m7MnCxW_gXnWnQZSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2Ns_weeoKlQfrMwJJeVwqLCTHTiyhYYSnZ33MvYsGmQ&oe=69AEA6A1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud53yAQYY3cQ7kNvwEIJmlp&_nc_oc=Adn5roXqzgZXuH79aF6vYfXrb5rHKZasYiu1iyj4V1HGdEMqkrpKVlz8WM1UYgwumJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDmIBUkeuH8SDongI94YMZJ82FVEDcjNJUTtIH_IX5ig&oe=69AEAAB1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LizvpVb1FcUQ7kNvwHUf-zj&_nc_oc=AdkD9qJ1I2fHNNAWrHRRJA7tRK6OSHqu_GKuX4I_nEKnVtypg3gExqzA5o0m07cprUg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCEj3r5rdfLNbFWyOSJWUY-WxYZILs6yoVCsl70lMoNg&oe=69AEBF1B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tX8ninq7b8Q7kNvwHE4BME&_nc_oc=AdmeUoAM7CH0NSpkS5A_agpRyCNT4thbV3R1w1rvcyHC1xZNZaKA3ulyb-BzRi9CKk8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAbr9NbTqb0RL7LA4uQ2EPVcFoCOM6pI60ZpVSUKXrKw&oe=69AED816"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/
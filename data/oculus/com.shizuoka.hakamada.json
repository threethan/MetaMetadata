dn.com/v/t64.5771-25/38974577_1116705442768967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIGUM9QQ4yEQ7kNvwFc17UP&_nc_oc=AdpEKgyTJUNQh2DnZKvP4NGiIWgWx0a5ESZ5RVcjhCIghOn0HwMAxJvTNhlWlbWzCx8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgvbVxRXce2ezMqnokzd4GAYhM2sGc9kBH-p7DvsSZBA&oe=6AA954EB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=690L2f6grGAQ7kNvwFArNcB&_nc_oc=AdouVHI50bp4DwKCCjgVc-ztUOH9dEGonXZOTII-Zz072CAMtgcmDiFrGy4vg_zwNOE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUmy3Fp1tR0a-ZN8fFMBk0grpoWs1Rbzb3e_WWlsaQeA&oe=6AA94682"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D21NieYZpe4Q7kNvwF_Ca_q&_nc_oc=Adpvr-lFvc4m89Kd7u1IwLooGsHlljC3D5K4N1QQbQCglwlor3Gt6evQ7m-RSY4TbOg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCzY30VpOKcTYqalAFJAkol_zhwXsELOHJ0W1kvMJD-g&oe=6AA95BE1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzk5vniQc0QQ7kNvwHT61-2&_nc_oc=AdoQNRmLEtJ_pFta2c2rBWXlwrsC4EmPtE2EkSwRimtFJBoikl4yvbQRJ2qx3_7d7iQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyNZznjiUyJqnyqPUZfoYTV-5V4lRz6va8x1ir2AfKIQ&oe=6AA95FF1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfsY9r7-n40Q7kNvwHVL8sE&_nc_oc=AdpH1K9JLLe8Dl7Kj1trXi1u6MJFoKh9umy01NLUi5dueBfLA0hFpTV-CHLhUf-92Wk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2l0RIuaD38RF_rHmOcpLLt0hmbzKfltcbSyPAPNXY3Q&oe=6AA93C1B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLguLADZVV4Q7kNvwHMkutg&_nc_oc=Adoa6BhsjPk5iZZjpkp5SXdmQtSPNxq8oqdYDIDdSSrz1ViguFhWYc4nbTK67ZSCHes&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0D2-egodK0Uqq4QMx73-8KpIPp1_lLZnIxI2rOnyKxw&oe=6AA95516"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "ima
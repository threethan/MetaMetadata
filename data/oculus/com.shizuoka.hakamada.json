dn.com/v/t64.5771-25/38974577_1116705442768967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTtGuGr3KAAQ7kNvwGjvh1h&_nc_oc=Adp_ZuGoQ3d-I0WALD703hrm_wblQIhI_glysutKPjrxotVPNE0IZa3WisSRmlTHVbY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gkxv4T7rFhBTj_a1zsFQbfKPjZHHYiMoTjqCaxm_cEg&oe=6A39456B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJRnZTUoeTAQ7kNvwHLhpVB&_nc_oc=Adow8qSfSFeh1IMzMLhxA9mGQo4iJxQJcUOqSF0uybWqRh1vt4H_6AM8l7IQTyL6HdQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C98csjIYwGCUMzNpO3UnGty-YKc7WVutguTUP-hZAjQ&oe=6A393702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue0f1ycGItAQ7kNvwEqeyxu&_nc_oc=AdqgmBFBBmJEwDJpxzmFmg1vQKS_g_2fR424VIY6kbvecx3uWIcWhd_K0zn4-KCFR_w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sj_Tp5g5sxTQISDHTuE5AlHDwTLOlQ8nv2IUF3p1ZxA&oe=6A394C61"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ivW2m5TCSwQ7kNvwF3eKvN&_nc_oc=AdqYixXODPBbul-RAkZIWJ9tcZX_ZxOhdfMThQGNKYndOoOgMRlG_KwAr9-BY_siEwk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9we6lCBEcmU75tR9TVCUhHix0iV8BW0_xvNsqaEy1q3A&oe=6A395071"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3UeSzifPCMQ7kNvwFj9TDF&_nc_oc=AdpamcLC1fo9waErsfNdZUzgBaa-BC846flQ_RR8xF34hT4XqvkaQBB-d5uEYRdUW8g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IDcgd0gsk9xhNB5uzV0pso4i_NQHLYtwweyu5WXW9Zw&oe=6A392C9B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_3Ax-y1IMYQ7kNvwGimPjH&_nc_oc=AdryUf5s7tmuQMpqEFgp7_2C7_QhyLeDrwzyktIjl9NBS65fuoTOJevRG_ZfkIM1pWs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P9p3FHikBRdJk9vSV6e_vioKEFQIsq7pqeh02RBQRgg&oe=6A394596"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "ima
967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX0-JJe3n9kQ7kNvwG8kvF_&_nc_oc=AdmqL0eVQ9IvxRR-W-BChvWS-a9ytD1erflTnlWBVd8ks5Z1RlII5Shha1IEK96iRqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZqw-xyE6bNTw1yuAM26XosxjhHqWKg4ydLbgYfIaiGg&oe=69BFFB6B"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoORNX47FMgQ7kNvwHCGqYc&_nc_oc=Adl4NWlfW-24Jwk4yMmYFp8Ak-R0mBMSOo_pSf6ZQQxrVyPdvisYOn9-myfcJVLrdB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4iYfrB-T9kUFiYl45SO_3ptuucjp4hmBr1UZgbUQdYA&oe=69BFED02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icFBetHeGtwQ7kNvwFkwQah&_nc_oc=AdnVE4DIJ5F2Bf07fDKAue30mspJ8HgX9JOlWTy6RLZK_gkVEHpA27eSbc9QtLnyYHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQXpV24BdKJNaqgqIXffO4K5jQB8Bbz2S2Ea_SiH1AfA&oe=69C00261"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally publi
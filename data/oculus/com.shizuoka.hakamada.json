dn.com/v/t64.5771-25/38974577_1116705442768967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtXBR8j4J20Q7kNvwE3o6l2&_nc_oc=Ado_m7RkhcD-WgfPjNAyJdqmHz1N9A8Rwn5nJH0stWNsdJrOhqU9omg-Mswk2b98oJk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AF7QbTdYRA4xAKSRhBi4-6vZ5JK0IjpYWyRxpguuOxw&oe=6A22DBEB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUqgRh5ehz8Q7kNvwGxwOOz&_nc_oc=AdrFgeXktA1a9dOOiISurhch_zODYD6yz-Q2raHwT66xM6Hl8A-6LIKR7zbPRNDdEp0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--k-N7z3fxojUZTFJiV8M5mxEObbaXHy7Ev4VyuHWnPQ&oe=6A22CD82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0GZZ_sOndIQ7kNvwExoBPD&_nc_oc=AdqD1aE9lx_EgoMy0OuuDs8H0qHDlAfJ9drMgoTdznmTqP9dHsp_Op0wSN28j5mOENY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jPrB1NkoBCdSfa9xBpx1V8ZgMrF7BtdGc9XD0mhBQbw&oe=6A22E2E1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhSFUelfJuQQ7kNvwEZwyyG&_nc_oc=AdrL5jjSukavoSbPPO2NC9YV1SL3yy6DY_VMYJha4H7rWmX8ru86qc3JwAJtoiRtHAU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ts-76L6qQnh8tvBhy5_qhko_ltt6A8FTANqkduinQQw&oe=6A22E6F1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dqQuzJvuAUQ7kNvwHCupmC&_nc_oc=Adoe13xN3o28GQL9ONjyVJECCIRker1ypIpuKk7Rz98YKoZe7eQ_w5KfGmesaCgabys&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a3X_-g8epUEbhHSFGL1NGbfRKkKeoOs3jaf1jyoiurQ&oe=6A22FB5B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BncMm0RHfUkQ7kNvwFpXwKR&_nc_oc=AdplguQh2Y7RiWlkwZvlEXOgoEO77iT5yMfTswXmht6IXKK1zpeYHQo-_LWkgwRKSdM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UX-O9X8ajHKT5ZQ1BUZrrF7o1BphHTjEFNWokSORTtA&oe=6A22DC16"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "ima
967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFgHwqDOMosQ7kNvwEN91c4&_nc_oc=AdnvhOlRQOFOYseZWev8ogo1ONFudW3RDf3nDBMlR1ACbr_N7YzVku85oCB7mGh2cbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaGYSJbltHSA_7CFVx0Ld2rZ_XmaMgV4AJNSHYa5GGaQ&oe=69AC34EB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wraPuPxpVIQ7kNvwHvulYW&_nc_oc=AdmQVcoiYg0LOrL7kC_CGV_EzQ51R1VLcs3_KDijiSaCL-Pzigcb4J7VB68MHY-N7uE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwP8-7e1aGiJhOmrVg3q8L8ONBFmBz-BbnITbVkslxRw&oe=69AC2682"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94macDQqsJAQ7kNvwHpu4qc&_nc_oc=AdnS9jlnbqevhTw2Q5SeCTAe23othoHfGLLzfxgps5qHEEu2dXpm4kCOL8faM4ZCT3c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxc6Qx8zUJtf2Pmqnm7M--mcEPav1OYyrnCafOzNx5gJg&oe=69AC03A1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud53yAQYY3cQ7kNvwEKIlDt&_nc_oc=Adn__8yiSZrLNm5v6hFaRq4khUF2BSs6sjqfxv3_qlNE6dZLZipdK2o0WrOFR9j8ps8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaIkig_FbE_FCXYD7Aq72hjzPhBdiHg-WK1we1bfr6eg&oe=69AC07B1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB9xtDi6StYQ7kNvwGEkvSc&_nc_oc=AdnIIjWwsAZbkXstW44MM5FNRgAf5iSNBnIvIFAjf2084564HlxPpOb0h79jBVQtnC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4coDiM17ghcFL26-G6W0KC0iiKavamZR5JJKO9XjgVw&oe=69AC1C1B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUMcQCk_kqAQ7kNvwEklRRa&_nc_oc=AdnWqP6ETzGnjK8QJBSKe4ZkAoXe8bDQY9zJ67y2XijRa_U2LtyOVmoerDDcQZKFasY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwhjZgzjFaEghW9lLvd4bvqBXwRQMCGuGvmBCfJw18lg&oe=69AC3516"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/
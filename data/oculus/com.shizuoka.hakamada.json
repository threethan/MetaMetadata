967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_JFUKcdvRcQ7kNvwHjch2I&_nc_oc=Adl7-EpKT3kA8HbMiomo_JDRBdn2KUT5FnrD831fu39mTSOHlDJ1EEcYjn_RWAVkRSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXZnWNCRWlvyvVsJN8RtXEe1ggteHwOC-TJmRkhMvd-w&oe=69B6C0EB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyKVUpFFYMoQ7kNvwEzKNgb&_nc_oc=AdljVQuEwL9fU6BFfi-BMifPWar4fDkoR2XzyzhZpkQeoBnSXdWkvTa9bjYS_rP4lGo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2qJGo9v_Z-YkxplwBGujCTJ2dxmisgaCC66Buzj6bMQ&oe=69B6B282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-ORUFBT8GoQ7kNvwGMGCRo&_nc_oc=AdmqHv0vlhFCILDBF1-YF6lOtVtfwCMsiCWnLUOmz8--O4cUOddh7GGuZZ4n6oFN_oI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfySgS68QX5cxjEvov1rER964t0AS2caAa3ycqS7RQb2Eg&oe=69B68FA1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYJt8Alb0MQQ7kNvwGVkrU_&_nc_oc=AdlwfApZOeibxoagpi24ALnez9eroNXtrvpFJ9CiCRaw1aXb5MZgZsYwpoRPo9lNRKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyf4UIBIbDCN_q-5ZDEdD6I-dlaQMYTcONeKU_eQ8u3MQ&oe=69B693B1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh4Giwb22-gQ7kNvwFhhTg1&_nc_oc=AdmrhD8FcJUIU7NES4D0YDR4LWOZOHIgq8jcceNOvELuIRBwOjVnE10595peGNjiLjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmupaDiIz8o5duSArOR_M4BEHBC2p1Lh2to0d9x1mUPg&oe=69B6A81B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adMlJxYL6dAQ7kNvwHtEsnM&_nc_oc=Adnm9MFjjtUxM6vxopHk662bU2rZVXgduSCCyD32ydE8Rl-ZnVuPHWRlLhVx2R7grm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwu2Ps_xO-rwxokv8IXCFoSkQefro8RWcQdyUZoqnU04Q&oe=69B6C116"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/
967_3048739830427570595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF8Nw8pZajgQ7kNvwEmKm3S&_nc_oc=AdnHYYFOSVrfcu60-LodtlLyUPlgA20MM0OhEKq9Oy_O9IbgdqQKlufcZH_47JaAOYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaGmLhfq3xGx1NG1Dm28BD8oazw0qLjCF9SE_Akxcjvg&oe=69BC06EB"}, {"file_name": "ScreenShot5.png", "id": "1723978778372236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210389_1723978781705569_409548563003269241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WqQR81rKnwQ7kNvwFivkB7&_nc_oc=Adl6keyI5WDnzgH7ty02zwOmjfFoyu9jDkbVXvHq0Qf81ED3Bnfqxa1jU4b7JiXUbRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxF5XyMi1cv-CKAitaFqdi-UmQuPXSoxJMwYnz57_22Ng&oe=69BBF882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaigotonotorideLandscape(2560x1440).png", "id": "780674754231882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982568_780674760898548_1115309042069381758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_orP_H-_SkQ7kNvwHrIUHl&_nc_oc=AdlVnVDD7dl8uJTZ6KziKVb2jI_5ei7OnKH0mo5-oknohWQ65T5CU25e0Ib5kJZT1os&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx1AaA9b2-kHq5f0D5TvJN-6UX5P1blR2VoCbPI7S4mfw&oe=69BC0DE1"}, "display_name": "The Last Bastion VR (VR Hakamada Case)", "keywords": [], "long_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession.", "short_description": "We have created a VR experience based on a portion of the campaign series titled \"The Last Bastion: Criminal Justice and Retrial,\" originally published in the Shizuoka Shimbun. This VR experience, essentially a \"VR Newspaper,\" allows you to explore issues in the retrial system in Japan. We obtained actual recordings of interrogations conducted by investigative agencies and recreated the harsh interrogations that Mr. Hakamada underwent at the time, which heavily emphasized confession."}, {"images": {"nodes": [{"file_name": "ReviseSaigotonotorideLandscape(2560x1440).png", "id": "24437448272624182", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_24437448282624181_8955605117626039896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyIk14cf9A8Q7kNvwFiVFIn&_nc_oc=Adnyfepwof9gLCnZCu2KsYY3ndLoNKgiZyphxoWtSVIND-C4eeV4MOut0nNBL57XBkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzrJHY5zI7cMONlIRKUZL_VGImXww3lvAByjIQcUPRXWA&oe=69BBD9B1"}, {"file_name": "SaigonotorideSquare(1440x1440).png", "id": "1515797782644837", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1515797785978170_2887062265356263178_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZeIk5U2_D4Q7kNvwHUXE03&_nc_oc=AdlStdGhgZRtd7prYEz_vCVxO-KkY4S9Hb5ISp4UKYe5GRqU6Ec07Z5bBPv7zlTeH8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZ5jBWyur_0UxFAK9wBI62PAi7G_c5yhb9kw8nv0AQLg&oe=69BBEE1B"}, {"file_name": "ReviseHeroImage.png", "id": "1375408020965991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825050_1375408024299324_4176912590361696383_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_v2RQ9ZF4QQ7kNvwF6-a5z&_nc_oc=Adla4XzP6PtF5Yo2gBCWNxYr2h5RdDLmdfYHVsFGKnhmHoMqlrupfITdfZvd4ey4RXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1huj57qlmQX6Ssso8exSmHUgg8EFSy4gGZ1SuxuFx_g&oe=69BC0716"}, {"file_name": "RevisedSaigonotorideIcon(512x512).png", "id": "1161884015866490", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/
ad6-1.oculuscdn.com/v/t64.5771-25/491819356_1799036914097603_3492729496526893971_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8zhcT5a-C4Q7kNvwHI9laF&_nc_oc=AdrWbIMbpmSvVnS1HA5Ib2NHV8nbnj7tvsjG527XsGFRHkUtmslxV5IgGCmyq0cbY6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtg5dkNn57RwoyjN78U2MPeuvh9CYf2x6wskV2vGfC5Q&oe=6A675E9D"}, {"file_name": "Screenshot 2026-01-14 172042_2560x1440.png", "id": "932566585958619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_932566589291952_1904419284383482747_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5wQlmWiJswQ7kNvwGqzczV&_nc_oc=AdqkdgZHWdQk0gc3xtunJvJduGT_M3QRMGnpcmmEyDEvF4uZ_Nqe-A8VDtzeZekR5X8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMbzpcjPVW5jbAxthI-TEguA_IF2HnQ-tgVCRn6GM2JA&oe=6A677A45"}, {"file_name": "Screenshot 2026-01-14 172055_2560x1440.png", "id": "1798140977549997", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1798140980883330_6666212417146499664_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmlCtymKtisQ7kNvwG2Z3hS&_nc_oc=Adqbj9G3qyKui8Bg32ws_2WtenRToVli4JhpFaRvxfVqKccYuVYQLegz2QzIcwJs-Y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPeBsDE9YJRYm5RzZdRnSMfJEVCHipyas_ejHdRwPE2w&oe=6A6775BD"}, {"file_name": "Screenshot 2026-01-14 172034_2560x1440.png", "id": "3444417889038846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_3444417892372179_3019099473515539841_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xs4YLin8A3wQ7kNvwGGZBeF&_nc_oc=Adqfd7ckzCeQcBmkRGtFDVj8H6ZCBz82IMI28CeFx75pvuDqFbNnkViRE5TUkmEoW4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxx3l7GtFjO364jXfpSRhuQwM741yHXFsxhmBoNRI1fA&oe=6A675272"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Velocity Runners", "keywords": ["VELOCITY", "RUNNERS", "LOCOMOTION", "movement", "armmovement"], "long_description": "Welcome to velocity runners, a high-energy VR movement experience where your hands are your only way to move.\n\nBuilt around momentum-based locomotion, velocity runners challenges you to run, climb, leap, and glide through immersive environments using full physical motion. There are no traditional movement controls \u2014 your speed, control, and technique determine how fluid and fast you become.\n\nEngage in competitive tag-style gameplay where agility, awareness, and strategy matter just as much as movement skill. Whether you are chasing opponents or escaping pursuit, every match is dynamic, intense, and skill-driven.\n\nKey Features:\n\nFull hand-based movement system\n\nMomentum-driven locomotion\n\nCompetitive multiplayer tag gameplay\n\nImmersive environments\n\nHigh skill ceiling with rewarding mastery\n\nEasy to learn but challenging to master, velocity runners rewards precision, practice, and smart movement.\n\nIf you'd like, I can also make a more competitive-focused version or a more casual-friendly version depending on your target audience.", "short_description": "A fast-paced VR movement game where you run, climb, and glide using only your hands. Master momentum, outplay opponents, and experience next-level freedom in velocity runners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/velocityrunners/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VELOCITY DEVS", "support_website_url": null, "website_url": "https://sites.google.com/view/velocityrunners/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
5/499618264_1901765627083593_6650175356007638038_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMNpxJWrTXMQ7kNvwHSYcEx&_nc_oc=AdqkMdde3Egv0GS5zrP6ezE11eRCn5RZ5FQKLH8MwlmGGiGnTg7vEf4mlAa1g55ukzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiEUlMdMGUscOlZE5_6-aXpKmp6bB0btdNru0ImqxTHw&oe=6ACA68AB"}, {"file_name": "com.pixite.cubes-20251024-112921.png", "id": "4197122430570707", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_4197122437237373_600924481414945387_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI-j8-C9RMsQ7kNvwEHR59z&_nc_oc=AdpqlA5gTHkUe5oq86v-D0WzMb4Tk7AP7e8EW7RRJ97B6wzh-ZT3LL8nRYTPq60z0Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-M-VbuO6n5Mo8z3TEzZuvdviT4Z9L8aMgzWc1o4LDlA&oe=6ACA435B"}, {"file_name": "com.pixite.cubes-20251024-102235.png", "id": "772495692412262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_772495695745595_7563187284033841743_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX07ayDQ2VUQ7kNvwFG1JxO&_nc_oc=Adp-DQ26Cr0VglBB7nCw0tiIyNirVNqQgLLfAuqnaBo2Iq561HU4v4MFdnAvCwna3A0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiET_m4kGgWfG1rpTNtGi5zqVhxNbjTLYV9FbGoeKang&oe=6ACA5F8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cubes - Create 3D Designs", "keywords": ["blocks", "3d", "building", "voxel", "art"], "long_description": "Let your imagination run wild with Cubes, a 3D experience that lets you use virtual building blocks to create meditative patterns, castles, fun game characters \u2013 anything you can imagine.. \n\nBuild ideas, experiment with shapes, and explore possibilities. Intuitively add cubes to your model. Choose colors, textures and styles from the easy menu. Even automatically build castle and terrain structures that fit together perfectly.\n\nNeed a fresh perspective? Cubes has an awesome rotatable stage that allows you to experience different angles and views with an easy gesture. It's. So. Cool. \n\nFeatures\n\n* Interactive Menu: Easily change cube materials and colors.\n* Intuitive Creating: Point and click to add cubes. Add individually or in batches.\n* Easy Pivots: Cubes\u2019 rotatable stage allows you to create from any position.\n* Models: Experiment with pre-made models for inspiration and guidance.\n* Save Projects: Save your progress and return to your project to pick up where you left off.", "short_description": "Let your imagination run wild with Cubes, a 3D experience that lets you use virtual building blocks to create meditative patterns, castles, fun game characters \u2013 anything you can imagine.. \n\nBuild ideas, experiment with shapes, and explore possibilities. Intuitively add cubes to your model. Choose colors, textures and styles from the easy menu. Even automatically build castle and terrain structures that fit together perfectly.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixiteapps.com/privacy-policy/", "developer_terms_of_service_url": "https://pixiteapps.com/terms-of-use/", "publisher_name": "Pixite, Inc.", "support_website_url": "https://support.pixiteapps.com/", "website_url": "https://pixiteapps.com/apps/cubes/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25623693230601589"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"statu
/v/t64.5771-25/499618264_1901765627083593_6650175356007638038_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV1AW0Xzcu4Q7kNvwFDBD_i&_nc_oc=AdqwZZzyfR_T8DYAF0sYW9ELcPOIWO8dd-FbbF3-BfJ_irJIbXe1G6kfHGcVMPNoteY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYPTzTsIHQfNGJDi89pr__ne-QGTlB-DOB1vkQ12Fiww&oe=6AAE80EB"}, {"file_name": "com.pixite.cubes-20251024-112921.png", "id": "4197122430570707", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_4197122437237373_600924481414945387_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSHspR9_VPsQ7kNvwGeGZs_&_nc_oc=Ado5ilIfW_GColxkOJFJ_W0MNByCLltAxp07KE3QRH4xa5Xqidr6IHY3Rb_5tqJFz4s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvdBz1ZekY3Y6wvZ4H-qNDMEuBaiYefPxXwJ8gMHK3lQ&oe=6AAE93DB"}, {"file_name": "com.pixite.cubes-20251024-102235.png", "id": "772495692412262", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619098_772495695745595_7563187284033841743_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pW6k8-wnWogQ7kNvwFmodxK&_nc_oc=AdrPWh6NGTzgzH0S2E5GtCfhk6F8OA09BSigeORIq72712OAiHfc-TVqUuQIVLAhZV4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2135ODJ2mVZMlUgiytMHOjgco5jyNtFmUo7k-wGV4Tw&oe=6AAEB00E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cubes - Create 3D Designs", "keywords": ["blocks", "3d", "building", "voxel", "art"], "long_description": "Let your imagination run wild with Cubes, a 3D experience that lets you use virtual building blocks to create meditative patterns, castles, fun game characters \u2013 anything you can imagine.. \n\nBuild ideas, experiment with shapes, and explore possibilities. Intuitively add cubes to your model. Choose colors, textures and styles from the easy menu. Even automatically build castle and terrain structures that fit together perfectly.\n\nNeed a fresh perspective? Cubes has an awesome rotatable stage that allows you to experience different angles and views with an easy gesture. It's. So. Cool. \n\nFeatures\n\n* Interactive Menu: Easily change cube materials and colors.\n* Intuitive Creating: Point and click to add cubes. Add individually or in batches.\n* Easy Pivots: Cubes\u2019 rotatable stage allows you to create from any position.\n* Models: Experiment with pre-made models for inspiration and guidance.\n* Save Projects: Save your progress and return to your project to pick up where you left off.", "short_description": "Let your imagination run wild with Cubes, a 3D experience that lets you use virtual building blocks to create meditative patterns, castles, fun game characters \u2013 anything you can imagine.. \n\nBuild ideas, experiment with shapes, and explore possibilities. Intuitively add cubes to your model. Choose colors, textures and styles from the easy menu. Even automatically build castle and terrain structures that fit together perfectly.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixiteapps.com/privacy-policy/", "developer_terms_of_service_url": "https://pixiteapps.com/terms-of-use/", "publisher_name": "Pixite, Inc.", "support_website_url": "https://support.pixiteapps.com/", "website_url": "https://pixiteapps.com/apps/cubes/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25623693230601589"}}]}, "scheduled_offers": {"count": 4, "no
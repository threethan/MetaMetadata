png", "id": "1047896474628699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617813_1047896477962032_1535245791416422395_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4wZOVR1_SIQ7kNvwGv92YH&_nc_oc=Adp4u_noUdXll2Xivbo1a5fiu8UR13pbUR8Hh01SrquwRVRAgfufJ-W8SxM3Ut14i0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOXtHzr_CEaEYMRKLYN8m_kPFHoJWi500W-lOjpFLEyQ&oe=6B05D316"}, {"file_name": "5.png", "id": "1581228030041049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507849536_1581228033374382_709426243938005546_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csFrIEayQKUQ7kNvwFBWNie&_nc_oc=AdodciA3w_r4_Juu7yamQWudhg-gtTrrgF3_CeXEGd_wr3ltqvjHyyCzuDubYrLOZrA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuFezyemU7zuQ1osqKgsupfsMdcVy7VofNwsoUUufa2g&oe=6B05C3CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Night fishing", "keywords": ["fishing", "horror", "night", "puzzle"], "long_description": "You row into the reeds after dark to fish the still water. The channel is narrow, the fog is thick, and the only light is the lantern hanging on your boat.\n\nSomething moved beneath the surface. You saw it. But you can't leave yet \u2014 the key is down there in the dark, and you need it to go on.\n\nSo you keep fishing. You keep your eyes on the line. And you try not to look up when the water goes quiet.\n\nNightfishing is a slow-burn VR horror experience built on a single feeling: the dread of what you can't quite see. Cast your line, solve what the river hides, and move deeper into the fog. No guns. No chase. Just you, the water, and whatever is watching from below.\n\nRow and fish through a foggy, hand-crafted river at night\nA slow-building dread that rewards patience, not panic\nSolve the mystery of the water to find your way out\nBuilt for immersive VR: look down to work, look up when you dare", "short_description": "A quiet night of fishing on a foggy river. Something is in the water with you. You still have to catch what you came for."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1048740797537336"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2409472543199737"}, {"status": "PUBLISHED", "id": "1739373687140498"}, {"status": "PUBLISHED", "id": "2277670053174480"}, {"status": "PUBLISHED", "id": "1608290574339139"}]}, "baseline_offer": {"id": "2409472543199737"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794835080, "status": "PUBLISHED", "id": "2409472543199737"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1094745116270237", "version": "1.0.4"}, "id": "4448787572116380", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1048740787537337", "is_concept": false, "latest_released_binary": {"__ty
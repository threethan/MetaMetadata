nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXoXg5oblmyK5eze8HgV_7VZGhz1gMSBfnjBkpb8s6Nw&oe=6B0EFE6A"}, {"file_name": "bedroom-2560x1440-fill.png", "id": "29092828530371342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620532_29092828550371340_7201679399126520721_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbv9-TXejMwQ7kNvwEvxzhh&_nc_oc=AdqsoH5SnHD2JmYS8EVVmytcUceqvqGnqEJLVHygVSax4mL9UI_r4l7S2vMVklyOEOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOXs1z90BzUkJyISIj0E--7lwl1ephJ_tdhydEjtvsdg&oe=6B0EFFD3"}, {"file_name": "racing-cockpit-2560x1440-fill.png", "id": "2097241895012801", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628449_2097241898346134_2636895160069867971_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_M3YtTHzrMQ7kNvwFDh95j&_nc_oc=AdpE58N1XBblA8a6FdhhYx10FfOVmDzrF5y_POjwUuH2TNJrIvXvLsyUEToypaTZ_-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPqsTygkkr1GwxCvrl-HSXuOpYencYdmp86ESaPkYYKw&oe=6B0EFC1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racing", "keywords": ["Racing", "car", "Multiplayer", "passion", "immersed"], "long_description": "Racing\n\nRacing combines first-person racing, romance, and character development. Drive high-speed cars, compete against other racers, and share every journey with your customizable companion as you chase your racing dreams.\n\nFirst-Person Racing\nExperience every corner from the driver's seat. Master each track, activate unique engine skills, overtake your rivals, and push beyond your limits to reach the podium.\n\nMultiplayer Racing\nCreate a custom room or join other players in races for up to five competitors. Challenge friends, meet new racers, and explore brand-new maps together.\n\nChallenges and Progression\nTake on varied racing levels and exclusive single-player tasks. Test your driving skills, complete objectives, and work toward collecting a grand slam.\n\nMy Room\nRelax outside the track in your personal room. Interact with your companion, discover different items, and decorate the space to create a unique home of your own.\n\nCustomization\nPersonalize your cars with different skins and customize your companion with a variety of outfits and accessories. Show your individual style to racers around the world.\n\nWith immersive physics, exciting racing mechanics, social multiplayer, and relaxing character-development experiences,Racing offers both intense competition and peaceful moments. Start your engine, challenge your limits, and race toward the top!", "short_description": "\u300aRacing\u300b is a game that combines racing and dating simulation. Drive your speeding car and race alongside other drivers! Racers, push your limits and chase your dreams to the fullest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gameworld-studio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GameWorld studio", "support_website_url": null, "website_url": "https://www.gameworld-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1440594602473689"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/
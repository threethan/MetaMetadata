P3A&oe=69E8ABA5"}, {"file_name": "mossytemple_store.png", "id": "2536058036697723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223481_2536058040031056_3908955771461817536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ieUJWcQ9zYQ7kNvwEVhd48&_nc_oc=Adowl8zuEpiHgwQkmSIwKJXFXhv5WTBCfiY8uE7m90DkinLhjjiYvzjeE2xHAaoZBmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y4YODIWtfNh674PL8YzFDBxOrQQtR9f_92VOW_rM44w&oe=69E8A8F1"}, {"file_name": "playground_store.png", "id": "431473507969515", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982515_431473511302848_429798369478179794_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUcO50oI9NQQ7kNvwFVOAIO&_nc_oc=Adr0yXuW0-ZHVU57hhKzOWzshLaOXNacX7uBWbAl7J2JdpRCYpr07qYES8i1LR7gZoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30uSet_5zpeD6DDJGY44ditRVHMGnQvWSe5ZUwWgHqaw&oe=69E8B8AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiny Castles", "keywords": [], "long_description": "Tiny Castles is an \"action puzzle game\" built from the ground up using hand-tracking. It's an experimental project developed internally at Oculus to test necessary interactions for a hands-only game experience.\n\nIn the game, you play as a powerful god. The game's objective is simple - free your \"believers\" from the evil god and his minions and advance forward to destroy the obelisk which powers the evil in this world. The game was built to identify the types of game mechanics that could work well with hand-tracking. For this reason, it lacks real challenge and difficulty balancing and focuses more on showcasing a variety of hand interactions instead.\n\nIncluded is the \"Playground\" level which is the best place to experience all of the game mechanics in an isolated setting while the actual game levels demonstrate these mechanics in real game scenarios.", "short_description": "Tiny Castles is an \"action puzzle game\" built from the ground up using hand-tracking. It's an experimental project developed internally at Oculus to test necessary interactions for a hands-only game experience. The game was built to identify the types of game mechanics that could work well with hand-tracking.\n\nIncluded is the \"Playground\" level which showcases all of the game mechanics in an isolated setting while the actual game levels demonstrate these mechanics in real game scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/blog/hand-tracking-in-tiny-castles/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1166651397203765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974841_4213856315295736_2899563845947728675_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEbXo3UX0cwQ7kNvwFcw0ql&_nc_oc=Adp7OGb5WvSZmIkU0TGdd6UU5uVWqiuwkhxkPUupEUDU4eqsNUwSSFQs2wTmi16wI6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LQe8vW_kMJ-bUKXqZn8wb4G8244V557E4H_uGk3idiA&oe=69E8B920"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
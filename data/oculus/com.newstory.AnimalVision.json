ough. Discover a new way to look at your own home with these unique visual effects.\n\n\n**\ud83d\ude80 Early Access & Free to Play**\n\nThis app is in active development. We welcome your feedback to make it better!\n\n\n**Disclaimer:** This app is for entertainment purposes only. The visual effects are artistic interpretations and are not based on scientific research or actual physiological data.\n", "short_description": "Have you ever wondered how your beloved pet sees the world? Animal Vision MR lets you experience your own home through the eyes of a Cat, Dog, or Shark."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25713025501634388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622334_24470110739330458_6789145799786113134_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA82fk2L204Q7kNvwFBeIg5&_nc_oc=AdpmcBs4hBpMTdsRsYdZRWi5B-hNss3255LsazM-i4mvOuUFamP74sFyawPIvXnFNxE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8rYq04r7j16S5YK2iWpg0rL6p5ihnF1Wpb5pMFED5yA&oe=6A8ED452"}, "
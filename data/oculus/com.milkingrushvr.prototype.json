ttps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307920_908416211786832_3041099296916613144_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ENfjxEFChkQ7kNvwG21QPb&_nc_oc=AdqlauMTGl4IJdm-9o5YcajuZBZ0sxdlvBzGMikm0W4Ds62GSVtwJiRZlBDs4JXuCT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHxT9hYBr2Rz5ZGfvVSsbjqNjPJYRr2mBvuwohvGZXRg&oe=6A9EB68E"}, {"file_name": "screenshot_2_cheese_delivered.png", "id": "1951836102145038", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295512_1951836105478371_1659680972519589244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgBUU4qSbM8Q7kNvwFRvL0I&_nc_oc=AdqTUshsW_RVJy2FADuhTTiunA8BKabaPv7N4bPnucv8_xqcIZzgX_l0hN6lDamH0DY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM4aaTucY4Zzn9yTMFv4z7z7dPH6ySwI-eVm3K1eYtig&oe=6A9EC139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1671057313997337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297120_1671057317330670_901740785862698214_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WVFsD_Jz_kQ7kNvwH-Ehbk&_nc_oc=AdqaF55aUf4bVf1St9FGYmyERAX22R_38LTBTs6qTuUwnjPF8O3I05k5LOI99ceoyRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRt9mUp63kMhJR_m1q0q8dTqw6xRTn5IDcYWzEVCI-Vg&oe=6A9EC8DB"}, "display_name": "Milking Rush VR", "keywords": ["farm", "farming", "milking", "cow", "cheese"], "long_description": "The farm is booming and every order is urgent. Put on your headset, roll up your sleeves and become the fastest farmhand in the valley!\n\nMILK LIKE YOU MEAN IT\nGrab a teat and pull down with real hand motions \u2014 smooth, steady strokes fill your bucket, frantic yanking gets you nowhere. Keep the bucket level or precious milk spills everywhere. Unlock two-handed milking to hit top speed.\n\nFROM MILK TO CHEESE\nCarry the bucket to the work table, churn with the paddle in real circles, portion the fresh cheese wheel, box it up and rush it to the delivery zone before time runs out.\n\nEGG DUTY\nThe hens are waiting! Keep their feed and water topped up, collect the eggs and pack them six to a carton. Careful \u2014 eggs break, and broken eggs cost points.\n\nRACE FOR THE STARS\n20 timed missions with rising difficulty, combo-driven scoring, accuracy bonuses and a star rating on every run. Chase perfect deliveries and beat your best scores.\n\nFEATURES\n\u2022 Physical, gesture-based milking, churning and egg handling\n\u2022 Two farm jobs: the dairy barn and the hen house\n\u2022 Combo scoring, accuracy bonuses and 3-star mission ratings\n\u2022 Haptic feedback for every grab, stroke and pour\n\u2022 From your first wheel of cheese to the ultimate Milking Rush\n", "short_description": "Grab your bucket \u2014 the farm won't run itself! Milk cows with your own two hands, churn fresh cheese, keep hungry hens fed and collect their eggs, then race the clock to deliver every order. Physical, hands-on VR farm work across 20 score-chasing missions. Easy to pick up, tough to master \u2014 how many stars can you earn?\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/ea94a21c-e5df-4504-896e-00cced5b9891", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/ea94a21c-e5df-4504-896e-00cced5b9891", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTIN
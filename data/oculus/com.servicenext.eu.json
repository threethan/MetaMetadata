_bNvxpS4m2rXmgZWZm-ZwgeBYNuDJalif8Hk5MZNYnUhOqVrIlBIITtE7xV8ypE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88FgpFmn3sXwIPPGwtIpi4CBGkGozM_JEuSFw5XbtH_Q&oe=6A3D4C17"}, {"file_name": "5.png", "id": "856586404051449", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822550_856586407384782_1765243487109526897_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UkfcSWuPjsQ7kNvwHfFthq&_nc_oc=Adq_5k0chyd7WDX8xLx-7R5fjijD0yZY9DAX6xYT3-yY5_EIU6DDOGcbeNAFeu-RI8Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LnXjJHmN-nQ9yOzxBnvsV810DMs5ZRpX5zX9ZOKhy_w&oe=6A3D502E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada video metadata app tienda.png", "id": "1403965287661072", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307413_1403965290994405_6395188103456626789_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE2ieZLvLF8Q7kNvwHfoD_r&_nc_oc=AdrVEVGefudtqWIDBhXHMrV2AGeZme_HjVjYHdY80QEhB11IkWlOJuNsR3-TqRE6YIQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88qz9muI8Hm0_sJkLZ595tiFQZjqV4DRDJlEh3NHzJJg&oe=6A3D45B1"}, "display_name": "Next Academy VR", "keywords": [], "long_description": "Next Academy VR is an innovative virtual reality training platform specifically designed for mechanics and automotive industry professionals. This application offers an immersive experience through 360\u00ba videos, allowing users to delve into the world of motor vehicles, including hybrid and electric models. With a library of instructional content available in streaming and in multiple languages, Next Academy VR facilitates learning and the updating of technical knowledge. This tool is exclusive for members associated with workshop networks that are subscribed to the ServiceNext platform, providing a direct path towards excellence and innovation in automotive service.", "short_description": "Dive into the future of automotive training with Next Academy VR. Learn about hybrid and electric vehicles through immersive 360\u00ba experiences, exclusively designed for mechanics and workshops subscribed to ServiceNext."}]}, "developer_name": null, "developer_privacy_policy_url": "https://servicenext.eu/en/privacy-vr", "developer_terms_of_service_url": null, "publisher_name": "Service Next Automotive Technology SL", "support_website_url": "https://www.servicenext.eu/", "website_url": "https://www.servicenext.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "pt", "es", "nl"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25840147875682006"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031344_1777991439350460_6416894580631473890_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YevsySR8kC8Q7kNvwHjIpvI&_nc_oc=Adr1X9S5zDxa3lejQM0Cq5cdEsmPpGqLvTrdU0_u8uhYGFPre5z3bP3DeI9SmCsJBCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97qGRxA64xECzuFClNddLLPVkI7yxD8XbLxWV7kbVBFQ&oe=6A3D3B4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Next Academy VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1712278800, "lastRevision": {"nodes": [{"id": "6766141420175938", "release_type": "SCHEDULED", "administ
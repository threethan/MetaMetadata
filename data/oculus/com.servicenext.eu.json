//scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210893_416622747561027_8883145206560033643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRjYFWArlRcQ7kNvwFn2z08&_nc_oc=Adpm7hzWVll6dHt7BK07TGCLs3jvnpk4v32TzdisWasKsefIKdVLLrkfk7IPa_P4hYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtsFNS5qwd6OdqB2_v9tv15J6tic7FCwdrMW8x0sT6pQ&oe=6A79B6BF"}, "display_name": "Next Academy VR", "keywords": [], "long_description": "Next Academy VR is an innovative virtual reality training platform specifically designed for mechanics and automotive industry professionals. This application offers an immersive experience through 360\u00ba videos, allowing users to delve into the world of motor vehicles, including hybrid and electric models. With a library of instructional content available in streaming and in multiple languages, Next Academy VR facilitates learning and the updating of technical knowledge. This tool is exclusive for members associated with workshop networks that are subscribed to the ServiceNext platform, providing a direct path towards excellence and innovation in automotive service.", "short_description": "Dive into the future of automotive training with Next Academy VR. Learn about hybrid and electric vehicles through immersive 360\u00ba experiences, exclusively designed for mechanics and workshops subscribed to ServiceNext."}]}, "developer_name": null, "developer_privacy_policy_url": "https://servicenext.eu/policy-vr", "developer_terms_of_service_url": null, "publisher_name": "Service Next Automotive Technology SL", "support_website_url": "https://www.servicenext.eu/", "website_url": "https://www.servicenext.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "reco
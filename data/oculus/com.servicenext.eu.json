zBJTXrhNupz_tu6W1N3jjEj1F6mThHgqXqPEg-Sv4DISC9fddGT0xnCvqW620-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af623rTchvmcKgokZIo8KgVEs9lkgbCBkdxLPI7qCq-glQ&oe=6A186217"}, {"file_name": "5.png", "id": "856586404051449", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822550_856586407384782_1765243487109526897_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D2RFdyOmJcQ7kNvwFeNhCB&_nc_oc=Adp57wTcTANoNdI4f8M4h9hkTw5oCjSfS2_CKYNUnxU6iPHh5QfvKE7AchS9pRn3cQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yMoklkfGyY7xTOgUhAlBbaLd_sTecEOCcnxVV2M-3Sg&oe=6A18662E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada video metadata app tienda.png", "id": "1403965287661072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307413_1403965290994405_6395188103456626789_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG-8P5Ct0CYQ7kNvwE7eK4j&_nc_oc=AdqPWmbFeKmwTBnOJWpxzAU_Q90ILu-fCa9IEqNTumhkVgfF7_fmiCRwr-Gt--bB0wQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w3bqXaIH1MeE6xmPT4gGVuj_DR6xoO8Ph11DtJNg76w&oe=6A185BB1"}, "display_name": "Next Academy VR", "keywords": [], "long_description": "Next Academy VR is an innovative virtual reality training platform specifically designed for mechanics and automotive industry professionals. This application offers an immersive experience through 360\u00ba videos, allowing users to delve into the world of motor vehicles, including hybrid and electric models. With a library of instructional content available in streaming and in multiple languages, Next Academy VR facilitates learning and the updating of technical knowledge. This tool is exclusive for members associated with workshop networks that are subscribed to the ServiceNext platform, providing a direct path towards excellence and innovation in automotive service.", "short_description": "Dive into the future of automotive training with Next Academy VR. Learn about hybrid and electric vehicles through immersive 360\u00ba experiences, exclusively designed for mechanics and workshops subscribed to ServiceNext."}]}, "developer_name": null, "developer_privacy_policy_url": "https://servicenext.eu/en/privacy-vr", "developer_terms_of_service_url": null, "publisher_name": "Service Next Automotive Technology SL", "support_website_url": "https://www.servicenext.eu/", "website_url": "https://www.servicenext.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "pt", "es", "nl"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25840147875682006"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031344_1777991439350460_6416894580631473890_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlyVrMiI2qcQ7kNvwGXSuTq&_nc_oc=AdrAGz8rjgkSjOkWEIhRy1n_H_vVfK8DGdxHZfTZsZQaFWyA0anKjV9zhWJdYl73NDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QvGFU2cFB4OUMcsI-1GOr2eZ7-zviVWJPe47JbM-XuQ&oe=6A18514F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Next Academy VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1712278800, "lastRevision": {"nodes": [{"id": "6766141420175938", "release_type": "SCHEDULED", "administ
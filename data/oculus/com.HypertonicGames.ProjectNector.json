4C2LVQ&oe=6AFC732C"}, {"file_name": "Customer 2560x1440.png", "id": "1664922221138337", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1664922227805003_3909014069258872078_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbCEbqwXCcwQ7kNvwGRP76T&_nc_oc=AdpBXYINIM2KTuUBjxGMJB_O8NiI77Vb4AEU2YFsRAYgPYybgdKc8WSfccOSlRdrYmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoeJLcHsita-fLpqZSCwoZDnYIwQVslXcQ6Cu1swxRIQ&oe=6AFC77C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honey & Hives | Beekeeping Simulator", "keywords": ["Beekeeping", "Cozy", "Nature", "Relaxing", "Simulator"], "long_description": "# Immerse yourself in the gentle art of beekeeping.\n\nTend your bees, harvest honey, and craft new renovations in your cozy garden. Take a moment to relax, watch the bees forage for nectar, and lose yourself in this wholesome, calming VR beekeeping experience.\n\n{841912192343363}\n\n# Harvest your Honey\nSlice away the wax to reveal the beautiful honeycomb left below\n\n{1587120989136293}\n\n# Extracting\n\nCrank the handle and spin your frame to extract the honey\n\n{1508486917060533}\n\n\n# Bottle up the honey\n\nOne of the best parts of beekeeping. Collect the honey in the jars ready to sell.\n\n{828965129863365}\n\n# Sell to locals\n\nReap the rewards of your hard work and sell the honey to the local townsfolk. Locals request a variety of different honey flavours keeping you on your toes.\n\n\n{1178333771171380}\n\n# Renovate the Garden\n\nCraft new renovations to bring your garden to life.\n\n{1633074811400756}\n", "short_description": "Immerse yourself in the gentle art of beekeeping. Tend your bees, harvest honey, and craft new renovations in your cozy garden. Take a moment to relax, watch the bees forage for nectar, and lose yourself in this wholesome, calming VR beekeeping experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypertonicgames.com/honey-and-hives-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Hypertonic Games", "support_website_url": null, "website_url": "https://hypertonicgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9593878047384993"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2230706161157682"}, {"status": "PUBLISHED", "id": "2171597816752758"}, {"status": "PUBLISHED", "id": "1660737515193948"}, {"status": "PUBLISHED", "id": "987306290864971"}, {"status": "PUBLISHED", "id": "1678848836380820"}]}, "baseline_offer": {"id": "1678848836380820"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2230706161157682"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26588109094201956", "version": "0.9.2"}, "id": "1274717450936009", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9593878024051662", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26588109094201956"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channe
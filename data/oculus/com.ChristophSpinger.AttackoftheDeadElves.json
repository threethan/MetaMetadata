nt-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WBFp5UstsBN6KFD6Fw7vrl80vZziGoONvY0Sv-p7pBQ&oe=6A26E8C7"}, {"file_name": "ScreenShot3AttackMeta.png", "id": "802853259406872", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818890_802853262740205_8927864492186091726_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iN9NzP9bFggQ7kNvwGwwgus&_nc_oc=AdpFvLnO8CsL-djbHXEHvhV__SZyKfhPU4K6aEt9MM6aJIekSXZKwJ2eYRQxsPCEzpU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bRYxSS0N7ERP4ffq7-O2CskqVF9AKGg23X6EpnphXHw&oe=6A26C605"}, {"file_name": "ScreenShot5AttackMeta.png", "id": "2423145574750027", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825563_2423145578083360_1084822089398020649_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlMv6Ox0NLcQ7kNvwEStWDp&_nc_oc=Ado3kAFvGM5be1GX_M17L3k65me1WULIpotbwInY9wQLMdtdt8P6Ah7cPhi3Z6_m2l8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zTJKM8mt3_5v9VMEtIEf9KaHikJZvfP9g6Ap3FHHNww&oe=6A26C809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AttackOfTheZombies TitelBildNeu.png", "id": "1443893980775089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823910_1443893984108422_5734627786537788151_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayMtSGi7XhAQ7kNvwFiEQNc&_nc_oc=Adp4efxrMRhe_v_fH1m5_vqysceZQihF6MCzLpJjVs3Ggubu531P7rmIfcy2Vhf_-lc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LPHXzxF_aR2zyyAg-hgeV0hvwEZ5tRRODxxruOODRQA&oe=6A26D2D5"}, "display_name": "Ballee: Attack of the Zombie Elves", "keywords": ["MixedReality", "Sport", "Soccer", "Football"], "long_description": "Attack of the Zombie Elves transforms your room into a chaotic holiday showdown. Mischievous zombie elves appear directly in your space and try to steal the packages placed around your Christmas tree. Your task is simple and hectic: stop them before they escape or chase them down to recover the stolen gifts. Meanwhile, coins pop up around you and boost your score, creating a fun and constant decision between defending your presents and going for high points.\n\nYou interact using a real physical ball, turning your movement into playful mixed reality action. The game relies entirely on real-time color tracking of an actual ball, so you\u2019ll need to bring your own ball before playing. For reliable tracking, the ball should be single-colored, non-reflective, and clearly distinguishable from your surroundings. Strong contrast to the environment and stable lighting are important to ensure accurate and responsive gameplay.\n\nWhen you move, swing, or push your ball, the elves react with humorous, exaggerated animations that bring the scene to life. Your physical space becomes part of the gameplay, making every round dynamic, energetic, and physically engaging.\n\nThe game supports three different playfield sizes, adapting to a wide range of locations: 2\u00d72 meters for compact spaces, 3\u00d73 meters for comfortable room-scale play, and 6\u00d76 meters or larger for gyms, garages, halls, or other open areas.", "short_description": "Attack of the Zombie Elves is a fast and playful mixed reality game where zombie elves sneak into your room, steal your packages, and you use a real ball to stop them or get your gifts back. Collect coins, protect your tree, and survive the holiday chaos \u2014 all playable with hand tracking and a real physical ball."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ararcadegame.com/data-privacyprivacy-policy-attack-of-the-zombie-elves-meta-quest-app/", "developer_terms_of_service_url": null, "publisher_name": "Christoph Spinger", "support_website_url": null, "website_url": "https://xrchris.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "exter
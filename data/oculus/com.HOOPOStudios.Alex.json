gyumhZQ&oe=69A2D980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Alex - Banner.png", "id": "1413133706704905", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393696_1413133713371571_146637141592971169_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DBSrxWLyJUQ7kNvwFO1RTW&_nc_oc=Adn5ne0bzrlH6YLyq-Uh7pEBmbV2hlxqPLJQf4jWXaC3qyyFUcSCK6F6kHWOIii8hPg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0pZZSG7mLa37J42gmxZSycryVBUfrRp4CUQcD6Vnetg&oe=69A2CDCC"}, "display_name": "Alex and the Jets", "keywords": ["flight", "Cool", "Arcade", "Cute", "Squirrel"], "long_description": "# Come Fly With Us!\n\nPilot Alex the Squirrel\u2019s plane as enemies swarm right in your space.\n\nDodge, shoot, and strategize.\nFast, fun, and full of chaos \u2014 **Welcome to Alex and the Jets.**\n\n# Fly in your own surrounding\n\u2708\ufe0f Experience your space as never before!\n\n{8598454083520072}\n\n# Turn your surroundings into a thrilling dogfight arena.\n\ud83d\udd2b Fight AWESOME and challenging enemies\n\n{999134122178506}\n\n# Use the doughnuts to gain power-ups\n\ud83c\udf69 From poison, through shield to missile: douhgnuts will gear you up to to make sure you got what it takes\n\n{1425233925524156}\n\n# Enjoy side-quest!\n\ud83c\udf83 Play with bouncing pumpkins, hovering cheese and more.\n\n{1853800155024167}\n", "short_description": "Alex and the Jets\" is a Mixed Reality flight game that lets you pilot a plane right in your own space and engage in exhilarating dogfights!"}]}, "developer_name": "HOOP-O Studios", "developer_privacy_policy_url": "https://drive.google.com/file/d/1SeXpzbqK_3yiXulvvgqICYZigUXT2Skv/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HOOP-O Studios", "support_website_url": null, "website_url": "https://www.hoop-o.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
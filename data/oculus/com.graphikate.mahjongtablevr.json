gH5r3L0xkQ7kNvwEa4ORp&_nc_oc=Adrt0GMdOfRKA58_dmP4_R6VQ7HV6mYeOCuiVnTkV8yn-dvXRU2YWCSgRejcO_ekKFs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcyJelylEVqjpUYTTsSeTN9JWurx-S7QN2Wh2ek8b_fA&oe=6A901786"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS9yRF-c3dQQ7kNvwGD_uAt&_nc_oc=Ado7bvSfCG7UclS63-8wMp3HNPTpXRQzfAXw_UaqrL5SuAUWcE0RfnjDdm5cpJLB7Yg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiyE6w0aBpSe3b8GHfA0H1Be83s6SiTSFCQwvz43qp1A&oe=6A900EE9"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17USbclGd4UQ7kNvwFnveKp&_nc_oc=AdpHCaaCVTuL8zbYmxdIqYYvXIDzGxybgDAJvUSiFaXPLxafzj3eIByU0wFAMlinZnM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-M6SvbO4ZDnUj5sxXBg16cB5Lgu64hNp9G25NfqxMSQ&oe=6A90331E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s03UPtRAhgQ7kNvwH_E3HZ&_nc_oc=Adq4yiEiOgqZ_u0Ebangnb--O6Ud9vYiIjE1XL7JVGDgdJ7VXzoyDDmFhnRvHnHC-PU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtyCq5IdtO0Hv2uClXkh1GOfw5SvvXcp0bV9oP1f0JIQ&oe=6A9023FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INy3koyU0wIQ7kNvwH2mz3t&_nc_oc=AdqfOLwvW3RWVH_CnBBkluhlYtYWEnMfrCo2VWw_H1D1BmDgyOUTu2nIvWGJLdH-xp4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJvYi_b3Ww4zVWymxOkDU0ga3ayp-1u0PvAS6NNoikmA&oe=6A903003"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type
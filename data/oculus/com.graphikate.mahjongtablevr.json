04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zze82Ne3OWwQ7kNvwHEGI0_&_nc_oc=AdooQVKeqT_gS5HEMY5D7lolF1fgSrZxmdD8CMw5t-6Vd6EJR5gQmP9MmJIHb_OjrDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3RbFDLO7Jas9b1k31Z3lLQx_ApVy0WjMlR-dM6UkeiA&oe=6A9838C6"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFqpUwgp1s0Q7kNvwE0ewva&_nc_oc=Adrlny1twRJ943U6FLDlvcCBJuFEp6UyaHM_-hqDlUTViZ9hBMncViDOfxaRAaMSkyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_wVR3EtSDTQzGH2owCafuQcYt-4v0thMDtE5P-1KMow&oe=6A986869"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjMHsHSPPEUQ7kNvwELwHes&_nc_oc=AdqhWJM-XdmV7iu1UDm3ExBeGs7G-vlJj2XbxPMh_1bn7o02YP8p15nWndkytVcBdgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFN65r48ikyLoc2AwKp0dP-vKbeay8rqeTSAjO8KbMLQ&oe=6A98545E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDkVK_raT3sQ7kNvwFANI_9&_nc_oc=AdqspuMxHx2olaJKZORRHVim1fN3u9TA4Dx_OM8zmomg7CnfH1MiVKO6xrDmSlt_Vr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoeuVg0HFGsQyhi86ulfaBnPQ0SKV2zkJBcef9s9A8hQ&oe=6A98453F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpzCnO4LapAQ7kNvwGm2ILd&_nc_oc=AdqgiWAHpBE_KYMYiTD86Qb9mGacv5ku_puPMPdsYkuI94qno1VOD4WvQxlzKH571pw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYWKKa5w-S_y_SDeLxTw_Lsv_8eXCunn5ZAmWygVJhcQ&oe=6A985143"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
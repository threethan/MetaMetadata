04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89LA0QPiRUAQ7kNvwGcAYhk&_nc_oc=Adpv5vC6RWCMPu0MlNlYQHXvl0s16JDDvEhO-4SRC4FYTAVe4wHm9gTzg6kocmitG-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMfP52sCgVO0hwQTzFE-1EDuAi-BqNDIexbBGA12QzOQ&oe=6A9ADBC6"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFlsB22brqwQ7kNvwEks5Tc&_nc_oc=AdoHWFQ7nu8nTmbCeb7uFNFseDCxSbq9PkQPWPDqWMDu5S-MZA_GKmOSHWEG5oZDCP4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-djAjivzCx-bl-jNcjEBDXOMg-nyUKrINJnlIZv7nkQ&oe=6A9AD329"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB5eC78MsDcQ7kNvwGTLUZ1&_nc_oc=Adr1G4als97JGkFiA01pjl858q8kKfYjD740uNggPXHss4hN3WjXX6EUfFNzMG7M4Ck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbLRMaKIbAXIHKE12pLQWMFF6wuqGigudIv3Fmb7YcKA&oe=6A9ABF1E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaIfxDCjMowQ7kNvwGoTYbs&_nc_oc=Adqnc94mFUzsuYa5jEh_bob1xAulCwBrp1a09Uo30T1QqwuqvP-J4Vep5X4oPFpMZNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtir4bIBSaqiceh4sOLrzq3GnsMetLQMeC3uD_95AFVQ&oe=6A9AE83F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-KeFx9KPw8Q7kNvwHFW5Q5&_nc_oc=AdpOiuYAUPeG8JU3J8OJPJzkHry-HUqPHJSo7my1C8C833K_Dv_j4fOOIQF6PfR5teM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0hAzIRHTPdOloqDBzIznkeqvR4pKTuF-MKpSYIwwlyg&oe=6A9AF443"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG98jvh4AaUQ7kNvwFAK0Z9&_nc_oc=Adr-LS0LqRWM-sFeAv5HOXs8ub9Z7KC6UwKT9PA6kBZGOO6huskDdhOtsTs_ODtDaJ8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2V7y0He2Y9Z0hBysfuvWfJgMJNa7UAUxJuPi0DRKvzg&oe=6A916906"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO2vHD1Vo78Q7kNvwFTjNFz&_nc_oc=AdqadLeiXBF1ZZSBEbpGk8DR_mxSBo_nmYF3j2CVjrVgx47yDtGrmQacZaBLshkE_54&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_FCW7dC4j1IPUKquL2sACnW_hcfv55i8heAmX6NgvTg&oe=6A916069"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVEocekCMMwQ7kNvwEFWXYZ&_nc_oc=AdrUZSX1bAuSSvR6dNZa9tfxzDcd_yX1Nj6DFbXohQ6D_CVu7n72P57IMD4GWA_0vMI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqlOJmJH5_8LxQyGVQ-AlkYMzR12LdPxZOjm5ogLfuJw&oe=6A91849E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s03UPtRAhgQ7kNvwH3JaQh&_nc_oc=AdpaMJnp4oWqUrwlWNUIti0PpIuV7ZZSuLX0GjnYfDpxCUEPxp_tRtJsb-CX4VyRTUk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEleslUi-mOf0f7MrbLAR5ir625UVvk4KdE2Pc2A9qTRg&oe=6A91757F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INy3koyU0wIQ7kNvwE8PuWs&_nc_oc=AdoV1oEEo7kQduPKl-qSp5bmzmf2-BibV6MjKc84Bz5gDcZ1pmfgDciJ59EXx5hyFDg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVOgMVMZMsom1EpILBXxjlSP-hmTuq9uGQNXvLHtcgNg&oe=6A918183"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853158066
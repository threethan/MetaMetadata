c_sid=6e7a0a&_nc_ohc=e6gH5r3L0xkQ7kNvwGPbWsK&_nc_oc=AdoejrzImxJRLZEzzqh1NNeI5bMW8fj09T62S0tqN87vbt8RDY6qqgwguXgDgF-QCZY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2YpVKoqN8mAFoZrqKo7QHyeBkwNIixRQVkStl06eGGA&oe=6A8EC606"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS9yRF-c3dQQ7kNvwG-KEPV&_nc_oc=AdoCw-UFdmym4ZoFZ4HeJTDTH2z-nAU_SQ6jqNzA-Hg0WWMl16t_DA5Og6EZrurSTZM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGs_u4CA_ZEPrLZKYKXddFO-ArBrVbBZ24cQOxVRqmyw&oe=6A8EBD69"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17USbclGd4UQ7kNvwG2glK7&_nc_oc=AdqUklM7YFPrSfCz42Lssz8LOLy82UnXV6tUpHX-M0Pwyc-supgATqmAopYc9kuetIM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9zrQ7r06o8hHEtzEnerl_dWHhxwm7zOnZMB0IZnpUYQ&oe=6A8EE19E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s03UPtRAhgQ7kNvwFWIU85&_nc_oc=AdqShjDITxoYyLe9DaocpZRRFi69dKIep2-Q2bRSd-X163oQ68vBQ-JXw7dBi3DEeGY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm93XWjlnAiWKYr-0lCS9zcM-gwcXa39CqInxRo7JOqw&oe=6A8ED27F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvGUjPebUTMQ7kNvwEVypmf&_nc_oc=AdrnAnxyE2CXuP49uj-jYi02VXTwCGur1M6vP-UV9s5NRtUOi--wmYEsPlhx3WG5Ck0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvBUSo7MhrI75iwhGTSnS8rUI4oRtmyrDxHjZuH7_8fA&oe=6A8EDE83"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}
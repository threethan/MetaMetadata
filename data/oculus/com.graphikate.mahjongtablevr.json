nd.png", "id": "2176351159610863", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620530_2176351162944196_4660498793524379160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yk2SxsUGRWgQ7kNvwE1Y4D6&_nc_oc=AdpbQz6oh8k27s7-s6Wx9_IPY8IsYF5B1t7y-c19WVi3U3jajiWw19Pu1qMpyj6rtDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-6RZDSrqtTXn3rjB-W-Xyk9ji6YYVd7Hglrjr4-FZ5A&oe=6AE75B7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440-v3.png", "id": "1443523247764799", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622186_1443523261098131_6227382849589502258_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bmq4UKOQIpkQ7kNvwGEmxW1&_nc_oc=AdrejulVwUKRY234cqCb2KiJz6mFyXYAJO2GPaaNnvX2KywwBZRMZ7URBwuxHheCtC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyAQmYqKOvUlzLkAo8zXRDv7gUUkRRq6eUic_mnwmyxw&oe=6AE747AF"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "multiplayer", "american", "mahjongg", "jongg"], "long_description": "Sit at a real mahjong table without leaving your room.\n\nThree rule sets. American: the Charleston, jokers and exposures. Play solo against three bots on The Table Card, our own card, or host a private table for four friends with your own card, where wins are agreed at the table. Singapore: 148 tiles with flowers and animals, scored in tai with an adjustable minimum and cap. Hong Kong: 144 tiles, no animals, scored in fan with a 3-fan minimum.\n\nEvery rule set plays on the full 3D table. Pick tiles off the wall, rack them, and throw your discards onto the felt, solo against three bots or with people.\n\nTo play online, host a table and share a 4-letter code, or sit down at a public table. Friends can join from a phone or laptop browser with no headset, and joining that way is free. Your first 3 online games are free. After that, online play needs the Online Pass, a one-time in-app purchase that covers every online table, American included.\n\nVoice chat is built in. Play in VR, or switch to mixed reality and put the table in your actual room.\n\n- American, Singapore and Hong Kong rules\n- Real tile physics, jokers and exposures on the felt\n- Solo vs bots in every rule set: three levels for Singapore and Hong Kong, The Table Card for American\n- Up to 4 players, and friends join free from any browser\n- 3 free online games, then a one-time Online Pass\n- Built-in voice chat\n- Controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "American mahjong vs three bots, plus Singapore and Hong Kong rules. Friends join free from any phone or laptop browser."}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1462077305808670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624656_1816239476232341_1203005495199467175_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GalTTX0R7kQ7kNvwGKaNtY&_nc_oc
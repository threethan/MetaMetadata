47904987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D5nelkBcegQ7kNvwH3acIU&_nc_oc=Adpekq8OW3j97RRcFfH1_PiT1W1AlIDdTckUBBKwuC1o0mM0LLZkj0CsBoBQpKNS5mY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn8hRoKpun7GWIlh0YLlIU0tt_gkMMOGv_jRsfFxUyMA&oe=6AA41646"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7x1ec0BHv8Q7kNvwEgbPzC&_nc_oc=AdolaBWe2SHMzToaJh-ddCPI6BND1V_EXodbTIvEqROKFIyS8GyewfR1ArPhKKU942A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpTGA1wwBpG-ZStui6ISP1W8--dE-wbX1VIpcJrR78Lg&oe=6AA40DA9"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT-1VxiFBeEQ7kNvwHYz1N9&_nc_oc=AdrPIkUBsG91fHyZr15gdIa21oxhO3cmLHfeS-1wonRNtKOQHlkiOEMLEs7rN-WFu4w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIsKPGLe-ES17s8N7OkKG3YwSUrxZBiTDGy-RTy0kf7Q&oe=6AA3F99E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szTpEqNiJW4Q7kNvwGfZGPl&_nc_oc=Adr5H5ba4MRaWe5V6A91n77JYm7JuoyqQO-AVaRGk_mqGYEJHtWwdbYkesBA3J5VeZA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJad4cXL8OC_ucUAQbgYQn0M-AoVm_Kmtved2mQXr4uvA&oe=6AA422BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrqzSWT5DJAQ7kNvwHDQk5U&_nc_oc=AdrRfTVtSEqLz7-RtTaWHvqY-HSIoqqyl8ZfBfPhHpOx_zZKLd3CJPhY4OOayetSIT0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHkWWTAORsswY0yTgB3AWWoQfOYb8-4YjHQKzIqtj2Dw&oe=6AA3F683"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648
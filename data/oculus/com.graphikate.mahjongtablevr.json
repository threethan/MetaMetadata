Nw&oe=6ACA51C6"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIn0CbbVjigQ7kNvwFs8JED&_nc_oc=AdoulwmVM-jBxQw0uJM79Rn80zQuKsWmtcGVT58WeVRpJrrNauZLrIKYwSrd2ckfRU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTvEPvBCoUxrBkiz_42ikCVefNLVysubB55qXtye9TqA&oe=6ACA4929"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hCPsSmoBTQQ7kNvwFD2kjt&_nc_oc=Ado0Opyvto2O3CYn-9l0oznoVYSezVBE8uCqGASFmoiOfDzKkbT2qTEr1Cm-XiEoW-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8Ng-7h5Fr7H2fCVo1ZWaH2no8-s4q1Uq_tupN_5p57g&oe=6ACA6D5E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG3pRTtbiaMQ7kNvwELZJKz&_nc_oc=AdpU1JxSzyb08qrJR0DPKZYuhCwBh85qjzzZTev4NVF-1D66k5rxAFG5C4-m0VLtSAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPja2bexa0V0RSIBHo6Iip5EMBQ37V1xwUWqNZUhBwdLA&oe=6ACA5E3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yGDqWpJ1NAQ7kNvwGRn-lI&_nc_oc=AdplkTg4VjFhRLsuWCJo3gGQ_g9Ge-wACpgHXidOfraof1HFGifEXlRk0868ab9o4NI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtXmtHRiRSPqg1EvDoRaI1Tk1J89Q47MHbMAIqLivBkg&oe=6ACA6A43"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
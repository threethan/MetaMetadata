uluscdn.com&_nc_ss=7f20f&oh=00_AQNWyTCa6_1KQP-NJQE-W5L3EncMR3XgES8BevP6Txv12w&oe=6ACF97C6"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKWPl7_xutoQ7kNvwEglBeo&_nc_oc=AdrGT6TuOZI-6oQnL5FbTow12eSCLVdPI1eZFnEuBCR7cR2qaB3RSXikuG7YFKYSBm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQFvwSuMBH7v77baqBiiPXfx9fNyVH6n26KYMzafXl2w&oe=6ACF8F29"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dhtbZXviSYQ7kNvwEe3r7-&_nc_oc=Adqr52v37amjLdw71e2YHl8Ou_O7tShGc72qMQo4hXFPsvcjXVkJ3VbK-yb4DB0hrVw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1bpF5KlUPUe96mQk9f_LsxS-P5Bq7Yo2A8Sckc4ZBLQ&oe=6ACFB35E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDQTYw7csnYQ7kNvwGQ27oD&_nc_oc=AdrhVrRdSL8QrqRAEcOXSM3MoCJ5-7CsjNFJ9EovZnvJrC_OfalYnSl4mJ6tSctm-GA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMepQahrVApuuD60SWk4T3ur6dUo8m3VB16Wl6WxCU-sw&oe=6ACFA43F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DpXalD8Iy0Q7kNvwFJOObc&_nc_oc=Adr81dLTGH7LT8BqZRCmRLKNFL_jy5xLhgCoE3fzj-dAA5MV80Sl3eBmTW2WK_tX3m4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf3gWJgefuHNFqf7G-xMyFmpxKfPIL-SRPT5kyHm5_BA&oe=6ACFB043"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommende
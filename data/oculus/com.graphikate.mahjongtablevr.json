04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foh0y8uENToQ7kNvwHXQW7j&_nc_oc=Adq0jlcrKbxTkIis8SkCpzJx4gs1ZoQEUeZBs89sUfMTf_38FRyilv3pLiRjR1B8lvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkt74fqaC9zRN-kHOtiAZ8_EbylYCdZ3Cx_cJgHmT-SA&oe=6A9ED046"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPpyB1hyz28Q7kNvwE2hYFA&_nc_oc=Adq2nNX6ymKKLEFzy1bs033rT4Ht2NkO4Q-mU_lvUfMOYbIjsU7nA5wMzIcuEvnLIyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGFcUbr8tvEGbhyF97Tvx2frdV8buEviK2yrEhWf0ERA&oe=6A9EC7A9"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPS2g8ZRlVkQ7kNvwEslSHA&_nc_oc=AdpBDpNzJ8old0k4-ZzzBh8v46WWL46q92vF9uXqETJHqpQzEhcO6-YpA366AhcQv-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQFlg5dKDBqF5sMFPO5qlRGu9kJcWrC2cXPIzdukYHOg&oe=6A9EB39E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-sOicRMeokQ7kNvwFG7zg8&_nc_oc=AdozGvjfq1B1c-nvY3WxClJHv2o4oUvajJnb6vkYtOhwNfrAHx2zUxjRajxs7qWNuaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeXWZ8aKtoxhHgI9zpOaNN_ptqET22vbZXnVwOD9lerw&oe=6A9EDCBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBbc0DZEBv4Q7kNvwHIjdKz&_nc_oc=Adrj4n5SrSqjmwnNGmIjJLeFC_cuTAlJOqz6WuDsJ5tyTHzTNyz91iar2pmBh1B-C7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN85MbehHJvybCDMoXSekAr4SKUpyEdAxPM2AhVbR2Ig&oe=6A9EB083"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
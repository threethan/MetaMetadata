04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VSbzUyKkP4Q7kNvwGOkOXc&_nc_oc=Adp3fcS31JrVc1BHHHnwbvdv6te277gCC7iCxX8Oe0l93iimXb25gFjgnUezWPzum9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFyH55IXvdle6224zbnpgWzlJxWRG_xOyuYw9aeKbbNw&oe=6AA567C6"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy3oPRBLCSsQ7kNvwFHnxme&_nc_oc=AdoFisU2bsHNp5GuIG-MSpq0ggRF4ucSBdAsAU40KCYmOS5c3f9R0n5DNunE89XKr0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTjdiIlDzIj7iJIdQeQuHZ4ctLDPp6fyi6MoxI_YHc4w&oe=6AA55F29"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIGbb2kZkr8Q7kNvwF_424M&_nc_oc=AdqxKiDOk4-LJFXeyD2YyHtlR7YEgyQQT58JwOgRrnb2dz2TWQxkCIDlhqZdNJw5bPQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCttcKEvvRPM2SqWJqU15wV-9mb5wmCJ4itFr4f7nuYg&oe=6AA54B1E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szTpEqNiJW4Q7kNvwGVp_Yv&_nc_oc=AdovwYehdLSw57tg36d0rWk5kOs3XnJh--dPyWRjP3iCZlVsw3JV4EK7aiBLXf2DdAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPkV9yFI8-LcXEkhHvYSMl0Dsn-RMRm8tbAZ9i2JxZFw&oe=6AA5743F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrqzSWT5DJAQ7kNvwEMQ5hz&_nc_oc=AdqaC_Czo4OTf9LfzqdM8IDu_s3X8HFmBSo3hy6c6oY9_oDJ7x-1VudDo25x_M5-9Jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrN-SE6pvx5hVl840k2XNHwOoQhVvaV5r1UpsjW-4j3w&oe=6AA54803"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_M3xK0LPMYQ7kNvwE6PnPh&_nc_oc=AdqJX7eECKrcPpJOsnpjmvt11Vj4Sn1HlR3fYvLSLNJeeYcPiUxLz0sJSpawO4kGoms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_HQG2ofMzTxezYBqSWVpp_sqBnxwjYb4IgUOGlBYnxw&oe=6AABFF46"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlKUDhPBIkoQ7kNvwG1b6Kg&_nc_oc=Adq9LYCmt8tA6RL2HW6_gmO9PDBW_wtChtN11052VZULQ-oDcqTtx_aoUuOJ-m6knc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLsKrweRPLFgkx01D-bFuFjJsh1De4K5FT1zCwLktliQ&oe=6AABF6A9"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khQZj-x8OFEQ7kNvwElVK2T&_nc_oc=AdoNVMVVnyFc3PDz2IYDAUV5QuCkHD1snhczcmXclIQw3_bUfoIoM5OQcm2dWS1De-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFovHKXn5tw2G_umtlLNmD41-_DNGpq6opPjnj183UKg&oe=6AABE29E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lNu6pnRz5UQ7kNvwHuX8DO&_nc_oc=AdoFYjk7yKPsJwlj3Lr017_6kzp2T6blUqRFV9xo8ZmPZov8rlGGOcm1_hc4iuVDFhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHA8HBijRFKB1yfokh5veYrrKKQVszbFud1OZV5ScuwQ&oe=6AAC0BBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k90771BHGAYQ7kNvwFupfP0&_nc_oc=AdqJLjZEBPrJRRDwXlICWfZJe121fyPxp8Lin2D6OoT_d-bFPQFBwn8LPA2C-UfZve8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRrNW9ZN-pow8tKA2K1l1eUOdEcWgjNm_kkgY7v2RJVA&oe=6AABDF83"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
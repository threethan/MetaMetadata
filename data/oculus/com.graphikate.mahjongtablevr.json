04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89LA0QPiRUAQ7kNvwHvd3ud&_nc_oc=AdrGOx2u7fhqDVwCVgeaK7gvoJtkwmgUUNJPb06CRVQVemz-vYSQ0pNPfQoCkJGyymc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZQSR6v0M4HiW0PY4hCyyrqfU5Bfmv19uPY08YPZXu5w&oe=6A998A46"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFlsB22brqwQ7kNvwFwePyQ&_nc_oc=AdrYBxwr7SrHrXc8HYBAHiwDO6CPcC9axy_n9C0ibJS1vIIKXlW_XV4TWef65lG7rXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7xmcDh2FnGB2u-5sVCxETZTM7aTnSIJwv9ZRPqZcGsg&oe=6A9981A9"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB5eC78MsDcQ7kNvwFz5fJi&_nc_oc=Adpf7cSK47BZmnUk-cfnUxzHNtnEYmlmtce4HlCUc1xvcud9rTuOFeFwirWz-4gaI4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSYG_PaDtJ18Z3ENtdvDOl7Kj1q4U5hSNiWfbCQnY0GQ&oe=6A99A5DE"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDkVK_raT3sQ7kNvwELoayR&_nc_oc=Adqc-X5X23DDRytQLC7k8qmQ-VvyJBAM4313xDBNfm1jP_vHc67qpiQ-iLUXfTP2RI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqtG8f0r3ItM6_6Eprur_UnqxZ_dLLRa1l8PxrDJDVDw&oe=6A9996BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpzCnO4LapAQ7kNvwGnoKVG&_nc_oc=AdoPLBJZk5hApKdH-lL9vbj0xUFwaNlAtF8lVmzpAvV9nSsv_AcXj_Gj_vwNUaTNWcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWzVd1RFgg0KjugnMuHTdHCcswrHzb7WQ9z9AGcIqddg&oe=6A99A2C3"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
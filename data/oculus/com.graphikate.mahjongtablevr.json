04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zze82Ne3OWwQ7kNvwGZHfvQ&_nc_oc=AdrPkgriEZEeswM9A7V3jUA5fjSDlIh-SRFlmtQCoKXQ86uAbdNnJ9sGKzSsfieP78c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO-3WVxeyzUahrfDaZ7wY6DTLMHNVpJmrWniZoL7n6uw&oe=6A95CE06"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFqpUwgp1s0Q7kNvwHbF6XV&_nc_oc=AdrrzU72KzQ4-jpy1iF6ALsRVWvBg_BzNAUlygK_dFejWG_qYFYRUxhbRiDUQbPegzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGix4a7FxD4Tc5-KOzL5cEuoxX0-sneItMdu09EF1lRoQ&oe=6A95C569"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjMHsHSPPEUQ7kNvwEGsWKY&_nc_oc=Adphu7DaFgQYNRfXUchMXcnLi-7mS4VJ7nlbIXC0wPIxpfCeujWtl6j_UynhLSvLMR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Fnmdab43hMgEA-yblXpMGW1Tnu0WQeFIE6pgHFMyAg&oe=6A95B15E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDkVK_raT3sQ7kNvwGxeJJA&_nc_oc=Ado9S9Jhf7PFsFEzwK-A8quZO7RaQuzvZP-wzL6WbZv0I_wV_K2A3knotrRMv1LKP7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxQsB5cGxWH7Zv-1OxTQNqB1ZO5625RhleUC6Lx8MMfg&oe=6A95DA7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSKwHb6O24MQ7kNvwHQukqy&_nc_oc=Adr5cuF7NwEHxlLPnP8IiaQdfSH4a0vPiW7TC_j08Rltt1Qi4lbOPC4g1mr9grWKb-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxpB-zoFWEptWAtSIXRBuCr-qHiDzS4VVismXQ2kVlbA&oe=6A95AE43"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
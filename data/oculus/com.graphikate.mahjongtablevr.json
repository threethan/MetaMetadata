04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D5nelkBcegQ7kNvwFmf12c&_nc_oc=AdqpsjEi09KBGCReyEg91pzUABRFUdFAu11rhqBBN4zF0yhi2DD4aOJOZQEa-lOO9tc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2fuQWdj9yHgwAAlgfd92MU4vAawLfE7fmQc0OjeYflw&oe=6AA17346"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7x1ec0BHv8Q7kNvwFEV9E0&_nc_oc=AdoOV-EHlvYpB5S1x8Yv0oJocxJGYlyLO5P3uqiK2tPC6f54L5L33nOOIoT7eeeBRM0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5HM444jteRPktjDdATi14OotMdgEUzFutYrQgBIJ_LQ&oe=6AA16AA9"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT-1VxiFBeEQ7kNvwHnL1hL&_nc_oc=Adq7v43ABhNGpu2M_l6C4F_IM0Sbb52MzADRjSZkziCMPhd3wtNTK8KosB6ZdhX_g44&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwSix6XpcUgqMLkUiSezcEnHIxzunio8S0icHE9qBNgA&oe=6AA1569E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-sOicRMeokQ7kNvwELFY-5&_nc_oc=Adowbk_gqTuD544B7Z7Ik2xavIHxNuSvGVRhubgg7EvswJKxQvaSD4MAy6JI8jqn4PA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYX1Fz8L2x7w36PljQG2gEa0VpUZTjJXu-wlobQgsF1Q&oe=6AA17FBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBbc0DZEBv4Q7kNvwG9r9tr&_nc_oc=AdqikomJ0zx_EqM9Bf57b1F90MxhycNEUG3QRqKpGdTCj6zOZuUoyLQCSsTW1fRSwqk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5VAhfcsi9JDw8Jbi50n0haOwBYUUmvjaodbxu20JIiA&oe=6AA15383"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
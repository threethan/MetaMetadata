04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89LA0QPiRUAQ7kNvwHtK3DK&_nc_oc=AdqKjTnFyurviKv1ItceLo0rApDwcT53vXVj3anG8d9WnkN5xmPrnvOuAnsH89f96MM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWOI0t2YwAFkbSvuAFVlFtP6iBDXuT2DYAcE8aiTCRgw&oe=6A9C2D46"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFlsB22brqwQ7kNvwG-6RqG&_nc_oc=AdqgjxAVjvBomN8jYgbMJdCAwoR5pBqqqa-n_hqKIAC6lpwTJv78SgLVWGg3XYaaI7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiiycfD25k9UFZX8At1DQ_eITRMVypbDii08BIoEOrlQ&oe=6A9C24A9"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB5eC78MsDcQ7kNvwF1WD0_&_nc_oc=Adq7K8bd0Ys0I-qjkMBkFdiVKSADykOLoCk2cApI1WWWbPBj2SWAcueKPLfz6P7_YxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnzJVZNr3BV3tUHxdvkP0dww7gJTuOfi3_JTFoKff4YA&oe=6A9C109E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaIfxDCjMowQ7kNvwHaXFNc&_nc_oc=Ado7IaMQViaB87FrMKt1PTqdST_u4BXsUotwXHoJLWaHOO6Ss5cZRxxfQHbCyzaea1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyerqmussxK9jNf3Xby8qT3JVTq3APwzZ7Vx-pqnD-yQ&oe=6A9C39BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-KeFx9KPw8Q7kNvwFTOTK0&_nc_oc=Adp9adkXt1pkGjhrAExqWDjbcmMEyO-Wp1jo9lgMN2DxdhIWPIIs3a4JjWeaikswvZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_JGEEp8C8V2vFGRkeXL3HT5-Ut9xGxtFSsApFNaXr3w&oe=6A9C0D83"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
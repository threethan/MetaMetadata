04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zze82Ne3OWwQ7kNvwHjk38s&_nc_oc=Adoh1Gii3FX4OPE-FCmJMaql-e-NDhNIRbL4g3qOkVSsLgjavVLcP5jh4aJdGnZmpBM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvL8n55o0nMr0Rbdhu3CyuxHUPGoQokZ7htVgpkf46yQ&oe=6A971F86"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFqpUwgp1s0Q7kNvwFzC7-y&_nc_oc=Adp2Im7Fmcg9CjCnCZoczLDzElzPvNyhF0sG2_ZL84mPRigMt1acBCaYC2t94qMWct4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP2fi3yrLUdXGXtI7RuTrocSR6rxT3l7iZA8q4V02hDQ&oe=6A974F29"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjMHsHSPPEUQ7kNvwFx-0Gc&_nc_oc=Ado6unpfCbdMrGU_E3vyHifCI5KgEkUSosXzaVBTsFo1dBIOQpVMk_RVU6iSwLanmZ4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyqOIrwl6xTO4Srq5di9mRisO04wOru-WhNYLbKp7YYg&oe=6A973B1E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDkVK_raT3sQ7kNvwHKhtBQ&_nc_oc=AdrwC_YyX11JUH0kc3FnYO0RBIOMVRkyBxcuvwVnfpvLTsHzppx5RpmZD8JKsVfaJdg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMhC8fKASbEWFaPwQKeFJAWTt8lWfVgVKe5Vhydsh6_w&oe=6A972BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpzCnO4LapAQ7kNvwES2mIc&_nc_oc=AdqRaLTBj8mCIWGI-VDgZiSx0NH72Ly8kQtL88AOgbx5robzfBeR2GltsQauLL581AY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCELOewJPP4HDVAUT0qtupT3pkNX1MCEPQUOH81gu1wQ&oe=6A973803"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
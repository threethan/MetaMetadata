04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG98jvh4AaUQ7kNvwEpiTvf&_nc_oc=AdqI3ez2rr5AeVzbmjiA8UkEnPubg16kQHyPglEzAAyWvrW0jbO2MyTti1ogTiVaq9U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFidp3TkgK1RNW2IYKuCfcQuzRaFyLiEFr6ivXQi_4o4g&oe=6A940C06"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO2vHD1Vo78Q7kNvwFV8mg4&_nc_oc=AdrfeKwCv08zLn6bZ_LX6J-KNeHzTJTBHv_-GTLXX-plfUil77NotGphsYacslhl42g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqx_QzeW36-9v8H3ptshfYhAs8LmwV4imHkeWEuTXH9w&oe=6A940369"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVEocekCMMwQ7kNvwFbz2aF&_nc_oc=AdpaZn224Zys4FO-9bGsvWBq3WNHtI65QeZqox42PZy22-r3mTVMunkIG3wMwC8Indw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNUXMBUHZmKpZNvyoqkIP2Ci-9a_PbJwinKisYkHrewg&oe=6A94279E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_JDfgfbpXIQ7kNvwFNj4UT&_nc_oc=AdrUF157cxoWGxm2EQsYKo77sM20zySc34od-38C4cm8oXpfKYbcROyqxnRXLGWyYp8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv58FzRI97i1tFGbqOq5XfuAPiBXfOF2K17geQYNWukw&oe=6A94187F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSKwHb6O24MQ7kNvwFbXD_p&_nc_oc=AdpVjkxVIr018GjQwIby19HZbQe4Tyuz0xk9cniqJJO5lC9Kw9sEpJApo3AKpIGRI3Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5g2N4jeDM6Zdxs4nGfH2oN8kOY6tHaTfHX-TVGG1vQw&oe=6A942483"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
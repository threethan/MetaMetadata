04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foh0y8uENToQ7kNvwFNLIvS&_nc_oc=AdodtcrGr4lFHwaLKQrNjEj4pBNdo3cVC8JStFPjhvYi-sogjaTD9inY71mZteEyA78&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIYVKbL6BX9sIYoU1Xim705yQBmHTvo4xzPT19OfIvRg&oe=6AA021C6"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPpyB1hyz28Q7kNvwHThbX6&_nc_oc=AdraYM8-0vlsDO8TBg6-0rZdLsXpLlJZm7siLze4b73Z-fXOIwa4oa6XT-8rvW3BBRM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGpMbe-OnuK83Zzb_CFG5hFnDzGamiXHKPW60fT7yr-Q&oe=6AA01929"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPS2g8ZRlVkQ7kNvwHXFU0U&_nc_oc=Adp7Gp7Csh2wFYFax_6Why_jqWDLQrDaM11uJyuwEprA-H95lFLH0zrwuUilWKMhIDQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIESbhl1elQfO67b4UoZorwo6Q1zVKiqKSCQQYQliEOA&oe=6AA0051E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-sOicRMeokQ7kNvwHzqct8&_nc_oc=Ado8ghfpezqOZxMd0236vYTzxrUrbhPD2N0MssstImEinfJ8nMvB1_TzZ9JeMt27WNg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCvJxTvLVOIj1hW6hgFiYDNa0Jch00Jnm8Rf-q17W2Ig&oe=6AA02E3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBbc0DZEBv4Q7kNvwHwdV5Y&_nc_oc=AdpfGS-xY-01r_MQRuY_HukD62S_fKCZbR1GoCSP7p4Geu2H4csmxP141DsGUJwN79o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdt_LGoYe8TFZwVVsMV81CxQ66qpcIDU3B9ymr6iMoww&oe=6AA00203"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
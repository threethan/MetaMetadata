04987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VSbzUyKkP4Q7kNvwEkqPwI&_nc_oc=AdowbTCioqRJVXiN60MjS6OExK-a_JYzNtr9QNRNfju2m8h-Ms5RVYYBR9gnXzoZa98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtHzNJkiAGfoyo6HxNzWlfyQULeqOMXvURcNl65-JicA&oe=6AA80AC6"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy3oPRBLCSsQ7kNvwEleIsO&_nc_oc=Adr3fbHCHrIlm40Eapir85YxzT5I3ObRp6gxLXaoaC_TSIBDRVREoO-mG2VsBMhgows&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZZxtL9xn41D3H5QuOa-zsOkdqOhVZwszjYygN8-AZ-w&oe=6AA80229"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIGbb2kZkr8Q7kNvwHSsyNr&_nc_oc=AdpUWPsM8QYXZB6dEW6xkjhKb_eJPVr6MfUKt3MSOdkROqwsbx-qRevd_UpGxR6UieI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2fKk2PGBM99mvuqjH91UAJZYXl9tiA2LVIs0voQg5jA&oe=6AA7EE1E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePm01w02HooQ7kNvwGF9Rbc&_nc_oc=Adr58i5i2EA3mO42T5t1uILmURZhV622eOrpotgWIquQ2bCYB8GsdY_TOqClN9KbIQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUS_bQAX4XcOu0FopmmrwreZKFfMu21HlsuYwBkSffZQ&oe=6AA8173F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngVnFo2anHwQ7kNvwH3ev_G&_nc_oc=AdrsJ6QNTK-sDacRGk6PWRIHALBKMQLu1wjdlggj8HnFymAJVAj3K10zrF5JGVGIcEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLztgdKnAqVlzLBBzDJ6RpPuropWXck6wA-RE8xebmHJw&oe=6AA7EB03"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648531580
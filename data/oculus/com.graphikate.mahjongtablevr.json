eenshot-2-tiles.png", "id": "3037085083296481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_3037085086629814_5608187919121422803_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSnPQ7VvwWMQ7kNvwEvJrLS&_nc_oc=AdrMjzm6_QPPgLNnMObTjgDpTArI7tA1j0yQWlvd51JrxlR7jrTBUWdDFMLgta3QkEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGFhrs1qevdVggzooiukBibiNEtuhhnwdbHDdDZTMtLg&oe=6ACFA36F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440-v2.png", "id": "1618852946347982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_1618852949681315_6483354325256334167_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Okyv8npPM8Q7kNvwFVIAqT&_nc_oc=AdrvspSnD5al5gEjS_CQtO2cjySYVhInJ22ZSfGWR2JUJzdU_QVhhF-f9RsqVJTWrVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJRRvWGf1_w884v-9oVHNHEvJJSAjG40m7WNDal32Kpw&oe=6ACF8D2D"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nThree rule sets. Singapore: 148 tiles with flowers and animals, instant payouts, scored in tai with an adjustable minimum and cap. Hong Kong: 144 tiles, no animals, scored in fan with a 3-fan minimum. American: private tables for four friends with the Charleston and jokers. Bring your own card; wins and points are agreed at the table.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a 4-letter code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it. Play in VR, or switch to mixed reality and put the table in your actual room.\n\n- Singapore, Hong Kong and American rules\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "Real four-player mahjong in VR or mixed reality. Singapore, Hong Kong and American rules. Friends join from any browser."}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1454871036529297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_1663445985167665_6285353421498183027_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4evORPhLdroQ7kNvwGxP5o3&_nc_oc=AdpK7yPVSQs8msVtLR5K-DyIEVMiXzHVVBiAUuIY5Mi_KEd9wlvPW1QJj8pW3B8yfo8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvhCRwSg6Ypj8LxMJ-rzByol-V0yeiS1C4ykcdHHudHA&oe=6ACFAA59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mahjong 
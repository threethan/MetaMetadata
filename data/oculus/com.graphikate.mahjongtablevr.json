47904987662776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_M3xK0LPMYQ7kNvwEjjjeN&_nc_oc=AdpL2KIVqq2Rx8IctfwgSBxxPL0M5NWHCYvZK-IIciiZW9xqUhHk40hENEg1eqPF2Gs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNI-bVxZJibxd4VGagzWuD6CxHUIwQidgp_-yhQ36kwQ&oe=6AA95C46"}, {"file_name": "screenshot-1-seat.png", "id": "1583885329746068", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619697_1583885336412734_1232291410291248272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlKUDhPBIkoQ7kNvwET9ZPl&_nc_oc=Adq-a5QI3STQWDQKv_nW3cVh36mY1bTKgpSL0_gQt04J8ftnt10evOpM1r2cWRiwiRE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2rC3ReZD2wHpdBz9SmfjD1jOJepT9qa1SSfWmGmgbdw&oe=6AA953A9"}, {"file_name": "screenshot-3-overview.png", "id": "1957514004914617", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499620875_1957514008247950_2769593181572890106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khQZj-x8OFEQ7kNvwGP8gSo&_nc_oc=Ado6nexrNCQj-HxFL2uO8hrTp_c3xXOw4nqP0XPdqNFZcDvdMDmCFmjkjI5faXw-MC4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOFaNVb3h9Ydk0uCvnNNJH_KIQlbdG-cSW7Vxg1TwJLw&oe=6AA93F9E"}, {"file_name": "screenshot-5-night.png", "id": "2751702535216160", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620444_2751702538549493_3801895166710475780_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePm01w02HooQ7kNvwEF0RUg&_nc_oc=AdozJGo4Own1LjTMhtDekXzhmVJlDvJDcJdgFavwpFP4-i_cfrNbRkSBCGSd6V-A_mc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7gln5zrV-AKbrz7scF-4kWpIlf3nkIh2Ef_HIl_yCsQ&oe=6AA968BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1020015244080350", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499623601_1020015247413683_7470808261870336801_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngVnFo2anHwQ7kNvwHDTMSP&_nc_oc=Adq0gYKnbzLLnJm2mTLU_2FR4qRQ3xSiBitYswe7lJkFz__GTZomsFkVIm8628u4qP0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0uBYwO8TCFDBP_XRerGVdrNjxBe-pbdqdOQ3yTdbn6Q&oe=6AA93C83"}, "display_name": "Mahjong Table VR", "keywords": ["mahjong", "tabletop", "multiplayer", "singapore", "tiles"], "long_description": "Sit at a real mahjong table without leaving your room. Mahjong Table VR is full four-player Singapore mahjong with real physics: you pick tiles off the wall, rack them, and throw your discards onto the felt.\n\nPlay solo against three bots, or host a table and have up to three friends join from a phone or laptop with a room code. They don't need a headset and joining is free. Voice chat is built in, so the table talk comes with it.\n\nSingapore scoring, done properly: flowers and animals with instant payouts, rob-the-kong, sacred discard, dealer repeats, prevailing and seat winds, chicken hand toggle, adjustable minimum tai and caps. Stakes are counted in chips.\n\n- Full Singapore rules with a proper tai table\n- Real tile physics: wash, stack, rack, throw\n- Solo vs bots with three difficulty levels\n- Up to 4 players: friends join free from any browser, no headset needed\n- Built-in voice chat at the table\n- Mixed reality mode: put the table in your actual room\n- Play with controllers or bare hands\n- English and Chinese\n\nOne hand takes about ten minutes. Pull up a chair.", "short_description": "The only real four-player mahjong in VR. Singapore rules, real tile physics, and friends join free from any browser. "}]}, "developer_name": "Graphikate", "developer_privacy_policy_url": "https://mahjong-vr.pages.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GRAPHIKATE PRIVATE LIMITED", "support_website_url": "https://graphikate.com/", "website_url": "https://mahjongtable.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "167648
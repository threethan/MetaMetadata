d=6e7a0a&_nc_ohc=vi2gshuTIKUQ7kNvwEDNwjL&_nc_oc=AdoyomiOYKjrz_6HwUJTR5wdmW6pcp3ZO3cRsiRAsUckPA3yj87jExAGPTmVlZRLrN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LXBns1ByYsF_GCX2oX4Q31ivxGeQsFrh7tJvfDhkuVA&oe=69D4F061"}, {"file_name": "Squingle-Twinkled-Screenshot-03.png", "id": "1013963573823261", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974526_1013963577156594_2061989920474998390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak5vlhjyD2sQ7kNvwG2pN1o&_nc_oc=AdpfD5UuHJNJDKyYpE4cRwZMuELQMUm52Z4cBC3s1ShC9q3F8U-SpZaU4Vt_ehDbyHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kmAvVGXD6qgjJcnQmcUx8uKNJWRhX_Mb68B6_mn75RQ&oe=69D4EA16"}, {"file_name": "Squingle-Twinkled-Screenshot-05.png", "id": "2121495998306034", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_2121496001639367_6867377017957057624_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFhmKpJP9m4Q7kNvwFyKliG&_nc_oc=AdrnHPQLBFPbDxt7MwvoGisw1T4k4ezzYSrN1SB21P94rcov5_EWXhRv5VRzDuHahfE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_xfGJe0ZJVvfsuLLt_eCeBRjQEhu6vn6WDFZ_nVxaIA&oe=69D5042A"}, {"file_name": "Squingle-Twinkled-Screenshot-01.png", "id": "1186035523063640", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974783_1186035526396973_4771898997726366931_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq4C6qOoiEUQ7kNvwHAPpZn&_nc_oc=AdrA1wuCa3HrEUtoezASnvfuNCfYuhA9bKj2_WUIgr3mzeHVtO6vvpmyuMAap3oyTTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Na4V-3D3C1Ed7pKOhXQjgHCbp0Sux_4B5GY3sc-D1kQ&oe=69D4E20F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "487841280996149", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031435_487841284329482_7014507726029390394_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY99y52j3ncQ7kNvwGfR1Bw&_nc_oc=Adrzp2xLnnDxOTun755Kn6TLEv6pLKPIgHImS9Xf5G0mKilqCOdzneWKbUGfBpNMLhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mnYrSY8br230cROwmZFom6_Xd4dQ_X26VRwGNRJ3g_A&oe=69D4E571"}, "display_name": "Squingle", "keywords": ["puzzle", "mr", "puzzling", "squingle"], "long_description": "Squingle is a cosmic 3D puzzle game that could only exist in VR.\n\nYour challenge is to guide 2 spinning orbs to the goal through intricate, glass-like mazes called \u2018squingles.\u2019 \n\nEach level offers a mesmerizing visual experience, featuring dynamic, morphing sculptures that come to life in fully immersive environments or in Mixed Reality. \n\nWith intuitive controls and hand-tracking support, Squingle will captivate your mind and spirit.\n\n#  \u2728 100 LEVELS\nLaunching with 100 levels, with more added over time. Levels grow complex, featuring tighter spaces and new challenges.\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing sculpture, offering an unmatched visual experience in Mixed Reality or fully immersive modes.\n\n# \ud83e\udde9 EASY TO PICK, HARD TO MASTER\nDesigned to be accessible for both newcomers to VR and experts seeking a transcendent experience, with intuitive controls and hand tracking support for seamless play, whether standing or seated.\n\n# \ud83d\ude0c RELAX & UNWIND\nPlay on the sofa or in room-sized mazes. Squingle\u2019s calming gameplay will soothe your soul.\n\n# \ud83c\udfc5 AWARDS\n- Best VR Game ~ GDWC Finalist\n- Finalist ~ QLDXR Festival\n- \u201cBest of the Quest\u201d ~ Gibby\u2019s Guide\n\n# FEATURES\n- Challenge Mode: Time trials and global leaderboards.\n- Room/Mini scale: Play big or small!\n- Race your ghost: Beat your best times.\n\n\nGet ready to be Squingled!", "short_description": "Squingle is a cosmic 3D puzzle game that could only exist in VR.\n\nYour challenge is to guide 2 spinning orbs to the goal through intricate, glass-like mazes called \u2018squingles.\u2019 \n\nEach level offers a mesmerizing visual experience, featuring dynamic, morphing sculptures that come to life in fully immersive environments or in Mixed Reality. \n\nWith intuitive controls and hand-tracking support, Squingle will captivate your mind and spirit."}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "pl", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9833448970016067"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_1617908775465552_6402685251699552058_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2Qv9_8GeqMQ7kNvwGy76d2&_nc_oc=Adr4Q65V9YnJI_r7Ue69SyYEyKhBrTQMuPrjkL1KzeFcIPronHXt0Phs0UD3zYpnlj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eRXxCsPCmQMSEPoFQJwEGQ-xQZUcPn5iwqnPyuwI4NA&oe=69D4E74C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squingle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1732212000, "lastRevision": {"nodes": [{"id": "9288954744465495
Q7kNvwGZU5kK&_nc_oc=AdnxejDgQ4VAaINVszqpeEM08mXD5THpR0H32_K3bSS5tKUsKVL4sJG3XSLxFlJ_9qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsXiYXVSZnFb3CE0IEjncsQxU3_lzE77UqoGdhlQNQirQ&oe=69A6D181"}, {"file_name": "screenshot-04.png", "id": "4126929497534637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974635_4126929500867970_4262452980415593861_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1KBL7jU4-4Q7kNvwHIN5Ch&_nc_oc=Adl0P5DbfIlbaqakel7m5Y0-hblNZ54y9SJ00iQm5f5ZspybZ3GfDurH7l_9b7XaWSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBWW8DSlBLcpL2i3jcyK5-F9F4OgJTU8uedNrxtAVkjA&oe=69A6C06D"}, {"file_name": "screenshot-13.png", "id": "2055235781600121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286675_2055235784933454_4629890574825469283_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXzspGjK1-0Q7kNvwGJqNKS&_nc_oc=AdmjA4WmDYPLT1puZtj7IDWiggtifCPVdowAFk2r5t_tY9AHrxwoQTiCgB4GOXITRc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsjRnTGZzPknGHbNe0vuRghIcfWZ-v-iokScI_QYsLRMg&oe=69A6CFC3"}, {"file_name": "screenshot-11.png", "id": "1600564897226685", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974803_1600564900560018_6058402302123344296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98UwD3_MoWcQ7kNvwFzCptF&_nc_oc=Adn2Y2WRbC3aqjGWmU3Qf29ec66xTkgTHG-vXCPieZpWRino5FxCFpnmfIYkAz1w3Hw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3TRX6rU_oz4cmj5KwJ9cwSA7_QmC_ssf8EBheMrI1-Q&oe=69A6CB68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-FULL.png", "id": "371948285912904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631740_371948289246237_6520084295772107681_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id6yRKhYlhgQ7kNvwFo4tw9&_nc_oc=AdkiHWxPQ3B88gc4vY0rQZmOLfkpmvj1RTOEpaezrefuB4nAgqwaLIa8YRzsBkKM5SI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgZ1mMesIzEuMnPUzHjqCqgoesGzcVN4yvc2_2Bi1yPw&oe=69A6BEB5"}, "display_name": "Squingle", "keywords": ["puzzle", "mr", "puzzling", "squingle"], "long_description": "Pre-order for exclusive bonus content!\n\nSquingle is the ultimate Mixed Reality 3D puzzle game. \nNavigate glass-like mazes called \u2018Squingles,\u2019 guiding orbs while avoiding edges and collecting points. Discover why it\u2019s a critically acclaimed 5-star masterpiece!\n\n- 10/10 - \u201cThe perfect VR game.\u201d ~ Zimtok5\n- 93% - \u201cA masterpiece.\u201d ~ RuffTalkVR\n- 91% - \u201cOne of a kind.\u201d ~ VRGameCritic\n- \u201cBrilliantly creative\u201d ~ RoadToVR\n\n# \u2728 100 LEVELS AND MORE TO COME\nLaunching with 100 levels, with more added over time. Levels grow complex, featuring tighter spaces and new challenges.\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing sculpture, offering an unmatched visual experience in Mixed Reality or immersive modes.\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n# \ud83d\ude0c RELAX & UNWIND\nPlay on the sofa or in room-sized mazes. Squingle\u2019s calming gameplay will soothe your soul.\n\n# FEATURES\n\n- Level Add-ons: New puzzles soon.\n- Mixed Reality: Augmented or immersive modes.\n- Challenge Mode: Time trials and global leaderboards.\n- Hand Tracking support.\n- Room/Mini scale: Play big or small!\n- Race your ghost: Beat your best times.\n\n# \ud83c\udfc5 AWARDS\nBest VR Game ~ GDWC Finalist\nFinalist ~ QLDXR Festival\n\u201cBest of the Quest\u201d ~ Gibby\u2019s Guide\n\n# \ud83d\udc96 Experience SQUINGLE\u2019s almost perfect 5-star rating on the Quest Store. Get ready to be Squingled!", "short_description": "Pre-order for exclusive bonus content!\n\nSquingle is the ultimate Mixed Reality 3D puzzle game. \nNavigate glass-like mazes called \u2018Squingles,\u2019 guiding orbs while avoiding edges and collecting points. Discover why it\u2019s a critically acclaimed 5-star masterpiece!"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "pl", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9351314144896221"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1124679472362691"}, {"status": "PUBLISHED", "id": "1081981156897711"}, {"status": "PUBLISHED", "id": "1900321310574019"}, {"status": "PUBLISHED", "id": "1489339388785962"}, {"status": "PUBLISHED", "id": "24537726682550174"}, {"status": "PUBLISHED", "id": "1239097030693793"}, {"status": "PUBLISHED", "id": "1671815780098259"}, {"status": "PUBLISHED", "id": "967144615359905"}, {"status": "CANCELLED", "id": "936196335246111"}, {"status": "CANCELLED", "id": "1308648443792846"}, {"status": "PUBLISHED", "id": "598652459221476"}, {"status": "PUBLISHED", "id": "1510570189645959"}]}, "baseline_offer": {"id": "1510570189645959"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1900321310574019"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"node
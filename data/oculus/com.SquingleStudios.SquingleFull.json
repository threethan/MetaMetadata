d=6e7a0a&_nc_ohc=pUvlaM7BxAUQ7kNvwE8xmq8&_nc_oc=AdpBkrW6PGWW-p4VHvIgcKUI26s4VnBSQkwMnqhA2JxXYOlgBPvIbLLwTw7OAA4LQXQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT87mYIzzxe2cP2rQWzDKCvyteY9G-74gcHefRRZy_HA&oe=69C7C161"}, {"file_name": "Squingle-Twinkled-Screenshot-03.png", "id": "1013963573823261", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974526_1013963577156594_2061989920474998390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90e0KQzeFHEQ7kNvwHqxeti&_nc_oc=AdoJcDpP-ucSYHaexwCA85fjusJWUeXuoerJRHzTMdGOFRhBFMAD2YoU10v4TI6wIUc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZvaX-F_3J_HsNfMblWhEnMhs76vM7HDkEVxqUqjCXyA&oe=69C7BB16"}, {"file_name": "Squingle-Twinkled-Screenshot-05.png", "id": "2121495998306034", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982488_2121496001639367_6867377017957057624_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjK5o9X6a94Q7kNvwEvu1mp&_nc_oc=AdocO7caHgH-VdaBUUFdIipI0OfaQeHtQs5BPdO7VpH6q8IAwx1mBJdRaolC1fpMA3k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi4HoHRFAfS2-7pjq_3zPL3iDi1aaXShgvxie9jWZ21w&oe=69C7D52A"}, {"file_name": "Squingle-Twinkled-Screenshot-01.png", "id": "1186035523063640", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974783_1186035526396973_4771898997726366931_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGAZqBhwHqQQ7kNvwGa7bcs&_nc_oc=AdrDuTy3IfdRYlH7_0m54QNJxf6ByTIGlbl_1AtRMLHLkWkjant19G5tTcWTCMO65sc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeD4BEApZSRqteBsdDLB3zPfYNh_hqlZP3JWnIi3ycnw&oe=69C7B30F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "487841280996149", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031435_487841284329482_7014507726029390394_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T8WVPMJa5QQ7kNvwGz_qNj&_nc_oc=Adrqb-JpLDzYAIIAXdoxjsLlInjtuXc9iu1Fpkkx3p_3pE-fSF_ZRab6vIk0OBWFHYg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzT1c_YLz9jLTB7xLDpSt3WFVLJ3_o5Haok9yRV0spLdg&oe=69C7B671"}, "display_name": "Squingle", "keywords": ["puzzle", "mr", "puzzling", "squingle"], "long_description": "Squingle is a cosmic 3D puzzle game that could only exist in VR.\n\nYour challenge is to guide 2 spinning orbs to the goal through intricate, glass-like mazes called \u2018squingles.\u2019 \n\nEach level offers a mesmerizing visual experience, featuring dynamic, morphing sculptures that come to life in fully immersive environments or in Mixed Reality. \n\nWith intuitive controls and hand-tracking support, Squingle will captivate your mind and spirit.\n\n#  \u2728 100 LEVELS\nLaunching with 100 levels, with more added over time. Levels grow complex, featuring tighter spaces and new challenges.\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing sculpture, offering an unmatched visual experience in Mixed Reality or fully immersive modes.\n\n# \ud83e\udde9 EASY TO PICK, HARD TO MASTER\nDesigned to be accessible for both newcomers to VR and experts seeking a transcendent experience, with intuitive controls and hand tracking support for seamless play, whether standing or seated.\n\n# \ud83d\ude0c RELAX & UNWIND\nPlay on the sofa or in room-sized mazes. Squingle\u2019s calming gameplay will soothe your soul.\n\n# \ud83c\udfc5 AWARDS\n- Best VR Game ~ GDWC Finalist\n- Finalist ~ QLDXR Festival\n- \u201cBest of the Quest\u201d ~ Gibby\u2019s Guide\n\n# FEATURES\n- Challenge Mode: Time trials and global leaderboards.\n- Room/Mini scale: Play big or small!\n- Race your ghost: Beat your best times.\n\n\nGet ready to be Squingled!", "short_description": "Squingle is a cosmic 3D puzzle game that could only exist in VR.\n\nYour challenge is to guide 2 spinning orbs to the goal through intricate, glass-like mazes called \u2018squingles.\u2019 \n\nEach level offers a mesmerizing visual experience, featuring dynamic, morphing sculptures that come to life in fully immersive environments or in Mixed Reality. \n\nWith intuitive controls and hand-tracking support, Squingle will captivate your mind and spirit."}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "pl", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9833448970016067"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982685_1617908775465552_6402685251699552058_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJtmiLKq0tEQ7kNvwH0hSfS&_nc_oc=AdrXL6pzN4jsN6BWu8khpNef1d4NqD0cLQfuf2571MEKQThkZ1seSUdzln8YDwaTKMg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKtXqbNAm45uXj_JFG9rfM5ub7N0kj3NRCH-61KH_ZsQ&oe=69C7B84C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squingle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1732212000, "lastRevision": {"nodes": [{"id": "9288954744465495
d=6e7a0a&_nc_ohc=nBaICaMLW70Q7kNvwG27ued&_nc_oc=Adpp6QHaLB4FW7r3_Zx1aRUlCSoUDeW2_Ay_XSr52KNiGdJF9Xv8UO1ofvfmayyPKYg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HQUyMc2x5OI51U-N3kpWVLBLda7Cl45KKKwvKZlaWHQ&oe=69D79361"}, {"file_name": "Squingle-Twinkled-Screenshot-03.png", "id": "1013963573823261", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974526_1013963577156594_2061989920474998390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbhRVb6eU0cQ7kNvwEsMuTw&_nc_oc=AdqF6eginTvhhp5WRyabyl3ztHbnHhKv3BT_t5-LKAra5WACmkSC5q_KW7XUWxVi6OI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3it7e87HJLgpVnGDV0NmZN7FmbJwgILOTIty2iWuyv1Q&oe=69D78D16"}, {"file_name": "Squingle-Twinkled-Screenshot-05.png", "id": "2121495998306034", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982488_2121496001639367_6867377017957057624_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JiGHj6pWaMQ7kNvwGeuh86&_nc_oc=AdoGOfBi9dUO53ZdWuHBh8uEFJ4a8FuPMg4B39a8P27WghHYXntwPgMDnUr1F92Uk9U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YXWEa6Gc5v-kv0dZUijG6tsTRpcGRhjrHfBLavGq89Q&oe=69D7A72A"}, {"file_name": "Squingle-Twinkled-Screenshot-01.png", "id": "1186035523063640", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974783_1186035526396973_4771898997726366931_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7r7Sb00BrgQ7kNvwGkoqfS&_nc_oc=Adr1eKCLnKu4e3-dFatjmtvL0cN4kMD_sX38jr-U4tjgdT6mpaE1aQotRBKrl0Hflic&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Im1f7-QXJCsF_Jwd8ehroStPAJS3icJ9x5a6SOJ15Uw&oe=69D7BD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "487841280996149", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031435_487841284329482_7014507726029390394_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY99y52j3ncQ7kNvwGkIimQ&_nc_oc=AdqIaqi92lz1YmDgJJqihsXRKHRfh6CbjKE32_WYiv1JOSa17iSgGvT0Y0NnA__LJPM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZgVl5r49crd4ve7hSd8n52vv6mlVe1U4Qo9K2J_xPQw&oe=69D78871"}, "display_name": "Squingle", "keywords": ["puzzle", "mr", "puzzling", "squingle"], "long_description": "Squingle is a cosmic 3D puzzle game that could only exist in VR.\n\nYour challenge is to guide 2 spinning orbs to the goal through intricate, glass-like mazes called \u2018squingles.\u2019 \n\nEach level offers a mesmerizing visual experience, featuring dynamic, morphing sculptures that come to life in fully immersive environments or in Mixed Reality. \n\nWith intuitive controls and hand-tracking support, Squingle will captivate your mind and spirit.\n\n#  \u2728 100 LEVELS\nLaunching with 100 levels, with more added over time. Levels grow complex, featuring tighter spaces and new challenges.\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing sculpture, offering an unmatched visual experience in Mixed Reality or fully immersive modes.\n\n# \ud83e\udde9 EASY TO PICK, HARD TO MASTER\nDesigned to be accessible for both newcomers to VR and experts seeking a transcendent experience, with intuitive controls and hand tracking support for seamless play, whether standing or seated.\n\n# \ud83d\ude0c RELAX & UNWIND\nPlay on the sofa or in room-sized mazes. Squingle\u2019s calming gameplay will soothe your soul.\n\n# \ud83c\udfc5 AWARDS\n- Best VR Game ~ GDWC Finalist\n- Finalist ~ QLDXR Festival\n- \u201cBest of the Quest\u201d ~ Gibby\u2019s Guide\n\n# FEATURES\n- Challenge Mode: Time trials and global leaderboards.\n- Room/Mini scale: Play big or small!\n- Race your ghost: Beat your best times.\n\n\nGet ready to be Squingled!", "short_description": "Squingle is a cosmic 3D puzzle game that could only exist in VR.\n\nYour challenge is to guide 2 spinning orbs to the goal through intricate, glass-like mazes called \u2018squingles.\u2019 \n\nEach level offers a mesmerizing visual experience, featuring dynamic, morphing sculptures that come to life in fully immersive environments or in Mixed Reality. \n\nWith intuitive controls and hand-tracking support, Squingle will captivate your mind and spirit."}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "pl", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9833448970016067"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982685_1617908775465552_6402685251699552058_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPLOxU-1OFwQ7kNvwF6un3k&_nc_oc=Adojrh0DvM-UiP6O_OlLxVkdsf0AJwyNPJgk8ZrmIrTsOmQ-5RAokqIKzhDS6wbA_EE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pIbLL0B7hTxP-gocoSpDSZfBaK-qeLvJCK_jemnN4ZQ&oe=69D78A4C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squingle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1732212000, "lastRevision": {"nodes": [{"id": "9288954744465495
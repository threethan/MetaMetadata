d=6e7a0a&_nc_ohc=Y5byzJrizNkQ7kNvwFtzhwf&_nc_oc=AdqzdHxGz7iKmIJWNYD4ndIeH40BC-XTnGxVWRD--m5YJaUI-rHGPVyTSYgOWVFHoag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSt2oUmE9v53RK4aNmobbQGHv2wdjzUyO7S5n3CQOErw&oe=69D0FBE1"}, {"file_name": "Squingle-Twinkled-Screenshot-03.png", "id": "1013963573823261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_1013963577156594_2061989920474998390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nElCPd2vls8Q7kNvwF7M--9&_nc_oc=AdpQWWyQdky180ixX9917XQoIosPBLC9obqPUIargnYz6kWi_fO85YDrr5tZEcyEei4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-HwUpaGrL2IzBIyhCxWLcsZhN5AzEHBWzIV1A9bv7gg&oe=69D0F596"}, {"file_name": "Squingle-Twinkled-Screenshot-05.png", "id": "2121495998306034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_2121496001639367_6867377017957057624_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5bl-vNEXXQQ7kNvwGQMur3&_nc_oc=AdpzK8aVS69lRpukPMypIw8sYXFm1df4OVY0UmuT1VMJqsV3zOPqcL6e9kBeQ0HyssI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN2ZZpxcc7pfIE4Y7re2OEAaoFLZMoVJmijhsrP4pHjw&oe=69D10FAA"}, {"file_name": "Squingle-Twinkled-Screenshot-01.png", "id": "1186035523063640", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974783_1186035526396973_4771898997726366931_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHNLsMTGbyMQ7kNvwFZgNIS&_nc_oc=AdoId2qv3DBTxMWk6CAj5xG-6WzfXYM6Oi5mPl1kr5Q3WEl_f5Xs76ZwFf9WxCcQUJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz30gGNGNG901PBTCOeOEM1aXIB5a94NopswpcH4Jdz9w&oe=69D125CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "487841280996149", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031435_487841284329482_7014507726029390394_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls2DiWXFyZkQ7kNvwGnWgp0&_nc_oc=Adrp2abzCu4KT10Xi17n1QP4XPGp-4-Zbt-vTh2WjhdJcSDrRYylQRKPDZQ35hRU_7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdtSP64SB5IAy3RmKXK6aouPHqO_ZQm-95j4qOx7UGuw&oe=69D0F0F1"}, "display_name": "Squingle", "keywords": ["puzzle", "mr", "puzzling", "squingle"], "long_description": "Squingle is a cosmic 3D puzzle game that could only exist in VR.\n\nYour challenge is to guide 2 spinning orbs to the goal through intricate, glass-like mazes called \u2018squingles.\u2019 \n\nEach level offers a mesmerizing visual experience, featuring dynamic, morphing sculptures that come to life in fully immersive environments or in Mixed Reality. \n\nWith intuitive controls and hand-tracking support, Squingle will captivate your mind and spirit.\n\n#  \u2728 100 LEVELS\nLaunching with 100 levels, with more added over time. Levels grow complex, featuring tighter spaces and new challenges.\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing sculpture, offering an unmatched visual experience in Mixed Reality or fully immersive modes.\n\n# \ud83e\udde9 EASY TO PICK, HARD TO MASTER\nDesigned to be accessible for both newcomers to VR and experts seeking a transcendent experience, with intuitive controls and hand tracking support for seamless play, whether standing or seated.\n\n# \ud83d\ude0c RELAX & UNWIND\nPlay on the sofa or in room-sized mazes. Squingle\u2019s calming gameplay will soothe your soul.\n\n# \ud83c\udfc5 AWARDS\n- Best VR Game ~ GDWC Finalist\n- Finalist ~ QLDXR Festival\n- \u201cBest of the Quest\u201d ~ Gibby\u2019s Guide\n\n# FEATURES\n- Challenge Mode: Time trials and global leaderboards.\n- Room/Mini scale: Play big or small!\n- Race your ghost: Beat your best times.\n\n\nGet ready to be Squingled!", "short_description": "Squingle is a cosmic 3D puzzle game that could only exist in VR.\n\nYour challenge is to guide 2 spinning orbs to the goal through intricate, glass-like mazes called \u2018squingles.\u2019 \n\nEach level offers a mesmerizing visual experience, featuring dynamic, morphing sculptures that come to life in fully immersive environments or in Mixed Reality. \n\nWith intuitive controls and hand-tracking support, Squingle will captivate your mind and spirit."}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "pl", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9833448970016067"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_1617908775465552_6402685251699552058_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmLfLrA9sP8Q7kNvwFnuNqG&_nc_oc=Adp6pKJ1Y9Wvn3wmCUdsLQlLzBOJB3CzjyOZCI3DaYvo5K0WZnLPzm8W0lcSBBhOiK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPMaSIN-uKXYX1hAjJ8goAVC-oOsSt9sqoZqg0HC-7FA&oe=69D0F2CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squingle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1732212000, "lastRevision": {"nodes": [{"id": "9288954744465495
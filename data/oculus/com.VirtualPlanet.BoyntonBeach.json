uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821972_812941538085236_4339074728186284506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQroarscEB8Q7kNvwEmdBKN&_nc_oc=AdpZ6fpqPgZ2yzApDJwu0nXcXqNl8dtWDPjK6oikVHkpov3r6hz7zxwm3bck9WLBvu8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQpQmdtn9ZICqdokFYPS5khPJsgF2E3XH1HlAVmrN9CQ&oe=6A620447"}, {"file_name": "Screenshot02.png", "id": "1532260194428187", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305050_1532260197761520_3938890083851124073_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp51_TBJZ4kQ7kNvwGnqahw&_nc_oc=AdrBg2lIMJ5CL9evp_513n4ywtEGKkgz58ndf_XphVfyUXbeKgzccnxp0GmUOGMEUCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDwwKmd-pKx8oncXuSm-Y4DJ8ZycnkskZ83d4wAxXGfA&oe=6A62228E"}, {"file_name": "Screenshot03.png", "id": "32446160748316811", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300574_32446160751650144_27126381873821092_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY_nP_nvHAAQ7kNvwH9fp0R&_nc_oc=Adqn2W6aTtIvVVCLugADpd8LVNwDBl-i8Vqr-ugVop68Qx4MLH_1faBFIxTcQEt1EXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAx0ybGRQpv7Fs1D6WhCmInZ3r4ilaWdR63Kdl6vbaWCg&oe=6A621986"}, {"file_name": "Screenshot01.png", "id": "816844664239432", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304305_816844667572765_5691164272222335878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjM09lSIYg0Q7kNvwHumY74&_nc_oc=Adp5MhN4VoHxkMf8ivi1g4D9VeiyANqITJXAG74hTmkgxLNAQtoxciWyYqhzgqR8TV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmt0SKNT4y3hKD1xNqD88rdGjX1IqFU3UjwdAKAIgGvQ&oe=6A622F08"}, {"file_name": "Screenshot05.png", "id": "1827693398101162", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311585_1827693401434495_8304425342075194876_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZSTrZSMAvUQ7kNvwG5L0Qi&_nc_oc=AdoIud_eUBE_feTvk3s_QDkrUXNpyXZw4o5bGN0eBgOwlWdpCXxybkUjy07wgLRrAoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO5ow6KRtRnVnkiZeUqO7KCXHzRNI2w7vZdfisBmDVng&oe=6A621A75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Boynton Beach", "keywords": ["resilience", "Boynton", "climate", "adaptation", "SLR"], "long_description": "Discover Boynton Beach, FL through a new lens.\nIn this immersive 360\u00b0 journey, explore how one of Florida\u2019s most vibrant coastal communities is tackling climate challenges head-on. From the heart of the city to the mangrove-lined Intracoastal, experience the beauty, risks, and resilience shaping Boynton Beach\u2019s future.\n\n\ud83c\udf0a See the Story Unfold\nFly over sunlit marinas, shaded parks, and lively neighborhoods as the experience reveals how heat, flooding, and sea level rise are transforming the city. Watch as solutions take root, shade trees cooling streets, mangroves protecting shorelines, and communities coming together to plan for tomorrow.\n\n\ud83c\udf31 A Vision for a Stronger Coast\nCreated in collaboration with the City of Boynton Beach, the Coastal Resilience Partnership of Southeast Palm Beach County, and NASA DEVELOP, this experience turns complex climate data into a story everyone can see and feel. It\u2019s a look at what\u2019s at stake, and how collective action is shaping a safer, more sustainable future.\n\n\u2728 Step inside. Learn. Imagine. Act.\nEvery scene invites participation: explore, click, and visualize change. Because when technology and community come together, the future becomes something we can all shape.", "short_description": "Experience Boynton Beach like never before in this immersive 360\u00b0 story. Explore how this vibrant coastal city is confronting rising heat and sea levels while protecting its parks, marinas, and neighborhoods. Created with the City of Boynton Beach and partners, this interactive journey shows how innovation and community action are shaping a resilient, sustainable future."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": "https://www.virtualplanet.tech/#contact-us", "website_url": "https://www.virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32022188690760633"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2139215429977573"}, {"status": "PUBLISHED", "id": "1195775525761843"}]}, "baseline_offer": {"id": "2139215429977573"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780061460, "status": "PUBLISHED", "id": "2139215429977573"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32602117446101085", "version": "0.12"}, "id": "1693429661345114", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "30643928381920011", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32602117446101085"}, "release_status": "RELEASED"}, "binary_release_chann
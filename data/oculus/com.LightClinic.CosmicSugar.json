9_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1hEQM031j0Q7kNvwGlAFGm&_nc_oc=AdpzD3SC02Ip0J35iwWEUc0TpxvRpSocr8gmja0_QKlg9nBLJ6wHZPqTNG6a_j-E3Jo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2le9q4MojZcY4dsbLwhba8rrmQkcQ71jW7jYL8wwKH5w&oe=69F21AD3"}, "display_name": "Cosmic Sugar", "keywords": [], "long_description": "Cosmic Sugar is a trance inducing physics sandbox. It can be used for art making and light shows. Cosmic Sugar visualizes natural forces in a way that is similar to sand grains on metal surfaces revealing hidden cymatics. It is a relaxing and engaging universe which responds in completely unique ways to the personalities and interactions of each individual artist.", "short_description": "Find your flow state in a galaxy of stellar dust."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicsugarvr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Light Clinic", "support_website_url": "https://cosmicsugarvr.com/", "website_url": "https://cosmicsugarvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2735344096772064"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974809_3325911214181496_3792729672
ject_39.png", "id": "1146027176877945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1146027180211278_6900323663202133216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Phk0ci66An0Q7kNvwEKrdeG&_nc_oc=Adr-K5Oq_kTTqhqTcGBq2t657JVNIl0ZbKcAzahlgGLnAj1JlqNn1B4N8S7hNt1euWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7Wkxo0qPjwDgyCGyVllJklo9GoCuyzmjjLAEZW7xfaA&oe=6A3BEBBC"}, {"file_name": "backroom.png", "id": "1993297611208559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_1993297617875225_7729927286656875447_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIasu95gmCUQ7kNvwGN8Jih&_nc_oc=AdrdZRXzKlEDK10PBPeXOQvFk8Bdb2GI6N01eOxHQCqFzs6odHR8XwqO0HuWYb8KRUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SG63Gk2qL1Pbd1xxRVkMeEEa0ntYfwQ5gJN_G_hSIGg&oe=6A3BE1BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_43.png", "id": "1758399128261889", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1758399131595222_3242421812600278716_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4psbqAocqQQ7kNvwGwsumo&_nc_oc=AdohMe24UmXqAt2udGpnx5-Frx82jJ2w_-CI7xxof3NW5ZJNjd6IUdWKsZuWGDKbbcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2CbeA8sddVGMCby6pSXnu4r7UiXs-hYgblns4Rb-aUQ&oe=6A3BE161"}, "display_name": "Lucid Descent", "keywords": [], "long_description": "Step into your nightmares  and never wake up.\nLucid Descent is a VR horror fan game inspired by Gorilla Tag, where reality fractures and primal fear takes over. You aren\u2019t just running for fun anymore you\u2019re running to survive.\n\nIn this twisted, dreamlike descent, the familiar mechanics of Gorilla Tag are reborn in a surreal, haunting world that shifts with every heartbeat. The walls whisper. The floors breathe. And somewhere in the darkness, something hunts you.\n", "short_description": "Welcome to lucid Descent...this is a vr game inspired by gorilla tag horror! "}]}, "developer_name": "voxelate", "developer_privacy_policy_url": "https://sites.google.com/view/53tk558u48u45984i9/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "voxelate_dev", "support_website_url": null, "website_url": "https://sites.google.com/view/53tk558u48u45984i9/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25483074441300077"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_2030906877713359_8142556246986442723_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVce5nYpIlMQ7kNvwGsaD-_&_nc_oc=AdqOjoZoxa27jYTMqCZW9oO8RD-My4F9uRkovJhveeSKIC-fh3TZQ_zhcpPq8fedW4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-etWuO7eT3Q8j2LKmX2PUfk4TaPfBRonbNzvfxo29Jpw&oe=6A3BDA3A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lucid Descent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1761488280, "lastRevision": {"nodes": [{"id": "25350549114552611", "release_type":
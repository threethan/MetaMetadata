ject_39.png", "id": "1146027176877945", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1146027180211278_6900323663202133216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGgEQU6lu-IQ7kNvwH_xit0&_nc_oc=AdqwsBm-fknabq75S29ya3SAHLV3D3XjRipxcxnQI6KFhr1sdGhpdDdojozpisMKN5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yf_v00Ogxy7GBK4zcpdbT2lIc3t_m6ap13LWe5rRYzQ&oe=6A28253C"}, {"file_name": "backroom.png", "id": "1993297611208559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_1993297617875225_7729927286656875447_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rg1bl_F4GwoQ7kNvwGbmBV8&_nc_oc=AdpK5_WNtqRMj-1gMifDicokCLmHKF5X3tO0R5XnxWeNcrZdKTIFG5HHbZJ-w09rebg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QGkbkDnnbJBj0IE7uAejFA8VmQvLZG0m4jlgCF4Rqfw&oe=6A281B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_43.png", "id": "1758399128261889", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820887_1758399131595222_3242421812600278716_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsE-qO1iuakQ7kNvwFd9h9i&_nc_oc=AdoeMou5bBDUza2SAg2IWjAJtabnseuQSve0dPjt1pX1C7SsVVcAfB9eQVqKJppf3So&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dgz92jOqwFyr8szYtb1DSluZZHCaHm_6Nd4Xl287aJA&oe=6A281AE1"}, "display_name": "Lucid Descent", "keywords": [], "long_description": "Step into your nightmares  and never wake up.\nLucid Descent is a VR horror fan game inspired by Gorilla Tag, where reality fractures and primal fear takes over. You aren\u2019t just running for fun anymore you\u2019re running to survive.\n\nIn this twisted, dreamlike descent, the familiar mechanics of Gorilla Tag are reborn in a surreal, haunting world that shifts with every heartbeat. The walls whisper. The floors breathe. And somewhere in the darkness, something hunts you.\n", "short_description": "Welcome to lucid Descent...this is a vr game inspired by gorilla tag horror! "}]}, "developer_name": "voxelate", "developer_privacy_policy_url": "https://sites.google.com/view/53tk558u48u45984i9/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "voxelate_dev", "support_website_url": null, "website_url": "https://sites.google.com/view/53tk558u48u45984i9/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25483074441300077"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_2030906877713359_8142556246986442723_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOdhz74G6qsQ7kNvwF6IWJt&_nc_oc=AdqREEjbwE6tmXEQscewVs6M1mKsDAwNXO_u5aYCZ3Ixs61Jfk1rn_rg127JDjy_5Tk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z8YGvrUSH48As9pPtGasycwIs9Ru9yfD90fMKe4_E8w&oe=6A2813BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lucid Descent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1761488280, "lastRevision": {"nodes": [{"id": "25350549114552611", "release_type":
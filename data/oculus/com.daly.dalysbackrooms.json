ject_39.png", "id": "1146027176877945", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_1146027180211278_6900323663202133216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbJJQoKi8IcQ7kNvwGhIlme&_nc_oc=AdrM3M5-swT3q9Rm4Grv09tEdUbcxll6TWV7zvibk7S5D4WGWVbGg2MTwo9oSYYeo4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o2aARjWIlt9zNzKUN-Fm7qYT9UvIRUAZHWZfswP5SqQ&oe=69FB523C"}, {"file_name": "backroom.png", "id": "1993297611208559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819859_1993297617875225_7729927286656875447_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFj2_82lBR0Q7kNvwEJCsaT&_nc_oc=Adq12wlGelHAOLP_4rfoXVq3En52Ne0jjfqjKiv4XGQOqrHn61zR-hTPbgmLoEqBtnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78goB8quHNP-agGn0yVSll-diQwj70IBeXW6Id_T7ztg&oe=69FB483F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_43.png", "id": "1758399128261889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820887_1758399131595222_3242421812600278716_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZeDpwd5FqwQ7kNvwFDDqgF&_nc_oc=Ado42Xfx_MDXDmSaS38gfzDW9IrULaFgHDmP-8uKcr7slW2eBor6FvJrex5RsAYGh5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LtQmv06cM8HpDf9JV_vblTFsvSsW3bPmDPhhXVYC3dA&oe=69FB47E1"}, "display_name": "Lucid Descent", "keywords": [], "long_description": "Step into your nightmares  and never wake up.\nLucid Descent is a VR horror fan game inspired by Gorilla Tag, where reality fractures and primal fear takes over. You aren\u2019t just running for fun anymore you\u2019re running to survive.\n\nIn this twisted, dreamlike descent, the familiar mechanics of Gorilla Tag are reborn in a surreal, haunting world that shifts with every heartbeat. The walls whisper. The floors breathe. And somewhere in the darkness, something hunts you.\n", "short_description": "Welcome to lucid Descent...this is a vr game inspired by gorilla tag horror! "}]}, "developer_name": "voxelate", "developer_privacy_policy_url": "https://sites.google.com/view/53tk558u48u45984i9/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "voxelate_dev", "support_website_url": null, "website_url": "https://sites.google.com/view/53tk558u48u45984i9/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25483074441300077"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_2030906877713359_8142556246986442723_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15wJ-XRfeQ0Q7kNvwFUCgJT&_nc_oc=AdpZ9169ZX26FDcsU4nmX9HJ7LC1QxKm0XJI2Saw7whFMbpXy9vGGMW_yQhmaVrtfSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68-RmR4uf5VTaGW-UoDCV4GuUdhNKvE2rdYCyoVgWY8g&oe=69FB40BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lucid Descent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1761488280, "lastRevision": {"nodes": [{"id": "25350549114552611", "release_type":
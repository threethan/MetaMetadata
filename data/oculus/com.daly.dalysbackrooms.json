ject_39.png", "id": "1146027176877945", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_1146027180211278_6900323663202133216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl3OPDz4flUQ7kNvwFczSkj&_nc_oc=Adrt91LizVznErlLUJfKMjGgx0GNNNK-r50gqnwSCQDWJdOM_xJIEMdDpE8g3sBr3Bc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0N7dxLoD7rjXLwbQ9pKCdfRRGacvC0hPmSZy7XG_VACg&oe=69F3693C"}, {"file_name": "backroom.png", "id": "1993297611208559", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819859_1993297617875225_7729927286656875447_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH9542H0xuUQ7kNvwE4hOrf&_nc_oc=AdpyjNyB3rBrVsgSGbT5Yvu-5-cGhWAmmjlewE19hU8a7rAiukScqzFvy2KnW5OKouc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DGYQW0-qRH7m8PAaKVtXtoLKE8Uh_Bf-JUxo7EndpaQ&oe=69F35F3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_43.png", "id": "1758399128261889", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820887_1758399131595222_3242421812600278716_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0gzK4aXRhgQ7kNvwHUbpIh&_nc_oc=AdpiIh-VwSMAgfbyTFdr8gMN_dWXJJmiSMGFTDJ5X3EJTgBizC7lUZzsoEce8n3j5C4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35Vdt5SPODVnxRZ9JwnrYmSKibBZTK_h0MAKTJsmngFw&oe=69F35EE1"}, "display_name": "Lucid Descent", "keywords": [], "long_description": "Step into your nightmares  and never wake up.\nLucid Descent is a VR horror fan game inspired by Gorilla Tag, where reality fractures and primal fear takes over. You aren\u2019t just running for fun anymore you\u2019re running to survive.\n\nIn this twisted, dreamlike descent, the familiar mechanics of Gorilla Tag are reborn in a surreal, haunting world that shifts with every heartbeat. The walls whisper. The floors breathe. And somewhere in the darkness, something hunts you.\n", "short_description": "Welcome to lucid Descent...this is a vr game inspired by gorilla tag horror! "}]}, "developer_name": "voxelate", "developer_privacy_policy_url": "https://sites.google.com/view/53tk558u48u45984i9/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "voxelate_dev", "support_website_url": null, "website_url": "https://sites.google.com/view/53tk558u48u45984i9/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25483074441300077"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823341_2030906877713359_8142556246986442723_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRH2lfBfitUQ7kNvwE499Hh&_nc_oc=AdrPi_QQLpEFYy4d73qWtPVVjdpA2TXfJtTFqM1btVn9ZgQQI7ltbB7uqCckWY00RGU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19Cua3LuvTPhmorz0gExsl07FE535nhd5qDkkv_D1h1g&oe=69F357BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lucid Descent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1761488280, "lastRevision": {"nodes": [{"id": "25350549114552611", "release_type":
ject_39.png", "id": "1146027176877945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1146027180211278_6900323663202133216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiS6WdY7ZKMQ7kNvwFSM9Vv&_nc_oc=Adr4wiqDXjRJBB28IM5m4yQ6CFC41IQXMqW8y2M9LYuuPcj_ivXUxSYWshsItyQg3jc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXsRS7EY5bcCBbBnwUMXK9EuQGHb3BY1_yCaTxrx4UwA&oe=6A4D0F3C"}, {"file_name": "backroom.png", "id": "1993297611208559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_1993297617875225_7729927286656875447_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGoXIQNp4XEQ7kNvwEJKOhj&_nc_oc=AdoNjfYij4l_bNVwBclWmPTbEXL9X46f_eiNwICqG9Xi4n4K4SfbWgIOnC3UPUiM5Y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWLo8Wez4dDIvOm1EQvvGET8w_2JMchX1V-_xW7cnR3g&oe=6A4D053F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_43.png", "id": "1758399128261889", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1758399131595222_3242421812600278716_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUtvX5qxIWgQ7kNvwHv8taq&_nc_oc=AdonHPP41AvENGhlqrRC2zaXUP65cfYdW6wB7oA_k7RmPeDh38FWEGJA2HSt0JE5W_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVfzDzrT69BcwEYcp_rL33QZMyhr8wrjDHBqpODnPGwg&oe=6A4D04E1"}, "display_name": "Lucid Descent", "keywords": [], "long_description": "Step into your nightmares  and never wake up.\nLucid Descent is a VR horror fan game inspired by Gorilla Tag, where reality fractures and primal fear takes over. You aren\u2019t just running for fun anymore you\u2019re running to survive.\n\nIn this twisted, dreamlike descent, the familiar mechanics of Gorilla Tag are reborn in a surreal, haunting world that shifts with every heartbeat. The walls whisper. The floors breathe. And somewhere in the darkness, something hunts you.\n", "short_description": "Welcome to lucid Descent...this is a vr game inspired by gorilla tag
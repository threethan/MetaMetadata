ject_39.png", "id": "1146027176877945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1146027180211278_6900323663202133216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmdRQYJFjTIQ7kNvwGDk7nU&_nc_oc=Adqa6Nnh9ptMHPDl6vr4RnoZVcykPpQg0cs5vT3dAVwAtixOseXuLb-xlCluuxsSUic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnPqVY20InrJKx4Xn9bbN9FTxoqIqPVO8jTewzKHzd8g&oe=6AD236BC"}, {"file_name": "backroom.png", "id": "1993297611208559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_1993297617875225_7729927286656875447_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdlUkyhOItMQ7kNvwGzQ3Af&_nc_oc=AdoZp8uXoo8YBKBXore7rIf8wVDISuYm-qqpdSEwYeQPnv7zg6JuyWi27BdGHNlXbU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpxACOhYQECrU00zGpeHZczqViXzFYwPYneCw30N5nZQ&oe=6AD22CBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_43.png", "id": "1758399128261889", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1758399131595222_3242421812600278716_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnNGlsWV-wsQ7kNvwHbeYMJ&_nc_oc=AdrOAU2Cx1FGZyxI9RDweUUuyPQtZxozjFPnc5cEW9PcTvJa0Irpt-AfcYz4KwT7u74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHAUazdz-8ctByH2T3vVwWL0qdPliIwXc39j9NinGQmw&oe=6AD22C61"}, "display_name": "Lucid Descent", "keywords": [], "long_description": "Step into your nightmares  and never wake up.\nLucid Descent is a VR horror fan game inspired by Gorilla Tag, where reality fractures and primal fear takes over. You aren\u2019t just running for fun anymore you\u2019re running to survive.\n\nIn this twisted, dreamlike descent, the familiar mechanics of Gorilla Tag are reborn in a surreal, haunting world that shifts with every heartbeat. The walls whisper. The floors breathe. And somewhere in the darkness, something hunts you.\n", "short_description": "Welcome to lucid Descent...this is a vr game inspired by gorilla tag
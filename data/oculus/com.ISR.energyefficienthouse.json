t-iad3-2.oculuscdn.com/v/t64.5771-25/646433061_1835844071181236_2446289647303599339_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ikafl1w_TXIQ7kNvwGOY1Fr&_nc_oc=AdpUdF6HvhWtjCQc6xhVLHScC9Ha1B_Blm96RXn7SyqUgnUDMBwLixOzbvJmeIUhzI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVEI0lSmt5HRYw-20gyCdGmAY2I5u2rPK6FEZSnewpnJQ&oe=6B103AE4"}, {"file_name": "2.png", "id": "3026348784395658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303088_3026348787728991_3895764577034274069_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp_I7S5YangQ7kNvwHqHxRX&_nc_oc=AdowAJr9rJnNvRO5NzKxiCJyN7WtXlgLQnPMfaLl-xkfNryaFFQ3-bSmLGNzD2Ku8kk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWCnV-iznSvqKBXhXTOdmLIKnr36n8qDGkPXiqdlXtvDg&oe=6B1045F6"}, {"file_name": "3.png", "id": "2018885278720514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299745_2018885282053847_3530157896109177004_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5c-O9ylWl8Q7kNvwG5-VOI&_nc_oc=AdqBlDz48on3ZtDj5fGbRL7gTljKJUnA6e929YtFIzfM5UiykJIA2bX-39MZAPJTU6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWa2NX4hV9-quwpSFs05xJ664JNuC1ZCOHygnIIEfsNuw&oe=6B104AA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Energy Efficient House", "keywords": ["educational", "training", "education", "energy"], "long_description": "Step into the world of energy efficiency with Energy Efficient House, an interactive Virtual Reality experience designed to make learning about energy systems fun, engaging, and accessible to everyone!\n\nExplore a modern virtual home and discover how different technologies and everyday appliances contribute to energy consumption and efficiency. Walk through the house, learn about smart energy solutions, and interact with educational elements that explain how energy can be used more efficiently.\n\nWhat can you explore?\n\nDiscover energy-efficient technologies: Learn about household appliances, smart thermostats, and other solutions that help reduce energy consumption.\n\nExplore renewable energy: Install solar panels on the roof and discover how solar energy can contribute to a more sustainable home.\n\nLearn through interaction: Explore a realistic 3D environment and discover useful information about different household energy systems.\n\nBuild energy awareness: Understand the importance of energy efficiency, renewable energy, and sustainable choices in everyday life.\n\nDesigned for educational purposes and casual exploration, Energy Efficient House offers an enjoyable way for students, educators, and curious individuals to discover the technologies that can help create a more energy-efficient and sustainable future.", "short_description": "Enjoy a VR experience on a Energy Efficient House, allowing you to learn about energy systems and place solar panels in the roof."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fsvpJGtNov-A3ZM9-PY3432RvXJ0uC9ie5hs4yXqtIA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Instituto de Sistemas e Robotica - University of Coimbra", "support_website_url": null, "website_url": "https://www.isr.uc.pt/main-page", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sk", "pt", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
name": "verse2.png", "id": "931468837973967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572950_931468841307300_2595699674538666790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYMsX_uSK9AQ7kNvwEGANDw&_nc_oc=AdnZr4zG-KD5m7PsADI5XR4cF22F4D7GuCkeo5C-ExpVzbykOxC5IKj5vzNXBb28Zjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftiDQTHBk5RehqVOxbCAz8-5QvAzRXNSBMjXXgQU-YOrw&oe=69A4358B"}, {"file_name": "Verse3.png", "id": "845351930727510", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001722_845351934060843_1219799958268738039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1i8RBqGR80Q7kNvwEEnL07&_nc_oc=AdkJVOOaWAZpm5x8VsdF0BX22YzPrAgpe1Q-_iEYZSaNQ_UbMopzdQvyN1Y94QCkNBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft4nGDq5ULHorSdpWULuSpEfqibY2WfLsHh0OxAXbr33w&oe=69A44EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-CoverLandscape (1).png", "id": "1022119218749085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207235_1022119222082418_5076847675613690101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7LOIL7YSqMQ7kNvwHqOwpf&_nc_oc=AdndfNBhuhXLuX-mqhQ2-SBWN9-099vhARVWBlo6NREAkj9DmzC-WyuXt1eTLUyXjcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsRFFs-MGCchWT7uFjFAhhEIcPycCSq5h6jDsPiX4PzZw&oe=69A41EBE"}, "display_name": "THE VERSE", "keywords": [], "long_description": "THE VERSE is an early-access, fully multiplayer world. We are constantly improving the world and adding new features to enhance your experience.\n\nImmerse yourself in hundreds of locations spread across 250 sq km of open world, where you can jetpack, drive, boat, jetski, hoverbike, and snowmobile with friends or on your own.\n\nDiscover the hidden depths of our unique underworld or unleash your creativity by building your own custom structures. THE VERSE is more than just a game; it's an ever-evolving universe where your imagination is the only limit. We have a lot left to show you and bring to this universe.\n\nChallenge yourself with a variety of quests:\n\nClear the building in record time; Reach level 12 or higher in the wave quest; Complete the hunting quests by tracking down all the animals.\n\nAs an early-access title, THE VERSE continuously evolves, incorporating live updating buildings and virtual land. We are dedicated to expanding and enhancing every aspect of the game to create the ultimate VR experience.\n\nJoin us on this journey to build the future of gaming. Experience a true Ready Player One adventure, only in untethered VR. ", "short_description": "Experience THE VERSE, an early-access, fully multiplayer world where adventure awaits. Jetpack, drive, boat, jetski, hoverbike, and snowmobile across a 250 sq km open world. Explore the unique underworld, build custom structures, and tackle various quests. We're constantly improving and adding new features. Join us in this evolving VR universe."}]}, "developer_name": "Proxima Centauri", "developer_privacy_policy_url": "https://www.theversevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.theversevr.com/termsofservice", "publisher_name": "THE VERSE Gaming Corp.", "support_website_url": null, "website_url": "https://www.theversevr.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8108813295866219"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75394636_922263332103788_5421968193266
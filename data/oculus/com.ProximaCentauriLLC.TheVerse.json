-iad6-1.oculuscdn.com/v/t64.5771-25/39036613_1432534167666537_6576254558792309383_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wP-JD1up16EQ7kNvwF5Za_k&_nc_oc=Adr0VunNLtomKAfVKVAiQGn2jwBc5_Nk98b5sUMlwtx-VZl7DNDrTxS84ESbkKlEelo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUsB2YnxMyyXEPRsb_kA7nTvsczDSzT0-05ndptEeAvg&oe=6B05D4EE"}, {"file_name": "verse2.png", "id": "931468837973967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572950_931468841307300_2595699674538666790_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu4U3Q6uGoYQ7kNvwF6p2AE&_nc_oc=AdrKaUM3UR1PDI9dG4-pyDeDPbha2dFlDaMmAKAwyaGJIpiIVaFRcwc5TD-J7sPqNu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROPHsPicJwoGzu_nbdbCGzdKsQFr9r4iM3mRBATSXI_A&oe=6B05BFCB"}, {"file_name": "Verse3.png", "id": "845351930727510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001722_845351934060843_1219799958268738039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5rg5J9cA7sQ7kNvwFC4fk-&_nc_oc=AdoWLxD5FlZ8fGsX2zeSOT11RHhLAToUO12MO7KFQUYObecBQ5tVu5L4UkHBeZgMXZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDGhcFx0-t-ocDgCGtNAHx87znhvTCTKQVJEE4dpMCbw&oe=6B05D8E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-CoverLandscape (1).png", "id": "1022119218749085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207235_1022119222082418_5076847675613690101_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTxlYC8G-cUQ7kNvwFR4ibv&_nc_oc=Ado2ZWHBdshmB5md4ngfymhSAf8zLyCWW4WwEwc4nDh9IFa0WYk8Nniv5UF6P9K9YqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy73j3sza1pCWpc8CdPliUe911aOvadc87XuNRcAspYg&oe=6B05A8FE"}, "display_name": "THE VERSE", "keywords": [], "long_description": "THE VERSE is an early-access, fully multiplayer world. We are constantly improving the world and adding new features to enhance your experience.\n\nImmerse yourself in hundreds of locations spread across 250 sq km of open world, where you can jetpack, drive, boat, jetski, hoverbike, and snowmobile with friends or on your own.\n\nDiscover the hidden depths of our unique underworld or unleash your creativity by building your own custom structures. THE VERSE is more than just a game; it's an ever-evolving universe where your imagination is the only limit. We have a lot left to show you and bring to this universe.\n\nChallenge yourself with a variety of quests:\n\nClear the building in record time; Reach level 12 or higher in the wave quest; Complete the hunting quests by tracking down all the animals.\n\nAs an early-access title, THE VERSE continuously evolves, incorporating live updating buildings and virtual land. We are dedicated to expanding and enhancing every aspect of the game to create the ultimate VR experience.\n\nJoin us on this journey to build the future of gaming. Experience a true Ready Player One adventure, only in untethered VR. ", "short_description": "Experience THE VERSE, an early-access, fully multiplayer world where adventure awaits. Jetpack, drive, boat, jetski, hoverbike, and snowmobile across a 250 sq km open world. Explore the unique underworld, build custom structures, and tackle various quests. We're constantly improving and adding new features. Join us in this evolving VR universe."}]}, "developer_name": "Proxima Centauri", "developer_privacy_policy_url": "https://www.theversevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.theversevr.com/termsofservice", "publisher_name": "THE VERSE Gaming Corp.", "support_website_url": null, "website_url": "https://www.theversevr.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_
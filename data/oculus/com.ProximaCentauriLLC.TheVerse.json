-iad6-1.oculuscdn.com/v/t64.5771-25/39036613_1432534167666537_6576254558792309383_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fHoTLKkcK4Q7kNvwGSoDvX&_nc_oc=Adpm3eE5toIO-n9jjRJrfBi7slk28gTZvaZRiw8NZRqgANsxy1EWrk0IaZ5cIfPFeAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWteZ2O6qjEYE2iy-7nIoJgUBt1ueYZkMi8L8Uj6IKhPQ&oe=6B0F0F6E"}, {"file_name": "verse2.png", "id": "931468837973967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572950_931468841307300_2595699674538666790_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1iXKatI_BYQ7kNvwEUpAf3&_nc_oc=Adp3Sry9cF3VwONWFLj7Wa0QkRM0tzY7ntiPPDVkUhSXnMmRBD-zRKgQREtACZzsGKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9h5tEuL6WViHfDQ7VakUB1LIFUqQzQEUzYCKzQi8_Ow&oe=6B0EFA4B"}, {"file_name": "Verse3.png", "id": "845351930727510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001722_845351934060843_1219799958268738039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3TQwpmTpZAQ7kNvwH25wBI&_nc_oc=Ado83J8ySpeDOStoq4O7bYFRn1Vof6_J_VKR0GyLETaEF58QtmntWoarBhgmZ6koguw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUeFYEiQ8W_bUkhRdoUiSk88GcxH2OKmmAFUxyiSRjGbA&oe=6B0F1368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-CoverLandscape (1).png", "id": "1022119218749085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207235_1022119222082418_5076847675613690101_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3KrI2bf1b0Q7kNvwGgP9BC&_nc_oc=AdoUXv_5tfjTsl9gtVn_JyMRoyJ9js9qSkZktE66lAOVz0dArBxMPNVdqjhPEgZOBhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4zMqDGl8cVFj8RvWXfwQ4npk_URR3Da0d3ajU0MjKJA&oe=6B0F1BBE"}, "display_name": "THE VERSE", "keywords": [], "long_description": "THE VERSE is an early-access, fully multiplayer world. We are constantly improving the world and adding new features to enhance your experience.\n\nImmerse yourself in hundreds of locations spread across 250 sq km of open world, where you can jetpack, drive, boat, jetski, hoverbike, and snowmobile with friends or on your own.\n\nDiscover the hidden depths of our unique underworld or unleash your creativity by building your own custom structures. THE VERSE is more than just a game; it's an ever-evolving universe where your imagination is the only limit. We have a lot left to show you and bring to this universe.\n\nChallenge yourself with a variety of quests:\n\nClear the building in record time; Reach level 12 or higher in the wave quest; Complete the hunting quests by tracking down all the animals.\n\nAs an early-access title, THE VERSE continuously evolves, incorporating live updating buildings and virtual land. We are dedicated to expanding and enhancing every aspect of the game to create the ultimate VR experience.\n\nJoin us on this journey to build the future of gaming. Experience a true Ready Player One adventure, only in untethered VR. ", "short_description": "Experience THE VERSE, an early-access, fully multiplayer world where adventure awaits. Jetpack, drive, boat, jetski, hoverbike, and snowmobile across a 250 sq km open world. Explore the unique underworld, build custom structures, and tackle various quests. We're constantly improving and adding new features. Join us in this evolving VR universe."}]}, "developer_name": "Proxima Centauri", "developer_privacy_policy_url": "https://www.theversevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.theversevr.com/termsofservice", "publisher_name": "THE VERSE Gaming Corp.", "support_website_url": null, "website_url": "https://www.theversevr.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_
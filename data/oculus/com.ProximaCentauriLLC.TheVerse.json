-ord5-2.oculuscdn.com/v/t64.5771-25/39036613_1432534167666537_6576254558792309383_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEDdsPeoEoUQ7kNvwFTtgoD&_nc_oc=AdrGDAi_z1Sb8pGNchsypgR6fHYmslSIDuTVls7FNUI3Fw7ADN8GyO6GHmHA8pEanSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-xOV22Pj6Y71ZUUjgUIKxreeVZiG3CJNqmmI0AW0dDg&oe=6AFDB3AE"}, {"file_name": "verse2.png", "id": "931468837973967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572950_931468841307300_2595699674538666790_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIyZGdECWXAQ7kNvwEX8jsA&_nc_oc=AdpI3vDtDX6rNu2hyz-xsqj1Fo0zxZUBbVNnYOFvJY05YN7LOm7QJTuo9STItLwxK8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRri5LZ69MDFBldDdmGUgDRZaTK_JdXsjMpmj0y5V3hQ&oe=6AFDD6CB"}, {"file_name": "Verse3.png", "id": "845351930727510", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001722_845351934060843_1219799958268738039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKdLf1PlRjoQ7kNvwEffMUI&_nc_oc=AdpKkrMPpIsYKmu_HKfjGCESbhw-suhMWh5VFV1S26QRt8VMgVmPdwOujZQNLSbTNvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtIQAMr6fxU3qG-dorCIv0u04rMruiTSmmj31MmjyM5Q&oe=6AFDB7A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-CoverLandscape (1).png", "id": "1022119218749085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207235_1022119222082418_5076847675613690101_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJll6pdmRn4Q7kNvwFK9LL8&_nc_oc=AdqIEeDRnXqeyYKNxHkUfwVeEm6Vfl9_htbRRU2g2GAglHEJWXVQD9X1nP2Euh0WvGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGxSY__EynJ8-FtC7AsiBKRgPxoVZWEmFnLu1Niv4fDQ&oe=6AFDBFFE"}, "display_name": "THE VERSE", "keywords": [], "long_description": "THE VERSE is an early-access, fully multiplayer world. We are constantly improving the world and adding new features to enhance your experience.\n\nImmerse yourself in hundreds of locations spread across 250 sq km of open world, where you can jetpack, drive, boat, jetski, hoverbike, and snowmobile with friends or on your own.\n\nDiscover the hidden depths of our unique underworld or unleash your creativity by building your own custom structures. THE VERSE is more than just a game; it's an ever-evolving universe where your imagination is the only limit. We have a lot left to show you and bring to this universe.\n\nChallenge yourself with a variety of quests:\n\nClear the building in record time; Reach level 12 or higher in the wave quest; Complete the hunting quests by tracking down all the animals.\n\nAs an early-access title, THE VERSE continuously evolves, incorporating live updating buildings and virtual land. We are dedicated to expanding and enhancing every aspect of the game to create the ultimate VR experience.\n\nJoin us on this journey to build the future of gaming. Experience a true Ready Player One adventure, only in untethered VR. ", "short_description": "Experience THE VERSE, an early-access, fully multiplayer world where adventure awaits. Jetpack, drive, boat, jetski, hoverbike, and snowmobile across a 250 sq km open world. Explore the unique underworld, build custom structures, and tackle various quests. We're constantly improving and adding new features. Join us in this evolving VR universe."}]}, "developer_name": "Proxima Centauri", "developer_privacy_policy_url": "https://www.theversevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.theversevr.com/termsofservice", "publisher_name": "THE VERSE Gaming Corp.", "support_website_url": null, "website_url": "https://www.theversevr.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_
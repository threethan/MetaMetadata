-iad6-1.oculuscdn.com/v/t64.5771-25/39036613_1432534167666537_6576254558792309383_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fHoTLKkcK4Q7kNvwFHqbCf&_nc_oc=Adobq9A5hhTzcVDeP8CikQX_ZB6_iwh_r7PSXBoQwHQ1iJAt4_TjyvT9HfH59jcD76Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUR6WMYPLDO2y2kbaTl8VvMFoDVNMWGuitjceU9ntmrjg&oe=6B1060EE"}, {"file_name": "verse2.png", "id": "931468837973967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572950_931468841307300_2595699674538666790_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjuGTItijeUQ7kNvwGaRuve&_nc_oc=AdrZMbGvjzC18aVe4r-tROFSz9zrldz0lL0sKkHyzRrJ7zSx9KC-rT7qYT1vgrAeSgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4gYKFFMtI39kPbuVy4fx1G2cr7yaknE9WgEvozz478w&oe=6B104BCB"}, {"file_name": "Verse3.png", "id": "845351930727510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001722_845351934060843_1219799958268738039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3TQwpmTpZAQ7kNvwH8m_1U&_nc_oc=Adqie4d_i_BKVPiFgLwf9d8cnQiwJXUXFGIv2RB_4VYEy9M80W0sp93TIXsWz0V9NtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHrXSJUsVgCIHXjHlSG6TOK3A3vAj6hPrnJkhMDEAh6A&oe=6B1064E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-CoverLandscape (1).png", "id": "1022119218749085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207235_1022119222082418_5076847675613690101_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3KrI2bf1b0Q7kNvwFBKMIF&_nc_oc=AdqRwKxxhRV6tSKtb0WDeXKJQNFqlbPLNoV76ZfoPurHaD8v0FiJq8pWp32Fs6SAeSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPF48Y-xqh3NQ5iAKj7Jua-OMZmO-9kVKwl2curBlYcA&oe=6B1034FE"}, "display_name": "THE VERSE", "keywords": [], "long_description": "THE VERSE is an early-access, fully multiplayer world. We are constantly improving the world and adding new features to enhance your experience.\n\nImmerse yourself in hundreds of locations spread across 250 sq km of open world, where you can jetpack, drive, boat, jetski, hoverbike, and snowmobile with friends or on your own.\n\nDiscover the hidden depths of our unique underworld or unleash your creativity by building your own custom structures. THE VERSE is more than just a game; it's an ever-evolving universe where your imagination is the only limit. We have a lot left to show you and bring to this universe.\n\nChallenge yourself with a variety of quests:\n\nClear the building in record time; Reach level 12 or higher in the wave quest; Complete the hunting quests by tracking down all the animals.\n\nAs an early-access title, THE VERSE continuously evolves, incorporating live updating buildings and virtual land. We are dedicated to expanding and enhancing every aspect of the game to create the ultimate VR experience.\n\nJoin us on this journey to build the future of gaming. Experience a true Ready Player One adventure, only in untethered VR. ", "short_description": "Experience THE VERSE, an early-access, fully multiplayer world where adventure awaits. Jetpack, drive, boat, jetski, hoverbike, and snowmobile across a 250 sq km open world. Explore the unique underworld, build custom structures, and tackle various quests. We're constantly improving and adding new features. Join us in this evolving VR universe."}]}, "developer_name": "Proxima Centauri", "developer_privacy_policy_url": "https://www.theversevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.theversevr.com/termsofservice", "publisher_name": "THE VERSE Gaming Corp.", "support_website_url": null, "website_url": "https://www.theversevr.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_
name": "verse2.png", "id": "931468837973967", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572950_931468841307300_2595699674538666790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zreCDfeR3QQ7kNvwFworO0&_nc_oc=AdoHzFxtgwgP6xbch1p7Ue-wYblWG-WiEkNJlOO0ocs3YHL6n_FTu50Zaz8NCJK9RGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af335HgjG7-fG_AZTkhfYAHr7LmawP5SAYHJHySMV1Rqqw&oe=69F0AC8B"}, {"file_name": "Verse3.png", "id": "845351930727510", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001722_845351934060843_1219799958268738039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sorGS5ByBUEQ7kNvwF3u_aI&_nc_oc=Adq23LcvGW4gJJyMf2H6-dhNSgYf-3QJoJrwxAwNH7uCFFQVOPwZqoDqMA416PLwC6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2s1Tgy-AKkYNwc_tntb-sL_nfBjR41IQ6OuQBjAhfRMA&oe=69F0C5A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-CoverLandscape (1).png", "id": "1022119218749085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207235_1022119222082418_5076847675613690101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E38AINT7IWgQ7kNvwFPBCwS&_nc_oc=AdpUaO2esf01bGIIsydyV2YTGEijIOAq99PJIuNHs2w9_2HFp4hA7Z4INNrpnQS_hYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0WPB9zddQgUWhgUpOsV5XFdap9XoyHoBR8CxBPmrjhGg&oe=69F0CDFE"}, "display_name": "THE VERSE", "keywords": [], "long_description": "THE VERSE is an early-access, fully multiplayer world. We are constantly improving the world and adding new features to enhance your experience.\n\nImmerse yourself in hundreds of locations spread across 250 sq km of open world, where you can jetpack, drive, boat, jetski, hoverbike, and snowmobile with friends or on your own.\n\nDiscover the hidden depths of our unique underworld or unleash your creativity by building your own custom structures. THE VERSE is more than just a game; it's an ever-evolving universe where your imagination is the only limit. We have a lot left to show you and bring to this universe.\n\nChallenge yourself with a variety of quests:\n\nClear the building in record time; Reach level 12 or higher in the wave quest; Complete the hunting quests by tracking down all the animals.\n\nAs an early-access title, THE VERSE continuously evolves, incorporating live updating buildings and virtual land. We are dedicated to expanding and enhancing every aspect of the game to create the ultimate VR experience.\n\nJoin us on this journey to build the future of gaming. Experience a true Ready Player One adventure, only in untethered VR. ", "short_description": "Experience THE VERSE, an early-access, fully multiplayer world where adventure awaits. Jetpack, drive, boat, jetski, hoverbike, and snowmobile across a 250 sq km open world. Explore the unique underworld, build custom structures, and tackle various quests. We're constantly improving and adding new features. Join us in this evolving VR universe."}]}, "developer_name": "Proxima Centauri", "developer_privacy_policy_url": "https://www.theversevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.theversevr.com/termsofservice", "publisher_name": "THE VERSE Gaming Corp.", "support_website_url": null, "website_url": "https://www.theversevr.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8108813295866219"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75394636_922263332103788_5421968193266
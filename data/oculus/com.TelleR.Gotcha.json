Y5fEeNj0a8E4Ml_kMCXGIPsC2kej9qirewSBXTGsddmq7pLKZt6B9J_NKUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvB4ITdgcq6KlfTd8DzQH7fBJylThxrU6a9LciC_OtsA&oe=6B0DCC9D"}, {"file_name": "NoText_Gotcha!_Stage2.png", "id": "882521201261948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620432_882521204595281_8716605361420789263_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urghZ3xAWJAQ7kNvwGyx5nv&_nc_oc=AdoJrfFNMkqFgjpKI3rDRRfHDdKdLaG6EnxiBHk1SKg02x08D1MmkcYZ6NK5Brk5hWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmMWDG_KbbokzcplrCcQggZSfNOirP2hSigtTSQx6BTw&oe=6B0DC0A0"}, {"file_name": "NoTexT_Gotcha!_Stage3.png", "id": "833829669695550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822467_833829673028883_895923766869528946_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjqh1Q33OS8Q7kNvwEdt7Lu&_nc_oc=AdrAWINMPlj9szgg_Wa7WX9Oq0PSwFgmaddQUVY_3Wz0UyxPzSfyRK_Y6vHGYfBH63U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqPtVGwf7fzWaOriVHxL7IuG854RBe0AiR6N_5EAx2yA&oe=6B0DAE78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gotcha!_Cover_1_2560x1440.png", "id": "1509354853497931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619145_1509354856831264_5218143801089235423_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55UiGnoYA0gQ7kNvwHUtwgW&_nc_oc=AdqJOxscnKW76Pjyf9Wo8Qj_98W0Pdk8rFLsw2M8oIavqDSHH80NbtsLYVrEl_HypMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrgKfSCxN8_wwOjjcaMMiVo5srKi8SN8aNpMc6TAxnVw&oe=6B0DB777"}, "display_name": "Gotcha!", "keywords": ["Drone", "Flying", "Hunting", "Simulator"], "long_description": "# \ud83c\udf89 Play Now & Get a Free Bird Item! \ud83d\udc26\n\nPlay now and get the Bird for free in the 'Shop'\u2014available for a limited time!\n\nJoin our 'Discord' community and tell us:\n-  https://discord.gg/pUAeqHbh\n\nWhich drone model you\u2019d like\n\nWhat kind of map atmosphere you want\n\nWe\u2019ll randomly select players and actually create them in-game!\n{911652791278323}\n# \ud83d\udcb0 Best Price Right Now\n\nThis is the lowest price the game will ever be.\nEach time 2 new maps are added, \nthe price will increase by $1, up to a maximum of $5!!!!!\n\nGrab it early, play freely, and grow with the game!\n\n# \ud83d\ude80 Have a Mode in Mind?\nLet us know!\nWe\u2019re currently planning to add a Racing Mode next.\n\nHave fun, and\u2026 Gotcha~! \ud83d\ude0e\n\n# \ud83d\udd79\ufe0f\ud83d\ude81Practice flying your drone\nLearn the drone controls anytime, at your own pace.\n\n{902355445668302}\n\n# \ud83d\udd13Unlock and choose the drone you want\nUnlock new drones in the shop and play with a variety of drones.\n{1223227503099614}\n\n# \ud83c\udfaf\ud83d\ude93Find and capture the suspect\nSearch for the suspect who matches the figure\u2019s appearance and pose.\nYou\u2019ll need to carefully distinguish between many characters across a large map.\n{2808200742852497}", "short_description": "The police are counting on your drone skills to find suspects scattered across the multiverse.\n\nBecome a drone pilot and explore a variety of environments,\nusing visual clues to locate targets that match the suspect descriptions.\n\nUnlock drones in the shop, travel between worlds,\nand help the police solve the case."}]}, "developer_name": "BBangBBang", "developer_privacy_policy_url": "https://teller.website/privacy/gotcha", "developer_terms_of_service_url": null, "publisher_name": "TelleR", "support_website_url": null, "website_url": "https://teller.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25664583589899644"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4387551798179637"}, {"status": "PUBLISHED", "id": "907382432146255"}, {"status": "PUBLISHED", "id": "2180938862314816"}]}, "baseline_offer": {"id": "4387551798179637"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784685000, "status": "PUBLISHED", "id": "4387551798179637"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29082014628156506", "version": "1.3.3"}, "id": "1519528415920289", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25097303353294340", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29082014628156506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1519528415920289"}]}, "change_log": "Version 1.3.3\n\nNew\n- New Stage 4: Sci-Fi City. Fly through a futuristic downtown and deliver targets hidden on sidewalks, rooftops and back alleys. Find it as the 4th stage in Stage Select.\n- Controller haptics and new effects for pickups and deliveries.\n- The loading screen now shows a progress bar and play tips.\n\nImprovements\n- Re-baked lighting in every stage and the tutorial for more natural shading.\n- Performance optimizations across all stages, especially Stage 4.\n\nFixes\n- The game now pauses, sound included, when you open the Meta menu.\n- Purchased drones no longer disappear when playing offline.\n- Fixed cases where clear records or leaderboard times could be lost, such as running out of energy during a delivery. Failed leaderboard submissions are now retried.\n- Fixed several tutorial issues, including the intro fade and remote control staying on after switching drones.\n- Improved app launch stability.\n\n\ubc84\uc804 1.3.3\n\n\uc0c8\ub85c\uc6b4 \uac83\n- \uc0c8 \uc2a4\ud14c\uc774\uc9c0 4: SF \ub3c4\uc2dc. \ubbf8\ub798 \ub3c4\uc2dc\ub97c \ub0a0\uba70 \ubcf4\ub3c4, \uc625\uc0c1, \uace8\ubaa9\uc5d0 \uc228\uc740 \ud0c0\uae43\uc744 \ubc30\ub2ec\ud558\uc138\uc694. \uc2a4\ud14c\uc774\uc9c0 \uc120\ud0dd 4\ubc88\uc9f8 \uc790\ub9ac\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.\n- \ud53d\uc5c5\uacfc \ubc30\ub2ec\ud560 \ub54c \ucee8\ud2b8\ub864\ub7ec \uc9c4\ub3d9\uacfc \ud6a8\uacfc\uac00 \uc0c8\ub85c \ub098\uc635\ub2c8\ub2e4.\n- \ub85c\ub529 \ud654\uba74\uc5d0 \uc9c4\ud589 \ubc14\uc640 \ud50c\ub808\uc774 \ud301\uc774 \ub098\uc635\ub2c8\ub2e4.\n\n\uac1c\uc120\n- \ubaa8\ub4e0 \uc2a4\ud14c\uc774\uc9c0\uc640 \ud29c\ud1a0\ub9ac\uc5bc\uc758 \uc870\uba85\uc744 \ub2e4\uc2dc \uad6c\uc6cc \uba85\uc554\uc774 \ub354 \uc790\uc5f0\uc2a4\ub7ec\uc6cc\uc84c\uc2b5\ub2c8\ub2e4.\n- \ubaa8\ub4e0 \uc2a4\ud14c\uc774\uc9c0, \ud2b9\ud788 \uc2a4\ud14c\uc774\uc9c0 4\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud588\uc2b5\ub2c8\ub2e4.\n\n\uc218\uc815\n- Meta \uba54\ub274\ub97c \uc5f4\uba74 \uac8c\uc784\uacfc \uc18c\ub9ac\uac00 \uba48\ucda5\ub2c8\ub2e4.\n- \uc624\ud504\ub77c\uc778\uc5d0\uc11c \uad6c\ub9e4\ud55c \ub4dc\ub860\uc774 \uc0ac\ub77c\uc9c0\ub358 \ubb38\uc81c\ub97c \uace0\ucce4\uc2b5\ub2c8\ub2e4.\n- \ubc30\ub2ec \uc911 \uc5d0\ub108\uc9c0\uac00 \ub5a8\uc5b4\uc9c0\ub294 \uacbd\uc6b0\ucc98\ub7fc \ud074\ub9ac\uc5b4 \uae30\ub85d\uc774\ub098 \ub9ac\ub354\ubcf4\ub4dc \uc2dc\uac04\uc774 \ube60\uc9c0\ub358 \ubb38\uc81c\ub97c \uace0\ucce4\uc2b5\ub2c8\ub2e4. \ub9ac\ub354\ubcf4\ub4dc \uc804\uc1a1\uc5d0 \uc2e4\ud328\ud558\uba74 \ub2e4\uc2dc \ubcf4\ub0c5\ub2c8\ub2e4.\n- \
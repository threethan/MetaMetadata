ng?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7ogdmRfXtAQ7kNvwFDySAM&_nc_oc=AdplvrJE5Vd1jF0e94oWDnI3uLEVGti1rqzuJpUVurxbbj-VJnQXUcsSe-_9ec96H6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYj38_RYgF7gJNCbC8vfWQOfroTAu_A9SIFqSD-wHlUA&oe=69CA5C9D"}, {"file_name": "NoText_Gotcha!_Stage2.png", "id": "882521201261948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620432_882521204595281_8716605361420789263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt0ZLbNuMLwQ7kNvwFnJNFs&_nc_oc=AdpScP0m7dtsHKiEHXH0EHhGHN4ZCl0OmT3twEWmQo3xqbTMCjdNmB6GXtotqRK3a4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpjiQLBL2MP3l6SeKixOkVgu09deuO_4VxPxKNBEqQoQ&oe=69CA88E0"}, {"file_name": "NoTexT_Gotcha!_Stage3.png", "id": "833829669695550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822467_833829673028883_895923766869528946_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RdEvuzp9W0Q7kNvwGSKggC&_nc_oc=AdrVYXXhJ2i0s-5M4kerTipPO0nijZ3g4krWSXJgZf03Wy9DrSGAIp9WCfUmaWjrL0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyY9Gylfdkn17IrR3SAt36KjnsC7XbUx8ROlkCcSED7qw&oe=69CA76B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gotcha!_Cover_1_2560x1440.png", "id": "1509354853497931", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619145_1509354856831264_5218143801089235423_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH0R1uiMKegQ7kNvwHwXTH-&_nc_oc=AdrRQzoGrgE2D0GIPBMrvIEhwcDhZW7qKjjvUwoH5IxXnGRSIcFMKmz3QSr0dDRX5e8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypvCy1tEAMqbXxaHzB9ykPR0ti16tifZLQKPtn1y0xyA&oe=69CA7FB7"}, "display_name": "Gotcha!", "keywords": ["Drone", "Flying", "Hunting", "Simulator"], "long_description": "# \ud83c\udf89 Play Now & Get a Free Bird Item! \ud83d\udc26\n\nPlay now and get the Bird for free in the 'Shop'\u2014available for a limited time!\n\nJoin our 'Discord' community and tell us:\n-  https://discord.gg/pUAeqHbh\n\nWhich drone model you\u2019d like\n\nWhat kind of map atmosphere you want\n\nWe\u2019ll randomly select players and actually create them in-game!\n{911652791278323}\n# \ud83d\udcb0 Best Price Right Now\n\nThis is the lowest price the game will ever be.\nEach time 2 new maps are added, \nthe price will increase by $1, up to a maximum of $5!!!!!\n\nGrab it early, play freely, and grow with the game!\n\n# \ud83d\ude80 Have a Mode in Mind?\nLet us know!\nWe\u2019re currently planning to add a Racing Mode next.\n\nHave fun, and\u2026 Gotcha~! \ud83d\ude0e\n\n# \ud83d\udd79\ufe0f\ud83d\ude81Practice flying your drone\nLearn the drone controls anytime, at your own pace.\n\n{902355445668302}\n\n# \ud83d\udd13Unlock and choose the drone you want\nUnlock new drones in the shop and play with a variety of drones.\n{1223227503099614}\n\n# \ud83c\udfaf\ud83d\ude93Find and capture the suspect\nSearch for the suspect who matches the figure\u2019s appearance and pose.\nYou\u2019ll need to carefully distinguish between many characters across a large map.\n{2808200742852497}", "short_description": "The police are counting on your drone skills to find suspects scattered across the multiverse.\n\nBecome a drone pilot and explore a variety of environments,\nusing visual clues to locate targets that match the suspect descriptions.\n\nUnlock drones in the shop, travel between worlds,\nand help the police solve the case."}]}, "developer_name": "BBangBBang", "developer_privacy_policy_url": "https://teller.website/privacy/gotcha", "developer_terms_of_service_url": null, "publisher_name": "TelleR", "support_website_url": null, "website_url": "https://teller.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection"
set-01-build-2560x1440.png", "id": "2446460289517309", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842246_2446460292850642_1090014927150697345_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY9RM2iLGFQQ7kNvwEeGKfe&_nc_oc=AdoqKQc4S5vyivG9FG9qAj6uM0dXEiLiLjac_qPpyMNDn7LI5e1apAWkoaZTWpUCLeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1bajDfdMB9EqYPBG-uckUiYYNWgJ5gF9psslPI6YQBw&oe=6B0EF695"}, {"file_name": "headset-05-notebook-hologram-2560x1440.png", "id": "2654353478367260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842276_2654353481700593_7786990849852296520_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCA4G6d7kYEQ7kNvwGkykdq&_nc_oc=Adpw7SqrPVMWi6Ydg3LyCD0yRgcCZNVWocG9TddE-ttfPybEfErdSxKw7eztdqaReVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVEYpMDil2GEvHpTylGxCI-Xai1NxEvR5YOhFrMd4U9Ag&oe=6B0F20BE"}, {"file_name": "headset-03-engine-2560x1440.png", "id": "3436177136585137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842244_3436177139918470_5955369852899408798_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-trlRtEqbx4Q7kNvwG1xaez&_nc_oc=AdpqftrDumlv8jdFDQQeynGLLst7XrCw2SgR0QGDJIyM0luqDJIQMfnwF-DsN5WW6zo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJ09tQDpQ_SX2NMwCRaKgKDZNqB51SGzs1nqPBtQ15Lg&oe=6B0EFFB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3515606051944120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842284_3515606055277453_2975290498110173378_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msIpgbLUmdAQ7kNvwETIQRb&_nc_oc=AdpLx1doSGuHIdeHWXLSXVjLasuBivn6GZ69Zm1DZiqbgKIo1Im0Fq1pqmmphiVx_7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWC9zM_T758i_FuCOaFKw7Tb5ppy5ctZRtyr6UOzI1MDQ&oe=6B0EF145"}, "display_name": "HoloBench", "keywords": ["Holo", "Bench", "Assemble", "Diary", "Hands"], "long_description": "HoloBench brings a holographic workbench into your room. Use hand tracking or Touch controllers on Quest 3 and 3S. Work at your own desk in passthrough, or step into a virtual beach house or lounge.\n\n- BUILD: Assemble simplified machines piece by piece, from a robot arm to a space station. Follow guided steps, then pull the model apart, replay the build, or run an illustrative animation.\n- SHAPE: Pinch, twist and stretch eight interactive forms, including a fractal tree, a shell and a miniature planet.\n- ENGINE: Adjust valves, nozzle geometry and altitude on a simplified rocket engine model. Watch thrust and pressure change as you work through five challenges.\n- NOTEBOOK: Dictate dated notes in English and watch a pen write them onto the page. Speech recognition runs on the headset, and notes stay there.\n- PANELS: Try 35 animated holographic interfaces powered by demo data.\n", "short_description": "A holographic workbench: assemble machines, sculpt forms, run an engine, keep a spoken dictation diary and interact with it keeping log of activity done in HoloBench.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/holobench/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/holobench/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/holobench/support", "website_url": "https://nebulytic.com/apps/holobench/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
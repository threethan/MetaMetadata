set-01-build-2560x1440.png", "id": "2446460289517309", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/908842246_2446460292850642_1090014927150697345_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8h8wuTdYpwQ7kNvwHN7h0V&_nc_oc=AdpqRYOuevGwYPj6J9GU_6u9KsyvnotLc4sK2asL2OeN8GA-yx7fgG6zx-5-2xDmMhk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQqHZGvznqgzUScNhMyFbwATCMerCqvJpzrbRwh67AlA&oe=6B085F15"}, {"file_name": "headset-05-notebook-hologram-2560x1440.png", "id": "2654353478367260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/908842276_2654353481700593_7786990849852296520_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY7d8RQN20wQ7kNvwEQp6CA&_nc_oc=AdqZYyR8MHT3q0XfwTGwNZbke0VMisX4sAqVdom4-shIQxbhaPzEC9UFvnNloitqQQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5NwcCBT5LsV7owz4wUzkw41KL6Fcb4OT6YTOpxUkCfQ&oe=6B0850FE"}, {"file_name": "headset-03-engine-2560x1440.png", "id": "3436177136585137", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/908842244_3436177139918470_5955369852899408798_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yngr7H513zgQ7kNvwG60p0g&_nc_oc=AdqaKLWsSTeEaXTDTmXtKTYLoDBKtl3mSSp7LTrn-gR7CGqU6vCRe8x3jgXOQhNvlc8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP6IifEXp-gTbj2myWjJfLPqf795gD68o9IoyGC2qjXQ&oe=6B086839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3515606051944120", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/908842284_3515606055277453_2975290498110173378_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7Qf4Ry3BxQQ7kNvwG4Sr-x&_nc_oc=Adpum_7IrUll6SnYCf1vDikQld6xYUBYmhT455cRNRprM8WEsMbUDnA5_9Yc5ecH4fQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9CPx_HrbKFOKV9CeSVmlk4H2LkezVUNqjzcr5DxFVIA&oe=6B0859C5"}, "display_name": "HoloBench", "keywords": ["Holo", "Bench", "Assemble", "Diary", "Hands"], "long_description": "HoloBench brings a holographic workbench into your room. Use hand tracking or Touch controllers on Quest 3 and 3S. Work at your own desk in passthrough, or step into a virtual beach house or lounge.\n\n- BUILD: Assemble simplified machines piece by piece, from a robot arm to a space station. Follow guided steps, then pull the model apart, replay the build, or run an illustrative animation.\n- SHAPE: Pinch, twist and stretch eight interactive forms, including a fractal tree, a shell and a miniature planet.\n- ENGINE: Adjust valves, nozzle geometry and altitude on a simplified rocket engine model. Watch thrust and pressure change as you work through five challenges.\n- NOTEBOOK: Dictate dated notes in English and watch a pen write them onto the page. Speech recognition runs on the headset, and notes stay there.\n- PANELS: Try 35 animated holographic interfaces powered by demo data.\n", "short_description": "A holographic workbench: assemble machines, sculpt forms, run an engine, keep a spoken dictation diary and interact with it keeping log of activity done in HoloBench.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/holobench/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/holobench/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/holobench/support", "website_url": "https://nebulytic.com/apps/holobench/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
set-01-build-2560x1440.png", "id": "2446460289517309", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842246_2446460292850642_1090014927150697345_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY9RM2iLGFQQ7kNvwFfqiQK&_nc_oc=AdrkjQlkEXto-JXZ52bUqztxyqkUqaE0gUCsplBM02ogdLbBQFg8VJt84vUaUQJKdoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUac6e5oXFJOyufj4dwk-L8VCg5g6L38hItLjsjW_HYaw&oe=6B104815"}, {"file_name": "headset-05-notebook-hologram-2560x1440.png", "id": "2654353478367260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842276_2654353481700593_7786990849852296520_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCA4G6d7kYEQ7kNvwHsh9QE&_nc_oc=AdoSMQPMVDGisar57oNyBml7QvBht1vj_0DhCgAQRqTtRiWyv_MR1AMuO5qRDd-EOLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPOd_NRPAbVCA7QtqsnMvnFEyi8ZgjrZmoTvXDAZtSRQ&oe=6B1039FE"}, {"file_name": "headset-03-engine-2560x1440.png", "id": "3436177136585137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842244_3436177139918470_5955369852899408798_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-trlRtEqbx4Q7kNvwG6IMxA&_nc_oc=Adq-dtDhXukVZwtlxK3YCBnCq8C1lijmSfz4IZlfhJ3kRJEqH5d9s7pfXv22elToMF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU5JGFiKqfK3KC0_3LZWPc5wxqsReZyAOM1Hx45j4dBpg&oe=6B105139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3515606051944120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842284_3515606055277453_2975290498110173378_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msIpgbLUmdAQ7kNvwE703lE&_nc_oc=AdoEBlTc3cogVCZE-CwH8abdU_oSaepIulNimtXY2whPASwUYexTSLHExufv9jaoiDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgtU8RIQO1aiGCP0rtt1eJKgPiT5iW5jxsxuazsR02fw&oe=6B1042C5"}, "display_name": "HoloBench", "keywords": ["Holo", "Bench", "Assemble", "Diary", "Hands"], "long_description": "HoloBench brings a holographic workbench into your room. Use hand tracking or Touch controllers on Quest 3 and 3S. Work at your own desk in passthrough, or step into a virtual beach house or lounge.\n\n- BUILD: Assemble simplified machines piece by piece, from a robot arm to a space station. Follow guided steps, then pull the model apart, replay the build, or run an illustrative animation.\n- SHAPE: Pinch, twist and stretch eight interactive forms, including a fractal tree, a shell and a miniature planet.\n- ENGINE: Adjust valves, nozzle geometry and altitude on a simplified rocket engine model. Watch thrust and pressure change as you work through five challenges.\n- NOTEBOOK: Dictate dated notes in English and watch a pen write them onto the page. Speech recognition runs on the headset, and notes stay there.\n- PANELS: Try 35 animated holographic interfaces powered by demo data.\n", "short_description": "A holographic workbench: assemble machines, sculpt forms, run an engine, keep a spoken dictation diary and interact with it keeping log of activity done in HoloBench.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/holobench/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/holobench/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/holobench/support", "website_url": "https://nebulytic.com/apps/holobench/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
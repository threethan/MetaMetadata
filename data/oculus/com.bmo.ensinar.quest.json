 "uba_APP_IMG_COVER_PORTRAIT.png", "id": "978384845326660", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312267_978384848659993_144858686541350325_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC2iQ8mJjZwQ7kNvwHKXk9N&_nc_oc=Ado6cfv_yiRTa51ydOYpZiRQj0WHBz-Lqm00cLLcXfdPiS6-f_3hGMCtV2O9VOM7vCg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFt8sNgkrYkA4cP6KJGuAkOqC7Si8W-BKd7HKNNl-nbg&oe=6AFB20E2"}]}, "id": "1691489202362895", "locale": "en_US", "screenshots": [{"file_name": "02_Divisao_Celular_Quest.png", "id": "1147954997976648", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/786297305_1147955001309981_6587148747760301049_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY-Ds3kCKHAQ7kNvwFrd7N1&_nc_oc=AdrBciEvHVngM02h2gq7xnRIhaIqOaX_qGBGFnQwKUV-3WctfVVLeJyuJwewK1upSIU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk9F7gQML58JQUslUlMcCV_MZnN6HZ1yaVVNO2WRdEiw&oe=6AFB2E1A"}, {"file_name": "05_Gerador_Inducao_Quest.png", "id": "1907996773899354", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673573223_1907996777232687_7100928180393315977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fuFfujRQvAQ7kNvwHaEDMt&_nc_oc=AdqYOMxpkVgDMjRViDtoGKxQC2jSCUO2UK9wsf2UG314lEJkiQ5kmdIetZZF7XEfLzc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyr_c4qmSngKtMin7eU-TBpIBZRLogfvuAPHB9B0zi1g&oe=6AFB2513"}, {"file_name": "04_Sistema_Solar_Quest.png", "id": "1521682303135739", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/737543484_1521682306469072_160597631020769871_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntZbzLvVwUcQ7kNvwHTxm4h&_nc_oc=Adp7KgkfkI9lqUhgARmuY7bthNZ-QZvDDKt8nx8jkANS5hlkSicOOEL6-XMUY5adazo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz3gY6TVxcIwPRcGoak5I67oAOHLm3hsd4_NrXji3g2w&oe=6AFB3A10"}, {"file_name": "03_Laranjeira_Quest.png", "id": "1158439523210544", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/596061819_1158439526543877_4322882257842614467_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWwyNxRZlgkQ7kNvwFn01S2&_nc_oc=AdqTiJ9_FMLRD2B7MHM508m6CaVOqDtysVxuHNcgYixBjkXLW6wXTjzQxiEMmjioNKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdUbxAEJSwyEipcYXF13EEaezeHmYsBPCf0hcu_t-kgw&oe=6AFB2E8D"}, {"file_name": "01_Ciclo_Hidrologico_Quest.png", "id": "29191048343894177", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305071_29191048350560843_7570336496410604547_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVVoYNhnYrEQ7kNvwEBBmhO&_nc_oc=AdqaRkRQuD-YcWMd46tXaipxAmxMlok-BthBRi2CadMUhMRWWRgNNhQE0XLxvBHYtYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0ounT107H06LKUTO3e10ZPT7jfEGCM85kws8DDJBDfg&oe=6AFB3A5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EnsinAR", "keywords": [], "long_description": "Turn your virtual workbench into a space for scientific exploration.\n\nEnsinAR brings together 21 modules about life, the universe and matter. Explore cells and osmosis, cell division, bacteria, the Solar System, Earth movements, lunar phases, the water cycle, atomic models, chemical bonds, plants and animals from Brazilian biomes. Investigate electromagnetic induction, molecular geometry and polarity, and braking distance.\n\nUse Touch controllers or tracked hands to move, rotate and resize 3D models. Follow each activity to observe stages, record predictions and compare your answers.\n\nQuizzes offer three school levels and up to five questions per round, without a timer. Select an answer, confirm it, read the explanation and continue when ready. Rounds and answers remain available during the app session.\n\nChoose passthrough, an observatory, a Brazilian classroom inspired by schools in Mato Grosso, or a futuristic classroom. Enlarge text, reduce button effects and explicitly reposition the workbench while seated or standing.\n\nThe app interface and educational content are in Brazilian Portuguese. Models and animations are teaching representations intended for exploration and discussion.", "short_description": "Explore science in VR through 21 interactive modules. Observe 3D models and animations, handle objects, record predictions and answer quizzes at your own pace. Choose virtual classrooms or your real surroundings with passthrough. App interface: Brazilian Portuguese."}, {"images": {"nodes": []}, "id": "1073617205725083", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EnsinAR", "keywords": [], "long_description": "Transforme sua bancada virtual em um espa\u00e7o de explora\u00e7\u00e3o cient\u00edfica.\n\nO EnsinAR re\u00fane 21 m\u00f3dulos sobre Vida, Universo e Mat\u00e9ria. Observe c\u00e9lulas e osmose, divis\u00e3o celular, bact\u00e9rias, Sistema Solar, movimentos da Terra, ciclo lunar, ciclo da \u00e1gua, modelos at\u00f4micos, liga\u00e7\u00f5es qu\u00edmicas, plantas e animais de biomas brasileiros. Investigue tamb\u00e9m indu\u00e7\u00e3o eletromagn\u00e9tica, geometria e polaridade e o percurso de frenagem.\n\nExplore modelos 3D e anima\u00e7\u00f5es com os controles Touch ou com as m\u00e3os rastreadas. Mova, gire e ajuste o tamanho dos objetos. Use os controles de cada atividade para observar etapas, registrar previs\u00f5es e comparar suas respostas.\n\nNo quiz, escolha entre tr\u00eas n\u00edveis escolares. Cada rodada apresenta at\u00e9 cinco perguntas, sem cron\u00f4metro. Selecione, confirme a resposta, leia a explica\u00e7\u00e3o e avance quando quiser. Rodadas e respostas permanecem dispon\u00edveis durante a sess\u00e3o.\n\nEscolha o ambiente real com passthrough, o observat\u00f3rio, a sala de aula brasileira inspirada em escolas de Mato Grosso ou a sala futurista. H\u00e1 op\u00e7\u00f5es para ampliar o texto, reduzir efeitos dos bot\u00f5es e reposicionar a bancada sentado ou em p\u00e9.\n\nOs conte\u00fados e as anima\u00e7\u00f5es apresentam representa\u00e7\u00f5es did\u00e1ticas para explora\u00e7\u00e3o e discuss\u00e3o de conceitos.", "short_description": "Explore ci\u00eancias em realidade virtual com 21 m\u00f3dulos interativos. Observe modelos 3D e anima\u00e7\u00f5es, manipule objetos e registre suas previs\u00f5es. Responda quizzes no seu ritmo e escolha entre ambientes virtuais ou o espa\u00e7o real com passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ensinar.ai/ensinar/privacidade-quest/", "developer_terms_of_service_url": null, "publisher_name": "EnsinAI", "support_website_url": null, "website_url": "https://ensinar.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1394437147089524"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491831279_1951946403275798_3365517470828511152_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5PvyoavtBsQ7kNvwGVNb9s&_nc_oc=AdpnYGPw--xVCZz_l3n04y5X_STHnhO9pKyEdPIO8GqUvj-IKYSJkDNCdAoo30S59Cs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvZub8zFq5at-w1Slobpv3FLMYNl4Rgz-PaFd0l6RcDQ&oe=6AFB17C0"},
 "latest_released_binary": {"__typename": "AndroidBinary", "id": "29242090205383997"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1618977329921089"}]}, "change_log": "Open six prism flowers to charge a celebration. Your hands pulse white when ready. Look up and reach both hands toward HANDS to launch fireworks that gently sweep the stars away. Stars return after the fireworks fade. Includes four-way FIND YOUR RHYTHM guidance and camera continuity improvements.", "created_date": 1792067278, "id": "29242090205383997", "version": "0.230.0", "version_code": 236, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29223221160604235", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29242090205383997"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1618977329921089"}]}, "change_log": "FIND YOUR RHYTHM now appears in four directions, hides after moving one meter, and returns after you stop. Includes Flywheel with an animated skill guide and uninterrupted rainbow visuals during brief camera interruptions.", "created_date": 1792040149, "id": "29237488739177477", "version": "0.223.0", "version_code": 229, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29223221160604235", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29242090205383997"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1618977329921089"}]}, "change_log": "Introducing Flywheel and its animated skill guide. Cycle both hands to charge and launch spinning light discs. This update also keeps rainbow visuals animated during brief camera interruptions and preserves flower targets until live video resumes.", "created_date": 1792025854, "id": "29235131276079890", "version": "0.221.0", "version_code": 227, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
c_oc=AdqPZdqUdbTjOug2f84SiKsbrQ5qSafOFzB6lrqB9mVeYt49WXMPokYBMlEfwtVN4is&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0jhPS-rhYS2cU-pfZVzJaOncEHuZ3QXh6lpq8wLjoQw&oe=6AE88D39"}, {"file_name": "03-palm-wave.png", "id": "1656454755876475", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620630_1656454759209808_266726457107112932_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7wwLYO3-KIQ7kNvwF-gD4j&_nc_oc=AdrpJeDMImr1_dLnUabu7R2KYhr--WYeFbci0gEkatxRNZGnhleW5pyw0klpk-vgemA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUrIZTl9NnlR2iK8Ln9JokkUGXWPhQWwEkwUmCTRuKtA&oe=6AE8A1CE"}, {"file_name": "04-find-your-rhythm.png", "id": "1111918081596953", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620532_1111918084930286_8798882427056585702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0KI2OS-SG0Q7kNvwHJPYON&_nc_oc=Adr5O6Po2iWoEBA3jU9cQp0Pv4q9DGmGT0ai7r3ieIJra3XrBSJm6LpMVNzCUxiTLsg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_CjTH0B43CM1RxVMWjNAUe612Z5GRjKcAURHYRUrsWA&oe=6AE8C23B"}, {"file_name": "05-hands-and-space.png", "id": "1362910042394808", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620532_1362910045728141_7605641893821990811_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U10sGOV3mCUQ7kNvwFBGlOH&_nc_oc=AdpYZWoMTkrx9b8ze61yULxqWTmhd8L_DzYl56HtYvKL8YDkJ5068fQeo6eB_CAFN8c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqFwPuFXkYzoMmW7NflHzF24uFsk6Y2UPcUm1rqUeG9A&oe=6AE897CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Ritual", "keywords": [], "long_description": "AMPLIFY YOUR MUSIC EXPERIENCE\n\nYour favorite track. A live concert video. A space filled with music. Prism Ritual turns listening into movement, and movement into visible expression. Make the space your own.\n\nFIND YOUR RHYTHM\nDrum with your fists to begin. Rainbow images emerge from your surroundings, and your voice and nearby sounds bring them closer. There is no fixed choreography and no perfect beat to chase. Move when the music moves you.\n\nTO YOU, IT LOOKS LIKE MAGIC. TO OTHERS, IT LOOKS LIKE DANCE.\nPoint to fire light, sweep a crescent blade, push a palm wave, punch a ripple, or release a two-handed wave cannon. Scatter depth-based stars and strike approaching prism flowers to unfold luminous rings and particles.\n\nDRAW A WINDOW\nDraw a circle with two fingers to open a zoom gate. Grip both edges with your fists, spread your hands to resize it, and turn it like a steering wheel to zoom. Open both hands to release.\n\nRuns standalone on Meta Quest 3 with hand tracking. Play music on your own speakers or another device; music is not included. Camera and spatial-data access power the visuals; microphone access enables sound-reactive depth. Use a clear, well-lit play area. The star field is not an obstacle-avoidance aid.\n\nLook down for the drumming guide and slightly up for the skill guide.\n\nCreated by Festa Sinarisama / Toshikazu Toyama.\nSupport: sinarisama@hotmail.com\n\nScreenshots show in-app effects with a virtual studio background. Normal MR uses your surroundings.", "short_description": "Amplify your music experience. Play your favorite tracks or a live concert video and turn the space around you into your own dance floor. Find your rhythm, move freely, and let rainbow light and stars respond to your hands. No fixed choreography. No perfect timing. Just you, your music, and a world of light."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sinarisama.netlify.app/prism-ritual-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Sinarisama", "support_website_url": "https://sinarisama.netlify.app/#contact", "website_url": "https://sinarisama.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"i
43208441257467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrFlGcY5t4gQ7kNvwGxkgCd&_nc_oc=Adqdf4KkahXtpdyVuFdIfkwkitPmlpi2iUWaIc0avnEbH5Ppz6nLIXTHWfTX4yJyHac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEZU8HCZJmqacnZcXMCFCBi0Stdz-kCJE1g-XVWTAezg&oe=6AE20B64"}, {"file_name": "hero.png", "id": "2135876333680416", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624069_2135876337013749_5894915174257808444_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QelZMqMLIH4Q7kNvwGo-1VR&_nc_oc=AdpQGYRTwbfDu3_Xbamv9-M8YPhfs-nITZOZ0QObyxxKJjgyc59ZlrffsJ57flLJ_j4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzBzIz8CIZV0o5K-zvmWipSTpo5TQD9OC5rrESjNyh2A&oe=6AE1FDB0"}, {"file_name": "prism-library-cover-1440.png", "id": "1379614027495074", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593942860_1379614030828407_4352274308688640675_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O36dFROGeVgQ7kNvwHi-KhY&_nc_oc=AdqSloh5Itp9afvcgQpDlEejgGBUwdbm8uvmvitD09QbkEvAjjhnl-uBrY9p5SLhIl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF_h4J2bKRoBsS222sye1cADTRKlwmK60hp-8O6ZuqzQ&oe=6AE1F84D"}]}, "id": "1128623209853898", "locale": "en_US", "screenshots": [{"file_name": "01-flower-bloom.png", "id": "935375336007598", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627477_935375339340931_3499339645123941314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmKWr-1FRjkQ7kNvwHQcCLD&_nc_oc=AdpkQdOWyng6CDgo1FHvJahgYhwG1FtKTMeHU2LpESI4PUpSvLCk7mu8dZCp4Eet7B8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDONEDUqGCaaoWTnYQD3zCiMnlJ-BOAVY5yRHNcKk4wQ&oe=6AE1FC8F"}, {"file_name": "02-crescent-skill.png", "id": "2626966491117890", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627379_2626966497784556_611212543645009806_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irmneKXoZy8Q7kNvwHumqeo&_nc_oc=AdqIhm3q1w5LMqylIXaaSWV8ofUslgJnSabpzIJHv3PYv21FOheFGirmJTrHrxNwYyg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2KoQe72YbP1TymeLiGD8_F271rROBdx1RbhwKIfeOrw&oe=6AE1F5B9"}, {"file_name": "03-palm-wave.png", "id": "1656454755876475", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620630_1656454759209808_266726457107112932_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndj7dTzz124Q7kNvwEoTWDu&_nc_oc=AdoeGGwWgfHOVdrLAoCsr_fwHEAeglfInmbinQZr4IKqewa1kUh1zJvwJuaEWmcGbe4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOch8XMDaMDer1AIRmAW-kbu2aKu_-lUd1h51Az9azZg&oe=6AE20A4E"}, {"file_name": "04-find-your-rhythm.png", "id": "1111918081596953", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620532_1111918084930286_8798882427056585702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clsdU0Iqn_oQ7kNvwF_I1Jb&_nc_oc=AdqOMcJHJkJuc13IHSVO4VkhW9-aUi6AGWPrFcyJFJdxQhIqhcr5yZRXQSha8E3iCfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIE4-QlOZdD3w2_uL2HBrkjEy0ZJMT0XnYRPSuVdR-vQ&oe=6AE1F27B"}, {"file_name": "05-hands-and-space.png", "id": "1362910042394808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620532_1362910045728141_7605641893821990811_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5cH9Pi833MQ7kNvwHM-_fp&_nc_oc=AdrKICfbRPwFqubbwk4-xHGQ0UhU0zEdcuSeQYJlPe03G09FfzWM9dO7SzpexSGx_vw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU56b-OArykdTW4qhAK4R-GIDYHVnl8mA5QQyrFGRoOA&oe=6AE2004C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Ritual", "keywords": [], "long_description": "AMPLIFY YOUR MUSIC EXPERIENCE\n\nYour favorite track. A live concert video. A space filled with music. Prism Ritual turns listening into movement, and movement into visible expression. Make the space your own.\n\nFIND YOUR RHYTHM\nDrum with your fists to begin. Rainbow images emerge from your surroundings, and your voice and nearby sounds bring them closer. There is no fixed choreography and no perfect beat to chase. Move when the music moves you.\n\nTO YOU, IT LOOKS LIKE MAGIC. TO OTHERS, IT LOOKS LIKE DANCE.\nPoint to fire light, sweep a crescent blade, push a palm wave, punch a ripple, or release a two-handed wave cannon. Scatter depth-based stars and strike approaching prism flowers to unfold luminous rings and particles.\n\nDRAW A WINDOW\nDraw a circle with two fingers to open a zoom gate. Grip both edges with your fists, spread your hands to resize it, and turn it like a steering wheel to zoom. Open both hands to release.\n\nRuns standalone on Meta Quest 3 with hand tracking. Play music on your own speakers or another device; music is not included. Camera and spatial-data access power the visuals; microphone access enables sound-reactive depth. Use a clear, well-lit play area. The star field is not an obstacle-avoidance aid.\n\nLook down for the drumming guide and slightly up for the skill guide.\n\nCreated by Festa Sinarisama / Toshikazu Toyama.\nSupport: sinarisama@hotmail.com\n\nScreenshots show in-app effects with a virtual studio background. Normal MR uses your surroundings.", "short_description": "Amplify your music experience. Play your favorite tracks or a live concert video and turn the space around you into your own dance floor. Find your rhythm, move freely, and let rainbow light and stars respond to your hands. No fixed choreography. No perfect timing. Just you, your music, and a world of light."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sinarisama.netlify.app/prism-ritual-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Sinarisama", "support_website_url": "https://sinarisama.netlify.app/#contact", "website_url": "https://sinarisama.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id"
67040113_983885899923027456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1nJrRHC7L4Q7kNvwFtmbWD&_nc_oc=AdrbLtMAbe9jStCO7WTQCKF3N2dfWjgFGM2pPJmbBO7vU0lNqjUB1XDCukK-_749i8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIW27PE9qkt3t_LQpjix35dgm0etm3w6p1AciZzYaaUw&oe=6AF33FE0"}, {"file_name": "screenshot_4.png", "id": "1558222465477202", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654859273_1558222468810535_2785985496703847454_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJNntI6BxicQ7kNvwGHSKFf&_nc_oc=AdqyTIYCimYUawCfA4U-khfow4NUhzlh2Paj9pFrQWwycmzLqEWqcZ24D2O-gkkgzxc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVVjfHwCeWpteKYn1Ys59MyPfR8MF4pJr_wzau4pLmdw&oe=6AF34A61"}, {"file_name": "screenshot_2.png", "id": "1416560646770980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299789_1416560650104313_1285851539457248565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFsYdNgP6uIQ7kNvwH0cV3-&_nc_oc=AdrEq9d-nqKfX7DLEuz9USv_ztUiq0h2I9eGy8e3GoX6oblbnAgvvoUQI8FNK9nB4Jc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxFdJntFBGcQbcrt_NvAghpg_OYaKWMzR1Q8k8bBTh4g&oe=6AF32DB3"}, {"file_name": "screenshot_1.png", "id": "1814504943382643", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303976_1814504946715976_3776230304824378370_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OOJgg_0I2wQ7kNvwGcPppA&_nc_oc=AdqY99p2pJuAwa8Qk6gjSJnSUpYROLFiGXgk_6Tmdb4PTFeBWhPFXtyi-JJr_kCvWeM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTzjA6GVetC5FmERR_oOFRKzC4sCSFH7JKePQ2QCLZTw&oe=6AF3555D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1411142704297772", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299789_1411142710964438_6258554483791004993_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d64k5r95bKYQ7kNvwEOKRrW&_nc_oc=AdpZgGrHDFV-sBP4AksL6At1kicUai0rXf_44-RaBPCkrwgwX6FBDFXUPpec6mfANVQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTogLcMKGGhX9UFFj6TaP7iSMiy1S_c0jQTsFhNdsQbEw&oe=6AF352F1"}, "display_name": "Whac-A-Mole Mania VR", "keywords": ["mole", "arcade"], "long_description": "The moles are back and they brought friends.\n\nYou stand in the middle of the stand with a mallet in each hand. In front of you, a table and two rows of windows. To your left and right, the walls. Over your head, the ceiling. Twenty-seven holes in total, and everything within arm's reach: no teleporting, no thumbstick, no menus to aim at. You swing, you hit.\n\nWHAT YOU PLAY\n- 18 hand-tuned missions of one minute each, plus an endless Legend mode.\n- Every mission opens a new front: level 1, then level 2 and 3, then the side walls, then the ceiling.\n- The target of each mission is calculated from how many moles will actually pop up, so it is always demanding and never impossible.\n\nWHO POPS UP\n- Golden moles: triple points, but they duck fast.\n- Bombs: do NOT hit them. One bomb costs you a hit and breaks your streak.\n- Armored moles: two solid whacks and double points.\n- Streaks: five hits in a row and your points multiply, up to four times.\n", "short_description": "Grab a mallet in each hand and take on the fastest mole stand in VR. Twenty-seven holes surround you: three tiers in front of you, both side walls and the ceiling above your head. Sixty seconds per mission, one target, and nothing to press: you swing your arms and the mallet does the rest. Smash golden moles for triple points, keep your hands off the bombs, and crack armored ones with two hits. Eighteen hand-tuned missions and an endless Legend mode that never stops speeding up.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/JLHddB4H7ZHW9SpouAiVqR", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel  Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/JLHddB4H7Z
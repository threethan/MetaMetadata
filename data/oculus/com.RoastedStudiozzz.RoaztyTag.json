dn.com&_nc_ss=7a30f&oh=00_AfzJJzGcf5Jx_J6w91h-gOlcQaT5Hs5btH8nGjnXyww5BQ&oe=69CFB444"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Roazty Tagging", "keywords": ["Tagging", "Fangame", "Fun", "Tag", "Copy"], "long_description": "Roazty Tag is an immersive, fast-paced multiplayer VR game set in a vibrant  environment of a wide variety of maps. Players take on the role of a monke/gorilla, engaging in a thrilling game of tag, racing in a dynamic and ever-changing environment. The game is designed around the core mechanics of classic Gorilla Tag, but with added layers of strategy, unique power-ups, and cooperative gameplay elements.", "short_description": "Game that uses gorilla tag locomotion to move around, explore a variety of maps with friends while also completing ingame tasks!"}]}, "developer_name": "RoastedStudios", "developer_privacy_policy_url": "https://sites.google.com/view/roazty-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/roazty-tag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9219369958183731"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported
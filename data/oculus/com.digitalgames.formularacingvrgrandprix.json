": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839711_1121737504078008_7670741399455752670_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1kS44rgKvQQ7kNvwGAmplB&_nc_oc=AdpyTvC89RKISWWigNh706wM5VapQeuwtJ2qmIHnV0VWuXHTsyAGXx8OABmhVTLDGMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTURnJkiyqWgtyReaqx4J_XnQm8y89To4WECofbcUMUTg&oe=6B0C822D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Racing VR: Grand Prix", "keywords": ["RacingTracks", "GrandPrix", "FormulaCars", "VRRacing", "FormulaRacing"], "long_description": "Formula Racing VR: Grand Prix\nGet ready for the ultimate Formula Racing VR experience! Step into the driver's seat, take control of powerful formula cars, and experience the excitement of high-speed Grand Prix racing in immersive virtual reality.\nFeel the thrill of competitive car racing as you accelerate down straightaways, master challenging corners, and push your driving skills to the limit. Experience realistic racing action, exciting circuits, and the intensity of professional formula motorsport.\nExperience High-Speed Formula Racing\nTake on thrilling racing challenges and enjoy the excitement of Formula Car Racing in VR. Every turn, acceleration, and braking moment puts your driving skills to the test.\nMaster Grand Prix Tracks\nRace across challenging circuits, navigate sharp corners, find the perfect racing line, and improve your lap times. Become a skilled driver by mastering every track.\nImmersive VR Driving Experience\nGet behind the wheel and enjoy an immersive VR racing simulator experience. Look around the cockpit, control your formula car, and feel closer to the action than ever before.\nImprove Your Racing Skills\nExperience exciting Formula Car Racing.\nDrive powerful formula racing cars.\nMaster challenging Grand Prix circuits.\nImprove your speed and cornering skills.\nTest your driving precision and racing abilities.\nEnjoy an immersive virtual reality racing experience.\nAre You Ready for the Grand Prix?\nStart your engine, get on the starting grid, and experience the", "short_description": "Experience high-speed Formula Racing in VR! Race powerful formula cars, master sharp turns, and compete on thrilling Grand Prix tracks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://actionsimulationsgames.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Games", "support_website_url": null, "website_url": "https://actionsimulationsgames.blogspot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1379635241910613"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1603519497767546"}]}, "baseline_offer": {"id": "1603519497767546"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795191600, "status": "PUBLISHED", "id": "1603519497767546"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1380092538531550", "version": "1.0"}, "id": "1196721919977375", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typena
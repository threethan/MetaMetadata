zVbG2BvfpHNQaJ_AFmDLNA&oe=69A5876A"}, {"file_name": "com.ar2vr 4.png", "id": "380544148148797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75514545_380544151482130_8611958163279227071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmN41-44y7kQ7kNvwEJhZsx&_nc_oc=AdksujHM5f7lSSb0bwGVZz1E_rIKgvMsPjbiYH1TL_XRrn1dNTf-kDNKnnHi3wgmwQk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvh6JH0ZXNUrVMh-_tdT0YlOP2_JPeWePPJiT9glrKhJw&oe=69A58BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.ar2vr 5.png", "id": "438332838648732", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75367596_438332841982065_4175588108673307282_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmxnX-gIZ7AQ7kNvwH7EWkb&_nc_oc=AdmLIcWad-S8eAL_7h9gqZyB1-yS1gUQDvfw-ywLMwfH6shsrhmt883hCAxePIaIc-I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftjaqvJ_iKfyE1NGd6xz0-IYKHrnZ_TLBxbAcLlE_hvYg&oe=69A58B88"}, "display_name": "AR2VR", "keywords": [], "long_description": "A lightweight, stable, and fast navigation eyewear app designed to assist in education and aid in VR product demonstrations for businesses. Intuitively gaze at photos to immerse yourself in their corresponding VR worlds. Utilizing VR technology to help teachers create engaging and immersive treasure hunt courses, enhancing students' learning motivation. With offline functionality, there's no need to worry about poor network conditions; simply download the navigation package before experiencing. Each individual equipped with a device can engage in group discussions and collaborate on completing learning tasks, making learning as enjoyable as embarking on a treasure hunt adventure.", "short_description": "A lightweight, stable, and fast navigation eyewear app, designed to assist in education and facilitate VR product demonstrations for businesses."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ar2vr.io/privacypolicy", "developer_terms_of_service_url": null, "publi
S2t8wZ35puBqIS4uPDld3Q&oe=699EEFEA"}, {"file_name": "com.ar2vr 4.png", "id": "380544148148797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75514545_380544151482130_8611958163279227071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24Ghl5WToVEQ7kNvwHvOw_O&_nc_oc=Adkae6mgqaiT_B_HbtBte0YFu7YdwU1aGoSwIm04K7LuwbEv2ziRveEIH_ZHSl2tMss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvDhny_9hdM9LNRfH3RqgtbRJWdw4sJxVsiYyYw1MdqZQ&oe=699EF46E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.ar2vr 5.png", "id": "438332838648732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367596_438332841982065_4175588108673307282_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyW9IIfPmTkQ7kNvwHuKm-h&_nc_oc=AdkFfEfIsNEcPm1WBrIZm-CS3G6z8Dg3BJJyvKLcYQfJLdFO1Thd_kQLukOscwpDe-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu21AsAWZ-yVyFY-w2O9kZ5pmu6cdn1mMFNsvuIhXi-jQ&oe=699EF408"}, "display_name": "AR2VR", "keywords": [], "long_description": "A lightweight, stable, and fast navigation eyewear app designed to assist in education and aid in VR product demonstrations for businesses. Intuitively gaze at photos to immerse yourself in their corresponding VR worlds. Utilizing VR technology to help teachers create engaging and immersive treasure hunt courses, enhancing students' learning motivation. With offline functionality, there's no need to worry about poor network conditions; simply download the navigation package before experiencing. Each individual equipped with a device can engage in group discussions and collaborate on completing learning tasks, making learning as enjoyable as embarking on a treasure hunt adventure.", "short_description": "A lightweight, stable, and fast navigation eyewear app, designed to assist in education and facilitate VR product demonstrations for businesses."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ar2vr.io/privacypolicy", "developer_terms_of_service_url": null, "publi
8Q1GwGkI7fdbX19WZFQ6NA&oe=6999A9EA"}, {"file_name": "com.ar2vr 4.png", "id": "380544148148797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75514545_380544151482130_8611958163279227071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rctmJ-xeUOwQ7kNvwEvO3GG&_nc_oc=AdlhJXd9TyGGZseR22vsgU6H006LRJ0xd-YoJ5QzGPXd_F2jACwCY_lfHy4gV6MH1Cg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOi1gKsrZIcuiteVxINpqdHQlt0tIaPHaBvwk-iywtjA&oe=6999AE6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.ar2vr 5.png", "id": "438332838648732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367596_438332841982065_4175588108673307282_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3LZi2RkkQIQ7kNvwGAokmi&_nc_oc=Adk-rZFQbsSZfCFq1dmu8KwREUWubBcvWUvO293d7ZTdMQbTWgI5XUAOIfgvJcE7Cso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvhBEmyAs8gWh56uY0rb-a_aSMKGz1mJxhK2NRCaDrqNA&oe=6999AE08"}, "display_name": "AR2VR", "keywords": [], "long_description": "A lightweight, stable, and fast navigation eyewear app designed to assist in education and aid in VR product demonstrations for businesses. Intuitively gaze at photos to immerse yourself in their corresponding VR worlds. Utilizing VR technology to help teachers create engaging and immersive treasure hunt courses, enhancing students' learning motivation. With offline functionality, there's no need to worry about poor network conditions; simply download the navigation package before experiencing. Each individual equipped with a device can engage in group discussions and collaborate on completing learning tasks, making learning as enjoyable as embarking on a treasure hunt adventure.", "short_description": "A lightweight, stable, and fast navigation eyewear app, designed to assist in education and facilitate VR product demonstrations for businesses."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ar2vr.io/privacypolicy", "developer_terms_of_service_url": null, "publi
tps://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2128214031125642_2006093879953357184_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XZ8hRZRavUQ7kNvwFC_Iy5&_nc_oc=AdpW7O3FCb_EZDM046HfYWBXY1eWX3cTLGXIsnaPbs65V49aJSvcfJL4-HqLKM2O09g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbH2QCqfYZhhWk93TnjsSZPZ2AjIU0-aviX1YBYrIVHA&oe=6AFB3512"}, {"file_name": "Screenshot_02_2560x1440.png", "id": "1644432697087581", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303116_1644432700420914_4837480879525191291_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEtFKGUbrV0Q7kNvwGC8gcV&_nc_oc=AdqNa2VoThGeLwVhEgf-iVf6MbWMMRxqyK82dSqmWvsdw2K1ItfNXuBPZXoj0mzMgFU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCUGUb9vaVe99pRHC1XcEjyBE8WrzkHbXCN8A2lDDSKw&oe=6AFB3881"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Prism Keeper", "keywords": ["puzzle", "relaxing", "strategy", "tracking", "maze"], "long_description": "A beam of light. A table of possibilities. Your hands hold the solution.\n\nThe Prism Keeper is a VR puzzle game where you guide light through prisms and mirrors to awaken colorful crystal flowers. Use hand tracking to pinch and twist mirrors, rotate the prism, and watch the beams respond as you shape their paths.\n\nEach flower needs its matching color, and every mirror must receive light to complete the puzzle. Navigate around fixed obstacles and grab removable blockers to clear the way. A small turn can change everything.\n\nSOLVE CRAFTED CHALLENGES\nWork through designed levels that gradually put your spatial reasoning and problem-solving skills to the test.\n\nEXPLORE BILLIONS OF COMBINATIONS\nExplore over 4 billion possible combinations across Easy, Medium, and Hard random modes. Choose your challenge and find your next puzzle. Different combinations may produce the same layout.\n\nREACH OUT AND EXPERIMENT\nInteract directly with the pieces using hand tracking. Adjust, observe, and follow the light until everything comes together.\nBring every flower to life. Become The Prism Keeper.", "short_description": "Turn light into life with your own hands. Pinch and twist mirrors, rotate the prism, and guide colored beams to matching crystal flowers. Solve crafted levels or explore over 4 billion possible combinations across Easy, Medium, and Hard random modes. Every mirror matters in The Prism Keeper."}]}, "developer_name": null, "developer_privacy_policy_url": "https://theprismkeeper.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Robertson Gaming Studios", "support_website_url": null, "website_url": "https://theprismkeeper.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1764813788143290"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1830215264664124"}]}, "baseline_offer": {"id": "1830215264664124"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791957780, "status": "PUBLISHED", "id": "1830215264664124"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1765516021406400", "version": "1.1"}, "id": "1844620550047487", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": 
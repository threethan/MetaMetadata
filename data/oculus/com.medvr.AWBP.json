ler": null, "video_trailer_thumbnail": null, "display_name": "Assist Patient with a Bedpan", "keywords": ["Medvr", "Bedpan", "Assist", "Medical", "VR"], "long_description": "Assist Patient with a Bedpan is an immersive VR training experience designed for healthcare students and professionals to develop essential patient care skills with confidence and sensitivity.\n\nThis simulation guides users through the complete process of assisting a patient with a bedpan, including preparation, proper positioning, hygiene practices, and effective communication. Emphasis is placed on maintaining patient dignity, comfort, and safety throughout the procedure.\n\nWith realistic interactions and a risk-free learning environment, users can practice repeatedly, refine their technique, and build confidence before applying these skills in real clinical settings. Ideal for foundational training, skill reinforcement, and compassionate care development.", "short_description": "Learn to safely and respectfully assist patients with a bedpan in an immersive VR environment. Practice proper positioning, hygiene, and patient communication while building confidence in delivering dignified, patient-centered care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
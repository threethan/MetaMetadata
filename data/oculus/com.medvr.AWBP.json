NjC3ujjrTbo74fx6K-kTpaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tBz6-vtAAoP8XlSYIxvXTOvR_WxoZLoAfaaX0yXA9Ag&oe=6A280B07"}, {"file_name": "vlcsnap-2026-02-12-18h46m39s730 1.png", "id": "1812204202785691", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_1812204206119024_2275650489273648170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76fdi6Xy5i0Q7kNvwHtQevq&_nc_oc=AdrHIMFDvw5j4HxZPa0kVWSwaDs7YGj3VzYpHntMBEPaYDJhpn8iRI6Bw92R1sSDYs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RBfDu_LNvHBC-vHILa_iurwpR5JFe5qS1sSEOh8_g2g&oe=6A282485"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Assist Patient with a Bedpan", "keywords": ["Medvr", "Bedpan", "Assist", "Medical", "VR"], "long_description": "Assist Patient with a Bedpan is an immersive VR training experience designed for healthcare students and professionals to develop essential patient care skills with confidence and sensitivity.\n\nThis simulation guides users through the complete process of assisting a patient with a bedpan, including preparation, proper positioning, hygiene practices, and effective communication. Emphasis is placed on maintaining patient dignity, comfort, and safety throughout the procedure.\n\nWith realistic interactions and a risk-free learning environment, users can practice repeatedly, refine their technique, and build confidence before applying these skills in real clinical settings. Ideal for foundational training, skill reinforcement, and compassionate care development.", "short_description": "Learn to safely and respectfully assist patients with a bedpan in an immersive VR environment. Practice proper positioning, hygiene, and patient communication while building confidence in delivering dignified, patient-centered care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "s
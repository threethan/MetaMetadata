4546_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozqB9lm-cl0Q7kNvwEPOj_m&_nc_oc=Adr3hHIEgElOHj0cmE5FnRJReP0wdX6Iv_snx_XILPur6Ju49jmCid1tlCuFAIPQC3Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAlUE7NZ0EOnH3GWiyJ81M4U9O0yd-_d6GyLaP3EjtqA&oe=6A8EE007"}, {"file_name": "vlcsnap-2026-02-12-18h46m39s730 1.png", "id": "1812204202785691", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819239_1812204206119024_2275650489273648170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hLq5dvmOoAQ7kNvwFWku2N&_nc_oc=Adq_rxkGB2xs7eUGcZBKImGWGCwcxdR3Gcd5sAnP_kbtw0pe9d7MHtLsTwOp9D8BNvE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCeFDIQaYcpdO8oUq-_zFNM5ZWMPZb7EdxPObvPG-glw&oe=6A8EC145"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Assist Patient with a Bedpan", "keywords": ["Medvr", "Bedpan", "Assist", "Medical", "VR"], "long_description": "Assist Patient with a Bedpan is an immersive VR training experience designed for healthcare students and professionals to develop essential patient care skills with confidence and sensitivity.\n\nThis simulation guides users through the complete process of assisting a patient with a bedpan, including preparation, proper positioning, hygiene practices, and effective communication. Emphasis is placed on maintaining patient dignity, comfort, and safety throughout the procedure.\n\nWith realistic interactions and a risk-free learning environment, users can practice repeatedly, refine their technique, and build confidence before applying these skills in real clinical settings. Ideal for foundational training, skill reinforcement, and compassionate care development.", "short_description": "Learn to safely and respectfully assist patients with a bedpan in an immersive VR environment. Practice proper positioning, hygiene, and patient communication while building confidence in delivering dignified, patient-centered care."}]}, "developer_name": null, "developer_pr
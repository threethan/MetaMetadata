sXA&oe=69F0C7F2"}, {"file_name": "vlcsnap-2026-02-12-18h47m12s773 1.png", "id": "2336222796856438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819323_2336222800189771_3109406975182960458_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuRY5XeGA0IQ7kNvwE03t5J&_nc_oc=AdotyLZMYfpTxSfOaebeISf6l14ZT4-mep4bxVsWkr9tm0DSzn4cpVcNrTBNFZxxfmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3bmNYpInCwjmK2MeTuvk9CfgtKITot88MpivkflDjbXA&oe=69F0B19A"}, {"file_name": "com.oculus.vrshell-20260212-181433-0.00_00_07_10.Still003.png", "id": "26247374604942985", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_26247374624942983_5357556156872553618_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1IKKzyBh2wQ7kNvwFkjyi5&_nc_oc=AdqwC09MttkLlyE-TisrReIyxumyY8SIAJqNvqHlf57MGM4ujQc5tdIGn3IQ0EmcB6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2vaUWG2mu6LlGv73zQiXhAs7vEbSVwhPYi3gOjeb7N6A&oe=69F0ABD7"}, {"file_name": "vlcsnap-2026-02-12-18h45m16s751 1.png", "id": "1495305895519278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821674_1495305898852611_7194274969745324546_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El3Q2bsxbPsQ7kNvwF0YKx0&_nc_oc=Adq_7KLXVCjLyc3RLFF5wjjytH80NRMbHWv3X_VHjnMVytq9J2e2-NZkKcJ6BQa-Bm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af21lVQdAjKoa8J-zcQK8n6RHC0wS54X20VjsI9hb4QQag&oe=69F0AC07"}, {"file_name": "vlcsnap-2026-02-12-18h46m39s730 1.png", "id": "1812204202785691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1812204206119024_2275650489273648170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_sJqB9xUsYQ7kNvwGbfkf2&_nc_oc=Adql1VqQRXd4j5eL3cqYM8tihyvx4ugVAHor-yUP1viaUEnvto3bp6OpEchtDW55MoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0xRojcArG0tvFXCCIyCJgiX-PwhSgKq4BwhdleZ89r7A&oe=69F0C585"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Assist Patient with a Bedpan", "keywords": ["Medvr", "Bedpan", "Assist", "Medical", "VR"], "long_description": "Assist Patient with a Bedpan is an immersive VR training experience designed for healthcare students and professionals to develop essential patient care skills with confidence and sensitivity.\n\nThis simulation guides users through the complete process of assisting a patient with a bedpan, including preparation, proper positioning, hygiene practices, and effective communication. Emphasis is placed on maintaining patient dignity, comfort, and safety throughout the procedure.\n\nWith realistic interactions and a risk-free learning environment, users can practice repeatedly, refine their technique, and build confidence before applying these skills in real clinical settings. Ideal for foundational training, skill reinforcement, and compassionate care development.", "short_description": "Learn to safely and respectfully assist patients with a bedpan in an immersive VR environment. Practice proper positioning, hygiene, and patient communication while building confidence in delivering dignified, patient-centered care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE
4E4tWIHzrYQoLiqRdUk4ZNtt4vClm8Yo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR007DcgowERZeOm1zS-JhA-xx5q0FWWChw8qk_MUX0ig&oe=6B030E15"}, {"file_name": "migrated_image.png", "id": "3020874091269395", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54809986_233008471209782_3259211936587317248_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwfFLvYsyQEQ7kNvwHWhdPz&_nc_oc=AdoToFRkoJzzEcjNNVXaWfpaQ5tzQNNk1E7YyNC7u2rAGKBtENoUxyN4IhPWi_5iWdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_RA0BWjnllc8u3jIsdhVrc9o2uiSdjfli44s8Lc1Ruw&oe=6B030825"}, {"file_name": "migrated_image.png", "id": "551319245491214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75305882_207229180380500_2169347556977410048_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx40yJ03FSwQ7kNvwEa1yU7&_nc_oc=Adr0_c0mYp5EdZVaJOHg8HgGtGJ4h6DToOJBO9Z5gb_GnwjNSygAEzeVmmzPppQlO90&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUM7xps5OCIjGqVUPU5v5A7Jg4cpPTYyVBDZ5YpkblKA&oe=6B0327F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jump VR (virtual social world)", "keywords": ["SKT", "Social", "Jump", "Virtual", "avatar"], "long_description": "\ufffd'\uac1c\uc131 \ub9cc\uc810 \ub098\ub9cc\uc758 \uc544\ubc14\ud0c0'\n\n\ub354\uc6b1 \uba4b\uc9c0\uace0 \ub2e4\uc591\ud574\uc9c4 \uc544\uc774\ud15c\uc73c\ub85c \ub098\ub9cc\uc758 \uc544\ubc14\ud0c0\ub97c \uafb8\ubc00 \uc218 \uc788\uc5b4\uc694. \ud604\uc2e4\uc5d0\uc11c \ud574\ubcf4\uc9c0 \ubabb\ud55c \uacfc\uac10\ud55c \ub8e9\uc744 \uc2dc\ub3c4\ud574\ubcf4\uc138\uc694. \ud568\uaed8 \uc140\uce74\ub97c \ucc0d\uace0 \uc2f6\uc740 \uce5c\uad6c\ub4e4\uc774 \ubab0\ub824\uc62c\uc9c0\ub3c4 \ubab0\ub77c\uc694. \n\n\ufffd'\uac00\uc0c1\ud604\uc2e4 \uc18d\uc5d0\uc120 \ub098\ub3c4 DJ'\n\n\uac00\uc0c1\uc758 \ud074\ub7fd\uc5d0\uc11c DJ\uac00 \ub418\uace0, \ucda4\ucd94\uace0, \uc0f4\ud398\uc778\uc744 \ud130\ud2b8\ub9ac\uba70 \uc2e0\ub098\ub294 \ud30c\ud2f0\ub97c \uc990\uaca8\ubcf4\uc138\uc694. \uc544\ubc14\ud0c0\uac00 \uc2a4\ud14c\uc774\uc9c0\uc5d0 \uc62c\ub77c\uac00\uba74 \uc228\uaca8\uc654\ub358 \ucda4\uc2e4\ub825\uc744 \ubc1c\ud718\ud560\uac70\uc608\uc694. \n\n\ufffd'\ud568\uaed8 \ub180\ub2e4 \ubcf4\uba74 \ub204\uad6c\ub098 \uce5c\uad6c!'\n\n\uacf3\uacf3\uc5d0 \ub193\uc778 \ub2e4\ud2b8, \ucf00\uc774\ud06c, \ud3ed\uc8fd \ub4f1\uc744 \uc774\uc6a9\ud574 \ub2e4\ub978 \uc544\ubc14\ud0c0\ub4e4\uacfc \uc218\ub9ce\uc740 \uc561\ud2f0\ube44\ud2f0\ub97c \uc990\uae30\uace0 \uce5c\uad6c\uac00 \ub418\uc5b4\ubcf4\uc138\uc694. \uc74c\uc131\ucc44\ud305/\uc774\ubaa8\ud2f0\ucf58\uc73c\ub85c \uc9c4\uc9dc \uc18c\ud1b5\ub3c4 \uac00\ub2a5\ud574\uc694. \n\n\ufffd'\ub098\ub9cc\uc758 \uacf5\uac04 \ub9c8\uc774\ub8f8'\n\n\uc544\uae30\uc790\uae30\ud55c \ud63c\uc790\ub9cc\uc758 \uacf5\uac04\ub3c4 \ub9c8\ub828\ub418\uc5b4 \uc788\uc5b4\uc694. \uc544\ub291\ud55c \ub9c8\uc774\ub8f8\uc5d0\uc11c SKT\uac00 \uc900\ube44\ud55c \ub610\ub2e4\ub978 VR\uc11c\ube44\uc2a4\ub3c4 \uad6c\uacbd\ud574 \ubcf4\uc138\uc694. \n\n\ud604\uc2e4\uc744 \ub6f0\uc5b4\ub118\ub294 \uc7ac\ubbf8, Virtual Social World \"Jump VR\" \uc138\uc0c1 \uc18d\uc73c\ub85c \uc9c0\uae08 Jump! \ud574\ubcf4\uc138\uc694.", "short_description": "\uac00\uc0c1\uacfc \ud604\uc2e4\uc744 \ub118\ub098\ub4e4\uba70 \ud568\uaed8\ud558\ub294 \uc990\uac70\uc6c0! \ubc84\ucd94\uc5bc \uc18c\uc15c VR \uc11c\ube44\uc2a4! \uac1c\uc131\ub118\uce58\ub294 \uc544\ubc14\ud0c0 \uce5c\uad6c\ub4e4\uacfc \uc2e4\uac10\ub098\ub294 \uac8c\uc784 \uc911\uacc4\ub3c4 \ubcf4\uace0 \ud765 \ub118\uce58\ub294 \ud30c\ud2f0\ub3c4 \ud560 \uc218 \uc788\uc5b4\uc694."}, {"images": {"nodes": []}, "id": "260474465027672", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jump VR (virtual social world)", "keywords": ["SKT", "\uc544\ubc14\ud0c0", "\uac00\uc0c1", "\uc18c\uc15c", "\uc810\ud504"], "long_description": "\u25b6'\uac1c\uc131 \ub9cc\uc810 
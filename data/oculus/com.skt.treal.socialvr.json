539181626996708", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_539181630330041_3726398009232064512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhAYqhdi_CIQ7kNvwEL35Dc&_nc_oc=Adn32bjzFNlCGqNpdTZmk7r0Pc3rj9bIaRK0HgwBxjOGOgkAgv4CVEuAENdAP1pYvWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs8FedUK9DzXNXvvm8gqdVs8_IYEUEL0BZUb_BayKwmrQ&oe=699D8C32"}]}, "id": "683961015484969", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "214767939836517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982695_528259938057732_1281898921534160896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFq8H6bMjEIQ7kNvwHnVBeF&_nc_oc=AdnuuH-6l7atnZSDt8rIq0oKDcFJOIQPBZJGPhPfagBovV3qAukzPAO5C1Fp9B6GRfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujPAU1uVHfZ9WBJNxaevjRs1Q6642v3zizTSrI5BSJ3w&oe=699DB59D"}, {"file_name": "migrated_image.png", "id": "853143451800680", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_220676142419370_4568400255686541312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVU5opOfi6oQ7kNvwFTzwY3&_nc_oc=AdlDZv7hTwpbJ5xkEHcvs9FugzK8N5JJWIEr7SgxX2-7u-HooXHigWBTzC63OHNCM1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft05eCJb06A6jKMNYyeqoH2n1ZpDV5AEvSCT_Pm6X3YCA&oe=699D8CC0"}, {"file_name": "migrated_image.png", "id": "255768208767482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003282_1268373663360027_5822907383340335104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_YSjWi40qIQ7kNvwHoUC0l&_nc_oc=Adn8KVnWW-AhWZVrbopbkMkZuD5u1GPVn2vo64_Ow2hZx71q2cBnVAd-KpQn7yLFQtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs4MOEI48ZZMXKsGs-IqR4pKdcmWLfHV5oVy7KxLfpXGg&oe=699D8F55"}, {"file_name": "migrated_image.png", "id": "3020874091269395", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54809986_233008471209782_3259211936587317248_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlRf0GS0qSgQ7kNvwH3luHW&_nc_oc=AdncdewJeAW86rjymPRzxXqs-3PRUf6PRLMXrLhqW_PwQvibyJ3MPsycioJapKswV0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv2MbHOXuuGSm0Wt4I82kDy5zqfDGGhQpGjmxTqr6A6Yw&oe=699D8965"}, {"file_name": "migrated_image.png", "id": "551319245491214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75305882_207229180380500_2169347556977410048_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqDphZ0xAt0Q7kNvwGyyuMM&_nc_oc=AdkXrQ5XyQd8Hx4fQz_shchlmb9rxXLwTX93R7FN7IeQUkIgKMJeFmTznvF3NKUkeHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQfDsMPmEwdgR2XZtKL9nyjovmuW8Ca8WlHqQdLe-x4A&oe=699DA930"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jump VR (virtual social world)", "keywords": ["SKT", "Social", "Jump", "Virtual", "avatar"], "long_description": "\ufffd'\uac1c\uc131 \ub9cc\uc810 \ub098\ub9cc\uc758 \uc544\ubc14\ud0c0'\n\n\ub354\uc6b1 \uba4b\uc9c0\uace0 \ub2e4\uc591\ud574\uc9c4 \uc544\uc774\ud15c\uc73c\ub85c \ub098\ub9cc\uc758 \uc544\ubc14\ud0c0\ub97c \uafb8\ubc00 \uc218 \uc788\uc5b4\uc694. \ud604\uc2e4\uc5d0\uc11c \ud574\ubcf4\uc9c0 \ubabb\ud55c \uacfc\uac10\ud55c \ub8e9\uc744 \uc2dc\ub3c4\ud574\ubcf4\uc138\uc694. \ud568\uaed8 \uc140\uce74\ub97c \ucc0d\uace0 \uc2f6\uc740 \uce5c\uad6c\ub4e4\uc774 \ubab0\ub824\uc62c\uc9c0\ub3c4 \ubab0\ub77c\uc694. \n\n\ufffd'\uac00\uc0c1\ud604\uc2e4 \uc18d\uc5d0\uc120 \ub098\ub3c4 DJ'\n\n\uac00\uc0c1\uc758 \ud074\ub7fd\uc5d0\uc11c DJ\uac00 \ub418\uace0, \ucda4\ucd94\uace0, \uc0f4\ud398\uc778\uc744 \ud130\ud2b8\ub9ac\uba70 \uc2e0\ub098\ub294 \ud30c\ud2f0\ub97c \uc990\uaca8\ubcf4\uc138\uc694. \uc544\ubc14\ud0c0\uac00 \uc2a4\ud14c\uc774\uc9c0\uc5d0 \uc62c\ub77c\uac00\uba74 \uc228\uaca8\uc654\ub358 \ucda4\uc2e4\ub825\uc744 \ubc1c\ud718\ud560\uac70\uc608\uc694. \n\n\ufffd'\ud568\uaed8 \ub180\ub2e4 \ubcf4\uba74 \ub204\uad6c\ub098 \uce5c\uad6c!'\n\n\uacf3\uacf3\uc5d0 \ub193\uc778 \ub2e4\ud2b8, \ucf00\uc774\ud06c, \ud3ed\uc8fd \ub4f1\uc744 \uc774\uc6a9\ud574 \ub2e4\ub978 \uc544\ubc14\ud0c0\ub4e4\uacfc \uc218\ub9ce\uc740 \uc561\ud2f0\ube44\ud2f0\ub97c \uc990\uae30\uace0 \uce5c\uad6c\uac00 \ub418\uc5b4\ubcf4\uc138\uc694. \uc74c\uc131\ucc44\ud305/\uc774\ubaa8\ud2f0\ucf58\uc73c\ub85c \uc9c4\uc9dc \uc18c\ud1b5\ub3c4 \uac00\ub2a5\ud574\uc694. \n\n\ufffd'\ub098\ub9cc\uc758 \uacf5\uac04 \ub9c8\uc774\ub8f8'\n\n\uc544\uae30\uc790\uae30\ud55c \ud63c\uc790\ub9cc\uc758 \uacf5\uac04\ub3c4 \ub9c8\ub828\ub418\uc5b4 \uc788\uc5b4\uc694. \uc544\ub291\ud55c \ub9c8\uc774\ub8f8\uc5d0\uc11c SKT\uac00 \uc900\ube44\ud55c \ub610\ub2e4\ub978 VR\uc11c\ube44\uc2a4\ub3c4 \uad6c\uacbd\ud574 \ubcf4\uc138\uc694. \n\n\ud604\uc2e4\uc744 \ub6f0\uc5b4\ub118\ub294 \uc7ac\ubbf8, Virtual Social World \"Jump VR\" \uc138\uc0c1 \uc18d\uc73c\ub85c \uc9c0\uae08 Jump! \ud574\ubcf4\uc138\uc694.", "short_description": "\uac00\uc0c1\uacfc \ud604\uc2e4\uc744 \ub118\ub098\ub4e4\uba70 \ud568\uaed8\ud558\ub294 \uc990\uac70\uc6c0! \ubc84\ucd94\uc5bc \uc18c\uc15c VR \uc11c\ube44\uc2a4! \uac1c\uc131\ub118\uce58\ub294 \uc544\ubc14\ud0c0 \uce5c\uad6c\ub4e4\uacfc \uc2e4\uac10\ub098\ub294 \uac8c\uc784 \uc911\uacc4\ub3c4 \ubcf4\uace0 \ud765 \ub118\uce58\ub294 \ud30c\ud2f0\ub3c4 \ud560 \uc218 \uc788\uc5b4\uc694."}, {"images": {"nodes": []}, "id": "260474465027672", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jump VR (virtual social world)", "keywords": ["SKT", "\uc544\ubc14\ud0c0", "\uac00\uc0c1", "\uc18c\uc15c", "\uc810\ud504"], "long_description": "\u25b6'\uac1c\uc131 \ub9cc\uc810 \ub098\ub9cc\uc758 \uc544\ubc14\ud0c0'\n\ub354\uc6b1 \uba4b\uc9c0\uace0 \ub2e4\uc591\ud574\uc9c4 \uc544\uc774\ud15c\uc73c\ub85c \ub098\ub9cc\uc758 \uc544\ubc14\ud0c0\ub97c \uafb8\ubc00 \uc218 \uc788\uc5b4\uc694. \ud604\uc2e4\uc5d0\uc11c \ud574\ubcf4\uc9c0 \ubabb\ud55c \uacfc\uac10\ud55c \ub8e9\uc744 \uc2dc\ub3c4\ud574\ubcf4\uc138\uc694. \ud568\uaed8 \uc140\uce74\ub97c \ucc0d\uace0 \uc2f6\uc740 \uce5c\uad6c\ub4e4\uc774 \ubab0\ub824\uc62c\uc9c0\ub3c4 \ubab0\ub77c\uc694. \n\n\u25b6'\uac00\uc0c1\ud604\uc2e4 \uc18d\uc5d0\uc120 \ub098\ub3c4 DJ'\n\uac00\uc0c1\uc758 \ud074\ub7fd\uc5d0\uc11c DJ\uac00 \ub418\uace0, \ucda4\ucd94\uace0, \uc0f4\ud398\uc778\uc744 \ud130\ud2b8\ub9ac\uba70 \uc2e0\ub098\ub294 \ud30c\ud2f0\ub97c \uc990\uaca8\ubcf4\uc138\uc694. \uc544\ubc14\ud0c0\uac00 \uc2a4\ud14c\uc774\uc9c0\uc5d0 \uc62c\ub77c\uac00\uba74 \uc228\uaca8\uc654\ub358 \ucda4\uc2e4\ub825\uc744 \ubc1c\ud718\ud560\uac70\uc608\uc694. \n\n\u25b6'\ud568\uaed8 \ub180\ub2e4 \ubcf4\uba74 \ub204\uad6c\ub098 \uce5c\uad6c!'\n\uacf3\uacf3\uc5d0 \ub193\uc778 \ub2e4\ud2b8, \ucf00\uc774\ud06c, \ud3ed\uc8fd \ub4f1\uc744 \uc774\uc6a9\ud574 \ub2e4\ub978 \uc544\ubc14\ud0c0\ub4e4\uacfc \uc218\ub9ce\uc740 \uc561\ud2f0\ube44\ud2f0\ub97c \uc990\uae30\uace0 \uce5c\uad6c\uac00 \ub418\uc5b4\ubcf4\uc138\uc694. \uc74c\uc131\ucc44\ud305/\uc774\ubaa8\ud2f0\ucf58\uc73c\ub85c \uc9c4\uc9dc \uc18c\ud1b5\ub3c4 \uac00\ub2a5\ud574\uc694. \n\n\u25b6'\ub098\ub9cc\uc758 \uacf5\uac04 \ub9c8\uc774\ub8f8'\n\uc544\uae30\uc790\uae30\ud55c \ud63c\uc790\ub9cc\uc758 \uacf5\uac04\ub3c4 \ub9c8\ub828\ub418\uc5b4 \uc788\uc5b4\uc694. \uc544\ub291\ud55c \ub9c8\uc774\ub8f8\uc5d0\uc11c SKT\uac00 \uc900\ube44\ud55c \ub610\ub2e4\ub978 VR\uc11c\ube44\uc2a4\ub3c4 \uad6c\uacbd\ud574 \ubcf4\uc138\uc694. \n\n\ud604\uc2e4\uc744 \ub6f0\uc5b4\ub118\ub294 \uc7ac\ubbf8, Virtual Social World \"Jump VR\" \uc138\uc0c1 \uc18d\uc73c\ub85c \uc9c0\uae08 Jump! \ud574\ubcf4\uc138\uc694.", "short_description": "\uac00\uc0c1\uacfc \ud604\uc2e4\uc744 \ub118\ub098\ub4e4\uba70 \ud568\uaed8\ud558\ub294 \uc990\uac70\uc6c0! \ubc84\ucd94\uc5bc \uc18c\uc15c VR \uc11c\ube44\uc2a4! \uac1c\uc131\ub118\uce58\ub294 \uc544\ubc14\ud0c0 \uce5c\uad6c\ub4e4\uacfc \uc2e4\uac10\ub098\ub294 \uac8c\uc784 \uc911\uacc4\ub3c4 \ubcf4\uace0 \ud765 \ub118\uce58\ub294 \ud30c\ud2f0\ub3c4 \ud560 \uc218 \uc788\uc5b4\uc694."}]}, "developer_name": "SK Telecom", "developer_privacy_policy_url": "https://privacy.sktelecom.com/view.do?ctg=policy&name=policy", "d
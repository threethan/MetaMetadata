nd we've barely scratched the surface of the possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.panomoments.com/company/terms", "developer_terms_of_service_url": "https://www.panomoments.com/company/terms", "publisher_name": "Moment Capture, Inc.", "support_website_url": null, "website_url": "https://www.panomoments.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1105648416867407"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1475081579226296"}]}, "baseline_offer": {"id": "1475081579226296"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1509051600, "status": "PUBLISHED", "id": "1475081579226296"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2325528034150131", "version": "2.25"}, "id": "157895791458540", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1447414238628186", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2325528034150131"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "157895791458540"}]}, "change_log": "Brand new UX, faster downloads, higher performance, and support for non-360
H&_nc_oc=Adpnsw8c6VYZeJYsxoBGpVSzuf3s130q705f1lZTD3QFfc-gtOLZEIUsz52ck3_TgWE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGHxbdkxGB63kUe3Gdw9JVQ5kyEFDA_llUeJmj1xxVaA&oe=6A4A5996"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erih2MOilcAQ7kNvwHDPtAl&_nc_oc=AdoXz-QPVAOEij88rflGFLm47TFcCU9A7rhv0MsuvSluyv0a58oDWIwYvUJe0DO2KWw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUJK0pIMOwJt5e7BEf78x0H0xjJR_LW1Xo0fj5JK0SKQ&oe=6A4A5979"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBAaVnq548cQ7kNvwEhh9fG&_nc_oc=AdrMNLr9hjRvmYi7yuXRd24y15lf51F3x6fAvSP_k8uw91JzeRrPuLPLO5QIj4YhngA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa0WR8yjZYEx_KYrMl5fqA5AWw07p85Q7jIc2v2IlRPg&oe=6A4A5D1E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdDPtovWifAQ7kNvwEWL0jl&_nc_oc=AdqbcYQ0kd0boymAit5JPLL7xw1ssoj3DChRgKx4Doy1fc1yd5MVxExPM6tMj-KXLXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqsRUrhqPluCL8WROA_kIgXMDwFqmhutnzbwWftTiDDg&oe=6A4A4DE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUdn-r4VBYAQ7kNvwFUJt0p&_nc_oc=AdoU2AzoHnx25hcKYuNS6cfMI9nPI4qC0kpX_INyL38hkSb95nOaTAqEQAmujGfnr4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculu
d5-3.oculuscdn.com&oh=00_AfsZULuVzT1j8qgrlf6Nz7wFF4zr524xd9i5pLUbJ_95eQ&oe=699C5396"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbMq48KGXUYQ7kNvwG4qmoF&_nc_oc=AdnidnNffzLEvWALJeS8KbzUaMOKy4wR1Ixci1ViZI63XLgNbINW8EOpwClABeuuEpk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvp89plmROGamgjer_Q4vX54DQ20gQnzWmxiPfXZ6u89w&oe=699C5379"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7QRvkTFwVoQ7kNvwHqCntI&_nc_oc=Adn6rgul7nkdQ89yce-X6R4uZnHe9ersLPsWcOb7OpYcJyAys6ptsaFjbPF2dPlp0aQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfunE2S0Kj1kxmYjCBaKvYxTIbAa1xKDah-Eqjyn6eMuwQ&oe=699C571E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VZpUGFX5LYQ7kNvwE9xbx-&_nc_oc=AdmrGSRSAk4iVFDRhNg85clOoEpLH8boBgdjwkyK6aTMafUj3RGIQI7BpdXNEbRDgqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft2y859P80JqnFtHKSEcijY9HvYFTDECZ2LcBdFCPG7tw&oe=699C47E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgYqUeL8SlcQ7kNvwF_bMLF&_nc_oc=Adn1Vl2EFNfG1YaeczZdbhatplqmBwYuNEUZnSL3rAdYlYvJkgbXJJ6qJGqnYf-mv_w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft9YO66AEknVLRQgZMRy7kQgM9Nndob_Onss3sY7HmDqQ&oe=699C4B1E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
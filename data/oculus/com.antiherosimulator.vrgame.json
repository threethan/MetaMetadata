G&_nc_oc=AdrjCc0WDmP2uV5G_qJMRQC35ugTjOyXQzk2EdmQUaMkFQZCpeGkLbgzDIXW38Cx0HU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1xx9m1UsANix2HIZJ3SGEAUgJCu2kua6Gq6lkwNsVWw&oe=6A903916"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7X0xzLnk9oQ7kNvwE6Me5K&_nc_oc=AdqHDo7fyr4WLvsf0cog4PhlxA5BgAbQ6PEvHpSNbEZkZ8ZCohmhIUzFK1pmZ6KxzLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD4W2wfWZ1WzPtpLFhJwEIrfKThJo8orcwyD7UkgAfAg&oe=6A9038F9"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGxqGdvV-a4Q7kNvwGYhaaB&_nc_oc=AdphQiKwMyy8SqlAKhKgPDdZxEnNQ1x-GfsWRiAvX6rlZaIeUwjzKRrzzaWfKkeekus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0OKNRtI-ZKhfHH1Q2oA7ZV0LitJ1lHl25f97kntaILQ&oe=6A903C9E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzmS9G4dSs0Q7kNvwGr1dpR&_nc_oc=AdrL8Ugb9Bn627nXfPKDl7MRWMOt7qCgnvAFi8Z5O8XwheolfUcfPIbYILnoPMP7Cvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMina0QLooyg7ZmZPeoPufZD48iUt1WK_oNqfK3Wbuow&oe=6A902D67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAo0GyQjsM8Q7kNvwE5JY7c&_nc_oc=Adqvb0B1LpoT-AwTMBpmSc0C6sVb0K7HbTDiQ50oFn4pqQsdDbc6lIKR2qI89sfgSpA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculu
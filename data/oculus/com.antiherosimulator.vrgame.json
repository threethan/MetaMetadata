Z&_nc_oc=Adrv7ZYYf6T2_Ld_a9AgSUAbQWsciXSOMc48Ai6OrtEJAZbJB6lUqZ0p74L07WgqiRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nQvdoz7tSDfqigVIx4Z3mCMmxTix-HS05rq4ufJaXVQ&oe=6A3BD916"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sncHOxVqo2YQ7kNvwFwKeZj&_nc_oc=AdqCEam9SDGlOQ-WYEBJKNRp1mpQO30nZcZWeHEP99lIiDm0tJC2eV10hUVG3CJRR6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J4Ltu8M53e1GMNd0SUo4j8sY3QoqMvr29hpT9x6cUnQ&oe=6A3BD8F9"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKsJmlmXVf8Q7kNvwFQW6-Y&_nc_oc=AdphPNMpOE_tjhexLmplJIsVQM19_UQXvb3CT9xFTQ54OSORpPxoa-_aT1eDwBwq2z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mKbux3i2ejFdaZqosG5NmGAY754uL90Sgjnao9GCjRQ&oe=6A3BDC9E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thKzKkKaFFkQ7kNvwFYlyCo&_nc_oc=Adok4IwKIMjKK4sOVWu2K4FTXYMxU7FyEoL8T438kfJcL0XQpfwzOTd8HFoENRgpc8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HqyUy1G6TlHzuVUG7PQZAD0BDoQNhdNuWI9F-eK8ISw&oe=6A3BCD67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HifTbJSZrCwQ7kNvwHhLKeS&_nc_oc=Ado0FBlEAcyrEm4FWkaoeTu1toSPnKNfvwQGqtn1k9255lH_37lD_nq9SbBv_TiNNtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculu
uluscdn.com/v/t64.5771-25/11162754_105647013313713_7595255084330516480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V7s_rZ9DvQQ7kNvwFWKClj&_nc_oc=AdoXYB__lySDn4qX4HxAyFW-WJPBDT3d9AtRn5ZGsYvwyetHDQFuVetTT2XwTxBiz88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUjwS8kOmWj47_WdEqiyn0FOD38e6GH-Kt9vah_NpbSQ&oe=69CBC41B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1457330677618990", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602290_1457330680952323_7789951964812410880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj3bEnWrf3MQ7kNvwFfFIpb&_nc_oc=Ado_26sLcbp8_HM6-LhLmJPewqS4F_Mb4ebQxhD-JqVAOXpAR1-hp31W_KJra0K996g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxC6v6V2OwfksKPFu9LF0muxyQvLLC5Rqry8EcLEw5zbQ&oe=69CBDCFD"}, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "Take a journey to an amazing cartoon world.\nThis experience will show you - through 4 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner.\n\nThis game contains 4 different exciting and stunning interactive VR experiences:\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://randgsoftware.com/?q=content%2Fprivacy-policy", "developer_terms_of_service_url": "http://rand
p&_nc_oc=AdoRd3b1szKq25iO_BBi1I5be4zYrte7ObfEz4gljlDQBk3uI7BNa3Bi-ScWbCFUCUw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49-7T24_cKrDwtzSt_ovqQCvUUydrrJn8Dv7_FovpUlw&oe=6A0C6316"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBmDz2wRm2oQ7kNvwEWWPrN&_nc_oc=Adr5Qxng_vp5CYeOAveXb_0ujNG6sbX4A2CwOUOkCFiTezugPbgZxGOA7MCKIOZVBRs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tTfaGh0Ek5IxyZ0D9JWvQIl6E6vVHZFqh41iMm_m0sw&oe=6A0C62F9"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVCdnvX3v8MQ7kNvwHSX_GL&_nc_oc=AdqccBaMuIqkfLGR_dOM0mVDu8zbL9eJastmiRXJLjN33vO9rAdqMRuJQWGBzzMzbO4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71S_LHB4DRx5U4lo_ewcJMxMlf8TRHhgscSfKPoM6u1A&oe=6A0C669E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ee4ULpHfbQQ7kNvwHfgygk&_nc_oc=Adq8ApJpU3Gfb18rgRNPsGEG43eaRhIpjgLUp2zX7PaaLvXBiMcmKNWoyZdu-79hF0c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RCzUv-JOHUozdln9TJNaMr7OrHRPeJq67FE3ze4baEw&oe=6A0C5767"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW0h5xZ8c7YQ7kNvwFLnWbD&_nc_oc=AdpNc7IC_GXGoAzPJjbFt2dd_AjC6dlGwstxjiE3V4vtXuoXQ8S18hJdSlpX1-5l2lM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculu
u&_nc_oc=Adq0Zp1fq0eWQgfcPIjxEtYsRjOFjjf8cv988VQbvdVb3QoJsp_D5X5qjJJOCCNSl1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ3BXYkRNm_B-3ELzi0xv25yfiIogvxljkBcvcSkJ4kA&oe=6AC10096"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mWAv_ib_zUQ7kNvwE2-d-2&_nc_oc=AdpTRDqnY_eOv0uA9UqsbhBWDNXp5nRagosOV1oPzGZ9OeitMEjL0CaHgVlF8pogeLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN7qnlz1YogBGdAgZR54RXQKB5jO3wlaHf2zoFfKCBrQ&oe=6AC10079"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewX5piWGv0oQ7kNvwFa6UhO&_nc_oc=AdqZbaVoHfqYBmDgrf32LW1slDxjozQuxXR3v-m9sBIs1gXvo8MuP4uTVzEmJUXqPUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8ek2Hvx_hIA4IzfD181bN7kfbn4a9fLsu8wfNqdCI3g&oe=6AC1041E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncW6r9CihtQQ7kNvwHG4sIu&_nc_oc=AdqPDrBbZD_kSj3xceyUMRb74WSGJ65Z6ODId7C2AWy8IbKX-6mMLj0he6MFJc51ILc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3ZRAw1_kdHsrIoLSVOBxsT2J0ZY0N1s5162hv4DTAYA&oe=6AC12D27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnAv01rDNhIQ7kNvwE0-pCE&_nc_oc=Adq5qJeUnQ98FR81jp9W4H09N898yhLgT90byNFjyckFQdkFL8KuF8n7wLafIGWQbzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculu
j&_nc_oc=AdpuQ2870lNJijmO6r9XBBc5OPpAaDnDpWzv_PzTYMeoDviiZbUYPgc0ZW9IrHJIZhM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCszobk7vVn9rUqumKD82lVdIK-f_B73ssDLCLPGUXBSQ&oe=6A660916"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zupnt6h2OmAQ7kNvwGpDLZq&_nc_oc=AdoTnIz2oSVaWSVV_1Yy7Ymz0DBZcIkAZD9pexNclBBWUI53HUCtvu93FmUsoR_2UYc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-JchWj1ctK8xvDMO2Bs65HeWGVRgwjLRm8Ddx-G-86g&oe=6A6608F9"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnIvNoz8UEMQ7kNvwGYg0eF&_nc_oc=AdrV9VjrJj0Ars7TNIjBephzvKqjwltMHIneAaBSGTpz3S3sqaiwlQmV2cN-shGck8Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAComzXCZEdjup6e258X1aU03xFVryWKPi6Ce4NjDC3aA&oe=6A660C9E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AINPxHZfU0IQ7kNvwH81mUB&_nc_oc=AdqsRrxYW4p6m7olr_efJH1BrRiV_IGehFhoOQpWxwSaWKelXf1Da_X22h6-7er-JS0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvjsEYSRFzgJGjRxXHcLp53hjnEA06iPvRR2_jQ7DOFg&oe=6A65FD67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jywx1bNtiCkQ7kNvwHxOaWD&_nc_oc=AdrATE9QqzVJBhSI5i7V9k9A1-46fQ9g19MAjHc2MvvXznf6ZnjhnRcgQ7ULj_jj9nk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculu
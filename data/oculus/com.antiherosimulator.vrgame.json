Y&_nc_oc=Adp0VIQ25UhxFJh4AcdNooVfXTpF_xzw5blCZZavNcj-X860YJQFRfmyQt41wp_giNY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2S7kQQKJuNhkq4LuNJeCVVouosqRcSU3gPkUd4yizBQA&oe=69F5F996"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmlT9Gpmc7YQ7kNvwEI8XOB&_nc_oc=Adqg13gv0cXlpM5syRK3vfkxm2aA8bQBaYb3F18Z6cfIj-qxHKFdy5jpA0XM6SuZMNk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LWme5WuO7UuKjgtg75xxK62ipnoCh3rIGdaidygF9-Q&oe=69F5F979"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bksmy-ftdEoQ7kNvwG5zHC_&_nc_oc=AdrEjFTtlOzOe5jj09MapoJZcP7K7Ool5Q9UXVCxy0KeS56zG_WfCBiepO_wRRyA9m0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Kayl4bnPXw7Hx0snuhJpP_2vULTHnvmYx7i3O7NeHzA&oe=69F5FD1E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrbjAugCaGYQ7kNvwGxghn2&_nc_oc=AdoVHm3bts_IROSsmaCuUZEi0-kIhOdrfJQ3kEtmbm8BboB3A0sLaXlIkFHYCvjzKXY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sbvIS35HwgsqxxvmTvKbbuWhTkC_Fo5U6GjZv6W5IJg&oe=69F5EDE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jw2YMRfBoOcQ7kNvwHNafWn&_nc_oc=AdrG9Jm2HHfR454EfAZ1mEfm1A86PrZNQdfEVrNRp9eoF2efLZU_9xBM86mX_r77MYI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculu
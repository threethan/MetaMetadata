x&_nc_oc=AdoeYi5y4KJksxpOtaBuWWue0sgM0ZB3rgEDyOYTMLTmmm670jEgEhoWiCygji1IJP0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEhwQhVOa26Pf-pN-YoVhUt32SYmbmkJaFV97rW4pP4g&oe=6AECBA56"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stbIrtravy0Q7kNvwHTj7e4&_nc_oc=AdplC2Arz89-ktXhvfy2MH3kEQngY5OxyRgWzcj8Qs9wxrTTrRqDPg88hYpRbSXos7g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEKKNoaAY7ORpibzbJbz1MVVhEMPolF-HnCUICz_pzZA&oe=6AECBA39"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNKbCV039sYQ7kNvwGKgO0T&_nc_oc=AdpwKKXlgC0C5g8YI0maPUsK5sisCZ7g6-KkWUEDJsmVn4-mg6KOngSdaU629nNu-8M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Ybv63i58QGXJSxTRT8SuvrYXNBBdpU7DakcM8heqvg&oe=6AEC859E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gqnuxm7RnAQ7kNvwHC1nm1&_nc_oc=AdpL0etlNe1QH6QLpuEZEHVQsJkzAvkS_yJlHHFzXTK0P9pMG8bpnNsp4FRgZCy-vPk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxY263QRIgnRWegXsHzUTF8_QfKY0L69wYaFUJOGbNGg&oe=6AECAEA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VEB5ADa1OkQ7kNvwHoVAOp&_nc_oc=Adqwp3d2GvQ9lSPKXw3owYGY0dSYeD3AGCSlcS5_CpKosRiKBR_88qNMlHO9Dz03z9Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculu
d5-3.oculuscdn.com&oh=00_AfsT_I-ezSVPVapRx4Os3Z2GmJcjXx18ZeDWxQZLeLqVvQ&oe=69A43C96"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFnLGvThr_IQ7kNvwHnfjdo&_nc_oc=Adl9UdOxHmdXewYKHZTIgeZ3pCRD33yJuJ2rDwfurjkD9LOIwg3ERSZYfQjNuo-QB4c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuwKMkoxTwj9lahDuct1S-hU93oYDm0-b7NXiQuCj8tKw&oe=69A43C79"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCJMOaDXO54Q7kNvwH4IfJp&_nc_oc=Adl_AFxETwDgW1ycGFQJ9TyyEx8cvQF1RYx1LHTzv6ap3Bx03w8q0xmTCvv6I4KXC1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKR50fAYkh_ahfaJNA1r6lXfpYs3LMGxsMXLbq8ozOjQ&oe=69A4401E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjwPQltOdeUQ7kNvwGWmPY7&_nc_oc=AdkX5iQXWpqueYioD9qp2wPXYIVjQ0qm6DKYaRWLzwfu0NaXaD76CcclnaVJ3xtp908&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvun1gq12EP-oFYKx_b8NgVZSJfSfNQwoLfZ2baPWIvVg&oe=69A430E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxJZBlqX_ywQ7kNvwFsbDnE&_nc_oc=AdnQekwGlM8TpU6JSh48ErmWtWHe22c9epqVk0Nm1ZfS00TkIO2qo60fDvTncOfdepk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsD5F4zBaDK0eodsm_daDTqWyeDw6jRAc-ghkx7putDvw&oe=69A4341E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
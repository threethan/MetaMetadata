W&_nc_oc=Ado8BNOsV30J4y_POIus2q6zChNjd4pfNOHoL2LqrSlo_7jAgSUhT3CFxB8DcSss83c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjlDpCobOJg6mMiKwdOp3mviYDLajoQwwQZIMzxy99EQ&oe=6A748996"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9UZ2Kt-Qt0Q7kNvwEU3wZG&_nc_oc=AdoN5ngBWJ8W7l_C2SR98P5G7HyHsnDM5jBGJfXwsmTHtmhp2l5jFIpKsSTf9DM6FjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPleJkrf2ic7j-c5JH6C8Euv76MSvotsGxpdewZQ90pw&oe=6A748979"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1woN3uc3CgQ7kNvwGG5G_A&_nc_oc=AdpJRN01bxT5xC-F5RJPJKADlbeEfTEfKQ4cbUOndB1h069wDgpnNJxYCloTGd_bvu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOzb8PsHncfFqRYKai2v3E3xeXlIxsoeA9kcz65gLWpg&oe=6A748D1E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKfymYkLkGsQ7kNvwGmtgzG&_nc_oc=Adom27pdBzR_VwNmlCtdgRkp2KiqKW64tamjr3yc45S5JlMPNa0hBKS6J8RfmeLQ-e0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLb2hJn70qdY0VJdvuv2PT9G7_sn_BO5xYJh8zHreNrA&oe=6A747DE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s4e-OKRPFMQ7kNvwGj7yjz&_nc_oc=AdpgxNGYAs5kCjia43AJgonRGvZu6fl6OEuBxG6axT8LLB4th4tWDXtY679QnDWiM3k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculu
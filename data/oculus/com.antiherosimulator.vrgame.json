uluscdn.com/v/t64.5771-25/11162754_105647013313713_7595255084330516480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO-PUfa6qKkQ7kNvwFvJJpA&_nc_oc=AdqLYkzoL7CCqQ9nHrMMe-A8PcgJzyTMqr-qgtva7vaCRkFVlu2ijdWvEtugUWue_zQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfTvRBNlYnXnQmQy13M2ZKfGRvOVKJ5KRZp4RjDQYNLg&oe=6A58D49B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1457330677618990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602290_1457330680952323_7789951964812410880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVql1iv0P0IQ7kNvwHjAnde&_nc_oc=Adop6qax1L2g-Psy3lxuyXqH9ZpXf4yrGO1epBmOR6WWPFCHkFamebZGzsbIt5DXm7g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmNxEMuLsSzr8ljmsAwzWV4iDGN4AwCinfgVWzbDT_4w&oe=6A58ED7D"}, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "Take a journey to an amazing cartoon world.\nThis experience will show you - through 4 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner.\n\nThis game contains 4 different exciting and stunning interactive VR experiences:\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://randgsoftware.com/?q=content%2Fprivacy-policy", "developer_terms_of_service_url": "http://rand
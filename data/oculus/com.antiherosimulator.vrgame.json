7&_nc_oc=AdpIKlzO-1o0Rdy5FFY361_E8o8O-4mihsYDgNgAqwDGyyPRnhICxdqtfP0j2VmPAa8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68dtssm2wIOfEYtUMjusKhBubghXxLAgLy-f8eod4s1Q&oe=6A1AE396"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuUpd53YZLUQ7kNvwGmn5ap&_nc_oc=Adq7v2Ay1XSgCprKCl8rgrb_sJrr9TO_TqH5F50tig4KJb2tWlEWvnKM0BAgcSCm3c0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zOU21x8rcEi2boIq1wHlGc1iB7BWM82J8a5rVPV3Shw&oe=6A1AE379"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wb-_J-WdJykQ7kNvwEKBLd4&_nc_oc=AdoLiN3YQSgNY4oSr8gJ0JA0ouaHjS5n91EwbJi9vrKIfMCT5Q-0x6HHZPzrQ4QmjgM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KoiAv5MIs3kNTMVTrPfsV7QmrWSaATtNFLYERQkm-Ug&oe=6A1AE71E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6r3PYmENlUQ7kNvwH7q_5S&_nc_oc=AdoYe-YWIryiAfXoSWM1ytIOCiornDhPbSxe1SBVPiJWTFXO2v8zDISMEMCNtxJc_yU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nJXhBeF_fjLLKmcM1qtreAJI4pitx1_pwWCgk1JhAXA&oe=6A1AD7E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsM3TQok5rsQ7kNvwEKA4Bd&_nc_oc=AdpeF1fuJhh42qLhUWyd8tpzzxmnDPl2yp-u84jXTvm_22Vdx3qLwRzNHQOGWZNI1rw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculu
d6-1.oculuscdn.com&oh=00_Af0XqJiEryUcGxzB0iDfJi6rq1SuxS1CD0neW3bOIR0XCQ&oe=69F0B396"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AdtR5TUSggQ7kNvwHL06pD&_nc_oc=AdqPVo_vbylEo2oGMnDs46NEYkWtxkQqbX3e_lc-sXnVSWHBHEPH-q0lVGSNinvPL6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0gtNeZKTR9_lIFGuAWAy8o5qgeo8TxfAM0gNbmhzaU0w&oe=69F0B379"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYDM9Q6Rox8Q7kNvwEu_cEf&_nc_oc=Ado9wArRj28U11_xPTE5lHWip3rUpVUT_kD7msKQVGJGjKE7iif7jqHS1tk1PlzPSUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2Zk6efYjm7rdQKz3cpufyBS_iwawxbveuKDsAndqQ6Tg&oe=69F0B71E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWDB4facbpcQ7kNvwFhcjsv&_nc_oc=AdoXefawXuJ5fz3UTRxowBEJwDKK_1PH1lq9G3ajld7E7EludgMFGcVrILywMPUb8CA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2DEtzbaJsj1eIDLeMfWKuD2-kY9L_ZY-vq5l50KS8X8g&oe=69F0A7E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUuTiR9nfjwQ7kNvwH3Bfi5&_nc_oc=AdpFR-x2wgqjjGdcmJpCyoGck3JKuS7VA7mDrhM8fq87vtDaLvEg95Hjxp_AqNKdx1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af27F4x71HiFpWLtpeeq2wHafqzljilMGGxI-nKDZLcAew&oe=69F0AB1E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
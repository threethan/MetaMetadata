R&_nc_oc=AdrG5twrdLcsQ7KoPPRKQD6T1W0IZQ_p_d8sD6RDRtyO0VnpmbnoiTI6x0wTA73ougk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgqBinISj6RfkPQYlEdYHp1_U3Vphj6FphVkopixtuSQ&oe=6A69FD96"}, {"file_name": "migrated_image.png", "id": "1084883978534252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162741_819345054904358_4606622492503572480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaWFuXJ4G1oQ7kNvwHJKGCW&_nc_oc=AdoAQ9Wx6z8KUxgny7XFprSqsP6N_EikDEriRoll5Hage3cxqIdJYfMgzGgmDhoKnf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwKc7Nf8nWjnECe_HVAMjtC0_Qy6yNZNFEbqZ4QzPLoQ&oe=6A69FD79"}, {"file_name": "migrated_image.png", "id": "874183863045834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162801_217017035445041_6333627399116161024_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i5JvkASj-MQ7kNvwESdMUU&_nc_oc=AdpO0b7yGhFJoPntSByfj7ohx5PdSoVgxHvmYULyQQ5u_WSEIkV-eHCCdes8oAdN_2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALbkTQsJnf9NDPa8q5eMeSL9JKPDcsoJjn8LUwOpepHQ&oe=6A6A011E"}, {"file_name": "migrated_image.png", "id": "596538994407254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727760_232591803813668_7540574515655344128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaqezfWwoT0Q7kNvwH6M8lB&_nc_oc=Adr5Xz0bj-wg4O9Spxnuohw3985o0nOTZ7XeMdQBIwXqrJHtXSDq7u5NOj5PpgQ3Nas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr3Ots6m4GTnpP4eznqoZ4E2KVDD-4yygY_32KeuzGjA&oe=6A69F1E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antihero Simulator", "keywords": ["cartoon", "skydive", "coaster", "glider", "parachute"], "long_description": "NEW Christmas experience added.\n\nTake a journey to an amazing cartoon world.\nThis experience will show you - through 5 exciting games - how hard is an antihero's life. You will see catching tasty animals in the middle of the desert isn't as simple as it seems to be.\n\nEquip yourself with crazy machines to be able to catch your dinner. \n\nThis game contains 5 different exciting and stunning interactive VR experiences:\n- Chase the Santa in an amazing Christmas adventure.\n- Equip yourself with a parachute and a massive fan then launch yourself from the huge catapult and try to catch your food\n- Get in a minecart and try out how dangerous the abandoned mine railways\n- Shoot out yourself from the huge cannon and use a wingsuit to steer yourself towards your target\n- Use a hang-glider to chase your dinner", "short_description": "Take a journey to an amazing cartoon world and equip yourself with crazy machines to be able to catch your dinner."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "https://tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "https://tech-tro.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480056573669709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162801_1436130413101779_6395371402286858240_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtfeTHjuwyQQ7kNvwEnDWGk&_nc_oc=AdqxrJyhREWHZj1Xvcenk-NKaFkxvoe8vbZ_6x1wHEvmZXVKuYdYhJ8fubtVkF8ltKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculu
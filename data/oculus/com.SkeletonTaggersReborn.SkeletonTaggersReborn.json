K7ZDDkkss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdYA1Q2sTi1K3fZhUyn-kf9kOv94VY_Yoz-rc8nNx7Zg&oe=6B0DB996"}, {"file_name": "Screenshot5.png", "id": "1212839027587734", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1212839030921067_4268759861806327981_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fj3swapvLfcQ7kNvwFmPolo&_nc_oc=AdplY6wsUUs9iyqfLbIRzL2Js_tJD6bw3gl5zLaAjD8hGL4Ms_KGi-by-5R-Ttsm51g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8LXSGyCItgTMRwh6mGUD17B2p_MRHVNVxUqj80n4DHw&oe=6B0DABA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skeleton Taggers Reborn", "keywords": [], "long_description": "Skeleton Taggers Reborn is a fast-paced multiplayer movement game where players use their arms to run, jump, and climb through interactive lobbies. Master smooth, physics-based movement as you chase others, escape taggers, and pull off quick maneuvers using momentum and skill.\n\nExplore different maps with unique layouts and routes, allowing for creative movement and unpredictable gameplay. Whether you're juking players in tight spaces or launching yourself across the map, every moment is full of chaotic, skill-based fun with others in real time.", "short_description": "Skeleton Taggers Reborn is a chaotic multiplayer movement game where players use their arms to run, jump, and climb across maps in fast-paced chases. Dodge, tag, and outplay others using skill, speed, and clever movement through a variety of fun and unpredictable environments."}]}, "developer_name": "KleckserHD", "developer_privacy_policy_url": "https://sites.google.com/view/skeletontaggersreborn/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KleckserHD", "support_website_url": null, "website_url": "https://sites.google.com/view/skeletontaggersreborn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context
23310_1212839030921067_4268759861806327981_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdGpvVmMX7gQ7kNvwEr_Bv2&_nc_oc=AdoXEmXjR446SWORuPx8RzCqUlhxPWY0zycfHT8JNgqSaDlO4xcMKVG9f9FC0aMJFYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPipSd4TtiAWHdHyuS0BR7UNDaXiI9ZZaJmJqmX85upFw&oe=6AE5E661"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skeleton Taggers Reborn", "keywords": [], "long_description": "Skeleton Taggers Reborn is a fast-paced multiplayer movement game where players use their arms to run, jump, and climb through interactive lobbies. Master smooth, physics-based movement as you chase others, escape taggers, and pull off quick maneuvers using momentum and skill.\n\nExplore different maps with unique layouts and routes, allowing for creative movement and unpredictable gameplay. Whether you're juking players in tight spaces or launching yourself across the map, every moment is full of chaotic, skill-based fun with others in real time.", "short_description": "Skeleton Taggers Reborn is a chaotic multiplayer movement game where players use their arms to run, jump, and climb across maps in fast-paced chases. Dodge, tag, and outplay others using skill, speed, and clever movement through a variety of fun and unpredictable environments."}]}, "developer_name": "KleckserHD", "developer_privacy_policy_url": "https://sites.google.com/view/skeletontaggersreborn/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KleckserHD", "support_website_url": null, "website_url": "https://sites.google.com/view/skeletontaggersreborn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRE
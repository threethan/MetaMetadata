23310_1212839030921067_4268759861806327981_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HusmZE-mkAEQ7kNvwHGG9-G&_nc_oc=Adp4sEjxt0bHTPOWQ71HZN33yl4mgu6BYds5GkJMVkzAwmuLm3HnqTD-ducZhAZ481s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4_tCqWBy9QOg4-r7aZ2yWy_NCbucZeGrkXsbYF0LT-A&oe=6AF893A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skeleton Taggers Reborn", "keywords": [], "long_description": "Skeleton Taggers Reborn is a fast-paced multiplayer movement game where players use their arms to run, jump, and climb through interactive lobbies. Master smooth, physics-based movement as you chase others, escape taggers, and pull off quick maneuvers using momentum and skill.\n\nExplore different maps with unique layouts and routes, allowing for creative movement and unpredictable gameplay. Whether you're juking players in tight spaces or launching yourself across the map, every moment is full of chaotic, skill-based fun with others in real time.", "short_description": "Skeleton Taggers Reborn is a chaotic multiplayer movement game where players use their arms to run, jump, and climb across maps in fast-paced chases. Dodge, tag, and outplay others using skill, speed, and clever movement through a variety of fun and unpredictable environments."}]}, "developer_name": "KleckserHD", "developer_privacy_policy_url": "https://sites.google.com/view/skeletontaggersreborn/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KleckserHD", "support_website_url": null, "website_url": "https://sites.google.com/view/skeletontaggersreborn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRE
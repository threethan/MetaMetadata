ame": "Crane_screenshot_4.png", "id": "1099921659148905", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828050_1099921662482238_1689825574361580623_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCSOlhJEl3AQ7kNvwE5Qzv6&_nc_oc=AdpbKmxEpHDidXPiPfblSMYETQSMQDctWhrXkcRbByEO8rrnImRmDkuWJTf3buYnHo4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvTOvNB1kAxmG8vQkZqcUvkFdDcWWOvmy__hBEvIOSxw&oe=6AF333A4"}, {"file_name": "Crane_screenshot_2.png", "id": "1657031735990234", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828008_1657031742656900_4692598384903563325_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiVDpv1-4NAQ7kNvwFvWfj2&_nc_oc=AdrD0-q5nMvPUu2VThDMqYQkWXv5vmZbMJp48gx8MC0wxaDWCRAUu2eFLl66phrfZvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAkHXXO_KD68blRDegNujLGWQwqJHBIbTkX-P_QNbivg&oe=6AF352AF"}, {"file_name": "Crane_screenshot_1.png", "id": "2626947474424167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_2626947477757500_5497919035340309453_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK5PM6UqdlAQ7kNvwH4fqMR&_nc_oc=AdrzRbEK3QCyAtm_oGfN2h7AXd4hQ_pL1_P3yk7K8D_T2B2Zvs8D0CZBfVykbeTFOTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBFAQHhJ2F9TdC9J_1balpPK60MiW1uq_g4rkCRH1r8g&oe=6AF34F6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be A Crane - Simulator", "keywords": ["crane", "simulation", "sandbox", "fun", "building"], "long_description": "**#\ud83c\udfd7\ufe0f Become a Crane**\n\nBecome a powerful robot with crane hands! Grab, lift, carry, and place heavy objects as you construct, explore the site, and experience the freedom of a construction simulation.\n\n{2176833553212660}\n\n**#\ud83d\udca5 Create Chaos**\n\nTurn the construction site into your own sandbox playground. Grab, throw, smash, and move objects around as you experiment with the environment and create hilarious chaos.\n{1440135504645577}\n\n\n**#\ud83d\udce6 Order New Materials**\n\nNeed more materials for your next creation? Order new construction supplies and put them to work as you build, experiment, and create whatever you want around the site.\n{1581304450355842}\n\n**#\ud83d\ude08 Annoy People Around You**\n\nThe workers are trying to get their jobs done\u2014but you don\u2019t have to make it easy! Mess with people around the construction site and create funny, unexpected moments as you cause playful chaos.\n{1553961683409846}\n", "short_description": "Become a crane-handed robot and take over the construction site! Build structures, grab and move objects, annoy the people around you, or simply cause chaos. This VR simulator lets you build, experiment, and turn an ordinary worksite into your own crazy playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1362126816975928"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1746250299937067"}]}, "baseline_offer": {"id": "1746250299937067"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790153880, "status": "PUBLISHED", "id
oe=6B05A98E"}, {"file_name": "Crane_screenshot_4.png", "id": "1099921659148905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828050_1099921662482238_1689825574361580623_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0dnccsY3BEQ7kNvwFZzb7s&_nc_oc=AdrgHqmW33TjVhWSGKjb6QKleN4MwHPJVYcz1J2nasgDzTZc6hPp4ClqkG3SxaJ_l4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8IICRTjT9cOmhMbBjYKhuSw69BS6_PWao1Sh_WYO16g&oe=6B05A8A4"}, {"file_name": "Crane_screenshot_2.png", "id": "1657031735990234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828008_1657031742656900_4692598384903563325_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIlZKQacPhkQ7kNvwF7nQEm&_nc_oc=AdrGFEQLKSPEov4uVs_W1PIUy1TBYysZ35ajjEqIoWeMyBlxdLcXvriD5cT3fPjuRyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvffgCX7Xk5Bt5QBk6icFoQkEc9PGl6qTI5t7RABFiFA&oe=6B05C7AF"}, {"file_name": "Crane_screenshot_1.png", "id": "2626947474424167", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_2626947477757500_5497919035340309453_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toYVqJpKb3YQ7kNvwGMKAuh&_nc_oc=AdqZcw_RUi6wNf5t8tSXiTZXOXEX4Q33yG8XmlU4w1YqPiggWquu54A9H5f7WTWePJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIs5A4vkln486NsFKUrfFNIVJC9bnsuee1PvfMiNjxsg&oe=6B05C46A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be A Crane - Simulator", "keywords": ["crane", "simulation", "sandbox", "fun", "building"], "long_description": "**#\ud83c\udfd7\ufe0f Become a Crane**\n\nBecome a powerful robot with crane hands! Grab, lift, carry, and place heavy objects as you construct, explore the site, and experience the freedom of a construction simulation.\n\n{2176833553212660}\n\n**#\ud83d\udca5 Create Chaos**\n\nTurn the construction site into your own sandbox playground. Grab, throw, smash, and move objects around as you experiment with the environment and create hilarious chaos.\n{1440135504645577}\n\n\n**#\ud83d\udce6 Order New Materials**\n\nNeed more materials for your next creation? Order new construction supplies and put them to work as you build, experiment, and create whatever you want around the site.\n{1581304450355842}\n\n**#\ud83d\ude08 Annoy People Around You**\n\nThe workers are trying to get their jobs done\u2014but you don\u2019t have to make it easy! Mess with people around the construction site and create funny, unexpected moments as you cause playful chaos.\n{1553961683409846}\n", "short_description": "Become a crane-handed robot and take over the construction site! Build structures, grab and move objects, annoy the people around you, or simply cause chaos. This VR simulator lets you build, experiment, and turn an ordinary worksite into your own crazy playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1362126816975928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828050_1092877909812749_2711144
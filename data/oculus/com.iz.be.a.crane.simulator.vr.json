7a0a&_nc_ohc=NBM4vexU0I0Q7kNvwF58ZcT&_nc_oc=AdoA7CKAEOTmxRLH3HG9ovLK3RL30DbUPifpTxdpmD31TyK1ScE5TTWYAQujjYrDevM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRsy6RuWttkh9CNM8MwIu1XDJ8d-kO3eqfuRzFpz8Osw&oe=6AFDBFA4"}, {"file_name": "Crane_screenshot_2.png", "id": "1657031735990234", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828008_1657031742656900_4692598384903563325_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTNmmD4u1XQQ7kNvwGN4lzp&_nc_oc=AdoSxqYw8K7jltNBqawaZxblPwalb7CAPh7-XTd72-n5hNAcqxWkZp2jdKG8Q3jiml4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYKsTI1LfUCMmyVqFbYnEZ2c_dhY_7STfbk4okb10B3A&oe=6AFDDEAF"}, {"file_name": "Crane_screenshot_1.png", "id": "2626947474424167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_2626947477757500_5497919035340309453_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmbHNGyIHqgQ7kNvwG7styV&_nc_oc=AdpqrasBjOu-8t8i5JGuVKN9LW8IelqcwxbvyrTFrewYMb6OMLjO9I9KERqhlg2Ss9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT66JDOdQAjUTynLaAlB0R6WE2Z2DmUpB7lgG7-Lb8PPA&oe=6AFDDB6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be A Crane - Simulator", "keywords": ["crane", "simulation", "sandbox", "fun", "building"], "long_description": "**#\ud83c\udfd7\ufe0f Become a Crane**\n\nBecome a powerful robot with crane hands! Grab, lift, carry, and place heavy objects as you construct, explore the site, and experience the freedom of a construction simulation.\n\n{2176833553212660}\n\n**#\ud83d\udca5 Create Chaos**\n\nTurn the construction site into your own sandbox playground. Grab, throw, smash, and move objects around as you experiment with the environment and create hilarious chaos.\n{1440135504645577}\n\n\n**#\ud83d\udce6 Order New Materials**\n\nNeed more materials for your next creation? Order new construction supplies and put them to work as you build, experiment, and create whatever you want around the site.\n{1581304450355842}\n\n**#\ud83d\ude08 Annoy People Around You**\n\nThe workers are trying to get their jobs done\u2014but you don\u2019t have to make it easy! Mess with people around the construction site and create funny, unexpected moments as you cause playful chaos.\n{1553961683409846}\n", "short_description": "Become a crane-handed robot and take over the construction site! Build structures, grab and move objects, annoy the people around you, or simply cause chaos. This VR simulator lets you build, experiment, and turn an ordinary worksite into your own crazy playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1362126816975928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_1092877909812749_2711144099391946207_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqt6rWeefzAQ7kNvwHCGJWI&_nc_oc=Ado9S3ddZWt6gOjrAq-FSJ9xUVvPgUHfoA3qPkGpshleg-2OgzWPAfAWA1A_6n-cFog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.
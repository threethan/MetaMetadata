b=1-7&_nc_sid=6e7a0a&_nc_ohc=xCWeqarqgcEQ7kNvwEtbk_P&_nc_oc=Adr2Ng7FK9H2LkVdchk6fr0PpSE-baQYSyTUvQ5jvv-95gXNezTv0uNNyv3DUcypOnk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwux2d05DhxIcXj0UYi5JBA3S8nwFLfQrQ43uOh-uQdbQ&oe=69C7E7E0"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S7N21fAsfAQ7kNvwGQ-USg&_nc_oc=Ado2RQ3koSPmbTgIgT0bGM6jhy6LDz50gjEzKP1AO010RUBi-72GWMO9leTqRgx-9kk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoEpXoZG0ELm-vYgL9aYEhhi53bXEOHxS9s5lCUNn3EQ&oe=69C7E44A"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV94VPuM92AQ7kNvwGTSHdc&_nc_oc=AdrcOdeXcJE7O0sLs4BV7SLHxQ6utPKNmuOtkPv8PzPV-9CnWSq98XCAQs5RY_mZHSs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCgV55Dt3i7FuObGbdjShn7XbIB9cnTrso-hiWDFbYFA&oe=69C7C453"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk4m4AbmakAQ7kNvwE9WpTX&_nc_oc=AdrrI3r08YC8aCpM0QOoscqHFX5cci5M_vjEKsyRcaFEqM_SZSRdd3B-xj19JuLlgXU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4u2zHqn2eYc0YbijjOnjyBxlob09eDPdghReR3qnlRQ&oe=69C7CE56"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
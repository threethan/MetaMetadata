E", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2cFM0QskqsQ7kNvwEY0phj&_nc_oc=AdkL2AdZNRONDtJu-cKDa2NxIU4-7Pc447GtKqeSt_ESh72UtBAlVi4KXMoO61r_iOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbPZ2cIP1QIQ8L41JOapIOl9YEZR995T22PeBMD3WOvA&oe=69AD7056"}, {"file_name": "migrated_image.png", "id": "213356049902245", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974612_528837984527128_1247214874480607232_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5bCLZHtHQkQ7kNvwFjQC7t&_nc_oc=AdmkutY8VH5wIY_I56qP8T6AejAKqfe_aqCsyEeT0w9zX53TiEHIF_BitZPea_o5lGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDgEunFmc1nYOepuhaTojLH9GQrm6pSP95DHDYiWxBQQ&oe=69AD7EA2"}]}, "id": "575138729775623", "locale": "en_US", "screenshots": [{"file_name": "AfG0Ae.png", "id": "857418388076484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982618_857418391409817_3759376868369760256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFpiH8YYapoQ7kNvwEt5ep3&_nc_oc=AdmFaAxGqT299XyuFAyFkRfxOT46dQArY97iEipQyDBSD-h6vFhp336HQBNLPOd9JFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0QDn8WPsjYIG3CK2H5U7HgFVHpWvK2wuhfYXBz8RLIQ&oe=69AD6E02"}, {"file_name": "PZhmIH.png", "id": "720675825411934", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974700_720675828745267_1048403612897640448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wQ68N5z6JsQ7kNvwEgMY5a&_nc_oc=Adkf7zSxpyeLZJjkawQ5ZCaVfEDqEMrd8d4CwMj4xKXcdIuxeI1dPAzIoVPMgj5jIXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLJo3aJPKgtlFTMvHtTYZVi7tcvP8gbuFdXt4wEFsbag&oe=69AD5C88"}, {"file_name": "migrated_image.png", "id": "161236408298881", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031310_2366020760337249_1318923584030113792_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66VBx3OBW6wQ7kNvwEh6v5c&_nc_oc=AdlwBHA1JBc35x4xXScjDjahczjuRtdLxiDsitHuA9vyYaaMNlt4Vqk-ovnH0yX0ImI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNHbMWX4dGakrh-RGcY-NNzH0yPhNTa2XPZxjohp3B5g&oe=69AD51A0"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btzLSYTm3T4Q7kNvwFLcgZl&_nc_oc=AdkThgaFMWfrhnPLqYYBeryD2Pt2qkR_s0FleZUs6O205OH3zVKO2mtBuHYqeW7G8vQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZnH90Bgb91rAz5i3QSNXsGPDkLRJ3Bt5UPcMLF_Y8mg&oe=69AD864A"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ1zrfr88nwQ7kNvwF1tKMu&_nc_oc=Adkg3Nr1HCH6za2ltoMjhCw7hOtU3hTl4cTle5e6QUsSjzH2wfEWduPUCquAv3rEdyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0bvIuEJjsJdT2jkmAHXTe4ylVjaO20appanQ77VXd5w&oe=69AD6653"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2cFM0QskqsQ7kNvwEY0phj&_nc_oc=AdkL2AdZNRONDtJu-cKDa2NxIU4-7Pc447GtKqeSt_ESh72UtBAlVi4KXMoO61r_iOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLWNxZLGgNu_bgt_fYsk8HrwFPZotq4K1g7rw67zb1Og&oe=69AD7056"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hawkeye Archer", "platform": "AND
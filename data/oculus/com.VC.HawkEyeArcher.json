b=1-7&_nc_sid=6e7a0a&_nc_ohc=syxbWYVZDVcQ7kNvwG8FA05&_nc_oc=Adr_fDXlVMU2q-ksh-eNp13XXNyCg4xhmjQuOed4G9mMJOTAU_G5rllhzmq9wnDoqaM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vjyXVuVSvscPXpoofU2B41FZSWFuzM4CsAPkgvcAa4g&oe=6A2C19E0"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcP7jf_88GcQ7kNvwFJWUK6&_nc_oc=AdpMRMF8o3RiNTSfzrGFUj9j644SQOtLyRm1WVh_ruhesIylQKy0ZP3zKUOE5qkDZYs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g8u0XfNxk33MuJ0dn-xVoGkYAYneROq-CYY8uikurrA&oe=6A2C164A"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa3MugWgFf0Q7kNvwFPL_yG&_nc_oc=AdqDoGIA0bYep3zot-eLLShP9T6z94_iX6tGb9yGQ8hFxHPQhA_UHz0C3YeAWWYOd9o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HJ0L061uePjrGVbM9RqT2x3c3v6gpT3ibdKphMUvboA&oe=6A2C2E93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BiYOUzAAsYQ7kNvwEALIHu&_nc_oc=Adr7UjK_PzLM9OR6-y3imn5BEzF7xYEvCEXJCGNP8F1IHPMkHY759Gg0yC2HSQ89nTc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u5RY8VQC8rx4N9PLlJb1Eh-XgYR3yUtPHvWSPa1_s6Q&oe=6A2C0056"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
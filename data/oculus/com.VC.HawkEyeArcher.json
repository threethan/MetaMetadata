E", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2cFM0QskqsQ7kNvwEHINgr&_nc_oc=AdkGgqHqbY8kt81ukZyUWcoo6Ucq69xL3I2937wNG6W7XarAFy120xPFiyghJzpxtOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxcDEiYwkn6S54IwAPxx_bROdUDRRznI6m2_Ps5dckPw&oe=69AC1ED6"}, {"file_name": "migrated_image.png", "id": "213356049902245", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974612_528837984527128_1247214874480607232_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTL7t3YshcAQ7kNvwE49lsc&_nc_oc=AdmbZ2MXaRroRakhkqqqFVlumsXSanEi5TxPxliVqdU0MHeikqNkuNxEAvnyAQsAgTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxbb2ok-tEtdxTYZdLVd8w-fC4f8d9KAtfXgGtlgUYKoQ&oe=69AC2D22"}]}, "id": "575138729775623", "locale": "en_US", "screenshots": [{"file_name": "AfG0Ae.png", "id": "857418388076484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982618_857418391409817_3759376868369760256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2Rqa0mUFI8Q7kNvwF1yUrO&_nc_oc=AdldGk8o0xDuWCeCJeh0PdQJlQwKXyDzMRYFXoePG_u0vmLKMzXcmTixabaV1XEvZ9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtiszuJDbJik0Ij5HLfIS4E8S7lKSrkuAfJaGBuo-Gdw&oe=69AC1C82"}, {"file_name": "PZhmIH.png", "id": "720675825411934", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974700_720675828745267_1048403612897640448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wQ68N5z6JsQ7kNvwFTE7Oj&_nc_oc=AdlBMz6KIG_hcZHn9dZJPIRTEq5jsVK-rrkQ0Uvt1NyzndocevO7qqu4Km5sI0IN_nA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyH6QjRCxBidG8ivm0KiGWD9cslTYrSdv-oj0u5PrljeA&oe=69AC0B08"}, {"file_name": "migrated_image.png", "id": "161236408298881", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031310_2366020760337249_1318923584030113792_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66VBx3OBW6wQ7kNvwE3uQjn&_nc_oc=AdnHgqyTVtX4Vp9RwJXWE1kvTjoTrT0x7h5sWAY4enT6Q8fkq-73UJcWuJNpdahQTbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxM25gnT3U6g6XwndC1wn04ZQpOxUd7aUWsjXCQKj2fqg&oe=69AC0020"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHUxneHZnokQ7kNvwFO2Afy&_nc_oc=AdnEQg_jqMtT1JHp34nIsuP5O9pxoqAfbHVmLaAPVyK4MilbBOMUiqLMWXQcAaImLmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzf5RdExsh9akSUct6lKkg9tyABuU-D0XPQw-q1k-5caA&oe=69AC34CA"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLMDNtYGfPoQ7kNvwGxhIFO&_nc_oc=Adk0dNlRUkOyywZDPG3htYpxrHTGKHkB4SatEV02g0i89x6mdquivN4hsLioOhCTrFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxNBWG7PfTyZ84CnMUwyKafNcPvmJotiaGqJhokNsSaw&oe=69AC14D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2cFM0QskqsQ7kNvwEHINgr&_nc_oc=AdkGgqHqbY8kt81ukZyUWcoo6Ucq69xL3I2937wNG6W7XarAFy120xPFiyghJzpxtOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2ZGwmHqLgFqsTKujcFr3kV036a7hsyw7H60wJtnrudw&oe=69AC1ED6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hawkeye Archer", "platform": "AND
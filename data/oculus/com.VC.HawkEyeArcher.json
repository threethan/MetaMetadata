b=1-7&_nc_sid=6e7a0a&_nc_ohc=P1s-pLzCJIAQ7kNvwEqbQu1&_nc_oc=AdqPlp1BO6iBuBUz-lkzY3bV2wDXFJ5bUVSX-4fCsZyhXa3CdyC5RAn7T5kcLOk0OYk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiSxwo3NnIzqjS6of57PbXDi3JvyitpqLIpzXp1E870Q&oe=6ABD1EE0"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T9H4ul-IpcQ7kNvwFyxoha&_nc_oc=Adpokh1_TPRQ4EoIIP2-0ooj1MhX9KDxm6mGOjFpFkA4gDBCNnNfFS0l0ky2Se5bPMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0rhHHihmkDBI0ycrznEjhS3dVmkmNQqd286Vigfkv3A&oe=6ABD1B4A"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so4Gy-f7LlIQ7kNvwH_yFbQ&_nc_oc=AdqBA872RTqYBylHcg7-97ZE2vkGOdsZcpvVhw9J0aR1C4xb5kEU1Ue7KNtUpyvm9dQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfiMfDlYYJCAGtsYX_atnXzBi9dSIyavyGgW24qBOWgA&oe=6ABD3393"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxDoNKQP2E8Q7kNvwFfnsE6&_nc_oc=Adp5-ZcFdyb97D8V9hkpt7oQe97M46DuUg7tjMpuHQfGHkKAeqJrf4c_FQIYzV8kacA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHT2Tj4aiGC9DiW0T9bMY5b_7MzgXm3Vu4hFOvZhKF9w&oe=6ABD0556"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
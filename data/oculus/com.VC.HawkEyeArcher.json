b=1-7&_nc_sid=6e7a0a&_nc_ohc=p90zqS5fUc8Q7kNvwFUARDN&_nc_oc=AdqreqQsO2-Z93Y-3fCoLkdRzP3LKNX6tQJCUlQsP4t1DLpBL_uKPEL39Zo3K47v3AU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43T1G7ZHMNU0TvKQZ9Ja1h31n2wfveiWVwdeIMyP9L5g&oe=69FB5260"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UTNXlILd10Q7kNvwEBBhFm&_nc_oc=Adp3tayqP9gM-2cUnCOHxnUkKmZnSx2AV-CplF9kDJR4mtp8nDtsSLiI9swOIlu6ssM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SgqdA6rEyST5tuMgZUP6xz3K17hIN43iJrdCaVDYfFg&oe=69FB4ECA"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-hCtle0W3cQ7kNvwGDjcBN&_nc_oc=AdoPJy3pWIbx6wtTsRqCF6RyBEikkkxRcoaC-ORlXrlbdFNNGtDaclMqF3I43KDbgXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-ZKF_ijsaJn-Ym7SdqwLOe9JBrjL6D902vIg1lG_b2A&oe=69FB2ED3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVYDAoS1fZ0Q7kNvwGq7fjw&_nc_oc=AdqMeYNMXArHN2Jd1QQGojZofBCX1jHd_yYhnHM0TEL7vXJD9F94E5LvNEzSyTFv8Mg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UgIzDJdEoS0T2t0RwwQDR1_JA4vb6zwvWlwFEzzZuPQ&oe=69FB38D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
gw4uTwDz8gtNy6kxR1_BtoKu3iEcVaQ&oe=6B0F1F08"}, {"file_name": "migrated_image.png", "id": "161236408298881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031310_2366020760337249_1318923584030113792_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUFGOP3hH0kQ7kNvwGSo4Dx&_nc_oc=AdpqoYIImaMVJdNpN5loOteBtlOK2GQTdnUqNcERzscm6y85Vl9PqjmvP0JFHEJemE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV3OWl9eYbb1B3OSAh8wjdTjFOXuUIGB-_kG0rJlBFNbA&oe=6B0F1420"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2kHw5DZBLMQ7kNvwEebcFP&_nc_oc=Adq97MFXM54S9KI0nRCh_Rljoypi--nDUhkJaNlvnUxuB1v_wJMIbKMGSAeDNYNj3Vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWh-lJYUxvFVsBxHPMSDbmfEc_AXokBy41IXYuSRTfSSw&oe=6B0F108A"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Nt9_Qj1dH4Q7kNvwE_EKBW&_nc_oc=AdrYBzzi_972JnZxNGdbTLLAgtsWZXNo-lEgr3_pKfg-A80zsm2xf9uehQiO2NxqEEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKfI221mwjaBWVfC3EZtM6rtwxUsEv439UGdH1BiZYmw&oe=6B0EF093"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlge
t=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teGWGmlg1q8Q7kNvwEFpeZw&_nc_oc=Adp6RL7lYTDBt5GDkKjDg4s0IvyfngNI7ngmQmADqY1hgeK1yw_BgHFnFJNGFf0zWVU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnxRIPnCZZol6wdOMBVuSZyscr7002nhg1JCFIKXjiGQ&oe=6A8D70A0"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRrxGNcQWuoQ7kNvwGXOuCF&_nc_oc=AdpNFfoB_SSozV9lU6qFTj5jSh9phDu9NnJyi_z5oLYCSi0EzutCuyYFM9kj__xufFU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGO-gLPNFx_xrUDMsn-IWRm79S0MIrRxx46L3GTra8SQ&oe=6A8D6D0A"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDlvpZRGW64Q7kNvwEa2Qzc&_nc_oc=AdpsVmVTe9UXjQD0DwBCK7i3ITgvxZ6uoGXIQRa6dZnTjoUMyZk2GCyhr3fU90m2rnk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkB9OWSPge10kpapMNVNEpr4WcIxk7WyNipnyJl6F7pg&oe=6A8D8553"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upKpERE7pMkQ7kNvwHh5iOE&_nc_oc=AdppoZccjxP32aSxr5NXvD7cMCLbcc5Ja3MvDUf0_qlj3NXjJ3x1FuzjSYhODlI8r10&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOssamdkngmcb8koF7C8yQBdKHfbmjE3G3LzYsmNx99g&oe=6A8D8F56"}, "is_concept": false, "is_test": false, "is_trial_offer_v
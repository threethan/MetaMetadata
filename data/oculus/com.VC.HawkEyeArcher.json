yxuSpuzAeMO7L24Epq6EAICS9sf3v6w&oe=6B030948"}, {"file_name": "migrated_image.png", "id": "161236408298881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031310_2366020760337249_1318923584030113792_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6Kk9HNlyrMQ7kNvwFvHC8B&_nc_oc=AdoDVf9visjVQ_P-4W8V92VuwViQhwed3woDyAGDSd5EVA7c7m7k5b44yL4I1tYx-qU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu5lGM9VroU83c99Fkqs_ZRcoefIQ-5dpdTLmkfwlYQQ&oe=6B0336A0"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OPABB2Z6YIQ7kNvwFSsTCy&_nc_oc=AdpGwxA6PAefhlXysPYM90j16hkQq1gnXyWr9IwS7zt-_EpSM8YCB-rCLIcgcV7ybbE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXL2pha1wSckTH9-pZ1j8ZGLsK7gL3hyTtCbwgU8QTUg&oe=6B03330A"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHOzcIYf3f8Q7kNvwEdPKAu&_nc_oc=Adr_AoWKumSYBzne2Yf7p21x1EMBmaSVFsEIMo8gQIXiuj07Fqm8dny0n7OqQPjC3WU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsd1YER7XX88I4Bh4ZIzHpvf49HdbPbE0ikQF1T5IGLA&oe=6B031313"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlge
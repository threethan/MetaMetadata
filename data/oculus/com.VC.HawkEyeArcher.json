b=1-7&_nc_sid=6e7a0a&_nc_ohc=yh8Zb-DQcY8Q7kNvwEk5_uD&_nc_oc=AdqAZyE2LCOSIUiPARk8ugat_2n11CuPAKYNJLmMvUhq_-HEKIGkBxPrZ4o5cNzwpX4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyMwvRboxzBRNX6Sls1v4KJOsgBzCizh6HEbQUbCbPQw&oe=6AD0E560"}, {"file_name": "migrated_image.png", "id": "660673801411016", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974709_1964522403605905_450488111676260352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVD68iaIfd0Q7kNvwFB8K8z&_nc_oc=Adp6rafQ8a3EQq_qooaPPxTKIG7LHm_x1JCpe6s1CZoUgWaPvDT-AGbAIRHZ0aroAZg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUyn7KFmBgJ8EBjoP9QX6h6HxNp2K7jocr6hZFO-cJ5A&oe=6AD0E1CA"}, {"file_name": "migrated_image.png", "id": "618924762297141", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974826_318983732084030_3460359909487411200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTg0JWbHIRoQ7kNvwF4IjlM&_nc_oc=AdpTTccoz7fuiuWCLzR71WrsFXM9T2CdrR3JNmtt2zwA9RQaY8m9sa8sx6yAgexKFhU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB3IboKIBRIIHsEwjXpzAZrgS9J30fpgdwKXjcWQTrxQ&oe=6AD0FA13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hawkeye Archer", "keywords": ["Archery", "Shooting", "Action", "RobinhoodHawkeye", "BowArrow"], "long_description": "What's New\nSummer theme added\n\t\nHawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery. A hyper-casual infinite FPS game with virtual gaming adventure that features stunning graphics, amazing animations in virtual reality in a 360\u00b0 world.\n\nA point and shoot experience, you must fire your arrows at the monsters before they get to you. With each wave of monsters, you must step-up your game to fight against stronger and bigger hordes of monsters. \n\nWithin our picturesque themes inspired by different seasons, we\u2019ve added everything to make a player fall out of reality for a while to enter a bright and fresh world of vibrant colors.\n\nSo, buckle up your quiver and get ready to fight an army of monsters for they come from every side. Compete for the highest score while you experience the freedom of movement.", "short_description": "Hawkeye Archer brings you the fast-paced visceral action of a first-person shooter and combines it with the immersive and tangible experience of virtual reality competitive archery."}]}, "developer_name": "Viitorcloud", "developer_privacy_policy_url": "https://viitorcloud.com/privacy-policy", "developer_terms_of_service_url": "https://viitorcloud.com/terms-of-use", "publisher_name": "Viitorcloud Technology", "support_website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "website_url": "https://viitorcloud.com/portfolio-howkeye-archer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "368843808413430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974733_896329507404322_7069686632173010944_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19xz3R5iHsMQ7kNvwFxODL_&_nc_oc=AdoQzAzWhEG_gRSfGgR2almgb4u9LjLJnJshwsJf-yS4z6Uivs8D8f7wbkIT6Ekh6AM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSgG20zZNClvMbtZUum-Lx6IEZtM2ndzgJF4JwFQ6MRA&oe=6AD10416"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
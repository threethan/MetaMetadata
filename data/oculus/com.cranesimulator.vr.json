=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqcZ7MKQPIMQ7kNvwH3NgKp&_nc_oc=AdrrUD-BuKXo0e36on8TELWTkx1n3oUZa1PamFnM3Mn9sc3i4aNBQmkHg82l_-RlEsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSmUrYrGJhO33b06nXr18HuwP6ZRTQ0seqHwZ9ngLvHg&oe=6AFC8541"}, {"file_name": "C2L3_Fast_20261023T003617151Z_t00006965_f0036_External.png", "id": "2508769379614167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_2508769382947500_7967043419221261473_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeocVj2jmjYQ7kNvwGATIdf&_nc_oc=Adr15DJqdU2IrWQB5x8l3yiZwaeaM8JsZ-86grsKgWdHLimHW_XI90t6MG6Axw8fNCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU98TchDk-JxlnQjlNn2e73HPYzC1wZKHXM_cDl9Girg&oe=6AFC61FC"}, {"file_name": "C2L4_Fast_20261023T004754984Z_t00015247_f0108_POV.png", "id": "1374209928252993", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_1374209931586326_8180166333368720676_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7xr8ZtG6WcQ7kNvwFWKlA4&_nc_oc=AdriVrvHRuEkesBoEOgaotIlEb4dUbg1Iv1KiHpKNryDeZKJc0tXEfM8Rw8m1vsHseY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCjMjg3WlJXkOxfIXo_p75m5cA_VqmO_PTWA16qPqMlA&oe=6AFC7E24"}, {"file_name": "15_C1L1_Loader_External_RubbleEngagement.png", "id": "1677005307151449", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604370996_1677005313818115_6099462908398313202_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk41JI34hSkQ7kNvwG7VKpD&_nc_oc=AdocMIjJNbQgkYqV9KVxpyhm9GH2tyr2tGwyIguT7VsYwNsTmQearvKAp3nfwv8s2c8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYTUsIBe-12EEenadRP3tq-CcN0Q0ZZJbhBhTkYUp65A&oe=6AFC92C5"}, {"file_name": "20261021T235709029Z_t00044644_f0100_External.png", "id": "1743642213410596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1743642216743929_5110866364743860483_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB9UQ6IrwWcQ7kNvwHvTww-&_nc_oc=AdpyYs7huVOQ59eEFBiZ64RJ3JudY43bov6yuRzSkiqhOpciSw1kQKQ7LQBEpomaKfk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTAzuJv-Lfv9F4LhPdpuEZFKvlwzFik81S00_ySHEdYA&oe=6AFC850C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WTB_universal_2560x1440.png", "id": "1111556471258848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1111556474592181_5547080004538756637_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgLqTZtY1UIQ7kNvwG_RNs0&_nc_oc=AdqaZN_9LCPgg6UO89Jv-zrsuedTUhT52spqJ3xnLubg0STrxUZFaYhPOqWkSKNX7n4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcvSJulnyfxi_d2mF7V6fcD3hfzwimBzzQHiVxbGSoZA&oe=6AFC7D87"}, "display_name": "Wreck the Block!", "keywords": ["Demolition", "Destruction", "Crane", "Explosives", "Physics"], "long_description": "Ever wanted to take a wrecking ball to a building? Or bring down an entire tower with a carefully planned demolition?\n\nWreck the Block! puts you in control in a colorful VR demolition game where smashing buildings is only half the fun.\n\nTake the operator's seat in a massive crane, build momentum with the wrecking ball, and send bricks flying. You'll tackle demolition jobs that test timing, accuracy, and control. When needed, hop into a front-end loader and clear the rubble.\n\nIf explosives are more your style, take a different approach. Place charges, connect detonation cord, set up your firing sequence, and stand back to see how your plan unfolds. There's something satisfying about watching a building come down exactly the way you intended.\n\nNot every job is about destroying everything in sight. Some require a careful touch, while others reward you for making as much of a mess as possible. Earn stars, improve your scores, and see how you stack up against other players on the leaderboards.\n\nWhether you prefer heavy machinery or controlled demolition, there's plenty to wreck.\n\nWreck the Block! \u2014 The demolition is in your hands.\n\nMusic credits:\nMusic: 'Undefeated' by Hey Pluto! on #Uppbeat https://uppbeat.io/c/hey-pluto\nMusic: 'Nod Your Head' by Hey Pluto! on #Uppbeat https://uppbeat.io/c/hey-pluto\nMusic: 'Daiquiris' by Hey Pluto! on #Uppbeat https://uppbeat.io/c/hey-pluto", "short_description": "Take control of the demolition in Wreck the Block! Swing a massive wrecking ball, operate heavy machinery, and orchestrate spectacular building implosions. Master challenging demolition jobs, unleash destruction, and chase high scores in a colorful, action-packed VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wreck-the-block.karatejeans.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "WinterPeg", "support_website_url": null, "website_url": "https://wreck-the-block.karatejeans.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1397402133456885"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/613094043_1457593782928757_4017587998180378777_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_s
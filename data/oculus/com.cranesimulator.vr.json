489479_5905540346595131215_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU8NhUN43uEQ7kNvwG3kF1B&_nc_oc=Adpo9rSD1mSbWI2OOv1iGpJ_Pkh9e2PdrAe9IuaPT37cez9jpva7bu2YIzA-r2HaXFs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZRgx_LZYurGF-Mqj5SRunwhYfROxz59Q-sVaSkVh-Mw&oe=6AFC6926"}, {"file_name": "03-charges-cord.png", "id": "886477504551857", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/793139181_886477507885190_705817149470452378_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYLZFVZXrSUQ7kNvwH5B6oL&_nc_oc=AdrDVGW1juxWbi3tXGjUwqaJ--W9pJGjX5Fk-VakzflV2zrnmTukRKEFjhzXUW6ERKM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThEzcuHcgVBVBnmzDrmi7z0LmEZSlbScJY-rNB42YyTQ&oe=6AFC9433"}, {"file_name": "04-controlled-collapse.png", "id": "1440090261329327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_1440090264662660_7320731919104783770_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE7-THUTZOMQ7kNvwGXtxKp&_nc_oc=AdqkgcU3in70RZxiu0kcFLGhdvrYuEkFb7P-von0Jla-XRFrVCy8qsbzYbDAGjnUDG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa5qY56XJGYBRNjZMVVyLXIIrozNHwL2V0zPSgLUoXWA&oe=6AFC6BF4"}, {"file_name": "05-tower-cinematic.png", "id": "1083332631234686", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1083332634568019_3803580550521870640_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr2h50FdUScQ7kNvwFXpsRt&_nc_oc=AdoXckEhTKjitzYUeF5YiJx52PVLlngQci-MddrcWgvIP_aW-M5klMccSMCNgLph0cs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAKb6vGRf3xIfHLhZYqB25TB1T1u326mKaF2GkJTLolA&oe=6AFC6362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WTB_universal_2560x1440.png", "id": "1111556471258848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1111556474592181_5547080004538756637_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgLqTZtY1UIQ7kNvwG_RNs0&_nc_oc=AdqaZN_9LCPgg6UO89Jv-zrsuedTUhT52spqJ3xnLubg0STrxUZFaYhPOqWkSKNX7n4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcvSJulnyfxi_d2mF7V6fcD3hfzwimBzzQHiVxbGSoZA&oe=6AFC7D87"}, "display_name": "Wreck the Block!", "keywords": ["Demolition", "Destruction", "Crane", "Explosives", "Physics"], "long_description": "Ever wanted to take a wrecking ball to a building? Or bring down an entire tower with a carefully planned demolition?\n\nWreck the Block! puts you in control in a colorful VR demolition game where smashing buildings is only half the fun.\n\nTake the operator's seat in a massive crane, build momentum with the wrecking ball, and send bricks flying. You'll tackle demolition jobs that test timing, accuracy, and control. When needed, hop into a front-end loader and clear the rubble.\n\nIf explosives are more your style, take a different approach. Place charges, connect detonation cord, set up your firing sequence, and stand back to see how your plan unfolds. There's something satisfying about watching a building come down exactly the way you intended.\n\nNot every job is about destroying everything in sight. Some require a careful touch, while others reward you for making as much of a mess as possible. Earn stars, improve your scores, and see how you stack up against other players on the leaderboards.\n\nWhether you prefer heavy machinery or controlled demolition, there's plenty to wreck.\n\nWreck the Block! \u2014 The demolition is in your hands.\n\nMusic credits:\nMusic: 'Undefeated' by Hey Pluto! on #Uppbeat https://uppbeat.io/c/hey-pluto\nMusic: 'Nod Your Head' by Hey Pluto! on #Uppbeat https://uppbeat.io/c/hey-pluto\nMusic: 'Daiquiris' by Hey Pluto! on #Uppbeat https://uppbeat.io/c/hey-pluto", "short_description": "Take control of the demolition in Wreck the Block! Swing a massive wrecking ball, operate heavy machinery, and orchestrate spectacular building implosions. Master challenging demolition jobs, unleash destruction, and chase high scores in a colorful, action-packed VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wreck-the-block.karatejeans.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "WinterPeg", "support_website_url": null, "website_url": "https://wreck-the-block.karatejeans.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1342290508968048"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2355671064973001"}]}, "baseline_offer": {"id": "2355671064973001"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792093860, "status": "PUBLISHED", "id": "2355671064973001"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1378093328721099", "version": "1.0.0"}, "id": "1351181191406148", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1342290502301382", "is_concept": false, "latest_released_binary": {"__typename": "Android
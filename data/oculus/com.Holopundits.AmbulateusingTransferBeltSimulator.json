392293940743_1765071940836830125_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuQeAajeczcQ7kNvwF_14ED&_nc_oc=Adoo1UFI8awRAKBCsKNfDKP2oO82p3NNiD8dwX5bSVdkoDD8SpAmeguXdRoxOx_jTM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFZYbairTGaQKktFfUFE4tLchPRldGXP8x1TWtt3FtRg&oe=6AFB435B"}, {"file_name": "Screenshot_Ambulating_belt_05.png", "id": "1508972156392410", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982656_1508972159725743_344779921690540713_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2J4_SyVr-gsQ7kNvwHGUbci&_nc_oc=AdqpcJVep183cSF5xuo0IOx4ZoZ34YH-LnXhHQhxFZ98JM7vdSUW1HgZeDXcavSsAGM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPnKSHru0fRpCWiMaLpDi_Pvlq5Dr0uB6EutAf8QnlFQ&oe=6AFB3CC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "522645180123106", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569445_522645183456439_8914387727413741660_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYWuIplUVZkQ7kNvwERPatb&_nc_oc=AdrqOl1tTBzhECGQF2KYEqq0cpOvKs20qFEj3laFc8T26AiFeiO_LW5pTtd7f998rfM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5tI5Uw3vNNJhJ_YyA34G5gIW3HDFutl9LvdIlqG9ZOQ&oe=6AFB318F"}, "display_name": "Ambulate using Transfer Belt Simulator", "keywords": ["CNA", "nurse", "nursing", "ambulate", "training"], "long_description": "In this VR simulation, learners will master the process of assisting patients to ambulate using a transfer belt. The tutorial covers preparation, communication, application of the transfer belt, and the ambulation process itself. By the end of this tutorial, participants will be able to: \n- Remember the necessary steps and safety protocols for using a transfer belt. \n- Understand the importance of proper transfer techniques in patient safety. \n- Apply the correct method to secure the transfer belt and assist patients in ambulation. \n- Analyze the patient's condition and environment to adjust the approach as needed. \n- Evaluate their technique to ensure it adheres to best practices and safety standards. \n- Create a safe and supportive environment for patients during ambulation using a transfer belt. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with proper care efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn the essential skill of safely assisting patients to ambulate using a transfer belt."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7956572267762275"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2988700777978292"}, {"status": "PUBLISHED", "id": "477867771836880"}]}, "baseline_offer": {"id": "2988700777978292"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749742500, "status": "PUBLISHED", "id": "2988700777978292"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"
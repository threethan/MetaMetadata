BwnRng&oe=6A1D8F1B"}, {"file_name": "Screenshot_Ambulating_belt_05.png", "id": "1508972156392410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982656_1508972159725743_344779921690540713_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=909l_om2a90Q7kNvwHOB-aZ&_nc_oc=AdrP1h3dAupbrQXdsuu5nurXKr2sZ7KUgzL0U4dT7tGQsI18_otqC3oLwkKHCxVAzUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cUo6pDqBd2BKhM2dliJT-eDOrAPilIOm6qY3JK07M6g&oe=6A1D8886"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "522645180123106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569445_522645183456439_8914387727413741660_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3Z2OIxsdIwQ7kNvwHAPX32&_nc_oc=AdqKPNWaZ_KJ_yonsOVeT9YL2aN58Vqjm1NVDa5s8Z0cehYaO74cEjlfMk_FhxrjNww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e7u_iPDhNBN16GWINH2LEollJyncSP1SAFyFsTBUfEA&oe=6A1D7D4F"}, "display_name": "Ambulate using Transfer Belt Simulator", "keywords": ["CNA", "nurse", "nursing", "ambulate", "training"], "long_description": "In this VR simulation, learners will master the process of assisting patients to ambulate using a transfer belt. The tutorial covers preparation, communication, application of the transfer belt, and the ambulation process itself. By the end of this tutorial, participants will be able to: \n- Remember the necessary steps and safety protocols for using a transfer belt. \n- Understand the importance of proper transfer techniques in patient safety. \n- Apply the correct method to secure the transfer belt and assist patients in ambulation. \n- Analyze the patient's condition and environment to adjust the approach as needed. \n- Evaluate their technique to ensure it adheres to best practices and safety standards. \n- Create a safe and supportive environment for patients during ambulation using a transfer belt. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with proper care efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn the essential skill of safely assisting patients to ambulate using a transfer belt."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7956572267762275"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23935484016111178", "version": "2.0"}, "id": "908645611100562", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7956572257762276", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "23935484016111178"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "908645611100562"}]}, "change_log
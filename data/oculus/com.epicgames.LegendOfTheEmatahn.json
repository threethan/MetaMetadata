-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-B16wRtvdiuaAwjwW21wgp0i_HNQF3v-7TF-KyEpBUw&oe=6A1B0DA6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4B_HSFo-UAQ7kNvwF4wfxw&_nc_oc=Ado_m0QGU-QMUIs4ffh_fsy63rlTFdGcjxopT_j1Gux3zGJWvhrvfvV58B7AUPlvFiE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QAbTV5iudynK5enmjh5tIa8THseOWkLvwh0JlreMjNQ&oe=6A1AE07D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8QdG8aLZ-AQ7kNvwGIVVe1&_nc_oc=AdphXgOwbfiKxVD7sUjeDfeNACvGsaJSKrkflV5mDS6QShq51hZuhSiRei-XlBT1XGg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nNnwDI_8PcAjgiyRsVL0K9U-n7XaeLmag6DJbhUpiUA&oe=6A1AE812"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7PZsa2X9Z6fBWPz3EUfim0Rkf1P_E3ZKpbwTnw99N2Q&oe=69CFAFE6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9O27om6D_oQ7kNvwGJo4-8&_nc_oc=AdqcmrC0W7B-nCzefvefNLSB8j8zZ3_ygT98nwOifwclwljJh-XaT2s2UKfDoDf9ucw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8Hgci4i6Rnq-_t3JlRr-3AyL3us8O2LpdwK1rT5uNpw&oe=69CFBAFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wgYv66j8nMQ7kNvwFhZpoO&_nc_oc=AdrRPVKT276mKhp_q1XH7eBCgAPOqhLcvcgZtALt5F1T8xa_Tbc7JfqlzzJ9uUVhvTE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyddfBGs7iFgT5cE1YGDP1DtUSq8M3UG7xgMFV01zhTlA&oe=69CFC292"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
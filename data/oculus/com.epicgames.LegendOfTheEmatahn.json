-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuP4VO_I-SbgkY6qYZ84uqDVqCPoIXQGKIZ9zir1IIFQ&oe=6ACE59A6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrHy8YYC-G4Q7kNvwHvjoTQ&_nc_oc=AdrX465x5rxuUtPrErV-mrS_pv6k589QppUM-CpKi_eNY7bRCwiq_3S1NGqbG-U1Q1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHAwrEGXvUWTN7GBRZVHtvq3Lc86_i3gW103HYBKAjIg&oe=6ACE64BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg3f6Lgwo-MQ7kNvwHQIMuf&_nc_oc=AdoNyxb5fhJqJuhh8Bv2DY8UVZUl7ozVSD-vMvcKoYAO0zHcmCWdlE7Z2EIWX1bKIzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKjt4rgwB2C_KA1EJJKMh7t7uZnc2ZoS0pJHOnsZB-rg&oe=6ACE3412"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
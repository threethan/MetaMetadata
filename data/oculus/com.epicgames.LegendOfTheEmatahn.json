-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2q0T7YLtgYnVAjBANrct0oPYcMTxLXdicCbYZPaGeqA&oe=6A86F066"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNlr48Wh1nwQ7kNvwGEG9yk&_nc_oc=Ado8_nyVEmVeMs9bkTn9XAJcPbNFo_A0zK8Kxz8vAWfrklFUEiqHBsRZZBIOVrgcBCw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI2p70GjIFY4wV4AGa3LnGKtfwnmR6BKprn2D-k27CCg&oe=6A86FB7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdQEKJ16CGoQ7kNvwE9vZBj&_nc_oc=AdpRQKWgBiFQd43tv2RGeIjr57_mYRunTuN2WW4JiRr-WYSY79JEBLFZwyUuK06oue0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM6cHf7TUbOR_iu-CQDX5TU6EtOiSkYfP6b9PP3cPP7A&oe=6A870312"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
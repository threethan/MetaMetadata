-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32SX3xzGrPM3ifGGXXFYMqZVOQWddDpQNPC6HNTXtmWw&oe=69D3A466"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ke-kjY6CPwQ7kNvwFcKvsk&_nc_oc=Adp4va4nJoo6SN8InywoQiJbx8_Bdphq07XDLCRU5mEAnrzjuRYzw0-ArrLkZg_bepk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pxZPkNeW9tRfRXFj7O_rSkXJUZ9s_OOy4_PSrDSS2OA&oe=69D3AF7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7IYJKiHGSsQ7kNvwFeiUS_&_nc_oc=AdoQsg9IgfAZYcTaR5fgvP5kmcpZ3FihUXZ291m_rf0y1y_thF4UAqqju5v2rwt4opk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w1Y-N-9ib-If23BHCAN926RtDzwjQBPHDq6qUQGFnHA&oe=69D3B712"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
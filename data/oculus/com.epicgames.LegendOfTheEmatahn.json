-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0nlbZ3SpECMg8KAIlu23mKhAyRe4bZKsA3Bf1bjxAhw&oe=69C3D266"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_858Y8hSXyMQ7kNvwGwhmPQ&_nc_oc=AdoMYxN-5GFUXn6Jkb04-9n8Gd81uTqIOECJ4aA-lsxp_54JgUcVrH5oKztJdtM4HaI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxujfBoBv3EoziUDplBbwjCCdQiDfuvJWaqJ4Mrk-u_PQ&oe=69C3DD7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWaFTch02yQQ7kNvwFP98Bh&_nc_oc=AdpXZP_V1OILkbRLGM9Gl9x0eO5iIPlRybLLjeqYFM0wvRoERa2pj6EYwxdTdw3aod4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPrilJQdBTvnXw7r9QcLqJVNDSXrrVC_Qu70lMuRhlSQ&oe=69C3E512"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHAQ57H-zaL8qV-P8VfTMhHmMrjDJgALCA3L-KjZfsXg&oe=6A620666"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tE7qs4kUtiIQ7kNvwFBXUQi&_nc_oc=AdqUeFFRAnRyus_ziXIweqscYC4D6UPa896U5Qk2_q6YxR8Xcr4nM8ZUq6kGrv8rTcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgNAVAk5cG0pUUfr2VWzmZOuq26GT_7TV2B2nyHFR54Q&oe=6A62117D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl-eOPV3oCwQ7kNvwGanBtw&_nc_oc=AdomR4aSg3FWwva8bD-HXJ_iWpCyby3EnTZ44Mop8TNTrNrcRxikHGvsCgFEPGTQyPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB67Lmh33NtfVQCfiByo2COmv4KKFCfWOIYlgcvcJre4A&oe=6A621912"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
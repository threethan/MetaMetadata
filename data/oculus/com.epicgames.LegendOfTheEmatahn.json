-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8l_SATOH5OnKke8T4AD1NF8JjTC4w49pymcUSN94_YA&oe=6A81AA66"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ8lmzxeBVkQ7kNvwGRn_VS&_nc_oc=AdrvCiV6iWfPrZ_PAxzCD9nWIcpPV_A71jPBOO0sg48BDwczzSUozuxr97uzkx6l2a8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnGTSlMcjiTA_7-YRLd_c6dp1Fht0qdRyS0wjkqfz_ug&oe=6A81B57D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFRVxzyxu3QQ7kNvwEVf8go&_nc_oc=Ado6UvtER-cVESo9m7bvh23Ptul-j-i8lm7_jGjqecfEqhs-ZE53naVpMOEvDqr5ro4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyPGTAF2MkwiZfBSfB7dMe-45048IdHe9-NNIEEplqFw&oe=6A81BD12"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
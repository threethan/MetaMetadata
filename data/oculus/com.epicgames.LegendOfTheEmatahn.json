oc=Adn2hCPN9PGhqbUZ95CU9qf1sRqIO4r5zAsLWf2hvCeuit5xsCH8zKNtyIB_r7oL_wE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuQu8ZQmjaXpybOsbqRthGJoGGDIYNEY9pr9N-T0brELQ&oe=69A42CBC"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTbGNS-kXBAQ7kNvwEEyLFs&_nc_oc=AdlBxq98-XegDBh5g1EiTerImegLntF4vnOkOwZauolk0MApBQnKj4awubYHiEmhWC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftLtLiA3RDE3mAlqr7S8v4zXvu4WQroEEEduPktcNRwSQ&oe=69A41ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTyTqfs8VWAQ7kNvwF7IXl_&_nc_oc=AdlB3frnBMy8qNBY_sAO3de0zb6uYzJAuPd4sufr6owNNuXtvq7eA_pqt3nI4beXy1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvssnqM7JeozTyse1ufIkoOCfVXro7A_KiCY7SXVvaGKA&oe=69A4430B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!",
-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztNJCp7AIXf8Xr_AO6jgf4p7s8dYljdiliiFFk9EiK_A&oe=69CBBB66"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idYigGgRJu4Q7kNvwHDyyH3&_nc_oc=Adr8nQvMYajpe6qnaBHIZfwZQNZaAGjQEPu4N9F0L193GBcsL-JkkruaB5owbFEKhwc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzS1n7zgZCWfnAoPJ61Cyn76Lbu3Hlg3eTXZpGCIGCCiQ&oe=69CBC67D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsoWGWWGhbUQ7kNvwEg4hGw&_nc_oc=AdqidXHrlgmFappvqrHRme1pFdCBh107P_LMankm39HNcwcEv1BgKqJJFFhfQjBXqnE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4RyTY_30Q9wDWxdbldwEcWx-MDd3ZWKn_BTScW8llfA&oe=69CBCE12"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxIKyti_HYvvYCNdKs4QqY1iyfvJt14w4bfiGeEQqZuQ&oe=6A844D66"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ8lmzxeBVkQ7kNvwFoezKe&_nc_oc=AdoG9NWT3Ft5RHoDrBJhnNeKdxGcQHo8WXPE2oBBcX1PhlagztAuuBpe3_BL9c1MoLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcngi2Iie_wka7ZrDWtUWV53WwwpHJ3dBgtU7EsNC8yA&oe=6A84587D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPGqqnSzel0Q7kNvwHhL-qI&_nc_oc=AdpNnfD5rf0Z0BvFsKyLbqbLCLLaSU8ZdlBY-Py-YJw9eCdvjXHlE2Fpk4cDS5YpO6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNDYwCDm6iGm4xlm_yXknliIr_YqkngzKbPJ8qc9RGLg&oe=6A846012"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
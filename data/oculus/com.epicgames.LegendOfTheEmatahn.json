-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkvlTQR6xVV8qfLGuCWYAg14Va6Hr7_J4CC1FXjSIEUw&oe=6ABA5AE6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVTtFNzrb9AQ7kNvwGj2dco&_nc_oc=AdpHhtyp9GyKMpEabn2vUg8LFdRRGc4HOzPuE1ZHcx_vPgcyhZF0g-cJ51Qukq_yMmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcyzX5f5LrvmVmCYNFJHAglYcnvXcfK4wZ4tPG_TQDFg&oe=6ABA65FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-JCWY3iK1YQ7kNvwEV6Jg-&_nc_oc=AdrCnfva_8dZiwA6NvJdtOn0wURjp_MK9X0-pWiANTD1cYHQfK9cBF3Oh1FvjWg9zUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_3CsBMfI8nBUHQ6Z1iZZjDIYCeZh0u8JmAfxZxTsTtA&oe=6ABA6D92"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsF88Ow_l-wghkKXsw1msnAY8UZlsiNfDIn1ilsTRjhA&oe=6ACD0826"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrHy8YYC-G4Q7kNvwE8wVcl&_nc_oc=AdrzUd33_WmKzt23o19jCeyqQPU8zw23Lm5SFZm6BkhLUInv7kBUdZqJz9jCMLKhJEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSBOLe0SeRCqMmCyWMtXHu22YMlmIrX9bs_FEnfWkY-Q&oe=6ACD133D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUqYD9WNw6kQ7kNvwFVjuRx&_nc_oc=AdonwVAIbEi2tqc1Qo_PJiv53uAc6bp6bB4O7JzrATlisSxynk5Xnh4gAXqjuE913Y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9Yw-anVk9bAWDl9ruKFiwY6XO1npNj4A9orwSZCMJJQ&oe=6ACCE292"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
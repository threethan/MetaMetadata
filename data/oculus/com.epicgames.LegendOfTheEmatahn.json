-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiK-2Z-OUmjb_cEi5qTwumm1QoXlpXR15tp9I8VbOykg&oe=6AF889A6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc6_x6h6Cd0Q7kNvwFstIrG&_nc_oc=AdqB-nXG7AtqCNA0ClsugWhD5LmCd1ZR12r-qRzIzhMY6-2X0iIr0S4Pwadmfk3lSJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ42oqAnHOI4MBu4lgZgyaSn-ZYxIEoDea6yeIFuDRv6Q&oe=6AF894BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE7b92lgcMoQ7kNvwHM8Ncs&_nc_oc=AdrCQ6nmpmuJXPXpdFUEeur9BkUcEbwZlF_Sjg-HIweHh9Yqff4XFHqVgBm-cJ8pxss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0WOMwiSss6qzEbKxyG9_UN4phrUX2-h35gra4ddTq_g&oe=6AF89C52"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
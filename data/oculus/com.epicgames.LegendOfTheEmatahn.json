-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h4pZnfoiuYrs6HLaNxXeeAH-HW281z-hBuGHApCLVCQ&oe=6A2C3126"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vrv1VQuuvHoQ7kNvwFyKAOS&_nc_oc=AdrsmH7bI0Jm9-725YsrJmED4s3bICPjSv3e9zHiEq_oEBuEwKVFqQipvxSljRSkgP0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R_2OHBIVzDmK1fYgDyisxb-0IqY2L1l5K1NAE4mgnpQ&oe=6A2C03FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0izqaTATdEQ7kNvwGbPkOn&_nc_oc=Adqqzo2fdAUg0oDbNkuGXtss0sA4J_VyGJ1D9m3H5hkSUB8vdYjfNNs1fNI2C93Wgtk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kzWEMhrg0Bhzd6PVJ1lXbAqQZhYs5C9_1nJtYMe9bZw&oe=6A2C0B92"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
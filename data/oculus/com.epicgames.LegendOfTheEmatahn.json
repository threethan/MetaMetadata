-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zDyRulLTboSidWZBPm-UxyvRchfeNaWsYp9Zne5eTLg&oe=6A3025A6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFwPaxMwl38Q7kNvwEct94s&_nc_oc=Adr2zDoksiqG6JG3NI5ZIkfvdm5yfs1_7seEDymWOgduCwLta_dk_JwsdNKfNYenwyY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9bTjRYecpbBvZ6_i_DCjHwjLIotOI1LZvre3_ev6rAg&oe=6A2FF87D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqBsQGQ6xI0Q7kNvwHnEy0U&_nc_oc=AdrYErXJrglCi06MrzkINhbPw9LRDT7KTo8EnUtZLB0VT5YqoyaJthdnP6UyeHvZKh4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_wH4QFJBO1mhvz-Lb-axDnUf26a40OqyOq-kAsvkrGw&oe=6A300012"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
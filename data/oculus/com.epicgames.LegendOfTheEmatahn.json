-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lrwSfui2foVleTnVPsenjU-dhN3_VC06mfY25jCK0GA&oe=6A2ADFA6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vrv1VQuuvHoQ7kNvwGUuQVa&_nc_oc=Adod-Km4SrqTMuJlVxi_cVGRhGpDVeAHJtxGWpOOeKqTcHPvLs1kI7PNGP-XrLjljNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_XrQ-tY4VU1f7E8-vn1S1S83XYOgPH_oV9HGJ9AJjMg&oe=6A2AB27D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3N0N-8DpbYQ7kNvwFc9JGY&_nc_oc=AdrftM0poRIAzYjs6gHY3gAgdvm53qQ354yt0RD1U5BJdAjrg0fxj_jmiWjfhiGWHuI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-kWQ26DmWYdYj4h1vFOyXOuW9gHcUoRzT_aYd1bNq_g&oe=6A2ABA12"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YivOL3R2uOhiRzkbxEjkaTOg0x5JBdzjP6SgxhSlMIQ&oe=69EA0DE6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyoFVy5TT0cQ7kNvwHpQJwS&_nc_oc=AdplOcveGQdKxbuGwUkpUtz_z1X3x1ulh_Wz3GEzL3ZAei7HtmQhkVgv9EwZJxhHQYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jpIfUoNhJhgkJgeHVwd5XurMRJZZvz4KPqJNnPvJVag&oe=69EA18FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqhErCKZ2oYQ7kNvwGZh0Iz&_nc_oc=Adp35xc-IIANuOeaXYXlYpPXT2sXEourN6dce7wID2oWCHojzZsSU1cza2zu3Vy-XTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LjPuKxDnJBUxH99mzacp1e4Fj0_iGmMWDNhi1WhKpWg&oe=69EA2092"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
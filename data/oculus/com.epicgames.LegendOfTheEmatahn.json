905_646708517771920_8670401618957788474_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjivf0RI37sQ7kNvwGRBPMt&_nc_oc=AdqLrM7pOCUx2jwpf9d8FLj5WM1FT_6KMLoAgVCBY_QAhI_3lRo-N4ig0QzjdPjIQrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAVIPskd__6AcmpOut0A6ORLxHdkadoHzAmJakyZJA8A&oe=6AA29E3C"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDkZRhgJH_0Q7kNvwEJaK3k&_nc_oc=Adr14VCk8OHbHkYdQeBkc6HzuV8YrKfBHqcQo4GrSFrRJLyLuGKgPLqviUkX_dgCgjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0Vda9CMle-VyT75iNv41L50i9i0p9c-ilwRinqGwNWQ&oe=6AA2C88F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoIlgFfqWJUQ7kNvwGKrGXA&_nc_oc=Adp-BZ9llhxrN51btZVB7pG1KrtEHee4V1nRwv_d22frLXNy6qE4NgLfR-GQ3uOrH8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD8xOzitxSGVbxR1UAEuUFEyEf75iAhWkfiTUsKD43Pw&oe=6AA2B48B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://levityinteractive.com/privacy", "developer_terms_of_service_url": "https://levityinteractive.com/eula", "publisher_name": "Levity Interactive LLC", "support_website_url": null, "website_url": "https://levityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31195916846720764"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_1974945496318483_2060217974023383223_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DvjBG0j2Y4Q7kNvwGtZPhR&_nc_oc=AdpJw68jCpV2O4hJh6PWLZKoy6pU8SagyQRUhQ8ax2BQ7ffz_dKZLVKZSIsLSnJmEVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6USq1YYs0rhgMYcshdF1_gVZvJnTzjuO4KXH8hB2CdA&oe=6AA
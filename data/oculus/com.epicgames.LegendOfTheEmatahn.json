oc=AdmGJwfBOrzX2x4kSc2TowxjlbXCF8z8726TZJBhAZ3m-GU9ewB1Ii6vi4UkkjzbyC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afub5__daoZ8vwou3hwJJDH9VJ95DXcSKmnRakmABay_RA&oe=699D953C"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUH10W_x0aQQ7kNvwHjAGZ1&_nc_oc=AdkXtqxVt6cf-t2xMyylf9iSS9-12wMUmgogxdS1lZti99mpoiUEH-KxfI7honhwmWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0saEVas7ZWTFiOu3j0FXPSGULcuIlZMntzxBZ8hZyYw&oe=699D874F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjXsRcfSwLAQ7kNvwF2YCwO&_nc_oc=Adm8FTKCPH_OmIeP-wxH6-CnflbgacsZxV1zbZP6wncFtvvlQ6ZI8gW4C5-r06UyZSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0QNCxNhdsqKuOdx-zER9eKOMkTfwrR9Sq3Zjo7Ux5RQ&oe=699DAB8B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!",
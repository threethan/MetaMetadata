-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3jsEfNpNemGAWwZNrlFZVRTV13-zr0jZr0dPcmf-_-A&oe=6A6C9266"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bl0c5XB2-cEQ7kNvwERGyBR&_nc_oc=Adq_qGWcjDoAGURKnH2Zp_LqCP74jTYZr_RF5GSRsaeoANPGOnUBbIWMgZe5Qekg5nA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkdhZfC2ViBeqGjgGEMsvE_K3LCHCd4TWStDEmBvY-6Q&oe=6A6C9D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXuafw6ifOMQ7kNvwG9hPOA&_nc_oc=AdpI8xtcZWlG4ISIvOS_Uw8tCVwlW3w9284WX63e2thgPms5sxq4GHzL4ZtyKvAOT-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2e60RApUga-rribUE9rwoapDWQhvHCg5lUreHjK1taA&oe=6A6CA512"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
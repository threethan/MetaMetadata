oc=Adn947EpP09SYu_zw_sFuh8MW_AVd8pvKucQmogHllJFQh_PyHCTDJqOKc5W-GocVo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvGoIXcutBki4RAh_mfea79lB5lI1gtSLAo2IOIDsvvEg&oe=699EE6BC"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwt6yau84CkQ7kNvwEq2TH7&_nc_oc=AdkWkqpMfJDKg3IStX0MOLrqAHZ9Zk1lDU1ZSyzcv3Lye0SwfdPSNEY6BbNy9NeV3_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftxbK-jx72iZjxgu3oI5DqlugeFhYGc0QyK1cekhp2jKA&oe=699ED8CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjXsRcfSwLAQ7kNvwFg7-Mn&_nc_oc=Adka61kfjK9VULcEBNSs-gFEWtQ4nJQ_ckTt40gecLepw18POZIM211rRd3dXx1Qej0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuOOFQ-tJzTQzpQJRK9bmGR8PVeIm3Xq26fSvCC5-6sAw&oe=699EFD0B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!",
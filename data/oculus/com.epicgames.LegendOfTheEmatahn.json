-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpMDyeV17-mDfbOQMhDoN2B39A55u-hDcJH_goUjaoEA&oe=6AABDA66"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuvlG0wzbCQQ7kNvwE_-npO&_nc_oc=AdrqZRDf7sRQlG3h0H33_zovkM-GPViewGACiTPSdW7vH7XrH-DVl4_mqUXN0sM4KMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSBZPK4uNjDAwt-ag9drbfXq4E4qXVNulkk-IV1e4whA&oe=6AABE57D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZR8J53uwEwQ7kNvwFweyPl&_nc_oc=Adq_VCX2HP5TmWaj31t8Qxik9XE7O3EgdoxMoH0jl64S9yCBIoi1IkGysNmi81xqoT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj7pEHtJ7xfbzqqtIyfGEepuEHvzvRiKw6pj96VHsBkA&oe=6AABED12"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aDNvsn7lj_c9z5YIkg5uubYVNXtnVbxjy9lAyXiUgxQ&oe=69E4C7E6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYZ7IC2FWVwQ7kNvwGXXZ-w&_nc_oc=Ado1nWAOsA63qJYH4DBarnqP_ksHALu7-mQ71lHy1fW4eKKHyljEl6p9nV-q7Atap2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yCUZGbiIbzckBAlWaKiIN3XTwUYKXlGToX-dnTjkUMQ&oe=69E4D2FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8SGRR5H-0wQ7kNvwH9oj_F&_nc_oc=AdpVB2vsMuU854xRqysSy1hMhUpQ2rhZ0vVoEYFo9BZlJhO7_vpd4vElSnDN-uqAPXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TtFSM2-WbAG8rrcttahwOaRvbhfYjhFHJ92tejNUIFg&oe=69E4DA92"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
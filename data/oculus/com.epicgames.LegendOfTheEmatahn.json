-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXqoPM3Gc1-46b866xuggAnJao2u5rwdPEeHYBWG0fnQ&oe=6AE1E7E6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orjg8EPGjxwQ7kNvwFzOk7c&_nc_oc=AdrfLEo1OTeTZLzlJfSwjBijcFc74eoQRExOSsyy98zGKcImRs3qDdu9yyjVBWGO74I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQgFlWRKABEKkwJTj8G0t7S7Xk7DnZ0LQjX0BA9Okw-w&oe=6AE1F2FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QpkYCjy76oQ7kNvwHUkU8_&_nc_oc=AdoC4JHhsLzC4oAgvXcWEOeZvmETZ7DQT6qVHEamwCy1jMi5LpOUW0nRfX8h5nz95pQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_KcWG6n-9sR0d3Uo25O26RswXOm4HSkjehFEoxLBc3g&oe=6AE1FA92"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
oc=Adlvr7iuWohDqD7hgPcs6O3-sQlyPqMosN3Z5_aqD_SNLufWJvXqbSBz-fuGRBYFj7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsIL2rSFv1IZcnhE9XOt3OYeGzaB4kdYeXNlK0k3ZczZQ&oe=699C43BC"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUH10W_x0aQQ7kNvwGN7h9W&_nc_oc=AdmceTihqPl3IYY84zFuowbAYuraABwXkquuzYatpVOzajqJnONmLXhkhCMwTt0yTLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsRTGJAUQuh60ySgMrIHPWFDt3MpXufSx_7Tj3JuC3N_A&oe=699C35CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjXsRcfSwLAQ7kNvwFEHx7x&_nc_oc=AdmlJ89qpUfnlqwfWojOYsJipCoBv_Uj5ysjttRQVDp2glB1rDSgD3Vb2fC0Tk_bVYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfubAWNKoy1w9Rfxk2ijP9zzuz5lG-7Cw7iTcXe_S0IvyA&oe=699C5A0B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!",
oc=Adk49ZLRehilJ7y7qiv-RAU1ruXjNmP5j9wZKThF5-WxIvjM96BvUEVRP-cpcfimxp4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftix3PhpR8RA6i1cGShbejTIFCm0v0P9WAZAM0_2tANOw&oe=69A57E3C"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTbGNS-kXBAQ7kNvwForTG9&_nc_oc=AdnAoAvyii97sZ3qltI8Xq8dy0agpocDgV2QgX3FeFFqVvvjExdcyiVchwXhcS3jii8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfscGSjIc2Nr3n_2wa3zTmrbI_ZnNwXIxJh8buKup5xA-g&oe=69A5704F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTyTqfs8VWAQ7kNvwH-ZTrj&_nc_oc=AdmEXK8sb1sJ83R2PkLhnK0deXMDI9Pm6QvvYrKbYhCfCU_zwo9-LOZYgdkqFw3U2X4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsuZMf2U5jNgqlmGMQ_fZBWBXArxfTz_5IExlV4XvGFBg&oe=69A5948B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://levityinteractive.com/privacy", "developer_terms_of_service_url": "https://levityinteractive.com/eula", "publisher_name": "Levity Interactive LLC", "support_website_url": null, "website_url": "https://levityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31195916846720764"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393328_1974945496318483_2060217974023383223_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxiAVuNiy1MQ7kNvwG-iIeW&_nc_oc=AdlZfwZSB5ecPj9OlgfiUwlUdEfNcZcgdb3Ro6LMxBOMHYPSu24wzdr8LkWXwf0Hj1s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvTKbvtZrxn14fi7_t2HtzFO3nW1Wo0tAW98NtFDeOy8w&oe=69A57582"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Legend of the Ematahn", "platform": "ANDROID_6DOF", "context_category": {
-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XenYVRVj0zcpKKSbsH1Vmoy3Gf0zLhU8zrncFUgghSQ&oe=6A070EE6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruU2r51OQekQ7kNvwHwIZgH&_nc_oc=AdrZX84U5GVu-rHi-zMUEtgJYc7jCx01Iad2n8Mcmv_zOtAt3Oa0ZtHTnHa0IqnDhcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pOzbcPTDoM32GuVTtLh_F_5E5J-YHsKatw4bAFjTLmg&oe=6A0719FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whl1JiD2f-QQ7kNvwHsdALG&_nc_oc=Adp4OsWVmXf5z4ZFy7-3XVoVrPUkKK0qdFehd0jWrfr1S0rH4uQ2JDEtYsnfiHbI_28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n8yEyuilYOzXrafRgxLix_v5dqpo_RVY1FZuNoNnz1Q&oe=6A072192"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
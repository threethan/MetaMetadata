-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M7tAk5ZlyxWmRelObKQp56F0WuYrz0tAKe1xOZwtNSA&oe=69FC82E6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUMjn6OF6DAQ7kNvwFPCs-3&_nc_oc=AdpV_UfTu5MTS9c5SbOTrlnJ236hlguDeINZ34yFKyNxBpK-wWZdBhSkGKdLdA2dyzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61NwmHk0UbanIrHRDA_uvfq_QiEU5bCkUmVL5LIPNlGg&oe=69FC8DFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzvnmEJOpLoQ7kNvwEeVG0V&_nc_oc=Adr_-T0w3ux9OWH930eazUMpG2MrC21JWwMiWS8-LQhXcWmy6qDI_Rhm5K-jMx7-XmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cZnq_SUjMUE2Qebk0P0CjVB4vw1FQwVdmaqNSD4y2ig&oe=69FC9592"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
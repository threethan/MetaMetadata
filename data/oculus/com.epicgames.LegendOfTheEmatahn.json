-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbG83Xr19WtTD0uyKtxjLVlbQ08wsvEFh6Udg-yDmmRg&oe=6A9FFCE6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIe_Fc2nYpMQ7kNvwEQtMRa&_nc_oc=AdrHw5oLEAsXfVhUCCUJi5S_GKG8NRQTM6Z7HQ1Sk4CMA3ovJZU9QHBJ2GJlCxIlwWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsxNuRxVZJF9r33oO7Nc4Sf8nL8SE0S0db1zDx6I29EQ&oe=6AA007FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UraglUKj_WMQ7kNvwHUr1ef&_nc_oc=Adq5zaCIEb9LUnRtLFCFbjhMHJgbsTlPzrm4T5j4nkn3S14RA5Yn9tfn7RwXCXzcKXM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYLqMLHSDBQtUWCtfMJ90YFsHwQonOIpZWOADnNMk4xw&oe=6AA00F92"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jAgrhsCxL5RLTDpnTCKDwVu49ayPuRrAMGW8DOaF0Ug&oe=69EE0266"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id4P1mugDDkQ7kNvwGj8UGz&_nc_oc=AdrExzugncX8aazbD7zPuLozd-QHE9KZmmpBXXWg1WT9ULHfjxyK_TlLIvuUexVSwSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z2YKK1tt4WXFfekUuKHPQnH9nc70A5rh_5ZO5nkP2GQ&oe=69EE0D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm98IKYg-nYQ7kNvwFwPHZZ&_nc_oc=AdpwguXPUGcyPRjFufsSNTmtlM8wWOW7hrAHMmGAqB92kmp3EMPwC9Nk6_s6B2uVwPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08k92WJUsG575oFtwN-Wdd69euDOJnEPzQnZQqdmLwOg&oe=69EE1512"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
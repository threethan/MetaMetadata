-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2bcrUp9WmSZ5QWJIJcYRar_F-Up2PYUDIPMEq2iFv_Q&oe=6AA14E66"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64nmjoCl6CsQ7kNvwGJ22pZ&_nc_oc=AdrmEXp4Y7SGUD_X52jrL4oqXw8K3B5-_nihDfPliiOoPuYPyS9sy9H-b0XiOZCvjYc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP9lBchNUKdP7l_v0qvHXCQger11yuaXxoPmDDyLFrTA&oe=6AA1597D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UraglUKj_WMQ7kNvwHhsf2B&_nc_oc=AdqM4q6EOD0n6_IseAd576D5J-FWGz3hT47FqoGEHK1wcPKJp_eWYiV_pPDgjkP1QAQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXWCXXvQs3bm0L39idxBmX8rmzjgUod4LZN0ccHxO4lw&oe=6AA16112"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
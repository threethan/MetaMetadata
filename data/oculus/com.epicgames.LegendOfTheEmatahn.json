-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr6oFA2ebXH5DLKis3ZCHrNl5jxPOfphViPih36IkWtg&oe=6A5F6366"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKlZcWE4xQ0Q7kNvwFHBmNv&_nc_oc=AdpikFEkGs7h5nOPaPmTbtsWzFSgxOndOASOPDJrg8CuQ7umUFYI7L-WrE7W8NZzpc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxE679wZ1BbsNTQ9kviyCiqdNe43_Ea8WwecQbozFLAQ&oe=6A5F6E7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl-eOPV3oCwQ7kNvwEZ7otz&_nc_oc=Adrv3cdxH4npXjJJ60bRs8CqPkCHBOg-ujoNZY_KDrxU-0Ea0yWA2LwNfrSYVWagY20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBABU1G0cY2YXror_eKTB91umDHQlWKdliA66211mRcrg&oe=6A5F7612"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
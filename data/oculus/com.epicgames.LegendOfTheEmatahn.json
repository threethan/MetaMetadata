-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1qVYxw9fBTD5JHm3EzTXhU41qB7sB3nwcny9NVLkv8A&oe=6A95E166"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJQP8F1Q6DIQ7kNvwFIPtJA&_nc_oc=AdqzIHe7BlA7CfI4ES7gnQ8Y6yR7Thc29U6cLvTvnoZVCLuaVe86t2Obwiu3-TPA7Ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH6HXpYQljc17DoudL7yQXOxN8F3q-UsXKY6nV185kKQ&oe=6A95B43D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gQorL7QyFsQ7kNvwGEVLpj&_nc_oc=Ado29WBRkf5Jp5JUnw_n5Wv_Py___PXqb_iy6E9TQ4HhtDldno3Jwf--yVrMCZszdUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP-0Qrd8nJqaKv9Dj5IzpYAEKzonZEbdOgncyXvDdaHA&oe=6A95BBD2"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
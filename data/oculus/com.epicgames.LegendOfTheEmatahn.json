-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aJMmZKdD4mbwqBMDT9rE3fYuj5D7Q6hE2W9AnnXvLDw&oe=6A21A526"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw6BQ9emDbcQ7kNvwGn4DXA&_nc_oc=AdoaJagg9sfjwPDxvv_OyY7Fcd6m3aWWwf02Dn1E0uX9n49-yEw5P4ORvL59Jje1HAo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P0Fg1FRjdPVAyqVTlIWw2jZB-Dcb8uyQs0WwZe8J7eg&oe=6A2177FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RVONjTTKWsQ7kNvwGl6IhK&_nc_oc=AdqPXMtRQgf7XG8Qid6QcFwLiotcZmh73Wzqn-oOzJYJAKRD7xJg1za0unz02tp3iFM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S7B-AGa_LvD-ofxOTr0WxCi3lwpkDb6aCdtywgGzq9g&oe=6A217F92"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAnc4I_INfo7QO2fI8nvsAOP78mJlTV04aOF7Ab3WnbA&oe=6ADDF366"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG3sVYJR06MQ7kNvwHX-wUS&_nc_oc=AdqzrQ492m89HV_7iQr0GvBOwT_-xkkUyDRvXb3hTtrDKE8WGP1ULzXWCluzK30Tc2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5aNAsRPbrV5KSvf2kAc6dmbDTpDt9RS1d5aNCU3rf2w&oe=6ADDFE7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_AK6k5z_eAQ7kNvwE70G1x&_nc_oc=Adp6O0LWhGekVsnZ5B8uz1jnTsX9CY31PKc7aloSmQk5djsDTKEHEUsV5pQt7R4zfrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJX3e9jh-WK4_n43Xh3HUrgs-zcKnZq_qyOQM-lRURQg&oe=6ADE0612"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
905_646708517771920_8670401618957788474_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tts1ei5euowQ7kNvwHbgxKu&_nc_oc=Adruaj249TuGh1H2uBHo_QGrRvIiOKcHAf7stNA3bLLlaSyPSS_5l74-DwDSD0iD1PI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29amSKHWAsuClciNraArh6rrOFroq_yiBdHe_fNG4dNQ&oe=69EF523C"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo6rf-4Z-JUQ7kNvwFV0QKy&_nc_oc=AdpXeIiFzXHfuFGp97kBqzeh_TBuvagSX_5nN4Q6eHzc3ejflBS8f7tNSAYpfb9_tMI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29Hm3awYb5D6dk_7M3JiDTNgF0oaMAJE4mLBDMnfYMyA&oe=69EF7C8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b68IlLge2cAQ7kNvwFZY-1_&_nc_oc=AdoTNk7EKg4E4nOez0CWLsKu03TcsPd3F2UGW1MLxeLIwlp0ocm9xBLyiQzWkdK2U74&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MZtPzWH3nsfJTE_TlKiFVuRZn3O5g81vKSzv-32EKyg&oe=69EF688B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://levityinteractive.com/privacy", "developer_terms_of_service_url": "https://levityinteractive.com/eula", "publisher_name": "Levity Interactive LLC", "support_website_url": null, "website_url": "https://levityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31195916846720764"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393328_1974945496318483_2060217974023383223_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc3Ie2Zto68Q7kNvwFbcm41&_nc_oc=AdqN7Nwhpz19jKWX2wS-NM2qqyd4605IXV_xqzqA-X8_kxEeSGShbpCi6fdxiTuB-EI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nioAAC6yN-hjXy1gXxb1ZHtFTvmdXu2folwUUSMw6dw&oe=69E
-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeW0w3HL1Vl5DEqPnBqx2x8QYJ5yQ1oMvB2VZFV7VJhg&oe=6AF49526"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c50JtuO8xnkQ7kNvwEuIWvZ&_nc_oc=AdrHkdyXtN9hXJ9IE8jXKL1p6seHy3mn7iULbtEWB_Dm_1wvkRTNsvysxVzU3Hsunq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0NfhiTXQ2xqralX_pkKKB2ji7DSmvAPnnDs5xZJvv3w&oe=6AF4A03D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8cuh6uy9h4Q7kNvwGDWr9E&_nc_oc=Adqp8erx5sEUnVwXiU7_ys1k1lTKkw6LDFxo7kKO4C5z2YlHtkUmC65eKOM069mxfLE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYmj1L_FX241lp1yRzLeRlkHAB3J_OWRS4ASCy-QbFdg&oe=6AF46F92"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DNTFsh4R6EBDzpNhGXYoWRM4oWaDv8-snWNrCDxtDhQ&oe=69F9DFE6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXp6crD41X4Q7kNvwEt80EX&_nc_oc=AdrO7EoJdYbHzFenc0zlSAHchEL2ZDdFnV9TI3EJWuNEv-rs-7HA3uuTbMIbmXDv_60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HulqlsdMJYvhuVS5yQ470J9eR2rOJ4eLuBv6fHRQB0Q&oe=69F9EAFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPg03ydS_HAQ7kNvwFmv_Z_&_nc_oc=AdqTvpVN25sD0H_4ygImfd-fH-NkcY2cXQm4_67yk4Q9Lu4EW46wALJ70sGN0_FCU_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Yb2Aje1Ff9PmxP2VusdZClJaOllJVya_em2kDq_VoNQ&oe=69F9F292"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
oc=Adqh-D0oTLSuAy85u4E9hYmjdpvty0CDLllv5sORiBbn3-JXN_tyufEVlhodmK5IJLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3BHYcheC3f7_yQe729gVfCAvBljh_lFEo7sRcPiddoRw&oe=69F0A3BC"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo6rf-4Z-JUQ7kNvwHxu5uL&_nc_oc=AdoF25U-v9QW-dtdXxq_gNR9633u8AVJ2H0odmQYn_JeIW27GnQOZmkVATX5i0kiZug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0HAg6T1F2OYkx2KHJ2HUUlMydE_qveRYzU8ehX7a0ylg&oe=69F0CE0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b68IlLge2cAQ7kNvwFEQdOd&_nc_oc=Adps7yqW13Bd2MPf9eKWxuyCupbp9oWKp1gIy6z2Lf-5CRcrMBjthJw_fpOwZOVLXP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0gfGcu94DCmw_XYqshOz_zyC81e44rku86E8lxlt039w&oe=69F0BA0B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://levityinteractive.com/privacy", "developer_terms_of_service_url": "https://levityinteractive.com/eula", "publisher_name": "Levity Interactive LLC", "support_website_url": null, "website_url": "https://levityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31195916846720764"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_1974945496318483_2060217974023383223_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc3Ie2Zto68Q7kNvwGOEyE1&_nc_oc=AdpmbI70bNZNMnzESYBgea7Hos3OWVd7E_jviTXNKXglcFtX8k6nt9i7i4H7lY8hvtA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2msgl9gWfr0GAcUKo2eSJKAcYwewYTXuaP-wtCbkNUMA&oe=69F09B02"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Legend of the Ematahn", "platform": "ANDROID_6DOF", "context_category": {
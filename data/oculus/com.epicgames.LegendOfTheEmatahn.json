-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjrwQe19XgUNrzGz2NP22PvMCL79Iw1LpFHdEuiTAJzQ&oe=6AE76626"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmp55RVRNogQ7kNvwHnPOaz&_nc_oc=AdqYU4j7fn9a3vG7rw5do4vvrsCqos3Do8n9mftvZECL16AmbSV9rT6Ktb_8-gsY-2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4PVLs4uFRoT1ZBnZMNyW9s7SmbA7Cv8VjPRLMhgXqPA&oe=6AE7713D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pQukXqynf4Q7kNvwFU6mLh&_nc_oc=Adoz_E2GDwOo71eoLIPlw86iv2JS8_ihUCUD6F44VToK5j_pEqAyQ5IUfxUozOrejng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO5GByO9j3Dl2djTl2KWuA1cWcpQTnoh7Z529PjuBKZA&oe=6AE74092"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://levityinteractive.com/privacy-policy-2", "developer_terms_of_service_url": "https://levityinteractive.com/terms-conditions", "publisher_name": "Levity Interactive LLC", "support_website_url": null, "website_url": "https://levityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27168319316147224"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "755807707248854"}, {"status": "PUBLISHED", "id": "1044294777094873"}, {"status": "PUBLISHED", "id": "636668539192789"}, {"status": "PUBLISHED", "id": "2320123201706647"}, {"status": "PUBLISHED", "id": "605459128556941"}, {"status": "PUBLISHED", "id": "893699955811623"}, {"status": "PUBLISHED", "id": "1294094948412017"}]}, "baseline_offer": {"id": "755807707248854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757335500, "status": "PUBLISHED", "id": "755807707248854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bina
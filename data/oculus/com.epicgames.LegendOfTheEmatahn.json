-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL-iKNEn0jV_mWh37A2saTzvC5dlm3SUUkmv7B_JlySw&oe=6A5628E6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcOGuRgTSq8Q7kNvwGxGJqN&_nc_oc=AdrqfJ7OM3I_zBpuBBmDhOSBfgnq8oGs_5mI996Tc2Xa-ZBgKOMwr_2P9ornzp2L3gw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCGFbDojWa6soE96_cDVv0Teg0_ZCR29TuVeiH2uSwrg&oe=6A5633FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjwcCzy9BRQQ7kNvwH0VGHR&_nc_oc=AdrtFpueesOdP6aUBcB0A8EngXfnNffTd8g3CB3dKsqCDMaXoaPcxMpIy4xXS45J3XY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3FH0S7NHiYSk8PDiF2G-rM7RUKn61HppTCapEhBFKyQ&oe=6A563B92"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
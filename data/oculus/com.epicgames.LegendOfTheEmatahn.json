-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrRQgCjAFJzL4_Wp7VQnWJ61CjW6juyOS7N7IKcEPesg&oe=6A9C40A6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKZ2PcPPEKsQ7kNvwF2eZEj&_nc_oc=AdoZx6WZm0rZznPqRi4EZXF_X3mU6GLGPOkQ77RPRmiqfqi_nTbisNtHGPeJjgLTmaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIID1-FgYhZIa94DXF3vf-bhUbBJ27rM3K7_i0EpSf0Gw&oe=6A9C137D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0juXMVCzJYQ7kNvwFv6xGi&_nc_oc=AdqeA_KgU-g-g7CCQmQohGp504kMwKdn1dSKWa8AWG3UhNNFrcbkB8kCp5txhUP5wM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXPCI-71aMTz7OWMYy2Jb1o27NXrW3p2B3PU4lguiG2Q&oe=6A9C1B12"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6LzJLibmsCTMWaNgn4jMsdralJTfDPrtpRoZk_2jyvQ&oe=6A43EC26"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQhmFwV6DT4Q7kNvwHWAcUd&_nc_oc=AdqflOh99dk8u9dMwKLbenH987DgmmSYBkiaUqMgM_arUE_ReTJ75USCdckTCmjtTP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mIicRm6PZ2DFg-FfaOSoPXtveniZzXcG4KKfOcxtXgw&oe=6A43BEFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1NRbrn2P6cQ7kNvwE3x22X&_nc_oc=Adqcz6HrjTVt0sY40CCcXbwTQ_3e6ekL62tjlMo-oqKZknhkZ_tsB80BpXOY5Bs6nNQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cXaCugBy_neKpbgQoIsJXGAGXRgDgJf-pUiH4TBFzNw&oe=6A43C692"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
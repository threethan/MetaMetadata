-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWeP3l4o3vvsZt4Kl1MQfVbtTkE9sUUjtxknJWqwDnWA&oe=6ABE87A6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5WaxfWEMRgQ7kNvwFp_tJ8&_nc_oc=AdpkO5Ss90vONQ7j7F_04np93t81UZ2rJLrUbCHKT3ercg_iBR3ZK_0IziISWNsssjs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGQhf9S4EZDPsdfO6Axz8FUP5kkuNcHN4xBb8aWSHneg&oe=6ABE5A7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vikM41ArugQ7kNvwEoviEq&_nc_oc=AdrR1mt4znsGaT0LjT5p4ToOBHDerCTNZYnTlVQxuT5guIJGg9eA26qXFk7KgdaJ2YA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb7la_dnAnW41V4u6xucz0rDaoRE4jFSY7ZeasllQ8lg&oe=6ABE6212"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
oc=Adnrw11JRF-kXrkqkweS3gs2b8GlqLXBE76OJ3h1JuRtNnuCDe8g7fE9RRlys9-hDhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv6i47dg4MijKa1QrlIzeIS88nJT01Nb7cFbHyyAWTJZQ&oe=699AF23C"}, {"file_name": "ScreenshotHighRes4.png", "id": "588567577280598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392107_588567580613931_8837092997352571154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUH10W_x0aQQ7kNvwFH3hLi&_nc_oc=AdllO_pm4fDojbRh6Ssuh_VB0K3UWNoTFMKMPBfRp7fk2TjHdVMJS_URaCXgngBGxls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afve-hitUNgrYUA7ehgcTbKcOmvKEtud0VBpkHtrH8KNlQ&oe=699AE44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PromoWideShot.png", "id": "3252051398268500", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392100_3252051401601833_3745721758652046213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2K48_yxcm8Q7kNvwG_Wpyt&_nc_oc=AdnbxiY25kSF9h97yf1E4oX0d6iMaqMF57ZzOEVYFBJRqYEACN0erlDM__5NrE2sXgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvTZZK8Q_3sLZAfQU2IBAf1PdNcpa29jyXS1Vg1CRSN_Q&oe=699B088B"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!",
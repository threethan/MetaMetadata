-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM95nkiq7AqUBBnhTKfgBmCgtY3IDKQasV3liK7Qm9LqA&oe=6AC12AA6"}, {"file_name": "ScreenshotHighRes6.png", "id": "1262435838228048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_1262435841561381_3311224200131038151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwVcY_Lb5kkQ7kNvwEQX_AG&_nc_oc=Adqj1Scun6t3t4aQVDmo66vYrn5AGPVfwC1QQ6LoE8lOy-zDB79yH_gtbvRUkaY0OaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8N5MuLL2lZi4NbViRCf73qr4VKWRSG66Zx5coiAgycw&oe=6AC135BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmatahnCoverHiRes.png", "id": "511241218457028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_511241221790361_760251907399571310_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vikM41ArugQ7kNvwGvpzM9&_nc_oc=AdqH2_WOCojQc1y_bzJZNGXsELA0ZcOJ4X3YMYIY1l_y_dEV0d6zMubLSgV8ME65cIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsb3DmlTB9zTgZz1HVjxBtyli-D60jt3YAxRy-Tc5fRQ&oe=6AC10512"}, "display_name": "Legend of the Ematahn", "keywords": ["Action", "Adventure", "Physics", "Combat", "Magic"], "long_description": "# Embark on a new adventure!\n\nAs you're beginning to make friends with a nearby village, a new group emerges that threatens the stability of the Highlands. Legend of the Ematahn is an action adventure game featuring physics based combat, magic, an original story, and a world waiting to be explored. Complete quests for the different factions of the Highlands. Uncover a history of conflict and defend the people against threats of all kind. Are you up to the challenge?\n\n# Features\n\n* An original story with 18 unique quests.\n* A physics based combat system with magic.\n* VR climbing and platforming quests.\n* Boss fights.\n* 5 different factions with unique characters and dialog.\n* Survival mode with 6 different maps.\n* More to be added in future updates!", "short_description": "Embark on a new adventure! Legen
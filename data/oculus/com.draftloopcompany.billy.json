=1-7&_nc_sid=6e7a0a&_nc_ohc=MtfX9MSsGd0Q7kNvwEXlkQd&_nc_oc=AdrO2fhwEAyH8WLvqQBoJqinUwjTlzFplKJkH7mVPS7TLp-oYAjMgMZjM7X6EvNil_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUejWDhSLPTKCtsvok57LQcGaxCWk87wRBk5voZtI5cAQ&oe=6B0F1CAB"}, {"file_name": "screenshot-10.png", "id": "1267310285352792", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819902_1267310295352791_724041432339820834_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFUXIMqGFTQQ7kNvwH4rrRp&_nc_oc=AdpDBrwsqMQZbJpLWdgs_X5-ijGzUC7kNRcvo0STc0DjXxbOqswApF6xpBVTf3xydHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxTrGXZVcGoQqb8UBbmA0bgg60phUIwfGPveGy7c23mQ&oe=6B0EF616"}, {"file_name": "screenshot-5.png", "id": "1353936319577025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1353936322910358_5618054116015023625_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_3fsxNORUYQ7kNvwHTknyZ&_nc_oc=AdoAxcGN0O4fsKI2T0YNS15wWwRwDK40exFM_9XsYQ76IMCi023IB5tU4BwjoisllYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDLcBndcSpvQrVXa2IBLF9HVD5tSffmrnfuczncTbo2A&oe=6B0F1BDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1433620308577030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1433620315243696_6549021710227929313_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRrh1GL6TpoQ7kNvwGqtXYV&_nc_oc=Adog2hMJKZd3rXZcnLeCqpMpt4d3gL3m454MWOrOQAe4V0Gf8Z6O2LZjrWbc3yj6bAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUpkve7ZMN--H9BkNBvC4iGzx2y486R-u_Ab2rlTzpXdA&oe=6B0EF69A"}, "display_name": "Payback Billy", "keywords": [], "long_description": "# Payback Time\n\nBilly played the gig of his life and the goblins ran off with the money. Grab your crossbow, step on stage, and collect the debt one arrow at a time.\n\n# A New Run Every Show\n\nRoguelike runs deal you fresh ability cards from a deck of nine, each upgradeable into something nastier. Build a new flavor of chaos, spend your loot on lives and upgrades, and push one wave further than last time. Fall on stage? Start a new run and come back louder.\n\n{1551065326458205}\n\n# Pick Your Arrows\nCollect arrows from levels, dropped from enemies and boxes around.\n- **Shotgun arrows** blast a spread of bolts for crowd work.\n- **Ice arrows** freeze a goblin solid so your next shot shatters into confetti.\n- **Bomb arrows** explode on impact and clear the whole mosh pit.\n- **Poison arrows** slow enemies to a crawl while the toxins finish the job.\n{1040090608732114}\n\n# Meet the Band\n\nSkewer screaming goblins, swat exploding kamikazes out of the spotlights, topple giants twice your size, and wipe the smirk off one insufferably smug pig boss who thinks he earned your money.\n\n{1500137278533130}\n\n# Butter Smooth\nEnjoy native 120 FPS on Quest 3 with zero spacewarp trickery. You hold your ground while the mayhem comes to you, so your stomach stays exactly where you left it.\n\n{1023554680533103}\n# Your Quick Fix\n\nJump in, shred a wave or two, jump out, the daily leaderboards remember who rules the stage.\n{1465671738936669}\n# Early Access\n\nRock through the first six chaotic levels today with more mayhem on the way. Join the Discord, yell your ideas at the developer, and see them change the game.\n\n\n\n\n\n", "short_description": "Payback time! Load your crossbow, crack your knuckles, and greet the goblin horde arrow first. Dodge bombs, topple giants, and wipe the smirk off one insufferably smug pig boss who stole your gig proceeds. Every run deals you fresh ability cards, so build a new flavour of chaos each time you step on stage. Spend your loot on lives and special upgrades, strut through levels of mayhem, and when the goblins finally get you, respawn, reload, and riff again."}]}, "developer_name": "Draft Loop", "developer_privacy_policy_url": "https://www.paybackbilly.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Draft Loop", "support_website_url": null, "website_url": "https://paybackbilly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1763395607991273"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1014880971432802"}]}, "baseline_offer": {"id": "1014880971432802"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787438040, "status": "PUBLISHED", "id": "1014880971432802"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1788007915530042", "version": "1.0.0"}, "id": "1561635908863456", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1763395604657940", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1788007915530042"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1561635908863456"}]}, "change_log": "Initial production release.", "created_date": 1786290327, 
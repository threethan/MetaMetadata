tps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410245_709729785848947_5776195413518319616_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzpWwaneHj4Q7kNvwFNMaYf&_nc_oc=Adr_8NWwsStlwopp7XWYFYIiaForKfpIwQvcNv1Kugrm8nBTSwrEGOe_F7ZG49eJs54&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBMR5KFgcWgAESTsnLINvDxTsN1_DmwsVf-ia_TMPOwA&oe=6B0B1F26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MintPot", "keywords": ["vr", "mintpot", "video"], "long_description": "High quality VR video! enjoy with MintPot.\nMintPot is VR video streaming service. you can enjoy to watch high quality VR Video whenever you want.\n\n* MintPot offeres the services to users\n- high quality(up to 4K) streaming service\n- 4 languages in app(korea, english, chinese, japanese)\n- category classification for searching easily\n- recently the most popular VR vdieo list\n- latest uploaded VR video list\n- amazing virtual environment\n- convenient features of VR Video player\n\n* MintPot provides service for the user to watching high quality VR Video.", "short_description": "High quality VR video! enjoy with MintPot.\nMintPot is VR video streaming service. you can enjoy to watch high quality VR Video whenever you want."}, {"images": {"nodes": []}, "id": "830898440742622", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\ubbfc\ud2b8\ud31f: \uc790\ub9c9\uc774 \uc788\ub294 VR\uc601\uc0c1", "keywords": ["\ubbfc\ud2b8\ud31f", "mintpot", "video", "vr"], "long_description": "\ubbfc\ud2b8\ud31f\uc740 \uc138\uacc4\ucd5c\ucd08 VR\uc601\uc0c1\uc5d0\uc11c\uc758 \uc790\ub9c9\uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\uc804 \uc138\uacc4 \ub2e4\uc591\ud55c \uc5b8\uc5b4\uc758 VR\uc601\uc0c1\uc744 4\uac1c\uad6d\uc5b4\ub85c \uac10\uc0c1\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n\uc2e4\uc2dc\uac04\uc73c\ub85c \uace0\ud654\uc9c8\uc758 VR\uc601\uc0c1\uc744 \uac10\uc0c1\ud558\uc138\uc694.\n\n\ub2e4\uc74c\uacfc \uac19\uc740 \uc5b8\uc5b4\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n- \ud55c\uad6d\uc5b4\n- \uc911\uad6d\uc5b4\n- \uc601\uc5b4\n- \uc77c\ubcf8\uc5b4\n\n\ubbfc\ud2b8\ud31f\uc740 \ud3b8\uc548\ud55c \uac10\uc0c1\uc744 \uc704\ud574 \ub2e4\uc74c\uacfc \uac19\uc740 \uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n- \ub192\uc740 \ud654\uc9c8\uc758 \uc2a4\ud2b8\ub9ac\ubc0d \uc11c\ube44\uc2a4(4k)\n- \ud3b8\ud55c \uac80\uc0c9\uc744 \uc704\ud55c \uc601\uc0c1 \uce74\ud0c0\uace0\ub9ac \ubd84\ub958\n- \ucd5c\uadfc \uac00\uc7a5 \uc778\uae30\uc788\ub294 VR\uc601\uc0c1 \ub9ac\uc2a4\ud2b8\n- \ucd5c\uc2e0 \uc5c5\ub85c\ub4dc \ub41c VR\uc601\uc0c1 \ub9ac\uc2a4\ud2b8\n- \uc544\ub984\ub2e4\uc6b4 \uac00\uc0c1\uc758 UI\ud658\uacbd\n- \ud3b8\ub9ac\ud55c \uae30\ub2a5\uc758 VR\uc601\uc0c1 \ud50c\ub808\uc774\uc5b4\n\n\ubc84\uadf8/\uc624\ub958 \uc2e0\uace0 : service@mintpot.net\n\uc601\uc0c1 \uc81c\ud734 \ubb38\uc758 : contents@mintpot.net", "short_description": "\ubbfc\ud2b8\ud31f\uc740 \uc138\uacc4\ucd5c\ucd08 VR\uc601\uc0c1\uc5d0\uc11c\uc758 \uc790\ub9c9\uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\uc804 \uc138\uacc4 \ub2e4\uc591\ud55c \uc5b8\uc5b4\uc758 VR\uc601\uc0c1\uc744 4\uac1c\uad6d\uc5b4\ub85c \uac10\uc0c1\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n\uc2e4\uc2dc\uac04\uc73c\ub85c \uace0\ud654\uc9c8\uc758 VR\uc601\uc0c1\uc744 \uac10\uc0c1\ud558\uc138\uc694."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mintpot.net/single-post/2016/08/13/MintPotPersonal-Information-Statement", "developer_terms_of_service_url": "http://www.mintpot.net/single-post/2016/08/13/MintPotApp-Service-Users-Agreement", "publisher_name": "MintPot", "support_website_url": null, "website_url": "http://www.mintpot.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "MOVIE", "MUSIC", "MUSIC_VIDEO"], "has_in
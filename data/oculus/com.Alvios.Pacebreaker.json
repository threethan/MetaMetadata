6e7a0a&_nc_ohc=pxhgoVoSczAQ7kNvwHzlPy1&_nc_oc=Adp4UfTpqrZ6A_aNaY8HKx9-MCiTFt-Gum6WJ7KuDjhA_9lHjfZKEcRHS4ZRuM-0Ezw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0V2CT0ZNfd_WWql17SnK_XVf1DcyOnQxshDXGxlCYu8A&oe=69F0A2F9"}, {"file_name": "PB_SS_3.png", "id": "1388534484815640", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75435285_1388534488148973_4466565987122987367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JiW0zRD6_EQ7kNvwFk62Fh&_nc_oc=AdqAvGnvsKrmCVgXe2lCsRnwVWbQV4P7X48HGtJ54ccw0XT9psVObHPjVGTnEIBkS64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2P-Vylg9LZtfN0U4s8dS2tD7heNb3z6xXmvarwl6aHTQ&oe=69F0A96F"}, {"file_name": "PB_SS_4.png", "id": "116368240386196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984462_116368243719529_6207788087315804527_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV_TMxU5ErsQ7kNvwEE9Cb6&_nc_oc=AdqRoY0DjypO3jaMprW-ycEALMVfbcEhyWlA2D7ttBuS6-nv6KkpBuDITZyFKz88Y4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2JaM3TXR9f8z1TgoJ7FJQhe0r7kVK_KQM3vhNPl0Hszw&oe=69F0CECC"}, {"file_name": "PB_SS_5.png", "id": "228193502187597", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568674_228193505520930_3731636703315603604_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3S_RWfCaLC8Q7kNvwF1oRWi&_nc_oc=AdodD2lVGhgVkME943p8rzRMmMSCBkev-LjabKdKgHOZd20rQPFxVoojg3R8CBz3XQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1Lv_TZ7z7a8E_8GDVrGXeKBWf3VsuSwAsSfUZktTimGQ&oe=69F0B688"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pacebreaker Beta", "keywords": [], "long_description": "FEATURES:\n- 4-Player Co-op multiplayer\n- Intuitive gameplay that's easy to pick up, effortless to continue\n- Testing game for AI-Perfected Exercise, and lab-based fitness ideas\n- Ongoing development by the VR Health Institute\n- Full featured demo (until out of Alpha and Beta development)\n\nPacebreaker is developed by the VR Health Institute & our sister org, The Healthy Empire. Pacebreaker is our testing ground of our next-gen exercise concepts in VR. Help us test A.I. Perfected & Responsive Exercise, gameplay that changes on the fly for optimized, less-sucky exercise.\n\nPacebreaker is made by a small team of students, developers, researchers, and other people that love the possibility of exercise in VR and AR. Come help us build the (someday) most advanced demonstration of the potential of AI, VR, and AR combined.\n\nNote: This is a full-featured demo of Pacebreaker, freely available during public testing of the game.", "short_description": "VR is not just fun exercise. It's the first exercise equipment capable of meaningful bio-feedback that's useful for someone trying to stay healthy, painlessly. Pacebreaker: An Experiment in A.I.-Perfected Exercise is the VR Health Institute's testing ground for research-based next-gen exercise in VR.\n\nNote: This is a full-featured demo of Pacebreaker, freely available until we leave alpha & beta development of the game."}]}, "developer_name": "VR Health Institute / The Healthy Empire", "developer_privacy_policy_url": "http://alvios.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alvios, Inc.", "support_website_url": null, "website_url": "https://vrhealth.institute/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "
6e7a0a&_nc_ohc=OcmnKRFTndcQ7kNvwF2c21R&_nc_oc=AdmMTxushAyPmiJfcxp_aetDOzBKR26xbEYyhmi3cEyuRS8Sux9whhp41USao2uWNbo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftn4zMID15KOFfZWdAQYsdOcAf_RO_MjR8SkDXp2W2vpQ&oe=69A188F9"}, {"file_name": "PB_SS_3.png", "id": "1388534484815640", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75435285_1388534488148973_4466565987122987367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4XDDdl8XIgQ7kNvwFgxHYG&_nc_oc=AdlMZLoZgWoOyq2ikoGcKMgZTCPfHIA4ZZKFshWEgbwskLrJoyZnfdk6t4CnNWioqDc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsrkLXJWAUhOX8bgSJatwsxk9Pu0cqcTUDkEIqktaff2g&oe=69A18F6F"}, {"file_name": "PB_SS_4.png", "id": "116368240386196", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984462_116368243719529_6207788087315804527_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xY7NaYkJLOMQ7kNvwHo3yfX&_nc_oc=AdlCCjpO5cedIhuEt7MTUFOR_g2xmCAyZV_otQKo-ET9nQUSx7ezSOyuYwySqHiUluE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvCs5sQSyOMmWvRDpHQrgQbGvUeHrcPZCPMyXbdGMc8hQ&oe=69A17C8C"}, {"file_name": "PB_SS_5.png", "id": "228193502187597", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57568674_228193505520930_3731636703315603604_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykF9bl91bDcQ7kNvwHOu8vZ&_nc_oc=AdmPu8o2z6-tazL528EXbT4t89FtGOjWAJQJEnJNRRZQOze98v7V4R1Of3dDbSf4a7k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuquXmGCuHov460gUApz3qHLfiakYEitjaIYVLXB4_zzg&oe=69A19C88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pacebreaker Beta", "keywords": [], "long_description": "FEATURES:\n- 4-Player Co-op multiplayer\n- Intuitive gameplay that's easy to pick up, effortless to continue\n- Testing game for AI-Perfected Exercise, and lab-based fitness ideas\n- Ongoing development by the VR Health Institute\n- Full featured demo (until out of Alpha and Beta development)\n\nPacebreaker is developed by the VR Health Institute & our sister org, The Healthy Empire. Pacebreaker is our testing ground of our next-gen exercise concepts in VR. Help us test A.I. Perfected & Responsive Exercise, gameplay that changes on the fly for optimized, less-sucky exercise.\n\nPacebreaker is made by a small team of students, developers, researchers, and other people that love the possibility of exercise in VR and AR. Come help us build the (someday) most advanced demonstration of the potential of AI, VR, and AR combined.\n\nNote: This is a full-featured demo of Pacebreaker, freely available during public testing of the game.", "short_description": "VR is not just fun exercise. It's the first exercise equipment capable of meaningful bio-feedback that's useful for someone trying to stay healthy, painlessly. Pacebreaker: An Experiment in A.I.-Perfected Exercise is the VR Health Institute's testing ground for research-based next-gen exercise in VR.\n\nNote: This is a full-featured demo of Pacebreaker, freely available until we leave alpha & beta development of the game."}]}, "developer_name": "VR Health Institute / The Healthy Empire", "developer_privacy_policy_url": "http://alvios.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alvios, Inc.", "support_website_url": null, "website_url": "https://vrhealth.institute/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "
4_424014875351236_7819920644855449800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfwPK7azEWsQ7kNvwFkM_Ff&_nc_oc=Adn90nY4BkpEkDpWCCANbb8Cq85LnsEnKc2_ijq5GelsmCL1XktSWIwiarGQcnPC3PM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8qmksh_R3IC_sKNP8bBnpHidIOwB1Wtclx-hjtXEWxw&oe=69B7F279"}, {"file_name": "PB_SS_3.png", "id": "1388534484815640", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75435285_1388534488148973_4466565987122987367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-N58prj4fsQ7kNvwENJ_RZ&_nc_oc=AdkXBQilvbkph0KSkK8Q62jcOl9OaOAFSDQ5AWF2v9swWsXdiD7Fy9HYFIJ-ysdqDMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPR3p1YU2l2OzF-vBlwgHlwCfEU9d4PEiaTbMERl2TpQ&oe=69B7F8EF"}, {"file_name": "PB_SS_4.png", "id": "116368240386196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_116368243719529_6207788087315804527_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsfZo1egwtsQ7kNvwHFCuX8&_nc_oc=Adl2ZyzB79tqPhzV-brIZ_5BhLFhURQiQWKsm-lWg0gSDsTHUWI39TtD4gxGO_g10Tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLyNo6kRJv6nvnL-pVQXXHBzn_GSb8MUtpprp6M2Z8mg&oe=69B7E60C"}, {"file_name": "PB_SS_5.png", "id": "228193502187597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568674_228193505520930_3731636703315603604_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoY8Gx5345oQ7kNvwEiT_nG&_nc_oc=AdntP5B4nhU3CQuhWfA_aI_457cydiMdAGqWP2t8jQyiO1nRE8ryTBWJOWphNOTQHDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPUo_MoTg2Q9rDhWwjEyScCHqVry68fTu_29RfQpfAog&oe=69B80608"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pacebreaker Beta", "keywords": [], "long_description": "FEATURES:\n- 4-Player Co-op multiplayer\n- Intuitive gameplay that's easy to pick up, effortless to continue\n- Testing game for AI-Perfected Exercise, and lab-based fitness ideas\n- Ongoing development by the VR Health Institute\n- Full featured demo (until out of Alpha and Beta development)\n\nPacebreaker is developed by the VR Health Institute & our sister org, The Healthy Empire. Pacebreaker is our testing ground of our next-gen exercise concepts in VR. Help us test A.I. Perfected & Responsive Exercise, gameplay that changes on the fly for optimized, less-sucky exercise.\n\nPacebreaker is made by a small team of students, developers, researchers, and other people that love the possibility of exercise in VR and AR. Come help us build the (someday) most advanced demonstration of the potential of AI, VR, and AR combined.\n\nNote: This is a full-featured demo of Pacebreaker, freely available during public testing of the game.", "short_description": "VR is not just fun exercise. It's the first exercise equipment capable of meaningful bio-feedback that's useful for someone trying to stay healthy, painlessly. Pacebreaker: An Experiment in A.I.-Perfected Exercise is the VR Health Institute's testing ground for research-based next-gen exercise in VR.\n\nNote: This is a full-featured demo of Pacebreaker, freely available until we leave alpha & beta development of the game."}]}, "developer_name": "VR Health Institute / The Healthy Empire", "developer_privacy_policy_url": "http://alvios.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alvios, Inc.", "support_website_url": null, "website_url": "https://vrhealth.institute/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SI
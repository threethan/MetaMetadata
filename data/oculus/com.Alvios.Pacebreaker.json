1.oculuscdn.com/v/t64.5771-25/75422374_424014875351236_7819920644855449800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rq7ta-NJtqIQ7kNvwHSMjpw&_nc_oc=Adq2GqAazNdepht3mdYU_waJPZPsn1o_8ttg6HB-K86Qt7wv8fzQGHDjbR7E3mN8m3s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuSI3MyEtb_jjmRrIADAvrQJhnyn-fuCU1-TSmSQmNBA&oe=6A8D8579"}, {"file_name": "PB_SS_3.png", "id": "1388534484815640", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75435285_1388534488148973_4466565987122987367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxev3lEazXcQ7kNvwGhrJ-F&_nc_oc=Adr73SgUlWlCChIjcTiJVFFc8Za_ueCn0k36DXzSR_OqFFQuyc9-EiSlMAPyGfvmw_k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIfgQw4bnGoAUG3MJFbbXLq5o9_aVZsVh4DQO2cCkHlA&oe=6A8D8BEF"}, {"file_name": "PB_SS_4.png", "id": "116368240386196", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984462_116368243719529_6207788087315804527_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZNQdI76qUQQ7kNvwHH4Okb&_nc_oc=AdoJOQA6kCPinDTcqVerpXvoJAqd9e48xNOKZsTl8FADg0qLemzrTDbSpQ4Cl82HzKM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEop-TIudTcsut2Z_ZThozsyCnLwZvXzLJUn76UQshR-w&oe=6A8D790C"}, {"file_name": "PB_SS_5.png", "id": "228193502187597", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568674_228193505520930_3731636703315603604_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb5p8lh12NMQ7kNvwGW0L41&_nc_oc=Adp0iShB0DMmlJeYoXo6vzkpdHuUzrdtc_q63EwrH5gbk_YZc6QZhxpvgxLzyp4VM9M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTJxRfSUoTh9MLE8y7MgxVByJKeL92GE_tpDQxZxc1Mw&oe=6A8D9908"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pacebreaker Beta", "keywords": [], "long_description": "FEATURES:\n- 4-Player Co-op multiplayer\n- Intuitive gameplay that's easy to pick up, effortless to continue\n- Testing game for AI-Perfected Exercise, and lab-based fitness ideas\n- Ongoing development by the VR Health Institute\n- Full featured demo (until out of Alpha and Beta development)\n\nPacebreaker is developed by the VR Health Institute & our sister org, The Healthy Empire. Pacebreaker is our testing ground of our next-gen exercise concepts in VR. Help us test A.I. Perfected & Responsive Exercise, gameplay that changes on the fly for optimized, less-sucky exercise.\n\nPacebreaker is made by a small team of students, developers, researchers, and other people that love the possibility of exercise in VR and AR. Come help us build the (someday) most advanced demonstration of the potential of AI, VR, and AR combined.\n\nNote: This is a full-featured demo of Pacebreaker, freely available during public testing of the game.", "short_description": "VR is not just fun exercise. It's the first exercise equipment capable of meaningful bio-feedback that's useful for someone trying to stay healthy, painlessly. Pacebreaker: An Experiment in A.I.-Perfected Exercise is the VR Health Institute's testing ground for research-based next-gen exercise in VR.\n\nNote: This is a full-featured demo of Pacebreaker, freely available until we leave alpha & beta development of the game."}]}, "developer_name": "VR Health Institute / The Healthy Empire", "developer_privacy_policy_url": "http://alvios.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alvios, Inc.", "support_website_url": null, "website_url": "https://vrhealth.institute/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH
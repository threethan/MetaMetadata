oluaBUWG6MPBOkiCN7Ox6usqae9mjhI6jugR-Mrx8gdNI9SEzce9qc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6SrVgoHJpFJJHWkfbWwpmKTpv9wTkH3olbwA9B-RlZg&oe=6A92A9E8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYlbY3iZUYUQ7kNvwHM4jbB&_nc_oc=AdrnGEk1kOdY_5Rsqez5O0ZBLP6I69SAWMY2OtE-uEJQWybXxcujjd12EZKC8q_OZsA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHphJTU7f_QUsRuozsb2h2YzD-SWj0QQaz69CQNRMPovQ&oe=6A92B0DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czBJ-qLyI8AQ7kNvwE3PkAa&_nc_oc=Ado2cWFEMbo45gTUoShv1lN45nujiJ6D2dYNIY79Ek2_eabDXkykkiCoiXrVCq2ealw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIAt993ArvKG1phr_kZ__RNlPGD9tPPB4R4RFvEkq3Ug&oe=6A92C0BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
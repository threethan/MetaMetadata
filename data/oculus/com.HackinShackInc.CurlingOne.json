GFbJCv4dpI1jjR4mhN3e8T7BrUAC0IxJYcQ0DVMYNyVzcEwWRHtOdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMEvF6aKpvpYd_xg3R9Y7Kq06RGZ7Lkh5oW7TXedgCAA&oe=6ABE63A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXipT4d0T60Q7kNvwErZfVR&_nc_oc=AdqQ8FNM5DuXZAGuFPMEAqOPr7EAABjoOUMJAnXf5iNWqUZbSjJtKHs12HE3J6nkScU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxu-csU4Rr9KGbDLmC21Ab8SAEMeZL9VwwMsoLa5tiTA&oe=6ABE6A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFab1_Dmz9oQ7kNvwFCQWkP&_nc_oc=AdqIKwpHEFJbRYuhLlI9vJs3MKDbYySbG-hCa5XzYCC5qclhD5FKIAk152QdcExXE7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNMJYgWgm_wAI76PeSacAkBq7BwpO3smCyB3nJAkg9Ew&oe=6ABE7A7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
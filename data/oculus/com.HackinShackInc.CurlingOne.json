SK6j9K2WpPEWZTTorg9KYqPQ-zaO8kUlc4BFHksxj2_v6GDOpTM82BfAQzHI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PWY7Qx0IY8ZApg0-fDejfzQum9H0-MAUgVScC5bkKzg&oe=6A22D2A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv3x05j5PeQQ7kNvwH9dIru&_nc_oc=AdpxpYYpwBFEDFMOugPU7cG0AatYL04C73jln0vBGINaGC6m-z6fSU8V_AH10725ex4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dF06mAVbGRf7pWwfEfn4Kd6C46qMHLKzx-pDixEezmw&oe=6A22D99D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsOuxeBCPGQQ7kNvwHIf6wt&_nc_oc=Ado60FyJHdj9ozTPQ-IEwHEMkfzfF61D4Ojb-wLxFKou6HfJYHYuX-0cWPr2GeYpq0s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-25bqL3CnqpT7DjckiqRQQL6EiN9aDetl8vAUG3VgR3w&oe=6A22E97A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "htt
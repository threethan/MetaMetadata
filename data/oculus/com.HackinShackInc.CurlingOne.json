ZZsTkwc-jsSQlxa0wHDQ-A1mewV35lwEX8f2js8LqkgAZZzPm4kzP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tRTwxjZtcJfCYXv6sRAvJYRcyCk_5ZAQOqcxvYn1EZg&oe=69F75128"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pUxkjAZtAwQ7kNvwGIZlQd&_nc_oc=AdqrfoSsCBkV7gS5EjJripwzHhAbYYL-MT9psiRZCb4vjdCoWxNVIwhZbHXr0T0PCZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0op26PJrfz3zH1ytppNfvkt3DLkfLqvd7mclfiKSeyAg&oe=69F7581D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD4p_zZuTEAQ7kNvwGOVpg_&_nc_oc=AdpuGDE_lVVElwH6p6Z1K0-Ewaq_0PxtJMofXn3JPDCxayXOv7mM9i12ekc16pXxtAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03A9_mGDc2xCKo1SyIK2JbC3U1itNUAZJ-sj206biYlg&oe=69F767FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
3LS0odGgeBwwaO_ZduLH7-HfMynWj-PNrAgSqJQL8JU2jthOIXh4D0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMenVMiX8VBdu0uxGmr7Z6oR1f47EaNJ5nhxEsWIWekqA&oe=6ABFB528"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXipT4d0T60Q7kNvwF3aKW6&_nc_oc=AdpjHPrWqhZSeG0LlUITnfXZZ-k3-c5yIWznlDTgtdtXYfyfhMmpIDrVF54B-20xjFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNef4aMuRfG0dB9OnoX3EigTQL3pvBiSul5yY4lPbJLRg&oe=6ABFBC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JIbHKinEf8Q7kNvwGcnj8n&_nc_oc=AdpdpUP3DDJVp9ST9ZaH9EFbWDEfMuSoO-Ogyi0lAREOf_JW8b9OZioDlgyM7yyH454&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYCb7PrOBQhjwyXGykybGkkrjqmpvQ1VkZHlM--QOFPg&oe=6ABFCBFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
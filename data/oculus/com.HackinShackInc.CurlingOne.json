JTQBvtTDNqInqfpsjuIc_weNWNdu8B4kblmwu0cB8BIeCUT2Xmlqo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVQK40sLxVIdMlbXl89Fjvv1LGc3AZdpngCiPOZ2v3qQ&oe=6A7C78A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae4jtssDchgQ7kNvwG_KErl&_nc_oc=Adqg_sYFmW_u9YWgrF1mUDeM0jn3143PeEUSy4uc-uR1cZ_TKKuwOFSQBv2-b7jKQKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYAa_cFAED1jGXir290jwaTLtSqZW9F6t_fD4SmCZmNA&oe=6A7C475D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuzxASYMSqAQ7kNvwFuczyi&_nc_oc=AdqF694k-ilP6HcqnNnlK_VUiHDn3pkF2zhGV7Pc9fxTjQjaxtKY3DSTYsoxgio_QOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8SHM50N68vgH1z-srDkFKtH_Jn5klq6uA-1YIRFl4ag&oe=6A7C573A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
cJnZqtYZehtpMf6f3xgEklfTZk3fCS1NsDkkRjmnbl52ZFEaHh7QBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg_Zt-JFhf3JpKteUb28z9ayfSdC3trylsZ6Fvj9lwjQ&oe=6AB134A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMli_TvkfdMQ7kNvwGgwhA7&_nc_oc=Adoq_iR-4SevxMp4GaQN59O1fl8T9AzHERYC1LZwzeTIfAeYT-oP_QbbLIKc-X2P_I0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbY6ilWQ_uzG0CcU0pbbCjIOBrFaK851izQlS8Nd7MEQ&oe=6AB13B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW7iLh7cr0UQ7kNvwFZQ4Qi&_nc_oc=Adrt0-Sk0nzGownJ01twDncyN883FRSv891MsF5Ht9oL9jOW6KL8uz9fvJRDu4CSrp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKtt9Anr4gtcI3Bo4nnInhjPsejAHeh6KHuMTK2x0UiA&oe=6AB14B7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
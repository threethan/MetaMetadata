=AdrtzVn9jr5mqo1D7Ioh14pvW_z-abWqZszKL6q37GjC1PQ9cQczNmjkaHkwZfvUtt8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH24C7j7ksFHa90NjDZC-nlHKrQULxXqYoAxDLABKXI5g&oe=6A8D9C28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48ac9VJsZFEQ7kNvwHzCKpg&_nc_oc=AdrBfxvyvEGKPDl-tMvPtDRLtC2OaItOdmUuQ3GKHQI3VSzmfqIzmjZZ8oP3L3pqxGY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh-iRRwltSLFsJyyXSP-y73uC3ZIf5Y0xzNGUwSHIqTg&oe=6A8D6ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QOorcrWdY4Q7kNvwE5FzAF&_nc_oc=AdqsXf_CRhxGd1nwfxrHi9The4Ep1C6ld-5MZ_XTWAxsEeP4NMdlSjGcfnt50Iu-Q9w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6cLUtcz9W_L7CfVM965A0SwP0AcSjRsP0yxJ-pAtb3w&oe=6A8D7ABA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_ur
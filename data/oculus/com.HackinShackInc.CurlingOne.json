yS4G0D2aCizTZfJ23x5a3JX8zVrHizO8trmX_Mn4YBPOv1LQtjDoDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDno0PWyL3eBYfCgfVmRhqzGENKz7q8yT_xjz4-WgsqMA&oe=6A5248A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sF6wCpkwWa8Q7kNvwHwDYgd&_nc_oc=AdpLvt8Si-pD4nO2HrmcouvYiHqS3hXE0cGcy4n3TnKzmHl5DnzXIyts6wT3DKqIyE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcgOkxrX0TLdFfMSVu8zD5sR-PsRbTg-cE3KIunDwgpA&oe=6A524F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-ycHP_6qVMQ7kNvwFBoZym&_nc_oc=AdoJLYKXBp6ZhtsSyuPg2dPEYtltIJ90TF9NIRODUSp-QQnOSewzoGuGN16jorP7pps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCjCpBP9j0ribjHX-fir1jQGGyXJfogibmxBkFXT2tDQ&oe=6A525F7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
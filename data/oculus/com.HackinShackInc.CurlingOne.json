k8jqydSPkBuS8K9jQbkuiwuhoc9v1vxYA-HtDATGdENB4iJYUi9xbw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHez9U4eykIJg6nCOKsC1w0zrdmd_F5iMSGRS173eIA1A&oe=6A9190A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn704BMQOwcQ7kNvwFP7Zt0&_nc_oc=AdpOb_Rvvg_3tX0BCjYV_CZliVdU-EPSI0xyA5U4Jgsv8jo7C-ZuwGA8dKqPI6PPfgA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKAdvEONc_5TwXrwHQewPRKbtw55xB0tDPr5knNO5EEQ&oe=6A915F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czBJ-qLyI8AQ7kNvwGoReIw&_nc_oc=AdpS5KLpO_6pw12qNbWsPHUdRwEC93UgRwFPF6cns-ydky2P6h_Gff8p0qnReY5pBwA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF32kTbAfpjY_0HSS_8sRjxe3wScE11LV2IxmLuQJKzBA&oe=6A916F3A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
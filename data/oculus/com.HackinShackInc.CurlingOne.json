x0tJF-vw-Se7Wpq4_6ujtgPOfJ9T_Jian4QhYvCCd1Wxj2AgPUc31w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQHEjzh6fNISfDUSGMDjiCXeZFTdf3eA3UdWom_Fi1Pw&oe=6A5B8328"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4PZiF4JCNQQ7kNvwEty2iT&_nc_oc=AdpvdUqIcMFACCQqocb2B0aACzg-GvvVWgbVWCP2HO9KDMcHFHe2j3wjyLM7YaF-Cg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG0FZUeuT3b9_VoXYOMx1byuTM5ibJO5-xwh74Pu-tjw&oe=6A5B8A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG88i_R-_V4Q7kNvwFVTzrS&_nc_oc=AdrpkzVHKri0005WIo5dMgZZUW3GLmbGIubvHUs8-vHCo9176r_UoPCmrZ1Jl7lrul4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByeLGJHmUWi7BUXT36dGZxc43wgRc486EFEtzfkLmZjA&oe=6A5B61BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
fECsAs7hjTrJaOeBK6gGRuBPK0Nl-BHMZJcGe-cel5dXmrp7fZ9Ee4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eiHMc7WbnGBz8vtYPtbID3u0-Z0y6tn2g27OZGz5nKw&oe=6A242428"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-e7FAHSgswQ7kNvwEK-rJG&_nc_oc=AdqhaPRcdeiN4bZiAtGN_jpG8Psm-LQBU75CQ071pV94TNF6AhX32NTL4M2vs5t_OHI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kcjp76pBRWwVCLIzoQrylkXx3-YtHKAM71c8qQI64DA&oe=6A242B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsOuxeBCPGQQ7kNvwGEomI6&_nc_oc=AdpDPZuFjtG29EyDHRWn-USwYZmiQCGraUFpCKAN91zpTUsEAImgXxQD4Tw6NDfd0l0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-b5_xvY3MQqjS8bMfPKmSCOzJ5RxgJVWxISbSljr4mg&oe=6A243AFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
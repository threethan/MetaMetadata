4uDlTtRDOvbfloihftkKheGfpNUhDJC0ZmRdGz-lc4BXs6K991LkLI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBLHfqqrGF8nZBbjZV7stXazcbAVVsOhAjHQuGOzX_Lg&oe=6A5A31A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdgr82BonKoQ7kNvwG00JV1&_nc_oc=AdpyOsrVdzqJvRecjXd6NNoW7iHOuNSrhwqTg7_iahppw5698Xm1uUVWqG8IFAKfmXI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW-i25-Ac9M1OsZ7t8l7NkS1cJl8wgSFnuexh2rr9JDg&oe=6A5A389D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG88i_R-_V4Q7kNvwFDPZIb&_nc_oc=AdrtSoD6zAMbv2uBwlREBqMbij8Vn4a2NOVpWLC8G3TCz7lNztBXyqODymTQzHiZFGY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv0cLfw74m7yKsZv_nCpKG5RlpGPHGiHlDeauuOspGhg&oe=6A5A487A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
MkWnK-YPF5pcUFhmHfTc1trGo3IbwkBa0O2rkyMBIzvFVfvzy8XBbs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTwW93z2iWMApXaR8n_RNHs4fZAqsMJXK4fE1gCwQEJQ&oe=6AD0D8A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOyKdBLJO28Q7kNvwHoOSuY&_nc_oc=AdoHJYx2Y4bJOM3DZKDBjZecFOG_tViZ2ChBYQiOtSS6rTokVS65Oi4IdD3rBwK5opY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF_2MisnFDsjYfqtAIvT-apW-1Gh5cDQwoUIi4pDxEpA&oe=6AD0DF9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6C-jsi4S-UQ7kNvwFdK5os&_nc_oc=AdrnYG8qTKPMBy5q6wE-LM54Fyte_sBjzyGI616IHa2TTQReUzbo37AO5hNoFX1wKwA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-g3M6hyBvG5DLOD4PpT_y-2S7dcDykJ-SF9CbsK62nw&oe=6AD0EF7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
lYOy-DJpw36LY92TtgRZgSvE0aGTjo5a0VVoTU2BFBA_sU-4tIfGMs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yDPrbu6jS7VdhdkMV3Uovma1Vb3WwhIlrMITL-sUoRw&oe=6A3E8228"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkBwyxqLoEoQ7kNvwGNqPiq&_nc_oc=AdqUucmbv_JF8raUk1uayfBKmT8Ua3b79UN_mHNXzUoBs0UH5-mCMu40NevU1o3PWCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s2bO0NqC_gWxeIRGM51DhNUuQwnfL5YZcygoto7HfwQ&oe=6A3E891D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpBL2IPEJCwQ7kNvwEUBolX&_nc_oc=AdooiNde6NwcM933zK1XF74j5eVHq_ZBslpfJI3lh0_fMoBq4dx_msAFiN7UoxmLQs0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Z5MyBKsZaowbJEoGVuQEK5fi3p_29gzaEq63TZwcqA&oe=6A3E98FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
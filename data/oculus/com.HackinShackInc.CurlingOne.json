EZ_0_a9uWq93ZFNYSV7pyCLo6j0Xlm9UIXpBsJhFdD6Hdt9gwz8z6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhaZU4jUThs1shjgeo6rJVTaGCUg1kybv0ebVf0gI4SA&oe=6AE9E528"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhpDuQRfRrgQ7kNvwEYxdoP&_nc_oc=AdoU6lOZ-LF25c212-Ey3KRugSn_GCd3eRyp219DgeK-_mjMpxaLWjqXkKNsMQAry_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWJGTtr_gi1R8zFG6RcyNKec6UzkeC6mOM7G1_80BN2Q&oe=6AE9EC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZH3ZHf-aUYQ7kNvwHTOXeM&_nc_oc=AdpOjyGJLx-XAoqA_1SitAKPuGNILuoa_3Whz16E2C_ZiT6ejD8SQPVG87OILh6Sjs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeIllDqvuEBFY01KmfKikNuuGgz4Dkn4nYZiRb-6jvoA&oe=6AE9FBFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
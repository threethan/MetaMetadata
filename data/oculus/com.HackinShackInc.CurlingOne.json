Q3nJECmDT0wJ8-Wi7iFSE1o5xgZDBCqWngtCaT0D7eMSjS7SegdknE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQVQSIawjhy_X-fYM1xINQjGI3fR3GfecI2Jdb3Xvgww&oe=6A79D5A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOWdt15ehmUQ7kNvwHnhP8d&_nc_oc=AdqwRPF9dT_6_zyllanDYFi2iBz72yviGvC4Y4lnAvxiZJqS5_OOolqTaYXvOO6t00A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQP0WRthZrS1r9qLTI9GWST3aJ8nKbm20vI9IwGogQWw&oe=6A79DC9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KAn6V-y9dsQ7kNvwGuXjkF&_nc_oc=AdqT8dgNCkqq7z4O1t5-OmgbWFaFPH9fELODRpLsth9OB9d3FNJX69GdMdXlEQVA89Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRBGY2wz61OGzY5zogB3tr0nMJq_v5KV8mzdWz-ajBmQ&oe=6A79B43A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
pyG5D7aEd8m-r-lmSlKZFM_afueb8qIzKM_Lpp40ui95IVSZCX7ROs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrNZDKv0lfyepBxgRPmLsamHVaI0l17KztvWtidaahvg&oe=6AB7CC28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1Fzp3B02rUQ7kNvwFlv_Op&_nc_oc=Adqr8_qKTdVCaVGxNwQJyOjznxqAWzhrqjyeZf2WyVmPy-rL2Iv8b7dfHnFCJbqmKzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUEFSuuC38jCwrPvMYRsn5QixFpi1neMJCYxuyP1exdg&oe=6AB7D31D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yt6D-RPHyV8Q7kNvwFLTJz5&_nc_oc=AdqEUSmqAjYiHrh1Ggvnc8Nqftw_J6XeME0kc1TRvI28-lQ-PbHg_XZJJMB6jpoRnDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6qSzv7-BcoE0sjRCq_n4KYQc1gWFKj4Zm9hbiOJuKXA&oe=6AB7E2FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
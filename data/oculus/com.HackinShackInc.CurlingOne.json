ulZIbKc3Ha1Ef8MrCyIN9SfSYLx5eE2mOOqH9AJ-rPm-2LjQNPbC7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gqe4SSnqGrXD6XFlTkg32tPvcAAAFEi_WooNbYXkpIA&oe=6A315328"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oVHsUojC2oQ7kNvwHagrun&_nc_oc=AdqmcBhcUCRGh6gPvqPpr_sURIYLdbuu4BoIf1xOXXz5WDC-04rSYk1s5cg7BeVCjwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TUXjJDhkhYOBsVZ58zqwq8VxOQPD5LFBaXmpXDX16aQ&oe=6A315A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrRCM6qYoLgQ7kNvwEIxm6I&_nc_oc=AdqOjb2qIqve5V_Yl75zNuMDhr551oHciEYStU1-wzLzMwrz_gQj0-nZKHrILCKvKuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pOfL9x_XHRC7ZGk5I6D3f3EZj3ZJ-4v7I-rDgWJHAHA&oe=6A3169FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
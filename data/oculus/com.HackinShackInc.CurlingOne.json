BwV_Gne9L2i5Mlmqj-CojurKG1JYt6q7yJAwwuXl1RiAmYiamSM5Q4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qS2NeqnU47HFWilUxgqGtO2rUIBaqyiyeYzJ-By9p6Q&oe=6A1300A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On7ZWzctNOkQ7kNvwEUEarh&_nc_oc=Adqpvo8ujndUtVZIYzPFFUI5x1NBU7xNIx91kiv7nGlNlA7Kv-JyZK9mp9RzzksFCAg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lW2f63-F6RuaqcqyGetZkHZ20Poxa5iwhkZvT2pV5fg&oe=6A13079D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W98HpQOyeQQ7kNvwFRvchx&_nc_oc=Adq_mGWMl5kCmCrJ81Ao24LMCw5Muu4Ti78z_P-8sPP0gorVBsfvneN1CpjvUP8Ylmg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67NeAcuSpXUeb5MKq0CnZDMaj765Fy3HVXWM0pFdwioQ&oe=6A13177A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
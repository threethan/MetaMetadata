87ny4UeFXlJFn_9KkJlXZW9_O5gdWwo5M-MBgz0YnW_nlJ-zY7GwyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A4KKABCVM7-Nm9oTamWloZJCIeuF46unHuEHkfPNgkg&oe=69D65BA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whdHEXTWeZEQ7kNvwGhTo4d&_nc_oc=AdrsTzi-ZcjSAQR6qzr7yRiP89931VNEgEfA_Trh5Q5IUOozUqEM0z0BQy_C-uDBLXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01FlJ1Xub2mNUt8EhX2AOsURflMBKvbbIAcDpN6a0NlQ&oe=69D6629D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHnmHgmGZA8Q7kNvwE5Qzlc&_nc_oc=Adp0l9y9pQNXajerV24qIaIh_IDFmGshK9SFMCvKVOXzKE3W8Hh4dcPXiRDKShi21dI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HIJOVEZOrqHfrhSwSHwHXp98E44WZ9vxXGaBTIeJzYQ&oe=69D63A3A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
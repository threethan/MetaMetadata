Mxj4z5gLtuSwYWrYESOgZFd07pZFm5yZx7CsG-3zKb0sh5J3e-XeuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTItcy212xl8UI_9QaGKv1z1PcIT6Q4hCfZXER3OLtz9g&oe=6AEF6368"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipbwE77smo0Q7kNvwHDcyd-&_nc_oc=Ado_WxHkZpO2rTHfF-V7Z4Rj0mEpTE5qPMcSisywLUrN7WgAnOkxaWyosREdtJvWs_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgi-N169QsmlsiVWJ3ezFhQDnerEjHEaXlmR0eCE7rCg&oe=6AEF321D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hftoCE0szNsQ7kNvwFhS_ll&_nc_oc=AdoCb0fKcfzuRtDr9Fncqnkj2Ny_0mM0cT18PWzQ83f-UWhkvl0UqNwTrHTzqYbynCw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9TETSCzRvXUk19IDPm-0CO23wxOSk0aW3eyKX0MavsQ&oe=6AEF41FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
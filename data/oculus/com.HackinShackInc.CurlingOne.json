6Jn1TKutkgPx4YKAXgDnvv5KfCWIQeoDpFt_1vktbVpHv_zSD5fZeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGepNmC8WTXOG6WPH8cN9q2MGUue3oDNSSC3FhMjBTFEw&oe=6A788428"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOWdt15ehmUQ7kNvwGo8IN6&_nc_oc=AdoLXu_qPYJODOmUJH7U01xrMvjgLfWjZuDuHBPTb8DZAG7TUxNCbREoZuB6xJrtnyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv0FsNGLYjXzzbQmh_HKkQsMYsEdS4DChiYF13PniLGQ&oe=6A788B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KAn6V-y9dsQ7kNvwE0RDjL&_nc_oc=AdqIBqjNb6Lplmte5fWFdyoTPCDXnQJ5k_sVc8MVLQf98M2qQL_ZmbWo5DP0RZT0GUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRvCNPhx6_cMBaHwkaLgJm7N8ulxThx2obLNBMVEn4Xg&oe=6A7862BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
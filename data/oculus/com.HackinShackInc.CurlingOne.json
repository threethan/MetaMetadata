Kl9hz176qEa5SvMOFeI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwSy89k0_AeH0ZtC2BUb2ihzvRobn0aoG1mzVxmImup5g&oe=69BAAC28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkUAHniW0JQQ7kNvwEvntsM&_nc_oc=Adnsxw1XgLHyMBAqHTib7cGiZe7wnl_bDcZ2I3r-8OAvA5MrjC4_QfW12-6NF9a5JCs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFJic1uvuqRADsXAxmOu0ak9loZFB9ONOMbe4BOcoFbw&oe=69BAB31D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uym4QgFpNawQ7kNvwGge7Ch&_nc_oc=AdlN8Yfu-7T8wFEmAjuAoXyti2HbwFQtnP2s0o9sifjiu8QCGp-x_nNRUIHC7RsRoPI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsnRmCWmAARDSKRuAGd2RwXsB8gi6JoIMt3Y5bRwb7zQ&oe=69BA8ABA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_s
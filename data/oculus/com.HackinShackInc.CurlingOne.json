J0-3C19mJWkVHJYyFbIgiiKrcK2smQJG1lV9BJpSIra-Uj4-AY5t7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAzqV41hM20tFyPs9fOw5gScDGNvEELHP9Gjh0bDE-uQ&oe=6AE74228"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKFyeNpGdQgQ7kNvwHpLqEw&_nc_oc=AdpxHqYd6SmQA2-ddeAOokiDrfCk3EAYrQTi0fPBv2hH8ixpwE4Zl39r8fK2tN7-XqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQVq28WNPVY0gdwtztr3cYP_GP8JWS5nQ4CHFT-E7nbg&oe=6AE7491D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZH3ZHf-aUYQ7kNvwFPGJzg&_nc_oc=AdqJWItiHVayIqSQts7T3BUyGrNsdxdl2-seQUDUpyVlBlCsIOv-Ex4lZM4Ur4fX4c8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS15IsrgJ1HkFCpxRgcZFJn7U8dwzfMyXar_qEs5ze-uw&oe=6AE758FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
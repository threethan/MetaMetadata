B91zpbcUY32dPxTkpfiJ0Zlol79VIvoGaCo9C2zp51XvdTzok1WCBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37i793AB9H547Ccxx4sT0bdKWGlbGZuhzDtApbvDDErg&oe=69D50A28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whdHEXTWeZEQ7kNvwGQ3Ej6&_nc_oc=AdrWISOTn2lXPgyTM17dg8iQ8H1yX5XwevQycx4OOlDeDHGGI7OPQDbB3exALvwmIjo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MFhC7ifSQi8ikQb7SUuxu2LLLPToASI63dl3RjlRNpA&oe=69D5111D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmFjcxfOCIYQ7kNvwEawPVk&_nc_oc=AdpCJPNiCz-oiiNQHrOsSlqZo9HSBTMCexiY2J7D3c3eACei52SKF_1wgULdnJY2PXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dKz5NIVsom02XVMTpiXstiXSX_9O4JiwB3TwGcnSScw&oe=69D4E8BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
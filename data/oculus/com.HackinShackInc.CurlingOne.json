4eN_khaIp0DEqxdM7SLm9CpWk-nkv1RZc0UTBRSIntzomDER7busCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WJIeuSYE60F771EDDrEZ3niJ2fVTVSveHnr4no-1XJw&oe=6A0874A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2Gef_xQH7oQ7kNvwEzkAUE&_nc_oc=Adq25BLb-j5uKIdt80APxlvbwmrRV7QLjXFb2OeN43poXgTSODIOnmnR3TwmwAgYJFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a4oQMjXpFmlR1u3Z_e-1bIHwrecuOjzqe2YSF-GAofw&oe=6A087B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rePaJnSoW4EQ7kNvwETGh2_&_nc_oc=AdrbsaSDPNzAQrFcB11zYgeWlJEqu959wd3uxK5VXlnz_e6dR1h1QMTPkk4zF0iz0e0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63EurN4iDhZjP-baL8miG5nn1zRmWMALwmQxuguSiVUw&oe=6A088B7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
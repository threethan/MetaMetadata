Y-b9kJ86t-24SHdVV15BtR3ZAUFMfKfhgQAFWq2tHVbomCpOB1joCo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPDwVTHTAbdazrlDCY76tyMsaee3ecFKcs1WSCO6284g&oe=6A563D28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_A-BUVgkNsQ7kNvwGs0qOJ&_nc_oc=AdoKyqmCCivZHaXgMxTG3Ky1fjG2Lck8PKIzBmXULSs2aZC6WiYctY2ZU0zeccWLEZs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYTzx0ooBVisR6Op5QjiK_iyqFKXcp--C0FqAQtTixrw&oe=6A56441D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvO3i6Ofx0EQ7kNvwGY3mV2&_nc_oc=AdpG0yJzJvDaaxCB2GSzQT7Tgc8It2ReiEHMv6YR963q1FFNXpnnSxzx50-ItTVECPY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4vx_oufe5rDdHCvrTtXQcUBQy4AMh8WFFcujhtOw5ow&oe=6A5653FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
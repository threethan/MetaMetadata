f4OemITtuLwydhtMFmg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJPMo5gLy54XdMF0pVl6OrXCRoDNHRahu-1WNQtpAMAw&oe=69BEA0A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1UO4pGk0NQQ7kNvwEJGWwv&_nc_oc=AdlkNd1ikZ6yGbn6kpooY4iEXlBvZZZyPMSjAi_VUlP73aadQ1pwDRjxS5aL3LpIy0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyACdM0IBRkSzZSfpQnnUVc0CpMoGywoxe841_7XBEtQ&oe=69BEA79D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykASHjIuiigQ7kNvwEuRvHI&_nc_oc=Adlmth_IEHdfppEBP-s2MmtCGy9cjF2lQcsa_98-gwqZOR0py4olSA3DKgQOuulE5z8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIDCDtIVZAMNycYnYjjhtGSTPi1fRZfP_Z2iJ1LK8kSg&oe=69BE7F3A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_s
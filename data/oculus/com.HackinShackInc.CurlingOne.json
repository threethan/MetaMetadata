LIUC17WMC4CTKEq9vfbcyEo5y7q2ZdYPd-N-gV9_QZWnQOIqCf6Dho&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWemaSAPvR8Vj19dyTkhP2iIu47ZqfuW_os-khCwo-8g&oe=6A81BEA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypWb1AbPGL8Q7kNvwHBfNvQ&_nc_oc=Ado82hpToHxgKlFzyb7MlM6JNx1zmM09I956Sdekd8Lel_FFv4hPlLWLQVSlEmxJ-Ng&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcop3LAiT5sYCT6Ilbrb-yhyARPe8XAcfReZoztxZYIA&oe=6A81C59D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOQXvfJH0SUQ7kNvwEswlyB&_nc_oc=Ado0gv-V6erEo1tZFNwrvMbnAMtX4zjQ5-yT-f5Th1hqwB0X6M9Gbwm1fyHODZ9vL9U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoz_BxNetgeJmdufHZDHF385SVp7A_ndYre0mDee5Few&oe=6A819D3A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
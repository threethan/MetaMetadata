MqzxhBp3Iy5MD9VRePKQ2xqdu8zkduQLNflfp7IJSierk1Iu9r7DHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mx5K5MJkKw4CAuyDulcQEugUlh5ISSXESxg0XkTTj3g&oe=69F8A2A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osaeQwoojmIQ7kNvwEbq6e9&_nc_oc=Adpi6BWamMBNnkHAxEnqEj9TJR6f5bJ6JIt1VpS8RYDjtCiz9nEAdy2L5dRTw9ziJjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XjCM-HxBIXaMxjzTJKQN0HxGOAcEIEYDz9GJ4CWKNQw&oe=69F8A99D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD4p_zZuTEAQ7kNvwHr2dim&_nc_oc=AdrloJ7ApbN803-de0xXoTqLArsUkr2lABRa4Qm5NrDxxkuy_x9xOILItRAZ0S0H1LM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jNItGGrqxLsFu6hKxF3e5omL5XWT3gY-XRyWqdoTRpQ&oe=69F8B97A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
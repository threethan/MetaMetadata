wGSL5RpFWNOjcPjxVpynWGsADkFRSlOcGwWaVZNKLRF39UzPVuRulM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wpaNREYJ9k4bgTBy68lIM7vb6ZImpS-ABG7aNFNKFLA&oe=6A3001A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oVHsUojC2oQ7kNvwHJ6-Xb&_nc_oc=AdpVzitedxgxtWr5YutTri64YB3c0yCBGsGJhEURkE_Uj1r5_bgEMwyk1HBf5z-owwc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NacMDWcVfsqZTG9HqKQD2kM1phbSW0r5h1yN9jGdfNw&oe=6A30089D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BB6wTK_3DoQ7kNvwG3LmPa&_nc_oc=Adqv-dJwFMAjSVMIqudNHfl_u--o6ZrnS05K_EFGgYKTv5H-GE21xyDxcPfL7dXBM_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MPlcn5QI76pnzVhXzIxpSKMBMJPQXepdSEoI7aPV7rg&oe=6A30187A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
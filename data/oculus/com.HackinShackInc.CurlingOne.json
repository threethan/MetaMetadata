WIYKGznAbPHl_W47hvNUgGlq26P_nK6CqqrBIXB_kiqNGDetXw-L0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS4Ko-Oql2SMiXBtNAEkHGlDNjIg4m8HNGGDqpi0Kd5w&oe=6AB52928"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWObtJ50cGoQ7kNvwGLMk5l&_nc_oc=AdruMk4zvQnIBMOjVH3yiOHyrEB5fbd6GaG7PjPBiQWIDuPVXBN1ousaEsJM6oPSQE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp1AOHR9U5zuLmf0DkJuZ8kcr4P1uBymEVxGTX5OlS5w&oe=6AB5301D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huNWTte3heIQ7kNvwECBqu_&_nc_oc=AdqBq--e_fGDsqpt89ubFUfgwhset_jM7oRxZb1slV3iHPC_4tuaTgqnDC1pzrVvxk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3bk-x7MoWsW0pJfTaONZ6R_Uyf1be4BpWWCr_lUBHFg&oe=6AB53FFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
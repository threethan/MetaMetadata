9GPFo9Q6N3ks9tBgVlswV3kzjQj8IMzhK5bizl6j6WkI0gAHcFja0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2yv8lYdXC5TVOm1rzvOPtQ-VBj7mNMYdMBPZ_gEMiyw&oe=6A5F77A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTrb2n7ddTsQ7kNvwEhxQWA&_nc_oc=AdqzoHHX1suUZV7W63U3B46Zl2iwvh1xSlN_0RgnE7_99m7CNwoD73AtzQzMSVKW20E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5kfu_mnIwkJAaooIHwqf1km4Pmj3aryz3ES5jXt1JtA&oe=6A5F7E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-q-l3Cu3PoQ7kNvwE8FSbu&_nc_oc=AdoM2j-pCsZxxpVcuod0wM67_-CJYwMGxxXHklZGRarq_ya3BuMk6zpaHI1OTzljoXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpXm0v1JpV1EAotuaCQ-q0RTnrUZbZby8initGG9wK5g&oe=6A5F563A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
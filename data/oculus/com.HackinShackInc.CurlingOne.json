4DhgeDqVgHCQItSs3n_-NzBKk1ahjmMWxqCJcsR9ZlZlaYvdXBTeLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs0WX3w_O8riFcHfuJ9GNMOAJ6uf18y50JvP_WJnEA3Q&oe=6A9C1CA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAAM1Faa2QwQ7kNvwEEBuaW&_nc_oc=Adp91ni2A0rIJ_k-fMA1BdgOc60IZnp8z0fbkGDB_j1yK9qz9U_QKLqismeG9DtETAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZn4DOA8lPIID-Epqt-Xr1xGAOlurtvMvVJF_UPMNtdA&oe=6A9C239D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taoULIgOmmMQ7kNvwGsTAKt&_nc_oc=Adqtx8txS6lVvCb_yStO-39j6x6XaDW-7J65QmG5caxnBDTT0Eg3FQIDhasRbAaCKq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2rQ4ONnAsbb4fjc1wrWijJ_IlX176Y0iiFqTmEnKtDg&oe=6A9C337A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
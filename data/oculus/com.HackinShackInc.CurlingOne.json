9TqReeCgLFa66XptnVa6wgZjdicSqh61I2g5nxKKeszz59RfOHWxe4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QjsvUu2gBOinY_q_vYRSSNxLqx4mJF4Cipp3kyAoeYg&oe=69DF9628"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq7lX3Oc5iwQ7kNvwGecyjF&_nc_oc=AdqKY8lSMOXCx5rp2xNGKno_Nb8XkJ7LG3Wf1n13cLguFrOWqs_eER03pPrbD3PBFus&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TLZDnlOu_yA_dl4mmektJp1hLdSCrZ3nY47W_Ru9bZA&oe=69DF9D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBJm4-22_YMQ7kNvwG5HJZL&_nc_oc=AdrjiOwsd4AzrmM-irmgfEz1MNcfw-fVhYA8Q-mi2hBfY7tgg0Xo062ciGN8P0mhVQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Sc2nMjE2oZD_2NYHy4RQjcvwaKfEBkuF59a52sSmUwA&oe=69DF74BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
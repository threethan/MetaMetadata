nvDem5iHNqw5hphN7PUiRGfMCT6Hc1UAYW9zyujtosb9WlTEAlpcBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6jB_PL-mPA5gILNBQR7V1lojNHIkRBgeocX1epTsnXA&oe=6A8C1268"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48ac9VJsZFEQ7kNvwGKGtdm&_nc_oc=AdoXqfI38v3YRZPJTTAX0fgSN1Zikk_n2EkkDx7CgC9as-iloIpHWIsXgIQkF2Pk5Uc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAz05R0F66FbyXEAf8UykgO0TJYDhm2tabs7AYCXGGQQ&oe=6A8C195D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QOorcrWdY4Q7kNvwFk7wNs&_nc_oc=AdogujtY3YEyKrQnieeW1NqjU3EBYPTPUXTxMR0tISdwKXqfaODnhiA8P_Z06_QSdms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErLkzuUmnWi2bpqM-aR6Y3TZfbR4yqQOMeasISkZsXbA&oe=6A8C293A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
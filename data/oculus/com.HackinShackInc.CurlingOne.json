vc7l1geTE-lmhhky364yn8-eVIyJvcxMr1XOmQI8gq9UGvqfx8c6-w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x49xRfJosrLidrgFN6VaXm2HptPTWF8-PfISLnIJPFA&oe=6A0C6928"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lXf6SHNdVMQ7kNvwFjYj1x&_nc_oc=AdriqMT38Tei0d1m5wv9WV9ysf3Y_k1nU7Or6HdK_jUvpmr9rpqytOIRXXbqbzRYfY4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IX6azPOJeDjMvV0yQHMrmyhsh6wjv6hEjiSCslyZjDw&oe=6A0C701D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f21QyMERkG8Q7kNvwH5Giez&_nc_oc=Adr0tXCiMztspP_hREEhYGCvI5T3DiB7jGYmtUqThKpZYGNoZBM9tzolQbTxnJ-LW_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ShWQyjATM1M3DMo4abrwUL48ClYZgoKgN1mreDZXNOg&oe=6A0C7FFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
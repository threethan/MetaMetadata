MslQIUBUbaXKLJPolBp__DMu3a3M2DrLm1g3NzbRn4a6ChAgV4vs_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-XoCLyUKRWD_yFqBToG3drDwijTwoRoh4SrsuSKS9nw&oe=6AA7FA28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwHlIJK0KokQ7kNvwENiSgu&_nc_oc=AdryvJm-LxtVUjUcAeqitIvO74RUo1ViHwX4B3RHenF1kkupnFkI_VAmDTTp27jRb1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL67HR_sd1on47rReufshQBryyZR05SP_yJCEyICUqp0Q&oe=6AA8011D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plme_QTShhMQ7kNvwGceCn1&_nc_oc=Adpn6zedqVO1klDhmDS4QA5tj7uyBypmHA11sJ63xnfd3W5rfwf8Zcc0Gbo40P3Ag_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2fD3GiDlO_fU-KCDp1DRt574zpJPL9niATseg7S5a8g&oe=6AA810FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
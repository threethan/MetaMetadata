P3m7ei3Sm0bK7aGEVlIbkPHD8EJFV9UZZqQFbRSJyPYC5f0kzZHJ6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdra635qmyDWWMMvlLRZcwsztQjXKCR3lU-y1SQOALGg&oe=6ACF8728"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOyKdBLJO28Q7kNvwFMN_hd&_nc_oc=AdoNgjsF_0tHJwrUbj6RGWGCNv5VaLWOalL8MbQ-fYuEf_HIqWWTgWalFrYAc9c2EUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNblD1qJeI7iTUlU2fTX1KTJtd2m9PL9VuDyHxtwmpORg&oe=6ACF8E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6C-jsi4S-UQ7kNvwGqMkLK&_nc_oc=AdqpfbtUFYYYNb0PyxjHPBpmUTQ6XVbZx8UTgX-q-Jk3KqQZtHP4ePz12pyALP4pByg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJmNChlDcPdYrCJXvA0gQBkRkq9HgZ5Kvt1RwGekqWQQ&oe=6ACF9DFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
yMoWcKFDOFdq-Y-eKnc1ypiM9Z5xRH1Wx2PjW5v_puUarGGpeia9tc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAHMVrne38j2AXBFiwjaL4BLPHvTDZEfMnTML5-RSR5g&oe=6A806D28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypWb1AbPGL8Q7kNvwEVxED_&_nc_oc=AdrK63FSZEhX2ZGZyX4raTX-WFF_mC_4D2pHC8i3luLpjz_Hu7REGY0eFkH0rJEgOK8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx0uZmTgtcRyS-Bbdr2cJFCLel7rvEbK8RTjmRT1JugQ&oe=6A803BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOQXvfJH0SUQ7kNvwGgPXk3&_nc_oc=Adow7N8-MELj3hBmnk66fxnjFjLg4xnM0CXeOTh6N-muy0XtRNnGGP-zaEAA91QmJvg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtzHiZwNNMpOPSFVBroYWECMhYagrCk5Hcm5jKcunL2A&oe=6A804BBA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
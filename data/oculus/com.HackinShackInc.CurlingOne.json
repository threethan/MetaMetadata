tIIhJUzpMAJ6jVf2kLaHw-6nZK1fxuURXxcKaKgk0y3brNORHeyfn0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nX1b9wPrhM1ZIf869X8mPQ55_5jJbx9tWx_cUvGoMaQ&oe=6A32A4A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oVHsUojC2oQ7kNvwHJCH0v&_nc_oc=AdqYUvv_sTtDot4vaGNXxx5P8UcIOG1QuCPMRsNTZh6o41D3IxEL-K7GhhkH0eeJBng&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fc0bBvepxSrTxYXLGjFl4mT9yB0f8d6g7cPMsFW4YpQ&oe=6A32AB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrRCM6qYoLgQ7kNvwH7uVWk&_nc_oc=AdrclQErR-Gd2xuoCM1_YZfo63BdjiCiE3Sl3X0htpYuYps_CDkvz9QC55TQTXpb5wM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WIdfEatxFl96r93W8heSCyrp2-L1uBwwmjBbObw1l5Q&oe=6A32BB7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
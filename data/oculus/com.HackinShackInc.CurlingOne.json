aIFjWDUyHYTCEtAKw8GZ8ryN48WWCj-ZRlgRT_illFdn3xTbZPROWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GcIST-CQ2A_0_h25axWgnoty0snUoNE7MnAP2ANQ7Ew&oe=6A3D30A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkBwyxqLoEoQ7kNvwFW5sSw&_nc_oc=Adq2R2gE_ErtHGi5jl35nXbit3_wUpifCXO6-Z3sOEWtpF5pP6lthc5obFX6JsN5Vhg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5cuqPg9IUqCuc_Bq94zWKTDuzMWmznaeJIuwCu6uXSA&oe=6A3D379D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpBL2IPEJCwQ7kNvwEby2LS&_nc_oc=AdoYh5zbUbArvAXru2jTHBj56DxyDOsmMmrhue8JIN13MVnvcZf1v5jlQoK_s4bS1jU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y8_5WvmqfYacHhPxAqwLtMY3xGZzYXbYYogxuCsCH5w&oe=6A3D477A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
aWwoAPLhatuVolKq-D48METD_8soMQ3Hi95r2-v9mamSOzYaxcQvx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHRhYHHoa5Tq6Rwa-5ZEJRTvpoRFyBDXMyIzXn5hO8Vg&oe=6A490E28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8ODaQ295sMQ7kNvwGq_SvU&_nc_oc=AdpAOZBaSj-87Y110AgQT6wiUYw8l2rmnoCmf7iRTEbW8y9Vx4vMguaJU_4D4ycUtxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcx8ktwHAUQVaEAcO_XEPjDaiWZITAo-B5Gsej5E_j3A&oe=6A49151D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf_fhXgz7csQ7kNvwETXR1u&_nc_oc=AdpNtPIgXP4Gqx0SSbU5DE1biBx3_xlGXUObzZ-79Uj_OLQAk1i8ldKsrpc8m6SL3kI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcDQP7jsxmHMSOzMDYaOmJyaII8lYCPoLDfM-2dM2CPQ&oe=6A4924FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
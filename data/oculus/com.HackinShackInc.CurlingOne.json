npNL7_Isy1s8zorrv2v2CDtzx8r85LPud92wtzX5UdJI3uNCUUc_O8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD26uyW9dB8dGm4IU6defuCqwo_EFVft_J95vV-1OEE_g&oe=6A5CD4A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4PZiF4JCNQQ7kNvwH50K7B&_nc_oc=AdpghLuB26hKk2TUwfgNyIVAuMJUF90PKTeqqgg4YJKsTHyDYn-GnmH3KPsjXly3_Z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0LfoDY6d1p3srucKFbYzGuDF5XisJWKEhVJWCd15tgA&oe=6A5CDB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-q-l3Cu3PoQ7kNvwEiDelA&_nc_oc=Ado2nWoSlJ14bYgvgFjc0JjynByvSJ82j2WuMT02Ixq_mUixAimUk7AGi70yWDg05nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUyw82BIgvqxy_u45XTRSAxC8-LqR1NWnCLPGMM4Ba8w&oe=6A5CB33A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
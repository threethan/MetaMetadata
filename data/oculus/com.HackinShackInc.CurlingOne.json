myTMsDUb34L0bYjyV6rNaWYRP-Ci_UwDkglKhHiW2xTuAs3NAdVNzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR6X--4JiPNcfZWMX8EhyU1sXwwq6dbCH_BosDFH697g&oe=6AF0B4E8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipbwE77smo0Q7kNvwGymQQO&_nc_oc=Adr15nCsg8dRZqkNCU8a-ipwuwCc1iAXmLwaDQ2obaAPhRc4NxqPJVdterIKpEqhzhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTED9MPdz1vhZU-v5ZVyjIynvb3NiuEe3RILSxq56ZrKA&oe=6AF0839D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hftoCE0szNsQ7kNvwE3VMNs&_nc_oc=AdqLwKLfqVvhVLumArNZLyFECF0otlgkq2V9X0zB1qw6hF036UyDxeXxo5IUvgUzI70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTheNgGgbL6qjFtH9VQ-hjGQnUVC5KpqVVhRr-_Fypqqg&oe=6AF0937A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
1uXEobtCf8_mMZwazy9JceOMeaXeXhagNJZ-45262eCpJEizmum_tw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKThRkNj8RRUb6Xje_i4IVQh4M9l-GHI1MZke-GkggRrA&oe=6AA01128"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0qbN1x3gYQQ7kNvwEygfTr&_nc_oc=AdpLdZv3oIeB264FA95-D8YkXEaqWmL-fOHAHeKp0BDO_Ua0SnctKce5N5IOjs7SeDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBTP9JVCrwh4-HXxCXvuwVUkRgLat28ig_oRkGRybJLw&oe=6AA0181D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEMNmNwWGIoQ7kNvwHEzjov&_nc_oc=AdpIJt1tm7d06JClfgLziWc063AQ3Hm7_gVBIlI5SjprBLOGX4bgOcqXvBaWMHRtPYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHFXHE-xWP4VLtksxHNwWabmb8S2KmHIVaG5Wyn0v9gA&oe=6AA027FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
gtOjhEDzEvxNTsj9RESYfmWOLOxOsm943p5utczR7bPj5Un0IA1gIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWfh4C5-X8ySzn1VmNqccp2dEmkpmLohuxaLoIFzl6ug&oe=6A68B228"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HxXt6P4C-MQ7kNvwE6MPaB&_nc_oc=Ado4ENOXpfeNhrKbPJ5-J-FHKYzB8K1vZowzRgeN0d3PIDwHUgOImf0yILroI5F_Hgw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ-nR4NA89nid-iLBlF-VgGWyqMtN2KQ6C1PWLH11bMQ&oe=6A68B91D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhp17o3IjXEQ7kNvwEHNSZF&_nc_oc=Adr_uS0HO8UOVQCR9C49TZQSIBy101UCKOGpvLLl7fWY9NuTSMzeYxMQMnnycsv7ZJ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzwe0H2EQE74CgW04yQL2vSlFpofgentJCZmY_JDysaA&oe=6A6890BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
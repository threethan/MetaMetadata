0_AQUt6PBb5kos5Rjb5WSgnOLh4OWNyX84qbPsHuePOxmylw&oe=6B103B73"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One -- the closest you can get to real curling without stepping on ice.  Now featuring multiplayer capability with voice chat, and enhanced graphics.  Play with friends in a multiplayer room of your choice, or play against AI.\n\nExperience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  \n\nThe advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented.  ", "short_description": "Multiplayer curling is here.  Deliver the stone, sweep, and discuss strategy with real teammates in VR.  "}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/privacy/", "developer_terms_of_service_url": null, "publisher_name": "https://hackinshack.org/", "support_website_url": null, "website_url": "https://hackinshack.org/docs/curling/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "41118419954411616"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031595_723424289474777_612179489041818709_n.png?stp=dst-png
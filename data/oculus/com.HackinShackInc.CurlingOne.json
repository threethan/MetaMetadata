v2_NA4phbpNeAtD77d7bNnvHgWFYpY_uoAI1KnyOar6JXPmS40QkZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_1a1sSisG7r3WhW2DbxxqU8Glwbxb1vAigM_I_WkRVA&oe=6A2EB028"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9ffk4UHg9sQ7kNvwFFmkNq&_nc_oc=AdqCoqku_o3GCx8k6OUoEGVhbWT6SErPr-1w6iM0JygwMvGgLKqWDFL4WoUvXjqsoYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iy-8MdfVHauCrLdd4ZIztehu55P4_VQ6VQPrUh8b0NQ&oe=6A2EB71D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BB6wTK_3DoQ7kNvwHX3Ee6&_nc_oc=AdolFs0OzEIbjxPu1-YmMLnWrQTg48weltrqWhyr7i7P_W0Amlmr56vfwRlELz3Rw9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VvmIYjxZuhGCW1aHWp9qZragf39hTLLJFUWAzut54Rg&oe=6A2EC6FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
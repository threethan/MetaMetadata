E0aZAwDVH4CnQ4GO586MphJT3pveZdaBTUG7T0NEuHU-ff_7lvhUhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a8Ydde-djcfliPkqdBSM8sQC00pTeKns54JjaNrWmcg&oe=6A1EDE28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1rzQSPOsLYQ7kNvwGVZXki&_nc_oc=AdpcYcWpK9svDDwqhtAM1bdPFtbtwnIQ6AOVvcGUM922h3CrC8WM9bnhOXq7cUaFaoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UR7h1gnXFnv_YmO0m2utOvtuTaXXKRq1wpIz8p-c9KA&oe=6A1EE51D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5xZmySZAkIQ7kNvwEOXwsJ&_nc_oc=Ado96eqTkKaoFT_UuJwzTWxNhU2-2f9xlDg3i4l_gwkH_1QvJzK9h01r_7DwZSalJCo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kZA11sy8gQ_mK855dl5W8POGba0IIQUoZMKvl4by6Bw&oe=6A1EF4FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
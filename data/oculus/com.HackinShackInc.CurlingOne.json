-aA7Lt0Q8n4SEHnu3WTvTxpPdVjN3muSyrq__IJ3UT9aJzlXQSf1SM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6l9B30AdKWbZjtZXW94940I3NHi_OkLJ0NiGfxrA_uw&oe=6A636C28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddekL2QKJRoQ7kNvwE2hDU0&_nc_oc=AdrdMnH30QQ4QoRmPf4_R7uRWCa6CzNTFIDUxfc--IiBHPDGNp83oOOq-cdrlkmWjbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGLNFyxVM0BuACrS_gkTfgmFD76AmVyFb2T_wjNbeiyQ&oe=6A63731D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8redEiPqD8Q7kNvwFq0MSC&_nc_oc=Ado5HxqbvzuEpP6hYMRdMoSWlhnloVoD6HE4PFjdzxVB1wRKKUDEIzO-TrP3mwkFY18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3sS04RMWqoiCo3C9tf7j5Fh8HLSqRRgaaJ9yqb8iR1A&oe=6A6382FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
71zgT3EbIxQZ2r7DEKrZhSVohfDTmFBhrylYIUvIq79kh5vfox_X54&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdBV-mT6o5F6XPdKxEZs8EGK93DPhirNq0e5EfDIxdRg&oe=6A881DE8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHmY8J6ZtQYQ7kNvwFMP6hI&_nc_oc=AdpQU6oEk7EkiiHg_mc3ORgHVO28ACRVya_icSuCHSTbD4qCH99UkHKzn1lULs74JSo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgHVGOqf1Ux9I-MmqVragRwL1_TpcQg4QAmJlHOGaTBw&oe=6A8824DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mYarAeNWgkQ7kNvwEr-ngh&_nc_oc=AdoEVCcIVoHYuQtdlcCXceYCBuFMsBbfTHTw9TzI7fcwWnCZ8svwVwitjnWeunHXz_k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpgXTMJoXluLZV6cqZuEknJYj1WvCPiQdzLhlAp3Kifg&oe=6A8834BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
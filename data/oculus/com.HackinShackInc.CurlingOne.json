pzQ5jlIh-JBXQpxyDtvvVe3blCwJ1k4Fg7_N4Up070EcdHq6XvXxrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ju2Di6-WAjVZ-GcufJ1dI7o9N-EnAMDk1z-i05nkAlw&oe=6A3A8DA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXbqETZDXKsQ7kNvwHNGHs_&_nc_oc=AdpirEnn9zA_2ZJhHxBaqS9wEgbK_yazJbluE_KgSAgF0xYveFIPWkreQ2ZQzcdAAnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U090ugdX_NqsrG9qaz1z4t_rJpwFvhRHwlatUkq9v5A&oe=6A3A949D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sPIle8rhq4Q7kNvwFxfnH5&_nc_oc=AdouU8yhrRjMXOUdzXnq-arFjg44DgXserdSWAu84dluUogKUqhL3X-reZrzye2iZDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2nkgvlNZYnSATzgityc7nD10Osy084mVGJ9VWCPbnzg&oe=6A3AA47A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
wMlWG11HLX8Moz0uIk-LTVgrlq3c9DONyxykB6vrY5Urm_xUUIyT4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp-u2dNjpsfWM-lHZFJc7-fGxgt_TAOnzPPLihC3V5zw&oe=6A6B5528"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=optceO0ncykQ7kNvwF7qEXo&_nc_oc=AdrX6H85nlGB388Vq_bZimHmOlFIEnVPoq4QijAp5r7bBpC_5I9HJ9HCmpFVXXeTuKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTPQ2Sr9X8rsSKMZkhgHzpMBu4p5fB2yp_EANb_gbGXQ&oe=6A6B5C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhp17o3IjXEQ7kNvwEtomj8&_nc_oc=AdrCPieZa5sb8pRfel3Q1Xj0ItrY0JUcPg5L0j1KPnkg1cjR68YiJEX9DIRbiSVluCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk3QlML7jk-11hdwcPjAhabeZiTixjs6gTg2pMCQ585A&oe=6A6B6BFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
2ydTLx4ix7-tDtJ2OQlOCrpiaqP3ZsMY86kiVpjEzBCDd7K7UU4_-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xj5rPmTrfwcQ9u1aTrbJFUAnOoK2-cwrNgAs8U8SOZw&oe=6A4519A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-CSRyueOaQQ7kNvwHPcjkX&_nc_oc=AdrGjVRhi4W4vfZupqid7DzEAOv3W6-9Fm6aQsCBWzkksEQ2JvmzgM_6MtXX92w6uIs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af827gLayrwAiV61gN9HYdKwIJX4wHTbLkoEeJnLI_Lufw&oe=6A45209D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrNRTD7KK9sQ7kNvwGgU530&_nc_oc=AdpGK4iysXqbvzMStIF3VTP3LLL84hw4cCHhZAKOEI1OruzXEdklfJTnZ5NjWENiJmw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MoCaSrOEo_g6gRTbLxCwaBBgnG8pPzIyS_8nWzrSHgQ&oe=6A45307A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
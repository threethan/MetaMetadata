3gkqIiia3IFK9Fs9E6WjoGaZ0C7owTgB7mVYiZeADZiBsMg64fR6gw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_UkF9Ms1J6LJbf4O7KENMDWffzD8_o933cy6A6_LrDA&oe=6AC4FB28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRaCDrr5WVsQ7kNvwEWnHNY&_nc_oc=AdodPVcxDlWtaMZHBgVnz5O5HJBtMNQU5M2vU13eXBF1N0u4YAWktZqkK8M6TknQoFA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM96keXpu6j9KHkqRA5NUAEk7lC4z4IoYX7Vf-7N4D9xQ&oe=6AC5021D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-ALuh_bzfUQ7kNvwHlwcz2&_nc_oc=AdpEdC0i1ueYS_1At9iJEX_t_UuSqf1uIZ8_sygdSuvcawOJy74P4nA7Yh-13hJsVB8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwrGTCbDEotHKW5yY693fSNNejeZ0Kr_O6YuRK7vefrQ&oe=6AC511FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
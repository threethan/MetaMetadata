zUUQ2yuc9Ci-jfLGJLlJVa4wF5kEyQpQQhxC5a4UQ8oAlDxh1oGI4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDZS0P0vORyR-C8rZ7thNdizF6yZo3VY2vIIthqppkwg&oe=6ACB92A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AjYJHt0UgsQ7kNvwEc0glW&_nc_oc=Adoybpq3t4KZtv8YqLj_HCSv_zJvXr9gfooJS_qciJXHhZ1OyXytd45z5cUZgQrymCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcgmN08MRo4F_bLzp-QlNwJaS6M3L61UfXZga8Pi_fgQ&oe=6ACB999D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYf-rzVowLMQ7kNvwEkqKNt&_nc_oc=Ado7RaVR_1VXTB9nqg1wK8D9XfpL9LZ-_cbnHHiBfpzcyqdGf-Z7u67x1sTuSqx521Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLGZJdYXufnqptNLFd7Zur05sXwnfETCKJeJ076OEnow&oe=6ACBA97A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
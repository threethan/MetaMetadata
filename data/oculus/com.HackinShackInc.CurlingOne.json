t4.png", "id": "2464972843650350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569462_2464972846983683_3021874364853938094_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11Kuyjwxw2wQ7kNvwGTl-84&_nc_oc=AdoCl7ZVcPdO8AZCpAMitrSu_QCpONPAwIppF9J1GdMXDItSgcIhAf3oFOnn9V-kGmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFNnpnUvFaB7Ts_HdJGSuttcEA2jKllaTst0UpvaNsog&oe=6B047B68"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlYO2-Msh1gQ7kNvwEWSNCc&_nc_oc=Adrd92TTPip9nkXFB4soEvf7cA8QqLKYLw9fmUEOSGvhGhy7h5p0RvnJ5ETCq1GsICA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm0yhfhGid-cSu2Xlndi2qLjtJWAFbmq-Kc2DTTolUdA&oe=6B04825D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESBWzlUCqBkQ7kNvwGVg60C&_nc_oc=AdqCP-l8rkvWOiR7pl2Lo5G2wQZ39d7nW0TpavZzJsgCOWiyStCHBOzYuUdoIe1bzBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7rYNerIoXcoaNBt7C0DyIY2I5S9HelNotJh_RofQysw&oe=6B0459FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_service_url": null, "publisher_name": "https://hackinshack.org/", "support_website_url": null, "website_url": "https://hackinshack.org/docs/curling", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "35365661276354208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031595_723424289474777_612179489041818709_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irRhudhyYAUQ7kNvwHzmWa6&_nc_oc=AdqSy8bTxj-xcVNdea795k2AftBD0E1F38XRhx9o8yAZjXrNYyqOvT2brt5J5TehRRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiffugTUuOcu81m_5bAOwgxF26jY_2G7afscCTYQWimw&oe=6B045CA4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Curling One", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "277654228
IrEzfMTiADxIA7xLW0uwHf40OHwfu9Gm4my7c6i1XWARTdGDUay04Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG7DOhD33YUnL_xM7NQp7E62bkNlaRGzuwYy43BJ09IA&oe=6ABBC0A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag6CtqKXxG0Q7kNvwHZiehJ&_nc_oc=AdrQu00VHqHArAgCTpIufR51StjmGqm2l5vNGTNZjN0wecBtOGI-GU-kdRh-vsafaCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbz5Wk7kwHxYizRCvD82a0CngB0u4omoe2743B6itF2A&oe=6ABBC79D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFab1_Dmz9oQ7kNvwG7EPFf&_nc_oc=AdqV6bFVu2DeweJySNSBC5RjnoufpRQpviS35LxDfM193DW92UlAJprzHI8KeJizIdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnq09dn858_O5_04MYpoTS3Wb4sMng0i7YLjTpxPZeTQ&oe=6ABBD77A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
bO_GvDHrXtkTotfAc_RzSRwMi61nvEoavK1yF1PPc1DIPWaXJTkqvk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL74BbPUZhfJElFWu4jTbrPQlAMSR66p3MqcIEq2AYrQ&oe=6A974728"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKoO1T92tsoQ7kNvwFKPP71&_nc_oc=Adr_JXwA_H2JDVyqLPX3J8C2RxNEW_tGRX1inZSLJZybnptF2AArJWea-15XFxSWEmk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEadtT5l1UBmoSo32TQQ-M0OEBzjKclE31DK2cf1a5q0w&oe=6A974E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuMHZ0UC4RYQ7kNvwEPiNYN&_nc_oc=AdrivSKdXS1xH7JOyCa91E_rvoJ-_t5uZpKpwXynH3Q9mARywyWjR3-5VLBzq63al_Y&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1R2aCPqW7VuiCKtEsHWgWj0nvALonVga_xeysV55ZAw&oe=6A9725BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
yK6QeczFt747-_Th22xb_buatLWpCtaVDkY6Oab3MO8SKgc-1U0Udk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zvllprovfkT7QcrQODzzIVfwo7MfAbF_qzrP3jJGxZA&oe=6A05D1A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOHsomG0_gsQ7kNvwFpYIDX&_nc_oc=AdpaWYVDDJ9_WDZi9c-9TmLpyuGE5yMluRbAe8ywn9UJnO60cpGtZcgl5-Cml-ZLNdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MZBrzBEd3eC-_Wzkxt410as2S75Vbkyfk-M8ZEThkzg&oe=6A05D89D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rePaJnSoW4EQ7kNvwHZUiDV&_nc_oc=AdoOVL7uVYhjNWEawydL_b81R5IUp21GBCySbsjjZidEO-5In8B5-4IzO5Um3QZ2gqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42gqMZLE0TkClY2jRwXUr1Sk2rjTHCda1bZ1gllammAQ&oe=6A05E87A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
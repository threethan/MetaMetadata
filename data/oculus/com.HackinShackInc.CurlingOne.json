UV1DxmZuX6Y8r4vYFmEEU6AIhZXva9esROsOuvW29caR-LnYjwK3ZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsuetlds4yvnRTgmQe0cIDd-M5VkR3qHD8Y5aLQv9l5w&oe=6AF20668"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlRbhr-rlmMQ7kNvwECeO02&_nc_oc=AdoCCp38FgZGUzU2IUXbxmIu2m8gPaAWfOUisZzykR-IrDZjgJKKUPt8a16gLhvngO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg-3xornQRjqMT4hsBODicqKlPhlMy1INJp4W8yHG3Jg&oe=6AF1D51D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hftoCE0szNsQ7kNvwHO22CA&_nc_oc=AdrYfcSZxZzGbxpRZDy-ZFxcEpnVGxsQkTyGLKagCq23gx5ZDHz3h8EUFpwpIJcYkpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWfHVuFy6hd8vePh2V_5uvH-FY7RVONrrabMZR0fy6Tg&oe=6AF1E4FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
uBcshmyzqJeWn8n86PoBodMZtmR1A60u-XtsXbFNYI_H7TpnaGSesg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G6JltGyH9289dacNolPSAzfHr-B3sz-XXokj3uVLC9w&oe=6A2575A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-e7FAHSgswQ7kNvwEBCxqC&_nc_oc=AdosxaKrkcBMYQ0fLWVfaDMKyQp8lNCWK5qcZ-uRy37a0Wm0pTsbles_9aTexhleVdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tGHi77x6H11dLBwkJ7dCIiv_BnSh0aPmrom8InAbYMw&oe=6A257C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOCr8VgD7r4Q7kNvwFjLgtB&_nc_oc=AdqZejkgISiKHKFB_zrNp9ezgxUjM483kU6Q4aUDCVgaT_CcD3vhuKe1IMV3hvRup5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JSthO-OC41V4JiMaX9lXU5HythGR0XgNE00NOX2wEjw&oe=6A258C7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
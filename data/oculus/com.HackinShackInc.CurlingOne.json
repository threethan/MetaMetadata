eKUeBU5KDT7Wr3RlEK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9BY8u-NM0_6KIiUZ_tyEt36hkxLMZMTngndgseoIX4A&oe=69B2C328"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTo1tT6ERE4Q7kNvwHAszaE&_nc_oc=AdmwADyAO68-_9D5bFpYTr2ai1fse_jSSOwCMXbVIEeiZK8ZIigTq28uSOokYJQ7nK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSsmWUP8bD2m-jZs5RPCb2kP7lg9Bddsn-nrPwVazajg&oe=69B2CA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH7Epd8oJTcQ7kNvwGsRS8j&_nc_oc=AdlRpEcuC6V7LpdVSgQRrVnaPMsAmW_iBR77z7K7lRDVfj_u9TIi-rvKSTzI0Qoe1K8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFEyJH90NogfZ4nXtWhns_feGurJV2GCygpA8NvJtang&oe=69B2A1BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_s
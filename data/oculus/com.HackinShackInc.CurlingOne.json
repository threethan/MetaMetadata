srGdmwCnLU-0ip98X05VNQx-mMgHIyv99QCl7g7lCkQ3N_8j4QIf-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9me6IpUAHG1Kk-_YwanGbE3W4mPDDi_bw5tmgsApTg6Q&oe=6A412528"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aj9pcvC9HoQ7kNvwHf_EEo&_nc_oc=AdoEon1bDhsRw93hCf1TfPoSudrnA9fM3XvcVYgJh0WU2GRwA-mrqkPOUEPGVAs-ml4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7aNMzVbiu-8OD59umh_fcORI4TTNtfEEZQzgw5tfxWw&oe=6A412C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_2mTSJyB8kQ7kNvwFDRB9X&_nc_oc=AdrioUyNdZaG6ZtD2LHVoZ_BNEM07Sk2BamgxRsVGI0Pl5jkMe_LlQB1OTdlfkvQ9MU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ydNyPKuFuj3Flj3cJNgbEAzJunIDHKwJf-GVI4cv5pQ&oe=6A413BFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
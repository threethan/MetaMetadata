bsEEXlGJk0ODH7-O1wvD5JEOEmx0S9zLjGW53ie4mbATnxDRJz4-5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwr2jjsjjjzR-YObtLgQ_rhQrkwgG-bOq54N8ZRc_X5sA&oe=69D115A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxUzQMz3C28Q7kNvwHwejcV&_nc_oc=AdoCy60uHupRoZoYZ2I2bhj3we87CCvKInqvOM84PmBhzKsNmi7-HaluZtUbyhbi4ek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVlEh_kiahMaSPGBP7OnXnEL-7KjmlVwdta4UYP98alg&oe=69D11C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kxKHdFNCmwQ7kNvwHPcsfH&_nc_oc=Adqap6TwqLhZaDCSk9EIKtF5vWYuODivzHTxtiZyHN4SgAOBridKQTlLTQMiEFiYhQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-BarEkmjH4a65J4jWHBqfixsrzBkKispi_L87eE_UjA&oe=69D0F43A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
BMDqS-I03e8o1H05e93j5NyKyVIk50zXVB8UgiYRh0m3A7PSSWCtJk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF0JAW-72SLxXTCRPHJ8KHZnvr_uczG9Z-LjhdT3W61g&oe=6A660F28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddekL2QKJRoQ7kNvwF8LFka&_nc_oc=AdrZ5H0nN7afNowyehF0JB5ggpTzgkMndQnOGMF5ByWa8dJrxJS-TvcWDn-Zzua0jgs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwQFKfwCLh7EmTqufzbziaWE-8VYqqvWHrKH8XWvGAdQ&oe=6A66161D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPup80S2VxQQ7kNvwFwseu5&_nc_oc=AdrhXlxFcDQqK6-ooiJCsJqes0DNJfeQO8KJmmoXqABtWGovi24hcXSxWAKczQxfSME&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIa4WSSb-mxfI9Hjm3qVamnJKNBmGjMZY4cDjX5FVw7g&oe=6A6625FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
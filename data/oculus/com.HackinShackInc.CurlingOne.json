8yvy5Mdvhe8J1OZZLSH5pK7tQlo99yabLlSeS8bKG-xWOK2Bj-BAhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4gZpT6w3aFXhVUPc77tvzrs9MqOAfBcPIo7M6x3NjSw&oe=6ADF5928"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwZhHkBgIrYQ7kNvwHFfj-J&_nc_oc=Adr50cUtZt3YpyBdJ9LYiM4VPc0Jb30rVR9DjDjeQs4L9gPrXv61LJ69tjUsTJrCp6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCHH8zGvpbldB4wyX3Z3A1VmBvV7TwRzA6zRAWxHEAqw&oe=6ADF601D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Osa6FcWRc9YQ7kNvwHE_hNV&_nc_oc=AdoVy3gJBI_3bbblZ5J30D2uEmsR-Ox-dP1O64CtW6lCIwiAqSgbQPPAF7ynHnwDmT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP5rUpPX1yStqHW36c-yhTbA_vpX6NTHrRTt69qnZadA&oe=6ADF6FFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
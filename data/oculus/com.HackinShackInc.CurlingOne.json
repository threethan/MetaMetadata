5McBjrVmwJ70iFBLrJX1ciaJTYth3rV7B7ms1XTIWNTLg0LB0s54Bw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29tU3HIuLevUHC47WGJFcxJPqYTTBG0NV4OD4k7ghYvQ&oe=69EF6828"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IO55-X3fsN4Q7kNvwEe_0cF&_nc_oc=AdpFDcM-RzSBO4iGo9QH0hQpTfS0yxyK58Em5Zi0OwWEXboADYh4gmU9G6YCyhA26eQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qKcrPtNgPCcRpyY-fKIaMHncgRYoicRo38bkE9Ws9qg&oe=69EF6F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5k7Wk3tBNgQ7kNvwH8CR0b&_nc_oc=AdqDqRJEx8z0xOOgTdTYvpzBWyyiIT4gX9sx6PkWLCqV5q6iY6EUEl22insB6Z4yHAM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3y4WOAlaYlp_IFTR3ooNZGZrQlhHxRBjTYKVbLs-Dx-g&oe=69EF7EFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
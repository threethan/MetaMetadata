kQ_gDBpam-kalIRkJyQHhkdTrpTN92KlNn7_mMgBafSUXT3ivosHOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T1VMBgemWx_-bkJ4Qu0hmyLx2OsOeopr893q3DZ6GJQ&oe=6A47BCA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8ODaQ295sMQ7kNvwFmf3Hb&_nc_oc=Adrl8da5-fvg7lMReuBb3C11QWExc3rmgJenmi5FZlOie-qe2wSI8817XWNyyErzgtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pe38FXNny7oOthaBtgM1y8A65K_sK2vFjx_t3Hphf_Q&oe=6A47C39D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrNRTD7KK9sQ7kNvwE30D5N&_nc_oc=AdpuiHdagHGw4ds0o2H3Nvxe1tfvzJWnY9MpzZhrWUvjFnBd_WPcjNeC9r3nix85nV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_76F3JdTH5OPnHmqo0_bmD8CDV3CS3c2_ZoOpjBH0ayA&oe=6A47D37A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
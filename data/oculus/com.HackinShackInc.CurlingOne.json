vvS9DIO-MLfVzePiP-3zogFNkQNHpiFdsvrLQNhYsUssMlX8Aig-v4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5haHxtpPopj4SuQb1Z-hBo0bgQI9KXM2WHSO-BUN6-A&oe=6A4E5428"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtG3JxSHyaYQ7kNvwGvScHS&_nc_oc=Adr17DoJtwn4wThmcbcg81CMg82cKs0BX5ANP1aHOfDnkrEjWQoi_F9FFtsceriMM9I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwH5Rqy-OM4m6AYKlNN5cJwKlWxbMNFzVBF7_pssZsEg&oe=6A4E5B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ9YaSRsbI8Q7kNvwFcBYG7&_nc_oc=Adqw2KyXGmOqAVSMevlclUegg-Y5Eck8e-XQYr4XezMEUbmEgJLbLh-5QksOhHAk-bs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxLUhTa1sZapkAw9495YTJYQPeB_8CmivaHWWsySjCHw&oe=6A4E6AFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
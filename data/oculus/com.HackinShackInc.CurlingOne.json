vb5gIx-9gsPPGp0IaSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLeNAKPn1I75d_WLLZ0Iw2mDgDs-L-SG4i6esnsjEZ0A&oe=69B56628"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l79IxdhT-6oQ7kNvwE7Zcx_&_nc_oc=Adl7mYfZL1UmDw627aOiiV4_r69iGBi19HchrKpBxweeAP5cP9wvbo3Wla8dTsFRvzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxlc0w4IMPsLOTxCxCWOOhIPXlfJC7NRTnVfbhrU5yolA&oe=69B56D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH7Epd8oJTcQ7kNvwHHU8mN&_nc_oc=AdngjwJW-5n09cYf7oabwx0Qmd3Hbwm__lAVvtpTQ_TOPJlq7LRc8TcDfdJ48Y7a3XY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx94py8cUA-Le7tWg_4dCIgUvsdyZ3uw_gS2AWA8mihTw&oe=69B544BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_s
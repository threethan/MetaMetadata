erhTl31XWEWbmkzhxm037H_hQGz87y2oCbmie8Va5rCkVsNjFJ_XQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnyuqkMzxfLPziCcx8X37nwiymqhrTlrJ2ZpzUETuLbQ&oe=6A5E2628"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4PZiF4JCNQQ7kNvwENxFdz&_nc_oc=AdpphhzA4-5nuAyexlEJJ_uueBJsponNDIrLfula-0TUBIJvTFAnPTwgnat9zC377fc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUfTdJVLBXi62EZCLH30bt87IKqEVtiQfeHnV7AF0S0A&oe=6A5E2D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-q-l3Cu3PoQ7kNvwGlhHhs&_nc_oc=AdrnSimlMizndCpvAn4YWvUCFurEDTLp0vdPhnOW1RRN0lrMqkUlzlrLmARMsXRWcpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALxBdXO2aZGh6q8FU5XX-YN-IUGFFeCu6kagUj0nyhYw&oe=6A5E04BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
jHPuJFIkyJHwYm614JhDEFrHR7L0QDACIJkFQtANVkbqyHz4IqYlbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_sHUg8OiwNXl8vK6CVAYCH-PXBNFo0LeFAwLDUj4ujg&oe=6AE49F28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SWaAoCXc2AQ7kNvwGkZ8l5&_nc_oc=AdowUiAfZHDWjCi8EfLoiCQiXYvUqWIKr34L23NEX6KdwDcWZBXNeEgaqlhelTT4Nbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7hG_ichpc3KpSSvg4cfR5--dmF56MDCCgPhLqZNRI3A&oe=6AE4A61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=men8I0-9E8cQ7kNvwEfCnRN&_nc_oc=AdqUU_3QtzfqmSM15cKyEsKFAPYloeL5GObcb_am1NpcvCyxNGeDnfAIr9NGSd3zyS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKHjd3z-0G1bY6UuGJtTYT7aDiFvpY1nrHvatlUpdnMQ&oe=6AE4B5FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
T5K6CPyjiAFNYWZLROojMKOh6VIc9HcFCL63x4LT1cEUm6CSKqsYQ0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FAJ2y39qkUSQoFjHXZRHwn6JDljUtdDmevx7f64vBbg&oe=69F5FFA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pUxkjAZtAwQ7kNvwGgirOr&_nc_oc=AdqqDM6LfbuIEecY8cPjC8ndtG1EWoU_54waCplA00XLCouYhmfwJR-RR4o8_CeWqb0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Sw9-SoZ84xWEn2IGfTCoYdTpQs5DRJMK7NIB-6jQBPA&oe=69F6069D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD4p_zZuTEAQ7kNvwGgLGfr&_nc_oc=AdpBTaYwXmLfGAFhl90vPS4Ozm_TAwoWGojnwEFmyKeAIblwVsX1THAvrVBJsMl24tk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RVPAExxPOzuuhoBIV991FUxt-4OzoK8dfwjhSFwFZjQ&oe=69F6167A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
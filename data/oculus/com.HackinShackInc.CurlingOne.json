z3cEplr_qTNfQ3-DAmFbACB0tvezeMq1JYfTiG_Kqx08IOAti0Jsfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dunP5WQNAEKe3TVNaxFJzPe_hfCMc38UQMtOf58tYnA&oe=6A145228"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co9wACmFR8QQ7kNvwFHtign&_nc_oc=AdptydF4JOku6pKPG1ykf8hUXZ25NR2axowKADzH7ySC9oNj-7vK3thdKGzb81y4xnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-lfHqW06YL_wk_2ZL83Y0HLvW6ME2n7H2efXTYuKkeQ&oe=6A14591D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W98HpQOyeQQ7kNvwGeYiHR&_nc_oc=Adp1yjSGNIaxMhuPdKFyHMET9UiAk61v3KWESPiGCiWblZpPeWRkgCnSpt_mdn637lA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UC58zYPcZz_Zo9iiPhSDmRXYgbjQX0ZyPelTU01WLTw&oe=6A1468FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
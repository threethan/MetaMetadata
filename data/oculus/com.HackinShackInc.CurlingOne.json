_ht-SENDCCmfPk5d1QE0HYFovZfExSd7p7s8Yf1qizs23Q9mBqcPWelUserQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2cDERLRxkmJ8X41jIs9Sw5EIglBbXkkfLGrSIFGG_kw&oe=6A393C28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXbqETZDXKsQ7kNvwE976FE&_nc_oc=AdqniNoIElkvoLr0FdeO1CiF_ufboaEYlKBy3EoDUtnIrWfAy13SV7_LsZm6e3TbMdo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iKA19FAfw9PIGZIzQ8GadtItZe3ByAmhZ7Hj97tBehw&oe=6A39431D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sPIle8rhq4Q7kNvwFxMqWN&_nc_oc=AdqjfrjwHHoIdF_ppuQzI7qUISvEmwJhQtHaQP_gVbNGp-6E4S3oMdJI6bsUkc0Eq3M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UMw6AvnXmiSXgNCqktoxxsZzOpbeB4gU5kw3U_tYfAg&oe=6A3952FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "htt
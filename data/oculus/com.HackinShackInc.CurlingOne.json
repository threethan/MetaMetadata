lhk6XtVqyk6qUnIBaEKuAeW2i6fnjGGyBynT3xrzBvU0fyWglqUnBs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0DudYNFpiY0_zwFTaJqv_2SSZZ62pPyi1pFOeriTikA&oe=6A58E028"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdgr82BonKoQ7kNvwEprXxV&_nc_oc=AdpwJ-K4rImXpn80Hmcwbr6Jj1v2fTAHdNJ-FtJAaymMA8BNQ1Iqt6GaxWesQKjfSPA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3_MO8uNVjnOyG8KU3r45oiuSVnzfdbnBBXw9l_mW-wg&oe=6A58E71D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG88i_R-_V4Q7kNvwFRAub-&_nc_oc=AdqqByAkYn8RFyyb6ZUB-gGn2kDYE1hifnGMuYpvtfmeSg15ADDmNCfBdwIqnZwxzT0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSD2--qQWnvK8cKaH1lLvqdsb7T0Uxh4Vg9C7Yz5k1sw&oe=6A58F6FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
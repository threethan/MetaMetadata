U4MG6FU4Y7r1ZxxMKL14cBLNyGvF2Jm_IKpKxJAv0uKpqECdvDsa_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y__ADd6x8KvG_SZc__H6fWEdXJRK17hW8IdVlI3w6YQ&oe=69F9F428"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osaeQwoojmIQ7kNvwH3pSYy&_nc_oc=Adpe2r6m_DlNNJN55haeDxmDNBMq_7iyYDU-kVC1RO9iTStEMA-33WKcBjyHXxnAFec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BFseRR52pmlp49_rMH-S-nwQpSBZwuHf8v0nxF3Qbkg&oe=69F9FB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0irwnzGYr0Q7kNvwF0TrWB&_nc_oc=AdrveEsiKKhABhGwE0CQVAdERkTk8_l0JqbhYlDDu7PgQKj8EsnADKr_DZPvu7DlCNM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wI8f1wq7FQtjCBho8ATKhiipyiE2ThunZRLMXpjI2eQ&oe=69FA0AFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
iH3AmYZ4k-8OzTe_R9E2Xn8Xgx79jAv76BuberpzxvQNYFd-McESHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsAm9AXiEv4G8cTB-xoeACPNufXbc7-1MMG9J8nPH9JA&oe=6AE0AAA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwZhHkBgIrYQ7kNvwHbnjd1&_nc_oc=AdodUIIk1dG341DyPXSkFwbeQ-MrhoUM1FGFKw8HzHhCDF_g3JgZjJqBpYsuFJ542T8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA827rTfSYyAu-3d8EfqZnCIkIfrA54ksquOkm4WgWpQ&oe=6AE0B19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Osa6FcWRc9YQ7kNvwH8WoaF&_nc_oc=Adqw7E6ZT3q1YWnqnEfyOHXY6rJ_xRz_d8X2qCCcnvNzepDJWrZb_98AInJWq_OnG2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp6IbVCqgHjTU6neyU1m22bWApPXwQcNzdtsq71YAdPQ&oe=6AE0C17A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
CGs12J6NCFXgGVZdPjZ0uWma-C5GdAOWiRZJxojzifGnRG0fX9It7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tB9gRWJ--GPq-rvjjurn37gTUj884cTnn368hw4hFMw&oe=6A2818A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPpOcoMtgGoQ7kNvwGrMNu8&_nc_oc=Adqu0_ATqJGurLDu4hVytzceuf_fCJPT3LdYqaQZGlTbmfLDraYqEa4s09AWSARXjXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jfU0EDfk4p5W8xONNAKaDOCIRBsZ5T6by8MvLQFBS4A&oe=6A281F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOCr8VgD7r4Q7kNvwGkkoe6&_nc_oc=AdqKWDt6kKiA89CVgIMPn8qyDliZ9cZkUl-zCEINcQ1oNBSdv-dUI4D11Qg6EKX0Z6s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D5V-RqTAZW7u6eDZBVAipK8JCAE9loVpEkE8G98Yjlw&oe=6A282F7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
DsW7VruJQhEOP2lMkWmVcoIZr8EhEQDeOajbszNGcocfJWky7IjC0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVbjRpP-WMmz1Y3gi_VpXWTceW9-tnbpY6j-3vPE7rPw&oe=6A7732A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOWdt15ehmUQ7kNvwE5PIt0&_nc_oc=AdozTbIe_jqaWinZrQZV4FIiepb7JX_Qg_aUxUSkbXx68k086lKhTSg4ToryBTxa3tU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPjWDyT9AJF8eDtBe3qmjBNj_-k0fyj2eOntZoV4TWig&oe=6A77399D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itWRvaa35l8Q7kNvwHOEzz8&_nc_oc=AdqgzktgJpuF1AcQ1TCtwgH2vICw5PDlIC3KsCo5idsbRwBu5PSOUGVmLhdQmE5IDb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB3y4OFiRnNF2rfIHlGuIOn_0LEGN-uVz6mHct_EePXQ&oe=6A77113A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
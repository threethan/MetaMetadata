jmZHziFM7rS_YZ2CWlvIKcDjc9t-ToC5HmB3Pk55-Ez4AwiURf3rzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eOKDs7UBGJQr0iDbgJwMopQvwzhaf2khHwM-uTq3BWA&oe=69DCF328"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq7lX3Oc5iwQ7kNvwGI5BRt&_nc_oc=AdpWPqOJWafjf0LGs9IwqivzJkPS6MKP4C73gYhEHurPQjq9FZ2xiXjaQPn1nhJEPrk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36ysSqxXAWL21ZcV5OM51fcZsrV18YoaO2Eu6z-Diezw&oe=69DCFA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8jPEcvTjk0Q7kNvwFYoS6N&_nc_oc=AdooUtLwjTdGMBRSmjVxrUuIPonuHjwErZNzQwZOHpXIHQVEv18olq4RHOdGda4I59Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21mrLNxKriMpiIs79edrT_A2xY6RBPGv9RJb5GPtkCVA&oe=69DCD1BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
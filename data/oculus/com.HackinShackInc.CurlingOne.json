VT41ajf3Q4OMo-UGclCosbgolAAA1eJu3FgrLlBZcZNNOC0cGU9czk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JEXfiiO1ure1IYZht5jiFgpdm9lPOlt1nyLS1MLAg-Q&oe=6A0B17A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2Gef_xQH7oQ7kNvwGWD8sD&_nc_oc=Adqv2HMFo0dwULFNUSBY3EIWUORrJ8nNKp9MieHy4ST3I9vZTDFXRBSFYnSKU5D3tps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_6UYvwdVo6GaC9HSlfBoOljDTZgFhyU6mouURruyRDw&oe=6A0B1E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f21QyMERkG8Q7kNvwH5KOoA&_nc_oc=AdrH7dzGuuCDL-QZAbcyirs0OEyX71IochruE2EoVbfJpV6hUZgEy6RYfjqRTxgjxpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55pYleyfQVmaCJ6QyYoJQxGCu1a9q4nC6g0ylJllYfyA&oe=6A0B2E7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
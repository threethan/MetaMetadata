-Kn7JqJsftxCF5jKMEllwH74jkTpBsht-wjQfrOJ2waxosH-8UerMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_IFOyeNc9-QX0YZdnUA6SKrVsW2MQ28ZE1CvMaxVB4w&oe=69EB73A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jH9ph8Xu0wQ7kNvwEmlQml&_nc_oc=AdreeNMgWQW9KTD5u5zYwXOViQGJWg7uL-Z0rQPQF1FuWFrALOmLK14cg4xvlgJCL5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tRUzxTfvpg-_5KKojLuEqPewr5v5K00rdOsYkb3YLDA&oe=69EB7A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7A9kNLoFqUQ7kNvwGK0Rmq&_nc_oc=AdqD8-bY-xPlYrLzCpbQCdWhJ5Rhvgs85Yku2ZwcVifo2bK30KUnQbUH-sldyWQtJWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CaAnd6o6Lt9QoFSuqvRJ2Jb65vg29bAXIku29ceCSuw&oe=69EB8A7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
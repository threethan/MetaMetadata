aDAZ0LRLsSJNMQAzZc9sih7ETEO8zG8dlRSzcHmZwhVld98NXsq3MvU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyLkV8vc_ZkrdMM31VSwJ9_OVcndbFjQzwZwwSO3SGVg&oe=69C3E6A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvcbxfNmkNwQ7kNvwFykreT&_nc_oc=Adp473V96FUtCxbnCRtIGjEXZpSikSpZ0oqUPL8Sd7CLgCqpdbkrNUzVkwEDykJEoCs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1-kPv93m7PKMNS9_qMBnFbPeoTjko1qLa0PcWu2BxNQ&oe=69C3ED9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWT-Fvm1LvgQ7kNvwF27UVy&_nc_oc=AdowOu4Q3zAzRHKJHiqCZoFCdim2qnzPKB3tPqcqJb2G_XDfwShJdf-pklLo_G68mGo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcIASAU03ajrIK_rUOW9MsKD406trSQa7bOCI3adNdHA&oe=69C3C53A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_service_url": null, "publisher_name": "https://hackinshack.org/", "support_website_url": null, "website_url": "https://hackinshack.org/docs/curling", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "34924653087121698"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031595_723424289474777_612179489041818709_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z9j9War5vMQ7kNvwEznHGQ&_nc_oc=Adp2UW9T8bdb6_EWwQMH_SjyNpqsUuu6H-hYk80F3nFMm8cAuIKUqVXcCoHHCei7kVM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtEeNl4hLBEvxsQNx6kFZjrcS1y-3Fnv-HWRcPRzMRKw&oe=69C3C7E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Curling One", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1680818385, "lastRevision": {"nodes": [{"id": "9443599828987041", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9443599825653708", "is_first_party": false, "enables_in_app_ads": fal
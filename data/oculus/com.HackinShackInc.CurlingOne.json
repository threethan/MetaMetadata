oroNOPts1DXhyQEbRJyObHCLZEqinD_k8ZnhB5ru9Ysj7pks5nYIck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P5yvnpOq7yZwUn8PdR9HqXm4ZSvW57ajsxvGNxzm_fQ&oe=6A296A28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPpOcoMtgGoQ7kNvwG0z50j&_nc_oc=Adr0FFTpdhgQ2ntfIC3poSDBsBw_xO9VEHda8ROvQoGkIXOueqxAV0Kpk6bXcuPawrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TFvUdgT-4gRbcv_ELopvXtYyavNPSvg6hguXnGy3i_w&oe=6A29711D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7ueuVIW7WsQ7kNvwGly4qc&_nc_oc=AdpWvlQBZQCbJazaOV9xjSkI5xbckTVkghiwC6tbRJjyOtiJqmmaGGQRPD6aOjCPueY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NVgSh1htTBCQ4zv50-3yzXdnfJHoWsrbDawtjMZUzEA&oe=6A2980FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
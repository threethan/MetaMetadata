KC4U9d7jh4LwNpK9od19-PzyYxotne6vT06Gzrb53gnounwMM1frA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KDVeihv1zx-kf7bCySfwFBSqYnLr4tOWJSwVIXoiQ5g&oe=69FB45A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osaeQwoojmIQ7kNvwG9vBtZ&_nc_oc=AdqUwl72EhDRKOlWEe5qFdeZ3Pr2lM1slTc6DxQblFrqiKFKTFTI_D4nOGNbz8o_14I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w6jmKiAnXzk7vBiK_6tTO8kTp7IWGY--jQpjClrB3Pg&oe=69FB4C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0irwnzGYr0Q7kNvwEsVkG0&_nc_oc=Adq9l8i-RUTMkNgy_qmPPqKgjh2mQd5bC7r5LmImEbNvDw0VX_em50qL-QFn0eEk24E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N0okaP-awZ_Aq3OoLdsoHkfHzb-HPpY-aO7Redwsz3A&oe=69FB5C7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
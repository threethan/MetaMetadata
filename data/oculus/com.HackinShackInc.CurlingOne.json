Sr26pUSq5aBwK-5Whua7b0x4Oqxns3LXuR0z_c76hrMhtONkeYH5rA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIziwB_R3jW_Fh__zy-rPjkcwvHoiWM_qT0auMCwQ8Qtg&oe=6AABEEA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceI5M23wPoMQ7kNvwHSP8ks&_nc_oc=AdrTwm0znfjGwBYRjRAmreeKCsWSo4Lzee1TqciXcx-i7ln4CV1ZhFX6qRgqShhKDLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLErsKD_tDR0EbTmw2F9m_gRlEtMBs6OdLykYyUXjzLOA&oe=6AABF59D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_otpP1eXUWoQ7kNvwENCUqB&_nc_oc=AdpvamCzFDmY1cnsoM1jspcx4YscRZf4Q0esTCcDHWne9GmlUTcKkNf8w_NX0YuL_nU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfFyKzTopSW88r2VqYFDRQ6qKGmpdcLB4NzufnRyn3QA&oe=6AAC057A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
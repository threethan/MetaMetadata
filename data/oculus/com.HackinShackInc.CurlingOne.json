hTMeJn31ZY1I56AfwJoQV08dov2n2vw9I2gu5zavvo1hicsSrQrdjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG3mL8dypCdBqnNiG_Mg43F2T6vvMSx-zDnU8gcKqrtA&oe=6A9979A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKoO1T92tsoQ7kNvwFdpNeF&_nc_oc=Adqk9dyLcGUH2_bJtQQNe5zaHqsi1h12KQjbOn8Vteqg6o3pv24kH_M1BnQA3oc78V4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJamAwAJz_iYWRyOvV2Zes5hYq3Cat4ZYQ_ejl-_AcsCw&oe=6A99809D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeU7iRtDX0YQ7kNvwFq4xRk&_nc_oc=AdpszOV93fkrql8WZS67f_4lQmcMDPhaRkvpCgxpA0biIO478NnyIa6ypy6agtwVG8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7kRSw0fYcekSirG6f74xmAji2PPNPUnbHaONhr4ol6g&oe=6A99907A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
ndiEZ6ZeSXgqzOwbk4JFAEZqz6OVhRJjkSx1L-G-c5Eodf4KwaIYvM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzP8iTsLyu0zaWNdwsxKMTxxRywvyxdBBRkY_io2SF3g&oe=6A9433A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYlbY3iZUYUQ7kNvwHo8aOq&_nc_oc=AdpmkyqYw8sB2t6Jj_utqfsOvqU_O9Ou0l1ejz7320pICl7aCKoYTuOoSCNEj6rPUS8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-1pIx-swDb7MOdCDsrw5_EMqMwacW3fIkcg6KEi9eVg&oe=6A94025D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuMHZ0UC4RYQ7kNvwFgMrPD&_nc_oc=AdofolYlfkQmHhcR-nOsLYcpGWkMFde9d-66SA0SbaFlIt6HPz56HvzjROt549ASLGo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFotGSV_6nbQ1i4SmYVjI-L23c89H8VCuKuXhSnKa7CWA&oe=6A94123A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
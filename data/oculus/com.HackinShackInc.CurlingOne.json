RFX1VuIuB5C0AVK6sUoZNgop3CvyGwhwKR91V6GGDPE0n3fiUFCm30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZTyof5S5m4FOS3WwZH0UCF2W5Q8zlK19yIcZRf-PfUQ&oe=6A7F1BA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypWb1AbPGL8Q7kNvwFFYKbE&_nc_oc=AdqQHIwvNEV0aSJiwEQ4ctTMkvJV57Y0T4VEYFUstAh-BIFQJbgPz0r-ZIxp5hNPa-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrIT-qv_07hLM-au2VeOMSBWVpZvBXCmQwVX_DAb6lMg&oe=6A7F229D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuzxASYMSqAQ7kNvwEyr6QY&_nc_oc=AdpNkSbefDiYtGXobBMoybVuGjRd5DjlicxiL3mzkwplxQb_1bOxxNix_TCY0wmXCgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9pbfYKxnvq05M1roFJknDJ7B4_t6NWGGNsWA1rqAf8A&oe=6A7EFA3A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
=AdqdGm3NNioHaH8-NSVZERJqulZa7XB3GNaXpdiZQIqr9kLD7ESqJiqGEZBdXYwSY3o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRlcpZPFYU-HCSPYi9xF_8jlDAAjihhqyiUdy2ficxmA&oe=6A8EEDA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn704BMQOwcQ7kNvwHjv9Rd&_nc_oc=Adp_ymC6YgF8Db6tOEVyDxgEl0dn0qPh_6WPdbOOrGNb-K9miSZcywm_WRkpFW_jqgk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOJwh1bw3hVJn8fohyqqjkf7DUt6O-jviHZBfy3oruLQ&oe=6A8EF49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QOorcrWdY4Q7kNvwGx3XuT&_nc_oc=AdpMj4YnOhzzLpy0eASYFcM2VgHhozui-7_Y4A2vaoD4Y_5KllysQQR2Beaw1zmKoAs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAYjqkMoawlt_io7zk9mygsTBIIQdZwovoOF09HBBZbw&oe=6A8ECC3A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_ur
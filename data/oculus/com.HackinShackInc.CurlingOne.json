_W5naLdeVzl7nPgtvvsBC5OfejbqF_E8RjcUToz4fLbOaMnD3hlQvYjpRDew&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SXJQoan_iQTWCGz2Qgzp0jf9_Cefc9X38xlE9HLGVGA&oe=6A369928"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmcpwv78XIIQ7kNvwGcaav8&_nc_oc=AdokGhBaD96B89Llim8OvvvGDuxBaELLrDs_YKyzAoHl7rPYrsNSg5HTLnR-nxErIXE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9csaSdq9vtCgNyAkNpfUBoNXeXjPT8cj21G9lWIzw1eA&oe=6A36A01D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fayZYIZVq7EQ7kNvwFK-CNs&_nc_oc=AdpnueyaKxqkEyUiI2YVuPQJjeuDT8ruDQi8FdkpZaH52NxN94W8_9gSO96RW9_T6dw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6K9ETh66mw3sLY8_9uiE9hqnamkrrQ4qFJCtRwN4DeQ&oe=6A36AFFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "htt
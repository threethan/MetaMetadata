Z7BA2B-afqeEILrjSCCA_1Fy3sYNQaCFH_qqP5Amn1pxw6MZoUWFqM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEMCAH3dEb9sDwapYbPmb3RJFlvRKl_U6exMxaOHnFXg&oe=6AE34DA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SWaAoCXc2AQ7kNvwGd4_vP&_nc_oc=Adqz94vBjLGIzGABurTErTO6SPzUc8ZepT89XghyqWLRYrgAQMRo-nYi2yxPwqo9cxk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTi4WHm3q8_08DiHi_j5ZR7rX8x2vBfCDW8qqSOB5f4Q&oe=6AE3549D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=men8I0-9E8cQ7kNvwGfWttp&_nc_oc=AdoX0huUjl5ArZtaIFliv1MilpMSvmbwCzNoD3Y4bSXTd-rDXVjjKWZiOwxYiVKelOA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOywUJZOGxeO-mvwE8Afz_s1247c5xbXSFL1YOV0iW9IQ&oe=6AE3647A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
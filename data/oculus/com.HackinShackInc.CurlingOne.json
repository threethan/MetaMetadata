QtglEMrgkg8EqDAUw9R-UqilS1joxLlsbCb7xe-BJqYdIjRHOtCHlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgzklkfJpZDvwpYAoGUMba5D8ZHVO48BTKgmPSswE1Jg&oe=6A75E128"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA2dVbJYKPAQ7kNvwEhVH8n&_nc_oc=Adqx4_iw62dfRZ4NoVX7wkJfyPBQfyAJ6DhXy3cgdsTzTxgE5OyLf6o6Bu4ii-GmNfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVLkjfqx_wZg-QNyo8k71EUKVFKBnRY20nlbWlp_-KRg&oe=6A75E81D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itWRvaa35l8Q7kNvwES20Ob&_nc_oc=AdpAsDJy4NEaPBr1hbtC9v7Dw4VbHhRTBuJTFuA1uOikl2RsHcTvn6gjme7hV9UO_u8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFBgBIxWyktpX58u4OpR8HccLj1uA5Vq9FY_Ld3KbmTA&oe=6A75F7FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
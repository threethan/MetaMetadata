Ff-33K99bFimo2cKuRFKpXczVvlWy_gbD3puM64NtQZFyCaeG3SYzQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PujP_nVM8wrCu65Db6BHycXHTRh2P4FgKZp14_C86wQ&oe=6A105DA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On7ZWzctNOkQ7kNvwFbJs3z&_nc_oc=AdoBj5b53A22SyPEOJbrmlf0qXsr31LeryW4puIOOaXYOWC0L0qJSK0p9JLAGdtP-Ds&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65HCgiCom3sPdft5y-fykiah1CnDeRta2on1L4_BtbUQ&oe=6A10649D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj5q71zMslEQ7kNvwGZjYjM&_nc_oc=Adp9fPhywxqURB-4nB7It8ghm7dxtHy9Ju3q98Gw-xrAvPR2WvqHxWLXBelROuT2j5w&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yyjbPpkwTiFpuofZn3LHCOO6rRVUtBwd3n0rtTQIWow&oe=6A10747A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
349UcFYb8pseugwEDPGkWDEh8FFf94fQbooHE_szbZ5MAHE_jxEkC0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rQ2EV8F-Tto3a9OYli_Psvc-17j2fDhd69ePnvLzQVg&oe=69F4AE28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pUxkjAZtAwQ7kNvwH6tvlQ&_nc_oc=AdrxhZhmuCLfrk60AbXcrWWxTNEMedtt6LwH69kU09tZ80qJzc-eyoXlF573L1SBmBA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ttjqEEUyd_dj6DBSwdUXXg0IOiZpuuVkCD_WUFFfMMA&oe=69F4B51D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IoBp1ZGRvAQ7kNvwFQ-ccJ&_nc_oc=Ado9S_iZlbMS62ZZNFBuTJT_h0_nOXA1laUPJ360knQmEileqVCFeE1IaKdhgDXQiTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iOokNrhJfg5gA_E-A7_wzrdGQSbyKUq2o3hl3SO7r0w&oe=69F4C4FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
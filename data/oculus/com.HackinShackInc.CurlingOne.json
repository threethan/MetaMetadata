qhsSsIgCSi9ntPB6q5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUhY5uUwph4Fh0o6jIYOJ9RdhqgVzX6_zHe3UMpIISdQ&oe=69B171A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTo1tT6ERE4Q7kNvwGwIx-S&_nc_oc=AdnXHZeb_af0PCs8EgEcql8hth9UCDO-rDCejMZhFgcvkW2OnDmZ-5Jv1Gwel5V5VcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDriEQEBP9oABu7J-Squ8mSpQ-2MCwGfZmANMzbCGD1w&oe=69B1789D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBsyYNIH-SAQ7kNvwGir3P3&_nc_oc=Adnrc1-jugrb3u74h-oe4Tuf0ZN6Pi_7oAhcxrXFjL_paG3kUGfp5Jn3ejpcMTlo4BA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ9xlbp9F_KkmZ8ghJ_6e6h_Yrx4S9Kw2ML4MAWcOPUw&oe=69B1503A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_s
8Weztpf-PHh5noY1Q9vK53BIXZotVwJe7eP3VZZ-_GRI_dj54wpcwg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1u9QSaLNedZpQ3Cds8gAkndsHpk1bdjLdxI5NUGfq8Gw&oe=69E62DA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp3UOg3eW9MQ7kNvwEKL14M&_nc_oc=Adp5YV-N8hLxtUlLgbIBJUjuWQcVMBIerdERZT90-3N45Y-4UTX6mJqBWiwSCUA0ZWc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oBAxNAY07cuIWLMdDYmIwRJSl1bY0HbGjor3X2FutMw&oe=69E6349D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe3i9h7QnugQ7kNvwHe4Tlf&_nc_oc=Adpuf3YAejpgTEEmR4BruMZROcFmDiCwOjbaoDcXlrQWwGyPnvydHatTqrNkjTuJWtk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LSw6IXgeFb-3YY5l_FVAbCgolQ0KCtOOg74Hcx9YOEw&oe=69E6447A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
CKke9CrKR6Ux2QuoO8JOQ2itEZqe3_FcswdS40OvN2VAsQH68c44F8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR66CHMdbs7W4Il7EDmO_KPiirHx5BApS2TY7acAy83lg&oe=6AEDD9A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipbwE77smo0Q7kNvwGX0TXH&_nc_oc=AdrILH0fwcHJVeKhcG6bb9-dPFGHugBsBNlM_IKMcgXIM5zaMjH8natZc23Ju_F0wCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbea5wxfLcaQVk9NlG65PLqJ9eLhVnR-mUupjehpcyRg&oe=6AEDE09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSEiJ-qDZBMQ7kNvwGBfJJQ&_nc_oc=AdpYVVkTZszI7vENdXGXVY6luKcEv0BCYcER9eAu5udI7C2zysvNiuFzpe1iX5J-w5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhSF4-EWpbMdpl0qH1Mnva3vYU8_QpjZumGZ4kLsaZ4g&oe=6AEDF07A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
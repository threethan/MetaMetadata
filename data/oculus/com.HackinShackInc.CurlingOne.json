Yjo8HwljOs2gEPVCWGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHCHqIFafE-VQUQnp2vuWlT2jProdkFP7Sj-VzUrV89Q&oe=69B95AA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkUAHniW0JQQ7kNvwGWsBf7&_nc_oc=AdlWEhC5dv3SVBR_j30IDDWjrgEBitNn6PI9vKrfcjfz_aSXNZHtfpzZo37aA-M06pY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztxBTdSK9F-VG5iWXGj3FMBMqTLyGiwSVvWjMl2BACag&oe=69B9619D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtzP4G5FaJ0Q7kNvwHQwax8&_nc_oc=AdlN-U-egyCHHEZVMT56jboFmPAzD7IP9ruGdSKdA850KXZHfFJcbF9W0Nge-J7ItuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxT6JbybtjWY5qNwfVpeup4FVeWhqQpLyTCWzt-CnH4cA&oe=69B9393A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_s
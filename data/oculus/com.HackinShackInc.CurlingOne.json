HGMaBDxG43p4Aqxnfqgng-OEFRfZ3x3BtI_XVr41liN53JjXyJisno&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_hdj_qYvZv0QtxrBPQ4s3lEoJVE70eZOy-L9my_IQvA&oe=6A539A28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_A-BUVgkNsQ7kNvwFqxNnx&_nc_oc=AdrjUQAST1ZY738GDlEOW8H--UCINHDM2MeO8Kfu2sNvKrFfS3ET9hxRXrSFuYTTasc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnjt7Fq9G3kfmyEsV7Y7nRvJc3SYlBSYtNRa88mez35g&oe=6A53A11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-ycHP_6qVMQ7kNvwE490Zj&_nc_oc=AdqO0guclL4r7KaQrsfiX4-c0K1iB7AWygayNIeTwpIVCt4bL09CwmY5-JpPUKLf8AI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFmFpzVIpmPQOznVXvSLTjh4ZL-IzUDscvGeSwkIJ5gA&oe=6A53B0FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
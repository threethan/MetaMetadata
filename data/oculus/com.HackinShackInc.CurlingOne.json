Y-D9I8AJiOc_F12i3Mx-9YjrKqNPhdqgA2Q92GOqSruQYECEf-PEEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN8Dcet0zNp9vlrH_PQFHDGDtd8C5vVKw6PiG-W5PjDA&oe=6A896F68"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHmY8J6ZtQYQ7kNvwHE3mNv&_nc_oc=Ado7ERbfye83o4GSoror5nnMp5WRg8eGqO-toFyiZqAE2-nD84BWr0ndo5VxGceqfao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Xbv7_vrnM-D2ZiDyCKvqujszsqVNGzoAHpX6EUiYvg&oe=6A89765D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mYarAeNWgkQ7kNvwFmy-EC&_nc_oc=AdrMmQ3hdUjVm2nvORIqcFc-hbxJBdLFFchLQsv7hJsz24R5Pu2pUzdYrK__e-QOn_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMaYf7tvf9yGOtbm4VIrvN7xTxKQu3jKpRdoz5BlBMMg&oe=6A89863A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
7xnEFcL8akeVxt7WNAmw1nphG3R5-82S_j4jFZE5w5o4McrXeNT5do&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbeYOHj7MvzEMEMOi117_yqyOCtOL4oBk5Y9JjdycmUQ&oe=6AA2B428"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcN6p9WRr3wQ7kNvwG6DllF&_nc_oc=AdrQu3zT24OTs6MvVwwKPs20o8XEBZVKw3fU-pbM2QW5LoK4-TlB1jMz8FYq6mWnQ2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL5WcF41YUWCFgPvwNCj_u8KhRHUacsJqbsosoQ_Kg7Q&oe=6AA2BB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEMNmNwWGIoQ7kNvwEGjZMI&_nc_oc=AdpSTMs3lvJA_2LV4fz5eEJcYpuDtvU9eC_PoNhbG02B72LZYUbZ2u6OA60T9NDNY8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0HEr4IjHhrjQBGEjfq3522vHy6r4FYR_PElk4Jwfiyw&oe=6AA2CAFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
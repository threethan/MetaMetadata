APSCOPjxpvApNWvBHBc6TOUwuGQ8twquilBKH9jlVdDu1-KW8QBL3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LLJAE7cY-_qraq3CmS5VTMpQVDaVI7maDRUhSokU6nA&oe=69FF3A28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83jptDJ7aRsQ7kNvwFip01X&_nc_oc=AdqfHwVNvAmtb8gzQqnE0aLe1noLG2gcg2ammFoUBIfRTVFCPES2R9frkavJJjvl8Eo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59ohzAp9wxVqJDiJS0qu7axslXXf-Y1SM9yat79UqMoQ&oe=69FF411D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMU4Zz5ENpcQ7kNvwE0SHy1&_nc_oc=Adpc2EDyeBHnX8OPJvTqsWV-Xyg7Y6qYFARGrodhy2wvQLG23M_hdaJ_aOLFQxU9xv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vPT-ZhjKbE-WCr7woELEsKUKS0TVuB27EUv8IZUgGog&oe=69FF50FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
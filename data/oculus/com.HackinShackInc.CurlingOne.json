BFD2_6jUWy0tmPaIHlY1NkywMW9wi5GiAdmoF8LqQ38F5y4LYF_bCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh-jBGaUnAnTbnYRKKAR3GqXDQlDIcxy0LdUVKI0GBhA&oe=6AF89DE8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMYdSvopNXUQ7kNvwFuaDbl&_nc_oc=AdqU4iFdTDyo0DtMZAPdQptmQNOD_pS4XxLGvjUipaPgxG-vSMlxMt2C-iCkPZwFH3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiYJsYsGuBBpCqod-Q4smjgTTcKVcugx2TH7qK1-PDCA&oe=6AF8A4DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgrafhU4gooQ7kNvwEd4I82&_nc_oc=Adrill2UI1HkQhmWt1GLwNVeMYq8Yy3qaz5Yv2yiprvDL49akStjKej-IkG9rNuUtwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8jh8BcrCQTyEZxQfz7R5TOxPGVV1Ck8pOhOBTn3EUmA&oe=6AF87C7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
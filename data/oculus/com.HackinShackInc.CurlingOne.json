ehUZptuBKcfseN9FqEXcC8UUCQ-FqAgfmn2wAjuFyc8lrIO2my-rtY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7ELkDBAB7k0OYuAr-Ula030TOCePiolYlKyM6NVEIVQ&oe=6AD22A28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GYtCFrsjSgQ7kNvwHn4ZGX&_nc_oc=Adq2vzo9cyxqObphvJKoaQz10l73vDaPl6_bc3z-PrIGv4Sulz_Hqvjzj3EuB9gToHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLZsOj0YuM0lebHeEk-EU2EQQlsjhy9PBGb8sA7GcMjA&oe=6AD2311D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6C-jsi4S-UQ7kNvwExZgcd&_nc_oc=AdpLpWnlt-MM8xbBWJs-b1AnBjhJKxD7uhZ9I39lRKF7aCrTtO6CFtcRmQF7fQ9K-Ck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB9IpT5pK3e1QchqCGrybSgHA-7IXx5yOZ8rtH-mY31w&oe=6AD240FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
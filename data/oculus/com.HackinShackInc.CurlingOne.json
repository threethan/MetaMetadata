_L8L4UiXIFqyy4cJMhSvBudR0YaCQ4lGeCax91ZrRcX69ryBL-ePLs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh_pMWpJw7tSON-LDqDSMPxHFhIoIUP6AbzIrnrUP6zQ&oe=6AEC8828"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhpDuQRfRrgQ7kNvwHRc3zH&_nc_oc=AdoRZzxZfHH_H3lRWLotkDqEFYnSeFjtMaI4_vOvORylJJ2gSCZzT4g94KKk4V0-KY4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOdGJAsk2sCP8K2zYinN6gZlUNzcHobs_Jb54FgpQweg&oe=6AEC8F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSEiJ-qDZBMQ7kNvwH3Nd04&_nc_oc=Ado1twRvMpM2kb1BLVcJxQVfZJI_9qNkfrA2EF7GnOFnCeYm8Ct9KwQCymDCaFfQdE4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtU0HMsysbChv9FOxX1DH8Ke5aHh2orhWtYeoMKEkgxw&oe=6AEC9EFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
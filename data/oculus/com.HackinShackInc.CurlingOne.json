wfPH5GzIH0qPi-11G9bxFd5NxbmkdUI5xpeYAKzWnwklwex1z_bNIFjtCcpo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tvqAbqv-TVlm5c7jEtgbaUW3uXsbTQdkRZiTPc7feFw&oe=6A466B28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-CSRyueOaQQ7kNvwE3G0gL&_nc_oc=Adr620O7YDQCPc7TpHEoCWP0lp0Kfegv68o3-q5MdBhmpwwPMU_KX6ORSBRa0Mj0VX4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UA8qYIFwzYcraWXRORf_w1cIGnVH0PyfVxUcbfI10CQ&oe=6A46721D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrNRTD7KK9sQ7kNvwGRL9nv&_nc_oc=AdpT1uUBq8bTh6LlmRN1dQjBNa7XGhF2ktuvllU8DXvufGgrv09qfuCDhRzAuiSzZ80&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mwj6Ld_CPw751VoK0EvGCPgCQGh5fp0qU36JWn7VuUQ&oe=6A4681FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "htt
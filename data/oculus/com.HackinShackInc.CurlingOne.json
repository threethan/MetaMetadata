iLY-bOBYz346Cyd8jzenMoJriARf-HOIF1yxfugJjxUe-dBHw2RyXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUvvpor8ekPorKfHkANSy5DpCyxV4ycGMXkESqsc5iIg&oe=6AAA9D28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceI5M23wPoMQ7kNvwGePRgW&_nc_oc=AdqAjk-OcaQCG7uUAXcpRAGSax_Xpzw00nevs5kMniZxhhYOi2cuEmTWOvKdM616PBQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6PgBtIZlUnYnnemOxPduPKgbYypyJzQFtMMcpXpzgWw&oe=6AAAA41D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plme_QTShhMQ7kNvwFzCULC&_nc_oc=AdoCcGTanLuLckyGDunvj0_2d2fp0q5b95yjc2NEUfLYN4n12BMXyPdPs3mKXksVMxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKezWJFLgRPe494QnGC_8ju2G7bHToIHnHKbyThgGisRw&oe=6AAAB3FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
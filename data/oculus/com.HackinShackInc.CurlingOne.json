lga3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCd3ent22GAQ7kNvwEfLE-Q&_nc_oc=Adoexo6N0AEHRfcAXHzbxOU-rcaVf2cDKKeo_KhUqszsYBd3wW67EmBZJVsYBHIsU5k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJUuKSy8ZM7dNyrd93xIIb8trvjrF0ci1nht4Alc7LXQ&oe=6AFB47DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-4mT0GcJKQQ7kNvwHmMzZ_&_nc_oc=AdpZ2H5iEJBdcGuTzlM17Ti5pFDSFN-g6EE-G6DWCY-KfhIJV85GtmWGHtcXZqslstE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7_VgaG-WplQBW_GJVkbR0cmpGA0HCiRps1q31pCC48Q&oe=6AFB1F7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play solo or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in solo or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_service_url": null, "publisher_name": "https://hackinshack.org/", "support_website_url": null, "website_url": "https://hackinshack.org/docs/curling", "category": null, "comfort_rating": "NOT_R
oIm9oUxDjYcB5r7czuOAGEQUQCYF2Q6t_iXw&oe=69F0B9A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2B2SVPmtXsQ7kNvwFRcalq&_nc_oc=Ado_K1DHlxGyj3tdxKGBkRoCGpSaUS-TC9wR0DWphDSIZvQJdKqzyd2O0EG4b4l5swI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3UFq0QPSPH0DnwZV3qQau7jVYBr5Q5dWwGVB2nJVy61g&oe=69F0C09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5k7Wk3tBNgQ7kNvwHkEqxF&_nc_oc=Adoz4o3Aa8UNyN8Aohq9ytgx3fhZyBX7KVj1fgMjdR6xV69P_M-ZKERlV79nMCvy1o0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1HO9huaQ3hKULXY_jBj0OiDfHYkK_SbuK3TZSnMCSc-Q&oe=69F0D07A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_service_url": null, "publisher_name": "https://hackinshack.org/", "support_website_url": null, "website_url": 
_3mhDDKYTlU47-nevoWQnlEUApSWu60I2CrgVrxTehB86TxnkNMTEk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GlTXcoB5r_NjWuTo_g6yLXwC8Aae3Cue5NOacv8038Q&oe=6A1C3B28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1rzQSPOsLYQ7kNvwGj9fny&_nc_oc=AdpgdIKLsvwbRLe-3CS6hBJTEGzKFL-o3Dk_VqChvBpxOETh0uvUrHlzXb4Q1DyXlvk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PmalyKLdZpGhtbYGwMooR1kOzgFPngeTyHT6b4V5-HQ&oe=6A1C421D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyOBtYuOy_0Q7kNvwGKwDSD&_nc_oc=AdrJMmbkvu6T479kwkGhhCTxxvoHTJgV9gogHAE6WXJjz698XO7sjWprD_HeVn0a_MU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QdWuSGr63YMFYC1m6FzTqxRC2oZS46xVu9v-Rzn58QA&oe=6A1C51FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
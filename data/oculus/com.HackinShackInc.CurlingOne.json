UK3kzIB-nXhLHV9cPpLhikLmGpNdzhxd7c0ycZq0kY9sOL7t5yboE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XIKVVjYJ3Fasq3-EYowBU6eLCdWbWgmj7PksiUgkEDA&oe=6A032EA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zShVN4O2C7oQ7kNvwExCVdT&_nc_oc=Ado4D67z-cH6Bsi2DYsKhB_lbqjqJ_axUDd0ivvVKxZFwnH8xdNh4MNa9aSK8-50U0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gRXFBhv9WKO5TI77mSU07CjmxxljvWH2Eih-9AcnXBQ&oe=6A03359D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEJZrz6tFVEQ7kNvwFfyCS9&_nc_oc=Adopyx_2DoTGkk8GVIosh7-Jdo7bm-7_uGGN4TXaHccieurfZCtca26V6mqtAdT8Jd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QmYtL_MUAJhA63Y806JvHdVW0UmU6PaxFCaQ8M7NQJQ&oe=6A03457A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
eSFvGM2cgh5gXHXV6nRHX06sB35x9yV38ObKSrMNGKu_QOZpt4xoDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx-tZL_UXTBd1eX578CMMIJadL9sKygbtwpt-UlBykgA&oe=6ACA7968"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AjYJHt0UgsQ7kNvwErqzSa&_nc_oc=Adrs44xn1r1W_yafVjK4-QprtyQdDrfCS_W7p1rZ7GXC4mCeFH7GNINopueR9nWe7NI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2VDZ8KiCLQCj2-fFgfsQmgayc1PUxJKV4ndvE_wRwsw&oe=6ACA481D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r9SUmmC8DgQ7kNvwG9cdZv&_nc_oc=AdoM9wsQ827WQoVWhViy9VeXgiON0nLBwBnGKwHJHaD4dKLdqpnC2c2iJzlHrwp61Rs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORkgscbT6BqFfTOrpPdi0j_CVgLXQJuBeJHx1ToJcYDw&oe=6ACA57FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
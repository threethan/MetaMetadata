Iorm5yD22eanOP14NpSiUYQY4o0GDDZGwxNCiZKr4T0CYrh3KqyMfs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gGWqGHtqITcuIW29nFzDGm1xNEB8-vdG8gbuWnmmumw&oe=6A218128"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv3x05j5PeQQ7kNvwF9I3_K&_nc_oc=Ado9KomIE5LzTWtBnEy4cidRizNAE-V1TUkptSikDRtbbnmEeZ51Ax4mY-mP8ub8nTw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9Hp71EtCnJT0uRZedeh3sYanWCv94kmqWXojetcVS1Q&oe=6A21881D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsOuxeBCPGQQ7kNvwHEMfnA&_nc_oc=AdpFDWoot-YDEdcVRPenWo0uUVG1Jbr7Ts7Rj_5JuGCNf6TtEPo1GkLdu14lozqL3Xg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G0Li0qXf7qlGkEQ7XV7PzcueTcYDrKfan18XuRuiOmA&oe=6A2197FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
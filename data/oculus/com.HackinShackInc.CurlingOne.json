ydENoncDTiSgs2VTcK06-cvNeVboJGC-5KjDIjnPGTVHCLU5U2gNxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i6m_ZC8AbPScU-4U-TJg-FA4p0u741GnmW9LMcmkXaA&oe=6A01DD28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zShVN4O2C7oQ7kNvwHmyh4Q&_nc_oc=Adq6nnPTHzhGiD6g3vHw0icGCqrkfgwzQ9XYiMLASrJ0U3Wp-XO948cfREOGxfZKdZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xQijEa5e9HZ-O1NcW7UKX4qQYKteOZjx8Kfqec93VEg&oe=6A01E41D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEJZrz6tFVEQ7kNvwGSUlRN&_nc_oc=AdqspmKklkv0-i-gEQZAG7CL0m6nDqYzXiwp_O0EGqjS02e-Bq3jdYZxwLD1P3iFlX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rYvshwNoRWnsF2RFYD0F7fKQQ_lT67V62Gy-jIYzJEg&oe=6A01F3FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
mM_XpSyF6S9yr41CMaLufBrZzoZsrpPnnme2El8kAHCBzxeBQTybgA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtC6jW5KYeKqCZyblXyHnLAfWEK-UYi-Fd5tDnBR7hrw&oe=6A8AC0E8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48ac9VJsZFEQ7kNvwEdwgLi&_nc_oc=AdrlRkv48BoOULjij5TDp8r7-qGriwgCOUPV58-jN-mhzfjqdhSdHutZmfyqZ1CCzG0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNyDWGngmumjSaZZcgnO_wWYhQBNT-zaAAarS3j_Xtzg&oe=6A8AC7DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mYarAeNWgkQ7kNvwGJDkEa&_nc_oc=AdqwiazN5X3yXth0w_g5uM1lsQ_YwTr-9aHPd_qstiJdWqkyNYyACCMS0MkS-DjeWgc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaDa0sRbp1_Ty2ali6LExsrYDG8MvStUFtpBJlHw9URw&oe=6A8AD7BA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
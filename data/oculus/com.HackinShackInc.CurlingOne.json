gVUabInqUEGBnYTPW0yIFboBGHt6uswiekWe0rEgURqmSCdMeCpm-M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTQmCkYj5EJ_9NL6omx5LY8BN7kUK38tG7buJq5deTSg&oe=6A8704A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHmY8J6ZtQYQ7kNvwHIAi-g&_nc_oc=Adp4PbsAQpr7geemTr1lsH3mDekqO3G4P8aHz5BWgdzdMbWaEjald-4joFNX-CqsXRI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKIIgGfZTDxILDER3n15xnURUV6JmfYGKNYzZdwr2Lrg&oe=6A86D35D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxQlEVoYsKcQ7kNvwFvK7iv&_nc_oc=AdrxphcBz3NwgRJIbQU5reV8D9oBNt8JkFMit1FK-fl-BXLhw9QF7b9CFPWv1_4DP6s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnslVTTg9vKzi1xTm9QjaATmO2kGAffmAG62DbpW3Ewg&oe=6A86E33A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
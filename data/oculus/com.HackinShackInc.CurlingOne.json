K0yYhjOUf3jT4d-8Ql0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4_vHdDt1IjQTNRNqxLWASMPPcGa5RpMQ76QvFR32ruw&oe=69BBFDA8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkUAHniW0JQQ7kNvwG_9IXX&_nc_oc=AdlQ2-F-nXidbWTovRUsm5eM798M7DIReR5VThWmr2p7Rw1EHMVIKNkqsWTbqi1XbhY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_GAX2HeI7ZqNNB3vABBm0MI2SBysI51wF27cSqFFZxw&oe=69BC049D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uym4QgFpNawQ7kNvwFQhSaC&_nc_oc=Adnd4bpC6GINOcTUDEKtBtcn927h-zhmtu82rUHNlst3oPGHILJWKTRNw8UAFx6jrD8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyywPAOtl_wVCUyL4w4OSLzkuwODAcpLDzu-gHTyPgsFA&oe=69BBDC3A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hackinshack.org/docs/curling", "developer_terms_of_s
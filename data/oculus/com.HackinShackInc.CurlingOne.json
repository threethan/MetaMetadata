MnmTGl-0sQ6JJARBJnRmR7X08cfOeAVLX80F0o4PspbZRXCBQdoPVE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pY7v2elYzTDV00snlgO9yLB2MZZl_3HoxfuveXws85A&oe=6A3547A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmcpwv78XIIQ7kNvwGuT5-f&_nc_oc=AdpyI61J2QQrjw9hdwceCbHc5BzcSFvmp1lW7iYTgUr0AlPOAM4O1em4aNCJH3JW1Jk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LTJn7O8RBWht883ihpA24FctzZerxqYGTRdeoiRQaCw&oe=6A354E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fayZYIZVq7EQ7kNvwHLCU5N&_nc_oc=Adrt4NJrNiiE46B6ISF1m-CjoxIi6v3AvBfRTZwasIqbaUL4y3z1UYJdxr8WK7WSIdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CcGxLu6t6Kpgmfiu2RZNnE1kOIq0tp9X5UpcDmQG_Ig&oe=6A355E7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
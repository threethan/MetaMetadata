mWXse0jM6BdZU7JrHIRjq_NMNS0sD0F6AITM2oj6s_5cjaCbWk7tb8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL34061ngq9QPODB9z3t57kCGvBpxANcnlPmpusnQMhWg&oe=6AAD4028"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceI5M23wPoMQ7kNvwEVDunr&_nc_oc=AdphtkL5Iny7K-ztS83ySmVqaIu4wJci4IhfLrNobch0ZN22jVmqynqcaD3RIlQMYSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyRfcwMJykRe2k_TLb906-OyORNHMUJVbWAUcBK59iVg&oe=6AAD471D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_otpP1eXUWoQ7kNvwFRt1Bk&_nc_oc=AdqmDOjGhEXGFNaLxsL29bg4UxCgHPw4Ux_Nxak2YOwNATqCOT-zSNk27Cv4hT95Hcs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuu4bYedxrOYK11YfzOCyf48Rb_OT9NHVuGJ0sdmC4tA&oe=6AAD56FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
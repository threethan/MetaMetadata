8Jr5clVuWhnrwbkHYFJHkcaUGdONtB9UjFvm8Jdw0jytzziwT9l0s4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOSRjsKaOUfot6x5rXtPo9_UjI7nF6Us9BRSjtxrCV9w&oe=6A4FA5A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sF6wCpkwWa8Q7kNvwEu-8dQ&_nc_oc=AdqbM6hAVU5uenPFstXRJRJWj3rFd1ssXD9qIRYym0AxwDSS2pBsHafuBLMbLB0Wmz0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHqSvEAA2459DcLm6clf-K1XPdREqpCsxYeBYCOhaxHg&oe=6A4FAC9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ9YaSRsbI8Q7kNvwH0eOSc&_nc_oc=AdoCTTaEmRQaJ_i0OTs1Wmn_IeyFBLlYgB3qadyOA69fsYrcitI_2QT8Z-E2LNRLfD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUE37Dh9cMQHjx4M2MiAsthPHLfYPME3dvNSVJelUR2w&oe=6A4FBC7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
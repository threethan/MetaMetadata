mzIOYQt_uVhmAdF2CeL2vwSlhwuI3hvXXBn6QxbtnYM_BoWvGQEV7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3vc3fdLPxwv-rJcjUolbRddZhvbTzi6IBlcNwbGYHtw&oe=6A903F28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn704BMQOwcQ7kNvwF3a-WX&_nc_oc=AdouW4WT9RWHTfZL7z8pint434No9_tZVGrQoNApuBfhLxjYqNKCgJGKGzdiI3ZZ36o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE44KtboBRPKLI483SxwGzQ-fvsZgcqE4y8ClSfM0YT2Q&oe=6A900DDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czBJ-qLyI8AQ7kNvwGMySf7&_nc_oc=Adq7eE5a0BMCA19phPx36Cn3wNIc-b9KtceHJV8gKP6bnGd9o-QZt1X19I-FxcLusIo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0G2HwRyj01KrNyeJqsr0qoFDANTJLP3ESEZzlkFQRkQ&oe=6A901DBA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
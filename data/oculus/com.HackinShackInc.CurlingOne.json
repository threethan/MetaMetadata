6cUh3QGJj9NL_mBxl-VW-lEsBtBwykEXYuGaQbkNAvnhvLET2Gkomc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAVBlP8MBXzxnkDKuIVl5dbGUI57zxsMdwtCIunynUVQ&oe=6ACCE428"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AjYJHt0UgsQ7kNvwFayUkG&_nc_oc=Adr10a3sReNGw70RyCrir82z0lGOCuqC9OHuibUjNKdvX8U2BVtxrMTOxs_esIrm5K8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsPkZxyzz2glV4hTmJBA2fIjy4FNvY-H2AhhsH1WwNbA&oe=6ACCEB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYf-rzVowLMQ7kNvwFfk0s3&_nc_oc=AdplpBRwrvHdZHUiD2FuN0RSPvgi3dIYBeZ4sD-T_UOyM8a-3cHD0teuhI8tm4tWq0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYVCK6LAy78BGniT6kIGXsiooYdINap9mIqFqWB3mzGg&oe=6ACCFAFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
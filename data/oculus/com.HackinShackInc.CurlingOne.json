r-xCHFd1o6OYfzaV2EqGMZ50icDfXKd1JFXwQD5vnJztI-jbscslUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k7HBA3z139x7kmn91LXF1RgA5CQAqkBA4WcpShls1kw&oe=6A33F628"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmcpwv78XIIQ7kNvwG2PPWr&_nc_oc=Adri6usnt_WtMEJPG0m1eCEzWWmyb2jCKK6KyBScKPZFXtBqdOq5aoRnTpzriyguhQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LF4H1e9qqGLYwZKnxBbPGq5WCt97RoPefLxmCiVJdhQ&oe=6A33FD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrRCM6qYoLgQ7kNvwEfSavo&_nc_oc=AdqkYvNoYh21uK8PSYAoXSrBIKKHJ9vrgPL1T_OUbQ9dLcwpUPtDdU7mRwH6XF8ktFQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IkSk_DLGCAmxHmQXzwsf_rfAj1FIMIk8rJPR-5o02DQ&oe=6A340CFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
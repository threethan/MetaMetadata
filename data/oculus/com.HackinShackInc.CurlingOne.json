VqN3iHRJBYdE1tckdRUq-Wo0xiQdgX__thsb_YBLYY1Hb3x1ZHtDjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UdwGUqL0wYF8OnvQx-agjZ9A9HzrSn2YZ9s7rMytzkw&oe=6A43C828"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-CSRyueOaQQ7kNvwEKjvu6&_nc_oc=Adr2R64c8bfJuipE8pEpHpUBbjQZp_yTUp5rmaAEv6djUDFWorgxg_Rl9UPsq7fpBrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mrwfzGrF848WKcsyQzdT2Qc30189528wLDq5MbUNBjA&oe=6A43CF1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_2mTSJyB8kQ7kNvwEcirdk&_nc_oc=AdpTWZ70rru-EYT0Hoi4wcMf98I3juIwfF_3IgL5Tls90_xS3WNyyqponcumpdMyXqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JvSkjrxR4igBMAkoJU_GOtjmnvo88lP-rdGCHxI--DA&oe=6A43DEFA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
VyLYjdfgZC6DR90A87LW5l2zPyhDliGAikKKOH2q3VpKlgOELvwcVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj0LTKNN-VjeY71UaJwcqYD2GN5tbY9fwDl7Jx0FAgYQ&oe=6ADE07A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwZhHkBgIrYQ7kNvwFY2dZs&_nc_oc=AdpRtXSI7u0WI6E4YsD6FzhCf3wXkoPYPLoiJVuHWayFca_pQ52DeZa-m_oSpoxVdQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCs1YnhXunCfiOfwIA6hPBIjafsA6o8g-JQik5aTZDyA&oe=6ADE0E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqLCCY-BIM4Q7kNvwERXOk2&_nc_oc=Adq39Z_LxTDn0_1vefcPDgohIaXeV-GQArCPZb7BUJp6esJkk_daQFS1_q-rSs4kTPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxX2X5h4jLdKsF2EVM65ssJ5iL_5wDY4e2g4BPam5v4Q&oe=6ADE1E7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
uAiihbDwPXhBAYd7eLjyirIY023OCzPu30-fJZR9qS0kt6AM0tc9m4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7_PvPq9s_uUKEnI5s-JQ_GctxjfeprAojbvN0isH69A&oe=6A9ACB28"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAAM1Faa2QwQ7kNvwHxbNmD&_nc_oc=AdoD8HtGKz3eMTpIZrNK-oQ4ZOvHql1k7UBo1StCrTZATqA9h1Onz6Amb_4rtBMBNfs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPCGXtfDpTnJ0WTiUStd_7gok4t-YnPsnBpvgeLklZ6w&oe=6A9AD21D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeU7iRtDX0YQ7kNvwHze1sU&_nc_oc=AdpOOsa-I-qZszwAf6Mv--ZkxB3a1kvHVa5el5MdnMS5i2nlO51xr854PPoax_EmzZ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDVBWsSNXSmk8QG5ANT2TUR3vkTvvZFP2efia97GGkwg&oe=6A9AE1FA"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
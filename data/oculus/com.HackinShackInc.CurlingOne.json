GgKpPGSjtr1LJbZ8hLcpFBB-cVeJBb3BJLFlRzcO3kXgCsiD6PJ9-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPop9mqDrs_Ce2bQiSsZ26vz8S8gJVq3WMl61PslzTH0Q&oe=6ACE35A8"}, {"file_name": "end_over.png", "id": "907018370547600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_907018373880933_8858027341035918661_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOyKdBLJO28Q7kNvwHkF2Vo&_nc_oc=AdpYNrkDLir6SE0p53dLHpJ6B9JIez6T5jtTfaQ5RP9aHvlbMQrR9URBB82uayTFL1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXJlmEuEPlxtPOAxNxSaDKXr_VUoaa_Zn1byy_ofJL5g&oe=6ACE3C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "3397840737125172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_3397840743791838_5680916268405930213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYf-rzVowLMQ7kNvwHrlgw5&_nc_oc=AdqeLAzQbbAx0ZcRF91S8_vfAcRbnw7IxqJJBVdfZg1FljfQ1_CWIH13RETbktiFXJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoeBRpL6rBvbml5thE0ubVQcaS1IknfQwypOHPK_PQ6A&oe=6ACE4C7A"}, "display_name": "Curling One", "keywords": [], "long_description": "Curling One allows you to experience the sport of curling, from delivery and sweeping to detailed strategic planning and execution, in a fascinating 3D world.  The advanced physics engine produces realistic curl, effective sweeping functionality, and accurate impact results.  All of the basic curling rules are implemented, including the five-rock rule (free guard zone), hog line violations, and removal of out-of-bounds stones.  Play against an AI opponent, or with friends in pass-and-play mode.", "short_description": "Experience the sport of curling in this virtual reality world.  Deliver the stone and sweep, in single-player or pass-and-play mode.  Throw guards, draws, and take-outs.  Develop and refine curling strategies."}]}, "developer_name": "Hackin' Shack Inc", "developer_privacy_policy_url": "https://hacki
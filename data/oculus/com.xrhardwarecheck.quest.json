IaE_37vY8Rt2oXl_EYh2IipKqTRxRdpBip0lEsAnEkBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAOyzvj_HEHLZygPZx30_KWmfv6hDpjz6XauauuYemPQ&oe=6A7C4626"}, {"file_name": "5.png", "id": "27767982286177199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_27767982316177196_563084846001782302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyjs-NE4nxoQ7kNvwFKQs0Y&_nc_oc=Adp6vEQdGI55-MH0pfdFcByDINakkZ629xZCUHb049gPDc5cbRxmhXj-_bflLQCcbmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ53W7DRDEzztpB66sYVY3eVOHqUBvTGwEcrZJt8Melg&oe=6A7C4BFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR Hardware Checkup", "keywords": ["Diagnostics", "Headset", "Display", "Audio", "Hardware"], "long_description": "**XR Hardware Check** is an all-in-one diagnostic utility designed for Meta Quest headsets.\n\nQuickly inspect common headset functions through a clean, desktop-style interface. Test speaker channels, display colours, pixel patterns and pointer accuracy while viewing live device information such as battery level, thermal status, memory, storage and refresh rate.\n\n**Included features**\n- Left, right and stereo speaker tests\n- Low, mid and high-frequency audio tests\n- Frequency sweep and alternating stereo pings\n- Black, white, RGB, greyscale and alignment display patterns\n- Pointer selection and precision tests\n- Live battery and charging information\n- Thermal-status monitoring\n- Memory and storage information\n- Reported panel refresh rate\n- Panel frame-cadence history\n- Guided hardware inspection checklist\n- Locally saved diagnostic reports\n- Long-session monitoring\n- App brightness and display shortcuts\n\nDiagnostic reports are stored locally on your headset and are never uploaded.\n\nXR Hardware Check runs as a standard Horizon OS panel, allowing it to be moved and resized alongside your other apps.\n\n**Early Access limitations**\n\nPanel FPS measures XR Hardware Check itself and does not measure the performance of other games or the Horizon OS compositor.\n\nCurrent display tests cover the application panel rather than the headset\u2019s complete field of view. Current input tests focus on pointer and panel interactions. Full Touch-controller and immersive display diagnostics are planned for future updates.\n\nXR Hardware Check ", "short_description": "A local Meta Quest diagnostic utility for testing display, audio, pointer input and headset system information."}]}, "developer_name": "XR Hardware Check", "developer_privacy_policy_url": "https://sites.google.com/view/xr-hardware-checkup/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/d/1h-zg1e0uzLD5kd3xespOi37QLLa0y1i0/p/1jxNFEHl-SZKobZynGeXrYn60fAAAJEY1/edit", "publisher_name": "XR Hardware Check", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-hardware-checkup/privacy-policy?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1190086334196511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1065875825995013_7286228299473529980_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XvKS-RyXbkQ7kNvwHuTTFv&_nc_oc=AdpWiI77QwlQ4Jbgnk08Nbuml8sb_tM8QlmgHG2x07
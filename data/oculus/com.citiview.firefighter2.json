55468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNTrSke_ppwQ7kNvwH_m2Ug&_nc_oc=AdqyRCTEGD1OcBe-Lw5knTNrtihogCpJxleV5ob0d9f0GH2e2SRdYAT6mlA02xkiVgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpye2GS7oNCXYAAY172mP4On_hDBEARcWjZtSqe1HvZA&oe=6AF47A9D"}, {"file_name": "screenshot-4-2560x1440.png", "id": "1395183359403556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_1395183362736889_6019348780581805394_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuT-Ltjv7J4Q7kNvwFCFJ_M&_nc_oc=AdqkStvulRZC2MTiTW3z5Pv4QLtIXzuE8tFgxE4Bh8Yecilyniq7FsQy3gM60e_OxWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD8mwIOK2dDFJGMlJVkCjgLxKf0PeyHfFdcjzvj3Y2Aw&oe=6AF47188"}, {"file_name": "screenshot-3-2560x1440.png", "id": "1424187889638946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596168449_1424187892972279_7914752980701099252_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3lZJnDBuuIQ7kNvwF32DCq&_nc_oc=AdpTb9GfKR26J1ns-EbOSyoDe3ZAh9eL057lB0AmwP-7r-fylAYiEVPMSAUQOFArKyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGkRHb0VRqP5z8zqobUSxOL19RxtTp-NnHYy15MzOn6g&oe=6AF48130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1998470250849485", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_1998470254182818_1403232808173245831_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o6lKIpd5roQ7kNvwG3fwtU&_nc_oc=Ado_AX-LBVa8rqOTXO8kPeuT3Ctlwh2jBAvVPTHa24EiT9GmQf69Dzoc_jGN6CByUN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbuWrI_Pr90QjrMjK3jltFoDi1d5qkL6S-bg6cjD_dOw&oe=6AF46FD1"}, "display_name": "Firefighter 2", "keywords": ["firefighter", "fire", "hose", "simulator", "smoke"], "long_description": "FIREFIGHTER 2 is the sequel to Firefighter: bigger buildings, more fires and real black smoke.\n\nYou arrive with a charged hose line and a pistol-grip fog nozzle in your hand. Pull the trigger to open the bail and the water arcs out with real weight. Press A to spin the nozzle from a long straight stream to a wide fog. Your hose trails behind you along the floor through every doorway you walk.\n\nFOUR LEVELS\n- The Mansion: a grand two-storey home with 10 fires, from the great room sofa and the library bookcases to the kitchen stove and the bedrooms upstairs.\n- The Auto Shop: cars burning on the lift and in the bays, plus a battery fire and a bucket fire.\n- The Beach Cottage: an island cottage on fire - the veranda, the living room, a rowboat on the sand and the pier itself.\n- The Paint Booth: a sports car mid-job, the paint table, the masking paper and the paint drums all alight.\n\nREAL FIRE\nBlack smoke gathers under the ceiling, the haze thickens while the fires burn and clears as you win, soot climbs the walls and the furniture chars.\n\n- Wrist counter shows the fires left\n- Dispatcher radio calls\n- Clear times and personal bests for every level\n- Free movement with snap turning\n- No internet required\n\nEARLY ACCESS\nMore content is on the way during early access.\n\nCar models: \"Generic passenger car pack\" by comrade1280 (CC BY 4.0), modified.", "short_description": "Grab the hose and put out real building fires. Firefighter 2 sends you into four burning locations - a two-storey mansion, an auto shop full of burning cars, a tropical beach cottage and a paint booth - with thick black smoke rolling across the ceilings, soot climbing the walls and flames that grow back if you stop too soon. Drag your hose room to room, switch between straight stream and fog, and save every building."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-firefighter2.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-firefighter2.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfor
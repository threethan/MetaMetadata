202_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LredsfpZv_0Q7kNvwF0Cy88&_nc_oc=AdpRbHjliEawdLz8B2vtO-DihvD2TCBUjpFsjrKUxX3PXMb_q4XKXaOj46T4RYk1BV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBsfieYWXKXJAstM6WbvpmEioTSsizHnf_vGTV2AIIVA&oe=6B071B9F"}, {"file_name": "ss5 copy.png", "id": "1295184427641771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035394_1295184430975104_8458846718387014864_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eRlyKRUl1kQ7kNvwF06VeG&_nc_oc=AdqF-rNh9EN2cJxw5pU37cpOwbNckXKO9FcOyOdNgHUsKLRlhu9XpHpgE4nRSwxEjzE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp4MjHo2jgyDwiSAE0eWu18eCSCF2ienr_ayIThMlLPw&oe=6B070004"}, {"file_name": "ss4 copy.png", "id": "827748598886961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974457_827748605553627_5207887848812920530_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfEsdpdFOpIQ7kNvwGVw24n&_nc_oc=AdraUxsuMRhQKlk5BSLdITum6ufcLjuq3ZHqbVVV_s9evv4ZveRqv2sdfc-DTzjNbMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC4hnmhe4Hs3nzYXhENSoclpDn0MvdRwHP59m64d5n2w&oe=6B0711D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copy.png", "id": "1004604977515698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570305_1004604980849031_955649335753462243_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoHvB8Z1pbEQ7kNvwFl5c96&_nc_oc=AdrlkBUhgaRrxiLfgTCZwQb_4nITBHB0XuNV6YOOQ5e6l9ZbNez4Jw-L1P_ZvM07Gm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHFSd3Vk2xwvZHo88QBkglq1DBkC3PThF5M5McttMOZg&oe=6B071CA4"}, "display_name": "Quest Together", "keywords": [], "long_description": "Welcome to Quest Together!\n\nTake up your sword and shield and go on a quest with your friends!\nQuest Together is a social VR game where you can hang out and play together. As a new Rookie Hero, you get stationed in a small town that's been suffering from recent monster attacks. Take up quests and defend the town from monsters and help out with the villagers' requests. Meet other Heroes in town, make new friends, team up together for adventure, or partake in some PVP matches!\n\n- Enjoy online multiplayer in VR and make new friends, or invite your existing ones\n- Form 4-player parties and go on co-op quests together\n- For the competitive Heroes, enjoy a PVP mode in the arena to earn new gear and rewards\n- Customize your character with a variety of options and items\n- Unlock new weapons, armor sets, outfits and gear by playing\n- Strategize with your party by dividing roles: melee, ranged, support, etc.\n- Work your way up from small fry goblins to large bosses that won't go down without a fight", "short_description": "Take up your sword and shield and go on a quest with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://questtogether.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "QuestTogetherVR", "support_website_url": null, "website_url": "https://www.questtogether.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "429131118912212"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "970326795639329"}, {"status"
202_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctakiA30GbAQ7kNvwE4LSRb&_nc_oc=AdrR-vlzE_WCLgwQUY3vKgwjIBfhaYnvFL4-jOkohDa-hhRyATOp07hMOFUhXf313Ws&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWsBsjCb8KiQcrnuCAhlh5L5UVSScarosewPb54vpfPQ&oe=6AFB3E1F"}, {"file_name": "ss5 copy.png", "id": "1295184427641771", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035394_1295184430975104_8458846718387014864_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yutiSMXrzHkQ7kNvwFJl1u9&_nc_oc=AdrXKRXsgWN7sD4xTlg9a1nviPsCt0hWz4fXjhzNmevAI8ehHSo0s90k_q_vfRti_bE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkZCCPDieNMkWcRuTSIyZU8YurZ8a4V0TZbkcjKCrEgg&oe=6AFB2284"}, {"file_name": "ss4 copy.png", "id": "827748598886961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974457_827748605553627_5207887848812920530_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98o5gJrUYX4Q7kNvwFVaZCF&_nc_oc=AdqQgxvTwozgfVPIESwYH87y7g5Ijb1GvQWLk5eaYDc91mVK6i07n3l9I0xD3POoT78&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSukGFzyhWmsG0RIXhR9QDGZ_-NkukBNf7EWVPu0OivBQ&oe=6AFB3455"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copy.png", "id": "1004604977515698", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57570305_1004604980849031_955649335753462243_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAbyObu3kBwQ7kNvwFzxqRl&_nc_oc=Adr8nv0XBkgT5CfjvPBxH8MuS-TqN0ExOJQoZCZJTmbZKgYRoB27X-qO5AIHb_fm0Xo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_-ODCHRiO2HYCg3dHxZZtyY_xPwQNyMHnODwyyYKioQ&oe=6AFB3F24"}, "display_name": "Quest Together", "keywords": [], "long_description": "Welcome to Quest Together!\n\nTake up your sword and shield and go on a quest with your friends!\nQuest Together is a social VR game where you can hang out and play together. As a new Rookie Hero, you get stationed in a small town that's been suffering from recent monster attacks. Take up quests and defend the town from monsters and help out with the villagers' requests. Meet other Heroes in town, make new friends, team up together for adventure, or partake in some PVP matches!\n\n- Enjoy online multiplayer in VR and make new friends, or invite your existing ones\n- Form 4-player parties and go on co-op quests together\n- For the competitive Heroes, enjoy a PVP mode in the arena to earn new gear and rewards\n- Customize your character with a variety of options and items\n- Unlock new weapons, armor sets, outfits and gear by playing\n- Strategize with your party by dividing roles: melee, ranged, support, etc.\n- Work your way up from small fry goblins to large bosses that won't go down without a fight", "short_description": "Take up your sword and shield and go on a quest with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://questtogether.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "QuestTogetherVR", "support_website_url": null, "website_url": "https://www.questtogether.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "429131118912212"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "970326795639329"}, {"status"
t-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkdLxHJxA8FgUu_jW2DwL6Tdf1oWIicq0UzNWkSVmfIw&oe=6B05D739"}, {"file_name": "ss04.png", "id": "1555810735740590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_1555810739073923_3586730637425458974_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoCAOnHI7B4Q7kNvwENjPYf&_nc_oc=AdqrUw0fJ9FHv4K7jgYB5xI_0pSpsxRLjqBIVhi6EdVXRAdbwW9zQZpidKSEi-topfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSnYhl7zddawndOufH6_nrZwlPwxEFIJCYShoiwABvbw&oe=6B05A445"}, {"file_name": "ss05.png", "id": "1195708815323225", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507883442_1195708818656558_245947397122507213_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuEBOAgA70cQ7kNvwEpaLCY&_nc_oc=AdrBU0UTHmUSYKdLVRCueWFfd4GwKnLpeHo2UBj2mvnNifAIy1ON7YwFVuNhdRbhXKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5QLeAneMFgJL6rlt_NFLiJVztsSkPQnPXKKBuPr7duA&oe=6B05DA23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1296139059337329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313390_1296139062670662_8831087196547486546_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_36MvHahaUQ7kNvwEJ0V9_&_nc_oc=AdpZtnAerXtDF0evQ-jZMPApo9rWklQl0rouv6LEdA6a4wpTLTauUnW5MRgMwc4BZhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgTifnTa_z614V9uwzfwKDizzkpyVa3Q9lMzSl5kU7fw&oe=6B05CB87"}, "display_name": "QUEST TOGETHER Online", "keywords": [], "long_description": "Take up your sword and shield and go on a quest with your friends! \n\nQUEST TOGETHER Online is a social VR MMORPG where you can hang out and play together. As a new adventurer, you get stationed in a small town that's been suffering from recent monster attacks. Take up quests and defend the town from monsters and help out with the villagers' requests. Meet other adventurers in town, make new friends, team up together for adventure, or partake in some PVP matches!  \n\n - Enjoy online multiplayer in VR and make new friends, or invite your existing ones\n- Party-based combat with up to 4 players per battle \n- For the competitive Heroes, enjoy a PVP mode in the arena to earn new gear and rewards\n- Customize your character with a variety of options and items\n- Unlock new weapons, armor sets, outfits and gear by playing\n- Strategize with your party by dividing roles: melee, ranged, support, etc.\n- Work your way up from small fry goblins to large bosses that won't go down without a fight", "short_description": "Take up your sword and shield and go on a quest with your friends in QUEST TOGETHER Online, the VR MMORPG. Rise up the ranks in the adventurers guild, hang out with your fellow questers, make new friends, team up together for adventure, or partake in some PVP matches!"}]}, "developer_name": "Studio.QT", "developer_privacy_policy_url": "https://questtogethervr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio.QT", "support_website_url": null, "website_url": "https://questtogethervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28045813805007224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculu
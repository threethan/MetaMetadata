SUv9X6YO6HGsBRqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzNdDdCCdPBYBkMP5EyViEU6MQKF3V2tEz3RUU68yYRw&oe=6AAAB704"}, {"file_name": "ss4 copy.png", "id": "827748598886961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974457_827748605553627_5207887848812920530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBetRbe76HgQ7kNvwGfrFJ1&_nc_oc=AdqxmItgx1n99rLtJ5k3PGABJRTqDzAF-4KBUiZ4a7BwnTIIICoShmcC-0cwGaDdZ7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISiR3rdBi56LcVqexyPBTAhk_FlgSrpcOPhAquGAonfg&oe=6AAA9095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copy.png", "id": "1004604977515698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570305_1004604980849031_955649335753462243_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJkyKGT6GbAQ7kNvwGsme8E&_nc_oc=AdqeJwDaUYQbS22Mee8f8Gyq19dpRegPdTnJ4xRsl78FJvpwvbpzK9dlE6mWwikjTMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvEHfvCi18gue5BBRI8cGdPgvliUPXy4y-9uRf2_dlmg&oe=6AAA9B64"}, "display_name": "Quest Together", "keywords": [], "long_description": "Welcome to Quest Together!\n\nTake up your sword and shield and go on a quest with your friends!\nQuest Together is a social VR game where you can hang out and play together. As a new Rookie Hero, you get stationed in a small town that's been suffering from recent monster attacks. Take up quests and defend the town from monsters and help out with the villagers' requests. Meet other Heroes in town, make new friends, team up together for adventure, or partake in some PVP matches!\n\n- Enjoy online multiplayer in VR and make new friends, or invite your existing ones\n- Form 4-player parties and go on co-op quests together\n- For the competitive Heroes, enjoy a PVP mode in the arena to earn new gear and rewards\n- Customize your character with a variety of options and items\n- Unlock new weapons, armor sets, outfits and gear by playing\n- Strategize with your party by dividing roles: melee, ranged, support, etc.\n- Work your way up from small fry goblins to large bosses that won't go down without a fight", "short_description": "Take up your sword and shield and go on a quest with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://questtogether.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "QuestTogetherVR", "support_website_url": null, "website_url": "https://www.questtogether.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "429131118912212"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "970326795639329"}, {"status": "PUBLISHED", "id": "1236084671973918"}, {"status": "PUBLISHED", "id": "2092235711546973"}, {"status": "PUBLISHED", "id": "1397282505389034"}, {"status": "PUBLISHED", "id": "1783997358912941"}, {"status": "PUBLISHED", "id": "842732548390655"}, {"status": "PUBLISHED", "id": "813646851008336"}, {"status": "PUBLISHED", "id": "785569309932948"}]}, "baseline_offer": {"id": "970326795639329"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781875440, "status": "PUBLISHED", "id": "970326795639329"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28739271768994754", "version"
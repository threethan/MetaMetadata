t-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWjB42QndeBaTwwCRxP30cx2-uJOhfrIQjA_ZaLgYWCw&oe=6B0B1D39"}, {"file_name": "ss04.png", "id": "1555810735740590", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821696_1555810739073923_3586730637425458974_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W21e8tzn8ogQ7kNvwHNxwrv&_nc_oc=AdqkHRbf2SEcmk2QxCuBWM57guH0LMT4hDll9ovyfkpN5mEo7S7BPF0cSxgedZegBq0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAMPRpT2mKZ2K1zP6SuGVGOBsPJEyjWS2QTco7v6LTSQ&oe=6B0B2285"}, {"file_name": "ss05.png", "id": "1195708815323225", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/507883442_1195708818656558_245947397122507213_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukmviTYCM3EQ7kNvwFEkaI-&_nc_oc=AdoIQGmcbcJtsWO04xrhRu5No_k42Jcv8XaxwLAVTll21jtOIi-lSQsKXjMnCY55Eo4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT34LK5dtvBKA1NN-LbwODztGmVfY5cU-V0xuCPmQmc2g&oe=6B0B2023"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1296139059337329", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499313390_1296139062670662_8831087196547486546_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9AEE561BDAQ7kNvwHuF2hR&_nc_oc=AdrqkwMF1c39w4OefdEzdoDRboq9QhN5uiZJL16U4wFIXldBVC4sJVi5jxzuyN6za5o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4wSJzYftD-V3RquJT2O9Vi51QNGGGAFRBz6TPzaHMrQ&oe=6B0B1187"}, "display_name": "QUEST TOGETHER Online", "keywords": [], "long_description": "Take up your sword and shield and go on a quest with your friends! \n\nQUEST TOGETHER Online is a social VR MMORPG where you can hang out and play together. As a new adventurer, you get stationed in a small town that's been suffering from recent monster attacks. Take up quests and defend the town from monsters and help out with the villagers' requests. Meet other adventurers in town, make new friends, team up together for adventure, or partake in some PVP matches!  \n\n - Enjoy online multiplayer in VR and make new friends, or invite your existing ones\n- Party-based combat with up to 4 players per battle \n- For the competitive Heroes, enjoy a PVP mode in the arena to earn new gear and rewards\n- Customize your character with a variety of options and items\n- Unlock new weapons, armor sets, outfits and gear by playing\n- Strategize with your party by dividing roles: melee, ranged, support, etc.\n- Work your way up from small fry goblins to large bosses that won't go down without a fight", "short_description": "Take up your sword and shield and go on a quest with your friends in QUEST TOGETHER Online, the VR MMORPG. Rise up the ranks in the adventurers guild, hang out with your fellow questers, make new friends, team up together for adventure, or partake in some PVP matches!"}]}, "developer_name": "Studio.QT", "developer_privacy_policy_url": "https://questtogethervr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio.QT", "support_website_url": null, "website_url": "https://questtogethervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28045813805007224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculu
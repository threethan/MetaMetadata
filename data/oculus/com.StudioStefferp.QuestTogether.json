202_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctakiA30GbAQ7kNvwGMMJO9&_nc_oc=Adp_1ooUYopk0GoAco9ZhwYmNkWn3jsiVJGTWGTM2e7waKVFhcMp-E0GVOI8ErFjsK0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvJjbq3zKzwIWpjaURhAH9n4yeXSAVok8DkjnGACqi4w&oe=6AFC8F9F"}, {"file_name": "ss5 copy.png", "id": "1295184427641771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035394_1295184430975104_8458846718387014864_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3iCLaDjq_gQ7kNvwGFOleW&_nc_oc=AdrSIogzgQEq12dwrbFFqwSxj3CXZEwpD-HUkyKjhN_Z4kKGifc-cTYQYpn7Tl_NW6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGcW9vq8a6V9-HRefyC6FgEhGNdpQOSgu7aC8FUykb9w&oe=6AFC7404"}, {"file_name": "ss4 copy.png", "id": "827748598886961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974457_827748605553627_5207887848812920530_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98o5gJrUYX4Q7kNvwEZaFFN&_nc_oc=Ado7pXWoMtcWv_tUkv-CvgOI3gOdEyYrduFjjj3AVLKq-WDHgMZT0derH3PnUul7J68&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSRceb9Uc1i6sPH3oBny-253wmOoOq2fyzPx77nscfuQ&oe=6AFC85D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copy.png", "id": "1004604977515698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570305_1004604980849031_955649335753462243_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAbyObu3kBwQ7kNvwG3TwCC&_nc_oc=AdrER0kgCUUqzS2j2nN1idNpdCjOlptRmIl78nCofHQCmkNJ3DczJlJLPQ-ARbQ7Odo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGSF1u3ajJDTnpbmni-vcUDbaxJVFQS0NCN1QLv9xdPQ&oe=6AFC90A4"}, "display_name": "Quest Together", "keywords": [], "long_description": "Welcome to Quest Together!\n\nTake up your sword and shield and go on a quest with your friends!\nQuest Together is a social VR game where you can hang out and play together. As a new Rookie Hero, you get stationed in a small town that's been suffering from recent monster attacks. Take up quests and defend the town from monsters and help out with the villagers' requests. Meet other Heroes in town, make new friends, team up together for adventure, or partake in some PVP matches!\n\n- Enjoy online multiplayer in VR and make new friends, or invite your existing ones\n- Form 4-player parties and go on co-op quests together\n- For the competitive Heroes, enjoy a PVP mode in the arena to earn new gear and rewards\n- Customize your character with a variety of options and items\n- Unlock new weapons, armor sets, outfits and gear by playing\n- Strategize with your party by dividing roles: melee, ranged, support, etc.\n- Work your way up from small fry goblins to large bosses that won't go down without a fight", "short_description": "Take up your sword and shield and go on a quest with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://questtogether.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "QuestTogetherVR", "support_website_url": null, "website_url": "https://www.questtogether.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "429131118912212"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "970326795639329"}, {"status"
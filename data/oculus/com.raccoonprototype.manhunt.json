066220810783_7296466736784676056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPgHu2Uh9V0Q7kNvwGiym5d&_nc_oc=AdoFYU7FSdKjCh4yNerxZvIQz1PWQmC9ljzTdO3ZnI4m6C5fe57QptAP0vGcGK8S0vI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyQeykY-Sm1zUEFvXAwpL8qeLUi5VfmujHEtJsJCqKYg&oe=6AF8853C"}, {"file_name": "04_ScreenshotSurpriseHuman2560x1440.png", "id": "2058826038330037", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_2058826041663370_8632099954226313959_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAAZ27s9ARAQ7kNvwFF2_jE&_nc_oc=AdqSxlWev6aSY2tZQb_heCgsOFFZy5-W_zEFyZHiYIYfAo4qWgz16RX9KdVBYZmC1_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBSPocgYyQ9UQ2AMby4Gnk8Ke4xmwhmLALJktOWkZV_w&oe=6AF89912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_TrailerCover2560x1440.png", "id": "1890568385255544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1890568391922210_5119556642576551875_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2bJPVLhLXsQ7kNvwEwAz5Q&_nc_oc=Adqa-XhgkH8VSdSIPGrmhnl0PLJc_pyp7DemHRWn-B1it-GboQ8d5rOa--92C2PKjbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt62HOAoS4_aM_AKIdS3YudblBESm6D-yj3wQlve8oTA&oe=6AF8ACEB"}, "display_name": "Raccoon Mayhem", "keywords": ["raccoon", "climbing", "playground", "sandbox", "physics"], "long_description": "Big trees. Little paws. Plenty of mischief.\n\nRaccoon Mayhem puts you inside a playful raccoon playground. Use your hands to move, climb, grab, and throw as you explore a colorful forest filled with places to play.\n\nEXPLORE ABOVE AND BEYOND\nClimb tall trees, cross elevated bridges, and follow a mountain tunnel to another playground. Bounce on trampolines and make your way up to a treetop house.\n\nMEET PIP\nSpend time with your raccoon companion, Pip. Race together, get into playful boxing matches, and watch him react to your antics.\n\nMAKE SOME MISCHIEF\nSurprise the park's human visitors, snatch a snack, and experiment with objects you can grab and toss.\n\nSHOW YOUR RACCOON STYLE\nSee your raccoon reflection in the mirror, earn stars through activities, and collect cosmetics. Store your collection beside the mirror and discover special items in the treehouse shop.\n\nPlay solo with Pip or try local multiplayer for up to four players on the same Wi-Fi network. Internet multiplayer is not currently available.", "short_description": "Become a mischievous raccoon in a playful VR forest. Climb towering trees, bounce on trampolines, explore a treetop hideout, and cause chaos with Pip, your raccoon companion. Earn stars and express yourself with cosmetics in a colorful, blocky playground"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omegacortex.ai/games/raccoon-mayhem/privacy/", "developer_terms_of_service_url": null, "publisher_name": "OMEGACORTEX LLC", "support_website_url": "https://www.omegacortex.ai/games/raccoon-mayhem/support/", "website_url": "https://www.omegacortex.ai/games/raccoon-mayhem/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1334044696458425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_956021416802332_5385943869287469158_n.
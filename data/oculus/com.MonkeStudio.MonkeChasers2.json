_3399092923686825_8642051988661028241_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AY_fTk7gBOwQ7kNvwEhFrem&_nc_oc=AdlPKbNcZ3usA4k5U1nz_2Jjd1G3bqUXdUjib61h7jGrItr_NskRBG4GVo9QPNoqbJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv4j-lyMvariX3AGIoRUf4gRedoxnHnqR8yzcNy69DPxQ&oe=699C431F"}, "display_name": "Monke Chasers 2", "keywords": [], "long_description": "In this game you play as a monke and run around the maps! You can also drip your monke with cosmetics, but don't forget, this is coming out of your paycheck. There's lots of nice of nice mods but don't mess up because they have a special item with them! Enjoy being monkey because you are a monke stupid! Join the Discord: discord.gg/monkechasers", "short_description": "This game has gorilla tag locomotion, this game is about monke, that's it. Nothing else to now expect being a monkey! Join the Discord: discord.gg/monkechasers"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkechasers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dxtor", "support_website_url": null, "website_url": "https://sites.google.com/view/monkechasers/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "680614817144067"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1356309551962036"}, {"status": "PUBLISHED", "id": "555547836370596"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_t
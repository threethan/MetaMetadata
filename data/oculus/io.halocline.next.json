t=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxewRc3hy1dzF7SUUj7jbb2Jtu2cc13PLj_5TbpLOI2A&oe=6B0723A8"}, {"file_name": "Halocline Logo.png", "id": "997969496343009", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_997969499676342_1213032733919189071_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY7q8nw4PJMQ7kNvwHvPf5M&_nc_oc=AdolNKpaH2UBGDDy2pcOZytjRHpKGbV-NHqcbj0A2BDlHTd8-kGvVV6qVXbPGu2AL_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0m6yHNSkUJ3yrJxNjcyrji-rFfL9SQ9VdGqFFcTh_1w&oe=6B070A95"}, {"file_name": "Halocline Logo (2).png", "id": "774585535717519", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_774585539050852_9045340122397664913_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmhsryBzxF8Q7kNvwFBEdHb&_nc_oc=AdqzGNm4IPMJ2RKk5SFc_ShPyMoQz2puTt26qgcdX6GS2atw3_u23YWQMwn4Rb5puqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe5-3ko66LoFVmB54pjh_nsDTWrsGY0f0yHRGZMFZKIQ&oe=6B07193F"}]}, "id": "1433808125589722", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "1353141853420415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313390_1353141856753748_3655664760087552442_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGdbMDuE5nMQ7kNvwGo45w0&_nc_oc=AdqnuTGw8HM6x0HhkQCHbHJt-8mR2rucEFDIly1m2ngx0SGghr5pjqGQvc6qoquHevg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSgwYpz8zdIEWbfrl6DKcgM0TAuNkPPYn1R2nH9gfZyg&oe=6B06F188"}, {"file_name": "Screenshot 3.png", "id": "2400741747080296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312332_2400741750413629_39441032803366670_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jkJCBmM0egQ7kNvwG8HnFm&_nc_oc=AdpyI4xh_V3TonBL5J6T2BifUccR5R_Jvaq5f4ls6yl6_kkvj13JoX_KPZ6sHsWgzvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzzB9mioA_jyF9b-5Z2xLNT3TqfxoAmMDHc2ubztVerw&oe=6B0720AB"}, {"file_name": "Screenshot 4.png", "id": "2468777213589423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307931_2468777216922756_3485215605053437134_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byC588kH8CMQ7kNvwEx-O3I&_nc_oc=AdoK63SLIy80mOTwKLujSWTgxXJHoqIlvVfRtKV9M6xQSQ03wNBIOqFU3Zb2zLJCUZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-7o5jOQO-oJZYpsMQL3ta2lyl49eyYTr7wTIRCf_B3g&oe=6B071DF4"}, {"file_name": "Screenshot 5.png", "id": "1036174832317589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302374_1036174838984255_7128987048797142672_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cokc6jbWRb8Q7kNvwFoPOdm&_nc_oc=AdqupZkKf5kh5mNvoqteU8OX7C5LevlXJOtQj_0GzlaP4Dky2KDnRp7vMgkP7Lqy-Q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9ZwrLirc99FHIXcjMbK24JXmFtMtvwsYOhMCm5y6jag&oe=6B070C91"}, {"file_name": "Screenshot 2.png", "id": "2538557443248081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604328314_2538557446581414_3087707058072397930_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNuWkiBIxBkQ7kNvwEMUbpS&_nc_oc=Adrx8own0FoBSz8MvyqJ8dv5vVz5La3sRhhuJcnmxJlUpJobBF9q4WMfO_8S7azrl_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5jiH7f0qkBxJ411Ny3_QMnwOBc7WRRfkDCH_b9ws03A&oe=6B06F486"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Halocline XR", "keywords": ["layoutplanning", "mixedrealityfactory", "productionplanning", "industrialengineering", "leanmanagement"], "long_description": "# Halocline XR \u2014 See your factory layout before you build it\n\nWalk through your next production line at full scale \u2014 between the machines that are already there. Halocline XR turns layout planning from a screen exercise into a decision you make on the shopfloor.\n\nPlans may look fine in CAD. Standing inside them is where the real questions appear: Does the forklift path clear the shelf? Is the operator reaching too far? Halocline XR places machines, workstations, shelves and vehicles at 1:1 \u2014 virtual where your new equipment will go, real where it already stands. You walk it, adjust it, decide before anything moves.\n\n## Features\n\n- **Prebuilt industrial library** \u2014 machines, workstations, shelves, vehicles and automation, ready to place\n- **Real-scale, walkable layouts** \u2014 between existing equipment or fully virtual for greenfield spaces\n- **Precise editing** \u2014 move, rotate and resize to exact dimensions; duplicate entire rows from a single asset\n- **Halocline Web sync** \u2014 open the same layout in the browser; existing Halocline files work on-site without conversion\n- **Built for the shopfloor** \u2014 bring stakeholders into the layout, not into another meeting\n\n## Who it's for\n\n- Industrial engineers planning new lines, cells or workstations\n- Lean managers running layout reviews with their teams on-site\n\nLearn more: **www.halocline.io**\n", "short_description": "Plan your layout at real scale where it'll be built. Halocline XR turns your Quest into a layout planning tool for the shopfloor. Drop machines, workstations and dozens of prebuilt library items at 1:1 between your existing equipment \u2014 and walk through the layout before anything is moved.\n\nPlan on-site in XR, refine on your laptop in Halocline Web, review with your team on either device \u2014 one layout, always in sync."}]}, "developer_name": "Halocline GmbH & Co. KG", "developer_privacy_policy_url": "https://www.halocline.io/en/privacy-web-xr", "developer_terms_of_service_url": null, "publisher_name": "Halocline GmbH & Co. KG", "support_website_url": "https://helpdesk.halocline.io/hc/en-us", "website_url": "https://www.halocline.io/", "category": null, "comfort_rating": "COMFORTABLE_F
{"data": {"node": {"__typename": "Application", "id": "8051969074838801", "organization": {"id": "798192889003080", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8051969074838801"}]}, "id": "1734047824064506"}]}}, "firstRevision": {"nodes": [{"application": {"id": "8051969074838801", "release_date": 1794929040, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29123271997281869"}, "id": "1046073440358083"}]}}, "binary": null, "live_binary": null, "created_date": 1794929993, "id": "29107100495565686", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29007131002229303"}, "release_status": "RELEASED", "id": "8051969074838801"}, "id": "29007131002229303", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "PENDING", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_4412486758999798_6073501546593111632_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PnROJAFF0wQ7kNvwFtEdx2&_nc_oc=AdqfaBt659HxuH6cqP4gn54u4I0uNILFoYKHoXIbmdOi-8RR8lPW3BzZNCNwhK4tFWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuxO_nclpiIHpKou8huFlAPh6CpaRhlbx_XSJZcP5yow&oe=6B07250F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Halocline XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1794929040, "lastRevision": {"nodes": [{"id": "8051969114838797", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8051969074838801", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1191005243161668"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3303562703177888", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Halocline XR", "keywords": ["Layoutplanung", "Fabrikplanung", "IndustrialEngineering", "LeanManagement", "MixedReality"], "long_description": "# Halocline XR \u2014 Sieh dein Fabriklayout, bevor du es baust\nGeh deine n\u00e4chste Produktionslinie im Ma\u00dfstab 1:1 ab \u2014 zwischen den Maschinen, die schon stehen. Halocline XR macht aus Layoutplanung am Bildschirm eine Entscheidung in der Halle.\nPl\u00e4ne sehen im CAD oft gut aus. Aber erst zwischen den realen Maschinen tauchen die richtigen Fragen auf: Kommt der Stapler wirklich an der Regalkante vorbei? Greift der Werker zu weit? Halocline XR platziert Maschinen, Arbeitspl\u00e4tze, Regale und Fahrzeuge im Ma\u00dfstab 1:1 \u2014 virtuell, wo neues Equipment hinkommt, real, wo es schon steht. Du gehst es ab, passt es an, entscheidest, bevor etwas bewegt wird.\n## Funktionen\n- **Industrielle Bibliothek** \u2014 Maschinen, Arbeitspl\u00e4tze, Regale, Fahrzeuge und Automatisierung, sofort platzierbar\n- **Begehbare Layouts im Ma\u00dfstab 1:1** \u2014 zwischen bestehendem Equipment oder virtuell auf der gr\u00fcnen Wiese\n- **Pr\u00e4zise Bearbeitung** \u2014 verschieben, drehen, skalieren auf den Millimeter; ganze Reihen aus einem Element duplizieren\n- **Halocline Web Sync** \u2014 dasselbe Layout im Browser \u00f6ffnen; bestehende Halocline-Dateien laufen vor Ort ohne Konvertierung\n- **F\u00fcr die Halle gemacht** \u2014 Stakeholder ins Layout holen, statt in ein weiteres Meeting\n## F\u00fcr wen\n- Industrial Engineers, die neue Linien, Zellen oder Arbeitspl\u00e4tze planen\n- Lean Manager, die Layout-Reviews im Team vor Ort durchf\u00fchren\n\nMehr erfahren: **www.halocline.io**\n", "short_description": "Plane dein Layout im Ma\u00dfstab 1:1 dort, wo es gebaut wird. Halocline XR macht aus deiner Quest ein Layoutplanungs-Tool f\u00fcr die Halle. Platziere Maschinen, Arbeitspl\u00e4tze und dutzende vorgefertigte Bibliothekselemente 1:1 zwischen deinem bestehenden Equipment \u2014 und geh das Layout ab, bevor etwas bewegt wird.\n\nVor Ort in XR planen, am Laptop in Halocline Web verfeinern, mit dem Team auf beiden Ger\u00e4ten reviewen \u2014 ein Layout, immer synchron."}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "4533316160284314", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824700_4533316166950980_5471980951702086733_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvBCOBMQcKgQ7kNvwH9pG-B&_nc_oc=AdpJ284akBqHmgb5-WOTB7z11PtfDLjGfmxpH3098TtIyUUMQz-SItLJokq1Xd2BEbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmPDkwbdGWhdIJ22x8OjbA2lXg1vDg8Sxvf881IYJWGg&oe=6B06FD54"}, {"file_name": "Cover Square (2).png", "id": "4412486755666465", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_4412486758999798_6073501546593111632_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PnROJAFF0wQ7kNvwFtEdx2&_nc_oc=AdqfaBt659HxuH6cqP4gn54u4I0uNILFoYKHoXIbmdOi-8RR8lPW3BzZNCNwhK4tFWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjZ2M_VGHOuP7sKpXUXD28y23QJOgu77OihZhYXZionQ&oe=6B07250F"}, {"file_name": "Spatialized_Foreground_512px .png",
611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269588_4683731468518944_1540423267916520940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS7mphcJsb4Q7kNvwEIHBjH&_nc_oc=AdpdIGKtZ9I_AAPPUhSO0y8lIt7JU9hmvy20b-nLk-6OUL1Zug2mWetEFqL31Brb2FM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl8ErPDM-nIElwlwBahgEHxkFccpQVr0gLhPxQOQAFpQ&oe=6AEF4905"}, {"file_name": "5cb520109d2e4303a8af865c5ea32ae5.png", "id": "552598740736831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974647_552598744070164_6122924417793959877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cel9SWScPZsQ7kNvwHtGSMZ&_nc_oc=AdrRf5o6QZRI7emn_QS7EKOBwnPOK6DhBhkd_G-BybVF56V4tIu-eey8NaqZQUlf31s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7J886orcotvW4XEq9jTQqyloWFwUQoRwMcXVqeECA_w&oe=6AEF3935"}, {"file_name": "e41877ecd90c483592a7a298ad2f5c84.png", "id": "937555581591749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395591_937555588258415_2719448633370451320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIU_O0zPQm8Q7kNvwGQhbOn&_nc_oc=AdqNX9_FzBao0sXFJYbSLkmsrww3WYsdSM-GHIVH6804rbgVyl37FWz2GyJ86QXWnfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPmoC6hB4gbD8VpwMFTrTE1OISoOkOF35fb0y31P-dpA&oe=6AEF3C89"}, {"file_name": "com.CruelByte.Slowp-241201-031735.png", "id": "1683451575848228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207243_1683451579181561_6208308894005236034_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-kg8kPpm_wQ7kNvwEkJuBY&_nc_oc=AdqUz3-irUz61ruS3Ir5lD1Sf44yMV3TvEdS-qQbUe8xYAJ37w6nk_qqRXTHeaqF3B0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7yvJIRm54p6k-zSypVIqqFkmQNQ3oI7SH5-BZJkUURg&oe=6AEF3EF9"}, {"file_name": "6053753c6ffc40558af9677ebb292bbc.png", "id": "539764895698066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86665725_539764899031399_710732249969276897_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ntavv4kmCAsQ7kNvwFgUb5Q&_nc_oc=AdpVCefwV2PfhFZWTYeXYMsyf6t7U5BSaJCuQRpw87VLgUPiIQ_vJHE7eE3IAoDxbLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa7gwE52xRUUznKRbnm57BjEV89suPV_YXzrLqXZqoOg&oe=6AEF530D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "principalclareada.png", "id": "1425438239515962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_1425438242849295_1188010789252204980_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGp3hzGIYlwQ7kNvwGA6uE9&_nc_oc=AdrPyBMpWO4LlhtQeaap5XMGbL_-s6A_ECJzt9ixI-r9d-Y_18yNqSO_6oxrMOCklFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5oybH3jA3Pl3Elzs73Tdtxwv1WvbWnmwNIx7WeWdZlA&oe=6AEF4C95"}, "display_name": "Slowp", "keywords": ["snowboard", "carve", "ski", "slope", "skate"], "long_description": "**We want you to feel as good as riding in real life!**\n\nAs real-life snowboarders, we believe carving the snow in VR should be the best feeling in the world, so we tuned the physics until it felt perfect. \n\n**Snowboard**, **Ski** or **Snow Skate** with friends having full control of your board! Carve, jump, and grind rails. Explore 50+ official maps plus 1200+ community-created maps!\n{2137596933351413}\n\nRide on steep slopes, bowls, ramps, loops, narrow and large trails, ice caves, and many more totally crazy tracks. You can even create your own maps using Gravity Sketch.\n{1390431582091653}\nAll players are competing for time and best tricks on each map. \nYou don't want to be left out of this mountain party! Bring your friends and join us in multiplayer today!\n\nFEATURES:\n- **Full control** using your hands as feet\n- **Grab tricks** included!\n- **Realistic Snowboard, Ski and Snow Skate physics**\n- **New Gears** being added constantly.\n- Explore **50**+ **official maps plus 1200**+ **community created maps**\n- Change your character and your **board skin**.\n- **Multiplayer** fun!\n- **Race** against other players best time. \n- **Footage mode** to capture your best runs from any angle.\n- **Change the time of day** and world biome.\n- Optional virtual goggles to **eliminate motion sickness**.\n- Find **secret areas**.\n\n{1027522485490012}\n**Slowp** is still in development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "Missing the thrill of carving the snow? Snowboard and Ski in VR. Tuned by real riders until it felt real. Bring your friends and join us in multiplayer!\n\n\n\n"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28199970786362758"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596149727_966605386344136_8793741730025676844_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctu85bFogjUQ7kNvwEcHrQZ&_nc_oc=AdpmUOh3mWS_vJX3raWKNeuIaXTqrCuMUHSgm1-YxHrqQJ6bqRfju5aLpQJr1SvTJl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=0
11", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269588_4683731468518944_1540423267916520940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhIR4CeQny8Q7kNvwFy61-d&_nc_oc=Adp0FxswLMiZgbgMygLhUGu-tez35rYzkVkySfE8RhlfPI9EeBrw37G2XBKCXa08v0o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-RdhYhgmXhcRhyEXtOuxex_uP2jTWVn3gNpdLwxoUUQ&oe=6AAD5E05"}, {"file_name": "5cb520109d2e4303a8af865c5ea32ae5.png", "id": "552598740736831", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974647_552598744070164_6122924417793959877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9XPiIxI55MQ7kNvwG7DNSk&_nc_oc=Ado1YWIE_P7RZ1adp7NBFvzXuaso4b3OcW9Fq5Mi63055aMejBkFldryxWfGjImu0ng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKpdGjTQ0DvyIwU86VR_97J4rWyqCuNx3Ga6I0nvwAhQ&oe=6AAD4E35"}, {"file_name": "e41877ecd90c483592a7a298ad2f5c84.png", "id": "937555581591749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395591_937555588258415_2719448633370451320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0XT0XHWzwAQ7kNvwFhS0LO&_nc_oc=Adp308PedIKQ0_nvlKS4b-zGb6pQvKg-0DBVvL0oe_r94qh2Ud8aRyGeIcveAshuGX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRUgNqIW2ezAIMwXwVbh326sTHFVNoOiy-I2ztXrJNOQ&oe=6AAD5189"}, {"file_name": "com.CruelByte.Slowp-241201-031735.png", "id": "1683451575848228", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207243_1683451579181561_6208308894005236034_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gZF69CduKEQ7kNvwGJ4DC1&_nc_oc=AdoCaz_nsZrXUgcuY29oWul8ClHo41vjnc6MTyTqLmDNDRY3rZ8AFEufNg45xkXtlzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNSzd0Xv5RLARQqPqQMwNL3s93hi7oHtYj73msy8oMaQ&oe=6AAD53F9"}, {"file_name": "6053753c6ffc40558af9677ebb292bbc.png", "id": "539764895698066", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86665725_539764899031399_710732249969276897_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ma3nPxW-aIAQ7kNvwGSWtYk&_nc_oc=Adr7LDSIcgmiSiAAJWRMJqq5ag6LjScFd41UUHrQR0UUkT43xvJUQ-OWkuKmgGprSTI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR10y80UdclipurBDzCmZWqPE1TaW1qJitL2kq-tO7OQ&oe=6AAD2FCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "principalclareada.png", "id": "810050607904783", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207235_810050611238116_8619340535011103037_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHz8A5cAbzwQ7kNvwEBdO8t&_nc_oc=AdqkFSity89JmW1ShhLoBgqn5-TRWZJnpyhhDP6OF7G81lm7R89sIC4F9_M1sLfq1Do&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAnnWpswbbsOuGESfukThhZ266eo0xz-sB7oCuoFG8SQ&oe=6AAD49BB"}, "display_name": "Slowp", "keywords": ["snowboard", "carve", "ski", "slope", "skate"], "long_description": "**We want you to feel as good as riding in real life!**\n\nAs real-life snowboarders, we believe carving the snow in VR should be the best feeling in the world, so we tuned the physics until it felt perfect. \n\n**Snowboard**, **Ski** or **Snow Skate** with friends having full control of your board! Carve, jump, and grind rails. Explore 50+ official maps plus 1200+ community-created maps!\n{2137596933351413}\n\nRide on steep slopes, bowls, ramps, loops, narrow and large trails, ice caves, and many more totally crazy tracks. You can even create your own maps using Gravity Sketch.\n{1390431582091653}\nAll players are competing for time and best tricks on each map. \nYou don't want to be left out of this mountain party! Bring your friends and join us in multiplayer today!\n\nFEATURES:\n- **Full control** using your hands as feet\n- **Grab tricks** included!\n- **Realistic Snowboard, Ski and Snow Skate physics**\n- **New Gears** being added constantly.\n- Explore **50**+ **official maps plus 1200**+ **community created maps**\n- Change your character and your **board skin**.\n- **Multiplayer** fun!\n- **Race** against other players best time. \n- **Footage mode** to capture your best runs from any angle.\n- **Change the time of day** and world biome.\n- Optional virtual goggles to **eliminate motion sickness**.\n- Find **secret areas**.\n\n{1027522485490012}\n**Slowp** is still in development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "Missing the thrill of carving the snow? Snowboard and Ski in VR. Tuned by real riders until it felt real. Bring your friends and join us in multiplayer!\n\n\n\n"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27962323310127508"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/596149727_966605386344136_8793741730025676844_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZYv0rgyJZYQ7kNvwGah-XD&_nc_oc=AdrXtLEBQulGgPzoHzzVcL0A6SuoCdqur3p7vgrRU1X4ruaShtTxCib6m9BmMgPgP8c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQ
tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc627-wjHSMQ7kNvwGTGXP-&_nc_oc=AdqC2yxmkVBjPn4Glcv3jrv8tHXf91OJ98FWp64Pr1isnDVyVbTeKVtR9rFo26E6IUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB8y4T73JNWfeV2G7KZTTdtQFD31MrEYiT7wbiaPApow&oe=6B0484F3"}, {"file_name": "snapshot_224.8721097.png", "id": "157395420251437", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641340_157395423584770_3367785875394688241_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-rCobITcRsQ7kNvwHtnzC9&_nc_oc=AdrAqtdvs_tufs1hfNmePEs4AxEF1RglVGuv0KmJHbsIKYd-b9GxVBBruHG-cTb0m6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStkn-g_ocKizmh_6jYIwDY8WDvzt4m7QJLrz_7KIO6ig&oe=6B046903"}, {"file_name": "snapshot_70.3227980000001.png", "id": "732535068353780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031447_732535071687113_1355001718090222806_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KG5d5hqZ4gQ7kNvwEInJv2&_nc_oc=Adp7sSBzvBPfGjXaxUAOJe3nqreBHglIGWAk642y0onEBPl9FOXqPsCqMPq4IQpT2tc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl-G1FkmAyI-liTnFeGhxew7kYGfLPeHUs1cgdEGa8Kg&oe=6B04680A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video.png", "id": "6019823294744822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035453_6019823301411488_4109508000963133960_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33wPzEfzTe8Q7kNvwE-C7KH&_nc_oc=Adpl3LDxpaFG7H4VM8UF9lh7Hhmbfq93M26oQ7MWcU5mKFVavqhcgSIyPuNQPeHK6eM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMJcHsAkk4BtIWbbBE4Ns0qI1Xggo-GbMVSNaCikoJbQ&oe=6B0488D6"}, "display_name": "Slowp", "keywords": [], "long_description": "Snowboard in VR having full control of the board using your hands! The board, rails and snow physics are realistic! Carve your way and compete on official and community created maps.\n\nFeaturing experimental level design elements like bowls, jumps, narrow and large trails, ice caves and totally crazy tracks.\n\nLeave your mark by getting to the end of each track so other players can see your ghost when they are playing. All players are competing for time, best tricks score, and coins collected! The best player's scores replays will auto play on all tracks!\n\n- Full board control\n- Realistic snowboard physics\n- Community created maps\n- Asynchronous Multiplayer (race against other players replays)\n- Ranks for best time, tricks, coins collected\n- Footage mode (capture your best runs from any angle)\n- Customize any map by changing the sun position and sky mood\n- Wear goggles to reduce motion sickness (optional)\n- Secret areas\n\nSlowp is under development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "VR Snowboard with full board control, realistic physics tailored by real snowboarders and community created maps!"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
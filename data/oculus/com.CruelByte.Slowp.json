611", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269588_4683731468518944_1540423267916520940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIDvm_Xx4MMQ7kNvwHqPseV&_nc_oc=AdoU9-4dsNJBYrMFGgq6oEYnzDrbIw4VLRpuMY7ypjnNRsIUgYnN_QgS1jc2844V1xY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp4hU61ArUGT6z-9CaLqO68OUeZSoITNV5isnwMXg0hg&oe=6AE76005"}, {"file_name": "5cb520109d2e4303a8af865c5ea32ae5.png", "id": "552598740736831", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974647_552598744070164_6122924417793959877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkrepzadVWMQ7kNvwHaNhdD&_nc_oc=Adry3oxVXz0_hr7V35rt5ktmBVdNQeiXUoF-Hf_KLt2M5skAJhrivvPTY1gYCkQZNMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgmlMVkggDlFFQaG-65tctnrVhPcUen1BcLWfwvhwXkA&oe=6AE75035"}, {"file_name": "e41877ecd90c483592a7a298ad2f5c84.png", "id": "937555581591749", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395591_937555588258415_2719448633370451320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9FES2yZdwoQ7kNvwGEqjjU&_nc_oc=Adpu1lV5LxGySEj05VNpnvr2LoonrhytbPqn1oj_mlhCQCs06E9R0EBrZEiOkG8ktwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2wgf7-8RCr642qSEjlSoQxVXSTgz7hHzR_V-gtaMR6g&oe=6AE75389"}, {"file_name": "com.CruelByte.Slowp-241201-031735.png", "id": "1683451575848228", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207243_1683451579181561_6208308894005236034_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQEcWBSSMEAQ7kNvwFYL-Eh&_nc_oc=AdqXgxLy28fd2FzNmEn-ADmg10c-K0fZI49R0qizZUw8yhN7o3RhsSXm1QBl2fJwSnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTUaYx9TXjpY5Tz6yRo9-IOb3Cicv4ToFCqbIghIA09w&oe=6AE755F9"}, {"file_name": "6053753c6ffc40558af9677ebb292bbc.png", "id": "539764895698066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86665725_539764899031399_710732249969276897_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btTtCE78RnUQ7kNvwHin0MW&_nc_oc=Adpdb7IVXiN2mSTfmu0zyERIlT5h-lwBGC10kmwglCgL5RlHRB_opN8dQlvBeJ0S27Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzkfcPdTXQIFenh9OjzPUwOPMGC0t75AWd4-KKHkgg-Q&oe=6AE76A0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "principalclareada.png", "id": "1425438239515962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_1425438242849295_1188010789252204980_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmsaAJlEQUYQ7kNvwHW6V2i&_nc_oc=AdopBlDmaThQNMxPqWwkoqQNnyL4bq1VnGmiaGBbPzvxc-awizZXQupHffiUHNYC9u4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWPCBhhWwClcAIrK5M-2MiPYiYc28Eaq-_9he1Z-uUvg&oe=6AE76395"}, "display_name": "Slowp", "keywords": ["snowboard", "carve", "ski", "slope", "skate"], "long_description": "**We want you to feel as good as riding in real life!**\n\nAs real-life snowboarders, we believe carving the snow in VR should be the best feeling in the world, so we tuned the physics until it felt perfect. \n\n**Snowboard**, **Ski** or **Snow Skate** with friends having full control of your board! Carve, jump, and grind rails. Explore 50+ official maps plus 1200+ community-created maps!\n{2137596933351413}\n\nRide on steep slopes, bowls, ramps, loops, narrow and large trails, ice caves, and many more totally crazy tracks. You can even create your own maps using Gravity Sketch.\n{1390431582091653}\nAll players are competing for time and best tricks on each map. \nYou don't want to be left out of this mountain party! Bring your friends and join us in multiplayer today!\n\nFEATURES:\n- **Full control** using your hands as feet\n- **Grab tricks** included!\n- **Realistic Snowboard, Ski and Snow Skate physics**\n- **New Gears** being added constantly.\n- Explore **50**+ **official maps plus 1200**+ **community created maps**\n- Change your character and your **board skin**.\n- **Multiplayer** fun!\n- **Race** against other players best time. \n- **Footage mode** to capture your best runs from any angle.\n- **Change the time of day** and world biome.\n- Optional virtual goggles to **eliminate motion sickness**.\n- Find **secret areas**.\n\n{1027522485490012}\n**Slowp** is still in development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "Missing the thrill of carving the snow? Snowboard and Ski in VR. Tuned by real riders until it felt real. Bring your friends and join us in multiplayer!\n\n\n\n"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28199970786362758"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_966605386344136_8793741730025676844_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdRSlbzmETUQ7kNvwHDFaR_&_nc_oc=Adr-S7EThQ19TTYmMBCxuQp_fTUihxOpWLa6UNIq8O9BQVVnHxK5ctW-1jTOf5Y-o0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=0
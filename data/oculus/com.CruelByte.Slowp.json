611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269588_4683731468518944_1540423267916520940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_XWMWSlWs0Q7kNvwFbRPTT&_nc_oc=Ado9_M1L5pyLZPWijrFEMEbQuQbH6K7m2SBg9M7rvU_oxDDbbZfh8TTQ8LPNUzVdD5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjH2RkUlfvQNTbYbObdcCCcG5nFWqpitv5Ta71gzeHZg&oe=6ACA5F05"}, {"file_name": "5cb520109d2e4303a8af865c5ea32ae5.png", "id": "552598740736831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974647_552598744070164_6122924417793959877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEeEpwNB0oMQ7kNvwHfBTGW&_nc_oc=Adp109hi0fWOqDxubskJY8KfccNbK8i_RroJ3IDTKXZ-BvlfHMtrCio7RGubaeRrdIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqrA2dLqYJBz8VeCp7AMkEA1qZoeRyO9XrdWYmjL5EGQ&oe=6ACA4F35"}, {"file_name": "e41877ecd90c483592a7a298ad2f5c84.png", "id": "937555581591749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395591_937555588258415_2719448633370451320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnppDJKIVTUQ7kNvwGPvORI&_nc_oc=Adpr1iG48fVve3fKB3-xV0HKgR7Nw44GYU8EFMNk9VWJE0q8Mw3PZ8J4jpavb-T1ZE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZJ3ANZYTMpEaAOISlbL9I1jFwQDp2KCOaKTKsFjfukA&oe=6ACA5289"}, {"file_name": "com.CruelByte.Slowp-241201-031735.png", "id": "1683451575848228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207243_1683451579181561_6208308894005236034_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rU7G9lFHtIQ7kNvwHTQBcQ&_nc_oc=Adqvp7iTl-Z6ELbuO4PQEsrNF_3aG0jyAIEhSQHRM5-_MNp0jjMvT404FDY9Oi4RVWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpRFGAGwUVBA3XXBkde-SamKInEi76NJnLqgkSjgOvrw&oe=6ACA54F9"}, {"file_name": "6053753c6ffc40558af9677ebb292bbc.png", "id": "539764895698066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86665725_539764899031399_710732249969276897_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ2wxnShkkQQ7kNvwGr2CAY&_nc_oc=AdrjtJUPC3kC9p9UjS14xBx_jCrrsP7fZGz-TeDyI0gUbdFI08ayGlm_SVqNxPUhJoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwXSxw16_0XSyRQVkL8L4OnhZETaUrY_6qSwt5PA8t2w&oe=6ACA690D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "principalclareada.png", "id": "1425438239515962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_1425438242849295_1188010789252204980_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw1Cmk7MLUsQ7kNvwEqtOjj&_nc_oc=AdqdQ_TwgX_U9GHxIupYgxjj3QAFrEWfWqvZAB491aPZgMKzLbfLl43jJaxAkwMW-tk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsGxrn_ZjaxUaLFMMxvhE4KucMOn-UbNCHp37cNkB4WQ&oe=6ACA6295"}, "display_name": "Slowp", "keywords": ["snowboard", "carve", "ski", "slope", "skate"], "long_description": "**We want you to feel as good as riding in real life!**\n\nAs real-life snowboarders, we believe carving the snow in VR should be the best feeling in the world, so we tuned the physics until it felt perfect. \n\n**Snowboard**, **Ski** or **Snow Skate** with friends having full control of your board! Carve, jump, and grind rails. Explore 50+ official maps plus 1200+ community-created maps!\n{2137596933351413}\n\nRide on steep slopes, bowls, ramps, loops, narrow and large trails, ice caves, and many more totally crazy tracks. You can even create your own maps using Gravity Sketch.\n{1390431582091653}\nAll players are competing for time and best tricks on each map. \nYou don't want to be left out of this mountain party! Bring your friends and join us in multiplayer today!\n\nFEATURES:\n- **Full control** using your hands as feet\n- **Grab tricks** included!\n- **Realistic Snowboard, Ski and Snow Skate physics**\n- **New Gears** being added constantly.\n- Explore **50**+ **official maps plus 1200**+ **community created maps**\n- Change your character and your **board skin**.\n- **Multiplayer** fun!\n- **Race** against other players best time. \n- **Footage mode** to capture your best runs from any angle.\n- **Change the time of day** and world biome.\n- Optional virtual goggles to **eliminate motion sickness**.\n- Find **secret areas**.\n\n{1027522485490012}\n**Slowp** is still in development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "Missing the thrill of carving the snow? Snowboard and Ski in VR. Tuned by real riders until it felt real. Bring your friends and join us in multiplayer!\n\n\n\n"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28199970786362758"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596149727_966605386344136_8793741730025676844_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMb8FKi3hNYQ7kNvwEb1QyI&_nc_oc=AdoLhzjgxTCsRSHuPDjTqI2AVoFK5pmEHjuEza2zAS4Mq1hNu66-R066cXWvVktMoRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=0
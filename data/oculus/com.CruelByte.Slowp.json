tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc627-wjHSMQ7kNvwGuSxbS&_nc_oc=AdpgjfDVeJMIFRmYc7kAa2oJOblDFCoNpwF_gOYYZo88N81Ft7MVNUCm_sgSE3w0TKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9fB_ihzgwAMxERLJO0xkXaBwptZuKYTiGr4ps_VI-eg&oe=6B033373"}, {"file_name": "snapshot_224.8721097.png", "id": "157395420251437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641340_157395423584770_3367785875394688241_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-rCobITcRsQ7kNvwGh5SVA&_nc_oc=AdoFJYrykaQcOcxADGJgrLpQmqyX6cNr1mbnGEYI714wtotWuMLuwMu1ir0ECxGVGFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6VShMADvpZtFEgLiVK_wFQ_oqBkGhS6FLRcgper_Hrw&oe=6B031783"}, {"file_name": "snapshot_70.3227980000001.png", "id": "732535068353780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031447_732535071687113_1355001718090222806_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KG5d5hqZ4gQ7kNvwEiu_CN&_nc_oc=Ado-sgl65ov52dqYOFrI_ITZswgxG-Tdps8hIZ3jcxVugm6ihGMd7hNDq6KTPiGYcRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfmVtYJJSB-VLiyYaJK1rJrI7-QRQDsqleXEG6tIWaAg&oe=6B03168A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video.png", "id": "6019823294744822", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035453_6019823301411488_4109508000963133960_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33wPzEfzTe8Q7kNvwEEH9J-&_nc_oc=Adpw145927GZgKVYNjjfwK2d7eB8E5PmyA1HZgfqKYcEv7vK3Q5B8t-l9kjbSiim7J4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcuxBfCmvOZ3pAJoJ-TyxYG_S6jRDWhqPAM6TADorzeg&oe=6B033756"}, "display_name": "Slowp", "keywords": [], "long_description": "Snowboard in VR having full control of the board using your hands! The board, rails and snow physics are realistic! Carve your way and compete on official and community created maps.\n\nFeaturing experimental level design elements like bowls, jumps, narrow and large trails, ice caves and totally crazy tracks.\n\nLeave your mark by getting to the end of each track so other players can see your ghost when they are playing. All players are competing for time, best tricks score, and coins collected! The best player's scores replays will auto play on all tracks!\n\n- Full board control\n- Realistic snowboard physics\n- Community created maps\n- Asynchronous Multiplayer (race against other players replays)\n- Ranks for best time, tricks, coins collected\n- Footage mode (capture your best runs from any angle)\n- Customize any map by changing the sun position and sky mood\n- Wear goggles to reduce motion sickness (optional)\n- Secret areas\n\nSlowp is under development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "VR Snowboard with full board control, realistic physics tailored by real snowboarders and community created maps!"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
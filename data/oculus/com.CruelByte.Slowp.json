pjTL0LXtpe5h8vdCVQ&oe=6AD0FE83"}, {"file_name": "snapshot_70.3227980000001.png", "id": "732535068353780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031447_732535071687113_1355001718090222806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lu57Hcq2nAQ7kNvwFR5EdE&_nc_oc=Ado4ieSTuQND3rKnuHzrCfO61gRXNZufu60X8tKpSD-hlS1loele0o95fBrfK-N7cuk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjsClW49B8tE5pzbZbthv4Zd4PoV-ehDB_eMp_3qdyfA&oe=6AD0FD8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video.png", "id": "6019823294744822", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035453_6019823301411488_4109508000963133960_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mE5Q_wYb6wQ7kNvwF0tMlJ&_nc_oc=Adoi9sHN9N7qh1gKj9IejF6jmsfPX8wIqbPKf5v6V7b92FR8kFHaT5eVCw1KOm7Racc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLgKrNvE6ZiGQvUaLt4U_zTqKQyg1xMQwmZ4AIRHogYQ&oe=6AD0E616"}, "display_name": "Slowp", "keywords": [], "long_description": "Snowboard in VR having full control of the board using your hands! The board, rails and snow physics are realistic! Carve your way and compete on official and community created maps.\n\nFeaturing experimental level design elements like bowls, jumps, narrow and large trails, ice caves and totally crazy tracks.\n\nLeave your mark by getting to the end of each track so other players can see your ghost when they are playing. All players are competing for time, best tricks score, and coins collected! The best player's scores replays will auto play on all tracks!\n\n- Full board control\n- Realistic snowboard physics\n- Community created maps\n- Asynchronous Multiplayer (race against other players replays)\n- Ranks for best time, tricks, coins collected\n- Footage mode (capture your best runs from any angle)\n- Customize any map by changing the sun position and sky mood\n- Wear goggles to reduce motion sickness (optional)\n- Secret areas\n\nSlowp is under development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "VR Snowboard with full board control, realistic physics tailored by real snowboarders and community created maps!"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "146882188316541"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1196929535985937"}, {"status": "PUBLISHED", "id": "1307972061364747"}, {"status": "PUBLISHED", "id": "1580825070026877"}, {"status": "PUBLISHED", "id": "31895977906684213"}, {"status": "PUBLISHED", "id": "787898544409764"}, {"status": "PUBLISHED", "id": "4109334752678888"}, {"status": "PUBLISHED", "id": "1905036500036638"}, {"status": "PUBLISHED", "id": "2186429121827772"}, {"status": "PUBLISHED", "id": "2248674912196367"}, {"status": "PUBLISHED", "id": "1418314879539437"}, {"status": "PUBLISHED", "id": "583110734060896"}, {"status": "PUBLISHED", "id": "1186181565925352"}, {"status": "PUBLISHED", "id": "1
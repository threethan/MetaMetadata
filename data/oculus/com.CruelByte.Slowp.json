4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzoeg3cSBq7P4DHnpOjzEZSgD5pZQzkzSwvwTOLXBPV0A&oe=69C281CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video.png", "id": "6019823294744822", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035453_6019823301411488_4109508000963133960_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xM_6Th0I_QQ7kNvwE4-xDv&_nc_oc=AdofLJELd6Gxj76HBu6uG3SlX9WA6mEqaiDO21TxEXf2V2d_RBgQxdd97rzQiTm2yGE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5PHyrUhY1VQQnKjxZn-MKnJo1EyyuWQnUxt3ISE1jiw&oe=69C2A296"}, "display_name": "Slowp", "keywords": [], "long_description": "Snowboard in VR having full control of the board using your hands! The board, rails and snow physics are realistic! Carve your way and compete on official and community created maps.\n\nFeaturing experimental level design elements like bowls, jumps, narrow and large trails, ice caves and totally crazy tracks.\n\nLeave your mark by getting to the end of each track so other players can see your ghost when they are playing. All players are competing for time, best tricks score, and coins collected! The best player's scores replays will auto play on all tracks!\n\n- Full board control\n- Realistic snowboard physics\n- Community created maps\n- Asynchronous Multiplayer (race against other players replays)\n- Ranks for best time, tricks, coins collected\n- Footage mode (capture your best runs from any angle)\n- Customize any map by changing the sun position and sky mood\n- Wear goggles to reduce motion sickness (optional)\n- Secret areas\n\nSlowp is under development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "VR Snowboard with full board control, realistic physics tailored by real snowboarders and community created maps!"}]}, "developer_name": "Cruel Byte", "developer_privacy_po
611", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75269588_4683731468518944_1540423267916520940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_3nwmLFd2cQ7kNvwEId65a&_nc_oc=AdrSdsEhVLh68exzUmwvcAJwatpeCPBkOodAbgTR2eV0Kfw2mBjB6AY6ltoojzlRrQ8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOPDSMFUWTWNdBg631amGf0bUZfjimI2-P6yLknp6SvA&oe=6AC90D85"}, {"file_name": "5cb520109d2e4303a8af865c5ea32ae5.png", "id": "552598740736831", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974647_552598744070164_6122924417793959877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEeEpwNB0oMQ7kNvwEgwfw4&_nc_oc=AdptQfptQP4dFq-tbghry1jHutQbkxUCVfWwWoHtGEe9OUocm4LrgrnNh0RlfbI8KKY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObWij10j6c5BNUW-VhZmpYlpopyMni9c89KEI10uF3BA&oe=6AC8FDB5"}, {"file_name": "e41877ecd90c483592a7a298ad2f5c84.png", "id": "937555581591749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75395591_937555588258415_2719448633370451320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnppDJKIVTUQ7kNvwFA8fcJ&_nc_oc=Adqx1ArmivMAwoVaAiv9bFruLIVZGb2aFTqYnakOaMk0YoVdfcTAcJRqeGiwLOuIRSU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlC5MQitiz7grH-LxSbrdLM-gA04-e9LAydFca8Md__w&oe=6AC90109"}, {"file_name": "com.CruelByte.Slowp-241201-031735.png", "id": "1683451575848228", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207243_1683451579181561_6208308894005236034_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNuTmaPOLkEQ7kNvwE8NymX&_nc_oc=Adr4_uAVmXvzNXnoOaT15Gb7SSJm3IqLFWEAcomZtpC2HOooYVW5m-Kd_UU9Q6ntT1A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxgMGfw8o2l4tla03GaQusmN1UqCPON_VrRtNad2bAzg&oe=6AC90379"}, {"file_name": "6053753c6ffc40558af9677ebb292bbc.png", "id": "539764895698066", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86665725_539764899031399_710732249969276897_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ2wxnShkkQQ7kNvwG_2xik&_nc_oc=Adp4rajfcZJ-DPVv7y0qcMcGoqoUK1iqP6mG7d6XGrZuT4cUhC1hfknuPlefCo82SbM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeoVGjgOU0JjAmmC4ccQBemqGhOYCI5emMsRkVAO1Z6g&oe=6AC9178D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "principalclareada.png", "id": "1425438239515962", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830576_1425438242849295_1188010789252204980_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw1Cmk7MLUsQ7kNvwHTQNE0&_nc_oc=Adpo-L_ajEqkLWbYGU-1F_T6NPG6ueWTZCGEpiNmF5f16-R6G1dzCJmqCGshh0bdde4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2QpceSnZPyduMQiAVyfw6pCU6a3non7G2ayDWbjv_bQ&oe=6AC91115"}, "display_name": "Slowp", "keywords": ["snowboard", "carve", "ski", "slope", "skate"], "long_description": "**We want you to feel as good as riding in real life!**\n\nAs real-life snowboarders, we believe carving the snow in VR should be the best feeling in the world, so we tuned the physics until it felt perfect. \n\n**Snowboard**, **Ski** or **Snow Skate** with friends having full control of your board! Carve, jump, and grind rails. Explore 50+ official maps plus 1200+ community-created maps!\n{2137596933351413}\n\nRide on steep slopes, bowls, ramps, loops, narrow and large trails, ice caves, and many more totally crazy tracks. You can even create your own maps using Gravity Sketch.\n{1390431582091653}\nAll players are competing for time and best tricks on each map. \nYou don't want to be left out of this mountain party! Bring your friends and join us in multiplayer today!\n\nFEATURES:\n- **Full control** using your hands as feet\n- **Grab tricks** included!\n- **Realistic Snowboard, Ski and Snow Skate physics**\n- **New Gears** being added constantly.\n- Explore **50**+ **official maps plus 1200**+ **community created maps**\n- Change your character and your **board skin**.\n- **Multiplayer** fun!\n- **Race** against other players best time. \n- **Footage mode** to capture your best runs from any angle.\n- **Change the time of day** and world biome.\n- Optional virtual goggles to **eliminate motion sickness**.\n- Find **secret areas**.\n\n{1027522485490012}\n**Slowp** is still in development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "Missing the thrill of carving the snow? Snowboard and Ski in VR. Tuned by real riders until it felt real. Bring your friends and join us in multiplayer!\n\n\n\n"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28199970786362758"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/596149727_966605386344136_8793741730025676844_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMb8FKi3hNYQ7kNvwEEJOTz&_nc_oc=Adrr8jyVLS5_K6JTTEBTRkaSHYqR-JIT2jfmca2yJS9JrzN3hzB3uysYm8i0SKq7g9c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=0
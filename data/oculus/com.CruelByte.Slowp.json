humbnail": {"file_name": "cover_video.png", "id": "6019823294744822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035453_6019823301411488_4109508000963133960_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNX5Y_TKezEQ7kNvwG_uH4e&_nc_oc=AdlKd67q5ecZX9nX361Fz0q08O1ClT0OXMdlQyrNW3v3x-FKFa4rKyfVDiAUJdl_Prc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAxaGPCU0h1vxbCbVBFTd2qkQJVZOHAuSwCK_L-j3Y8w&oe=6999C416"}, "display_name": "Slowp", "keywords": [], "long_description": "Snowboard in VR having full control of the board using your hands! The board, rails and snow physics are realistic! Carve your way and compete on official and community created maps.\n\nFeaturing experimental level design elements like bowls, jumps, narrow and large trails, ice caves and totally crazy tracks.\n\nLeave your mark by getting to the end of each track so other players can see your ghost when they are playing. All players are competing for time, best tricks score, and coins collected! The best player's scores replays will auto play on all tracks!\n\n- Full board control\n- Realistic snowboard physics\n- Community created maps\n- Asynchronous Multiplayer (race against other players replays)\n- Ranks for best time, tricks, coins collected\n- Footage mode (capture your best runs from any angle)\n- Customize any map by changing the sun position and sky mood\n- Wear goggles to reduce motion sickness (optional)\n- Secret areas\n\nSlowp is under development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "VR Snowboard with full board control, realistic physics tailored by real snowboarders and community created maps!"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "146882188316541"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1196929535985937"}, {"status": "PUBLISHED", "id": "1307972061364747"}, {"status": "PUBLISHED", "id": "1580825070026877"}, {"status": "PUBLISHED", "id": "31895977906684213"}, {"status": "PUBLISHED", "id": "787898544409764"}, {"status": "PUBLISHED", "id": "4109334752678888"}, {"status": "PUBLISHED", "id": "1905036500036638"}, {"status": "PUBLISHED", "id": "2186429121827772"}, {"status": "PUBLISHED", "id": "2248674912196367"}, {"status": "PUBLISHED", "id": "1418314879539437"}, {"status": "PUBLISHED", "id": "583110734060896"}, {"status": "PUBLISHED", "id": "1186181565925352"}, {"status": "PUBLISHED", "id": "1181123399602100"}, {"status": "PUBLISHED", "id": "1607570169742688"}]}, "baseline_offer": {"id": "1307972061364747"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1196929535985937"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25684024771290718", "version": "0.99.137"}, "id": "636779054271066", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__
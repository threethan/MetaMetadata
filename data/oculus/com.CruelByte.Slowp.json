11", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269588_4683731468518944_1540423267916520940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tv4akRFjLWIQ7kNvwFNnZil&_nc_oc=AdoL2lL8BQ4I6KnI-aFpoNvkzFkA87wI465at81vc-fUFydsXWT443sSpNIDVduHh54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3Cm5Mm305j9dTCFvmxW4hIEZ263Sg4ESzrBIHI7dNmg&oe=6AB2A405"}, {"file_name": "5cb520109d2e4303a8af865c5ea32ae5.png", "id": "552598740736831", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974647_552598744070164_6122924417793959877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltc0UhoP9-AQ7kNvwFetfxm&_nc_oc=AdqDDiIFmn1bcn-JnSGskDMDFrNeR2LZEEksQk7HU-xVXvWwSKXCeJYgfTyB5NT5r7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUcMSkwInXk6y-c-DZVQUIbtVwIxRjkAE7fqpNqEyEcw&oe=6AB29435"}, {"file_name": "e41877ecd90c483592a7a298ad2f5c84.png", "id": "937555581591749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395591_937555588258415_2719448633370451320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6xx5-lGBPMQ7kNvwGXdfSX&_nc_oc=Adr8eBk7s5j8J0tVFa1IhA0RQaUy6258KXcfEFYktfyCI8ZXczdPbUphRrn9uZcRqSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtSAGhNdXPzlcVRsW8w5ttlDQ8_E1auwumPz1VPL2m-w&oe=6AB29789"}, {"file_name": "com.CruelByte.Slowp-241201-031735.png", "id": "1683451575848228", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207243_1683451579181561_6208308894005236034_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BftQDAYUTTcQ7kNvwE8Fj6B&_nc_oc=AdpLXXEDyZxGxFrM_QS_NMXKCoAo5f2IdJo4g_Nv3Bs2S2wCH9XnfyDRluiLzDObSUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxNXTGZyOHFp81Br9YokHC9cwEru8th7aHRkglpTmZ3A&oe=6AB299F9"}, {"file_name": "6053753c6ffc40558af9677ebb292bbc.png", "id": "539764895698066", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86665725_539764899031399_710732249969276897_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzatUOToctYQ7kNvwGAxVDj&_nc_oc=AdrmktX1JpYE6WCesLjaV3FeOvSliVjlWGSVh80EPACZfVHuZx27ftniORXA982_JXo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6QB8QZruJ8pgOncxxwrUhkMmebEqlfzt6nzGaWOIWZQ&oe=6AB275CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "principalclareada.png", "id": "810050607904783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207235_810050611238116_8619340535011103037_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBa7uBCY0CQQ7kNvwGdNJn7&_nc_oc=AdqYW2yZpdNgAb6z5mgaKVjqmmQ1z5MJGTm6j2xF2x78BON8X1exPWdE0Alseuru3W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJRI35Y3r82fJx1ErIOwSdUcNWngRYhSFgqCoo0N0VFw&oe=6AB28FBB"}, "display_name": "Slowp", "keywords": ["snowboard", "carve", "ski", "slope", "skate"], "long_description": "**We want you to feel as good as riding in real life!**\n\nAs real-life snowboarders, we believe carving the snow in VR should be the best feeling in the world, so we tuned the physics until it felt perfect. \n\n**Snowboard**, **Ski** or **Snow Skate** with friends having full control of your board! Carve, jump, and grind rails. Explore 50+ official maps plus 1200+ community-created maps!\n{2137596933351413}\n\nRide on steep slopes, bowls, ramps, loops, narrow and large trails, ice caves, and many more totally crazy tracks. You can even create your own maps using Gravity Sketch.\n{1390431582091653}\nAll players are competing for time and best tricks on each map. \nYou don't want to be left out of this mountain party! Bring your friends and join us in multiplayer today!\n\nFEATURES:\n- **Full control** using your hands as feet\n- **Grab tricks** included!\n- **Realistic Snowboard, Ski and Snow Skate physics**\n- **New Gears** being added constantly.\n- Explore **50**+ **official maps plus 1200**+ **community created maps**\n- Change your character and your **board skin**.\n- **Multiplayer** fun!\n- **Race** against other players best time. \n- **Footage mode** to capture your best runs from any angle.\n- **Change the time of day** and world biome.\n- Optional virtual goggles to **eliminate motion sickness**.\n- Find **secret areas**.\n\n{1027522485490012}\n**Slowp** is still in development! There are still many features and polishing that we want to add to the whole experience. Judge it with that in mind and please give us feedback!", "short_description": "Missing the thrill of carving the snow? Snowboard and Ski in VR. Tuned by real riders until it felt real. Bring your friends and join us in multiplayer!\n\n\n\n"}]}, "developer_name": "Cruel Byte", "developer_privacy_policy_url": "http://cruelbyte.com/slowp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cruel Byte", "support_website_url": null, "website_url": "http://cruelbyte.com/slowp", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27962323310127508"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596149727_966605386344136_8793741730025676844_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKcQMn9DVXoQ7kNvwHlxJeK&_nc_oc=AdqRdKDZ8jQWH1ecyNQXo3Z5gJVNQAIsom_qA09jWW62Hr4vOCj39NwfA6cwQelsoO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQ
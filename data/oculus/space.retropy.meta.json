qCdW9PHq_DdFcPTM8KQqn5dHZ4fVV5PzrHNnYybWvA8GRdhuEOTMD7gA8YvxxVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnB8A7bU3h-x48qs-id18PWGPpsBsuOkDUY5gRIswgWg&oe=6B099CFB"}, {"file_name": "3.png", "id": "1140112234513126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982696_1140112237846459_3391350817744798822_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qv1EWfRCT4QQ7kNvwHNJI-y&_nc_oc=AdoBVj8Do6Qz4yYM6rGuzJWz_QvM9jns96GV8MAPULE8QMb0MHMZgwRJdT8vm8ec73w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQESGPK7BgheWriA6HcK9TyvzdEDm4ixazSYbXHWRuJ4g&oe=6B09C808"}, {"file_name": "Untitled design-12.png", "id": "1855003265306793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031329_1855003268640126_3692145407816589862_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_gGEdLBGSEQ7kNvwHBZVF0&_nc_oc=Adrzmkp9FJCw-7qiXzoO0xgV452urdoPP2KsTlqgr97mxYtUF0wVuhDwF_O1JC1hwVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE4AkRetp0plbvLTCY1GFoN6YUFjQLMQ75gjssPW-m6w&oe=6B09BA84"}, {"file_name": "Screenshot 2024-09-19 at 5.04.56\u202fPM-2560x1440.png", "id": "3829319804053099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035399_3829319807386432_8697232045329718283_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbcREfEx8l0Q7kNvwGDT4ES&_nc_oc=AdpNYJVNQl3KRk53ii0qGN_EfLRnq8FtelY5N-qPHzO2pvlcbKLw8cY-HX4lH_ifa5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRKcDAhYzLzc43EGi1jPqla3RlNUcb_ANmGX4sD4MjOw&oe=6B09C996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "1950772375415851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_1950772378749184_9023911922798697221_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f821ZGAl3HIQ7kNvwE0c5EU&_nc_oc=AdpBsKlxKt3PuzYXjKuepm1vJazC2NiKs3GgmIVH3uXIxpZfGLT3_ySWgKF8sA4QejA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8h0_D-SlsNsq3GfFEqGA9JwHQqt1rrExa30P9n9sbDQ&oe=6B09CBE2"}, "display_name": "Retropy VR Puzzles", "keywords": ["puzzle", "puzzling", "scan", "jigsaw", "retropy"], "long_description": "\ud83e\udde9 Become a Puzzle Master. With 16 base puzzles and free monthly content, you will never run out of satisfying 3D jigsaw puzzles to complete. Ranging from easy to complex, there are a variety of themes to enjoy. \n\n{963016575775248}\n\n\ud83e\udde9 Exercise Brain Health. It's no secret that daily puzzles improve brain health. Relax in a whole new world of oddities and detailed puzzles crafted for relaxation and to improve cognitive function. \n\n{1113800780393627}\n\n\ud83e\udde9 Customize Your Puzzle Space. Enjoy detailed objects in your choice of immersive VR environments, change the music from energetic to relaxing, and make it your own!", "short_description": "Retropy VR Puzzles brings you hours of relaxing 3D jigsaw puzzles  in an immersive VR or MR space. Enjoy 16 base puzzles and 2 - 3 puzzles added each month for FREE. \n\nRanging in difficulty from Easy to Hard, adjust the challenge to your comfort and unlock achievements as you complete each puzzle. \n\nFeatures:\n16 Detailed objects to puzzle\nUnique VR environments \nA variety of music \nConstant updates and free content \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO
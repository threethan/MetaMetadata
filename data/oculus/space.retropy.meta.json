126", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1140112237846459_3391350817744798822_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeVOtJ6RPqEQ7kNvwHjnO9I&_nc_oc=AdpOSNTfQMe4zwRfW2qL8VX-aUq6NEUbsv3cSCTaorl-ILM76TC7tI9nE3U27PyByf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr2Gwclil--sUdDAU19Vpo2Z70WhjnqPd24WAPvFcHEw&oe=6AAAA3C8"}, {"file_name": "Untitled design-12.png", "id": "1855003265306793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031329_1855003268640126_3692145407816589862_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nCKQy7y8vEQ7kNvwG9ER-q&_nc_oc=AdpA9FKzIbGZ3_ZZrA9lIg7vcRGZNNJYmQqAbhoFZ964_b7I6nJbgv7MYPrQnnW7OF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKavdcUh4FKTL9uITd8iM6ZcyiSOb3qtTb7_s7JN6yxOQ&oe=6AAA9644"}, {"file_name": "Screenshot 2024-09-19 at 5.04.56\u202fPM-2560x1440.png", "id": "3829319804053099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035399_3829319807386432_8697232045329718283_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG9kCh1sYwgQ7kNvwGEqgOh&_nc_oc=Ado5SZRNFo0XWo0HmAH0ioz1JXeLWzjSo4cnYrUXph6HoIgmLD-QcrubJ-MbqdWSwYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbf8xrRdgq9TcOrb9E5d_e7hjA4CC244zjz2IUJ7gXpA&oe=6AAAA556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "1950772375415851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_1950772378749184_9023911922798697221_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MneLtA6SLEMQ7kNvwGwu3gV&_nc_oc=Adq4qUePtnhg0eu5GtrpvEPKLgasSjWkO_zgUQJJ81QMtJD3HsYMEIF8oakjv6Mh9P0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_p8xuR9bscqzyupFGnhr0l4sFnjXsveJkPrIeD06wWw&oe=6AAAA7A2"}, "display_name": "Retropy VR Puzzles", "keywords": ["puzzle", "puzzling", "scan", "jigsaw", "retropy"], "long_description": "\ud83e\udde9 Become a Puzzle Master. With 16 base puzzles and free monthly content, you will never run out of satisfying 3D jigsaw puzzles to complete. Ranging from easy to complex, there are a variety of themes to enjoy. \n\n{963016575775248}\n\n\ud83e\udde9 Exercise Brain Health. It's no secret that daily puzzles improve brain health. Relax in a whole new world of oddities and detailed puzzles crafted for relaxation and to improve cognitive function. \n\n{1113800780393627}\n\n\ud83e\udde9 Customize Your Puzzle Space. Enjoy detailed objects in your choice of immersive VR environments, change the music from energetic to relaxing, and make it your own!", "short_description": "Retropy VR Puzzles brings you hours of relaxing 3D jigsaw puzzles  in an immersive VR or MR space. Enjoy 16 base puzzles and 2 - 3 puzzles added each month for FREE. \n\nRanging in difficulty from Easy to Hard, adjust the challenge to your comfort and unlock achievements as you complete each puzzle. \n\nFeatures:\n16 Detailed objects to puzzle\nUnique VR environments \nA variety of music \nConstant updates and free content \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9009
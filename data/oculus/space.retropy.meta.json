?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gd_WHjYMZM8Q7kNvwGvKO05&_nc_oc=AdkVzF_FwOycKTbjU61q0WT3fqDMZ_JkOlMjn7VwJ2M7rIc_4G2LdCwzP8cum5fnl1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfswThHZxTbx5-x95l5RQ4pYsMcEJVIJv1fb19Sm-5syvg&oe=69A44948"}, {"file_name": "Untitled design-12.png", "id": "1855003265306793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031329_1855003268640126_3692145407816589862_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exRH12pVR3IQ7kNvwESupv_&_nc_oc=AdnxZ2x0yWZ9dRUl5shqKUo4zyS6gNZ_Oc08eekKESdMMGwlvuEiO9cXqDCvTGe3mU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuXq3DazAVC1256nws1WEdvav7sDF8YEqJOcfR8PU4Atg&oe=69A43BC4"}, {"file_name": "Screenshot 2024-09-19 at 5.04.56\u202fPM-2560x1440.png", "id": "3829319804053099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035399_3829319807386432_8697232045329718283_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cUZXttAwksQ7kNvwF-gtBc&_nc_oc=AdkNSpFngUTk4qrn79ICpggiLLRZHutH6lgqGPoaAeyU49_OpvtNyHbsfJ16TJ4To7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuFSk6EsKFhMFkUuJL7ahusqDpNamJImiB6zTGqoDJ-Gg&oe=69A44AD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "1950772375415851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207242_1950772378749184_9023911922798697221_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FKuo_1PjGkQ7kNvwE-gWHz&_nc_oc=AdmwoOiXrHP2W4oKaPTDGZi0Gdr535GDD2rLD8uBPqavu7mhe6TM07aRxpokynCC8D0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afus7tt6HOLmkTqhKOtKEbj3YobhHsh9FS-Zz1yEUezh3g&oe=69A44D22"}, "display_name": "Retropy VR Puzzles", "keywords": ["puzzle", "puzzling", "scan", "jigsaw", "retropy"], "long_description": "\ud83e\udde9 Become a Puzzle Master. With 16 base puzzles and free monthly content, you will never run out of satisfying 3D jigsaw puzzles to complete. Ranging from easy to complex, there are a variety of themes to enjoy. \n\n{963016575775248}\n\n\ud83e\udde9 Exercise Brain Health. It's no secret that daily puzzles improve brain health. Relax in a whole new world of oddities and detailed puzzles crafted for relaxation and to improve cognitive function. \n\n{1113800780393627}\n\n\ud83e\udde9 Customize Your Puzzle Space. Enjoy detailed objects in your choice of immersive VR environments, change the music from energetic to relaxing, and make it your own!", "short_description": "Retropy VR Puzzles brings you hours of relaxing 3D jigsaw puzzles  in an immersive VR or MR space. Enjoy 16 base puzzles and 2 - 3 puzzles added each month for FREE. \n\nRanging in difficulty from Easy to Hard, adjust the challenge to your comfort and unlock achievements as you complete each puzzle. \n\nFeatures:\n16 Detailed objects to puzzle\nUnique VR environments \nA variety of music \nConstant updates and free content \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9009087172479619"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_1584523055521089_879219565925531066
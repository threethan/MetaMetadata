sSCb9UUj9_DJBBxz509zsKlTfZ4MOT40tKnPMlrzy-kRDlLKDvx0Uw_5YGrSp2o&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXUpuiDWmMuwabEaPISgDhJKMetNnH6UGQUJT1sCxq6w&oe=6B084B7B"}, {"file_name": "3.png", "id": "1140112234513126", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982696_1140112237846459_3391350817744798822_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gercpx71yikQ7kNvwELbJx5&_nc_oc=AdoM4-YB5e6_YFUHeBne53SlQsKMJtHjmDLPoiSEGOLjY_fLwyf-CMlNNCBVSZJX_ak&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcdG54h7DUs5KwncM3580NXH5FrUgcLuCBVwdLCOOLmA&oe=6B083E48"}, {"file_name": "Untitled design-12.png", "id": "1855003265306793", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031329_1855003268640126_3692145407816589862_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_gGEdLBGSEQ7kNvwGjWrto&_nc_oc=AdrH2HhCI9ri-Zi69WBegOZPyBbOPRb20WhG0TYTOkbRKQ9Rox1__fhU9Gm9sc2zL_c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHImJShB-rnriif035HEo3I-pnaBBA6XbetSjfpayQaw&oe=6B086904"}, {"file_name": "Screenshot 2024-09-19 at 5.04.56\u202fPM-2560x1440.png", "id": "3829319804053099", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035399_3829319807386432_8697232045329718283_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbcREfEx8l0Q7kNvwH6ttnb&_nc_oc=AdqJXjGejAKqfV3EKYnAYXsPP3JvbNIfOnAX8QnM2Q9966ZVqGhOcGda3QYvvvBJY98&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIHJ0u8T_WkqD9OPOs-_X31DAt2nSMYDtHyHVkSYVHlA&oe=6B083FD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "1950772375415851", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75207242_1950772378749184_9023911922798697221_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3e9Ynk7jxyoQ7kNvwF1OyoL&_nc_oc=AdpXHq4XUOOeWRUegAbqrgCL-_6HP1CTXJwSmpSueYyoqf0SQXcjmT9njpo-Mkk24Mk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK_D4HI6dOJMlF_UCU0HVn2RTLwJK0pEGsY9soUKFXfw&oe=6B084222"}, "display_name": "Retropy VR Puzzles", "keywords": ["puzzle", "puzzling", "scan", "jigsaw", "retropy"], "long_description": "\ud83e\udde9 Become a Puzzle Master. With 16 base puzzles and free monthly content, you will never run out of satisfying 3D jigsaw puzzles to complete. Ranging from easy to complex, there are a variety of themes to enjoy. \n\n{963016575775248}\n\n\ud83e\udde9 Exercise Brain Health. It's no secret that daily puzzles improve brain health. Relax in a whole new world of oddities and detailed puzzles crafted for relaxation and to improve cognitive function. \n\n{1113800780393627}\n\n\ud83e\udde9 Customize Your Puzzle Space. Enjoy detailed objects in your choice of immersive VR environments, change the music from energetic to relaxing, and make it your own!", "short_description": "Retropy VR Puzzles brings you hours of relaxing 3D jigsaw puzzles  in an immersive VR or MR space. Enjoy 16 base puzzles and 2 - 3 puzzles added each month for FREE. \n\nRanging in difficulty from Easy to Hard, adjust the challenge to your comfort and unlock achievements as you complete each puzzle. \n\nFeatures:\n16 Detailed objects to puzzle\nUnique VR environments \nA variety of music \nConstant updates and free content \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO
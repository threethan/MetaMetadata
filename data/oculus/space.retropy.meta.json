ZIkwjjRRNe1_zrUpLOI3uxnk5JhniJlBIgG7R38gx6DogT48XmrhZqPeRn7EWrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc0XGjKmX2OrB78RZ8xxX37oPLgqKHE25tBNSIDdrnwQ&oe=6B00627B"}, {"file_name": "3.png", "id": "1140112234513126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1140112237846459_3391350817744798822_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ucb33QgpXnIQ7kNvwEQR9x0&_nc_oc=AdqKtSvmt3Cxr4Tr6lWop9UcwdOesmbmM8og6SJ5Ixde2gf2VKvo4Qc0jQ25Bwg6l7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhviwuF3JGkng3HeEDlgKfpyHl49b7_3-aLhkYS6iyqg&oe=6B005548"}, {"file_name": "Untitled design-12.png", "id": "1855003265306793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031329_1855003268640126_3692145407816589862_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDd1Np_Erg4Q7kNvwEyahT5&_nc_oc=AdqLKW8SqctpXwncpvwX3XMEegvpplqyPuec-4YzB276a4M1SUGAPXV9dlnAkYXYpFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXl3B0DTctncamiruKbTvo-GHi_aErHxda51lVZ7eftA&oe=6B008004"}, {"file_name": "Screenshot 2024-09-19 at 5.04.56\u202fPM-2560x1440.png", "id": "3829319804053099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035399_3829319807386432_8697232045329718283_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5GbmgmdfosQ7kNvwEDMLbG&_nc_oc=Adp90lcocc3sYiS3cz2RNVlw1IxVa3ypcVMhQmdp_82-5yqUIB0WVsnd-miE9GR7kk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIAJkMB-V2ty6BToweWfbPPMp3Lhe3suMaIiy_NneYjg&oe=6B0056D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "1950772375415851", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207242_1950772378749184_9023911922798697221_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKWdgfnZXmgQ7kNvwHa_oYI&_nc_oc=AdpFnBy50SL3ezyG5cVme6Fll-ZCONSHAsQ_C0ROrheur2soW1UIMrRulg0GF5c_epo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUykPPfkcnALrHIY2pjuKardQXpYywYuHPbVeLAmNhSQ&oe=6B005922"}, "display_name": "Retropy VR Puzzles", "keywords": ["puzzle", "puzzling", "scan", "jigsaw", "retropy"], "long_description": "\ud83e\udde9 Become a Puzzle Master. With 16 base puzzles and free monthly content, you will never run out of satisfying 3D jigsaw puzzles to complete. Ranging from easy to complex, there are a variety of themes to enjoy. \n\n{963016575775248}\n\n\ud83e\udde9 Exercise Brain Health. It's no secret that daily puzzles improve brain health. Relax in a whole new world of oddities and detailed puzzles crafted for relaxation and to improve cognitive function. \n\n{1113800780393627}\n\n\ud83e\udde9 Customize Your Puzzle Space. Enjoy detailed objects in your choice of immersive VR environments, change the music from energetic to relaxing, and make it your own!", "short_description": "Retropy VR Puzzles brings you hours of relaxing 3D jigsaw puzzles  in an immersive VR or MR space. Enjoy 16 base puzzles and 2 - 3 puzzles added each month for FREE. \n\nRanging in difficulty from Easy to Hard, adjust the challenge to your comfort and unlock achievements as you complete each puzzle. \n\nFeatures:\n16 Detailed objects to puzzle\nUnique VR environments \nA variety of music \nConstant updates and free content \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO
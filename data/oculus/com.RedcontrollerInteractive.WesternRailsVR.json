8).png", "id": "24204029555950125", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298360_24204029565950124_807927387328327777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahrml3MXNnQQ7kNvwF2_TOi&_nc_oc=AdnJCHDDo2kKuXdQWRKCAMDWJBU_44swzw6aaYECdq2VhveqhqjWc86PTPPL1M9v4rQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwA368ZjRNGJ27Mt-7xaGD8l2BJxDJW9Q4erOiWYa4wGg&oe=69B7E704"}, {"file_name": "New Project (39).png", "id": "710782278786345", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298212_710782282119678_901810222265480062_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6Nk3y64IvgQ7kNvwFTfJaU&_nc_oc=AdnpOwOAoNGYd4_4QZ15U9BPtHnymN2dwngz42MTGzGnmHrRy8MQtuwIqKIOT60B5P0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_COSaZLkB_W28J2HzfbWnLwKPI87YQVcU8uBdhwvVMA&oe=69B7F14B"}, {"file_name": "New Project (40).png", "id": "2461571157550944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623441_2461571160884277_8073650898290566373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtuuEfPikDsQ7kNvwGLIAIc&_nc_oc=AdkCtBa2IagyeOw5ab6D0s2dqFhPMPbcdoeKtusrY5vSGVeIu1NInj04leC02d6zYxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQvdsvpjq4Ecl-g0onZUvt5HIAmXZcZ8Yisa5PWGADig&oe=69B7E282"}, {"file_name": "New Project (41).png", "id": "699639913069191", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293732_699639916402524_8416088777441639828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qV8UbUsQQ70Q7kNvwEbM_bF&_nc_oc=Adm_nNZ6y1vMQFyZHfzcbftx_oRcu9eqTuO6Pgn1Cy4L5-WZq7_oB7ciDtvyj33qpOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxC1ob4xjMCxv65_8Nwaa5SSGKmswFYTaLW1VacMgKMhw&oe=69B806CB"}, {"file_name": "New Project (42).png", "id": "1924070251715514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298337_1924070255048847_4863618051968138806_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqlIKVrUGlkQ7kNvwGJew4v&_nc_oc=Adl8E3F2O1TeAb9xK3OE5rOIlRCx98i_gZYqhmzDtacLkm1SSpyaTXynuLqkXUBz64U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxV_xehCLXpdySKnnFk628otrcO7KSGSjOfi0oc7ThD_A&oe=69B7E153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wr1.png", "id": "622278380468890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618063_622278383802223_658738055666053367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmlU11jLZBAQ7kNvwEqnCHN&_nc_oc=AdmbVgbBOyLkBnTeT5TVRy3jMdwcbcHRsUulEzBslTXHrW41aK8MqOmuhPoScHO5Gxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ1fAh0i8ORd4oB1M5Wmwf4ZSFAuVtA4Ef9s__4qzrbg&oe=69B80C13"}, "display_name": "Western Rails", "keywords": ["locomotive", "trainsim", "train", "steamlocomotive", "simulator"], "long_description": "Step into the boots of a steam train engineer in the heart of the Wild West.\nIn Western Rails, you\u2019ll take command of a mighty locomotive and journey across a vast desert frontier filled with dust, sun, and steam. Drive historic steam trains using hands-on VR controls, from throttles and brake levers to firebox doors and water refills.\n\nExplore a rugged open world where you can switch tracks at turnouts, attach and detach wagons, and complete a variety of jobs. Haul heavy cargo across long distances, transport eager passengers to frontier towns, and manage your train\u2019s systems to keep everything running smoothly.\n\nDesigned for immersion and accessibility, Western Rails blends authentic steam-era vibes with intuitive VR interaction, offering a uniquely satisfying driving experience. Whether you're a train enthusiast or just love the Wild West, this is your ticket to railroading adventure.", "short_description": "Western Rails puts you in the boots of a steam train engineer in the Wild West! Drive powerful locomotives, control turnouts, refill water, attach wagons, and haul cargo or passengers across a rugged desert frontier. With hands-on levers and immersive VR mechanics, experience the golden age of railroads like never before. All aboard for adventure\u2014Western Rails is your ticket to the frontier!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2020533d-edfe-4f50-9cc0-cf108ba7688e", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23922796194081185"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1174647574516895"}, {"status": "PUBLISHED", "id": "1250492099523739"}]}, "baseline_offer": {"id": "1250492099523739"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761325200, "status": "PUBLISHED", "id": "1174647574516895"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25462162196811236", "version": "0.1"}, "id": "731281382843141", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23922796177414520", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary",
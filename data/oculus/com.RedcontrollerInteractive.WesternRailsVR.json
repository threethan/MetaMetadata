c_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7HS6OyZwbza8RFFtYiT8R5-zkv88w8GC73sO16GX-uA&oe=6B0F050B"}, {"file_name": "New Project (42).png", "id": "1924070251715514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298337_1924070255048847_4863618051968138806_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S4CldEbFC8Q7kNvwEvc5cm&_nc_oc=Adr2JiMT-SZDGUmR7izva0U1BBc4doxsli5F14eyB0pyfwplnizdTKpiUISEKtILmbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXnejfclOPf50_7YGEjaP7nAWSKeTmJCMduqL_aSsTPBw&oe=6B0F17D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wr1.png", "id": "622278380468890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618063_622278383802223_658738055666053367_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J24S2oCbRvUQ7kNvwGhH3N6&_nc_oc=AdohqlKM9fUUhPhBAQAjyuVv7-EblK2eoy4Z31Bzluku_V4Yclwy86eU7G496kTrI2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVc2x4P6OtdD49_s9QL7OgdpeDq6dMl1QZMbNp4L6Uc1Q&oe=6B0F0A53"}, "display_name": "Western Rails", "keywords": ["locomotive", "trainsim", "train", "steamlocomotive", "simulator"], "long_description": "Step into the boots of a steam train engineer in the heart of the Wild West.\nIn Western Rails, you\u2019ll take command of a mighty locomotive and journey across a vast desert frontier filled with dust, sun, and steam. Drive historic steam trains using hands-on VR controls, from throttles and brake levers to firebox doors and water refills.\n\nExplore a rugged open world where you can switch tracks at turnouts, attach and detach wagons, and complete a variety of jobs. Haul heavy cargo across long distances, transport eager passengers to frontier towns, and manage your train\u2019s systems to keep everything running smoothly.\n\nDesigned for immersion and accessibility, Western Rails blends authentic steam-era vibes with intuitive VR interaction, offering a uniquely satisfying driving experience. Whether you're a train enthusiast or just love the Wild West, this is your ticket to railroading adventure.", "short_description": "Western Rails puts you in the boots of a steam train engineer in the Wild West! Drive powerful locomotives, control turnouts, refill water, attach wagons, and haul cargo or passengers across a rugged desert frontier. With hands-on levers and immersive VR mechanics, experience the golden age of railroads like never before. All aboard for adventure\u2014Western Rails is your ticket to the frontier!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2020533d-edfe-4f50-9cc0-cf108ba7688e", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23922796194081185"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "3689921231170222"}, {"status": "PUBLISHED", "id": "2080452992880656"}, {"status": "PUBLISHED", "id": "1174647574516895"}, {"status": "PUBLISHED", "id": "1250492099523739"}]}, "baseline_offer": {"id": "1250492099523739"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHE
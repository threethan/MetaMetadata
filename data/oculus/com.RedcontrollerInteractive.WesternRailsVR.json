221_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By_lFGnma4MQ7kNvwGfNz4U&_nc_oc=Adpkt0jU9deUGOnCDSOLnJ5H1ygWjregWlqpi3WDToaLc1umtAo5FsgWyHZYQw8ML2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDYLh7_TTjrAU_LzCvmG5V_pFeuT4xrfxZHecLZmEWWQ&oe=6B10674D"}, {"file_name": "New Project (41).png", "id": "699639913069191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293732_699639916402524_8416088777441639828_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP28-jfmir4Q7kNvwFwe6KW&_nc_oc=AdpSvip86XdY0Q0Uxf0ExYTVlCW6t1KibBHz2B_MHsDmAKnjHGUSQHtytVTH80nkvIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRC0v_RpqYk46g6oYGxsPTjDHLh23T_AEx_p6wCg-_ag&oe=6B10568B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "western-rails-2560x1440-reference-layout-v3.png", "id": "1483879873651368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839681_1483879876984701_6221113268076468739_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyhFsOzWVNcQ7kNvwGWxAeu&_nc_oc=Adr2dleH_wz12EWaCWXH1uqVp4Hl2a5MMHFomVXTSOGxKv2BLMAGGvyLr8gIx3ybdBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUWIxqpqE21kcOqW-xpnvjxX5OQw-sB7qmZ0uUwBMk2g&oe=6B104493"}, "display_name": "Western Rails - Steam Train Simulator", "keywords": ["locomotive", "trainsim", "train", "steamlocomotive", "simulator"], "long_description": "Step into the boots of a steam train engineer in the heart of the Wild West.\nIn Western Rails, you\u2019ll take command of a mighty locomotive and journey across a vast desert frontier filled with dust, sun, and steam. Drive historic steam trains using hands-on VR controls, from throttles and brake levers to firebox doors and water refills.\n\nExplore a rugged open world where you can switch tracks at turnouts, attach and detach wagons, and complete a variety of jobs. Haul heavy cargo across long distances, transport eager passengers to frontier towns, and manage your train\u2019s systems to keep everything running smoothly.\n\nDesigned for immersion and accessibility, Western Rails blends authentic steam-era vibes with intuitive VR interaction, offering a uniquely satisfying driving experience. Whether you're a train enthusiast or just love the Wild West, this is your ticket to railroading adventure.", "short_description": "Western Rails puts you in the boots of a steam train engineer in the Wild West! Drive powerful locomotives, control turnouts, refill water, attach wagons, and haul cargo or passengers across a rugged desert frontier. With hands-on levers and immersive VR mechanics, experience the golden age of railroads like never before. All aboard for adventure\u2014Western Rails is your ticket to the frontier!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2020533d-edfe-4f50-9cc0-cf108ba7688e", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29026670983693655"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839654_2389833938449645_7515235916158232523_n.png?s
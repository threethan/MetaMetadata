t-ord5-1.oculuscdn.com&oh=00_AfvbnJ0PRJViG7DD4cRMIG_AQ48QkMgyhvlUTYcv7OiY0w&oe=699AE604"}, {"file_name": "New Project (39).png", "id": "710782278786345", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298212_710782282119678_901810222265480062_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxFgH2Tuts8Q7kNvwEWj2HN&_nc_oc=AdnCIRLmFKLoYevM7RqtctUoFXt2NZ1do-jrDBgrTrgOxVs8iHcKaKXngBVWkbm3iUI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuBNOkCCKjEWhKJHvcBzphyfFFWCiqBRzRcN-T3r_ZxLQ&oe=699AF04B"}, {"file_name": "New Project (40).png", "id": "2461571157550944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623441_2461571160884277_8073650898290566373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4sh9HWPWSwQ7kNvwG2zjuB&_nc_oc=AdkaJjrAxnjoxzP4oxFX7ogUZMMXwC1iCX-Rl5LA0azrYr1rwuiv5FS4qVLyl2sPYKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs0B4v6qE_yYcTSlJlYQt4IWeYHLrsr-tHrxX2a4LZ5wA&oe=699AE182"}, {"file_name": "New Project (41).png", "id": "699639913069191", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293732_699639916402524_8416088777441639828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qag74QGuEgQ7kNvwEKv5NE&_nc_oc=AdmUuPgEqp6r4cjSR5ipguRINTxysXW1jt70KGYszHMj3_0nsdiqTks0t-kBg7txSSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs1ZL7eWtldEHQyu2jKDxO5NCB4VL54KMFFCTEul8jZyg&oe=699B05CB"}, {"file_name": "New Project (42).png", "id": "1924070251715514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298337_1924070255048847_4863618051968138806_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYQGBZmG878Q7kNvwG1u2zF&_nc_oc=AdnbyIe2JGRHLbHyBzkOeO9_Nj6dLawR-TeFYbBBgzl6pBj1ZtW-dzV2oR1bLLtMfAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvLJvYJN_tvtzjuTxwnALRSlj9EcVedODXhIqsaslQjxw&oe=699AE053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wr1.png", "id": "622278380468890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618063_622278383802223_658738055666053367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwmwA4lxUQkQ7kNvwHSYL2x&_nc_oc=AdmV8lIRt8xC8XdDMswcVMo7PtPTDdQrSamjwgDMuJniNtDO98UEHXEDBQUlgU_f-iM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftD4EX6_9jJZqTGz7KTlSnmrUqbmr9MSkg43BRUCXsxog&oe=699B0B13"}, "display_name": "Western Rails", "keywords": ["locomotive", "trainsim", "train", "steamlocomotive", "simulator"], "long_description": "Step into the boots of a steam train engineer in the heart of the Wild West.\nIn Western Rails, you\u2019ll take command of a mighty locomotive and journey across a vast desert frontier filled with dust, sun, and steam. Drive historic steam trains using hands-on VR controls, from throttles and brake levers to firebox doors and water refills.\n\nExplore a rugged open world where you can switch tracks at turnouts, attach and detach wagons, and complete a variety of jobs. Haul heavy cargo across long distances, transport eager passengers to frontier towns, and manage your train\u2019s systems to keep everything running smoothly.\n\nDesigned for immersion and accessibility, Western Rails blends authentic steam-era vibes with intuitive VR interaction, offering a uniquely satisfying driving experience. Whether you're a train enthusiast or just love the Wild West, this is your ticket to railroading adventure.", "short_description": "Western Rails puts you in the boots of a steam train engineer in the Wild West! Drive powerful locomotives, control turnouts, refill water, attach wagons, and haul cargo or passengers across a rugged desert frontier. With hands-on levers and immersive VR mechanics, experience the golden age of railroads like never before. All aboard for adventure\u2014Western Rails is your ticket to the frontier!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2020533d-edfe-4f50-9cc0-cf108ba7688e", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_web
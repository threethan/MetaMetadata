7_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDr15i4iTscQ7kNvwFW1yku&_nc_oc=AdoC5cKmJfVs5KL0MLQSjkTi2YRMmywD_y3UuNA7WcrEgMsJC-mGxx6X0jW2cdlD2wA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAAb3MBn2VwgrNBqLpTPm0hL9Us1u8srJBITydNjEWvQ&oe=6AA93678"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_x9UXTG49UQ7kNvwEt2omK&_nc_oc=AdoVV0YkG7_o7ypZvrDJiWBbTKDkq-zJuvgCJ_Dwm0x01fs-8cEh_C7atN18ccYUeoQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL853-NGURwzqu9wehXzBArLgVb0XffvhTMGLllzpmkHw&oe=6AA9419C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX4efSWPQlEQ7kNvwHmbsdm&_nc_oc=Adq_i_PvQ7WO6NCQCHAlJNL36maS01F-UVKtiOm6ggj_erLHZrWH9VxLioIzBKenvDk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnROFb_sEPNK7RtqExmXAHjawIn6Zf9ViubJsfRgh6gA&oe=6AA93413"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short
uscdn.com/v/t64.5771-25/39036663_541742147533753_461213774474481790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN4YUQHmUsUQ7kNvwFB3qhh&_nc_oc=AdlZckTkvDiYy0giYCGhyB2C7zC483fvYtNhhaQgy3ID-gpFTx2HLnClngvavs9dvE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunOXl908VeZkp_QDFMrK292cgJBm_LopYdTVzTi1J0XA&oe=6999B849"}, {"file_name": "wada_oculus_screenshot_3.png", "id": "488392406346969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB-29zZ8agUQ7kNvwFLUgrT&_nc_oc=AdnnVFBd3_nGLLjQw5CN6_mOQ2n9sxu-FMkt6JApcTh9sNDnXaGDmqAVFgfZT7i8cSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBUDs3pALU7xN-RPJmTppO-f0nK3FSbKespoKnfvx1xg&oe=6999A178"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VwxyWUb8AMQ7kNvwHbmfsU&_nc_oc=AdkqrOu3EyyBZBK_ikarU1MvrEMcjOWmgw5rma4ud92nnWQtnHZQ2HTl8WuetiJapmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-DrGiPGXhQg5LYIN6WlO6J7cRngyOiZRFjrp7Cf9sGQ&oe=6999AC9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOTVK_XgHzwQ7kNvwHP8EGC&_nc_oc=AdlZu2sBKl9T_9W5P0ZBUDAejRNCpkKdVBavmpKc28ZKSMZdpglH-Ja8MvETNSGwCiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsrkKxQ9eY17DjGxYQo3aUsjUBE6526lS_IToaStJ48-A&oe=69999F13"}, "display_name": "Wadality", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That flying locomotion system gives a fresh experience of 100% motion freedom during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 12 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wadality.manerai.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Manerai", "support_website_url": null, "website_url": "https://wadality.manerai.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "6993874694013390"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984469_722657422272757_9151180453971855544_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCT2gY7fTMMQ7kNvwH1pCsu&_nc_oc=AdkU4vBnDIIcX6hMrLi_-uPJ0dacTegVD4avEYeQgj68QZb8LHftHY_ZqDmGzmp4gX4&_nc_zt
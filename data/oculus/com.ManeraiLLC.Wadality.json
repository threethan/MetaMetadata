shot_3.png", "id": "488392406346969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNHF7Z5uOwYQ7kNvwEIN3x8&_nc_oc=AdqzKFnFH3vvuhQ0HCP0ACsKIW4aQj2Tz81pPc3MAZ7l9MRLtNSDj_hDPe9a11gbbgo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eByVdEfaOQ08a_zrhNqLNNh2deldGOsUWmXPgLtBHhw&oe=69EB5E78"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XE3Bom7S-kQ7kNvwH54bZo&_nc_oc=AdqWUTJ4x6_ywdviU4Q2JN40x1zeCS_D4JXm9j7c3HtmNKNCFCGSo3mUZJyppt0EutY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iOrN89V61vqqornffsTPv3p108HptXAtnhAFiCzr2Ew&oe=69EB699C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wKpqmCNoHwQ7kNvwFWJ1HI&_nc_oc=AdqGM7DDnbm0srWzys3YPf1XA9mXHsSC7hujaTFQMda5MG0BQ7VZ2Ojoqp5jctLqiK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wjNlKiDQzKJI9YMz1nQVe9OlwX1pblBWKH3KfVOooYg&oe=69EB5C13"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z60I3ZFAicYQ7kNvwF8aZ5N&_nc_oc=Adoy6zZGXjjDaHV2smilFIuBbo3TFTVJswjLpFtgX_T6EAkSHh0SMmt-C8FuYwW7y_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JfZHBf4fcVOQlQawVZO0LnhIjw9RTRq14TjzBDgOSNA&oe=6A201A78"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFPm1ZaVNLYQ7kNvwEbrXI9&_nc_oc=AdqQ-7Kldp6vzCzc0SH5r7bqs0eOI0_7llZz4s2_JaLw1C2X6Ar9lRTOcKfjga9zCDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iaQNVgtOgfHdED1q-vM_Vcj6swx679KC3ruZuv8lFDw&oe=6A20259C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVzntNBL4UMQ7kNvwHqeLKM&_nc_oc=Ado30t0-yQCs4OdixkWDMnzmAMDj9xdLiBRZKiUaIkOMtcCA7HT_pOMksPnUVthBRTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JCOyRkrhVvbIDjQMBz34I1JrwACSulncfL4hHLifAgw&oe=6A205053"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKND6AsG5VcQ7kNvwFYU9f-&_nc_oc=AdpRQpho6kJenc1AUTKHt6y2BhV_ifT6KMm5uPEvzsf0f_gMpMtQbVv3G2d0Ux5ue0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE6wbkYl9uJGja0VKBFfiaYb-_aLW4xG3xAaUuOmU2yg&oe=6A95E078"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChGkGNAED4MQ7kNvwGYhUrG&_nc_oc=Adq4KHwtd6HMgMXboIuczgOLnGKJqb70bZDXVJSKTruDf4zDd2lQrSzwmQ6Q6IQa9nQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMY61XLPbVEGKMimnhsO9zUiGeYQYrm4UG_vUSoNC63Q&oe=6A95B35C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-a9W9g3vZkQ7kNvwFScGJV&_nc_oc=Adqm3oW1O_ly7OXQWDoKg0hvsGuPhE1FH9f9PNTvHa0dh5aithPk6zMQlny5xr7AYBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX_QuW0WqHAu4VHh-inq-Mq1C_GMcZh3zVNWGEOzKMig&oe=6A95DE13"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7mnP7z5vLwQ7kNvwHpXT3N&_nc_oc=AdrPjp8801GNU4ao1yemWBA9CKmHY-uR9jnU6ckqSskrfhn6Pj4K1464sXIpz3vejwo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8MxKyE3ROMhu1OiK-uvJK4pw5mIYLg-_ro3NYnY59Aw&oe=69CBBA78"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8Q2oSaAcKkQ7kNvwFnluhb&_nc_oc=AdpeSrX2ryS4FfmaAQN5k4KwhLexcY4-X2zGIaMkJMGnjcQghbm9LEHTZrd071lQ9v8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzR5_FpKBhFqtAaPQW78kcAZeHvqYJ7jeyzW_2O7FJB2A&oe=69CBC59C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGL98kewhsQQ7kNvwH1ocAg&_nc_oc=AdrDTJIxO9tIBvsKmXONt4PleHFDqKowb5uxkfnaKIILkLeQCOzEu2Q8-VVTr6JVoWw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8rq6iQBqFJ7F09oJuQnv_y3gou9E511S7mKR5YVM0Yg&oe=69CBB813"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SplbtSVB-UQ7kNvwFRYVe6&_nc_oc=AdrGcFAPQtUNkLMSsTX3XZJ5UtsyZicEmKit97-SzF-e8QKBLlHP6QTHT2IK5gSdFZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwqEoZ1QE3jm0E1aovjjYb_d-k56g9xB4pUiho_rEpdA&oe=6ADE2AB8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng-DgmBMPO4Q7kNvwEy2UkS&_nc_oc=AdoS8S4plri3OJEAye-o3VFSL0A-Pa5LhWmzeAaLj5y5FfQtwp_fC9klDylw81zCrGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhgQPvbd2XkvHDUuKPwLCKziKerBpgVScOQxgAgFsrlw&oe=6ADDFD9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG2CkhjZzB0Q7kNvwFLAN_i&_nc_oc=AdpEZFW1BRllrfWxioem8MadP-jblGZ6kHTdBCaRNhFSG6Evv5-Vw7Amui8udeGeCAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5tA9mEg1uvfZkKqYuFb_GJL78zilCnYOXr8mJoUNB7Q&oe=6ADE2853"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
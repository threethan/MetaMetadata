shot_3.png", "id": "488392406346969", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayrG8EB5FQIQ7kNvwHJOuo8&_nc_oc=AdojkDKIQSumkwIqejg27FCpvMDhPC8FraRrCnzNPeH5Q_FNm1m-KsjHeKkEb8YRxDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhvB6AvCr5T-9idBIfq61tphKPtBg5l5O5XcGDHglFpQ&oe=6A689CF8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC-rF9kjecYQ7kNvwHpskth&_nc_oc=AdrwmZk2FL90ePaIdLeTLTQW23KrcTJrq92WblERdxEkE2VB27-r9QVxQUkOmQ1XpOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1P9MPPHVaGPvvb-Nfx8UWRi7yCxBIENVS_FEUb8Z1Gg&oe=6A68A81C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_8aWa_e6a8Q7kNvwFqb179&_nc_oc=AdriQJJ5t-N1GvHhg6MAAxhpSzcoChJoAtmet86Xo43ocpT2eZNHXJfo3WoDrzk8TDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgw5f_vF4rDzbdxmqrnJw-93QD1hu5xi8AgdpXR4hISg&oe=6A689A93"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
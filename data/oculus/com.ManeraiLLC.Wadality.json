7_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvKYbVziCT4Q7kNvwHtycCj&_nc_oc=AdqJjEaQPrt7RDmOmFt1CKegSf11OzREjvBqzpBX0LaQh3Q0xbyp6gakV5R82qAABDw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ--5zdLYpARjyGLYTkGpFlhSI5Yj11F-YpvKSu24vG9A&oe=6AA3F078"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcIb1SffPvQQ7kNvwHSucxt&_nc_oc=Adrhv46Em5HCRwnzK3bCEHxut3rJlzDfZDbTHCdXFbPYYwYd7EREct-L8VEEfqCLvnk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlq9Q80DkkfOKc9tSuwtEiedpXWi6Yq_43nR5WclhJcA&oe=6AA3FB9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQLIvAmutvYQ7kNvwFUvORf&_nc_oc=AdozBqIprGzlZr0TTcgBqRcU9XdlXxdkvxG3_h05wxG_FHq8PvUmMa5N0_lupmyBuyM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUwJi9Kh9oMqAejuMzFiiUljCfvIABrv3sBykUEIbzkA&oe=6AA3EE13"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short
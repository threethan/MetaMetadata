shot_3.png", "id": "488392406346969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUYj9w03Ht0Q7kNvwGpVREH&_nc_oc=AdoX_7queFIsdijatHm2pqi_r3Ssm0G0BVr3UMl88UWTmFrG1_yAYJGqx2sd5ZAySSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Sr3-_o30PKrr9SDCSXdEWJdfnSPqog63Iz5g1oNk20A&oe=69E37578"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZcVUUxal2oQ7kNvwGs5Io-&_nc_oc=AdqdaH5hI_VDKbvu08R4vnB6XU_2th3KLeg8aB2w_IPWf94ETuXif0ppPXFJ39odIcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pOgQdmjb90-ZA5TCcaZpjkX9yPMYofmxj7UWrouh_Pw&oe=69E3809C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoJkv5eTuQcQ7kNvwEv8tPD&_nc_oc=AdoZSoX--OV0miNKUvqULgISSK9cZNNBCyAT75onj7BYmDDTr9PR6jEvbE8LgmeIAQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FhNYgTbbwS6USqnOdlcCwM3ov6gy6wsIHowSyLnrDyw&oe=69E37313"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
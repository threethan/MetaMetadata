shot_3.png", "id": "488392406346969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJyMGZE5beUQ7kNvwGypaE-&_nc_oc=AdqoknHHYDpxRkPInF_rVBNgFM24TAyBLfDVAU_iIDodosyh2h1Z5GI_4k-RZFqxYUI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mM3UNzNxoGSg66ZmwCczY7oJcUZkBzp_OZOzjZYDlEA&oe=6A47DFB8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viRpe4Fk1zUQ7kNvwFz6OTC&_nc_oc=AdqeLPp2ZFLE3HRdiu8LdQhxkyyZUml_rXznudEmw8ibc9HsJ9kwPvnAMMJuvF_mU94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88P5NAi_VZFEjKpeBcOanfR9GOD0WQ6MeqY5x6hELkQg&oe=6A47B29C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBO0GK2qIWUQ7kNvwFRAxLv&_nc_oc=AdoCHwcR8ToIvrTRxVot-jCh2PibQl-6LP84_22nAVc4j59B93UlbWjrRi0R93UG_P0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__l24eyRmsXZSOF9ewa5IajcJu5j7bffedJCUkcs3ONw&oe=6A47DD53"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
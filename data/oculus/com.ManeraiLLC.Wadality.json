_screenshot_1.png", "id": "541742144200420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036663_541742147533753_461213774474481790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qngbHOHZi_IQ7kNvwGlIgRr&_nc_oc=Adln-naJNtWYeKR_q8hAQwuTuazYpQbiz88EiKpPvxOeBcW5Plns0hoZ7szs1lcA8qU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHo4i5FT-aijnbmpqtxnZuUV-bp9njKZea6HJAV2TUTQ&oe=69B021C9"}, {"file_name": "wada_oculus_screenshot_3.png", "id": "488392406346969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xBySMtjgk8Q7kNvwHvxjpw&_nc_oc=Adm4vY2ysZP8rmDQEjtfJXMFAw7PBg4q0f2B7-Lye6GIecb5U1h5TyYb6zJ1x-D9Jho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxg0KUcLKyFX7a9JmuUN-uweINqxHPbP8RWg8k1__lrTA&oe=69B00AF8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF03a3uIWVQQ7kNvwG9Fnk0&_nc_oc=AdkzkYO-497ilFbXZtBG0CvdYbZWJ9z5Z4G45l3Ad85EUTKWnbAU8AgJ41iYzQ4fStI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwX1WmcJSNg5cvmQSXQrBrcmpqe6lm2hWqawDwqIpliVQ&oe=69B0161C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIzYQn6PJWIQ7kNvwHwZRtx&_nc_oc=AdleLD2VmSX9qp0mkwU8yArTEQiPbtG9Yn_y8ptCBq9zcKt4X9eC1_jcAr7nFyKJqDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHrqG2RM-BJnrd94TQP2h45naOTybM-jWQ0tLi6HuF1A&oe=69B00893"}, "display_name": "Wadality", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That flying locomotion system gives a fresh experience of 100% motion freedom during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 12 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wadality.manerai.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Manerai", "support_website_url": null, "website_url": "https://wadality.manerai.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "6993874694013390"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984469_722657422272757_9151180453971855544_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7
nshot_2.png", "id": "1039815123611270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMKh3KQBN6wQ7kNvwGKmH77&_nc_oc=AdkuopGh2mDr83G5mxRxgEi0C0KtDtwmdAprwmhuFLa8Rh9ARrJvspUWzMcGuhoKrCo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUzkDSQR8S8viL507YhDhoaiUhEL9bkgbrAdtAgcMIGg&oe=69A2E71C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrCFcjdoG3cQ7kNvwEx55Fi&_nc_oc=AdlLN4Z09qNJOA03RnkIvmR2o-PQ0mFugBydG1DlQCVwklEFhKkNFFDbuHODjXK6ThY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftpfw3-CvninlHH8uacoL6SGJgNToxs5taZkJfqDY3aQA&oe=69A2D993"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wadality.com/privacy-policy", "developer_terms
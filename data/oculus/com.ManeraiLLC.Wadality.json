7_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHFWgGbi5K0Q7kNvwF2A-zR&_nc_oc=AdpnJeYyZsfAfTRNmQa1_22P0ZeIPFMvYszy8ibhRd5ZjMa-A9_NnqELXH_-cv8y3qc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNzQTV1q8m7SkjLX8HQyXbFElJydr9J4vdM0k-uZiA0A&oe=6AAEB4B8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcMCcMNIkjUQ7kNvwFWe9HY&_nc_oc=AdoY_n7FtiZhs-U-WoPPnTL9s9p_xR0nsgxpMKgLcXZe_adIHKSgerd2xkFiAj9g-MM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImldpCXuVWeHiUsZ_yrwLqF_BV_MHZx2s5MR8TIczJYg&oe=6AAE879C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZicte0jmIoQ7kNvwFAXePh&_nc_oc=AdpB7sDg9b-2I8HN8fqwp8551kkEORF47OaOQGotTluO-IMU04mWzw6h8D7UNbFrWlk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIflE3owLv2ekZnpu6Iwmothix69zOjIQhjMbfd9v8SjA&oe=6AAEB253"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short
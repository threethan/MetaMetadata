shot_3.png", "id": "488392406346969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1owfy0Odb0Q7kNvwFPhNum&_nc_oc=AdpX1ZqzNcFeix_0dIFInQOlFq-19LBsIFKNj-qGZ3Iuu-Az0ugCTjw-cJCQhJCQ_88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoTdYbNPhSuyugP2SpvPI9odb2sE6plDuGf00ORThlig&oe=6A8C3578"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLAGt7lP4PUQ7kNvwFqP8Iw&_nc_oc=AdprRkezpiYdPL7bl9458XyFNeMhwMkG4wQU3dQSvCQoSreX77NDdlLcIInfVPeVfFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdeQlJS4lRoIe-pxTYvscNuTv9cAk2EYrfS_hP-b4rkg&oe=6A8C409C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Y7PPnX1qmgQ7kNvwG7kcLO&_nc_oc=Adp_TaTFY96uooqWhMtWNClgpaeBxVGW2_v1BH4OcoeGa4uPz5iVGZbY5hMcxMtMY-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWTlrLzyBNy_gvxDMAl0XWPPuAMMghFQbNaL68UQ6FSA&oe=6A8C3313"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
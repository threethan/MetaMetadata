shot_3.png", "id": "488392406346969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxqFRUbulgYQ7kNvwFtRxsv&_nc_oc=Adr8qAKHIwqXpf4xkvHdZUX7kvEgfHLO3d_BJjfM70B1yIWihjSZJ5xeazeLt_yFiMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmGRxFItQJ65cFooAsmp99oRhDgWK9_1Wg3NsXNJQuDg&oe=6A48F8F8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viRpe4Fk1zUQ7kNvwHDv-XW&_nc_oc=AdpP6fADgvIHGrrDtuNT1RuixAqhQrL2-7x2ig1OuW1YrmeTzqj-YIP7E_c1H32hJrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhAC0wWixNyTeruIlb-Bjl11Ck33uMDYdbWjtRx2Pd7Q&oe=6A49041C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBO0GK2qIWUQ7kNvwHLJKDj&_nc_oc=AdpoFl_CORsZeBvUckv5jGabm8YX4DRV5gN1lueZ05gWb9Ew5d8-5kj0MuZT67uiqYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0azd17DduxT5nNAwFzJFSVVv6iLSAL4wvSPHisuSj_A&oe=6A492ED3"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
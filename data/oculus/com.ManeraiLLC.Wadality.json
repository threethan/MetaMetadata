shot_3.png", "id": "488392406346969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SplbtSVB-UQ7kNvwEPZhJZ&_nc_oc=Adq0idcz_ZXDG5w6Wh5LWH2pGx2cbUJ9JpnI49Pu9PVFqTIPBeTcRC1blrstQhLww5U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXW77RtBllrj0OIXJbvG6gWK6Of-WVE51lONAtY2P94w&oe=6ADCD938"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng-DgmBMPO4Q7kNvwFvPgsQ&_nc_oc=AdpU8QTnPQMjR99Nc_giMiD9OP-S9XABN63ptpStIA6jxOMhgmN-SthWgskuKQDjiyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTT5EIgnlfDLXe7lgZFbCHK4flwX8ie8oLBnrpZq2niw&oe=6ADCAC1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG2CkhjZzB0Q7kNvwFOhQ0Z&_nc_oc=Adq8aE7LdR1kkccGlAHda4jCKpCLeUG9y39oebAOKeff0djkDzbDkwXdHbiQMcdTTV8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM01ZJNUPlK4f56BNwb82NjxxBhrCLE1i0zN-1c6pLsvA&oe=6ADCD6D3"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
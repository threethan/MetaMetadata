ABE23D"}, {"file_name": "wada_oculus_screenshot_1.png", "id": "541742144200420", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036663_541742147533753_461213774474481790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9fV-o5M-r4Q7kNvwFij8Gg&_nc_oc=Ado8DREAjRttl28-b-kj3RQ2c_3-hTLsSeVPQxCblIVSf6UACVOMauAA3IS2yjKolVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIikgyUuwQGaKNfA3ixTX1vW_9mneA9pWqxi0EKrvYxTw&oe=6AABF049"}, {"file_name": "wada_oculus_screenshot_3.png", "id": "488392406346969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHFWgGbi5K0Q7kNvwGRVpsh&_nc_oc=AdoO2-c08xIUq_-abQKpDkDQEoooDNfM4KsSxmUOZbnNQB0gaCo2GcJ0skfIQt4JplE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdb01TUs3zGyneGUpMLNojV3bYfewjIKXBl3BsX3mRsg&oe=6AAC11B8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_x9UXTG49UQ7kNvwErWJTn&_nc_oc=Adqs4brG9kz1mnN3ZjUBGEaLuVLlTcceTS_u-E-JlbVGT7ohfbOjcWObSkfnoF_mbe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLawIHHdy8tY9h_JpH5OFwq9cysSPQZkIfFUqsZSM7QvA&oe=6AABE49C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX4efSWPQlEQ7kNvwHfahP3&_nc_oc=Adr7u9FIJrH7oAyHZBlpo-FneHIcJZPpnGA2OxMaL371KedxMT33-BloOsRz6qATfds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUKMoP7vEviVXfsdXKaQyKisY-I6Pidy2Z1FepC3Ns5A&oe=6AAC0F53"}, "display_name": "Wadality", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That flying locomotion system gives a fresh experience of 100% motion freedom during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 12 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wadality.manerai.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Manerai", "support_website_url": null, "website_url": "https://wadality.manerai.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "6993874694013390"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984469_722657422272757_9151180453971855544_n.png?
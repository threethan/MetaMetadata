shot_3.png", "id": "488392406346969", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObGURxl8Lk0Q7kNvwEK2pSZ&_nc_oc=AdobFficpLvyAY567jgcQDQiRNjT5F6csSXPGQ0KojZOiKYBBnWsIY-wyH8LFk6_XJw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyhBtuQaaJhiuP8j2qfKxs0NLVoGVR0wn_r0E4a-kGTA&oe=6A81A978"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIj2Ax67JkMQ7kNvwHopEeG&_nc_oc=Ado0dIrikixXh6eCVwC8Un9VMop-mLzTm656F5CpmqbnX0CeYJ85kPoTsXIkRvvOz5A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj0-yu_cHBqejvZ5wZKtUJSb9MGNZF7RpzC1dZwCvGIA&oe=6A81B49C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKUTcmc3sFgQ7kNvwGTfm6X&_nc_oc=AdoThkrk1PmAIHW767r23yX_i-DCHX4FeeuVi5iMlc-7O7uxSt7sXnuMdO32Sk-3USk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnwJfHnSHjQFqOT3Ae6FPMnwQS7oFilkPSOU597bB-_g&oe=6A81A713"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uPQ0Vst3lYQ7kNvwEdJycE&_nc_oc=AdoIpfwm34JYralrL-MLM0zXb3HhzTE1mFbKEhYZxT4FqN1nboQ5oKoTzEKQLNY7GIA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cqVXmU6V0gEnI49579V-due2Wr5zpsuP5eiKYlwMPqw&oe=6A3024B8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGUnhJu_TFAQ7kNvwGNw-P5&_nc_oc=Ado4WblsHZst8W-zBfoYwnDBee5bEUxz3slJK5uolC3Pr3ZaFLb5SgxRf_eHqG7Jjdo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iHcwYQRJ4_YWU-w1K9OmTVexQzrMRn7v60FwdQlKrHg&oe=6A2FF79C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2pjjipKjSAQ7kNvwG765f8&_nc_oc=AdqNYgzvupiMLUY_CtWySrC2S2BKVR_plhk0zq5dPkXU3Q8EhhSMZqrsjaISKiSsv9s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96sz6DgrlJ_QlYAfVW4XrmTYHAv0dJzIE8cfsTLgI94Q&oe=6A302253"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI2UR8mbXY4Q7kNvwEUYGIT&_nc_oc=AdparWz8hk3KlRgaVrV-_xxMey-BJET7aDonJi6jkN5rqPUVOEtCIGSay8DnvFqsRhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTio0N7RrhivJDDzxTOF-z6newBVdEl-DvT6NiFL1M39Q&oe=6AF342B8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TefVsmx2YVEQ7kNvwFDm4Sg&_nc_oc=AdrQvHyuVLWhrJD4HY_lwyosaribfk4q6XxohtxwVhURtzvWck8iGq2ppn_435-a2rg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZQrLgtQMi1lwA7tkIcXxKYZ2yXI2GommfrH1zKAZRfg&oe=6AF34DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0ukSUXJVlgQ7kNvwFzFLji&_nc_oc=AdqIgs1KFFnRGujjhVkcu6W8AWaPVptYLA47WDw2mHUF-4_BtJY865ny-8IxQXg5RCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd0sz8me6RJYvucpooCISEAYxZ5CQ1d7z5uCJ8V10zgQ&oe=6AF34053"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
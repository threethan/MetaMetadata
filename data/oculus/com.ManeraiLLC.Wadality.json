shot_3.png", "id": "488392406346969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXhB-sNRYgwQ7kNvwExCq0B&_nc_oc=AdpZ5QtDwZcyVsWr_AsX7kzOSrhjtHccyZT_DPip_qllVtlnheR12jbvniLCNnQYtAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bEf3iLCH3QF5nxPlA2IDRJNrRm7IrfM1LeZrGp0ECVw&oe=6A317638"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGUnhJu_TFAQ7kNvwGQ9p2X&_nc_oc=AdqpWD6y0IcLq7CXuClLpttulH5bCt62eFE4qLMNFgfyxkQpa8-9Pk58hC4FxVXYJHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JF_xOlp1SIPbwO413FMdzPjg4zakYZy3PD2vr4Nmpcg&oe=6A31491C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2pjjipKjSAQ7kNvwE06OT9&_nc_oc=Ado9mstLEGmSfuOPZ1CAS166_nLQSApMADwdpHC9OKJ7MMfZJhFHRKJxzOcfh3q_kfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KVNf6J-0sK1JXph14f7I4vGm7pSxKIvWtI8WZqKiBTw&oe=6A3173D3"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
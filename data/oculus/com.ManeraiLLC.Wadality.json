shot_3.png", "id": "488392406346969", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6XV7RVgN9MQ7kNvwFd7b4V&_nc_oc=AdraaCghr9HlxbUrsDdoWwrnO2qkMBW73k59bpNuO1ypl8OKKlRgZ-eiOik3YSAqZnM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY1EIZttECX4EK7XCi_0nB7bj6w5vgCj5QTDLko7X6rA&oe=6A86EF78"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GR7q__3ULUQ7kNvwEtpR3G&_nc_oc=AdrerLHTCtmCeHWEm2SHve7T5fJOx7zwhO4nbT6rFY4NhLEz40XKCWDu2d20G2V4v6I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEakLMfdlH7vE1p8777Ac4UmNRvHi1FL4lZDARyeVkEzw&oe=6A86FA9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcT2daAWhvoQ7kNvwHFI4q4&_nc_oc=AdpvpZkbv1Td--zlbwijUBhN7Ip0C5mLB3UqAPBBy2D8MZCW0Fnv6OaZli0QXaaXQsk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHkuWpkJMvVScbwM3GibxuondnV2xQoUY8t7EXqjFtUw&oe=6A86ED13"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cwaf3YRmHEoQ7kNvwH4QDst&_nc_oc=AdpPk5k_QaBrgTf7j-9TFTRUPl9kNNnadbYaQ8rUSLChXNGGcChyynuYTIRiGM0SU7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-2FYsNZvSGSYL2Jv6zeOZOQ3af3eV7lXr8KGUGgMPbg&oe=69D3A378"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXK_wkhMatIQ7kNvwFiGzo_&_nc_oc=AdoBvvCygZPy3-evujbaH6w2bosdTbK-VJainoP1jFiuLSRApTu7kJDJIOWaa8yAiQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rd9RAF6x3J9fOyYAC_3DbPCpESzvE6AW9a6YKraoXlA&oe=69D3AE9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esSDNz8oTwAQ7kNvwF_HFpj&_nc_oc=AdrZtfg3hpWX9Y6adLz7VJcepVE4kMa93r6wER2iOWk4JYY43Cc-ms1R8feQI_nHtcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EyYoKQGw90tHKTmxbp2GUlPNTI5Wtesu2So1fgHzzLw&oe=69D3A113"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
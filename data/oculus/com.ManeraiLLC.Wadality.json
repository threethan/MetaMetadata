shot_3.png", "id": "488392406346969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4pkQz6havEQ7kNvwFYgpPE&_nc_oc=Adpy7WC1Ga24WlfirrinydsFGzvEymzfjVHFmHVZ5CVNWsPPL2rqE8ST829FysArdNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGP2-J0RVtG0hE6mSUAoJkb3IS8UUAl0U-A2nIgdB93Q&oe=69CE5D78"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8Q2oSaAcKkQ7kNvwGJ6xe-&_nc_oc=AdpOdaHXA5WRWaOkNy2HVTWI5ZgeJFqZOz7BQRTEUGIFzl82Cd7y8Gq5MGEWrEr9yWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdnMDwdmIIg5a_1Tsd2evQqBqMEEvNK_Fzk2wcF3DWmQ&oe=69CE689C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGL98kewhsQQ7kNvwFn8lc_&_nc_oc=Adprk0L-ZO81jMG6n7mGED77PitMQZns6vo6Cm3p1rP8D1j217Uc_gNYKSwFCHCAb64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsyVwb9Wj4Hf6-bELyiu7XNzG8tNRUC6CHrY1HsR85sw&oe=69CE5B13"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
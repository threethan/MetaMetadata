7_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhitiAZwwMwQ7kNvwE8c-oE&_nc_oc=Adp-a9XoKtb_s_66-_RrU9MsY5eYDJg34KbASAYIvr1uFp_RAIWO544Ajn5pdlEOX-Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40veGRWujJ7-V-CLyzOMaFsFG9N4HMSpdD0NQ0XPa1Ng&oe=6A1199F8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1p--OJNN74Q7kNvwGCfbZC&_nc_oc=Adqy0givrrB9RyQcxoE9kbc_wCg-xM1r1kMmMxZ4kUtIR7FTmqK0fPEwnDu01YyPHjo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RFfKtEXUqT8uPA0Gw0GUen8FOcobX_753FmQTtzsOdQ&oe=6A11A51C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPqPy5x3im0Q7kNvwHtCMMf&_nc_oc=AdrkfVEMm7-qWqeCg6BWu0YooaPbBcCLl0kxT3HxT29c-Et24D_7Z3bUFYzJVdoFuKo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i73dGSTA0ShbnKmoUVPWfhWr8GkTtJ2wfIL7TFccXqQ&oe=6A119793"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short
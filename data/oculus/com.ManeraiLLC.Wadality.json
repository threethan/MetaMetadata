shot_3.png", "id": "488392406346969", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldCHKixspOgQ7kNvwGv7CpO&_nc_oc=AdqiIEIuwBK4VJt4zrai088lQRYvPx_8vIZZ-j4bQDmIdnOJ_qUo5k_2AMWbixHKp8w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38F-qykFm990-4NQjtKburQ4eO7qppUZlR3LFkISkaWA&oe=69F498F8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkwIs1CQp_0Q7kNvwEkVfTL&_nc_oc=AdoavMTtKZ5QwTM-IUTlAQ8RjEpthrcbIKw1UFiRuERLijs1ZBcvA7cE6weBm9aIWas&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rqyecwpXfg8U7YlKyMyiCvpwRs2KOERS5KCOw8F9vHQ&oe=69F4A41C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqS8Hyd90t8Q7kNvwFl1xqr&_nc_oc=Adr1ejM0rkN2LH-XT-9Z7P2gchZJtAjvNA6P8dxNWv_8XIlbUregv94DXA1UqLF1_PE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35hcK2E0MBRjeF_S3jaE3mKfuA8KxQ8ftCupHZDTDGOQ&oe=69F49693"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObGURxl8Lk0Q7kNvwEssgMJ&_nc_oc=AdrId_GHPVdjfEyX-fC1BbrCWaC92OJQ6_nkoNP4eGij5eD0VxEVoHZ5GBWRBXVTEa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF-5vf4rkl34CIxzCc7uj40Mk3GGnNl4Y1WJwoGMjr6w&oe=6A82FAF8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIj2Ax67JkMQ7kNvwHi72GY&_nc_oc=Adr0iqbOWJrAIocIYHbI9rc2keHNHCf8UpRMeA5oQ1lcr8vjzKdlBeIXGVbra32ZXZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNahczwAE2NhFMzHelV_WxMLIAcan3As1XDnTxsrqXHw&oe=6A83061C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKUTcmc3sFgQ7kNvwEjSHdk&_nc_oc=AdoxKMwcr4PqA6yVUfEFcj7gO37Wvt386mVTNUdtiaXkYgrG1B13KUuch2M3-Lr7VAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYUg1trVBFxxzWlru3M-uC0x4C5TLJuYF_he-IKw2_ZQ&oe=6A82F893"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
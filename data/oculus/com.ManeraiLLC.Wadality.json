shot_3.png", "id": "488392406346969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOU_4eVJEewQ7kNvwGCIjOq&_nc_oc=AdqsoMe2QfIz1xqtsCfdOhE9-UiH3lL6NNrnSlR41HPD-zSA5t9E9Ta6HF3Ab1A0nRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OPyPY-g__k_n93_WgUcdLuNHlRBWG6EgZSdHoDAYtvQ&oe=6A283BB8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MCoZpsmjH4Q7kNvwGmp94z&_nc_oc=AdqBvdz0r5tjCskyn3_qrprHFRSivPsub2EzkKRA5PbIHVSeszsbLvq3wUZ3J21DW0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9NXqMXj-qH5YLCrUWocW7wA6FjDfpTEqVuyFpKa1cvg&oe=6A280E9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JguwqBTnjrEQ7kNvwH_gEYX&_nc_oc=AdrqMX_9B7_2YCXpskh96-57dFHhzwdihuOH4FCVMAAkYGQe1tCyfyEVB4ZqWKOvfcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pRXCx0alVWU_izxqD0rCneXCXP_Y2hrLIfvVvW2BreA&oe=6A283953"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
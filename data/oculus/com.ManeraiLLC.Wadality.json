shot_3.png", "id": "488392406346969", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI2UR8mbXY4Q7kNvwEZKQBL&_nc_oc=AdrRC26T8kwDbELQLsSI04TFj4RuJOSLW5uCVY_SHmSEytl8-Hw3ubP6cTqF1-2D3Yw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuPcTdk34-T8FmCP6YUvfjVt1J0omf5VzipsK1-9uA2Q&oe=6AF49438"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TefVsmx2YVEQ7kNvwEEgJMv&_nc_oc=Ado-9i7gee1KON4EfVZrTriHA4f8CcMsVTPDPrIBvcVg2EFif55mmg69gJ0mzcSaN_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw7ERtfzb8IbXKrVUHtBJMfYvZs7rC2K8x7kXXwzeTDQ&oe=6AF49F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNU3dG3YVrwQ7kNvwEUW4ER&_nc_oc=AdqL5SPfFJMF-06sAdSSWIShOiAaxpwQx46AXlbWJfNNGQi_E7BOznGAo7OdF6O7rPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiuV50hy8g-nBtPWBFlp6js0mC1xQxyAX3XsZcrZSK3A&oe=6AF491D3"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
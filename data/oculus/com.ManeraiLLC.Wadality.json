shot_3.png", "id": "488392406346969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocKMzy82fDAQ7kNvwFlrpDr&_nc_oc=AdpOrsxnQG5Iv0WR4EmrE5SevlRcud_FFQVy3M6fM0jknEDjsq3ID_5m2IFGx05ohUA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwvUzBctRFXc1uGjBpuXYuDaz2k8Eeg7u0T8u4-DK_Eg&oe=6A6356F8"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgLHUI_3AWYQ7kNvwG1jky0&_nc_oc=AdqNfFJR9DbXARRnMmsfwok57O_86qglaLK1STwR1uPEko62kA2sdCOHBsjtBFWlKnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJqk_tbC0TfVcHSBGwXv9qg-4c3r84ek8wAufBZ1Dvvg&oe=6A63621C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DD42Ps3Paz0Q7kNvwHzZfXF&_nc_oc=AdrKDhJptFUci6OUgnwxD914sIN4SOwvjMuVCZfRgy0SeHdFq9Qrr2KZIDwT0dhCZ_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ3Jddvf078ZJteE5Nm4QApeTDLll3kNDbt3d7pwyaXA&oe=6A635493"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
nshot_2.png", "id": "1039815123611270", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMKh3KQBN6wQ7kNvwEWD8Te&_nc_oc=Adk0nkMuoMQCI_yJ6eD_q0Ym5KcEFuKmnysXQBYTxeLYlQPh-Yv7UqtGZ9oj1AQTz8A&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsvNrmj9cKpSI9-ZsDJedxP670zJoolRz9otjsvn97elQ&oe=69A1959C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrCFcjdoG3cQ7kNvwGUev2K&_nc_oc=Adl1_XwkyrxHt4PlBL_SQ-fNfsnFuk-466mf0p1xzpPmtFNFRAGVYTrVI6yn2TWnr5c&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsjtL7yo007QOpqjjQeBuS0nzQSeWzChOqBqB6ctcXgAA&oe=69A18813"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wadality.com/privacy-policy", "developer_terms
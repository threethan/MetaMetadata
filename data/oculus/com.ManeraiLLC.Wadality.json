shot_3.png", "id": "488392406346969", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdAjwEEwLWwQ7kNvwGgYjrh&_nc_oc=Adq6im6hMlUhkI7t-Q6m6_j4zRWL1va8ZcvWbag4gST7K6BAu8Oxplkfmqz5iBZcm6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS4KsJGSUr2W5iwIv2B81Qi9QsCV5SyxBL5AQtQamC4g&oe=6ACA6438"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-b-Hwh-YcMQ7kNvwGzUXP0&_nc_oc=Adr-x6eYN5QbYzcYYmYZfbuClTemb67KN2rVbgEl5TBd0t9FLfbo4vqW3IyzelgP8s0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOew5o0UvOstnpvtvy55uq-yT99OrQvZVV_OGffXoBxaA&oe=6ACA6F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33tUDD6vS3cQ7kNvwGSU_fe&_nc_oc=AdrWYvqsMIYDWmyAedKHX78IZ3F1h60E55JqmN_jm5kN3YhLeCEq_MXVB9mFqNMEQUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs77LeQ-BjqiLixdB5bir1EEYXsBu8vxRfj49T-8sPbA&oe=6ACA61D3"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
shot_3.png", "id": "488392406346969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avoaf9nJ8qkQ7kNvwE7nixP&_nc_oc=AdoCfLGpYSceUR4QZup1uoCTWLGdHP_6dv-fTqSCriD0Bzc7KEFM2wjPy3FllomhcYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH75ZrGT5oCRbUdkEKpwtu08q2rUT_syPeEH3qhuSdg9w&oe=6A747A78"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dKzcXKbxNMQ7kNvwGE5JDJ&_nc_oc=AdpZ-RzrAklkvLVd3uAbhRDfDxLOjV1oM-63afn-Yk-FWRhDwSvVPe3rGKaVGpBGRik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJTF2GizBIN58YIv733c3zyQrTZM-ZOGqKftrV9N27Ww&oe=6A74859C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGhj9vEfWo0Q7kNvwF64PQr&_nc_oc=AdrRCnaIvxt772-aMMTAg2ls14iWET_13JsAa3kEVOFA2TSBVSwV0zcdD0XSacKaB6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm_SZ7zTMSNUNuLfLJD-p70J4kX1xWg-qNFn8TggICXw&oe=6A747813"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform and currently works on main VR platforms. Become part of growing wadality e-league community <3", "short_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wadality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Manerai", "support_website_url": null, "website_url": "https://wadality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "295833109387263"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085397665373418"}]}, "baseline_offer": {"id": "1085397665373418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1652628600, "status": "PUBLISHED", "id": "1085397665373418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23943802768593984", "version": "1.2.3f2"}, "id": "236262735199187", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicatio
shot_3.png", "id": "488392406346969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_488392409680302_3155418975303320174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWWJ1sNnr48Q7kNvwGpPK8j&_nc_oc=AdpzvrSTjIW1M7BSQUzFHDM4VfGH2ftleL5ZKEAFQtqnpDdo3iV0CptqbUqRxReiXc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrRkTsx3ooCyYAIVw0gRwxojftGFUerFYJl_5fe_lzmw&oe=6A674B78"}, {"file_name": "wada_oculus_screenshot_2.png", "id": "1039815123611270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974610_1039815126944603_9177373266834432759_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC-rF9kjecYQ7kNvwEJrSxk&_nc_oc=AdoJ2k1v_j4BCfV0laoao324pVFDNj4npN2FKLmaHOe_dbQQk4iOWAA4GjKqwBAKReM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxBYA9enWCxRKpsyM3wbRcnl_e9_zkBo7ZId21hc8VUA&oe=6A67569C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wada_oculus_tumbnail.png", "id": "1219257588605169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982721_1219257591938502_8118811099117830679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_8aWa_e6a8Q7kNvwGXY_9p&_nc_oc=AdrJvqECSLoBP3FZ1e7P39raEiTSTAmZH15KDJ_LS3f_NYG7T_6wvCH_NvwEu2j5XbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmFv9DYOsOizqqXKHoM4-VTyvMr_v6EOb1ne5tjtekAw&oe=6A674913"}, "display_name": "Wadality VR Arena", "keywords": [], "long_description": "This is a multiplayer VR Shooter platform with unique vertical gameplay! Take your friends and fight for the title of being called the toughest on the block. That \"flappy\" locomotion system gives a fresh flying experience during the game.\n\nThe game features the movement technique unique for VR that allows players freely move around game level in all directions. Using hands swing locomotion drastically reduces motion sickness symptoms.\n\nGame supports up to 8 players per server with different game mode and configurations. Game is crossplatform a
 2D films into 360 virtual reality movies. This is a whole new way to watch and experience movies. You can now be immersed in the story and the action. ", "short_description": "At The Edge of The Universe Lies Mystery And Adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrmvideo.com/vrm-apps-policy", "developer_terms_of_service_url": null, "publisher_name": "VRM", "support_website_url": null, "website_url": "https://vrmvideo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8915165218594392"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "552351830598502"}]}, "baseline_offer": {"id": "552351830598502"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739409420, "status": "PUBLISHED", "id": "552351830598502"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8860767537367494", "version": "1.0"}, "id": "484558628084459", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8837256806385234", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8860
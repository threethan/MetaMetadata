RM", "keywords": ["VRM", "Movie", "Ghost", "Planet", "space"], "long_description": "At The Edge of The Universe Lies Mystery And Adventure\nA group of space explorers finds a treasure trove of new alien tech on the far side of space. One thing they didn't count on was everyone else gunning for their find. \nThis crew must now use their wits to survive their deadliest adventure.\n\nPlease Be Advised:  Movie content is being streamed and good internet connectivity is required.\n\nVRM is a new video format that converts 2D films into 360 virtual reality movies. This is a whole new way to watch and experience movies. You can now be immersed in the story and the action. ", "short_description": "At The Edge of The Universe Lies Mystery And Adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrmvideo.com/vrm-apps-policy", "developer_terms_of_service_url": null, "publisher_name": "VRM", "support_website_url": null, "website_url": "https://vrmvideo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8915165218594392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1275348557083600_3547856730283233664_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8TBKMBwv4gQ7kNvwF--Gjc&_nc_oc=AdkPPNSx
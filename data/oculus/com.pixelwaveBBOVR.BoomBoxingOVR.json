2727971_1838675256350749_4026954172724150272_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4T0uNdeThMQ7kNvwGwqz4_&_nc_oc=Adrc9rro9gz6tImKRGdr4jjKFKPy8bJ5n2ujAT2EZPZ79W5gCrU3spfjVVGDPtmvt5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT9beGu2ZmblEFGQ8xtyAsvcCzRnyS27uZy5jCfUnHSA&oe=6AFDAE86"}, {"file_name": "migrated_image.png", "id": "210708747006192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680493_1666581260307988_9041309811991379968_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1E6gEPrLtkQ7kNvwGLX8Y-&_nc_oc=AdrXYGRw2dWJNeIWkXSzSSLdmynLP4m77KmJ8IAEd5UArtoUJF7_TZ5uYJ7UOeA6UuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwMcosZ9oAR3x11tDo3-r8HDBcdzxniiQqGR1yYtBEXg&oe=6AFDD7EA"}, {"file_name": "migrated_image.png", "id": "141608053895673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448923_581655878700103_6047995121696243712_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XbU5BiOQgIQ7kNvwEw9aDR&_nc_oc=AdpfyoDl2ztDw__US5X_raCR1imAA2RWivPw3KhVPRahNy4fNw-UXc28-2o7VZMsg40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH9_G0iF4x_OCIXIvT-bsDvGgOwO8U1jjblS-7dlwHUA&oe=6AFDD182"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boom Boxing ", "keywords": ["boxing", "firstperson", "fighting", "fight", "arena"], "long_description": "Boom Boxing VR is the FIRST & FREE knockout boxing experience on the Oculus GearVR.\nBoom Boxing VR will take you directly on the boxing arena and let you fight 1st person perspective in a VIRTUAL REALITY environment. \n\nBoom Boxing VR offers fighting game fans an adrenaline pumping world of boxing action. Polished animation and stunning 3D graphics bring the real boxing experience to your BRAIN and MIND, Just looking at the opponents hit point controls make jab, hook,and uppercut feel natural and fun. No more sit and play for Fitness lovers.\n\n\u2605 HOW TO PLAY\u2605 \n\n--- Just looking /gaze at the opponents body part like face or abdomen, This will immediately trigger auto generated  controls to make jab, hook,and uppercut which is natural and fun with your body and head movement!\n\n--- Example: If you look at the right side of face the right jab/hook,punch will trigger, Same for Left side, Abdomen, etc.\n\n--- Move your Body, Head left and right, This will help your attack to be more precise.\n\n", "short_description": "CHALLENGE YOURSELF IN VR BOXING ARENA."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.deepbrain.xyz/boom_boxing", "developer_terms_of_service_url": "http://www.deepbrain.xyz/boom_boxing", "publisher_name": "Pixelwave Game Studio", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/boom_boxing", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["FIGHTING", "SPORTS", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "322324856512109"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "CANCELLED", "id": "319475241872317"}, {"status": "CANCELLED", "id": "728528327346410"}, {"status": "PUBLISHED", "id": "750274815370621"}, {"status": "PUBLISHED", "id": "140352693187322"}, {"status": "CANCELLED", "id": "138229023505580"}, {"status": "CANCELLED", "id": "243881922721627"}, {"status": "PUBLISHED", "id": "364167720682312"}]}, "baseline_offer": {"id": "364167720682312"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "CANCELLED", "id": "31947524187231
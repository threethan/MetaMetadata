2727971_1838675256350749_4026954172724150272_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_H29_tMSbkQ7kNvwHeO6lG&_nc_oc=Ado0xWQf-ZFUs5S7NmnnSxDMQHwSdfbXHTCRvijUhedtM2vinj9sLZj-dqgvhDS-XYE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2vfqd-SFduJNqIBS40HGegLx56Dr8mUISdIyqZ6d2FA&oe=6B0DB8C6"}, {"file_name": "migrated_image.png", "id": "210708747006192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680493_1666581260307988_9041309811991379968_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQxdC8vb-WcQ7kNvwFbLegG&_nc_oc=AdpNgrv2d-vsqANagdt4IuKwFAyBTsKFvq2nR_TlYD31BKKntCAoj42t1frD8BF_1ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRb6ueycx9gKB2k-gw-wuZnd6ibz55iFgI1FCXUPk_IhA&oe=6B0DA9EA"}, {"file_name": "migrated_image.png", "id": "141608053895673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448923_581655878700103_6047995121696243712_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDVrRvqKdUMQ7kNvwGM_EDJ&_nc_oc=Adq6aBACXzW-BMnLDHj2f_A0IVgDy9LGfj5lCOUCKmfRdqAyRF6RlNLDftSwiOVbB5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkcrqEJtHNIeGmwKVJWPDiv8Z4P2mj_thI9tqQKczkzg&oe=6B0DA382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boom Boxing ", "keywords": ["boxing", "firstperson", "fighting", "fight", "arena"], "long_description": "Boom Boxing VR is the FIRST & FREE knockout boxing experience on the Oculus GearVR.\nBoom Boxing VR will take you directly on the boxing arena and let you fight 1st person perspective in a VIRTUAL REALITY environment. \n\nBoom Boxing VR offers fighting game fans an adrenaline pumping world of boxing action. Polished animation and stunning 3D graphics bring the real boxing experience to your BRAIN and MIND, Just looking at the opponents hit point controls make jab, hook,and uppercut feel natural and fun. No more sit and play for Fitness lovers.\n\n\u2605 HOW TO PLAY\u2605 \n\n--- Just looking /gaze at the opponents body part like face or abdomen, This will immediately trigger auto generated  controls to make jab, hook,and uppercut which is natural and fun with your body and head movement!\n\n--- Example: If you look at the right side of face the right jab/hook,punch will trigger, Same for Left side, Abdomen, etc.\n\n--- Move your Body, Head left and right, This will help your attack to be more precise.\n\n", "short_description": "CHALLENGE YOURSELF IN VR BOXING ARENA."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.deepbrain.xyz/boom_boxing", "developer_terms_of_service_url": "http://www.deepbrain.xyz/boom_boxing", "publisher_name": "Pixelwave Game Studio", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/boom_boxing", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["FIGHTING", "SPORTS", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "322324856512109"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "CANCELLED", "id": "319475241872317"}, {"status": "CANCELLED", "id": "728528327346410"}, {"status": "PUBLISHED", "id": "750274815370621"}, {"status": "PUBLISHED", "id": "140352693187322"}, {"status": "CANCELLED", "id": "138229023505580"}, {"status": "CANCELLED", "id": "243881922721627"}, {"status": "PUBLISHED", "id": "364167720682312"}]}, "baseline_offer": {"id": "364167720682312"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "CANCELLED", "id": "31947524187231
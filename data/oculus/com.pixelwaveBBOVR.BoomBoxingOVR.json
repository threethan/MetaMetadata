jc6-1.oculuscdn.com/v/t64.5771-25/12139031_608268026176082_3293314857385852928_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNpdnsGYsywQ7kNvwF79n0h&_nc_oc=AdpnmHBN6yWy6jAgflGoIrM-ZzwmRXnYWET3hZj-Zdmd7ticRiLxzEWZofFUt2P4pFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGgmxiMFOuwdN87EAP00CaIdWk2jkVejayeDvVwvgF_g&oe=6B031E06"}, "display_name": "Boom Boxing", "keywords": ["boxing", "firstperson", "fighting", "fight", "arena"], "long_description": "Boom Boxing VR is the FIRST knockout boxing experience on the Oculus GearVR.\nBoom Boxing VR will take you directly on the boxing arena and let you fight 1st person perspective in a VIRTUAL REALITY environment. \n\nBoom Boxing VR offers fighting game fans an adrenaline pumping world of boxing action. Polished animation and stunning 3D graphics bring the real boxing experience \n\n\u2605 HOW TO PLAY\u2605 \n\nUse all four corners of Touchpad Swipe for different attack actions. \nYou can Increase skill by swiping from All eight directions with new GearVR 2017 release, or combine any two swipes in a single blow to your opponent.", "short_description": "CHALLENGE YOURSELF IN VR BOXING ARENA."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/boom_boxing/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/boom_boxing/privacy-policy.html", "publisher_name": "Pixelwave Game Studio", "support_website_url": "http://deepbrain.xyz/boom_boxing/", "website_url": "http://www.deepbrain.xyz/boom_boxing", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "SPORTS", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_U
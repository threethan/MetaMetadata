jrbPigvoCuuw&oe=6A4674D2"}, {"file_name": "Screenshot_3.png", "id": "813228517917576", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/507840144_813228521250909_8658570504597759726_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdS4HtTrRVMQ7kNvwEM4A2j&_nc_oc=Adod9MOmgZzS1SNrMKpCm2q6ZCyJfpncjHylob_FsXXv0CWCYY74vw0gJbkQLVJaE1U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rIKaaKhwkNtt7n4wmth0d_54Ueb9r7auykNSshOggfQ&oe=6A4674E8"}, {"file_name": "Screenshot_4.png", "id": "1256340769400365", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819281_1256340772733698_1553656389496609971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEN-KBHu33oQ7kNvwGoeUZ7&_nc_oc=Adoj2kk7YSYf-KA7YYnc2bLeMB3rdeX0XLppYVTH5lfGpYWLbPCHDitaaTJPpV1ft4g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xPMnOFRR_iGZ64nilIRPZrKmxt2FABlLAQFk5p129zA&oe=6A4674A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Gorilla Attack VR Jungle Escape", "keywords": ["GorillaVR", "JungleEscape", "GorillaAttack", "VRSurvival", "JungleRampage"], "long_description": "Step into the shoes of an angry gorilla in this thrilling VR adventure! Swing through the dense jungle, roar to scare off intruders, and crush anything that stands in your way. The jungle is your playground, but danger lurks everywhere\u2014can you survive the chaos?\nClimb, leap, and smash your way across treetops, dodge traps, and escape hunters while mastering your gorilla strength. Every roar, every punch, and every leap is fully immersive in VR, putting you at the center of the action.\nExplore lush environments, topple structures, and unleash your fury in a game where the jungle obeys no rules.\nAre you ready to be the gorilla and dominate the jungle? Swing, attack, escape\u2014and survive!", "short_description": "I am gorilla! Swing, roar, and crush anything in my path. Can you survive my jungle?"}]}, "developer_name": null, "developer_privacy
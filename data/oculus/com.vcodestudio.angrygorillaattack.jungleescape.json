.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xPMnOFRR_iGZ64nilIRPZrKmxt2FABlLAQFk5p129zA&oe=6A4674A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Gorilla Attack VR Jungle Escape", "keywords": ["GorillaVR", "JungleEscape", "GorillaAttack", "VRSurvival", "JungleRampage"], "long_description": "Step into the shoes of an angry gorilla in this thrilling VR adventure! Swing through the dense jungle, roar to scare off intruders, and crush anything that stands in your way. The jungle is your playground, but danger lurks everywhere\u2014can you survive the chaos?\nClimb, leap, and smash your way across treetops, dodge traps, and escape hunters while mastering your gorilla strength. Every roar, every punch, and every leap is fully immersive in VR, putting you at the center of the action.\nExplore lush environments, topple structures, and unleash your fury in a game where the jungle obeys no rules.\nAre you ready to be the gorilla and dominate the jungle? Swing, attack, escape\u2014and survive!", "short_description": "I am gorilla! Swing, roar, and crush anything in my path. Can you survive my jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
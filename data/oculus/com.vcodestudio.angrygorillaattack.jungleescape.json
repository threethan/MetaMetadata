2mvX7Zb4IDFIcymg7n5t3Cxxd7V7pCCjzZ34lxsnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3WtPL6TdcMIv3bsOV0wV0BEbMV_FjOsUqyDXYR9HnDOA&oe=69F0C368"}, {"file_name": "Screenshot_4.png", "id": "1256340769400365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_1256340772733698_1553656389496609971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uOBHqd8V-kQ7kNvwGPS9ZY&_nc_oc=AdroGdjyBItNhNnAyDTvcgqlSoSGgbgAtaDGAczmFdB21eicKjzVyZ9mVHGfutExnwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af29Qi0tHIJK_4xh4kvCYp3KT7QfuLTW2WYb4kR-zsjG6g&oe=69F0C323"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Gorilla Attack VR Jungle Escape", "keywords": ["GorillaVR", "JungleEscape", "GorillaAttack", "VRSurvival", "JungleRampage"], "long_description": "Step into the shoes of an angry gorilla in this thrilling VR adventure! Swing through the dense jungle, roar to scare off intruders, and crush anything that stands in your way. The jungle is your playground, but danger lurks everywhere\u2014can you survive the chaos?\nClimb, leap, and smash your way across treetops, dodge traps, and escape hunters while mastering your gorilla strength. Every roar, every punch, and every leap is fully immersive in VR, putting you at the center of the action.\nExplore lush environments, topple structures, and unleash your fury in a game where the jungle obeys no rules.\nAre you ready to be the gorilla and dominate the jungle? Swing, attack, escape\u2014and survive!", "short_description": "I am gorilla! Swing, roar, and crush anything in my path. Can you survive my jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "co
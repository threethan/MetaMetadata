, {"file_name": "Screenshot_3.png", "id": "813228517917576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507840144_813228521250909_8658570504597759726_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcqKC37FKtAQ7kNvwFVn_lu&_nc_oc=AdojZbIOMUREjeuEK2kBTgAVNdYtKbQG756jIQu9kQa2wHYRop7dlrzO9BYaxMnNOQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dfd0jzriDWHiWxsXxt-vHjHH382pNuZkKAKe65egUVg&oe=6A3E8BE8"}, {"file_name": "Screenshot_4.png", "id": "1256340769400365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1256340772733698_1553656389496609971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC4qdI0I9u0Q7kNvwEJBCUZ&_nc_oc=AdqqHJXxT_ViAolfj8OXxxZBULH38tBG3GzeDsj73tyDH2sNk9-sL2ViS4nn2hCyodI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e5QKlQOzFtfJV6RxIpKvIvKaYxNZ2Y3xLvaB2kCXWlw&oe=6A3E8BA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Gorilla Attack VR Jungle Escape", "keywords": ["GorillaVR", "JungleEscape", "GorillaAttack", "VRSurvival", "JungleRampage"], "long_description": "Step into the shoes of an angry gorilla in this thrilling VR adventure! Swing through the dense jungle, roar to scare off intruders, and crush anything that stands in your way. The jungle is your playground, but danger lurks everywhere\u2014can you survive the chaos?\nClimb, leap, and smash your way across treetops, dodge traps, and escape hunters while mastering your gorilla strength. Every roar, every punch, and every leap is fully immersive in VR, putting you at the center of the action.\nExplore lush environments, topple structures, and unleash your fury in a game where the jungle obeys no rules.\nAre you ready to be the gorilla and dominate the jungle? Swing, attack, escape\u2014and survive!", "short_description": "I am gorilla! Swing, roar, and crush anything in my path. Can you survive my jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites
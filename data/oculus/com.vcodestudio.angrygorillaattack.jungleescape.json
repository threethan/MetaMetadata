, {"file_name": "Screenshot_3.png", "id": "813228517917576", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507840144_813228521250909_8658570504597759726_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKR1symlZYkQ7kNvwHcle19&_nc_oc=Adr7PLi20g-w9WTsYRHx0XRbX6gGJtPOp5RtT7wmC6N2h-s7hSMcIdGpZmtONquu430&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69PmdGxVPL_EVxbXM30zatLGDUot-nn0VXY8WqNb-Xmg&oe=6A130A68"}, {"file_name": "Screenshot_4.png", "id": "1256340769400365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819281_1256340772733698_1553656389496609971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR_SQdSiap4Q7kNvwF7pdv1&_nc_oc=Adqf2mzTXfQ2Vy1mMPT0Eyk629TNFA__3DcL4JfMO6Et0Q1y-Kmy1940BFWVeBxduyY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73Jc1y3UOYIpx5msfZO-Gxfrl-v2-C7eEo850nu9NMcg&oe=6A130A23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Gorilla Attack VR Jungle Escape", "keywords": ["GorillaVR", "JungleEscape", "GorillaAttack", "VRSurvival", "JungleRampage"], "long_description": "Step into the shoes of an angry gorilla in this thrilling VR adventure! Swing through the dense jungle, roar to scare off intruders, and crush anything that stands in your way. The jungle is your playground, but danger lurks everywhere\u2014can you survive the chaos?\nClimb, leap, and smash your way across treetops, dodge traps, and escape hunters while mastering your gorilla strength. Every roar, every punch, and every leap is fully immersive in VR, putting you at the center of the action.\nExplore lush environments, topple structures, and unleash your fury in a game where the jungle obeys no rules.\nAre you ready to be the gorilla and dominate the jungle? Swing, attack, escape\u2014and survive!", "short_description": "I am gorilla! Swing, roar, and crush anything in my path. Can you survive my jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites
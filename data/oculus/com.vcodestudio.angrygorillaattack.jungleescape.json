ers while mastering your gorilla strength. Every roar, every punch, and every leap is fully immersive in VR, putting you at the center of the action.\nExplore lush environments, topple structures, and unleash your fury in a game where the jungle obeys no rules.\nAre you ready to be the gorilla and dominate the jungle? Swing, attack, escape\u2014and survive!", "short_description": "I am gorilla! Swing, roar, and crush anything in my path. Can you survive my jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_TW", "zh_CN", "ja", "de", "es_MX", "th", "fr", "it", "ko", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34544403675204023"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1597287758709419"}, {"status": "PUBLISHED", "id": "4586870271581817"}, {"status": "PUBLISHED", "id": "1718358115962156"}, {"status": "PUBLISHED", "id": "1668390447712521"}, {"status": "PUBLISHED", "id": "955478324002969"}, {"status": "PUBLISHED", "id": "141
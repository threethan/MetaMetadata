: "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819982_798118713208610_8709433147171934914_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLcr4CawF6cQ7kNvwHp-zqy&_nc_oc=Adqv7ZxebpY_ibzIcBs6YCeDLzM4xRj5u3LfjuRRJ_DUprzzGZQnXngn1NBxf-OmYh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErcguxajnPsm7GfdwqSt5d4GCKFuWnO_y0lX3Snhjv7Q&oe=6A92B392"}, {"file_name": "Screenshot_3.png", "id": "813228517917576", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/507840144_813228521250909_8658570504597759726_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57GP7KP27BIQ7kNvwFYr56N&_nc_oc=AdpSKQWKHEsVDd9thLJpLRa2rEDgSrC1o2WCiK87UDdePHTg6gReUfgYMVTSCAw5DNg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3ZhnEZtgLVNtY10BxsFPld0O51rYIrTOJ7QVqfKk8Ww&oe=6A92B3A8"}, {"file_name": "Screenshot_4.png", "id": "1256340769400365", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819281_1256340772733698_1553656389496609971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHRzBKoOwzEQ7kNvwG0LmTj&_nc_oc=AdqJVub711q3moOPZGsrXlhTKRNAIoXMqL7YpRSC2az0lLp95mg9A8tnL3ur9JP3g7U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDdg0KMBqDoR3Chj8-9Ml8s3ZG8zTiRuRfRkzoY9bm2g&oe=6A92B363"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Gorilla Attack VR Jungle Escape", "keywords": ["GorillaVR", "JungleEscape", "GorillaAttack", "VRSurvival", "JungleRampage"], "long_description": "Step into the shoes of an angry gorilla in this thrilling VR adventure! Swing through the dense jungle, roar to scare off intruders, and crush anything that stands in your way. The jungle is your playground, but danger lurks everywhere\u2014can you survive the chaos?\nClimb, leap, and smash your way across treetops, dodge traps, and escape hunters while mastering your gorilla strength. Every roar, every punch, and every leap is fully immersive in VR, putting you at the center of the action.\nExplore lush environments, topple structures, and unleash your fury in a game where the jungle obeys no rules.\nAre you ready to be the gorilla and dominate the jungle? Swing, attack, escape\u2014and survive!", "short_description": "I am gorilla! Swing, roar, and crush anything in my path. Can you survive my jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_TW", "zh_CN", "ja", "de", "es_MX", "th", "fr", "it", "ko", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34544403675204023"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "4586870271581817"}, {"status": "PUBLISHED", "id": "1718358115962156"}, {"status": "PUBLISHED", "id": "1668390447712521"}, {"status": "PUBLISHED", "id": "955478324002969"}, {"status": "PUBLISHED", "id": "1417375156811822"}, {"status": "PUBLISHED", "id": "2441621962933054"}]}, "baseline_offer": {"id": "2441621962933054"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "45
R3VQSxtD-4us2cLCcPMHu8hq9aOZN82H5mdsX8eG_bsdXl05bY4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_gEBqG2G8IUA9Eyu1WOyxoyMzeqCEFMVH_ycTG21XKQ&oe=6AFB172B"}, {"file_name": "screenshsddsssdsdot5.png", "id": "182082477119953", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974479_182082480453286_4529326347623976215_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IHFMr0PubYQ7kNvwHjx8jM&_nc_oc=AdrDltEfrD3Q2lt57IHfP9fdnGAn_rqjbVgozYPs_zt_-WYKSdSB_GCvoeRO6iJL22A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk2JeMrFBkNPL9WJWkqpSFjT6Hr6FeoR0ChjTVshy6Ag&oe=6AFB3ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Haunted- Thumbnail big app.png", "id": "1076692856154654", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035381_1076692859487987_4517676425108502473_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDbF5v_hk4EQ7kNvwGIuRyf&_nc_oc=AdrKq6T1qacgsqIp1UbrExuc8nP-RrD8GIkA1E_PLnn3U4_TYAQkA2kbMSlqjHwZ5ag&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSqSiTWNGaOBimXPO-aH_kqoFuBjwZVvhnAEYhQWz_IQ&oe=6AFB274B"}, "display_name": "The Haunted Ride - A VR Horror Series", "keywords": [], "long_description": "The Haunted Ride is a VR horror film in full feature-length (split int 4 chapters, about 10-15 minutes each), which tells the story of an influencer collaboration shoot that went WRONG! Rico, Maya Sam, and their weird cameraman Albert rolled in an RV to Burningland. The biggest music festival ever. Little did they know, the RV was haunted and the ghost within it started haunting their dreams and altering their reality until they ultimately lose their minds. \ud83d\udc7b\n\nThe Haunted Ride is a campy, spooky and thrilling horror film. It is clean from gore, appropriate for general audiences, and is an epic step in 360 cinema. With spatial sound and endless trippy worlds and nightmares, this movie is a rollercoaster of excitement. \n\nIn this app, you will be able to download all 4 chapters of the VR movie on high quality, for smooth offline playback. Just walk up the stairs, get into the temple, and find the Chapters gates.  ", "short_description": "The Haunted Ride is a VR horror film (360 video), which tells the story of  4 influences that have disappeared on their way to a music festival. They got an RV and started driving. Little did they know, the RV was haunted by a jealous ghost, which started haunting their dreams and altering their reality until they ultimately lose their minds. \ud83d\udc7b\n\nThe Haunted Ride is a unique 360 cinema experience like you have never seen before. Walk thru spooky worlds to play the movie (split to 4 chapters)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.nirnetzer.net/#portfolio-2", "developer_terms_of_service_url": null, "publisher_name": "Netzerland Studios", "support_website_url": null, "website_url": "http://www.nirnetzer.net/netzerland-studios", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "HORROR", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1004673303766775"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1190719094740505"}]}, "baseline_offer": {"id": "1190719094740505"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1625088960, "status": "PUBLISHED", "id": "11
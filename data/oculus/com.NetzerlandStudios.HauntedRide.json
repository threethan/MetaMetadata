kPpTFjzjuIXbKDb37Nlb_9YZAS8LJETQNzpUdnVSgR8YWq583bo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjUXqMAvWqGrBQzvGmnyfQoWr9S6IOSwKzODQnnhnMeg&oe=6B0C72EB"}, {"file_name": "screenshsddsssdsdot5.png", "id": "182082477119953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974479_182082480453286_4529326347623976215_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC7vYMUXf6EQ7kNvwFTWw2i&_nc_oc=Adpau_BiyBfJH4H7_xN1_0IkHhMS2vMQzpAm_VAPzjCxGGebG0w5GVMAydKWIA5_AAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT673YCufgMP9gkdGOORveI20epBbt7LiFiZ5exldnbFQ&oe=6B0C6255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The Haunted- Thumbnail big app.png", "id": "1076692856154654", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035381_1076692859487987_4517676425108502473_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yvgBVwAjMUQ7kNvwHxgmWp&_nc_oc=Adow6kUZE56aoK6J4ndLn7MGv9pptpv5m5-l20N9bmgiOzgmyt1SC5BptEVgWzyFF6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4pn9fPryO8iRLd2PaLiuwEWeebr60Y9BS0cbwPfonIw&oe=6B0C830B"}, "display_name": "The Haunted Ride - A VR Horror Series", "keywords": [], "long_description": "The Haunted Ride is a VR horror film in full feature-length (split int 4 chapters, about 10-15 minutes each), which tells the story of an influencer collaboration shoot that went WRONG! Rico, Maya Sam, and their weird cameraman Albert rolled in an RV to Burningland. The biggest music festival ever. Little did they know, the RV was haunted and the ghost within it started haunting their dreams and altering their reality until they ultimately lose their minds. \ud83d\udc7b\n\nThe Haunted Ride is a campy, spooky and thrilling horror film. It is clean from gore, appropriate for general audiences, and is an epic step in 360 cinema. With spatial sound and endless trippy worlds and nightmares, this movie is a rollercoaster of excitement. \n\nIn this app, you will be able to download all 4 chapters of the VR movie on high quality, for smooth offline playback. Just walk up the stairs, get into the temple, and find the Chapters gates.  ", "short_description": "The Haunted Ride is a VR horror film (360 video), which tells the story of  4 influences that have disappeared on their way to a music festival. They got an RV and started driving. Little did they know, the RV was haunted by a jealous ghost, which started haunting their dreams and altering their reality until they ultimately lose their minds. \ud83d\udc7b\n\nThe Haunted Ride is a unique 360 cinema experience like you have never seen before. Walk thru spooky worlds to play the movie (split to 4 chapters)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.nirnetzer.net/#portfolio-2", "developer_terms_of_service_url": null, "publisher_name": "Netzerland Studios", "support_website_url": null, "website_url": "http://www.nirnetzer.net/netzerland-studios", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "HORROR", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1004673303766775"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1190719094740505"}]}, "baseline_offer": {"id": "1190719094740505"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1625088960, "status": "PUBLISHED", "id": "11
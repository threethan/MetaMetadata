bLRNTnmVd-ZAUPlAKXbEnaw&oe=6B104FF1"}, {"file_name": "04-Guida-strati-3D.png", "id": "1026876780457711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842205_1026876783791044_6308055136028003715_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP7WN0S7RMYQ7kNvwH82O3j&_nc_oc=AdpdfjNxz1e6urVWZJYAesg0vAWN2yx5_1F3Ou5OiWsKSWtdvW_AMK0T7nT2VnGmEF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9A3tG-ApEO3_Sy-P-XNE22O_8qQcgycZBpDYdWM6lFw&oe=6B104532"}, {"file_name": "01-Tracciatura-a-parete.png", "id": "1170372628663898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842288_1170372631997231_5443524795056225925_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjFJ1UPI26cQ7kNvwHML4wF&_nc_oc=AdoF822_CQ0EEaD-Wh8hPUJWsUCE4N_EkJRLsUgAxCfSZqq3B_FP3brS_-VoHfjl8QE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVRRck34s-1bVHLYasXmKmuj73b42E-8oIehEndLhcuqA&oe=6B103E6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Traccia EN", "keywords": ["mural", "drawing", "tracing", "stenci", "art"], "long_description": "Bring your creative ideas into your space with Traccia EN, a mixed reality tool for planning and creating murals and sculptures.\n\nLoad an image from your headset, place it on a wall and adjust its position, size and transparency. In Room mode, extend your image across recognized walls.\n\nBefore locking the image, fine-tune its depth and tilt so it sits flush with the wall. Check the alignment from the front and from the side. If you have already traced a line, use it as a reference.\n\nChoose the guide that suits your work:\n\n\u2022 Original: use your image as a visual reference.\n\u2022 Lines: turn your image into outlines for tracing.\n\u2022 Stencil: view a simplified preview and work with separate color layers.\n\nWorking on a sculpture or relief? Load an STL or OBJ model, place it on a wall or a horizontal surface, and adjust its position, orientation and dimensions. Use the layer guide to explore the shape step by step, from the wall outward or from the base upward.\n\nSave projects on your headset and reopen them when you\u2019re ready to continue. Alignment depends on headset tracking and the recognition of your surroundings: check your guide against your work as you go.\n\nIncludes an in-app guide. Supports English, Italian, Spanish, French and German.", "short_description": "Create murals and explore 3D sculptures with mixed reality guides on your walls and surfaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eudera-nera.pages.dev/traccia-en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "EuderaNera", "support_website_url": null, "website_url": "https://eudera-nera.pages.dev/traccia-en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1403355789525981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842208_1679598417119488_6494643202785489071_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNNU9ePMym0Q7kNvwFnOffx&_nc_oc=Ado_dX_ggK40gFlD0VvGzVn1teZjaRZYET_fKfKJEBqTNiJjja5rinJmItacPaY_qhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUyeDWdgv3zP8afLovG52NKxttAMtf6jH1DL
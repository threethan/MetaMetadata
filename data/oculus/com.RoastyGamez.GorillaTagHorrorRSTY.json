TLzKZ6uJtGurwaEDJGmVBkaUIQPbtNnw815s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd69jx7znQi8tLjUQCmn9oIQRNNwiM1ko4DKdafgq0Cw&oe=6A882C6B"}, {"file_name": "Main_Custom..._07.07.2025_09-44-22.png", "id": "701366495991601", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827033_701366499324934_4230052151975619469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I10qQO-3KqcQ7kNvwGbnqbo&_nc_oc=AdrFwowu7JHaeXnV1XllT1zHNgWn5Hs5wdB5zOI_vPSIsCWGmBfApTYUFqwU4cB3LRQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjoI343rXhSHFM0SQB4S-m_oqGR_XRSJWrbn9DdqBlIA&oe=6A881F24"}, {"file_name": "Main_Custom..._07.07.2025_09-45-02.png", "id": "1068700574791730", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822045_1068700578125063_3360387875634446809_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlDI11zwKJsQ7kNvwE_FQCV&_nc_oc=AdplN9ufUXwlo5p2RDb91a9bnUCSIlrQNl4LDH3p9Beum8OXDEiJQ-Z6AlIaxaZX9Wg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7DylGWVBLOfQ0dtQgf7-ufZ-C9aL7kCODtglAfncd5A&oe=6A883F1F"}, {"file_name": "Main_Custom..._07.07.2025_09-42-17.png", "id": "1845208992877291", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821208_1845208996210624_2008133048086388061_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Cbt4knN9PYQ7kNvwEnn-95&_nc_oc=Adqtv__BWmUvu_sNpZkjg8fv67t3nyD1fQ7BS79E0_y47VCy98wN-YicYAvqc9Ed1_8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNwCVH8TLzlhuo2KuuqYOUx6vrAKWj0UpJy-ezMX-dzA&oe=6A884BC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Scary Gorillaz", "keywords": ["horror", "monke", "gorilla", "monkey", "tag"], "long_description": "Welcome to Spooky Scary Gorillaz \u2014 a dark, creepy playground where something is always watching.\n\nEnter a haunted forest built for Gorilla-style movement, where every step and climb draws you deeper into the unknown. Using the familiar gorilla locomotion system, swing and scramble your way through a pixelated, low-light environment filled with strange shapes, eerie trees, and one very unsettling creature with glowing red eyes.\n\nThere\u2019s no escape. No objective. Just you, the dark, and something waiting in it.\nThis is a small, single-map horror experience designed to give you that uneasy \u201cwhat's-behind-me\u201d feeling. No loud jumpscares \u2014 just atmosphere, tension, and a slow-burning sense of \u201cI shouldn\u2019t be here.\u201d\n\nWhether you're checking it out alone or creeping around with friends, Spooky Scary Gorillaz is a weird, immersive trip into a haunted space where gorilla movement meets surreal horror.", "short_description": "Spooky Scary Gorillaz is a multiplayer VR horror game with Gorilla Locomotion-style movement. Explore dark, 1 short map with, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastedDuck", "developer_privacy_policy_url": "https://sites.google.com/view/spookyscarygorillaz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/spookyscarygorillaz/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24753747677560977"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED",
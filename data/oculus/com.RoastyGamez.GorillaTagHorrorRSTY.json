/491822045_1068700578125063_3360387875634446809_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbwLOEy2IyEQ7kNvwEg4oTz&_nc_oc=Adrnex6phlNHG2P-_NhBAQ8XZz79quVYOp3TYIdw55a935qWrlS5gLEHaBu5zMdH3kA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YTodB5sJffSqjlyE8r4et0S-mIvu4AASIiTrHY02aTw&oe=69F4971F"}, {"file_name": "Main_Custom..._07.07.2025_09-42-17.png", "id": "1845208992877291", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821208_1845208996210624_2008133048086388061_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKdt1s7N0JoQ7kNvwFoQfL_&_nc_oc=Adr9H0nfGsmDLpGbV3csZD9e9qm5QieibD1QHgrNq_t1hWEMUIKr6IUNpfldh1nwjDI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12n3DonABY4lJv_kYIUwHifpnanhZHFRCOiC4Zt22ZWw&oe=69F4A3C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Scary Gorillaz", "keywords": ["horror", "monke", "gorilla", "monkey", "tag"], "long_description": "Welcome to Spooky Scary Gorillaz \u2014 a dark, creepy playground where something is always watching.\n\nEnter a haunted forest built for Gorilla-style movement, where every step and climb draws you deeper into the unknown. Using the familiar gorilla locomotion system, swing and scramble your way through a pixelated, low-light environment filled with strange shapes, eerie trees, and one very unsettling creature with glowing red eyes.\n\nThere\u2019s no escape. No objective. Just you, the dark, and something waiting in it.\nThis is a small, single-map horror experience designed to give you that uneasy \u201cwhat's-behind-me\u201d feeling. No loud jumpscares \u2014 just atmosphere, tension, and a slow-burning sense of \u201cI shouldn\u2019t be here.\u201d\n\nWhether you're checking it out alone or creeping around with friends, Spooky Scary Gorillaz is a weird, immersive trip into a haunted space where gorilla movement meets surreal horror.", "short_description": "Spooky Scary Gorillaz is a multiplayer VR horror game with Gorilla Locomotion-style movement. Explore dark, 1 short map with, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastedDuck", "developer_privacy_policy_url": "https://sites.google.com/view/spookyscarygorillaz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/spookyscarygorillaz/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24753747677560977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830599_735574469078255_4534506677305582512_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9rt-7muz8gQ7kNvwEnircS&_nc_oc=AdrNg8yglkMuMyPXoI2ItMrmrpljuHiNnKi0bGl60mXVhgQr41JP-m2aFeKr4u2n2hc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lhjKkdpfBmCk_qz3EEZNjWKzK-f0Scja6Q7hf2vl-Pg&oe=69F4C20C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spooky Scary Gorillaz", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "6443548731
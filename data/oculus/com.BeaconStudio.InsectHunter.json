Su2tKxgJgOyOrbPOL_2bo51o9aJIY_oJMFO4O0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmSvbTxpChcGIXNtAtK4SaFDM2dZxSZXQxEMHHYUJG9Q&oe=6AFDD331"}, {"file_name": "-2.png", "id": "1044718904956740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304212_1044718908290073_8996322537744988405_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3Gz5Ycvn0UQ7kNvwGcdfV1&_nc_oc=AdqiwPeQNr9S8GLefhhmUhVRgn8mwgCHzn2e6rFUwY2FKHX_F0Vp6jZzuTMTV6ObdtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN0iOw6UyaPtqoe7f8i5S1CiljMgyefZQ-dNXzoFqwsA&oe=6AFDC7E3"}, {"file_name": "-8.png", "id": "1340254278293324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307309_1340254281626657_4776097109586684244_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBcX4ZxxKLQQ7kNvwHvcZTV&_nc_oc=AdoP0jrCKXMydL0yhaf7xHltVKC6kWAzHDSDgKK5yN3YQErQmeTNUkBVpp8kBTwB_3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkaCLGeyn9tC23ddciPbrQ29uWoGstTrvvx_qyLs50jA&oe=6AFDBDF8"}, {"file_name": "-7.png", "id": "1791198091870038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311600_1791198095203371_8839061009607127664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-7NZt_KpKQQ7kNvwEx5eaZ&_nc_oc=AdpoMsgUz_LSNELw3KyQL3hxDw_D7hdMKeK5Y8XSpj8PoHXa5HNN-4CSIaf5gajiuCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKKED5dugPtm95q-Kw9iaCwOyMkuGiFtFyjDM33dI2Fw&oe=6AFDCA3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Critter Blitz", "keywords": ["MixedReality", "Collect", "Family", "Arcade", "Cartoon"], "long_description": "Turn your surroundings into a lively world of magical critters!\n\nIn Critter Blitz, adorable creatures scamper across the ground and flutter through the air all around you. Grab your net, take aim, and catch as many as you can before the expedition ends.\n\nEvery successful catch earns coins and helps you rise through the ranks. Discover rare critters, unlock the powerful Net Launcher, and get ready for the arrival of an enormous critter that will put your catching skills to the test!\n\nEach new discovery is added to your CritterDex. Keep exploring, complete your collection, improve your score, and choose a cute nickname to claim your place on the leaderboard.\n\nWith colorful critters, simple controls, cheerful guidance, and quick play sessions, Critter Blitz is a family-friendly mixed reality adventure that is easy to pick up and fun to master.\n\nFeatures:\n\n\u2022 Catch charming critters on the ground and in the air\n\u2022 Discover rare creatures and encounter enormous critters\n\u2022 Earn coins and progress through ten ranks\n\u2022 Unlock the Net Launcher and expand your catching abilities\n\u2022 Fill your CritterDex with every new discovery\n\u2022 Compete for a place on the leaderboard\n\u2022 Enjoy colorful, family-friendly mixed reality gameplay", "short_description": "Your room comes alive! Catch magical critters and fill your CritterDex in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pp.rimeow.com/", "developer_terms_of_service_url": null, "publisher_name": "Beacon Diary", "support_website_url": null, "website_url": "https://pp.rimeow.com/app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCA
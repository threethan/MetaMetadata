dia revolution.\nCreators, producers, studios or 360 capture enthusiasts earn commissions when referring their favorite destinations and posting their amazing experiences. Once approved and published, they automatically become official Hoppin' creators, and we'll send their way anyone who asks about immersive content production in their region.\nEnjoy!", "short_description": "Meet with Friends and Family in real Hoppin' Destinations, 360 video chatrooms, using your Oculus avatar. Destinations: post your activity, event or location to welcome visitors. Creators: submit your work about destinations and start earning."}]}, "developer_name": "Hoppin'", "developer_privacy_policy_url": "https://hoppin.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hoppin'", "support_website_url": null, "website_url": "https://hoppin.world/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "SOCIAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "477960294048055"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982498_1385532174927647_3785748912460005376_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS6sbpC1dHcQ7kNvwF2KdWF&_nc_oc=AdqkDe0qBT0vlT6uxKgUE0Bk4KEewz4NNbIbC7KXhXlMQgGW-BUMKTHNpX02ns06lfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2kStLs9qvUsFPGPn6Wp21Q3r1wOySz3ewAQDZNDx8_GA&oe=69F0AFFA"}, "is_concept": false, "is_test": false, "is_trial_of
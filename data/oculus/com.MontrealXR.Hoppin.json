//scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031477_2422303158028201_1624768862308270080_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruaoS7Nnb3EQ7kNvwHhIDBn&_nc_oc=AdpPbDCEdHJkWGECtp1RxO9i_pGny5e9VRvQflSm_kv0dRWQ8N77uY-WR_c1RQ6oDgE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICB5HcQpVXLAAgMCl5xXSriaXelZxtFhiU0jAfiiG_ew&oe=6ABD34DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppin'", "keywords": ["social", "travel", "hoppin", "destination", "multi"], "long_description": "Meet with Friends and Family in real Hoppin' Destinations, 360 video chatrooms, using your Oculus avatar. Follow your host or lead the way. When you like where you're at, send yourself some information about the Hoppin' place by email.\nActivities, culture, events, landmarks or touristic locations can benefit from this unique opportunity to welcome potential visitors onsite. Contact us through hoppin.world to participate in the media revolution.\nCreators, producers, studios or 360 capture enthusiasts earn commissions when referring their favorite destinations and posting their amazing experiences. Once approved and published, they automatically become official Hoppin' creators, and we'll send their way anyone who asks about immersive content production in their region.\nEnjoy!", "short_description": "Meet with Friends and Family in real Hoppin' Destinations, 360 video chatrooms, using your Oculus avatar. Destinations: post your activity, event or location to welcome visitors. Creators: submit your work about destinations and start earning."}]}, "developer_name": "Hoppin'", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Hoppin'", "support_website_url": null, "website_url": "https://hoppin.world/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres":
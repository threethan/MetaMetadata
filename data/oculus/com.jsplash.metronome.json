519005199711_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX5B9Sd79k4Q7kNvwHJ1KLU&_nc_oc=AdqXzWX6C2yCi21tHhelXaZYearI8fBDFbdroiBlkhuHZZvCzDe7rGcjcLRuJmvzsls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS8Ay8tyWQbwigv-9IbLmQBjLH-F0U_3fcMkDCfo5LEQ&oe=6B05D661"}, {"file_name": "05-metronome-options.png", "id": "2678384715954255", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821615_2678384719287588_2969313409927374774_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zihCQp4njVoQ7kNvwG_6qzn&_nc_oc=Ado1Ki0uXCXMm2U0mRi55ZYeDZznprjsOt8xRWAMCf5TvR2VNaYkzXvAI3O5JXHZKB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJhOsCgfLAu24sX14TFMyme07ukTcvx0wz1NEpoKhmEA&oe=6B05D782"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Metronome M1", "keywords": [], "long_description": "Metronome M1 helps you keep a steady practice beat in a resizable 2D window. Set the tempo, use tap tempo, choose a preset or custom time signature, and add subdivisions. Select the metronome sound and adjust first-beat accents and increasing-tempo options. One purchase includes the Horizon edition's features without advertising or in-app purchases.", "short_description": "Keep time with adjustable tempo, time signatures, subdivisions and beat accents."}]}, "developer_name": "JSplash Apps", "developer_privacy_policy_url": "https://jsplash.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JSplash Apps", "support_website_url": null, "website_url": "https://jsplash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
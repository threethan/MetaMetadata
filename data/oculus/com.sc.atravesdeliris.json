JW-AwCGZ74JtiSzuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxp1rSsTDO4yIK2hpVV96rZGd4j4oiuaW4E9fE-AzrpA&oe=6B071B00"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5l8KpaMgoMQ7kNvwGBRpwZ&_nc_oc=Adp8thqu8uADokP1QSYVkOpuLQlpPvVaZgNr4jbV74dsfMp1mZofYvy0FtWI3xhIwOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSReRkup0mkysooPuGz0x_k7thXpq_xlDsLcv3sUM7GpA&oe=6B070BAF"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT1y_Av9svcQ7kNvwFwzZ7w&_nc_oc=AdrzfL0XSG5qLtsjL5E2-mYBPiWFto-m5gdximptUZIGCrzpSsPQD09Iz8ociVEEiVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEi2KxcnM_qV-3Vwe6qHZAvX9le8unX7BMsShFbd1RIw&oe=6B06F12A"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVQxBeT5byYQ7kNvwEMRjOq&_nc_oc=AdrvMgsE5ic6Li-mpRI0fd8mrQ_NqRHJGtZcmAZ3aBm8rwnx041ZqQyE5j1PaNhLKV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRImWP7zMpv3rv_T2OoMQzFbytlWVkXHbVTF-_N_OGONQ&oe=6B0727AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uveUMHX7-4YQ7kNvwGX3KtU&_nc_oc=AdpNOueetF9e1ur-ooIaC6azY4Cx_zJ5gg3Hmy7cdjv1dn85vKKVbfKyIPp-FpAZ-1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0TZfqz0-AaZ4wSjtzhmjdM1CQkNC6tgvkoVOjdk4xng&oe=6B06FD95"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
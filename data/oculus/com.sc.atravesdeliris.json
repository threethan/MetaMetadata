5H7Kgccclhkdb6dLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNCYcAuMm6GEC_7dzW8UmrSlQadsZzu4UW1EcB7swWwQ&oe=6AFC8F00"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITBrTf18mFwQ7kNvwHJ2RRR&_nc_oc=Adr6m8L9OnHWXeVJqBfd2NmC1mK4mhmboxekWGXEh91rZQ5B4Qr-kOSuqnWd-tkTXto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd4rYZ1v9mMe-Jo_AbO8JcFj7d_bXmbjWIc1M2tZezJQ&oe=6AFC7FAF"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiRaJlosdnUQ7kNvwGpEMmM&_nc_oc=Adpn-5zqFCM5VbIZLZ13lPNa0QGMjq3lf4x_D8F4vL2WG1Kqim_d4E6CHaIbiOyfSsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw9dd7TYIcFQkqOkfjVxHqTZfkzRTPMPeq1SjorBwuwg&oe=6AFC652A"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Qqz-csn4EgQ7kNvwG28iHX&_nc_oc=AdrKno80LIp_D_4F29R9HoAZWkc06WbsJYoCjHFAnKfluUXXGxUe6QBXJXq1TUxpVVw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy3HHncHahCvsiM5cVh_TO06cu01_FZ8NJqkotcXcxFA&oe=6AFC636D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NviEXp5Gp6UQ7kNvwHXf2G6&_nc_oc=AdqnZMEJdLBwlXKYIEju923ERlisVUsQ46UotHxUG3g4az76Q6oSb2v9nyIHWh8fsz0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-Ib2Is5TQute1g0miGFR6GVwLUXhik50uvj6bKkYD1Q&oe=6AFC7195"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
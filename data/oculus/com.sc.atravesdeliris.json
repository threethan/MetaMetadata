nt-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCYFSGw2rfAQ7kNvwFk4YLM&_nc_oc=AdqPAUpjPhYb3XVDdtgTbe3UBvklcKlioAW0IgwdHYWdjNm_hbNcFdEJNlzxK8tWrC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXX2BwplzHDml_Thz31qIup-hnuOoX9UtGbAE3K_YedeQ&oe=6B1062E9"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wloD7syaJ_EQ7kNvwFK1avc&_nc_oc=AdpLFeeLNuRSfEbdVlsgFIrJGcivqwT7wWcx_UfLZsdxNYMhoaQQlyVQONPeTAiacwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNS6hfi_yvXBBzsoeQ-9JYFnE7fSZhcuGOHw6Cw8zPFw&oe=6B1051AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kah018vnslsQ7kNvwED3oN7&_nc_oc=Ado_SvO8NoWlInasTiF_R0lEfZzvJQQOdivLHiyV33plCOPo01NGMILuUWsYLWjAdZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX468EaSyVdCaEsK97xvLtgZ3QHhMFEXqz14XbKa14T1A&oe=6B1046C5"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-_2ByAyOtIQ7kNvwEdiytP&_nc_oc=AdrVQ22ULTgg4O2-XfVGKlUzrzRI_nDETDKdasHkXOefXZ4GCCv9yIIounMKJUVf6a0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_Bqu2Ry7Bg0V6ag2DOaOc6nXDwx-AXKMm1GIDO2gDVQ&oe=6B105C5A"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS5Mg-x8rukQ7kNvwELu057&_nc_oc=AdqkOSDgXQxQ1ZAber6KEJmq44r_Ehn-nDgWTgJ7o7Dmwde-pJDFAntp_IlixxPdrBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWietcsK6kZuUPRhSXpH_fYrBGugWbJetrztO-_7jqnSA&oe=6B10366F"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbdxfEnH5CUQ7kNvwH_5Zgn&_nc_oc=Adq0HjOvljfqNCR9wv64UsF0MTnQfRbojmA4igYkPEHN5BxY
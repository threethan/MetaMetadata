AT3brsIvBth3JsPBDSznIIZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgdDt7044IXi76qSI6Su193WhKF0SnoHMQdduIQYbvCw&oe=6AEB40A9"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vw35Dq3KwDsQ7kNvwHYG44V&_nc_oc=AdqXZSL0R0goRUr8q5Mx9GZNB2lB8E7cwd5KGp-hhPdQ2dyxRmqIVBXHa7ICuf3rs9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ1eK0NJ2rPgHPzGtQhltzctXGTXYmtDLDuZxJNcGNLw&oe=6AEB2F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3ylnBJ3EDYQ7kNvwH39_4C&_nc_oc=AdrW4oeWephR0OEUn4qYoYGtxx2RBaE8i8-C_3Zgoxk5Un386O2ifxMBa9LCejdFARE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUa0pHpo3IVqeA7hZHQOnNdnnmrylU6nrRFyMrpyb_4g&oe=6AEB5CC5"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3PaDqNZZh4Q7kNvwHEDRte&_nc_oc=AdrULh05w8r06_VCs4RfPmRMVltsb8ggAv86ShFgf4mv7_KM2-OcFahplZYirc7N7Ow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMEE8Ew0BENZIjcvt_4cx8uyEdE_qIjET7mR9XpQrj-w&oe=6AEB3A1A"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xxe5N9kS-QQ7kNvwFXHrUU&_nc_oc=AdqNsn8YWbs0gGvE8VakEv0O6BnHZxQOoLaIaYKOCIj27FYZaFnwxG04etKIpT_7mgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStwRdA8e-nXzZPFkHDs6K1Bkf1Dyh2ucVLurwGN7xW2A&oe=6AEB4C6F"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmAjSflq_f8Q7kNvwF6L4WX&_nc_oc=AdrL_yWcbJCQJNR6bUuwUbXWhdH1cxi86hakP9wtNOFlbvxewSzo-VbUmfGt9GP4SR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY945h5M883xpRkjaqS_2brx6-7NMh60Pz5_acxtHP0g&oe=6AEB5D9D"}, {"file_name": "Portrait.png", "id": "973518925187618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618910_973518928520951_3852690785809695379_n.png?_nc_cat=10
PScEkjxbxJreB2CrE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZJcIgHEkMm9M2dhkrUS0j6x-X--DJwXpocGBwIBy8xg&oe=6B0B0F80"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu3x58o1EegQ7kNvwEKPHlU&_nc_oc=Adp_wxjSadVgXhbQgD01fQnfGLlkdBQ_agnhgi1Fj7HnAauqQQWiaMHiz7KHfm3Igfw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbzVPLCdDfH3JmPsU1HMZkNQCSUgaKXb-SQU8c2ITWXQ&oe=6B0B386F"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbEJ-qjPX-UQ7kNvwE1C_MC&_nc_oc=AdrH6SoMootlIfa31tZ58S1byI4MM9aXSGBVmnqDP8cO0YXJuWqocKbjMPryfRUk3b4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSe69tKvnyQCYx5LomKFiTw8VgadAuveezIY9NZBDGKkA&oe=6B0B1DEA"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUa9DkosuZwQ7kNvwE-dXDS&_nc_oc=AdqGpTCdhSve7iMc5HUERCF2RLdBfp5oEGDfNU2na9GwWXe45nxjv7O_NCjZ0d1h7ho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSq0NrTYTbcfcfZZgvFNWIOjixmi15E1CxGGXJ6sykjHw&oe=6B0B1C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWRK7Cjf0iYQ7kNvwFH6T24&_nc_oc=Adq3PVsAsfjqGbf6GimIwHRrivDVDGEpID9LHpzmI1O-ShFO5xHOhWS2HS_ERI252mM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTmpW3IaEfaqCc9HkQ_tsUaeOd5IFU80BVhfuYzVv9GQ&oe=6B0B2A55"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
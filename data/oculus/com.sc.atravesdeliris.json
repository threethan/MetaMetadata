nt-sea5-1.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU1_CAeH1aIQ7kNvwEToqJE&_nc_oc=AdqK_1l5n2D26aEB5baco0A8wtuj7VEfnlIfW-tpgwrY6YEGB0uJ__pNYupcqoCfWzk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0gRx5f7EM60GtV1cp1V_4F02PQmp6p6bJZxfifCaQZg&oe=6AFF0729"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBwpmiU-8uQQ7kNvwHDMe6p&_nc_oc=AdobdaGdR4oL3nfOjZRIDryBlV_wDxc129cYNLWLd2GGwEPor12y5s1DkB9CdPawDdo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2HGmM_aYyekiFHV5qfayAWHhUAuuZwHoIYYXbHCvFZw&oe=6AFF2E2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39PQGTedpeYQ7kNvwFsTIhn&_nc_oc=AdqVrC3jfKiosIaHY1mxjPp9F7_7Qf3ygDnkL6c2RviYz_oVERi3Mm5Rmy0VBfgnZzM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk67sR6iXNV3OjoGZYKznYLqV6mE-H9lpvRY9EJZ-U_A&oe=6AFF2345"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unqrKirrel0Q7kNvwE2f85V&_nc_oc=AdpvjZMpvaBOvuXBRoKL1c573_mwlqyXOMKPhIR8YXy31RsRi0C_IkZFEe7aoWONqEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRb9VFTX6TsQJ-KqlMkB7OT0wqEDU6lU2w2gCH-hpJFA&oe=6AFF009A"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xscyY4Blj-IQ7kNvwH0HTwJ&_nc_oc=AdrAzJ159WKv1lD5IXcB9EjM27zqHhFGnMe4cQoEF8hH8aZSulBh3EEX_BZvoqdn4_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSDWah8z1Da7Ck0vRcAX8O9ZvtUNIztuejdHonWa383g&oe=6AFF12EF"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9qnJlxvikAQ7kNvwEU7UKU&_nc_oc=Adp_qS0utBuJnLBa3bjODu64DRam9bzqhdCuMq2B2CnlVSuk
glIgpnJL57n1BLCc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQihTczcVUgDrco00RZuo4lFLbnQVEOqCdisS59aBq8Gw&oe=6B01D500"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B7hduVu_vEQ7kNvwFfUReV&_nc_oc=Adoza9NLzPzB--rS9_fZfOdk0DdKBSjP9IATL8GXOeZV2YTuRbEnR8SScXZ21ythnvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI-LFUkaflfddiWRX-OUkzlfHjbq6mKdvOgyLjXekimw&oe=6B01C5AF"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC1cAUeMBskQ7kNvwHkF9Du&_nc_oc=Adq1dqpagQ0Ri0tiuv4GJgudvnUY_PooDR2yRw908OOA2yxgtlXzdmgW9B_fQzLfOl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHP1MRSzSEf7JFT_s0K4ydUnkxkWb1FCAttUKyop7V3A&oe=6B01E36A"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SubsdiS7Bd8Q7kNvwEPlsoR&_nc_oc=AdoSW6YotW_4PKH3B5yR3Mu6PfVHR9SGJqliJ92EwLSWKwyBGa6qyUhxOY5IlL4cMzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFtb_K1fZa9UP9HjS7e03Alr5s4YD4Nb3cGTDRtW7k-w&oe=6B01E1AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3CLid8StwUQ7kNvwFrWB60&_nc_oc=AdpooqBbloSA95_5BHhpYtP71lH6M4mrHBtuCp9zYzcS1hwgUCGegRIqk6-wluO_lQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-P1JD5ifXqr2LHIEYdqyOhQhPd744Dbtxtz34wzufBw&oe=6B01B795"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
nt-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uF8dk2EnerUQ7kNvwHcOqq9&_nc_oc=AdpLnalqyji4-_0cHL5UgsKdcN9c-QQOgH1dajcGi3RbOfBTT8uMeQ5n0w1keYAJVso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-WZZWPkngalb87IfyWwujCHBQZ8KAYNoqfJ3kjVBRNQ&oe=6B048569"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeunRO4H31gQ7kNvwFwTHvk&_nc_oc=AdqOLvY_yqL2CPZPMeG0DruyKQuleTbHSJVZb3nOE0RurJnvDgQAiyukUmkDbU7w_Uk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ_l-A8GqKUXSrh9qpZMEJ07hUikywqAJnF8k1DbNYkQ&oe=6B04742D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BtYy-dW97YQ7kNvwEL7O_4&_nc_oc=AdoDrMpewla4hGhGrL1d-B22m2Q2BE5YlCBMSCiE0fPXVI2gU1o6On5UG3WgeikmYGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnY2V9LxNZ7gXTVoKrAs7oNOSk4vQrKFVfv5nDtH64_Q&oe=6B046945"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs1B0wo82JoQ7kNvwFhbuur&_nc_oc=Adr9AktLi6sjR-BHxr49lN-aElnFCFe_ArlrcoWCgoOQ8961ai4-xwvNuREvCoZQCd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM9NBvJZwspMAZ9DYf1fmZZanu_CzJgVdCu3Yh41vEqw&oe=6B047EDA"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG3O59unrJIQ7kNvwHil_zO&_nc_oc=AdpmZreLZ4EMSgkcWXZ1t9zwTRf3aWxE8NQKM_d1sE4CzCbNOSLMlbntr03Bs6ltPjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-saXELcEpbbdNpYQFS8cOiAkSygcpH6pbSf-ssbIzVw&oe=6B0458EF"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc0_RoxrY74Q7kNvwEZoREs&_nc_oc=AdruczdWLI5kImushEaR0Gbrpg4i7Fl7T2rSS49-8l5k_TvT
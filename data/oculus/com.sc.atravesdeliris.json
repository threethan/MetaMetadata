nt-dfw5-3.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2oLTXTmIxYQ7kNvwFBv2Xm&_nc_oc=Adpp4mAsva_ac5XdHGombs6LJM97bM3A_P5Ym3vIJ7M0ZtUW9XOqUqVt8jD248zGr6s&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA0sg_p6ag_17v2G3i0ZtGMUsv1Q7OUm6qLFAcC0tfww&oe=6B0841A9"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXM7kvE7dp4Q7kNvwHDz--4&_nc_oc=Adpj2gkaAgHd4OygGGVis6jqUltnQglXqeXnIACUZq1iWHO7gOAqYZu1GZWWHYE192o&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtEEmjPeEVqFl40rG8z-zECjs02iMpAzWlRGcFvE-L0Q&oe=6B0868AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51Q6ooolKigQ7kNvwE-4tXC&_nc_oc=AdqZ3Vl_d_eT89IACBKfCh48IgCPFM7kpDaF-VU9v-jJeQbZrgm6xg5JLekuc6PiRFc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf09sz28DMs81Tcx4hmEN2znFJXMZaiHrdIuCPi4VgOg&oe=6B085DC5"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfoIdpnBKpcQ7kNvwFkUKc-&_nc_oc=AdrfzmWaRHtR6Sy6J5nYNYI-lDWYy13aF4T8YuwYNPWklvGHQqSA-oTAogePaUV_T-I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1VfZCr12EtY8Q29tSXr6YZu4gh8gphBvlAexp9hmV2Q&oe=6B083B1A"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evNuabvGrO8Q7kNvwGaBOSG&_nc_oc=Adqk6WBch8e7rWK0WF4_Ji8E5ApqjVF1VpxhLUuRnRs2Mdj8Nt8VEoj-b6U9GXEPgAs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUedfT1Z-55Figwj66JpssgPIKB4JoeS7OYtmE26UYDA&oe=6B084D6F"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn3lwb4Fi-MQ7kNvwHqkZVP&_nc_oc=AdpSrM7NrQsFH8QkNnwJrLahD8mQvzsfNfOkf8CTIPO_LRIT
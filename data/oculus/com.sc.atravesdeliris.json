3zc__aOU9pMsLEttSCmPY_g3RCXadpqENOlAFay0XUqzkBN9XdCDD-y1Hs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPO4j-IoSMJrxWgmaakWOudI9Zb9jb4FXf5m0qSbgw9A&oe=6AFB2E2F"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiRaJlosdnUQ7kNvwEi4Hv9&_nc_oc=Adqj_NACkE1Y-bjKz0xxo8SsSKBEhFGTZdaiJ9lAbnTziXPa4wlUj7HEOIf2RuTC0Ao&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmu4ypDIG70kAffHX6ARLYFDLJfcLzR1lkLcDAz-FaYw&oe=6AFB4BEA"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Qqz-csn4EgQ7kNvwFP86pC&_nc_oc=AdpVAnlgsY67HP-k5o5534qzHmNxklgYjWLJqMpXPGNGquuAZLy6FnPOJsxA8OjIq-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKDiVQeqShDFM0w21gE8RNXNQW5W_mXsD9D8a35Ucxcg&oe=6AFB4A2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NviEXp5Gp6UQ7kNvwHxDvGx&_nc_oc=Adp4N5ANezCvWnfzBQ8C3edTJe37L1vNfDNOs1It_6ig5Wb1Fv4hWM8TgSYqptCG7EY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD5BC3OZpSolJpShByJuY4-IjnzhQRE3oYYtiF76WNpw&oe=6AFB2015"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25805899522440235"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1625212319396376"}, {"status": "PUBLISHED", "id": "1684770942709413"}]}, "baseline_offer": {"id": "1684770942709413
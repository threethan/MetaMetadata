nt-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lm0WrnqTkR0Q7kNvwEpwhua&_nc_oc=AdoOWRxNSxVHXHZOeMV_hCTpbUWIvWuIHw9eparML3AvYU_LebwAx5wFrRfkgJuHqik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyn9-FEDTnsbwZG9znHX3A4y0duepnU-In713qRE1AmA&oe=6B0058A9"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjoS67NuWu4Q7kNvwFXBu9l&_nc_oc=AdoxQxSYxXcnAEO_MfiVTV-_ETbQQ9O_kIhVUqBaJm1g_lnf11fokR5z7DdQBtn0dI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR50vJ2W4noJjyK5E0EVD5CWwaXktLeyiZ8qD1z_tMm-g&oe=6B007FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39PQGTedpeYQ7kNvwGkHs8U&_nc_oc=Adro3VwIYXx9ngpKUS4SaekGxRub_QlHip2yPVXjlxPmaBvgcuAqarI-2H7q6Ir0N4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN_SrIzJNJmICQkTu-3Fj7jCkB1Bm6KbjbsVHUCX1c9A&oe=6B0074C5"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unqrKirrel0Q7kNvwFTmuQK&_nc_oc=AdrtkOSiFW0cgvl5jSw7NoQCDj2PdoCY4KrkYJczTtb_UsTyw_XFwMOnVI3y780PTRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqqHAJPXKIvPRcjXavrl775zeV6K5lx7RiV_f9d3WluA&oe=6B00521A"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xscyY4Blj-IQ7kNvwElJoos&_nc_oc=AdomrcPqkNUZVsWSZWZhtxboY0xJxvb5Z7kwcsvtXP8qiaYucxbWX9WR-AfjzLMCOIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsujPubOKbXXuvcskdT3AOs8cnSB8v6IskYlVH1Bvhbg&oe=6B00646F"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9qnJlxvikAQ7kNvwHCt5La&_nc_oc=Adp7XxUP_rI-3zwAgIViaGaT6M6l9glGiMbFP2Eeba5ZLiI-
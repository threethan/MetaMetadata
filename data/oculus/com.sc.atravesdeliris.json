4gWy_S0TsPBI3DIxk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6_ge6DTAubYYJMUWRNTx001_YUDfbHovoeE276bRkXQ&oe=6AFF3200"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITBrTf18mFwQ7kNvwEkupyI&_nc_oc=AdpSRQ2USHP-TtaxmXTJa7947Xgk0_KfusjIxmO3WzEBj8DsH9DsaaTQacT8jAUe5cI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUEEd6cZZp6xYZOrgB3F8subYYZUcHHEPzixrOJZ2-bA&oe=6AFF22AF"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Biih6YJ0PXgQ7kNvwHpWrXn&_nc_oc=Adp3XNDgMYsLUZQlqyhMfoGqcKNnIq-kZu6Xnbpui16UMxfwGK2ZE-XWmZ42OLVIij0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZskOdHmm7--3Dd0HVRbhT_xhVM85D46rfsNqD2W1Sgw&oe=6AFF082A"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SubsdiS7Bd8Q7kNvwGrCk55&_nc_oc=AdrVxSPIneYF75ET1CgO3joPQzZRTb5-2yS8M99Fel52rAckWqAMRiMARYTlR3OuAi8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRht1JDPze4oJuZ4UbHUTr901np6YD26jMEtrleugXTzQ&oe=6AFF066D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3CLid8StwUQ7kNvwHVtutt&_nc_oc=AdqHfUAoCxT6SyZOb7iOH1YPRmoNjxuQ9wlMObYHvjI6AOJlc26uBmhdpy8btrxaaxY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXiYv1PqLyrF0ZdUXH6IptQ_C_Emmt6xfynNHt-v15cg&oe=6AFF1495"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
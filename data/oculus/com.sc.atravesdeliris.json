0Yp_wEsz1V8nQZbA4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsEtiDPGmov7gBWQQySI3THT-9yiMSNO1KOpghf3tSJA&oe=6B032680"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B7hduVu_vEQ7kNvwGE5UZD&_nc_oc=Adq02oOg9UbjaNJr7LuatUbMDHTDxKnnmA1Li-NE43dnLv-MZMw0jMFXfXmmoEEn_Q4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0p5PfHuDnhKn0a2pgtGhH0ioLe1ED4RrKobvSgJ1dlg&oe=6B03172F"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC1cAUeMBskQ7kNvwEG7eWn&_nc_oc=AdrkvHtySKEAgaK3Wz1Iopj8FABMKA6QNl00ayeZTgOc4lzFpjo20AedpOtwo-GPwG8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsUVPnBptmZmZEnjmvtWmuQsx1oBXOEnY21VXX0ZzW0A&oe=6B0334EA"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzyZ24wST5gQ7kNvwG1e1Ng&_nc_oc=AdoZNv2raWXx_js1QaZ4491qUhXXyd27ln1U7sirw8RtYBzru32bhK8LpURSaPlwUsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5Lz2295896D7hlqfVUnm9kMa1OHV1yflJUm9oqbWTnA&oe=6B03332D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QhJJcSeSrIQ7kNvwFKEJIC&_nc_oc=Adq_X5p3n8ubruVsuZV26q3BTFnWY1xyD09RvqVJyk-jvbi_66xQS6z3Bv1263LelwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdQbRcUMiwuhDVTDlzoVXcE70DwiK2ta1thlVgkoq_Vg&oe=6B030915"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
n7btEcvxtvkMlJTvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkp-1I72uHLTqbmAs2FdwFYLz0rmbwVDIgDhQgs4l2rA&oe=6B047800"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5l8KpaMgoMQ7kNvwGY8dhA&_nc_oc=Adq5m3HnIIFHEN8g-mh5ybai79Fm98iaJQ28Ju8kzQneZtkHz7t9Xbl02_z9FKPwOyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdE_6b8rxCm0UXTUuMJg2lG4tkTDeBdqnQxDhdePPvMA&oe=6B0468AF"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC1cAUeMBskQ7kNvwEb6EAE&_nc_oc=AdpKUaz-2fUBdK0ONMH_qHRaXQr4p94H0MruWijpQwzGWB1OvW5PO9oZT5Ja5yLecBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpvB5DlHRjOnclmCCP4PInYIWQrZdtgm7hYIeW89nh-Q&oe=6B04866A"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzyZ24wST5gQ7kNvwFg4SPh&_nc_oc=AdrgsHfvgogqXA_wD55W_Qm8U004pRqe7faUcvdKahM9y5AVJsy2_Nb_jUOZnmVwYPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjKVeI35HUguZ1lqdmoA_l0IeOpsnE3u8EkdOe3dx6bw&oe=6B0484AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QhJJcSeSrIQ7kNvwHmYlle&_nc_oc=AdoekoUiYXkMxx1DT74BNHdEAzR3GuY9QVUFewmjNQ2bw4QXfur9YmhXoR-oyC1GvBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREpfwitawtpTnAfYe1sFInGcOH7J8OqZsXh1CZ7rMCkQ&oe=6B045A95"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
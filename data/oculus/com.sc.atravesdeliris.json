nt-atl3-2.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2oLTXTmIxYQ7kNvwEPqTG5&_nc_oc=AdqU91NQfhU7XejVKe22c7I3QscSOt2PYA5DrK2v77el7ZjPYRpOaR5BFY0kJAJo9ow&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpUGo0_aXjmi3gjLb-JKV0IOg3RmYWsiybnlbJW59gHA&oe=6B0B1CE9"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXmsR1gEJjoQ7kNvwHG4FTJ&_nc_oc=AdqFc8vWa8DXjowGJBYGwJNjxUgyeAXjgOTg8vz6eL7Td-iVjPZDy5nZWXecC3kU1pI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQarxAWElLb42qEO3p4_ImxEYlB3Kiwf2fSllNWbNy5Pw&oe=6B0B43ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q59WTKBwsIUQ7kNvwGDuBCs&_nc_oc=AdrbsZBKkpnas3ZKE0Rx6YaMaa3XSOqR29o1ZcUxLLdt5JslJWMq_AD50Sle97uA-_8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRiwys1b2zn9wGgWnr8kKsVSaKDVlMtiMj9ofmR0Un1g&oe=6B0B3905"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6royWIs7c9YQ7kNvwFSJnsj&_nc_oc=Adq9gIL301uyPswZ_knNS8TZAMhJOi6wwkm6bCmQEDaGBZ782tz95W6V63pZ0PkaxFA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTYE61WoIGKNCO8a5fkEHr-WJa2qmW1R0JYhUFeVTX4w&oe=6B0B165A"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5sAqYYDuAUQ7kNvwEa0vGx&_nc_oc=Adr4TGrLqVLJtT4IUR50W3bKoW57vlrKpvYKpF0gMTaQCNwwbvPnIk2AXnzj6uIbuME&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRePBcks2GTViwNSnEEnKY6XQiv486Owt2MZ8IXl6fr2Q&oe=6B0B28AF"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIsJ8ADsrWYQ7kNvwGqnxye&_nc_oc=AdqYNGUyNFVOPt2uCK_nzo-KjwoH86NFuDh9nyQc1FjvuSxN
nt-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lm0WrnqTkR0Q7kNvwEmYntA&_nc_oc=AdoN2GlXCgdOVu3jlD5GwrR5W4OlUAhMDMfLjuqtdWiIBHimyK4jaGHd1FenRvXxeOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSokcnKQBZNY8JN13v9ZcLphXTzuxg3mXhKqiu8oTkXiw&oe=6B0333E9"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjoS67NuWu4Q7kNvwEpT92I&_nc_oc=AdojRj_D7uQ6nytq3Dpfb6reiZlUrJRKsqQGHW8H347KnZbXpH5JtR87lUnF1YRaMhw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMMtiA-Gu0obOT3CY-h0XgliDOD9vNQKfiNk-7BEX2vA&oe=6B0322AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BtYy-dW97YQ7kNvwFT302g&_nc_oc=AdpMFLejZCcFV75csq3zg-0t9QkHYJHeK3lPpl4vSmFYGRHP3N2rdUAV2AayzfPUZG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKOM1fyeq_sHZsF5buROGAmWZD-k30lXDqk7Bo-HhDNw&oe=6B0317C5"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs1B0wo82JoQ7kNvwFM96hz&_nc_oc=Adp-rLT-lqCLtt6ebzwuiTjWQf8XfZoPh2QbCcYHXvRCT8ZQI583ySYA1rEfuNWzLRo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrQUSh2vWyLM-Gs7uNEpaW6QPOKqkUlXdyQ-RP9vB5EQ&oe=6B032D5A"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG3O59unrJIQ7kNvwHWKqDR&_nc_oc=Adq4OTMylkvIgOKbJLQFl1Y_ENDmy6xecTkMoDcYetv9IfLnjx9vbQNyQ1mvbWkqSLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFHBTaqABwZiF6Awwj7kYdAecRL8ODiA3pd9VznZdLCg&oe=6B03076F"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc0_RoxrY74Q7kNvwGMKRsY&_nc_oc=AdqKibsSjK6PuSuS8ukIjvCJ9pPvB47VFTgc9PDqSegpv9l2
nt-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVyJMQtmBwYQ7kNvwGlbayo&_nc_oc=AdrlVVrdhwSk1trV7VjMYMOF6aGAnUUzLQkudFHoTenT7ZBdGR2Zuz4OqN2ctSyJJUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsIThJBNk3BryD8QmsQmlqeIYhx57JLOnzGLFAr4C0jA&oe=6B0C6E69"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXmsR1gEJjoQ7kNvwFEPtAp&_nc_oc=Ador8ziTkoU74H1iMQd-wXV-24sG83GOUtZG-mpiVY7R9NJoHIAXKpkwZxOQU5DBzN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlcfsNBpXV0Ri12Z0K8LC2p56-OGhS4w0HznZ-awWI8g&oe=6B0C5D2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kah018vnslsQ7kNvwGK-mEG&_nc_oc=AdrN0KGy7TGbF-2_mRLS2BuzcCeB6Gbo-uqdzV29nP4pYCXiTbhRCZnyqKMm5xNeZzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLYV6ZXFJx-WmZHPbsCF4BCTFCI4Ys_mZofgPWpD3Pwg&oe=6B0C5245"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6royWIs7c9YQ7kNvwEaE66p&_nc_oc=AdpmN27c9QHHWpqmx8dz00S3tOmlP-1vKJ7xMmty0D21dT3YBgUzkjX4TxXwxZ5j1eM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQOLd9ZAxUGYU7femXr9sJd-ZMYk29gqcg2_WpBmhvFAA&oe=6B0C67DA"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5sAqYYDuAUQ7kNvwFm7D5_&_nc_oc=AdrMmHsKCMvy6Hrx8MxohWDSfp4EM86hfBpK2ZbPC5swfLpBXDsxr5cTvh459N2gPxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnuj6pvzVSo2FEZRfD4wmidU3PdO-CbH4PLxu7GgWJNQ&oe=6B0C7A2F"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIsJ8ADsrWYQ7kNvwFPji3a&_nc_oc=Adp0JYymBwuEl5COxikrSfIUjXKSxqVzM-WlfV4iu1DAaG-4
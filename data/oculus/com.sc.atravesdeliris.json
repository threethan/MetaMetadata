G5kwys3v0DjfG4wUo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM1R7g96KB-zy80VDkv7-aQ8Q7-yBYSOM8VgUvdfI0wQ&oe=6B086C80"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu3x58o1EegQ7kNvwGYwqEJ&_nc_oc=Adoucw9Sjytmf7OHR1r3_zJkY8UHe7_dl6Sj6Zg6bJJ26ZrnyMLqA6RvIV4NzBbgFCw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdd_koICQI8p_xp6-bvWp1r_o_WlCvmZri9M38_c-gLA&oe=6B085D2F"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT1y_Av9svcQ7kNvwFyXSC7&_nc_oc=AdoRZNlQJZAGT1Dt1y5pye_BIeTbmmaXvNG_5L03xMe6Z4fQgA9VnG3NUlpRxDVdQ9Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDQrKlNEP4Nm-RH1F6PdZMVFuULLj7xg_ETvHT3mzGWA&oe=6B0842AA"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVQxBeT5byYQ7kNvwHp59Vm&_nc_oc=AdpD6l5mENVydcq1ZDhAFPkMSJ5bk7VbOriBIcoeehlAJ-jot-0jKDIKy3x_b5Mb_Hc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGr6_owWP2M6ZcOdNGgbG-Q5p2Z6_bOQxEKKsq2O74SA&oe=6B0840ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uveUMHX7-4YQ7kNvwGxDKNr&_nc_oc=AdoV-Zf2ITw0exsiBaDGZdmGImMy9HDwp1bq-ghNqq1uHkpVykgxmm9AWgx4A-4cg6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-0fb0kVajjc-Qyfsus4iguVG2KGGDIcODZcAuTWeARw&oe=6B084F15"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
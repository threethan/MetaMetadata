EhTbhKHf0_9tAEMn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRp4yos4uINoKQBgw2iVZO3zgLYVjCvAI-JQGP4tk2IHw&oe=6B0C6100"}, {"file_name": "Screenshot 3.png", "id": "3869248009872782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_3869248013206115_1602114415536352824_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9Hgtrxr318Q7kNvwH4dRfp&_nc_oc=Adpmh2TxuqvkEeAbqnvqp9vziljFCNca8VdwF5BtQhf8gyWVD2ZSb8Q4R3trK_E1pNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNAKQII3RdvMXKzyDsyqp_7oj0OgWT8qjgbK5Ea1l63w&oe=6B0C51AF"}, {"file_name": "Screenshot 4.png", "id": "928540146741964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_928540153408630_877853015018159315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbEJ-qjPX-UQ7kNvwEXydVm&_nc_oc=AdoGm599BPdfPHxJnCTABDIdgLMgdEvgOslZfYm4eSkfCam7GIl5PEKgyI3C96J7FVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGMYi67W0FySY_qoxRctHVRlSfK1D8BC6GjhhNEXc-pw&oe=6B0C6F6A"}, {"file_name": "Screenshot 5.png", "id": "961765816584247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_961765819917580_6045476221473346880_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUa9DkosuZwQ7kNvwHFNjzL&_nc_oc=AdqldJRJ962p2xeZdTi1BoiD7IGWAzzrxGSxQIc6pS5QKU0p1yjiImEBhU4tjFL9Nvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6bBRBH-KJPVuhDn8xDCA-6OmUpcpUWKHA9sy5TB21YA&oe=6B0C6DAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "1491320075997949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_1491320079331282_3811728051085953309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWRK7Cjf0iYQ7kNvwETtEfg&_nc_oc=AdqNZWhdLpTXaLesd_7NqSC0lfkbs41lOVNIRZ3tynH_e_M1zUmCdDwALbBkjaQ4Po8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4NEXIxpY6Z_svaroA44iqgv0ocMQepnFLJLWaUDmfaw&oe=6B0C7BD5"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrative", "Storytelling", "Exploration", "Personal", "Psychological"], "long_description": "Relive your memories and discover how you\u2019ve changed.\n\nA Trav\u00e9s del Iris is a narrative experiencethat explores memory, identity, and emotional introspection through color, environmental storytelling, and interaction.\n\nSet inside an intimate personal space, players uncover fragments of story by engaging with everyday objects, subtle visual cues, and shifting atmospheres. Rather than relying on fast-paced action, the experience invites slow discovery, observation, and interpretation. The environment evolves with every interaction, transforming the way the player perceives the space.\n\nClosing your eyes with \"Blink- to Think\" triggers  reflection moments and subtle narrative transitions, making stillness part of the progression. \n\nA game by Sebastian Carrasco.\n", "short_description": "A narrative VR experience where memory, identity, and color shape an intimate journey of reflection, interaction, and emotional discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.softwareandcreativity.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sebastian Carrasco", "support_website_url": null, "website_url": "https://www.softwareandcreativity.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX"
nt-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVyJMQtmBwYQ7kNvwHawxma&_nc_oc=AdoDy1b4hgaII_iu-Z8FZoVITrtSwrnyVnlgFTwhC4hvBJBifrNgHPrbaeRKPntv2vM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFZExqEahgva5xU6fZ3UdW139ikh6XAyi5c0IB9ZfCnA&oe=6B0F1169"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wloD7syaJ_EQ7kNvwGms8DF&_nc_oc=Adq9ZM-FySH556TN-AqmoFz5d0jWOmPOCU7p83-0eULg2Lius8YMNv9CjrgMyC-Rwno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_TiMSiDc_djpmlawx11B7fwAEygZ-m1_XqmLvzFZxbw&oe=6B0F002D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kah018vnslsQ7kNvwGw0hBj&_nc_oc=AdoYmo5GwJeHQcR7z_J1Esu7FU_pciXhv0Lix7VJYv8UYuYUnNzxnPt6bS63p6hfqoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUNuzn8WpQeVJr2TC0WHG28v2-bZdQay4qojcEEw5xcw&oe=6B0EF545"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-_2ByAyOtIQ7kNvwGX8ZOM&_nc_oc=AdobIb6yRyXZyudOVp6nKN2CM1NQBeoNigitQ87xGh5n-1IkKGGym1kv-alXMdLYFl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhCMnl7iCGU6FksLuX5xMssuYCa2lzLX40y97nMsJNLg&oe=6B0F0ADA"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS5Mg-x8rukQ7kNvwEf4t_z&_nc_oc=AdpZZwJlSL5LfD8oefUR54C2KPQHlwc7iVb9TDXCw_fxmmVmMEr7EXqdKfEcU9v0qSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfW-c6mqHHi6yOQfwZdLGfiph0n2KNX6p-izlN9MmhjA&oe=6B0F1D2F"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbdxfEnH5CUQ7kNvwFFKfy6&_nc_oc=Adqtz_gcQ8l_3nN9rZ9S8cJThtQUHP-1TSXdKEz3ww1BpQD-
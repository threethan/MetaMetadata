nt-sea5-1.oculuscdn.com/v/t64.5771-25/499617762_2247542556085231_4624220947461989850_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2oLTXTmIxYQ7kNvwH5CwZ0&_nc_oc=AdpOTut_Bf_-GiPCEKBqoOzUxNQfjWn3xtyfDTiLrAunPTd5l00cLdOVZGb18nXCnNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDX3J5o7iDcnKV1TZW1g1YF5XBgW85JIav9RgEmL_Baw&oe=6B09CB69"}, {"file_name": "Screenshot 5.png", "id": "1294051438960511", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619751_1294051442293844_8154713239817790874_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXM7kvE7dp4Q7kNvwFPbAsE&_nc_oc=Adq6Xnt8kg-SoFKEKOHKJlNu2_3Ing0Zy1qAr_GpLQMBf5PZV7K0pL0Mhemvibf5VtA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6_ccLvQ9PYh-2HQWDDPS8G7oWslisGn-frDNxU2L6Gw&oe=6B09BA2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "965261262669942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_965261266003275_4119045274853098971_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q59WTKBwsIUQ7kNvwH_48di&_nc_oc=AdoWsE5V5_j1D6Wl7cs5FmMvXrrY9-pGTZYUVM7nSfWAmc4iadYhDJtjp2qahJI0JoE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-1dYyguooVQkCw5zjS0tlhYesE1wCS7A5vLd210-sAQ&oe=6B09AF45"}, "display_name": "A Trav\u00e9s del Iris", "keywords": ["Narrativa", "Exploraci\u00f3n", "Memoria", "Aventura", "Personal"], "long_description": "Revive tus recuerdos y descubre que cambi\u00f3 en ti.\n\nA trav\u00e9s del Iris es una experiencia narrativa que explora la memoria, la identidad y la introspecci\u00f3n emocional a trav\u00e9s del color, la narraci\u00f3n ambiental y la interacci\u00f3n.\n\nEn un espacio personal e \u00edntimo, los jugadores descubren fragmentos de la historia al interactuar con objetos cotidianos, sutiles pistas visuales y atm\u00f3sferas cambiantes. En lugar de basarse en una acci\u00f3n trepidante, la experiencia invita al descubrimiento pausado, la observaci\u00f3n y la interpretaci\u00f3n. El entorno evoluciona con cada interacci\u00f3n, transformando la forma en que el jugador percibe el espacio.\n\nCerrar los ojos con \"Blink-to-Think\" desencadena momentos de reflexi\u00f3n y sutiles transiciones narrativas, haciendo que la quietud forme parte de la progresi\u00f3n. \n\nUn juego de Sebastian Carrasco.", "short_description": "Una experiencia narrativa en VR donde la memoria, la identidad y el color construyen un viaje \u00edntimo de reflexi\u00f3n, interacci\u00f3n y descubrimiento emocional."}, {"images": {"nodes": [{"file_name": "Game Icon.png", "id": "1607505360556230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673625994_1607505367222896_1574350596834126161_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6royWIs7c9YQ7kNvwHuCuhA&_nc_oc=AdpfxOu4Tst9ozC6ZkIYWRlHgL4YVSuJn119IOWL_TbfpyC91VHLYUV_20-dWCDIUZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCcmT5z_CptWZGN6LqFH2SA9eMpDeOT7zs6S8eWoqP9g&oe=6B09C4DA"}, {"file_name": "Landscape.png", "id": "1459118102347778", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_1459118105681111_1176602155369088893_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evNuabvGrO8Q7kNvwHMk7k3&_nc_oc=AdqZRNdwSQ9eRFrzzMDGVsKMcM2xBCHycsbreKzY0NMfkmMbmvDWEEQEwjPySevEVEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIt3U67JI8O5KDSw1qkCYmgpwPouX6FuzhnQ81sGiOUw&oe=6B099EEF"}, {"file_name": "Hero Cover.png", "id": "1327050222649759", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298137_1327050225983092_2181195551602462942_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIsJ8ADsrWYQ7kNvwEQVffR&_nc_oc=AdqEnvOKvmTpCplTOQprTtmfqGz0-ct-8uRBJe8TSeqgptJN
i": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618264_2297872447299859_7952081742571568939_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWxZe2beCsEQ7kNvwGyzuwh&_nc_oc=AdqQ5h1Lfv_2ZhMAQm5Ym7M18inJ-LsH9ZXhuk_Opg8J8V-u82Yiwl731d4hyPxH9K8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeQZL8wUdSC6hQTB5cHcaiNBxTX4A-WcD0ALzcz722lw&oe=6AAE8115"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_08_26.Still002.png", "id": "614277468214615", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619113_614277471547948_2500430941839585821_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dChyZ7TbVeUQ7kNvwF53ENj&_nc_oc=AdoQTVLL5D-1y352MbrbvLwfzecvK6JUpkYkIExVKB5yQNgHdA-zB_JwBAKtgQhuFgk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0gICC06af6bd5vohqieE3XaVl1HQxLENp-84hCX03yA&oe=6AAE7D08"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_15_31.Still001.png", "id": "1280732216839771", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499309594_1280732220173104_8343935985165146168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezdbE4uG3o8Q7kNvwGcIv1q&_nc_oc=Adpc1VFZREHGJpsOXKrIwuTur_9S05xZLjboWAtvUMmxagq-JJWONvbEbL9yiUOukj0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTRrhXf8hHUYQxVX_iDTcHjoimiavuFubsf9dvB_SjYw&oe=6AAEA43C"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_05_00.Still003.png", "id": "1766710710652888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499297507_1766710713986221_1337569140629504933_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3CYHBKx8cAQ7kNvwEH-uLn&_nc_oc=Adr9cqt9H44LQQ18sYEordOEcEtAp4NtDGYlMGe6579FOwXWNPfXpvma7c2Wcq1KrWo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAT6eajUPtl0jHStDbxjZJjT2iH8UJu2kXV5IVb8_heg&oe=6AAE8328"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rapid Blood Transfusion", "keywords": ["Medvr", "Rapid", "Blood", "VR", "Transfusion"], "long_description": "Rapid Blood Transfusion is an immersive VR simulation built to train healthcare professionals in handling emergency transfusion procedures. The application provides a realistic clinical environment where learners can practice patient assessment, equipment preparation, and execution of rapid transfusion protocols under time-sensitive conditions. By engaging with interactive scenarios, users can strengthen their critical thinking, teamwork, and technical skills without patient risk. This simulation is designed for medical students, residents, nurses, and emergency care providers who want to refine their understanding of transfusion best practices. Whether used as a teaching tool, refresher, or assessment aid, Rapid Blood Transfusion supports competency-based learning and helps bridge the gap between theory and real-world practice.", "short_description": "Rapid Blood Transfusion is a VR medical training simulation designed to enhance clinical decision-making and procedural skills. Learners can practice identifying critical scenarios, preparing equipment, and performing rapid transfusion steps in an immersive, risk-free environment. Ideal for medical students, residents, and healthcare professionals aiming to build confidence and competence in emergency care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
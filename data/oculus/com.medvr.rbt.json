zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VWxoURfcnbcBa2d1zxTaM0nG298jTc7PL_iWX8mUyDA&oe=6A183615"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_08_26.Still002.png", "id": "614277468214615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_614277471547948_2500430941839585821_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGWeIHmcpBcQ7kNvwGXvYOL&_nc_oc=Ado8_RBSgmYH0Jfuj-E0I9laCsUFXdO0sv71nqTEaU-GL8RXLRRQYFP_EUrG4raLncA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZajIfxIY1hz9Fct9VNEy1AB70KScdVteRSWo59fsRAQ&oe=6A186A48"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_15_31.Still001.png", "id": "1280732216839771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499309594_1280732220173104_8343935985165146168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14d94QE0YQkQ7kNvwF2GDrl&_nc_oc=AdqPA-SkjYRi50kA7SCWpOpZ5Y2PktIb6HeRSxyzkVutYpwO9xytDbm1Ql5Q568Wj8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zVx5xPisx8REjD7JtMt7tQUP_BA7ERwAXCaJTOPF2kg&oe=6A18593C"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_05_00.Still003.png", "id": "1766710710652888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_1766710713986221_1337569140629504933_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mB9HWneezwQ7kNvwHhl7u4&_nc_oc=Adrnhc9VBMgBPWAV41C19yVgwCgPe3YLHFScvINo9VUFr_CmmTzPXXPQmiChNKn_ASo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IE8W2B-ongP6yY0XBC6ZTNrJe-2f9f6iT8zhIVaX6Lw&oe=6A183828"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rapid Blood Transfusion", "keywords": ["Medvr", "Rapid", "Blood", "VR", "Transfusion"], "long_description": "Rapid Blood Transfusion is an immersive VR simulation built to train healthcare professionals in handling emergency transfusion procedures. The application provides a realistic clinical environment where learners can practice patient assessment, equipment preparation, and execution of rapid transfusion protocols under time-sensitive conditions. By engaging with interactive scenarios, users can strengthen their critical thinking, teamwork, and technical skills without patient risk. This simulation is designed for medical students, residents, nurses, and emergency care providers who want to refine their understanding of transfusion best practices. Whether used as a teaching tool, refresher, or assessment aid, Rapid Blood Transfusion supports competency-based learning and helps bridge the gap between theory and real-world practice.", "short_description": "Rapid Blood Transfusion is a VR medical training simulation designed to enhance clinical decision-making and procedural skills. Learners can practice identifying critical scenarios, preparing equipment, and performing rapid transfusion steps in an immersive, risk-free environment. Ideal for medical students, residents, and healthcare professionals aiming to build confidence and competence in emergency care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "
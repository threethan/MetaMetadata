c=oTTVjBPhKzYQ7kNvwEltaKl&_nc_oc=Ado4l_J3cTxpDKMSfVMeFbDkr0P0UwOe0Il05MJPalcHKJPv5RAUrMli3UWcapgoOLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ELLQbbsUHYCiu4w4n83YPyBqunoiNcShgD68HPe5nIw&oe=69F88E08"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_15_31.Still001.png", "id": "1280732216839771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499309594_1280732220173104_8343935985165146168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4MTQIhXnJQQ7kNvwGSI52d&_nc_oc=AdqS-nwhy-QdX_HEcLLZqdEv80VtQi1yumWk4ErTNEKITFu40HgbLvKRsaQPsj_c2YM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3t-MhYLUu47s0KcoDQr3zPbPpgvPrO6yzoqer1oMD5RQ&oe=69F8B53C"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_05_00.Still003.png", "id": "1766710710652888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_1766710713986221_1337569140629504933_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfV-wfsu_fUQ7kNvwF58zdf&_nc_oc=Adqd3mEkWxSxLbZNatUJDrgwxEjgv816DDfXsYq3HTl4KNvPMWf6fyE5GuqvVFd95pU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29ZbhVf3pcjsyaNgHI_iL1KN4BGcEfbazO0sNDmJ0paA&oe=69F89428"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rapid Blood Transfusion", "keywords": ["Medvr", "Rapid", "Blood", "VR", "Transfusion"], "long_description": "Rapid Blood Transfusion is an immersive VR simulation built to train healthcare professionals in handling emergency transfusion procedures. The application provides a realistic clinical environment where learners can practice patient assessment, equipment preparation, and execution of rapid transfusion protocols under time-sensitive conditions. By engaging with interactive scenarios, users can strengthen their critical thinking, teamwork, and technical skills without patient risk. This simulation is designed for medical students, residents, nurses, and emergency care providers who want to refine their understanding of transfusion best practices. Whether used as a teaching tool, refresher, or assessment aid, Rapid Blood Transfusion supports competency-based learning and helps bridge the gap between theory and real-world practice.", "short_description": "Rapid Blood Transfusion is a VR medical training simulation designed to enhance clinical decision-making and procedural skills. Learners can practice identifying critical scenarios, preparing equipment, and performing rapid transfusion steps in an immersive, risk-free environment. Ideal for medical students, residents, and healthcare professionals aiming to build confidence and competence in emergency care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24678542285097901"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1944258303094716"}]}, "baseline_offer": {"id": "1944258303094716"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757069160, "status": "PUBLISHED", "id": "1944258303094716"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary",
c=oTTVjBPhKzYQ7kNvwH68nGI&_nc_oc=AdrORXAZHlPtzcdikVkZ1ybObMVOY_pFMfoJlZejIt5gr5A3xlRfb4hzkEDiGv-206U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18_vSGhlgUieaxLi3HStkt03Qx17ITHaJHp_wtaYQ7bQ&oe=69F73C88"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_15_31.Still001.png", "id": "1280732216839771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499309594_1280732220173104_8343935985165146168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4MTQIhXnJQQ7kNvwHRy1eg&_nc_oc=Adpo79FMRFxQYAXlHSp1qf8jqdvADRlJ3tYGESXJR7Q2w5i1PUBgxYT-SPFQZGhNWMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fmt66HPKljBV4G5jmdB1tiTncHYWQ5km4gnyDif_GqA&oe=69F763BC"}, {"file_name": "Med VR - Rapid blood transfusion.00_00_05_00.Still003.png", "id": "1766710710652888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_1766710713986221_1337569140629504933_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfV-wfsu_fUQ7kNvwHGsBxB&_nc_oc=AdpcHONqbGSzza0rUHWdrUeCMy1Y8uyOo4y5Qzxif4sOBjfBJG1Dx9rNdZAKJimfj_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UJIEiKDK4nvVH_ynvEJNtgBEGy8DEPIhD0VmQaCUeZA&oe=69F742A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rapid Blood Transfusion", "keywords": ["Medvr", "Rapid", "Blood", "VR", "Transfusion"], "long_description": "Rapid Blood Transfusion is an immersive VR simulation built to train healthcare professionals in handling emergency transfusion procedures. The application provides a realistic clinical environment where learners can practice patient assessment, equipment preparation, and execution of rapid transfusion protocols under time-sensitive conditions. By engaging with interactive scenarios, users can strengthen their critical thinking, teamwork, and technical skills without patient risk. This simulation is designed for medical students, residents, nurses, and emergency care providers who want to refine their understanding of transfusion best practices. Whether used as a teaching tool, refresher, or assessment aid, Rapid Blood Transfusion supports competency-based learning and helps bridge the gap between theory and real-world practice.", "short_description": "Rapid Blood Transfusion is a VR medical training simulation designed to enhance clinical decision-making and procedural skills. Learners can practice identifying critical scenarios, preparing equipment, and performing rapid transfusion steps in an immersive, risk-free environment. Ideal for medical students, residents, and healthcare professionals aiming to build confidence and competence in emergency care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24678542285097901"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1944258303094716"}]}, "baseline_offer": {"id": "1944258303094716"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757069160, "status": "PUBLISHED", "id": "1944258303094716"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary",
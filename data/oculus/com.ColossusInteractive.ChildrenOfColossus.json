2974813303209984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmLZ1RSDqLoQ7kNvwHgw00-&_nc_oc=AdoozCT8BHw_pX2Flor9a_jckr45VKq9rVyVYJ8EvnU6Rof7fC3ae-Lv_ismVdXLdns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHai0l-738ZMBUIeTLHK781i3zNQOYkresfKkUUOamRA&oe=6B1059AA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUty32L5lS0Q7kNvwGBIuWG&_nc_oc=AdrcsY8kv6KFRjlwNFA8qlpFenypV-9OF86eg1nPAGi0yeJfx5MvHPsAAt1tIsa_dk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSFljM46EBzLm8fmHpsZq4ECDu1Jfnu3U0n4kaqYdeEg&oe=6B106107"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gq0PAjzGe8Q7kNvwFDkceM&_nc_oc=Adr_ksZIFN8tUMqaBcbjXGURe8wgvxagwuHYLjvi4ANDkbtR5dalLl3PXpBMuIt_WvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU5M_Z3aYgok6RlfOxo5szXI7BY9KH0TD15-6jIaCfPMQ&oe=6B106140"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYQJgbSCx60Q7kNvwFHjaKv&_nc_oc=AdofHqBHKaUgygfQe4NLv6ShSM5_ujLFIinWCPb12ZOvF9GPtRKWCG2qDxhZmr41zdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUU6jwp_b1xQ7ABfgiJhiTWNBOtyILCyWuy-hKSa8IAMw&oe=6B106CEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t
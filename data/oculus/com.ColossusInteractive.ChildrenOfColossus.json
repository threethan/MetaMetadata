om&_nc_ss=7f20f&oh=00_AQHXfzdSqi6Xuanu5FSmplt78mJ8rH40z_297Anrmop7ew&oe=6A91916A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gLpaYT6KrwQ7kNvwGynHcm&_nc_oc=AdokDj42kNQkY2nTHAdhSm7PNNWsrMzze3fnodXBWQKgj1ihTxQCHMR2G4e6Adbeho0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqqzQee5LR18_v59y_6WxpD32ejeBvfmFO72NfIlddrQ&oe=6A916087"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmT4Y72-qmEQ7kNvwG1Ni2k&_nc_oc=AdrQPzKKTfuVm9HXAR0WpOIbVr9HEuYwW5axK9U2_qy_L-AOjYVYJGAKGVMfv3O-gDg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeVI1_41zj4f7AdJropHeMRjGM0sFtiA_8xNIxI-7Hdw&oe=6A9160C0"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBnHO77IblwQ7kNvwHXFr7A&_nc_oc=AdqQtM3ZfQoEQRgFHDYS-bs631lA0o9a8F0IOm6rm9FDY_1YY21Q7AeUGyv669K_w0c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_EPzGbVjaURCORsG3aMkNGrkjJjz5UVcVd7sL--U-wg&oe=6A916C6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrBCdBkDyowQ7kNvwHySvAp&_nc_oc=AdoW7KiSA_LeA9MhG3Fh4Feyk0hVqt5Gqo9008Rja752H3tNuh2l4KvImxICSX5rHog&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjNEW_DLbgm-oFAOqhVU
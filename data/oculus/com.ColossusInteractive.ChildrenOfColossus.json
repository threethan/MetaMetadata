om&_nc_ss=7f20f&oh=00_AQEzKZ4SaJKf8LoMYzyROUTkwaryNIFv3zTnSdvmMIqsdg&oe=6A806DEA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amld3Qmiu_sQ7kNvwHXPiGc&_nc_oc=Adpz2Dny6xU-n-GhYK1sBppNlFWX-R0JyC7yBOnSALzbHG0uv0KH8HUY_NcaAPhxRrY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9luqgLEp2kfvLO-Q56p7kxSkaiONomwudNLiJFQE4GQ&oe=6A803D07"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c946ZHgC8_sQ7kNvwEhDOe3&_nc_oc=AdpJKD2sBxhb98u5LisHwKkvNkjDv94MMhG-Mpuf1dVUzc2Rz611K_Z6Dc6FLrjt8Lo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1RI5ca2Af8XmlufWnpBxmY92dk-_n_3l986aUBy86JQ&oe=6A803D40"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9q59xixDk0Q7kNvwGryYep&_nc_oc=Adp1Om3tpxXdYC6aCTphsN24RFP1hz6V1j6Fb_9pZew6ujcvlsAJPcDEr5rLDfcQzqg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZAenPyo_HY5bY6brrdeNw6pl5RhoV0G7nkAjy95sO1A&oe=6A8048EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymQ8LhHPnEAQ7kNvwEmSOdC&_nc_oc=AdpIMEmP6_kryrpPt4ck0rGBZUNczeq_400Vjlb9vr2ddEMNbhP6bl3575Id3sZj7jQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDnJVL8F7F51e43Exrd3
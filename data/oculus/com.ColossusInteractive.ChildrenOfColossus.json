2974813303209984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b00yLwWopnkQ7kNvwGDAyAs&_nc_oc=Adrg9JIFYy_XvDXRUEEuGvs42X4CTvIBQBkOsOwok9pUG6gnjLGwx-u8H5KYjQRGhtc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFmHpHwdcmdKqkYrdOUB8PjHrTlYutYUds8hhk_8V4Cw&oe=6B0870AA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtn_B_ZoxhQQ7kNvwHxlBZP&_nc_oc=AdpoHLg5bXgTfMDmzK0ZCSz7rBLbVJ4GZLw-FTWyi2RI0kZoIe0JplG8hBzct_uoKxc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9fUn1e6wBE4Ecvw2JHusYmIBQywNcfJmUtScktU3dMw&oe=6B083FC7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgaW12KhWHgQ7kNvwGJegHf&_nc_oc=Adq8oiTZcj-ANi8J8keRb5ZQQw-iV_SYbiA072uyJsyur2pRCayMqJ7NzKgmFxK3UvE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRfaeJA-yp5FCLGg52siWRa2_s2lgK22eaAd2-bTSdDw&oe=6B084000"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew5y9uGullAQ7kNvwF1tp_l&_nc_oc=Adr41fgWkM5MD9cppWhjolq_Zm4taJaRCYlkuiLHWs3tqrY6mg1rtGD5XWhJrcYilm0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaDi7oFxyDqlNiE4npe65IoFvj0CrbErFIUYMJ0EkEiA&oe=6B084BAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t
om&_nc_ss=7a30f&oh=00_AfwNwFtUeqVh7FhAYJinnoTl52CYK_5m6APY-KHP0ys_kg&oe=69C3E76A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saHEL5vuBxIQ7kNvwHBmBLO&_nc_oc=AdqTw_0m87n3urt66xsQ29GeniBzRNoMzrSVqhPBuRtF27QBRJM5MUr0U1pq-1lygA8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzruQ15QpGSytYlJBMxYNizVGWwKJYo2DbuRxFk5wyMig&oe=69C3EEC7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrskkcqwGMkQ7kNvwE63g5i&_nc_oc=Ado3OlyChzK9OxbMUYQDi6RMcllNTO5R7nb-G1ldk455BE5ZNkP3q7Q8k45fzV2bbzk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwyf6O0KYGlB944M0OhctD0qQBaeA9E9j0Met5XRm3iNQ&oe=69C3EF00"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epLOSyCyoqgQ7kNvwEGepmT&_nc_oc=AdoNG02FbYs0JnAwqqLZ_RrZrpcBdP71WK0F23l1PdCH91HnrUN7PG9TsVA_K0YAIqU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHHxpyBe_YPP5U1uLeUBVWaj3hrJHNOqO97GXC328wYA&oe=69C3C26C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdeDYb3ucsUQ7kNvwEj2hih&_nc_oc=AdrwSdoUptVRhaMwTxCW7cLHHsryr31l5W_H61jwUE4LMHXE3nPr--_-2MEd_jog5Ro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwze2e7LcWAyJpy8M0ain
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oeVviNOvAxwbjyQuP8o9gkw3nKrHAdaNzpXCUPPftgg&oe=6A393CEA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcvVo9RlwBIQ7kNvwGxiwHL&_nc_oc=AdrYmglGsamVUW4_ZeJUeLwj-NmC6wpq-do-AO7xrMT5xltZBMKt8SApP8IWhEl1Brk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g4JuNy8kfShUlqcMsi18B1Ez7JIL6ixAkFE4AsGF-Hg&oe=6A394447"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Yu6irpzvVMQ7kNvwHqXnjq&_nc_oc=Ado6yOQ1yukB-z9wl8sS_2oxxtBBIEc_gf56ERMVPSLVcqQQH7IaC8up2HKEtrV2K3k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fdZNIqd3FXsZbXqzjZSVzTETbbE-yjL1CyD7KG-BhSw&oe=6A394480"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WaW_xkinAgQ7kNvwFxVWw4&_nc_oc=Adq5OwuH0BZ2qIJz_kybePe1oucKCS4D-jhos_7j4fXVxfiLgTcVpncTvhXWGA_LMBs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vK8NA9PYaLhmZMWJ_YyHDn49YnbbyTEOx5hoikBz6uQ&oe=6A39502C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU1zx5nJgwgQ7kNvwEJUJls&_nc_oc=AdpEUV7bUVMQ92z6yzzSi38l-sPzFvJ_0ucC35JmPWW0e3CNte60M2drbx5kvGeHMYw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k9zil
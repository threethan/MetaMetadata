5-mSUm9Rbvf-oCCawuCxQuP1l_F57i6Q&oe=69BAACEA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1zXwVsrt2YQ7kNvwHByHVD&_nc_oc=Adn9uLCyCiH-UuRBpjsdOiIsDGzujtR7heP-3Zde0BWNS7SAIHDRSx1mRHuZFMoibp8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZjpTR6i0SLMBec_wyzBO3C9WXWVa1xwMFHId5U1_7YA&oe=69BAB447"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvMBF9X_XuoQ7kNvwEbE3hj&_nc_oc=Admj7dRiWCz0Iy53EtmayXG4Sj9TZ4nmR2i3tHasVYdZtVvLZAs7Fa4JlNrd8MeHE1Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxslZvEDMh18lG_OaZmQO2Z6j6yxzCHw_PRz7s0scPx6Q&oe=69BAB480"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EIRDNC8_PwQ7kNvwFmRTcJ&_nc_oc=AdlJzF3UgyG1619_zmwOPzcjtUUnQhkWKeIrV2ofOddOhfa_9CA-DUILp6Ymb1fGeSQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzesFBIMpmsv2BR0279L8pOw1KWHWsSGrz5DT97L7Sv8Q&oe=69BA87EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu7aqmjUB2cQ7kNvwGUHqCX&_nc_oc=Adm5yJiTKM6HUiPIHXHwT-6kkh7aLo3ziJ113-ZDDH_MZk9fcGvBTLt6jZOlJgHWdUU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzoYoAopz6PO1TfYc9FzQNiyyDS1zuNl9LhHdEcXUyQvw&oe=69BAA8E3"}, "is_concept"
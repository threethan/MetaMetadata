om&_nc_ss=7a30f&oh=00_Af1YIUdr1HHY_rgA2k852jNMyBgBcsLLC7UKfwApkzFbkA&oe=69DA50EA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MH0MzGYZQYQ7kNvwG4mB6Z&_nc_oc=Adq5KOG4-qw25c1Ys6iCIArsdx8D3sWN21feg-5-46YeJhTlfSm5Wgxlve11-1N5Pj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38i9uhs8tZPPFoQ_pcCHQaA-hWhT4OjtMUxiY6S9HH8g&oe=69DA5847"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cw3gbufVzLoQ7kNvwECNInL&_nc_oc=Adrxx5imvZ53mURVP5qqS6K_kR647R7tB00e2WqN_3bAIjCQI5kjlMcNZDTXOdcdOeE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Xmdi7Q4dbm389JkvLXlPD4I8NdxX-x6smc9epzQueGQ&oe=69DA5880"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eag-Y5Un3w8Q7kNvwGM_M-X&_nc_oc=AdpLwWpJ2KK6MkNImb6KfBGPIb7jHXSX-wYeBUrW1awFkdNXDA_HPQNhqngNvVtk2EE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05zRSgxBIfkNYhAOz8lbjQGGlwBtnP6xVD7ctaKzqLBg&oe=69DA2BEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=443jG0TZZh0Q7kNvwEO79lM&_nc_oc=AdrAk8tzbiLMDK_hJYfKx8PDV_kbs4t-Bn7eDDi_2mmkRjokQ2bzO-p16gvs8qxb1d0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gPlaO6BeGbYmarivrDv
om&_nc_ss=7f20f&oh=00_AQDjF3ZpDMV_oTBjdzHskkrwpSOGqd6W_7hdwXDYXY3_XA&oe=6A539AEA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIy4Mb1-OMsQ7kNvwEn93vQ&_nc_oc=AdoFFyhs9o5subrU2VTz2urkc3Np1Gyh5nvZGl_hldiLliL-T2UoP8HV2u4FPA72bho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5objQAorqM4sMJQ6LkbQSFGpPDjIOR11GjG6nEUaPGw&oe=6A53A247"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHqCVuGBz1oQ7kNvwHgG-KE&_nc_oc=AdprI-riHgt_y5RMHEzTkxk61QN8_2KKMqgwE--lU0_QWzfRZHBMiAXsSjWhR5cL3p8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCivBK07QUq3ghxcxnhkbJONPtd_aIRRPzf6cyA1PK-oA&oe=6A53A280"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fkaj6i0u_kEQ7kNvwEi3U1K&_nc_oc=AdoF7xGevJt6UYls32musD8-lwh2xAtfoF8baUx41JU7FVAmEECCTDawxSuxr6MbgfE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBexE3E_TDvUzjpkrhWUv_qbTWta5UlMsrzyIVQs7QiVA&oe=6A53AE2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTG-C0bNH8kQ7kNvwEzftpE&_nc_oc=AdrEVeo0Xo9c8u_s27ujAsK7TkL_4I3TmRS_Yjiapnzf_g-KtFCe8IpgH41yfyGfm4Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuh3KZ7Imqe3gB7zQbqi
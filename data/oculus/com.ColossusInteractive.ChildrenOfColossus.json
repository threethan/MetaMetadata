om&_nc_ss=7f20f&oh=00_AQErO6jpAT2evrQ8TJftaAA6a3EIy_pnXtZi-pJdZE3fkA&oe=6A87056A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1ED8y78ZNUQ7kNvwGDLhtk&_nc_oc=AdrGI-3sEs1Hy_qTbwrsYLlq5baS5-psq4a2TsQD85sdglPr3jFgsKw767O7OLD4fUM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOA0RiNn0jg4SzUyMMqX_MmcUwkE6TCkBJ2qzW14ss7g&oe=6A86D487"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HroRunkAV-cQ7kNvwEYwqf4&_nc_oc=Adrl3vGcY0Xm-wEIeSj86P40U2Ak19CICIqDG9VjKop3TtdRlQ7lKgVuRFSOgSY2bSQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgaZxYMmZBL2hRHtcWIzBlNTDg3G-WbKQWcVZiTp5trg&oe=6A86D4C0"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfsIeSpv-JkQ7kNvwFE5odU&_nc_oc=AdrwKRfQZVoi4ISgiuM7-B_tlMaobUGV8pNp0VZwrVMwJ7O7NGV0JvXSp0tnxi9OLHI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOh1h_ETbo8VXu7uRj6sWTnH4ClNKRLvsibI-LqGV-jw&oe=6A86E06C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcSgKOnW3hYQ7kNvwH8DAUA&_nc_oc=AdpdRw9LecYOCkYV7Y0Rl-24oAtiqvKX48pOwVUCGIH7fJABC0EisD-Xoenjj1cbbc4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0jmtM7VAyM-V7Z3RarU
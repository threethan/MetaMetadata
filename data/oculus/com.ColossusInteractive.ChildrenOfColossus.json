2974813303209984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1Bk6uUmzpYQ7kNvwG5ClO4&_nc_oc=AdrBgVV-n8oLa5gU_nvW7ag0Z47aSwuB6efr7u9XUmXHE9ht0pct6dXsi-e19S45yg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDC5OqQy-IVv1S0C6RwMJABH3NNBA1lb0JtW2DArDRFQ&oe=6B047C2A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia_Oe2oj0WEQ7kNvwFprViE&_nc_oc=AdpYil_B1mmCodi_YqtuCfg1OiORNdTT-q9SEaBMFufSGC20w6oS3ar-vKRU9w9Urn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs5RkI70k1_okQs7pIJsbFC1cR5fqPuTUC9OUo03UzWg&oe=6B048387"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih-z9SVnN7gQ7kNvwF6tbWw&_nc_oc=AdqpSMCAJvB6poSjDtONkMpygeTdboihXLIluxjmujyRUSLgJozrNBL1qES27jIGcLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi5ONkoYkGRuRuZdUmycFP5q6ZnFvy9_CxYNnHCUBc-A&oe=6B0483C0"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUdk5-w6w6IQ7kNvwEUjBRj&_nc_oc=AdqBLOHwJ3cQFTRkCWa5WPWHDeOeqjcLbZeEafB3x27IDGlq4ULoRBWIVYSm8YDybqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaQSATSNB5qwN0tEtYXzq4j5DkadsJ-TkpxUhmZ-QvAQ&oe=6B04572C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t
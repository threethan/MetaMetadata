om&_nc_ss=7f20f&oh=00_AQPaPxv6CbR3YDbOnwxuZKXlD1zBik-jETx3HdmuyzU9eQ&oe=6AE34E6A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZS7keAL32MQ7kNvwFsCX65&_nc_oc=AdrZeC5zEnHtnt-pvfQ9IJncW7ijj-rUg7W5ZWTZ_7iMK3Z9fUqYsJT3g2pkX8dd8PI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLc0hnp3Cywq5lFIx11eq6cbj3dOcfJuuP2U6y9UwOwg&oe=6AE355C7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKGZ3BaEHAAQ7kNvwF-yfGW&_nc_oc=Adr5Z854jcpvNzbOmkM6iNYFvBisoTDn9h72n-FpNPJ6ayiKg9AYXivVCjeuFpxH5wg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyg1-ystA-VOu7HgK6KpiAeIgjWJdoS1f0HUy-ASNIfw&oe=6AE35600"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vO89e2mkIf0Q7kNvwFJbuSx&_nc_oc=Adqc6R_P3beJztXSWkpI1nXdhjXc4spfnbJ1pLSANY3CPznDfd3LvbkOOPPmFDZyfFU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyr8dQMlmA1Qt5Qy8RQB2HGmgwr59Qv_gVY28eyRwQkw&oe=6AE361AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2lbt80uA8UQ7kNvwG5RK8R&_nc_oc=AdqI2DBC29Ken7fpr_m4iIbHUQ1G9A0C8eLarPEkX25xWCdDjtdY1RfPmR3VYHEwbkw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPFvrJuX129BboEm5BdB
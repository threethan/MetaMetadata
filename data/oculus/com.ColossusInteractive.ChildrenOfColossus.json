om&_nc_ss=7a30f&oh=00_AfwAD0dKbBT9o-r0G9ESPbsRwi0WFP0dSssiiFWHQOCPEg&oe=69CBD06A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvflTMKFrlIQ7kNvwGt320Q&_nc_oc=AdrzdhvKRoRNn-eBYeq7LyS0MXSA6uTl95eNQdNhEymiStS1POyA1mLYQJalZ6BdvhU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybINAFskct6fx9leirVGI5jFJE4R7rEyJpwu8mSeuYWQ&oe=69CBD7C7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQvmmQzItdQQ7kNvwEyR37Q&_nc_oc=Adqfl70BujURxPTtt3EytQr_2TrltDX73d9o5Oupim-2gFNkDy6Ww-M56As2WOWj_lY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfSd7yZmIf9JICzpI_P_HZuWmhRF_OaQQQxLqCeE4fug&oe=69CBD800"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHfwpkmAGIwQ7kNvwE6GDwE&_nc_oc=Adowg0KKNa2GTmp2KwYprJtlSZwesWL4ZidC0D8DDtQxju53gzeQVRfI8Zdf2SYCxvY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV8PXEAzr7GlNNgqvaF22mDMHnuSz8B_mEtQhffi1SSw&oe=69CBAB6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ishw2qlE-SsQ7kNvwEdPvhy&_nc_oc=AdpIGDifv5-WCjlriGgw0zUf7VW8K8cVqtvz5re-dKuVZZrN1D5DNhqPbE6kfIE9jis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrJBwz9f_-mZ4zk6Oe0o
om&_nc_ss=7f20f&oh=00_AQBfz2SodoPiVmtjotfKW0lvZ1vnuRh3ZDyTUt1b1Uqbbw&oe=6A5A326A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtZMlFHdWs0Q7kNvwEQnDGG&_nc_oc=AdoRGCwOO-3IRFciaa9n3NBqLMGlFb_Hrlli7YJp7FD3FjhEGTLrA8gmQUkxHVSQK5k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG9uXLJ5jmZGfhyyUOyZYKWPf4qFx40TtC0Jj-Vto_Gg&oe=6A5A39C7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnRUx1u0rnYQ7kNvwH-vmd0&_nc_oc=AdpH6dRBT2joT7gYpzbpZ2sn66P55MGLeMKcYuBsTwu-_0jpg8DqJm0fPDNLKHvY4_Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZu8EUxFGRQfi1CSayOcK37-UJJpSautNBFwaKu7QcvA&oe=6A5A3A00"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnAFOc7nzRgQ7kNvwGOZFVx&_nc_oc=AdqZaQiJAd12RDbLEgXcUz_H7eEeY3HsF9DONKECXodCNRe12rmn34qbcyhLpYFozuE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4TycYPkBOhKDZ8skIt15XppJJ3nedlyHbwRFyAJO_ww&oe=6A5A45AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkPkXItXH1kQ7kNvwGtc0yK&_nc_oc=AdqkmQc41fdnSCnfwTsHJ9gvAQKuAsVPu1-l6MqGZCXBwKb-hbNyPVCzLkcZd_E4jH4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZV_CMYPGZOQMBW7bWnT
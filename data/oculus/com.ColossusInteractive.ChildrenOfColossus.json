om&_nc_ss=7f20f&oh=00_Af3wX3abfgclyVdtGZ5_kLI12e-OdN2sZ7TWd4zYzB_opg&oe=69EF68EA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adUHdkKY35AQ7kNvwE4IKCk&_nc_oc=Adrwtc5tHBBMFQAJ-a20IbZ--H8S1aGErbH_f3-FVEz2BFV9XgWfTiSdGaZk_RC24MI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lVCHu3qZFJ9yrvx4qH-vJMu0artL4a7UmFhqR-keEjQ&oe=69EF7047"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-zCEATdF4IQ7kNvwFfFgSY&_nc_oc=AdoMi43lDv_ynaOCSJwkMB4xyoS3Fe9zV_tix39FczX-MpyVcSLQ80p2T1pSl9V4HwU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YUiThA7vyg7aCp2lad-xMhSuRXpf-pBAX24OyhQ6Qnw&oe=69EF7080"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moI4imsUUSkQ7kNvwFCxliM&_nc_oc=AdpzAXZeYtgoTohRvs8P8MqYrDp17islY_ABCXh5lIVX1gpBEHZGWx5slOHbXs3ooYc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hSt-JbaiztAxdcad1azIajhVtxOn1NWcnSZqp7M3Iuw&oe=69EF7C2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM6IQoGKEI4Q7kNvwGmSrqz&_nc_oc=Adqb_WmmONRfdDJzM4VIiwonlKeaMK7xHtB1WKW7rn0b5nq3BIUMD8TwuR_pQfoB9z4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ovxLMygSMEWAqMjDHoc
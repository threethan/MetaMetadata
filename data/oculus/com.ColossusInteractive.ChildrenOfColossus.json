om&_nc_ss=7a30f&oh=00_Af2zcEr3MMh8_DES-FuT9uj1XyQHWoI6K2U-5bwHSLG1iw&oe=69E0E86A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-RCeSzyeqQQ7kNvwFB_pZm&_nc_oc=AdpMDbUnJpruJNGS4iUoV7PJ1GTv0huxwIjbCP6tmhyMTPIPF-UJcuRlC1MXWgSpyF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hUoMC1DvNd9c-5PS04fwoyVw4CgMrTuE6PyROjH547A&oe=69E0EFC7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trG76fJ18fMQ7kNvwGYYbJe&_nc_oc=AdrGHHGbOGr4E2aqJy6ibE-QKupi_O5OZYcS89N3WHsXXeNRehVQWNA6Y1YbHl8nBiU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UQ_sSOwbQY5oa6djE1GoWDuhn6IgNpWinH9COStYSbg&oe=69E0F000"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2F-XlgheeMQ7kNvwFJyOSz&_nc_oc=AdpwGwE4sGk1G8Q9KpD6KZHrCalbhWcwkQs0TTrKhQ8sGUOoMQ-ucLzXSbsYvyA7TJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IywiYaV2ED8JWvJWbyvuc50k450k3l7L1Alp6SMaaxw&oe=69E0FBAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy7kAO8007kQ7kNvwGqLIhx&_nc_oc=Adp2qLbYhCzEPSz0WGqn4-5s2BJQN1LsqLMtOAkftUU7Aw2HzLWQz1DcgtgjtA-ChFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04lhlmIVuvKCNNADckBj
om&_nc_ss=7f20f&oh=00_Af5Ugs5zP2E8BW6J83DcBHZYWIh5cDvR1wIjoR9h1jCP5A&oe=6A0B186A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0d2U1NQcgMQ7kNvwGCsJjt&_nc_oc=Ado36kMBB50O9FNwoUgqdkX5E_T8wkgPCU6VZkoUF7WbbITbuNKCPniFJyL290fuUnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B34S8Ott_gebRu333-AzYuZ8UI0Hmz02TKrtdv3UJwA&oe=6A0B1FC7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUvkrEFwhWgQ7kNvwGZQKei&_nc_oc=Ado-lEeImCUGGb-LaSSRSMzmqBbBcaiHjpC05cmjI_CN04FzOi3HC25-C1jvh-sjl18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t06kUo1CeZHSooxGro5hOsfx4nsM4qYeMpMh3R0mWAw&oe=6A0B2000"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN15edgqf18Q7kNvwGK95Pq&_nc_oc=Adp4leeDoH1C-5DnoCnd_ubSRig2FBMD18FKQlrGHE1kMef-pi-04VHwjgzOblozpqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HNrhc7X47CJSwqS8Edm2QUv20vRweMqWLeT3HQB16tA&oe=6A0B2BAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vou2UnDlIF8Q7kNvwFxsvmO&_nc_oc=AdpqsYJtMI_O1yVyqdPZYylq3_B9OuhWk00Hocozml8hUbX1Ux_tj3GSvjWR0astLBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ldWAZ1PhoLwitWPA85o
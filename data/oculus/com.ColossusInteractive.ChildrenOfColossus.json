om&_nc_ss=7f20f&oh=00_AQR__V9d3RcnXiRI9xyIRjaMMrPBhw88yFQBlCIf-LT7dQ&oe=6AF07D6A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhwd0p5eirgQ7kNvwEaGALh&_nc_oc=AdoJHYo5fieOhr0yJkGD33d4chpYUyZ8GDn2TnC6p8kPFZkUWBHdajv31XX7V67LQzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhHIU4jD5HISovP0Q1lcNqjw3HvZ7FOUVHmKVGPiM1sg&oe=6AF084C7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17uT0u90mGIQ7kNvwG2P0Rf&_nc_oc=AdrneKq5l9cLSXH2d2-XZojajFJIxDZKpyctGTO5T5JUlSV6UO4jf6bZ1bStQMb0g2w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkZKjO5jhyNN14Di4H8h1qTRWKbYCb0PbwRTUQoXOKdQ&oe=6AF08500"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_n2g7yUrYwQ7kNvwERIHyp&_nc_oc=Ado6bZHEIG6YBEh6z8V1QaFp9BDUIey80c1WaBmV_vOzHX7HkX0ai0MvUjCJknQdX6E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzSNr_nhFxoi0GajNrqEeh-YhHMvjOauFis9m6ru_nzQ&oe=6AF090AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md1rPEv0wP0Q7kNvwHxbxf6&_nc_oc=AdrCc96HR49YTe8AhX-IVlxZbnVfqXUBpo4UbQNPL2iq4DGYGK0v_fpb7zUgV2tVeLs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoqDwoChVrn6XrANl3ir
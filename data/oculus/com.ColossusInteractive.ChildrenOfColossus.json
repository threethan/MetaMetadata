om&_nc_ss=7f20f&oh=00_AQKqUuIGuCalWhBYJ5_4GQ404lZpWq46sIzD9P_tU8Kisg&oe=6AB91E6A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhXvMdZ1nLgQ7kNvwFse1sF&_nc_oc=AdrkGXgQqXOH6s63G5MFivtqdSGhiFselPSHcPwM35iKqCAdBIyOnhOsIhOKEJSu9us&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw7TClbj4wdeqEd4NCgLGCIyzoW446qZF5RP1RDd7BLQ&oe=6AB925C7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pL-ieXx5wsIQ7kNvwFXQcxY&_nc_oc=AdpwPvX8w99hELwiFKcPg8yYPSHP1C5VT9mmQJ7zZCCmd633E-l6rU7kjhB81jrPB6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqw2Es9j5az72RrMPpNCX9LmRz83RjGOw7kC98_VIpQg&oe=6AB92600"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aakqqeOZxFoQ7kNvwGi77IV&_nc_oc=AdoAINS8J2QoG8LtD78HLp7F_LVDhwx7ctqiImhhWYzSS0AK-o4Sa8vIr7meKYDzZMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx6_7802McYV3L0HeAbru52LlGnMYkJ3pa2rSjgn59OQ&oe=6AB931AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmsB-uIEfcMQ7kNvwGhVlCm&_nc_oc=Adox5BgHw-mteqFEio6Btb_Pu3bMfVEXF1qKvcdt6UEWNznJH2Drq9Jx4fYyEDGtKNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8Ob6t8jtteO0Lx_O_3D
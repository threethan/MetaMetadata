770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WaW_xkinAgQ7kNvwG-X7hb&_nc_oc=AdoTOn3p_f-YvDENo2tmz2keY_mPMIE2uldMJcgwiNvJX28utEzrsZi5w2nFKbKbX-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2BqnRHQAVMhwQk2cZ-rUTk3ueWpT_-LU5CFrSg9W8JQ&oe=6A3BF32C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02.png", "id": "750246001790759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727789_750246005124092_4382666293346566144_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbOeF8G06p8Q7kNvwEiLWlR&_nc_oc=Adr25dQTyWd2nS8TYa9UZ-8fFhXOSyuDaRB8mT6cbldpHXxQEXX-FFgyhFfF6BnD_ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aUwPp-XqXY_kzPJldsRQKMMAahUl-q1t4rmyK5DH_ow&oe=6A3BE036"}, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RPG", "FIGHTING", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "457027569396691"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "262569744156011"}, {"status": "PUBLISHED", "id": "1867898686804584"}]}, "baseline_offer": {"id": "262569744156011"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1485972000, "status": "PUBLISHED", "id": "262569744156011"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1192731087443132", "version": "1.3"}, "id": "206129986458152", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1161016330614608", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1192731087443132"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1487243303, "id": "1220629861319921", "version": "1.5", "version_code": 5, "release_status": "RELEASED", "status"
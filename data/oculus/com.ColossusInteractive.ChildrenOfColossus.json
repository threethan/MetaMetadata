om&_nc_ss=7f20f&oh=00_AQT2hiYYnWwxfq6dMiDncTjRXlQ02bNrkVdXAg2AiVRSNg&oe=6AEDDA6A"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpF9YG9EMw4Q7kNvwG8moMr&_nc_oc=AdrFcCA0URQRShgos9iJ9oYFYp5YnwBuYPUWxIFZZxDrkW59pazG8Wu7dXHr5a7mMyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDeyzaJRvALCE7J3d6mPaQ6zTGXTmOxIdTP__3djzHHw&oe=6AEDE1C7"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwxI8fWm5c8Q7kNvwG0_GAB&_nc_oc=AdrldR2eq2f3ImhvKPoNzNkECJHNR9-vcpGkyNIPovjo19ffuQXG8mt-5-Y-ODN1zBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ66_MhnKBJDz6Zb9IJ_4UqZUf2ZtMBgFHoPyqfrPD9g&oe=6AEDE200"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp0K-SxiqrYQ7kNvwGzXZ1Y&_nc_oc=AdqYxoOyuC2K0tE-4zY-QjEt6HMJuj8Do6k__BI4ZecTYHfxkSBSzLoYCLi5xAVpsFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToavT3MuCjP_x7WsqGyCNrf221BEsvWMtqfoJV1RgQ5w&oe=6AEDEDAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md1rPEv0wP0Q7kNvwGwT6ul&_nc_oc=AdqWE4p23gMTAiXlrkJryfjR2CRl0_wBMe-j4o7OKdf5Zy7Bcp6pVG2kpeb0Sw9q3qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsWfb5jDKlQk6YyEknK3
MunKEUQIS8P3jZV1l_F_U-oOED2zjspg&oe=69B809EA"}, {"file_name": "migrated_image.png", "id": "137771817677227", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533755_1778741655725225_7421742674769608704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1zXwVsrt2YQ7kNvwEhEn4K&_nc_oc=AdkxuXcHtyh9npNXKdDeOxO6Z44elWNtmlbi-E7j3MPO31mOY1GojPa9pVKe9IwvaNQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoxmTGuvNHWsh0N77lfIRIp6Nv1DDFLe9-JzeSGy_1ug&oe=69B81147"}, {"file_name": "migrated_image.png", "id": "2676981895867118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410271_1697334603913059_4907451399303856128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvMBF9X_XuoQ7kNvwG-sm4g&_nc_oc=Adkxt4Z-nN0wAzuKtL8SLoUR4jEVc6Ij7Q6_pKWW2OvcKBAkxLDmY-3_TQkXgGZdE2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8_BHgK0yXo23l40m0I9g_f10pnvFh4mCy2FRdlEVijg&oe=69B81180"}, {"file_name": "migrated_image.png", "id": "216709456200474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410455_228764770898624_4937826576252272640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PRiaDEgaeQQ7kNvwHXq4NS&_nc_oc=AdnK4bVLGIE00k9j9H9AmF9bsKmRMOyd_2daJ6II6nJotgdsS50bj6pHUs25ouv-2io&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxS-cghR0fohZKyQ4uhQfmCia_J7buFy8LQ4pRh06OT3w&oe=69B7E4EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Children of Colossus", "keywords": ["childrenofcolossus", "colossus", "children"], "long_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back.\n\nSince the beginning of primitive era, human and colossus lived together. As the guardian of human, colossus helped mankind to resist the invasion and attack from natural disasters, flood, beasts and dark monsters. \n\nWith the improvement of natural conditions, human race grew stronger. Once as the guardian, colossus now has become the obstruction of human's development because of their excessive consumption of natural resources. \n\nHuman race wants to develop, colossus must be killed.", "short_description": "Children of Colossus is a VR action game for Gear VR. The player will challenge 5 different colossus to win the opportunity for human's development. All the player can rely on are one wand and one sword, the player must move or squat to dodge the attack of colossus, and take chance to strike back."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.colossus-vr.com/", "developer_terms_of_service_url": "http://www.colossus-vr.com/", "publisher_name": "Colossus Interactive", "support_website_url": null, "website_url": "http://www.colossus-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1767701626733891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138842_380280935643298_2212113529891192832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fapRQinhu4IQ7kNvwEATI1R&_nc_oc=AdkZdXml7C12u0VSTR-5rVbmG65f9rrD2i4VRLjx-ujrdWPP97z37-Y-vyFiiIC1xvE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6gyhCXF5xcjATVddwvY6vyhnri_tLATge0XxgOJuYGg&oe=69B805E3"}, "is_concept"
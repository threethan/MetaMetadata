-QZUsj8Qz6ORGgw0_V4sCfRnhxjXM9A2Q0SwBjrYdmAK171B6u2BnNZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftAhrT4Zh7Ua1FIJ7WV_UvH2_GS8RAHKrIKaDOASkK9CA&oe=699AE909"}, {"file_name": "migrated_image.png", "id": "543783796496436", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162768_361473887618276_5781143821433700352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOOJwPTQnhUQ7kNvwE7Aj37&_nc_oc=AdmTiW0vM6DUfqoSC4QVXf927v9bjRtsO6cvTeF9EtROKDT6E2srSx1o1QXutNWvGzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv79eD_0XihCyGrDocs7ZgqSbQ--ekbQn7RDqcdIZVT8w&oe=699AF969"}, {"file_name": "migrated_image.png", "id": "306594363649526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1239176766209798_2810556478866325504_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxJDbems0UAQ7kNvwHYnBkv&_nc_oc=AdlwBOzYbFBEduqux5mZ6gm05y0wIta74auvyXwJpP2OZt21aSzXj_B9H0qOAdPGarA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWpjFPK6bNMi9-RVzcs7BSnLOACALc8Fa3EG1zA1svqw&oe=699AEE5E"}, {"file_name": "migrated_image.png", "id": "217766636249462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410487_195095187773428_5782374982399033344_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYXh-SCL5XIQ7kNvwG8moDY&_nc_oc=AdmMhWaLiYTXWdDfRlZFuwhaKn1uLiJV7yq1t4HCa0OiFVtD2yxLNdbrnSc_XpHYrn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu1QboGTpHfKHJhE7OAmSqRUyDmk9PJeNPOoGZPDrKFtA&oe=699AE886"}, {"file_name": "migrated_image.png", "id": "198477324768984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162743_108416083180856_5143234439450460160_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=468t8T73N0sQ7kNvwFQrl29&_nc_oc=Adk0HkEF7u6PBPAfV-u31R7qWt-6LNAV0ZRaZ7pdUrcmYvRFawxtUjkRYUjsC7oaoTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftg5puEzjn4xKGOevKLzSu-oJl8HyOPtYV87rj6XE-xJw&oe=699AF083"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings", "Simulation", "Ultralight", "Adventure", "Flying"], "long_description": "In Ultrawings, you'll pilot multiple aircraft to complete tons of missions while soaring around beautiful islands.\n\nFully supports 3DOF controller for a truly unparalleled flight experience!  \n\nKey Features:\n\n- Pilot 4 distinct aircraft each with their own handling characteristics!\n\n- Soar around 4 unique, beautifully-stylized islands!\n\n- Earn money to buy new airports and new vehicles! Ultrawings is a VR game with REAL progression!\n\n- Lots gameplay variety! Pop balloons, race, perform spot landings, fly through score rings, and even perform emergency landings! Ultrawings is the ultimate hobbyist flight game!\n\n- Full English VO support guides you through the game!", "short_description": "Take to the skies in the Ultralight, rocket-powered Glider, Sport Plane, and Gee Racer to complete a variety of missions across an island-themed world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://bitplanetgames.com/", "developer_terms_of_service_url": "http://bitplanetgames.com/", "publisher_name": "Bit Planet Games, LLC", "support_website_url": null, "website_url": "http://ultrawingsgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450048346903751"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331258_577030532659677_382722080743253606
Hn7u7EYw6VOp-PODMm2EuRbWih3Yj6Zyciqxp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3ETLU-JuqeWub7W8jUcdk1ZxqGU9BRJblm7BS9mhz2w&oe=6ADE2843"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings", "Simulation", "Ultralight", "Adventure", "Flying"], "long_description": "In Ultrawings, you'll pilot multiple aircraft to complete tons of missions while soaring around beautiful islands.\n\nFully supports 3DOF controller for a truly unparalleled flight experience!  \n\nKey Features:\n\n- Pilot 4 distinct aircraft each with their own handling characteristics!\n\n- Soar around 4 unique, beautifully-stylized islands!\n\n- Earn money to buy new airports and new vehicles! Ultrawings is a VR game with REAL progression!\n\n- Lots gameplay variety! Pop balloons, race, perform spot landings, fly through score rings, and even perform emergency landings! Ultrawings is the ultimate hobbyist flight game!\n\n- Full English VO support guides you through the game!", "short_description": "Take to the skies in the Ultralight, rocket-powered Glider, Sport Plane, and Gee Racer to complete a variety of missions across an island-themed world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://bitplanetgames.com/", "developer_terms_of_service_url": "http://bitplanetgames.com/", "publisher_name": "Bit Planet Games, LLC", "support_website_url": null, "website_url": "http://ultrawingsgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "
3234439450460160_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9X55J7AwtEQ7kNvwGBGklx&_nc_oc=AdrulT0eQ75TckGZyz2NFwjJmyeOzTHdoXs0UYDDJp5RiunJ3sLFoupq1wJ9cr72kCA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL33vNdFdwEvYWXqvENtmLu2MrqZ0X6VAs8c_VvqlpUA&oe=6AF9D7C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings", "Simulation", "Ultralight", "Adventure", "Flying"], "long_description": "In Ultrawings, you'll pilot multiple aircraft to complete tons of missions while soaring around beautiful islands.\n\nFully supports 3DOF controller for a truly unparalleled flight experience!  \n\nKey Features:\n\n- Pilot 4 distinct aircraft each with their own handling characteristics!\n\n- Soar around 4 unique, beautifully-stylized islands!\n\n- Earn money to buy new airports and new vehicles! Ultrawings is a VR game with REAL progression!\n\n- Lots gameplay variety! Pop balloons, race, perform spot landings, fly through score rings, and even perform emergency landings! Ultrawings is the ultimate hobbyist flight game!\n\n- Full English VO support guides you through the game!", "short_description": "Take to the skies in the Ultralight, rocket-powered Glider, Sport Plane, and Gee Racer to complete a variety of missions across an island-themed world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://bitplanetgames.com/", "developer_terms_of_service_url": "http://bitplanetgames.com/", "publisher_name": "Bit Planet Games, LLC", "support_website_url": null, "website_url": "http://ultrawingsgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
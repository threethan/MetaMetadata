c_ohc=IAUtpJsCuxUQ7kNvwFgghHB&_nc_oc=Adq7sJIRdohaD6hXidWJViv48uajcIB6LnUTGR1X-iCBdg2moeH15Y7eOJy4CHK7KbA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz14mmkhmQBxr2tOzdu9hdLVFq_4-d-UWPNVMvxehAcvw&oe=69C26B58"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RPlnCjP0ZgQ7kNvwE4L3X4&_nc_oc=AdoglBa1X0RdRhivKZcjJtAz2YulcC5yoNSqok3OD5EzpqV4hANbkTC16OVyy92HIRE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYlMZso4uLAMIgMv7HdNx6qPJIOQtI5w4U2OpQRad30w&oe=69C288E8"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4ovliS5TqYQ7kNvwFIQWBD&_nc_oc=AdohnFShgPpPokREPHqi8lq6FRptyBn9zDCt3nHffEcvqUze6_Ur-dA_vbUJiy8WmQE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZcf89f2PiKMrphiMhoAFCXd-rXwkmoXHFK8HyRr4ufg&oe=69C27CD5"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No6oKOruDgsQ7kNvwF14xGd&_nc_oc=AdpsO4n115zek5GVCSPLMXFbUtKNO3IWD4U4hIPNwUXOJf9mguROfkmufTWql_NAboU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9tL7pWWtMniiZOUz7H2e9g24r6KIDGcqpuPM_n-uckQ&oe=69C2A037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBoQMU3A8iIQ7kNvwH_WuHB&_nc_oc=AdoSf6or_uc12CKyihP5FUi9Coke8PFjMY6_eYPXKeXBOb8wN_PtjfWXXhoh8fgRPp8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLkQFl-Yw3q9EJAGy3vnKMcF2-fcK-EhmXB5tEALBMaQ&oe=69C27FF4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
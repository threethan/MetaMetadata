c_ohc=i8sJ3Qg9T8UQ7kNvwEnxCd0&_nc_oc=AdrkSYZi_FLm8Le2aqAmfAHUpX2Am89565RAapLHOUKWlkHQ57D2y3x6VUfz8GQvPww&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZPBINUmz-HezY0-9yhuwFa1msUVWJ6JTqL5OTmk9GUw&oe=69F4BC98"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyg4nYQnBNMQ7kNvwH2ZN8W&_nc_oc=AdqpbUMm4Rat-t_jj-rLmr5aiOLddqQ0d6jpCcHr8JHraArBAn2ybS2JBbhHLch6RgM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_vHoz2d68z10p5-MNxeOgKlnTRfcYNC3Vj-7oaArFEA&oe=69F4A1E8"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0Ij1Yk47nsQ7kNvwH1trAp&_nc_oc=AdqgRTGTNDHyftzEcc3HYAAk1LJomrUit2EjHZwHbhQVTC4Hueeg1DZfL_sRHzNFqd0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hYIg_qBR7li5LABfb2NFVloTj5tt4IErDo8AwSOiejA&oe=69F495D5"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy12Cqfbvy8Q7kNvwFDrRJj&_nc_oc=AdohhioYnJ5IQfTSjjzObGeTLoby5UjPz2ZtcUH_sj8pt0YTILkX3QH3QsLpzFHIMss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mmR8a_5ERYjbKGdoeP6dXG7ETiwiD-IhAvIVBDxiDgA&oe=69F4B937"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-cNakrOK6YQ7kNvwGA_Blu&_nc_oc=AdqVilta9_xyu2sJyuBSp4R4IQyijbAqcZoLUucPQ4pAg3xwTGNK9SNHrbb30H_zg1c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Gc5GkAKYsSXWbXMzrqiUeHoc4hkJ9Pfpty6WvIYps-w&oe=69F498F4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
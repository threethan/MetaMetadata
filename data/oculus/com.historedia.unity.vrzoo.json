.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syR-9ekCTCMQ7kNvwGYtLXy&_nc_oc=AdoUtY0dgQkLzUZaka8rxjLOpJpIjt1tvDUW4R9SbiYOAgWzXocicXAoHLqD4CCU8Kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3MoJAl5IOTui6hfVWWImLlV6uqCZcOV1P9uahxIpGY_Q&oe=69F0A155"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyQ0XC0Gb0wQ7kNvwE8-ELX&_nc_oc=Adrb8UZumLpexOuSDZ0qMmOjbIfhng3KAOjT0Y6Tz4xex7_-9JxMp6J7sZPy3eYyUp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1wH-vdgLsgzoy2YLaFvy2UBSl6zsFIE8ONldk-Agi4NQ&oe=69F0C4B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WnixblPLXcQ7kNvwG8F-tP&_nc_oc=AdqrUfiKukoOY77v5RJW5HmKn8xlJaNVaWl7kc86XLHv4H8mI_HbjHz60PPfg5bRc2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2Rgg_ETBP6HeyC-yOS_nF_yj-Aq0MEAL9XhGX5lMItHQ&oe=69F0A474"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7197023953754989"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "965840905354176"}]}, "baseline_offer": {"id": "965840905354176"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734737340, "status": "PUBLISHED", "id": "965840905354176"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7627893610668019", "version": "0.3.1"}, "id": "423644980788013", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"node
c_ohc=dAPgWDqVqiEQ7kNvwGjxamR&_nc_oc=AdpM-fhoMkfeGdfRFjbpLUXdMEM5r3qCZY5zEI50Q8RuWJwq41oIJFYWuiMKKMaKLTI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EMopt7xtqr4Ka1Dg8rdi5Zydr4z-IM5lxfoZyfzNkXQ&oe=69F60E18"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMhVCct5LlgQ7kNvwF7v8s4&_nc_oc=Adoc34qb9hdDyaSrUW9leSiGzRrikmNT9auoumoSdGXUbt44D9S4nSoUuA-iHyINZuA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23_2NiQzDy3HdrCHDrunaHILvbtaNKelZEVffba4Bm7g&oe=69F5F368"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0Ij1Yk47nsQ7kNvwFOszRo&_nc_oc=AdoPY3yRQQQ51U5a0yBF_fXwKasdiBwH-ehzjQoC3EA0kQPQHWO_VfIoO64rl8y0OlU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YI7WsxpP6gYEd1MAUvQvzqbMv_QUNjshz3eAqnnP3JA&oe=69F5E755"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Fn2S4E_QEIQ7kNvwHxfCLF&_nc_oc=Adr0ffWmNkZzkKHU6qWHhfzxuJBMIt5C9QwQ-jca8frNOIlp6cDQGm3N3KjoB0CuFik&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-bFWwRp7oNM9H9-AdmXVWLau2cf-ZsV5HBpCqtZagbg&oe=69F60AB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKKsYgwcJD4Q7kNvwE42Cgn&_nc_oc=AdqVGwoZG5xw4EI-SVe_0yz9yT1dWXlpWPmRt54ZJKjjTmNzuF0vTaEQCK_BhWT0QxU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BkHwaa8jaLTCwkeUqoBgPDqlEA7zFTxZcIRLipmtKgw&oe=69F5EA74"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
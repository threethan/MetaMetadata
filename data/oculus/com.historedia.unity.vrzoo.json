c_ohc=iaNMs9Hq3YsQ7kNvwEVfEL4&_nc_oc=Adr71q3QJL-P4gSpolpmmWFpuavAzfxLnEos_VSbNUvYlXcDaFdI2CYprfwu1vjjmsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oUOtyBzCkQVXUmSusVkF_N1KPihkXm405E_ty6nxaeA&oe=69FCA598"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q58NaGhuws4Q7kNvwFynFbk&_nc_oc=Ado7PADBNUapy9VDSsLIN7PdRvH-gcjAbE1rZyV5OiYt9cHCpxunNllU7BEnxTckiKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qHxt8MBU5Hm4mbDjWVSII1VAeJ_V0j_cw_iwTMuziDw&oe=69FC8AE8"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90LX6wL0tscQ7kNvwHNwIsx&_nc_oc=Adoe5YkhU6iz0iD58EnUbNh6Wmeygu_RxGFpTFW80IgVyh2nszLHJdQnzjwa9LebgYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57U4GSi07exyct1nC2YILmkq0bIIMUG568NYL4yWYOSA&oe=69FC7ED5"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nQOAzDT7u4Q7kNvwFmXeN-&_nc_oc=AdpKfhA_5iwTjO4Hyoq1TpSjerVD1eT1ghGnOTesUA4fs6l8Cl41ESfapvxzZrfuc0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-nj0Z0KFrZaaRkSHDspnlTwe6EZq3ukkU4bMH9av_Hg&oe=69FCA237"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IiO3olCoTEQ7kNvwHEN0Zu&_nc_oc=AdpSFDH1qrkyRDZlrfYvaWEg9jSUG1v2skwnavnE1UQcpIk4OoezJ0C4UuCP062LJF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sd-HeJYorHsa_GJLU8q8U3LZZ5peOfNcuJJVSe88UWA&oe=69FC81F4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
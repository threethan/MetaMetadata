c_ohc=X0oQ_CDHbgkQ7kNvwGFwS5u&_nc_oc=AdruyjO1XTSy7yOSYmgDn_qkyCxEXQcZebUpaVzVNOcpXNkzMR_WzXwRU6eDoG9VFwo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z_rEdGpD7oyX1RxY8SovWqFaoe_rX24WPSuHqGPxjAQ&oe=6A033D18"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7n5RCct7N8Q7kNvwGvtD5d&_nc_oc=Adp-euAGgG5N-DgwgIMRmTN9Tv8ZChG7QQNoMpSnmfD1yQmSEFFihjqZL4peEL-4Qjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A72391HX4S79BLJgTod-A46Zwt4JGYU7vpUJ9nMRG_g&oe=6A032268"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvWHuf9z2nEQ7kNvwHBAwoT&_nc_oc=AdpmHp-0VPX086YV6FgRuBg3COb34WVcy3nQVyM66HuGuPJdK1bPyU2Ltc7ZUhKrYHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rHof0Tnz__Rp-p4jDU9EsrbDlhTy5c45wGrG65AxO_g&oe=6A031655"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJyX0iud2H4Q7kNvwH-VbyC&_nc_oc=Adopl9reRPiXII1kIMOrd90zmG3AbuJESa5cbmy0uFsxa7Fud3K0Vr5mXJmXp68nG8c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WLKXZ5N1OU1qsujvYzTORRYCXPC1h4-Exr-dfPeZMQw&oe=6A0339B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Lwldp6ETu0Q7kNvwHk_9rt&_nc_oc=Adriz4i82ZE_s6LwlQeYLIZIlOPCoU1foTZIzwdY00vluS6ReF6T7wDjgUFAyXQcvN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af495kSI6gsOJkhYlQtelT1SBlOfGErjUEdkYpsUc-n5AA&oe=6A031974"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
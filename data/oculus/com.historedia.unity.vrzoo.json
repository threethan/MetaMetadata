c_ohc=QChLacHiZn8Q7kNvwGLGONm&_nc_oc=AdpB5rHbJxl8pEpae45yI2VBptw35qFXZpzBtMTlOWoTQjicAkf-pxcO3Wskj8CnhzE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxb_DmPu0FFvb4uZnifseywjwoiwOALDRz_P_L6XR5HgQ&oe=69C65FD8"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oq3iBMWYAP8Q7kNvwGkDFaF&_nc_oc=AdrW9nBGn0Vit0iLeDfMcB53TxtL70GMb1p6mHXzQDaQUhi3u4YxrZMU_GSTn2pnuVQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFwN8eZDrStxPdj1r9iJqPEcU6C-vEfdj_2IQJ7xhG1A&oe=69C67D68"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0G_3A8wqxDcQ7kNvwHUP_zI&_nc_oc=Adp8PygHTOrlo0D2R8c60TblATBtyTlo7iILgupL07fFhgzKOVpgv0cOgMat5UuZcG4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7Ife8YBktYjYfbXTn7bZWiF8hu_YhjWVArgkOAALwvw&oe=69C67155"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhL9_rQh-SMQ7kNvwFZLut_&_nc_oc=AdqR1Hi7yYQDszoYTeLyUx7MwV80X4fUqj7Sp2JKej8VYyO89K6FiIwkPHAc-yk9s5E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPwqlgYh2CzbeUfPo9dZjTXrCZaWZqcijK7AY3_FdWcg&oe=69C694B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb9olRDyIcsQ7kNvwH-TGil&_nc_oc=AdrUnWnjRcw35xdGxNWMAKDw7ZuJA3K8QMZWNMwUskFPsVGk9lLsBUMun8KpOGsueUs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvLIAopW9a-MKVpRhKgWPq5o8OOQ746zgzAcSlcvzIXw&oe=69C67474"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
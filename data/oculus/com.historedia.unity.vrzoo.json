c_ohc=VGvNx7k_AkQQ7kNvwHxtVGq&_nc_oc=Adoym6F5fuw6lJ1WLXR_9PwH6q2g1oM7zGmTeZ4qqKsHnUYHy7_4YVsI_F0_sV6ed7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C2LrdBMuOsmkVwumF4PSVKVa7g9D3KrhguK4TZ0WHsg&oe=69E63C18"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_YsXg87oroQ7kNvwFHaDkF&_nc_oc=AdpbIna6sVQ-0K6NIYRB32URb84PPuu10Zbx-czUG2xbCWPV5UF-8nj75kaGtZh5B6k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-04rE-2iEXo8MFafEKkliAM2yp-r0lOpHE7CmeMfZnw&oe=69E62168"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXDKyDJJWDUQ7kNvwEgGq9d&_nc_oc=AdrebcnIx2W737OxZ9rPJRmv53FJRqRXRWlEiNOgQHbiQKPjih0yTGeSLTN8myQUppM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VMBuZt5c4WJZyVlafuladb1kmoEsAK3i2yaozXbZT5g&oe=69E61555"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e55svKXwCX4Q7kNvwHFVVZk&_nc_oc=AdrJnetGLlFYRXkNbj5pceVw8Fhxj9p-ThI8udymppJ6vhpJ4RRhgjMzH9HM9MpUG8w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GOwwvE0D5cBQaAn-ouxmuZgijOX8W22g5Tjc3bM5boA&oe=69E638B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7xkfgklX9EQ7kNvwHItEzS&_nc_oc=AdoxQP_3saIwF_EqMmJWPhEY7IPd0_6J4fcReWm8S-hVH-8IaJrc3aeqNujE9RGypgI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XvvjC2VO9SLzW-lQGAmeHgZCU99cZ9jTPFONqx4MRhA&oe=69E61874"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
c_ohc=-NGApyBvLzMQ7kNvwEmU7Wr&_nc_oc=AdoYOLHcOIXLNaLFkbIiiHrhBy0X00iGwWMUoyoisadVnCU4x6FERyYJZ-7NzyAubQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHYi2mfNs91APzXFYTCf0JCOnc5gv4cRQHz5m0B3I-XA&oe=69CD2F98"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RdnGmpCYTYQ7kNvwGkPorq&_nc_oc=AdreJFgKGISy0Ufr37Z3MmUqzjlhTdacahHYRFc8LlcOrHtE7IvdilT7StzoNHV79iE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycyIUCUdUoSD1VSXbaqyqKeN2AexqQ5dEiiYpB5dc0bw&oe=69CD14E8"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPikXwLpeLQQ7kNvwHecdMd&_nc_oc=AdqbIM_akOIsN8HY2KDsDPyF7430GJ7nGYyEgTpIv1lLbjpAhJyFYgsnFGByzFoqSm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXSFOWsnmvL_9ZU0wZjOFDgLUdyOgI5267mGfsfbeZ0Q&oe=69CD08D5"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeZSuxAjRTIQ7kNvwG06X5f&_nc_oc=AdoDjWArumhTwixy2wuiCUDgUAo8zqHChYDyFhE6LjtuLFvMcr8qVfT7v9y6Jgshy9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw52I3gNlygyyhJx36_xbvGpgTMQa08Hom9jZvX-dVZMg&oe=69CD2C37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNQub1NkSQEQ7kNvwE316Z1&_nc_oc=AdqKJ6xY7s3QPOsUuoC1AMJNGjrr0SDr9ewPyNZComvQszzcZZ5hYQ6I_-iACDE7_gU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAIRP43mN71juv50cmNp77TGRb6hJEOoGAjktn9Zlr_w&oe=69CD0BF4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
c_ohc=vwftT6cA2n0Q7kNvwHSRSnL&_nc_oc=AdrklyhgpEgDs2cb_wMqLHQHFywQVgRgE009LNyKlHLPnPkJGpDcV89XJhop8hvr0CM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ugjf-MfIela59XTYsvcsKcd8OfSPpQk-TSihVVy0NqA&oe=6A1AF818"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miaooEpTQv4Q7kNvwHFA8P8&_nc_oc=Adp_UegELBWw5NqzqAwDiN_5Bgg2J46D_zwAo1Uj3H6Wxr-WUN0O6bM1sojSbMzyzFA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kiepS3-0IZEKNAqO5t6oXPaZtS5Q4cyG3tVG4oNEEyw&oe=6A1ADD68"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JHZb7ruyuEQ7kNvwEyKFXm&_nc_oc=Adq18PZ2sDGD-SukVSXjJBJ1PEqR8VJnUGgV7K9qvCh_p5kCq9mHcs8tgIaimDAL4SE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K0mVHhg9deoRSqZL0G7OeUX1LPA2ns1gNWc1Gssg1jw&oe=6A1B0995"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rOmKwnEpSsQ7kNvwGemQ5w&_nc_oc=AdrvZs_a6cY37aWLynrS5HkhTcXga9AKmGEnR0i0gwg8cZPORCBP2HIxCx2vuaLLmt8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cx8d0feCUzwkH5grtRZ8ObqOd2TyAZRMtFfjXfU79CQ&oe=6A1AF4B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhemLVS4-G0Q7kNvwE55uBP&_nc_oc=Adq-5z2vpaf0A6346bkhICxv681oyVwF-BVFKrTnnTlxvZW44pc-HwqxE7tS0HvbgUU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zVJRDZy8Les4yIAfn1am-bq49bgsjy3odF5ClWI4eUg&oe=6A1B0CB4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
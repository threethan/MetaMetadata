c_ohc=iaNMs9Hq3YsQ7kNvwH-ZHp1&_nc_oc=Ado2rxagy4MW1P2DxfLz-kH-Srf7joiFaqdRETghNdX08AEDGdtnfrpSIHd6gVXblM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yl0GZ239o1mcif4Pzlp85aOcwt6F7S0o-v9XwLrInkg&oe=69FB5418"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q58NaGhuws4Q7kNvwFcbXmq&_nc_oc=AdpELh55MSjby6QoIsmxoqRmevcHZs_4g5vHrMTpVwjzjK4tyRr3IWvT1EpVv464J5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42klY1dwFYcW6QKzyc1q2v5vf5q6P-DlVABMc22BEu1w&oe=69FB3968"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AbCS27Y14MQ7kNvwHV9Z_n&_nc_oc=AdqghXfpi3CPgCtMZPS4giBHAaVb8aveE5TLcySU_Al7Jk9ZKjqo4bMblHEQYO-IDGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H_wBaiU6kMDVuctzFgDFqeDfVz3rmcdFydy5Q9oiaHw&oe=69FB2D55"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nQOAzDT7u4Q7kNvwGQ1Fkf&_nc_oc=Adpr_Ldg2sc36pIFVjHYBe2qeJUpBD2iVIyMy5EJc_1mtnSuDwGSPmGsXvopyI0YxLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eXPoXKanO2iwGOTFAPVnuzk-uSJMIRGD0SfyNY-Kbfg&oe=69FB50B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IiO3olCoTEQ7kNvwFRAtO7&_nc_oc=AdoNwEHpcv-0ZsudDUZIG8BqyI5xUooVhPhyZWZ8lM7QjfyzoLGanvN2u-r-BgkqZIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46EQ4ssfFJsC_AkJ4_V79GMwEWTtWI6wZx5jiKRRw0Cg&oe=69FB3074"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
c_ohc=qdIrC08gdN0Q7kNvwGP-Hl7&_nc_oc=AdrbmXAQbY6YXkFasU7HQKD4ybaM81sdVFLGt9_UbmmEg7vZsHCvZNLIiZMybr9_Hkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeeTvP5w0djI5BRnrtSZWRkqde7z2jsfuq-UVHUCxMNQ&oe=69D12418"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6BRLD0o7lQQ7kNvwHyACGm&_nc_oc=AdowZoaTRD2rqzKZ3d55g8DPmi_CSuufRreq8sYZlKenvnb4i9cRvtEeenRWKoeUa8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBxb9ggF0NqAKfbUMq818PN7syM0ji8OPd_uvPtTnVig&oe=69D10968"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vJwQySQWpEQ7kNvwEvBuTI&_nc_oc=AdqDJ6gTMT64tby_jfhK-cl5dN1oK3Kha7WNHsrWjNMAgeeuoOXzZ0fQd0X6cgca0xQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9QrVTMhs22rXWACZ7eyL5trezmispCwcLOfNbN0Noxg&oe=69D0FD55"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fJpzjZWemgQ7kNvwHN4lwt&_nc_oc=AdoQHfeWrZpGnUYBpbg7FDsByvTiXCYyuCSsgkIK9fwUkmjV0mWvqvRKHjniA_aA4O4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoLvwlQnZej5qva6j7HTy63xcUd3GUYX8bg-63o9T2qA&oe=69D120B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSv--ClBctoQ7kNvwFX--qU&_nc_oc=AdrmcVDrA435-YF8zc_Fyr8_nIoOdtxqT2PuCJjcyBtBc_oAjKQjCbrO_kzWAdyhkZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywNPV5cfpi6SGwvxS402lwFXQ-s01omNsAX3yvoDQI6A&oe=69D10074"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
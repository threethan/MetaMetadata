c_ohc=VGvNx7k_AkQQ7kNvwFGtFyb&_nc_oc=Adq91Iz65H9-OMwBItdGLk7hNsEuW--FLESda3WX2cDu8GAFs-wG-Zncoe50-0Pl10o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Uhj2_nEXg4g-V4mp_6Gjcd5lsskxO8EJzCg_3VWy6uQ&oe=69E78D98"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_YsXg87oroQ7kNvwFylYLG&_nc_oc=Ado2utyZzXWDfS8uxXk4pzALmRjG4sIRiwfmp0xu-8Yi116cUb4b00raY1PFRVE7_Xw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MJo30oNrk04cW1aUuOPxq6bfqU4HFqe9vyy5KDmUmAQ&oe=69E772E8"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXDKyDJJWDUQ7kNvwFHY3ZV&_nc_oc=Adr4jLUxVdHBYmxpzmw4tD7UcgPFRx4RxXQMRPcyB4jz-B7Es8Lj0sw8e4ABb9R1vYU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00nfedCVCNRSaJZHQAc2LNunnTd0Jfy53hf3xNLf7rcA&oe=69E766D5"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e55svKXwCX4Q7kNvwHqC10O&_nc_oc=Adr-m-TmkX7fYLdRPx_qkVz37pXUdo53F3Hb8QVQXwzMA0HQxSN9m8VKSV7ih0RpMFQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f9nabWsEBovy2dsoyzKpKHl6QhRvSMbRILf5Yg9-2lQ&oe=69E78A37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7xkfgklX9EQ7kNvwGcOfaG&_nc_oc=AdrWedknLkztTh4f7AahfYR4foS9n4uswJkXntx3v6Ve4Vfa67PWgBUyQvQ1s07oiiI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZD8jjq8PIg2vSrTPM5pArxbxBZPf5vwTwI4cXIAN45A&oe=69E769F4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
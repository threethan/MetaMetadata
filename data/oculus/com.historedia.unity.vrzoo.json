id=6e7a0a&_nc_ohc=dIuhpZ12yo8Q7kNvwFF5blg&_nc_oc=AdqE_kPbBDPOOdfNcItiW9CixBIj8xfUojb1HqM_bkRltzzvCPdgtqaMwQq8aa4xbxU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JVbGiKpQ5errIBbOoy0lQOVnsDejQBrkqfuunTaSkAg&oe=6A11BD98"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmeaXolRHFQQ7kNvwH-40MH&_nc_oc=Ado68uGUuK39H1pZzy-n24apvs8AC8aO29Ud2zww-rsd0Mi2_xtRZ_qOA2DsBGPc-JY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sk1VOembe5C0q24yO_qANbuqWzuAFdGLjHd8KGQorkA&oe=6A11A2E8"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXaR__6CZYUQ7kNvwFXBGe9&_nc_oc=AdqHM_3MloEE9W0HRP_BX4S0FtKEyQdDCwlNJZS0nV5zwK_saIFpnq7q0kkHlp6CPMY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CQo84Iw0plHzVT2qgG5wV5YY_8hPoQHK_EO7NLPszHg&oe=6A11CF15"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzxpYobQ4KIQ7kNvwE0IX7Z&_nc_oc=AdoV6jcDalbTAuaDUbAufxpOLEUcxRxhGh1yLZr1w4lzgmrZcaJioebfSaufTs0nvaA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bNg-FEJusfmbapSpdjRPZ7JQhE28D8lGdTSu4yT8LVw&oe=6A11BA37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YC5Z7zdN2UQ7kNvwHzIfxK&_nc_oc=AdoTniaNCem5-RifM4v4cSVVKPjaFejqoyViGT5GSS5-i_CIalO6Ol9yF_jekP5CC4M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47r0cN5b8GjJPJvfvn_E2rS7GKSmyUJxZJYjNZlEx5jQ&oe=6A1199F4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
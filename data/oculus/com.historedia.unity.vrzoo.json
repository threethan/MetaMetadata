c_ohc=WVczRj3ZtSQQ7kNvwFBlOvL&_nc_oc=AdqsK_IkC0GGc5NZWv-XGX1A7P_WlXteoM-TkoUxAVZF7PdsuHWfpq3GY8JvxJcsO-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ba66zHOnRzr1guGZgvmS0GXgEMvNGB7AmRqmMq9upbA&oe=69D631D8"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGmJXDdq6PsQ7kNvwFSI6Gs&_nc_oc=AdoNiLx7R8LFhKEXzQo8qMONK3c4QazIeoPx1Z1dohhHZcEtFZafMRWfdyXh8PbZk9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uQLKSmcJiu9XRVvltOo0WVYY0F_4wAhNq5dPMCyU8ug&oe=69D64F68"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxWQy6aXrnsQ7kNvwEn6frc&_nc_oc=AdqKyaU3B_R6BtrQtJlcnP4B9U7hhtFVGs0tMZcaHj2UjZXR5rknsq5Wegwwl8Ok4O0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PMydYuqazFuuuXuP2o0BEUSlRRfPMLv5LEHkUA_kyMg&oe=69D64355"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koGcL7CwT1gQ7kNvwGB3sOT&_nc_oc=AdqVx1rh56gPSS2WzRYieewNdOSCdx4D16mgMlJH5jqtQV800gce6qMqjO9h3fIE2qI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00oTGUsPQ-7PvT8QR_5IfAmSQcMF1nUqOOraQ6_p2-bg&oe=69D666B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAh6ox4lfKwQ7kNvwEDu_FQ&_nc_oc=AdrUPsUThgWmIxQH3ZuS2YiuloSaubGqTtJBwcTLX6xHW-6tSBusi82IfrQWgzGXtbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oBkoOfchY8h6hS327sUWIUvHYfTdmQ-qiGdsI0xLmZg&oe=69D64674"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
c_ohc=HI3Nn2BpjXUQ7kNvwHUpvKz&_nc_oc=AdojwrZ-a0JxlrUBCShYW26I4qMftW1PQuIBmMeCSYFptgbPmUyW5dsGFq8gP6hxvxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XDybcmGRw5R9eLR8zoXdZnqPjD92rvVfR9_CeCsr2Hg&oe=69DE5318"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcMqEgbAQkgQ7kNvwFim-cX&_nc_oc=AdrSS-i70pxK2acc3RATL9JKNJQaAxmS0PngNdWlwX26C3lS4-80kv37_O2S37W3_X4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kulLQd72uy54YhWVACSNtwGlxDdIIW7CJ3m4aLVtITQ&oe=69DE3868"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9KggdiMZrIQ7kNvwGg7rA5&_nc_oc=AdouCEyZbzM_zLEnbQyQAXCc8BKq9Tla7seg-s1HUOK50xLrZvNdPfEkJY0U1bYBEYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13RVy8B1fHW7iRu3lzZgKsIZkCCnmVEZ27nsDbCxOfqQ&oe=69DE2C55"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbH0twP05ycQ7kNvwH-bWJ4&_nc_oc=Adqe_aL1SDEnqpy9KkTQ76KR_7CUEgzvd7IjokrmXaX5d-dWC7K4pB0Qw4PsIpAFgvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af123KdVW-d0-LVO65FUg5oSufRmkCxVZD3yQg_F2wcu9A&oe=69DE4FB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWra24VSV5kQ7kNvwEL7ZtB&_nc_oc=Adp2mXNVD1Xv8zkqy4QC_jbH4K3mjT86AXTQs61879Amb53Nghv9KGbhDkiZMBhe6TQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gvyPYzC9gU9Q4CbSflC9GcJwhmm7vrRfdMFyoAuhfuw&oe=69DE2F74"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
c_ohc=IAUtpJsCuxUQ7kNvwHSLzX9&_nc_oc=Adopkvp2hk4w9_PjGPdMaJgHMejG8pxsisbsOkjeiqE0Bsl1gzij4zE28yDY7jVKSFM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiXpoqawKzgRag23piL_FddxDDrpqSpgqxECdV3CTYXw&oe=69C54698"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RPlnCjP0ZgQ7kNvwGSu-y_&_nc_oc=AdoOYgu0_27DsaDpmBG2nIAGKeFxLJqL8A29dVrV-hCJ3T7UUnla7J48LagrftahYgA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOoREKEuBlr0bdwdGc5svtRze1iYZrEOtmsT5F1LEBzg&oe=69C52BE8"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0G_3A8wqxDcQ7kNvwGm0Q_C&_nc_oc=AdpVfvP3pNeOP8O0MYWXUDtHqHUXSelsQxf8Ue1vn_tDoe2bfTb30AARmj0WFB-RjDk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1DO-KXdl6jBWgu87r7-53_Jmh3G08VHvDO0hseUcJng&oe=69C51FD5"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No6oKOruDgsQ7kNvwGHQCe7&_nc_oc=Adpp0AaZF7e7wXvpCu-569UXxAH1EWTn7ZtR2OlnINfrZ0fW_oa1dDdVqlOWDbCo57M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTgpM1JDDfSk2qLMjWcgLt_Z7J8sYjCIM3oWVqvES4xQ&oe=69C54337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBoQMU3A8iIQ7kNvwHpwHrO&_nc_oc=Adr88QAW0CCBPsMOlaysmvamd_N2Cf6Iio1-Gedke5XMqzcNNuSrht33R5G0_nwkg4s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnZ9Cf-S0dgvFkWPEpsvtJbxPIK85x4xqgW64p4rhwdg&oe=69C522F4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
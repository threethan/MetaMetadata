c_ohc=dAPgWDqVqiEQ7kNvwFKF70x&_nc_oc=AdoCS6N1ZF-YsmPZXomZgQpy_2WfE4iegnvxGI7_vaKIxnJVSmT7XyDaY3mi5IjOv-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30vLnXUYGuAFcgOxJP94uEfJjOHYdjsFyqnnmggq2G-A&oe=69F8B118"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q58NaGhuws4Q7kNvwG0khmr&_nc_oc=AdpuqN2WJrGfAhflGCgbvf0TYegY8Jy6jjSgmRwRQ-YOrAhVlpgFAbxDjVJ4hhHJKX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TUFG9XjOwqZ0ieJvP_rSaVHuPoH065MRZ6nBJ2YUzFA&oe=69F89668"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AbCS27Y14MQ7kNvwFmI1ud&_nc_oc=AdrUGkwr_TgL1ntTXVvyM6f7lQCAFq14vPrMRwrwqCg3sDRHFR_RI_luVqqN82rSp0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SSp3frsL1KklbxvBqa9qj9bsahDpu1yXiCs1tpRqJVA&oe=69F88A55"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Fn2S4E_QEIQ7kNvwGJWeiP&_nc_oc=Ado_y-EyxQMtIeNl5Hy6D33RKSY51XIgfoJdEPbiFMKBuS1fQjpUmSTwcIRQup1yy_0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tv4BWqIHoTzTyq8hxSIdvbOCo9igrSAW9BPsJ4D1yBQ&oe=69F8ADB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKKsYgwcJD4Q7kNvwHMImZn&_nc_oc=Adp79HoFbCjcdNTQbyxVz4AOcj8j2NWT9-8ltwQIqpkSGiR2Ew3dl7h5DRX9LW-tj40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iSfNPnf_lEbtnrutYbqLZaxsLRQ5FF9xgB3Lvra3ZnQ&oe=69F88D74"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
c_ohc=zwFAqC0-nYEQ7kNvwGYc3jL&_nc_oc=Adr-dk0ooG1WkexLsZ_D_dh7gxHSDCAv1kozLZdwR3jA8BDDeX--edh_NshVqYmTwfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ebg5JjO_HD_ABTIJFwqNCB1B6RkwXtkQ3kQV1-3Nyww&oe=6A05E018"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDbUwH7alToQ7kNvwElp6k1&_nc_oc=AdqE-aZw3DYxn9ZvFTIUcfjy6Q7sm_c_1N-GieTKfrAADcP2TgpEeZEj9R2kgNBa8hI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DcXp1rJbgoi2-ta_F4jdcZFwcvKATLSSN0MNsgOCQWA&oe=6A05C568"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Hwlu96I11QQ7kNvwHi0BCo&_nc_oc=AdqPWumOnZhs-VENxhpdZ0mLEnjZW1Ow_d-TtnKiu34NU0MVhmG8U4w3Dlx9P4pjIeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HXPlFuzv6FtSn5KdySEQ-lZwRyd4RL-i78h6yNzqCtw&oe=6A05B955"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWI15DV-bKEQ7kNvwF0rZDJ&_nc_oc=AdrlSnomLd_LCAxQRgbSAPjsnXNuqnKyaiAzUL7Ph0-7dQo_XIgTkGjxzWAakUUCVas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zOSqkCtaHRFUCHeVZDdzyde9NSlEeSXhF2cZw1YGQLA&oe=6A05DCB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXy6dtg0E4EQ7kNvwGL45zV&_nc_oc=AdpPNaOjPsowEnDmb-vc8YvbLQ8k70-tBaSefY94P5I5UaTJwjLUaOfK3qtIvhnlSFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IqH6oUXYBwlTjkk8MbfTJXvEqBhhp1OGdNuy9DGQrtA&oe=6A05BC74"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
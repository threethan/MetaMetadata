c_ohc=HI3Nn2BpjXUQ7kNvwE5thIw&_nc_oc=Adr62kg1JOSWeV_HZToVI9eEKJ32qLacTcHhijBphk8RxhCectUQKKRx5P0aK0PEloo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lvwcivUO1kbzfWnFHy7cqNdgQJgp_JDw3llSK64sVqA&oe=69DFA498"}, {"file_name": "s4.png", "id": "1110197043850916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982458_1110197047184249_2881444081915904517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcMqEgbAQkgQ7kNvwH5TgUY&_nc_oc=AdrjmROkF6FGZjtLf2fA__fqnuMvGcZhY34BWzwe-Utk2Bh-wKjPHYEbeURK5WEz5Oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LS3gr5qwwYyccoSYSV2NZUjhczyIpSactRDHqXfPSbQ&oe=69DF89E8"}, {"file_name": "s5.png", "id": "1223543632061942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75303840_1223543635395275_7573664584271116405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9KggdiMZrIQ7kNvwH01L3J&_nc_oc=Adq3p6ACwvS7xhdWgELqRzRI2DdHQoPD36j_q5FdNpoB2gxtrq5hMrUO2Pci8jKu0eE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SEShzElndLfm-LcPG18m_zhyy_MjcqNdjzhVopx00Mg&oe=69DF7DD5"}, {"file_name": "vrzooscreen5_2560x1440.png", "id": "498396525986771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031447_498396529320104_8235631405721114724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbH0twP05ycQ7kNvwE2fkL0&_nc_oc=Adr3wxwGbcFuRHcO6iJF_bRcKCv4E1DtGSjU41vqEWqAFzF8f2ik1RxO4vn--MHJoNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f4T2mac38TkaSf0mUsqBEFs_5spCVigSTSAVqqQz6OA&oe=69DFA137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560x1440.png", "id": "9106899822708399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207243_9106899826041732_3868966364404116440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWra24VSV5kQ7kNvwGNQK5t&_nc_oc=AdoZ8DvF39lHaCR4oKzudqr0yNkiIwoFTmik-Fz4m4uTuiLb9CVm5MOoDDx2ePhuLo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CPg1je1Oz85T5HjRyOG8C4bM8puEwcp6kaeI5SIssZA&oe=69DF80F4"}, "display_name": "VR Zoo", "keywords": [], "long_description": "Step into the animal kingdom like never before with this immersive VR experience! Choose from 17 incredible animals, such as majestic lions, powerful tigers, playful bears, and towering giraffes. Each animal comes to life through stunning 3D models and realistic animations that showcase their natural behavior.\n\nFor select creatures, dive deeper into their world with captivating 180-degree VR videos filmed directly in zoos, providing an authentic, close-up encounter. Whether you're a wildlife enthusiast or simply curious, this app offers an unforgettable journey into the heart of nature.\n\nAnd the adventure doesn't stop here! We're continually expanding with new animals, videos, and interactive features to enhance your experience. Stay tuned for more exciting updates and discoveries! Perfect for animal lovers and VR explorers alike!", "short_description": "Explore the wild up close in this immersive VR app! Choose from 17 animals, including lions, tigers, bears, and giraffes. Experience lively 3D models and watch captivating 180-degree VR zoo videos for select animals. Stay tuned\u2014more amazing content coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/vrzooprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/vrzoo.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
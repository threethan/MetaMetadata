.com&_nc_ss=8&oh=00_Afxi6LvyzQdenydvaJOWgXZdAoqH5gjanD_QQHoTBYiYIg&oe=69AEA5EC"}, {"file_name": "metalogoscaryahgorillaWOW (11).png", "id": "1357324762140289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391890_1357324765473622_3573307445257390025_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqS0EpkJkd0Q7kNvwHDONeK&_nc_oc=AdlZT49U4NWXqYXUpuJV0z4GYOwdjGuouEzuu8KMwRHPQaWdH5JBDORkgAD2RYjJNro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2Ul3CIMx-ffIitDeoH8zCaB3ufvE7BLeOlZJ119qSyA&oe=69AEB749"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary B\u0430boon", "keywords": ["Gorilla", "Baboon", "Monke", "Monkey", "Scary"], "long_description": "Run, jump, crawl\u2014heck, scream if you must\u2014do whatever it takes to survive in Scary B\u0430boon! It\u2019s a wild survival challenge with monstrous creatures hunting you down. Whether you're fending off a giant beast with a traffic cone, hiding on a shelf, or sacrificing your friend to make it out alive, the chaos and fun never stop in this multiplayer VR horror!\n\nMake sure to join our Discord Server: discord.gg/gtag", "short_description": "Run, jump, crawl\u2014heck, scream if you must\u2014do whatever it takes to survive in Scary B\u0430boon! It\u2019s a wild survival challenge with monstrous creatures hunting you down. Whether you're fending off a giant beast with a traffic cone, hiding on a shelf, or sacrificing your friend to make it out alive, the chaos and fun never stop in this multiplayer VR horror!\n\nMake sure to join our Discord Server: discord.gg/gtag"}]}, "developer_name": "Goofball", "developer_privacy_policy_url": "https://sites.google.com/view/scarybaboon3/home", "developer_terms_of_service_url": null, "publisher_name": "Quantum Games", "support_website_url": null, "website_url": "https://sites.google.com/view/scarybaboonweb/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
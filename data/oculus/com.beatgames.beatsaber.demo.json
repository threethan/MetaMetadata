content-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jEpBoEdIb9yT80FxDR1qYFDzXF5q1kqk5V80TLbGpVg&oe=69FDEB58"}, {"file_name": "migrated_image.png", "id": "226409608511670", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974585_2513703168704987_7810588664194400256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd9B3lne9mMQ7kNvwEjUXII&_nc_oc=Adqavv57NPxUmZnEWcQ9WCcGf_DQWjTomO9BRCjmrx3jVAc7mwH2ef6YPKgzfXEj4e0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VOl4ZIFHb6m3Y6VjlaR5QJyele8DV5qEGoq8Kchdmgw&oe=69FDF931"}, {"file_name": "migrated_image.png", "id": "672745893466810", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974554_1294809350683852_1749506472204566528_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3AeUQEVFYMQ7kNvwHOJT0W&_nc_oc=Adqlla_S-iQwAV94w8nFzAn8nYOu7SLH8vVqpKqBBNVqR-cc0y06c-1z31UcT7naTSY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-j4UoB6W1kaX-wiKSRc6cVmUIHLCZ8_2i1-fvyXgFHA&oe=69FDEA9E"}, {"file_name": "migrated_image.png", "id": "632898920776287", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031371_1744385042373777_6858567823975776256_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImZN7k7XBNsQ7kNvwFcazPK&_nc_oc=AdoFNkWr_qNFCNv0jrs6tAaywbEW7gb7JcdwSO3FFQwBk4y6TreWa_pcr_8eDHLZ8A4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dWv_DhUP06wROU1blXJPicCfRy-LtC_XD5zCWxQXrSg&oe=69FDD45F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Saber - Demo", "keywords": ["free", "games", "best", "demo", "fun"], "long_description": "Beat Saber is a unique VR rhythm game where your goal is to slash the beats (represented by small cubes) as they are coming at you. Every beat indicates which saber you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. Our goal is to make players almost dance while cutting the cubes and avoiding obstacles. Each cut is strongly supported by great sound and visual effects to emphasize the rhythm.", "short_description": "Beat Saber is a VR rhythm game where your goal is to slash the beats which perfectly fit into precisely handcrafted music."}]}, "developer_name": "Beat Games", "developer_privacy_policy_url": "https://beatsaber.com/doc/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Beat Games", "support_website_url": null, "website_url": "http://beatsaber.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "511891406932417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974480_2249125205120340_7388791226113196032_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ050Kzayr0Q7kNvwEJ7g9T&_nc_oc=AdqP7Mw7ryWX9jwFrFKD2UjeUqWzCuFiNr5EoB_L9E3gcZu1LnknWM4PtNNJ1Wai6Ik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kbRNXbfkEkAv4spIUxH8Pcx5WjTMJMz37YUZjuPhs6w&oe=69FDD5E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Saber - Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 15
_ss=8&oh=00_Afz2jeojJnoyMKH1PYCc9cwf1Z9duUlSfWyIQmkKwLnyhA&oe=69BAAED8"}, {"file_name": "migrated_image.png", "id": "226409608511670", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974585_2513703168704987_7810588664194400256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEnO7YCt8noQ7kNvwGvXduG&_nc_oc=AdlR4rO3WiriKTz_2FDyJmMX116IV_9Y86rVK8rLx1mSQI0zFtyHesn6etgz_WOT8HE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7VCpMSA5ona2tloTuAUOVMOu4_BbJupvaz_zLH8jmIQ&oe=69BA8471"}, {"file_name": "migrated_image.png", "id": "672745893466810", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_1294809350683852_1749506472204566528_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGvQTLzkJDYQ7kNvwEZV7IL&_nc_oc=AdkfFkaqv-czVIIyqPWJEteRbWu_ZCte6ekIR6YPcdJE3D-MdS3CFACUwUfNZkDcxHA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhYvYnQpsbJDAk0S4uPFvmsS9K0FMv1rdDSAaiazUnEA&oe=69BAAE1E"}, {"file_name": "migrated_image.png", "id": "632898920776287", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031371_1744385042373777_6858567823975776256_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEn4T8pJ3CIQ7kNvwGkIOkL&_nc_oc=AdkJqKUvpur1qsVbtIwIXyQxyCrmyB3wAM5vu-gagc6I447e6ZQShh-pjgNI7t97xLc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkA0Rz9-9f3uUeTMeiqaEUOHiz5UiX7ZO-jIQzEvheoA&oe=69BA97DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Saber - Demo", "keywords": ["free", "games", "best", "demo", "fun"], "long_description": "Beat Saber is a unique VR rhythm game where your goal is to slash the beats (represented by small cubes) as they are coming at you. Every beat indicates which saber you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. Our goal is to make players almost dance while cutting the cubes and avoiding obstacles. Each cut is strongly supported by great sound and visual effects to emphasize the rhythm.", "short_description": "Beat Saber is a VR rhythm game where your goal is to slash the beats which perfectly fit into precisely handcrafted music."}]}, "developer_name": "Beat Games", "developer_privacy_policy_url": "https://beatsaber.com/doc/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Beat Games", "support_website_url": null, "website_url": "http://beatsaber.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "511891406932417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974480_2249125205120340_7388791226113196032_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jywsXwkkwegQ7kNvwHz3Ma5&_nc_oc=AdmcJNBdbhGEkknoA57Iiq4aF5NrkxzlUZRL8pI30SS6uEPg7w0FDmkRVYZHWuFsRNo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztaN_6PECVpEt1crPpXfjgxgFXOkXVo_7gX_Geeguthw&oe=69BA9962"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Saber - Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1558450200, "lastRevision": {"nodes": [{"id": "2130322
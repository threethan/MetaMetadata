_ss=8&oh=00_AfsrgviXNLK_58H0-USB9DZ9OA9TMG2xzlyEbJbYT1eqZQ&oe=69A98B58"}, {"file_name": "migrated_image.png", "id": "226409608511670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974585_2513703168704987_7810588664194400256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKQ3guEn9JoQ7kNvwHLwz9-&_nc_oc=Adk8paImx1h6UB7zJ39eOTAUF7YyAEBKfsG47AkypmmzmL0AsG5mnTwiN1N2vaIQoKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs5cl2BMDF1-t545UPnK38w3U1_Q7BbBBN8T7nsfAiS0A&oe=69A960F1"}, {"file_name": "migrated_image.png", "id": "672745893466810", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974554_1294809350683852_1749506472204566528_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfJEdo-hcMYQ7kNvwECI2Kv&_nc_oc=AdlcQ6URRhxylDJtzjAwUU5CdBD9iDYR0lCrC5yDtoKclP7ZBiwC7apZkH0huPXqCDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu_hWZad_KsvEze7B0pX8EatbGcMPapZbFnAHo629hLvg&oe=69A98A9E"}, {"file_name": "migrated_image.png", "id": "632898920776287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031371_1744385042373777_6858567823975776256_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ixuYSjyzY0Q7kNvwGjsc9p&_nc_oc=Adl5ehjYWWybfaLdw5Mjzp9FbGg7L2cQBnfn50OUIP4zhls27LLgfxms1CVmEBNhkaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvwXPt8yDiKXGzzDEWBteTNgnW4IKiO-nirPt3YPqHVLA&oe=69A9745F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Saber - Demo", "keywords": ["free", "games", "best", "demo", "fun"], "long_description": "Beat Saber is a unique VR rhythm game where your goal is to slash the beats (represented by small cubes) as they are coming at you. Every beat indicates which saber you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. Our goal is to make players almost dance while cutting the cubes and avoiding obstacles. Each cut is strongly supported by great sound and visual effects to emphasize the rhythm.", "short_description": "Beat Saber is a VR rhythm game where your goal is to slash the beats which perfectly fit into precisely handcrafted music."}]}, "developer_name": "Beat Games", "developer_privacy_policy_url": "https://beatsaber.com/doc/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Beat Games", "support_website_url": null, "website_url": "http://beatsaber.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "511891406932417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974480_2249125205120340_7388791226113196032_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee1gOaPlq6oQ7kNvwG03Uzp&_nc_oc=Adm3ZPUmqsVldRiwwap8Z-PMlBQJBXOCmb3o1XE6yg6gc94ify_i1u2XFFJ3-vsldgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvbfGGKFKSOxQ8Wl75RaC3o8GAVl2xbyXVvPfqTsVpZ8g&oe=69A975E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Saber - Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1558450200, "lastRevision": {"nodes": [{"id": "2130322
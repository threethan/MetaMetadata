content-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BUjcb_3NmFrTcJb7-qzM3JJnSxBcdDLTdUC13kgnTIg&oe=6A16F7D8"}, {"file_name": "migrated_image.png", "id": "226409608511670", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974585_2513703168704987_7810588664194400256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5NBveo-rBMQ7kNvwHUYBcE&_nc_oc=AdpRpL_9tzBcsOU1wy9FvU99bBp7XlRvIxCA1x6ayJ1aJvXhedg1M9w49rDRalpFuu8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ouGl1oSgwFarQP-51j4YCce6TpL-gNLHiyC-eWh0vtw&oe=6A1705B1"}, {"file_name": "migrated_image.png", "id": "672745893466810", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_1294809350683852_1749506472204566528_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTpDSz3Da1EQ7kNvwHiYBKh&_nc_oc=AdoSDJMF9TF8Egz3Dv3bUauAHhJaEXnkOFserNgfERVACEaJPGCEp6aa0AxRnQjFGCQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76OFOi3aeLoaw6dGkRIim9mwEKjk8lhreFPttzjqxEKg&oe=6A16F71E"}, {"file_name": "migrated_image.png", "id": "632898920776287", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031371_1744385042373777_6858567823975776256_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgO_5KIjKhgQ7kNvwEtWB2A&_nc_oc=AdoDP8nbRdnd8oI4xxFz3BI7FYaiJlRKpTKehbeA8Xt5sZjf0sqVP6IfORPz7T2IwyY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6StzWiM_nrjYzzwudQpvZ6my7USenl6OUXzoutui5S0w&oe=6A16E0DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Saber - Demo", "keywords": ["free", "games", "best", "demo", "fun"], "long_description": "Beat Saber is a unique VR rhythm game where your goal is to slash the beats (represented by small cubes) as they are coming at you. Every beat indicates which saber you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. Our goal is to make players almost dance while cutting the cubes and avoiding obstacles. Each cut is strongly supported by great sound and visual effects to emphasize the rhythm.", "short_description": "Beat Saber is a VR rhythm game where your goal is to slash the beats which perfectly fit into precisely handcrafted music."}]}, "developer_name": "Beat Games", "developer_privacy_policy_url": "https://beatsaber.com/doc/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Beat Games", "support_website_url": null, "website_url": "http://beatsaber.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "511891406932417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974480_2249125205120340_7388791226113196032_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ueTtpHIKv0Q7kNvwHw-56U&_nc_oc=Adphueo0eX3nb2Nap0AwCYzX2cV3I3-ZexgiSzBTXomJXTKwIBK2c7S_SeLDSWEgNno&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s0GllgmK81W1YVMSTs2jHEq7EmkhgqenvdBEk23PK-A&oe=6A16E262"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Saber - Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 15
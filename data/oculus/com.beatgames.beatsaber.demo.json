_ss=8&oh=00_AfwQni3wmGobG1VFONMXWvnO47b5Zv9v37rcG64ZFjpwYg&oe=69C14658"}, {"file_name": "migrated_image.png", "id": "226409608511670", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974585_2513703168704987_7810588664194400256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW9GQrNrKyEQ7kNvwF3n5KH&_nc_oc=AdrhOFUP-njXgpt8qI08thwYs1trNQru6tXBQ5HbXJx_OGIqaoT4_rhLsgD5K6siAY4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzI11GhADpPlvfJNQQYYH81pF-469RZH8oevwe51mfFhg&oe=69C11BF1"}, {"file_name": "migrated_image.png", "id": "672745893466810", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974554_1294809350683852_1749506472204566528_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FAHQiX4hzcQ7kNvwH_nwpU&_nc_oc=Adqp9S5GPMhGUAhvE-Q7jbGAvhqYZ6dDyEqfAjbszNHFy4WcXouSFmQmO_2eTjhv-jg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2GRLM5KhMEFm3i696858bPMiZKKwgu4EmuUAWrXSC-g&oe=69C1459E"}, {"file_name": "migrated_image.png", "id": "632898920776287", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031371_1744385042373777_6858567823975776256_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDBYx2T2g9cQ7kNvwHG9mn1&_nc_oc=AdotuhZ75E3Q1ghmXuDxwIRQ7qCVQgZBAjaP7YeyjXKdywNiLIi8K4SnPSe2WnDXIJ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwn1OHdG2Y1_ceEWK8N9lrItm_qof8e22kCm_QNPww0lg&oe=69C12F5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Saber - Demo", "keywords": ["free", "games", "best", "demo", "fun"], "long_description": "Beat Saber is a unique VR rhythm game where your goal is to slash the beats (represented by small cubes) as they are coming at you. Every beat indicates which saber you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. Our goal is to make players almost dance while cutting the cubes and avoiding obstacles. Each cut is strongly supported by great sound and visual effects to emphasize the rhythm.", "short_description": "Beat Saber is a VR rhythm game where your goal is to slash the beats which perfectly fit into precisely handcrafted music."}]}, "developer_name": "Beat Games", "developer_privacy_policy_url": "https://beatsaber.com/doc/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Beat Games", "support_website_url": null, "website_url": "http://beatsaber.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "511891406932417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974480_2249125205120340_7388791226113196032_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKE67NJGLZgQ7kNvwGtvUqD&_nc_oc=Adq6LN6b9CvuCg9pm_NwTwuzrwMsmmOZmrB-CsegIYAZM1aSRWRMC2Lhhol1Wy6sRUA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzdr_Nz3HsYagK4566wsQjvQX511X6XxON-oXJkBOgKow&oe=69C130E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Saber - Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1558450200, "lastRevision": {"nodes": [{"id": "2130322
947447212664_6395978528347356670_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GGCuqY4XCIQ7kNvwENWcwx&_nc_oc=AdqBwMAAEv2RdovfQfyEcMpqX5E46jgfbbzcEdBCpDPrXT1v-DfTSNV1MWMk7vGtOaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp7I3msJ-Lllpp-j7RiM8xU1L-ASejOk-dlLYubGtrow&oe=6AE1F81F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer thumbnail.png", "id": "566604454032833", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031309_566604470699498_302973466358571206_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kO6nWCKxewQ7kNvwGsHzJh&_nc_oc=AdqciecM8wbQ_OF0R1bR3IIMPZzwGmhFnt_fUAQECKC5PT_kPW9xcsSnQ6djB2ULANM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY6YfC5wlV0Di0F6XDVdEes8miDRqn9DFbcYm-AMGLRA&oe=6AE1F28F"}, "display_name": "Home After War", "keywords": ["Iraq", "War", "Explosives", "Documentary", "Journalism"], "long_description": "\"Home After War\" is a room-scale, interactive virtual reality experience that takes you to Fallujah, a city that was, until recently, under Islamic State (IS) control. The war against IS has ended but the city is still unsafe. \n\nThere\u2019s one looming fear for returning refugees \u2013 booby trapped homes and improvised explosive devices (IEDs) in the neighbourhoods. Since the end of the war, thousands of civilians have died or been injured by IEDs.\n\u200b\nAhmaied Khalaf and his family returned home after the fighting subsided. In the experience, you find yourself in his home, which still shows signs of the damage from the war.\n\u200b\nExplore Ahmaied\u2019s home by either walking physically or teleporting in the space as he tells you his story. about returning to a home that might be booby trapped. \n\nHear Ahmaied speak of his loss and his hopes for his family, country and the world. Learn about what it's like to fear the home you once loved.", "short_description": "What if your home becomes the place you fear? An Iraqi father returns to Fallujah to face the threat of improvised explosive devices (IEDs). Through this virtual reality experience, join him in his home and discover the unfolding of a tragic event.\n\nWARNING: This experience contains disturbing content. Viewer discretion is advised. It may not be suitable for people with photosensitive epilepsy or post-traumatic stress disorder."}]}, "developer_name": "NowHere Media", "developer_privacy_policy_url": "https://www.homeafterwar.net/", "developer_terms_of_service_url": "https://www.homeafterwar.net/", "publisher_name": "NowHere Media", "support_website_url": "https://www.homeafterwar.net/", "website_url": "https://www.homeafterwar.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "ar", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "660245665316323"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2610231056109239"}, {"status": "PUBLISHED", "id": "1006832816443295"}]}, "baseline_offer": {"id": "2610231056109239"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791380340, "status": "PUBLISHED", "id": "2610231056109239"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6170852472950042", "version": "1.1.6"}, "id": "2906591256087718", "channel_name": "LIVE"}]}, "i
ng", "id": "2123113377819305", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572925_2123113381152638_1453897916701716489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqMzXCF035IQ7kNvwFiF-pa&_nc_oc=AdqXxD6npqQeXKkZZJ9MpQZWX87BoMBe_A8ahb93RivI67xojuLU8Q6tuFzx19_CPCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6VWv2aKHJiMrT9Z0u5dwajh8sA-XQt3DxqmwkpRNSIw&oe=6ACFAF2A"}, {"file_name": "Screenshot (19).png", "id": "1269994576671211", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974703_1269994580004544_4179477739931592187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EBMC6Z43K0Q7kNvwG6wO3d&_nc_oc=Ado5BsJxV0g2Fyj1CxeMCZv0QEBIZApCJKsC-JRO7XmC-5WkKzr0il6sk9gkq5wj8lk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf0jU4GdmJy7Z-_ZMZKYV-HvojJQ0G11F1M87f5BcjUg&oe=6ACFAB7F"}, {"file_name": "Screenshot (23).png", "id": "3849690251724206", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_3849690281724203_3911670020795902398_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTRKgTCke6gQ7kNvwGka-_7&_nc_oc=Adq-69XixBiFiGLdpWtN-9Uwc7Dq70U5KAZSCuApbSuEhHfYSaHOVKBErlGjU6C1pCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6Gam7WsK68V5B1ZThdVmaxSOsFgKvKXbhh4DSVlo71g&oe=6ACFB43D"}, {"file_name": "Screenshot (8).png", "id": "274677690267480", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_274677693600813_898934355073785036_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB16T_ClTYkQ7kNvwHCc6H-&_nc_oc=AdouiRtYodqdhtjpdS7ILrbtsk-wTkVMRnKGhW7fGx-CoC61MoXnt0aliMhbEY95H78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNScWqOd09mkQselOCmZbppeK2xWjOAkJTIXylDKwnbtg&oe=6ACF832E"}, {"file_name": "Screenshot (5).png", "id": "2330947443879331", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_2330947447212664_6395978528347356670_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jelpepq8fqgQ7kNvwG890Gm&_nc_oc=AdronP18NP4NxRk98HjDVKT1RV4_c2ggR8xkJqqdZ2UbrqkUerg8bgwxSiJPNdBud4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeHc_VJdnApcXyp5H6e61-ksEsxxqTrUZYjfR03ZyOWg&oe=6ACF831F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer thumbnail.png", "id": "566604454032833", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031309_566604470699498_302973466358571206_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNw6qWSfFNkQ7kNvwGSL2a8&_nc_oc=Adr4fLhDT4ilA5gKWZ4fIFsF9UaCOXtpPC3qdvrZCfqGkboTMJMy7yWPayfFM2f5Eyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl9rPiPI05-ilN5UaZPyVu6uCQ6zP6e5DG6LHsNtXYFw&oe=6ACFB5CF"}, "display_name": "Home After War", "keywords": ["Iraq", "War", "Explosives", "Documentary", "Journalism"], "long_description": "\"Home After War\" is a room-scale, interactive virtual reality experience that takes you to Fallujah, a city that was, until recently, under Islamic State (IS) control. The war against IS has ended but the city is still unsafe. \n\nThere\u2019s one looming fear for returning refugees \u2013 booby trapped homes and improvised explosive devices (IEDs) in the neighbourhoods. Since the end of the war, thousands of civilians have died or been injured by IEDs.\n\u200b\nAhmaied Khalaf and his family returned home after the fighting subsided. In the experience, you find yourself in his home, which still shows signs of the damage from the war.\n\u200b\nExplore Ahmaied\u2019s home by either walking physically or teleporting in the space as he tells you his story. about returning to a home that might be booby trapped. \n\nHear Ahmaied speak of his loss and his hopes for his family, country and the world. Learn about what it's like to fear the home you once loved.", "short_description": "What if your home becomes the place you fear? An Iraqi father returns to Fallujah to face the threat of improvised explosive devices (IEDs). Through this virtual reality experience, join him in his home and discover the unfolding of a tragic event.\n\nWARNING: This experience contains disturbing content. Viewer discretion is advised. It may not be suitable for people with photosensitive epilepsy or post-traumatic stress disorder."}]}, "developer_name": "NowHere Media", "developer_privacy_policy_url": "https://www.homeafterwar.net/", "developer_terms_of_service_url": "https://www.homeafterwar.net/", "publisher_name": "NowHere Media", "support_website_url": "https://www.homeafterwar.net/", "website_url": "https://www.homeafterwar.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "ar", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "660245665316323"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2610231056109239"}, {"status": "PUBLISHED", "id": "1006832816443295"}]}, "baseline_offer": {"id": "2610231056109239"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791380340, "status": "PUBLISHED", "id": "2610231056109239"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6170852472950042", "version": "1.1.6"}, "id": "2906591256087718", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinar
ng", "id": "2123113377819305", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572925_2123113381152638_1453897916701716489_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqMzXCF035IQ7kNvwEcizPk&_nc_oc=AdplIu_VRpk3fFlN0WJ69YFp5QRXafanRweICa-KmYlYnIIJeexfg8MIcz78tFoIjT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwYw5IpwK-iB5k8ZOILacwDF8sAC-J8U0DhN9ozMUZlQ&oe=6ACD0C2A"}, {"file_name": "Screenshot (19).png", "id": "1269994576671211", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974703_1269994580004544_4179477739931592187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EBMC6Z43K0Q7kNvwEMm_bP&_nc_oc=Ado8IEVDJPHMGtHGt_FM5FDdCrwUldtd-AsdKVw4gnp-cxg5rT_ayC42n8ZI4xGhnjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1mkC-Kb1PCSxtQva6KIeodndXhcLkDPPXnS2KRmFudg&oe=6ACD087F"}, {"file_name": "Screenshot (23).png", "id": "3849690251724206", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_3849690281724203_3911670020795902398_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jouw2fWUfl0Q7kNvwG32jfm&_nc_oc=AdrgRsBFOHnhRYQ4NoRgW1xt13WqA3hSAGNkxYKohuY5ac9kUSXmrOSJ1gqZwsGaY8w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_mvLP0f7T_v1axGuC1mgOtU83OuwgIr431tS-29ZMLw&oe=6ACD113D"}, {"file_name": "Screenshot (8).png", "id": "274677690267480", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_274677693600813_898934355073785036_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB16T_ClTYkQ7kNvwFdebvD&_nc_oc=Adpw4u3sllvU7lIysw5WBnBYiPROBoC9HDGkLMljZn878wMZHEAcIq5NgM4NgT0UCtg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV0h8VDyi5Akab0IJ4p-SgzXvU57Y4AnHiogWnlCVVjQ&oe=6ACD186E"}, {"file_name": "Screenshot (5).png", "id": "2330947443879331", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_2330947447212664_6395978528347356670_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jelpepq8fqgQ7kNvwH8Hrdy&_nc_oc=AdoFaX0a4FSMnb9WFbLVz_oLXCw4Bpo5OvxPjZTWjMOv-c6DIqopetZW8ped2kbhCrk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUOw6rVv3VOtDAT1-r26-bN8huSDWdPMZuMDB1ZvCx7g&oe=6ACD185F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer thumbnail.png", "id": "566604454032833", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031309_566604470699498_302973466358571206_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNw6qWSfFNkQ7kNvwHmcNY5&_nc_oc=AdqNF-CjcIyQYImzihMhqzBTx9380T_g0Z4LweUpCnozGTPvW9g4Ptq0ul4UZaJpi4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnJkcwMk0GCJq4FkXP2IfdiNHcbo5oBPtW4fX_LYPrTQ&oe=6ACD12CF"}, "display_name": "Home After War", "keywords": ["Iraq", "War", "Explosives", "Documentary", "Journalism"], "long_description": "\"Home After War\" is a room-scale, interactive virtual reality experience that takes you to Fallujah, a city that was, until recently, under Islamic State (IS) control. The war against IS has ended but the city is still unsafe. \n\nThere\u2019s one looming fear for returning refugees \u2013 booby trapped homes and improvised explosive devices (IEDs) in the neighbourhoods. Since the end of the war, thousands of civilians have died or been injured by IEDs.\n\u200b\nAhmaied Khalaf and his family returned home after the fighting subsided. In the experience, you find yourself in his home, which still shows signs of the damage from the war.\n\u200b\nExplore Ahmaied\u2019s home by either walking physically or teleporting in the space as he tells you his story. about returning to a home that might be booby trapped. \n\nHear Ahmaied speak of his loss and his hopes for his family, country and the world. Learn about what it's like to fear the home you once loved.", "short_description": "What if your home becomes the place you fear? An Iraqi father returns to Fallujah to face the threat of improvised explosive devices (IEDs). Through this virtual reality experience, join him in his home and discover the unfolding of a tragic event.\n\nWARNING: This experience contains disturbing content. Viewer discretion is advised. It may not be suitable for people with photosensitive epilepsy or post-traumatic stress disorder."}]}, "developer_name": "NowHere Media", "developer_privacy_policy_url": "https://www.homeafterwar.net/", "developer_terms_of_service_url": "https://www.homeafterwar.net/", "publisher_name": "NowHere Media", "support_website_url": "https://www.homeafterwar.net/", "website_url": "https://www.homeafterwar.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "ar", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "660245665316323"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2610231056109239"}, {"status": "PUBLISHED", "id": "1006832816443295"}]}, "baseline_offer": {"id": "2610231056109239"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791380340, "status": "PUBLISHED", "id": "2610231056109239"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6170852472950042", "version": "1.1.6"}, "id": "2906591256087718", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinar
culuscdn.com/v/t64.5771-25/38982608_3827836834206061_1990133434518879906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St5GooMoNlkQ7kNvwHzvBI6&_nc_oc=AdrD4HBHkjnAz_n962xrxHJeIAZD7U7fzG6seasGYT8KwD8KWfcOKCCZAwMWg7eakyg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG35N23pgcfIVd7U_xR2mQaeH_TFUCY8WenZ7I0hp7Mjw&oe=6A881B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PLAY FOR FREE ON (5).png", "id": "406695519118603", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974735_406695525785269_1369042610810613153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sgYlci_7SwQ7kNvwEpSeHo&_nc_oc=AdrISoGQcqDQskOEb3gl9Ex5X_tAkJ2fQlnxngj-Mxfeq-KOoDCkq4_eVNvosXw1dhU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz80qhkQXfFDtsMQ_XtcBguvC0TLw6mFpQ-kSXyAAc7g&oe=6A8851C8"}, "display_name": "Centipede VR", "keywords": [], "long_description": "Centipede VR is an immersive horror survival game, designed to keep players on edge as they fight through a dark, perilous world. Available on Meta Quest 2 and 3, players must confront six terrifying enemies, each with distinct behaviors that increase in intensity as they advance through the game's map-based progression system. With each level, waves of enemies grow stronger, forcing players to adapt their strategies and use every resource at their disposal to survive.\n\nMultiplayer COOP mode offers the chance to team up with friends, combining forces to withstand relentless enemy onslaughts. As you defeat enemies, you'll earn points that unlock new and more powerful weapons, adding to the tension and excitement of each encounter.\n\nAt the core of Centipede VR is its horrifying boss: a giant, segmented centipede that stalks players through the levels. Shooting its body causes it to split into multiple segments, turning one threat into many. Only by targeting the centipede\u2019s head will players bring about its explosive destruction. Will you have the skill and nerve to survive this nightmare?", "short_description": "Centipede VR is a gripping horror survival game where players face six terrifying enemies in escalating waves of intensity. With map-based progression, COOP multiplayer, and a unique centipede boss that splits and multiplies when shot, this game tests your survival skills. Available on Quest 2 and 3."}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/in/centipedevr-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27843693825274261"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "2141759780083844"}, {"status": "PUBLISHED", "id": "1344615460367043"}, {"status": "PUBLISHED", "id": "1727351178302805"}, {"status": "PUBLISHED", "id": "842298198745843"}, {"status": "PUBLISHED", "id": "1013932484514187"}, {"status": "PUBLISHED", "id": "26399028039797359"}, {"status": "PUBLISHED", "id": "957217797037768"}, {"status": "PUBLISHED", "id": "1107694664747361"}, {"status": "PUBLISHED", "id": "858562813718620"}, {"status": "PUBLISHED", "id": "1360405822098690"}, {"status": "PUBLISHED", "id": "832444192604950"}, {"status": "PUBLISHED", "id": "2
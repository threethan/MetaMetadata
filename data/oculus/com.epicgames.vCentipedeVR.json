3041_3103250527439147196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=degLakad-CwQ7kNvwF-bfqB&_nc_oc=Adoz8oKtJhsIpwgQTxd8IYkz65sQg3Z37xP3AjXtaKdmxA9Eis7XbxkOs7QI9hzUUWI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7cXbwzTFbGrKD-K95r9WLeslOS91fP_VwttCxG7SAaQ&oe=6ABD2062"}, {"file_name": "01.png", "id": "2176218832921624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619774_2176218836254957_6585542440236652534_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31GWrkLHTYwQ7kNvwECFwAq&_nc_oc=AdoQgdFcoGhsRLU3Qpni8M_OrfMakn1BqytOeW3vVNjXshCTFLJ-mEKHBD7T07L0JJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPYHBYDrjCLdaPqm6SP6ltYrKt8BKgwM4dUH5zKlQFgQ&oe=6ABD2DD7"}, {"file_name": "08.png", "id": "1048871371359417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823296_1048871378026083_1377641739306680908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VyztBcQF3sQ7kNvwEjBPaX&_nc_oc=AdoaTGflrsLk3K4yHUQijLEKe4r3fspBiBo5yO0jzJRDl1lKUfoTRkjijUBlrQmbGwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWyzq4M3q-ujNy5fp6RKXHz1dh61OcfrWqqjBPaUqg7Q&oe=6ABD31B4"}, {"file_name": "03.png", "id": "1085189840561866", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_1085189843895199_9212323706841117051_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTIFiVb9Dw8Q7kNvwHDVAXR&_nc_oc=AdqMqMSLaGlfRGHamUf0tE7YASla5IFl9htLY6udeHnDfJItnT_ic9zLdlf3sLOPJz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI39NPDtV4vYe2nPAk5eOkjNz6gYdRMEdXyQwFIA7QncQ&oe=6ABD3007"}, {"file_name": "02.png", "id": "1215533260584874", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620965_1215533263918207_4346188877359330409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cCNBww2FP8Q7kNvwGQtGZ5&_nc_oc=AdrCmB2y8HqKTPMotHYcAQW-DYov_Me69Xz97_tdtu9NLHDMbtBY2WzzxM21tyI2-lY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqNMNl5YqZ7CyV7tBgiskxUoGxdU6HujqFz4oOJojRig&oe=6ABD2736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1-1.png", "id": "1420088359939142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/585741071_1420088363272475_940075024818264242_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LN19mz5AknUQ7kNvwFSVwOd&_nc_oc=AdoAx5P4uhvWIwKDcD7S2QhP9qVDlvtrpvdj3cmDNVr1kQPIuvUDnoDH9KGdphnMiO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp5Qfm4Gkqiw_J39b_uMiJf8L7hjaVPhoX5tLlP7QVSw&oe=6ABD37BC"}, "display_name": "Centipede VR", "keywords": ["horror", "survivalshooter", "waveshooter", "monstershooter", "Monsters"], "long_description": "Join us on Discord!:  **https://discord.gg/xftspKVA4F**\n\n# HUNT OR BE HUNTED\nYou're dropped alone into a facility that's already lost. Somewhere inside, something enormous is moving through the walls. Your job is simple to say and hard to survive: complete your objectives, hold your nerve, and don't run out of ammo before the swarm runs out of bodies.\n\nCentipede VR is a solo survival shooter built for players who want pressure, not hand-holding. No teammates. No safety net. Just your reflexes, your loadout, and the dark.\n\n**WHAT YOU DO**\n- Push through  connected environments, completing critical objectives under   constant threat\n{1315291380537150}\n- Manage limited ammo and resources every shot and every reload is a decision\n{2298661384268905}\n- Fight six distinct enemy types, each demanding a different read\n- Survive the segmented centipede boss that's been hunting you the whole way in\n{1632229348683716}\n- Earn and unlock new weapons as you go deeper\n{4465123320410588}\n\n**BUILT FOR QUEST 3 & 3S**\n- Smooth and teleport locomotion, snap and smooth turning\n- Roomscale and seated play supported\n- Tuned for a stable, responsive combat feel on standalone hardware\n\n**EARLY ACCESS** \n\nCentipede VR is in active development and shaped by the people playing it.\n- In now: core campaign,  weapons, different enemy types and Boss\n- Coming next: 2\u20133 concrete roadmap items new levels, weapons, modes\nYour feedback and reviews directly steer what ships next. Jump in early and help build it.\n\nCan you complete the mission and survive the swarm?", "short_description": "Step into Centipede VR, an intense Early Access survival shooter! Dropped into a dark, hostile environment, you must complete critical objectives while being hunted by relentless, giant centipedes. Test your endurance in a massive, grueling and survival gauntlet that demands sharp reflexes, precise shooting, and tactical movement. With no one to watch your back, you must rely on pure combat skill to manage your resources. Can you complete the mission and survive the swarm?"}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/in/centipedevr-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38565650119745191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_1008752525209197_4846357053665195223_n.png?stp=dst-png_s360x360&_nc_cat=107&
kNvwGjwTMM&_nc_oc=Adr8n2oLrQdZ7e12DLBRhu5ZZLsF_0d83lKJVrNCgt6E148myUyC89S6HVTF5bRu5E0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoR4Czix7tmXle8RD42Zv-JYjt6ndl2bEEjxwyC5pVMA&oe=6AB6803E"}, {"file_name": "4.png", "id": "3827836830872728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982608_3827836834206061_1990133434518879906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_-96baeyCcQ7kNvwE7aaqw&_nc_oc=Adq47bNk0UgYn2j1GJ6A4PGqFD2cxA6QOfAjBbkXZv-NizhyrC-UaUiArod1SEXjA5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm7sZAOAeCFl_Jgl0oKqqkTHc5UmM5T0cXN2m9nJcxlQ&oe=6AB677DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PLAY FOR FREE ON (5).png", "id": "406695519118603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974735_406695525785269_1369042610810613153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVNYUYeUtdYQ7kNvwHK8X2i&_nc_oc=AdoDxQlI-RAI_OBnfldvbS4_kb4iug887oms9DY4qY7cTo0jueFyqf4kmtWK6PQDADo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd2qAerFMw3i-6-zz2IrCLAS_T-VuKgnt-h-5_GROr3w&oe=6AB67648"}, "display_name": "Centipede VR", "keywords": [], "long_description": "Centipede VR is an immersive horror survival game, designed to keep players on edge as they fight through a dark, perilous world. Available on Meta Quest 2 and 3, players must confront six terrifying enemies, each with distinct behaviors that increase in intensity as they advance through the game's map-based progression system. With each level, waves of enemies grow stronger, forcing players to adapt their strategies and use every resource at their disposal to survive.\n\nMultiplayer COOP mode offers the chance to team up with friends, combining forces to withstand relentless enemy onslaughts. As you defeat enemies, you'll earn points that unlock new and more powerful weapons, adding to the tension and excitement of each encounter.\n\nAt the core of Centipede VR is its horrifying boss: a giant, segmented centipede that stalks players through the levels. Shooting its body causes it to split into multiple segments, turning one threat into many. Only by targeting the centipede\u2019s head will players bring about its explosive destruction. Will you have the skill and nerve to survive this nightmare?", "short_description": "Centipede VR is a gripping horror survival game where players face six terrifying enemies in escalating waves of intensity. With map-based progression, COOP multiplayer, and a unique centipede boss that splits and multiplies when shot, this game tests your survival skills. Available on Quest 2 and 3."}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/in/centipedevr-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27843693825274261"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1487271926493868"}, {"status": "PUBLISHED", "id": "1544230060518484"}, {"status": "PUBLISHED", "id": "1808894156946881"}, {"status": "CANCELLED", "id": "2141759780083844"}, {"status": "PUBLISHED", "id": "1344615460367043"}, {"status": "PUBLISHED", "id": "172735117
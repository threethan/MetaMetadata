57_6585542440236652534_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShjY06i-YH4Q7kNvwEWPVYE&_nc_oc=AdolfGfhjNhTSiFy7nopE8bCm_Av7HdwhdpJSu0C-F_aK4Xf5SWSJUwrR0HT0RRYKPg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs28iz4O-wR3ZoINNOHOd2e0Mrx9jlVlZXOce285P3sg&oe=6A883997"}, {"file_name": "02.png", "id": "1215533260584874", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620965_1215533263918207_4346188877359330409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZYDxaC6M_0Q7kNvwFGq1s_&_nc_oc=AdocpegOYY2n-8EK4dlHwQqPzQ0ZvRyzq6W0u5I8MJu0lnOF-9BDZdbqHOvk3AbPqVQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4iN7LMvvZ5qNGQPrOHXLO051G-gk2_fQh1AgsfzbjuQ&oe=6A8832F6"}, {"file_name": "03.png", "id": "887887893571804", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623601_887887896905137_8672401630082458141_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34p1oohh6VwQ7kNvwHY2r2G&_nc_oc=Ado-x6r_e2XTKKe0YsqapzE6NDpqvUZjvIxVmowfm2me4GozLj3FOAh1odg5nW7sBLk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3xfDPmYFh4Q6j_H9x-wGGIkA2FE1E1_a7eqQAY7xLjQ&oe=6A884DB4"}, {"file_name": "04.png", "id": "1016026064713712", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619808_1016026068047045_5107916500689094789_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbrQK3QrXOIQ7kNvwFmL5pu&_nc_oc=AdonrW0zIL1TJdE9W5mVBNvdhC0TY0XAnx84-lZ23kR6HMJmPMOatCx-aFG0JOR7Zb4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAGHHJhkC6Ess1kJtZ1NBzfbmHqVc27TagTHMD9X0lyQ&oe=6A88455D"}, {"file_name": "05.png", "id": "917296188047413", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499623295_917296194714079_2106608679789546530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQflskLSmq8Q7kNvwFFgiK1&_nc_oc=Ado7GGPcxjLaGfKFdSKULAPEd8JDAxvnEW5K08sLJWFbFhppzmTlK1xg3GY9fsfyGA0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFONOewiMQqJa4G9Yov_KFlPi_TDkZf7yPFYHHi2-CHhA&oe=6A882F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1-1.png", "id": "1420088359939142", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/585741071_1420088363272475_940075024818264242_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC49a79xgvcQ7kNvwEgBGDy&_nc_oc=Adosx70Sjth93JG36-QfbTnW0M43QnqXVliBQDX-PZ63vnWSxVYiWlSlAE17Ma1F2Xg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK2TqgAEQ7VjGS_yKkDhSMISQmaljw2zRs_895WJUjAA&oe=6A88437C"}, "display_name": "Centipede VR", "keywords": ["Horror", "Shooter", "Survival", "Action", "Puzzel"], "long_description": "**Centipede VR** is an action-driven, single-player survival game that puts your combat skills and situational awareness to the ultimate test. Launching in Early Access, this experience thrusts you right into a high-stakes scenario where you must keep moving, complete your mission, and fight off terrifying threats.\n\n# Core Gameplay Features:\n\n1. **The Early Access Gauntlet:** Dive straight into a massive, fully realized level designed to push your limits. You are looking at a grueling long survival run that requires deep focus and stamina.\n\n2. **Objective-Based Action:** Survival requires more than just shooting. You must physically navigate complex environments to complete specific, critical level objectives while under constant attack from the swarm.\n\n3. **Tactical Swarm Combat:** Track the unpredictable movements of giant centipedes, aim carefully, and manage your surroundings. The enemies are relentless, and getting cornered means certain death.\n\n4. **True Solo Survival:** There is no backup. You must manage your loadout, conserve your resources , and rely entirely on your own VR combat skills to make it out alive.\n\nLoad your weapons, check your corners, and focus on the objective. Experience pure VR survival action and see if you have what it takes to beat the swarm!", "short_description": "Step into Centipede VR, an intense Early Access survival shooter! Dropped into a dark, hostile environment, you must complete critical objectives while being hunted by relentless, giant centipedes. Test your endurance in a massive, grueling and survival gauntlet that demands sharp reflexes, precise shooting, and tactical movement. With no one to watch your back, you must rely on pure combat skill to manage your resources. Can you complete the mission and survive the swarm?"}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/in/centipedevr-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36598160776494145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823746_1008752525209197_4846357053665195223_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7k6yUJACb4Q7kNvwGttKxc&_nc_oc=Ado0so2Cq57lLgLRh2UxpuI4sPOlWC-1tEQNpqlLQo9Li7CVWo7wfswVTnp4zN60D0c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx8mZlQO4TBtHAemXqAQRIVJix6xIMJNMmullPsTErIg&oe=6A881C55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
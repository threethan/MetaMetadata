t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI3bmGROPXLUV96PC63hid9v0rWGIPIZS3onLYu9Y1hg&oe=6AF1F6E3"}, {"file_name": "Screen_3_2560x1440.png", "id": "1359338369038431", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507818746_1359338372371764_6872119598989832147_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJkijfQYDdUQ7kNvwEmchxh&_nc_oc=AdolvkUN8Um1VBBZyDt1vuNi3cPhvvfzKFw4-NgtOqI-Pd1me8-EmTZEsEHAwVtPsmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBer8wdgZSb2uj1gCDT-2djxALnlAfLMT-1gNTzeJJoA&oe=6AF1F935"}, {"file_name": "Screen_2_2560x1440.png", "id": "1545170637228798", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1545170640562131_6736824217703087101_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsHKQH03NugQ7kNvwG2RIwu&_nc_oc=AdrqJFQZIqwa7fKrDbS1fPGe8Rocy5Z2YGhUZ7SMex-Z4-p334TJl1Nz3Nw1PXcpOS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgnFWfhxo512gMfC20AwPo85WL1fXf8ecuAPYkv3sXWw&oe=6AF1FB5B"}, {"file_name": "Screen_4_2560x1440.png", "id": "1318012300446251", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312310_1318012303779584_1936072793338294516_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDTqY1iEnQoQ7kNvwFKbIMC&_nc_oc=AdqKogxzXbSrT_rZ9qYP9jEAXDtox605v2T3jgJIALSFpgpRKUX7DMpwyW1tR2H-jXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmgQ_GAh3mJJi55W6jQACFjxtJSCK118xDEz0eRJkTDw&oe=6AF1FB34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MyQuiz", "keywords": [], "long_description": "MyQuiz is a quiz platform for Meta Quest that brings interactive experiences into Virtual Reality (VR) and Mixed Reality (MR).\n\nCreate, share, and play quizzes in immersive environments designed for learning, training, events, presentations, and friendly competitions. Participants can answer questions, track scores, and view results while enjoying an engaging and interactive experience inside VR and MR.\n\nQuiz creators can manage their content through the MyQuiz platform and instantly make it available on Meta Quest devices. Whether you are hosting a classroom activity, a corporate training session, a promotional campaign, or a social competition, MyQuiz helps transform traditional quizzes into memorable immersive experiences.\n\nFor event organizers, MyQuiz provides a powerful way to increase audience engagement, strengthen brand awareness, and create meaningful interactions with participants. Interactive VR and MR quizzes can be used at trade shows, exhibitions, conferences, corporate events, product launches, and marketing activations to attract visitors, encourage participation, and deliver unique branded experiences.\n\nMyQuiz supports both Virtual Reality and Mixed Reality experiences, allowing quizzes to be played in fully immersive virtual environments or blended with the user's physical surroundings on supported Meta Quest devices.\n\nA free account can be created to use the app. An internet connection is required to access quizzes, synchronize content, and submit results.\n", "short_description": "Create, share, and play interactive quizzes in virtual and mixed reality.\n"}, {"images": {"nodes": []}, "id": "2618694515234592", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MyQuiz", "keywords": [], "long_description": "O MyQuiz \u00e9 uma plataforma de quizzes para Meta Quest que leva experi\u00eancias interativas para a Realidade Virtual (VR) e a Realidade Mista (MR).\n\nCrie, compartilhe e jogue quizzes em ambientes imersivos projetados para aprendizado, treinamentos, eventos, apresenta\u00e7\u00f5es e competi\u00e7\u00f5es amig\u00e1veis. Os participantes podem responder perguntas, acompanhar pontua\u00e7\u00f5es e visualizar resultados enquanto desfrutam de uma experi\u00eancia envolvente e interativa em VR e MR.\n\nOs criadores de quizzes podem gerenciar seu conte\u00fado atrav\u00e9s da plataforma MyQuiz e disponibiliz\u00e1-lo instantaneamente para dispositivos Meta Quest. Seja para uma atividade educacional, um treinamento corporativo, uma campanha promocional ou uma competi\u00e7\u00e3o social, o MyQuiz ajuda a transformar quizzes tradicionais em experi\u00eancias imersivas memor\u00e1veis.\n\nPara organizadores de eventos, o MyQuiz oferece uma forma poderosa de aumentar o engajamento do p\u00fablico, fortalecer a presen\u00e7a da marca e criar intera\u00e7\u00f5es significativas com os participantes. Quizzes interativos em VR e MR podem ser utilizados em feiras, exposi\u00e7\u00f5es, confer\u00eancias, eventos corporativos, lan\u00e7amentos de produtos e a\u00e7\u00f5es promocionais para atrair visitantes, incentivar a participa\u00e7\u00e3o e proporcionar experi\u00eancias de marca \u00fanicas e memor\u00e1veis.\n\nO MyQuiz oferece suporte a experi\u00eancias em Realidade Virtual e Realidade Mista, permitindo que os quizzes sejam realizados tanto em ambientes totalmente virtuais quanto integrados ao ambiente f\u00edsico do usu\u00e1rio em dispositivos Meta Qu", "short_description": "Crie, compartilhe e participe de quizzes interativos em realidade virtual e realidade mista."}]}, "developer_name": "Catrapus Trade", "developer_privacy_policy_url": "https://myquiz.catrapus.trade/privacy-policy", "developer_terms_of_service_url": "https://myquiz.catrapus.trade/terms-of-use", "publisher_name": "Catrapus Trade", "support_website_url": null, "website_url": "https://myquiz.catrapus.trade/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2687655338230691"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
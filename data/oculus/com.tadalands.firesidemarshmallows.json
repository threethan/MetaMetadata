AfvEVl_Z-sgP9QkF1Kvf7ZmeJHiiGSyesFlvQM-l-bh2ug&oe=699EFFCD"}, {"file_name": "screenshot_5.png", "id": "1319590369679256", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312378_1319590376345922_2069455092659536298_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiyKtaDc8VoQ7kNvwHyh2He&_nc_oc=AdlaGUhbnSvuGwi9_40iMJQluTj5lOcuzao0NKNrt0fc9aYM391oO-IOJPiWScfF6pM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv-iD4AyZyFaEus3WyED27qF2XonufX1hmOUCmtTZJ27A&oe=699EE616"}, {"file_name": "screenshot_3.png", "id": "776696905301126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307954_776696908634459_592546761830732526_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYpVvXV2VagQ7kNvwH-K7lH&_nc_oc=AdlS_9P0RWbqm0cUhQeBeQIHXaB7Y6zXzAK72KDubw5pKTdJs757AEnUWkCHBqzImUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftcH4FNXeFmZoA6YXWhdXgxkip41_9-HJ7rMcSlKvxQeg&oe=699EEDB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1326570598989014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303280_1326570602322347_5061653168626100632_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdMQwvcWR18Q7kNvwHj7a_z&_nc_oc=AdnVsSR6LQdUgSInyS3nNGWaiHPz5AydSurchPajj-KKJ-MQA--x-kYR9bS6RMO8Gco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuXbKClNOMFZ4tI3M3ivF2hpem5TnPuMm5cTcIpdFM-6A&oe=699F040F"}, "display_name": "Fireside Marshmallows", "keywords": ["camping", "fire", "marshmallow", "smores"], "long_description": "**Roast marshmallows in a relaxing campfire environment.**\n\nUnwind and find your calm in this cozy experience. No pressure, just relaxation.\n\nPlay for as long as you want after a stressful day at work or school.\n\n# Roast marshmallows\n{24501947739424486}\nRoast your marshmallows until they're just how you like them.\n\n# Enjoy a relaxing campfire environment\n{1471631680738405}\nSit back and enjoy a peaceful evening by the crackling fire.\n\n# Eat your creations\n{1870451993533928}\nSavor your roasted marshmallows.\n\n# No pressure, just relaxation\n{1264987228258119}\nNo penalty for uncooked or burnt marshmallows.\n\n\\* \\* \\*\n\n# Features\n\nWhat Fireside Marshmallows offers:\n- **A relaxing experience**: Play for as long as you want, from 5 to 20 minutes, after a stressful day.\n- **Simple game mechanics**: Roast marshmallows over a fire. Watch out\u2014if they get too close, they'll catch on fire! Simply wave your stick to put out the flame.\n- **A cozy mood**: Enjoy peaceful, meditative music in a soothing environment.\n\nWhat Fireside Marshmallows does **NOT** offer:\n- **No exploration** or moving around in the world.\n- **No pressure** with scores, in-depth gameplay, or levels.\n- **No multiplayer**.\n- **No s'mores**.", "short_description": "Unwind and find your calm in this cozy experience. Roast marshmallows to perfection and savor them in a peaceful evening campfire environment. No pressure, just relaxation."}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/fireside-marshmallows/privacy", "developer_terms_of_service_url": null, "publisher_name": "Allen Dawodu", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24343218702035273"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com
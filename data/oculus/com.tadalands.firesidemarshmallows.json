 "757714216996417", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "747337288175818", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819934_747337291509151_1764300958553509395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WEazdEf6Q0Q7kNvwGqE-7_&_nc_oc=AdrV6pn0oHiycw0tu_5o7-Eat3Tfyd8DEuNNql8yVPYT8hTDN60XU798dVKLsBo4HiU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5shmgRcuHMm9nKSf6vfbL9W0KYowhUVZHwCC_i2ccNXg&oe=6A11CDFE"}, {"file_name": "screenshot_2.png", "id": "801822522266610", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491822034_801822525599943_3818810406335217974_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv1oQRGkTxIQ7kNvwFnAmpr&_nc_oc=AdrePt9WdF8DRX-iRHyyDVaaA_Lis_0fXJBbdH3rHZeT0k-8alQ8IxgWR7hB5pNiE94&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75V3tH8tB_rdNSJcAyC-0EnI14EGmUiUWYUdh0QTSKAw&oe=6A11BE9B"}, {"file_name": "screenshot_4.png", "id": "752808064290719", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823893_752808067624052_1356415765418954511_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhcxU6sTEncQ7kNvwGnNAYs&_nc_oc=AdoEqhVwAWNERgoq0J3vQD3wJ7qDoP4CPfCn2AP1SitN4rLh0R6G5qZS0rFlLNeS-DU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l5DfDczp3rFbf9yP68Y6opN0vJv99ekG9IltNSGzrdQ&oe=6A11B24D"}, {"file_name": "screenshot_5.png", "id": "1319590369679256", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312378_1319590376345922_2069455092659536298_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTHEXO4sMS8Q7kNvwH_EIGs&_nc_oc=AdpbRmTWm-iHIKtpwuWfOM_sp1Bxorhy9Fn2Bmfyy-HsCon7IcWDzJl1WyLxKC9cq6I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40kH08ykFDxWh0RoARfGbt5NH6CmHr_xSDUxIynM-CFA&oe=6A119896"}, {"file_name": "screenshot_3.png", "id": "776696905301126", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307954_776696908634459_592546761830732526_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lmDv-ObfpUQ7kNvwF6BB3G&_nc_oc=Adokh3HcCLIMzyKQOJ33HGwkGSn3M4gONBp57REh4iFoXM7mgsYd85L9GUVuFp9EyNQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-3j2ePXdo37xvYDCM2xChPdUX9okOd4FwCZZtkl4Uiw&oe=6A11A038"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1326570598989014", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303280_1326570602322347_5061653168626100632_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH1AnZRRjz8Q7kNvwEV1GOV&_nc_oc=AdpUzECm78Ad3B3IpgXd6n_nV-bgYm6YKJw6uNuMxM7O-fBAupNuPnvq135JTRJIjkU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qTO2OrHTqlBsCfdI7CcUnwDjDhbPmOdJCcJvQ73iNtQ&oe=6A11B68F"}, "display_name": "Fireside Marshmallows", "keywords": ["camping", "fire", "marshmallow", "smores"], "long_description": "**Roast marshmallows in a relaxing campfire environment.**\n\nUnwind and find your calm in this cozy experience. No pressure, just relaxation.\n\nPlay for as long as you want after a stressful day at work or school.\n\n# Roast marshmallows\n{24501947739424486}\nRoast your marshmallows until they're just how you like them.\n\n# Enjoy a relaxing campfire environment\n{1471631680738405}\nSit back and enjoy a peaceful evening by the crackling fire.\n\n# Eat your creations\n{1870451993533928}\nSavor your roasted marshmallows.\n\n# No pressure, just relaxation\n{1264987228258119}\nNo penalty for uncooked or burnt marshmallows.\n\n\\* \\* \\*\n\n# Features\n\nWhat Fireside Marshmallows offers:\n- **A relaxing experience**: Play for as long as you want, from 5 to 20 minutes, after a stressful day.\n- **Simple game mechanics**: Roast marshmallows over a fire. Watch out\u2014if they get too close, they'll catch on fire! Simply wave your stick to put out the flame.\n- **A cozy mood**: Enjoy peaceful, meditative music in a soothing environment.\n\nWhat Fireside Marshmallows does **NOT** offer:\n- **No exploration** or moving around in the world.\n- **No pressure** with scores, in-depth gameplay, or levels.\n- **No multiplayer**.\n- **No s'mores**.", "short_description": "Unwind and find your calm in this cozy experience. Roast marshmallows to perfection and savor them in a peaceful evening campfire environment. No pressure, just relaxation."}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/fireside-marshmallows/privacy", "developer_terms_of_service_url": null, "publisher_name": "Allen Dawodu", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24343218702035273"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1138313735020450"}, {"status": "PUBLISHED", "id": "791289910265279"}, {"status": "PUBLISHED", "id": "1490379762087867"}]}, "baseline_offer": {"id": "1138313735020450"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773763560, "status": "PUBLISHED", "id": "1138313735020450"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24412478898442586", "version": "1.0.0"}, "id": "1161948992439521", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_a
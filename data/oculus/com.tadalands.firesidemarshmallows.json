png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoA1nJDqhl8Q7kNvwF8wfpk&_nc_oc=AdlO8pMTcVtWt8QT3JGrVI46eAb_Rn5lM6-P_pgThH7EtePvVrC14eVxpDecSBY38tY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyux1s0H4J3NA9_dXhopMGphIycoOn5LQUOWzHX9GjtsQ&oe=69BEA3CD"}, {"file_name": "screenshot_5.png", "id": "1319590369679256", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312378_1319590376345922_2069455092659536298_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w4Z9FMAXbEQ7kNvwHoeum9&_nc_oc=Adk-PX83Nee2xTo1JqzqPd-mHftp-JLlAnHiSOXpDTn9IRSKIdr5lLfsNaKtFHsBE8I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMurBjyOwPOZwenHnpfe0sfbiZSwR0vRYxsBil9MC2PA&oe=69BE8A16"}, {"file_name": "screenshot_3.png", "id": "776696905301126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307954_776696908634459_592546761830732526_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwtSruD6u9sQ7kNvwHmT0-B&_nc_oc=AdnjDMhXa50HwN3CjeCFeH2HrUuQ0CquvsB2AXmsjcGdfkrPu-fifjV-7gsTg-Yvtb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDjj1p56Z7zGC4JgzhTGdPJDDZ_o4gP9NKWDjrjusNwA&oe=69BE91B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1326570598989014", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303280_1326570602322347_5061653168626100632_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xC0zPJuB5oQ7kNvwEV1Jev&_nc_oc=AdkIz0FWRNmnBwfKWF-nwSr0_0uRWILziY_3FDu_wdnSqRvKjhYPlDP13oNZEhKRvDI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLwdd3PamxFYFPaCTDhieV4Kb2JQND0zFKZkBNDCKgfQ&oe=69BEA80F"}, "display_name": "Fireside Marshmallows", "keywords": ["camping", "fire", "marshmallow", "smores"], "long_description": "**Roast marshmallows in a relaxing campfire environment.**\n\nUnwind and find your calm in this cozy experience. No pressure, just relaxation.\n\nPlay for as long as you want after a stressful day at work or school.\n\n# Roast marshmallows\n{24501947739424486}\nRoast your marshmallows until they're just how you like them.\n\n# Enjoy a relaxing campfire environment\n{1471631680738405}\nSit back and enjoy a peaceful evening by the crackling fire.\n\n# Eat your creations\n{1870451993533928}\nSavor your roasted marshmallows.\n\n# No pressure, just relaxation\n{1264987228258119}\nNo penalty for uncooked or burnt marshmallows.\n\n\\* \\* \\*\n\n# Features\n\nWhat Fireside Marshmallows offers:\n- **A relaxing experience**: Play for as long as you want, from 5 to 20 minutes, after a stressful day.\n- **Simple game mechanics**: Roast marshmallows over a fire. Watch out\u2014if they get too close, they'll catch on fire! Simply wave your stick to put out the flame.\n- **A cozy mood**: Enjoy peaceful, meditative music in a soothing environment.\n\nWhat Fireside Marshmallows does **NOT** offer:\n- **No exploration** or moving around in the world.\n- **No pressure** with scores, in-depth gameplay, or levels.\n- **No multiplayer**.\n- **No s'mores**.", "short_description": "Unwind and find your calm in this cozy experience. Roast marshmallows to perfection and savor them in a peaceful evening campfire environment. No pressure, just relaxation."}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/fireside-marshmallows/privacy", "developer_terms_of_service_url": null, "publisher_name": "Allen Dawodu", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "s
en_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFIotSv29tUQ7kNvwHapsSt&_nc_oc=AdqY-hM8ucxzy4FDOxoaxKldLGfRJw8nZIUDlragZEPJ-i3hViynl6PiUG5Z59XW0IE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPkZ4MN3o6uw_shFeREfihidZQ8xUmDIqFHiQp5C4BKA&oe=6B0B160D"}, {"file_name": "screenshot_5.png", "id": "1319590369679256", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312378_1319590376345922_2069455092659536298_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLBrJeWy--0Q7kNvwEI9Sew&_nc_oc=Adr2UCZsiaVuzCSHLV3yUgOaoJCK8o5l5QY-rw20_0AgQckVxJaWIyYTTJtdj0FFHFA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5XS0-SSI02uw3uUmNYXjDt-gtFLml8vWERZP5xWfuxA&oe=6B0B3496"}, {"file_name": "screenshot_3.png", "id": "776696905301126", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307954_776696908634459_592546761830732526_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5DraW6Vnt8Q7kNvwEtFzXa&_nc_oc=AdqOkKbGrTKodfypFU86r9rRlhfLmEZwvz2afT_-aTmjGAHs22NdVX_iYlu6iCZLCG8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnbhk4mIcBBOqT-J3Cd8J0hggChvckRQZsSuM24y5CtQ&oe=6B0B3C38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1326570598989014", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303280_1326570602322347_5061653168626100632_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwyOOFRJO4gQ7kNvwG-4O5R&_nc_oc=AdpWZO3O--vi9qXzk1-IYcJyqhZm0uvKV9qMN46sxW7HcmXs9Dx_3At7FBS4VGoDk9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHOSlGPn1GYKmn3RxZUNzTiV0pzvPLdYC3uObucm8ddg&oe=6B0B1A4F"}, "display_name": "Fireside Marshmallows", "keywords": ["camping", "fire", "marshmallow", "smores"], "long_description": "**Roast marshmallows in a relaxing campfire environment.**\n\nUnwind and find your calm in this cozy experience. No pressure, just relaxation.\n\nPlay for as long as you want after a stressful day at work or school.\n\n# Roast marshmallows\n{24501947739424486}\nRoast your marshmallows until they're just how you like them.\n\n# Enjoy a relaxing campfire environment\n{1471631680738405}\nSit back and enjoy a peaceful evening by the crackling fire.\n\n# Eat your creations\n{1870451993533928}\nSavor your roasted marshmallows.\n\n# No pressure, just relaxation\n{1264987228258119}\nNo penalty for uncooked or burnt marshmallows.\n\n\\* \\* \\*\n\n# Features\n\nWhat Fireside Marshmallows offers:\n- **A relaxing experience**: Play for as long as you want, from 5 to 20 minutes, after a stressful day.\n- **Simple game mechanics**: Roast marshmallows over a fire. Watch out\u2014if they get too close, they'll catch on fire! Simply wave your stick to put out the flame.\n- **A cozy mood**: Enjoy peaceful, meditative music in a soothing environment.\n\nWhat Fireside Marshmallows does **NOT** offer:\n- **No exploration** or moving around in the world.\n- **No pressure** with scores, in-depth gameplay, or levels.\n- **No multiplayer**.\n- **No s'mores**.", "short_description": "Unwind and find your calm in this cozy experience. Roast marshmallows to perfection and savor them in a peaceful evening campfire environment. No pressure, just relaxation."}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/fireside-marshmallows/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
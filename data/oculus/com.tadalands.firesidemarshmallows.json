 "757714216996417", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "747337288175818", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819934_747337291509151_1764300958553509395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BewZzpP-Y8Q7kNvwFzS-oC&_nc_oc=Ado--vNTrhrIFKPqKVVMUPxISzVfKq86hGKxo7aT1-jscLAZpTOrqSy6-I73O_YTzQA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx-_CfcV4dfXVqQUHOXG7Pb_f5FgwBrJh5rZUkYrHCPA&oe=6AA96A7E"}, {"file_name": "screenshot_2.png", "id": "801822522266610", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491822034_801822525599943_3818810406335217974_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3rp5VyWnvMQ7kNvwGcHfIX&_nc_oc=AdrVIuOv0buD3Lh2A4pQUpyuw0IeO9M8UxV-ajuspW5exvCNAIkPAhpTJ5AccNH9RFw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5Txbb6oNOFRDQedXbWdewcQ4974SixEkZIV8OF2TEJw&oe=6AA95B1B"}, {"file_name": "screenshot_4.png", "id": "752808064290719", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823893_752808067624052_1356415765418954511_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD0BRtYeUOQQ7kNvwHG624F&_nc_oc=AdrnlkN56dlUaTv3aRwzcfUKB6sv5dCz1ciFwIOrkroEdkr0_NR8D5NxmaXPxjTeZU4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGjMHslKhHs7j6dyjbbI--c2_qf8tjoylotNh8FWismQ&oe=6AA94ECD"}, {"file_name": "screenshot_5.png", "id": "1319590369679256", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312378_1319590376345922_2069455092659536298_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwDLizDVMDYQ7kNvwFitTBn&_nc_oc=AdpKtZ-h5Zg1Av2pjGdhY2mL-6r6KyB8sxD3xvSetq2jG5nU4DONocUeVFqFrIMFek8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeavvjqV-t0tkEZdIcdceYirD_PSnU3oma-41fOFP_-w&oe=6AA93516"}, {"file_name": "screenshot_3.png", "id": "776696905301126", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307954_776696908634459_592546761830732526_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnKfdq35nKkQ7kNvwH0zYrO&_nc_oc=Adr7nhtcr9fphsFAWG54MbTLOTaMqDmYzaYutotXiaSJDM7VEu5Y4pVO9YJ6fTj-zfM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0RM5_aPLi2ghEiNc-hM0gGhDvHF7zcm0DzOu1XREtvA&oe=6AA93CB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1326570598989014", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303280_1326570602322347_5061653168626100632_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkeFAGczK7oQ7kNvwEiJwJq&_nc_oc=AdomHInE8K1TlJULLZp6XVKhQaDflCX84v-HD60o_W235vChKHPuo9sekmIV4gal1ak&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvgdqBFtT5K50oECkB4VgY9svMoSUyghf77pa0OK2xAA&oe=6AA9530F"}, "display_name": "Fireside Marshmallows", "keywords": ["camping", "fire", "marshmallow", "smores"], "long_description": "**Roast marshmallows in a relaxing campfire environment.**\n\nUnwind and find your calm in this cozy experience. No pressure, just relaxation.\n\nPlay for as long as you want after a stressful day at work or school.\n\n# Roast marshmallows\n{24501947739424486}\nRoast your marshmallows until they're just how you like them.\n\n# Enjoy a relaxing campfire environment\n{1471631680738405}\nSit back and enjoy a peaceful evening by the crackling fire.\n\n# Eat your creations\n{1870451993533928}\nSavor your roasted marshmallows.\n\n# No pressure, just relaxation\n{1264987228258119}\nNo penalty for uncooked or burnt marshmallows.\n\n\\* \\* \\*\n\n# Features\n\nWhat Fireside Marshmallows offers:\n- **A relaxing experience**: Play for as long as you want, from 5 to 20 minutes, after a stressful day.\n- **Simple game mechanics**: Roast marshmallows over a fire. Watch out\u2014if they get too close, they'll catch on fire! Simply wave your stick to put out the flame.\n- **A cozy mood**: Enjoy peaceful, meditative music in a soothing environment.\n\nWhat Fireside Marshmallows does **NOT** offer:\n- **No exploration** or moving around in the world.\n- **No pressure** with scores, in-depth gameplay, or levels.\n- **No multiplayer**.\n- **No s'mores**.", "short_description": "Unwind and find your calm in this cozy experience. Roast marshmallows to perfection and savor them in a peaceful evening campfire environment. No pressure, just relaxation."}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/fireside-marshmallows/privacy", "developer_terms_of_service_url": null, "publisher_name": "Allen Dawodu", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24343218702035273"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1138313735020450"}, {"status": "PUBLISHED", "id": "791289910265279"}, {"status": "PUBLISHED", "id": "1490379762087867"}]}, "baseline_offer": {"id": "1138313735020450"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773763560, "status": "PUBLISHED", "id": "1138313735020450"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24412478898442586", "version": "1.0.0"}, "id": "1161948992439521", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_a
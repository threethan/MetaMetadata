en_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1FsyCyspOAQ7kNvwEyktHf&_nc_oc=Adrv-_OJhd_VabBBANW6BhCmAjvwNmW820cQUQsyPHrlxaddab8YfrjdwKI-_l8f4bU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6PvBCguwpEPGokpq2qtqPnnb29VJU-S8cEDleToJ4mQ&oe=6B0051CD"}, {"file_name": "screenshot_5.png", "id": "1319590369679256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312378_1319590376345922_2069455092659536298_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ug10u_7vCwQ7kNvwGbeLlK&_nc_oc=Adrp8sTcncRCtSm5X1okky7kfbwK6QULk_LYt4i4S44ANLQR9gCbhEvBKwusY-tbNdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiF2-d5Tr9upogNLpsP7l7RxBTD9TxWxGRFVS2UMJZ-w&oe=6B007056"}, {"file_name": "screenshot_3.png", "id": "776696905301126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307954_776696908634459_592546761830732526_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIEp_w92uRwQ7kNvwFr-srd&_nc_oc=Ado7zLjDZ2hEHHaOR-E9q48yJErhtE90Tl6sCJ2mC7c7GubzHIrh5dBn3H9mNBjKEVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNNOqdL8r1DJTE1NwHPv4pIy45bQIdhuE_URPNqT9cOQ&oe=6B0077F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1326570598989014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303280_1326570602322347_5061653168626100632_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EKe918Bjv8Q7kNvwGV0PTz&_nc_oc=AdoYe_aQDZ98KBrSU8x6rhx53ePaASjAKBjJb0PAGEa14jZPGYw5PEPWK-g9nh1T67E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB6UeUy3J0fHPib1EQLl_FyHyTXP_nMv3MZREZU4n7mA&oe=6B00560F"}, "display_name": "Fireside Marshmallows", "keywords": ["camping", "fire", "marshmallow", "smores"], "long_description": "**Roast marshmallows in a relaxing campfire environment.**\n\nUnwind and find your calm in this cozy experience. No pressure, just relaxation.\n\nPlay for as long as you want after a stressful day at work or school.\n\n# Roast marshmallows\n{24501947739424486}\nRoast your marshmallows until they're just how you like them.\n\n# Enjoy a relaxing campfire environment\n{1471631680738405}\nSit back and enjoy a peaceful evening by the crackling fire.\n\n# Eat your creations\n{1870451993533928}\nSavor your roasted marshmallows.\n\n# No pressure, just relaxation\n{1264987228258119}\nNo penalty for uncooked or burnt marshmallows.\n\n\\* \\* \\*\n\n# Features\n\nWhat Fireside Marshmallows offers:\n- **A relaxing experience**: Play for as long as you want, from 5 to 20 minutes, after a stressful day.\n- **Simple game mechanics**: Roast marshmallows over a fire. Watch out\u2014if they get too close, they'll catch on fire! Simply wave your stick to put out the flame.\n- **A cozy mood**: Enjoy peaceful, meditative music in a soothing environment.\n\nWhat Fireside Marshmallows does **NOT** offer:\n- **No exploration** or moving around in the world.\n- **No pressure** with scores, in-depth gameplay, or levels.\n- **No multiplayer**.\n- **No s'mores**.", "short_description": "Unwind and find your calm in this cozy experience. Roast marshmallows to perfection and savor them in a peaceful evening campfire environment. No pressure, just relaxation."}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/fireside-marshmallows/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
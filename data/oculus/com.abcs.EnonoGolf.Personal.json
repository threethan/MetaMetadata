E9EC0"}, {"file_name": "enonogolf-personal-screenshot-for-store-1.png", "id": "2028006970999519", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982510_2028006974332852_6047058620083591197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lx9rxxQ_zvQQ7kNvwG570I2&_nc_oc=AdpevOX8xicgKgJRYM65Jl9sfDCFeyZ8CFP5qkzC0k8rrdVvdMSTSow5VI4fO2Ch2Uw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqlrkzguqkTbYQMaBr2ywstEkGR2FcmKswHYaXp04SFQ&oe=6AAE83E0"}, {"file_name": "enonogolf-personal-screenshot-for-store-3.png", "id": "1079478467203445", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75505860_1079478470536778_1421929271856470663_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVDla2lMsSAQ7kNvwHhur8S&_nc_oc=AdoiBupZheA-QpNTZzyXZlaXOZfdC7vhrIrP9xR0NQj3LTlWL5JNRwzC83ieagHYu0w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA4btYiDj9U5hoWUg4zV3Mkad3S10tz_dHtGDSP-vYkg&oe=6AAEABD0"}, {"file_name": "enonogolf-personal-screenshot-for-store-4.png", "id": "830934602398008", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031578_830934605731341_8087008464296517015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9SXR8APwVEQ7kNvwEmw4ew&_nc_oc=AdoTAJyFA8B0wXSfSNQiD0WBZTO5yaCVXuwFOgzJ-WUzf5-6RBLw3TpYWir1lfwtx_M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXol_iAiG-94qtn5SHQ96PzejRnkqcQ9IuLLTWDoEmTw&oe=6AAE88C5"}, {"file_name": "enonogolf-personal-screenshot-for-store-0.png", "id": "1775709256536163", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75441576_1775709259869496_5629890347236747677_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyPAA0QV8rMQ7kNvwGjYu_P&_nc_oc=AdpICf3BvNXZuwtILAVOB8dXD4Ynj_xrOEx4cXe7WzMbouzOAhUw3bD_HlcmwM7Zz2E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGuj4GoX3OXWsUZoq4ixxDnZavdaBmbD1qBGWuocvPhA&oe=6AAEA9FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EnonoGolf Personal", "keywords": [], "long_description": "# EnonoGolf Personal : Rounds, driving range, mini games\n\n\n# EnonoGolf Round\n- The courses included in the game are scanned reproductions of real courses.\n- The course is scanned and reproduced from a real course.\n\n# Driving Range\n- **Swing Analysis** allows you to evaluate your swing according to the ball path. You can also view your swing from the side and from above the swing analysis.\n\n- **Swing Replay function** allows you to replay your swing in the past. The swing comparison function allows you to compare your past replays with each other and with the swing replays of professional players that are built into the application.\n\n- In the driving range, you can practice by comparing your swing with the swing of a professional by combining the **volumetric swing replay function** filmed in a dedicated studio.\n\n# Mini-Games\n\nThe mini-games include the following games.\n\n- **Balloon**\n- **Building**\n- **Driving Contest**\n- **Nearest-to-the-Pin**", "short_description": "Round of golf, driving range, mini-games\n\nIncluded courses are real golf courses.\n\nOn the driving range, you can practice your own swing compared to a professional's swing by combining unlimited shots, replay functions, as well as volumetric swing playback, a feature that utilizes a dedicated studio."}, {"images": {"nodes": []}, "id": "511837005238885", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EnonoGolf Personal", "keywords": [], "long_description": "# EnonoGolf Personal : \u30e9\u30a6\u30f3\u30c9\u3001\u7df4\u7fd2\u5834\u3001\u30df\u30cb\u30b2\u30fc\u30e0\n\n\n# \u30e9\u30a6\u30f3\u30c9\n- \u53ce\u9332\u30b3\u30fc\u30b9\u306f\u5b9f\u5728\u3059\u308b\u30b3\u30fc\u30b9\u3092\u30b9\u30ad\u30e3\u30f3\u3057\u3066\u518d\u73fe\u3057\u3066\u3044\u307e\u3059\u3002\n- \u30bf\u30fc\u30b2\u30c3\u30c8\u30e2\u30fc\u30c9\u3092\u30aa\u30f3\u306b\u3059\u308b\u3053\u3068\u3067\u30b3\u30fc\u30b9\u4e0a\u306b\u30dc\u30fc\u30eb\u3092\u6253\u3064\u65b9\u5411\u304c\u8868\u793a\u3055\u308c\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\n\n# \u7df4\u7fd2\u5834\n- **\u30b9\u30a4\u30f3\u30b0\u5206\u6790**\u3067\u306f\u7403\u7b4b\u306b\u5fdc\u3058\u3066\u81ea\u5206\u306e\u30b9\u30a4\u30f3\u30b0\u3092\u8a55\u4fa1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u30b9\u30a4\u30f3\u30b0\u5206\u6790\u3092\u884c\u3063\u305f\u30b9\u30a4\u30f3\u30b0\u3092\u6a2a\u65b9\u5411\u3084\u4e0a\u7a7a\u304b\u3089\u307f\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n- **\u30b9\u30a4\u30f3\u30b0\u30ea\u30d7\u30ec\u30a4\u6a5f\u80fd**\u3067\u306f\u904e\u53bb\u306e\u81ea\u5206\u306e\u30b9\u30a4\u30f3\u30b0\u3092\u518d\u751f\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30a4\u30f3\u30b0\u6bd4\u8f03\u6a5f\u80fd\u304c\u642d\u8f09\u3055\u308c\u3066\u304a\u308a\u3001\u904e\u53bb\u306e\u81ea\u5206\u306e\u30ea\u30d7\u30ec\u30a4\u540c\u58eb\u3092\u6bd4\u8f03\u3057\u305f\u308a\u30a2\u30d7\u30ea\u306b\u5185\u81d3\u3055\u308c\u3066\u3044\u308b\u30d7\u30ed\u9078\u624b\u306e\u30b9\u30a4\u30f3\u30b0\u30ea\u30d7\u30ec\u30a4\u3068\u3082\u6bd4\u8f03\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n- \u7df4\u7fd2\u5834\u3067\u306f\u5c02\u7528\u30b9\u30bf\u30b8\u30aa\u3067\u64ae\u5f71\u3057\u305f**\u30dc\u30ea\u30e5\u30e1\u30c8\u30ea\u30c3\u30af\u30b9\u30a4\u30f3\u30b0\u518d\u751f\u6a5f\u80fd**\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u81ea\u5206\u306e\u30b9\u30a4\u30f3\u30b0\u3092\u30d7\u30ed\u306e\u30b9\u30a4\u30f3\u30b0\u3068\u6bd4\u3079\u3066\u7df4\u7fd2\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n# \u30df\u30cb\u30b2\u30fc\u30e0\n\n\u30df\u30cb\u30b2\u30fc\u30e0\u3067\u306f\u4ee5\u4e0b\u306e\u30b2\u30fc\u30e0\u304c\u3042\u308a\u307e\u3059\u3002\n\n- **\u30d0\u30eb\u30fc\u30f3**\n- **\u30d3\u30eb\u30c7\u30a3\u30f3\u30b0**\n- **\u30c9\u30e9\u30a4\u30d3\u30f3\u30b0\u30b3\u30f3\u30c6\u30b9\u30c8**\n- **\u30cb\u30a2\u30d4\u30f3**", "short_description": "\u30e9\u30a6\u30f3\u30c9\u3001\u7df4\u7fd2\u5834\u3001\u30df\u30cb\u30b2\u30fc\u30e0\n\n\u53ce\u9332\u30b3\u30fc\u30b9\u306f\u5b9f\u5728\u3059\u308b\u30b4\u30eb\u30d5\u30b3\u30fc\u30b9\n\n\u7df4\u7fd2\u5834\u3067\u306f\u3001\u7121\u5236\u9650\u306e\u30b7\u30e7\u30c3\u30c8\u3001\u30ea\u30d7\u30ec\u30a4\u6a5f\u80fd\u306e\u4ed6\u3001\u5c02\u7528\u30b9\u30bf\u30b8\u30aa\u3092\u6d3b\u7528\u3057\u305f\u6a5f\u80fd\u306e\u30dc\u30ea\u30e5\u30e1\u30c8\u30ea\u30c3\u30af\u30b9\u30a4\u30f3\u30b0\u518d\u751f\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u81ea\u5206\u306e\u30b9\u30a4\u30f3\u30b0\u3092\u30d7\u30ed\u306e\u30b9\u30a4\u30f3\u30b0\u3068\u6bd4\u3079\u3066\u7df4\u7fd2\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n"}]}, "developer_name": "Abic System Co.,Ltd.", "developer_privacy_policy_url": "https://enonogolf-p.abcs.co.jp/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Abic System Co.,Ltd.", "support_website_url": null, "website_url": "https://enonogolf-p.abcs.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8999687123386637"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1116575803587419"}]}, "baseline_offer": {"id": "1116575803587419"}, "is_approved": true, "firstOffer": {"nodes": [{"sta
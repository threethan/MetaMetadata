 "779747528417101", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618277_779747531750434_941145022281938101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0i3duQ8QLAQ7kNvwE99QKS&_nc_oc=Adqa10o_WN5PwEE7msWMKdba65iCz2mwvmWi66sryDI7l-sKuJM6_tpMXJ8i6kga8Vk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k98yDtV2rf22VNbQI20PmoZzcxJslBUmBSVBqRnpheA&oe=69DCDF7C"}]}, "id": "2262974017532916", "locale": "en_US", "screenshots": [{"file_name": "com.abcs.EnonoGolf.Personal-20251216-114733.png", "id": "853975817261857", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622276_853975820595190_587649647880148293_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT8p6a3f-KUQ7kNvwH_Wbx2&_nc_oc=Adrdw5tUbCRPXugKYKyHVXDoOjRBrCAcabrQVdzkLT34PzfnTNPhB4qZYBELQZ2vvIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ARGvpAz8Qm5T7VlFh4lJPdyQBjq7vZ8wcip8llUAZPw&oe=69DD0171"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-114703.png", "id": "868215049483849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618288_868215052817182_7450514515068754739_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luaE6GjFGH8Q7kNvwEFYTKH&_nc_oc=AdqaMoSZgIog4UJjM_GJZRkl5HTD3uMT31YuEspFcFwmChd_N-v2tnIhJFbsSh7yCjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s6tEazCKsdwmHmGb3alP8phWzYlAJ91FCjmfympn5JQ&oe=69DCFCD7"}, {"file_name": "enonogolf-personal-screenshot-for-store-0.png", "id": "966598165430065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391871_966598168763398_2673494751816208481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhG7xrVVD88Q7kNvwFi90ec&_nc_oc=AdoKPmloXp3patZoaRdunR418LiD5MzVbFA1Wex-AiaVKuPsJkzG28LwDmYIE7KBty8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1M72p4ucJIJrOh-am1zELodj-HvigeHtB7UBhonaj9UA&oe=69DCF6C6"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-114452.png", "id": "1590347725318913", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620432_1590347728652246_923840658049877269_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaVAWyD8mOQQ7kNvwGpVheF&_nc_oc=AdpJ83m6odNT7bOiTqYcswGwGzH9jnwUXJvGj7P4fab_dydJs2aujSw1Fs18nsb_foU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09eCqlaRZUaSdxYNRMiumLpmQrffNh_9qh_Bf889I1Nw&oe=69DCF7D1"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-133129.png", "id": "1342248660504317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619677_1342248663837650_9196868397227301834_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q99ya6YdL6QQ7kNvwFHNrN_&_nc_oc=Ado3z5iVPUGWRz7_EvQ_7xlhtfQ6TL1vyRAOqzRSVUkTS8TlKgvj6cJlJi-ehVGfIGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21gTaXZThBENmZ_iKy4ij5whIAGNTuLtMy-XyG-i9QKA&oe=69DCF197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1980796055833494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619704_1980796059166827_3356433641066268915_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc5CeGNlwfsQ7kNvwEwdFqL&_nc_oc=AdojIBYjKUZlK_55pP6YsJ6oM6RaZIX0vM6qG04kaxHRcBMgJUKk7pO8uDX-2v_etyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19qoEM2BeQxgoUkTp4ZcbAfDtVlSET6joe7CgcAhmsGQ&oe=69DCE05B"}, "display_name": "EnonoGolf Personal", "keywords": ["golf", "sports", "enonogolf", "real", "fitness"], "long_description": "# EnonoGolf Personal\n**The Ultimate Home Golf Experience**\n\nTransform your space into a professional golf environment. **EnonoGolfPersonal** combines authentic course simulation, advanced swing analysis, and engaging mini-games to help you master your game.\n\n---\n\n## \u26f3 EnonoGolf Round\nExperience the thrill of the fairway from anywhere.\n\n**Real Course Reproduction**\n\nAll included courses are scanned reproductions of real-world golf courses. Experience the authentic terrain and strategy of actual locations.\n\n---\n\n## \ud83c\udfcc\ufe0f\u200d\u2642\ufe0f Driving Range\nTrain like a pro with high-tech analysis tools.\n\n**Swing Analysis**\n\nEvaluate your form based on ball trajectory. You can switch views to check your swing from the **Side** or **Top** angles for a complete mechanical breakdown.\n\n---\n\n**Smart Replay & Comparison**\n\nReview your past swings instantly. Use the comparison function to view your replays side-by-side with built-in **professional player data** to identify areas for improvement.\n\n---\n\n**Volumetric Pro Playback**\n\nExperience the next generation of training. Utilizing **volumetric video captured in a dedicated studio**, you can project a professional\u2019s 3D swing into your space. Compare and sync your form with a pro's like never before.\n\n---\n\n## \ud83c\udfae Mini-Games\nSharpen your skills with fun, arcade-style challenges:\n\n**\ud83c\udf88 Balloon**\nTest your accuracy by popping targets.\n\n---\n\n**\ud83c\udfe2 Building**\nA unique target challenge amidst city structures.\n\n---\n\n**\ud83d\udca5 Driving Contest**\nUnleash your power for the longest drive.\n\n---\n\n**\u26f3 Nearest-to-the-Pin**\nMaster your approach shots.\n{675355952324165}", "short_description": "Here is the English version tailored to EnonoGolfPersonal, keeping the focus on training features and staying under the 500-character limit.\n\nTransform your space into a pro studio with EnonoGolfPersonal.\n\nFeatures:\nReal Courses: Play rounds on authentic, included golf courses.\nDriving Range: Refine your swing with unlimited shots and instant replays.\nVolumetric Swing Analysis: Compare your form against a professional's! Utilizing 3D capture from a dedicated studio, you can project a pro's sw"}]}, "developer_name": "Abic System Co.,Ltd.", "developer_privacy_policy_url": "https://enonogolf-p.abcs.co.jp/privacy-policy", "developer_terms_of_service_url": "https://enonogolf-p.abcs.co.jp/termsofuse", "publisher_name": "Abic System Co.,Ltd.", "support_website_url": null, "website_url": "https://enonogolf.abcs.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25632326736362747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_2706900896322673_646596313452875166_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I427dVVIvgQ7kNvwHxg_K6&_nc_oc=AdrZ7mhlrmsfZnBPRnqeQbHN0xtw0uKL060bzZfrDJ4W3akAYChRhwqJHxZE1b4m6ac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q9Y1ys0ZGmUgjyEV0lQ2cAFAZi8PszNTuPNFDypfa2Q&oe=69DCCD62"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EnonoGolf Personal", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1734667200, "lastRevision": {"nodes": [{"id": "8999687153386634", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8999687103386639", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "588340227074801"}, "iarc_email": null, "msrp": null, "translations": {"nodes": 
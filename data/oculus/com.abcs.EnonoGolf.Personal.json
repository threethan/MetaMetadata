nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwbpzUA2s68ZsRMWmrWYT8viEQdlPA63M50ST4IcXkJw&oe=6AFF1251"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-131710.png", "id": "733338243185950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620860_733338246519283_6539350064826100348_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVwNw03M_UsQ7kNvwE0Gz6a&_nc_oc=AdpU1Jv3j1tqDVcxaHTbOEd_PQNgTMReKX_WMFaa8UFeAsvPWVCbOc7hlsv8Vfmux0U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrVU2eYeYylS1mDZfigZnI2hPVLikVTIZlDrSLp-ITfA&oe=6AFF0690"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-133213.png", "id": "1409132997412437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618937_1409133000745770_5273948702078778612_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_i9TVO74ucQ7kNvwGol_1T&_nc_oc=AdpzlZns-LLr1pty7q52fNabm5OLWMFmS39P51J4m2qss5g8z1K8tntvU-MB8jXF6Os&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMsUFpYWzHtiug7a6tRFRLbymlC7hGDLEIaaNBby1lSw&oe=6AFF17A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1208898861186559", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618251_1208898864519892_8558164106863763057_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0_od9TyuSsQ7kNvwEVsHk5&_nc_oc=AdqOcBYocOniRAte_cqUIvcPdwlcvNuz5CcRERmjPfGiUiSppIsy3nEPLEwgSXH0-Bo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBgY83JMH10k_bsihkrdPQi6TYfMm0PuEQ_05W2rw_mg&oe=6AFF09F1"}, "display_name": "EnonoGolf Personal", "keywords": ["\u30b4\u30eb\u30d5", "\u30b9\u30dd\u30fc\u30c4", "\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9", "EnonoGolf", "golf"], "long_description": "# EnonoGolf Personal\n**\u81ea\u5b85\u3067\u5473\u308f\u3046\u3001\u7a76\u6975\u306e\u30b4\u30eb\u30d5\u4f53\u9a13**\n\n\u3042\u306a\u305f\u306e\u7a7a\u9593\u3092\u30d7\u30ed\u4ed5\u69d8\u306e\u30b4\u30eb\u30d5\u74b0\u5883\u3078\u3002**EnonoGolfPersonal**\u306f\u3001\u672c\u683c\u7684\u306a\u30b3\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u3001\u9ad8\u5ea6\u306a\u30b9\u30a4\u30f3\u30b0\u5206\u6790\u3001\u305d\u3057\u3066\u9b45\u529b\u7684\u306a\u30df\u30cb\u30b2\u30fc\u30e0\u3092\u878d\u5408\u3055\u305b\u3001\u3042\u306a\u305f\u306e\u30b4\u30eb\u30d5\u4e0a\u9054\u3092\u5f37\u529b\u306b\u30b5\u30dd\u30fc\u30c8\u3057\u307e\u3059\u3002\n\n## \u26f3 Round\uff08\u30e9\u30a6\u30f3\u30c9\uff09\n\u3069\u3053\u306b\u3044\u3066\u3082\u3001\u5b9f\u969b\u306e\u30d5\u30a7\u30a2\u30a6\u30a7\u30a4\u306e\u8208\u596e\u3092\u3002\n\n* **\u5b9f\u5728\u30b3\u30fc\u30b9\u3092\u5b8c\u5168\u518d\u73fe**\n    \u53ce\u9332\u3055\u308c\u3066\u3044\u308b\u30b3\u30fc\u30b9\u306f\u3001\u3059\u3079\u3066\u5b9f\u5728\u3059\u308b\u30b4\u30eb\u30d5\u30b3\u30fc\u30b9\u306e\u30b9\u30ad\u30e3\u30f3\u30c7\u30fc\u30bf\u3092\u3082\u3068\u306b\u518d\u73fe\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30ea\u30a2\u30eb\u306a\u5730\u5f62\u3068\u6226\u7565\u6027\u3092\u305d\u306e\u307e\u307e\u4f53\u9a13\u3067\u304d\u307e\u3059\u3002\n\n## \ud83c\udfcc\ufe0f\u200d\u2642\ufe0f Driving Range\uff08\u7df4\u7fd2\u5834\uff09\n\u30cf\u30a4\u30c6\u30af\u6a5f\u80fd\u3092\u5099\u3048\u305f\u7df4\u7fd2\u5834\u3067\u3001\u30d7\u30ed\u306e\u3088\u3046\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u3002\n\n* **\u30b9\u30a4\u30f3\u30b0\u5206\u6790 (Swing Analysis)**\n\u3000\u7403\u7b4b\uff08\u5f3e\u9053\uff09\u306b\u57fa\u3065\u3044\u305f\u30d5\u30a9\u30fc\u30e0\u8a55\u4fa1\u304c\u53ef\u80fd\u3067\u3059\u3002\u30b5\u30a4\u30c9\uff08\u6a2a\uff09\u3084\u30c8\u30c3\u30d7\uff08\u4e0a\uff09\u306a\u3069\u8907\u6570\u306e\u30ab\u30e1\u30e9\u30a2\u30f3\u30b0\u30eb\u304b\u3089\u3001\u81ea\u5206\u306e\u30b9\u30a4\u30f3\u30b0\u30e1\u30ab\u30cb\u30af\u30b9\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002\n* **\u30ea\u30d7\u30ec\u30a4\uff06\u6bd4\u8f03\u6a5f\u80fd**\n\u3000\u904e\u53bb\u306e\u30b9\u30a4\u30f3\u30b0\u3092\u5373\u5ea7\u306b\u30ea\u30d7\u30ec\u30a4\u518d\u751f\u3002\u3055\u3089\u306b\u3001\u30a2\u30d7\u30ea\u306b\u5185\u8535\u3055\u308c\u305f\u30d7\u30ed\u30b4\u30eb\u30d5\u30a1\u30fc\u306e\u30b9\u30a4\u30f3\u30b0\u30c7\u30fc\u30bf\u3068\u81ea\u5206\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u4e26\u3079\u3066\u6bd4\u8f03\u3057\u3001\u6539\u5584\u70b9\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n* **\u30dc\u30ea\u30e5\u30e1\u30c8\u30ea\u30c3\u30af\u30fb\u30d7\u30ed\u518d\u751f**\n \u3000\u5c02\u7528\u30b9\u30bf\u30b8\u30aa\u3067\u64ae\u5f71\u3055\u308c\u305f\u300c\u30dc\u30ea\u30e5\u30fc\u30e1\u30c8\u30ea\u30c3\u30af\u30d3\u30c7\u30aa\uff08\u7acb\u4f53\u6620\u50cf\uff09\u300d\u6280\u8853\u3092\u642d\u8f09\u3002\u30d7\u30ed\u306e\u30b9\u30a4\u30f3\u30b0\u30923D\u30db\u30ed\u30b0\u30e9\u30e0\u3068\u3057\u3066\u76ee\u306e\u524d\u306e\u7a7a\u9593\u306b\u6295\u5f71\u3057\u3001\u81ea\u5206\u306e\u52d5\u304d\u3068\u91cd\u306d\u5408\u308f\u305b\u3066\u76f4\u611f\u7684\u306a\u7df4\u7fd2\u304c\u53ef\u80fd\u3067\u3059\u3002\n\n## \ud83c\udfae Mini-Games\uff08\u30df\u30cb\u30b2\u30fc\u30e0\uff09\n\u697d\u3057\u307f\u306a\u304c\u3089\u30b9\u30ad\u30eb\u3092\u78e8\u3051\u308b\u3001\u591a\u5f69\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\uff1a\n\n* **\ud83c\udf88 Balloon (\u30d0\u30eb\u30fc\u30f3):** \u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u72d9\u3063\u3066\u5272\u308b\u3001\u6b63\u78ba\u6027\u30c6\u30b9\u30c8\u3002\n* **\ud83c\udfe2 Building (\u30d3\u30eb\u30c7\u30a3\u30f3\u30b0):** \u5efa\u7269\u3092\u821e\u53f0\u306b\u3057\u305f\u30e6\u30cb\u30fc\u30af\u306a\u30bf\u30fc\u30b2\u30c3\u30c8\u30c1\u30e3\u30ec\u30f3\u30b8\u3002\n* **\ud83d\udca5 Driving Contest (\u30c9\u30e9\u30b3\u30f3):** \u30d1\u30ef\u30fc\u3092\u89e3\u653e\u3057\u3001\u6700\u9577\u98db\u8ddd\u96e2\u3092\u76ee\u6307\u305b\u3002\n* **\u26f3 Nearest-to-the-Pin (\u30cb\u30a2\u30d4\u30f3):** \u30a2\u30d7\u30ed\u30fc\u30c1\u30b7\u30e7\u30c3\u30c8\u3092\u6975\u3081\u3001\u30d4\u30f3\u306b\u5bc4\u305b\u308d\u3002\n{33494852470105684}", "short_description": "\u30b9\u30b3\u30a2\u30a2\u30c3\u30d7\u3092\u76ee\u6307\u3059\u30b4\u30eb\u30d5\u30a1\u30fc\u306e\u305f\u3081\u306b\u3001\u5b9f\u6226\u7684\u306a\u6a5f\u80fd\u3068\u6700\u65b0\u6280\u8853\u3092\u51dd\u7e2e\u3057\u307e\u3057\u305f\u3002\n\n\u3010\u4e3b\u306a\u6a5f\u80fd\u3011\n\n\u5b9f\u5728\u30b3\u30fc\u30b9\u3067\u306e\u30e9\u30a6\u30f3\u30c9 \u7dfb\u5bc6\u306b\u518d\u73fe\u3055\u308c\u305f\u5b9f\u5728\u30b3\u30fc\u30b9\u3092\u53ce\u9332\u3002\u30ea\u30a2\u30eb\u306a\u5730\u5f62\u3068\u6226\u7565\u6027\u3092\u305d\u306e\u307e\u307e\u306b\u3001\u6ca1\u5165\u611f\u3042\u308b\u30d7\u30ec\u30a4\u304c\u53ef\u80fd\u3067\u3059\u3002\n\n\u9ad8\u5ea6\u306a\u7df4\u7fd2\u6a5f\u80fd \u30c9\u30e9\u30a4\u30d3\u30f3\u30b0\u30ec\u30f3\u30b8\u3067\u306f\u7121\u5236\u9650\u306e\u30b7\u30e7\u30c3\u30c8\u7df4\u7fd2\u306b\u52a0\u3048\u3001\u5145\u5b9f\u3057\u305f\u30ea\u30d7\u30ec\u30a4\u6a5f\u80fd\u3067\u81ea\u5206\u306e\u30b9\u30a4\u30f3\u30b0\u3092\u5fb9\u5e95\u7684\u306b\u5206\u6790\u3067\u304d\u307e\u3059\u3002\n\n\u3010\u6700\u65b0\u3011\u30dc\u30ea\u30e5\u30fc\u30e1\u30c8\u30ea\u30c3\u30af\u30fb\u30b9\u30a4\u30f3\u30b0\u6bd4\u8f03 \u5c02\u7528\u30b9\u30bf\u30b8\u30aa\u3067\u64ae\u5f71\u3055\u308c\u305f\u30d7\u30ed\u30b4\u30eb\u30d5\u30a1\u30fc\u306e3D\u7acb\u4f53\u6620\u50cf\uff08\u30dc\u30ea\u30e5\u30fc\u30e1\u30c8\u30ea\u30c3\u30af\u30d3\u30c7\u30aa\uff09\u3092\u642d\u8f09\u3002 \u30d7\u30ed\u306e\u30b9\u30a4\u30f3\u30b0\u3092\u76ee\u306e\u524d\u306e\u7a7a\u9593\u306b\u6295\u5f71\u3057\u3001\u81ea\u5206\u306e\u30d5\u30a9\u30fc\u30e0\u3068\u6bd4\u8f03\u30fb\u5206\u6790\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059\u3002\u7406\u60f3\u306e\u52d5\u304d\u3092\u76f4\u611f\u7684\u306b\u63b4\u307f\u3001\u52b9\u7387\u7684\u306a\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002\n\n\u30df\u30cb\u30b2\u30fc\u30e0 \u697d\u3057\u307f\u306a\u304c\u3089\u6280\u8853\u3092\u78e8\u3051\u308b\u30b3\u30f3\u30c6\u30f3\u30c4\u3082\u5145\u5b9f\u3002\n\n\u672c\u6c17\u3067\u7df4\u7fd2\u3057\u305f\u3044\u65b9\u3082\u3001\u624b\u8efd\u306b\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u3057\u305f\u3044\u65b9\u3082\u3002\u300eEnonoGolfPersonal\u300f\u304c\u3042\u306a\u305f\u306e\u30b4\u30eb\u30d5\u30e9\u30a4\u30d5\u3092\u9032\u5316\u3055\u305b\u307e\u3059\u3002"}, {"images": {"nodes": [{"file_name": "com.abcs.EnonoGolf.Personal-20251216-135254.png", "id": "2254509421694813", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619774_2254509425028146_1565940347102850357_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUj0jhAl4roQ7kNvwGtwtc_&_nc_oc=AdqpEdWWeVTuBhqjgPRQ_URkYN7U8lu_bWffDeOMjkHD-qvqr5OgVY744pJCwqJft3Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGXgceD9Sxe32cf8FxFafxLaIaABllLh1lN5MjzuYc-g&oe=6AFF22E9"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-135254.png", "id": "836915389218127", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619465_836915392551460_1561762982643214480_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fbn7PQHkshkQ7kNvwFkRZ8a&_nc_oc=AdqLWuHrcpxHJQiEoQcjGiRU0gpUPQMQ0DpkPivlzmB037qJm-zmuae0XdLjy_epKk8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDfwwpa3KquPY9wSKrs-1LLO1cC4e5hb5JJ25fnVYXaA&oe=6AFF31E7"}, {"file_name": "swing_25601440.png", "id": "675355952324165", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618252_675355958990831_7116721050889175460_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4Di-56rQdcQ7kNvwFMDADp&_nc_oc=Adoh_MyPpMzac8p5rmZW_OsAsNPk71yI6BwtpUm25SlV4E4qX8XLn1aT0RAZb727UdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9YzEPOATUlth7xeYeM3zlwF99G66cqdke4v4a2cD4-g&oe=6AFF2582"}, {"file_name": "Cover_Sq
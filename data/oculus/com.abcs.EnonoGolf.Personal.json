0658049877269_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_K9LhFPz7oQ7kNvwEslTM0&_nc_oc=AdmN2ZANFPQ8Rx7RarP7ZNdm8DNTTeHEZWkBYpkHdLHgrT5eJVDdsRtshztynRN5K7k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzl-U99Ht7GCmwjjMGWC9ZmPhpY8Le93Z48jb2tJ1X-9A&oe=69BAB0D1"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-133129.png", "id": "1342248660504317", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619677_1342248663837650_9196868397227301834_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWQFFyuqIaYQ7kNvwGjSDbW&_nc_oc=Adm_Hf0FXYpWlXGAxhkbJmTZJ38y8NjZK-baJJ40T4HyqbluX6N_hlZrGKcC8M4_88U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4hHitVetm0-ItRQPyJKSq17RJCCMgGIzueAoOEEDiCQ&oe=69BAAA97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1980796055833494", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619704_1980796059166827_3356433641066268915_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCnYkv7mW14Q7kNvwHyV7Q9&_nc_oc=AdnOk1Hmg6CbMUHvRipPqC7xkkrJ6Bf5RYZJKxujxaj5d9t2KRhKO3ZwD9ZaGHR0dLI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzp5UaZJXVvIy973WEKyMjinAfO7L9XBhlDwERQ4PqHCQ&oe=69BA995B"}, "display_name": "EnonoGolf Personal", "keywords": ["golf", "sports", "enonogolf", "real", "fitness"], "long_description": "# EnonoGolf Personal\n**The Ultimate Home Golf Experience**\n\nTransform your space into a professional golf environment. **EnonoGolfPersonal** combines authentic course simulation, advanced swing analysis, and engaging mini-games to help you master your game.\n\n---\n\n## \u26f3 EnonoGolf Round\nExperience the thrill of the fairway from anywhere.\n\n**Real Course Reproduction**\n\nAll included courses are scanned reproductions of real-world golf courses. Experience the authentic terrain and strategy of actual locations.\n\n---\n\n## \ud83c\udfcc\ufe0f\u200d\u2642\ufe0f Driving Range\nTrain like a pro with high-tech analysis tools.\n\n**Swing Analysis**\n\nEvaluate your form based on ball trajectory. You can switch views to check your swing from the **Side** or **Top** angles for a complete mechanical breakdown.\n\n---\n\n**Smart Replay & Comparison**\n\nReview your past swings instantly. Use the comparison function to view your replays side-by-side with built-in **professional player data** to identify areas for improvement.\n\n---\n\n**Volumetric Pro Playback**\n\nExperience the next generation of training. Utilizing **volumetric video captured in a dedicated studio**, you can project a professional\u2019s 3D swing into your space. Compare and sync your form with a pro's like never before.\n\n---\n\n## \ud83c\udfae Mini-Games\nSharpen your skills with fun, arcade-style challenges:\n\n**\ud83c\udf88 Balloon**\nTest your accuracy by popping targets.\n\n---\n\n**\ud83c\udfe2 Building**\nA unique target challenge amidst city structures.\n\n---\n\n**\ud83d\udca5 Driving Contest**\nUnleash your power for the longest drive.\n\n---\n\n**\u26f3 Nearest-to-the-Pin**\nMaster your approach shots.\n{675355952324165}", "short_description": "Here is the English version tailored to EnonoGolfPersonal, keeping the focus on training features and staying under the 500-character limit.\n\nTransform your space into a pro studio with EnonoGolfPersonal.\n\nFeatures:\nReal Courses: Play rounds on authentic, included golf courses.\nDriving Range: Refine your swing with unlimited shots and instant replays.\nVolumetric Swing Analysis: Compare your form against a professional's! Utilizing 3D capture from a dedicated studio, you can project a pro's sw"}]}, "developer_name": "Abic System Co.,Ltd.", "developer_privacy_policy_url": "https://enonogolf-p.abcs.co.jp/privacy-policy", "developer_terms_of_service_url": "https://enonogolf-p.abcs.co.jp/termsofuse", "publisher_name": "Abic System Co.,Ltd.", "support_website_url": null, "website_url": "https://enonogolf.abcs.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25632326736362747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618499_2706900896322673_646596313452875166_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVxOFwSihYMQ7kNvwEZNyZv&_nc_oc=AdmMNxQPho7Nb5vFogLwjyEo3ckYxy7eGPHidARsGA5Cb1wzzQ9moUjsRYT6l0QCSUM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWVqwhB2s6zLzRHXWCt6NWW-u4mFnSI-EQfIJ5Szmr0w&oe=69BA8662"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EnonoGolf Personal", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1734667200, "lastRevision": {"nodes": [{"id": "8999687153386634", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8999687103386639", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "588340227074801"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "miniCover.png", "id": "8510749929033942", "image_type": "APP_IMG_SMALL_LAN
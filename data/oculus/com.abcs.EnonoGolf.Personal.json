 "779747528417101", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618277_779747531750434_941145022281938101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV7dPmAY24wQ7kNvwG3CCtK&_nc_oc=AdpyyGmQLpxENwl5wf5XFqvoo64xjzIkSRNQztplPNOYeViJtWKN2R913wNJsDL3Uv0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af181ZIeeTzNaYOlRGqxCfU5cXneZnU1pjWPooRKvDRmKA&oe=69D7997C"}]}, "id": "2262974017532916", "locale": "en_US", "screenshots": [{"file_name": "com.abcs.EnonoGolf.Personal-20251216-114733.png", "id": "853975817261857", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499622276_853975820595190_587649647880148293_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2BcZVjay1wQ7kNvwH8STEd&_nc_oc=AdoUolUy4dnEGuLT3o6R2Slm7TeID6ChvWhBE4pdISkLi1FILZo-o_ph_XNs9QcFPq8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ozEEKnlP9w8yYEbOKwEQEfSkvYcE1BLSfdKIoK6vaUw&oe=69D7BB71"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-114703.png", "id": "868215049483849", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618288_868215052817182_7450514515068754739_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v62kOg5BiwYQ7kNvwEzFgRD&_nc_oc=AdrRDY0YMZor7dvFMLTcwhDAb_p2ergm4WzDeeYFFQulgOMag1DI_4LWpoKfpIBKlyw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Rf5yOAEibfD5ewgKJRSJcAX_76Y23TERdb-mnxNEFWQ&oe=69D7B6D7"}, {"file_name": "enonogolf-personal-screenshot-for-store-0.png", "id": "966598165430065", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391871_966598168763398_2673494751816208481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgiGovxoWzQQ7kNvwGTRO69&_nc_oc=AdqB7NcuR-tKLpwI1nh0Oa2PlurUcT3ITCWCt7cRi5McTh8rzN6jKa2JLImydWhiTlc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GFEC_l3klTUI1kiNEIkAAmh2PqkMq9FGJclAu-cPyzQ&oe=69D7B0C6"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-114452.png", "id": "1590347725318913", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620432_1590347728652246_923840658049877269_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvfqHptLX-oQ7kNvwGsJKto&_nc_oc=Adq2MWZsImvTNHMr90aaLcbiTDobKkyZgI5e2GWbBhYNnYr6WE09y7A6ddVkBgt6gxI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qH-WuitaJZpiEC1ayh5SYy7TiNX4pt9CNPt97XdHLbw&oe=69D7B1D1"}, {"file_name": "com.abcs.EnonoGolf.Personal-20251216-133129.png", "id": "1342248660504317", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619677_1342248663837650_9196868397227301834_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPUf71KaUxMQ7kNvwGH-NHY&_nc_oc=AdpA0wHrG6V-IHNX3afWWbs71u1wO7cRK65KK2PbKcWDO7jAkLg5a39JY5vX9ocPHOU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PnynhXre-MEeK2lGFP8_AnxaNxmKHZE5KFvtUta8_IQ&oe=69D7AB97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1980796055833494", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619704_1980796059166827_3356433641066268915_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phIqzw7NglAQ7kNvwErSubD&_nc_oc=Adoil-qu0NdKXWAiVod58sZvRuxK3Aca6d1CtXJHSc32a3h942-K4ynhKTCNvziMkWc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o_6nfQwPTUJcgJeQrLdc-DlibFAWnCbKUWwNTfF-4dQ&oe=69D79A5B"}, "display_name": "EnonoGolf Personal", "keywords": ["golf", "sports", "enonogolf", "real", "fitness"], "long_description": "# EnonoGolf Personal\n**The Ultimate Home Golf Experience**\n\nTransform your space into a professional golf environment. **EnonoGolfPersonal** combines authentic course simulation, advanced swing analysis, and engaging mini-games to help you master your game.\n\n---\n\n## \u26f3 EnonoGolf Round\nExperience the thrill of the fairway from anywhere.\n\n**Real Course Reproduction**\n\nAll included courses are scanned reproductions of real-world golf courses. Experience the authentic terrain and strategy of actual locations.\n\n---\n\n## \ud83c\udfcc\ufe0f\u200d\u2642\ufe0f Driving Range\nTrain like a pro with high-tech analysis tools.\n\n**Swing Analysis**\n\nEvaluate your form based on ball trajectory. You can switch views to check your swing from the **Side** or **Top** angles for a complete mechanical breakdown.\n\n---\n\n**Smart Replay & Comparison**\n\nReview your past swings instantly. Use the comparison function to view your replays side-by-side with built-in **professional player data** to identify areas for improvement.\n\n---\n\n**Volumetric Pro Playback**\n\nExperience the next generation of training. Utilizing **volumetric video captured in a dedicated studio**, you can project a professional\u2019s 3D swing into your space. Compare and sync your form with a pro's like never before.\n\n---\n\n## \ud83c\udfae Mini-Games\nSharpen your skills with fun, arcade-style challenges:\n\n**\ud83c\udf88 Balloon**\nTest your accuracy by popping targets.\n\n---\n\n**\ud83c\udfe2 Building**\nA unique target challenge amidst city structures.\n\n---\n\n**\ud83d\udca5 Driving Contest**\nUnleash your power for the longest drive.\n\n---\n\n**\u26f3 Nearest-to-the-Pin**\nMaster your approach shots.\n{675355952324165}", "short_description": "Here is the English version tailored to EnonoGolfPersonal, keeping the focus on training features and staying under the 500-character limit.\n\nTransform your space into a pro studio with EnonoGolfPersonal.\n\nFeatures:\nReal Courses: Play rounds on authentic, included golf courses.\nDriving Range: Refine your swing with unlimited shots and instant replays.\nVolumetric Swing Analysis: Compare your form against a professional's! Utilizing 3D capture from a dedicated studio, you can project a pro's sw"}]}, "developer_name": "Abic System Co.,Ltd.", "developer_privacy_policy_url": "https://enonogolf-p.abcs.co.jp/privacy-policy", "developer_terms_of_service_url": "https://enonogolf-p.abcs.co.jp/termsofuse", "publisher_name": "Abic System Co.,Ltd.", "support_website_url": null, "website_url": "https://enonogolf.abcs.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25632326736362747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618499_2706900896322673_646596313452875166_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q10zcxsPYQ8Q7kNvwGpryh_&_nc_oc=AdrxobkgIkFlYasWkORCT5597eH-vZyMZmGdLQEi_tEuuvemWqOObjnRDgNjppocD6M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af296a9KDcqSU1MwrXSM1e9lojnB7owcSYMte0l7gRw5nQ&oe=69D78762"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EnonoGolf Personal", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1734667200, "lastRevision": {"nodes": [{"id": "8999687153386634", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8999687103386639", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "588340227074801"}, "iarc_email": null, "msrp": null, "translations": {"nodes": 
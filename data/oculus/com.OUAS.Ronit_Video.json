tN-3-xugy9-vRyvJRWD00uk2zz0lxS7M-R7wZdS95NA&oe=6A4CF1E1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkxB20FlM4gQ7kNvwEVAlDX&_nc_oc=AdqQ8K3jS2zHFGH2AiDA3-QDDoLvKOuJFl-7szVPqyt8A1zdnaWq3anI4AYn__J-pAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3uGn-GLXReVW1_POBT6N0FbR0YeIpDCUngzWh7lOVOQ&oe=6A4CFE81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DHy_EZvK7YQ7kNvwEcohIZ&_nc_oc=AdqUU3Bu_KHGFjlOmvb1_j6gKDeouLOsoEO8lOCPyCzLq-iaCcDCRnk6HXfGfwDx6ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4Xp_NfVGHLPgvdVlZp6gnAMGlIepRta6ixmkasKItww&oe=6A4D103C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9Q
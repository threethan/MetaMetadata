5580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l9qflLmJEoQ7kNvwGPvadM&_nc_oc=Adpyot5Rl85mKoBWsHCDj0LTWUDMoo7CikXmBFchWr_wC9CQusZNLhHMAVLG6PSGAw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYatPZUAEnFKyCZQIJgR17MAKFuE9UJeMQTem6Is2JBA&oe=6B01C7A1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRsSNElPDJkQ7kNvwEgSfBN&_nc_oc=AdqxMrKUEejilLQzwZA6mMU9WDpeH8xAMR_nDdE24P4x9B5xaNVQauyeAeuv0uXnAqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrc4gBk5LplqjH2RSP09syTVh9MXND0tB2rEyBoP4qOg&oe=6B01D441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoagzPJKWcEQ7kNvwHjGgnh&_nc_oc=AdpCMndPPKFvI42LQzi9GOuG5I4OqDbnZ1pl0n5keU1mDko4KxbQ0_-L7KXpEe557vo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5X_kbjINBMloWsyuM7h6EL5DtWHcuPieJc7m5Do8v-g&oe=6B01E5FC"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "649803076263759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982535_353277713229039_3469310805404137579_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLSq8yav8ZMQ7kNvwGMvAl9&_nc_oc=AdpVMaLv7jw9wvF-m0CWNmtOmgaH6JFGcUPlCjnITMGyZ1XYPzeF1xNGP6Hlep_69Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGCzIMI64_pbN_lj0-sbofdRH3RujCq9Z0ounfjHVv0w&oe=6B01ECF5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS",
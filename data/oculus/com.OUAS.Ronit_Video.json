5580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCrbmsCfHh8Q7kNvwFo6UlU&_nc_oc=AdrRKxEsWy7a9OsjJfHeOD3tqPmbFcIn8SmpGUNrlK0Sgjgp4joGcszllZZpLc2dmdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlq-zl7JU9byD7-KwxNWiYX7E-9S-2eJCQT3CQD1hiGg&oe=6B070DA1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlQyLkxwIGsQ7kNvwFbQbhH&_nc_oc=AdrWPdXYq1fWPJ-gNKhgum5yRqATvo5zpqjLiIRAkRxF4qAO1nbAgbSsdBRQDOSKrQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9QYkBI0PEKKF2gKR6BCZeib3gI_XH5Yl2MLY3DXBs3A&oe=6B071A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7AU8j7HQVUQ7kNvwHRxb9_&_nc_oc=AdoWh9t2vlHeX_azqPDiTGVxi7WdcqI6Rk8qMxZwnCJbfkp9eIt7gyP9G2wGrZWFX_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX_FrmTw3tbhwCEjBW0Y6dxmNmP21FS5aRc91TFey0FA&oe=6B06F3BC"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "649803076263759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982535_353277713229039_3469310805404137579_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Yp9-PeRvj4Q7kNvwEKFVIz&_nc_oc=Adp1xAbHmWeUR0aEqush48ibbYNWyGFgzJ1pR8a1QuZbVabyiFTL9HViiG2KDM8CHvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLEmpvxPEt6ZeSATVeQ6xLr6hPX3nqisXJcDSHnuYjNQ&oe=6B06FAB5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS",
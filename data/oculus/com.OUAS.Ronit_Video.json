g8GoZUPnS18VXUz2N5dkCjV8X0J8DMPCWAZPel9zlHQ&oe=6AA151E1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orV1g3zaQaUQ7kNvwGIS3lr&_nc_oc=Adq-Pvx3ZublLJdYO1iHgFpxrDR2Gao_zrC1emRd5ykbRjaSCJXvCCaa6f63es0PaMg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoqlioItSX7Xtx5bdz1crIyDzDdl7VwfMpOrxHv3JsQA&oe=6AA15E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ4z53zb2bQQ7kNvwFXFFdM&_nc_oc=AdoyJgMGMQz5uve78wrVai1rwZqx1gfy_l49wB71ZXviks2SxgRBnDvcOmczqIbuQ9Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc2_VdhsXDX2mdAPEnFh6djN5JEwU4EAKlkEWSODAKCA&oe=6AA1703C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9Q
-1.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-Ibf-yJM-oQ7kNvwHlFJ2i&_nc_oc=AdpaxQGz_Ubyx-d-Ff6FCzDYLiWqhX_48QYRz3AB5p_YmifAPc6xBAwrvQF9Fr3DsVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u1YLQoEfIGWLgvdQWY-fBE3txXeJCk_CJO6fMjlrQUw&oe=69F9E51B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IbcBpbJHIgQ7kNvwHZPUa5&_nc_oc=AdqqFeGnV5FQ4kPyo5V9vaX3stg1SJ5C7nAWEbmuyOGDYqIbMkWfkBsCysHKVGPQ_Fw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cDWE8XEHFTDtzOx9zd8mC2rAgUbHQSOkO42lVuf_Nzw&oe=69F9EF68"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqiqMErK2kAQ7kNvwHAkJlW&_nc_oc=AdpeH1fkbY_RTFzfBtUlp6l3be0O8jKVeQTCBvKl2aZ0tJ-9zwl2Sh-kCXyBvzMJbsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k-5AusyLtRcDZUdPv-vECHMIv90PPkkgUVRxaNT9t9Q&oe=69F9E361"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT35lZJ0tggQ7kNvwFkADT3&_nc_oc=AdrzNPChQxhhaVuigaG8dcNKmxrNoVo6fSySNevnZ0js58dBS8hIeIm2K7vhmJ2QkEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6it3yZ16WLgnuSyouat4HjOHbozljrDcIBgRq6KkPXXQ&oe=69F9F001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb1c7TWr-KgQ7kNvwGhkHdL&_nc_oc=Adr9w8W5_LdDgfDoh8kWhtK20-jDUzkn6cTEa9u1cHJz8bZgdPXP9wS8cF-QKX9zdhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VqlhnKx0vizePw1IcjR3gDE6K4DgQsRpDC80XJk3oiA&oe=69FA01BC"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
5/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLZpIZsWY0wQ7kNvwF-YZBe&_nc_oc=AdnpQScA2ePhtGi7OfgXM6uHCOBwrPn-lIYnvhwJY67KZpkxkc3yt6rghbJXTaaaQh0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeNfm7o1Y1ef1gHwnBtFMhqi69zqAUu2Sov5yotCwcsA&oe=69AECA81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-gRnSjV6aMQ7kNvwEgczeJ&_nc_oc=AdlGr8Gqu840iBO3Kg5GYy1QLWjSOXUvBHIGptBBYgjxTAdGxbfJ_mUinKqgbnxf-rM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyh6kIRRgoJYZh11B3efTCFGSZut3NbB9oqxlmExMX92Q&oe=69AEDC3C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null,
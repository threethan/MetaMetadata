-2.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfYx8zj0Ve4Q7kNvwEgIEl8&_nc_oc=AdoQoc4zpAME09WtfLQTFwy_n8vs1DJBhb9Gku6WDqpj8s8YDf-DSCMi28Mm6KBUro4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-jQy3TvfBtUXfjeCRr5qSwy4ZxsZ4uTjlWIG24G1jbg&oe=6A05C29B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIOFR6gAzhoQ7kNvwE-kJsr&_nc_oc=Adr_9z0rdkMpY5TUbbBqg6koRIkZH95O6f7OWFMMNkk3kbgwts2n5HvEzSmr9f-uOXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dB7KPkyyFAU__ExrQoKFN7c7BbfQYoOmL9ymRyZ8J6A&oe=6A05CCE8"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6-a8G6tBLAQ7kNvwHd8yn8&_nc_oc=Adoibon8bwmc_5_VMueVEzW6fvpqLL_yQ2IG_mFk_AmeL5aL8fNJhsRuqXwLTSd-Sn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OLI0qDIihGyFowTsCQqDYgfv3ZOKCULuHE8xseDQrug&oe=6A05C0E1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6izAhufT3IgQ7kNvwF-EoxW&_nc_oc=AdoqAmiHJMnVgSVMBu_JuxaZHHTnjVY_jw7sjBoxAoKVPWZfAPQeDXFgGJAs2nuUBnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BYYGH4yWRFU7dYGrbp8dLGcrcetIxiebhJwbGp4PJmA&oe=6A05CD81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woO7ZYLyI-IQ7kNvwE_4Ifu&_nc_oc=AdrZkZ6H-VOy93uSVtcy8ZGi-lQn6n4ogEicl6cRra5PcGzZxTZYUbZjHwfNMDtXvfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X6XlArTRyhVR-cuLJcrtM0i3wW6Gi6PmGgFdcwO78HQ&oe=6A05DF3C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
-1.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRy7JQqoWjwQ7kNvwFqBAG5&_nc_oc=AdrMfgTsixAcLHKYQHCVW13ulOoevM87VkDm_Z7pNML9hIn5eJRE7tFTSoEZuP7fWME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEejEMFRhbAK9lqdpMeVhwNZrlXuPgqBkbaCOAn29orwg&oe=6A95AE5B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKXw-PeypFUQ7kNvwH0FZ2l&_nc_oc=Ado8mSoRkj-MllVktFrtKEvwhUIPkDPEh1PwoOQZgvsl6huuWCxQP2r-KV_GE54bXoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPD6Z7l-7mHLIuaEYgbIRbPUce9R77CC4JLjTMQsKDOQ&oe=6A95B8A8"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opW3WtZM9MMQ7kNvwG42P8o&_nc_oc=Adq2FCswSFIYlhlHbv13VDvzpRV-zg_B7ujZZn1xydRESwnlcHMskRsQ91pmZCVTE9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfBTyA5uJ7wpSbRa7kHIhVC8d1GTerCEC03P_N_Pno7Q&oe=6A95E4E1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqCK3ghrPxsQ7kNvwGrZim_&_nc_oc=AdolslrqP7xNt2tJ-R6t0SIIIRuJL0qRAZbnd5GbTWHEZp2lCwc05hb6ugIs2H5S_fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsioOSoLOf3bTScSvV3uRPgssNXGcmwBM_WWbz-5JyeA&oe=6A95B941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQR7burBMmgQ7kNvwGR6W_j&_nc_oc=Adp6HVhQToQxUt1tgTfyKgcIiiLHtQjprROMOWJSRNBerneutp7xpOy6jnAsyZNvLtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETZCb8C8KpK8fVNkdKx3JWL_66dk2qmX9FVObLpItiQw&oe=6A95CAFC"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
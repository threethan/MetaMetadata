xI7Cb8ZBwfFnm_7FWnMpyexfKujsqP-LG5mCkUrA0iA&oe=6AA697E1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgIJ00N9Q0oQ7kNvwGhsq3B&_nc_oc=AdoYwfI_nfVjJkKY_UDf885b8n3eV_ZrxfgrIrrGEU_wHplq-fLW6oDpm4wTNmjtbic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKofhHf4msnRkpah6xw4Fn2QrQhbrOvGNDhg10tsC2pFA&oe=6AA6A481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efp9PI5nQNYQ7kNvwEZm9Wn&_nc_oc=Adox-dY6HUVFmGgpzS5T6h21yUTo9SyexZzNNSoVT6r4q4yhlzLsY1rGxALyhc9TdwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpicXpNzT06Aj12l8Dq47JN92N0r1KnhyFn_jKimREEQ&oe=6AA6B63C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9Q
-2.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xakefdanmJoQ7kNvwHt7cGs&_nc_oc=AdoozRZ8qD7UNcaKNxL3lWHYGA2h4j_KwvyVg7--0a3YKEr1E_K9tnjBgcOKM1FD0cI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe5KNZTb2jyDT7dRbbJwkMnWkKz6O45hT3Mbkbafs9mA&oe=6A81AF9B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9s-p4yCTdEQ7kNvwGGaHq-&_nc_oc=AdrDa0-DZaSW2zOmXD3j0gG56KBGFpBJYTq3lQu6FoZ-mpxgRlzYpmGrb2uEKstciBQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtWx67R8W0dVc8f1-bO5bGyhy9JTjTmQjI8MqPm0PFtw&oe=6A81B9E8"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u--sPz1rCEQ7kNvwE_CZSo&_nc_oc=Adr84T3RiyM97Uy3NWKxQ1lqbJAU1p_IveHiMfwDE0tmXd2KQNvvnTf75bu3gKCGnSI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIoyRWQU-jRmCfHU9EnDcmriiwUwK14tJCURy7T7ZZTA&oe=6A81ADE1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFtftr4JeKwQ7kNvwENnhXu&_nc_oc=AdpMr8T6WpafL2PeeQuNAUKX2rrIDht8LUpvL6DpZ9FEbNXjYze3G_VDtpWJrGpUjEc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG3MOq-2owSe4juzHXSQosAGfGJi_5SakTl4EVMBmUqQ&oe=6A81BA81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idbN3n-6MyUQ7kNvwFkDBZg&_nc_oc=AdpXwybJVBEKi7twF6dnuFNDJmL0LhoGLEdhTkCRJE2KN18nurd2VB8d_89fYM-G-Ho&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC73U10afgonvXm4H_vxq1tssmvZYLfUtKu9oC1DYCpw&oe=6A8193FC"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
Uk1AxynAQ7kNvwGfTjj9&_nc_oc=AdmXhKfJxrQeAu0a4BK-QAG3E9XkA-AMHVfGUMnncmtQERdHhwgVkE8DmTTH4QmEV2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu97auZfFkGeo_EzRXOmj6tzpMsWegX7buxkW8eRCewNQ&oe=69A2ED01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60QRtJDDUs8Q7kNvwEt1TZH&_nc_oc=AdkD1fUB4uqbpoDCLHHGmFW9uwSsghLJZsPgn2C-moDhj918LEZl1M1ECyMc3KrVtsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslwcKngcsnJ5q9kQB92y4DCLoGpBe__qneW26maLqOGA&oe=69A2C67C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rat
-2.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GD5UA1JyCYQ7kNvwEOWobE&_nc_oc=Adqz7lrU6c868xKIorjB3uuhBaWdrOiMhJQZIhXshqyIY0vKGnC6sAGNZLc94djvLTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FKeNsCDnGLL424bM02pQovk1ipmp_4e0_kYwyJzF8jw&oe=69EE079B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdtwboJzJ-wQ7kNvwGujNia&_nc_oc=Adog5H8oxrMRF2KtQn-lESgfkg-NgsBPigussp2gedneNV3Deof1WVvnYYfTax6BJGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xlqiI2fChXSRJ19bi3sRJssODV9kYR-ekoDm0VgJtcA&oe=69EE11E8"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC-rqQKtsTkQ7kNvwEmcrOh&_nc_oc=Adq6qPK96n9lx9D2tRVblx3dtrCJhgIF3cIBXvWKSFuqw8G6qnG1rAo2rHMua-ydH7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i_9MUbkwvi3fEu4Row_aA4TxccrTS7e2qFlKKEVzrhg&oe=69EE05E1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNc6GB5BcmYQ7kNvwFhlxEP&_nc_oc=AdqU28COE7Kz0dh_gf-ZL4OFW_OE6Ar38Y1OjSx60g3sMs022AAZolZB0io0fvVuYFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GCNObH16bmvVxjqNvAOYaZJO51_MBbS3fuqAWTCGE5w&oe=69EE1281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WK4Nok6vjR8Q7kNvwFjHfsF&_nc_oc=AdqTS6WVtTNxc2e0dBse9FGSs_XADuUbvx7HqQuUCEZ5PlbguGquvPAzj7Ii21DcuLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NbURUhM1o9BZ_XNeKDmI2C2JNQWIyaeMI6iHXmWjS8g&oe=69EE243C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
-1.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIPDjhnPqKgQ7kNvwHg9um7&_nc_oc=Adrt9hgMbUwzmTaS2P2QhTXdW8cR-CiQYXW8KbiwzdgFzLAHtP6Oa8pDJ0lOiBC2rx0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z69JFkm1_pcWtnQyuH_728TuFkLlatIySDje5J4z3KQ&oe=69E0D89B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyHsgUprSn0Q7kNvwEa-YJr&_nc_oc=Adpwr656077WhAT8_AC7bTSFX5p33XOXI58y5F51woNfFSGPH0i4tE2sE5k3V_GmIaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HG32eusBMpN2CFd5MV9F7BhKXLDW-hiKPQcOXaNTXWQ&oe=69E0E2E8"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5B9MlRKu8kQ7kNvwFZ4dHa&_nc_oc=Adqei5vEkp_vPD9QisqEQaizgmbM20K4V58tqoKSLwBnenXrl6LYAzs4xMAraRXt18Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OxPr6is78CfP9z07Z5Ov7FTrdrXNKhfpilyDIUIBPqQ&oe=69E0D6E1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y5tO_ou8sYQ7kNvwEPgEqq&_nc_oc=Adq0NJhz8Ws53diFSB01KGPtW3W6EBCvZfVE2HseFWI5zMZSWBunWksWov9piDJQM2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MjLI9M3EMd2nE6NlvHUfPn5A2spTXIUxS4BWLTfqWMQ&oe=69E0E381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oZhcxxQrm0Q7kNvwHys_OU&_nc_oc=AdqMHCHMoeMfkAnI9bjkZH-f_xtYI9ZXN8LotfEVlwv3beEgtIxaeI4KpJZh23XJn8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P91YQVJhDOOhC03vJgllASOHC0Mqi4eWr5xoug5R5fQ&oe=69E0F53C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
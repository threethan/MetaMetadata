-1.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqRYEGQrBnIQ7kNvwEfg2YN&_nc_oc=Adruz3q2TTUHx_oq6M3iWmKfw6NuhRxHq6N54qlxvhPPkIVRW24YzgtQ6Ub7ARrxXxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afww7S9BLVTDrzY3gooOUfiAdzCcPIm91ZTv6HzgKPBCmw&oe=69D1069B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNnRU7GT-2EQ7kNvwHbUCZL&_nc_oc=Adq2QLag-LfRfGO1PWPFO1tg_cM-_FmuMgNboMgM8qsFBAK-SwFmKuVVOiJNom-6a0g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzMdUqL83qFTQZL9r-zZ060iNCXRqC2AGs4duWpz-m9w&oe=69D110E8"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf3QbUxf1_4Q7kNvwGZI5Y4&_nc_oc=Ado_KbgwVkYJTriHADs_LlDcNB5VsM1-zgOpanOZjNs9Vy71cmYUu_Bti6vyU08rziU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKACrWrXTbT3E0opYnzLtPRVKMIRPCxDdNowfMNm2h9A&oe=69D104E1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hY5kEGUYVm8Q7kNvwFjkc20&_nc_oc=AdqWQfEfMQI5i4XysjGxW2K_Treb8G6OcylYe_p81C2ANp--cpGtPTfRIUbgLJRS4PI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHxCGAwVFHsFAktvlKzOsZnWvRDpe2jotUHav05V8a5Q&oe=69D11181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pFhgHNgmloQ7kNvwHQjOlj&_nc_oc=AdrIKkvq_eqYnkrGIDKK8QH1WiDgJ67YP-COkn6RColIbzuJVIN7JZ2upeaSAyq4GsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDiFoUq4PpEce3Y3hr7IfjZRQAN97nBG4AoVG-CCeiHw&oe=69D1233C"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
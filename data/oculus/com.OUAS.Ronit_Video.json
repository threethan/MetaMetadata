lOe3UWot2tdDfVyksfAj07LI0O_X2716OMfRj1WDc2g&oe=6AD251A1"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JayF5btG5-QQ7kNvwHR42MT&_nc_oc=Adq3jPdCac-jT1-foDq3Gbs5RdvQiUpyFBtQ_U4PnT8yYNd_8Qfpmz_myOZC3MuliC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0x2bs6xn3q1iW5RbHJh09Odb67GO2eChT4lPskgbHzQ&oe=6AD22601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUU2vypqAmAQ7kNvwGeGuKK&_nc_oc=AdrwW_zdeLD40on2OqnjwEQCC7MT1-zoHvrAz9yooEzu33-Fr2q_OWjspSEpWiT2nUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuja60gduLYYiq7UuUx0D4jn7dNvXrogL-uZeaCZgHkQ&oe=6AD237BC"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9Q
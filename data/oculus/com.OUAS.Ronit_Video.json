-1.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6zrRQEpIMUQ7kNvwFKx3wZ&_nc_oc=AdqRQaMiU9COimLn36ygBR2Zn-IY7KupFJY9_CsLwOYnbNYWfaO5h8H3WzfiDdWyp8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uqn3l8SCovyPPMvuEwnJ481dsID08PWfwgxejJK-lsg&oe=6A01CE1B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DybO87u5zOcQ7kNvwG4eqU1&_nc_oc=AdqrRCfNHg4Z5mhWyVjKPhmQkk1iXbDe6h1JoemcEDUaV6bVRxw_v8Qz4L9022b5amQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DKVpSKn01WKtQWpZROXw75QvFUkdYD525Ygpce2VDoA&oe=6A01D868"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3rPdDDpcw8Q7kNvwE2rG3h&_nc_oc=AdqYeB0wBH7QR_14VFijNCjZ3YYVMmkE9Cs0agBxGArjhpcbOMFugCbqJEJUT7_14dM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I_DPOYBr-REmMtaRWFzH53TkPK00bv7qvkfWnQAvmGg&oe=6A01CC61"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0bayr8nUBQQ7kNvwH1wvYL&_nc_oc=Adqc4l3h3M5cEwT3Q3rHCMwlmcnyq_i48NylWN8NC3eB0vr1LtxLZcxWmqDJP80MfTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af568qjrAYF9WhTviuxUoE5jQTQzesLeDb1gmTneM4M0QA&oe=6A01D901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSEUoWnmMgoQ7kNvwEK2BqR&_nc_oc=AdpK5acCq4WmGYz6eVKwqzXjYeij9fk6GBmjVH0YwM8o3-UPJxCGNgLERFi-G2k5xiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G23LKOCLgZL46hCEiHAwZhaLJQHzJ2sYI0rLl1nynPQ&oe=6A01EABC"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
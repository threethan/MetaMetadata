-2.oculuscdn.com/v/t64.5771-25/75340706_1081876002578202_1774751231524808901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XGuxYZMDosQ7kNvwF50Cd4&_nc_oc=AdoIH6DQnNeukn-HvUQx2-Cs76JG31DcM1aDzmGStD-lSHjc0do_3w-ab5YCBaSuP-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QwFvslVij0kRhXbGOB-yWVspU8RW9T7Z1ONjOIPCmIw&oe=69E4CD1B"}, {"file_name": "Shot4.png", "id": "642280053625159", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395592_642280060291825_8468341892535758570_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCitSzZWPwUQ7kNvwH0JY-_&_nc_oc=Adq1yv2oQQwYJNZxYbTvZ6KD-kPr5GlqXiHOiw3HCPABAOEtOD2hKoGpnwIMtxGyHJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y0vBLhZSxj5PvemhjWFxmEWSjQvevjObeMhN_rL53yw&oe=69E4D768"}, {"file_name": "Shot5.png", "id": "333648481908842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580066_333648485242175_7142114941362976780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OePBFmguB1MQ7kNvwEb5Zj4&_nc_oc=AdorlHo47qwBeKM892CFSR1uRORUyY_srxVobOteUPPtPgpPa20r_9Rc5A1n5FO02_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qO4N6lyLirvA8-6REtXtqONVVDFHX-cgrN9T5y83oSQ&oe=69E4CB61"}, {"file_name": "Shot2.png", "id": "895321564686677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75302968_895321568020010_5297126940155273314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6089liVw95cQ7kNvwFWMEHO&_nc_oc=AdqJEsYmbcZ7V1wjjVtujLPLM8m6a_Dt4GMtl4Zh0tPiHXMPVZ51P3qeythMjtOyLS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i-jrMon8E6iU3aTgyN6Ib5UHJt53VuYEdz7Bbl1Z1Vw&oe=69E4D801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "964392504162072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_964392507495405_8574370962776368180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqJyz1hNhGUQ7kNvwEylHD_&_nc_oc=Adr0959WwOXCWQiaFwGBTFuRpJyOczS6hUgA4zFkY-c8GYI_MOjhhYHW38OG1snlAl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uLetgSkwgoYzSFWxTZ3lvw_dcwpqEhr3TYN4wQgeshg&oe=69E4E9BC"}, "display_name": "Once Upon a Sea - Ronit Hillel - The Muse", "keywords": [], "long_description": "The artist Ronit Hillel lives in a tiny one-room apartment full of paintings. Following a severe joint disease and after despairing of modern medicine, Ronit moved to Kibbutz Mitzpe Shalem at the foot of the Dead Sea. She left behind a large family, an embracing community, and an active studio, as she found a cure for her pains in the waters of the sea and the sulfur pools. But this natural remedy is in danger of extinction - following the receding of the sea and the closure of the beaches", "short_description": "\u201cOnce Upon a time, Earth\u2019s tectonic forces sculptured the deepest of hollows. Over eons it welcomed and held the waters of ancient seas. But Earth shifted once again and another metamorphosis began. It left in its wake oceans of salt layers, one lone river and a dying sea\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
h=00_AQQxZGEPWtgz8qpHMeJUCBGOYa6uf8f2n6vYICW6M7kgMw&oe=6AF9C640"}, {"file_name": "screenshot_5_2560x1440.png", "id": "2379290639546310", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673819499_2379290642879643_4008630812682329332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdW2dFhgxZoQ7kNvwEQS_uP&_nc_oc=Adr6rfi0dof3wGEkelfJFt5tOdBV2yqvmV7B7mY48RqM9tPbaxz4Pg4GqHBf1wkLrCw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA_iTsX8u4QK4bIWf1GM6HFN05BF7j2SOAydGLI-QXOg&oe=6AF9DF39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1090459400356788", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/595119480_1090459403690121_8722676598744107470_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-wNsDh9xzwQ7kNvwGaIvDT&_nc_oc=AdqF1HZVg8bp_HPmpSO5mKAysLTf2A3OXSX1rWhd4bLcHF6yi5fKh-uj_mvXumLdTQ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFCOqXpNH402szxFvWYMk_Z2sFGuCQB5lWrE8xxotVJg&oe=6AF9EA0D"}, "display_name": "CLAY", "keywords": ["pottery", "clay", "ceramics", "sculpting", "art"], "long_description": "CLAY is a relaxing pottery studio in VR. Step up to a potter's wheel, watch it spin up, and shape real clay with your fingertips.\n\nSHAPE IT WITH YOUR HANDS\nPut the controllers down and use your own hands - hand tracking puts your real fingertip on the clay. Squeeze a lump and it rises into a tall cone, press into the middle to open a pot, pull the walls up, push out a round belly or pinch in a narrow neck. The clay keeps its volume, so it moves the way real clay does. Prefer controllers? A short clay finger on each controller does the same job.\n\nGLAZE AND KEEP\nChoose from four clay bodies and seven dripping glazes - celadon, cobalt, tenmoku, honey, speckled white, turquoise and sunset - and see them on your pot straight away. Press KEEP and your finished piece flies to your My Pots shelf. Everything you make is saved.\n\nA STUDIO BY THE SEA\nFive wheels across a bright seaside apartment: two by the big windows, two in the kiln room with the glaze buckets and drying racks, and one out on the balcony looking over the ocean. Music plays on the studio radio and the waves roll in on the balcony.\n\nNo timers and no scores - just you, the wheel and the clay.\n\nDeveloped and published by Citiview Studios.", "short_description": "Throw real pots with your own hands. Shape spinning clay with your fingertips on a potter's wheel, glaze it in seven dripping colours and keep your favourites on your shelf - in a sunny seaside studio with an ocean-view balcony."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/clay/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/clay/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1246354555237184"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1421713530176857"}]}, "baseline_offer": {"id": "1421713530176857"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790011320, "status": "PUBLISHED", "id": "1421713530176857"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"node
c_ss=7f20f&oh=00_AQQ6-ZNTvH9w0viMyY1f0A6094QX3B5CJIt6EiR1inqWgg&oe=6AF9CC8B"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1111017321382209", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673607600_1111017324715542_9156170500251530095_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hrbHXTNytkQ7kNvwGXJ5Yw&_nc_oc=AdqAF4Y7QBR5zEYbX5F04YS0QBE8HzfGpXBva1OvDKeJHehQEmjFW-j8YuV46G0CguI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyvDOKyNIVgyTt9d-pGPAGLxWje2bmnkr_pVbtbUzBqg&oe=6AF9CB89"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1862770028219866", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595129854_1862770031553199_5846315089001093340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk0Klp7O8GIQ7kNvwFMhaKW&_nc_oc=AdrTaU3TYNPYLsmQ4Vnvkdavss_h4yZntmhGVWQeyB7DLrLVCgwt4AbU9lC6kB0_I0I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxZGEPWtgz8qpHMeJUCBGOYa6uf8f2n6vYICW6M7kgMw&oe=6AF9C640"}, {"file_name": "screenshot_5_2560x1440.png", "id": "2379290639546310", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673819499_2379290642879643_4008630812682329332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdW2dFhgxZoQ7kNvwEQS_uP&_nc_oc=Adr6rfi0dof3wGEkelfJFt5tOdBV2yqvmV7B7mY48RqM9tPbaxz4Pg4GqHBf1wkLrCw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA_iTsX8u4QK4bIWf1GM6HFN05BF7j2SOAydGLI-QXOg&oe=6AF9DF39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1090459400356788", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/595119480_1090459403690121_8722676598744107470_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-wNsDh9xzwQ7kNvwGaIvDT&_nc_oc=AdqF1HZVg8bp_HPmpSO5mKAysLTf2A3OXSX1rWhd4bLcHF6yi5fKh-uj_mvXumLdTQ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFCOqXpNH402szxFvWYMk_Z2sFGuCQB5lWrE8xxotVJg&oe=6AF9EA0D"}, "display_name": "CLAY", "keywords": ["pottery", "clay", "ceramics", "sculpting", "art"], "long_description": "CLAY is a relaxing pottery studio in VR. Step up to a potter's wheel, watch it spin up, and shape real clay with your fingertips.\n\nSHAPE IT WITH YOUR HANDS\nPut the controllers down and use your own hands - hand tracking puts your real fingertip on the clay. Squeeze a lump and it rises into a tall cone, press into the middle to open a pot, pull the walls up, push out a round belly or pinch in a narrow neck. The clay keeps its volume, so it moves the way real clay does. Prefer controllers? A short clay finger on each controller does the same job.\n\nGLAZE AND KEEP\nChoose from four clay bodies and seven dripping glazes - celadon, cobalt, tenmoku, honey, speckled white, turquoise and sunset - and see them on your pot straight away. Press KEEP and your finished piece flies to your My Pots shelf. Everything you make is saved.\n\nA STUDIO BY THE SEA\nFive wheels across a bright seaside apartment: two by the big windows, two in the kiln room with the glaze buckets and drying racks, and one out on the balcony looking over the ocean. Music plays on the studio radio and the waves roll in on the balcony.\n\nNo timers and no scores - just you, the wheel and the clay.\n\nDeveloped and published by Citiview Studios.", "short_description": "Throw real pots with your own hands. Shape spinning clay with your fingertips on a potter's wheel, glaze it in seven dripping colours and keep your favourites on your shelf - in a sunny seaside studio with an ocean-view balcony."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/clay/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/clay/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
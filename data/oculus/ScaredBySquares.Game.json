t=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnFJmlqVkl0dGWe-Wn3YcTz2J-5On8FhcC7WM4zNmh4Q&oe=6B0D9FE7"}, {"file_name": "1.png", "id": "648847211615842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626586_648847214949175_1702604157614741138_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nq24B_jZ8pQQ7kNvwEL3qm9&_nc_oc=AdpA87MzyQ3E3htr-B-2UvHI12IxPm3N1-Q9UHqulP2SAjgGNrV2y4H0TlmvGKdJ5UA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBBvvlseI62YjuYuTMkuIuVQ7gbARpHvHwO4qSlLLojQ&oe=6B0DBE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Multiplayer Update wide.png", "id": "27847979598172053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_27847979608172052_6415010084364317100_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzZAgbl2tWIQ7kNvwEPoaYK&_nc_oc=AdrjC39gIjWYVf3R2dUuEj864QFXmUpBwx_61s3LqPW9mIZ2o2ymFeELQ6vN-nxCIWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScKupAd1BVs96YNlUyP_upEAQDW-JMaT_S2HsFWD_1Sg&oe=6B0DA902"}, "display_name": "Scared By Squares", "keywords": ["Horror", "Puzzle", "Adventure", "Survival", "Narrative"], "long_description": "#                                                                                                                                                                                                       \n{798335439482046}\n\n# WARNING: Do not play if you\u2019re scared by squares.\n\nScared by Squares is an exploration experience built entirely from cubes. Use your senses to navigate each room as you solve puzzles, survive platforming challenges, and hunt anomalies. What secrets will you uncover as you delve deeper into The Cube?\n\n{848100537561043}\n\n**Uncover the Mystery**\n\nYou have been sent into The Cube, a digital prison made of perfect squares, to investigate reports of corrupted geometry. Your mission: locate and cleanse all anomalies and restore balance before they consume everything.\n\n{1471162510591402}\n\n**Test Your Skill**\n\nBetween mind-bending puzzles, hidden traps, and cubic enemies lurking around each corner, every room you enter offers a new challenge. Harness all your will, focus, and courage to make it through.\n\n{1106441114795445}\n\n**Adapt & Overcome**\n\nOngoing developments bring new challenges to your experience within The Cube. More floors and puzzles, new anomalies, and features such as multiplayer will be added as The Cube continues to expand.\n\n==================================\n\n# NEW GAME MODE: Escape the Grid\n\nA randomized grid adventure where every door leads to a new danger. Cleanse corruption, dodge deadly cubes, gather anomalies, and escape before the whole run collapses.\n\n{1384213246383389}", "short_description": "Scared by Squares is an experiment in horror. Can you create fear without ghosts, zombies, creepy dolls, or the usual tropes? What if all you had was the least scary thing in the world: a simple cube? The result might surprise you."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "
-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYxDHJUc9RdnnzG3vguJ-NZ_6EaPmDoiV_YtdXj1dFEg&oe=69B41E74"}, {"file_name": "02.png", "id": "1051169933114091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820579_1051169936447424_2681324634786467971_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug9P4Z-IUQUQ7kNvwGUv0Rc&_nc_oc=AdkBs_-xRVfHEyemkLSR8HFMFx_l3byE_Bkvj1JteFhYVMUe7qAv7SVqGFrfFBnb6Og&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzf3J8WaW9X6CKWJ2C7LjN9PCM-O6oql5l5PN3qrwyPCQ&oe=69B3FEA7"}, {"file_name": "1.png", "id": "648847211615842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626586_648847214949175_1702604157614741138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWuh3ABqGD0Q7kNvwELlECU&_nc_oc=AdnEReUQFNC89cpTHIgygiyH2SAX2NScPeGCZE6zbzYqVnzFpn9cuPUhaJp3BVdR7Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIWajQPJ4dtgkERBYt2wLEgrDSdtDo_p2nTmNwdtLMRg&oe=69B41D56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS_Main_Redesign_Landscape_Header_Trailer.png", "id": "2121967655274102", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294643_2121967658607435_8144277287595161388_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoZBbgRDTwMQ7kNvwFzcASk&_nc_oc=Adm4nY-Ch5SsZcy7N0C78jaaFnq2gDy28G8x6UJpMfySiGryFGAuIufrpLe9AhrRpQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztCoAqJd2wOTKNkFXzMkstwRR00SrYGaNEaemrpbPmGQ&oe=69B42231"}, "display_name": "Scared By Squares", "keywords": ["Horror", "Puzzle", "Adventure", "Survival", "Narrative"], "long_description": "#                                                                                                                                                                                                       \n{798335439482046}\n\n# WARNING: Do not play if you\u2019re scared by squares.\n\nScared by Squares is an exploration experience built entirely from cubes. Use your senses to navigate each room as you solve puzzles, survive platforming challenges, and hunt anomalies. What secrets will you uncover as you delve deeper into The Cube?\n\n{848100537561043}\n\n**Uncover the Mystery**\n\nYou have been sent into The Cube, a digital prison made of perfect squares, to investigate reports of corrupted geometry. Your mission: locate and cleanse all anomalies and restore balance before they consume everything.\n\n{1471162510591402}\n\n**Test Your Skill**\n\nBetween mind-bending puzzles, hidden traps, and cubic enemies lurking around each corner, every room you enter offers a new challenge. Harness all your will, focus, and courage to make it through.\n\n{1106441114795445}\n\n**Adapt & Overcome**\n\nOngoing developments bring new challenges to your experience within The Cube. More floors and puzzles, new anomalies, and features such as multiplayer will be added as The Cube continues to expand.\n\n==================================\n\n# NEW GAME MODE: Escape the Grid\n\nA randomized grid adventure where every door leads to a new danger. Cleanse corruption, dodge deadly cubes, gather anomalies, and escape before the whole run collapses.\n\n{1384213246383389}", "short_description": "Explore eerie spaces filled with cube-shaped anomalies and use your senses to solve puzzles, uncover secrets, and survive."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
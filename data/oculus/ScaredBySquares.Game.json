com&_nc_ss=8&oh=00_AfzZlzI-3sIDCVi8UUFH-L3tmH5o0TlguyLdBS3_QS3x-A&oe=69BC0774"}, {"file_name": "02.png", "id": "1051169933114091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820579_1051169936447424_2681324634786467971_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgbiZo2g5wYQ7kNvwENp7Bi&_nc_oc=Adl5bUjjvvyzHJY8GAD9JdfBZYsHarQuiWdsuYlMiFlCfKy3ITeGLEpufJJJaRwX5zs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyT871UjJViEaHlwnYgUdYGic7d5L9FN4I0_Zd530Bdlg&oe=69BBE7A7"}, {"file_name": "1.png", "id": "648847211615842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626586_648847214949175_1702604157614741138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COXxeWJiu54Q7kNvwGsNMZd&_nc_oc=AdlOnVkpF_KES6lmjC9R6pZCPu-_P6tMNOO9QuzYJvqBaR6f0vW0x5WYp5oP7a_-Plo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNPon2tMY02N9TR_VbXpqIBkz5LrbHPUnzq9p5Ps_FvA&oe=69BC0656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS_AB test_Landscape_030326.png", "id": "4230699787153762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296037_4230699790487095_5547558616184764929_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKX2XLBJE0wQ7kNvwH30ke4&_nc_oc=AdnxLn-JQ-xxenxru9IzYTr7a30-yhuFW_1LNwaZjIAKgjAb6GCrz5hLPIaHtZCv2dg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlWDas5cgiuMQmBm7mv6HetWasltGf11qn2AghtaJHlA&oe=69BC0662"}, "display_name": "Scared By Squares", "keywords": ["Horror", "Puzzle", "Adventure", "Survival", "Narrative"], "long_description": "#                                                                                                                                                                                                       \n{798335439482046}\n\n# WARNING: Do not play if you\u2019re scared by squares.\n\nScared by Squares is an exploration experience built entirely from cubes. Use your senses to navigate each room as you solve puzzles, survive platforming challenges, and hunt anomalies. What secrets will you uncover as you delve deeper into The Cube?\n\n{848100537561043}\n\n**Uncover the Mystery**\n\nYou have been sent into The Cube, a digital prison made of perfect squares, to investigate reports of corrupted geometry. Your mission: locate and cleanse all anomalies and restore balance before they consume everything.\n\n{1471162510591402}\n\n**Test Your Skill**\n\nBetween mind-bending puzzles, hidden traps, and cubic enemies lurking around each corner, every room you enter offers a new challenge. Harness all your will, focus, and courage to make it through.\n\n{1106441114795445}\n\n**Adapt & Overcome**\n\nOngoing developments bring new challenges to your experience within The Cube. More floors and puzzles, new anomalies, and features such as multiplayer will be added as The Cube continues to expand.\n\n==================================\n\n# NEW GAME MODE: Escape the Grid\n\nA randomized grid adventure where every door leads to a new danger. Cleanse corruption, dodge deadly cubes, gather anomalies, and escape before the whole run collapses.\n\n{1384213246383389}", "short_description": "Explore eerie spaces filled with cube-shaped anomalies and use your senses to solve puzzles, uncover secrets, and survive."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
aHrSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBSHzRe3a1BfXeZIlg-n1t5RCXkTQiCFusRAvynECu_g&oe=69A6EF74"}, {"file_name": "02.png", "id": "1051169933114091", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820579_1051169936447424_2681324634786467971_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TzYrRIlcKgQ7kNvwGOGHGQ&_nc_oc=AdnBO77s3uuJL_4xE-IPgm0mY3fU_pRIqpxtH1VEVsYb28ENEnatygq5OLkA9uAi6SY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuRWHn0bIPlUAZCQp6tqpzoh8KArmnLS-urWS7Rm_J9Lg&oe=69A6CFA7"}, {"file_name": "1.png", "id": "648847211615842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626586_648847214949175_1702604157614741138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxCsTiGT7qYQ7kNvwFyHaMw&_nc_oc=AdlEuTWYKnCTNPlJWs6BUF0GNlZryUtYbNhmh3MSaGzqkobMvnLFsBi-MBYfch67Fso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsz9MTH-AbOZLJDNnnnPeFs7wdw14os5pik8OQXyM_JeA&oe=69A6EE56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS_Main_Redesign_Landscape_Header_Trailer.png", "id": "2121967655274102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294643_2121967658607435_8144277287595161388_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rq6DBb5ZDIQ7kNvwHeQGJO&_nc_oc=Admd3Ogkt_TDWr-ZW29Vhr2xZZPTAR2n8881cu6ukhbwnZw35J0K_bwU4Rx9_mi-sig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFrKA4Shj9lJNfZB3Z2q_Enl0C0ZLq9QYrO_ioQUH8Ng&oe=69A6BAF1"}, "display_name": "Scared By Squares", "keywords": ["Horror", "Puzzle", "Adventure", "Survival", "Narrative"], "long_description": "#                                                                                                                                                                                                       \n{798335439482046}\n\n# WARNING: Do not play if you\u2019re scared by squares.\n\nScared by Squares is an exploration experience built entirely from cubes. Use your senses to navigate each room as you solve puzzles, survive platforming challenges, and hunt anomalies. What secrets will you uncover as you delve deeper into The Cube?\n\n{848100537561043}\n\n**Uncover the Mystery**\n\nYou have been sent into The Cube, a digital prison made of perfect squares, to investigate reports of corrupted geometry. Your mission: locate and cleanse all anomalies and restore balance before they consume everything.\n\n{1471162510591402}\n\n**Test Your Skill**\n\nBetween mind-bending puzzles, hidden traps, and cubic enemies lurking around each corner, every room you enter offers a new challenge. Harness all your will, focus, and courage to make it through.\n\n{1106441114795445}\n\n**Adapt & Overcome**\n\nOngoing developments bring new challenges to your experience within The Cube. More floors and puzzles, new anomalies, and features such as multiplayer will be added as The Cube continues to expand.\n\n==================================\n\n# NEW GAME MODE: Escape the Grid\n\nA randomized grid adventure where every door leads to a new danger. Cleanse corruption, dodge deadly cubes, gather anomalies, and escape before the whole run collapses.\n\n{1384213246383389}", "short_description": "Explore eerie spaces filled with cube-shaped anomalies and use your senses to solve puzzles, uncover secrets, and survive."}]}, "developer_name": "Siege Industries", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "re
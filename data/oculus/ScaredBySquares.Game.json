ZPBO-jP-pC5ALjgR54SLqB0dkAU2OJCPQ&oe=69DCF737"}, {"file_name": "05.png", "id": "721892363613989", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819983_721892366947322_4739484140901482329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrlYaimvZmMQ7kNvwH6edFk&_nc_oc=Adre-oDfLqZPAlsBbMDWzMZd_v8BiUXz6izO6u7XykW7UsrEvcZdLxI_IFJ2KJjwXuo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VnblPrIJXlCWkaxS6gSIz4G7s9wIMusp_JM-plbDJ2g&oe=69DCCE8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scared By Squares", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "WARNING! Do not play if you are Scared By Squares\n\nScared by Squares is a creepy VR exploration game where you navigate liminal, cube-filled spaces that feel just a little too perfect. Something is off, and it\u2019s getting worse.\n\nAvoid roaming corrupted cubes, uncover hidden anomalies, and try to hold onto your sanity as the world slowly unravels around you. Play solo for a tense, immersive experience, or explore the unsettling halls with friends, if you think that will help.", "short_description": "A creepy VR exploration game where you navigate liminal spaces, avoid roaming cubes, and uncover hidden anomalies in eerie block-filled mazes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.scaredbysquares.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Siege Industries", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
ith friends, if you think that will help.", "short_description": "A creepy VR exploration game where you navigate liminal spaces, avoid roaming cubes, and uncover hidden anomalies in eerie block-filled mazes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.scaredbysquares.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Siege Industries", "support_website_url": null, "website_url": "https://www.scaredbysquares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "9541229245982380"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1405288607624468"}, {"status": "PUBLISHED", "id": "2055677808361933"}, {"status": "PUBLISHED", "id": "2095629504321198"}, {"status": "PUBLISHED", "id": "3523811841105441"}, {"status": "PUBLISHED", "id": "1600957577646334"}, {"status": "PUBLISHED", "id": "1635518994434244"}, {"status": "CANCELLED", "id": "26366660289628464"}, {"status": "PUBLISHED", "id": "1426988615809059"}, {"status": "PUBLISHED", "id": "1713898146252092"}, {"status": "PUBLISHED", "id": "1391718742464786"}, {"status": "PUBLISHED", "id": "1895479571001552"}, {"status": "PUBLISHED", "id": "1289408689598144"}]}, "baseline_offer": {"id": "1635518994434244"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790704800, "status": "PUBLISHED",
665542_6931708224968446707_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6NVptTj-18Q7kNvwFunKhl&_nc_oc=Adng9a-xCFyWbG7Ih8nF0hea2gcRnyrtcfM9nMaTT7VtqpNpyRH9k-uRnoNGcNK3DJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvPbbIbAibDePVsc7qz4gw8m-6Nnom6h-_hiy1cCITxQ&oe=69A6E891"}, {"file_name": "03.png", "id": "1210707840603641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820987_1210707843936974_8346239956573572094_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwTfl2OrcQ0Q7kNvwFF6m5c&_nc_oc=Adl-MoBkejXK0mZ7jG4ZHF1mgkzDaAJPGgr3ulsHs5I1Ba0gxDOJ5BTxR9ge3bNAyGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4f0lrkn5pjGjyeov77Iak8VyhVNvPdwZpLH4gZR9TEg&oe=69A6E9B7"}, {"file_name": "05.png", "id": "721892363613989", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819983_721892366947322_4739484140901482329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvBNOX8bzlQQ7kNvwFngM-f&_nc_oc=AdnSLR0GWYu6EwPYETWwe6dIvwJ0gx1CX0Eii8u6mYsc9fDA3Aab1SQ53rt7uZI0Dfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsKHQzlcXeMLSMjmf9jF-h6hBL8qyHV3fbqfNv9lcQzEg&oe=69A6C10A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scared By Squares", "keywords": ["Horror", "Scary", "Maze", "Mystery", "Liminal"], "long_description": "WARNING! Do not play if you are Scared By Squares\n\nScared by Squares is a creepy VR exploration game where you navigate liminal, cube-filled spaces that feel just a little too perfect. Something is off, and it\u2019s getting worse.\n\nAvoid roaming corrupted cubes, uncover hidden anomalies, and try to hold onto your sanity as the world slowly unravels around you. Play solo for a tense, immersive experience, or explore the unsettling halls with friends, if you think that will help.", "short_description": "A creepy VR exploration game where you navigate liminal spaces, avoid roaming cubes, and uncover hidden anomalies in eerie block-filled mazes."}]}, "developer_name": null, "developer_pr
t be careful oh precious monke, in the magic arena thou mayest also summon enemies that will crush thee with a somewhat large hammer or bite thee many times without reproach. \n\nDoth ye have what it doth take to be a monke mage?", "short_description": "Cast spells using your voice and become the ultimate monke mage!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/monkemages/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "2710427532541308"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26341133992165531"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822581_4284124781806019_5481497302197202891_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NmAdru4epYQ7kNvwEptzz8&_nc_oc=AdqWnVXpu3YDYBe-byglvZ7uyX-ZQMenavNPesDe0uxNF923OL4AHCvNsk-PGjp-lvU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af06tj3tWrEJx73EI0lIQbJdBQEqFiSaPPDjsZ4e8uNNcg&oe=69F216A3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monke Mages", "platform": "ANDROID_6DOF", "context_category": {"co
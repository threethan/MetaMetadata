 "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391865_9857304347626462_6132659690303189452_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxVIIDIN3r4Q7kNvwEmvWVY&_nc_oc=Ado7nGq1oA15HuyBmM_qldrw90I-_rvFf8zcG7QwSmXuiw3ypsi3MVioHCBKvwb44k0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTukiyaZRowM69v9a_yjM6tQQqP3of26vw7C2n8xeyunQ&oe=6B0487B7"}, {"file_name": "Screenshot 2025-03-18 173244.png", "id": "962821469175411", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393531_962821472508744_845319575203587033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heKsTqjMvjIQ7kNvwGdJzsc&_nc_oc=Adq2MhcILO9xpLAYNRsBDKF6wptJS9XI2Ra3z_7y9JUSva9ljdu_YQqeS9ySgXHuAvA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6XMdbxx2vOxPnOr-_AqNl4wbYn7MDsmXU1f0Nt4duLw&oe=6B047D3D"}, {"file_name": "Screenshot 2025-03-18 173150.png", "id": "1847312199352998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392301_1847312202686331_9137977497301491155_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr0sLslra2AQ7kNvwHcrX2R&_nc_oc=AdoLZpnEox7T_lHE4j_9CibwaBsaAcy4CErmKWgsiUsxwQ1e791IHNf6K6i4ZNHiUT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNbbrqvRKqcOKRatwRpyUsKxJjDFlm8pqNnGRGS4iWEA&oe=6B047E27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Banana", "keywords": ["horror", "cursedbanana", "cursed"], "long_description": "Cursed Banana is a Gorilla Tag fan game with a horror twist. Instead of the usual fun and fast-paced tag gameplay, this game introduces a creepy, unsettling atmosphere where players must navigate eerie environments while avoiding terrifying entities.  \n\nThe game features a decent-sized map filled with dark and mysterious areas designed to keep players on edge. From dimly lit corridors to open spaces with an eerie silence, every corner is crafted to enhance the horror experience while maintaining the movement mechanics that make Gorilla Tag so unique.  \n\nTo add more customization, we're also working on cosmetics, allowing players to personalize their look even in the midst of all the scares. Whether you're exploring alone or with friends, Cursed Banana delivers a spine-chilling take on Gorilla Tag while keeping the movement and multiplayer fun intact.  \n\nStay tuned for updates as we continue expanding the map, adding new cosmetics, and making the horror experience even more immersive!", "short_description": "Cursed Banana is a Gorilla Tag fangame but with horror."}]}, "developer_name": "Randomness Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cursedbananawebsite/home", "developer_terms_of_service_url": "https://sites.google.com/view/cursedbananawebsite/home", "publisher_name": "Randomness Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/randomness-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9582616421759366"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393406_667977072247497_6533395931435714327_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mydSHZ3gNkQQ7kNvwE7nx2w&_nc_oc=AdrOzg9ArABgEDl1vogyXBySIdYPwsKMrQd7vpdkxPlwcTTFkLSt
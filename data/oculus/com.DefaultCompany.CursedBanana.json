ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBv-H5Amo4YQ7kNvwHofwFC&_nc_oc=Adqsw7SpQgiyvfSIII8RDZaMF66_3bjs9o0H5bgFCrfYbdBkWTu9FPsg_axRA-IB1ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSK0oXkv6V-xcHjr7kPXqO05X0IPhYlkjDo6C30QwXMRg&oe=6B0C55E7"}, {"file_name": "Screenshot 2025-03-18 173213.png", "id": "1604561526862035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391991_1604561530195368_763926814494975895_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LS80TIecV1oQ7kNvwEmDlfw&_nc_oc=Adr00YYZDMjiFiP08fWAh-WpA6Oue-B1PHxcYV_4L3-Sewh9TcF2iyuu3ZZYDacpfFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAxTZLNdIjadUbNc19pVuNulioDWlaWNSNXHne8QZVZA&oe=6B0C844C"}, {"file_name": "Screenshot 2025-03-18 173203.png", "id": "9857304344293129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391865_9857304347626462_6132659690303189452_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOo6Fs1mFuoQ7kNvwH9pFTL&_nc_oc=Adrd4UnHmg8hnLRivLIchjneBMc1Zh-wpqt8R_wRjW4DTLiiGEysZT_97zyQg2faTy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQyAVO0FrVgVZUXcXO6V6pah7tCF5NfOrvW07NTfeevg&oe=6B0C70B7"}, {"file_name": "Screenshot 2025-03-18 173244.png", "id": "962821469175411", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393531_962821472508744_845319575203587033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQSArlXu7F4Q7kNvwFVsbuF&_nc_oc=AdqVs6-bcd6OFl43mNpkUS3sA67El97jZdAlAm20EzOesAruaxiKa6TCYhzypqQCFbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSemezGu6LBZ8JQ2Yw-XbjOxMRoroQ86Ol8e9Qc63yK9Q&oe=6B0C663D"}, {"file_name": "Screenshot 2025-03-18 173150.png", "id": "1847312199352998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392301_1847312202686331_9137977497301491155_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIJ-QZMJjs8Q7kNvwGihCf8&_nc_oc=Adrk0AbEInZFEa0rx7Ue5HyIVRPNqHaoiGzL4kuizAABJJG7UCfw5GhzyCsMoVsm9Es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNPATmHfWek-AejM1ZhKrGYaYuaZpAHgu0X3vliaFnMw&oe=6B0C6727"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Banana", "keywords": ["horror", "cursedbanana", "cursed"], "long_description": "Cursed Banana is a Gorilla Tag fan game with a horror twist. Instead of the usual fun and fast-paced tag gameplay, this game introduces a creepy, unsettling atmosphere where players must navigate eerie environments while avoiding terrifying entities.  \n\nThe game features a decent-sized map filled with dark and mysterious areas designed to keep players on edge. From dimly lit corridors to open spaces with an eerie silence, every corner is crafted to enhance the horror experience while maintaining the movement mechanics that make Gorilla Tag so unique.  \n\nTo add more customization, we're also working on cosmetics, allowing players to personalize their look even in the midst of all the scares. Whether you're exploring alone or with friends, Cursed Banana delivers a spine-chilling take on Gorilla Tag while keeping the movement and multiplayer fun intact.  \n\nStay tuned for updates as we continue expanding the map, adding new cosmetics, and making the horror experience even more immersive!", "short_description": "Cursed Banana is a Gorilla Tag fangame but with horror."}]}, "developer_name": "Randomness Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cursedbananawebsite/home", "developer_terms_of_service_url": "https://sites.google.com/view/cursedbananawebsite/home", "publisher_name": "Randomness Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/randomness-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459
_oc=AdoLZpnEox7T_lHE4j_9CibwaBsaAcy4CErmKWgsiUsxwQ1e791IHNf6K6i4ZNHiUT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNbbrqvRKqcOKRatwRpyUsKxJjDFlm8pqNnGRGS4iWEA&oe=6B047E27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Banana", "keywords": ["horror", "cursedbanana", "cursed"], "long_description": "Cursed Banana is a Gorilla Tag fan game with a horror twist. Instead of the usual fun and fast-paced tag gameplay, this game introduces a creepy, unsettling atmosphere where players must navigate eerie environments while avoiding terrifying entities.  \n\nThe game features a decent-sized map filled with dark and mysterious areas designed to keep players on edge. From dimly lit corridors to open spaces with an eerie silence, every corner is crafted to enhance the horror experience while maintaining the movement mechanics that make Gorilla Tag so unique.  \n\nTo add more customization, we're also working on cosmetics, allowing players to personalize their look even in the midst of all the scares. Whether you're exploring alone or with friends, Cursed Banana delivers a spine-chilling take on Gorilla Tag while keeping the movement and multiplayer fun intact.  \n\nStay tuned for updates as we continue expanding the map, adding new cosmetics, and making the horror experience even more immersive!", "short_description": "Cursed Banana is a Gorilla Tag fangame but with horror."}]}, "developer_name": "Randomness Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cursedbananawebsite/home", "developer_terms_of_service_url": "https://sites.google.com/view/cursedbananawebsite/home", "publisher_name": "Randomness Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/randomness-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459
ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-sfKoHEeu4Q7kNvwHeYwG1&_nc_oc=AdozL00pFHchs2xdhH-23iTSIesIaIpnHIOmRdpQ6Q4ml0Mkv_ypNu5SSULksn6Ix_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4mve3bkfZv0a0iN167e-tp-Kw_TIXoiLl7W5Eq0YKMw&oe=6B031B67"}, {"file_name": "Screenshot 2025-03-18 173213.png", "id": "1604561526862035", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391991_1604561530195368_763926814494975895_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF_jE5TBTpAQ7kNvwGSXXng&_nc_oc=AdqONTbvV94SWpJ7OfBXkSuVIn9HI9uvrrOH3Ft6fr9WnCDkAAy2rplk93WxUqZcWjo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScW1IM5zITpxGFGO7EHcZOv8py73A_KWnfl7YtKwatrQ&oe=6B03118C"}, {"file_name": "Screenshot 2025-03-18 173203.png", "id": "9857304344293129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391865_9857304347626462_6132659690303189452_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxVIIDIN3r4Q7kNvwGFuJpY&_nc_oc=AdrgfUHPGKcBLdIuTbsI2NETqCZ64H0JxqhL5omqY00g3oEIWu4637Sw2kmvms9smio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJg0uCBayoGuwScvistdB3XyMtv8Dwr27P6vMkdE9UlQ&oe=6B033637"}, {"file_name": "Screenshot 2025-03-18 173244.png", "id": "962821469175411", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393531_962821472508744_845319575203587033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-86sTW2LnEQ7kNvwHjcqxN&_nc_oc=Adq0BH00QM_3YdpTgcB6hZ5Y6kvCLB13aBll4Mrp7-uz6-sQHm-MwroHHo8eR8UGODM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTex80K1LWdbtW4v7ZG6NOezTalOBJA2agXbE4HIWAUA&oe=6B032BBD"}, {"file_name": "Screenshot 2025-03-18 173150.png", "id": "1847312199352998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392301_1847312202686331_9137977497301491155_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5dab7U4U_4Q7kNvwF2_ltd&_nc_oc=AdqQIMLjJxoVvHinVA88GuC6vZqNPtRsoXbTwTm_nWshylhTdGEOLDYaNvUDZ0E47xs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAKnJjBdEqZUcNocu6lr6NZtNeBw_HBONRkBQ2C5d12w&oe=6B032CA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Banana", "keywords": ["horror", "cursedbanana", "cursed"], "long_description": "Cursed Banana is a Gorilla Tag fan game with a horror twist. Instead of the usual fun and fast-paced tag gameplay, this game introduces a creepy, unsettling atmosphere where players must navigate eerie environments while avoiding terrifying entities.  \n\nThe game features a decent-sized map filled with dark and mysterious areas designed to keep players on edge. From dimly lit corridors to open spaces with an eerie silence, every corner is crafted to enhance the horror experience while maintaining the movement mechanics that make Gorilla Tag so unique.  \n\nTo add more customization, we're also working on cosmetics, allowing players to personalize their look even in the midst of all the scares. Whether you're exploring alone or with friends, Cursed Banana delivers a spine-chilling take on Gorilla Tag while keeping the movement and multiplayer fun intact.  \n\nStay tuned for updates as we continue expanding the map, adding new cosmetics, and making the horror experience even more immersive!", "short_description": "Cursed Banana is a Gorilla Tag fangame but with horror."}]}, "developer_name": "Randomness Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cursedbananawebsite/home", "developer_terms_of_service_url": "https://sites.google.com/view/cursedbananawebsite/home", "publisher_name": "Randomness Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/randomness-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459
 "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391865_9857304347626462_6132659690303189452_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6Duz-nS0HUQ7kNvwGxPk7r&_nc_oc=AdqH6VwR_64VrLvkZ7hBJ25SlrR7NQKYwhAN_bo6-I94YdF6htuZY7Ye7LjwLPxthuA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn0jhSCoS63nEY5yWkuVlOqHk42RC5JL9NJB_dxqhH6Q&oe=6AFF0977"}, {"file_name": "Screenshot 2025-03-18 173244.png", "id": "962821469175411", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393531_962821472508744_845319575203587033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4_pBXmPsXgQ7kNvwHMjakZ&_nc_oc=AdpHtPXKov_vI9Gx2SaTVX5890ZjSBCE24g97riNNJ9R_xXhPi3tpMibRrngYaq_Iz0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScTaJaO48Vs89MNbo3xNjZN_Cu1JUP_XALotlFhohG5A&oe=6AFF373D"}, {"file_name": "Screenshot 2025-03-18 173150.png", "id": "1847312199352998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392301_1847312202686331_9137977497301491155_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGynvHCjvTIQ7kNvwFf9Ilb&_nc_oc=AdoaTaNbzo2iu2POWE7Ocgh_1CYbM6e9BqPMlzmRZILB7FgCIKCS1LbiECtZI5ti9Xc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP-u1cJoD30F5QSyxt8z0DnUQTHHLGlafiiZZKxH1C5g&oe=6AFEFFE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Banana", "keywords": ["horror", "cursedbanana", "cursed"], "long_description": "Cursed Banana is a Gorilla Tag fan game with a horror twist. Instead of the usual fun and fast-paced tag gameplay, this game introduces a creepy, unsettling atmosphere where players must navigate eerie environments while avoiding terrifying entities.  \n\nThe game features a decent-sized map filled with dark and mysterious areas designed to keep players on edge. From dimly lit corridors to open spaces with an eerie silence, every corner is crafted to enhance the horror experience while maintaining the movement mechanics that make Gorilla Tag so unique.  \n\nTo add more customization, we're also working on cosmetics, allowing players to personalize their look even in the midst of all the scares. Whether you're exploring alone or with friends, Cursed Banana delivers a spine-chilling take on Gorilla Tag while keeping the movement and multiplayer fun intact.  \n\nStay tuned for updates as we continue expanding the map, adding new cosmetics, and making the horror experience even more immersive!", "short_description": "Cursed Banana is a Gorilla Tag fangame but with horror."}]}, "developer_name": "Randomness Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cursedbananawebsite/home", "developer_terms_of_service_url": "https://sites.google.com/view/cursedbananawebsite/home", "publisher_name": "Randomness Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/randomness-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9582616421759366"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393406_667977072247497_6533395931435714327_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZsVzxyJ3BsQ7kNvwEsuC4F&_nc_oc=AdqYYvQhCn35z7EMkP2KirqpbdswQrW0LAAKgR665k_1ta79CgyR
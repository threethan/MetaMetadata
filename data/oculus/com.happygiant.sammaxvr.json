1.oculuscdn.com/v/t64.5771-25/38974469_235918231655618_9200480916509836758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh9yCNq7IlAQ7kNvwFT43NF&_nc_oc=AdlMBRXeroKUr_qex_U6LXp91WOH0QZH19cM4zK0R0f_YSgRPnYAXefgzSH4lzS5o3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdNskQiV5LdXpWTjASLalB5XbaYgWv0BWkzu8p9qRrRQ&oe=69A6B95C"}, {"file_name": "SMVRFinalQuestScreenshots02.png", "id": "1202634946843386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982715_1202634950176719_6841690957288523386_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUtZtRjJfi0Q7kNvwECRCX3&_nc_oc=AdlLszrkYMRlNej0yEeInWN5pCNsInnln5XDrB329ZTNElGb9ghgvXxl4M5X3i4jMCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFofPyerN0kY42Au5Jv7GnjfW8312lNdiFwa-7_4InZg&oe=69A6CC25"}, {"file_name": "SMVRFinalQuestScreenshots13.png", "id": "528250488391317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_528250491724650_1577659830106612444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWgiCyThAH8Q7kNvwHZ8GIH&_nc_oc=AdmHScD6rLMIfFRo3mB_v6zlIwRpQFYvILNKuIC4lDgD7Lnag_X77pafmdX2EraqH3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvXGYrAOYOtEBH-o66Mz77O3OyVyZRGY7-RuoURkrmBwA&oe=69A6C06C"}, {"file_name": "SMVRFinalQuestScreenshots10.png", "id": "326371915829001", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974680_326371919162334_129873048362627550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNtgPX3HkE8Q7kNvwGq5Myg&_nc_oc=Adnph4hG_2FEmrfLmQP-Zs9B_csDPGMqDp90LrdfRyySHVuINOs0eTGHThRpZ-NPdTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfveBIFcSwcyh215MMNonJCx9Oy1A0l_FgQsGN5E9r9gVQ&oe=69A6C62F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusCover2560x1440VIDEOENDSLATEWITHLEGAL.png", "id": "321306219352083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035305_321306222685416_4438699296036008856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmlGWG2vfvMQ7kNvwEOtDKS&_nc_oc=AdmsTmiSCxSZ3OJUbTL-x5wHvEi-YnuyRmNs5yStPooc3dexl53VEMg6tUTVDUm3WSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1DTytaR743daMo33sAz8dtxcXfFFzE97hWWfbs1QdbQ&oe=69A6E5D6"}, "display_name": "Sam and Max: This Time It's Virtual!", "keywords": ["Comedy", "Adventure", "Narrative", "Action", "Arcade"], "long_description": "Sam is a dog with a hat.  Max is a hyperkinetic naked rabbity thing.  Together, they\u2019re the Freelance Police, the intergalactically famous agents of indiscriminately applied justice, now starring in their umpteenth video game, Sam & Max: This Time It\u2019s Virtual!  Even multimedia evil-slappers like Sam & Max could use a hand, and this time they\u2019re using the incomprehensible magic of virtual reality to invite the player into their off-kilter world for a furious day of monster-slaying, obstacle courses, responsibly discharged firearms, and, of course, saving the entire freaking world.\nKey features:\n\u2022Discover the horrible and socially relevant secrets lurking behind, under, and within Cap\u2019n Aquabear\u2019s rotting theme park!\n\u2022Push yourself to be the best of the best of the middling, as a dog and a naked rabbity thing harangue and cajole you through a bewildering assortment of Freelance Police Academy training challenges.\n\u2022Immersion so real you can feel Sam\u2019s breath on your neck!\n", "short_description": "Sam is a dog in a suit.  Max is his naked rabbity partner.  Together, they\u2019re the Freelance Police.  Jump into the not-quite-right world of Sam & Max via the wonder science of virtual reality, and join the multimedia darlings in their never-ending quest to slap the stupid grin off the face of evil."}]}, "developer_name": "HappyGiant", "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "https://happygiant.com/terms-of-service", "publisher_name": "Big Sugar", "support_website_url": "https://happygiant.com/#contact", "website_url": "http://www.happygiant.com/
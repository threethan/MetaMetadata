U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR57jYUly8Ea-qWrRmCXFHmOfUMdFOFcCQVFp6WuDRfA&oe=6AFDC46F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusCover2560x1440VIDEOENDSLATEWITHLEGAL.png", "id": "321306219352083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_321306222685416_4438699296036008856_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbF0fcD0u9kQ7kNvwHI8etF&_nc_oc=Adp-zkTuB1CCjG8DGzfEUU_Lth-n_Q2ZjFuOG0HFKvDjEvC6Ua0tjfwugUblfzbCCB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWJcsoQnFhbrxp1cIRMf2Dq0tS-P5av7jNBQ2y1tcPFw&oe=6AFDE416"}, "display_name": "Sam and Max: This Time It's Virtual!", "keywords": ["Comedy", "Adventure", "Narrative", "Action", "Arcade"], "long_description": "Sam is a dog with a hat.  Max is a hyperkinetic naked rabbity thing.  Together, they\u2019re the Freelance Police, the intergalactically famous agents of indiscriminately applied justice, now starring in their umpteenth video game, Sam & Max: This Time It\u2019s Virtual!  Even multimedia evil-slappers like Sam & Max could use a hand, and this time they\u2019re using the incomprehensible magic of virtual reality to invite the player into their off-kilter world for a furious day of monster-slaying, obstacle courses, responsibly discharged firearms, and, of course, saving the entire freaking world.\nKey features:\n\u2022Discover the horrible and socially relevant secrets lurking behind, under, and within Cap\u2019n Aquabear\u2019s rotting theme park!\n\u2022Push yourself to be the best of the best of the middling, as a dog and a naked rabbity thing harangue and cajole you through a bewildering assortment of Freelance Police Academy training challenges.\n\u2022Immersion so real you can feel Sam\u2019s breath on your neck!\n", "short_description": "Sam is a dog in a suit.  Max is his naked rabbity partner.  Together, they\u2019re the Freelance Police.  Jump into the not-quite-right world of Sam & Max via the wonder science of virtual reality, and join the multimedia darlings in their never-ending quest to slap the stupid grin off the face of evil."}]}, "developer_name": "HappyGiant", "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "https://happygiant.com/terms-of-service", "publisher_name": "Big Sugar", "support_website_url": "https://happygiant.com/#contact", "website_url": "http://www.happygiant.com/samandmax", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "fr", "es", "fr_CA", "es_PR", "fr_BE", "es_CL", "es_MX", "zh_CN", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1056342185237199"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_221272423240902_85322018656346448_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uGT0ZJQftkQ7kNvwFlulRk&_nc_oc=AdrX59gRrhoWIxBJ1MIW9v0Vk6mSLCkNmlkpn3x6cCpm7fOuaJ8XjJdapvnpqxUOUbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlAelYYxtwJnceEeASIXM1ha4t7k3woXwAsatxSMkRGA&oe=6AFDC782"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sam and Max: This Time It's Virtual!", "platform": "ANDROID_6DOF", "context_category": 
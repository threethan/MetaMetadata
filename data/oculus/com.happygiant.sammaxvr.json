{"file_name": "SMVRFinalQuestScreenshots01.png", "id": "235918228322285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_235918231655618_9200480916509836758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JRV6z5WN_4Q7kNvwFdJPIx&_nc_oc=AdqtmBac0NFd1CC6jQlYBi0A11ue_GBT0UCAOSqyzETNTJ6D9YAwmEEOEyCnJeTEaho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37WXzRXfSk6-ksZpWTKysySw9rVAJMbb063LTSFH1zpw&oe=69D2731C"}, {"file_name": "SMVRFinalQuestScreenshots02.png", "id": "1202634946843386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982715_1202634950176719_6841690957288523386_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkHl7bET2bIQ7kNvwEhCIdS&_nc_oc=AdquVqEpm9Yg_nUzjLaI6Um-uksgs-F-cPQd_jDb70Ssy1EXUOcAd8_EEoV2fSKv0_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jIXZMPvET4vHFGWmetDlLdc0P8xgyI7ioOtaZrtXslQ&oe=69D24DA5"}, {"file_name": "SMVRFinalQuestScreenshots13.png", "id": "528250488391317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001721_528250491724650_1577659830106612444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH4ok-orgh4Q7kNvwGKDr8_&_nc_oc=AdqeOh3DX0U5HzV7iGYm2DQmC_af1XVOCZRpwVaB8wDZVQxDQcQQlEwYEKk1CJva5hE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pcjw6LivDo-ge_ccFC0MX0yGlKTva1pULn-oOMlaonA&oe=69D27A2C"}, {"file_name": "SMVRFinalQuestScreenshots10.png", "id": "326371915829001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_326371919162334_129873048362627550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_1qYxU46vwQ7kNvwHGIMhM&_nc_oc=AdpTP-Sp4H03snDrW2GQ-mAFHUcFOoLAwNT0SKdWp0Nus-1H6Q3ngu5rGkBNenXiefI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3txuB_0UCH11BJGv2VoS1rogFHL5kZb7p5V1TxZag7hA&oe=69D247AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusCover2560x1440VIDEOENDSLATEWITHLEGAL.png", "id": "321306219352083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035305_321306222685416_4438699296036008856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfEdVTFRaGMQ7kNvwFLGYuT&_nc_oc=AdpZlHuQoMjqQ07jFCf-576qmO_PPxiyEpDeqwo1GRPMllM3l0uz-25qQ3CWSZ6R7CQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af352txQylO9KQTFxLlseUPWv-feSEA3Fe5GhSEGYapwXQ&oe=69D26756"}, "display_name": "Sam and Max: This Time It's Virtual!", "keywords": ["Comedy", "Adventure", "Narrative", "Action", "Arcade"], "long_description": "Sam is a dog with a hat.  Max is a hyperkinetic naked rabbity thing.  Together, they\u2019re the Freelance Police, the intergalactically famous agents of indiscriminately applied justice, now starring in their umpteenth video game, Sam & Max: This Time It\u2019s Virtual!  Even multimedia evil-slappers like Sam & Max could use a hand, and this time they\u2019re using the incomprehensible magic of virtual reality to invite the player into their off-kilter world for a furious day of monster-slaying, obstacle courses, responsibly discharged firearms, and, of course, saving the entire freaking world.\nKey features:\n\u2022Discover the horrible and socially relevant secrets lurking behind, under, and within Cap\u2019n Aquabear\u2019s rotting theme park!\n\u2022Push yourself to be the best of the best of the middling, as a dog and a naked rabbity thing harangue and cajole you through a bewildering assortment of Freelance Police Academy training challenges.\n\u2022Immersion so real you can feel Sam\u2019s breath on your neck!\n", "short_description": "Sam is a dog in a suit.  Max is his naked rabbity partner.  Together, they\u2019re the Freelance Police.  Jump into the not-quite-right world of Sam & Max via the wonder science of virtual reality, and join the multimedia darlings in their never-ending quest to slap the stupid grin off the face of evil."}]}, "developer_name": "HappyGiant", "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "http
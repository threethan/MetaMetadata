1.oculuscdn.com/v/t64.5771-25/38974469_235918231655618_9200480916509836758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMg2toHNJYcQ7kNvwEJcgvf&_nc_oc=AdnH1y2drxJpgFr1JHgs2B1VZLnXXuSVOfcv1K9Z7Nv_sjYB2KzrEUU5h6qUhdihS3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftoJ3DxVTmbXnkIhTVqWKqiXV_PtV3OiYb6S9l5SYdsVQ&oe=69A05A1C"}, {"file_name": "SMVRFinalQuestScreenshots02.png", "id": "1202634946843386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982715_1202634950176719_6841690957288523386_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhtaYkwJfr8Q7kNvwG0RbLg&_nc_oc=Adk1wDmtEZzwXu_kbIcvXhNXwm3fwBtb0pN9FpI19HfmD6UNCOkDqyxNLce9vXlwE3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNtx2xBKb-Fx9VegKDchxh0jwrx4NUR4lY5cuM6t468Q&oe=69A034A5"}, {"file_name": "SMVRFinalQuestScreenshots13.png", "id": "528250488391317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_528250491724650_1577659830106612444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5gzYg26lRsQ7kNvwEESoMm&_nc_oc=AdkMrKJZ578m-O1T02mbAZZYlM6ab24w_6ugUbekDbmLOg-gZv04QyWzQnlt76H5iKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3in2vTXrZa6FAU_SuvXedHu6nz2WyIapLvBHp5p7NEw&oe=69A028EC"}, {"file_name": "SMVRFinalQuestScreenshots10.png", "id": "326371915829001", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974680_326371919162334_129873048362627550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cHZ9X2bTxUQ7kNvwEmwQ1F&_nc_oc=AdnoL2SBwCHYmH0Nu2Rem__RTSwTjn1viqoKsqkM4N4OXNl5Da1FoAuiOT3cPCZb6oM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuEv3mueB9jKnHsZ9Jem2_d9IDQf7moBtgOTaFPCu_7Fw&oe=69A02EAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusCover2560x1440VIDEOENDSLATEWITHLEGAL.png", "id": "321306219352083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035305_321306222685416_4438699296036008856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U8MEzuZRpwQ7kNvwFna7XV&_nc_oc=AdmyCmluXZv77jYBOpa25lQdJETE2JzJ2x7pn80khAzq-8r34SgIsZH1H_hIWw6M9lM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWqsgbqQp4qYL3_f2Xfa1IU5wX1UOxo55FUWsjqeGX0w&oe=69A04E56"}, "display_name": "Sam and Max: This Time It's Virtual!", "keywords": ["Comedy", "Adventure", "Narrative", "Action", "Arcade"], "long_description": "Sam is a dog with a hat.  Max is a hyperkinetic naked rabbity thing.  Together, they\u2019re the Freelance Police, the intergalactically famous agents of indiscriminately applied justice, now starring in their umpteenth video game, Sam & Max: This Time It\u2019s Virtual!  Even multimedia evil-slappers like Sam & Max could use a hand, and this time they\u2019re using the incomprehensible magic of virtual reality to invite the player into their off-kilter world for a furious day of monster-slaying, obstacle courses, responsibly discharged firearms, and, of course, saving the entire freaking world.\nKey features:\n\u2022Discover the horrible and socially relevant secrets lurking behind, under, and within Cap\u2019n Aquabear\u2019s rotting theme park!\n\u2022Push yourself to be the best of the best of the middling, as a dog and a naked rabbity thing harangue and cajole you through a bewildering assortment of Freelance Police Academy training challenges.\n\u2022Immersion so real you can feel Sam\u2019s breath on your neck!\n", "short_description": "Sam is a dog in a suit.  Max is his naked rabbity partner.  Together, they\u2019re the Freelance Police.  Jump into the not-quite-right world of Sam & Max via the wonder science of virtual reality, and join the multimedia darlings in their never-ending quest to slap the stupid grin off the face of evil."}]}, "developer_name": "HappyGiant", "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "https://happygiant.com/terms-of-service", "publisher_name": "Big Sugar", "support_website_url": "https://happygiant.com/#contact", "website_url": "http://www.happygiant.com/
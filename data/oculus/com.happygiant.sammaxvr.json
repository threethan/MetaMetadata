xqyhn6SmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUkU6-rnUlwcrcgOZCfL7oQOJm2C6o7spR9rpt5dZVFqg&oe=6B0EEDE5"}, {"file_name": "SMVRFinalQuestScreenshots03.png", "id": "3968176583231558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001676_3968176586564891_669903818497939643_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWnonshbtDsQ7kNvwGW1pC1&_nc_oc=AdphglfeC1apBJhVC1h611PLGm6NVcqXFqakN4FCw7UhWAjKsvb52PrB1d5oCKf3p3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXIdljsq3cprFSDwzaEJZHlGKnzpe2vmQVq1eEVxwJYQA&oe=6B0F00A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusCover2560x1440VIDEOENDSLATEWITHLEGAL.png", "id": "321306219352083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_321306222685416_4438699296036008856_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSxYdsg8iw4Q7kNvwEGDgni&_nc_oc=Adp6xHVzRHoyJzJkkDRCNzU0XScfuFkeMy2dr4mN-hMTOF46etPGepBA6zgFGx17WiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXh-S5hDAIRuyz3_dEiNsfyM5SmT3MYbOJPxlca0rxXOg&oe=6B0F0796"}, "display_name": "Sam and Max: This Time It's Virtual!", "keywords": ["Comedy", "Adventure", "Narrative", "Action", "Arcade"], "long_description": "The upcoming VR action-adventure game features the bewilderingly durable comic book duo in either their fourth, seventh, or twentieth video game outing (depending on how you\u2019re counting). After decades of rescuing bigfoots, playing games of high-stakes poker against B-List celebrities, and preserving reality from cosmic nogoodniks, the world-renowned dog and rabbity thing are on a recruitment drive to fatten up the ranks of the Freelance Police\u2026 and they\u2019ve come to you for help! Dive head first into the funky world of virtual reality as Sam & Max push you through their mostly-relevant gauntlet of training courses designed to test your mettle and break your brain\u2026 and watch out for the hidden menace lurking in the training grounds that may spell doom for us all!", "short_description": "Sam is a dog in a suit.  Max is his naked rabbity partner.  Together, they\u2019re the Freelance Police.  Jump into the not-quite-right world of Sam & Max via the wonder science of virtual reality, and join the multimedia darlings in their never-ending quest to slap the stupid grin off the face of evil."}]}, "developer_name": "HappyGiant", "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "https://happygiant.com/terms-of-service", "publisher_name": "Big Sugar", "support_website_url": "https://happygiant.com/#contact", "website_url": "http://www.happygiant.com/samandmax", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272702791555189"}}]}, "scheduled_offers": {"count": 27, "nodes": [{"status": "PUBLISHED", "id": "1935944310355695"}, {"status": "PUBLISHED", "id": "1276501451006356"}, {"status": "PUBLISHED", "id": "1081283307420582"}, {"status": "PUBLISHED", "id": "658228460702395"}, {"status": "PUBLISHED", "id": "8955440764493979"}, {"status": "PUBLISHED", "id": "1029648165233479"}, {"status": "PUBLISHED", "id": "1893724504412018"}, {"status": "PENDING", "id": "311673544519838"}, {"status": "PENDING", "id": "296475866405407"}, {"statu
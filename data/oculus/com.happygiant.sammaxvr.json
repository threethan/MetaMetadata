1.oculuscdn.com/v/t64.5771-25/38974469_235918231655618_9200480916509836758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMg2toHNJYcQ7kNvwGX_gIL&_nc_oc=AdkTde6mrYDfh-KbTV-L2jW_kTF3JuOf_s3aU580WlVuPIkojWQS27Ugeenh72aRKks&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv4GK6ZihHmgDXXW6p1DFhdAThRW93lENnNvbYdMcArOg&oe=69A1AB9C"}, {"file_name": "SMVRFinalQuestScreenshots02.png", "id": "1202634946843386", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982715_1202634950176719_6841690957288523386_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhtaYkwJfr8Q7kNvwEGrpBq&_nc_oc=AdlpPd2gzpf9OnG5MKnSj9RWsq9U75FhuhaZIn6gniadRImPA69xOv2OvAWAmRUT-68&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft6lRzvjQr_Ciq5fJPbyqmUmxsTBi3o0GGuhx_fs02XFQ&oe=69A18625"}, {"file_name": "SMVRFinalQuestScreenshots13.png", "id": "528250488391317", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001721_528250491724650_1577659830106612444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5gzYg26lRsQ7kNvwE7gJq6&_nc_oc=AdnQqtinf_IYCJ5Y0de4FaP-5hGoynbMuDPJD4RdC2am6pVCVawnEiQNuU67IBWr-_w&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afvu9WJ8WhrtiRbBhiOlfBQuRaGNAfAoqGLhPLUPeEp0lw&oe=69A17A6C"}, {"file_name": "SMVRFinalQuestScreenshots10.png", "id": "326371915829001", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974680_326371919162334_129873048362627550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cHZ9X2bTxUQ7kNvwFeA_op&_nc_oc=AdmLtgqn0sMtqNMxcaQR_HDL8ZNtL7UOCSKwQmCj_361sHemTEMS2C5lKjuM9SWIYlw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afscyj4BKsOOJDNYBbIH1B6yY1Y_JyGRwyl5C2C4Qhfd9Q&oe=69A1802F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusCover2560x1440VIDEOENDSLATEWITHLEGAL.png", "id": "321306219352083", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035305_321306222685416_4438699296036008856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U8MEzuZRpwQ7kNvwGawsz9&_nc_oc=AdmWf1y2ln5ivJ9XOrvs-zg4GB0RUJZ_7a1TQ7woyRxWQQmrWWLXBNmzAhwMJuOStow&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftn_NqMmuduZOB9dZ8HsgNgTKvWtR7qKMH2yeBhbKfugw&oe=69A19FD6"}, "display_name": "Sam and Max: This Time It's Virtual!", "keywords": ["Comedy", "Adventure", "Narrative", "Action", "Arcade"], "long_description": "Sam is a dog with a hat.  Max is a hyperkinetic naked rabbity thing.  Together, they\u2019re the Freelance Police, the intergalactically famous agents of indiscriminately applied justice, now starring in their umpteenth video game, Sam & Max: This Time It\u2019s Virtual!  Even multimedia evil-slappers like Sam & Max could use a hand, and this time they\u2019re using the incomprehensible magic of virtual reality to invite the player into their off-kilter world for a furious day of monster-slaying, obstacle courses, responsibly discharged firearms, and, of course, saving the entire freaking world.\nKey features:\n\u2022Discover the horrible and socially relevant secrets lurking behind, under, and within Cap\u2019n Aquabear\u2019s rotting theme park!\n\u2022Push yourself to be the best of the best of the middling, as a dog and a naked rabbity thing harangue and cajole you through a bewildering assortment of Freelance Police Academy training challenges.\n\u2022Immersion so real you can feel Sam\u2019s breath on your neck!\n", "short_description": "Sam is a dog in a suit.  Max is his naked rabbity partner.  Together, they\u2019re the Freelance Police.  Jump into the not-quite-right world of Sam & Max via the wonder science of virtual reality, and join the multimedia darlings in their never-ending quest to slap the stupid grin off the face of evil."}]}, "developer_name": "HappyGiant", "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "https://happygiant.com/terms-of-service", "publisher_name": "Big Sugar", "support_website_url": "https://happygiant.com/#contact", "website_url": "http://www.happygiant.com/
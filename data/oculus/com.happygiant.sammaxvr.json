{"file_name": "SMVRFinalQuestScreenshots01.png", "id": "235918228322285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_235918231655618_9200480916509836758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlhgCYeKGpkQ7kNvwFXD1_W&_nc_oc=AdrQFDCUUjaq8VPdEucRIwBN-C4SLPaWRC456vg5fxy0r8HWQoPzLQfHX0cG4ouub8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afypnso7F911j2ZA1kDgrFEvPbRBn-y15JWm7v318Lj-tg&oe=69CE7E9C"}, {"file_name": "SMVRFinalQuestScreenshots02.png", "id": "1202634946843386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982715_1202634950176719_6841690957288523386_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcON767tFVQQ7kNvwGy_kVS&_nc_oc=AdrTh2uIlS1cpWTNlSdos-C1xXFV4eg_rOOaR8s1VtFwrliAG9iqtbqHfmRq82N3EkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlSz_kScadq6gtDSCNWSYkBfXnNoyaCI6IWaWEr8GITA&oe=69CE5925"}, {"file_name": "SMVRFinalQuestScreenshots13.png", "id": "528250488391317", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001721_528250491724650_1577659830106612444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKaD50m-4vkQ7kNvwHOMHUm&_nc_oc=AdpjyxH-AM3hsDFwROhfg5zMl1D5ybIE0IIXNDT-J__mVzQOmdK8DFtZiCtnsKQlg4I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0UuiAmQLeKDz6T79NGVqR3fjF0Zy5_NTJw3on-sbDxQ&oe=69CE4D6C"}, {"file_name": "SMVRFinalQuestScreenshots10.png", "id": "326371915829001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974680_326371919162334_129873048362627550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3_CPvxqRi4Q7kNvwFE8ELI&_nc_oc=AdopHNXXNvbw-Vq6jqPoL5lmsaXNO4zWl8KFk7spZBLuGjTy0vvyQYnBvJoVxh_TZvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxl_azhxjQKU7EAbAp0KpwQNXXXEl5SgERR6uFVgyqBRw&oe=69CE532F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusCover2560x1440VIDEOENDSLATEWITHLEGAL.png", "id": "321306219352083", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035305_321306222685416_4438699296036008856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smWHkTuFZA8Q7kNvwF_YvYU&_nc_oc=Adq7zUuEYpo_0Nomh2Ivxpp14jlue_9XVKvTNskqp5MqR9m1TlRTiOKVv0U3Ig4CXMM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydUz8eCHVE99zus1ey13sLKLDLu9gqOpzzuqlOH06bkA&oe=69CE72D6"}, "display_name": "Sam and Max: This Time It's Virtual!", "keywords": ["Comedy", "Adventure", "Narrative", "Action", "Arcade"], "long_description": "Sam is a dog with a hat.  Max is a hyperkinetic naked rabbity thing.  Together, they\u2019re the Freelance Police, the intergalactically famous agents of indiscriminately applied justice, now starring in their umpteenth video game, Sam & Max: This Time It\u2019s Virtual!  Even multimedia evil-slappers like Sam & Max could use a hand, and this time they\u2019re using the incomprehensible magic of virtual reality to invite the player into their off-kilter world for a furious day of monster-slaying, obstacle courses, responsibly discharged firearms, and, of course, saving the entire freaking world.\nKey features:\n\u2022Discover the horrible and socially relevant secrets lurking behind, under, and within Cap\u2019n Aquabear\u2019s rotting theme park!\n\u2022Push yourself to be the best of the best of the middling, as a dog and a naked rabbity thing harangue and cajole you through a bewildering assortment of Freelance Police Academy training challenges.\n\u2022Immersion so real you can feel Sam\u2019s breath on your neck!\n", "short_description": "Sam is a dog in a suit.  Max is his naked rabbity partner.  Together, they\u2019re the Freelance Police.  Jump into the not-quite-right world of Sam & Max via the wonder science of virtual reality, and join the multimedia darlings in their never-ending quest to slap the stupid grin off the face of evil."}]}, "developer_name": "HappyGiant", "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "http
1.oculuscdn.com/v/t64.5771-25/38974469_235918231655618_9200480916509836758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBtCV4PibpUQ7kNvwG-Hw0f&_nc_oc=Adk2i6vVgAWFrCEm7Xjwl379YroKXT0OBB2kAFy8FxDYGrRCV2Nop5cm3pWl-TC1qAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvztPRMYYvTZyfKW9iV6HA4e_PntnMyduX9u19SYBNA0g&oe=6999C29C"}, {"file_name": "SMVRFinalQuestScreenshots02.png", "id": "1202634946843386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982715_1202634950176719_6841690957288523386_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_QsKiD4y7cQ7kNvwGEcXfK&_nc_oc=Adkl7WVxW8t_uEo1_Ex7Z2QGYQb0rB0dQ67fMIBMh7YWwl8YaF0rHvz0Oo-433eLAno&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8XQcsmd33pVVMNvyg1jFusDHMi6Oh9gyaQKp920vJbg&oe=69999D25"}, {"file_name": "SMVRFinalQuestScreenshots13.png", "id": "528250488391317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_528250491724650_1577659830106612444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZyrmRzvnUoQ7kNvwGRb1Hb&_nc_oc=AdmdxraG1AxkBBHKZXZ40OhdNLLtT7Hi2KPqQ0msJW_hCFicSN2qqk_sYJnK02yUtvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMLmo2eBPq2clyFUgse6LMZu7y50JE-_Jh3YHcliQ0yQ&oe=6999916C"}, {"file_name": "SMVRFinalQuestScreenshots10.png", "id": "326371915829001", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974680_326371919162334_129873048362627550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH8Kkfcl0xUQ7kNvwEbdme9&_nc_oc=AdkGiTr5CJRyy-o6nSQ8H4ixdYiXfRLfUS_aGAjwb6i73vBY2QO9STiKEOGKztITDzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCBzX9GdRGcfkq-on1zGpM6JOXUn4lhBl_EUYBGIRusg&oe=6999972F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OculusCover2560x1440VIDEOENDSLATEWITHLEGAL.png", "id": "321306219352083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035305_321306222685416_4438699296036008856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glOWRgEpqooQ7kNvwF3wn4a&_nc_oc=Adl0LD70i9zcF4ob5eDy1MwnTKdew27CgJXltiNUX1JI1Rm0Tdvnj4ps_CFlM3WNYN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvIRDF2cFr7Ja6yG8taz4YAfzZwxqpH_vwrVJR_FeAQIg&oe=6999B6D6"}, "display_name": "Sam and Max: This Time It's Virtual!", "keywords": ["Comedy", "Adventure", "Narrative", "Action", "Arcade"], "long_description": "Sam is a dog with a hat.  Max is a hyperkinetic naked rabbity thing.  Together, they\u2019re the Freelance Police, the intergalactically famous agents of indiscriminately applied justice, now starring in their umpteenth video game, Sam & Max: This Time It\u2019s Virtual!  Even multimedia evil-slappers like Sam & Max could use a hand, and this time they\u2019re using the incomprehensible magic of virtual reality to invite the player into their off-kilter world for a furious day of monster-slaying, obstacle courses, responsibly discharged firearms, and, of course, saving the entire freaking world.\nKey features:\n\u2022Discover the horrible and socially relevant secrets lurking behind, under, and within Cap\u2019n Aquabear\u2019s rotting theme park!\n\u2022Push yourself to be the best of the best of the middling, as a dog and a naked rabbity thing harangue and cajole you through a bewildering assortment of Freelance Police Academy training challenges.\n\u2022Immersion so real you can feel Sam\u2019s breath on your neck!\n", "short_description": "Sam is a dog in a suit.  Max is his naked rabbity partner.  Together, they\u2019re the Freelance Police.  Jump into the not-quite-right world of Sam & Max via the wonder science of virtual reality, and join the multimedia darlings in their never-ending quest to slap the stupid grin off the face of evil."}]}, "developer_name": "HappyGiant", "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "https://happygiant.com/terms-of-service", "publisher_name": "Big Sugar", "support_website_url": "https://happygiant.com/#contact", "website_url": "http://www.happygiant.com/
b=1-7&_nc_sid=6e7a0a&_nc_ohc=zS7sU9zrT8cQ7kNvwFjsr-u&_nc_oc=Adr1yHnadu7UbpyJX0Q55UfF3uykgZBDU5QQDbapLLsP99FBWBdN_QR_v4Bsk2jqUVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgOTRU1ycK2lAG5MbHfi29CNkP4khCYTeMu-DR54zoSg&oe=6AFDD1A3"}, {"file_name": "screenshot_5.png", "id": "2114162189495143", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_2114162192828476_30244846929865055_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh2rJi2ddXYQ7kNvwEOGas-&_nc_oc=AdrdzPh9h-dcbr-WMFCjEfIlUWzlayd75OFTTUjNu4QxNw3vyqfv9miBUp8BpzsiWAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg9-rJl_j9b7BKmjUzyVqsPlVce9uCIE2bZ7ZFD7HHkQ&oe=6AFDCDE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "983237368138947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_983237371472280_8029599109397865671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw2oxjjuj1UQ7kNvwE9lEbL&_nc_oc=AdpcJcU9Cq_Lzuyw33EgZm8B9tTTeQ-zp-_MsrU9gobjaWdtCd9BCJ5sALPtndICG3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGkq0j4HD3bg4JEan6mZNx7aD7TqDuStq4MQEP_0A_uA&oe=6AFDD5A1"}, "display_name": "Flight Simulator Toronto", "keywords": ["flight", "simulator", "airplane", "helicopter", "toronto"], "long_description": "Flight Simulator Toronto puts the real Toronto under your wings - rebuilt from satellite imagery, real terrain and open map data.\n\nTHE REAL CITY\nToronto Pearson and Billy Bishop airports, the CN Tower, thousands of downtown buildings, the waterfront, the Toronto Islands and the Lake Ontario shoreline.\n\nDAY, SUNSET AND NIGHT\nAt night the region lights up along its real highways and streets, the runways glow and the CN Tower shines over the lake.\n\nFOUR AIRCRAFT IN YOUR HANGAR\n- A widebody AIRLINER with an Airbus-style flight deck: side-sticks, thrust levers, flaps, gear and five glass displays.\n- The GULFJET1 PRIVATE JET with its yoke and glass panel.\n- The HELI-2 VIP HELICOPTER with a four-display cockpit and a quilted club cabin.\n- A FIGHTER JET with afterburner and a live HUD - paint it and power wash it in the hangar.\n\nREAL CONTROLS\nGrab the side-stick, yoke, cyclic or throttles with your hands, or fly with the thumbsticks. Autopilot, flaps, gear and voice callouts.\n\nMISSIONS AND YOUR LOGBOOK\nLandings, landmark tours and challenges for every aircraft. Your logbook keeps your hours and your softest touchdown.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Voice chat stays off until you turn it on.", "short_description": "Fly the real city of Toronto in VR. A widebody airliner, a private jet, a VIP helicopter and a fighter jet wait in your hangar - take off from Pearson or Billy Bishop and cruise past the CN Tower, the downtown towers and the Lake Ontario shoreline, by day, at sunset or at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatortoronto/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatortoronto/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1348687768324086"}}]}, "scheduled_offers": {"count": 0,
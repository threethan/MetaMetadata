og&oe=6A15A002"}]}, "id": "779478336945112", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "2120155251716444", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572919_2120155255049777_2923981978996103421_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0OtyubdMq4Q7kNvwGTYa9x&_nc_oc=AdplwubqWPXVZwm5fvdC7UroUeGCLLwFY9TKduystkSnd_ojFIVdF-Y_DqZE69PYQhk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af744-FyYoJCjG4MuSyiOCcSJQ9rv9-TmZMFlOS8wBtcEg&oe=6A15968E"}, {"file_name": "6.png", "id": "955598156005214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75326673_955598159338547_3270883690709436555_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0jEfQweur0Q7kNvwGGRURq&_nc_oc=Adrj7w0XMvJ77H0nvnra90FGjSnr0htzMIldHV0llpv3Sj_WDyZ1ynQ7TEtuE4ke_0w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oXlWrmdTis_9tYHU2HEcmfgsGI694-DhI094sVs1vTQ&oe=6A15A1CD"}, {"file_name": "7.png", "id": "927816345325305", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974568_927816348658638_9005004507590425955_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M17SuvCS8ZsQ7kNvwHQ4MhD&_nc_oc=AdpYFAk57WaZdX-RDwIirzPjkvUs0rgrmrZe_ZKXDzyqZPopd69Ugn-krZC6S-p2vMY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nM7gwFCfKKOH_ms2SWGCq3BIHtir_rEtW64zy8DZfsQ&oe=6A15BF51"}, {"file_name": "10.png", "id": "382197344606473", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210399_382197347939806_8211132206860143922_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw-n06RhrW4Q7kNvwGqZMCn&_nc_oc=Adrq2iWWH7V-SiJQGgb8XDwhu2L5GeDuu4NNeTaCYQHNIuOCS22osYTPVxm6p7KDflc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XAE1ko0U2deZNxlgSaWRi3rIidT2rphul5vONHlTv-A&oe=6A15A221"}, {"file_name": "9.png", "id": "1066902321094817", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982448_1066902324428150_227247104404533180_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qDfs40V0HcQ7kNvwHxsueJ&_nc_oc=Adq1saZIKf6_G0TaXDTpajSO1y2Kh1LV1xxPIs5-dE5xTWRDhfObrbtH8sjfKfe-PPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lmQphdFMfcHotPD_Sx2DxnJLbDSl35LSNVHpP7lWR0w&oe=6A15C3D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "870746728135481", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982448_870746731468814_3546417512211831407_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTDCmdJ5JjoQ7kNvwGA5Ds4&_nc_oc=AdoDekPVRvXX43HmnWmdUMR4FVVLY_UoYlO_LYwf_hbHIdsNkjlO304ToyDQWwDmn34&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5611kWaYFSiILHBvbDuye91FbHsSZdbXNrPy2eiNc8Nw&oe=6A15B135"}, "display_name": "ExtractoR beta", "keywords": [], "long_description": "The game consists of number of levels divided into several episodes, set in different environments. New environments are unlocked only after passing the previous ones. To pass a level, the player must collect a certain minimum amount of crystals in that level. The crystals collected during the game are loaded into the ship's hold, which increases its weight and therefore reduces its maneuverability. The crystals are unloaded every time the ship lands on a platform and added to the total number of crystals in that level. After passing a level, the crystals are converted into currency that can be used to upgrade the ship.\n\nEach level begins on one of the platforms. A certain number of platforms are located throughout the map where the player can drop ballast. The platforms are usually located near large crystal resources, allowing the player to return to the same platform multiple times and explore the surrounding area. However, resource-rich areas are often closely guarded by enemy ships.\n\nEmbark on an exciting mission of exploring alien planets and moons, collecting precious resources and fighting enemy forces. Advance your career and build an invincible spacecraft to hover over fascinating alien worlds.\n", "short_description": "The game involves flying a space copter over the surface of planets, moons or asteroids and collecting valuable crystal resources. Enemy ships and other potentially dangerous obstacles hinder our collection efforts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybermagicstudio.com/extractor-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Marek Kierebi\u0144ski", "support_website_url": null, "website_url": "https://cybermagicstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7952455614781979"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1303520751672220"}, {"status": "CANCELLED", "id": "913632254484513"}, {"status": "PUBLISHED", "id": "891966826549964"}, {"status": "PUBLISHED", "id": "1682311912745214"}, {"status": "PUBLISHED", "id": "1224748252843550"}, {"status": "PUBLISHED", "id": "1998225817417042"}, {"status": "CANCELLED", "id": "791359607073922"}, {"status": "PUBLISHED", "id": "747953738298427"}, {"status": "PUBLISHED", "id": "1120520570034242"}, {"status": "PUBLISHED", "id": "1450891686035627"}, {"status": "PUBLISHED", "id": "690323787041840"}, {"status": "PUBLISHED", "id": "1373234827206789"}, {"status": "PUBLISHED", "id": "630723316008777"}, {"status": "PUBLISHED", "id": "1937376980086572"}, {"status": "PUBLISHED", "id": "1
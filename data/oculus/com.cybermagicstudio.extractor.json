A&oe=6A733A82"}]}, "id": "779478336945112", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "2120155251716444", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572919_2120155255049777_2923981978996103421_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=negtMZ3jOfYQ7kNvwHQ2O3r&_nc_oc=AdqJuK33lrJq-QQfrDQkX1bf_ytL34ekp19pY4YwkUyd9jpkWMlPDqjpw0Z2DOYhXZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFar9DYkTeQ9F9zqerjtcsaCPHXA1wpHfykk2ux2Lafw&oe=6A73310E"}, {"file_name": "6.png", "id": "955598156005214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75326673_955598159338547_3270883690709436555_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBt2A9sWrh0Q7kNvwGGcv-W&_nc_oc=Adq9C-DWk0vo-45vRgRbGKxboM9aNTlOU4vtmp5MLTrdSW0LcBmbqw282RdDUAXa574&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBGt3fBVhDDG2jxnC15aZlH42__kfsBO_QgHrd56AM1A&oe=6A733C4D"}, {"file_name": "7.png", "id": "927816345325305", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974568_927816348658638_9005004507590425955_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ASaYfiZUoMQ7kNvwFIcRu0&_nc_oc=AdqTaSwyZY8kjPKguN9yePSPPPO6dnKB3x-UWiioZk64kU4Ml0M86UkvqiJC26sOR_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv5TEMYj9Zf6tW-bY1JtbJwiKMoivmVU9pMKGPmPbakA&oe=6A732191"}, {"file_name": "10.png", "id": "382197344606473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210399_382197347939806_8211132206860143922_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHDEnEy4P-UQ7kNvwH4MVtt&_nc_oc=Adq3aO0JslhF37ZIy2rZAEX7JEPvUUNZjIfK9xL8Cx2GWDnRNuyFMDt7FsatGfRx41w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJcD7WgCVOGegos-ntKLoKV1W4dO1N8vZvKQuzJTr26A&oe=6A733CA1"}, {"file_name": "9.png", "id": "1066902321094817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982448_1066902324428150_227247104404533180_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJgGJ9vMK1UQ7kNvwH8gjHP&_nc_oc=Ado0HwE9qhuoEsa-6N5wjpVLRnScdrQeGPT6CGsinaBFQqKaK-_1Eau68OfCmjgVYgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVUi0WDS2nJAD_6_Ag2LR2zcWno8kJxOCvBleL4466QQ&oe=6A732611"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "870746728135481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982448_870746731468814_3546417512211831407_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-oN9-r_MBgQ7kNvwHtqeEp&_nc_oc=AdpzKz6JCXdSpbpQ9sVBgNp4SqxyxXKlgV7n5Gl6FLuezI2Rzd1jLdqiWEG44oOzZLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTv3DZuvyGH0WMMTdRDpOlT7ttz5-K1Jec9nfpTOEILg&oe=6A734BB5"}, "display_name": "ExtractoR beta", "keywords": [], "long_description": "The game consists of number of levels divided into several episodes, set in different environments. New environments are unlocked only after passing the previous ones. To pass a level, the player must collect a certain minimum amount of crystals in that level. The crystals collected during the game are loaded into the ship's hold, which increases its weight and therefore reduces its maneuverability. The crystals are unloaded every time the ship lands on a platform and added to the total number of crystals in that level. After passing a level, the crystals are converted into currency that can be used to upgrade the ship.\n\nEach level begins on one of the platforms. A certain number of platforms are located throughout the map where the player can drop ballast. The platforms are usually located near large crystal resources, allowing the player to return to the same platform multiple times and explore the surrounding area. However, resource-rich areas are often closely guarded by enemy ships.\n\nEmbark on an exciting mission of exploring alien planets and moons, collecting precious resources and fighting enemy forces. Advance your career and build an invincible spacecraft to hover over fascinating alien worlds.\n", "short_description": "The game involves flying a space copter over the surface of planets, moons or asteroids and collecting valuable crystal resources. Enemy ships and other potentially dangerous obstacles hinder our collection efforts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybermagicstudio.com/extractor-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Marek Kierebi\u0144ski", "support_website_url": null, "website_url": "https://cybermagicstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7952455614781979"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1303520751672220"}, {"status": "CANCELLED", "id": "913632254484513"}, {"status": "PUBLISHED", "id": "891966826549964"}, {"status": "PUBLISHED", "id": "1682311912745214"}, {"status": "PUBLISHED", "id": "1224748252843550"}, {"status": "PUBLISHED", "id": "1998225817417042"}, {"status": "CANCELLED", "id": "791359607073922"}, {"status": "PUBLISHED", "id": "747953738298427"}, {"status": "PUBLISHED", "id": "1120520570034242"}, {"status": "PUBLISHED", "id": "1450891686035627"}, {"status": "PUBLISHED", "id": "690323787041840"}, {"status": "PUBLISHED", "id": "1373234827206789"}, {"status": "PUBLISHED", "id": "630723316008777"}, {"status": "PUBLISHED", "id": "1937376980086572"}, {"status": "PUBLISHED", "id": "14
_9U1AY-UzgQ7kNvwF5b-SN&_nc_oc=Adr9vouX2h4fcQRWm_s5B_0lXEsEmjlyQaAOz30tjEOGHM_1Q7RtCDGXJNb_TJxcQ98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnxKjdfhf8JAx59FvwCLpprLJ6j0SkfxEAxr5T_Lgafw&oe=6A9999D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "870746728135481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982448_870746731468814_3546417512211831407_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJk4wE1OkIUQ7kNvwE_l-N0&_nc_oc=Adp5l-EbXTZ15ISRzbQCfOJ3maOus7_e5x4rkbRrEbpGl5Zu5eqFA6rOjceVCUsMuV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgwsbAD9P-ET-1MO-9DHh2Nvf_b_t6c5lx_lUc852zVg&oe=6A998735"}, "display_name": "ExtractoR beta", "keywords": [], "long_description": "The game consists of number of levels divided into several episodes, set in different environments. New environments are unlocked only after passing the previous ones. To pass a level, the player must collect a certain minimum amount of crystals in that level. The crystals collected during the game are loaded into the ship's hold, which increases its weight and therefore reduces its maneuverability. The crystals are unloaded every time the ship lands on a platform and added to the total number of crystals in that level. After passing a level, the crystals are converted into currency that can be used to upgrade the ship.\n\nEach level begins on one of the platforms. A certain number of platforms are located throughout the map where the player can drop ballast. The platforms are usually located near large crystal resources, allowing the player to return to the same platform multiple times and explore the surrounding area. However, resource-rich areas are often closely guarded by enemy ships.\n\nEmbark on an exciting mission of exploring alien planets and moons, collecting precious resources and fighting enemy forces. Advance your career and build an invincible spacecraft to hover over fascinating alien worlds.\n", "short_description": "The game involves flying a space copter over the surface of planets, moons or asteroids and collecting valuable crystal resources. Enemy ships and other potentially dangerous obstacles hinder our collection efforts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybermagicstudio.com/extractor-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Marek Kierebi\u0144ski", "support_website_url": null, "website_url": "https://cybermagicstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7952455614781979"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1303520751672220"}, {"status": "CANCELLED", "id": "913632254484513"}, {"status": "PUBLISHED", "id": "891966826549964"}, {"status": "PUBLISHED", "id": "1682311912745214"}, {"status": "PUBLISHED", "id": "1224748252843550"}, {"status": "PUBLISHED", "id": "1998225817417042"}, {"status": "CANCELLED", "id": "791359607073922"}, {"status": "PUBLISHED", "id": "747953738298427"}, {"status": "PUBLISHED", "id": "1120520570034242"}, {"status": "PUBLISHED", "id": "1450891686035627"}, {"status": "PUBLISHED", "id": "690323787041840"}, {"status": "PUBLISHED", "id": "1373234827206789"}, {"status": "PUBLISHED", "id": "630723316008777"}, {"status": "PUBLISHED", "id": "1937376980086572"}, {"status": "PUBLISHED", "id": "
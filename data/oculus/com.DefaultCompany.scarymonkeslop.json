eels alive. No sticks, no teleporting \u2014 just pure physical movement and competitive fun.", "short_description": "Dash, climb, and launch yourself through fast\u2011paced tag battles in this VR movement game built for pure chaos and skill. Master your speed, outplay your friends, and become the fastest in the jungle."}]}, "developer_name": "Eddy,TWFZOMBIE&axel", "developer_privacy_policy_url": "https://docs.google.com/document/d/10SKlJzLS62zKer_tvU2TMVJdo-kB4_yp477WRvMvTwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/10SKlJzLS62zKer_tvU2TMVJdo-kB4_yp477WRvMvTwk/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26381365341458539"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26702087112719692", "version": "0.1"}, "id": "1600245994565106", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26381365318125208", "is_concept": false, "latest_released_binary": {"__ty
nds are your power \u2014 push off walls, vault across platforms, and chase down other players in intense, skill\u2011based tag modes. Every match is a test of speed, agility, and creativity.\n\nWhether you\u2019re racing through tight spaces, juking opponents with wild momentum tricks, or escaping by inches, every moment feels alive. No sticks, no teleporting \u2014 just pure physical movement and competitive fun.", "short_description": "Dash, climb, and launch yourself through fast\u2011paced tag battles in this VR movement game built for pure chaos and skill. Master your speed, outplay your friends, and become the fastest in the jungle."}]}, "developer_name": "Eddy", "developer_privacy_policy_url": "https://docs.google.com/document/d/10SKlJzLS62zKer_tvU2TMVJdo-kB4_yp477WRvMvTwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/10SKlJzLS62zKer_tvU2TMVJdo-kB4_yp477WRvMvTwk/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26578384021756669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303672_928848226356168_8441545891953235732_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeeG0n-p2mUQ7kNvwHGXvhn&_nc_oc=AdppYaVWPKrwNVU8o8
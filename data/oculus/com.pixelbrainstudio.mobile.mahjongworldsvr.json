 implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!"}]}, "developer_name": "Pixelbrain Studio", "developer_privacy_policy_url": "http://pixelbrainstudio.com/privacy/oculus/privacy_policy.html", "developer_terms_of_service_url": "http://pixelbrainstudio.com/terms/index.html", "publisher_name": "Pixelbrain Studio", "support_website_url": "http://pixelbrainstudio.com/", "website_url": "http://www.pixelbrainstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "STRATEGY", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "685462445816866"}}]}, "scheduled_offers": {"count": 47, "nodes": [{"status": "PUBLISHED", "id": "604697567139756"}, {"status": "PUBLISHED", "id": "636854883843257"}, {"status": "PUBLISHED", "id": "535501407234024"}, {"status": "PUBLISHED", "id": "789932188510736"}, {"status": "PUBLISHED", "id": "3151585384953940"}, {"status": "PUBLISHED", "id": "814815302389051"}, {"status": "PUBLISHED", "id": "1269134726780783"}, {"status": "PUBLISHED", "id": "729004874350368"}, {"status": "PUBLISHED", "id": "3280780825342118"}, {"status": "PUBLISHED", "id": "197996168235525"}, {"status": "PUBLISHED", "id": "507270676527264"}, {"status": "PUBLISHED", "id": "241816803688613"}, {"status": "PUBLISHED", "id": "186559225752367"}, {"status": "PUBLISHED", "id": "3219413011441704"}, {"status": "PUBLISHED", "id
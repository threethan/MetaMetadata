1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83Lxt0rMlVoQ7kNvwEoxHUf&_nc_oc=AdpQ2xYeHEua4ZPcdZTzZwFQFzcL8AN0AbGk4suk7gQCswlpkAa-M7U-okfb4bztLak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q94osGF7yBpq7QUMupOfopPvh5lqhW4NFVF_ZOEA9WA&oe=69FCAAC7"}, {"file_name": "migrated_image.png", "id": "640604133153352", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982590_1285404841621850_5775893430072770560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yro_TXbTp1IQ7kNvwHpVPlD&_nc_oc=Adqn4ZBW9e7VN4v1TO6Lx1qlYQ6lY9zJbOJxGyhwcwpV8SUYhlD22tuk7GIw7yTBBg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eMTcnBmfD7KEi2Dn-_wmSQR56LChKRCl3z9iFO5tBcA&oe=69FCA2AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/M97De5", "id": "1047299875632410", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982463_1047299878965743_8485412826230292480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxwpsXm7FuAQ7kNvwH5lnlJ&_nc_oc=AdqkBkBlCad1PPlV5z3iN-ryV76bRmquc3p0Bh4pCORcDoeQHcGIML9Bs3AIaWqDT-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jWtUqxwkU0mfPfRjK_SUJSFqHZ-uhlKsF-7IGdu55ww&oe=69FCA18B"}, "display_name": "3D Mahjong worlds", "keywords": ["strategy", "puzzle", "board", "logic", "relax"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings relaxing experience to players in 3D way.\nBe the master and pair all the cubes to eliminate them on over 34 levels!\n\nGame features:\n\n- Classic and 3D style levels.\n- Rotate, move and zoom the board.\n- It\u2019s a simple puzzle game which is suitable for any age groups.\n- Auto hint and shuffle function, in case, if you'd get stuck \ufffd", "short_description": "This is the VR implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!"}]}, "developer_name": "Pixelbrain Studio", "developer_privacy_policy_url": "http://pixelbrainstudio.com/privacy/oculus/privacy_policy.html", "developer_terms_of_service_url": "http://pixelbrainstudio.com/terms/index.html", "publisher_name": "Pixelbrain Studio", "support_website_url": "http://pixelbrainstudio.com/", "website_url": "http://www.pixelbrainstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "STRATEGY", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "685462445816866"}}]}, "scheduled_offers": {"count": 47, "nodes": [{"status": "PUBLISHED", "id": "604697567139756"}, {"status": "PUBLISHED", "id": "636854883843257"}, {"status": "PUBLISHED", "id": "535501407234024"}, {"status": "PUBLISHED", "id": "789932188510736"}, {"status": "PUBLISHED", "id": "3151585384953940"}, {"status": "PUBLISHED", "id": "814815302389051"}, {"status": "PUBLISHED", "id": "1269134726780783"}, {"status": "PUBLISHED", "id": "729004874350368"}, {"status": "PUBLISHED", "id": "3280780825342118"}, {"status": "PUBLISHED", "id": "197996168235525"}, {"status": "PUBLISHED", "id": "507270676527264"}, {"status": "PUBLISHED", "id": "241816803688613"}, {"status": "PUBLISHED", "id": "186559225752367"}, {"status": "PUBLISHED", "id": "3219413011441704"}, {"status": "PUBLISHED", "id
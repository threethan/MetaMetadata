1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qduZXMFHOMAQ7kNvwEvF7jK&_nc_oc=AdoBG4zBRknrkeKv1c-Gmtvj3EfcVtxxfVGkUeqLbN8N-A5gow6nhUwiDbdqsA9XOq4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRt2BPnbDkVYz8E33nAAylVnRUr65K5E-mYZC8_QZj2g&oe=6AC50EC7"}, {"file_name": "migrated_image.png", "id": "640604133153352", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982590_1285404841621850_5775893430072770560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7yGiVLenzgQ7kNvwGazDyK&_nc_oc=Adogty1rzbRktQa7Rupq580e25uft2uzjzEyyb7Y1MC4pVw_IJ9Vg9zQeNVDUy-c53w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRCm7nIeacxaSEBz-kawcAmoLbZQ5DSKcUQRM-cSYl9A&oe=6AC506AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/M97De5", "id": "1047299875632410", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982463_1047299878965743_8485412826230292480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e7m7zrI2H4Q7kNvwGW52fS&_nc_oc=AdqGro-Up_i_Ry1OgDfY4Ban8pp1NZnNsHoUQxZy7MHSR9Y288Tf52ckJRSp0EaLoM8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLT59j5U5lRSXC43stL-TfnP_RX7ktJsaINzZ6oWs2CQ&oe=6AC5058B"}, "display_name": "3D Mahjong worlds", "keywords": ["strategy", "puzzle", "board", "logic", "relax"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings relaxing experience to players in 3D way.\nBe the master and pair all the cubes to eliminate them on over 34 levels!\n\nGame features:\n\n- Classic and 3D style levels.\n- Rotate, move and zoom the board.\n- It\u2019s a simple puzzle game which is suitable for any age groups.\n- Auto hint and shuffle function, in case, if you'd get stuck \ufffd", "short_description": "This is the VR implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!"}]}, "developer_name": "Pixelbrain Studio", "developer_privacy_policy_url": "http://pixelbrainstudio.com/privacy/oculus/privacy_policy.html", "developer_terms_of_service_url": "http://pixelbrainstudio.com/terms/index.html", "publisher_name": "Pixelbrain Studio", "support_website_url": "http://pixelbrainstudio.com/", "website_url": "http://www.pixelbrainstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "STRATEGY", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "685462445816866"}}]}, "scheduled_offers": {"count": 47, "nodes": [{"status": "PUBLISHED", "id": "604697567139756"}, {"status": "PUBLISHED", "id": "636854883843257"}, {"status": "PUBLISHED", "id": "535501407234024"}, {"status": "PUBLISHED", "id": "789932188510736"}, {"status": "PUBLISHED", "id": "3151585384953940"}, {"status": "PUBLISHED", "id": "814815302389051"}, {"status": "PUBLISHED", "id": "1269134726780783"}, {"status": "PUBLISHED", "id": "729004874350368"}, {"status": "PUBLISHED", "id": "3280780825342118"}, {"status": "PUBLISHED", "id": "197996168235525"}, {"status": "PUBLISHED", "id": "507270676527264"}, {"status": "PUBLISHED", "id": "241816803688613"}, {"status": "PUBLISHED", "id": "186559225752367"}, {"status": "PUBLISHED", "id": "3219413011441704"}, {"status": "PUBLISHED", "id
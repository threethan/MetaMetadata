53352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982590_1285404841621850_5775893430072770560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WP-INmZNgSsQ7kNvwGsd_7E&_nc_oc=AdnbpDkJVz4aL0vmxEMgVJRx_GlXV0veBK42DP_v82HhDohqqIa22jvxe8lvUROfm0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsx1X7udgqUX3L_XZj3kyICvc3xQioiUitaRxBKgBWCUQ&oe=699ECFEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/M97De5", "id": "1047299875632410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982463_1047299878965743_8485412826230292480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH40AjHWnhUQ7kNvwGpKoFM&_nc_oc=AdnZlK-3XxI6RG4qvs1e0VGoM897Z7OjVCchdlQoxFPhln10bV49mUWIW6d3GRJokp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft4WTnBduC01-JOKzPCxC_4BoQaw291GbFkusEFKdUv0g&oe=699F070B"}, "display_name": "3D Mahjong worlds", "keywords": ["strategy", "puzzle", "board", "logic", "relax"], "long_description": "This is the VR implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!\nIt\u2019s transformed from the traditional matching game and brings relaxing experience to players in 3D way.\nBe the master and pair all the cubes to eliminate them on over 34 levels!\n\nGame features:\n\n- Classic and 3D style levels.\n- Rotate, move and zoom the board.\n- It\u2019s a simple puzzle game which is suitable for any age groups.\n- Auto hint and shuffle function, in case, if you'd get stuck \ufffd", "short_description": "This is the VR implementation of the classic Mahjong game\n\nNo matter if you are a mahjong master or a beginner, this game will be your best choice!\nCreative design of solid 3D mahjong levels, simple game rules, suitable for everyone!"}]}, "developer_name": "Pixelbrain Studio", "developer_privacy_policy_url": "http://pixelbrainstudio.com/privacy/oculus/privacy_policy.html", "developer_terms_of_service_url": "http://pixelbrainstudio.com/terms/index.html", "publisher_name": "Pixelbrain Studio", "support_website_url": "http://pixelbrainstudio.com/", "website_url": "http://www.pixelbrainstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "STRATEGY", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "685462445816866"}}]}, "scheduled_offers": {"count": 47, "nodes": [{"status": "PUBLISHED", "id": "604697567139756"}, {"status": "PUBLISHED", "id": "636854883843257"}, {"status": "PUBLISHED", "id": "535501407234024"}, {"status": "PUBLISHED", "id": "789932188510736"}, {"status": "PUBLISHED", "id": "3151585384953940"}, {"status": "PUBLISHED", "id": "814815302389051"}, {"status": "PUBLISHED", "id": "1269134726780783"}, {"status": "PUBLISHED", "id": "729004874350368"}, {"status": "PUBLISHED", "id": "3280780825342118"}, {"status": "PUBLISHED", "id": "197996168235525"}, {"status": "PUBLISHED", "id": "507270676527264"}, {"status": "PUBLISHED", "id": "241816803688613"}, {"status": "PUBLISHED", "id": "186559225752367"}, {"status": "PUBLISHED", "id": "3219413011441704"}, {"status": "PUBLISHED", "id": "2265723106837811"}, {"status": "PUBLISHED", "id": "948233255599735"}, {"status": "PUBLISHED", "id": "2579773172312058"}, {"status": "PUBLISHED", "id": "518190682405587"}, {"status": "PUBLISHED", "id": "363613548180265"}, {"status": "PUBLISHED", "id": "588060835088879"}, {"status": "PUBLISHED", "id": "2725510361012751"}, {"status": "
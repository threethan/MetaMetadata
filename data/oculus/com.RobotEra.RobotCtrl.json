t=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv7sJzW1BelSqbv4ibfKj0-ksJ5D8AjRpZ5bmJDNXWA-w&oe=69A44129"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RobotEra Teleoperation", "keywords": [], "long_description": "\u6838\u5fc3\u4eae\u70b9\uff1a\n         \u53cc\u64cd\u4f5c\u6a21\u5f0f\u81ea\u7531\u5207\u6362\uff1a\u652f\u6301\u624b\u67c4\u6309\u952e\u4e0e\u624b\u52bf\u8ffd\u8e2a\u4e24\u79cd\u64cd\u4f5c\u65b9\u5f0f\uff0c\u624b\u67c4\u6a21\u5f0f\u7cbe\u51c6\u54cd\u5e94\u79fb\u52a8\u3001\u6293\u53d6\u7b49\u52a8\u4f5c\uff0c\u624b\u52bf\u6a21\u5f0f\u901a\u8fc7\u81ea\u7136\u59ff\u6001\u63a7\u5236\uff0c\u6ee1\u8db3\u4e0d\u540c\u64cd\u4f5c\u4e60\u60ef\u4e0e\u573a\u666f\u9700\u6c42\u3002\n         \u591a\u89c6\u89d2\u6c89\u6d78\u5f0f\u89c6\u89c9\uff1a\u63d0\u4f9b\u4e3b\u89c6\u89d2\u3001\u4e3b\u89c6\u89d2 + \u53cc\u81c2\u89c6\u89d2\u53cc\u6a21\u5f0f\uff0c\u652f\u6301 2D/3D \u753b\u9762\u5207\u6362\uff08\u9700\u673a\u5668\u4eba\u6444\u50cf\u5934\u652f\u6301\uff09\uff0c\u5b9e\u65f6\u540c\u6b65\u673a\u5668\u4eba\u6444\u50cf\u5934\u753b\u9762\uff0c\u8f85\u52a9\u7cbe\u51c6\u5b8c\u6210\u6293\u53d6\u3001\u64cd\u4f5c\u7b49\u52a8\u4f5c\u3002\n\n\u7075\u6d3b\u7a33\u5b9a\u8fde\u63a5\uff1a\u652f\u6301\u6709\u7ebf\u6570\u636e\u7ebf\u76f4\u8fde\u4e0e WiFi \u65e0\u7ebf\u8fde\u63a5\u4e24\u79cd\u65b9\u5f0f\uff0c\u9002\u914d\u5185\u7f51 / \u8fdc\u7a0b\u8fde\u63a5\u5207\u6362\uff0c\u6ee1\u8db3\u4e0d\u540c\u73af\u5883\u4e0b\u7684\u7a33\u5b9a\u63a5\u5165\u9700\u6c42\u3002\n\n\u5168\u6d41\u7a0b\u529f\u80fd\u8986\u76d6\uff1a\u96c6\u6210\u9065\u64cd\u4f5c\u542f\u505c\u3001\u8bed\u97f3\u901a\u8bdd\u3001\u6570\u636e\u91c7\u96c6\u3001\u8bbe\u5907\u7ba1\u7406\u7b49\u529f\u80fd\uff0c\u652f\u6301\u81ea\u5b9a\u4e49\u673a\u5668\u4eba\u540d\u79f0\uff0c\u591a\u8bbe\u5907\u7ba1\u7406\u66f4\u4fbf\u6377\u3002\n\n\u9002\u914d\u8981\u6c42\uff1a\n\u8bbe\u5907\uff1aMeta Quest 3\u7cfb\u5217 VR \u5934\u663e\n\u7cfb\u7edf\uff1a\u517c\u5bb9 Meta Quest 3\u5b98\u65b9\u6700\u65b0\u7cfb\u7edf\u7248\u672c\n\u673a\u5668\u4eba\uff1a\u652f\u6301\u661f\u52a8\u7eaa\u5143\u642d\u8f7d XOS \u64cd\u4f5c\u7cfb\u7edf\u7684\u4eba\u5f62\u673a\u5668\u4eba\n\n\u4f7f\u7528\u6307\u5f15\uff1a\n\u673a\u5668\u4eba\u7aef\u642d\u8f7d XOS \u7cfb\u7edf\u5e76\u6fc0\u6d3b\u9065\u64cd\u4f5c App\uff08\u9700\u4e0a\u4f20\u6388\u6743\u6587\u4ef6\uff09\uff1b\nMeta Quest \u8bbe\u5907\u901a\u8fc7\u6709\u7ebf\u6216 WiFi \u8fde\u63a5\u673a\u5668\u4eba\u7f51\u7edc\uff1b\n\u542f\u52a8 App\uff0c\u9009\u62e9\u76ee\u6807\u673a\u5668\u4eba\u5b8c\u6210\u914d\u5bf9\uff0c\u914d\u7f6e\u89c6\u9891\u6e05\u6670\u5ea6\u4e0e\u64cd\u4f5c\u6a21\u5f0f\u5373\u53ef\u5f00\u59cb\u64cd\u63a7\u3002\n\n\u5b89\u5168\u63d0\u793a\uff1a\n\u64cd\u4f5c\u524d\u8bf7\u719f\u6089\u6025\u505c\u529f\u80fd\u4e0e\u64cd\u4f5c\u89c4\u8303\uff0c\u4fdd\u6301\u52a8\u4f5c\u59ff\u6001\u4e0e\u673a\u5668\u4eba\u4e00\u81f4\uff0c\u907f\u514d\u8bef\u64cd\u4f5c\u3002\u5e94\u7528\u5df2\u901a\u8fc7\u5b89\u5168\u6821\u9a8c\uff0c\u6838\u5fc3\u529f\u80fd\u9700\u914d\u5408\u6388\u6743\u673a\u5668\u4eba\u4f7f\u7528\u3002", "short_description": "         \u8fd9\u662f\u4e00\u6b3e\u4eba\u5f62\u673a\u5668\u4eba\u9065\u64cd\u4f5c\u5e94\u7528\uff0c\u901a\u8fc7\u9ad8\u7cbe\u5ea6\u52a8\u4f5c\u6620\u5c04\u4e0eVR \u6c89\u6d78\u5f0f\u4ea4\u4e92\u80fd\u529b\uff0c\u7cbe\u51c6\u5339\u914d\u4eba\u5f62\u673a\u5668\u4eba\u591a\u5173\u8282\u534f\u540c\u63a7\u5236\uff0c\u4e3a\u4eba\u5f62\u673a\u5668\u4eba\u63d0\u4f9b \u201c\u6240\u89c1\u5373\u6240\u63a7\u201d \u7684\u64cd\u63a7\u4f53\u9a8c\uff0c\u964d\u4f4e\u4eba\u5f62\u673a\u5668\u4eba\u9065\u64cd\u4f5c\u4f7f\u7528\u95e8\u69db\uff0c\u63d0\u5347\u52a8\u4f5c\u63a7\u5236\u7cbe\u5ea6\u4e0e\u573a\u666f\u9002\u5e94\u6027\u3002\n\t  \u5e94\u7528\u652f\u6301\u901a\u8fc7 Meta Quest \u8bbe\u5907\u5b9e\u73b0\u5bf9\u673a\u5668\u4eba\u7684\u63a7\u5236\uff0c\u7528\u6237\u53ef\u901a\u8fc7\u624b\u67c4\u6309\u952e\u6216\u624b\u52bf\u64cd\u4f5c\uff0c\u5b8c\u6210\u673a\u5668\u4eba\u79fb\u52a8\u3001\u80a2\u4f53\u63a7\u5236\u3001\u901a\
/499311545_1364949061402195_1936069826654313589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycTbf6PXSt8Q7kNvwEi-XDF&_nc_oc=AdpURzVaJ0MwQiymKexpvswOyRBHJ-dx2rGco9-iAVp8mjT4ghPGveWrpq-ZyOtZF6I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFOG2tYJEYh0vlRU3r87oxwMVAls2S06C5ibQiwyvX-A&oe=6AEC8352"}, {"file_name": "3.png", "id": "661431556891391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499335570_661431560224724_8326600212694513629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsp9Gv4Eo00Q7kNvwGFWxgc&_nc_oc=AdpXJdd4twi58jWQSp2Qu_pQfokQnz8V03nLyqrBUuh4tMjtISukyfz_recWGB46c6w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr1hYJF4pLc34DdJPFPXwOnxZ3RjFY6iKIYTz5zfBRZQ&oe=6AECA45E"}, {"file_name": "1.png", "id": "1860792161352673", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499330337_1860792164686006_5244861811352948675_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtzvkNdDE-AQ7kNvwHydZ7R&_nc_oc=AdrgnKp_lzSijLpT8-6qBckhfni0o-vy56xyVKpNCvb78JyDI8uUiWGib--QgUbLYXs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQCgDblgnnoRs9PrsoLqC83WhMgGr1mwhLVKHDWZnXqw&oe=6AECB21F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-monster-truck_v2.png", "id": "1224975089256948", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819302_1224975092590281_6048742591319348013_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qckvBTX3-pYQ7kNvwENsNnf&_nc_oc=AdqTJjraoU3mFR31r8dRxk6U3hn7C8g2aikq4KplMWyQhIK_Q1q2x2vNQdUpJ35a1i8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBTGeMWpqioGKVGV8KiVPcoNM97Z0MRfNqzTIWQI99FQ&oe=6AEC9E6E"}, "display_name": "RC Monster Truck VR - Simulator Game", "keywords": ["Car", "Racing", "Monster", "Truck", "Simulator"], "long_description": "# Get ready to unleash the unstoppable power of your Monster Truck!\n\n**Play your RC Monster Truck**\n\nExperience explosive VR monster truck action! Smash, crash, and dominate in a full-throttle 360\u00b0 showdown.\n\n{1095619955754038}\n\n**Dominate with Power**\n\nStep into the virtual battleground where your monster truck faces unstoppable chaos. Crush rivals, smash obstacles, and dominate the battle in fully immersive action!\n{996565998912231}\n\n**Demolish your Enimes**\n\nFeel the thrill of every crash and smash in fully immersive VR monster truck battles. Experience raw power, epic stunts, and nonstop destruction!\n\n\n{1185868916355563}", "short_description": "Brace yourself to crush, clash, and dominate in the ultimate VR Monster Truck arena! Step into a fully immersive 360\u00b0 world where your monster truck goes head-to-head in fierce, metal-crunching battles. Feel the thunder of the engine, smash through opponents, and perform wild stunts in destructible environments - just pure, adrenaline-pumping action brought to life in virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kidloland.com/vr-privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Kidloland", "support_website_url": null, "website_url": "https://kidloland.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38786807007630313"}, "review_messages": []}]}, "cover_square_
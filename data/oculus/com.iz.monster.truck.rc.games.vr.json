/499311545_1364949061402195_1936069826654313589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nr0vMZMI8xkQ7kNvwG5vmSh&_nc_oc=Adqz6nnVTGBdVGFCbAW9d-RlSpUIN-Pir05VGQMa6Qb3yktH5BCwnSrhSIjBRJm88nI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3zVTXFTSbEizIlH9WjfrkbOZu_RLWh72C9xpdqUmD1A&oe=6AE73D52"}, {"file_name": "3.png", "id": "661431556891391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499335570_661431560224724_8326600212694513629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHWHbKQL-tQQ7kNvwGy37H_&_nc_oc=AdramY4dnsYrDPiqwph-iuZTIXeThOitNg9OkXVR9hDBXQTgS_jdE2mHyxsydr5rYbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnGDBqDqBTwhQJw4uJ6gaK_CBDThvJ3SPChXZqKYbsyQ&oe=6AE75E5E"}, {"file_name": "1.png", "id": "1860792161352673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499330337_1860792164686006_5244861811352948675_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e--kI2NP_lwQ7kNvwEUFt0x&_nc_oc=Adqzr09XsvlslTL-KVIvADqVMLHWFBJqa6yjG0y3d_VUWckGQRR2DFPNi2UWK5RpVus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMGxOFgVLkonQ8aBwGqfZh3EnUmUAdHmLx0VXzAdwfEQ&oe=6AE76C1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-monster-truck_v2.png", "id": "1224975089256948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819302_1224975092590281_6048742591319348013_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyVVeDoVx1sQ7kNvwGj1-hh&_nc_oc=AdrUgxjeB_7zZNvecX3ASLSoW0IzdpMZZpUqK-ut8OxERYo8TQvd_pNY7eQP_G4G6Zc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUdbUWKk1mlMCbQT_IYuCv8JPd40XX42yy1UyI43k8Zg&oe=6AE7586E"}, "display_name": "RC Monster Truck VR - Simulator Game", "keywords": ["Car", "Racing", "Monster", "Truck", "Simulator"], "long_description": "# Get ready to unleash the unstoppable power of your Monster Truck!\n\n**Play your RC Monster Truck**\n\nExperience explosive VR monster truck action! Smash, crash, and dominate in a full-throttle 360\u00b0 showdown.\n\n{1095619955754038}\n\n**Dominate with Power**\n\nStep into the virtual battleground where your monster truck faces unstoppable chaos. Crush rivals, smash obstacles, and dominate the battle in fully immersive action!\n{996565998912231}\n\n**Demolish your Enimes**\n\nFeel the thrill of every crash and smash in fully immersive VR monster truck battles. Experience raw power, epic stunts, and nonstop destruction!\n\n\n{1185868916355563}", "short_description": "Brace yourself to crush, clash, and dominate in the ultimate VR Monster Truck arena! Step into a fully immersive 360\u00b0 world where your monster truck goes head-to-head in fierce, metal-crunching battles. Feel the thunder of the engine, smash through opponents, and perform wild stunts in destructible environments - just pure, adrenaline-pumping action brought to life in virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kidloland.com/vr-privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Kidloland", "support_website_url": null, "website_url": "https://kidloland.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38786807007630313"}, "review_messages": []}]}, "cover_square_
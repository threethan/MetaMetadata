_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afG-wNGlD6kQ7kNvwFPV4p8&_nc_oc=AdoVrhgTfyH4EPaFoQT5OugmrsbA9gKpeUqmvYQVktThOabp13q5ZJybG-gz6ncIaBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vN6hmNWfbCmxfvLnJmMMF-cUaGmqFw_CojHQ7dZt7lQ&oe=69DA341E"}, {"file_name": "1.png", "id": "1860792161352673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499330337_1860792164686006_5244861811352948675_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZu2VgyXrggQ7kNvwFrQ5XF&_nc_oc=AdoJf7zX60JAw478cKUSE5J168MbQj9MrWsvnBQst54a4d8upJacjy67XEbfJMrCiPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f9F_xcqlDWCFzptp9ppMUtLK3vC0b7WTWuypSIWsIcA&oe=69DA41DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-monster-truck_v2.png", "id": "1224975089256948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819302_1224975092590281_6048742591319348013_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWn2WawrB08Q7kNvwHuxFc3&_nc_oc=AdoN_GvR7G1sAAWTeifnh7kjYuXjtMley3XNreoHuu9bWfUStOLG6zaPXadRW_QGnfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PO9n5e47Cm7WDZ40iirX8D8L3NQI4GxShUEzO7kDBxg&oe=69DA2E2E"}, "display_name": "RC Monster Truck VR - Simulator Game", "keywords": ["Car", "VSpeedway", "MotoX", "kart", "Racing"], "long_description": "# Get ready to unleash the unstoppable power of your Monster Truck!\n\n**Play your RC Monster Truck**\n\nExperience explosive VR monster truck action! Smash, crash, and dominate in a full-throttle 360\u00b0 showdown.\n\n{1095619955754038}\n\n**Dominate with Power**\n\nStep into the virtual battleground where your monster truck faces unstoppable chaos. Crush rivals, smash obstacles, and dominate the battle in fully immersive action!\n{996565998912231}\n\n**Demolish your Enimes**\n\nFeel the thrill of every crash and smash in fully immersive VR monster truck battles. Experience raw power, epic stunts, and nonstop destruction!\n\n\n{1185868916355563}", "short_description": "Brace yourself to crush, clash, and dominate in the ultimate VR Monster Truck arena! Step into a fully immersive 360\u00b0 world where your monster truck goes head-to-head in fierce, metal-crunching battles. Feel the thunder of the engine, smash through opponents, and perform wild stunts in destructible environments - just pure, adrenaline-pumping action brought to life in virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idzdigital.com/privacypolicy-vr.php", "developer_terms_of_service_url": null, "publisher_name": " IDZ Digital Private Limited", "support_website_url": null, "website_url": "https://idzdigital.com/vr-games.php", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29192487080395735"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1883087802257895"}, {"status": "PUBLISHED", "id": "1566197554741697"}, {"status": "PUBLISHED", "id": "951765133558249"}]}, "baseline_offer": {"id": "1566197554741697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755194400, "status": "PUBLISHED", "id": "1883087802257895"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32817761327868274", "version": "0.1
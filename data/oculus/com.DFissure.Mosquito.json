25/75451783_3380792928878499_406692301983354181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3-gD8ppXUsQ7kNvwHrQwPp&_nc_oc=AdnUXrxvILMBuwTwnT6_WMBwbhG6PPsYoFUdXtrjKwvN5KBel3UNOpZI57fOeqiIkUM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzw7rVGBO7h1wmuw7frJkXudLsc0c2hSr5Ga1iTIhEb0Q&oe=69BD3558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "a.png", "id": "953919766203912", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982628_953919769537245_6158809935601676350_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP-PeirjDEMQ7kNvwE0OjC-&_nc_oc=AdlllOkd1iYCLSurI_xyXPhGysIJv7Kb6sN77TTybVV4k314rIJxYCn4E5enAEfzQQ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqLgmGAVbNUUzfDdoFwJ44ZN32pSPABuCKuuDY0c0vGw&oe=69BD5AB1"}, "display_name": "Hey Mosquito!", "keywords": [], "long_description": "Welcome to the ultimate mosquito-swatting extravaganza! \nIn \u2018Hey Mosquito!\u2019 you'll find yourself in any environment you choose, with the real world as your backdrop. Mosquitoes will come at you from all angles, and it's up to you to defend yourself using your trusty swatter controlled by your VR hand controller. It's time to unleash your fury on those pesky bugs and rack up those high scores!", "short_description": "Fight! Battle! Sway your hands and kill those annoying mosquitos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yx10wesce3.feishu.cn/docx/UnCldzzQ4oFwu9xNh8kcxksmnpg?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "Meta Quest Developer Hub", "support_website_url": null, "website_url": "https://d-fissure.com/heymosquito/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MO
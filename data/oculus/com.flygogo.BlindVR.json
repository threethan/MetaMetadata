&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBUIwAfEAyIQ7kNvwE_mlYn&_nc_oc=AdoILgdDF8XPrCg2FXLecS4wnjMwr9IoESBSYxiy5GAJ_65Z7SVhk_3WS4euh1fA6RY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE1rXGFKxmLTKv1eDodTy5CuHoJsqS002-jSAr0mCbvA&oe=6B09BFB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1407129197124163", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_1407129200457496_5802683941144216445_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYlKGyPrRSsQ7kNvwHr43fL&_nc_oc=AdoGG8HWKRcS8nPuBKOMadiqsEAnQYORgGrgHnnkabthzPx85wF8r6f7-ibLgcxLEks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi6r-NwT261tc096ktGhCV9N-Cp7Ii2UjhnN8lAfrGEA&oe=6B099FD7"}, "display_name": "Blind Touch VR", "keywords": ["blind", "simulation", "visual", "touch", "simulator"], "long_description": "## You Can't See!\n\nStep into the world of a blind traveler, where every tap of your guide cane reveals the unseen. You navigate environments that are familiar or distant\u2014home, subway, a bustling street\u2014illuminating objects through touch and memory.\n\n- ### **Control Your Cane:**\n  With each touch, your cane brings the world to life. Uncover objects that hold meaning, from a humming boombox to the scent of a flowering plant.{620702970999839}\n\n- ### **Collect Memory:**\n  Collect significant objects, solve tactile-based navigation puzzles, and immerse yourself in an experience designed to replicate the challenge and beauty of moving through the world without sight.  \n{1032079755529904}\n\n- ### **Explore and Discover:**\n  This is a game about exploration, adaptation, and finding warmth in the everyday. Through careful design, a rich soundscape, and intuitive mechanics, **Blind Touch** offers a unique perspective on discovery and perception.  \n{648874157907594}", "short_description": "Immersive \"Blind Simulation\" that offers a new perspective and sensory experience. Step into a world of darkness using your guide cane."}]}, "developer_name": null, "developer_privacy_policy_url": "https://flygogo.itch.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Flygogo games", "support_website_url": null, "website_url": "https://impress.games/press-kit/flygogo/blind-touch", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9239284512866824"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1462087132516454"}, {"status": "PUBLISHED", "id": "1120433163792502"}, {"status": "PUBLISHED", "id": "2130996791119389"}]}, "baseline_offer": {"id": "2130996791119389"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1462087132516454"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27746941725007822", "version": "1.0"}, "id": "2905223426319086", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9197272227068053", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27746941725007822"}, "release_status": "RELEASED"}, "bina
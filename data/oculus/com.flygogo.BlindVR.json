&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIYplCKWEVUQ7kNvwG_NC2c&_nc_oc=Adr_Zb_XTQER7mTKiE5_gUCCb0HV8sXJqVhSNQ-raoQA-yTIkCkKWokWe5Y4p9fUhqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvtwncoh0PRHDkdR-Cy1_iPbA1JGuAQrIDGZr3r-MYMQ&oe=6B05CB35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1407129197124163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_1407129200457496_5802683941144216445_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRAudLPu7WYQ7kNvwG9X0GO&_nc_oc=Adq3NuOiegQlb9WLPMTexkIVd2tquFPckCNq7THIxJIbl77t2TVUPm83QDcEotbeLOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN21rCPtAsJRk3lwwTGmSW5QNDyASbGeuDf89D3HuQNw&oe=6B05AB57"}, "display_name": "Blind Touch VR", "keywords": ["blind", "simulation", "visual", "touch", "simulator"], "long_description": "## You Can't See!\n\nStep into the world of a blind traveler, where every tap of your guide cane reveals the unseen. You navigate environments that are familiar or distant\u2014home, subway, a bustling street\u2014illuminating objects through touch and memory.\n\n- ### **Control Your Cane:**\n  With each touch, your cane brings the world to life. Uncover objects that hold meaning, from a humming boombox to the scent of a flowering plant.{620702970999839}\n\n- ### **Collect Memory:**\n  Collect significant objects, solve tactile-based navigation puzzles, and immerse yourself in an experience designed to replicate the challenge and beauty of moving through the world without sight.  \n{1032079755529904}\n\n- ### **Explore and Discover:**\n  This is a game about exploration, adaptation, and finding warmth in the everyday. Through careful design, a rich soundscape, and intuitive mechanics, **Blind Touch** offers a unique perspective on discovery and perception.  \n{648874157907594}", "short_description": "Immersive \"Blind Simulation\" that offers a new perspective and sensory experience. Step into a world of darkness using your guide cane."}]}, "developer_name": null, "developer_privacy_policy_url": "https://flygogo.itch.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Flygogo games", "support_website_url": null, "website_url": "https://impress.games/press-kit/flygogo/blind-touch", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9239284512866824"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1462087132516454"}, {"status": "PUBLISHED", "id": "1120433163792502"}, {"status": "PUBLISHED", "id": "2130996791119389"}]}, "baseline_offer": {"id": "2130996791119389"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1462087132516454"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27746941725007822", "version": "1.0"}, "id": "2905223426319086", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9197272227068053", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27746941725007822"}, "release_status": "RELEASED"}, "bina
ri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1YV3sDUArAQ7kNvwHAR5bA&_nc_oc=Adp6TYH1wUHXzmUV-h7QaqigEJI6OWyuggRG1STavLLXm44Y3h_-drvFN9VggBUM_zA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMD9Hut5jdN2wdo2hNYylKeuUFnTE6OQBX-u1-ze3BEA&oe=6B0C7D11"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcaNtaPTv6kQ7kNvwH8tPob&_nc_oc=AdqMl42szNuYz3T77OFBMuq2tfdsifd6ByhVZMldX-JtfGtaC8HGeEAof8-HhUJgM7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDhS03T5-tnMX2buelcgmkdpY8QVN2pMEdVk2hgdv3WA&oe=6B0C7CA4"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkbjnJatVJkQ7kNvwEoyTJu&_nc_oc=AdofvG_9bwuZ3ETKmxoZgREGDr4JCOzHocl6WOEEqgVhig-pIFs6AApMDhnci394bXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjN2R2kHXcZne5heIvQZl6qCP4Z_fkRmKGs9fJ6da84w&oe=6B0C64DD"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVwyJRIi4yIQ7kNvwHDdi4k&_nc_oc=Adr6Q1kaDWwgIlgYS9kpg4cwM2BPNhqa9lmuJIF8R15P3esHL1ZKRoyNGrMZeWTX99c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQux0KeS_QDyjp1m-vmPDrOZa14iZNLZyNjGbIN9HDziw&oe=6B0C5381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEkprqtk3igQ7kNvwELkwWS&_nc_oc=AdoeCkXPYip5QZyJcFpkGKZI0uwjmqH8DmGSLRdUivqyFnp8IOo3Sp68q7_koMStkM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgCHzJ4yNW78s5Sde9xKN8YHNaRlyUvMm5JCfsmV_bAw&oe=6B0C7681"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
ri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P65-r4x6MIEQ7kNvwHdTaK8&_nc_oc=AdolQxXz2H_W-q_MxI9VCM1WqzOOgeiChgCDH7Tw2F0Lc7zci1LeE8vNfDhCN5uhC78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxSH2LJai-oJ3gt2fMpPAiLRmUa_4E42AFfcDsCawiaA&oe=6B01B8D1"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CjlR_Ktqn4Q7kNvwEz8Z1X&_nc_oc=AdpvuFLlZyPpnb6prfXmTAF1o4JoLfO3XlNVmxbJiDUc-cIbGTn33IPMmFjLvGVdB9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThYcsAT-omss6IWkF6eRdw5I_9u_hcjbjsvBpn51-XeA&oe=6B01B864"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wfikbOK810Q7kNvwFfDcEd&_nc_oc=AdrBC7j4TsmWRCZrj3vmggPVqryeW1ZnjAVsMoC0J5-GYUMaYHg0pqcsCiUnisbqj0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSggshl_93YNA_dc6pa3k4u8LPel4A2n2CyKSAma3YEpA&oe=6B01D8DD"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CwFeZOCD_gQ7kNvwHQNMWR&_nc_oc=AdqvcjwnV9yieXJ_y-1_85SKSflJac9NrMNbE0BXK0zJgqx_Ydwr7cwDhnsggy6A4aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwsMZCfLo8MOC98ngdBJQYnkyN2TE4G-7CNYzKGVc3oA&oe=6B01C781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GVZk-AtEGQQ7kNvwH0hPU1&_nc_oc=Ado069R_A7SlJlrC4F6a53gCNcI0abe45CfOxbKfASKx_8-QbWJSX8-fmWZNaPjpdmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLW5M9kqzsk0CKZsgPFSEckuZitRnHpJ04ItPNFNJwBQ&oe=6B01EA81"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
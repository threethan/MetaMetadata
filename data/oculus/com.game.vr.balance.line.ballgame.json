ri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umdZHHK1dbUQ7kNvwG1105Z&_nc_oc=AdqJVzDuUcQY2_Z2EMh-IrC1gooUm9v_oxEk_vuERI0E64Sk1BnnOCrSV7tU_P11JWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIyCwvX8JbtbSQWYjngSa0R6JxZlKPHpSgZ04GkRvNMA&oe=6B103951"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4N5qALjw9UQ7kNvwFTE8m9&_nc_oc=Adpibt6XJkrkQbHmVpOPVPsmS9hcRFyAbKDhev2fRWTuPUScclzbpTBphEKSVq9HIPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCdY6P63plYy2jlT66Cf17gcFDg8TvPGjIyiShInmtug&oe=6B1038E4"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkbjnJatVJkQ7kNvwFmtKaQ&_nc_oc=Adpxjd1EFp72LHLUxcCIKERTZsguVEtmIkdC0prIY48g3gbY1w9vLftRu6M-hXgyjXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUD4CP4QNQ1eMX4LU6cvtlueomnES-A0V51s1XNTCTTvw&oe=6B10595D"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PkZtrls3v8Q7kNvwGrj41r&_nc_oc=AdqeA2iffdPl0ZINt4Umv3hgG9pi_oskiAFBg4mQVSkMbOF0RHiTkQvFvD-H7xnshCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWkjojZGA4teaaR-CLn9nhu8ItKlguKLckRgehB8Ym3JQ&oe=6B104801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRvLAHTHvbYQ7kNvwFw74XS&_nc_oc=Adq4DJbsjTR58L9NJrZpXlFk0uoVZwX926Pw07hX-dDf7MEqLHgPFW1EqRFyswjEaKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXrYYzMsbSH-d4FvOPPTNUYoEAUWw83j5NAFd9vhNhlpg&oe=6B106B01"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
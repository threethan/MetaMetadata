ri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m3xghXGHiMQ7kNvwHYomFq&_nc_oc=AdrQmn7ookRpuPjDKSjuQKnfHAsMHkhP-OpZZi4BC8O93db3-OuDwBhLvZw1JYQomDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhWq-dO9C58ErHMHmE3iAInq3JGpbgUByTyn-Fvn2JpQ&oe=6AFDC451"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Xp33KopsycQ7kNvwER6BVU&_nc_oc=Adp_gm9IRWi4IEz3Oqv8Wa3MhXe2WaU9WyZOx1rDeZW8upoZp9tIakh_JEFG4pcSUi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoEapl7ZqhlVYrKVSapq31mvIx5AUw5-BmvNx1OPxDmg&oe=6AFDC3E4"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXLGVZU5JjYQ7kNvwHwLRD1&_nc_oc=Adq_AWx04vRn1hkB7RQPiNu0YtFL5bvfL_Wk1xQ9rMAMZ7QaMC_dIj7D-BUvmOqIWlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4XAAzQodRsPREBA3piz_w8cp9yMk6E1Zaf-KHdLnVGA&oe=6AFDE45D"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAiK0D1Cdh8Q7kNvwG161pS&_nc_oc=AdrMOtmS1fk147gd6lMCbugT5ucczFkyFYp2BLHwuyAWxo8W_QI0c7Y3cSaIwnNYAfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-YWspwuv-PMp2tVeO0aWWi3V8_OQIfWWO-lyh0bZcRg&oe=6AFDD301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5M3K4YfzTcQ7kNvwF5uJkd&_nc_oc=AdqMaLiRvoFT0It-q0CI_weJ-4yse22iCWkdbOUHID7rvZo7JVg268YzK2zwzfznFMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT85-zz-F8gtq50P5JvbxDcf_h5aBeaJTB1sB7zxxqXQ&oe=6AFDBDC1"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
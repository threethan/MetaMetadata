ri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PlPTpx3R6AQ7kNvwFlJu1X&_nc_oc=Adr1DQrrfyDsapQPTAmOjEx8Wco9pk5go1Glh8EZ3jegT33eCkJuKPA8Bh0O2JLsdeA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRffFhyaTTFfq7p4vv51VNy2g8bxO-1Vbycrhu3Z5dn2A&oe=6B05AD51"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdUuHkH4JigQ7kNvwED3oA-&_nc_oc=Adrsj6hQhVwcGAT7Bw2oV8lYmp_32G3PZHQJ4xcMDQPn450U5wvwJqFBxiRSYIBmj-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7RPiFAuPeLy6fJRXjIZGqY2nzbpYT26Ea8fOerADY3Q&oe=6B05ACE4"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyXwtDMY9LgQ7kNvwG5aFf0&_nc_oc=AdqaXFpJmOlFACl7kcUCrIH1aayaHeiO9Khce2LbyoesxsGisgqRkQAY99_iSm9HJoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmBcQVtnSgDRNUB7pKx12_uhA1gx1FfFtSZfc-Wq4rnw&oe=6B05CD5D"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mj2vG5PVg8wQ7kNvwGJg9UA&_nc_oc=Adr8YFSZwcf3nmYG2dk-zmv5Igm5utzenmqba6JNJVJE-Ncux49OnKyAUmrkT1MR1C4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg1a1HWYNkF3sMMXecaYMBJIy3611BuK8a9FgXzmLUAA&oe=6B05BC01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBahw4PXYCEQ7kNvwGl-5aQ&_nc_oc=AdpxAJBYnZki8_UVUfuyAvYxSINvAHvJfiNFxtgOlH_OCPh0W-qUi7NR__ybZareAgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS29EynZfFrAGzHv0XVIWYuLAhQ9LZx8ZOmLR2oxAEvWw&oe=6B05A6C1"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
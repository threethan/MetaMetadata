ri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P65-r4x6MIEQ7kNvwEhWBLs&_nc_oc=AdqhZDB1SyKfyz1r_cQDNuxwhDbh5tbpf8Q3FqXEfjh7WBbL90QEXw84hB9y-5S7h00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEKc4hiXzwGeGwmUHCwu_KDhyL3mLY5WWarn-9dQJj1Q&oe=6B030A51"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CjlR_Ktqn4Q7kNvwG57q3I&_nc_oc=AdrCcqjDNJnqu61S9g1mOL-MqGJOOLRL-JYJIYnYyRzwZ-ZZSpQrwgBNcNTbvRO3iXk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWX82_4ydokZvE4AlU18inHNAKvwkQjxQMVyiJ5j3lww&oe=6B0309E4"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wfikbOK810Q7kNvwFHGph4&_nc_oc=Adriea21iwea-TWF4IBj0tRLcSuXp6AQLx0Y1ry_CpKKF7OdetNyxyMBf3jo8NFPhLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgNURNVNSGvqRvdzPU9ZidYorwr9RY7EDS8OSEjTJuKA&oe=6B032A5D"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mj2vG5PVg8wQ7kNvwGKHiUx&_nc_oc=Adr-xJUvFUkw9rJmdi66UEa3CPbOL6c5nKrDt0hq2aFGhwjRlKZjYI57JdmVjK2Z0tc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrNg1Aev5JHWR4evGCqGCGksCBTeqmjdNW0dawqmZxJA&oe=6B031901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GVZk-AtEGQQ7kNvwHDPrTK&_nc_oc=AdpqkvWVH1OHSiZuoXjBwla-sSgrurhiCvq_1XaVieOBDSrgmfNDqAgRiZfgwOliE8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7YKfHekql8DyNb9fSVq2ojdJbU1hnjdotp8kw8xgZdw&oe=6B0303C1"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
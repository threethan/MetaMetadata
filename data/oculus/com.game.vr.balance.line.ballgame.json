ri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGB4WGNE4ZoQ7kNvwF6YM9H&_nc_oc=AdoLcTiN7iBf9pXfekvLzrQH-OGnJiw1xVKCwFFvBRb122LXKwkD6hk9WWvPwm7a_VY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmzPBHsl3Fp-A26YSAXzRhkjODPJPx4dh7zIZ5aafF1Q&oe=6AFB2151"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbfspfjtCtkQ7kNvwGU32Lw&_nc_oc=AdooaB851Yr8N-yAY5NHkdjyrfxFnvZ7oAu8WNxHlqd2uc4rIXezrOmPleFjaalYcf0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcqQNakN3QMQumtd0MvYwBrblZj7xvYhhrr1mmZEYLog&oe=6AFB20E4"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB9irZNimUsQ7kNvwEoKeUG&_nc_oc=AdoHk2AMTyF8tVzRfJ75BuPDeM_-vgh3oe_4dtXRBc-tT8ZHqxXiz4TftopnoDAqCnM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzbc_DCqejgLo-cKYdOYLrHokg_lR7FJ82NIwunC7J7w&oe=6AFB415D"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAiK0D1Cdh8Q7kNvwHP_qTT&_nc_oc=AdpW6r5aIuOlrX5Y7jC7V4Ec_22lpKXiRbcq-limtnXWyr-Ivw58dV6_MseRTRgNBnE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY-M4TAPDpVE3rSCKFrlBc-UqvBadoNpR9rHiAUrtFdw&oe=6AFB3001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9VPaDtRUwUQ7kNvwFK1gYa&_nc_oc=AdpCydkYut-GfSfa6pJHSpjWjI58qCxbM2Ki8HS3IcSyq6lCZk-JBaHty7IisexLI5c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvHfWIwvBQo9jNzbDs6fH2ezq_OOXxB-pE_fflKET5TA&oe=6AFB1AC1"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
ri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYzB5KvoFgMQ7kNvwEbjyUG&_nc_oc=AdrBixQQh6A3ukZ90d8_bwky04pPUBYZOLK-kk3NKtAEUNz-8gKC9PDcDC51SX0m4Vg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbeRlq9INbWLF1ejrI4tlMDe6VH6KbDMzjLGeo0S-n3w&oe=6B0B2B91"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcaNtaPTv6kQ7kNvwFUHGES&_nc_oc=AdobOhx0Th-QPcdqzWM6pOWsZS76gzAswBWXmyKpT0wizKRLTB3Q7MoEbpmiWztZon0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3n7Ggex5KdJZp4UU-cx2wg8g5WeY_DFGilV6_3a_pWg&oe=6B0B2B24"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grWhKMsSCsgQ7kNvwFiE_B5&_nc_oc=Adq10JRlGkhEb11y3ieO3gOyV8oOFzMIPM_UddBHXdUG0xFDiPOXUI_y9lRtTnu3dAw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTh8mMvDKQIkO4GOW8Vr23oAnN5v3Osj0KZAXDrVjF37g&oe=6B0B135D"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVwyJRIi4yIQ7kNvwGZPR0o&_nc_oc=AdovJmgkkzYz4gVTTmekxSTLhki7P6POxVCUy6qm9YiU_kEQt4mLP8Z10mLg6Fg57L0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9l-KPbXGLeaBAdYuFedyveqDi09ciGd0YBd47uSJG1A&oe=6B0B3A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEkprqtk3igQ7kNvwEuGVoY&_nc_oc=Adrq5urHHikoV727H7Smq9Vx6ELWVrv50ERvT8o1P7TOtbmt3L-kGpycrGRIM7wJCs0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTurwYDT8xhXuPIFL2LRl-BIZUIxeS30XiWk4Nhcw1UbA&oe=6B0B2501"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
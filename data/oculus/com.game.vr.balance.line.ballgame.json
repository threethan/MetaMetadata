ri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031338_8197176496982955_6972570383412535632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PlPTpx3R6AQ7kNvwEUBI1c&_nc_oc=AdrsZ0h_9Un0MiztAuCxG_iYAb80zjhhcZTrOOTxePo8NkaHsEVth9eNy7kKQ4NMJPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_BGmmsqG45V3pkxYbGox8AeLDYR9pdWBZWFdRwOxavw&oe=6B06FED1"}, {"file_name": "ss2.png", "id": "308572305582542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_308572308915875_2005886578111677469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdUuHkH4JigQ7kNvwFNuYu6&_nc_oc=AdpEzcvPMdKChuVPy1Q-xwx2TXUfvTkIBmTM3chJmoOlyq_BdlJDY-DtJLbHXzaCMxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAdSzFwQUGIcSrcKM0KHhQDA1PfyjpNiTVMn2nceol9g&oe=6B06FE64"}, {"file_name": "ss3.png", "id": "8349992958346809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_8349992961680142_7841921146541035662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyXwtDMY9LgQ7kNvwEUtH3C&_nc_oc=AdrTf-jp-PDY4AbdhgVg0t6Hq4d2Flz83Gcv12PpqROX2p3z-JtW5rj5lkg-RX-ALmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs9E_fglHdTmgzAzwqtpsEpC6lQriIDO4w_LMlxCpAuA&oe=6B071EDD"}, {"file_name": "ss4.png", "id": "857847426401057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570306_857847429734390_7910133873931103160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7C9e2TGdNcQ7kNvwFQNYZ5&_nc_oc=Adq0p94crotpDoUO1fZ4t1YqBwXkzzxL2OY8DcQ-R_51DiAgE3cO56z7X8ja06bL00M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSejykCn1bkgryVXDgYY0VxHPUj8JSsA_pPPUFDLD7-Fw&oe=6B070D81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "984446136745874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_984446140079207_434318002355948122_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBahw4PXYCEQ7kNvwHO5XdX&_nc_oc=AdqZJ-kMgvOEHJs3ppyytk2i5bf5yZUO0DRtW0UgY7bPM8Csw_YGJXzfH28ml3hElnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2_rxCEKpjTdr9ydXQ5uYtUP1m1iP1nesioxBgH6nE_w&oe=6B06F841"}, "display_name": "Ball Lines", "keywords": [], "long_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Introduction\nWelcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/balllines/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sgaw4t23 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/balllines", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "159219297431
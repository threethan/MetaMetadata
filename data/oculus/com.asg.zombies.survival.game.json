e7a0a&_nc_ohc=7gdIb7BpLucQ7kNvwGXYJ8_&_nc_oc=AdrvX5NHNlLrYnDB1Z1fdnRSK9dhBBZP6tC0PkPUlShsCNPfGEvkqNrb9KzY97CCTyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmv-IhgGfxVvBf9ZV5WTPX56Cc16AKzZNsDt70ru0qog&oe=6AA6AD89"}, {"file_name": "3.png", "id": "1531368665068624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303377_1531368668401957_7383040900466390957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmKTnzPoOlUQ7kNvwHW7Aq8&_nc_oc=AdoRtbDBiyHEaI7Eumik8-jOD6VLa9N7qfPVE5DfjlT8z5ZDlis9znI3aapZa-OtSv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs_3IO3dWJhh21pQRMwhF_B6snDVONimJqDJu2jYPJrw&oe=6AA69AA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bg_2.png", "id": "1029912936266820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_1029912939600153_2367676973372681729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fet_P-HF7VwQ7kNvwET9nZK&_nc_oc=AdpDsc9BmMdzf0VQmugASFUmcE96Gx-7oHJLHr1mPDyKRsGUdaHh8RjzQjandwgmcC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1985pBguK-pwOZkHUzz2f8XxjhkGAxLdsDsql2D-t_g&oe=6AA6C516"}, "display_name": "Zombie Survival Arena VR", "keywords": ["ZombieSurvivalArenaVR", "ZombieVRSurvival", "UndeadArenaVR", "VRZombieShooter", "ApocalypseSurvivalVR"], "long_description": "Enter the world of Zombie Survival Arena VR, the ultimate VR Zombie Shooter and action-packed Zombie Survival Game filled with nonstop horror, intense combat, and terrifying undead enemies. Fight endless waves of monsters in this immersive Zombie Shooting VR Game designed for fans of survival, action, and FPS gameplay.\n\nExperience realistic combat in a dark post-apocalyptic world where dangerous creatures attack from every direction. Use powerful guns, shotguns, sniper rifles, machine guns, and explosive weapons to survive the deadly Zombie Apocalypse VR battlefield.\n\nThis thrilling Zombie Arena Shooter combines immersive VR gameplay, realistic shooting mechanics, and heart-pounding survival action. Battle terrifying undead creatures, mutant monsters, infected zombies, and boss enemies in intense arena fights.\n\nBecome the ultimate VR Zombie Hunter in this exciting Zombie FPS Game and test your survival skills against endless enemy waves. Explore abandoned locations, dark survival arenas, ruined cities, and horror environments filled with danger and chaos.\n\nFans of Offline Zombie Games, VR Survival Games, Zombie Combat Games, and Undead Shooting Games will love the realistic action, immersive gameplay, and smooth controls. Fight to stay alive in this extreme Zombie War VR experience and protect humanity from destruction.\n\nFeatures:\nIntense VR zombie shooting gameplay\nEndless zombie survival mode\nRealistic FPS combat mechanics\n\nGet ready to shoot, survive, and destroy!\n", "short_description": "Zombie Survival Arena VR is an intense VR zombie shooting game where you fight endless waves of undead monsters, survive deadly arenas, use powerful weapons, and become the ultimate zombie hunter in a terrifying apocalypse world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/artsidegames/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Side Games", "support_website_url": null, "website_url": "https://sites.google.com/view/artsidegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "use
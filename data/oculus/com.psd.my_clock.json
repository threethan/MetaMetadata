457669344", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499292779_1018507461002677_6708870588212795546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVljweJ8fTIQ7kNvwFjc6Co&_nc_oc=AdqkFc_3eTKP72UhNkB8cu6gy-Vlgg4S0w2UuKu7jCv1LwAXs0VoWbBlC3C2m7U48UQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDu3qb5d3PeTHLbrvzQID4knpXjOyMXM8aTFgbe2KWCw&oe=6A88332E"}]}, "id": "2211281389428707", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "2260372721272066", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499302344_2260372724605399_1638692777574984514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvGK0RvejmAQ7kNvwF5FD_l&_nc_oc=AdpVhau1ItFh5w5hXITxMCHdSi9WsZsI051DVEx1H9oraJNzIb0V1G5e7m3Q8sWSD90&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRVrhpS8ng2zJvDIKniuCQWEQEB-UfiZpyAGa53VGmhA&oe=6A8827DD"}, {"file_name": "2.png", "id": "1311351264409357", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298248_1311351271076023_1462195197401332501_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8Wb-8xVJmYQ7kNvwGCuU9V&_nc_oc=Adoi7g88PTvOzm8eJVDNhxP19ebN8nnpjs0vlGcUL7ao7tSOSrTp9H_eslQKvYu8JKE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUS6cXHJWj58AFX_zn5jKLrcU5WtYtJRFZMeDcJzQB8w&oe=6A882A9E"}, {"file_name": "3.png", "id": "1057010760024574", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499313063_1057010763357907_3241894581459644960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0hfNZSjIWoQ7kNvwE11VsF&_nc_oc=Adrj5SOb2uQgKtIDBONWxNGrPtcQokKfQEXHbXzHeJFQKf09qLiZG4tF6GDEyHRLJI4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2QERva9o-CekeMH0H4hXS-48JbZJlqHhey4As9GqALQ&oe=6A885276"}, {"file_name": "4.png", "id": "1587135319715475", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312257_1587135323048808_6778664510046305289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N9RwRX6tfkQ7kNvwHQfXzJ&_nc_oc=AdoSRbcPKPbXS2qfPNA_iZcDDSJkC-gByhP-gF7wRf0U6YoRHd0ZxOocxyCQ1XrZJcA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8VpoYPITmWVTu-nVoGPgn9-2ckaw1S9eB7X58CA4R1g&oe=6A884E2D"}, {"file_name": "5.png", "id": "1730200161623270", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499308184_1730200164956603_9141385422071314581_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VfrEMAnNagQ7kNvwElNpvx&_nc_oc=AdqFaQqHzliCHPwCE2bW3oxkXDk-FSKL6WhxoLadoHsW6Yp2h5si77esZWx_z7UK8mM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE73cszwzpsrxxSxm0P5b6R_SH6vknOEUx1sW7pTudo6Q&oe=6A884AB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Clock", "keywords": ["clock", "time"], "long_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference.\n\nMy Clock is a desktop clock that runs as a non-immersive 2D panel integrated into the viewer's operating system. It offers two display modes: a digital clock with clear, large numbers, and a classic analog clock with hour, minute, and second hands that rotate on precise pivots. In both cases, the time is displayed in 12- or 24-hour format, adjustable according to the user's preference. The interface is kept up-to-date in real time through an internal timer that sends signals to the visual components, ensuring a smooth and consistent experience.\n\nIt is designed as a lightweight and minimalist tool, focused on visual utility rather than complex functions: its sole purpose is to offer a reliable and elegant clock that is always in view.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}, {"images": {"nodes": []}, "id": "1044758891269744", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mi reloj", "keywords": ["reloj", "tiempo"], "long_description": "My Clock es un reloj de escritorio que se ejecuta como un panel 2D no inmersivo integrado en el sistema operativo del visor. Ofrece dos modos de visualizaci\u00f3n: un reloj digital con n\u00fameros claros y de gran tama\u00f1o, y un reloj anal\u00f3gico cl\u00e1sico con agujas de horas, minutos y segundos que giran sobre pivotes precisos. En ambos casos, la hora se muestra en formato de 12 o 24 horas, ajustable seg\u00fan la preferencia del usuario. La interfaz se mantiene actualizada en tiempo real a trav\u00e9s de un temporizador interno que emite se\u00f1ales a los componentes visuales, garantizando una experiencia fluida y constante.\n\nEst\u00e1 dise\u00f1ada como una herramienta ligera y minimalista, centrada en la utilidad visual m\u00e1s que en funciones complejas: su \u00fanica finalidad es ofrecer un reloj confiable y elegante siempre a la vista.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Y3Pz50hge2tuYsymG-QZDMDJ152JQCAE7Q-l1lyIcuk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-clock-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
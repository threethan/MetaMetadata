s_pxYDe5c-6T9pfdJe_HA74w&oe=6ABA6B76"}, {"file_name": "4.png", "id": "1587135319715475", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312257_1587135323048808_6778664510046305289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_IwyG3_mzUQ7kNvwG5mJi7&_nc_oc=AdqPhnHYf9aeVPVnh6_3CkG4dfVRJyAu3IlR42iy4ykJQb0Zb_ZEoiOVq31_-z7aVqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8RPeMSC3W12I-v6rcGQel4rjU9eJUB3aL88ZT3MFGtg&oe=6ABA672D"}, {"file_name": "5.png", "id": "1730200161623270", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308184_1730200164956603_9141385422071314581_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46rMmhPRvXAQ7kNvwFP0zg1&_nc_oc=AdqKbQnGCZVVPVodKK7bKxjDaC6u3EZ8v3RaHQZHCUs6MktKg-HgaMXeza_BPTbNcJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-0KomAQp4EWZU-SKEPU1NsQtyeTP-O_nogPjQj9tYJw&oe=6ABA63B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Clock", "keywords": ["clock", "time"], "long_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference.\n\nMy Clock is a desktop clock that runs as a non-immersive 2D panel integrated into the viewer's operating system. It offers two display modes: a digital clock with clear, large numbers, and a classic analog clock with hour, minute, and second hands that rotate on precise pivots. In both cases, the time is displayed in 12- or 24-hour format, adjustable according to the user's preference. The interface is kept up-to-date in real time through an internal timer that sends signals to the visual components, ensuring a smooth and consistent experience.\n\nIt is designed as a lightweight and minimalist tool, focused on visual utility rather than complex functions: its sole purpose is to offer a reliable and elegant clock that is always in view.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}, {"images": {"nodes": []}, "id": "1044758891269744", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mi reloj", "keywords": ["reloj", "tiempo"], "long_description": "My Clock es un reloj de escritorio que se ejecuta como un panel 2D no inmersivo integrado en el sistema operativo del visor. Ofrece dos modos de visualizaci\u00f3n: un reloj digital con n\u00fameros claros y de gran tama\u00f1o, y un reloj anal\u00f3gico cl\u00e1sico con agujas de horas, minutos y segundos que giran sobre pivotes precisos. En ambos casos, la hora se muestra en formato de 12 o 24 horas, ajustable seg\u00fan la preferencia del usuario. La interfaz se mantiene actualizada en tiempo real a trav\u00e9s de un temporizador interno que emite se\u00f1ales a los componentes visuales, garantizando una experiencia fluida y constante.\n\nEst\u00e1 dise\u00f1ada como una herramienta ligera y minimalista, centrada en la utilidad visual m\u00e1s que en funciones complejas: su \u00fanica finalidad es ofrecer un reloj confiable y elegante siempre a la vista.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Y3Pz50hge2tuYsymG-QZDMDJ152JQCAE7Q-l1lyIcuk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-clock-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscr
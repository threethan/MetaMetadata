71-25/596168449_1586869222344067_7300555388965847955_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVqxOffHKsgQ7kNvwFfpvZV&_nc_oc=Ado4GluOPp-zOwCSt_1yM7ff9Db29ePHjNwOa176lKFX36QEuux3LoN2bgwWevcCZSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaRpUsHz2qyKewJf-eU56iE6F4nxqvxQ7EiubN0Rbc1Q&oe=6AC25E8F"}, {"file_name": "2.png", "id": "2611174466018499", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673645340_2611174469351832_5225801164518684143_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40jB2ZUTtckQ7kNvwFUXT5n&_nc_oc=Adrk3qIKbJOAx5j1NMAR30VU77PRyQxuNPHEaMAe6HGuuH2DPeKTpQAKR8gsA7d2U4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9Uqghttl6Uu14NgqhCzhW19WV0mlYnqWErKH7H4kPxg&oe=6AC26875"}, {"file_name": "3.png", "id": "1502533785032758", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1502533788366091_5495941055073199737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAqHjsCy0ykQ7kNvwEIIfGw&_nc_oc=AdqI4r6LWi8GILeHYXIGImvIphsU8I1SeC8Y_3V6jSyl7K0KOQPCj7ZL0zelP6pEA3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ5sjjxg_aGKOzSyuMLniIXLcKArT-WJHKvZ2IytDbsA&oe=6AC25293"}, {"file_name": "4.png", "id": "2170891943638248", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604347072_2170891946971581_2700134946028691023_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvfJWnGKyzoQ7kNvwGEEu2r&_nc_oc=Adov4e24A6pJSulJ3d_idzvSfu1o_Jde-w_l7SA3s5p0CAaP5E-mRfT6keTmBQq8lLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnB9Jllggceg69v7SfzLEki4uGEsstEy3opq20JEkjDA&oe=6AC26A9F"}, {"file_name": "5.png", "id": "1094300889908465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1094300893241798_7861064782206142286_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrS90lDKPm8Q7kNvwGeNAgZ&_nc_oc=AdqmYykWCVJ2VTyfNQDg9Ei6mirdDvtHuv_Qg2iROLpECrnQYnRHJh2HiUuTPZH-gCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2U0tyFJsuL_zMhW-v_CaSUyMvgAyygKoyq4hpH6Ukpw&oe=6AC271C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Clock", "keywords": ["clock", "time", "alarm"], "long_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference.\n\nThe clock includes an alarm function with notifications; you may need to try a few times before the Meta Quest prompts you to grant permission for alarm notifications. If you see the countdown timer, the feature is active.\n\nMy Clock is a desktop clock that runs as a non-immersive 2D panel integrated into the viewer's operating system. It offers two display modes: a digital clock with clear, large numbers, and a classic analog clock with hour, minute, and second hands that rotate on precise pivots. In both cases, the time is displayed in 12- or 24-hour format, adjustable according to the user's preference. The interface is kept up-to-date in real time through an internal timer that sends signals to the visual components, ensuring a smooth and consistent experience.\n\nIt is designed as a lightweight and minimalist tool, focused on visual utility rather than complex functions: its sole purpose is to offer a reliable and elegant clock that is always in view.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Y3Pz50hge2tuYsymG-QZDMDJ152JQCAE7Q-l1lyIcuk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-clock-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
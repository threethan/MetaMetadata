"id": "10073643982755670"}]}, "id": "1238382111075462"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24083912814538284"}]}, "id": "731754646171476"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24540846135518115"}]}, "id": "1855915175250396"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9962065617241968"}]}, "id": "558665297318241"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8999389220161426"}]}, "id": "1641296933185549"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9423531394404503"}]}, "id": "1734203960780789"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1344818478703351", "release_date": 1786475040, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1438318639353334"}, "id": "1019940970843556"}]}}, "binary": null, "live_binary": null, "created_date": 1790648685, "id": "1438353412683190", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1438353916016473"}, "release_status": "RELEASED", "id": "1344818478703351"}, "id": "1438353916016473", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1344818478703351", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "825187107253835"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2595780197511170", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mi reloj", "keywords": ["reloj", "tiempo", "alarma"], "long_description": "My Clock es un reloj de escritorio que se ejecuta como un panel 2D no inmersivo integrado en el sistema operativo del visor. Ofrece dos modos de visualizaci\u00f3n: un reloj digital con n\u00fameros claros y de gran tama\u00f1o, y un reloj anal\u00f3gico cl\u00e1sico con agujas de horas, minutos y segundos que giran sobre pivotes precisos. En ambos casos, la hora se muestra en formato de 12 o 24 horas, ajustable seg\u00fan la preferencia del usuario. La interfaz se mantiene actualizada en tiempo real a trav\u00e9s de un temporizador interno que emite se\u00f1ales a los componentes visuales, garantizando una experiencia fluida y constante.\n\nEl reloj tiene la funcion de alarma con una notificasion, tiene que intentarlo varias veces para que la meta quest te pida darle permiso para la notificacion de de la alarma, si ve la cuenta regresiba es porque ya esta funcionando.\n\nEst\u00e1 dise\u00f1ada como una herramienta ligera y minimalista, centrada en la utilidad visual m\u00e1s que en funciones complejas: su \u00fanica finalidad es ofrecer un reloj confiable y elegante siempre a la vista.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}, {"images": {"nodes": [{"file_name": "hero cover.png", "id": "3072368442969611", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299922_3072368446302944_5804488434351180032_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGDNC04d_a8Q7kNvwEYeO41&_nc_oc=Ado2wIOaoiH5puLLKRPC62HlXQQntJzNnNdKAKlJD-Ya2vCEO-FxZ8JOeF9xHXznA74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS8o0OFnoyi3GuFOIfxcd2BWyWsti_1Kh7nmUZHd521g&oe=6AC263E2"}, {"file_name": "square.png", "id": "2839263079741383", "image_type":
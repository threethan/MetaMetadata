457669344", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499292779_1018507461002677_6708870588212795546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbGH3j1xmi4Q7kNvwG6iPjm&_nc_oc=Adruqm8qmFYTsJ6x5QZbRZLUYDYkB9Hc5WEFEMzQXo4wxW4ACOUQGljC0_G2r6PMGo4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjeI_IhvEYIjqo1iTD12sb9uXwZi-l2CV_Qw5gAmZS4A&oe=6A8AD62E"}]}, "id": "2211281389428707", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "2260372721272066", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302344_2260372724605399_1638692777574984514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDdeMhpO2-AQ7kNvwF3fPH6&_nc_oc=AdouS6be8Z9P0eRKSpUyNqOrenwJZ3RKim9tfvhZBWJXzyMtPmMFM6SUar7tD2rk0tQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELbTBrwW-rmepQZIuymSUddVS0p7sw1HVUWioa_CellA&oe=6A8ACADD"}, {"file_name": "2.png", "id": "1311351264409357", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499298248_1311351271076023_1462195197401332501_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwyuca9s6mcQ7kNvwGk0Gr4&_nc_oc=AdqXAJO64PO_rLdP-LMMbH9PaTot8jB4bESXbNG7fssZ-9bZ9oe5D7CsFCzBR_rXlfE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8O-h8XGMwHADng1IuKPkLnVdBt7xsnl8ZNhSKsz0LQA&oe=6A8ACD9E"}, {"file_name": "3.png", "id": "1057010760024574", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499313063_1057010763357907_3241894581459644960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VppHZuLQNcQ7kNvwFzs12E&_nc_oc=Adqt_UfqO1Ux-u__Jy8iGPWqRsy8PtXReR4xg_dQ0UBkbBIi-ihKCQKiKaoCOCwb4CA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEifD7-e5N8DTZMBdq0gVY8p5ALhBgqh_S_yfLeY9207Q&oe=6A8AF576"}, {"file_name": "4.png", "id": "1587135319715475", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312257_1587135323048808_6778664510046305289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N9RwRX6tfkQ7kNvwGCxiHY&_nc_oc=Adpa561PZOpZkXvAg1-84Y_oVcZf0OvnRW2COqmn-10n1YzYzY5eeL4B_G0m7wyyui4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJEZEyaMHC0HRyBfPcZIHnGP1ayFiW1IzC_Wbm_PImGA&oe=6A8AF12D"}, {"file_name": "5.png", "id": "1730200161623270", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308184_1730200164956603_9141385422071314581_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfG0kC1h3YEQ7kNvwFfSFIH&_nc_oc=AdoAZr36BiOa88VGnLAhmTM61v7vm8FiciZiKfevhb_sMBQJWPgX4O5UC6JKYdAG0CA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBDiIjdGDbEJg7Wql8lpFmYx3OjYLTrhtOZKRrEvmrAQ&oe=6A8AEDB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Clock", "keywords": ["clock", "time"], "long_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference.\n\nMy Clock is a desktop clock that runs as a non-immersive 2D panel integrated into the viewer's operating system. It offers two display modes: a digital clock with clear, large numbers, and a classic analog clock with hour, minute, and second hands that rotate on precise pivots. In both cases, the time is displayed in 12- or 24-hour format, adjustable according to the user's preference. The interface is kept up-to-date in real time through an internal timer that sends signals to the visual components, ensuring a smooth and consistent experience.\n\nIt is designed as a lightweight and minimalist tool, focused on visual utility rather than complex functions: its sole purpose is to offer a reliable and elegant clock that is always in view.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}, {"images": {"nodes": []}, "id": "1044758891269744", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mi reloj", "keywords": ["reloj", "tiempo"], "long_description": "My Clock es un reloj de escritorio que se ejecuta como un panel 2D no inmersivo integrado en el sistema operativo del visor. Ofrece dos modos de visualizaci\u00f3n: un reloj digital con n\u00fameros claros y de gran tama\u00f1o, y un reloj anal\u00f3gico cl\u00e1sico con agujas de horas, minutos y segundos que giran sobre pivotes precisos. En ambos casos, la hora se muestra en formato de 12 o 24 horas, ajustable seg\u00fan la preferencia del usuario. La interfaz se mantiene actualizada en tiempo real a trav\u00e9s de un temporizador interno que emite se\u00f1ales a los componentes visuales, garantizando una experiencia fluida y constante.\n\nEst\u00e1 dise\u00f1ada como una herramienta ligera y minimalista, centrada en la utilidad visual m\u00e1s que en funciones complejas: su \u00fanica finalidad es ofrecer un reloj confiable y elegante siempre a la vista.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Y3Pz50hge2tuYsymG-QZDMDJ152JQCAE7Q-l1lyIcuk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-clock-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
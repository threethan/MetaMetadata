t=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHkgG4-9kT0Q7kNvwFgHTyh&_nc_oc=AdoXuWVj73T7gDxIW02IWXUXaPYt7ujeWi7VH8QH6EQt4RtQ2TqaeuDvv1R2ohKRJs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQun_zgI_reaudFD17QPQn00j_LjaDcaPOUShwGhYx5w&oe=6AB3CC36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Clock", "keywords": ["clock", "time"], "long_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference.\n\nMy Clock is a desktop clock that runs as a non-immersive 2D panel integrated into the viewer's operating system. It offers two display modes: a digital clock with clear, large numbers, and a classic analog clock with hour, minute, and second hands that rotate on precise pivots. In both cases, the time is displayed in 12- or 24-hour format, adjustable according to the user's preference. The interface is kept up-to-date in real time through an internal timer that sends signals to the visual components, ensuring a smooth and consistent experience.\n\nIt is designed as a lightweight and minimalist tool, focused on visual utility rather than complex functions: its sole purpose is to offer a reliable and elegant clock that is always in view.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}, {"images": {"nodes": []}, "id": "1044758891269744", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mi reloj", "keywords": ["reloj", "tiempo"], "long_description": "My Clock es un reloj de escritorio que se ejecuta como un panel 2D no inmersivo integrado en el sistema operativo del visor. Ofrece dos modos de visualizaci\u00f3n: un reloj digital con n\u00fameros claros y de gran tama\u00f1o, y un reloj anal\u00f3gico cl\u00e1sico con agujas de horas, minutos y segundos que giran sobre pivotes precisos. En ambos casos, la hora se muestra en formato de 12 o 24 horas, ajustable seg\u00fan la preferencia del usuario. La interfaz se mantiene actualizada en tiempo real a trav\u00e9s de un temporizador interno que emite se\u00f1ales a los componentes visuales, garantizando una experiencia fluida y constante.\n\nEst\u00e1 dise\u00f1ada como una herramienta ligera y minimalista, centrada en la utilidad visual m\u00e1s que en funciones complejas: su \u00fanica finalidad es ofrecer un reloj confiable y elegante siempre a la vista.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Y3Pz50hge2tuYsymG-QZDMDJ152JQCAE7Q-l1lyIcuk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-clock-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1344818485370017"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1072613182352055"}, {"status": "PUBLISHED", "id": "1224180429835325"}]}, "ba
2777574984514_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a03hcoYWfQQ7kNvwErJV_k&_nc_oc=Adppo5IPHRLmHbnEjuokwE3f35XCwMJ33FuYrUWTqCKijFDeZ6WvUEgxuLg4gb7u41Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4EBfU2qshg17fI_bS1Q3iCGE0qk4WeVDdUOJr9ZK2FA&oe=6A986A5D"}, {"file_name": "2.png", "id": "1311351264409357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298248_1311351271076023_1462195197401332501_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lclryW1TmUQ7kNvwHv7iZC&_nc_oc=AdoJc15nwdOpdKGd2eTBFabbMZtoqvmaesl93EJnqoN4ut0po8UiHAWK465mot-Mn2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp2MeRTVnMxrXJsBykMom9bpUHffdDlgmpI3-jlc1PtQ&oe=6A9834DE"}, {"file_name": "3.png", "id": "1057010760024574", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_1057010763357907_3241894581459644960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb9j8VFYYtkQ7kNvwGva0GQ&_nc_oc=AdpXSTGNH9oXN_VCg059gr6zu-PK4qvkHZvFjhqDxFR52J8r8q2ivVXlESmuqD3a4jo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNDocPLdNcr0CgxvPuSGsVT5qU__wfP5tmiQ3vFnTavQ&oe=6A985CB6"}, {"file_name": "4.png", "id": "1587135319715475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312257_1587135323048808_6778664510046305289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsoZgyQbRSUQ7kNvwFS-vLu&_nc_oc=AdqmBYpPEwehVDJOlDiIlJDZvjhJa0ns4aRtpLVm1NVbcCS6eHNcd3uFAH0I5PQ5-40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJukzj3NSN23WgTE3iK8NtspdjQjbnEykT8MVjcQW9pxA&oe=6A98586D"}, {"file_name": "5.png", "id": "1730200161623270", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308184_1730200164956603_9141385422071314581_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhs_NgsjGKsQ7kNvwHjShsl&_nc_oc=AdqXJfadQ_-ZKkBdWrPreZzgWEQGq1I-qS8_ErV2-sJh-d8l7AQRmtvlOj2xKSwvORY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFnQjq1pQcxUYu_ZpWmnEfaPKcsBPNFueASq1yXW_9oA&oe=6A9854F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Clock", "keywords": ["clock", "time"], "long_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference.\n\nMy Clock is a desktop clock that runs as a non-immersive 2D panel integrated into the viewer's operating system. It offers two display modes: a digital clock with clear, large numbers, and a classic analog clock with hour, minute, and second hands that rotate on precise pivots. In both cases, the time is displayed in 12- or 24-hour format, adjustable according to the user's preference. The interface is kept up-to-date in real time through an internal timer that sends signals to the visual components, ensuring a smooth and consistent experience.\n\nIt is designed as a lightweight and minimalist tool, focused on visual utility rather than complex functions: its sole purpose is to offer a reliable and elegant clock that is always in view.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}, {"images": {"nodes": []}, "id": "1044758891269744", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mi reloj", "keywords": ["reloj", "tiempo"], "long_description": "My Clock es un reloj de escritorio que se ejecuta como un panel 2D no inmersivo integrado en el sistema operativo del visor. Ofrece dos modos de visualizaci\u00f3n: un reloj digital con n\u00fameros claros y de gran tama\u00f1o, y un reloj anal\u00f3gico cl\u00e1sico con agujas de horas, minutos y segundos que giran sobre pivotes precisos. En ambos casos, la hora se muestra en formato de 12 o 24 horas, ajustable seg\u00fan la preferencia del usuario. La interfaz se mantiene actualizada en tiempo real a trav\u00e9s de un temporizador interno que emite se\u00f1ales a los componentes visuales, garantizando una experiencia fluida y constante.\n\nEst\u00e1 dise\u00f1ada como una herramienta ligera y minimalista, centrada en la utilidad visual m\u00e1s que en funciones complejas: su \u00fanica finalidad es ofrecer un reloj confiable y elegante siempre a la vista.", "short_description": "My Clock is a clock that functions as a non-immersive 2D display within the system: it shows the time in either digital or analog format, depending on your preference. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Y3Pz50hge2tuYsymG-QZDMDJ152JQCAE7Q-l1lyIcuk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-clock-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1344818485370017"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1072613182352055"}, {"status": "PUBLISHED", "id": "1224180429835325"}]}, "baseline_offer": {"id": "1224180429835325"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1072613182352055"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinar
2bNWK1677A&oe=6B0460E8"}, {"file_name": "11.png", "id": "3413430115582545", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982505_3413430118915878_9049976572575983986_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmSrjGJiB28Q7kNvwHr6SK-&_nc_oc=AdpgqcOalf-BDB6yeLhYqRxLiXLaET0yjGKZRTkyrEZxQUcRMVUBpCJW77lffq8HH0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2uPqdNGsaNutPNCtaE4a_OxsjhdzrCJ-8OK6Hf7vZLA&oe=6B046DBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "bHaptics TactGlove Demo", "keywords": [], "long_description": "Introducing a bHaptics\u2019 TactGlove demo created using the First Hand open source by Meta.\n\nIn this demo, you can enjoy natural and realistic haptic feedback with TactGlove while trying out various hand tracking activities, such as pressing button, pulling levers, building superpower gloves, shooting lasers, and blocking enemy attacks with a shield.\nYou can also high-five, fist-bump, hug, and shake hands with your mirror avatar to experience interacting with other people in the Metaverse.", "short_description": "Introducing a bHaptics\u2019 TactGlove demo created using the First Hand open source by Meta.\n\nIn this demo, you can enjoy natural and realistic haptic feedback with TactGlove while trying out various hand tracking activities, such as pressing button, pulling levers, building superpower gloves, shooting lasers, and blocking enemy attacks with a shield.\nYou can also high-five, fist-bump, hug, and shake hands with your mirror avatar to experience interacting with other people in the Metaverse."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/bhaptics/tact-android/wiki/bHaptics-Player-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "bHaptics Inc.", "support_website_url": null, "website_url": "https://bhaptics.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "c
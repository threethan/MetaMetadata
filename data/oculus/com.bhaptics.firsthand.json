video_trailer": null, "video_trailer_thumbnail": null, "display_name": "bHaptics TactGlove Demo", "keywords": [], "long_description": "Introducing a bHaptics\u2019 TactGlove demo created using the First Hand open source by Meta.\n\nIn this demo, you can enjoy natural and realistic haptic feedback with TactGlove while trying out various hand tracking activities, such as pressing button, pulling levers, building superpower gloves, shooting lasers, and blocking enemy attacks with a shield.\nYou can also high-five, fist-bump, hug, and shake hands with your mirror avatar to experience interacting with other people in the Metaverse.", "short_description": "Introducing a bHaptics\u2019 TactGlove demo created using the First Hand open source by Meta.\n\nIn this demo, you can enjoy natural and realistic haptic feedback with TactGlove while trying out various hand tracking activities, such as pressing button, pulling levers, building superpower gloves, shooting lasers, and blocking enemy attacks with a shield.\nYou can also high-five, fist-bump, hug, and shake hands with your mirror avatar to experience interacting with other people in the Metaverse."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/bhaptics/tact-android/wiki/bHaptics-Player-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "bHaptics Inc.", "support_website_url": null, "website_url": "https://bhaptics.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "suppo
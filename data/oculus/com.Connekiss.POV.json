58017052887_1764234400149201833_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_tzGATilyMQ7kNvwHweir7&_nc_oc=Adr0Zr-VMnq8OCT7i9MaxVOLLlOdolktpGinIt8YPYEJCs5BzbCNnoGV8f6KK3xtChs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0shre_J55nHlreOvDn0--Rc-dBkThuzlvVyjJNh06LQ&oe=6B0C4E20"}, {"file_name": "POV_2560x1440_20220909131325.png", "id": "451495357032980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566682_451495360366313_4657701678887731149_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WnPZ5KHwKEQ7kNvwHXy8zI&_nc_oc=AdqmEOGUwEtYdY3iejnFC3YlxNjEM5z63eKxezT_Q9HiH7T1elxdpFvXZiCVNZM8p4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5ClZxoCPT5T7Bu-XL_DbBT1AJmDQSyGHVm0drmq90Fw&oe=6B0C7080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "1158791631724766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974629_1158791635058099_1538718814688576676_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvJai9ZB6C4Q7kNvwFBAtNm&_nc_oc=AdpqNqlftXMpIt3NlWWsUNNzxJkZMQ1FtwnLtWaEsI-fAlg1_LvNbEGNoo9-YSkk5OY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqdqWkGlbTclBAjLPeXbCVY_eSuANFytUJzCaQct5BDA&oe=6B0C80FA"}, "display_name": "POV", "keywords": [], "long_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!\n\n\nThe POV is an evolution of immersive visual experience.\nThe 360 video is recorded simultaneously by multiple 360 cameras. Viewers can freely move their viewpoints with the controller. You can watch the musicians and performers from anywhere you like. You can experience the same performance over and over again in a fresh way.\nIt's not just immersive like you're there, but you're able to manipulate the visual space yourself. That\u2019s POV!", "short_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!"}, {"images": {"nodes": [{"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc_\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3292183281063618", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250455_3292183284396951_1493052847931319548_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqxQo-HZ2IEQ7kNvwHkBox5&_nc_oc=Adp9cXO1Ib36Ee2j4mkiGz2xpy_qCZJzj9oLZqaUJO7KUiyQgHwcihQ78Z4CMmoqX7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1LMFtQq95GbHGIMQNN-B95aj7KUh-iRHvQEWZpZ9jLQ&oe=6B0C5A6C"}, {"file_name": "POV_\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "1241159566427182", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_1241159569760515_8508840820940686062_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEfaUwD30AIQ7kNvwHyPZes&_nc_oc=Adr-M4XG_T5t5N0_Nd82vNBGgn0_HgRvSLla71WzBC1NvrgbEnjTrS4OI7JjuxLghGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRomWk-n7o3IWu_rgK05d65ERviBajUkFQx_pGCrHXyzw&oe=6B0C7360"}, {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "12097431229
n_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnAF7NVnDf4Q7kNvwGhgre0&_nc_oc=Adog0nnXZASzf4xhMv0Dp0Ch_JAYVXhqchHfcqaYleytD4pEc5wQRJQro5Pam3F_zbg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvhQIFx0pQxtqaR8nWozZJ4Vd-I1IpsnMVCof3NPgF3Q&oe=6AFF1F20"}, {"file_name": "POV_2560x1440_20220909131325.png", "id": "451495357032980", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57566682_451495360366313_4657701678887731149_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuRBVtGZ7REQ7kNvwFHol2Q&_nc_oc=Adq8InQ_D75k3xwmYEE-acm8z84SHoXNluYsFsdVsGRLcyV-s0Px-F4kO8yH-qWu0LM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHgO9eWAZ7xgwfOjzo59998I4kB-JciklKwZqxn9u-PQ&oe=6AFF0940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "1158791631724766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1158791635058099_1538718814688576676_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdCSlh9hxrkQ7kNvwGFIb4h&_nc_oc=AdqMwiozHXNCNIK61wofmkzAjjTF5BaZqwEgpdRvorrHNNSbPgACk0UM-Yu2F9zfhUQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdrZetwNiORB7THFpGnMlQgx6DX0Kr__-M5RScUjvzuA&oe=6AFF19BA"}, "display_name": "POV", "keywords": [], "long_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!\n\n\nThe POV is an evolution of immersive visual experience.\nThe 360 video is recorded simultaneously by multiple 360 cameras. Viewers can freely move their viewpoints with the controller. You can watch the musicians and performers from anywhere you like. You can experience the same performance over and over again in a fresh way.\nIt's not just immersive like you're there, but you're able to manipulate the visual space yourself. That\u2019s POV!", "short_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!"}, {"images": {"nodes": [{"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc_\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3292183281063618", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75250455_3292183284396951_1493052847931319548_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB91Kxf_bV4Q7kNvwEqvKLl&_nc_oc=AdpaGxNbO7lQzrO2nhytpZ7YP5flvwZY3J3cX1Zt0pdjbDYGiQBBpe_sHtsYC9RgneE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqVnlII5CcZtqJc12b5-yD7TDJqK2YoPkIGgppCdtybQ&oe=6AFF2B6C"}, {"file_name": "POV_\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "1241159566427182", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974672_1241159569760515_8508840820940686062_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVXMwiIi95UQ7kNvwHTorlB&_nc_oc=Adq_9FzStcaYs5M70E8-eG1EPoH7acbVSzj4zMSiW00k7jCLDswsdul-nKXL-3Yzl_E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcB9GiEdtMESKxfv21QRhHXw12GK9rH6E-k9IaVLtrXg&oe=6AFF0C20"}, {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "1209743122922236", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https:
n_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6TNEE3kKVEQ7kNvwFIHcCk&_nc_oc=AdoCokvJgqbZ-Sh0c0vUXHX6pf0e3uxJ-Sy2RgWs0QRbs9r-N-5YAEqmJylXj2RrDsQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdwB-g4icDXNXO7YjqSqqu6ILgxIViHQPfJxA2YMWEjw&oe=6B070820"}, {"file_name": "POV_2560x1440_20220909131325.png", "id": "451495357032980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566682_451495360366313_4657701678887731149_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mHdwSOW-ssQ7kNvwHvPIyF&_nc_oc=Adp5PQP1urjjB5FxfJdk_nciCSYIZlZVqV-m6-eDbDuSluBPhvF2AhFkh_HmZhZPAGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZVb2S2ZMc00nfDS472mHzkHEKIPLrWesAGLtrtOGGEw&oe=6B06F240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "1158791631724766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974629_1158791635058099_1538718814688576676_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH_RywvfOK4Q7kNvwEJsOU4&_nc_oc=AdoXmn2MN02WLzgBXd_181tVfCEfBW2Q9EYMZ7tbaknVSdmF5I7PnxOl9goa5Nmq3P4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIIkIDY-vWZ3pNGQJw7HNaE22JYuUyrHCSRw1VgZ-MBg&oe=6B0702BA"}, "display_name": "POV", "keywords": [], "long_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!\n\n\nThe POV is an evolution of immersive visual experience.\nThe 360 video is recorded simultaneously by multiple 360 cameras. Viewers can freely move their viewpoints with the controller. You can watch the musicians and performers from anywhere you like. You can experience the same performance over and over again in a fresh way.\nIt's not just immersive like you're there, but you're able to manipulate the visual space yourself. That\u2019s POV!", "short_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!"}, {"images": {"nodes": [{"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc_\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3292183281063618", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250455_3292183284396951_1493052847931319548_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTiZgYmCYvAQ7kNvwHMAbd_&_nc_oc=AdpW222yM9UQJDo1h6ALF2Kl858vqUmXW-Dd-HKJiLDzwdp-pxNGvfu1EF_SOHnUsTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjHpXhQQCyXWRy9AMtBfdRRkoEXFkO7NnIpTkjxUX5jQ&oe=6B07146C"}, {"file_name": "POV_\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "1241159566427182", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_1241159569760515_8508840820940686062_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz7FCF_c-PgQ7kNvwGzKf6_&_nc_oc=Adqid8jOkF5jhF44QvX-Y6JygPlyrgZfxLYEglTne85h4tiJtUHXiX7DcLaHnB0_Dnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXNWT1msMY7hmnAeRavGS6P_qYtJ9iDpfxhF94fXs_OA&oe=6B06F520"}, {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "1209743122922236", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https:
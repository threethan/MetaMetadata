7a0a&_nc_ohc=-2l4dLpcje0Q7kNvwEhK4AP&_nc_oc=Ado6rZdJj_0NqYe0v0LGc1TtHx7WL2d1F5hZyfQ3bguHMLVuchvk5XLheIieyfBduJo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPvDGcArlotIwCBoxtCJ88D79ZADeRzEtMI81CAGbXJA&oe=6AFB4D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "1158791631724766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974629_1158791635058099_1538718814688576676_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_IFAPn_iscQ7kNvwE6cLTx&_nc_oc=AdqIh1FRlGRKxi_rGkSbp2dPdKujwPyBdUKoMld2d1v2FpOzeP4GZX_XPAKB60neH9k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPGrp_wDshwzVgHQiYghBb8Nj29WXbWSxTRY_y5iVm3g&oe=6AFB253A"}, "display_name": "POV", "keywords": [], "long_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!\n\n\nThe POV is an evolution of immersive visual experience.\nThe 360 video is recorded simultaneously by multiple 360 cameras. Viewers can freely move their viewpoints with the controller. You can watch the musicians and performers from anywhere you like. You can experience the same performance over and over again in a fresh way.\nIt's not just immersive like you're there, but you're able to manipulate the visual space yourself. That\u2019s POV!", "short_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!"}, {"images": {"nodes": [{"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc_\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3292183281063618", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75250455_3292183284396951_1493052847931319548_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnBhQTio1FcQ7kNvwEx4rMh&_nc_oc=AdoRL7uQGDiWDJnYJj1DHUfrxsjb791zkic-FoduzaFEveVItG22RyBPKzPhH8UINkE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_a911Hikm2FAr5Ureit2jVySDgtHz7uwgwUf2GqDvUA&oe=6AFB36EC"}, {"file_name": "POV_\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "1241159566427182", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974672_1241159569760515_8508840820940686062_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hThXLqZUuIIQ7kNvwHj0fXG&_nc_oc=Adq8FqjrhDWwcWH911w4ZVGQspMiQGYVxpSt--6rAoSyJrt8tbZbKZR0pHE-8M_gzlw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLU_QkA5Z5Jgva_Q_yBD8QKweCg26bovxmV8PlJiEXAw&oe=6AFB17A0"}, {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "1209743122922236", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/227814956_1209743126255569_7621081603967209564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii2GtOODfsMQ7kNvwGii4Oj&_nc_oc=AdrGMIrf6uPOMM0bHbpS1qabW8xgk7UvigqJg3esoKs8YSQPYU7gi8cl8Gch2KEivEM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnulAN_YcxlrUW7Vg7NBptES8HE3rCSL8JUG4dYJFNnw&oe=6AFB22D3"}, {"file_name": "POV_\u6b63\u65b9\u5f62\u30ab\u30d0\u30fc.png", "id": "794628851789063", "image_type": "APP_IMG_COVER_SQ
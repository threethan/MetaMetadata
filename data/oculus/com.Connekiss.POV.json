58017052887_1764234400149201833_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_tzGATilyMQ7kNvwHr-D_K&_nc_oc=Adq_tOiBogPLSdIK_y59Ohn4kpdni2uCc68YV1NuYDgmMOD4FU8EZ9u_lQiMyvxr2so&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvHBBhENMBL7GmiiButIlWsJP4VPomUB-zncRw_0DMNQ&oe=6B0D9FA0"}, {"file_name": "POV_2560x1440_20220909131325.png", "id": "451495357032980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566682_451495360366313_4657701678887731149_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WnPZ5KHwKEQ7kNvwHrFz1H&_nc_oc=AdpSZZTqDs8betc-FXgVq6gVnP3-WNSgitRglWKtQdA1iQzoVIAmMvDNfwHZyAr_jf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQRTGFf5rH-FQSyTkg96S95qDlkPoaMoxr8wt29GuDKw&oe=6B0DC200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "1158791631724766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_1158791635058099_1538718814688576676_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvJai9ZB6C4Q7kNvwFwv3RB&_nc_oc=Ado5R3MJywJAudI-88oJqCh3EPIhIJyxqJEvQGbgb3nS5rXZGdv-vtfOS1lIa2EjqGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWG_rlEOWkBh7hF2Ir05xD8uvWKjPcK77XFQFI3pPxgw&oe=6B0DD27A"}, "display_name": "POV", "keywords": [], "long_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!\n\n\nThe POV is an evolution of immersive visual experience.\nThe 360 video is recorded simultaneously by multiple 360 cameras. Viewers can freely move their viewpoints with the controller. You can watch the musicians and performers from anywhere you like. You can experience the same performance over and over again in a fresh way.\nIt's not just immersive like you're there, but you're able to manipulate the visual space yourself. That\u2019s POV!", "short_description": "Watching live-action 360 video in the POV brings you a special experience\nThe POV is a \"multi-viewpoint VR visual experience\"\n\nUsing the controller to shoot a cube floating in space, your perspective shifts instantly\nYou can move freely between multiple viewpoints\n\nChanging the visual effect, you can enjoy a new visual expression\n\nThe POV can be downloaded for free\n\nLive performance 360 videos are also available for free download and watching!"}, {"images": {"nodes": [{"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc_\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3292183281063618", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75250455_3292183284396951_1493052847931319548_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLuSyh_a2kkQ7kNvwEacmHT&_nc_oc=Adow4_LaaZPw3oohqUqwoyQ8o8BDCRsZvzN6o1XxHlsmh-HKgLZukCzsxDNtWJqqOKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLQx4HKF9f3BZm5pEUinqSZ3txqYross3HGXb_i0ZMog&oe=6B0DABEC"}, {"file_name": "POV_\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "1241159566427182", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974672_1241159569760515_8508840820940686062_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xu_gzQ9B9roQ7kNvwF9Wxd9&_nc_oc=AdoDqtiBRaWMqBNL_gkA0St0wJ9oxaV5C9V6NUMsUN3cl1RYULvPcgxYleG-wSD5AxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyvYtzvixHFZ-m9QIP0RQjbgM2rgMePNiGCSqXUSAYpg&oe=6B0DC4E0"}, {"file_name": "POV_\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "12097431229
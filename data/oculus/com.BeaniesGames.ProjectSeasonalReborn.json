n.com/v/t64.5771-25/491820887_2091978034991698_292110746905996947_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsdNkHBhOz4Q7kNvwHROXaA&_nc_oc=AdpPhVTO8hR-AN13ETfLiQqiuFPPd-ZDLOl4l1TjfxcHuhoP4bfXPfrH7j8ov6bpOTI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFYOKMmTPED3CjNsI_ppS1J6soYmn_0DUlkpUSYqq7OQ&oe=6A831698"}, {"file_name": "screenshot2.png", "id": "1244613733874956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_1244613737208289_7093687278535935309_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZsMDiT81WMQ7kNvwGhL7_l&_nc_oc=Adrgxf8OQf7pGxGy_RmO03yjd6pyqsJfndl3MMc1OKK_tBVveM7whxtmfbCgUOcCBu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsh1e60KHNA38y0Hb8z9US6kpAjPVIAosgSTRmKgN_cw&oe=6A830502"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Seasonal Reborn", "keywords": ["Seasonal", "Project", "Reborn"], "long_description": "Project Seasonal Reborn is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, Project Seasonal Reborn is all about community, creativity, and fun.", "short_description": "Project Seasonal Reborn is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-seasonalstuff/home?authuser=1&read_current=1", "developer_terms_of_service_url": null, "publisher_name": "Beanie", "support_website_url": null, "website_url": "https://sites.google.com/view/project-seasonalstuff/home?authuser=1&read_current=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "26011007585187939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1433395401851576_189750912563160111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDW90cTit6IQ7kNvwGtz5lP&_nc_oc=AdrlKxo9Vb8wHBBXZcIWbwyw4D3eFAnx7G7CV-RQ_hiOBxliD5fkLb-mEJ6HRrvPaw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgSM5WGIfKclhKB59iHqsr9UNOr9cIDUgYKZOV6En21Q&oe=6A830AA9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Seasonal Reborn", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_nam
2.oculuscdn.com/v/t64.5771-25/491820648_1461040231586531_2569043311237301199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY626b39Og4Q7kNvwGNrBhM&_nc_oc=AdpDemtNivTZzVaYu1X6bOFxObr225zB1K17qeywZi2HmDR6x8DmtLFjJQD-Kw5AGLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI3wCEXgZD6d9IXd_iqoD7f7a-MdbI_cnWTO0rfI_5OA&oe=6AFDBCC1"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXvFoN4BjOAQ7kNvwEyLEfg&_nc_oc=Adp9IP7FhaYWXjP1jpdc8mSZ2H8zdQ2WaZnPbw7T5To9uKaLGNBDyoT1km2wuwRfnW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUkzQrfCZGpTOyqEdu0QTVJA6SiBk0LZyHGbzNctlsAg&oe=6AFDD9BA"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcSiPt-y3n0Q7kNvwFqNHsI&_nc_oc=Adoy0agHMPBfwSjdRkI2SSg7Up-fDJFVKgXfbcqjOl-LrQsEr9vGYpx1HYpsY0qezN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP3JrtPHDbf-4Fx6-tcaXbrkaNm2Rtj1OMurawXHsSIw&oe=6AFDE35F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3mDbxsS4YcQ7kNvwF8djvH&_nc_oc=AdpbP7rDZu6rhfvcraunTkY-zvbMcVODmgIsVn5QD8aw4tMDqfOk1W1ciBW2_HLILho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8NS-u_3lcehQ78jmaBwLhvAaqzR0c-ngKOUPVq4OxTg&oe=6AFDD516"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "su
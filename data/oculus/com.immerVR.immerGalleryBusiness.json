1.oculuscdn.com/v/t64.5771-25/491820648_1461040231586531_2569043311237301199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsNq6YIXjWEQ7kNvwFSlR2D&_nc_oc=AdrqDez_Q0cplz356E6FOATyVQINdQ31cvyWW3kYVqffNcgiwu9EKwBNU6YIGs4I44w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6SxmH-Iy-iXeE6S0qOEOpMNpgiqn6Pix-9X_ViJXueA&oe=6B0302C1"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coOd7LcpHd8Q7kNvwGahfQU&_nc_oc=AdqxmEjC2TlL7PbHhq0WWm5_uX2sqGiRVgZMMJ8y4NaMSZFC-ZQ6znBsQ7yQue06RMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1GT_JAilcn-TVSFXmDsCM0S2j0J_79_ljp8Qz2RPYrg&oe=6B031FBA"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2Fi3-e-Y1wQ7kNvwE06BeY&_nc_oc=Adqmqm4dAMM3YsnXkIX_SmcLSp5Ynw2hbkcOv-RK_RIXH8z8IcSwzqudlDTseml7Hzc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbt6s6aaxJvZNXA2h9udRF6KSo4aX6E1U2wMteZ-ulLw&oe=6B03295F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIv9vLWkHxsQ7kNvwGQiCcX&_nc_oc=Ado2R-5OUSQX1N0_v8FuGjJTYsV1aSmta2BAtHmQ0wnufg_2K4FcsozJcBVg3TboF80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnkixVP4ZGo2DSN19UFz0-bYq6XkGjtjJu7V-_LAOi-A&oe=6B031B16"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "su
ivXfiOiwdd4IsNyE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIveVzmLdnXXolkZpeUzAHA-yCTn7Vljj8IaK4Pt8uaig&oe=6ABE74C1"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGuCaJGdLewQ7kNvwGVNyBH&_nc_oc=AdpToMMtzhzbNUhWrwmIeKxWAvDuKW0ODfJukdohKAcgdOvehf52uqGLdVAkeBrRWmI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt17DFehlwEaBjQk5Z_KfxNkm-1qvNIDWo37s1FbOVaQ&oe=6ABE597A"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqqcgMvL-rMQ7kNvwE3XB8A&_nc_oc=AdoI-0NJsYNuxR-63HvmLd4jglavfPW-w8QCX9UHgJBJvyVVgp5ivLRCUYERwdKdt-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIChmRGOB1p763NVl28TNYxUkZ2uU05x5-66EPb1-8XA&oe=6ABE631F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl6GPQwIMAMQ7kNvwEjzcu8&_nc_oc=AdrqD5NsWzEF1O0vK91lfUPK5fhJRTumQPvzo8-q51HrIoXsqqKYDewYzs6fCLavzb4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCwUG-b9wD0ohC4RtbH3kwnyxgPN2eOo8097KaYVR_iA&oe=6ABE8D16"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://immervr.com/", "website_url": "https://immervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1063584910766706"}, 
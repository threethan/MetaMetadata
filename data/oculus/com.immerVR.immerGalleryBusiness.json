m_De&_nc_oc=AdrYCvYkcZ8tyfXd5iDR4uk5aN0q7lowFpd91MHOJq9U3Zzc9KkkEw425mctJp1-nh0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu-_yB3B8zWxnmSD7TLw7DPl_d-10yOBDDabmCvcdxkg&oe=6AE35EC1"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PpLkoezPmgQ7kNvwH4_g0Q&_nc_oc=Adqia1_dpOklgvzr8sJ-4OvhrlWeJtfo4BK9EJs31lLU6K4xlfNJ9WXs1AxXRj_DwJg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs2pvnL_5W-L-Y6Ve0n1yj8gBraZU0-_oN4Sam2avO2A&oe=6AE3437A"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXtEL43RlecQ7kNvwEqv9u1&_nc_oc=AdrId_QPN_hmDXnHY5J2bIjGQak3ee1mmkMwWow2D14Kgno9ukbwiBSSoP6WZBai9ys&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEPZGj7lHS-Z3H8yVQhPwykrtDUJDcpqAeH-YoVgkBUA&oe=6AE34D1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwSIW4gH7WMQ7kNvwEx6mut&_nc_oc=AdrZysHPUsrOi-rKf-OXkOxw03ZEr2g1cSUAkxrWt8loPRIba3UsUHagUgnHgDC-fCA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2L1mZDoLzsFRhUwP708EOu5dH9nvbiqVCwGTtNLMN3Q&oe=6AE33ED6"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://immervr.com/", "website_url": "https://immervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
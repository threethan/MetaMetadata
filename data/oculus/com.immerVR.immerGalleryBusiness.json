1.oculuscdn.com/v/t64.5771-25/491820648_1461040231586531_2569043311237301199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY626b39Og4Q7kNvwEvVusH&_nc_oc=AdoqHM68mKQUKpfGMM3bSOjP_zxsB_1f3UyV3b9dQ5wN2on5Ktivbfxh5FSj_yalQ1s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcL15gGdBBJ_xWguxYu8KzJbfe6UcQwNET7UGbfFIb2A&oe=6AFB19C1"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_g8H1QdpidsQ7kNvwFCWkzl&_nc_oc=Adovj0feliUxOEYmDlic4j4yq7M2U055Un6dNb_SUbZeRJ3VUqIUjlt0uNGffwgIBGI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIVW2XaWb7K34moqBSBN4zWXq5dz7tLdEPa8OfxkYV7A&oe=6AFB36BA"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trIF4ca9ZG8Q7kNvwETaoYY&_nc_oc=Ado4qmqC3TGpsG1gKi6kjDkd0iCFktU8Oo6P5khtLl7gnZnkHNhR3UoMy7atitscbew&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4PhIQLPhVus7OvSpeAlIMfBCwuONnI2A2rUDW_bQSdw&oe=6AFB405F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ8okW5xa3UQ7kNvwF1Mt-I&_nc_oc=AdoY3CDJyv9JqNeYCI9aNyKnvOnJ-o2959U_uz5k62av0KGby723PDJq-RWiVZ5Z-04&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs2hiDPzGw1vRmVJPoJeC4yYw-fW9ra2qlMnrfNWagDA&oe=6AFB3216"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "su
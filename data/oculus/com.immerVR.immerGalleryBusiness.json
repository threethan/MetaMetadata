2.oculuscdn.com/v/t64.5771-25/491820648_1461040231586531_2569043311237301199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsNq6YIXjWEQ7kNvwEDd2ZE&_nc_oc=AdqxDKrFrEaQUTly0TSZGANqIjJFPMqGh-YjXkZiP00HgiprPdsAdRUwkvQwHZ-nsDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ9lZZ1XcT8fCUmAKR9cYT6IOpciNCitx5Uf5KRaSYdw&oe=6B05A5C1"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqLQXoOXTKIQ7kNvwFSH6mG&_nc_oc=Adqz9ZZvH-kN4aGCacSwpSnWHTzQ_CyFZOfqG4bkEHrtPPTZM2f40vUSB0hfOvYRBd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdpBfa-X-Rat4pXHLGlrgkMzxu00WP3PYvIsl40JKkBw&oe=6B05C2BA"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lwd0HwcIpEYQ7kNvwFJRZyT&_nc_oc=AdqC1ZpBcHotcu-XP4iDxuRgrz6ZqPBqSSXKg8SsbMZdTIErVSfNeaUvZVQEx9X9U-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNShmaTaSTp7RA0eogmCeZ2gEau7cSzOAJjecyXn8mQw&oe=6B05CC5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E66t0OWUMhwQ7kNvwE_BtHz&_nc_oc=AdqNGAZjIWL6df301IHCfXlvntkNB78Xoy_d0OxhOJkDSUTP6RkrzSRRg1cZkUoLTLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJYzlE2ld4QiGIz9AVedpG1Vzax0k2HY1k5J9LtW7_zw&oe=6B05BE16"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "su
bvsNaD5QHAeU3pZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYYjLjxdY51FlLhCbk4MH521ksv3hsVYiJWMgJJK2oIA&oe=6AEB47C1"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z66pqAwsbNkQ7kNvwE7UaHc&_nc_oc=AdqtDXz6SqKa2BktU9m93BUum0yXXOS1odw3cFgG5dLPkd5eX6TXvmhdttFtF0n6Yy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkATkrr9eITjtXHbiwyfIt5M5RJpTLhiJi8dXPN-NOuQ&oe=6AEB2C7A"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAn_eeybbd4Q7kNvwHB4RqC&_nc_oc=Adq0iMv6ai7ASreVKbesP1EIqwuVJt76UwGL99NuPhbvz1ABmuCb_fhYygJHNuI5Hr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0qXa1723_y4Y0ilbWlyab5sBtNQ6Zy_kc0JcgAC7dzQ&oe=6AEB361F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPemqVfs5OEQ7kNvwFzxKyd&_nc_oc=AdrNXyT1BgSykYiH-rmPdXymp4ziKYeI6ThAt5d-mruuvVowbF6vCbibbAsNa10Rpg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuK7fTg-6sywA8j21G6zSISVY5xRkUZjYM0gtS9b4alw&oe=6AEB6016"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://immervr.com/", "website_url": "https://immervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1063584910766706"}, 
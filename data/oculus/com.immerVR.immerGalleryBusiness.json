svtx&_nc_oc=AdrxWk-KfysX4yG6oQ3-2WLwdpax2WcljRJNAr5_0hH0YPP-yC6GRZMwocs-yZ9X-4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB29GmfMg00A6HWEd6OjBIeXf1zVm7pITN9oq2q9L4cw&oe=6ACCF541"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn4HUfVtKXwQ7kNvwH2qq3y&_nc_oc=AdpjuYOlNha9ZEbA9JaPTQ8U-2u1pPuaDGN0TqAi0x9-bTiU9YaZEUB1zhsrnuv6QIA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTkE8McjvKqW-ltxHfCVSS-R3nU9aOxaDiosM5_dq4PA&oe=6ACD123A"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16KRcr21xd4Q7kNvwHhDYPk&_nc_oc=Adpuz5G-KBE-_wj_-j6XYCvTjyNAmpdBV3_0Mtv5QviFBkJv85d7ktj8m-CP8yUmPl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPN6BDsvls7XBfnpH9HOEmI9by-B7viKbZipyBvW93hg&oe=6ACCE39F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwNbTmTIyC4Q7kNvwFBViN9&_nc_oc=AdpJ1bLHUNwyq9iA1xM5iSOoAR56bsGaZ1AkyE3SbLoZYnGXCwzd5-TzrDQSl_MldyM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbY55JmIpGcEfdLfo8tZ4bABac3LWySC69jIzBjnPi4w&oe=6ACD0D96"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://immervr.com/", "website_url": "https://immervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
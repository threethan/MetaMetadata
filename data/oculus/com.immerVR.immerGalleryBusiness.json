kW5xa3UQ7kNvwF1Mt-I&_nc_oc=AdoY3CDJyv9JqNeYCI9aNyKnvOnJ-o2959U_uz5k62av0KGby723PDJq-RWiVZ5Z-04&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs2hiDPzGw1vRmVJPoJeC4yYw-fW9ra2qlMnrfNWagDA&oe=6AFB3216"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://immervr.com/", "website_url": "https://immervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "29745959728381778"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1380077349738584"}, {"status": "PUBLISHED", "id": "1238343911118788"}]}, "baseline_offer": {"id": "1380077349738584"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752871560, "status": "PUBLISHED", "id": "1380077349738584"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39404193995891588", "version": "1.4.6"}, "id": "728929149521149", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2974595968
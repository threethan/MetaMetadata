plgM&_nc_oc=Adq9-CHF5Wa0KDOhVnLGQAM0Cz4vP9OxSOQfiDf3Sc6kUVe3wgjmrE9rR-JnbhmfQes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrnom0AwtX7kQcPpEbSexYsswXzyL0weTbNSRoleockQ&oe=6ADF6A41"}, {"file_name": "04 Logo.png", "id": "1392499235301227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828793_1392499238634560_2821072604328041599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMdejLuk-8QQ7kNvwHLwY8B&_nc_oc=AdpGgAjTsCnHd3f8NAPAsWkn5aDymdINTESCMt6hsy77ZFfpMzHrRpggNWd-FnauACQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPErIt_3fbxPhHhN2U8Q26F7jrveva7-i4bga3R3MbhFA&oe=6ADF4EFA"}, {"file_name": "05 Team.png", "id": "617614884199451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_617614887532784_6402137718261538480_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vzi8iaS-C-EQ7kNvwHEp6Xx&_nc_oc=AdoiTmU_mwVw5y7G_v34bGu7yj8n1IHXF7MhJ560d7hLLx89tJHhMoLM7wOEU5Yaqe8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoaFfwbXoRbM5vvBdaZcr6CRGVdQVEAiPosTpEq50_jA&oe=6ADF589F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3011360369023154", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_3011360372356487_247061617889363979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sgw62XJ24xQQ7kNvwFiXbfb&_nc_oc=AdrqIga_lgNaKY93w7KTmwoLylMHzNKF8-tBDzwJzCPamMrzURn1GhBFEo-YVkuCvLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXZ9vnzAPIlDvGAEILOYVDiQcf8sJ24OFpEWJRNe1qsg&oe=6ADF4A56"}, "display_name": "immerGallery Business", "keywords": [], "long_description": "Welcome to **immerGallery Business**, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view **VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content**. \n\nCreate **immersive slideshows** with background audio and voice-over. **Automatic format detection for images and videos** ensures a smooth, hassle-free experience without manual setup.\n\nimmerGallery Business adds powerful tools tailored to business needs. Use **Kiosk Mode** to restrict access to a specific folder and lock settings behind an admin PIN. Add your **company logo, customize interface colors**, and **show only the menu buttons** your audience needs.\n\nManage multiple headsets with **Config Sync.** Upload your configuration once, including all settings and preferences, and apply it to other devices using a simple code. **Sync image and video content via shared SMB folders or WWW Sync** using online ZIP gallery links.\n\nSpeed up performance with **Pre-Caching**, which prepares thumbnails in advance. Use up to **eight favorites lists** to tailor content for different customer groups.\n\nWorks seamlessly with **Meta for Work** and **Meta Horizon Managed Services**, making deployment and management across your organization even easier.\n\nA subscription is required to unlock all features.\n\nQuestions? support@immerVR.com", "short_description": "Welcome to immerGallery Business, the VR image, slideshow and video viewer designed for business use on Meta Quest headsets.\n\nEnjoy all the features you know from immerGallery: view VR180, VR360 (2D and 3D), panoramas, and standard 2D and 3D content. \n\nimmerGallery Business adds powerful tools:\n\u2022 Kiosk Mode to limit access\n\u2022 Add your company logo, customize colors, and simplify menus\n\u2022 Sync settings across headsets\n\u2022 Easy content sync via SMB or WWW"}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://immervr.com/", "website_url": "https://immervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
oes of a hero and protect the city from a dangerous and powerful criminal group, or take care of yourself and work for the villains in their relentless crime spree. Swing between the skyscrapers, fly fast jets and powerful helicopters and race through the streets in on or offline game modes.", "short_description": "Midway City is in a chaos! A new type of criminal needs a new style of justice... Battle for the streets as a hero or villain, on or offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.enemyteam.games/webshooters-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Enemy Team", "support_website_url": null, "website_url": "https://www.enemyteam.games/webshooters", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7029309653851227"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982456_647801457286059_5601279890720159983_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y67T_dOgY8Q7kNvwF9reAz&_nc_oc=AdosvJ2dC2mZE7yLaK8j6dKrhjYpWKegHAacfEvce0dj85s-BaOXIXelL7lWn5lTLY0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af21ACNguKB9wVcvMpC4E1qE03RfDGYEs_snKtkJeUCO2g&oe=69F1F217"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Webshooters", "platform": "ANDROID_6DOF", "context_ca
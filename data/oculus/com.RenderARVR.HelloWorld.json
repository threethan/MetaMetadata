3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkUxF_GxazuCyZsPcnDFtR1YFWSYuwO7gqBBf1TDWAJQ&oe=6B07259F"}, {"file_name": "Adobe Express - file (8).png", "id": "2264146517316048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830617_2264146520649381_5240307306057443979_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J_r7ZmeekoQ7kNvwHW8PYK&_nc_oc=Adq5gY5pDQXGHWRyD2m8jhrrAJk_h9Q0cYcVERfsr2ui-aKZi6rtI2YUdz-IC8qIxm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMNn1gW1rXIkpTmsGBS1_bW2KTMHb_6sx9rUio8PG5zw&oe=6B071180"}, {"file_name": "Adobe Express - file (9).png", "id": "1196795425183587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1196795428516920_5607330333558775563_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfBPxflcAl0Q7kNvwGzzy6S&_nc_oc=AdrTJNHc1nfA19kKKWOrfVWgKZkw9gYhVBI-s_-w7D5m2RGSfAeb1evhBh-s4J1NAZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv5i_b8DpJaQpA8uYQ-3T1KSs9liEjETHhyyZClhjiIw&oe=6B06FBC2"}, {"file_name": "Adobe Express - file (10).png", "id": "985459937030820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392165_985459940364153_7150982175278585375_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9TCy78Eb7UQ7kNvwHTU_d2&_nc_oc=Adpsn-v77M5jZ7jcR6xHXn4QCFCmst6xXHTezAokucM1J_OhO4mf8BZWqaJ3xuja_dM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEkptHXbqF_-v-wLr__2OOeFYtb4kVrfFIUEh15Tpkqw&oe=6B06F93E"}, {"file_name": "Adobe Express - file (11).png", "id": "1702322827040953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394189_1702322830374286_3625385346484653544_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvb2RCpF1DgQ7kNvwFt54Di&_nc_oc=AdrFzf69Ntyu7yJAxEUlOoZFLzAGW32ijdhwaqioEm8y6OvfhZFxMCJFfuHT5exkNH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNum8AI9ajvuELETS9ZZPYekQLa9JY8URwbYYix-Dxiw&oe=6B06FDD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hello World", "keywords": ["HandTracking", "ManufacturingSimulation", "IndustrialVR", "Training", "InteractiveDemo"], "long_description": "Hello World is a free VR experience designed to showcase the power of hand tracking and immersive interaction in industrial environments.\n\nStep into a manufacturing simulation where you can explore and interact with real-world machinery \u2014 all without controllers. From operating a scissor lift and forklift to inspecting a toolbox, robotic arm, and concrete pump, each interaction is designed to highlight the precision and intuitiveness of VR hand tracking.\n\nBegin your journey in a guided tutorial zone with helpful videos and a tablet that walks you through each interaction. Once you're ready, teleport to a fully equipped warehouse and explore freely. Whether you're new to VR or evaluating use cases for your business, \"Hello World\" offers a hands-on glimpse into the potential of immersive technology.\n\nPerfect for industrial clients, enterprise partners, and anyone curious about the future of training and simulation \u2014 this is more than a demo; it's an experience.", "short_description": "Step into a VR manufacturing space and experience the power of hand tracking! 'Hello World' is a free interactive demo featuring machines like forklifts, scissor lifts, and robotic arms. Learn, interact, and explore \u2014 no controllers are needed."}]}, "developer_name": "Render ARVR Pvt Ltd", "developer_privacy_policy_url": "https://renderarvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Shail Shah", "support_website_url": "https://renderarvr.com/contact-us/", "website_url": "https://renderarvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "10431
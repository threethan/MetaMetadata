3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBKay4lqnvukXb8jC8tVxgSYRbBGnNtwuLZ5qEoYz8OQ&oe=6B0C6B9F"}, {"file_name": "Adobe Express - file (8).png", "id": "2264146517316048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830617_2264146520649381_5240307306057443979_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPIV7D4KK68Q7kNvwHOc6Ce&_nc_oc=AdrfUcgljkHjc0suTr3FVrIz_2F5Trwr9OK57lTOU16ZkyrwWv9911VgSDykwyEOc4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjO0R6eMRg8aDuLA5PYJLokC7FK4-QPxQWI_kFrvsl3Q&oe=6B0C5780"}, {"file_name": "Adobe Express - file (9).png", "id": "1196795425183587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1196795428516920_5607330333558775563_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_fe1v6NcEgQ7kNvwGoOtFk&_nc_oc=Ado3UeQLHBLV2CMaCm-sN5w_gvr8JKhxHzRrTJ_-GK3m6NlIGY95PXcw-nV150U-F8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkvtSmqqOYiw9UCoLS_Bey4n5ZSUV4b9kVpx8wmpNesw&oe=6B0C7A02"}, {"file_name": "Adobe Express - file (10).png", "id": "985459937030820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392165_985459940364153_7150982175278585375_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhw7Rg3EpFcQ7kNvwEepysv&_nc_oc=Adq0eMLX-l5A59Fpvzt6F2B49rI7YN3ZNaOL4ng_2Ge7fWqtQv2H8QCnhKi2FhGk_KQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjZ3ewG4lkgZHEA6x1k5b1xXTXO3j27oE64P5wK5Hceg&oe=6B0C777E"}, {"file_name": "Adobe Express - file (11).png", "id": "1702322827040953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394189_1702322830374286_3625385346484653544_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aLM-ZaRx8EQ7kNvwHTatz5&_nc_oc=AdpsyFPtgVBBlMgdgczF0d4qT5un3-P331yStVOoZxTQelObf6IqZ-MTkZS019Td6i0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAzH6qtf5lEvyGz0lAfMDKuigeEN-WGqQ3pc-DtQShmw&oe=6B0C7C12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hello World", "keywords": ["HandTracking", "ManufacturingSimulation", "IndustrialVR", "Training", "InteractiveDemo"], "long_description": "Hello World is a free VR experience designed to showcase the power of hand tracking and immersive interaction in industrial environments.\n\nStep into a manufacturing simulation where you can explore and interact with real-world machinery \u2014 all without controllers. From operating a scissor lift and forklift to inspecting a toolbox, robotic arm, and concrete pump, each interaction is designed to highlight the precision and intuitiveness of VR hand tracking.\n\nBegin your journey in a guided tutorial zone with helpful videos and a tablet that walks you through each interaction. Once you're ready, teleport to a fully equipped warehouse and explore freely. Whether you're new to VR or evaluating use cases for your business, \"Hello World\" offers a hands-on glimpse into the potential of immersive technology.\n\nPerfect for industrial clients, enterprise partners, and anyone curious about the future of training and simulation \u2014 this is more than a demo; it's an experience.", "short_description": "Step into a VR manufacturing space and experience the power of hand tracking! 'Hello World' is a free interactive demo featuring machines like forklifts, scissor lifts, and robotic arms. Learn, interact, and explore \u2014 no controllers are needed."}]}, "developer_name": "Render ARVR Pvt Ltd", "developer_privacy_policy_url": "https://renderarvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Shail Shah", "support_website_url": "https://renderarvr.com/contact-us/", "website_url": "https://renderarvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "10431
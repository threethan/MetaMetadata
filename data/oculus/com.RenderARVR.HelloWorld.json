5563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I10jP9zjRhcQ7kNvwG9V1BW&_nc_oc=AdkcotS7iCVNl6BtBEe_21Ul55X05XG6veCPqBF3KqhoLTRgdpyZG27LrGp1cyjWJk0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxR3TsF5cIb1OuF9nUnj-ArGf1Apd8ajtx9P-o759aotQ&oe=69B2A082"}, {"file_name": "Adobe Express - file (10).png", "id": "985459937030820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392165_985459940364153_7150982175278585375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Jh-mkoFfgkQ7kNvwEy783x&_nc_oc=AdncFLpXTHVNdtiYjE9rWUnCdWRcNF7wyRe9AbUlb9N2yFfiyN_TCClq0SSizRm1SBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwFocNF3VHNm5pm1UUiOlG86XlkmyRa5QO21rQWsD-3w&oe=69B29DFE"}, {"file_name": "Adobe Express - file (11).png", "id": "1702322827040953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394189_1702322830374286_3625385346484653544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnAPrk4KszYQ7kNvwEZroDi&_nc_oc=AdkWGB9KQWfbox1u9Xga3B3H2EEsmq9GIE1EqCXxY9ydYvaBZO9DneZV-fPvjd7V4aU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQVB4gpjC3-yBARf6ky4HuRFegyu0A6nnoxm7OoYKqDA&oe=69B2A292"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hello World", "keywords": ["HandTracking", "ManufacturingSimulation", "IndustrialVR", "Training", "InteractiveDemo"], "long_description": "Hello World is a free VR experience designed to showcase the power of hand tracking and immersive interaction in industrial environments.\n\nStep into a manufacturing simulation where you can explore and interact with real-world machinery \u2014 all without controllers. From operating a scissor lift and forklift to inspecting a toolbox, robotic arm, and concrete pump, each interaction is designed to highlight the precision and intuitiveness of VR hand tracking.\n\nBegin your journey in a guided tutorial zone with helpful videos and a tablet that walks you through each interaction. Once you're ready, teleport to a fully equipped warehouse and explore freely. Whether you're new to VR or evaluating use cases for your business, \"Hello World\" offers a hands-on glimpse into the potential of immersive technology.\n\nPerfect for industrial clients, enterprise partners, and anyone curious about the future of training and simulation \u2014 this is more than a demo; it's an experience.", "short_description": "Step into a VR manufacturing space and experience the power of hand tracking! 'Hello World' is a free interactive demo featuring machines like forklifts, scissor lifts, and robotic arms. Learn, interact, and explore \u2014 no controllers are needed."}]}, "developer_name": "Render ARVR Pvt Ltd", "developer_privacy_policy_url": "https://renderarvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Shail Shah", "support_website_url": "https://renderarvr.com/contact-us/", "website_url": "https://renderarvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29762386206708216"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "696731606254158"}]}, "baseline_offer": {"id": "696731606254158"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747196040, "status": "PUBLISHED", "id": "696731606254158"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__type
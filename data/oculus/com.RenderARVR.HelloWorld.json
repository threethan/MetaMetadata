3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWMIUY_6f6ivTrvnP8phhFapNCbCyU9lJUcHpxbMwW5HQ&oe=6B10601F"}, {"file_name": "Adobe Express - file (8).png", "id": "2264146517316048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830617_2264146520649381_5240307306057443979_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpLgbfJPRZIQ7kNvwGjbaTR&_nc_oc=AdrjlQ7dv1icu-x-dwZjC-VQUDeef6r2a_woeeNf2sVxvYw9QrWStggCeogNH1Fn8g4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxNfcoTbbMUtp-fCGJZxBRp0p_XJQmShBqRsSaLhjlIg&oe=6B104C00"}, {"file_name": "Adobe Express - file (9).png", "id": "1196795425183587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1196795428516920_5607330333558775563_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EmXGyTvpLwQ7kNvwGxbYcK&_nc_oc=Adpln3M3ITj7nDlS1YOpLR-CjiSlj1Emv5CJ8IfqEjwQ93_PxSGeUtr33ka7tCBw-8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgjsV25Gqm02dNFV0jQ7YiDEWVlgfRZF_qcl8Iifd1aQ&oe=6B103642"}, {"file_name": "Adobe Express - file (10).png", "id": "985459937030820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392165_985459940364153_7150982175278585375_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R48x-CEm0KcQ7kNvwEAIZLp&_nc_oc=AdrGKYnMzx_B7a1aWxuS52ri_pdOFJu8UWuxTYevC3FOygbEtkYISGqTb9BTIgJYCXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3nojk25_-iRs5rgCj7tygeKqcFYesqgV6ejBDIabigQ&oe=6B1033BE"}, {"file_name": "Adobe Express - file (11).png", "id": "1702322827040953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394189_1702322830374286_3625385346484653544_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqi_-WevRtAQ7kNvwGjdW81&_nc_oc=AdodpXFQuU0n3jBPB-GM_w2rCHDZm-rgvyjJ2UttA_PBMOjjw4yxchjHtf5chP62RRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFW-p1__ZGz20Zgzh8B4PJx7RGmAism2v-8CR3XSoOqA&oe=6B103852"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hello World", "keywords": ["HandTracking", "ManufacturingSimulation", "IndustrialVR", "Training", "InteractiveDemo"], "long_description": "Hello World is a free VR experience designed to showcase the power of hand tracking and immersive interaction in industrial environments.\n\nStep into a manufacturing simulation where you can explore and interact with real-world machinery \u2014 all without controllers. From operating a scissor lift and forklift to inspecting a toolbox, robotic arm, and concrete pump, each interaction is designed to highlight the precision and intuitiveness of VR hand tracking.\n\nBegin your journey in a guided tutorial zone with helpful videos and a tablet that walks you through each interaction. Once you're ready, teleport to a fully equipped warehouse and explore freely. Whether you're new to VR or evaluating use cases for your business, \"Hello World\" offers a hands-on glimpse into the potential of immersive technology.\n\nPerfect for industrial clients, enterprise partners, and anyone curious about the future of training and simulation \u2014 this is more than a demo; it's an experience.", "short_description": "Step into a VR manufacturing space and experience the power of hand tracking! 'Hello World' is a free interactive demo featuring machines like forklifts, scissor lifts, and robotic arms. Learn, interact, and explore \u2014 no controllers are needed."}]}, "developer_name": "Render ARVR Pvt Ltd", "developer_privacy_policy_url": "https://renderarvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Shail Shah", "support_website_url": "https://renderarvr.com/contact-us/", "website_url": "https://renderarvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "10431
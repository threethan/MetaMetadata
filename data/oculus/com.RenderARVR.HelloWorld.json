scdn.com/v/t64.5771-25/491830617_2264146520649381_5240307306057443979_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9sD8y67rn4Q7kNvwHS0Oyb&_nc_oc=AdqXYs_gW7iWr9pG04PPupj2EBkfecVN6nuorQRMgd6kHIw_BUqNsqqLvXMixXrMefo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BqIOjva1QGuu_tpoK6L7YMQyk4o8ev1ZFQ8T6icYMAQ&oe=69FB38C0"}, {"file_name": "Adobe Express - file (9).png", "id": "1196795425183587", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1196795428516920_5607330333558775563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVI4k2xoQnkQ7kNvwFsPr1n&_nc_oc=Adq_IzWFlRY2nRDJU3aXp2QPoyCwxZ-Okc3rGIdV8YY4ViLQqeU6QsFhNb80049N8Xo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tGcNpyrw3838eFfC_NeDA6YCxmLIN-1sgsstKKtcO4w&oe=69FB5B42"}, {"file_name": "Adobe Express - file (10).png", "id": "985459937030820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392165_985459940364153_7150982175278585375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Bgx7Hfcqi0Q7kNvwE2LVyn&_nc_oc=AdpZJz3RulfzGLKS_CnhAVb82ZW4dgeaiKHtsn-P-9h9h3KZaWTC_8_AFk-ujnbczx0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MHbJALpS91ZV37lGmLAQRH2Pyi2k_p3MCT6dgIcZIcw&oe=69FB58BE"}, {"file_name": "Adobe Express - file (11).png", "id": "1702322827040953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394189_1702322830374286_3625385346484653544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eApmyw6T8_8Q7kNvwFLBS0v&_nc_oc=AdqrVTRCMkAcEfLR33FMO2ZsvXr902PAAQbgNd0CEz5ZuELo5Nw1Bgi-QCPg88eQUkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g38Na26Hwp5AsGNAPKCDOjjdbZ7nDhjEFIs0xhfLXFw&oe=69FB5D52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hello World", "keywords": ["HandTracking", "ManufacturingSimulation", "IndustrialVR", "Training", "InteractiveDemo"], "long_description": "Hello World is a free VR experience designed to showcase the power of hand tracking and immersive interaction in industrial environments.\n\nStep into a manufacturing simulation where you can explore and interact with real-world machinery \u2014 all without controllers. From operating a scissor lift and forklift to inspecting a toolbox, robotic arm, and concrete pump, each interaction is designed to highlight the precision and intuitiveness of VR hand tracking.\n\nBegin your journey in a guided tutorial zone with helpful videos and a tablet that walks you through each interaction. Once you're ready, teleport to a fully equipped warehouse and explore freely. Whether you're new to VR or evaluating use cases for your business, \"Hello World\" offers a hands-on glimpse into the potential of immersive technology.\n\nPerfect for industrial clients, enterprise partners, and anyone curious about the future of training and simulation \u2014 this is more than a demo; it's an experience.", "short_description": "Step into a VR manufacturing space and experience the power of hand tracking! 'Hello World' is a free interactive demo featuring machines like forklifts, scissor lifts, and robotic arms. Learn, interact, and explore \u2014 no controllers are needed."}]}, "developer_name": "Render ARVR Pvt Ltd", "developer_privacy_policy_url": "https://renderarvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Shail Shah", "support_website_url": "https://renderarvr.com/contact-us/", "website_url": "https://renderarvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
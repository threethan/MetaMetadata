scdn.com/v/t64.5771-25/491830617_2264146520649381_5240307306057443979_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbT0oNi6BYEQ7kNvwFxLJpw&_nc_oc=AdrEYKKsS7nY9gx9DJRzaNJujY841pO0hghzj317qnDdpgYLXN8hAwwfnQj3qM0-rVo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIS6JNLOWCZsHX9urFRHOP7byoEjWaQorLXU8M0MfJlg&oe=6AC52680"}, {"file_name": "Adobe Express - file (9).png", "id": "1196795425183587", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473400716_1196795428516920_5607330333558775563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgbhHp1rtz0Q7kNvwE6qrJ9&_nc_oc=AdrZkxoNh9VXfXQMdnY9rOpZlxebZad-fCjFl0KfOAnTEc8ozvTBuCopnJB2KySMCv8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeFiHd_5M9nzW34IQgsgkd06m9dKXd3pMVPC791n4idA&oe=6AC510C2"}, {"file_name": "Adobe Express - file (10).png", "id": "985459937030820", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392165_985459940364153_7150982175278585375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsGEjSkZ0D8Q7kNvwErgxcF&_nc_oc=Adpcd9R1fAzRcl9GIcfDEaieNbJhZf8GqrNOjOjEaU-GId-RWMcbhUgUnsPYKj4aOb8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr7G-IhTGETEoOaf47IdgqzMjj8lIxAzZ9V8I-HwBISg&oe=6AC50E3E"}, {"file_name": "Adobe Express - file (11).png", "id": "1702322827040953", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473394189_1702322830374286_3625385346484653544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAgNCUF0A50Q7kNvwEdARo7&_nc_oc=AdrhjdWY-Yfn8XuYqUvvj5tdxgXqRsmwxYV4uFBnImSRqIKSslC5TqqYBdflbi83Q0w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcuYXIjaduuWs3pdvpXWHpRQL_dFfZI5qXf8Us_yZ1aw&oe=6AC512D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hello World", "keywords": ["HandTracking", "ManufacturingSimulation", "IndustrialVR", "Training", "InteractiveDemo"], "long_description": "Hello World is a free VR experience designed to showcase the power of hand tracking and immersive interaction in industrial environments.\n\nStep into a manufacturing simulation where you can explore and interact with real-world machinery \u2014 all without controllers. From operating a scissor lift and forklift to inspecting a toolbox, robotic arm, and concrete pump, each interaction is designed to highlight the precision and intuitiveness of VR hand tracking.\n\nBegin your journey in a guided tutorial zone with helpful videos and a tablet that walks you through each interaction. Once you're ready, teleport to a fully equipped warehouse and explore freely. Whether you're new to VR or evaluating use cases for your business, \"Hello World\" offers a hands-on glimpse into the potential of immersive technology.\n\nPerfect for industrial clients, enterprise partners, and anyone curious about the future of training and simulation \u2014 this is more than a demo; it's an experience.", "short_description": "Step into a VR manufacturing space and experience the power of hand tracking! 'Hello World' is a free interactive demo featuring machines like forklifts, scissor lifts, and robotic arms. Learn, interact, and explore \u2014 no controllers are needed."}]}, "developer_name": "Render ARVR Pvt Ltd", "developer_privacy_policy_url": "https://renderarvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Shail Shah", "support_website_url": "https://renderarvr.com/contact-us/", "website_url": "https://renderarvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
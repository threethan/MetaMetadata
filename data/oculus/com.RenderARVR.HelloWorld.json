3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVIrORUuvFJPXy_NBO78BfCw1q8apSc87Cik_a0t2uYQ&oe=6B0055DF"}, {"file_name": "Adobe Express - file (8).png", "id": "2264146517316048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830617_2264146520649381_5240307306057443979_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjYRfJT-wVoQ7kNvwE0D3PW&_nc_oc=Adpx0Wo_ayd0bzaOInNy8GFNAFO5ef8_4SBmmnSYC0GRlxvJoGHDRmYm7vCc6cxkM4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH6qro46E3vo4kAfltD9QZM6bv6_WdJ_da-IJKp8O0Fg&oe=6B007A00"}, {"file_name": "Adobe Express - file (9).png", "id": "1196795425183587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1196795428516920_5607330333558775563_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIVYhS82WucQ7kNvwHFUINv&_nc_oc=AdoZwTlra9acrGwcKCLeITmFnsQrLQqcrOWaeu2f6VZMxYSXovKHkoHRnlhna9hmYhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSZKDT-MGOKA8c1fYTGhWNxrRkh6NEEeCD1qPAQSEJEQ&oe=6B006442"}, {"file_name": "Adobe Express - file (10).png", "id": "985459937030820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392165_985459940364153_7150982175278585375_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoMA4A2sRQYQ7kNvwGUEiaU&_nc_oc=AdoBcPrC30fHl4GZtHB8WUSjIs3ukeI6SeBFkcMaBiSLHkvxxNuXvanM9haKnRiljwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-0_sQT8Fvz3AAo_XO2uYU08IVmh0nGqBJFbCAQ4sfUQ&oe=6B0061BE"}, {"file_name": "Adobe Express - file (11).png", "id": "1702322827040953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394189_1702322830374286_3625385346484653544_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xpKCLgAduIQ7kNvwH65oYO&_nc_oc=AdoQCJfrhXnzW1V9TAqouYfz7KiOPSv7Xl6snNKxRfm_aRxIAz1BBWbEmdhoH0YtZSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq2WI1-ewiDvkt_nzq2sEHx1gLDEeylpPynJz9YguR2w&oe=6B006652"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hello World", "keywords": ["HandTracking", "ManufacturingSimulation", "IndustrialVR", "Training", "InteractiveDemo"], "long_description": "Hello World is a free VR experience designed to showcase the power of hand tracking and immersive interaction in industrial environments.\n\nStep into a manufacturing simulation where you can explore and interact with real-world machinery \u2014 all without controllers. From operating a scissor lift and forklift to inspecting a toolbox, robotic arm, and concrete pump, each interaction is designed to highlight the precision and intuitiveness of VR hand tracking.\n\nBegin your journey in a guided tutorial zone with helpful videos and a tablet that walks you through each interaction. Once you're ready, teleport to a fully equipped warehouse and explore freely. Whether you're new to VR or evaluating use cases for your business, \"Hello World\" offers a hands-on glimpse into the potential of immersive technology.\n\nPerfect for industrial clients, enterprise partners, and anyone curious about the future of training and simulation \u2014 this is more than a demo; it's an experience.", "short_description": "Step into a VR manufacturing space and experience the power of hand tracking! 'Hello World' is a free interactive demo featuring machines like forklifts, scissor lifts, and robotic arms. Learn, interact, and explore \u2014 no controllers are needed."}]}, "developer_name": "Render ARVR Pvt Ltd", "developer_privacy_policy_url": "https://renderarvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Shail Shah", "support_website_url": "https://renderarvr.com/contact-us/", "website_url": "https://renderarvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "10431
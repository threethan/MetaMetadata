-CdJfewCYQ7kNvwE0yWaM&_nc_oc=Ado4ISZSNsJG7GlXRXsnDfUlEOP-g7lx5NvaH24dkS0Tr-IFAqnWD_qYdM8rIWRERKQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE8iYBy63CJVvRmOp-eEPtTf2tRwg9oQDBHabYrQpKQQ&oe=6A6F3A72"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO6mfws5UuIQ7kNvwETmB_m&_nc_oc=Adqy0cQJ_2oiaMKo6Kz_J8DkVyL6kx_hisCW_inY2qoLpt_k8wGu9ncZYwypBTOy84Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB90Ahf3XPbUPIuMrMN1oKibQd6QYab4agOrbA-JHYTGw&oe=6A6F5768"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeUcMBs4sdcQ7kNvwGV2VpZ&_nc_oc=Adq2fqJhBUj0liMw2o1h0_n5ErSpGIoZwjLNPEEO4QRP8Qcwi59-ifydETLRrBVWYc0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx-Sq0_70BMfqXoCk-Y53IFzcUhA9-C3XKzmcqJ72eRg&oe=6A6F575D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CJ2BRA3vp0Q7kNvwET2q_N&_nc_oc=AdqT7kSvRElGCoOCqS5s53E_LpTAMNGSpomFaTvs17PG1nJcEsycFMfEtDHsY4YP42w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlDbsvn6D796Crzw46WZxvuuYuHdrU_t_ArXCtmKBSQg&oe=6A6F37D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjNYy90t-3kQ7kNvwHWvHSB&_nc_oc=Ador24hmd1LRZ2z1QVWWQYcxaj9esQ4DY_gF4eZgDsORZc7zIMFQ-jiuM1z3WbtS4H0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIxrfiJLbD6YWVj_3cMrqT7lulHUheyMZ-wPNn3eOHzg&oe=6A6F5FFA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
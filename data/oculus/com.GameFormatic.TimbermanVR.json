d_71nfPC0Q7kNvwHrRaTq&_nc_oc=AdqxzeeMKHtcORtwo8ykmqqXnuHwORhv-wVs3ZTwO-r542CJ-erLma9jwbxrA5sw7Qg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMZ7KskWuisvC-P2W-cTTOazI1PBtuuS1OTBj58RYXRg&oe=6ABBB172"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tdjw_O9HTzcQ7kNvwHq9mGb&_nc_oc=AdqyRFMg6BBUqyYNtNRxrKc5K6a0PRKtgGG37jba6RcLSdsLg8bM4yfecGy0e-5r8mA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICDdSQO839K_1PuDMV-AlMR6gzNoyl8W_FXvr0Bj8XBQ&oe=6ABBCE68"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhcXN8LE-wcQ7kNvwGkcwpA&_nc_oc=Adrj-TMVdwtoo_Dk883vbLkthFpQX5upM3WQpJ1i3YbctIEVjfvx63t_aNFlb0l0Umk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTM64GeoHYqoWv4wiPAewMYo-Een4bC6NI63-bm8iNMA&oe=6ABBCE5D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xrP9oeILpgQ7kNvwF8IBA7&_nc_oc=AdqunT2wDW-YKIhpPsx76akvqSYLm3ef_G3AuNNVlvVQLopmgc28ijRr2vWU58QgTk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKy-xyn9YYeJAIlElQnNwh6oWQZBkcjdXGIO2CtnZXkQ&oe=6ABBAED1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWTwSblLvYkQ7kNvwFLp-O7&_nc_oc=AdoRa6LFAVoOA7DdkVgoJWYtX8Sg0yBrJd3-ibYdsBVxGYiHF9vsbMl_-UBUTpakJCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1MRMuQ2N91xnemtg1PvvD_EEsB8i-BoN0gyullEGf2A&oe=6ABBD6FA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
LHAQkTJW8TVINRpFqIIR3yXLDt3RnhULfoLEryOWEmuY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1AD-bgqeJvLbzoublcsA3DjkjO02WRPpa4rhoSLtwGLg&oe=69F1FBF2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dClAC1xd6cQ7kNvwG_xLfm&_nc_oc=AdqclJQ6f1g1mOpmzWH7zSG5YbC9yjGzrqjSnHQEErCrJhZGm8Spus6-q7s1aehsul4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nJFWge5m7xNNweHCMOzAhuLRlwE6UxtMMoI-5cU5JNw&oe=69F218E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK0Vp5SlZLYQ7kNvwGzDEJx&_nc_oc=AdrkcN3teikJapw5bknpiM32oU_AutbFIr-0ouyJUAvCIGxhBUjVliWZhSk_AIF0VIM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2mmnOzO3Q_YsPRFFYvYI47bFylW3vwhPoThIWe0F-tsw&oe=69F218DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu5EY2IuilcQ7kNvwHGpjNg&_nc_oc=AdrrOcIQmXNmuC4-ZVwrvTAsFfh1n5Tdkkg68zW32VlcKwI1aA8H1qjdP-PFGVHg0lQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2lOao5OO63m4GXsjARLtqtDupwwMb2QcxbJWBOdUv4GQ&oe=69F1F951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzGjVVovY40Q7kNvwEAP6EL&_nc_oc=AdoxeFkOk-5aFmsg_mwEzu2PMIgFhedEf95Y1ghPFo8DGIZNXzNBTayHd0UOvJjP-AY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-tw26V26CHRR7S9alm5eozEfUnHoPQZDVU_pw6g1A7g&oe=69F1E93A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.c
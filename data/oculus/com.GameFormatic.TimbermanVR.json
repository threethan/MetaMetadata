_qnxX7gCYQ7kNvwHNfsmP&_nc_oc=AdrFOAEChC1BF7wPmKjP-mgJjyl2K7Sqy4VeJHu351HEv1nk30VECRYqn4UGM4u7rlA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vDfk3rOBmqCReGIzuxR4zbsn5ANj0wk8qe89m5n8tdw&oe=6A1ADA72"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K4JChjZJXoQ7kNvwH_GPJy&_nc_oc=Adpx0wXw1YGAwEUdXV1Wpv80ddT8S1SFLoLrL5lRE7h-vROSgxb7Du1xKUn0lszk2yA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77TyQb4N9esZatF8cF0I8YIGhngZpDdRl7XsrEn60lSA&oe=6A1AF768"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIt8tjgMcbUQ7kNvwHlPOVg&_nc_oc=AdotjKuvp-8GqPy_2_2ZrYt49VA37Zai8ZLzbZZBd7sr_1EhkRPsuVAzL2WAHD3jIn4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R6_K4ybVm3dhcta4nQmtQ6GADp4Xlpptb6-0g-62yFw&oe=6A1AF75D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JxeBkfImNgQ7kNvwEvyvmc&_nc_oc=AdrPM7eng7VrKTnCYj0glU_qNGGcNzeH6VlfSVyDnDaE2YkSb7KLAKwXCbzfXYe9bsc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cVnG491jJKnK6TwgluDBaqLz_Mah42brzwL6ealae3w&oe=6A1AD7D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuGM6leMCAUQ7kNvwGFdE2o&_nc_oc=AdpnLoQKzRh7qtDGKpWERHghXkPhCOtK_N681y0bX4-uG7uXsgh7dBVqJbUL3Z5wyyc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Te5o5fisKSFDNSQrj2KHV2ktHaBetRAhWCMq8St4E0w&oe=6A1AFFFA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
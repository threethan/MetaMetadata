lS4QJkVBUQ7kNvwH_HcIV&_nc_oc=AdphLaIjkAr3F91xVtF6Ox-O2SAPvFpSj_PzZZo5UqbgI0QDmraoNpWplVWeHH_X5NE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP51OkjpFlOJC9Vcg_RsW7VD_e2jgCKBEA2Q7-pHjygHg&oe=6ACE5EB2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9FZZFN-9fYQ7kNvwEtxffv&_nc_oc=Adq_BbHok47P1_JotCZEVZiOIda4mF4uFm8xLRPlQg_Y329Xro9gqt_JoWScUB1G5nU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7Yos2uZd1oY-tz-A7hLdHcTYSUQwNiEjVNm0bIL9yMg&oe=6ACE4368"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKnvzeFUwSQQ7kNvwHYjon4&_nc_oc=AdoaqJP7_Ja3w5kxR2tSE8fFhFFKB0Rtpg_Gs4zA7fb0KRNLdJo2IDdtHi8TJTumCgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvAL6URClSBN9wr1kCHjD9SSjEiofdisUkNpd5v9qYYg&oe=6ACE435D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFY5qetXU0gQ7kNvwH6bdOz&_nc_oc=AdqBG1o4cohJR1_O3iwbT3AdwxAbIgAuyvHBdw1py34579r1YoykDSyKxPt4cHxzZRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNazvr7TycR9X0Dz-TBBSFjlLo_7jnNhhJGVonOg39J7A&oe=6ACE5C11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks5yf4QfzHgQ7kNvwGljMvP&_nc_oc=Adp9KeaWpTj0sA-s_Kdu-5jLPyyG_RlimAU-am6F5NAkukMZp95VoU3pekLSJo1-pKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqNs8O-qoI7YWmAjYiB6lYQYhE9cmVFt60yMaILBYZ4Q&oe=6ACE4BFA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
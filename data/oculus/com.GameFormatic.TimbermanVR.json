&_nc_ohc=Sf9ZVYb8Zg0Q7kNvwGjyjt-&_nc_oc=AdqTFcPkwxKmg5BZpbGDfZJ4MSR_3flW1AI0huz_QWXP_WsmevQUKpga-vlwfz-Jm6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBo2i9w8ZNvJx958zQLm2n3YJKi_1LJlNIh-uFqQXCwA&oe=6AFDB968"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_m7PX7DltsQ7kNvwF8S8Og&_nc_oc=Ado69mduV_jfbCr-KmfUaw_87SMaaDS3L-5kLTMt4JENlOf6jRyXAhMl-aJ85tojNps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoVVW9u_qBAv6K3GD_dnqAXBIzt_8AtqpDid8ed8-DvA&oe=6AFDACBA"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fULYUMckOpYQ7kNvwEmovcD&_nc_oc=Adozwoum-5WWy0PyTn-LvXqjTxmUzsNdMo3xv6cojjQ_rwwdHu6yQ7yjTeOBdE4GhgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl79x11XJRRL43k_l5MvgonwjlJ11S9bKxdomCjilw1w&oe=6AFDD425"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7N9SHZszwkQ7kNvwFYZhNd&_nc_oc=AdoAMTzwqOaqxdeo3bv1DCJFuwbXeNTI71irSgEUYwGpta7PQuMnAjOYcZ57Fl9C0eo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_JuC5Z5fPuZtpdWZQSd2nShcILWF9nCbyszdhjO-dvQ&oe=6AFDD25C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGRhyqcO-ykQ7kNvwEdcDCp&_nc_oc=AdqsfvLgoGrntipa1ZLjfkJbmabI3sq5U30-jFUfUeunHmho5-QH2KHc1s9P_qSAEw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-SRfK7ckUxySIgchbXIhuOVymgVG4B5E6myE9klsWkg&oe=6AFDE07C"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
Q8hpNwvfgQ7kNvwG07Qq4&_nc_oc=Adq95tToxY2ZKSv3NW7RLayP9UFK4eTa-DVhlqhgiHthlGpaVslvvswz-D-9R6i9fa0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uFO7u6nDgIn28TbrC-t9Zueunur7uAgZ-QZrwqEog5Q&oe=6A09B6F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLW_P-fpDDAQ7kNvwEABZ1T&_nc_oc=AdoecbDU3JeIltF4B_-qxPgnHIX25jgzNk3iI2l_3UZszC3SC7Xdp70CottRhpfkE28&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S5I9JyHBMbhC8bM2iY0Jr0Sxpt74ATCISVRfw5_zZzw&oe=6A09D3E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xb9ayEtg06YQ7kNvwH3YTGk&_nc_oc=AdrZxuaDLxZKbrbdWssntyiN8SUCvML9ehzrOjZxehY46n8EuMYH-cEvS0NZnCyZ4Dk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n4MsTfqfZmFhIjGdbvOZn94IwNsM3mguMf6KENHCDiQ&oe=6A09D3DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RziqncD3Ml4Q7kNvwEuLUqv&_nc_oc=AdqaHeOftpVYKQFtWSMQPvKMoleLgzRX2EDIILzXd6ciyakmNEnVRbIfJiygiV6kiAI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PNcSnLuRwm5DWZkZANuSl2PDiS7E13l_t82YSDlkGhQ&oe=6A09B451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An5gtYeFP3wQ7kNvwFAJPpI&_nc_oc=AdqN4yAB2QtEHoYwwztQvBoceVrVP_6dsPEBL0L6etSi6VmqxwDuaIP5euLUnZdIuaE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sA1LxHNEXWhDMtJe2pD_xANmWPBGLz7nsr-xZFcxxew&oe=6A09DC7A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
pxrq3UrrxWg2HPZuERAihxZ7sVDh9dfgtvMOtbFjUDkPwmjbtx896ozxitbll_Ws&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzkODmHfqVL8uVw6R0cSwjPx_o72Kt157cDbWmEaLwRxA&oe=69BA9CF2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pap_x12JxEYQ7kNvwFHrmFM&_nc_oc=AdmNvjY7CPDzZ56IQkFNti7qrkeTVwKkiY11S_mfySh86dvGs8syMsvUJwi4rf7xH9Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQm0azQ0I0OQg_THHflkY699hAKxHJOVeCW6nBwMaAtw&oe=69BA81A8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRYbOHYaKH8Q7kNvwE_pc41&_nc_oc=AdkCeqBQodHNzDQNFFhEhW64PX2U93GhPwsGetH5HzcjpUuwPOqoJBjX23dD8hux1A4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2_4tFhP1Z9oEvim5BjQKGB29AmICm6Mjmd7DYBB_LCA&oe=69BA819D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cbfxweLsrgQ7kNvwGoQXX7&_nc_oc=AdlK7Tbcpt6ACjRQsvYMLF-nUlz1rdU3f9oDxQhwHHvuYL6kB1PJk63vZDl0f7Zu_dw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9Cr8Skmng3t1hDszCV1UMWv1J6U6GRpvEKvjLKw60Fg&oe=69BA9A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLrGcQ2tcCYQ7kNvwFoDZSs&_nc_oc=Adn35c1lGq9vdrBItMMxI1lfEaIBMC1znoWZQ3JKzt9pu5EaOWt7e73qGYeZkYfd5hM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPM7KhrkNaAWNqfa3ZLyj6GEMeGzMFP4ZRnLDTYzMAYQ&oe=69BA8A3A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "review_messages": []}]}, "cover_square_image": {"uri
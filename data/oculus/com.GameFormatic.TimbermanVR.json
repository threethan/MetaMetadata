fDTGTwxsGzFoyy754GIV3M1Dl9cP9FO9Z6n1Nn0fcy9y9A0Ru2QbIGrg0XDMfflI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfueRVvPCAyb0JwYGMaQL3EshvmvsuLBjzoCrZbCcMH21w&oe=69A827F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsrdqTYBSt8Q7kNvwEqbM1i&_nc_oc=AdnOllP2_2_dGoOW78qMr05Jx9BhVe_xH2HSTaV9fUSNuePVWszCpSvimWJy5vgY0jc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuUnw9KPSl-cCIqbiq3vtd0r1xLWAgA65c3va4kBZ_eSQ&oe=69A80CA8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_6Jbn8O2_UQ7kNvwFmMSnr&_nc_oc=Adlt0N71stCa13URcugeKE9oVVDIZlHasRcG4jsHJQHRrsHo39YwWq_umq2C7sVbDyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsA2B-T9r47rXZZQTMqGaDs33VjBrwjGgVPOTPH1V8QQg&oe=69A80C9D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFa3n--JydkQ7kNvwG_fVMn&_nc_oc=AdlZ0cNS9u-AVlnDvBrE1h0vc30l-NMwBu4xcQNUQjbrsKjms1L4go0dB7aoFOlphro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvWMOYogNazu3E8DO0zGUTrmX0ZAaCyftYemopOpTTLGQ&oe=69A82551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_BcpNorAMoQ7kNvwHgUXNc&_nc_oc=AdkCZtoE9VCu9WL_Y0RmZwNwMxNHCpLy_SOW6lRMnccKpHr9mB6zFL03R5epSNrngtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftsTnmV0RcrV4SUA2MBpmOZV0i4jd8-fw-Ti3RH6Q4sEA&oe=69A8153A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "review_messages": []}]}, "cover_square_image": {"uri
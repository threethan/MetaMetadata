d_71nfPC0Q7kNvwFa6rDh&_nc_oc=AdrzMMW-_6aSnCu6o0zVhV1qMdG1or8nyObE884H-uTZi8ejgavD1a-ifjQBDEq0S0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMJczXIFXAHVVuAmBiomjsAsGPr-flLCaNdPmAOsVn8g&oe=6ABD02F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tdjw_O9HTzcQ7kNvwFbSRcm&_nc_oc=AdoIroSWYLnPkd90mWSeJZlrLDpaOieL4_vuT52XNG_afxXA0csxLUBb5U8089Cjhw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTHUbyuAVhQ35UIUtAq4ErF98979e1QlJ43KfsBnMLpg&oe=6ABD1FE8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhcXN8LE-wcQ7kNvwF29pt7&_nc_oc=AdpeuG7J80MaSDm2JteVPp5cZKk4lwUSa9G1ad0WiACF1EHI-2-KU30RtEGVLAKJpM0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYihwjmRJAI4ibjCGzOvDbcJDLze1bFYX8IlfVgu3OOw&oe=6ABD1FDD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xrP9oeILpgQ7kNvwF8Su64&_nc_oc=AdrV6Q9qzBDMWiAJXsJInWN03tlUI0sl_tu6DkKicD8MwwFXfosExYeTr6BqWuw82jQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDxTm1ItpC7Y1TIkuXRKHRP3SpHPnMFO7XA_jndoprqw&oe=6ABD0051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkgJLY-q9_cQ7kNvwFnJ8ag&_nc_oc=AdqVzfQh9nVA1g8IkCsXrNbLgNsu1Vs_IupdPDJrPX3Lgw_rWlllEW_yNGKHhcs4c6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIOywwd7wJpWQ1Dv_pbkULPppInF7dyLvb6hsdWn-HZA&oe=6ABD287A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
ou0XL0flgQ7kNvwG3n9t3&_nc_oc=AdqNuff5gSB34JAH3pTT1NG_y777u1A4m7YZ9kUomBpKeHwvHkDCL1Lnc4QMEoMe9c0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIAn6QTL4rt8gn5m8WjKRDLsoRUcb9hGHhBGQ0H1CwQg&oe=6A58D0F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3SNXSAl0zIQ7kNvwFJojO6&_nc_oc=AdrTSVfQcBRD4T-TzhI6b959maY2Vsr02SM10SmG7VyMNO_kOb2DynjQvm4ulac7uX8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLMoIkvuyNOVPS0eP9490ef--Lj77pIMpLurYJQM3TDQ&oe=6A58EDE8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmOhj2O9ax4Q7kNvwGeB81p&_nc_oc=Ado_u9NGz-fb5CRAY6flr-BoDm18BZissPxUI4qu7VkJaLzfyNov-pZUxaxPOMr2BEo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKK_XOddtW8t3MQDvCl6U2u3AzZfE65EsQFcc3koKneA&oe=6A58EDDD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbE6DZ2S8ogQ7kNvwGVj3l0&_nc_oc=AdrIPXRMCKQBeaoI5XeL4-52iR_LiWOph5SYhetiDNORyi1q2cSPzEHZMxh2vMFM1As&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgrTbMLVwW5XN9-EIgukjtkhCdcl8vRw_DaBMJAFYtMA&oe=6A58CE51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gmSkD_1PTcQ7kNvwHhzPX4&_nc_oc=AdryG77gjHHRM3Zm5yDdQ8F4h6oiebdFF9FhGvxVH5h0GvoXlg1KrwZY7KeAac2zbEk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwlu0bDHKuwqqWfvx1pV2Gfe4HDOYmGD1tdRFEjWuMdA&oe=6A58F67A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
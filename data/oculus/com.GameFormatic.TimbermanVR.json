gkGdaJg0EQ7kNvwENRrNC&_nc_oc=Adrc6Ss4D6Y4avEBhBKpkWzaXdyFZA9E2wQdaJljGJd8PVqTge9wMfh4qJOjp855FPo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBr2zNRpLhuONDFDEFjBFu8S6SApj_JiSrP4Gu_YUEmA&oe=6AD3A4B2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO02SPmcSWsQ7kNvwFXN6dQ&_nc_oc=AdpTXME9Qt6VrI4Zqs4iP1wnbN445fA3lNDg-Ujy_PEHwCnC0N2xWcyTSyReAiMh0A8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI9_dZOG3R2O6w_b_53ahNXwWK368oMg_W80ZXPAvp4g&oe=6AD38968"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OELxKXfPrKUQ7kNvwFZENdG&_nc_oc=Adr5hiM-Fde4QFqEWl1PO7xiJK_C6RjGv46NQEPOqQ-HTA-Ek0M7IUFRzbHTzPgQRco&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8O3Tdq0QUfX6HYgUWpnDaIXvn1zioPfd7qg11P0_rrg&oe=6AD3895D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdEj8TFeWF8Q7kNvwFth6zV&_nc_oc=AdqHVEq6LV3RMxHy_mQJZzdaZrjxWjEZWONNcwtTTDxtdIdInrnDJIlciMd7PXXMjrA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4BW62biIX9poQ8NPXE1fzlht7ZX52atgxyoYjLhzT6A&oe=6AD3A211"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_nGM08sVDYQ7kNvwHVu35v&_nc_oc=Adqh_Pggf91zpPBP7_-Pgcx9yJmWNgydWR9_k-MrHivHlOB7NbgbDGkplqqH36YBAaU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHpF4KYZojyk7PxGqfuO0pZfSn-E7iFI6dwMRPZnRw5g&oe=6AD391FA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
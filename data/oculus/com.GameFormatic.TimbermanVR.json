-6yVTmidMQ7kNvwGZ4iwn&_nc_oc=AdpxbT_Ny0vBck5admsCZ8dlMfX6jQr53hwvp3px6nnT-trtg3Xp8KD9eKPYoTjDAec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXXuEKm4vBBHjj3-MKdbc1iUgsmMHJwUnMARJ-95_Y_w&oe=6AE09B72"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVzlxt-DQM0Q7kNvwElq26S&_nc_oc=Adq6AKIQMF5tXaATXXPjHR5lNFEdy3iu1RAHBG3FxaJzL8hU74kaLYchkNrajuqXFeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyKezNKxOmRuTB3LVoBJzVvy449tZ6RBKx8kWCMQAYMQ&oe=6AE0B868"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnY3t02ufhAQ7kNvwFSVX4S&_nc_oc=AdqpFWNXE2F6d_K79HrjjG1_1y_0NQhMpq6nBfYpcJAbRJVFXDssgOcABUdpb6JRLts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6FQo2gV10PLE37iLNYtQNyWGM9x6uW4GNekcBY38xwQ&oe=6AE0B85D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zwf4k7rqlYQ7kNvwFn_5nl&_nc_oc=AdqgJ8FQZ_8LNSqBsfzmEsJ5l216_UFxPJ92u9b4iGfWnBE3d6MQIi_rnxiVDfKKT_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo3re4vw86J3KT_MayhZxCTqg8AuYt6aipakaBGVPqdA&oe=6AE098D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJOfOs8zuUQQ7kNvwFuAeLu&_nc_oc=AdonNzTUXe_XkJdNl7vFFqgI-3wkNMITnGWtx5P7tbJA8u1Gjmj3CMbXh9eX0BMPZXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsDfw3-UA_pHMMYSFayF6yR4-7Cb28m-JgkRB2Xh3CjA&oe=6AE0C0FA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
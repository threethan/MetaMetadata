&_nc_ohc=ZglCiK7UIccQ7kNvwF1jBdz&_nc_oc=AdrRCd5NokOYg2WYvg32BqXFliLkV3Q2zEZrNiYtjTMqtiRO_xG9Q9hCMIYKsKHzLxM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhs7VsnVlTVWdcA1Nbnax-1Y7eJ6UfxEKZ7JTtBf2BCQ&oe=6A85A3F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N8jlSEaJTwQ7kNvwGEDWof&_nc_oc=Adqghb8wgUA4mAS4Y81Nw5jR2963UjzPtmxxhkzmBhn3oxiBJFECQvYTB2VexctyxlI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNgQMucVWlOcsH9_DKoFV4uKNUiGp0nAsCt8GCgMgLtA&oe=6A8588A8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2d4WjSPvFYQ7kNvwHO01nf&_nc_oc=AdoHZAVErSLO7nBZERAmkKSa7_96h8ZVQzvHePWcht0aaseB4zTIao7xVsmgNnMBAJM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHwr0IGDhswmf7-w-9PJhMToaDYbl9NFZh_WpqQNruYw&oe=6A85889D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq5m7HWEUGsQ7kNvwEj6nk7&_nc_oc=Adqxxuh8sx4j7D2JnMYgOVLeehJlwQfvQwiiR_GQ7UnmD0Z72YOB8dpk1R_HeVgAyic&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh1w54vbcKPG9FtEpPCUlyzR1_sGjjQPd40UlgcWJTKQ&oe=6A85A151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhQ2ItlCdvsQ7kNvwE_jrN_&_nc_oc=Ado_Wu2mJXoUPXyuDStriBHmWWDEg5faEtic2B9Wy-1jdTalurGKz_zLA3OHeBRTH3M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfSDY-PT3eRmKskkjxrOpmNCnEYEow-FsEguN-Q8holA&oe=6A85913A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9829
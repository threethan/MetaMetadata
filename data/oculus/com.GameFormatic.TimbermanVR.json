BTzqoipU4Q7kNvwFW1aZN&_nc_oc=Adoq_f9SCA5Gd1PHmNJDvX_SIPFMBNsYdDHqSoNGBOVFMKGBmZ7DIuOMkorddSTnkn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrrIoKhq6yStGStZV3kYV2o4bA3UMvM8oBV370tyCboA&oe=6A9C0D72"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjsKveT7ypwQ7kNvwGwzn86&_nc_oc=Adp3q8T0W0IoWcLKhaKZGxiRor5GaATa44cjTnJ92vii0uTXO97jyESBekAXSntUKE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdz2Rp5P6qWvmAbycn3WI_2CvgbdFryX4ilkvq7O_jnA&oe=6A9C2A68"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kUwzBKDiIwQ7kNvwGDNbTo&_nc_oc=AdoeqKKtzFuasY8eaUGy5YDb_J1dqTsqXhAoWruXwi-7Z5LCQCsLdosqz7Ers7GVc2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGzUkskfXUopgTsF8WjGhIQkr1uPoP690MPTEc6gYijA&oe=6A9C2A5D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5V9V2trvrsQ7kNvwGjFPt4&_nc_oc=AdpFooMQpj9uzEoNbiJjmEDf18kq0TVJ3OYCeEvdfO3eyiub9fsCF-4ZAbNcwNpkLR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJREcRoONSIWFdOk5q5Kk5w5VHAeb09NOO3D15QKpl-zw&oe=6A9C4311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaxHgMdNhNgQ7kNvwGTTH1w&_nc_oc=AdqJ-o4Aik2e0r10n5OWolNOL83poAlPGzs0uPCD2oSGiNvZpP08uO1rvr9pcbuJmF8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj6GVUziwIs8kajx4VjPC7Z_P2CY_b4IvWOKfZZyW9DQ&oe=6A9C32FA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
5-GmO0EfEQ7kNvwFXLne1&_nc_oc=AdrCYZc526SBO1xxbQQ8QNLSumkYIAJThF59I8g3qYf54GiBNBF6_gShfWuHlkLHwnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_WtqukNobpskFNAUQHtA6vSjRmvoUSP0ImMtqy9yCwQ&oe=6A635CF2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azCvYMgBK38Q7kNvwHgk7bG&_nc_oc=AdqPmkSxgc0XoQy-ZfwhXNEOWPDei7v3pwbjfAD47r_hG95EuIRc4cfKO_OHO9ZVXPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHvbtJzrKaMpNF2bvRKl_we0XtNXx5sAwaHd9JrYlgAQ&oe=6A6379E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA7YX1k3z3kQ7kNvwEiAia0&_nc_oc=AdoX2UFaGKCjlSAc5Z5ce-iYUAL16PhTILQ9l2Wen9MHan_aTuj6eAplYHofhBk90aA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg7IltIV0PhKfmL1I-qCHAfLMnK_u-8kH-AAkDgTXC0Q&oe=6A6379DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTsZuoeQJtIQ7kNvwFtKUeC&_nc_oc=AdqhmT5NsrQ-YLXZ6nGy7Y7iln9k_Aw2MILSHLnJLFuAoBYIBb6ZnuhQTFEepzF7c9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0fA9X-qUwY7N2ikzN36B8Qprf3NN6xpAzfm4dI9qvXA&oe=6A635A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QKcKRyCV6MQ7kNvwFkX3lv&_nc_oc=Adr9fbY8ZVE7UV6eA9bw7YRoB6puEeuV3PX5y4Ayf-X7Hubuu3uY7mtAQY7yK8bmw-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA216GWmGrwsU36X86szoCHqBYoTbu0JsMYD9cUBf9O-w&oe=6A63827A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
&_nc_ohc=7AH61-0gliQQ7kNvwHwjABG&_nc_oc=AdoPMkqn5Pm4wcEe1G3qY4LDQjx60LczJ9kJK_Yt8dSJWIzIxshsBu1eh5DAtKQJ6_0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQowdSfnn6T-BLOID_kQ2FA1XCPx2VK0TSevXc4-1nNVw&oe=6AFC67E8"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_m7PX7DltsQ7kNvwFGwFYH&_nc_oc=Adoa2ZQwSQnk5yOwkgjdmPUg9cF7XyZAms7Alv66KtJr6vH9mvD7DFduBn82ehkxSnE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtxqq0OkB6d0jX4JgCUJltupVkC6smNAh8BlXhDjXVOg&oe=6AFC937A"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fULYUMckOpYQ7kNvwHlfZdu&_nc_oc=AdrFrtclQxr4WQpUaG5939X0JY4_buC14HlCkYP75Pu9XgT281K_CFlVUxEm5FqH258&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx4sYOYtH37NkYWA32KDbppZtV9FDq9K_7zWFv4seAHw&oe=6AFC82A5"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7N9SHZszwkQ7kNvwGYbF60&_nc_oc=Adpp30D9Idu5jVkVq9AhVXQLo4duevbgBsERXUIw80R_4ToClNry2AqlMHDYpIT6F70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMxkuFXHoMRo_GlyZUFY-_QtFH5JK4MMlV1GpHYqlwKQ&oe=6AFC80DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZTaxAIskTwQ7kNvwFfO1jv&_nc_oc=AdphVGiVW2sTsckZwVq4Y3X-Hi_PLqcgioNIcQ3F6Wk6DCOSXUHDaTmF-WusZvdEY-A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWQ-F_5hCH6ONxQGciQJTWGBvj_jlwOp6hFkk3PvO55Q&oe=6AFC8EFC"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
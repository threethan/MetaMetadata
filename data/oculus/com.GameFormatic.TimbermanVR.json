&_nc_ohc=GXQfgdKOXhIQ7kNvwEXHgjv&_nc_oc=AdoEIRK2WM5eUrjbNs4bADjM1QoEV7YLiQ2kWIifXv7nfzPUcqkVVdWQmmma6JAQKlw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTknKMhmBnzSKIN5He2oq0ShNyp2GpwBTRn04ztqkJdIw&oe=6B084568"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L47Y0i9TuKMQ7kNvwEW9y8G&_nc_oc=AdpOvQA6_ZpQrljq8MaDSNGC7BQnrZhldbFL39tjokh3jeiSkoiuJ4nEtxFyMIgZASQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrZQLdXK1xezZGLhi-oZy_9hiuKgawl-UCif7pOC4X-A&oe=6B0870FA"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiC-ij4wWm8Q7kNvwFWDax4&_nc_oc=Adq9nRM5dXzac5i4z2Unhm5yCbKFVICFFSOS2y65ZOqFxruCt8Jci7h82lWthS5SrdI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR60h3DSRLaf0-2luJ8hFytddjEGmCv2-CYsEAs-Ac1dQ&oe=6B086025"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52CTWODhfRIQ7kNvwH7O1bW&_nc_oc=Adr4q-SkJxdhb3NttFJpGeAfxo3F1V0f0sU9Oyo_tNMMzJK7csaqFnfRYiSkX9QBCfc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSgHWvHbO_rkFtrSEFGJ4l819OOIiSunBc6eDToVDopA&oe=6B085E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfmdBleiZZIQ7kNvwEqa-yT&_nc_oc=AdqZ7-Znf3Zaum0BQLM3tdmKBF4BlqJUDd2VHCtkhjdbyaodr_8My5nhTbAZxchN0as&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWrdZg6WjQcE6ZVOlSSfZ_U-4Q4DEOcOKqllMvdcJaAg&oe=6B086C7C"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
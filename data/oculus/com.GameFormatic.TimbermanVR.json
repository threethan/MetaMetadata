UGGyfNGBQQ7kNvwHahC7w&_nc_oc=AdqdKoEmHGJ0Vd2JGSOFYh6vXJdIGPDgxIt2HVJHLemGJ6xsHuAJKv6Qig4denFHmRE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm-2R4_0NFchvdNFLHWQ_dMkRS7hw4iufLDh2JNpueyA&oe=6AF348B2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpNEFfNB2hcQ7kNvwERUsiD&_nc_oc=AdpAqR3iwigQd_VJpy3NHpoxc2lqWiAHsdlgXm6-qqVi_jyMNcX7dJjKlHa7fVWH75g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzJASI9SJOK77tjpRE0RDTs9vOnlzoVIdNJng1_4rScQ&oe=6AF32D68"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dxsmh3i0DEIQ7kNvwEy1fVe&_nc_oc=AdpZSj8JHIE8tfB-Oas5ZcL3Tl-Frcu3X1GI4wr7Q8Di2BduVwCidBmAqKWi6lAx3dY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlZ-UAx4h2rWRA0euKGjXvAsXptqLG51OKX1buzJWPEg&oe=6AF32D5D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6VrmXT1JpgQ7kNvwHyrCLj&_nc_oc=Adpdzj_dochJSCe0msekpyvQVlTq0iICYJLa3QLOj_7I5ecLPZzrd6kjmmTczhkGozo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz-OHyb-6F0PlO_gBap3fm57T0lh5UnRw1HpkLxnrTHQ&oe=6AF34611"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ReRGdBquBwQ7kNvwFXb2Vs&_nc_oc=AdoDWgMpxt5ixklGqM8QhN76nkQTDwD5Q67IzH3gYGVr6y-ThVvOwH5lF1cON9Gl9rI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu9pv7OgevcoT57P382bIMGKuaqIjui3WvbmLkHwvK-Q&oe=6AF335FA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
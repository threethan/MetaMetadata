KjjFiH47dWeEVcigHpR-3GHppVjtxMf026NVboBqVmFQ5x1_uB1vBzzwtQ6XhepM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-u6bwiohK0KgpTzUu01VHOjl42wMMV9BIYzQbfnIjWA&oe=69BBEE72"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pap_x12JxEYQ7kNvwEFU0nL&_nc_oc=Adl1bjhye67sP5pdQfqO7ap_5ArZg0lWQAQMfVVqPdXwuDmUAqSfPtBGWkvleFrVq0w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSwMSIGoVkLHwTMFWN619YqbJ0qES1CYIc1Nltlca4Gw&oe=69BC0B68"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Rdc7vggRUQ7kNvwEI88vc&_nc_oc=Adm8qm0mMSGURN7Z1d_13Qp1_bJMFybt-9q96PqvY7xRItAUBSfFtjvVzxMoj-iXVUA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqJgd_rzCHeP4hb6_AECJ-W_JJtj0bwvfqYchL0gbKgA&oe=69BC0B5D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cbfxweLsrgQ7kNvwE7NtEQ&_nc_oc=Adl2c8acT17Qa_gmhyDDt3G50e_LrAIx9u5P5XttjISRWOC1aHdIiHmM3S40jUX5fek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvipnfpMfya3HZw-LOE-ef53-n-ZA2Od-aKhD8XD_7EA&oe=69BBEBD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC661GWMKe4Q7kNvwErRWV5&_nc_oc=Adm4OZMQ_UxAUwSMmJrZViyNNo4ejcg8sA_WDyL3XYqUSz46aj2d6Dt21lxzcvmL8mg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGkut9VPzN42TQl2dNDG4ay9_nS__pwe9rXm4I36gOHA&oe=69BBDBBA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "review_messages": []}]}, "cover_square_image": {"uri
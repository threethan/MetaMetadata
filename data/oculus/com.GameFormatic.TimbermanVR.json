&_nc_ohc=7AH61-0gliQQ7kNvwFbO1aZ&_nc_oc=AdraXzIaAb8w6vfQWj2Ox4pq7OZx8MWkkQu7Vohd4hdh2npbcd3RN42i3DXAWGuGj8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPYR4-30iqMVJfZBy51_ePqzg40kcYq66V-jsqfcVGeg&oe=6AFB1668"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqhLvOLBm1cQ7kNvwHGZZqT&_nc_oc=AdoodnSYNxRTkNL4K-z3jDPRYh_HjJtOIw6j_x5aFEOj8yk4x3nWrqnNo3kkH15VrOo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2RS6dm5oRJKO6fbU54iL8E6dVtT3fBefgA41yZpZ_aw&oe=6AFB41FA"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fULYUMckOpYQ7kNvwEsCnEW&_nc_oc=Adr_2yrJ4xP1ADArFnnCvF-1eljFufIywkWj13x1K8CQvecWE_e2Re9DWkvBowaiZ-4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSig_3IkaeZ2JEUx9Euec737OCcGX2cXgQaYz9OCitaxg&oe=6AFB3125"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7N9SHZszwkQ7kNvwGyWihT&_nc_oc=AdpkYP77QJx9sfH8vYaICEOrIInBDv84d3VcTMRuztQJtxVVSWknC_FHMnDqvrQspVI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7r7mp_KrQiyGwG14ESixk8WUElxp-OfC3M5AOzzcybA&oe=6AFB2F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZTaxAIskTwQ7kNvwEJ23AI&_nc_oc=Adqy76Sh840INeRhPPJ1-2M6x-LywFAbEJBRCkcjbUttWwUHvC--VdW9RnJCLTPiDe0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDyC4nEy38HqF9f7LhQKiD47sBMR1ftEjsw8UEc774Fw&oe=6AFB3D7C"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
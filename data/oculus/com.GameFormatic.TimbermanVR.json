yETTMD0gRuo-nguzv1wAbJkey11CysJQ4Qx5YjI-fhnMNX75jdDnu7oCN-3Bq3tI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy11eNtoA_-jfApPz9G1uxXgWaPFnpMkXT2kgd0oEhl4w&oe=69B556F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9I7cMMvDYYQ7kNvwGmUigl&_nc_oc=AdkbFsFxpkQjgHT7tv9YgI4dXVk5jAz1RpKAiWez_6olbM35ClAG2vc2clxsN9Or5tQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz24ZSvTCweFO1ryfPrFjIl-PuBOygMhFyXIZHd8RzhEA&oe=69B53BA8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaBM2MnJKQcQ7kNvwHTr2hi&_nc_oc=AdkyercEvT4O7SgoR3ghjrx--g8TLvXzLx-AutEAf3W0ZYkoFIqQZRGcJEdYfuq3zc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHfKG2_zEXlE5AWZ2NX4DiD7KrvSecbfGeSK5yjltceA&oe=69B53B9D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOBMuJnTL4sQ7kNvwF5QoTs&_nc_oc=AdnEYvzGhpfhsQoTMHPcnuuAHcGm68kyOvdqvd8Ba0Z0QlGUV2FUBMesSfmFBapL9b8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3WJOWzPeFUru4tXEqN2i3jDoztqwbOVvVvc7PNlTcsA&oe=69B55451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HXfyW5RgpkQ7kNvwEbctN3&_nc_oc=AdmRv2bu-5ONkbc_TYcJ-mtUX8Xq9a02oR-Cip2qs0vYEjhGCsKCKAxHfxNu4MD_SDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZfQrBIe_p1jf1xHoGe-hNz9NZA8HoPCc6XDG-sVH_TQ&oe=69B5443A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "review_messages": []}]}, "cover_square_image": {"uri
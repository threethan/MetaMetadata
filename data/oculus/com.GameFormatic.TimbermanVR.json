gGtGH6Y3wQ7kNvwGP4oTm&_nc_oc=AdqFCv9FyR60e1Lq3nTQTfoyU9SzO7M4ywQB_jeWhedXL-vphndniMYhq1a4Gr3EQ-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS4nVs1itHmgjL8toSs-pXNvt725UpBNu1xU8cdnG9BA&oe=6AC3D2B2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDo0zRMaZp8Q7kNvwFbvL2y&_nc_oc=Ado902MQNGlEB7ReHOK4PsxlSigw0K1WzVgoCjPMPAa4AbM6MXJouN63X1rVcsSOjiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKPWBBfn2h0ISZFHu7zZieZXxkwDJYmj2OM_jWAOLqRA&oe=6AC3B768"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIw1jpxs0B8Q7kNvwFfqoKg&_nc_oc=AdriF_UDq7dkjq5hVVWhG5gjvfltwUsfeSTREemdxecpgx9OXRUC9rC8esJEBvs0WHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFanJqGe5EUDrxZdGftIkoJW17bE0gI2BjXkn7221KYg&oe=6AC3B75D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50Q4DtREeP8Q7kNvwGBgc7i&_nc_oc=AdoK-DjuliqvLa9JUzAxAN7bMGw9FzzfzNHSnbwNc40NYl_GTv6igEm41yEPsWXs2g0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5VvT932SbCDgkE28Aeu1zsp-z20HlRgmVeCN-IY2VRA&oe=6AC3D011"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjm78FagTacQ7kNvwGnwNJ8&_nc_oc=AdoFhuH3Dcy5fVUbryzq8ey-Uashnq39_fQlyr2L6nZgVrTEvE_9uTxILuGEMwryPEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2xj_GcOTH7Gb0VZal3-YNeIrU-BNTHJOZ0qHkwLjsMA&oe=6AC3BFFA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
EXOif2WsQQ7kNvwHqTFll&_nc_oc=AdrbocRC3ACqUTJvbo7ncaEBXBVxrZGHegmk70lGgqsJuk2Di7ThvZtB-g3QvEz4Z1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2MlGZc999JA5Uri5gz6OnH7sdXwAEa7XRXiP_fuLj5Q&oe=6A68A2F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEwK-zdp9zYQ7kNvwGK8jQi&_nc_oc=AdqLht-UZ266vnDsERMySor2pVseyjo-Z6rC0zzBHhJHvi4LGrZdKqqi1d3vkqKfd34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2W31Ao6j1cpJT6cd-c0hp7C1f64UdR7PPCjciDDrENQ&oe=6A68BFE8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQPTgRFWY4wQ7kNvwFK8--b&_nc_oc=AdrN3nKRIn6gnb64QOI6HRffmq6Mjy80gbGWQdtTEAIEjRSMaGv0SRyCVs1DMslF8Ic&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZabIS4XzkLmWLCdoFcf0lDGLlMuLUhme-a-VT4hvSZw&oe=6A68BFDD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTlTaKFLC1QQ7kNvwHUsUs1&_nc_oc=AdoBT5WZt74dTCuv31-wZPVX6ndda5GsLd3liKftpDYwJ4Gij48PJ9virb0i55O6jik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCez3r1IWsjHDo8j48eutEnL64a2BB7GjZ1HTIeIbGfbQ&oe=6A68A051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlhISry8TcIQ7kNvwEZl8X5&_nc_oc=AdolYFpkBZdHh-LcJxRb1vfUGhTAUpmotAllEIHBxt6BkifGDtbr3Kyq0ogfP78RjBI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4RA7sZWcuNvgZQMLj19xDdeBSixyu7iPkMM4NuDJjtQ&oe=6A68903A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
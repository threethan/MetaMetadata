&_nc_ohc=GwyKcujmo3oQ7kNvwH_Lpcn&_nc_oc=Adp-QgvXigqIz1I_IzqsB5dOM7FJBwOSXZRaaDSvSYrDQRT5eHt3qNL3Me0StltFaAo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmZ4asfjpvBI6rpyEFr8V_sk9aH1uLvRQPPB8LR5q_Qg&oe=6A8EDE72"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOabJX70n0kQ7kNvwEfbAk4&_nc_oc=Ado3Wl_5U7PwlF8D0zj9O4hRxj8Hwh9gaKvC2pApXDTQ_jp6NRNE_ih0uOxgqDF3iBc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9MMorlQCTRs_YvpXtmnCw52FlowSV7UkHgbJNn-07mA&oe=6A8EC328"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxQ8U5icn9YQ7kNvwEZyMkH&_nc_oc=Adrmz_qQiOGpvGevfPYyTEvyKh4DuwpcsnBm4quOyhDoMAOUG5Exr9nOQ5o5ilZSgJs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOgzu2FVuptacXNau-86guU2co6hl1u0u51zmcJJCO1A&oe=6A8EC31D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-gyf-nrrVYQ7kNvwGaSmqZ&_nc_oc=AdrMiVix155d3rkTcW65WZwuZX6XKDU4F4RsWzC8PqZHJdKvwBBzryJmQcQ-dPKlwng&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGobu1x71z_TnLdoLV99dddCw5qZze6_slD26i_HRpNw&oe=6A8EDBD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rH1LbrOEMUQ7kNvwE_RJOx&_nc_oc=AdrVFMs8aMRKATE1HOB4Ov7nbvEGA9jt0ThJQPMwSo_XCxWoXTJrBNuTCAuZvVs6x0w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJpRJNdiXpjlmT4BO37UE5_Fm2m2xbSfpbbJlKuhb-Fw&oe=6A8ECBBA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9829
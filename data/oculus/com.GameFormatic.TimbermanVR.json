_qnxX7gCYQ7kNvwFOXT9P&_nc_oc=AdpdhutoFRoa-vCDe1TtTThlsVSuIjL_O3aX3VYXXI8Z34Nb2_soBiaL6zkRuA7XaM8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h8h8VlXSY2VWByVDoCzzdzWzCbWRjv43NYhqvUFdmaA&oe=6A1C2BF2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7xlIwOmOSAQ7kNvwEhBtIz&_nc_oc=Adr19vmy3SSmcf7pRVpJgk1REV3bUM0Fc388H5WOl1PXYOWcKxO7lNL6A8gXwd9W-UE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wi0pR52Sqkcqdqy8ja918ABReOdL-HgBW72GMc886VA&oe=6A1C48E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIt8tjgMcbUQ7kNvwGe_rpL&_nc_oc=AdosSP3cKhb6zJNcNgBNu7C_aAp_kVw1Far2TmtQJfBaob-qauOpk5_gAPeOGKGQnQo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t1SD45dxCNNYdd6WCK1oYze7HErKELUOr28Fp2pq7cA&oe=6A1C48DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JxeBkfImNgQ7kNvwH00DY6&_nc_oc=AdotVIRlI8wN7YbQT_s7DmaeJZ67iaXGTsq4j8BdAvfyduyshAbu5kTyzAGOPtGx3uI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af628SUjACjoGcg8PlMPSG7gMk34zgJ5Ry40pZXYXYEEDg&oe=6A1C6191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuGM6leMCAUQ7kNvwH3I2Ki&_nc_oc=AdpDXzmeMXeWLZHlaeuXxK_3uHVB0gXBywi_leJy4-oLK6jlo75qFc4aAG8_AQFq4sA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yv8EetqNKtetvDsdi6C6uAPH-qtH_6wY6lnMTic4uCA&oe=6A1C517A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
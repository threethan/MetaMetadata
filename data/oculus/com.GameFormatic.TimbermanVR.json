&_nc_ohc=GwyKcujmo3oQ7kNvwHRUmQs&_nc_oc=AdpliAPLvVF0q8N9_FSZs8F5Ytk8O3eziLwdXR6xMtuSpABB5oheVD_0vivB9-1DMHo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHSh7jox3OmZ8kkRQn5g5qPrYJidZ8LhGO_cLrH5PJXA&oe=6A8D8CF2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4LzMgxgOREQ7kNvwGHzXLc&_nc_oc=AdrBXh98a72gN_VMqN1s6UkPNlqtKyGggkJLk8SDWCjPzM0zRB49UWRjDAXl21aIiws&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDOxVCAg8WvEvzS9AQ4atQ1_24eMPNsD1nKxY9eELGGA&oe=6A8D71A8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxQ8U5icn9YQ7kNvwGoif57&_nc_oc=AdoTlu7FaBBkCXuJ4EOqQaDRluEfe6lUw-IKXGtyoh2uP9rKLKlYVOPiv_ICjK6_1l4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm4DIuI2x6X466T5WzHYhcXrs_RSuHtVu7yx7DXG64Rg&oe=6A8D719D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-gyf-nrrVYQ7kNvwHuO1m5&_nc_oc=AdpGO6zDrgdXRKLiO4N6p8aaRF4JnMxSgGugr0MsziSiQ1UEvojEv9liwCFJ21jAJ9s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoZwToLPT_R40PO85i9Xu7nW5ALdvSALbUKe113W36Pw&oe=6A8D8A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rH1LbrOEMUQ7kNvwFPMioJ&_nc_oc=Adp7kFXNGMJjo7bHfl7-hT21v1k_2KSplHqcL3oKGVDOKsZ-qXNKFATEN06AG7GpCtM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB9-Ty-2fc4pp7FQ5sjED8S3J-vibnyMbncPAX6h0kiA&oe=6A8D7A3A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9829
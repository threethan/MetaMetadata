Ai3fXIQhUQ7kNvwFliufd&_nc_oc=AdojXrrEZUS0jfQTIruW5f7Ipggi4SCfk3pRTSWEt1jm4cx5icm8IDMPjH1NBFmRrrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB_oO7vBZs1COvArK2rAWyDOl3di7xT7gXFXCbD9KqeA&oe=6A7C6972"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WDDQyBHYXoQ7kNvwFNYCGJ&_nc_oc=AdprO00a8vpMSi81riLOaGVCe8-RkQfd0eWxstPf0ZEBvAO0UHX3bBAJnZ-_3T6aS90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrgOagOiZJBX98T6LULB_csnFR_Utv0zqVcFlEFCH_wg&oe=6A7C4E28"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYJe9KqOFwoQ7kNvwHLiUZY&_nc_oc=AdqdJO5qjHFUQdA-V9DmDlSMNmazj2d3CvVdxVFhKQiTBVj7hjEa6va9YnHs3fDcvvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1sKR1yeqUuvZjj9maIcxp2eBYAAI91n4xvNGTJ6hbZg&oe=6A7C4E1D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsTgctJU4l4Q7kNvwFBVhLI&_nc_oc=AdrymRiq8RJWENQlX9ABUuIpB01TGAK-GXr6VxXMZGtj0QbgZzbayqWfZqZRWUWFBRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNB1n7FTdOOXXfEa7LzZk_41GVoU4uPQkafaCd4IPDPA&oe=6A7C66D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXji-3q4S4cQ7kNvwFVUS82&_nc_oc=AdrRFhYkucDPuRpyVdXE4IeOBEzMWc2iLmuTxG1qS4EDaTUXJ59SPKaCEpaq7XWVCNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ_rVWaoII6xseqYpJqj4KElu2Gxh0XmISyQyisUf1rQ&oe=6A7C56BA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
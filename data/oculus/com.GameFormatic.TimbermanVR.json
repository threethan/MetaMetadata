5-GmO0EfEQ7kNvwGSMgzB&_nc_oc=Adpt5uKSxGI9wpsmT53ipK4IVZ3AdqArNhKgTZUqv4aarddTymF8UmyTuQ00hiivWP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGKnozoJW7Tn2hvda6wNde-ptqQgeeeInQ_BbOkChuuw&oe=6A620B72"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAwtxqZR86EQ7kNvwF9ijYa&_nc_oc=AdpGwiMVyvVf5ZGgzBfYaKfa-lmnhGF2bxh_eXSvTgIxXAyanBBYBRP_0Tp9JVv5Tgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgN9rVPjVfwwEa-qHkXCTZqWbkm1j090yLLVSiXmBryg&oe=6A622868"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA7YX1k3z3kQ7kNvwHG3bid&_nc_oc=Adqi2xmHJjhAi7uXF_S4zninaQJWjtAwJb326PE5YkZ84GoouAavly6uLM_gKWG5NtY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaGw-lmcYo65EE1MCu2C5c0NUY4f0IwOXHH_7k-WFa9Q&oe=6A62285D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTsZuoeQJtIQ7kNvwHW0szX&_nc_oc=AdoCnrmikkkfCcIrF2tdoSDZJjU3EXIE9o6mbGzGzhpSHjwyn4G9gL-7xo0egB1OxMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0dLvurKC1URgzCXmaDMNpPgxXXl1Z2KFdoFyFvvlunw&oe=6A6208D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QKcKRyCV6MQ7kNvwHE2lgB&_nc_oc=AdrZi0Hws5LOLHQfMzwTXhwfwbF0BLs7fZ_TOCaxQnvnEIdmjbwl2PcbnDrXZlX-0S8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuELbPKZV2Jsz3UyNYjRTSwkXVZqUeUNON1CPSIlRvUQ&oe=6A6230FA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
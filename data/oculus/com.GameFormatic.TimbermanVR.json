c=4B1uwa6-5yUQ7kNvwGiEM2a&_nc_oc=AdrH6JSLw6j-PKClLWECHB3eBMQt26Tfp2TdHqrqNWDjAMxtIdhjYsiqvdBeQTlFeaw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJitLTikwh8zIWUbq1olk3fJ7MSsZxjSeGNb4QG0dxdjw&oe=6AA93C72"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtyEkvEsArMQ7kNvwH-nk4a&_nc_oc=AdoQdchzKp3qRIzEjimwv5poGgwoO9JxwYvo2piP5ImbJFz3HsKLgcJzHq0D83PqEtE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXs10zbfNNYCg5ZCiI5ZL2CNitBaBeuIf0LJ16XM-osg&oe=6AA95968"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD33QLDE5_EQ7kNvwE_Rq-N&_nc_oc=Adr2TllpazpfMgF4JK5ddi4c5b81TGWaFPPu486Dcunb7BM-Ony18L2evlkG3XS9j34&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGHYhLUKlyQo111pTYaZ2NcG9_ozYqP-ZMzS8URm7mfQ&oe=6AA9595D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv3mb3FhTLMQ7kNvwE6Fr1u&_nc_oc=AdpEq4-XYJH1xUS5n1ZOAPDDxZR-CHQ2cLHBQWo1wvT8ISQnHki8qrKpdJY8bfK5C38&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEYMW5By-RPU_naQWhz_E9eNDEB84N42Q8qCNA3nXgWA&oe=6AA939D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFeSXVMPes8Q7kNvwEsEUzQ&_nc_oc=AdrMrKyXa8Oys_gttdYVFKdHxKmHqPjSu0HjzDt4bU08o-xkNMvQ6hxvAkpHD9J9N5c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR4mVqeOaUqoLHJRkGMba7V6uIi1He-3iUEAcr3CNPcA&oe=6AA961FA"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "98290022603751
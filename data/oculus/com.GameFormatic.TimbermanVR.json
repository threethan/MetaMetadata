-6yVTmidMQ7kNvwFFd9UB&_nc_oc=Adqm4IDg5-YNZGjgnlrnHlM2NJ2DZPMjs76RjQ08eeJqex87Je153sMq07n0js8NP7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAmst2bmvrO4vFIBXD3W5dx0cY6VDP8vTXLUuJr38fsg&oe=6ADF49F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVzlxt-DQM0Q7kNvwF-YVd7&_nc_oc=AdrBbhFv7E6QaK-WfniamSStwqu5P0FPtzoNPEAeJ_6KkdzHcbv4rg-SyEi__G_gYjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPddpEg-kFaHCCfSgLxKK-CMZJKrsv8j7wkQDPboUWmuw&oe=6ADF66E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnY3t02ufhAQ7kNvwFxSIT_&_nc_oc=AdqejzWMbeROxdPdrSVEjLj05tr5LJh-3oJ2uAwuWsmo8wVQc_jLdDlvAb5VCIGs8Yw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEx59Q80zDrXEyxUl2Uyq_gYjvbo3biCyBwk5ecHtqAw&oe=6ADF66DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zwf4k7rqlYQ7kNvwGHo2Ee&_nc_oc=AdqplGvgr8L3bxuulI_vPeFeefW0t7n5B5ZZlcXYdqzi3xkYLDDQcoS-IPeFhy7Qx44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpCSxprPgXePPxVVQxIjJQ_QI2IYEd6Jjrwguydik3uw&oe=6ADF4751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7b5Q3QafGMQ7kNvwGQbQC9&_nc_oc=AdowBXEEPRrc8yQ9bG2bAZSnrdPSFGJpvTsIEz0eQBCpkm1lgZ7l76TzOd0v3dyo4H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9Mq76tb4tlj-qjJioC_aAcVKM8KUWm2uMhS5l-JSaOw&oe=6ADF6F7A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
&_nc_ohc=p0cme8rzZTQQ7kNvwHFDM0V&_nc_oc=AdqGSOFfTPE_i0dwqnaVE9sI5ZZRLPm872sgSpOssmhGV4uaPfuK-Hm_KtC1zj8_4ig&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQakMa7AuXt7QpihH59MrgtjC_T9hJFV8vxh-2wfsmhsA&oe=6B0B20A8"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L47Y0i9TuKMQ7kNvwGp24D4&_nc_oc=AdrBGSupKI22o0KwiK_OH2sYc76uB9FoRLCFed9rTpUBr07PKv--SCFSF4RBoW3NdYM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvCx2m2ttA4otEmO4qPlxLd8DDaLTPie5JxiDt8M89rQ&oe=6B0B13FA"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFafrIHYiLEQ7kNvwGVR1gO&_nc_oc=Adp9WJW9qdqxw33fTbOmCHhDx3XmlYov1krvh1S1_IThDFlgl5YVtBgta1PVN7VCuGw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqBHaeMVzh6-yJLwtbT1vi_r1sl_APaWB3uAOnMike6w&oe=6B0B3B65"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50WRyg23_B0Q7kNvwHf_4Pe&_nc_oc=AdqVLGQOb9za2hcy2V5sxmyRPvTxE5uITAYqpfQ3nxgIYdNEWRqH0inuHO5CV2ZWDcY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIkAnUIHQTZ9jlDqapFT3EhyAYdxWqO3giUv3VYG0naw&oe=6B0B399C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77c1es3rQtkQ7kNvwHXnqml&_nc_oc=AdqjEegA3OB1Sbt_kRtFsS8jBJ9Si53R_czNIvdVpQ__cY7tYs9o73ULydPZCppTx7U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxwBTx0FuM06Q0LJFi7bFHgRfOnMs13jqQz-gvJzjxlg&oe=6B0B0F7C"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
-6yVTmidMQ7kNvwGHgbaP&_nc_oc=AdpQYyyMAA5dyzfBfOm-oDfzdFm8D-j9EUpMp41S45ebcin3tas6ASl7F3Gg8v4m-5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPexUmqjP2A_PugOebr5U8c59Rp_KQHjpYDm1MOMLA2PQ&oe=6AE1ECF2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8I56n3IQJYQ7kNvwEjFMU2&_nc_oc=Adrk_0El8ouh46WWx39enQuhwWx_KYyC6DCU0hG2YoobQOo1IlIPIRiFHETD706dHxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxx93bn_aVZ4ExrRam08SpKUH2MPq_dlU1Tsiyi3BPpg&oe=6AE209E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnY3t02ufhAQ7kNvwHKi3BA&_nc_oc=AdoTAw5jRU_okVNDALGErF_ft2LOjoEkWSEB-WieebcV2Jx-L5XJD5IehKcGGFFy-Os&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxiwps9HhtfYcEDxTNplVqUJtNt7lmLFZ69FS4-2yoZw&oe=6AE209DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zwf4k7rqlYQ7kNvwEz7Z0F&_nc_oc=AdrLcMsDDr6g-BNv4sxECgXa6VdDiK3dEA2IFbaT7hJ0AQ2IkRk6g34uSWu06lYVmDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIzaBlmAr0Zb8U-nIExzGeokPNA0XO5eSjpw1VEcgQcw&oe=6AE1EA51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJOfOs8zuUQQ7kNvwGdaied&_nc_oc=AdoP0I9SDSMtNXgjzq3wG_ItxC2Jg0O7JJ9kK2TuFEHsDOU9V5QukX5DGsKPBn5cbJQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7aOHNDTfnHqQC-XStJq9frs4Pcqyu-sBS7-ocwrWx5g&oe=6AE2127A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
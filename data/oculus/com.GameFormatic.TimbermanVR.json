&_nc_ohc=oo5KIhaR_fQQ7kNvwEizymP&_nc_oc=AdqxC2OCfNkS4W_NNnsDfTEKBgfXJWO63JLAPxyncN0LdHyfXXsleLeekiXukv-w3D8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKiBsf7BIGRcJ4dOWANZqfAa9KBQLk41X9KNFPUPJeXQ&oe=6B01E628"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGYoW89Yj8IQ7kNvwHa_M_g&_nc_oc=Adr4XEWeIwX6eWyYa9RCK_nrdjd_G5s_DwK6m4jbOkUY6RlO6OGCfcAPQPmg1L0hglw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR59gk6i-BysY6AUrrdzagXBQ6sBaMCCpcXfX2Hu2dCrQ&oe=6B01D97A"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipYR5-rPM64Q7kNvwHvAohC&_nc_oc=AdpwH2iK-LM7lrmX2mDEJN-WAJl2g8M8K_pp-ittBskTO97EkOAusOHTDyMgQWOYdFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ2W1Qz4KT8JVh3PXPP1wGJRS8P_B8fPSLLHuypSx6aA&oe=6B01C8A5"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNvMKB4jdjAQ7kNvwHBYBEj&_nc_oc=Ado55soH9q9aOjh4fQNKt0pWHnzXFw23ZgGWnDbBuNErezaqQQ27YhqhJ2NNf6NClaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0LsrcDp8qna9zm9UJQqdhb2Jj_hOX7bpq6TBsboj-wA&oe=6B01C6DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY2Jg4Le49EQ7kNvwFFeWP7&_nc_oc=AdoffDWn34th-Ao4DwW3vvrCaeBwCfYflXDXJjhlupdAgPiLqGqDw3iBqmBByUDeUT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2O-MbWJPQJvf5iXq4gglXBCvFMADc4-TUEWeEaOUblg&oe=6B01D4FC"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
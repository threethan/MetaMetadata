erUboWH85XnwUmyLhgDg_037RD7agQujclykKSbQOFA9K5edjb3AkJTOONsNpZyo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqsw1svTursTuWakH-J9X7Ks5FMHqf71-pE-0cSt5cdQ&oe=69BD3FF2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-lbpDogsRsQ7kNvwHHHb7R&_nc_oc=Adljy1u24cquoqTXhyCk8wARFRx3Ijy34eX4FyIAg9wmq-FReqMPPbemFN_2ITR1jAg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyzGZ-szX_zILZOwAyXkLleKpwRC6UmdeVbsTtmR9wH-g&oe=69BD5CE8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Rdc7vggRUQ7kNvwFYkHCp&_nc_oc=AdloPjjCzXrjX80Xh2-QkjRZccceEtjVmCRTZlFwMlfH3168npl7z_z0bY__NgXUDlM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwks5Op1gEumJvOa2NZbrMSoVMUbr-HSPaTFcgTnDjZDg&oe=69BD5CDD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cbfxweLsrgQ7kNvwHssc65&_nc_oc=AdkRtsBcKm9TOqMlE21N26VrQrIGVjdUo02qujNt-8Wnw3pmrWAPLXQGne1OSDtR2eY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXePvqQio32Mpevs-TeYQO36apPWY-gwWT6aQ7fpU3YA&oe=69BD3D51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC661GWMKe4Q7kNvwFT2NPS&_nc_oc=AdkIGLTR3ueh4Azy-6fZcxqGzCuRoRjlgzvFG_ZQwiviv4zccohzvibQCvMsV3mxj3A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBrDupBQ8AQY1O4WCPJm-i1bt_SrqvFz3UvZGvwBurFA&oe=69BD2D3A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "review_messages": []}]}, "cover_square_image": {"uri
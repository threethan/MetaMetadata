ixOHu8pOwQ7kNvwHE7H0p&_nc_oc=AdovvKP00oBYyyJq-M52oWA4PQXC6m777BUcxnKzo5eR5jygKIWlzYuSWo_4FjwByM0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgYtnPrA0vn1O3GALJ-5vOxG5GQKrRvZ7ETNavQ4WKpw&oe=6A92D2F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP9gP0gKqfAQ7kNvwGiUKmg&_nc_oc=AdqqZT-8FqBp8WmQE4oQax_FacNP3eUkRYJGAWswUDD33cNEpmRf8B6rMKJj6ljqcLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA5wFHoDgnosdYGrMHzw0tCXzxhxAhNOchW0A9osdnNA&oe=6A92B7A8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncNN9vEKvpsQ7kNvwEd1Q_0&_nc_oc=Adq3xaKD7CgR9rn533IqkR-6-0bYDfGUQIvTwVmFhctVVLI62Cncu1rBCvyolChIEBI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcaFuxZcPgKmBEoihKcDVbNG_i7jGNzgDDIVKLTUr_GA&oe=6A92B79D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-azdRxCwaC4Q7kNvwGsGl1u&_nc_oc=Adq_TvCntJ-v83wyGtgBiZ1CaUAOUbYL6uzhem2pFBiew6dzMTQMotgrxa_lR8HIBG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFITTFuL0qbfiVxEnCiiiGTDYF48mG47Rv-gu6qJVzHLQ&oe=6A92D051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2dVZ-Mb_m8Q7kNvwEiAQEK&_nc_oc=AdrZ843GzB6ebcKGoQB_2KI66RcVaRXnUw5utZmYUWdnAaZrEnLg7ZBFcQUGg4FPVwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv2I_4UVr_sPw5qdHYQqoBPdde3sN-CPujHUVqBRGxjg&oe=6A92C03A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
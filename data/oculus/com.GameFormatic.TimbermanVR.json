1uwa6-5yUQ7kNvwEvyLzz&_nc_oc=AdppWTbFHO1bhMuD1-6t9S5NujsMjjPC4apexHU9PhLSmscKP-bc0TIXkuMLiEiI8mQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgXA42ZntZhwnm-kGB73-jybUAsQbAsN83ol4naCNsaw&oe=6AA7EAF2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtyEkvEsArMQ7kNvwGsuDNO&_nc_oc=AdpAAnTiLLrTxurTr_oQO_AS6COzCwmEfgnnyqbACEo2IHgqXFVp988OaiVLRHeJj1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcP-WWHb8c8Zq0-GaXH-g-p12s4twyTXMkeRlUX_IEzQ&oe=6AA807E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD33QLDE5_EQ7kNvwHTwJet&_nc_oc=AdpcTc_uvfL9aZynwsWrWS73y3dK3FxyZxufymMCD4g1VrTsBWO5PQEAam4W_c9Dl-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF6qXtLSisStKxFh1K-O2omaXxtq9X9VQx_Vj650Y7uw&oe=6AA807DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv3mb3FhTLMQ7kNvwGZsp-Y&_nc_oc=AdqP5FbQgaNZ_9C__txYEh15aHwyNe2fZph1s16EhLJkLqWO_mDVC4SXK9WU0a986vs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_wva8OKyOVqvSKQrGZH-uq8NNXhiwDWMxsxRPeVyD6A&oe=6AA7E851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7Hq8JWP89gQ7kNvwHAP8is&_nc_oc=AdozJAJZYdx6bGdhVo1T8AijVNpNoAjJ0NNFDU5IIcMd4OLuhhjTcsOaorJ5dxy0szY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcExPlpl0mkGKENuRRr7UO_PwZbeL0kd4sVaSvoKktMA&oe=6AA8107A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
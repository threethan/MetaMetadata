mmkLHgDe8qmztjFyLtCSq0Ker3s4yuPhe7G21Z2dI1nqhV9SerApw7yXl_EkZBGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7k4IGWJ4eZaeZwKRhKVFCOl3chyr_7EchTx3D8tg66Q&oe=69B010F2"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nKt_9YVfW8Q7kNvwHeM-6C&_nc_oc=Adn1htXCZn3i8cU-MgHsg8igyhLN29IzBtdS8BmfvNtPlmgXZSrHQVapLeusIKBuuQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGpKKhVNhfY3EIW05j4GnliAiXHgcShZF4QJW2dlDN0w&oe=69AFF5A8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvVrKAC8hVQQ7kNvwHO8YF1&_nc_oc=Adn7OPkWCTJARFa9X-RoceT2IeN5iZyfPu5WKSIfMR7AbYWvtJOtdGSFlsye1rC-Cbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxkon4neWRwS7_QbngZ0Vrqm6xH8h6Grb_ezERfLV-Gsg&oe=69AFF59D"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bnQau_8xBIQ7kNvwGD8D_w&_nc_oc=AdmsXIw4CTpjNSW-2hLmQKBaNgGem61sw7loenfFa6IWObv2EagSfdYZRT-YW6c9hz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzISN9CSvjxX_flVsOzFPtNZAmqdMW3PjEFUGu9Y3ySUA&oe=69B00E51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXXzoq-krk0Q7kNvwGn3fpf&_nc_oc=AdnGLI-SJi3NwKnm9kVK_pBWuIpr96HiTmwGI0DJcThCd5R4o_DZuDzhLXF7vie1nRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-Rnj-K52meBqDuPy-W7mqBFn-slKW_yJVFbA5MO4iGg&oe=69AFFE3A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "review_messages": []}]}, "cover_square_image": {"uri
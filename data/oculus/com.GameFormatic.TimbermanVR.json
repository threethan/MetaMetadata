&_nc_ohc=Mpj26B-8BDoQ7kNvwFVuGFD&_nc_oc=AdpSHuKV32NyUCXcddM04RiDEH3J_KhnAmvmgJNjsmb22ORYeQwYDPIFnh8V5JGw0yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUo_mYa2NMEUKovxXbczXNpI-YvOeBTcCkqbLGZq2r2Mg&oe=6B1066A8"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jpZ6DKVyykQ7kNvwEx1EUf&_nc_oc=Adrad_0ULfJEVDMhi6V7tcquLvfOC361Xt2te6w7PyJiVOxoIGEWybaSvyrLYQTnohI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFnDIJ5Sh0yM6pjy7HLotQJiSrjaVCxProdYXVvL5tCQ&oe=6B1059FA"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZQwDu01mfAQ7kNvwEmnbGw&_nc_oc=AdoCDwclD_9pCqe-nyHVei5NKFJh7G9DSmyS9d6DgtzY1TgSwXTSlXUd8TYZlP-IYJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgwskr-OW8CzGqFFgxJlxeONC5EsAk_z2L3CCRk1mu4g&oe=6B104925"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pHf9vYY2dcQ7kNvwFUU2cW&_nc_oc=Adp8bE7X9SaTV53sJ02GNsewW4ai26Ngub7zwUEY_xdukM_Fd52LvaPI7_YOZs0MPeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjsr64mMKNLz97sjt22vohvHq8VL1XGGDl66cc4ulBbw&oe=6B10475C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eps7pNz-KjEQ7kNvwFfUMi_&_nc_oc=AdoZUAfv9o5xNZiYwq39D62rx1tnTwlUz1ljT_Pu9hRTVXnQjsBu8bgT29siVAm6ogg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXRiWPp8yd0A1VX8EJYslNzJAy5qFfxcML0KTp3Oga8iA&oe=6B10557C"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
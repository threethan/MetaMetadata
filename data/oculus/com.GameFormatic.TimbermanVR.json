&_nc_ohc=GXQfgdKOXhIQ7kNvwF01bea&_nc_oc=Adpr-VSZ-PuSX1jVEKM09jex9xWuy7FmpNm6fsv5Bpt2kcQFGQsojJD-MFP5lcX1eOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROwx7yqkQtJQLb5HbiJT3jplk7k6J-vXUPCCrHLsMUQQ&oe=6B05A268"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJ8P_Xw52q8Q7kNvwHnOXtc&_nc_oc=Adosn4VpXSQuQU2dDFnNW7dNuwfB8Tr0s8HLHy-J0SKgTC8EiZZueB2-bNtZ4c5MokU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwD2VtzMpWVLjk9i6-x2SwPwK09lhJaQ-J3BrAqxMSXg&oe=6B05CDFA"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jLS7GePsgcQ7kNvwHXZav4&_nc_oc=Adrzleo7ZQFVnz1TcDWm1xQDcda5_Mk490SoDIX5WY9co_MlVW7V6cDtwCKJVpr2gUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqpmxHoko0kmamG2AntD3fV9GDjjbk51LcDOqLwfmBUg&oe=6B05BD25"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s-lwR76-fgQ7kNvwFknahE&_nc_oc=AdozJuXBr_DVnLfwKJy-wJ2iElE2ATxtynqv2z66BtswDCm5QxtB-bYjsJFSaARD520&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoXaG02z4ggqouQbH980V4gMYSa-yV1LTUm1FhDLwD6Q&oe=6B05BB5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfmdBleiZZIQ7kNvwHrtoWg&_nc_oc=AdqtCtTX5A9HkrocXUkm7JebwpI8OZL1vA-02tG9p8gH60KbUrcKz_eLH0jQi3GflcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmqyKnk-qSlGzL4CQbYA-aRI60blQsD8AS8D1EwRMaUg&oe=6B05C97C"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
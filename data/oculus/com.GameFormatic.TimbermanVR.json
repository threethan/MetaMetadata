bnsieRYj0Q7kNvwEq73Ul&_nc_oc=AdqvSDJ4J7niX2agTSfcXOz0IJb0dmsjn05UYk5FKHutr-slyAUPLZJZPT5ZGP1fAQ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrTz25WE1x74x3j_qZL6RwyApr-sVb1ZmeITlyIodR-A&oe=6ACFB032"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9FZZFN-9fYQ7kNvwFrB5ec&_nc_oc=AdpUeXWdW35MEfLGx_s_KYDfu5dlscgpnY0N_l9P9bue4vtcUd89jZnbuGQ5shjZ76o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_2pi15Fp88fPrA0KwyRx6TVsoxJokGQ1CCoix6i-oIQ&oe=6ACF94E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0LBD0rXYJUQ7kNvwGy8AaZ&_nc_oc=AdrG55YvgKhHp5SrCgHV1qCAqmBSX6hiT-yKaDoeFVR7D05cwh6EFrm1acijyN205is&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxGzZtapilGMSgLPf7u7nU-lfoyMNP9caI6IBGq_7T8Q&oe=6ACF94DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL8ZCYZhm_UQ7kNvwH9vRZx&_nc_oc=AdoWwAsN680AKLQH-8vDxLYxauNnlILDu4uFMuawn5EdJM9VCHA5ejkQFG-azMSw0YY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtLtl7MZcYmk2M06BeR5LaQmhJphr54abKY4_LdjOohg&oe=6ACFAD91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks5yf4QfzHgQ7kNvwF0uVAm&_nc_oc=AdpO0kSc7Wz0ukyy-k5soPqJAJdawHvTlaTrh7kh_Suo-YvWwT_iin12v0rNcnJ-gIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEsxc4aaX_Gl6XY00Av6-HhY808lpULOwdH0BwHtIGdg&oe=6ACF9D7A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
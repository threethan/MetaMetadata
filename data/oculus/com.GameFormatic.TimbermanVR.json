92sJ2u70oQ7kNvwEUVfTg&_nc_oc=AdqA0ESawvMd8JmM4Zun7Y5aMMOpU4RsfAnaZi0sC1s_nCtAxGEKvjKtXI8Kt6-vwPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlAepFZV5S-QCNzIw_19sK_sxnIgkDsclyCYiIHhslZQ&oe=6AEF5432"}, {"file_name": "Timberman-VR-screen9.png", "id": "791930118490552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_791930131823884_4317281742019350634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul4vo6DHsTgQ7kNvwFilo4_&_nc_oc=Adrkz9mj2MNIKsIDMd8pYd75AQ7bbim1VrIm5wMAABmfsv_UF9YWLzAshnQnLX3n_Mo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRevIYEwpT4T6-tzFV0u5qEeg9ViHjMRWyLt1uienzSqw&oe=6AEF38E8"}, {"file_name": "timberman oculus 2.png", "id": "922756862187083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75394635_922756865520416_4395742096745057328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfokkKAoXYMQ7kNvwEdEG9X&_nc_oc=AdriM0ZEplu63Az0tIn4RLphAxg-CI5E9uEVGSqhv2FKV619LVo7FAyGd4sfJrUbFwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZXgwgZNKQmXNt0FhcJoWK9Gd31yuK96NxnIWGQf193g&oe=6AEF38DD"}, {"file_name": "timberman oculus 1.png", "id": "659269792563427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974775_659269799230093_4054628554830474981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H79Ljl1Vj4sQ7kNvwFkiP3K&_nc_oc=AdqmB9Mx6O4SPvDr3KeakbOOhA1qgA1OMbbLY76r8lkI3VgXYXn0kloBgdHt4LnSDGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS54gWSinOijuZg2arTSB7SSI-bYHUKyFztjklRBYIxzg&oe=6AEF5191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman-cover-art-landscape-2560x1440.png", "id": "483864953922650", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_483864957255983_1110412221969612588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-4bfPMJ_PAQ7kNvwFtj3I-&_nc_oc=Adro-jvU-BKluZJBX5MYm_JBW_8t5jkVL5yF5SMsfTa04-cG3UWhy8pbIaZvAjBL92Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8IE9ItHgkGUD8P9gx-pzBpvZIza_m_nwfG7cYDz0KJQ&oe=6AEF417A"}, "display_name": "Timberman VR", "keywords": [], "long_description": "Keep a cool head and your best judgment. Use your axe and chop down some trees while avoiding branches. It sounds simple enough, but that doesn't mean it's an easy task. Set records and unlock new tools - axes, machetes, and hammers, which are not only stylish but also give you some special bonus. Become a true champion!\n\n-easy to learn, hard to master\n-4 maps (autumn, winter, spring, halloween)\n-15 levels campaign\n-shop and use new unique tools\n axes (stone age axe, tomahawk, bat)\n machetes (futuristic, viking, candy)\n hammers (meat hammer, shark, thor)\n-compete with others and beat the record on the global leaderboard\n-achievements\n-tons of fun", "short_description": "A devilishly addictive retro arcade video game that goes into 3D and beyond. TimberMan VR is a simple game whose charm lies in its lack of storyline, while the advantage - is in your skill set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982900226037518"}, "
&_nc_ohc=Mpj26B-8BDoQ7kNvwE6sfve&_nc_oc=AdpxNH5r0tvaBLFHab3wCPpxD-WgOlAn9YJhhKKsTmN4zGw0y6IUGyKS2psOEPW0fx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpsHd3yT_GcEaH3MaaSi1rvoP-QZGSF7q0fohM_i-v6g&oe=6B0DC3A8"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ivpGBQzRZsQ7kNvwGqxxJs&_nc_oc=AdpJ_L8amHGLaZ5-CebKUVXK5PDmyAF-ZuL6kgKu2tX5lgurivTjvBjj3ozb18YMFoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnYyDaJx31Zn9I-L_MoljcYF6LO6gemHlOJBHEQl4HQQ&oe=6B0DB6FA"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFafrIHYiLEQ7kNvwGWHinE&_nc_oc=AdpNKUgxQT8GzfFy5ahj67ebGnlp4a_H0ywnmTdPKEJqFPgDTGxek_mvcWUXkPiY0NI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2cN_Ch8BesySS4GQxJMrhrPleKBO0NZTqhhCloPZ6qg&oe=6B0DA625"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50WRyg23_B0Q7kNvwEuMovC&_nc_oc=AdowjFi6PP4ceTwxAzPOzk_6G8xMz1nhyd_KoOw1Lg6fjsQZ1VhAGvF8t8GKb5dcpDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8ugS4La-tsI_RsmSAFcc2PEnjYEgEEwD6O2SjTZob7w&oe=6B0DA45C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eps7pNz-KjEQ7kNvwHcF02J&_nc_oc=AdqwFixLtiTp2qzUP3oRVXJpgii8efgTM6fFZiGuL5sZUwldbQR8Ngt-_UOzgjCPO1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSo8YqbZMDuyd5Bq2WVubBbqniSEIooT-Lyjk9l-fOsnQ&oe=6B0DB27C"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
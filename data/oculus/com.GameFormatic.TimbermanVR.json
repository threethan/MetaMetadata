&_nc_ohc=Mpj26B-8BDoQ7kNvwETNTB_&_nc_oc=AdohX66li6pAKRqy8QawAFTPdUBK-nTd_A0yUzy8It9zHScYKUPwRifdQtOx1yzpDgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWV3-jkvPAV-nvoXH9GIXYUZVqgS7fRmOqFcEVoUbP7tA&oe=6B0F1528"}, {"file_name": "Timberman-VR-screen4.png", "id": "568847841445523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_568847844778856_1557055665675211780_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ivpGBQzRZsQ7kNvwHJiOZV&_nc_oc=AdqHF2XXBxy7o7XFD8eybTgbs4553eeYXZoeWdhl7ivGmmeqK-Pis7jHCFXI1acW_Mg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyvrX3fHiD2_xzmn9u_8YkBh1zRECsZOZs5RgJZylBZw&oe=6B0F087A"}, {"file_name": "Timberman-VR-screen8.png", "id": "3040081799616454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974448_3040081802949787_8907978113858572011_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZQwDu01mfAQ7kNvwGMv6NY&_nc_oc=Adp4PhSkXIL8XNLfQjE9OEX5Jaz-EL-bIzI2maq_BuCzamR08ANutaEZhmMoYKJ5CkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUuQcUd_Zeql6IRK6M4_e5EOgPkrRprHQyG3gdazjR-fg&oe=6B0EF7A5"}, {"file_name": "Timberman-VR-screen10.png", "id": "1741233212896683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001661_1741233216230016_8192747994358993307_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pHf9vYY2dcQ7kNvwHJHfTq&_nc_oc=Adrb4ByewmleZMLg6_NUEfiGanZKc8G8K2x_86Gp0BHd-fo-rW8PQEMtxDMKQ13Y6yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXviITP0b86Q2GxHKHwWBnimwUHU_eb7kSz4mwPLOMI2A&oe=6B0EF5DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timberman_VR_2560x1440.png", "id": "774477733842113", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_774477737175446_8889361905058736722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eps7pNz-KjEQ7kNvwH3mWF2&_nc_oc=AdqUciluaWZYOfMGYWTlX8BJnbuDg4_QRfycgTgTCQKpbql0I3Ywj4u9fY-20bRmEuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4t8QP5GuiINqWB58Z0uevRA_APR4p0yRpn2XnoSnk-Q&oe=6B0F03FC"}, "display_name": "TimberMan", "keywords": [], "long_description": "Grab your axe and chop down some trees while avoiding the branches. Sounds simple enough, but this doesn\u2019t mean you\u2019re in for an easy task. Show off both your speed and accuracy. Prove your reflexes and steady arm by always cutting tree trunks from the correct side.\nBecome a true master of your trade by setting records and unlocking new tools. Use your hard-earned points to buy new axes that not only make you look stylish against the cloud of shavings and splinters, but also give you some special bonuses.\nKeep a cool head and use your best judgement even in the midst of the busiest logging operation: it\u2019s not just branches that will get in your way. Look out for all the different types of obstacles and wildlife, such as squirrels and wasp nests. Act quickly, be precise, and stay alert!\n", "short_description": "Timberman, the devilishly addictive retro-style arcade video game goes 3D and beyond. It\u2019s now available in VR! Take a deep dive into a game that is easy to learn but not-so-easy to master. Discover whole heaps of fun in a brand new type of reality - a virtual reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameformatic.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GameFormatic", "support_website_url": null, "website_url": "https://gameformatic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
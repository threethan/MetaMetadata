&_nc_ss=7f30f&oh=00_AQRLtLtEWWYkPK7_z1rrTolduts3ZXTXc8iM_iF9_3PQLw&oe=6B0DBCCF"}, {"file_name": "ScreenShot02.png", "id": "2039715176413982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035349_2039715179747315_3666820418221366030_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=homwlOZ7LwcQ7kNvwHzBv6-&_nc_oc=AdpHn1CFT9YegE5C35va-lXbk3Wg29Ds87yCvgM_B8bZv4mt1knTNTCbT_ro7SsiSBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1CcfWqfORFmhER_WCyj_WQvGA_Ce6PUNXWDgsqJefhA&oe=6B0DA54E"}, {"file_name": "ScreenShot04.png", "id": "7419233568110284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974824_7419233571443617_228829691485305948_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTWtSGKVbL8Q7kNvwH_6uTO&_nc_oc=Adoc7-6X8Ql2_3xFVkHDs7wQjZ981DZHzwfX6aBnxoeKMqaVon-8EY7yP99m62DVxRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQSUTvTwcIQAxPAji0hSIQvoUBh4fmv9or0Gj1NTGtRw&oe=6B0D99D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot03.png", "id": "1138883017098340", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003259_1138883020431673_6838173099459925758_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGATc4d4Tk0Q7kNvwHDuw_9&_nc_oc=AdpdFjowvHn6_rt6ITdRZqxCuh-l1sXgDL4DMXUWUtkt9Kl1uCbeFek4k7JwpN7RlNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT00fNkVirPgnciERCOE1g6PUASq__2qvc5Pf7GJFHkJg&oe=6B0DBCA1"}, "display_name": "Bow-Bots", "keywords": [], "long_description": "Bow-Bots is a VR Multiplayer shooter where you take on the role of a powerful bow-wielding robot. \n\nBow bots have a unique item system. By hitting targets scattered across the map, you can acquire powerful arrows. Such as Explosive, Emp, or Sniper Arrow. Aim for the golden bullseye to unlock even stronger Tier 2 arrows, giving you a competitive advantage.\n\nBut beware, your shields are constantly depleting. To stay protected, shoot shield bots scattered throughout the map to recharge your shields. Don't worry shield bots are harmless. ( most of the time). Keep an eye out for golden shield bots, which grant double the shield replenishment.\n\nAmidst the chaos, don't overlook the power-ups that can turn the tide of battle. Unleash the freedom of flight with the jet pack, gain a burst of speed with the speed boost, or reinforce your defenses with the formidable Bow Shield.\n\nTeam up with your friends in epic 3v3 battles or 6-player free for all. \n\nBow-Bots offers fast-paced, action-packed gameplay where skill and strategy are key to victory. ", "short_description": "Bow-Bots is a VR Multiplayer Bow and Arrow Shooter with a unique item system. Shoot targets to gain powerful arrows or recharge your shields. The better your aim the better the reward."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bow-bots.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Siege Industries", "support_website_url": null, "website_url": "https://www.bow-bots.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24646416871668532"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "3826217534356256"}, {"status": "PUBLISHED", "id": "46070515369176
7530091564169556_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gF1EPsJV2sYQ7kNvwE8XzHB&_nc_oc=Adpxw5go7OTiQZD3dRmMADGZ5rDMDa8JBWELmGr9hv2EzFmai6pdxscOl7shUp2U4cI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5sQPtRH3AC9OIqRLpgQaUCzljjr_fo578ZV_d3uAT5w&oe=6B0C770F"}, {"file_name": "screenshot_5.png", "id": "2902487796805134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839762_2902487800138467_8025130841578980135_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fzv47dATI8Q7kNvwGLlnD7&_nc_oc=Adoe_zoyVWyxMyjJaL62uFnFIG9QS8Z4hy9rh_XNWr4IcMn54v_A0lSCWoZI3RH2hQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1H-XxqOMUCtiXik3wd9rW4fo8ai4HLAN7VdUOg9ipAQ&oe=6B0C783E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Glacier Meditation", "keywords": ["meditation", "mindfulness", "relaxation", "nature", "glacier"], "long_description": "Glacier Meditation takes you to six places in Glacier National Park, filmed on location in 360 degrees and shaped into immersive 3D scenes you can sit inside.\n\nChoose how you want to spend your time:\n\nGuided: three guided meditations (Gratitude, Kindness and Light), each in a 3, 6 or 12 minute version, 36 minutes in all. A calm voice leads you while the place sounds around you.\n\nNatural: just the place. Sit by the water and let the sound of the park carry you, for as long as you like.\n\nChimes: a row of polished lake stones appears in front of you. Point at a stone to strike it and let its bowl-like chime ring out. Layer them, let them fade, play.\n\nThe six places:\n- Going to the Sun\n- St Mary Lake\n- Virginia Creek\n- Virginia Falls\n- Avalanche Falls\n- Avalanche Creek\n\nEach scene has its own recorded natural sound in full 360 audio. Separate volume controls let you set the balance between the place and the voice or chimes. Real World shows your room at any time, and you can turn the view with the stick without moving in your seat.\n\nMade for seated use with controllers or hands. No account, no ads, no data collected.\n\nGlacier Meditation is an independent app by Big Sky Interactive and is not affiliated with or endorsed by the National Park Service.", "short_description": "Meditate inside Glacier National Park. Six immersive 3D scenes filmed on location, from still mountain lakes to rushing waterfalls and quiet forest creeks, with guided meditations, natural sound and a set of ringing chime stones."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bigskyinteractive.com/glacier-meditation-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Big Sky Interactive", "support_website_url": null, "website_url": "https://bigskyinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1389010544296120"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1788439289107169"}]}, "baseline_offer": {"id": "1788439289107169"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795417200, "status": "PUBLISHED", "id": "1788439289107169"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1447538561776651", "version": "0.1.138"}, "id": "1930871784541272", "channel_name": 
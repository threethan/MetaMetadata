s": [], "long_description": "\u2694\ufe0fFull Version is released!!\u2694\ufe0f\nhttps://www.oculus.com/experiences/quest/8752849024786000/\n\n\nBattle Talent is a challenging physics-based roguelite sword-fighting game.\n\nTired of fighting boring enemies? Battle Talent has created for you a mega seamless procedural dungeon. The full version with over 80 enemy variants, 100 weapons, 60 perks, and multiple landscapes that change each time.\n\nBattle Talent brings physics driven creatures to life. You'll get to epic boss battles like you've never experienced before.\n\nFeatures\n- \ud83d\udd25Thrill of the hack-and-slash\n- \ud83e\udd81Variety of enemies and bosses\n- \u2694\ufe0fPlenty of weapons and perks\n- \u26f0\ufe0fSeamless huge dungeons\n- \u2620\ufe0fBoss melee fight in VR\n- \ud83d\ude80Sandbox & Parkour & UGC", "short_description": "Battle Talent is a challenging physics-based roguelite sword-fighting game.\n\nTired of fighting boring enemies? Battle Talent has created for you a mega seamless procedural dungeon. The full version with over 80 enemy variants, 100 weapons, 60 perks, and multiple landscapes that change each time."}]}, "developer_name": "CyDream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CyDream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nn", "es_VE", "de", "es_AR", "ru", "sv", "es_PE", "ru_UA", 
_1336799045135470_5478735552618385620_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vekCTeTFYgQ7kNvwFFfsjE&_nc_oc=AdoNqSd8XbtenB_WO4adp513GihNZtHTJjCqHHU9DHYdQFy-TsRk6Py9AUev4xQr5GI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EWIt3gmvJDvH_AfO3OdM3Bg4FkidY1faMn3h87Ep-HA&oe=69D7AD43"}, {"file_name": "vlcsnap-2026-01-20-16h35m22s849-.png", "id": "1582503799696883", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499303679_1582503803030216_3957461508652600438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYeGL3IsxmIQ7kNvwE_nTG-&_nc_oc=AdpFfrhU7z1kYnVXHUpXZqik8ufjC0cqplRoq7S-JQjDJZEHJECl4Ff7YhmHXzZ5K-4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eWyjs0AFxDe2nRfsZgx7ST_G-wz10iaKdon1Pfp596Q&oe=69D7B0AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MyFlight XR", "keywords": [], "long_description": "*** Best with internet connectivity ***\n\nMake any seat the window seat. Upgrade your journey with a virtual view outside the aircraft.\n\nExperience your flight in mixed reality, where you can freely place and resize your own windows around the cabin, or switch to fully immersive VR for a 360\u00b0 outside view.\n\nWith a subscription and internet connectivity, the app can track your flight in real time and show nearby air traffic, so you can see other aircraft sharing the skies around you.\n\nEven without internet, you can still enjoy stars and satellites, creating a rich XR experience throughout your journey!", "short_description": "Make any seat the window seat! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://quarterdozen.jp/privacy/mfxr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Quarter Dozen Japan", "support_website_url": "https://quarterdozenjapan.zohodesk.jp/portal/en/home", "website_url": "https://quarterdozen.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id
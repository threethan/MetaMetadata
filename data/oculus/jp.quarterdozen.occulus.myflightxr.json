om&_nc_ss=7f20f&oh=00_AQQZteMB9OtaESpwDHDVSZP7TvkoWV3oeO3yLpq_Y91ezQ&oe=6AFDBCB5"}, {"file_name": "vlcsnap-2026-01-20-16h41m58s862--.png", "id": "1336799041802137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_1336799045135470_5478735552618385620_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIglYU_055cQ7kNvwHy7Llr&_nc_oc=AdrwjfdFCR0db6BCBiOAM4vxmizmDDe4JOLJba2PDaeB-y7_CsA5tKaSnH3JPmqt_Do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYT-JpH-eWbWRAQB9oooPz1_HLhPNyRKQT2c5AkRZNog&oe=6AFDE403"}, {"file_name": "vlcsnap-2026-01-20-16h35m22s849-.png", "id": "1582503799696883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303679_1582503803030216_3957461508652600438_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmhtkqAOUAYQ7kNvwGxY075&_nc_oc=Adq0Iym6TN4NCMgRvT2mLyuh4SZ24hxrdfg42rMQy8QzcIncATiZ_n1rZ9CaDDvUrv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScQY3MqzDVBjKENv0QAxouOjg4EYypycc1-Q3wXi7MBQ&oe=6AFDAF2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MyFlight XR", "keywords": [], "long_description": "*** Best with internet connectivity ***\n\nMake any seat the window seat. Upgrade your journey with a virtual view outside the aircraft.\n\nExperience your flight in mixed reality, where you can freely place and resize your own windows around the cabin, or switch to fully immersive VR for a 360\u00b0 outside view.\n\nWith a subscription and internet connectivity, the app can track your flight in real time and show nearby air traffic, so you can see other aircraft sharing the skies around you.\n\nEven without internet, you can still enjoy stars and satellites, creating a rich XR experience throughout your journey!", "short_description": "Make any seat the window seat! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://quarterdozen.jp/privacy/mfxr-privacy-policy", "developer_terms_of_s
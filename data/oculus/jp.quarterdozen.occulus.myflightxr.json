om&_nc_ss=7f20f&oh=00_AQRE6oiGJpZtJOPe9jXFWCbrIU_IANeMQT8WxdCQxdU8RA&oe=6B05A5B5"}, {"file_name": "vlcsnap-2026-01-20-16h41m58s862--.png", "id": "1336799041802137", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_1336799045135470_5478735552618385620_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf5HxAZcWAUQ7kNvwGBWe2H&_nc_oc=AdrSuHuoP3yZJ5V0uBYJSfd06lzcy6fTHvPLIqgMIdKnC2m5hkLous4c7yUAqRXL6Iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiv_jJ97J_IPPIsNLy9aVjl9Zj2fZ3WB7IVjWMfQ2Mow&oe=6B05CD03"}, {"file_name": "vlcsnap-2026-01-20-16h35m22s849-.png", "id": "1582503799696883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303679_1582503803030216_3957461508652600438_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tr7NvE39ccQ7kNvwGnebHX&_nc_oc=AdoxzFhxL1Bojy4YtcDd8TZdaEh2z68mZeLrA9O8dj3qQZXJbwYhCFSOz-KqfiCAp8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvw36rHqJ-Zn4henMFvnPG2wdAT4yMPDp0aoA0vATr4Q&oe=6B05D06D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MyFlight XR", "keywords": [], "long_description": "*** Best with internet connectivity ***\n\nMake any seat the window seat. Upgrade your journey with a virtual view outside the aircraft.\n\nExperience your flight in mixed reality, where you can freely place and resize your own windows around the cabin, or switch to fully immersive VR for a 360\u00b0 outside view.\n\nWith a subscription and internet connectivity, the app can track your flight in real time and show nearby air traffic, so you can see other aircraft sharing the skies around you.\n\nEven without internet, you can still enjoy stars and satellites, creating a rich XR experience throughout your journey!", "short_description": "Make any seat the window seat! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://quarterdozen.jp/privacy/mfxr-privacy-policy", "developer_terms_of_s
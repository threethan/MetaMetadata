_1336799045135470_5478735552618385620_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec3_I5YyVN0Q7kNvwFn26D8&_nc_oc=AdpeKuHk0e4vNyHB1u2ifroBhHas7WPPlhH4LJXn2O_-fsP1Y0Y8a3OIeubZxlPuHfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7OFWhLjmXGP1RBJ0-3dPVBj1q4QSnSGSR1XW644966g&oe=6A539A43"}, {"file_name": "vlcsnap-2026-01-20-16h35m22s849-.png", "id": "1582503799696883", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303679_1582503803030216_3957461508652600438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGQuueDioxsQ7kNvwGlWuRr&_nc_oc=Adomer_jZYeqmb3SlD-TGTbWRfIbjCYMOmDASVl1u8jBsjs-32zuR5Yi00fsFICTcow&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjyuDtV_J9H1KbhSjHAJ5g_p--O6KHp07JxloEpn6fvA&oe=6A539DAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MyFlight XR", "keywords": [], "long_description": "*** Best with internet connectivity ***\n\nMake any seat the window seat. Upgrade your journey with a virtual view outside the aircraft.\n\nExperience your flight in mixed reality, where you can freely place and resize your own windows around the cabin, or switch to fully immersive VR for a 360\u00b0 outside view.\n\nWith a subscription and internet connectivity, the app can track your flight in real time and show nearby air traffic, so you can see other aircraft sharing the skies around you.\n\nEven without internet, you can still enjoy stars and satellites, creating a rich XR experience throughout your journey!", "short_description": "Make any seat the window seat! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://quarterdozen.jp/privacy/mfxr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Quarter Dozen Japan", "support_website_url": "https://quarterdozenjapan.zohodesk.jp/portal/en/home", "website_url": "https://quarterdozen.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id
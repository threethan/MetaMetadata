_1336799045135470_5478735552618385620_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpmlBf6DwVsQ7kNvwFFej50&_nc_oc=AdrbAKZd6cKUgubdWs8kMIHViluQvGqMeu3JRsbflH1A0M_asbJyqkeb9RpmTDkkTR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TPvuik8HA5MCAtmHPlgyermYnw_YjholGvXwKvEZMAg&oe=6A37EAC3"}, {"file_name": "vlcsnap-2026-01-20-16h35m22s849-.png", "id": "1582503799696883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303679_1582503803030216_3957461508652600438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hu9BTsvhaAAQ7kNvwFSwgA9&_nc_oc=Adpaz4TAR8rRmB4-hJgo-GzkCO29HC1_PymGMaiT_9zSbd9S5-FBxi9EkdSXuuc3cok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q7lG1QZq0jYsXwWOvFa9TrbdhmtXiYNIIWtJQ__lfFQ&oe=6A37EE2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MyFlight XR", "keywords": [], "long_description": "*** Best with internet connectivity ***\n\nMake any seat the window seat. Upgrade your journey with a virtual view outside the aircraft.\n\nExperience your flight in mixed reality, where you can freely place and resize your own windows around the cabin, or switch to fully immersive VR for a 360\u00b0 outside view.\n\nWith a subscription and internet connectivity, the app can track your flight in real time and show nearby air traffic, so you can see other aircraft sharing the skies around you.\n\nEven without internet, you can still enjoy stars and satellites, creating a rich XR experience throughout your journey!", "short_description": "Make any seat the window seat! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://quarterdozen.jp/privacy/mfxr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Quarter Dozen Japan", "support_website_url": "https://quarterdozenjapan.zohodesk.jp/portal/en/home", "website_url": "https://quarterdozen.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id
om&_nc_ss=7f20f&oh=00_AQRM65hUez6-O-iEkfJoQOJ6US2JnTd9KrjBXAUYmFCLRg&oe=6B01E975"}, {"file_name": "vlcsnap-2026-01-20-16h41m58s862--.png", "id": "1336799041802137", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_1336799045135470_5478735552618385620_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErhVrBAfoDEQ7kNvwFOtAln&_nc_oc=AdpGwqUifHqT83cwULviE8bUV0C56Jjc79fAUu7YQYtCs9adzG_uM2FwpRj2vUM0pd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL4BcvrjRb6rATqVCjGQBCd8xEcofaPAE8oCWqLoZnEA&oe=6B01D883"}, {"file_name": "vlcsnap-2026-01-20-16h35m22s849-.png", "id": "1582503799696883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303679_1582503803030216_3957461508652600438_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55Sd5-8Ii3AQ7kNvwHiH0iJ&_nc_oc=AdpxPE_enpjjqgYDtgDGBqtVv70276CYlsmjrLobzUHrrnpMu3DBZDNQBnSCeJpmixw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcynM3P2PgP_HhmlcZdcRYNGu0Vz73mRcEG3ZP5AiVqg&oe=6B01DBED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MyFlight XR", "keywords": [], "long_description": "*** Best with internet connectivity ***\n\nMake any seat the window seat. Upgrade your journey with a virtual view outside the aircraft.\n\nExperience your flight in mixed reality, where you can freely place and resize your own windows around the cabin, or switch to fully immersive VR for a 360\u00b0 outside view.\n\nWith a subscription and internet connectivity, the app can track your flight in real time and show nearby air traffic, so you can see other aircraft sharing the skies around you.\n\nEven without internet, you can still enjoy stars and satellites, creating a rich XR experience throughout your journey!", "short_description": "Make any seat the window seat! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://quarterdozen.jp/privacy/mfxr-privacy-policy", "developer_terms_of_s
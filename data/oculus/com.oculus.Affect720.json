grated_image.png", "id": "231315318268280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_417225378672678_4912493544880472064_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcRE3SF5XGkQ7kNvwERqakd&_nc_oc=Ado2EZupVm9zvRamByZcmmbHrJOaBTRhhd_rK7LYcPJV10zKnCK4PtF7S_Zd4GC3Y_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5jNzSqqjxkFWjZ1oZoBSLvNveAxCrt8SPnb0wxinI2Q&oe=6B008008"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VZcesimxXUQ7kNvwEw4r1c&_nc_oc=AdrbgoFlpdwwJM73IW7xtWuD4RipF7U0M6hTTlqJIIMH4foPt7MiKzYLWv33qARlEpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPv9FZJ9kEbgRUe-xHr3WwlYXjk8wBNwXfL6R5cPBqfg&oe=6B006327"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc_VmdH9ctAQ7kNvwEEXBjD&_nc_oc=AdrG6R6IV1mm9Tn-_j97ZXYxZlbroI3VTp6-ZwoeVEOGENBs_aLsEVqFbpUiLnnh1Ak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXQac9gyn-UfX9eTGwYUl8OsmEVV7MNOZFBIeBSkpmIw&oe=6B006F5E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LbU2uM_dSIQ7kNvwFjhZyE&_nc_oc=Ado_YZum640pXfQL64EqL0bprc17NEPbVhOxqVcwvCnh6PvyCzYt2zrj7tFcf2ovQB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPLOLcNal-xHt61Il53yTk1vA2QE_lDELHyN9KVC8OAQ&oe=6B005AF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
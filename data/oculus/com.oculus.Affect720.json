L0qn5146Nc7_bd0CkEHPKspFV3C3GbapVaP7vwqhB2qhCMQQjf_Udw7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu0bSiIVdZnBTPhaK9elA_daJJbx2usiy37uI_QH1cJg&oe=69B01948"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYN7aG12GA4Q7kNvwFdBt7F&_nc_oc=AdmGOU9C4Npa_s5LKoYpW_Tzmlc07Tba1sq-OYi71mWXPsEgxjgcfseCC1oVuQBuGJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRtpX685pm77sFZ0I1bKCynfoB2HCShkgejENPxf4_Eg&oe=69AFFC67"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkxBnvXt9oYQ7kNvwGP4abi&_nc_oc=AdlojIxps5_NruV7GtHvHMh9pJCAIpm5fAtA_v0DozD4olfT1CoJmsTuEUQKIVvCWTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxah5yJsL7MC6DUsQ74PNIlBC7eESDbOR3IeN6CCD-t5g&oe=69B0089E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0uRFtiaNIsQ7kNvwH1djHn&_nc_oc=AdmhmHxMo9e8g7L9ca7mLyi9KILRjcS1tXUCFrRJt0PVAkmh9neItcp7Vdyen9N_Bc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxutCq6aEoD1L8Mwr4MmPu9E4s4hgx90OBsUoA6c2v4rg&oe=69B02C70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRX29nWzkDEQ7kNvwEUz09C&_nc_oc=AdkhI5vhQSQFVQOjJ5OptHtvY8ZSmYO7x0MOJA4xyC2MwqSFMJY2ZRToozqZHTgCQSA&_nc_zt=
=scontent-ord5-1.oculuscdn.com&oh=00_Afuau_ERA3J6bX6wN63ftoEnGY0hmjcTBOve0_rN8SeWTA&oe=69A43BC8"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAuxztgil_MQ7kNvwFcFjyX&_nc_oc=Adkm4aw_HXW2v8DH_l84rOYXHGnuzmDLXm3NyEkU54E55ZMZ-TYcl1LF0Kj92ahQnfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftixkHBNpF-A5KZ08E_E16Uky5m2aMIHb1ht--yE-d0Jw&oe=69A41EE7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm7axiRsj2gQ7kNvwEl2dq_&_nc_oc=AdmBT9PVd5ZkYHsOmnE3E53CAWu15xbCp00nck2-Biamvkv3n9Lc_aeq3Pd19XsJYTU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft7nlHEv7_32NnNU7dYe4GG3sGqin8y3mkjE7cY87YMEQ&oe=69A42B1E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKu3kIp9vxMQ7kNvwGEOJ9k&_nc_oc=AdlDzH8tE908wzAS9aHtrQ6vPOYFuQAXmTYrN1be7kVnBdmTX1MLKsBZvg7qS48RyVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftD_CcEYf089NFlmfNtxO7picPlgoQ_ZlaszSGG0KiySA&oe=69A44EF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYAFrrQ6iocQ7kNvwHRshq7&_nc_oc=AdmCqbdAIdBeCPNKjILqNJpKGeSEyeTtPTQWweUCIbK2c--zdrF8ZisQpiA_2XRdvIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftc7LLXaomKUFr50y5VRNRnXv0MkX4OHL9Gy2rBHDzl_A&oe=69A447E6"}, "
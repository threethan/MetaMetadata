4Q7kNvwGbjKrk&_nc_oc=AdrSDJwpv4jCaaBZMrrWEBjovr211qNmu5K76jjWo3BnNlvCklsLwCx2zPUW861Gy0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDATMgNu07djDeZj0v1FX-YTYNJ_HVAs7U7m7C6C4hbsw&oe=6A4BAA48"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI3_MM3t1DsQ7kNvwGEcweK&_nc_oc=AdrBUENxupIP-U9IGyE4i_JyR66q6-ARueqfi9YNnQWMnabje6KPlDadoKB0I4RxieE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfTlUpODqT75X5hwpkjy-GHzuZT3cOVjPrvH_mHGzr9Q&oe=6A4BC5A7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xn_T_6couy8Q7kNvwERGq1M&_nc_oc=AdpNZ1yHI59fEZ5HC-iSDKzbNRR6hxJ-3BwtGSx09kG4lPTLQM1P4Lx_2QMVZaqf8yU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKnfRqRLD_gOhKGTVqjL4bRvtvUrTTtYRfdY0SxWGosw&oe=6A4B999E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtUKXcqR7EQQ7kNvwEpNU4m&_nc_oc=AdpidFKY5l6jOicvA5eLQk2wV17ikR3Mljah2R23_GVoVLp_YSJrPU6pCVhMZbaStTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpxV5yLWTG3VNiAqOaDiprndPmAty9x3DaTeQvqzJ1Pg&oe=6A4BBD70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1T3zAM4NVQQ7kNvwG1B3jK&_nc_oc=Adp04lgYEZ-w3ukWeIC6JObptR5
=scontent-iad3-2.oculuscdn.com&oh=00_Afta5Kcp1i3OIezSbAa1vfGkWSb0R-mbg3_aNEMAQHxO3Q&oe=69A6DEC8"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAuxztgil_MQ7kNvwGsK5II&_nc_oc=Admlg8kBHFboe1-9l2z2HXu1hzeRau_T7nqbpV_yyziayQS1TWMyMzvyEpALAv7eqZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvayOxyzqUCmaCvQ6ZQi_oPR_clyLFgz14qIxmVGOLRyA&oe=69A6C1E7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KTfjwviVBMQ7kNvwGukdEv&_nc_oc=Adk77QmhpMW_6lO0z03TCzbVArxD6oGOMOMhNNQf8ea_mg80_oM4YnkCYRffqO4XM5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftMzbq-AfosrMfYiaUUYGjmSjyWXnIpImVKztQ3IUik6g&oe=69A6CE1E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU_G22umzEMQ7kNvwEZWwE2&_nc_oc=AdlC1FX0YB6oS08h2jUCzopZ8e1ho-tCCX8fgOsTq3D8oUY6hYSxj5uyGia_Nj3Rm-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuedxa8_JeFTjniLyTsLkuVzbPfvtTvVTNG8yeDZcfO4Q&oe=69A6F1F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYAFrrQ6iocQ7kNvwEn-S0d&_nc_oc=Adnid6wwr33ZayJPTRw80CNnwoNt8R5Ic8khPzMwfmn8uosHWYSvDe7obaKo1FG_C_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRrXMkHc_7Eelq2_sTSR_Kyhvv2bhb28RwOw7Rlj1faQ&oe=69A6EAE6"}, "
=scontent-ord5-1.oculuscdn.com&oh=00_AfvPydrkVu0z__pl2a9n-n1-przqWnFTmQ45vx9Ch4GIdw&oe=699B0148"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrhsHfrha6EQ7kNvwHK6c3g&_nc_oc=AdltIzw-ThQQuwFTxapp5q1ExSqvNan0Z3e1RygfuRI-jKmFA6bK2lrXGD-RvRWqITg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfudcOeOqKmthomjjljahQDpL9YIsSk1r9fxeHhQofPtWA&oe=699AE467"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBOoeR_aoPAQ7kNvwFRJRE9&_nc_oc=AdmzbCu9aCfXhuwB7mjbd6ZboO2Zw7-fRA9iTINxjS7yimxfNz1D3jBqMjlffnmO9ls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvevVhDbGUzlO0FHSJbP1uObqs_xlBkWCqq4928_EAk-Q&oe=699AF09E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJdoFJ3BLxIQ7kNvwGpOf0p&_nc_oc=Admjx0mswS2pM8f5nociHumClyCJBP9gVb53n0jYLl3T056OY86aa_66QO2z_U_mx0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuIjdCUMnP2q333MnCXlub7BoEydEuznHlaGr_9vm3tXQ&oe=699B1470"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6ZWn7toizcQ7kNvwF0cvt1&_nc_oc=AdktDiaNM1CsQJm_IUOKNyfUxqf_-ytUYD_hVZrF2rceI8rX0MoAX5KrWYLbAVgybdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu2JNrAzsJ_zwzWISFnyWQ8jCinmzfG8_Avbpat7s_zog&oe=699B0D66"}, "
grated_image.png", "id": "231315318268280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_417225378672678_4912493544880472064_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Dg4laCNUY8Q7kNvwGZcddm&_nc_oc=AdqRhyiUkxOzVknsL9JQ6J0zlHC3_cmE20KBEilOeiRnBHdIp_CXGe3u39BHapM74fA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ50qZWCpvJ1KADWT4TUHxpwiqP7zVMKL0qylAmNhsLkA&oe=6B01D188"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VZcesimxXUQ7kNvwE498RA&_nc_oc=Ado4YvUP0mC7e5RH7yyixDl_yTTIaX56zj6COQjMRcak-pxCIQ3E_Bvf9nDeu9xRS0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsZXSVJE_cw4s-8WwQYSLp87WYobUHsYMOJ9Tt5AK6rQ&oe=6B01ECE7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc_VmdH9ctAQ7kNvwGF4c-h&_nc_oc=Ado1QqWgj15xfgmjj1VSIRsGyVDTl1sZLIMgbbQSpv0OON-rb1JMUWqNlwyxe62kf1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6H-qNsdzeULBbK91LzcEwcPRgERRhkwqzd8S_77sOPw&oe=6B01C0DE"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lSbsmRAJLsQ7kNvwGbDs3s&_nc_oc=AdoqsM8uSOIc2OZtePDtGosF2oWvjix7oJpJfqUt4TBi6fydtYxuIxsw3wsN-qgcg8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmUI1DnN5mcwIINQ-MKdcRJalCLa2N83z0K6pUF2Gonw&oe=6B01E4B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
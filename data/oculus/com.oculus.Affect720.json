=scontent-atl3-3.oculuscdn.com&oh=00_AfudU3IgkoBn5t7TGT9t3r0F1EDZl8n7zUJSSto6J7DJeA&oe=69A58D48"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAuxztgil_MQ7kNvwGa1HNV&_nc_oc=Adl1UZwFqzkJuGqcxYaCzq6hmdPW4LqQ528BFeYabCrl5UTAfyVNlsECUE5yeVUPDtQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfusTl6-rcakzaFOoIksYwVpDV9MiL2bYEg74kdTBragfg&oe=69A57067"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm7axiRsj2gQ7kNvwHA0utH&_nc_oc=Adm0OUjO_kPiVmvUAoRu4n95ajfwAVIDPeDhtGw1VuyWXzP_Kwadai70oLPtnf4Ay94&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsr4aW5Y5vmy6MUxQy56t_OJk_dXwx5tM85bacIg0vgvQ&oe=69A57C9E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU_G22umzEMQ7kNvwEJKpJo&_nc_oc=AdlBTuOjAGbYzozpvSG-bdJtvWY61SgjvOkvM862E-BF_iCUa61_1C_QO_QyMR_gR7E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfueIOGDLhqgT4eJY_OTU8h19TNgA9gBME427a1A5vXK9A&oe=69A5A070"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYAFrrQ6iocQ7kNvwG7e706&_nc_oc=Adm7NLL_-JtKkjNc5XMxQYQhhep1IhFT4BBZgMx1iRVc-1SKSE9X_YYwiDNKnQ0Hggc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftb9Dohs9I-QuJRw7a7bQL0Acml1vRbmf_KpE7zWlyWYg&oe=69A59966"}, "
grated_image.png", "id": "231315318268280", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_417225378672678_4912493544880472064_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcRE3SF5XGkQ7kNvwGMmqGN&_nc_oc=AdoWjutZR7AQMkomX4h8iCYOoBnwMnqQuV2hV__1PPeZCDFLpFAtpQvgDw_5ZinhXaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSesHefUQnKpF2i6hOGaML8rMF4tLB2-HD6ZfulEinug&oe=6AFF2E88"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VZcesimxXUQ7kNvwFRuJ1p&_nc_oc=AdpRHcL0Bhe6DPyJoQYWR3-6IYVHbtpt50y0KhJEoQLF06HIw1INN_WUa4jRG_S5A08&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsXnrqj6aXLGWkeV9oINv3p--Rk8yaCvSxauaIlKTb2A&oe=6AFF11A7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc_VmdH9ctAQ7kNvwFR9IVe&_nc_oc=AdrAQWVb8wr-HxBuYyJkVM-2E6Xns4NjZ8HGUmg9rzGvL3ylzdK6-VFkskT5dA9RWD0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdAzVWyx1Uvyxs3j1siFZzCj-xTh4BFewtKSOTv6tSiA&oe=6AFF1DDE"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LbU2uM_dSIQ7kNvwFvKkDi&_nc_oc=Adr0l80bkgQhvhk5lVEbq-THuAP_aP_an5iWMo6qH53ITazQnzcuQXdRrLIcwO0ykSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAepUdDgcYr0v4OcaKfKnrg7eQGCzawZ0p1UIaFjFwAg&oe=6AFF0970"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
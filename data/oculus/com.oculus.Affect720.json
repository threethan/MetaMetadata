0Q7kNvwEpJVSs&_nc_oc=Adre_6p_giKc4-wjcGomGfB68dr-_0HHQ5RWki-YFgw_cSCyLi2_O6vqBP1t4-6Nucs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkxrP_58kc6hvhPEDv3vu643cxLDqEPwkjuVwCcIv6zw&oe=6A985988"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ8DLpuntn4Q7kNvwEWigpI&_nc_oc=AdrlDQbscEeRmCoItD9GlF1rF3SUrTat6ZTNgamN3uhhJyHrNFbVhNiE7by_C7FUVrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4bHgwiRQnRzJZQK3uWn6y_Ej2ENFljs3btss9XQmeIg&oe=6A983CA7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuOU9EihM-AQ7kNvwFrKNKa&_nc_oc=AdrTYd-QJJGJaqVNSTcIgAQD6M0bjyIyVGWN4ufjKxJVCpQwdlirlPi-oIGdRCLWJ-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE8vUbKUeWIPJPPpzYtnoSr6H3RaKmAQoFlc3hwjNH9g&oe=6A9848DE"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzTS8CTqBssQ7kNvwHCQ1C7&_nc_oc=AdrlcUzFzkksxtInlIdmvilmhfPfqwxFi5JsbQktiqFpd-rQH6DQijysEb6CpF7nysE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCTeeBDaV1vRakkhle1GvDNy6IF2Xw7bfeMJTRCaQnSQ&oe=6A983470"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIo0TmZQT7QQ7kNvwG2D6Jf&_nc_oc=AdqlTgESzAQ8VGiXlS5SmEj4KKs
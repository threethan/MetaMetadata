grated_image.png", "id": "231315318268280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_417225378672678_4912493544880472064_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlAo22Z0x5oQ7kNvwGBRW9L&_nc_oc=AdoR8Qm66Q31iLXp7fgF-lfK8UT_s-X7jB79IcFp4v_t-abELN81lbWuGqEA18X5Odw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjA_x3hXARdy0zrn3vX-fj1oIWY86ILoUd9R5JntwrFg&oe=6B0C5D88"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtosB-zDUvoQ7kNvwFnfeqG&_nc_oc=AdpZJjb-YCjSQcXxDW1l5md0uGf-RJjR-i6c9rNIyqT6bo9JHjWUy1Nd6VMJFcAtx3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSm48mf7HmM1vj73Pu6gJ52sJIlpQQKS6b8pVsx4COZJQ&oe=6B0C78E7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbR0kMm_k4IQ7kNvwHcErJ9&_nc_oc=AdoQmz2qivlGEvQVIWEh75NyP6_yPXxmrUAO1x_Vo7QT5hlH6FzcpgLaJlgxKx3vqCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRk0oOwoAZtCK_SAmygaTXFzyny_nNL0jUqQzC6Kxtbdg&oe=6B0C4CDE"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEVPyQlsZQsQ7kNvwGgSNor&_nc_oc=AdpsqihmkIMtwBwRab6Z0H1ek0WWYBjVDe9IhsxNTCISBhuRj5KJWV8538zbODaoPSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLTF7eo81ZVEkAdB5K7SzMB9hhnsfyejSu4r_d8DqLpA&oe=6B0C70B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
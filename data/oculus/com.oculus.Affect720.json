=scontent-iad3-2.oculuscdn.com&oh=00_Afuy_ydX4u4nzxAQbE3xsmV3sNSmSPR1QWvkFwyiCBz-hQ&oe=6999AFC8"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrhsHfrha6EQ7kNvwF89zZN&_nc_oc=AdlCTwz-dnAn3NxRVYqyedODL8cGD2sRj4McpArd5QgryAAHx-Xt8AZhLEheTmWuYJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDHtwzCptY4QDfduFiV9zX292AAYleFzHNW5WeCjYWwg&oe=699992E7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7dokTUPDXEQ7kNvwFAjRf_&_nc_oc=Adlbm9rW_B5nKnb5wT-miA92y0tHeCXaDasiVYevOqvx2BXvY0astjzQD1wxKgr0r_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0MMt2Z1SPhTxvgP5-3vnOszujnPknqQI_FCpk_JBd9w&oe=69999F1E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJdoFJ3BLxIQ7kNvwGO8DEi&_nc_oc=AdnphSru0FiOvYKO8dbCSBMxEBkwfm1HaoRCRAf-Grf1MuGJvjZsOkhtu197noTEnLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZbDAbygts7eu4LlSo17P_MgmvYF7BOQvPNV_MsDuz4g&oe=6999C2F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6ZWn7toizcQ7kNvwEjIqIg&_nc_oc=AdmmGhmcdsCZ9S5cE2VoutBw9reR30_ui9C5-XrPXSrSdEyfYH6gNl9SGlGxiHoswug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtKHBWmxgKSkZMD2vh207_r_ZnW4tEXt790SNsK6JSaw&oe=6999BBE6"}, "
0Q7kNvwFE6MLH&_nc_oc=Adp68f5gsngQdD4DHsoI1HXGn-gVK21664ilC7kVCdXW7eqxTvzywshS3lK41fKcd4M&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN9A4Y-7kYNw1781MHwkJNsdXJ3NwMLRj55WEenJzTzg&oe=6A974048"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fOEBcZnIZwQ7kNvwHknXTk&_nc_oc=AdqPP943A2jYVaIeOWqmZSMPKKRRnAZxtJAL8oeN5wiWZ0hstu2T7Ut8bi5cJFs_1hM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8BF0_7gGgjiaAbhkb4kEDS3t4UMABkREpNglTKQrqUA&oe=6A972367"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2pzi54r3fgQ7kNvwGabzY1&_nc_oc=Ado8jIrFgaB_ah-1ieKfj153AnAj5vmCJiTQWXDxeSeXtEamYq3XgrBYL8zOzBspp84&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKu2JAU1OgPRhroUgI1u_O9SCZjtBUsgC9KkvAJiTnrQ&oe=6A972F9E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzTS8CTqBssQ7kNvwEWwg7b&_nc_oc=AdrqGEqrd8Mzjbi6u-7EtR7fpEkvK4O0QLcfDXSXfrnez5TjMTDuFBAytVdjAAVlO_0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtslVo8ITsFvObDide6p3AHdDUst_AiNvvLOhBccLbtw&oe=6A971B30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIo0TmZQT7QQ7kNvwHW2lZY&_nc_oc=AdoXylT3o3JiJp7_lXQA_xxmql5
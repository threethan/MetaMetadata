AnjtbDVpJwQ7kNvwEJln4p&_nc_oc=AdqbVNPg1_ddMID2VWJZw1kYcCVm-86CZ9Cg_wZZU8gYCLO57whjNQOS7DxZZp_weoc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzpfWQqjPbSsgE9ToUBr_E4UU4eldbCxQHaS2r8YmQ1A&oe=6A8D9548"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no_zOm2KfWUQ7kNvwFgwC5f&_nc_oc=AdoO7B3vh5-rc2vkgO3EWJHW0tU3ns0jPXRCRnPbgDhhYRIfJ9IjUociPncYYyyOiwE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEp2ANb7F0nb-VoE634fnSyq5RDWgeurXVEr581-NN-fQ&oe=6A8D7867"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9trhxGi6bgQ7kNvwG787Cu&_nc_oc=Adoo7asyq74NVs9JNvbGPkUng_BQiXyT2HC8b5Pf-pbGgoF4-52Xk-kPRk_tj-rC5pg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUUO7tot2LIGwrJ-QH3l6XhyaSjSpqq-mLm7PnQVgRcw&oe=6A8D849E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkyt9JGKIWkQ7kNvwHuI58Q&_nc_oc=AdpEoLjJslN4R8OyLTxcdqq6e2oFYF_PG1CGAr-2itLFBTYyky6T5p4dlh_mNBpG8Lk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRyNL-5RdeOTi6OZKnZd_A5kAbFaw8Y4N9ycKsTHRU5g&oe=6A8D7030"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tOKl5DytiMQ7kNvwHrWrcR&_nc_oc=Adom1Pz6EOGgO
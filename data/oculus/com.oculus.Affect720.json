UQ7kNvwGux9DG&_nc_oc=AdrFzVmRdix55MWtLJlJgOSIOQfs6gyzTroCoD5LYnoiY0C_bVJX5FLhPLCcWvZH7YI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1LExPS15koLQ4RxhvdpLwA0UJuGdqE5g_5OWInu6ilw&oe=6A6F42C8"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFYLHC9TzpIQ7kNvwE5O8rw&_nc_oc=AdrFQdwSgpFkDTJOnQASHHpF3Yx1WFdLerf_wMSUMeqZnS23VvO8raFm1uLm1fmV8ac&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4wMa3EbphiqZAfzlVvKHADkOknF6P-iOJQDVtAqs9uw&oe=6A6F5E27"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8a2lLs_97w0Q7kNvwEdG-Kx&_nc_oc=AdpzZhXigcQJzzGSBor9MwdiEW8Y7RJIggo9bq3f4GVX9le0_Bcy5x23y56-ddRXRLE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC53pkkTeflsnCu4v6QyDRdHT8Afd3Zv4ThdoiLMBQo_Q&oe=6A6F321E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHIc9hMLEokQ7kNvwEmxyse&_nc_oc=Adp_rv55RVrEj-XTe9O5PUbghAnwIBO9g3KWj628DyB8jZR70mszpVtYXtw6Wm-Wjgk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpOne3pyDscA-bU1qfFk0NS1KxbvFttmjawmSyElnPRA&oe=6A6F55F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2Bgr6sEjLMQ7kNvwFcsa5K&_nc_oc=Adp8vdw7IdJ-8J5Grray50SYMDz
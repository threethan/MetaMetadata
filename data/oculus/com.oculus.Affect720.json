grated_image.png", "id": "231315318268280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_417225378672678_4912493544880472064_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Dg4laCNUY8Q7kNvwGXrnMu&_nc_oc=AdrBBzrhzjzdRFX1_WNYGdivWsceUNatD-DgFkORLr3BmidpJJcOtDZzuF1nsijGyVo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThgofGL_ynzDlKa3kKYUFOAFZlJ9xt-lO-yIuneYqCYw&oe=6B032308"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNCbg0op8AsQ7kNvwEW5oHP&_nc_oc=Adqbz6KqimjKyFAdOkbugg7_6kLnUtPZa7GibZrGykpPgK4cdRYUeqCPg3_Vmz8XC-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5fU8LxnKbtjCvNCQcRwI5MesO_PoND3b1_5OGIZUVpA&oe=6B030627"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0es_ohTBnIQ7kNvwGlak5b&_nc_oc=Adp8T6A3Poe9dDFs0Vf8xfqHIL7Sj_yBROEZa9VKGEL2nKzOktbh9DsTZMYwyc1TH7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvJq0AmGiUwiqawEbY6avUhtgktWqFqRhxNe0qmxGXiQ&oe=6B03125E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lSbsmRAJLsQ7kNvwFtw5az&_nc_oc=AdqOkN1oNyIZ3v5Po2hSWgaWkkZt7LRyhpSZsiMHE1oOX3CCEobFNui_xd0E1OCo-A4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-kNRn58Docv1vpu1zvtxXGXvpwoXCsmWaRxLY1JbAog&oe=6B033630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
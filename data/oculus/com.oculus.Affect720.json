EQ7kNvwHgeCwM&_nc_oc=AdpxkBCMEwlCZ7gO6CEZrOt8uk7q0-1SOij1OYCsJIWcyM9zVcgjJhCTNpv87DvL6ew&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD76YF7MPyL2yhAqmK_z5jmk7CWVu2eotcVtPhzDlxtzQ&oe=6A660848"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=766AJuITWi8Q7kNvwENbE6D&_nc_oc=AdpWza1KIS4Z7tj8OY1zCZOBP2OaaTPFP7b2pvRsblR_LZSaVx-RV9TDyfkGqlcpHe0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDExk5EvBqCvTuNTEkoSgp5jl0nh7GcSFkMNo5yUOtn8w&oe=6A65EB67"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI9TAd3ebfwQ7kNvwHelDUr&_nc_oc=AdqzYetdaJ8CHqhw5hc8W1CDIP9kVoYPiWAO94P27c_-Dd401tJwd8iAsFIJh5luIUM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkQ4DyPqeL0M0vx4E-fpA8-xoqgdSYjZOye7qqUHHGCw&oe=6A65F79E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YADEAJe6SKMQ7kNvwHdqM69&_nc_oc=Adqk8vvYvqThByCzXV7JFsIPAKRVhMrKLfFEpYSDbq4bcSHGL_UY1btjl0e9SJRu3OQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYVOfIu6GKtpY0t5pIvPL_0dllC9TuL2xUfjWIYYhG5w&oe=6A661B70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfzwCD-0YvQQ7kNvwHwDKUo&_nc_oc=AdqMgs6NFpVF2UMOf0uw1s04mPJ
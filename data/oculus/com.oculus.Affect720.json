IQ7kNvwFnHhpa&_nc_oc=AdpJ1sUzbgZ24uwh9I4GA9YKWiJKhuzxkEJg9Cs49RVbf_OnHCkGI7H-bMG3N9kXz4g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XvMWIFXkPlvyotLjnzYOQ8IpZ7swupQG7NfkH9DNIHw&oe=6A12F9C8"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xozKr-IteH4Q7kNvwEenx6f&_nc_oc=AdqGps7tlpahWZsnlZZp2RmhZr9ifAtO2gbFWsTGm5yE8ldb1PRXX2b9ZhI3KkE4QT0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bin2JgV9gR4hqoY9zrwoYDyEW_-T3g50ccNZOtaL8Sg&oe=6A131527"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQEKU6Ve5wwQ7kNvwGDmHZ5&_nc_oc=AdpPGhOzwJfpOyzn5V3NxxvDfehVe8tR6E_7IvWng7ZgJNmdJ_Jyo8nLiyz3nPiZh9s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YqYjcSe3ix3l1EAvL4CpOlOiQmcZn35ta93yEs1867w&oe=6A13215E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGrsHtd7zD4Q7kNvwG0KkdE&_nc_oc=AdpJ1xtQnsF-xULJz_ue1g5-ORu4vAm9OEYN0YL1zMUhAvElehfSHjugpoauMSzYCTk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MDUJ8h3pRV3Zy0mywJBmQWwmPVwkNr-7CGyMlwYITtA&oe=6A130CF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d3addsvELkQ7kNvwHX3ZmC&_nc_oc=AdoLeJpVOs5GttN6rue-9f_9CeU
=scontent-iad3-2.oculuscdn.com&oh=00_Afs6-GOf6ERGozNaX-lWp8ADAM1Ybgg5q8we1u6fbwN_qQ&oe=69A2EA48"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-d9_1ok6j8Q7kNvwFnMJIi&_nc_oc=Adl6uBmOFnpZT8CSLClonmNmxUqLkG2_kcsvGhy1dBJ1DcEno5LGzt7Q5wdRUgg5Otc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftuwmU6VJXQKqXdgn7XO21rlqDJKLEEjZVQrXelmP3f4Q&oe=69A2CD67"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm7axiRsj2gQ7kNvwH5mZn9&_nc_oc=AdkDRy9KBwIuYyHKVHIiX7PPWegPKohhVBCxp4X6Tt04ZMTVl01PP2GXPshOO1iFynQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuaeSfhiSan-D80CQxgbWswvnwwuO5BLF7MZpW7Rqu6RQ&oe=69A2D99E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKu3kIp9vxMQ7kNvwG3N6FP&_nc_oc=AdkjNTmypJh8FJU1GYrAdXpxCZflakN5-whve_EsO2Jz5qB3jHop1o9yy282EyiTFg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsi-r_kI5ptVsPY7BTzobInJCXPJKt1_nLPo1YRN3bo8w&oe=69A2FD70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sbBIxyRVNkQ7kNvwExNqD_&_nc_oc=AdkHHrXeVDtwilGTm70VKAHmnziGWIrt_UDJAz707N8baND4q8SM1VxFwj7FXlhQhVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftpN8EZ-7_iOUQHyL-_Z7W5AtasPssiJ9pOlCc8Yr8jUA&oe=69A2F666"}, "
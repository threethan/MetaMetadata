Kq02KLMf0hmAJTq-ROepuwFly1yAh1x2xthOVPNk9_nTHg9jUxGs_qAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyp3-ivjLn5ICnDp6iqZkHtFItqcZlKGY-AQkr9ZQzF3w&oe=69B80248"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA1Df2ji4ZkQ7kNvwFbZTis&_nc_oc=AdlNESShLiVMggW7ZTF9v9aeM-t8Ne3RMVYtR3OW30U5IugJFKuwoEnmsMSLzyIEo1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFAVnA4VL3yOyT_nmfhI9rQxQPnxgUyoKK9J0diPSliA&oe=69B7E567"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LurZUOa__J0Q7kNvwFA5-fw&_nc_oc=AdmYYsC8JLukmNpbp7AGbh53Dn8b4qxaQBpUov0QF23SRYF4DsQ94f-SFLRIeLydEJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZh_0mYn5tai1A7L2IlU5vbI4AhLZ3zAuIXL2UfWDIgg&oe=69B7F19E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47IpzerSowoQ7kNvwHBJLzA&_nc_oc=Adnzkie11k_w_JvAlYUdy2sVQm9DbavwkR29ebfvaMG4WXLeAmTYyW7yAODoavRl0AQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZUMOczT6XNJkx0bwG-XbIj5Xp5T528LY9X2OLcDpv_Q&oe=69B81570"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyMb0tm7lR8Q7kNvwEMdXOu&_nc_oc=AdnhwnG_Civ_8n_dsNYrW90xovFqJnk7vPsrkBxhtZS7o3BJk3WtvNbCZyStX5hlNgU&_nc_zt=
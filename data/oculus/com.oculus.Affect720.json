grated_image.png", "id": "231315318268280", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162732_417225378672678_4912493544880472064_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WITuo1zgRd8Q7kNvwFCYagD&_nc_oc=AdpvncwxpBKZG0tQDrVbQwKabOf9uzxVuYlxv4vA3uT3q18UrF2jyNceXcfE97yE3qs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG5Usb8bAiku23Nx9K5cDQBRujyvjxI72IMQStrnEAZQ&oe=6AFB3A08"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qEZ3SxgQuMQ7kNvwGgLrJk&_nc_oc=AdptoSdsSsdkmWTaT-BiSVUiyIV_1oV0Jmadoqhm8MyMcVUzQcffnEFesSOlGzWsw6o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPk0QiIFAlXeJ-UbacvFMlrcr-0U8BRY9qw_c2yT4DXQ&oe=6AFB1D27"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNg-6baZkh0Q7kNvwG1d6-y&_nc_oc=Adq8TQTOGhf6r0wasLVgszJAZ_gjiTmhfpXQ2gN-viykaVbgsc_kK0MXzZ3UvRi18pI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCecY9fXnsmt-jPzcs0zySXAo4brqG_7c-rcYbg7Zeww&oe=6AFB295E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irfYksRIUj8Q7kNvwGxJGkx&_nc_oc=AdqVh8w_YKK0GuhLH5FYVNB5NuJZfJGPJDUkitx5to2MYmLSNTHaQcdnkBLbcvdPH3A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgI0Ol8GZtL31wpkRb5EpdNITkp8bajaqE8QgeXpPiTA&oe=6AFB4D30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
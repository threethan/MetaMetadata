0Q7kNvwFSkTUA&_nc_oc=AdoAmfZYLkmACoNxqq8TzL5NQMs4Ltj6dzOvSKxqTp04Vcm9fFcR-d7vDzrQAePAweg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08eFR9VIPBNz5ipxeoH5qUQW8nw6u6d_sD4jEU7LPNGQ&oe=69E23248"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOqEnr1-PMAQ7kNvwEMwatb&_nc_oc=Adri66aMSpqZvu1ant1mfQADVEaUK1vDRpBjw1-B676GfK8ns0prk5Nbcl5jR5dU1wg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gf0_7Zn6iaexBLic8aPsZRRMz1ee4QXi2urTKx7-pdA&oe=69E24DA7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbcM9ZBiuZ4Q7kNvwFxosMS&_nc_oc=Adq9LDk7iaRas6Zb_Q-KnkFZCuF9ER-zH9_sPgKwVf8isBJz0rODBNAWt6gbf2I_f3o&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Oi61QbdYiVDDbac2rfI7TDHl0U4rkcm44vacaDKOAfA&oe=69E2219E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gD2NDZvNl0Q7kNvwHP5tyM&_nc_oc=Adp76wDBXgs1UDVZRLwCbDn4U7iSaC25rdJAOdT6tb6BrHxvQDGXeP4xBDurGi-k7Z8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xr58GlUvmXVnMpQTmB-RBWagcvR3HAHwVqCrimFaEOw&oe=69E24570"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbSo6yrktSkQ7kNvwE-Cj_l&_nc_oc=AdqLHLMkifVquLLeDIL2TBwUs_q
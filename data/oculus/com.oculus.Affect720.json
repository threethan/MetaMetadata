=scontent-hkg4-2.oculuscdn.com&oh=00_Afshtlr8o0r7Sms6D9SjZWSSfBfNBOUHFY8qAbewKyxCoQ&oe=69A198C8"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-d9_1ok6j8Q7kNvwEALcce&_nc_oc=AdmHEpOVni4e_WQY_LAcPNJWvPBd52beOAvRhy7ubUuq1glnsu9bKUHAQXkfD07nctw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftlTXyATYaBppbiFAuQOCCaGQCRg7-efTro6QDGwgLoFA&oe=69A17BE7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bInFwda1hwQ7kNvwHkIfbM&_nc_oc=AdnejmEl_FK0BStckByWcD-j2L7toe2rWdE0-IZrQ-yHg5wYkhdAta6DjS7JkHq7BCw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvL23RqHbjtru1OgVJmxManmV_cm-jCMGEY-m3craKR5A&oe=69A1881E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKu3kIp9vxMQ7kNvwEEEBkS&_nc_oc=Adk9ombV08xgO92yLYq-m5fBEw4Ti-fo5LJ27XPf-dhOcR13Ke0CPC8e6MoDRNAdw3M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvxlFmJVrzwurrPkBbXkU7hV-VWCOqUOkFQ9D8f340f0Q&oe=69A1ABF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sbBIxyRVNkQ7kNvwHpsLWQ&_nc_oc=AdlNr0mFQ4OlqrfKpDgi6e0-gTpKvv4MR7QDD3kWggzxtohU2aIuMWYM4RVl5P6yS-s&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsXfW4TfYLuHa9pc3xmOVNJsYo0-6mM1fk4iYFG2mgdaw&oe=69A1A4E6"}, "
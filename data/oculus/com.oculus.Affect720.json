AQ7kNvwE9b9vk&_nc_oc=AdrLaxLn4mZm-jUuBvHkP2Sgw8nCNuVYvuwrKLdLoNmGW3dP2z5iNOdQE2-STOSMKXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af085n-7kwTg0f_MY_uZg96zba90T55B3W_5atoxlRyxHg&oe=69E8C9C8"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG10GI-QRV4Q7kNvwEqtrIq&_nc_oc=Adr6kN4sxnCpPvfG-ntRnpbK5aWNHpYrIkdWE0SsQKLp-V98KIxZZJzFF9-2W8q_ATM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0djXDtAcF4C9f9_GpVT6CHtVDZwTRW3KP0md5qq1Gl4w&oe=69E8ACE7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36LpfZr_z6oQ7kNvwEbcsI1&_nc_oc=Ado-85RkD3acNniuv04F8qhyYMixSU1yPISKhSWxv0noyuQVpaZ5NumCOcRzj5sfTTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oFOXjCbEQzwshtaygxwcYQZzJpoGQ5HUyJfcJsO-lNw&oe=69E8B91E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy18pcDTDCcQ7kNvwENlika&_nc_oc=AdqFZQ7BuYBIGxQlbUxhHLxZGlCj63LKgqzPww2vhosBexWB5TP2-h4kLeaVq0na7pI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j1HDHL6Lsyvi7MFtxQnIOkeWOWwpCwdDO1fmoFfer7w&oe=69E8DCF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw7mZQZ2N7sQ7kNvwHohUqS&_nc_oc=Adr_pE0xV-9Qc9yfJBGl_we9Pi0
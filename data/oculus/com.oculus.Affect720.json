=scontent-sjc6-1.oculuscdn.com&oh=00_AfvfAUb9Pja4Lu5xn6U1gIg3kBBQQ6qVDWMxhWM1LKtPRg&oe=69985E48"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrhsHfrha6EQ7kNvwHclD30&_nc_oc=AdmJ7nw1ECAaZGi-aTGH6PRy143cXPOQCq3Y4lXcxA8lY_sr5vQrI9-bxFoll_fX15c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsZ1NczWA_F-M9Sic2QMSPTfteDVOP4EnT4MJCjOrmZ7Q&oe=69984167"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7dokTUPDXEQ7kNvwEdQoAT&_nc_oc=Adm5n3YPT7jNyq_Fs6I9PhgLPNfjdkCxZUQKqOaDz9_ee_jG7gn85_wNzEoJ0qjgOJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftmTBVPokgZol2a4Ll0u1jWLBXZWMKYbYGisCPyB04HTg&oe=69984D9E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQm6kZuUEj8Q7kNvwG_tWDa&_nc_oc=Adk7pre-V0uqkUjCPdGw3yqvsNHy-m9FZNjpL6VYXSrT_H9UzG9Bw2UDleJxaB35l9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftMgD4rzkdPbDhmOme511wG_xN_TD0sYcXLTzXlQOHGfQ&oe=69987170"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6ZWn7toizcQ7kNvwFBSPrA&_nc_oc=AdmuVxp9z7ZHnmro5qbxFjVRWJ8UHkmSeSxYW93crzV-4Jq1CT_qF_0SgbmIZRp8xWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftKOZ7cGRDeCnI37cjEI-58PrqOCr3tjQQ4n5ArHaVqjA&oe=69986A66"}, "
grated_image.png", "id": "231315318268280", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_417225378672678_4912493544880472064_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlAo22Z0x5oQ7kNvwE9yhVq&_nc_oc=AdpxvwcqT2eqtsvCmGHG4THEy8fYFWNBdXNNPazL-QqypwaoaSxp6JGDxI96sslKjbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9_alrvEl_MM1bD0G2FKFSHjvftCq-OLM49UC01OhiZQ&oe=6B09BA88"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk-roxbbe50Q7kNvwHIXISa&_nc_oc=AdpDfL5SilIKrUBtqjAe8YmTNqM6YFBMTaNjojdMB97J3bJPQ03RNvMx1ecOBX8hV2A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj6FdRRZ9E0Z3HkCtkAo4Oew0JTuxqxQyXbVtUL2qQdg&oe=6B099DA7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_Pl_jiRFfUQ7kNvwHblD0R&_nc_oc=AdrGbVQFL8eqNoHsqgkbVAluuRl7HLPzxvbkhF7vc3BjKR8w_SQWUf6Pm99-hqeKuyo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2UjKttJ8MG99KY2lxg6e__otBox6hc1qyptmxnLq2xg&oe=6B09A9DE"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEVPyQlsZQsQ7kNvwENAmH0&_nc_oc=Adra0eEGtDP7Cv5er9JRm1gI8wU5gpctf0HYS9Ll8gL6VcpRwprLTzgmHmDvbNly2_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKDEQMar2IN7QlhxxYhSMrFoU5Cv5PvCm42Y840-8Wzw&oe=6B09CDB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
gQ7kNvwEeg1xl&_nc_oc=Adqz-pGuG78E4PONYdnoXZNSmY8B7jCvLb5nrZVcOHvz3okZOqQzA-RIXjt-mZTCP8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TDXv7qO_RUY9R3HTGAQmSiGF2SgXNylUemOXxg3_anQ&oe=6A199148"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK4aFP7YnDkQ7kNvwGkW9zb&_nc_oc=AdoJ_fHoSFFoTZLCl5ZE7E1bRRL9sBzFfNv1pQL298mfgIUY54QQA0-chxNjI93D_rM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BmeBPowI7i6g8F7C-MuDONWe1JWaWkIJ7lfYdwfP5mw&oe=6A19ACA7"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L_XwTgtGUsQ7kNvwGmt_Sf&_nc_oc=Adr4-s3XmB-3Xwlx4voMM0iIv6M7SyrMytJh9JUejc7Wa5phP_-IhBFPuPfAnN6v76U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eG0KwLZgMNbrRsLnHyu1qnHUi3vbPbR15vW6GpYNylw&oe=6A19B8DE"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGPURYz-6mIQ7kNvwEmP_xP&_nc_oc=AdqQ94WDj1bCg6ndQ3hvem8o-gi9nq0mHhLVvRvB2r3CjNHb2H_xlIrZX808Vp6h614&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ImtqSSVKA4eZwX08g5sgy5Pm_LKn6B3BvfoWcx_FBzQ&oe=6A19A470"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CTduNOrV1UQ7kNvwFBlfKP&_nc_oc=AdqK7pkvy1UpnySPZF5TrkR0Bdj
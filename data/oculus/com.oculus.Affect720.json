8Q7kNvwEppqX9&_nc_oc=AdoEGvIghOdZQ5ECo5IFNLidPK66XbmzoQZ8nn1tSnGzEowxrv7rikAiYTqszbRfl-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I98bK13cuYKji53upkijwt_hk_m_C-uYEyAmlZ24Kpw&oe=6A3540C8"}, {"file_name": "migrated_image.png", "id": "1045745515793820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_345186819225360_8463322181634359296_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27MVvOPO138Q7kNvwEyqg0q&_nc_oc=Adr0L_67ifRRzuqwXGZcJFMTPuBhCnG82WDqKqOf-8jYAs1W7WMJEpIMwsl_BJxx0sQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q6a6MSqPVUtPiBPM_qKfq8eGLAl5JU1v9lmbWBibTxg&oe=6A355C27"}, {"file_name": "migrated_image.png", "id": "208565006909328", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162741_265666307269022_936834578889310208_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kGpJuZFAkMQ7kNvwEdpROD&_nc_oc=AdpwQCJKz656COjcusB8VYme58H5nJbr3OFvHToSg6BUW5A0XhUiI8kscBvAac440W8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gXZUQnnqfoVxvecCoPybtRQEJtiBVM1xSB7B39_8bKA&oe=6A35685E"}, {"file_name": "migrated_image.png", "id": "224407572087016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162726_114415772612159_1957637005366001664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tE2Tw345hwQ7kNvwHS5Voj&_nc_oc=AdpyD6LtsvTop4gS137Mbap1WaR-b20vnkhDbNvozUOh0k72vH8atTOaDB0xO8L4sRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mgk0TVEMp3CbCK8UyEO2Rl_YVDJTOf3rLCMzYdako7w&oe=6A3553F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTVR", "keywords": ["empathy"], "long_description": "Sometimes referred to as and Empathy Machine, Virtual Reality Video has the power to change lives - both of the viewer and of the subject. We make it easy to find amazing content that holds the power to do exactly that, and have a blast while doing it.\n\nTravel to far off lands, voyage under the sea or put yourself in the shoes of someone who has not been given all the advantages of the first world - and experience the power of immersive film making and the empathy it can create. \n\nWe aim to provide a platform for our story telling partners to share films that have the power to create good in the world, and a way for viewers to both entertain and educate themselves, while affecting real change. \n\nExplore. Excite. Affect Change.", "short_description": "An Immersive Media Plaform For Social Change - Affect Yourself, Affect the World\n\nWe provide our audience with a curated feed of the most spectacular Virtual Reality films that will entertain, while simultaneously educating and providing concrete ways to affect change within themselves and in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://underexposedagency.com/affectvr/privacy_policy.html", "developer_terms_of_service_url": "http://underexposedagency.com/affectvr/termsofservice.html", "publisher_name": "Affect[VR]", "support_website_url": null, "website_url": "http://www.brianhockensteincinema.com/affect-vr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "NARRATIVE", "MOVIE", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361860895773085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_110432226339779_2842953696352927744_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz6nG58g5LcQ7kNvwHEasfS&_nc_oc=AdpUT_ff-2DyIub6OF5saQlYyjY
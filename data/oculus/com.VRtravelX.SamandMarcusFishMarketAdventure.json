content-lga3-1.oculuscdn.com/v/t64.5771-25/38974653_1433560117256611_8317630692131838806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGWaUbhWjEIQ7kNvwHufgvs&_nc_oc=AdoSBZkOi053CHnLPyBKl_wMbDu_ghxpgNT3x6QBrh2735HXIMIlkBFuSBa5gMVVp3w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuqncfcRLVIbS_RgQoH8pCf9q0Lssih1JPQuPLFMQmPA&oe=6AA15CBE"}, {"file_name": "screen5.png", "id": "25163662986614057", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974663_25163662996614056_7476677478495086028_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq-hmy7dhVYQ7kNvwEemhWM&_nc_oc=Adp_uuhsaTt6ghECDyUtBbtr8P1fNLoL6mIvbJarRD3cB8jQX9ISh-cyHtAqzZvQM1I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPyjdXYzxKo937X5pA-WB1sjREN6GeNIwGX0INGPsXvg&oe=6AA14E66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sam and Marcus Hamburg Harbor Fish Market Adventure", "keywords": [], "long_description": "\"Sam & Marcus: A Hamburg Fish Market Adventure\" immerses you in a captivating 360\u00b0 VR experience where you and your friend Marcus set out to explore the vibrant atmosphere of the Hamburg Fish Market together.\n\nStepping into Sam's shoes, you enter a world as new as it is fascinating\u2014a place where every step tells a story. Marcus, though somewhat familiar with this bustling locale, shares your curiosity and excitement for joint discoveries. Together, you dive into the heart of the market, experiencing the energy of the criers, the freshness of the seafood, and the diversity of the stalls.\n\nThis journey is more than just a walkthrough; it's a shared discovery filled with laughter, wonder, and maybe one or two unexpected adventures. Along the way, Marcus shares his knowledge, impressions, and opens your eyes to the market's small wonders\u2014from secret delicacies to the stories behind the friendly faces.\n\n\"Sam & Marcus: A Hamburg Fish Market Adventure\" leverages VR immersion to place you right in the middle of the action. Every turn offers a new view, every conversation a deeper connection to the vibrant community that animates the market.\n\nAre you ready to experience the Hamburg Fish Market through Sam's eyes and with Marcus by your side? Join us on a journey that enlivens your senses and brings you closer to the unparalleled culture of one of the world's most lively markets.", "short_description": "Dive into 'Sam & Marcus: A Hamburg Fish Market Adventure'. This 360\u00b0 VR experience takes you and your friend Marcus on a shared exploration of the Hamburg Fish Market. From the dynamism of the criers to the hidden gems among the stalls, experience the allure of one of the most vibrant markets together. Ready for an unforgettable journey?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/fishmarket", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8486246771392291"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "4497131963851584"}, {"status": "PUBLISHED", "id": "992342029895848"}, {"status": "PUBLISHED", "id": "1610519073632665"}, {"status": "PUBLISHED", "id": "1562657838122580"}, {"status": "PUBLISHED", "id": "2037131813732207"}, {"status": "PUBLISHED", "id": "199539822794
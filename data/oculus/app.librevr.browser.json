e_name": "4-vr-mask-page.png", "id": "1644919440419008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620316_1644919443752341_2854512995597217219_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd1dQbvrV14Q7kNvwH62sQI&_nc_oc=AdqSljA5vsh43C016YddeoXNoIP17fWBD4yXBuzBb9JHXMJOVdrKPfsIAXKzPlebiBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUMU33X7ew-WrgiJr71Yzf2-yK1rgwi0A7l2POhoPd6xQ&oe=6B104E09"}, {"file_name": "1-browser-vr-button.png", "id": "2079241852751484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839731_2079241856084817_7272465494216445998_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNja_QZ8VtYQ7kNvwHSQgJu&_nc_oc=AdoJbak38JPNBS8Wpn4NMTNrmFfBzE706lVwWdiSwoaAKsPCSToUlqv6GGMlUIh7Bi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhC1NJsVtEwo0UIC1QLcFb-RrKkWZ35Tfiw5QxxejQdw&oe=6B106832"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Libre: VR Video Browser", "keywords": ["player", "180", "sbs", "browser", "video"], "long_description": "Libre is a web browser made for watching video in VR.\n\nBrowse any site like a normal browser. When you find a video, press its Fullscreen button (or Libre's \u25b6 VR button) and it opens in Libre's immersive player, picking up where you left off.\n\nTHE VR PLAYER\n\u2022 180\u00b0 and 360\u00b0 videos, flat or 3D (side-by-side and top-bottom)\n\u2022 Zoom with the thumbstick and move the picture up or down with A/B\n\u2022 Adjust 3D depth, width and height for a comfortable picture\n\u2022 Passthrough mode with an adjustable mask to see your room\n\u2022 Choose the stream quality, up to 8K\n\u2022 Play video files stored on your headset\n\u2022 Drag the menu wherever you want it\n\nTHE BROWSER\n\u2022 Tabs and bookmarks\n\u2022 Pop-up and redirect blocker\n\u2022 Desktop site mode\n\u2022 Find in page\n\u2022 \"Scan videos\" finds video files a page loaded, for players that aren't recognized\n\nPRIVATE BY DESIGN\nNo accounts, no ads, no tracking. Your browsing data stays on your headset, and you can clear it any time.\n\nLibre doesn't provide or host any content. Some websites or videos may not be playable.", "short_description": "A web browser with a built-in VR video player. Watch 180\u00b0, 360\u00b0 and 3D videos from the web or your headset, with zoom, positioning and comfort controls the standard browser doesn't have."}]}, "developer_name": "Libre VR", "developer_privacy_policy_url": "https://sites.google.com/view/librevr", "developer_terms_of_service_url": null, "publisher_name": "Libre VR", "support_website_url": null, "website_url": "https://sites.google.com/view/librevr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1176168644758392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628456_1139189215320722_3630286913769830035_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYny6jZBY20Q7kNvwEda_pU&_nc_oc=AdqSFsptXdAdCI5uwTFvSysWXpqrHSMPQgx2bgQEgLj69y6XpkBEXt5UmG5_CUBHlz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHVSoq9abet5a6ipBzuXAdHkeaiegF51FItVurzNdOzA&oe=6B106664"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Libre: VR Vid
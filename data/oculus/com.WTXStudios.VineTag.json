7_1356604333341471_5262468251646672768_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfzDiSfzEcIQ7kNvwESdqJD&_nc_oc=AdoKz557RhCOPpMmgnJ2WPifmGk6v_I6-SYgEb5hhRZrj65m_X21dqPQ5INf2BDH7R4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURA0lYhSOilBcfXaUxGfyKZxG8AgkIKF_3SOkMvhV8_A&oe=6B0F1B21"}, {"file_name": "Main_Custom..._18.07.2026_01-16-03.png", "id": "1411432437489450", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1411432440822783_7057132425180795736_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMk0UM5W7DYQ7kNvwH0P0My&_nc_oc=AdqnUWj79oJTZZxzNlDVfxh9MiqL_3-Tx424FOEzosFViuRCXTpkgSNSsltDxIUc6MU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWs3jcMA9zNI7kjKtNbW9lvaUKdEcX2g0boV6wt2o6AuQ&oe=6B0F0A21"}, {"file_name": "Main_Custom..._18.07.2026_01-15-55.png", "id": "1585049746622094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595136811_1585049749955427_43658817942947446_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQT4N7FwIlkQ7kNvwGglppO&_nc_oc=AdoTu-o6KzukvCeN8c_Owg7VjOdrprfyCwPuY9L8oPLrgrQtL1r-84MK12bgDilbako&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUujVxF-fsuAtKoK5r5kcoiGMJwziAZ6RmFn80CXMALIA&oe=6B0F221D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vine Tag", "keywords": ["tag", "monkey", "minigame", "horror", "locomotion"], "long_description": "Welcome to Vine Tag! Run, climb, swing on vines, and try not to get tagged. Vine Tag is a VR fan game inspired by Gorilla Tag, with hand-based movement and its own take on traversal using vines. Learn the map, improve your movement, and have fun playing with friends.", "short_description": "Welcome to Vine Tag! Vine Tag is a VR fan game inspired by Gorilla Tag, with a focus on movement, climbing, and tag. Swing on vines, climb around the map, and avoid the infected chimps as they chase you. Use hand-based movement to escape, take shortcuts, and explore different paths around the map. Play with friends, improve your movement, and see how long you can survive before getting infected.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtx-studios/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/wtx-studios/eula", "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtx-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27777312225236037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830467_1054039427581436_3488897646152096548_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2sS-21VnfcQ7kNvwE_DjKA&_nc_oc=AdotqqzDY-jsqr4QJZ0oBtRQcqGcUsgBWObsX3bPp6_ARmCOSlJDBeyRMT8HsII-e_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1izq_xcfky-lllvScWIRXDj3ybSp2MarBdY_Ot3bbKA&oe=6B0F1525"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vine Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id":
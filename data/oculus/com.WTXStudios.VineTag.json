_WVBCKHa6v4t6MAapWVPZz_I4aeBeW4zbgGWxZQ&oe=6A9C1455"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Forest_Custom..._25.12.2024_15-14-31.png", "id": "9022436164476254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468731143_9022436167809587_7997658571793145017_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kj0xuJvK54Q7kNvwF8YI-V&_nc_oc=Adq3550epfpOqqqYC-SIq0YeiMXFhBW6CM2DypkNxj7QQSs_xZutThDh8dzlhp8AOns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnn4ouCEP2KHFjKOwjDkqK30rNTykcNY76Ra-NzQA_rw&oe=6A9C1A32"}, "display_name": "Vine Tag!", "keywords": ["tag", "monkey", "minigame", "horror", "locomotion"], "long_description": "Welcome to Vine Tag, the jungle-inspired fan game where agility, quick reflexes, and strategy combine in an exciting VR playground. Swing from vine to vine, outsmart the \u201cit\u201d player, and explore a vibrant, jungle-themed environment. Just like in Gorilla Tag, players use their hands to tag others, but here, you\u2019ll be able to climb and swing through the treetops, adding a fresh layer of strategy and movement.\n\n", "short_description": "Welcome to Vine Tag, the jungle-inspired fan game where agility, quick reflexes, and strategy combine in an exciting VR playground. Swing from vine to vine, outsmart the \u201cit\u201d player, and explore a vibrant, jungle-themed environment. Just like in Gorilla Tag, players use their hands to tag others, but here, you\u2019ll be able to climb and swing through the treetops, adding a fresh layer of strategy and movement.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vine-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/vine-tag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
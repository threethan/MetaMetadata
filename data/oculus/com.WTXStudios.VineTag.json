7_1356604333341471_5262468251646672768_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfzDiSfzEcIQ7kNvwELjtKP&_nc_oc=AdqS2YJDkaArFII8y2Fb7w1BNJah34FS8qWXxTzwsZ7iwjjoEsFjXV1qjpdDyT4FiYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQC2AF3YoDDqd1k6zZkwtEayRRDjcCfg8E5XunHz44dvQ&oe=6B0C7821"}, {"file_name": "Main_Custom..._18.07.2026_01-16-03.png", "id": "1411432437489450", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1411432440822783_7057132425180795736_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSrpKgVa1DEQ7kNvwGMtmH8&_nc_oc=AdpMZdpHBPG5H_mmcT5GkPJA7lA5ULsapocB51BkrwlraakvkKKU9dqFQgrh2z2_eqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfJaXol3X1xGSdy9v_h-667kgtIFEMZ9MPb9bwI0SieQ&oe=6B0C6721"}, {"file_name": "Main_Custom..._18.07.2026_01-15-55.png", "id": "1585049746622094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595136811_1585049749955427_43658817942947446_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lPNfuLQwRkQ7kNvwEN_DBH&_nc_oc=Adqool5pprhShSOKMIZHxZoP3JhrHMKCi4T84SEm4SuHu8f5Pp5gwJydN7GpJiMTwq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6qLgjUCguqg-dP8lYZsB0BGmNvUufFDq4K6ygn40gYQ&oe=6B0C7F1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vine Tag", "keywords": ["tag", "monkey", "minigame", "horror", "locomotion"], "long_description": "Welcome to Vine Tag! Run, climb, swing on vines, and try not to get tagged. Vine Tag is a VR fan game inspired by Gorilla Tag, with hand-based movement and its own take on traversal using vines. Learn the map, improve your movement, and have fun playing with friends.", "short_description": "Welcome to Vine Tag! Vine Tag is a VR fan game inspired by Gorilla Tag, with a focus on movement, climbing, and tag. Swing on vines, climb around the map, and avoid the infected chimps as they chase you. Use hand-based movement to escape, take shortcuts, and explore different paths around the map. Play with friends, improve your movement, and see how long you can survive before getting infected.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtx-studios/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/wtx-studios/eula", "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtx-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27777312225236037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830467_1054039427581436_3488897646152096548_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_EPLdx_rtkQ7kNvwHctdb7&_nc_oc=AdpcTLjAJ2YwdSY97WLatvR1WT8RsiX6GV6cmNrE9SXpV25WUtyGmi382zrm9ARnY74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgZj69ZsZiMH1AJVM8Dvy0Y44DCvftyruTn3zireyRCw&oe=6B0C7225"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vine Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id":
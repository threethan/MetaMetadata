7_1356604333341471_5262468251646672768_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CIzXeg4qZ8Q7kNvwFLN2G8&_nc_oc=AdoTPuwzssT9_gn7Kh5DiQUBZAsDcxbgo29vXbQi3KWGB_5sC-31mMcUxjz__3oFBWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7gNmhnxrYRGW-Ko5sTRVkWtKKbErdXGQ5ZjddRo4Jkg&oe=6AFF10E1"}, {"file_name": "Main_Custom..._18.07.2026_01-16-03.png", "id": "1411432437489450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1411432440822783_7057132425180795736_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35u_3pf6OTAQ7kNvwGAcR74&_nc_oc=Adq0jROCVnX64Mxg7Hai3585cs9bA7GsReiFpyCMUYZXj08w7-OjCTOXhwyg34clCLk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0jUbx53C9W8xxNLZHu2Mz5TE9eme2tVKzm98-u43cYA&oe=6AFEFFE1"}, {"file_name": "Main_Custom..._18.07.2026_01-15-55.png", "id": "1585049746622094", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/595136811_1585049749955427_43658817942947446_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3cq94Uai8AQ7kNvwFXevCt&_nc_oc=AdpYDLJWx-4j09CoVor6gJJxUlwRllWpjHxvzRBbbw9fNbsxGLJLYphW2aGWkk9n_ns&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV0OIMrectnegLkPHES_f_3Z95JJ2IG0-K4jk4-ToUfQ&oe=6AFF17DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vine Tag", "keywords": ["tag", "monkey", "minigame", "horror", "locomotion"], "long_description": "Welcome to Vine Tag! Run, climb, swing on vines, and try not to get tagged. Vine Tag is a VR fan game inspired by Gorilla Tag, with hand-based movement and its own take on traversal using vines. Learn the map, improve your movement, and have fun playing with friends.", "short_description": "Welcome to Vine Tag! Vine Tag is a VR fan game inspired by Gorilla Tag, with a focus on movement, climbing, and tag. Swing on vines, climb around the map, and avoid the infected chimps as they chase you. Use hand-based movement to escape, take shortcuts, and explore different paths around the map. Play with friends, improve your movement, and see how long you can survive before getting infected.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtx-studios/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/wtx-studios/eula", "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtx-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27777312225236037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830467_1054039427581436_3488897646152096548_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSb_Y0pH4KgQ7kNvwFwO_4J&_nc_oc=Ado0NfLCgSlhmTcJhahHP-MtSkCKXQHSsp1MnjEfPPUTwHk4g-Nfo0Zt5UXDgeEBzHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfJXuxeOTMqQp7mu8x6ZYHZLrHAbK0vCmQHev0uGb3cw&oe=6AFF0AE5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vine Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id":
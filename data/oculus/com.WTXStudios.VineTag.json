7_1356604333341471_5262468251646672768_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZQc9vvFOg8Q7kNvwHcnx14&_nc_oc=AdrH7saBjYtAEYxe2s-0NqxF27t5GWgDpYIL5sjJwpMmzq92GcO-0x1nkgwGnNWPld8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Aap3R-4vfBWlh74Ua1cE8Zxwnl_HVIARaWQeOykBvA&oe=6AFB1C61"}, {"file_name": "Main_Custom..._18.07.2026_01-16-03.png", "id": "1411432437489450", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823812_1411432440822783_7057132425180795736_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwiGcVK1l4kQ7kNvwFmdNKp&_nc_oc=AdpC--nFfloRXrtRDxbUaWovpzoIlmA1fJrAhg2fKprzPMdgDV29Muo44F6E36NCjic&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm9X6kW1WTijZIDLOdtiabYjGTjMvKFQwbn8p8piZ0RA&oe=6AFB43A1"}, {"file_name": "Main_Custom..._18.07.2026_01-15-55.png", "id": "1585049746622094", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595136811_1585049749955427_43658817942947446_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-GTtkmfN04Q7kNvwF23PAF&_nc_oc=AdrxiBYWmBMsNlZE2w3vq6VI_GT7WiQJa1DKIhHW0Yg4rVNdAQ0byfTwH1sWhfvCc3o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4GEdwiIbp9AbnhDbeOyHI8iVN_CokC1rkIVgqQUhlLg&oe=6AFB235D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vine Tag", "keywords": ["tag", "monkey", "minigame", "horror", "locomotion"], "long_description": "Welcome to Vine Tag! Run, climb, swing on vines, and try not to get tagged. Vine Tag is a VR fan game inspired by Gorilla Tag, with hand-based movement and its own take on traversal using vines. Learn the map, improve your movement, and have fun playing with friends.", "short_description": "Welcome to Vine Tag! Vine Tag is a VR fan game inspired by Gorilla Tag, with a focus on movement, climbing, and tag. Swing on vines, climb around the map, and avoid the infected chimps as they chase you. Use hand-based movement to escape, take shortcuts, and explore different paths around the map. Play with friends, improve your movement, and see how long you can survive before getting infected.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtx-studios/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/wtx-studios/eula", "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtx-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27777312225236037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830467_1054039427581436_3488897646152096548_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_R4r_LemakQ7kNvwE8mZ7P&_nc_oc=AdrmIE8Rv5RJukgIRiyvRNXTE5AkrTKoJXCJnDODme9G9ubB8ij1ENKvdk2P-w8f3EA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQchWHw45UMMZQPy0ejfPgcwL7UMx_j44tBMVWnEtOVOQ&oe=6AFB1665"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vine Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id":
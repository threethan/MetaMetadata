 tag others, but here, you\u2019ll be able to climb and swing through the treetops, adding a fresh layer of strategy and movement.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vine-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/vine-tag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9070767026317173"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "421778617533562"}]}, "baseline_offer": {"id": "421778617533562"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735251240, "status": "PUBLISHED", "id": "421778617533562"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25286239691009982", "version": "4.3.9"}, "id": "2312877425730154", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8927484943978716", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25286239691009982"}, "release_status": "RELEASED"}, "bina
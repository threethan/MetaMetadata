43358404059036_5928577050093712994_n.png", "id": "1322488589328486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623384_1322488592661819_382048942036802864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4wKzVdc1cEQ7kNvwGoXLSb&_nc_oc=AdrcxK66-DrV2N4apCSpSPzFtL9Z3FGcc9rfK6py54F9QkRHifylfU7DBX5760Eat7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoVvxmu3Uf6HQ_Ac8c84Bt4np3fvywFhD_yhupL8C51g&oe=6AF0B46E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ClutchVR: Field", "keywords": [], "long_description": "# **ClutchVR**\n\nClutchVR is the first AI-powered VR platform built exclusively for tactical football learning. Designed for NCAA and NFL programs, ClutchVR converts your existing playbooks and game footage into fully immersive 3D simulations that players can study from the comfort of a seat \u2014 no physical movement, no setup complexity.\n\n## **How It Works**\n\nUsing the ClutchVR tablet app, coaches upload film and plays directly to the platform. The PlayScan Engine, powered by computer vision and AI, processes that footage into interactive VR environments that players can review from any angle \u2014 giving them the mental reps that translate to on-field performance.\n\n## **Built for Football Programs**\n\nClutchVR is a classroom and film room tool, not a training simulator. Players wear a Meta Quest headset while seated, consuming game film and play concepts in an entirely new dimension. It integrates seamlessly into existing practice and meeting schedules.\n\n## **Why ClutchVR**\n\nTraditional film study is flat. ClutchVR makes it spatial \u2014 helping players recognize formations, assignments, and situational awareness faster than ever before.", "short_description": "ClutchVR transforms football preparation with AI-powered VR film study. Convert playbooks and game footage into immersive 3D simulations \u2014 no physical movement required. Built for NCAA and NFL programs ready to train smarter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clutch-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ClutchVR", "support_website_url": null, "website_url": "https://clutch-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1154199601110153"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2227080758053692"}]}, "baseline_offer": {"id": "2227080758053692"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785522240, "status": "PUBLISHED", "id": "2227080758053692"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1219506231246156", "version": "1.0"}, "id": "1311846661122328", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1154199597776820", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219506231246156"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1311846661122328"}]}, "change_log": null, "created_date": 1791393530, "id": "1350129718183806", "version":
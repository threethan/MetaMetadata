e=6A901D42"}, "display_name": "Noclip VR", "keywords": ["horror", "free", "social", "action", "adventure"], "long_description": "Noclip VR is a multiplayer horror game with unique locomotion and proximity chat!. The Game has many unique levels with different puzzles and entities.\n\nInvite your friends and noclip out of the frontrooms now!\n\n\"If you're not careful and noclip out of reality in the wrong areas, you'll end up in the Backrooms, where it's nothing but the stink of old moist carpet, the madness of mono-yellow, the endless background noise of fluorescent lights at maximum hum-buzz, and approximately six hundred million square miles of randomly segmented empty rooms to be trapped in.\n\nGod save you if you hear something wandering around nearby, because it sure as hell has heard you.\"\n", "short_description": "Noclip VR is a co-op multiplayer backrooms game with unique locomotion and gameplay. The horror game has many unique levels and entities from the backrooms. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://superfps.com/privacypolicy.txt", "developer_terms_of_service_url": "https://superfps.com/TOS.html", "publisher_name": "SuperFPS", "support_website_url": null, "website_url": "https://superfps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7870829626
ity in the wrong areas, you'll end up in the Backrooms, where it's nothing but the stink of old moist carpet, the madness of mono-yellow, the endless background noise of fluorescent lights at maximum hum-buzz, and approximately six hundred million square miles of randomly segmented empty rooms to be trapped in.\n\nGod save you if you hear something wandering around nearby, because it sure as hell has heard you.\"\n", "short_description": "Noclip VR is a co-op multiplayer backrooms game with unique locomotion and gameplay. The horror game has many unique levels and entities from the backrooms. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://superfps.com/privacypolicy.txt", "developer_terms_of_service_url": "https://superfps.com/TOS.html", "publisher_name": "SuperFPS", "support_website_url": null, "website_url": "https://superfps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "29413329495019215"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623585_2119674012025657_4331949355327380901_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxZpKixIFKoQ7kNvwHWMu-G&_nc_oc=Adrr7iDXPDTUVf2a6V-TzXAXZ8ETCR7St1W7W4dL9Lq59itYH_H3c_r3pS3Ri_xOTds&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20
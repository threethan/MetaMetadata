jOdkZQTVOghMDLgX03grPAhz5g&oe=6B104FB4"}, {"file_name": "03-controls.png", "id": "2019521588732561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622162_2019521592065894_4935715928163797450_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT4K6k5OKWoQ7kNvwFJ18mo&_nc_oc=AdrEsQkRL_JEN0VUtAPxM9Cn-CTgJDxjAjJIzsaRaRa2CR0dYUnZFBso7rxvAN7gwG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVLgd5CTtLK6WOYE0Y878hh5QHxD4eVyBjWN64rK_FM4A&oe=6B10537B"}, {"file_name": "05-garden.png", "id": "1848825839700063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593919959_1848825843033396_6029336771736953631_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBTnf7Zy5a4Q7kNvwHr619R&_nc_oc=AdoeeBXMzNPPDK7xn6XF7j-Tw6Lb5nZ1xUKnzH6R1n_TgGXkUHrV9siM_yp7KBM5RU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUaTZWE4bHSXLPvpZ0OLD7sksd4TxnuoLH5yiy2GyvCdg&oe=6B106766"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ba Duan Jin \u00b7 \u516b\u6bb5\u9526", "keywords": [], "long_description": "Bring a quiet Ba Duan Jin practice space into your headset.\n\nFollow all eight traditional movements with a life-size stereoscopic video instructor in a landscaped virtual courtyard. Start with any section, pause to review a movement, replay a section, or continue through the sequence.\n\nFeatures:\n\u2022 All eight demonstration sections included.\n\u2022 Stereoscopic instructor video with original Chinese audio.\n\u2022 A mixed-reality selection menu and an immersive practice courtyard.\n\u2022 Controller ray selection, playback controls and recentering.\n\u2022 Offline playback after the complete app download.\n\u2022 One-time purchase; no in-app subscription or advertising.\n\nThe interface and instruction audio are in Chinese. Designed for Meta Quest 3 and Quest 3S. Practice standing with enough clear space to extend your arms and move safely.", "short_description": "Practice the eight movements of Ba Duan Jin in a peaceful virtual courtyard. Follow a life-size stereoscopic instructor, choose any section, and pause or replay at your own pace. Chinese interface and audio. For Meta Quest 3 and Quest 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sr2.tech/baduanjin-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SquareRootTwo", "support_website_url": "https://sr2.tech/index.html#contact", "website_url": "https://sr2.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1503707499481669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593875952_29952319637693803_6666027552470435941_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVNehkFcCKMQ7kNvwHm5GxX&_nc_oc=Ado8rqj9LUNpGANiK24FAIjTCTlbvE04DKbpyL7sYcclqXgut6bt2Ez0L4NwUiR5sG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYkQh_aA64P0H8Qh2a7RWRkBl9XgpOvOAXkExajoyUzg&oe=6B105A56"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ba Duan Jin \u00b7 \u516b\u6bb5\u9526", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_da
ription": "Practice the eight movements of Ba Duan Jin in a peaceful virtual courtyard. Follow a life-size stereoscopic instructor, choose any section, and pause or replay at your own pace. Chinese interface and audio. For Meta Quest 3 and Quest 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sr2.tech/baduanjin-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SquareRootTwo", "support_website_url": "https://sr2.tech/index.html#contact", "website_url": "https://sr2.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1503707499481669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593875952_29952319637693803_6666027552470435941_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPnugjjR8iwQ7kNvwHKLmiT&_nc_oc=AdrJ7eUtIxlvAvs-bGjKWN1YiTz5cHx1vnkex8Os1L3CwYMgym9tnRmzr7Ku1hFatx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhbFkStWs6Emue6FpOXrKghY555rv19GFi3gQZU8V-Aw&oe=6B0DB756"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ba Duan Jin \u00b7 \u516b\u6bb5\u9526", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_da
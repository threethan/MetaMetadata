, "id": "886202650663585", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295272_886202657330251_3889909548876004935_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eu_DnZ-bGT4Q7kNvwEirdKw&_nc_oc=AdrAeAFx0fHXHZ7IzPOQeBDw0IlU30Ks4rzSRsGoy6ENlZXjaC-8zSfCdiC3DfuWfps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIb7oqNU2frYNb-aEmNz5z_mwiI_KvXhoPui--yeQBYA&oe=6AB1591D"}, {"file_name": "Casting_Video_1768751387206 (6).png", "id": "2754921071507510", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_2754921074840843_4240604466051816074_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbLtw-DlYBwQ7kNvwEHXBh5&_nc_oc=Adp4LM4yvf4bZSHQ5nyxdxQZn1X7ji0fpuyGAl0KEWhZ4FQw7HRI4nqrxvZG4bOCjIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1k19_AeTQN8Zo4VdBqnpN358vFrz2omWjUvfo9kZMsA&oe=6AB14283"}, {"file_name": "Casting_Video_1768751387206.png", "id": "2668055520235085", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507828918_2668055523568418_17126060968458434_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hIHOKMt3mkQ7kNvwE5hqdb&_nc_oc=AdoDaEQeMoTnvnqtozujmdNPZ2B0jRtTP2UIMeV2u4aZsnZ_WsUKyEh3mZrZnszE-fo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMJMsRbpASUigXLnuszSHCFuMGUZDZA9NpPRO7p0n0JA&oe=6AB13E00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1203421521369682", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827718_1203421528036348_2651989266080759294_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICljl-fRqSAQ7kNvwGNTi58&_nc_oc=AdoJn2iWpEtG2bHksAdIeBP1VGOjvvksuX6tr8wvkWl8buEDyLXjblrDTqAx9QQenQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ-II1nhPKzANMzfAUg_Cs3pQa0tE4sXyoOlB8erkVzA&oe=6AB130C8"}, "display_name": "Arcane Flight", "keywords": ["Flight", "Simulator", "rc", "aircraft", "plane"], "long_description": "# Arcane Flight  is a radio-controlled aircraft flight simulator set in a breathtaking fantasy world!\n\nHere you can enjoy calm, relaxing flights and smooth gliding through the clouds \u2014 or jump into intense magical arena battles against enemies.\n\n**-Never flown an RC aircraft before?** No problem! The zero-gravity mode makes learning to fly easy and accessible.\n\n**-Are you a professional or an RC aviation enthusiast?** Then you\u2019ll love the variable-gravity mode \u2014 it\u2019s challenging, fun, and truly unique.\n\n**-Shooting and battling enemies** adds an unusual and exciting twist rarely seen in flight simulators.\n\nThe game also features a **Mixed Reality mode**, allowing you to fly in open real-world spaces.\n\n**Although this is not a hardcore professional simulator, the vector-based physics provide a surprisingly authentic sense of flight dynamics. \nThe controls are not arcade-style and require learning and practice.**\n\nThis game is made by a solo RC aviation hobbyist, for people who love model aircraft just as much.\n\nHave a great flight!", "short_description": "Arcane Flight is a radio-controlled aircraft flight simulator set in a breathtaking fantasy world!\n\nHere you can enjoy calm, relaxing flights and smooth gliding through the clouds \u2014 or jump into intense magical arena battles against enemies.\n\nNever flown an RC aircraft before? No problem! The zero-gravity mode makes learning to fly easy and accessible.\n\nAre you a professional or an RC aviation enthusiast? Then you\u2019ll love the variable-gravity mode \u2014 it\u2019s challenging, fun, and truly unique.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/arcaneflightvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "DwarvenCurse", "support_website_url": null, "website_url": "https://sites.google.com/view/arcaneflightvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925
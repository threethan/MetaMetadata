_nc_ohc=HyOD_NuMHPMQ7kNvwGn0QyO&_nc_oc=AdpMlEJcpl_Q7NeVB30QabkLFJ3Ff_TVYjfEsMxeDYWsGYs08ouD55XtE7DSSvDSSTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQYM5xdpCy14W3Cs_X-E9sh299dy65BAYXk9y6ehbsrw&oe=6AFC8095"}, {"file_name": "4.png", "id": "2517141225463204", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/756589809_2517141228796537_970780822119823115_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzVcns4DU5kQ7kNvwHFwpfA&_nc_oc=AdoH5SCiDhd2vRsnWOGeWMGO_zc69mgO1KQwgV9rDkiPyL88t0FkYbUZz4m39qttMoI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtSYh90BZcfSxfFFv4WfYqoCO9XEGgF--ZcoESC_WVFQ&oe=6AFC7E1D"}, {"file_name": "5.png", "id": "4566679093650673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673759338_4566679096984006_7617454332911877473_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi80X48yHUUQ7kNvwGlhL6d&_nc_oc=AdrAzedHk5EabNKicximqRRtJljwWzC1YmmRr0dCaA1xzkC52wVM1L1mWaZXe2WZ1s0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKVlG-mpDgHmW6KyAWgwSl-j8AzbJSfwZuJQbhijP5Zg&oe=6AFC91DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puzzling Pieces", "keywords": ["puzzling", "places", "pieces", "world", "jigsaw"], "long_description": "Welcome to Puzzling Pieces \u2013 The Ultimate 3D VR Spatial Jigsaw Adventure!\n\nUnwind and challenge your mind with Puzzling Pieces, an immersive VR puzzle game where you bring vibrant 3D miniature worlds to life! Move beyond flat 2D puzzles\u2014grab, rotate, and snap detailed low-poly environmental pieces together in a full 360-degree VR space.\n\nWhether you want a quick relaxing break or a brain-teasing challenge, Puzzling Pieces offers the perfect spatial puzzle experience for players of all skill levels.\n\n\ud83c\udf1f Key Features:\n\n3D Spatial Gameplay: Grab, rotate, and snap 3D environment pieces in full VR.\n\nBeautiful Low-Poly Lands: Rebuild ancient ruins, tropical forests, and natural landscapes.\n\nIntuitive Motion Controls: Smoothly pick up and snap pieces using your Quest controllers.\n\nMultiple Difficulties & Best Times: Choose your mode and challenge your best completion times.\n\nRelaxing & Mindful: Stress-free, immersive gameplay designed for pure relaxation.\n\n\ud83c\udfae How to Play:\n\nSelect a Land and choose your difficulty (Easy, Medium, or Hard).\n\nUse your controller triggers to grab scattered 3D pieces.\n\nMatch and snap each piece onto the floating grid to complete the diorama!\n\nPut on your headset and start rebuilding 3D worlds in VR today!", "short_description": "Step into Puzzling Pieces, the ultimate relaxing 3D VR jigsaw puzzle game! Rebuild beautiful low-poly environments piece by piece, customize difficulty levels, and snap together stunning 3D miniature worlds. Relax, focus, and solve immersion-packed puzzles at your own pace!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1343686155492094"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1
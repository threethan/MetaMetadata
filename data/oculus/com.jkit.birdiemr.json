cGbsNNdSi-DY8Fi1irMLPNEb9RQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYJjYlSPnLP8sBiwgMVGLbKJjl6v3kFzcmQ0KuOeyqCQ&oe=6B105360"}, {"file_name": "screenshot_5_mr_ball_line_2560x1440.png", "id": "1429021395874411", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622184_1429021399207744_3565304372195437033_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIerYJ9Dja4Q7kNvwGcFPjj&_nc_oc=Adqns5VfE5chmzJrWYOV5ttUcqyty1PjQegXpZY_4aMJfs21LMJtEnZTMqk8fgpQD2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWg_ptEZOGZBb1knjOJ9rmsKmRz49zWZxGelRSqjc9T3A&oe=6B104F21"}, {"file_name": "screenshot_4_mr_ball_cup_2560x1440.png", "id": "1446593137611907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593877129_1446593140945240_3107315303144683953_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSFOmePW6fQQ7kNvwH665vx&_nc_oc=AdoKhpAhq9pZUGkjrsxnSgAosmO8I1zkLEt7wEeKCLthdmixjZauw1VwiWFcGErLvaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1I_UjtPz23jPwO_F7sUc-LH2fQk6UM_QhZSJ2KbIiqQ&oe=6B106A60"}, {"file_name": "screenshot_3_putt_line_flag_2560x1440.png", "id": "1090649607290439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624583_1090649610623772_1729043161505906745_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JaDBP3No9YQ7kNvwHDC2me&_nc_oc=Adq0Xs8vWP0NzzJY4vyw6AOIOo4P9F3Zwvak1TnwSyelop1Ni01dvack6wvghaVWNaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUGSoJphb33nxrIg24jv8eC1g6MSC_st11CW4s2JfGhgQ&oe=6B10414D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BirdieKeeperMR", "keywords": [], "long_description": "Turn your room into a putting green. BirdieKeeperMR places a virtual green, cup and flag on your floor, and the headset cameras track your real golf ball as you putt and chip. No phone, controllers or extra sensors: you use your hands.\n\nIMPORTANT: you need a REAL putter, a real wedge and a REAL golf ball. The app measures your real shots and cannot be played without them.\n\nPUTTING AND APPROACH\n\u2022 Putt and chip on your own floor or mat\n\u2022 Your real shot continues on the virtual green: see carry, total, distance to the pin and spin\n\u2022 Practice at set distances, or play 9 or 18 holes and count your strokes\n\nCHALLENGE MODE\n\u2022 Chip onto three floating island greens on a lake and go for a hole-in-one\n\u2022 Results depend only on your shot: no random draws, no loot boxes\n\u2022 Buy practice balls with gold coins earned in the game. Coins cannot be bought with real money or cashed out\n\nWHAT YOU NEED\n\u2022 Meta Quest 3 or 3S (hand tracking)\n\u2022 A real putter, wedge and golf ball (white or yellow works best)\n\u2022 A flat floor or putting mat in a well-lit room\n\u2022 For chip shots: a net or a safe space\n\nTry it free for 30 minutes before you buy.\n\nChallenge scenery uses data from LINZ Data Service (CC BY 4.0, creativecommons.org/licenses/by/4.0) and \u00a9 OpenStreetMap contributors (ODbL). Not endorsed by LINZ or OpenStreetMap.", "short_description": "Practice putting and chipping with your real putter and ball on a virtual green in your room. Mixed reality golf practice for Meta Quest 3 and 3S. Requires a real putter, a real wedge and a real golf ball."}, {"images": {"nodes": []}, "id": "1787585775727605", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BirdieKeeperMR", "keywords": [], "long_description": "\ub0b4 \ubc29\uc774 \ud37c\ud305 \uadf8\ub9b0\uc774 \ub429\ub2c8\ub2e4. BirdieKeeperMR(\ubc84\ub514\ud0a4\ud37cMR)\uc740 \ubc29 \ubc14\ub2e5\uc5d0 \uac00\uc0c1 \uadf8\ub9b0, \ud640\ucef5, \uae43\ubc1c\uc744 \ub193\uace0, \ud37c\ud305\uacfc \uc5b4\ud504\ub85c\uce58\ub97c \ud560 \ub54c \ud5e4\ub4dc\uc14b \uce74\uba54\ub77c\ub85c \uc2e4\uc81c \uace8\ud504\uacf5\uc744 \ucd94\uc801\ud569\ub2c8\ub2e4. \ud3f0, \ucee8\ud2b8\ub864\ub7ec, \ubcc4\ub3c4 \uc13c\uc11c \uc5c6\uc774 \uc190\uc73c\ub85c \uc870\uc791\ud569\ub2c8\ub2e4.\n\n\uaf2d \ud655\uc778\ud558\uc138\uc694: \uc2e4\uc81c \ud37c\ud130, \uc2e4\uc81c \uc6e8\uc9c0, \uc2e4\uc81c \uace8\ud504\uacf5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774 \uc571\uc740 \uc2e4\uc81c \uc0f7\uc744 \uce21\uc815\ud558\ubbc0\ub85c \uc774\uac83\ub4e4 \uc5c6\uc774\ub294 \ud50c\ub808\uc774\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\n\n\ud37c\ud305\uacfc \uc5b4\ud504\ub85c\uce58\n\u2022 \ub0b4 \ubc29 \ubc14\ub2e5\uc774\ub098 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud37c\ud305\u00b7\uce69\uc0f7\n\u2022 \uc2e4\uc81c \uc0f7\uc774 \uac00\uc0c1 \uadf8\ub9b0 \uc704\ub85c \uc774\uc5b4\uc9c0\uace0 \uce90\ub9ac\u00b7\ucd1d \uac70\ub9ac\u00b7\ud540\uae4c\uc9c0 \uac70\ub9ac\u00b7\uc2a4\ud540\uc744 \ud45c\uc2dc\n\u2022 \uc815\ud574\uc9c4 \uac70\ub9ac\ub85c \uc5f0\uc2b5\ud558\uac70\ub098 9\ud640\u00b718\ud640\uc744 \ub3cc\uba70 \ud0c0\uc218 \uae30\ub85d\n\n\ucc4c\ub9b0\uc9c0 \ubaa8\ub4dc\n\u2022 \ud638\uc218 \uc704\uc5d0 \ub5a0 \uc788\ub294 \uc138 \uac1c\uc758 \uc12c \uadf8\ub9b0\uc73c\ub85c \uce69\uc0f7\ud574 \ud640\uc778\uc5d0 \ub3c4\uc804\n\u2022 \uacb0\uacfc\ub294 \uc624\uc9c1 \ub0b4 \uc0f7\uc5d0 \ub2ec\ub824 \uc788\uc2b5\ub2c8\ub2e4. \ubb34\uc791\uc704 \ubf51\uae30\ub3c4, \ud655\ub960\ud615 \uc0c1\uc790\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4\n\u2022 \uac8c\uc784\uc5d0\uc11c \ubaa8\uc740 \uae08\ud654\ub85c \uc5f0\uc2b5 \uacf5\uc744 \uad6c\uc785. \uae08\ud654\ub294 \uc2e4\uc81c \uacb0\uc81c\ub85c \uc0b4 \uc218 \uc5c6\uace0 \ud604\uae08\uc73c\ub85c \ubc14\uafc0 \uc218\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4\n\n\uc900\ube44\ubb3c\n\u2022 Meta Quest 3 \ub610\ub294 3S (\uc190 \ucd94\uc801)\n\u2022 \uc2e4\uc81c \ud37c\ud130, \uc6e8\uc9c0, \uace8\ud504\uacf5 (\ud770\uc0c9\uc774\ub098 \ub178\ub780\uc0c9 \uacf5\uc774 \uac00\uc7a5 \uc798 \uc778\uc2dd\ub428)\n\u2022 \ubc1d\uc740 \uc2e4\ub0b4\uc758 \ud3c9\ud3c9\ud55c \ubc14\ub2e5\uc774\ub098 \ud37c\ud305 \ub9e4\ud2b8\n\u2022 \uce69\uc0f7: \ub124\ud2b8\ub098 \uc548\uc804\ud55c \uacf5\uac04\n\n\uad6c\ub9e4 \uc804\uc5d0 30\ubd84 \ubb34\ub8cc \uccb4\ud5d8\uc73c\ub85c \ud655\uc778\ud574 \ubcf4\uc138\uc694.\n\n\ucc4c\ub9b0\uc9c0 \ubc30\uacbd\uc740 LINZ Data Service(CC BY 4.0, creativecommons.org/licenses/by/4.0)\uc640 \u00a9 OpenStreetMap contributors(ODbL)\uc758 \ub370\uc774\ud130\ub97c \uc0ac\uc6a9\ud588\uc2b5\ub2c8\ub2e4. LINZ \ubc0f OpenStreetMap \uc774 \ubcf4\uc99d\ud558\uac70\ub098 \uc81c\ud734\ud55c \uac83\uc774 \uc544\ub2d9\ub2c8\ub2e4.", "short_description": "\ub0b4 \ubc29 \ubc14\ub2e5\uc5d0 \ud3bc\uccd0\uc9c4 \uac00\uc0c1 \uadf8\ub9b0\uc5d0\uc11c \uc2e4\uc81c \ud37c\ud130\uc640 \uacf5\uc73c\ub85c \ud37c\ud305\u00b7\uc5b4\ud504\ub85c\uce58\ub97c \uc5f0\uc2b5\ud558\uc138\uc694. Meta Quest 3\u00b73S\uc6a9 \ud63c\ud569\ud604\uc2e4(MR) \uace8\ud504 \uc5f0\uc2b5 \uc571. \uc2e4\uc81c \ud37c\ud130, \uc6e8\uc9c0, \uace8\ud504\uacf5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"images": {"nodes": []}, "id": "1089393590375983", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BirdieKeeperMR", "keywords": [], "long_description": "Turn your room into a putting green. BirdieKeeperMR places a virtual green, hole and flag on your floor, and the headset cameras track your real golf ball as you putt and chip. No phone, controllers or extra sensors: you use your hands.\n\nIMPORTANT: you need a REAL putter, a real wedge and a REAL golf ball. The app measures your real shots and cannot be played without them.\n\nPUTTING AND APPROACH\n\u2022 Putt and chip on your own floor or mat\n\u2022 Your real shot continues on the virtual green: see carry, total, distance to the pin and spin\n\u2022 Practise at set distances, or play 9 or 18 holes and count your strokes\n\nCHALLENGE MODE\n\u2022 Chip onto three floating island greens on a lake and go for a hole-in-one\n\u2022 Results depend only on your shot: no random draws, no loot boxes\n\u2022 Buy practice balls with gold coins earned in the game. Coins cannot be bought with real money or cashed out\n\nWHAT YOU NEED\n\u2022 Meta Quest 3 or 3S (hand tracking)\n\u2022 A real putter, wedge and golf ball (white or yellow works best)\n\u2022 A flat floor or putting mat in a well-lit room\n\u2022 For chip shots: a net or a safe space\n\nTry it free for 30 minutes before you buy.\n\nChallenge scenery uses data from LINZ Data Service (CC BY 4.0, creativecommons.org/licenses/by/4.0) and \u00a9 OpenStreetMap contributors (ODbL). Not endorsed by LINZ or OpenStreetMap.", "short_description": "Practise putting and chipping with your real putter and ball on a virtual green in your room. Mixed reality golf practice for Meta Quest 3 and 3S. Requires a real putter, a real wedge and a real golf ball."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jkitsolutions.co.nz/birdiekeepermr-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "JKIT Solutions", "support_website_url": "https://jkitsolutions.co.nz/#contact", "website_url": "https://jkitsolutions.co.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "ko"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2599164287163169"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1152238724038662"}]}, "baseline_offer": {"id": "1152238724038662"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793680680, "status": "PUBLISHED", "id": "1152238724038662"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2638595953220002", "version": "1.1.474"}, "id": "1597108182430295", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2599164273829837", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2638595953220002"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1597108182430295"}]}, "change_log": "NEW: COURSE PLAY\n\u2022 Play full 18-hole rounds on two real-world-inspired courses (W Course and M Course) with your real ball and clubs\n\u2022 Choose FULL (approaches and putts) or PUTTING (greens only) rounds, tee and mulligans\n\u2022 Booster dial for long holes: swing in your space, the ball flies the full distance (x1.2 to x3.0)\n\u2022 Within 40 m of the pin there is no boost - every approach and putt is 100% measured\n\u2022 Hole map, distance to pin, shot tracer and scorecard on every hole\n\u2022 Course scenery and new courses update automatically when the app starts\n\nIMPROVEMENTS\n\u2022 Updated to Meta XR SDK v209\n\u2022 Better ball recognition for approaches, including fast and low shots\n\u2022 Putting: the putter head is no longer mistaken for the ball, and hole-outs now follow realistic cup and flagstick physics\n\u2022 Smoother hole loading and steadier frame rate on Meta Quest 3 and 3S\n\u2022 Settings apply instantly\n\u2022 Louder booster flight sound, no mid-flight bang\n\nMeta Quest 3 or 3S required.", "created_date": 1794623315, "id": "2638595953220002", "version": "1.1.474", "version_code": 474, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset
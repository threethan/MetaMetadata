478_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oKXmukXTO0Q7kNvwEPTdMX&_nc_oc=Adpl9Q7Al4MccGklnvtGqQjG1VUwboRbF9QUbY7HPALlt0tNsedxqxUFn7SO8DC6HiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u6eUz4Gg0ite7SS6i9uJbgDGqixV_exV_JklAij_LUg&oe=6A3BE5B7"}, {"file_name": "SS6Lobby.png", "id": "2072334393720496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_2072334397053829_2974435395988751372_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFNMT0t-fTAQ7kNvwGdGddH&_nc_oc=AdpVt2SHV7ECm08vP0kOVLW80QSRqK2oxU9s3xACSWgM-GM3nmSKjqB0Ykc5N7YaWJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HZC-WVu2z7LGcTDCAelBOxQtnn6XnzjJDnc7-be6eZw&oe=6A3BE86E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dreamy VR", "keywords": ["Dreamcore", "Dreamy", "Horror", "Gorilla", "Ape"], "long_description": "Dreamy VR is a dreamcore VR game where you feel like you are stuck inside a weird dream. The world keeps changing and nothing feels normal. You play with friends or strangers and try to escape the dream together. Each level is different with new places, objectives, and strange entities that try to find you. You have to work together to stay alive and find the way out. Sometimes you feel safe, and then suddenly something changes and you are in danger again.\n", "short_description": "Dreamy VR, A Dreamcore inspired game with multiple levels with unknown entities play with friends or strangers to escape the dream"}]}, "developer_name": "Trapwork Studios", "developer_privacy_policy_url": "https://sites.google.com/view/traxzz-games/main-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trapwork Studios", "support_website_url": null, "website_url": "https://dreamyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {
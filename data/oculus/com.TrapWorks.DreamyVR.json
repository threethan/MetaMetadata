751372_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gSHMPCGLsYQ7kNvwGsdMrK&_nc_oc=Adog3WnY98eK0Nv5z8xS841_Nm6546jHvQ4NPhUhjLG8WRwWPZXsdGS9qrPtTQuoXAY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qArttGdx2DtCT8y1wMAyMHG2p3rGh-e3k0YivtOd3oA&oe=6A46746E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dreamy VR", "keywords": ["Dreamcore", "Dreamy", "Horror", "Gorilla", "Ape"], "long_description": "Dreamy VR is a dreamcore VR game where you feel like you are stuck inside a weird dream. The world keeps changing and nothing feels normal. You play with friends or strangers and try to escape the dream together. Each level is different with new places, objectives, and strange entities that try to find you. You have to work together to stay alive and find the way out. Sometimes you feel safe, and then suddenly something changes and you are in danger again.\n", "short_description": "Dreamy VR, A Dreamcore inspired game with multiple levels with unknown entities play with friends or strangers to escape the dream"}]}, "developer_name": "Trapwork Studios", "developer_privacy_policy_url": "https://sites.google.com/view/traxzz-games/main-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trapwork Studios", "support_website_url": null, "website_url": "https://dreamyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interact
"id": "420761638484071", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974851_420761641817404_97441984628654080_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADXtQXQTyZkQ7kNvwHyiZb1&_nc_oc=AdptWA64ItLbXZ3Uzs1te8KaU8A67Y2x-BnmU5t0oDasGcwWAvXZd6XnW-t3Wcz95eQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTZQZAib_fjQ4u5EpCWbIQ-4wOLR5hbrz8YQJAL1yIAg&oe=6B086B94"}, "display_name": "Afterlife", "keywords": ["afterlife", "interactive", "film", "narrative", "drama"], "long_description": "After the tragic death of their family member, a family struggles with the loss of their familial anchor and attempts to mend their frayed bonds. Experience the struggle through the ghostly eyes of the deceased, unable to rest while the turmoil of their death has trapped the family in their grief. Using a cutting-edge VR filming technique, Afterlife takes the audience through a 360 VR branching narrative that seamlessly reveals a story that shifts based on the characters that the player chooses to follow and the objects activated within the environment.\n\nAfterlife is available on the Oculus Rift, Oculus Go and Gear VR.", "short_description": "Witness a tragic death in a family; explore each member\u2019s grief through seamlessly integrated narrative storylines in live-action 360 VR."}]}, "developer_name": "Signal Space Lab", "developer_privacy_policy_url": "http://afterlife-vr.com/privacy-policy/", "developer_terms_of_service_url": "http://afterlife-vr.com/terms-of-use/", "publisher_name": "Signal Space Lab", "support_website_url": "http://afterlife-vr.com/contact/", "website_url": "http://afterlife-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area"
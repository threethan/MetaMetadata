uscdn.com/v/t64.5771-25/499303445_1926443304815058_2198535171164593519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKqGYB5eeiYQ7kNvwGHROjc&_nc_oc=Adk2PvXy4xfEhcD-Hle8EykyW5mj4NmaJqAj7E0uAU8PWNUq0het9GZaIx-84U4J_AY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfybGabzBqszSixSAK51Ny1GZPSrtididPbBkVPXAYNXCw&oe=69BFDBBC"}, "display_name": "Paintball Playground", "keywords": ["Paintball", "Esports", "Competitive", "PvP", "Shooter"], "long_description": "# Welcome to Paintball Playground - Ultimate VR Paintball Experience! #\n\n- Experience the thrill of paintball like never before with Paintball Playground VR. Enjoy fenomenal immersion that makes every shot and dodge feel real. Perfect for beginners and pros alike, learn to play and master the game in a safe, exciting virtual environment.\n\n{3942689556034089}\n\n\n- Practice with you team on official **NXL layouts**.\n\n{771752829036865}\n\n\n- Flex and shine on the field with our gear from Web Shop.\n\n{1441238280825424}\n\n- Find a team and compete in our one of a kind **Virtual Paintball League**.\n\n{910213301890462}\n\n-  Create your own maps using our **Layout Editor**.\n\n{2755802601434006}\n\n\nJoin **Discord - Paintball Playground  VR** Our community is the best!\n\n{2027530124778886}\n\n", "short_description": "ESports Virtual Paintball"}]}, "developer_name": "Triangle World", "developer_privacy_policy_url": "https://docs.google.com/document/d/194s8a8vzVsUShK1w8oqQPfaZwRIygvrHuM_dXV14jxU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Triangle World", "support_website_url": "https://help.xsolla.com/ru", "website_url": "https://paintball-playground-vr.xsollasitebuilder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "
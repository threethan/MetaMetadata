r_thumbnail": {"file_name": "Landscape.png", "id": "1480524140082333", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823790_1480524143415666_5469891196766940771_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bltgdga0BuQQ7kNvwGwco4_&_nc_oc=Adp_bPhMzIzopNILEsvawNQaKx7Fj_dSOEiLlAf7bugVIoGsnAY1dCOogNYwn0N751M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwmm5OM9XDqEqEyKxjzS7OzXGZywJCyRbBAWKZNq3IBqg&oe=69C2A235"}, "display_name": "Paintball Playground", "keywords": ["Paintball", "Esports", "Competitive", "PvP", "Shooter"], "long_description": "# Gameplay #\n\n- Experience the thrill of paintball like never before with Paintball Playground VR. Enjoy fenomenal immersion that makes every shot and dodge feel real. Perfect for beginners and pros alike, learn to play and master the game in a safe, exciting virtual environment.\n{1471521487824709}\n\n# Customization #\n\n\n- Upgrade your gun, switch outfits and accessories using our gear from **Web Shop**.\n{1441238280825424}\n\n# Level Editor #\n\n-  Create your own maps using our **Layout Editor**.\n{2755802601434006}\n\n\n\n# Community #\n\n\n- We have really friendly players, so dont hesitate to Find **Friends**, chat and have a good time!\n{2777767019227780}\n\n\n\n# Tournaments # \n\n- Find a team and compete in our one of a kind **Virtual Paintball League**.\n{1472051784634303}\n\n\n- Join **Discord - Paintball Playground  VR** to stay tuned with updates and tournaments.\n{2027530124778886}\n\n\n\n", "short_description": "ESports Virtual Paintball"}]}, "developer_name": "Triangle World", "developer_privacy_policy_url": "https://docs.google.com/document/d/194s8a8vzVsUShK1w8oqQPfaZwRIygvrHuM_dXV14jxU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Triangle World", "support_website_url": "https://help.xsolla.com/ru", "website_url": "https://paintball-playground-vr.xsollasitebuilder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comf
AdpfpNcmPsFrTvWwz4AGXGV6eREMTb1SymXQr6l4N59gKxyI95tb95JcbtQ7Lg9mStg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYTDEqP1ucgNU2gMGi3Y1Zd0Pi4T_QnPmi_ScCTa2dzA&oe=6B0DD1D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1480524140082333", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_1480524143415666_5469891196766940771_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nchkla_tKTcQ7kNvwGYFWQO&_nc_oc=Adp__rOU-mCFXqhn0sIL2mx84JHW-TK1JnWm4wpEXbxWMA8M1JdpOJ_ZibKE2Ta4THY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYBjIgCxOMEmlxlnvhLFrW-Vvvuh7j_YPYdZkadiPv5A&oe=6B0DC2F5"}, "display_name": "Paintball Playground", "keywords": ["Airsoft", "Multiplayer", "PvP", "Guns", "FPS"], "long_description": "Grab your marker, drop behind a bunker, and make your move. Paintball Playground VR is fast, messy, full-body paintball you can play anytime with players from around the world.\n\n# Gameplay #\n\n- Sprint between bunkers, peek, dodge and land the perfect shot. Every hit splats, every dive feels real. New to paintball? Jump in and learn as you play. Already a pro? Climb the ranks and prove it.\n{1471521487824709}\n\n# Customization #\n\n- Make your player one of a kind. Upgrade your marker, then mix and match outfits, masks and accessories from the **Web Shop** until your look is unmistakable on the field.\n{1441238280825424}\n\n# Level Editor #\n\n- Build the arena you've always wanted. Place bunkers, design lanes and create your own maps with the **Layout Editor**, then play them with friends.\n{2755802601434006}\n\n# Community #\n\n- Our players are some of the friendliest in VR. Add **Friends**, chat in the lobby, squad up and have a great time between matches.\n{2777767019227780}\n\n# Tournaments #\n\n- Think you've got what it takes? Form a team and compete in our one-of-a-kind **Virtual Paintball League**.\n{1472051784634303}\n\n- Join **Discord - Paintball Playground VR** for updates, tournament announcements and teammates.\n{2027530124778886}", "short_description": "Fast, messy, full-body paintball in VR. Duck behind bunkers, dodge incoming shots and splat players from around the world in team matches. Customize your marker and outfit, build your own maps in the Layout Editor, and compete in the Virtual Paintball League. Easy to learn, hard to master."}]}, "developer_name": "Triangle World", "developer_privacy_policy_url": "https://docs.google.com/document/d/194s8a8vzVsUShK1w8oqQPfaZwRIygvrHuM_dXV14jxU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Triangle World", "support_website_url": "https://help.xsolla.com/ru", "website_url": "https://paintball-playground-vr.xsollasitebuilder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28079666391710240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1949421932620088_1790242787275902705_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JznCWK8BwfYQ7kNvwEoEy7a&_nc_oc=AdrW3cTc1PQr2-9CpsvxxSmr-spXh02P36irqbp98bSG_6_hyDBmwkJighKhBY02a6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh
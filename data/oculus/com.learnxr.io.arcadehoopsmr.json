name": "Screenshot_2.png", "id": "2544910385962115", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620432_2544910392628781_8576983261726965408_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k5KVWulXxYQ7kNvwF2kVT2&_nc_oc=AdrVGOoIOPjolxcHR0nPpVTVL1eBDfkxvsbIPWVmzxrOOI0nZDacvOaG-lyEGPBzrvQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIs_8lkflHp-CKpUDkp6IsZuavsBEPomgeqFcunEOK2g&oe=6A92C4ED"}, {"file_name": "Screenshot_3.png", "id": "979608861754355", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/604298355_979608865087688_2154459271389257656_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8-McRlOEfAQ7kNvwHvjgPD&_nc_oc=AdpItt0B12BQzH7bW6Jt3RIPd1Lz9b_CT2GQUR14EwPht0i5JtKuPme_7eR6tZiHMVA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIVJubZONxHYuL3noZx78e-w7nKhQ0sKh7zR4j9LT1vQ&oe=6A92C27A"}, {"file_name": "Screenshot_4.png", "id": "997740865958352", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619588_997740872625018_2365645715313249635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JypRg5QHw5QQ7kNvwFlLyde&_nc_oc=Adr8QNW1qEJwcM4Yoh01ZfPBuQ3Kt3j_E1HfvShagDy5uvooxKj3mOAohdMe9-zGAKI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2zKrKck3r6mvQdT5qp0Mlkl2p1M4GBNrfNl_Tq6Ag5A&oe=6A92D5DA"}, {"file_name": "Screenshot_5.png", "id": "2154020525329036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620504_2154020528662369_2693051855238082446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHwRWhSOGE4Q7kNvwGRNSMz&_nc_oc=AdoYcEkD_oytY2hskIPVWLxyDSNQJ2L-fQtaBEuBav3Cvbygva3NlP19rzxHA58sppU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDtikwGfk6SK9Aud18qWL1iAxDhHt44wHEoGUt_nqZFg&oe=6A92B19F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "995594262871211", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619681_995594266204544_7711575102498344673_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bje9ZzZY50cQ7kNvwGSBZVt&_nc_oc=AdpCGP0AbHNTusGk3dZdxQocRoF-D5DOdsB9L2lI3LMCVu8puqQZzzCRGutIN6M6xNk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOkUTpNHxTHakFnvurXY07CP-oWLPG_g70iDBOePzKvw&oe=6A92C042"}, "display_name": "Arcade Hoops", "keywords": ["basketball", "arcade", "tabletop", "sports", "handtracking"], "long_description": "**Arcade Hoops** is a tabletop basketball game built for quick, fun sessions. Place the basketball court in your room, shoot with your hands, hit bonus targets, build streaks, and compete for your best score.\n\n{1780006693378832}\n\nTurns your room into a mixed reality basketball arcade, using scene setup to detect your walls, ceiling, and floor for creative bounce shots and bonus points. In later rounds, bonus targets appear around your room, giving you extra ways to score, build streaks, and chase your best run before time runs out.\n\n{27937945882457098}\n\n**Features:**\n\n* **Tabletop Mixed Reality Basketball**: Place a mini basketball court in your room and shoot hoops in your real-world space.\n\n* **Hand Tracking Gameplay**: Aim, pull, and release shots using your hands for a simple and natural shooting mechanic.\n\n* **Room-Based Trick Shots**: Use Scene Setup to bounce the ball off detected walls, ceilings, and floors for bonus points.\n\n* **Bonus Targets**: Hit special targets around your room in later rounds to earn extra points and build bigger combos.\n\n* **Leaderboards, Achievements, & Streaks**: Chase high scores, unlock achievements, and keep improving your best run across quick arcade-style rounds.\n", "short_description": "Arcade Hoops is a tabletop basketball game built for quick, fun sessions. Place the court in your room, shoot with your hands, hit bonus targets, build streaks, and compete for your best score."}]}, "developer_name": "Dilmer Valecillos", "developer_privacy_policy_url": "https://www.learnxr.io/arcadehoops-privacy", "developer_terms_of_service_url": null, "publisher_name": "Learn XR Labs", "support_website_url": null, "website_url": "https://www.learnxr.io/labs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1676485315806614"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27787222360877951"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1700908174265609"}]}, "baseline_offer": {"id": "1700908174265609"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781202480, "status": "PUBLISHED", "id": "1700908174265609"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28481340884799425", "version": "beta-1.0.14"}, "id": "993799189682298", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27787222314211289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28481340884799425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784845873, "id": "28765372009729643", "version": "beta-1.0.15", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27787222314211289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28481340884799425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "993799189682298"}]}, "change_log": "- New theming system that recolors the entire game (court, menus, HUD, hoop, ball, room, effects) from a single palette.\n- Five themes in the Visuals menu: Default, Light, Dark, plus NBA New York Knicks (blue/orange) and San Antonio Spurs (silver/black/white).\n- Themed hoop (rim, bracket, backboards) and ball (base color, fire trail, aim line).\n- Themed dividers, wall equalizers, room outlines, and the achievements panel.\n- Themed low-time countdown warning, the Music/SFX/Handles toggles, and the score/time/stats readouts.\n- Saved theme now applies before the first frame, so there's no color flash on launch.\n- Fixed the move/rotate handle hint lines briefly showing the wrong color on a cold start.", "created_date": 1782693351, "id": "28481340884799425", "version": "beta-1.0.14", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27787222314211289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28481340884799425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782685040, "id": "28480405844892929", "version": "beta-1.0.13", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27787222314211289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28481340884799425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "993799189682298"}]}, "change_log": "- Swappable theme system: themes as ScriptableObjects that re-tint the entire game (playfield, menus, HUD, hoop, onboarding, wall targets, power indicators, court floor) from one palette, with an in-game picker in the Visuals menu and an in-Inspector \"Apply Theme (Editor)\" preview.\n- 5 themes: Default, Light, Dark, plus two real NBA team themes \u2014 Knicks (royal blue / orange) and Spurs (silver / black / white).\n- Deep text & surface control: separate colors for outlines, dividers, panel fills, titles, body/button text, and per-card HUD value readouts (score/time/stats), plus the low-time countdown warning.\n- Hoop theming: independent colors for the rim, bracket, backboard outer rectangle, and inner square (and a regenerated clean backboard texture so outlines aren't doubled).\n- Ball theming: base color, fire-trail gradient, and the pull-back aim-line color, each per theme.\n- Wall equalizer theming: base + accent colors for the Court/Room audio visualizers.\n- Achievements panel theming: unlocked-row highlight, unlocked-row background tint, panel title, accent, and dim-text colors.\n- Themed toggle pills: Music / SFX / Handles toggles now follow the same active-pill highlight as the Visualizers toggle.\n- Layout options: independent theme-button height and Themes-group height in the Visuals panel.\n- Reliability polish: saved theme now applies before the first frame (no flash on launch), plus a fix for the move/rotate handle hint line briefly showing the wrong color on cold start.", "created_date": 1782193018, "id": "28413695241563990", "version": "beta-1.0.12", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27787222314211289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28481340884799425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782191846, "id": "28413516658248515", "version": "beta-1.0.11", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
fPBuQ3Kt3j_E1HfvShagDy5uvooxKj3mOAohdMe9-zGAKI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2zKrKck3r6mvQdT5qp0Mlkl2p1M4GBNrfNl_Tq6Ag5A&oe=6A92D5DA"}, {"file_name": "Screenshot_5.png", "id": "2154020525329036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620504_2154020528662369_2693051855238082446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHwRWhSOGE4Q7kNvwGRNSMz&_nc_oc=AdoYcEkD_oytY2hskIPVWLxyDSNQJ2L-fQtaBEuBav3Cvbygva3NlP19rzxHA58sppU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDtikwGfk6SK9Aud18qWL1iAxDhHt44wHEoGUt_nqZFg&oe=6A92B19F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "995594262871211", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619681_995594266204544_7711575102498344673_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bje9ZzZY50cQ7kNvwGSBZVt&_nc_oc=AdpCGP0AbHNTusGk3dZdxQocRoF-D5DOdsB9L2lI3LMCVu8puqQZzzCRGutIN6M6xNk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOkUTpNHxTHakFnvurXY07CP-oWLPG_g70iDBOePzKvw&oe=6A92C042"}, "display_name": "Arcade Hoops", "keywords": ["basketball", "arcade", "tabletop", "sports", "handtracking"], "long_description": "**Arcade Hoops** is a tabletop basketball game built for quick, fun sessions. Place the basketball court in your room, shoot with your hands, hit bonus targets, build streaks, and compete for your best score.\n\n{1780006693378832}\n\nTurns your room into a mixed reality basketball arcade, using scene setup to detect your walls, ceiling, and floor for creative bounce shots and bonus points. In later rounds, bonus targets appear around your room, giving you extra ways to score, build streaks, and chase your best run before time runs out.\n\n{27937945882457098}\n\n**Features:**\n\n* **Tabletop Mixed Reality Basketball**: Place a mini basketball court in your room and shoot hoops in your real-world space.\n\n* **Hand Tracking Gameplay**: Aim, pull, and release shots using your hands for a simple and natural shooting mechanic.\n\n* **Room-Based Trick Shots**: Use Scene Setup to bounce the ball off detected walls, ceilings, and floors for bonus points.\n\n* **Bonus Targets**: Hit special targets around your room in later rounds to earn extra points and build bigger combos.\n\n* **Leaderboards, Achievements, & Streaks**: Chase high scores, unlock achievements, and keep improving your best run across quick arcade-style rounds.\n", "short_description": "Arcade Hoops is a tabletop basketball game built for quick, fun sessions. Place the court in your room, shoot with your hands, hit bonus targets, build streaks, and compete for your best score."}]}, "developer_name": "Dilmer Valecillos", "developer_privacy_policy_url": "https://www.learnxr.io/arcadehoops-privacy", "developer_terms_of_service_url": null, "publisher_name": "Learn XR Labs", "support_website_url": null, "website_url": "https://www.learnxr.io/labs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1676485315806614"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27787222360877951"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620856_1624851041918457_8139719471735620313_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMQhBZDcivwQ7kNvwHDEc56&_nc_oc
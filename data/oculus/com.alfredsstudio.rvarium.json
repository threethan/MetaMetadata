ription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26027575046945369"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "998394106143392"}]}, "baseline_offer": {"id": "998394106143392"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789453800, "status": "PUBLISHED", "id": "998394106143392"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28220002387702613", "version": "5"}, "id": "970286705954372", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26027575026945371", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28220002387702613"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "970286705954372"}]}, "change_log": "\u2022 Voice: all narrations are now spoken by Alexandra Herrgott, in all ten languages.\n\u2022 Planetarium: the Sun, the Moon and the planets in their places for the chosen date and location; the constellation figures at the press of a button; deep-sky objects (Messier, NGC, IC\u2026) with a magnified view and their encyclopaedia page; a ground of Alsace vineyards, and the cardinal points.\n\u2022 Solar System: completely remade, with real maps of the planets and their moons, and the asteroid belt shown at the press of a button. In the free tour, Mercury and Venus show themselves up close and turn before your eyes.\n\u2022 The Sun: a button to change its appearance, and a livelier surface.\n\u2022 Apollo 11: the real sky of the Moon landing.\n\u2022 Journeys: a button to pause the journey and the voice.\n\u2022 Pointing out the Constellations: the constellation you aim at lights up blue, and the riddle stays on screen with the answer.\n\u2022 Settings: the volume of the music and that of the voice are set separately; new music accompanies the Solar System and Apollo 11.\n", "created_date": 1792846200, "id": "28394015426967974", "version": "5", "version_code": 584, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26027575026945371", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28220002387702613"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "970286705954372"}]}, "change_log": "\u2022 Astronaut gloves: your hands now wear spacesuit gloves. Prefer simple hands? Choose in Settings, under \"Hand appearance\".\n\u2022 Zodiac: all-new pictures. The constellation figures of Hevelius, and galaxies, nebulae and star clusters seen by the telescopes of NOIRLab, ESO, Hubble and others, each with its name.\n\u2022 Planetarium: the eye button hides the controls to clear the sky, and the interface now stands in front of you.\n\u2022 Smoother picture: scenes are prepared before they appear, with far fewer stutters when you look around or raise your hands.\n\u2022 Credits: a new page, opened from Settings, names those the pictures, the data and the music are owed to.", "created_date": 1791754633, "id": "28220002387702613", "version": "5", "version_code": 528, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26027575026945371", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28220002387702613"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "970286705954372"}]}, "change_log": null, "created_date": 1791531363, "id": "28184471934588992", "version": "5", "version_code": 514, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26027575026945371", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28220002387702613"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "970286705954372"}]}, "change_log": null, "created_date": 1791028285, "id": "28107603082275878", "version": "5", "version_code": 454, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26027575026945371", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28220002387702613"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id
/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820047_1000848996149953_8039139125906793511_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeJ4XW9BEskQ7kNvwFAvw2M&_nc_oc=AdqpTPGucUL3-90N69KlP3vgiMJyLFHHQFAloE8tPGnSy8aZIG5TlevYhO5ENk3Gglk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaVzpt9cGG5fr3oVVgNg63aiFTL0XCwVnE_UZahHVPog&oe=6B07063F"}, {"file_name": "TheIsland_1440p_07.05.2026_19-39-49.png", "id": "1649967309586058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308307_1649967312919391_5444313034860142449_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ci9X3AdHkBQQ7kNvwFdDKZW&_nc_oc=Adr7Hel0xVsT5_lo6i0CZdrQvNYpqrwGCbEPa0mkbkMfMbbqS1nmBRCvWx2FXLEoJfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmolUzSUPG9QWu8N_IR7MVt2O39l1crIp-4Gd7ANf90Q&oe=6B072770"}, {"file_name": "TheIsland_1440p_07.05.2026_19-40-10.png", "id": "1658653468676636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314663_1658653472009969_9124592493935203159_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThP1aVREzp4Q7kNvwFpF2tt&_nc_oc=Adp5g6poGyQ0GPmGDu5JUEVY_p1EEv-uiDk6lZxov9sysG5QBIh4Fi_fbUpZ1jdbZGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX7ui9ZZxVLD9W2K0ILH9qs8y8kQLdvQvjS9LEndk41w&oe=6B071B2C"}, {"file_name": "Knockback_1440p_07.05.2026_19-40-50.png", "id": "953634890710447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304305_953634900710446_2979659020088686578_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMm-hWpDH6YQ7kNvwFWstng&_nc_oc=AdoeiYu8zWmwkF7f3lSm5hx4_KEvoZdrPJ7X3jomVdlyUG-L-azL2JI7xZnWA35EOWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1VJakqh7NVi8Xvwl4-nNmSI0nZDZhzvuq-EePcKuoWw&oe=6B071488"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munkie All-Stars", "keywords": ["munkie", "pvp", "horror", "fishing", "minigames"], "long_description": "# Hiya, munkies!\n\nMunkie All-Stars is an online multiplayer VR party game taking you back through the 3 whole years of Munkie. You and your friends can do a multitude of fun things:\n\n# \ud83d\udc79 PvPrey - Player-controlled Horror\nPvPrey is what people would call an \"asymmetrical horror game\" inspired by Dead By Daylight and others. You are able to choose between new and improved monsters from Munkie, Munkie: Explorers and Munkie: Deluxe. It follows the charming tradition of working together to power an escape route before the monster gets to you first..\n\n# \ud83d\udca5 Knockback - Intense PvP Action\nKnockback is a PvP gamemode where you and your friends fight to stay alive! As of now there is a bunch of different maps with their own quirks to them, and it will be expanded upon heavily.\n\n# \ud83c\udfdd\ufe0f The Island - Central hub for cooling off\nYou spawn in The Island, a hub for travelling between worlds, trying on cosmetics, and.. fishing?\nThere is a bunch of challenges hidden around this world for you to earn Star-Coins from to purchase multiple different cosmetics for your little munkie!\n\nWhy are you still here? Go play the game!", "short_description": "Online party game taking you back through the 3 whole years of Munkie"}]}, "developer_name": "XORWIRE Games", "developer_privacy_policy_url": "https://www.xorwire.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XORWIRE Games", "support_website_url": null, "website_url": "https://www.xorwire.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
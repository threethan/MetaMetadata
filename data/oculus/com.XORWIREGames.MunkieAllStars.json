&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOVlIPAyRe0J11ApVl1mY1pDk_zkA23frHovAQoF31lg&oe=6B0326AC"}, {"file_name": "Knockback_1440p_07.05.2026_19-40-50.png", "id": "953634890710447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304305_953634900710446_2979659020088686578_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJEFbuw3APYQ7kNvwFD1ikK&_nc_oc=AdrOd8Y0MSIfN82R8f0sk5ubZxQ2CuujFPwm_O3WaLfX9uLgaa-dV_NO9i8NAx99rF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV-3eikugtudmGLapAmOdabGbb2-Y9kwegQKtzSlNOaQ&oe=6B032008"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munkie All-Stars", "keywords": ["munkie", "pvp", "horror", "fishing", "minigames"], "long_description": "# Hiya, munkies!\n\nMunkie All-Stars is an online multiplayer VR party game taking you back through the 3 whole years of Munkie. You and your friends can do a multitude of fun things:\n\n# \ud83d\udc79 PvPrey - Player-controlled Horror\nPvPrey is what people would call an \"asymmetrical horror game\" inspired by Dead By Daylight and others. You are able to choose between new and improved monsters from Munkie, Munkie: Explorers and Munkie: Deluxe. It follows the charming tradition of working together to power an escape route before the monster gets to you first..\n\n# \ud83d\udca5 Knockback - Intense PvP Action\nKnockback is a PvP gamemode where you and your friends fight to stay alive! As of now there is a bunch of different maps with their own quirks to them, and it will be expanded upon heavily.\n\n# \ud83c\udfdd\ufe0f The Island - Central hub for cooling off\nYou spawn in The Island, a hub for travelling between worlds, trying on cosmetics, and.. fishing?\nThere is a bunch of challenges hidden around this world for you to earn Star-Coins from to purchase multiple different cosmetics for your little munkie!\n\nWhy are you still here? Go play the game!", "short_description": "Online party game taking you back through the 3 whole years of Munkie"}]}, "developer_name": "XORWIRE Games", "developer_privacy_policy_url": "https://www.xorwire.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XORWIRE Games", "support_website_url": null, "website_url": "https://www.xorwire.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "23866190453016311"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308010_608718822243605_1678091755871701449_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q0RN9pdwbcQ7kNvwGrYVEx&_nc_oc=AdqMOYrnoQyFBtx0GqhgaetcOa52Qb37FLfKsw2ENUW-9vwdwjzntj-PEHn_378WZN8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy_8kBW5ZdWC8up372DNanDwwPd7crohDMm6rgT344LQ&oe=6B0322F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Munkie All-Stars", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1780073820, "lastRevision": {"nodes": [{"id": "23866190499682973", "release_type": "SCHEDULED", "administration_status": "APPRO
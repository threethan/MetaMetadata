/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820047_1000848996149953_8039139125906793511_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEgK1buvUH4Q7kNvwEmGHVL&_nc_oc=Adp3rbJukNK0l3W2j6fDA9FRrzghpakqHVJjmX9Lb9Eka2z4pBLZLb7-92tDB5b6QUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcoDBqh7Iw_0wEztsMBYZmWysD1PhfR1epA-xJ9tAWDw&oe=6B0EEF3F"}, {"file_name": "TheIsland_1440p_07.05.2026_19-39-49.png", "id": "1649967309586058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308307_1649967312919391_5444313034860142449_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMvYj7SfCrAQ7kNvwHx21t_&_nc_oc=Adp-k1yL82O5HHOHNQx5J5opOl28xBvOAok1-wN4HkMoMxaDkmSyspA-8JPT-YznWPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRE6gkxIBn_MI2-OEC6DKYwuWfg72w7gLteBY5XpSWyg&oe=6B0F1070"}, {"file_name": "TheIsland_1440p_07.05.2026_19-40-10.png", "id": "1658653468676636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314663_1658653472009969_9124592493935203159_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96nPaPw4qZwQ7kNvwEQq775&_nc_oc=AdqJfOT516jNtGAm9vZv_Ro4JUCaPtCtSrDpHueZjx0QsMtkSXc-fZDHS8JV87SKiRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8X83aa563IvaCAkhiQhwDLYvy2HFaFehxYMH9HKH1Tg&oe=6B0F042C"}, {"file_name": "Knockback_1440p_07.05.2026_19-40-50.png", "id": "953634890710447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304305_953634900710446_2979659020088686578_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hR8CznMcrsQ7kNvwHfxNgG&_nc_oc=AdrS3gkAFGf361PMmTua1gKh57iHA6qj00RFB6EChcDh-MWbgvahCUsaQMI2iesHl84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyRWwq9gnXPneaKpQTlr5fB4RT0SA9yQsGSEmB2q2nDg&oe=6B0EFD88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munkie All-Stars", "keywords": ["munkie", "pvp", "horror", "fishing", "minigames"], "long_description": "# Hiya, munkies!\n\nMunkie All-Stars is an online multiplayer VR party game taking you back through the 3 whole years of Munkie. You and your friends can do a multitude of fun things:\n\n# \ud83d\udc79 PvPrey - Player-controlled Horror\nPvPrey is what people would call an \"asymmetrical horror game\" inspired by Dead By Daylight and others. You are able to choose between new and improved monsters from Munkie, Munkie: Explorers and Munkie: Deluxe. It follows the charming tradition of working together to power an escape route before the monster gets to you first..\n\n# \ud83d\udca5 Knockback - Intense PvP Action\nKnockback is a PvP gamemode where you and your friends fight to stay alive! As of now there is a bunch of different maps with their own quirks to them, and it will be expanded upon heavily.\n\n# \ud83c\udfdd\ufe0f The Island - Central hub for cooling off\nYou spawn in The Island, a hub for travelling between worlds, trying on cosmetics, and.. fishing?\nThere is a bunch of challenges hidden around this world for you to earn Star-Coins from to purchase multiple different cosmetics for your little munkie!\n\nWhy are you still here? Go play the game!", "short_description": "Online party game taking you back through the 3 whole years of Munkie"}]}, "developer_name": "XORWIRE Games", "developer_privacy_policy_url": "https://www.xorwire.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XORWIRE Games", "support_website_url": null, "website_url": "https://www.xorwire.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
jys0qbOBcQ7kNvwFIRX8-&_nc_oc=AdqtiOUO68yr6VxYagPE9cI6o2ZFrvt7t8xuf3zYNst8uQT3JlFtT8PuKg8fgvOzIgU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MRLIqxy4B7oK3pv_AJpK-L1nzzedlUvdVHHErLk7mnw&oe=6A36A230"}, {"file_name": "TheIsland_1440p_07.05.2026_19-40-10.png", "id": "1658653468676636", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499314663_1658653472009969_9124592493935203159_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jY2swqUYuAQ7kNvwGeNSns&_nc_oc=AdpFyYZ82LyOZ7YqqMMnQjKhdoeSdP3x6gX-z8njBo7vcwlQ5SyNY_2KaKGOGlLPX7c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l00hi-glMo2a-i7pHA4yLlZTBoCaG8rN_Dv92PS5dlA&oe=6A3695EC"}, {"file_name": "Knockback_1440p_07.05.2026_19-40-50.png", "id": "953634890710447", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499304305_953634900710446_2979659020088686578_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43yuEIBbHeAQ7kNvwGYeivM&_nc_oc=AdqGQkJ4TgckvY9PfKOQGZdkjoQMV-q8OuPRifz0bj82TgYYznFLYLveHBcETFWtUmY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uG4WeszsDY8ZhddgXNRuj9AoqUEjT_nfVbae_5lm7ZA&oe=6A36C788"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munkie All-Stars", "keywords": ["munkie", "pvp", "horror", "fishing", "minigames"], "long_description": "# Hiya, munkies!\n\nMunkie All-Stars is an online multiplayer VR party game taking you back through the 3 whole years of Munkie. You and your friends can do a multitude of fun things:\n\n# \ud83d\udc79 PvPrey - Player-controlled Horror\nPvPrey is what people would call an \"asymmetrical horror game\" inspired by Dead By Daylight and others. You are able to choose between new and improved monsters from Munkie, Munkie: Explorers and Munkie: Deluxe. It follows the charming tradition of working together to power an escape route before the monster gets to you first..\n\n# \ud83d\udca5 Knockback - Intense PvP Action\nKnockback is a PvP gamemode where you and your friends fight to stay alive! As of now there is a bunch of different maps with their own quirks to them, and it will be expanded upon heavily.\n\n# \ud83c\udfdd\ufe0f The Island - Central hub for cooling off\nYou spawn in The Island, a hub for travelling between worlds, trying on cosmetics, and.. fishing?\nThere is a bunch of challenges hidden around this world for you to earn Star-Coins from to purchase multiple different cosmetics for your little munkie!\n\nWhy are you still here? Go play the game!", "short_description": "Online party game taking you back through the 3 whole years of Munkie"}]}, "developer_name": "XORWIRE Games", "developer_privacy_policy_url": "https://www.xorwire.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XORWIRE Games", "support_website_url": null, "website_url": "https://www.xorwire.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "23866190453016311"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1237223678489935"}]}, "baseline_offer": {"id": "1237223678489935"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780073820, "status": "PUBLISHED", "id": "1237223678489935"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27221373157498007", "
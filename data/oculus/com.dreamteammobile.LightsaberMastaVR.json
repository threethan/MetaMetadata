=7f20f&oh=00_AQRcIAnH5qSbJ9NDgFm7oozZbAaf_ZUF_R4NM9FrJIG_JQ&oe=6B05BC96"}, {"file_name": "Screen3.png", "id": "102966335057834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974827_102966338391167_5016676235978288126_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WxHvl3Gw5IQ7kNvwFJAhiv&_nc_oc=AdoBB4M2zOlt4j0nXA5T0vTpsOuHZJIk-7pF4OtiMqkUyrIdH-4JqjezDBhsn-C6Qxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlh07JkFmAA-6CcBfRzSgG_X2iCkDLrWtdxWQ1MBDm9g&oe=6B05A9A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen1.png", "id": "218608259977806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031495_218608263311139_6027119395023712781_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcD-h1WD-NwQ7kNvwF5KPmT&_nc_oc=AdrPJxLmSDBnawKYt33s0Ek0Q2-VXSW0JEsLYZhCSmzIspzyZGtv46vl_zyzKdvUEUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8_4zwDqzXfpXiGVNd4FVLYIZ8-q_I6ZnZ70clvFdmig&oe=6B05B8AF"}, "display_name": "Energysaber Masta VR", "keywords": [], "long_description": "A long time ago in a galaxy far, far away...\n\nJust kidding\n\nBut imagine yourself standing in magnet boots on top of the spaceship, overlooking a galaxy, equipped with 2 energysabers with built-in rail-guns, hearing this alien synth sound alarming you about the drones coming up in different shapes and styles. Be the masta of your sabers and your people. Protect yourself and protect them.\n\nPhysical and mind activities:\n- 360 arm swings\n- 180 body rotation\n- Squats\n- Dodging lasers\n- Precision training\n- Attention exercising\n- Spaceship walking if you have enough room\n\nIt's a VR deep-space experience.\nIt's a survival game.\nGood luck!\n\nPlease, join our Discord server: \nhttps://discord.gg/Q4yEbzw", "short_description": "Defense style game. Energysabers with built-in rail-guns. On the spaceship in the deep universe."}]}, "developer_name": null, "devel
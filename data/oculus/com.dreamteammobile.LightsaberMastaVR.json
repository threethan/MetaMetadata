=7f30f&oh=00_AQW5zp17B8hLkKheJkxRJkBRfxsmqbtknJ-Szo_0LjON1A&oe=6B104896"}, {"file_name": "Screen3.png", "id": "102966335057834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974827_102966338391167_5016676235978288126_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iI0zSIBSMOMQ7kNvwECvVJw&_nc_oc=Adqj1TXjF3iqO-saQe6ofv3RG8zPcKlucZoE4FPZLSQC3bjJaPCSZJhXNexAVvmPGJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWpgsgH04UL9dt-g9iKOl2dUd7xLalQ7yTs_9QzTok_Gg&oe=6B1035A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen1.png", "id": "218608259977806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031495_218608263311139_6027119395023712781_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WCwA_9wL9cQ7kNvwFfEwcb&_nc_oc=AdoBqHpUiEr_AW4pSvQfxgYm_6rJQ-rhfTfgurcY8nI9ky3oZaTeFgVzckt1l4gxYa8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2UDETtoiMlDqTQYKkGmOd1ma0CnBbcHFKyd20OesbIQ&oe=6B1044AF"}, "display_name": "Energysaber Masta VR", "keywords": [], "long_description": "A long time ago in a galaxy far, far away...\n\nJust kidding\n\nBut imagine yourself standing in magnet boots on top of the spaceship, overlooking a galaxy, equipped with 2 energysabers with built-in rail-guns, hearing this alien synth sound alarming you about the drones coming up in different shapes and styles. Be the masta of your sabers and your people. Protect yourself and protect them.\n\nPhysical and mind activities:\n- 360 arm swings\n- 180 body rotation\n- Squats\n- Dodging lasers\n- Precision training\n- Attention exercising\n- Spaceship walking if you have enough room\n\nIt's a VR deep-space experience.\nIt's a survival game.\nGood luck!\n\nPlease, join our Discord server: \nhttps://discord.gg/Q4yEbzw", "short_description": "Defense style game. Energysabers with built-in rail-guns. On the spaceship in the deep universe."}]}, "developer_name": null, "devel
=7f20f&oh=00_AQT-6RQ9bz98jmq-k1oCp_H6VHrMNybAigyBm1Mau_s0rw&oe=6AFB3096"}, {"file_name": "Screen3.png", "id": "102966335057834", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974827_102966338391167_5016676235978288126_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FcRJtox7lAQ7kNvwGwUCUz&_nc_oc=Adp0_gdqIlrJoGM47u8rIxTCmkbmH-JcIxzJuTtnS9c3scro7Pu-H8cGrJ3xNox4FBU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCKJ8C1NZFqtrhVrUjNbLO7Awyj9rOpu2MZ9esN6FIFA&oe=6AFB1DA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen1.png", "id": "218608259977806", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031495_218608263311139_6027119395023712781_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlKZBkvA_VQQ7kNvwHzDM6n&_nc_oc=AdoY27jRQvmI-5YCgbTX9q9DyqTKb-QV2aZ6EOwyzZ3yeIflWqfk-MzfYmHTi60-iQo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRp1aYXdleff-KhPcWm038Gj6h4JOqqQZWkrjSE_3Tow&oe=6AFB2CAF"}, "display_name": "Energysaber Masta VR", "keywords": [], "long_description": "A long time ago in a galaxy far, far away...\n\nJust kidding\n\nBut imagine yourself standing in magnet boots on top of the spaceship, overlooking a galaxy, equipped with 2 energysabers with built-in rail-guns, hearing this alien synth sound alarming you about the drones coming up in different shapes and styles. Be the masta of your sabers and your people. Protect yourself and protect them.\n\nPhysical and mind activities:\n- 360 arm swings\n- 180 body rotation\n- Squats\n- Dodging lasers\n- Precision training\n- Attention exercising\n- Spaceship walking if you have enough room\n\nIt's a VR deep-space experience.\nIt's a survival game.\nGood luck!\n\nPlease, join our Discord server: \nhttps://discord.gg/Q4yEbzw", "short_description": "Defense style game. Energysabers with built-in rail-guns. On the spaceship in the deep universe."}]}, "developer_name": null, "devel
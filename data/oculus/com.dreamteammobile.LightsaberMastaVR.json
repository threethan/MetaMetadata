=7f20f&oh=00_AQR7ZvmXrAac6voFOWOd5gJfFPCiDzTdpZoqQCwXmgIzVA&oe=6B031996"}, {"file_name": "Screen3.png", "id": "102966335057834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974827_102966338391167_5016676235978288126_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WxHvl3Gw5IQ7kNvwEvrgD2&_nc_oc=AdrPURcfoHCCG-ubOapkTYgTIIIbkiFoM3iFttxVR5r90DVKyMhd44ish7cC-8rkG-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdG9kpUv4ryxadT9sgWo3DOXqhljpkmWBisGdic6GxuA&oe=6B0306A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen1.png", "id": "218608259977806", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031495_218608263311139_6027119395023712781_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAZ86jFDzZEQ7kNvwHZ-RAf&_nc_oc=AdrfDsWcHfkvhrvwiQhFFJBL6UFWM83cy9rXsVEGeSFdTzgv4bW3_gIi_akD7xyMMIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu6_d3UGOuHkCIYNVFzbg_1kt724F5Y_0R1boOymkAaQ&oe=6B0315AF"}, "display_name": "Energysaber Masta VR", "keywords": [], "long_description": "A long time ago in a galaxy far, far away...\n\nJust kidding\n\nBut imagine yourself standing in magnet boots on top of the spaceship, overlooking a galaxy, equipped with 2 energysabers with built-in rail-guns, hearing this alien synth sound alarming you about the drones coming up in different shapes and styles. Be the masta of your sabers and your people. Protect yourself and protect them.\n\nPhysical and mind activities:\n- 360 arm swings\n- 180 body rotation\n- Squats\n- Dodging lasers\n- Precision training\n- Attention exercising\n- Spaceship walking if you have enough room\n\nIt's a VR deep-space experience.\nIt's a survival game.\nGood luck!\n\nPlease, join our Discord server: \nhttps://discord.gg/Q4yEbzw", "short_description": "Defense style game. Energysabers with built-in rail-guns. On the spaceship in the deep universe."}]}, "developer_name": null, "devel
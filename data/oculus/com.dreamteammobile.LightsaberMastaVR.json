=7f20f&oh=00_AQQihKgwHwroClUQ3IZ68msSxQvdIUPEl4t6HK79tNax3Q&oe=6B09B116"}, {"file_name": "Screen3.png", "id": "102966335057834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_102966338391167_5016676235978288126_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x76G2AWXinEQ7kNvwGx9fXo&_nc_oc=Adpen0wBGIIH9Nz9o8SwPspp2GqQ3_2CamimSkfo44zqqxNb3IWcch80IjyKgypCApY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqKnqn8EWGD0PVxpVC1-DYeGOZWdjZCNpkifihFdeLBQ&oe=6B099E29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen1.png", "id": "218608259977806", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031495_218608263311139_6027119395023712781_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcMLmyI_uP4Q7kNvwHYyCJo&_nc_oc=AdoAy3sKZphT5gz4XwsLyIHTjMxwuVcyHXaDbPWEA0vrcIwaByZPA3ElOyFabyfBHJY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKZ1yPSGiU2fZhmvTm-14QDyE_Y5fc0WWO9A9JpOLjBA&oe=6B09AD2F"}, "display_name": "Energysaber Masta VR", "keywords": [], "long_description": "A long time ago in a galaxy far, far away...\n\nJust kidding\n\nBut imagine yourself standing in magnet boots on top of the spaceship, overlooking a galaxy, equipped with 2 energysabers with built-in rail-guns, hearing this alien synth sound alarming you about the drones coming up in different shapes and styles. Be the masta of your sabers and your people. Protect yourself and protect them.\n\nPhysical and mind activities:\n- 360 arm swings\n- 180 body rotation\n- Squats\n- Dodging lasers\n- Precision training\n- Attention exercising\n- Spaceship walking if you have enough room\n\nIt's a VR deep-space experience.\nIt's a survival game.\nGood luck!\n\nPlease, join our Discord server: \nhttps://discord.gg/Q4yEbzw", "short_description": "Defense style game. Energysabers with built-in rail-guns. On the spaceship in the deep universe."}]}, "developer_name": null, "devel
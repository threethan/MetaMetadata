n0F3ZzzxYVlEOsqYFaPDn6Jt3ZE29qKuoU9ehcglxiNnoHrNSpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaKNKULjn4NdwlOSq_zaebaaFX-jobAmHZUff1rvlaQQ&oe=69AEAB69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen1.png", "id": "218608259977806", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031495_218608263311139_6027119395023712781_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I52Jw8V4FqMQ7kNvwG18pVV&_nc_oc=AdnlB3fHuFLMav2qiKZngGxt8ijRoBTqkta0eof12aEGTwzDiSU5JH2WYyouwc_Xb_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtWE4Iqb4g7yfcxFYGXVCl8vd-MfX-YlrTYFow10Jp-Q&oe=69AEBA6F"}, "display_name": "Energysaber Masta VR", "keywords": [], "long_description": "A long time ago in a galaxy far, far away...\n\nJust kidding\n\nBut imagine yourself standing in magnet boots on top of the spaceship, overlooking a galaxy, equipped with 2 energysabers with built-in rail-guns, hearing this alien synth sound alarming you about the drones coming up in different shapes and styles. Be the masta of your sabers and your people. Protect yourself and protect them.\n\nPhysical and mind activities:\n- 360 arm swings\n- 180 body rotation\n- Squats\n- Dodging lasers\n- Precision training\n- Attention exercising\n- Spaceship walking if you have enough room\n\nIt's a VR deep-space experience.\nIt's a survival game.\nGood luck!\n\nPlease, join our Discord server: \nhttps://discord.gg/Q4yEbzw", "short_description": "Defense style game. Energysabers with built-in rail-guns. On the spaceship in the deep universe."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/energysabervr/privacypolicy.pdf", "developer_terms_of_service_url": "https://drmtm.blob.core.windows.net/policies/energysabervr/EnergysaberMastaVR-TermsOfService-TOS.pdf", "publisher_name": "DreamTeam Mobile", "support_website_url": "https://energysabermastavr.carrd.co/", "website_url": "https://energysabermastavr.ca
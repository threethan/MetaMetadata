=7f20f&oh=00_AQR7rRW1Llc1ICrZSsiYv5wFrs9P41u6AJTSmJwULpMmqg&oe=6B01C816"}, {"file_name": "Screen3.png", "id": "102966335057834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974827_102966338391167_5016676235978288126_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5Y6yi9NlwAQ7kNvwH_Bcrj&_nc_oc=AdrKNCqh_J70n5g3HrQD9QgzVIiu_ihR9u_Ece7F3wIonyqv6FDxg9FUNsXVz3rtFfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCv2P75Lh95qBG_Eve2vMvOLQu2eWBmycJvFF7qgy91w&oe=6B01ED69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen1.png", "id": "218608259977806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031495_218608263311139_6027119395023712781_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAZ86jFDzZEQ7kNvwHOqo_c&_nc_oc=Adps0OKp1eK0I0YQAhUIkawEQu0V2UPeYYFaJpH0UtV2VO-RsIXvadYv8ta96QRIH_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhTFgavRmXjbrEqUZVyhc4U__bhwstkCvgpwF3zgq8xQ&oe=6B01C42F"}, "display_name": "Energysaber Masta VR", "keywords": [], "long_description": "A long time ago in a galaxy far, far away...\n\nJust kidding\n\nBut imagine yourself standing in magnet boots on top of the spaceship, overlooking a galaxy, equipped with 2 energysabers with built-in rail-guns, hearing this alien synth sound alarming you about the drones coming up in different shapes and styles. Be the masta of your sabers and your people. Protect yourself and protect them.\n\nPhysical and mind activities:\n- 360 arm swings\n- 180 body rotation\n- Squats\n- Dodging lasers\n- Precision training\n- Attention exercising\n- Spaceship walking if you have enough room\n\nIt's a VR deep-space experience.\nIt's a survival game.\nGood luck!\n\nPlease, join our Discord server: \nhttps://discord.gg/Q4yEbzw", "short_description": "Defense style game. Energysabers with built-in rail-guns. On the spaceship in the deep universe."}]}, "developer_name": null, "devel
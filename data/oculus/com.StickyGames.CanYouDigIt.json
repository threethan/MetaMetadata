e7a0a&_nc_ohc=pXLYLnfhUZAQ7kNvwGa-ZHs&_nc_oc=AdpOltcYPmMCK9RToiyKSkh4tMpgWMSFi9A30KfBnrGFk4fSip_xNnIQsNIZYJ-28LI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mofPvCwdf-nXXcUAM_Piaft6deNGlp4F89u1cyX0K0Q&oe=69DA5F22"}, {"file_name": "ss1.png", "id": "3260372647465793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307339_3260372650799126_4067997248509001343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENAElqChlMQQ7kNvwFplz2D&_nc_oc=Adq6wQtt0LpTPPx8i7lJpTnxLjEm_8pHtNtJXwftfhFSxxvzqxjuGLEbJrQxSD2qy5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zC2dDwUhsA4nw-cDCBY-Y7U7BKFJ0zSBYCQWMIz6Mhg&oe=69DA45A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "928678400018837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823349_928678403352170_1508292082621670896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQvIbIvPzs4Q7kNvwEQlnT-&_nc_oc=AdrDndnmEWNr9kdtHvw-0c6WO_p5B_DRzMnJisxc7kXD9BFytrUVBjGF_4UunPo8E_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KZtL3ngE247wJeXUM_B-xG1CTu-YeNjHDnkj3emE_Fg&oe=69DA5743"}, "display_name": "Cozy Digger", "keywords": ["sandbox", "mining", "voxel", "exploration", "adventure"], "long_description": "Grab your tool and step into a cozy VR digging adventure. Dig deep to uncover valuable ores, rare metals, and gems as you carve your own path into the depths.\n\nResearch your discoveries, smelt raw ores into refined ingots, and combine metals to create alloys. Upgrade your equipment and improve your efficiency as you push deeper.\n\nTake on contracts to earn extra income, sell your resources, and invest your profits wisely. Build pipe networks and power them with gems to streamline material transport.\n\nWith no depth limit and no rush, you\u2019re free to grow your mining operation at your own pace in this relaxing yet rewarding VR experience.\n\nHappy digging, Miner!", "short_description": "Grab your tool and dive into a cozy underground VR digging adventure!\nDig deep, find ores and gems, smelt metals into alloys, upgrade your equipment, complete contracts, and build a pipe network\u2014 all at your own pace in a relaxing, immersive mining experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sticky.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "StickyGames", "support_website_url": null, "website_url": "https://sticky.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34039304119017392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820387_1594540712268445_4794080905817253024_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4wIUP4mI_AQ7kNvwH7ufQ2&_nc_oc=AdqiIP3JM4GHbRjVY805SLe2cAyyAAFiopNH1lYfxq78Ij11pZKxXRAZKYzevuExBVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eSKkvqYJ4NiPt8dyNpLRbT5rKJSRnz-bmNBot2iZ80w&oe=69DA5A25"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cozy Digger", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Adventure", "id": "269189016
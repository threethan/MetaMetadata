gG7TbEhkiqHQ_QiX-MPVHSm53G5npaSLZg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEutkdg6oDnhehN_7vAxs31SkSQZAwyk438DG3qS405tA&oe=6A8D91A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "928678400018837", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823349_928678403352170_1508292082621670896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNxAumaM4sUQ7kNvwHsaR1-&_nc_oc=Ado7Rq3lTOIgzs7SVL9pQm9hwXqVnsCRLS7x0vcx9P6XgcW2kXz_jJC2nptfBaH5YE0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhKpAefaG7OyIyvq09jlLuiP5XJv-GmZcJrxVJQcXtsQ&oe=6A8D6B03"}, "display_name": "Cozy Digger", "keywords": ["sandbox", "mining", "voxel", "exploration", "adventure"], "long_description": "Grab your tool and step into a cozy VR digging adventure. Dig deep to uncover valuable ores, rare metals, and gems as you carve your own path into the depths.\n\nResearch your discoveries, smelt raw ores into refined ingots, and combine metals to create alloys. Upgrade your equipment and improve your efficiency as you push deeper.\n\nTake on contracts to earn extra income, sell your resources, and invest your profits wisely. Build pipe networks and power them with gems to streamline material transport.\n\nWith no depth limit and no rush, you\u2019re free to grow your mining operation at your own pace in this relaxing yet rewarding VR experience.\n\nHappy digging, Miner!", "short_description": "Grab your tool and dive into a cozy underground VR digging adventure!\nDig deep, find ores and gems, smelt metals into alloys, upgrade your equipment, complete contracts, and build a pipe network\u2014 all at your own pace in a relaxing, immersive mining experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sticky.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "StickyGames", "support_website_url": null, "website_url": "https://sticky.games/", "category": 
7465793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307339_3260372650799126_4067997248509001343_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNh_Mo2JN_sQ7kNvwFS5Hc9&_nc_oc=AdroEWIzkSk7iegzjb3qh7jVMvI7031Grwc5Wrmj2dO2w35w5gsAY101ZhzBw7j5w2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuchIFPnVrivT9wFgOIsfVE9638nngNimZOncMvtGTMw&oe=6B0DAB62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "928678400018837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823349_928678403352170_1508292082621670896_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4oq2Z6F5MAQ7kNvwFnGQuM&_nc_oc=AdrAAI4iJr9JnG9OZEIf50OvtcnU9zh7bJFiZnm32wA98OIK03rgCMx83TTLQfJXkEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3n3C85wFtPVZlx-22KhJ26iXis7aBKBIXjOR6cSUm7g&oe=6B0DBD03"}, "display_name": "Cozy Digger", "keywords": ["sandbox", "mining", "voxel", "exploration", "adventure"], "long_description": "Grab your tool and step into a cozy VR digging adventure. Dig deep to uncover valuable ores, rare metals, and gems as you carve your own path into the depths.\n\nResearch your discoveries, smelt raw ores into refined ingots, and combine metals to create alloys. Upgrade your equipment and improve your efficiency as you push deeper.\n\nTake on contracts to earn extra income, sell your resources, and invest your profits wisely. Build pipe networks and power them with gems to streamline material transport.\n\nWith no depth limit and no rush, you\u2019re free to grow your mining operation at your own pace in this relaxing yet rewarding VR experience.\n\nHappy digging, Miner!", "short_description": "Grab your tool and dive into a cozy underground VR digging adventure!\nDig deep, find ores and gems, smelt metals into alloys, upgrade your equipment, complete contracts, and build a pipe network\u2014 all at your own pace in a relaxing, immersive mining experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sticky.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "StickyGames", "support_website_url": null, "website_url": "https://sticky.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pl", "pt_BR", "pt", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39823431120604634"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_1594540712268445_4794080905817253024_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eHcKYg8A44Q7kNvwETNf-y&_nc_oc=AdqS5eYDxeb7qOCSk_6iCRTBaeRyHpS_zFp97cYehYOlpD6AryGsf4Y66VXFeximnYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDzqjHEwjGv-Z86eplsFSxsnRcGFqRF_LMfVPTqeFaLQ&oe=6B0DBFE5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cozy Digger", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1774039020, "lastRevision": {"nodes": [{"id": "33337684349179376", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pd
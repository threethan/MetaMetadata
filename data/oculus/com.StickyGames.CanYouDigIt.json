QbZI3LmthU9qWNi0MMYb1730QX3yXuWVlbOAxSZkKoGEy28h-bnO9jQ3E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3R3o7QXACvaR6TA6SyaNrSH1I5BDSKoKZTNIZp_ISuIA&oe=69F200A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "928678400018837", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823349_928678403352170_1508292082621670896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFY83TRct18Q7kNvwHPPu3Z&_nc_oc=AdoMq5EWfxpfeFgyvsdQ-Jy91O4yzefkvOEE3V0bPJJsa8d2nXr8Ji-xQt00jxre_cE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14eywOnySGzK0lEqAkrB8Ea4G-qNUbzL3a6A5lTT6dDg&oe=69F21243"}, "display_name": "Cozy Digger", "keywords": ["sandbox", "mining", "voxel", "exploration", "adventure"], "long_description": "Grab your tool and step into a cozy VR digging adventure. Dig deep to uncover valuable ores, rare metals, and gems as you carve your own path into the depths.\n\nResearch your discoveries, smelt raw ores into refined ingots, and combine metals to create alloys. Upgrade your equipment and improve your efficiency as you push deeper.\n\nTake on contracts to earn extra income, sell your resources, and invest your profits wisely. Build pipe networks and power them with gems to streamline material transport.\n\nWith no depth limit and no rush, you\u2019re free to grow your mining operation at your own pace in this relaxing yet rewarding VR experience.\n\nHappy digging, Miner!", "short_description": "Grab your tool and dive into a cozy underground VR digging adventure!\nDig deep, find ores and gems, smelt metals into alloys, upgrade your equipment, complete contracts, and build a pipe network\u2014 all at your own pace in a relaxing, immersive mining experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sticky.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "StickyGames", "support_website_url": null, "website_url": "https://sticky.games/", "c
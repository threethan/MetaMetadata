vwFA62kW&_nc_oc=AdpimcoFqomY3Fcd1q9hfm5fnv36RKsQFzycsD-ZP1tAUXcDNMuq_0oxvPax-yOH6Q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Nppp0mSKVbp5-s7XdgLELtWZmta3LFWvNrdViyN2BdQ&oe=69DE448A"}, {"file_name": "ss4.png", "id": "921089424216350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/596139439_921089427549683_7657683904928076592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etjvySwV444Q7kNvwFmN4DF&_nc_oc=AdqwbpSb6aGxCFhCUmJjDRZU12MenndZHzoul0sxLYzNypCiszV2hXVN-w0xtJuA9b4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30_4Amt_-xNool6lirIZkEL-LDqSUGNo3EZ2btamMVIw&oe=69DE53A2"}, {"file_name": "ss1.png", "id": "3260372647465793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307339_3260372650799126_4067997248509001343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThWDXOEpUnsQ7kNvwG71vG0&_nc_oc=AdpYAqQKX3T_TTqXqna6lLSRRaaE5i1O6s6qp1BOu9aB2n7kHxCuSp-uh6TAA3Dae-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B2PBCwCoxtW2yEm286Jl49Vxx2Xn6NtpEzaNc7BDlsw&oe=69DE3A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "928678400018837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823349_928678403352170_1508292082621670896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=475gLemdzusQ7kNvwFWGt93&_nc_oc=AdrR708OdupfsWkw7fZcRPjaxgBKXaVKbT8HfMOiyNHOmz6aHBc1ssfuOZeYGn8_Jxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04oYyRnt50vIkYSJZyvq4dVYWrx669n0jOH30fQ2zGcQ&oe=69DE4BC3"}, "display_name": "Cozy Digger", "keywords": ["sandbox", "mining", "voxel", "exploration", "adventure"], "long_description": "Grab your tool and step into a cozy VR digging adventure. Dig deep to uncover valuable ores, rare metals, and gems as you carve your own path into the depths.\n\nResearch your discoveries, smelt raw ores into refined ingots, and combine metals to create alloys. Upgrade your equipment and improve your efficiency as you push deeper.\n\nTake on contracts to earn extra income, sell your resources, and invest your profits wisely. Build pipe networks and power them with gems to streamline material transport.\n\nWith no depth limit and no rush, you\u2019re free to grow your mining operation at your own pace in this relaxing yet rewarding VR experience.\n\nHappy digging, Miner!", "short_description": "Grab your tool and dive into a cozy underground VR digging adventure!\nDig deep, find ores and gems, smelt metals into alloys, upgrade your equipment, complete contracts, and build a pipe network\u2014 all at your own pace in a relaxing, immersive mining experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sticky.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "StickyGames", "support_website_url": null, "website_url": "https://sticky.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34039304119017392"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3042149899309764"}, {"status": "PUBLISHED", "id": "1546400346444657"}]}, "baseline_offer": {"id": "1546400346444657"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "3042149899309764"}]}, "liveChannel": {"nodes": [{"latest_supported_binary
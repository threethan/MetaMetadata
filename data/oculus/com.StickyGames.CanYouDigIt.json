M-kAtw&oe=6AFF0122"}, {"file_name": "ss3.png", "id": "939079251892697", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499308575_939079255226030_5660024707808709302_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6prJxA69LrAQ7kNvwHeeuit&_nc_oc=AdpAOcZVD9baROMkQIM_JRRPRXcbUAnQlBel5zIqhsaogB4PuA6sIm9znZfr0r8ENcE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2-GCMphuZXEzlNEVPkdAJB_IdTQv7j9B3MLYQpwaJvw&oe=6AFF354A"}, {"file_name": "ss4.png", "id": "921089424216350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596139439_921089427549683_7657683904928076592_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dtTJqe09D8Q7kNvwEHgjjN&_nc_oc=Adp4_XwFRnehusPhVzKkXuvHXSmA5FMT9l2Apmjk5yVmfhlcJTjyQO8G4L0q8YFPu1I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZvHOfJthUyfylJEFThMFhMJLZDQpslcXBb7Vuv813Ow&oe=6AFF0C22"}, {"file_name": "ss1.png", "id": "3260372647465793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307339_3260372650799126_4067997248509001343_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cyjxya5MrVgQ7kNvwFUiwDS&_nc_oc=AdomIbsP6XDW_yJNSfZycrj_qc3ZzjajBBjq40LJbjlz1iggQdtrfT2w4rYEoqHpDq0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRv4XJMj2q8J3tEyKCBY_HDGNeeGDbP3xcT8C8SEP-7w&oe=6AFF2AE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "928678400018837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823349_928678403352170_1508292082621670896_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk7I3JrpB8cQ7kNvwF1suS8&_nc_oc=AdrH_1gruEpYxJzBUZjLjSqfGElSy6CEic7un12EaKtsg7L-WL-P8DTuZGHheSrCUxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ3V1cUENmIVlhgZNlDWe97jfjdfi5nnz1Nc--CimVkg&oe=6AFF0443"}, "display_name": "Cozy Digger", "keywords": ["sandbox", "mining", "voxel", "exploration", "adventure"], "long_description": "Grab your tool and step into a cozy VR digging adventure. Dig deep to uncover valuable ores, rare metals, and gems as you carve your own path into the depths.\n\nResearch your discoveries, smelt raw ores into refined ingots, and combine metals to create alloys. Upgrade your equipment and improve your efficiency as you push deeper.\n\nTake on contracts to earn extra income, sell your resources, and invest your profits wisely. Build pipe networks and power them with gems to streamline material transport.\n\nWith no depth limit and no rush, you\u2019re free to grow your mining operation at your own pace in this relaxing yet rewarding VR experience.\n\nHappy digging, Miner!", "short_description": "Grab your tool and dive into a cozy underground VR digging adventure!\nDig deep, find ores and gems, smelt metals into alloys, upgrade your equipment, complete contracts, and build a pipe network\u2014 all at your own pace in a relaxing, immersive mining experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sticky.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "StickyGames", "support_website_url": null, "website_url": "https://sticky.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34039304119017392"}}]}, "scheduled_offers": {"c
AEUo3A&oe=6B047F62"}, {"file_name": "ss3.png", "id": "939079251892697", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308575_939079255226030_5660024707808709302_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p23zdljecL0Q7kNvwFluYqU&_nc_oc=AdrKKvM1ISIlfP8vRKerYsHvT3u8l77Dq9HzjL8I-rAXyipo1Bx1CmcGfivZIYZbUgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIsJb9lJXNldMjCEg0yf0A-cyc3RSGuMan8Kfau77YKQ&oe=6B047B4A"}, {"file_name": "ss4.png", "id": "921089424216350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596139439_921089427549683_7657683904928076592_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG-9hTXU6RYQ7kNvwEs7F3G&_nc_oc=Ados7O_wWqiWpUlpIS3QQcQXxwiWv2CQuylviSF5uHaCr8prB6BLwZrg4wDG-rshWUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHDgEZecYMS1lmH8KydfIlphWY_SetKkznsUDjFwOeYA&oe=6B048A62"}, {"file_name": "ss1.png", "id": "3260372647465793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307339_3260372650799126_4067997248509001343_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VovAIFYaDRcQ7kNvwH8sDU9&_nc_oc=AdrpSYFwMnQoU2oH83c2qsiOkRr8CArpXFZ-nFubf8Jh9Zl--PIwmpJW8QCsCCJHoWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMsnSFurrp3T4eckgGQ0vRbSd6nvFkmM5uXJS_2MlyGg&oe=6B0470E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "928678400018837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823349_928678403352170_1508292082621670896_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMQnj0OLArsQ7kNvwHDxxlS&_nc_oc=AdqroDIfUnj7bsl4C7-oE07K7HM7HPEUNzlNMU9aXw2RjaEAujf5-5t2QyH85n5lu88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMZu8NkNAgUKGrUsegztlNeEGB-BSlakZMCerSXriHoA&oe=6B048283"}, "display_name": "Cozy Digger", "keywords": ["sandbox", "mining", "voxel", "exploration", "adventure"], "long_description": "Grab your tool and step into a cozy VR digging adventure. Dig deep to uncover valuable ores, rare metals, and gems as you carve your own path into the depths.\n\nResearch your discoveries, smelt raw ores into refined ingots, and combine metals to create alloys. Upgrade your equipment and improve your efficiency as you push deeper.\n\nTake on contracts to earn extra income, sell your resources, and invest your profits wisely. Build pipe networks and power them with gems to streamline material transport.\n\nWith no depth limit and no rush, you\u2019re free to grow your mining operation at your own pace in this relaxing yet rewarding VR experience.\n\nHappy digging, Miner!", "short_description": "Grab your tool and dive into a cozy underground VR digging adventure!\nDig deep, find ores and gems, smelt metals into alloys, upgrade your equipment, complete contracts, and build a pipe network\u2014 all at your own pace in a relaxing, immersive mining experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sticky.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "StickyGames", "support_website_url": null, "website_url": "https://sticky.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34039304119017392"}}]}, "scheduled_offers": {"c
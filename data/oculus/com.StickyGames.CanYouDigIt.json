UeuWKXwlvweBipBwMEJRGM7G8RYkXOHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHpl4KMFDf7CzcwkHspW-O1tDxRVHR_NVztHcaZ8CGog&oe=6A676FA2"}, {"file_name": "ss1.png", "id": "3260372647465793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307339_3260372650799126_4067997248509001343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0ZofT9WZ40Q7kNvwFXRovj&_nc_oc=AdpHXl5NVI6jOupVWVtClWmryOE1V0EXKmLhEJd1hBFEpI_UzYmnQ0u9qPYi7tlpURA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp5QNTT-DdgwkX6HQjCvK_Oz8C1SiLoQChidGNNpZO_Q&oe=6A675622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "928678400018837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823349_928678403352170_1508292082621670896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqSttnQMjvoQ7kNvwFOjZDO&_nc_oc=Ado2VpiXAfNUbsxlY_LdeZZGPov6Ns-PGte4CZoep_Rm0aMa2WbbZKstaXfU2vBFSDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy2kSVPSZSUNX76yPxPY-6vPTSDROT7p0VtVBBE2eahg&oe=6A6767C3"}, "display_name": "Cozy Digger", "keywords": ["sandbox", "mining", "voxel", "exploration", "adventure"], "long_description": "Grab your tool and step into a cozy VR digging adventure. Dig deep to uncover valuable ores, rare metals, and gems as you carve your own path into the depths.\n\nResearch your discoveries, smelt raw ores into refined ingots, and combine metals to create alloys. Upgrade your equipment and improve your efficiency as you push deeper.\n\nTake on contracts to earn extra income, sell your resources, and invest your profits wisely. Build pipe networks and power them with gems to streamline material transport.\n\nWith no depth limit and no rush, you\u2019re free to grow your mining operation at your own pace in this relaxing yet rewarding VR experience.\n\nHappy digging, Miner!", "short_description": "Grab your tool and dive into a cozy underground VR digging adventure!\nDig deep, find ores and gems, smelt metals into alloys, upgrade your equipment, complete contracts, and build a pipe network\u2014 all at your own pace in a relaxing, immersive mining experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sticky.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "StickyGames", "support_website_url": null, "website_url": "https://sticky.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34039304119017392"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1343169663841380"}, {"status": "PUBLISHED", "id": "1642293173498148"}, {"status": "PUBLISHED", "id": "1146801677586831"}, {"status": "PUBLISHED", "id": "3042149899309764"}, {"status": "PUBLISHED", "id": "1546400346444657"}]}, "baseline_offer": {"id": "1546400346444657"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1343169663841380"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35166428339638292", "version": "0.9.0b"}, "id": "1503521010737966", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {
ywords": ["shooter", "minimal", "simple", "action", "japan"], "long_description": "Focus on the present - and discover your inner awareness of the now.\n\nZEN SPLASH is a stylized game inspired by the concept of Zen.\n\nVarious objects will hurtle towards you, which you must continuously dodge. Through extended dodging and intense concentration on the present moment, we hope you will enter a state of flow, and emerge out of the game in a refreshed state.\n\nTo live life is to keep exposing yourself to stress; how would you confront them?\n\nLearning the way how is an important lesson for all of us.\n\nThe saints from the past have left us the Noble Eightfold Path: the eight ways to live a life of happiness.\n\nWith this game, you shall trace down those paths.", "short_description": "ZEN SPLASH is a stylized game inspired by the concept of Zen."}]}, "developer_name": null, "developer_privacy_policy_url": "http://rhinoceros-horn.com/top/privacy_policy_en/", "developer_terms_of_service_url": "https://www.facebook.com/zensplashvr/", "publisher_name": "RhinocerosHorn", "support_website_url": null, "website_url": "http://rhinoceros-horn.com/top/zen-splash-vr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en", "zh_CN"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465840925000709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386179_691997234283486_176322963_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketles
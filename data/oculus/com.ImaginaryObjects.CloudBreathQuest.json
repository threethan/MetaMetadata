3029385180533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqGRP_TDvGoQ7kNvwHivuG1&_nc_oc=AdnrFc5cf2p7PoSOOk72zHwlTDhJokECt7xfvgtZDar43n0vMYFCXRCo5wZzuSYQ51E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzersEuYOGN8XqIL8gnJtIH1Rqe4TYzGGe785eiZLRn5Q&oe=69BD5908"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGGMZosNUV4Q7kNvwEW9H5R&_nc_oc=Adm0BV_8UB81wUX4dr2PkMxf0LNAMNrzKAvEvMWe7j-m1KViUxU2eniSJEmidtezgWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_IPc7nFkGJrq5NOTDW_mMrDezQzj5aWObtkewvWa3rQ&oe=69BD4CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_y6OpqHdlVYQ7kNvwG9Csh3&_nc_oc=AdlFgzWK0sDJ7t_cGFLhGaYlHZIlWfJe_QQKXxHt3ePlF3e_E-uhY3enrUm8ZPnr-eE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1GE5SQV1pxxp7DHKvqFjr7uJuxnpnCye6AEgwfzhXgw&oe=69BD5A8C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
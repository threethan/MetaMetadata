LSusNolO0B0Nvpq1GNRkSPebnL8aHgB2ANA&oe=6A81A2CA"}, {"file_name": "003-CB-Screenshot.png", "id": "2222106897947126", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974561_2222106901280459_1280595873516126760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8nNnYGNPAwQ7kNvwGC2kmr&_nc_oc=AdpU_4Y0jHb1mTnWDSeGAfHsmyF6lDFuHHomuK8HpuiRqgYLo-a7HXumCoVxzCu8XEM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSCj9OlEmziIW6zY2HDRAC7hwmfDLn5yAmHFUNQlzXQg&oe=6A818FAA"}, {"file_name": "004-CB-Screenshot.png", "id": "303029385180533", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfMPEmJPEBQQ7kNvwEujss3&_nc_oc=AdrUhxzDuUDFwBQ-i2FPijDR6Pc3kNkt0f2mENRLTL9h4h__iCBJ4mlIDz3cm2N3Ep4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGozjSGAnhzdcP65f4dFBc7om9KNOHNrMiHXm3q3k_Y_A&oe=6A819048"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ev20GXaTEkQ7kNvwFBsXbH&_nc_oc=Adphq5F6-pJNeyNDJ4bK7-gF-Lxrl6GGWkVj6iqXc6njg8ZIRxHZ8BRxdv-TNZUbWcg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQyUUy-ynFGNwX_rwkxOX6vmId6oZjWbDU9ohdnyLJJQ&oe=6A81BC4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3zpDEd6SO4Q7kNvwEMGl0T&_nc_oc=AdpMTIUJTPppiURObcVbY8h5p70CpFmjvJp2ZSE9uaiesGVb5AbuWMfNCTRPAZqYkNU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8EqS5l7x9DYIfSBacYXsUmOECe8AVTw3GyjO8b7zyHA&oe=6A8191CC"}, "display_name": "Cloud Breath", "keywords": ["Meditation", "Breath", "Chakra", "Relax", "Color"], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
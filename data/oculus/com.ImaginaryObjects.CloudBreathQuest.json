3029385180533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqGRP_TDvGoQ7kNvwFpbbmE&_nc_oc=AdkvdJmMBFtOJ2uiBpKQSBtgGNVGsrIsSq6NyZtZdqN4os8wnt4WUrzoOoOMGmgqMEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLHE6K69X18yeGoN3Rm1YKRKeNayXKKd6z2VRa_KasOw&oe=69BFFC08"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9XxtTv6VD0Q7kNvwFURScc&_nc_oc=AdkGzDC7CGG-y_ZGOVqdtNRMNPOLOAp576DeTH6pNwwMhabQLU4c1XVmFtS6PxCjZHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhoNr03EgvwptNb6hAWDscFNZPlYwW_e1g0vQe6jO1tA&oe=69BFEFCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_y6OpqHdlVYQ7kNvwF3Yfka&_nc_oc=AdkWvp-sXowlPS9GhiC20k5trG0i1ZU-auRIvazR7r43VoA1g-tnK3kwcBScRP04IWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy70HRBSPsd2U_4SvRSGOe0NvJJikJWbef9vYm7LduH-Q&oe=69BFFD8C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
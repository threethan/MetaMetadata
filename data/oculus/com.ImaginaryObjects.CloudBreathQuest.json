3029385180533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLfWm2pGSpsQ7kNvwGoZl_y&_nc_oc=AdlIdHkUNCBQJoDic9YWb1nT4HthjBOLdXVIzZJ3J5KXDnFfPgxwpjAIwo_Z-uX_PTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCFNwOWCbNK5JIf2WwSo1qh-qQJTCysCFmjN0amklGxA&oe=69BC0788"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGGMZosNUV4Q7kNvwEPFvic&_nc_oc=AdmBe3k4hf9QnfEO5SYbA_zzDxKklR6tLi-VtohB3Fkv4-VL6XHUteeKka5iSSrvMZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTtn6bL8tK9ls1gGUZ1oE42y6a-XrkPOsAfT2IJZ6WLQ&oe=69BBFB4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cps-FKSZ9O0Q7kNvwH6Uyv5&_nc_oc=AdlVg0i__gJRFeGG4rl3gqqgOY_oEvLEwL8IytxLQmjn-7G92uDn5lDn5VFhvYdWKQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx75kw610TUXuCnK8f8S_MUjaKHzWXpo16LV9EgT0109Q&oe=69BC090C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
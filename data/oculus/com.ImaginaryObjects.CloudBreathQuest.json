3029385180533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5fgTUaA03UQ7kNvwGhOqv9&_nc_oc=AdmVQ4xYnQWz4YLLbNidmf2capjP3Mi7KMe4KVfPdNwkw8s9HXzFDcjqa6ONraf5nzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxtBxEW1C_iLv5YkyRu2aA7TV4eRtfcmNtMDBUighojmQ&oe=69AC3588"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggU-Z8x_jwsQ7kNvwGNSTad&_nc_oc=AdkKqUgSbnpVG0S9fauwZHEduVKrxpU6Q83UdVq6FamN_J8OJZlYA6A5EEQb6RQpB1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKXQAByivHom1-NVyznGwDyBSZF32heGYARJdIbQG4hw&oe=69AC294B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZfBwP1fFJ8Q7kNvwGaYnFJ&_nc_oc=Adm8PGZ4EBQeeDzO4AXGbbt74zd9Weyo18urR1oVb6N9ZnrooGUagQMJAsANKVaAXTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOpCYtoaSDmTlJnpbis0Y6tuChtFSRqoVtezISW7AhfA&oe=69AC370C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
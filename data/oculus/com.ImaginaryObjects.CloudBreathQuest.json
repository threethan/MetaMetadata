N4N_TfgqlP-Wvt0LALdusfkT7fCBFQ4rUJA&oe=69F5E3CA"}, {"file_name": "003-CB-Screenshot.png", "id": "2222106897947126", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974561_2222106901280459_1280595873516126760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTESJ4POBZkQ7kNvwEaoHFn&_nc_oc=AdpCCb5oxNOiE0ULU_t4cjrwcNbM-bKegPoV37gUQr-j3Xz7vOMGZ38-o_GwAPxvjMc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2At6lpZHxwcNqodFC7weH2QlCQdi7jz4bOhIL0BiaSvA&oe=69F608EA"}, {"file_name": "004-CB-Screenshot.png", "id": "303029385180533", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV65Ri5bXnYQ7kNvwE-eMIB&_nc_oc=AdpoqB95hJpj3wKZ41fiZdd6OMg9dEeS8Vg0QMIsv0GpJ4wGmnNDyVfyw8zF3Ju1s-E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mwtliU3uIy56MLmcfGEO0XiBhzMpWDzAIGxN9jKYyBA&oe=69F60988"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0FJiPiXOK4Q7kNvwH0gznF&_nc_oc=Adq5FdlbIgVIkAUET2YqRMU9Ex8mQQywmh0XQ-iBlF-VqGkslKWG4RvBByq2Gez8RSU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KL0XyLywk3fhV0jpG_bJavqyfVy2U5ZTMKyP3pVXQVw&oe=69F5FD4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syFLbo-sOOIQ7kNvwFGcuKj&_nc_oc=AdrUnYuO08ySaB3Gum1CFn-C3As7HiWwCjnRj-Fe9bvAHLSNEmr6KZL2ZLfehlm8Oh4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CttNJyxHRRBPhudsu12Gl-TObA85aBDbUJEUF-6RZ-g&oe=69F60B0C"}, "display_name": "Cloud Breath", "keywords": ["Meditation", "Breath", "Chakra", "Relax", "Color"], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
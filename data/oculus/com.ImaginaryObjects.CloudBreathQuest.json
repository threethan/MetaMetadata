3029385180533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLfWm2pGSpsQ7kNvwGk9wOO&_nc_oc=AdmKAmXKa9wMHV_Dhw95_MtvLn2OZAcJ2Gh0SLiOX18w1hdceqvjVQmNFHdcUa0Iiig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzi3nE_rcF-KiUrgucs145dBl0W5H3lyRvlMaLRhmHsLQ&oe=69B96488"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0m-SLA4W8wQ7kNvwFEcV0r&_nc_oc=AdlDhOHnHFJUtbNSBszA_D4m1XZwTpWWtfiIpLiPEdMOGfchvs7AzQXdqdqIaJIlF70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1QI8LBhzXk9YqEagL7Sy4YeyMEcFP8j8FgmzECdpmdQ&oe=69B9584B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cps-FKSZ9O0Q7kNvwECGqqo&_nc_oc=AdlyhD1fP477UqpSd9MjLp014A01UhzW5S9PC-Jdk3Jus_6-C4EVur6u2YmSQYs3_gc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxvx0x4HNQfismmZTn3NZPpPlYO5Hgh8WmbEa5Xs_3aaQ&oe=69B9660C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
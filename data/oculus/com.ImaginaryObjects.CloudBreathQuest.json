aSohGKh1_uROanLuIL3jzNyXn9_0iDNcb7w&oe=6A5CB8CA"}, {"file_name": "003-CB-Screenshot.png", "id": "2222106897947126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974561_2222106901280459_1280595873516126760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgXwRzGkMI8Q7kNvwHkR8ZG&_nc_oc=AdoDltxXcQSv0LLsN0T7lKkpS8MQZAF6K-AEbuVZat5opkNlrwH0BAtkSf7_rAEEw8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwSEtl93T8lhGOG1P-swviAfmqwTpJfFV2bKbu5Fbciw&oe=6A5CDDEA"}, {"file_name": "004-CB-Screenshot.png", "id": "303029385180533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPGaK7aMFfEQ7kNvwHg0u7t&_nc_oc=AdpZll8AGsAXY17rSFBn6Gb-9gc-Gu7sBFoLuYvFaD01WJeajZGCp_2cfYeDyTRoMWY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYqgS_2_v4Wrmb3Ma2UxgfxtJR1twjckXsdgaBSlj0Jg&oe=6A5CDE88"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B72TTAYKA_kQ7kNvwEATKpY&_nc_oc=AdqfX7kZrEsrkk2LDRQOohgVdZzE-x_TaOj7fheV7Ykj0RIv7arHfgAnb-sM-r8fEdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgU3wxl9jeF3ysQunbo_Tdt5QvpTTaUUg3nkP37dUn6g&oe=6A5CD24B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcB-kqUysssQ7kNvwF5HDJU&_nc_oc=AdrM_ezNzNrgIofl1--tar76g128NlFz3SvQd_EEVoNI-EB5Hpj53_EUJRMO9t7LkzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFrsCEKwCdl5aNbLEU5EOh_yp6aVhTvOJ6Csq5Vfd5iA&oe=6A5CE00C"}, "display_name": "Cloud Breath", "keywords": ["Meditation", "Breath", "Chakra", "Relax", "Color"], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
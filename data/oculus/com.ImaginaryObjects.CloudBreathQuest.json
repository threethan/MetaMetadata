QNthNDiglX4xerWYx1wslRfwIcbcUR4GSfQ&oe=6ACBAF0A"}, {"file_name": "003-CB-Screenshot.png", "id": "2222106897947126", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974561_2222106901280459_1280595873516126760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA5YQKWN_A8Q7kNvwFoSo7U&_nc_oc=AdryiZ4w-S7B5V8cNUVocNMsLrGZQ9btOQFuGk2RTJPA8FXm4LJtcJoqa54Tzo16tHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIcm2qN0CMvUHlnuhoRX5-kz2GIvdPpFBDvWekiDScMw&oe=6ACB9BEA"}, {"file_name": "004-CB-Screenshot.png", "id": "303029385180533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pCobqPUT14Q7kNvwHiPCct&_nc_oc=AdoMeWKydG4BHu7cnFTcnABpETxK7yD__qZlh7KzYW8410GGF1SW8M5f8UYWznfxK3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjaBl_-bgnm4FVjSfqWwU-A_Z9L7EsAiZyukBBr_gIRQ&oe=6ACB9C88"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3k7pl8a0SoQ7kNvwFyBz2Y&_nc_oc=Adr9bz91bC5v1GOdTr3jY4jsjEmtDz884KQZQreUI0dgVRK_0c5fJK6Oipp34JbPKOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVacjpsZQ60IjXrEDmWYZvDg6tmVyAWc_F4UylUgmtLw&oe=6ACB904B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quI-1fUhINAQ7kNvwGvQ2xa&_nc_oc=Adqunv-9fjc5Bnz0X4CKrZPwXxsjiraMMh3Wp9IIv1FakOmSzx9YyQYhMc1gnGCmHXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk2JfJX1SnOIxjfS7FF_S4kLfQafTvPHmIo7s8tZehiw&oe=6ACB9E0C"}, "display_name": "Cloud Breath", "keywords": ["Meditation", "Breath", "Chakra", "Relax", "Color"], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
3029385180533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e0zMBtNx-AQ7kNvwFu4540&_nc_oc=Adn-jfPNT2jz2UlhDyBFBWWS1AgSnoaB8k1NOU6c7b9PDyRgdIiSmuxWGAOklpFBnBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyrpVS8LARgjVIVF9KMgPpy9Y5IX1MQOeQbqs-tEppJTQ&oe=69B57008"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPQaj4qzpN0Q7kNvwHQIAHs&_nc_oc=Adnw9L5S00loKZ2ojIwZ7QfHQnIZnKrLBE4QuWnCIh_TxouBspGi8_8cz5od79sJqIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIstTNlEWUiTtMFiJwRjfyGA02XbEs73fzCjqbpVYIHg&oe=69B563CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms1acfzicjkQ7kNvwERs_b3&_nc_oc=AdlsBZkFEqUunr7pbNxlH9qiPepuDEiRHN-UtFj0cY-E1yO_8CRwGOiH-CpOXsfLzIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyH_dE_hey-PqwoTcVvVlQSLgeA7JGxwfO1aet71RRCCw&oe=69B5718C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
3029385180533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqGRP_TDvGoQ7kNvwGvr-C1&_nc_oc=Adlp4iYfY1xs7p9l2agHWuiGlyvKRRmF4Owo_A4DZkcVWba17_2--8L4T2w5X1Ejp14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIGb7tYzhjDQqqlAFjXAWjlk7qv-JY9RKEPtOW2CVDTw&oe=69BEAA88"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9XxtTv6VD0Q7kNvwG0FYzW&_nc_oc=AdmsPjrgtGYWmNtrqgrqgLkHLhDeFdNXHhKdWoOdZ5ntKcwfJcJpcmGcDg-JAPqUV1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfysZ0_JmX8bRdoBpnfocUa2pUFBCxF9nASQ0SNgJPlIIw&oe=69BE9E4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_y6OpqHdlVYQ7kNvwEVsqCB&_nc_oc=AdlW1OMw_yvU4JgMpTV1O637vDCb3FiWT5smAAAY5usVOQhQLUnmGJzU-wVj6PYNSSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4lK1LTRrxqS_pa0NAWXsVNvxMIZlOmfDhXvsioG6Wvg&oe=69BEAC0C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
ohc=z0EtHFz9AbMQ7kNvwFE2Zrx&_nc_oc=Adq7zkT2zBfNH7aoyfwe14k691yacJA06lOFeSfuOnBxwrGbl3FJ-GPFRbUYOi79vrM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReQqmyhwZMMjGm3IJILPbTLNHmEX0YDAj_39Jmhiv0GA&oe=6AFF088C"}, "display_name": "Cloud Breath", "keywords": ["Meditation", "Breath", "Chakra", "Relax", "Color"], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NO
3029385180533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e0zMBtNx-AQ7kNvwGxh32P&_nc_oc=Adl2qjC54y8pxPXAYY9ICrCTeybYN_d2ZfQ_y7DnI63oYEtG5M9UJDHPZyqBdkEsCG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCZ2YA0BX2cwIxsRF3XhO79XcbFhDu-NDHnqNAOVevVQ&oe=69B81308"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0m-SLA4W8wQ7kNvwHIRwUb&_nc_oc=Adls24T1upFV-5a0OXJ0HDiPLzjf5iEW7tMQ5bXV_e9evOWvUrWIa3Yxd1wR2laofIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgBzVucaCtBvfthrcM1ZH7oG2h__FpNMZ5hDDI8ywGLQ&oe=69B806CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms1acfzicjkQ7kNvwFDvr27&_nc_oc=AdnNmWqKEcm7bRj5WhJlrUEuwBywTJjmABKvQZrrwtTWdxh5J7Qfqclib42IinkrtXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcKLTcUn3PgsZFH7P_osVRBbkZ7oSlaSP34SHqN-zzIQ&oe=69B8148C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
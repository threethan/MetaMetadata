3029385180533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqsUYvOVKcYQ7kNvwFp58JA&_nc_oc=Adky0o1Ait_yLyWa5DIis4wqimn98EvfUlzfZX5lfALa6dY_m2pfsdIvNdofO0RKMRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRofQnL6DoQEHbVSwzAF6G9xw6xwnpJyCpwCW7CGInsA&oe=69B41E88"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPQaj4qzpN0Q7kNvwGQyp_w&_nc_oc=AdkrOj4d9G-VqKCi6Q-IJOPBXVqPOOmHLBloVLLXxDeXvfeb4qgo1MWrU4DuD8hngvA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfygTR0PQp6vqyHWP_A--tY7CsBXQ_86p2m42lnJFBXT7Q&oe=69B4124B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Yj4lVA_ZBQQ7kNvwEtgzAV&_nc_oc=AdlleAnZEucUmmaE5F52SMCasJSSlAMqwJ4XTWVokiyCJAnlIAexO_qiw3PDi4KoDgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4oBLvsw1D_WBcIzskjyoeWJn4-xRRC3ViGzoNfB2pdA&oe=69B4200C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
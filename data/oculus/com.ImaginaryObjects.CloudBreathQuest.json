3029385180533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwHClv1nVlUQ7kNvwHJmhWi&_nc_oc=AdnQHAWGnCUqeQh10TUd1dEDTg8_d9RtuUUbnpOoVVbPVJb9GlsSequwgOrmC1icHFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsdJOFDyrmT5hwzoYXqIVratisQcMt-VwxQOSPtR5XAwA&oe=69A84108"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiiTZWbe_zUQ7kNvwGFf8Oh&_nc_oc=AdmGYZKPSyhaUNT_UFeVLV73ZMoO45tkiV6_l_RSKgqlNFWEt8rebWhONbAg5ajOQ_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu9wD55wTeguXIUge9ZqGGHWeote6Mqq7_oe6XXM8Z7WA&oe=69A834CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiRYF8cd_r4Q7kNvwE2bZdz&_nc_oc=AdkL6rpY62NJcabQcMLR-uMnNurL0_s8t982XvT5YL_Dyei0YMHee9woREvY8GPUYIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu-yXMNUTVHsMOVbjSGfEXNjtFb9ZsZ80gbnBkLsh0A_Q&oe=69A80A4C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
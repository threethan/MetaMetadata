GqjTzzCv0Ke_SA3uR3PdxPNMTyqaSUzA&oe=6ACA4A6A"}, {"file_name": "004-CB-Screenshot.png", "id": "303029385180533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pCobqPUT14Q7kNvwHiZadt&_nc_oc=AdoWOBs-vMR_BfFLRdy8DC8sAirFrvSqb-Odia0r2YasDD0WpKmsuwyKYuf-hpQ7MEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4TPu0DQbour3adrPmh2drukv1PIf5ZdrgKmMJIGzVpA&oe=6ACA4B08"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJerH7rM3H0Q7kNvwHMtHoE&_nc_oc=AdqJi4UMtUQO4tndSxy9a2VLfRbGR_5OUnwfZkAXEdf4isp9p7R_eV6nQv8wHVt07xU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcqUTS8fmiyxE81arG5p1iTocoJ4PqzClwbXhVJRGf3g&oe=6ACA770B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quI-1fUhINAQ7kNvwHfboZx&_nc_oc=Ado4U7i9bEIa9_5f76H3KSWWcbJgOmW0xfzJEHnMg31MwNJ-qowB4LygFYnLCfJv8BE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjsGqsbigK3D_5JFhIOD65V4KWup_I9dlx8MU3uEx0dg&oe=6ACA4C8C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1152635825509194"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2017714946294625"}, {"status": "PUBLISHED", "id": "1053268213405463"}, {"status": "PUBLISHED", "id": "9096348473783072"}, {"status": "PUBLISHED", "id": "545614435032350"}, {"status": "PUBLISHED", "id": "490155284063281"}, {"status": "PUBLISHED", "id": "245611767879937"}, {"status": "PUBLISHED", "id": "288981900009378"}]}, "baseline_offer": {"id": "545614435032350"}, "is_approved": true, "firstOffer": {"nodes": 
CD--aY33J713pyQrx_JQovTM75fCR4GFz1g&oe=6AF1EA8A"}, {"file_name": "003-CB-Screenshot.png", "id": "2222106897947126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974561_2222106901280459_1280595873516126760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUsUD8OYzuoQ7kNvwHgL8m-&_nc_oc=AdqEvBG1aBtsXJwpYYuc3G7uN3YQa5egV4Vt9538b3o7rhF6IFrRNqJWrw-LtqOQ05U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-tsD_OinZv2MPp9AK4WK-h4xeAlBkFVc_Xmw82epIhQ&oe=6AF1D76A"}, {"file_name": "004-CB-Screenshot.png", "id": "303029385180533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aegwNFx1cHwQ7kNvwE4zTSP&_nc_oc=AdohoN3jukf1wDN9mnTXU-a7r8coOUJUy1Q0uu5hds5KP_J_R2X9ff-axQt71gjH1mk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-TfH0pAXYUhp9AeheO95lxFCC4pg2C02_sqk2ClaJcg&oe=6AF1D808"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0DGk84-bVQQ7kNvwHdT0QR&_nc_oc=AdoRTx7XR5a8e28BfuELAy9-5vPeEmfO_5aNjhM3imO5RRfOujKaKYR1uwtWl15unrM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEcSGSjGrVdGmmSQXkplceId7P1rTh836PhKyzjjFB7g&oe=6AF2040B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v76SOef97pQQ7kNvwEAj6yW&_nc_oc=AdoaABL1BXVrL33MWR1TIc0_RsfO9eqBWmJRNvV2jor9YAteF2RvBS4zu46DzQSQdwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7WIT44Q_t5uyyxepDgXy-Xr6Ue--xH7FSlY-iO9shVQ&oe=6AF1D98C"}, "display_name": "Cloud Breath", "keywords": ["Meditation", "Breath", "Chakra", "Relax", "Color"], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
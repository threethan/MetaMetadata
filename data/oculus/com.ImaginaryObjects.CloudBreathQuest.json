xMwcT4z-tRip414AkY8rSERhybk8Pta3xEg&oe=6A9417CA"}, {"file_name": "003-CB-Screenshot.png", "id": "2222106897947126", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974561_2222106901280459_1280595873516126760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otrPvef7ADsQ7kNvwHyvlzX&_nc_oc=Adqaa5x88aw-IRS4VhbgapXeH5Y8P9uj7AiT-cNAu9-bsFevZDFEv7zXNcM6R13Otik&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFbL10NyLtwasi6KaiKU-tkjEgUMi4PlFHowLWcn_L7Q&oe=6A9404AA"}, {"file_name": "004-CB-Screenshot.png", "id": "303029385180533", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcarlwWbhA8Q7kNvwEfFdIX&_nc_oc=AdrPMyxuOkrUt7asYrts56aZ4IJixJBzS4ObIETZpR-Jt9xp5dX_ZXN6Jryk7tr4E7E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPThP9pV5ui9kax7K6a6yETn8EzHCZ9ZefM3o0Y2KYEA&oe=6A940548"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpmHjGryS00Q7kNvwHrYwm0&_nc_oc=Adof9CT3IHxOpu5tfKpP-dx4Jii7c_5gKLPPwDYS9MTHbLwodBkYhxntpagK0V_K2fY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaRUT2FViWWnHBhSuZDO8S6IONSPJGOxBDmzi-PMqoPw&oe=6A94314B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi3cjw0-xaEQ7kNvwEuTAXc&_nc_oc=Adon877XHUqhqG2dkekRYkGo9GxKynOJtSYmc03XOYe1HSuemll2FJ9UEiEgnFSXrgc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqIBVyIABBapaboslVZQGCCVfEmHaqSgVEIlYXqwwu1A&oe=6A9406CC"}, "display_name": "Cloud Breath", "keywords": ["Meditation", "Breath", "Chakra", "Relax", "Color"], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
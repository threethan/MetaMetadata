IPEaArqk-U3YKISXLjPcm9AL6CKPNWP0TxA&oe=6AB7E88A"}, {"file_name": "003-CB-Screenshot.png", "id": "2222106897947126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974561_2222106901280459_1280595873516126760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SayQFoSNhZYQ7kNvwErA1BG&_nc_oc=Adp04KxJzqw0HPTvnRRmBszEIaBrjFc3i2oDTwFlqbUYRNPFJJGTdO71H09C-KaUlfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMv1jxQIGbS9NZnc1gMJcdobbxzg1Hmujd_Qd_hWzCIA&oe=6AB7D56A"}, {"file_name": "004-CB-Screenshot.png", "id": "303029385180533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4yg1TDli9oQ7kNvwFq5fit&_nc_oc=AdqIoaNxj1ksdH9gYaOmqXVA8jC84l0w5qifqz21uCy25Bv4uXGYx_9dIIbVpun2AOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXAz2F3A32RdQzYRAGaNCJQrPRp0Dqw6ZmQqxgqLDZkw&oe=6AB7D608"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8bQSnDY0QsQ7kNvwEJtOOY&_nc_oc=Adr-YkRgqvj8MgYRVS46wZ6SmFzL0knSjWEYvkfCyIRPkUstUgRUT8lzuG4r50IAlEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5WjU4ZPVay2_weU_8aXheOaMYBYoA1zOaXfNuuKLhdg&oe=6AB7C9CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmNP8ADfcxIQ7kNvwH4XR64&_nc_oc=AdqBThfuvcYYxli79Crc42Jd2oEzkLzpyk9EiTkKJ8zTaBYXldLJMmneqL6yRwY_Wi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqKquLaOgI1RKbyoRbGHvAIXIqv0TNN5HGFdPImsga2A&oe=6AB7D78C"}, "display_name": "Cloud Breath", "keywords": ["Meditation", "Breath", "Chakra", "Relax", "Color"], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imaginaryobjects.io/imaginary-objects-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imaginary Objects LLC", "support_website_url": "https://www.imaginaryobjects.io/", "website_url": "https://www.imaginaryobjects.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
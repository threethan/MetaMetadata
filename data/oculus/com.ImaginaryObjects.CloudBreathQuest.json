3029385180533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqsUYvOVKcYQ7kNvwGFushf&_nc_oc=AdnYAFobNznmlm_S5OQZtwsaKICQdWnsSnnv4wbAr6KjlXzt_r9IAXMzhKkjBZFHuqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUcNZjmHqMCAqsjsMHi217kFXTeZ5KnlBgrmPgVLQZBQ&oe=69B2CD08"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPQaj4qzpN0Q7kNvwFcIijk&_nc_oc=Adn8y0c2vqSNW741wXpCKtOO_0cvzqcmlZbKipC2F4ZjjKaBsvl1JThztjcflQrhneE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV0YxYy7yEeN0Un3553nIXiHkvyK9W-YRW8BuczLxalw&oe=69B2C0CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Yj4lVA_ZBQQ7kNvwHEj7w7&_nc_oc=AdkJ6_0rhwPMqV3Q79Dd0x7TsLzfkAKocbAuFJbSK1yiHpofDHQtC4BnJ6y3g7o_J3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIfZbhhm4k8pJXnG7QaeOvKID28jUe3-sW3pz9djR9NQ&oe=69B2CE8C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
3029385180533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5fgTUaA03UQ7kNvwHSfc78&_nc_oc=Adk3PGV0ixQBPo5xPppw1aNGtE10yGUIVmv9Rs-aWyS4ptF3KaGNHyj7Bv4qwBQ8ONQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsiP1OVcAvaaC-vyHP3XyTMixFJvbORhQTozPpnBy2ZSg&oe=69A99288"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiiTZWbe_zUQ7kNvwG5di8m&_nc_oc=AdnWbOlgOb6z9xvXt00uH9WNf3TqnTrFBSPbUOcOoMMsZGoIzYK0oNlhBpDtzmeglVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv3SyyP9m-QRwGJnCDawdVX86kR-h-9bjSXT-x7BFBrAw&oe=69A9864B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZfBwP1fFJ8Q7kNvwE4VumV&_nc_oc=Admrf83H_YRnfIU9RJh9_tFcdNwREPecOoxqD9VseupvS2UNp4m-5KNUomnXTSBcOcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsT7SdjZpT2k-sfCSvA_C7B4ygObjoJX3LrOc7YRw3TJg&oe=69A9940C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
3029385180533", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974645_303029388513866_6447819358842920713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLfWm2pGSpsQ7kNvwGAfknK&_nc_oc=AdlPJHl99JwaE13u3J7woyKmAcVrLPF179UWIY7v_nqUsgITekwILA_6iVhfTQIrPIY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK8mIG-whFMP_g-HWNjncmYRxgczDbo_WEWBwtDZ-iVg&oe=69BAB608"}, {"file_name": "005-CB-Screenshot.png", "id": "424038006073458", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974528_424038009406791_1795171070576386841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGGMZosNUV4Q7kNvwHPOBMg&_nc_oc=AdlbOJLHbUrmaedJ5KvY1JEH2-QZwkpeAEtZjaKZNZmqzIwHSQTf2CMFFso-bSpL3-M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afztb3niZFOpVl5LZaPbBDBYM0GvXrkHWqgfJ4OkiOz0eA&oe=69BAA9CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-CoverLandscape-CloudBreath.png", "id": "923528738527797", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974867_923528741861130_1137451032775002230_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cps-FKSZ9O0Q7kNvwHGsLg_&_nc_oc=AdlsMfj-3lMeUOpVDpqMIlHnxQoS0ex-T03_Ilv0wkG8AgMw94J8kuRkvheoI6M_4p8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzdf8TrU76f1e7q91K0mJ9AlGdSVkbWHUJzo_ZxntKeUg&oe=69BA7F4C"}, "display_name": "Cloud Breath", "keywords": [], "long_description": "Cloud Breath is a 13-minute seated VR breathing meditation app, which immerses you in a changing environment of color, light and sound. It gently guides you to focus on each of your chakras, the seven energy centers in your body (red, orange, yellow, green, cyan, indigo, and violet) by timing your breath to the movements of a luminous colored cloud.\n\nIn a powerful and hypnotic original score by NYC-based multi-instrumentalist Greg Fox, each level has a unique composition \u2014 a modular-synth and percussive drone, based on the musical note assigned to each Chakra.", "short_description":
://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623345_1630145191874024_5245347413424424797_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRRAwGRJGrsQ7kNvwHHQsHW&_nc_oc=Adq3IYMgSOrCznDGlhgUMO7ekoQqgQUwVS9hUI7s8CCW0w1tRWEnpfIgno2ksGUQBWE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr_pn99ql9LFqBJDwoJ9SBxeZPLgdLh1keJ_cRPlWbIQ&oe=6AFB4955"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Off-Road Racing & Driving Simulator", "keywords": ["offroadracing", "offroad", "offroaddriving", "drivingsimulator", "racingsimulator"], "long_description": "Get behind the wheel and experience the ultimate off-road adventure in Off-Road Racing & Driving Simulator. Explore rugged mountains, muddy trails, rocky roads, steep hills, desert tracks, and challenging terrain while testing your driving skills in immersive virtual reality.\n\nDrive a variety of powerful off-road vehicles, each with unique handling and realistic physics. Race against AI opponents, complete exciting driving challenges, and conquer extreme environments designed to push your skills to the limit. Whether you enjoy high-speed off-road racing or carefully navigating difficult trails, every journey offers a new challenge.\n\nRealistic vehicle controls, detailed environments, and immersive VR gameplay make every race feel authentic. Climb steep hills, cross rivers, avoid obstacles, and master dangerous roads as you become the ultimate off-road driver.\n\nFeatures\nRealistic off-road driving and racing experience\nImmersive VR gameplay designed for Meta Quest\nMultiple off-road vehicles with unique handling\nChallenging mountain, forest, desert, and muddy tracks\nRealistic vehicle physics and smooth controls\nExciting racing and driving missions\nBeautiful environments with dynamic terrain\nProgressive difficulty for beginners and experienced drivers\nOptimized performance for a smooth VR experience\n\nTake on the toughest roads, improve your driving skills, and prove you have what it takes to become the ultimate off-road racing champion.", "short_description": "Experience realistic off-road racing and driving in an immersive VR simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1306470742545369"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_1265283548918001_1103753048053600827_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQP8FIuYmfMQ7kNvwEa0PJa&_nc_oc=Adr7f-OZ5Dc7YDoCezhgqgag_xJIXS1inBkrFR3xTZyAip8nVmk4RJO_GL2D-vfpRBA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw1w1T_2qa6x44nU_NdOLklY7kLNOTBACFCi4-ep08jQ&oe=6AFB3514"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Off-Road Racing & Driving Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_na
fnq&_nc_oc=AdpewQ691Dy8_7dKYbUTfr6Husqe9HLzvNX7HnqX7iHLwFp4x6nTYFjoBVSCJNHy-o0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHAX4WoWiXvFdMVmoh4g8t4DfRLul9V5oMhuah8nUqug&oe=6AFC9457"}, {"file_name": "5.png", "id": "318802671133507", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035302_318802674466840_1853670579831830610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KVgaqz_qU4Q7kNvwEcS1bj&_nc_oc=Adr32nZQHRk_HHlLlCMiJL3hnBaOaeLhy6BGCqNw1QjLr-bmu_G38FnQ-UW6nd8gcAM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZxTL8cCtQ6ZRVRJwGwwPXLhbctBPpUBSqFLe1QQr_cg&oe=6AFC643C"}, {"file_name": "2.png", "id": "364719136164026", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982616_364719139497359_1411155443060399617_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkubW_L3d3cQ7kNvwHXT5Oz&_nc_oc=AdoCHKQaffbnFgFn5giDDfK635BkXbNFR75qko4CvHo_RXVER121MlXZIYfDR93SzKQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaMuKh_h4WKkUGNmu0i5pQLj93T5Q0D2ek4y0y6-huRw&oe=6AFC650B"}, {"file_name": "4.png", "id": "3814418192216575", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75223482_3814418195549908_5866507427421967146_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLcTWnqqHP4Q7kNvwHJNRoD&_nc_oc=AdqeSSiYw8ug78agNSh2NaTWCNYqjpVVKdlT7ovWs8B3DKFKk_6hNqi3nosURYKJFvg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMy2p7v7pKRr_uG1pH5eBir-EPeq5mT0u5UpR3qS0gmg&oe=6AFC6BF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carbon Ville Spin Classes", "keywords": [], "long_description": "Welcome to Carbon Ville \u2013 Your Ultimate Virtual Fitness Oasis on Meta Oculus! \n\nImmerse yourself in the future of workouts with our groundbreaking VR app. Join instructor-led spin classes, embark on interactive fitness adventures, and connect with a vibrant global community. Elevate your routine with stunning environments and spatial audio.  All you need is a stationary bike and your headset.\n\nKey Features:\n\nComing Soon : Multiplayer Workouts: Connect with friends and fitness enthusiasts in real time. Available in the paid version for an even more engaging experience.\n\nOn-Demand Classes: Enjoy flexibility with on-demand classes at your fingertips. Take your fitness journey anywhere, anytime.\n\nMassive Video Library: Access a vast library of workout videos for all fitness levels and preferences.\n\nEco-Friendly Rewards: Earn points for every workout, converted into real tree plantings worldwide. Make your fitness routine a positive force for the planet.\n\nWhy Carbon Ville?\nUnleash the power of immersive fitness in Carbon Ville. Upgrade soon to the paid version for multiplayer fun and a comprehensive video library. Your journey to a healthier you is just a download away. Join Carbon Ville now \u2013 where fitness meets sustainability, and every workout makes a difference!", "short_description": "Step into the future of fitness with Carbon Ville on Meta Quest! Immerse yourself in exhilarating VR spin classes, and connect with a global fitness community. Earn points for every workout, and watch as your dedication transforms into real-world tree plantings. Fitness meets sustainability \u2013 download Carbon Ville now and redefine your workout experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonlabsxr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Labs XR Inc.", "support_website_url": null, "website_url": "https://www.carbonlabsxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOA
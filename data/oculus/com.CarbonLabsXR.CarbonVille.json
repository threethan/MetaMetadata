scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035302_318802674466840_1853670579831830610_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMhW0-8wZ6IQ7kNvwHROBJU&_nc_oc=AdnpbE1b_78Jk45G2LdefX1NDYkO4Ytde_Yk6Macm50-vxcqrVzhd_F9KGkfj03lZp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7vrRoHuE9QofgFaUG4ipBX7_QssFJDPEty_K5BwtNsA&oe=69B6C1BC"}, {"file_name": "2.png", "id": "364719136164026", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982616_364719139497359_1411155443060399617_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpN2kjwzqgIQ7kNvwE_zyuf&_nc_oc=AdlRC7k9EdBaiGuNmcFo94oXrx_t_IgGUzQtP5Uj6k7-gPkFcaKa3t7OaTjDi7G0svM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK7g011uZH9MaqcfR3VUAJbcN99uokAu9NGAh6EYSK0A&oe=69B6C28B"}, {"file_name": "4.png", "id": "3814418192216575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223482_3814418195549908_5866507427421967146_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drFOyNZMJ3sQ7kNvwHYWkHl&_nc_oc=Adnn3CQ3-u1Zzu2fKrvEOpuG43x4wKigMZ8bYPCdskXWc6xfVQlWustBiC_ktiNISjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3BrrvGKtvy4hAhN2ud7hozFVBjl26IrbyGq4wBEZPfw&oe=69B69137"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carbon Ville Spin Classes", "keywords": [], "long_description": "Welcome to Carbon Ville \u2013 Your Ultimate Virtual Fitness Oasis on Meta Oculus! \n\nImmerse yourself in the future of workouts with our groundbreaking VR app. Join instructor-led spin classes, embark on interactive fitness adventures, and connect with a vibrant global community. Elevate your routine with stunning environments and spatial audio.  All you need is a stationary bike and your headset.\n\nKey Features:\n\nComing Soon : Multiplayer Workouts: Connect with friends and fitness enthusiasts in real time. Available in the paid version for an even more engaging experience.\n\nOn-Demand Classes: Enjoy flexibility with on-demand classes at your fingertips. Take your fitness journey anywhere, anytime.\n\nMassive Video Library: Access a vast library of workout videos for all fitness levels and preferences.\n\nEco-Friendly Rewards: Earn points for every workout, converted into real tree plantings worldwide. Make your fitness routine a positive force for the planet.\n\nWhy Carbon Ville?\nUnleash the power of immersive fitness in Carbon Ville. Upgrade soon to the paid version for multiplayer fun and a comprehensive video library. Your journey to a healthier you is just a download away. Join Carbon Ville now \u2013 where fitness meets sustainability, and every workout makes a difference!", "short_description": "Step into the future of fitness with Carbon Ville on Meta Quest! Immerse yourself in exhilarating VR spin classes, and connect with a global fitness community. Earn points for every workout, and watch as your dedication transforms into real-world tree plantings. Fitness meets sustainability \u2013 download Carbon Ville now and redefine your workout experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonlabsxr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Labs XR Inc.", "support_website_url": null, "website_url": "https://www.carbonlabsxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7280755805345985"}, "review_messages": []}]}, "co
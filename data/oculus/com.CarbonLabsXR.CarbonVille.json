q7o&_nc_oc=AdotPwBexM-MWsTbVHj4YjkNt__DDuEc16hM6E9WBvBGDXUE4o49VdaISdqfJg59at8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXYWzbZxD54YnlTxusH2RwdKnXH20WA6E7XXf4oDnJc9Q&oe=6B0F0957"}, {"file_name": "5.png", "id": "318802671133507", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035302_318802674466840_1853670579831830610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVaXvnfmD48Q7kNvwEJdXJ_&_nc_oc=AdrNXYYWLPhERriruRa28HzfciWz1wrKvEwlsNSsUd464n_0fGe5OKzDkl-S-FOyIsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqopHldNXOP0MfX1BNiREtuc2I9cSU9YT8NR3Z3Tj-EQ&oe=6B0F117C"}, {"file_name": "2.png", "id": "364719136164026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_364719139497359_1411155443060399617_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgIND45W41IQ7kNvwFHOG7_&_nc_oc=Adqo_6fkDr6fXMsTLSZyTHSG4PcaI4YVhwQdEui87f4_mhOIyf1idHCOpPXDF31YHhY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEqYK3-l5le9HKOLyQ_9F1X9vgOFiIDQnPK-Yv4SPcHw&oe=6B0F124B"}, {"file_name": "4.png", "id": "3814418192216575", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223482_3814418195549908_5866507427421967146_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN5dTZnKgpkQ7kNvwHUbEXJ&_nc_oc=AdqFWwSKxFxTQa1_u30RaHGbFoeTAGa0LXrUlRvAYijH9WnxzNI6Dl05QVg-qLA8324&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXN9q8X73w_C5mOwbL1-0Ynw4HESYJbHgfqvuGEXt4Xdg&oe=6B0F1937"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carbon Ville Spin Classes", "keywords": [], "long_description": "Welcome to Carbon Ville \u2013 Your Ultimate Virtual Fitness Oasis on Meta Oculus! \n\nImmerse yourself in the future of workouts with our groundbreaking VR app. Join instructor-led spin classes, embark on interactive fitness adventures, and connect with a vibrant global community. Elevate your routine with stunning environments and spatial audio.  All you need is a stationary bike and your headset.\n\nKey Features:\n\nComing Soon : Multiplayer Workouts: Connect with friends and fitness enthusiasts in real time. Available in the paid version for an even more engaging experience.\n\nOn-Demand Classes: Enjoy flexibility with on-demand classes at your fingertips. Take your fitness journey anywhere, anytime.\n\nMassive Video Library: Access a vast library of workout videos for all fitness levels and preferences.\n\nEco-Friendly Rewards: Earn points for every workout, converted into real tree plantings worldwide. Make your fitness routine a positive force for the planet.\n\nWhy Carbon Ville?\nUnleash the power of immersive fitness in Carbon Ville. Upgrade soon to the paid version for multiplayer fun and a comprehensive video library. Your journey to a healthier you is just a download away. Join Carbon Ville now \u2013 where fitness meets sustainability, and every workout makes a difference!", "short_description": "Step into the future of fitness with Carbon Ville on Meta Quest! Immerse yourself in exhilarating VR spin classes, and connect with a global fitness community. Earn points for every workout, and watch as your dedication transforms into real-world tree plantings. Fitness meets sustainability \u2013 download Carbon Ville now and redefine your workout experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonlabsxr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Labs XR Inc.", "support_website_url": null, "website_url": "https://www.carbonlabsxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOA
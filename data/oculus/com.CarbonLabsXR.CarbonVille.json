1830610_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7nPAb3tz7AQ7kNvwHx5C1K&_nc_oc=AdkGLdupNo9lkv0mzsNEk8v1kaOPaibnizX80tIngLviaq1jyUqWlCxM0POFcsTc5Ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJbQSjPoPnpQcgl-G6C8GcYzMFpLk3hG19INysURaOrQ&oe=699DB53C"}, {"file_name": "2.png", "id": "364719136164026", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982616_364719139497359_1411155443060399617_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEpmu7lfQeMQ7kNvwEGAmaK&_nc_oc=AdnXvVeEB5rCyjfDr9XQEsfBkJCwC_Xc5HiG9iHrHuMjUZBxBfEoSRJvfigVDJ-WojY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyTMb3WSWRGb5JLUVR37Cwk_SEFM9CPdcaFwppPd3mcQ&oe=699DB60B"}, {"file_name": "4.png", "id": "3814418192216575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223482_3814418195549908_5866507427421967146_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF6m0DQPPkYQ7kNvwHW--tR&_nc_oc=AdmtcZOgT8ul0s0p-Lx63mFXSLLU-nih43YLcBDBsyHgEFgVPr12ietDb6C-1_wosi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuzfMWA4709tQ302lm0z2HGHtHloOhBcc28AJAjPpkojw&oe=699D84B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carbon Ville Spin Classes", "keywords": [], "long_description": "Welcome to Carbon Ville \u2013 Your Ultimate Virtual Fitness Oasis on Meta Oculus! \n\nImmerse yourself in the future of workouts with our groundbreaking VR app. Join instructor-led spin classes, embark on interactive fitness adventures, and connect with a vibrant global community. Elevate your routine with stunning environments and spatial audio.  All you need is a stationary bike and your headset.\n\nKey Features:\n\nComing Soon : Multiplayer Workouts: Connect with friends and fitness enthusiasts in real time. Available in the paid version for an even more engaging experience.\n\nOn-Demand Classes: Enjoy flexibility with on-demand classes at your fingertips. Take your fitness journey anywhere, anytime.\n\nMassive Video Library: Access a vast library of workout videos for all fitness levels and preferences.\n\nEco-Friendly Rewards: Earn points for every workout, converted into real tree plantings worldwide. Make your fitness routine a positive force for the planet.\n\nWhy Carbon Ville?\nUnleash the power of immersive fitness in Carbon Ville. Upgrade soon to the paid version for multiplayer fun and a comprehensive video library. Your journey to a healthier you is just a download away. Join Carbon Ville now \u2013 where fitness meets sustainability, and every workout makes a difference!", "short_description": "Step into the future of fitness with Carbon Ville on Meta Quest! Immerse yourself in exhilarating VR spin classes, and connect with a global fitness community. Earn points for every workout, and watch as your dedication transforms into real-world tree plantings. Fitness meets sustainability \u2013 download Carbon Ville now and redefine your workout experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonlabsxr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Labs XR Inc.", "support_website_url": null, "website_url": "https://www.carbonlabsxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7280755805345985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931340_225606610590296_371
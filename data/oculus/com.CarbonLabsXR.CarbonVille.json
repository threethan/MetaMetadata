LxZ&_nc_oc=Ador3m3qKRH9UbtKVyocWPMgl9pIfBHO3ZlQwn1nJ0bsnWYQlQq9L4TeJ7ik_n3Y82M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4spN6W7AXvrD1mrmtiJIO_YkzrdIBNBmCLq_BkjSPDA&oe=6B072057"}, {"file_name": "5.png", "id": "318802671133507", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035302_318802674466840_1853670579831830610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sNsLbaQSjcQ7kNvwG8ciYK&_nc_oc=AdpDcEYxCqD0ZSnUKTlpjy6goqnzFt88s_G0MKllVaylgi0MWEIvoehWcqEKpAzZvwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfMCDBv8KTBKjyaDXDakoeSejcdSqGhWDIg3haby_BaQ&oe=6B07287C"}, {"file_name": "2.png", "id": "364719136164026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_364719139497359_1411155443060399617_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyQ3tfVg9rgQ7kNvwFRPohU&_nc_oc=Adqt25ipj9dJ1VvWWGF5PYROuEK1t8V0fIC0O4jHL106-gv_gdzx98Jv6XrzQMzQSyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRZsMIOtkwsvsmIEmY9Qq830whpAhQpSCk8s4V4RMisQ&oe=6B07294B"}, {"file_name": "4.png", "id": "3814418192216575", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223482_3814418195549908_5866507427421967146_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWP1lNavNQwQ7kNvwEBH3me&_nc_oc=AdolsvbWEFzxSOJ31sU2nLGoA-twK7CtK-Peln1Uk9JiApdusy9c2HlPdYEwceriDOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCJnoBHFnyRtxnQYwJXwC01o0S1cNDy9LNnZBmKuNXCw&oe=6B06F7F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carbon Ville Spin Classes", "keywords": [], "long_description": "Welcome to Carbon Ville \u2013 Your Ultimate Virtual Fitness Oasis on Meta Oculus! \n\nImmerse yourself in the future of workouts with our groundbreaking VR app. Join instructor-led spin classes, embark on interactive fitness adventures, and connect with a vibrant global community. Elevate your routine with stunning environments and spatial audio.  All you need is a stationary bike and your headset.\n\nKey Features:\n\nComing Soon : Multiplayer Workouts: Connect with friends and fitness enthusiasts in real time. Available in the paid version for an even more engaging experience.\n\nOn-Demand Classes: Enjoy flexibility with on-demand classes at your fingertips. Take your fitness journey anywhere, anytime.\n\nMassive Video Library: Access a vast library of workout videos for all fitness levels and preferences.\n\nEco-Friendly Rewards: Earn points for every workout, converted into real tree plantings worldwide. Make your fitness routine a positive force for the planet.\n\nWhy Carbon Ville?\nUnleash the power of immersive fitness in Carbon Ville. Upgrade soon to the paid version for multiplayer fun and a comprehensive video library. Your journey to a healthier you is just a download away. Join Carbon Ville now \u2013 where fitness meets sustainability, and every workout makes a difference!", "short_description": "Step into the future of fitness with Carbon Ville on Meta Quest! Immerse yourself in exhilarating VR spin classes, and connect with a global fitness community. Earn points for every workout, and watch as your dedication transforms into real-world tree plantings. Fitness meets sustainability \u2013 download Carbon Ville now and redefine your workout experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonlabsxr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Labs XR Inc.", "support_website_url": null, "website_url": "https://www.carbonlabsxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOA
cdn.com&_nc_ss=7f20f&oh=00_Af8R118kP0bIb4TVG-FByLUzhVE7fK6aOJbobWAieq8FvQ&oe=6A36B3FA"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkk9ZUmNFZkQ7kNvwHKM3xJ&_nc_oc=AdoxAv5WTyP3dV1CDKVj3z5aCdC9xYuhstwC2tbFFQGqeCxGGPBZPTUZNv1rXfgtfZI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lu0EKJr7Z0oUigdm1Ltz-yPBPDGqj3unqMPAJyz1AaA&oe=6A369854"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsAap-KZt6UQ7kNvwHKH9tg&_nc_oc=AdojGOYtz9cvTFaQV3A43LRECOummm5PInWsmU6NmFBW6XWm50TcfBMxFNnLu4s0Blo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e9RiObXnGRokvrEEQasS8Q-rcW0x4l5zhUY4fe_ERcQ&oe=6A368F93"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvoYkwVOv3oQ7kNvwFOe9Ql&_nc_oc=AdoXHxD2RFqPI6FmHKRm4lgW1nC2mg0nutQmIbae0jX2llr6Waf2Ev4tHV4t77IQEIo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90XAu-WKytTXTBiZ0LiJ6zphf9H90F_w28CSV6YIni3Q&oe=6A36A8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8YhE0nCLzIQ7kNvwFFl-Kx&_nc_oc=Adrdz1uO-V5IX77gNLzZaqo63A47k7Lvz7ss3YAYuqEidKU1ResyiiFn3-H-yNxQYjQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yXUkuIv9F6ffDEoNDlOrSdyL_De-AjHt6m6_Y-9ZfcQ&oe=6A36ACEE"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
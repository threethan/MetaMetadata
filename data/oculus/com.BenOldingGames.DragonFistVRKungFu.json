JhAn47c8P57NGXUAuKqrzvhCHYW3XNvAy-wUKaQwIBtUdN1DA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hVfOnCgEvodMg0sWXK36Qt-F0QxT3sJOln3HSxBiz4g&oe=69F1EDBA"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rirtEfbT5XoQ7kNvwGTnDYK&_nc_oc=Adrt0abiVU2KIW8AMxcgrIoff-vm9Qyk3yHDbhkoH76sdZl-y0TmSGwpHhmOT98azg8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3vAk57mq97zuHC6YyVJYyVNh8RUyhzsVvVmwEFOEdeNw&oe=69F20A54"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N19XUAsMiCQQ7kNvwF18ZWF&_nc_oc=Adq45qiiUkwuhpoDgpUiRIrZfOUlqt_XliM5Uyq0tpA-OQJ545rQA-hZViozFtGBfQQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1UK66tPAeoUZDFopy_6mff9GeWf7GetA_ERK8KeUBVLA&oe=69F20193"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK7v-7BAUBUQ7kNvwGYmTOv&_nc_oc=Ado-vlVW-obGh6-jXd5lDb0ZbAnme-DkahLUerzUbl93iLC05DjP-MdXS6TcCdSFwyY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3XhFjlViBKGdsEKJwhcfKGG4TL2BE49oXEoeOCpdQl7w&oe=69F21AF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4ha14mbxCAQ7kNvwGGx_ME&_nc_oc=Ado1cvB-zg14ezs1jABkYwYvxEv4lJEDl9BllkKtA0VsMlz2oX14bexoMrMQwWDggaA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1VKhHao4YpjNW6W1AhpglGyqKvimQ-JUgvFxMP0BQNCg&oe=69F1E6AE"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics"
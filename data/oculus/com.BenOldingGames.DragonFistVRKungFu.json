02377252837958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VJ9qbZ-u1wQ7kNvwHg8mh6&_nc_oc=AdrcTTnuxJ7uQJoYXzPPgeLzuS3C00z2pWkaqz8y1_5CAqoPB0Xfvy1Ew-wL5V8sDV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHmXCmUO3Ml1ZOg6kq8IDMMHOlhK6WllXQbSIU7DdiUQ&oe=6B0DD0BA"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhP4WLuFSGsQ7kNvwEL3KW9&_nc_oc=Adq034-Noo88faoXnfJReD-5kepxBppt6X88LwEOXQ5O4pGw7-sJnkJZmvjKOCU0OGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuf2CCGrc8HPjbaDhGhYSVkeSlLMIpWREQ5OdVysdMpw&oe=6B0DB514"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtB2JKufm2wQ7kNvwG0D1Ox&_nc_oc=AdrYLaLCdzBkX45aGUB0msEulvZoTD2T5sTwXrXGx5b82UULqkRMSrmRp00IR6tAMPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7caRPRP-Bdp1RCaju7Hc1Kva-CdGM1OG6XQxf-Nv1jA&oe=6B0DAC53"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE3R4enB8wcQ7kNvwEjwBUC&_nc_oc=AdpiOmz09vy9df18wiCS5D8M6hl3oVExCAQV6kM5mpqlngWoOpNi5qJyTqAFRmmkSO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-Qv_gF2xwdwZ9h-NyxXzvlvm-bqraqZPHeZkWVe4EPg&oe=6B0DC5B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vxjbtad8gTEQ7kNvwFfufgv&_nc_oc=Adr2qOdMGPX_SnGDxSyMAa6zbc8RbK-NpFiRV26DP_kb6uSxv_9iXTnF5lQA5cgSCTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQipVbZvPIrNWDSsk3OW9wxyaJ9cgSWozy9PgXbfpIfyA&oe=6B0DC9AE"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
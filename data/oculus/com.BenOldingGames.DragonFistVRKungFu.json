qkkh0BSccQ7kNvwGPGKoB&_nc_oc=AdqaaeJk9-V3zdbksFqrbhU0k_08oVOUlJiLSR6Ii1XC2gCsqoI4993bj9GmIxZqb-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4ZGFFA-THH9X6pD6ANMOTUnyG_jr0Mt_n5Z8cLL43pQ&oe=6AB7EB54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499303100_706633645726305_1769912601622852371_n.png", "id": "1675910600824060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313072_1675910604157393_6371594827506090307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuyYT5wlSGoQ7kNvwFtxVAj&_nc_oc=AdpknZGGIfqsq0Ur3vYh2zr3F-lDuAGlhOFUY1sAfqEOGAGtNkVtySJesaxoMPH2EII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpcBSqGSBcmYpJ5RMxu4zlnb6FkX6ns1q2aqpFscL6GQ&oe=6AB7EC0E"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "physics", "boxing", "kungfu", "blade"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie, you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{1057677706737759}\n# **Forge Your Fighter**\nCreate and customize your fighter with an abundance of customization options. Select your appearance, record custom moves, select your strength and weakness, and more.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...", "short_descripti
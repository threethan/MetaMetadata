&oh=00_Af8ZxPaJqMWqU63IoBX3kAWP21baDaOsYemFn0q3uoBGGA&oe=6A3933DC"}, {"file_name": "DFVR_Western Warriors_PNG_SS2.png", "id": "959525750064347", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303971_959525756731013_6263242562532487709_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSXjcy0ZbGQQ7kNvwEfYPHF&_nc_oc=AdqPp2swnCozdkM_t9ak0S4JsMO2Vkwg_qr1ghYabEavsjxuH7lAaHixAGo3dcYsepc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af898Cu8qDSOVdHM9QvBty4fdwgt8UHRnfqqRmmU94HB7A&oe=6A393D7C"}, {"file_name": "DFVR_Western Warriors_PNG_SS4.png", "id": "1206995841283926", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819281_1206995844617259_7328660978693763170_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CSebA5fJ5QQ7kNvwFPng6M&_nc_oc=Adrss7MRgCMf0K2Z9KjtoAAupgUQLiiJxdE1HHHwIW86GihZFRBDvmHkE4SBNhVbjU8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X6rP0ZEjbP0OspHJ8K-z2Ih2JZt6q2ZDMZatzf_VWhA&oe=6A39385F"}, {"file_name": "1.png", "id": "691900473696934", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499326349_691900477030267_8034961341760562964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--ArkmBzncUQ7kNvwE47swF&_nc_oc=AdrlCu3ICGt_9Do-X5m88z8XHlZ2dcr1sGnQSzV1EaHPo7Sa1GsFSifyPfzstLPlaqw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bImnFhjkshgEj1xYS7rxlvcSRHCq-IkRcOAjnG884Ow&oe=6A3945DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DF Landscape.png", "id": "962034739612303", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304305_962034742945636_3346748041246155813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqP7J4ckUDkQ7kNvwGKpiFB&_nc_oc=AdqSb43cvP-eJ_nGvmDIKrbqKORODMWNa28-krdH-xKkIy70-zbIdEfgIlChahGE7oE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s4ItiHl-GbIkNLlVQWHdRH8BRrfDWa1-B_s9a7CWXog&oe=6A395C1C"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "physics", "boxing", "mma", "martial"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove\u2014and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie, you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...", "short_description": "Step into your own Kung Fu Movie! This first-person Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive singleplayer campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": "http://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.dragonfistvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT
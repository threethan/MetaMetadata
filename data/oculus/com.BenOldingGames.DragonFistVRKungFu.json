QIbHu99YB9uhn-DHd7Uhx1JXc0FMEbHRF7puxOnsg&oe=6A3AA87A"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJvCQkRhWusQ7kNvwFdAXR8&_nc_oc=AdrNaWTAc7-0gd6fINr3NYUeW6QppvNbZoJCOjLIDVH0psnHMgu2BMsehchTHj5j2zs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90CfSyQDiTfa4E5bTWgLElAY4NL0OcVC-HumMxYLS8Lw&oe=6A3A8CD4"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuYY8DngXiAQ7kNvwFo-Y_w&_nc_oc=AdpaP8yTKoMnyXue-5BByhQ7B7lrg-e53UKpKg1lEPsVvVzwVgMkkvGKDmTOKn6NSfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SAMMarjU8YgK0TrHTIMfjXrxUuImm9iUoj73Bck_jDA&oe=6A3ABC53"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdW0pjhZwTQQ7kNvwEuszr0&_nc_oc=AdoTF-1q3ytLjCo9DBqTjtnfJliHk_y4LoY42lqdZJx_CJpfL_kRrKsoUqshtrnV3xk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bSh5m7HrGtG1hDwpacd2cAS4ztYxp-Gf5RqL4YMhUcA&oe=6A3A9D76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP7HVkEjLLYQ7kNvwGq5W6f&_nc_oc=Adr_Kr9onOwDZJkG45vIfSvpyzFrcUFUv8m9o39RyM8TU7gxMGhOb-4xTJcEX1JNZ70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hhbCV3XtGTnFCLxJWHN4x4G7rdEHt-3on8_TcytTGTw&oe=6A3AA16E"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
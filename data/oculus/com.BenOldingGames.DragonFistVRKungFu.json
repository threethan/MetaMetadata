02377252837958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GXdYyccmvkQ7kNvwGyZUjF&_nc_oc=AdocQUkiLP0hOfc-h7XeDgq8pLWcBf9iBZSUyuxHwilZ4kp22evfys1uxb5guEdS8sM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5wxLjeGotE4kmZgGhPj5z09kxDa8jpgE9uvsQDb1_KA&oe=6B0700FA"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z929M5es89YQ7kNvwHVF2Jy&_nc_oc=AdrFp5Iw89tcSghqAGaJotpqls3XJPLXB20Siy_Yq4IrdliaBOSwP4K3ARWnA9WQp4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyY-h9MVn8KSR-G4lFMJMhJgHEKbla2PfH6Ftfdbe30A&oe=6B071D94"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTClNmsqmw8Q7kNvwEGSzBq&_nc_oc=AdqsnR8--RyyR83DyFQiYsrLbDe-5wwGc0NXCAEIpQbbtlPOY-i0Tya_s6BP4Ck23tg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxfp9yRC1thRkb3NwiUEaFGzCvYiI-cuhLYyx1oJMXFA&oe=6B0714D3"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u_zmJrs-xkQ7kNvwFwSH3f&_nc_oc=AdqJJYhgfGAK1CG9tOhtkS6T4RY6Lbp4wCePEujA3aZ345F1mtZJkfiYDAIyfdrO1Cc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpibgMr8o6E_thxBqsXkD_epFP6WgWYqEOIawED9eB8w&oe=6B06F5F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggM7gfODTzwQ7kNvwEhw2UA&_nc_oc=AdoZeSs-liEFoMmVEHLBBByYtHz98lnLNC4OhZ4ybsRxPtioqYWd8GC8OZxHyLlZQuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyFBFPtgsU_zhue4DjJ3Nj6awPSv1IwIYaGs9yjXkQuw&oe=6B06F9EE"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
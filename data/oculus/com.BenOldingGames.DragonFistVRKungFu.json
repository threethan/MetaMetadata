998428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rxghrR2E8oQ7kNvwFB-g9d&_nc_oc=Adlzs6eDHg_6rwq22R7Gz88npJYhRDlmfVO6Hf8B-m96yJrFd8BoHjhl7TH9t6lXdQA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuPRa0Rqf_OSJLgH9htlnEw-BW2GgnPSBgcydO_2YA97w&oe=69A59205"}, {"file_name": "1.png", "id": "691900473696934", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499326349_691900477030267_8034961341760562964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9hkI87FHDsQ7kNvwF1bBl7&_nc_oc=AdmZknIPyEeDpAt3JtseG_4_qouPwnsoL7Gc3ZSVhB8WV-OIxl7WZ_ZWJffPvI4fiik&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsR-TzDbto60QTxyHa9Rc4uQb4YGDFEHx_94aPWHPF1Hg&oe=69A59DDD"}, {"file_name": "2.png", "id": "701610639047065", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499311591_701610642380398_6712854599056515091_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14WJsGQk4AIQ7kNvwEdj6N4&_nc_oc=AdltzPc52nhFiFPD8GPW3zQ6ddPiJbPcUTJZC6hFCQjcq-UupFHynByvvhiw1iAAchg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftZ4FtGYmFfQKSARwEsvJQBYx_qP8dQ6mUWqbeWcmOe5Q&oe=69A577D2"}, {"file_name": "3.png", "id": "1448057773232210", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499318571_1448057776565543_7678358617141313131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fITJDQop3PgQ7kNvwGAggl3&_nc_oc=AdmzJBeU_9P6KjGsHH7IsddN46OYtpaJTnm7YjhqwTv_y1GwHFIbinTTkY_fjCO4zjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsrrxshIxzYaoaRJynfbFr_RNTMQMLaE5ihYO5giaK6Hw&oe=69A58BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DF_MA_META_HEADER_COVERLAND_TRAILERCOVER.png", "id": "1646731639656721", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831792_1646731642990054_4019563495684792553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juNzy8d809gQ7kNvwH2eazV&_nc_oc=AdkVVCuaH6T75jw8hssiXbB9mqv93u71Zv4GFAfOP78rVo7g3Z3g0OsfbF2Nn0de25I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afui4rPg59zlUz1dx4jR4nBp-TT9RPIm97BJk7HJejCZvA&oe=69A57257"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "kungfu", "physics", "boxing", "simulator"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove\u2014and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie\u2014you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...\n\n=========================\n\n# New DLC: Midnight Alley\n\nTake the fight to the streets! Midnight Alley contains a new environment for single and multiplayer modes, and 3 new characters.\n\n- **New Environment - The Alley:** A narrow streetside area lit by lanterns, windows and the moon. Features breakable doors that allow you to enter side buildings.\n- **3 New Characters:** Play as The Landlady, The Centipede, and White Eagle, each with their own perks, weaknesses, and special moves.", "short_description": "Step into your own Kung Fu Movie! This first-person Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive singleplayer campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms
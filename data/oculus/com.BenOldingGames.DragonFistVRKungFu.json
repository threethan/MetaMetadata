_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh1LXlRJj-o2cxyORuz7PgefCj6oc5yCTpu0NsjSmWLw&oe=6AFDC67A"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUGdCJ4V_8IQ7kNvwHSYm66&_nc_oc=AdopecPZsWi64I1TDp01VVNPIqiKSMvoqS-LIEfNP7rU8xrz-_xZZ5w3z-enAF8iTZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYUHuWvY3f72UcN9WJKbcu_RlLMNo1mMXAMlhn2ZXXsg&oe=6AFDE314"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ1jYuLAQZEQ7kNvwFzwmj_&_nc_oc=AdqUz_eslqYhogfXEg8YSzofTnxB_SR0XDpzDDx4Wu_EAmJk20C5b4MmUKqghzFlsGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSretiK77i3q28J7zO0CG6KOuKK1G8ny8MI_GE3jJhjPw&oe=6AFDDA53"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWfgHePQGq0Q7kNvwE_p0cZ&_nc_oc=AdpAm5io5gcv_Wag-hON-Vn2aswhSHA86yJGnwW-UlLBm6jDZh0rNbcthL101DakPQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnbIsQ4NS-qcSwwZUNlIBF7s5yUr9j9nnR5lT607MUcg&oe=6AFDBB76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCs2YfmyRl0Q7kNvwG4Mrka&_nc_oc=AdqK-NnWc2HoUl0exKsPVFk49K2U9SawXQzJi0eNFtcZUqIvt2n5ze2wZFFAbPVduSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXhtv8XdlGg9WmUxkkADEaZZzZVXxjKopkEO5pIH_Weg&oe=6AFDBF6E"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in
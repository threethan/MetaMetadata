uzTaqgg_BhnNg55lPiVk4K8tA&oe=6AAE8813"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZlLYKmYZQQQ7kNvwEucKsT&_nc_oc=Adpac8SyNMIXD3AiA4l-Ss2D5VTrbCqtfy-PE5LmmhHh6DJhpFSmvqz8_Qw5PIITyP4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5tGsTLQiOPzq4ylxTU-sKS8vwcQfokYKMvMI0JtA3Cw&oe=6AAEA176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5mkKYpaMCUQ7kNvwHuGFSH&_nc_oc=AdpstYFLsqoKbkYNgPS3k8jeEY9esV31G92Ro0cHfJmJDdjNopbRI7SBSOKdMvjel2s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkbYvzzyve0-ru71sKrdVhCejkJbW4InPHsduJrI_69w&oe=6AAEA56E"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "318258700452760"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "1048743411355702"}, {"status": "PUBLISHED", "id": "1359904799587501"}, {"status": "PUBLISHED", "id": "1871755953519742"}, {"status": "PUBLISHED", "id": "2447401955713943"}, {"status": "PUBLISHED", "id": "1916056545964859"}, {"status": "PUBLISHED", "id": "1790751808270491"}, {"status": "PUBLISHED", "id": "1843223466303461"}, {"status": "PUBLISHED", "id": "779832197867373"}, {"status": "PUBLISHED", "id": "1467708924368311"}, {"status": "PUBLISHED", "id": "1418486676238405"}, {"status": "PUBLISHED", "id": "1177574156884675"}, {"status": "PUBLISHED", "id": "1
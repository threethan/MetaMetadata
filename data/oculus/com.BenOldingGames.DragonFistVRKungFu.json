02377252837958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VJ9qbZ-u1wQ7kNvwHI83F_&_nc_oc=AdpN2uk3jbQ4FDR-vEu4KE5VePeUYX8xs771R_X-iBXUzIx6UDeYiYRc8ni-0eJfX1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfc2kOwHh6sgoSayWTEb6MBOhWul58ZBocye5rkofN5w&oe=6B0C7F3A"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajlNPS6rGS0Q7kNvwFsd838&_nc_oc=Adq43R1M3FWCQrEO8MC9X2ESqUA-yqGx_6VUGrtBudnd_SMT77SG52jstPlDg7OCXjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT57kI-yKuCdmmxFHGHdsjuUgq-SCLgXw_ACi3YEicEJg&oe=6B0C6394"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWZtv-QKb6IQ7kNvwEuBsm9&_nc_oc=AdqSARL0tjHlSCiH2A5_3eyJH6-zi6PoQ8hCbVygj7LoLhplfg8xOQE7A1wvUesUGto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWzmGpIx8k4aTVAxkq4RMX-J6_-I3lKGATOxQG6yZTGA&oe=6B0C5AD3"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx-jlVfwIZoQ7kNvwGheuxc&_nc_oc=Adq6_NIUpNZupMACSA6AEZJbcgkQDebSeJzYUW2US85PNAa4HJ3U1r4rH77OIq8NE_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkT_qTyPi3FJYrOeloiVXsOLchkm6NMnKSoZIDpccnfQ&oe=6B0C7436"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i86-oZLXYc4Q7kNvwEa12dv&_nc_oc=AdrKdyPD7stk5A-mV7VNstSUf3cW5a8Fcl3hJEhQyFV8kTen52yDbOO3tq4VS04BYqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdekihmgxTvsVqGtYzKDrR_8oTBlVkmmzq6_KkXbmOEA&oe=6B0C782E"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
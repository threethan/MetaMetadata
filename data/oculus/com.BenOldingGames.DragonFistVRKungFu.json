_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3A891wxAsZ3j1CuB359zTDJFnLrka6k4h9FdZNb7Rfg&oe=6B030C7A"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjYPoTkntN0Q7kNvwFxrYl_&_nc_oc=AdpWC4JP3BvEvv0L6yNaFjZ5ym-_AMMr-irpaoNJcI5NQCNVKwLs96bsD4t7wNDNwZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZTpJsoLDK7ZgHs_3HkruS8m_Z7Je0smr_VE3AEBD2eg&oe=6B032914"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaHY30LU6coQ7kNvwEICcau&_nc_oc=AdrjFCDklsnnIVv6-YDiV8i0PEZsbqmoPaEIHhsErPy7ZfGNvphyi0y4qUiIgCVJGrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-KKozI_5tvdGqT3axi5JMy9getjEFxDvxu0Fhl9WXDg&oe=6B032053"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oDuxQCD0m0Q7kNvwGA4JDd&_nc_oc=Adq66rDQ26gqLmi-RM_Uyv6Te1FXs3BIUaqyEBMMhq6SQ5TpNKaOLUGDObU-7vH70Uw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPDZVpOWOUItjl9QKoeHOOGeVDKBCO-gWCbGtHN2ykWw&oe=6B0339B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj7-rGUqoUoQ7kNvwFX5Daz&_nc_oc=AdqeRJFA_DoXgezF93dnNAclx-fB7dN3lpSSSRA-Td6u4py7GwOV_HMVezjV5PbJgEw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTijUoiy1BjEfDqGfiP7QMeZt-5WpUBsGlA3Rp1Q6ADkw&oe=6B03056E"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in
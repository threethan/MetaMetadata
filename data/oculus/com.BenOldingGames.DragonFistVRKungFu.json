NxJCknQAUQ7kNvwF7JD_K&_nc_oc=AdrtI1l4bpcmciRS39modDuchF-liYxUd5ZxDEtQbc6MeL74f8hW_i5HWoh4FtDk5cs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXXdxfvaBPgLytdybrwqfGD-ILdeedSwWFM-LDTMwlZQ&oe=6AB699D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499303100_706633645726305_1769912601622852371_n.png", "id": "1675910600824060", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499313072_1675910604157393_6371594827506090307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuyYT5wlSGoQ7kNvwFtKGp1&_nc_oc=AdqSt9v2T68ulhtUcMO47Rxr0zukK0YoVt23Sl4my_ndEDSjEbjAtrSdUG6jFgYSHbY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5xYMne0zQ2A8dFPVzLiK31M83wGTB8LonT-cLFS4hxg&oe=6AB69A8E"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "physics", "boxing", "kungfu", "blade"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie, you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{1057677706737759}\n# **Forge Your Fighter**\nCreate and customize your fighter with an abundance of customization options. Select your appearance, record custom moves, select your strength and weakness, and more.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...", "short_description": "Step into your own Kung Fu Movie! This Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive single player campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": "http://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.dragonfistvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "es_MX", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28179229591764343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507838217_2272805890187047_4199570249227969974_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGaBZZOfod0Q7kNvwEzDp6b&_nc_oc=AdpQImYR2cRtu4NbK4Ivr3koXCZi0XF1Q4Q91yroZG5x1aRK1F_F4Z-2k_uTPV3NJG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnhsHX2kIFa0TZWnK70L-PXyz7u0L9BjB8YSTykt67wA&oe=6AB66A9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drag
02377252837958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GXdYyccmvkQ7kNvwGP9drJ&_nc_oc=AdrYsUYZmV2kWmiSZwIz5dfll4_zMjzKbqKYy1qjaWCn3RDbETsSgrX8Sf6X_zIKrZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwsu0h-TIUhOlvEfu3dYv54c_BZhnywzxXgewKrLeusA&oe=6B09A3FA"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajlNPS6rGS0Q7kNvwHM2XHe&_nc_oc=Adr-4BmH9MZMzMVB9anhC9dkkCluBrUl2GUO-emZ75xuF0rZaurBTVwiNCgl2Fm0AP4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Bk_roe8qytAuH01frrS8Z9eAYPjjJtjoEjTHjCJlhQ&oe=6B09C094"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWZtv-QKb6IQ7kNvwGP1b2c&_nc_oc=AdoI-Ie46QhXVEHAljGeHGUfSzpZbfdhkFv1IXt05vEnzap78xrlGcCVln3lnV-y4x8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRibe2_XvA-ZTn-HqGlF6fhr6xh_AVk4UQJCoEplygGgw&oe=6B09B7D3"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx-jlVfwIZoQ7kNvwFnsPeN&_nc_oc=AdrltJ5Co1b1tPGAIOWzA6D4ro2yfmyWQCm9-Ywm7QYjv_nEUxyUeL3HuXtZip884hM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvscFy2T57JOCDwjr1ezH4fbKLehbMAsY45aGLBRlLXw&oe=6B0998F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i86-oZLXYc4Q7kNvwF1AU6K&_nc_oc=Adp_79m4BxFjBxtEWRAGZpOL09H2u9Q8qLqtrovjDACWqjKUjoJgwcI8DidymD5rrDY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6vQGTwzZEj2Kg3mctcYjVnAWRH5SA7D8Cl3B6Tm21Yg&oe=6B099CEE"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
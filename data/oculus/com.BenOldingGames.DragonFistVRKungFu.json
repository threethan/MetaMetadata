998428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahUu0Jxw5x8Q7kNvwF9BinV&_nc_oc=AdnzqcfyZ4fqbS8e5m_G4uzPOxpvd8THdlTpmSPAP6s0ABghOryEbUbgyLrJRmkKujs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftIKmRjZtkeKz5VjcvXQEVnsuJ1zJZCMgzsSGV5jtdYmQ&oe=69A19D85"}, {"file_name": "1.png", "id": "691900473696934", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499326349_691900477030267_8034961341760562964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ib7HivSQYKwQ7kNvwGgVaE8&_nc_oc=AdnchZ-0l5IxhnTsZg1I3Tac-qfxQDdlq1NkPYeXK2_gz1ABCD7eSLWUauqcKtGhmZk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsA4N1VazEtWE_odlshFYsL7-_LSaYTs0Xo_B0MUzLmKw&oe=69A1A95D"}, {"file_name": "2.png", "id": "701610639047065", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499311591_701610642380398_6712854599056515091_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-eaH_dWp8sQ7kNvwGe3uys&_nc_oc=AdnQ_WVnqvYa3arfrOxreR46ekMwkqfYA0CASqRxnjEXj0wHsdGq3qfGJwlh7QKn6t4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuRmOQEVNw2FFFpqBNNVkXdxB-3o_Ir6fXi-rMKw7jgTg&oe=69A18352"}, {"file_name": "3.png", "id": "1448057773232210", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499318571_1448057776565543_7678358617141313131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X6VhGT4Al0Q7kNvwGhHial&_nc_oc=AdmyNOFqtUMcFeXGCmPC09NWGncEstLewKc2NtiXwWO8-h67ldXdd3fcOA8BgNACk8k&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftZyfQl1M5F_jfIVwDsy3z8L-1RjYuPM4SPrXtOJq1elQ&oe=69A1975C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DF_MA_META_HEADER_COVERLAND_TRAILERCOVER.png", "id": "1646731639656721", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491831792_1646731642990054_4019563495684792553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXCvPzNcok8Q7kNvwHPH5QZ&_nc_oc=Adn8qN9OThmbbODLyaHssYC2jlap-ZNJU6Sa2Tqf2ycQZa0cUNQE5K2K7xCf36N9Vgw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftGUJ-EoDyy5yGy-rC_CzlHH5G9sSL7Uuhp-0QrIiIoOA&oe=69A17DD7"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "kungfu", "physics", "boxing", "simulator"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove\u2014and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie\u2014you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...\n\n=========================\n\n# New DLC: Midnight Alley\n\nTake the fight to the streets! Midnight Alley contains a new environment for single and multiplayer modes, and 3 new characters.\n\n- **New Environment - The Alley:** A narrow streetside area lit by lanterns, windows and the moon. Features breakable doors that allow you to enter side buildings.\n- **3 New Characters:** Play as The Landlady, The Centipede, and White Eagle, each with their own perks, weaknesses, and special moves.", "short_description": "Step into your own Kung Fu Movie! This first-person Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive singleplayer campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms
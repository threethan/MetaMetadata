cdn.com&_nc_ss=7f20f&oh=00_Af4wen7sLoMlKnnlHj8cAyOAeIgeQg2z1wxH9H2PeII5cw&oe=6A11C9FA"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyrGHj6rCs0Q7kNvwHNFDJJ&_nc_oc=AdpXd4z5gVMEIt5czTVG7x7jZUzCcCw3hul2vvSfnr7vOy-GVHprx3EQGYJ47zGfGuU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PW4gIkSJ9d37tGXsT4RcKyGFltjhME9T8udZEd4FIBw&oe=6A11AE54"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-mO4BxIoGsQ7kNvwGjG3_T&_nc_oc=Adru_9jdQ1zzNvvf_iFX-V5MGWPBS7JR3gsGwaNy6pyPBBI2a9ykeyIEgwowJg8NdNU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NFlD6cfr8v7ZztIXNixS97-pLiLMniyzUvMKRRl-lAA&oe=6A11A593"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riN-lg0URTIQ7kNvwHQ3114&_nc_oc=AdrbYggjYqkIhSIwgWankjYLovK3bUYOwYcWFahCazWxo8KtpLTnKMjaqDGkoBAeUJk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AUg5UbXJS4KM8p3F1zhpoi9S8lk_mULlOiFn-47Ko4Q&oe=6A11BEF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1gmpDB5ha4Q7kNvwGC8uPH&_nc_oc=Ado-Hcn7LSkZ8V0Bg-m3jZbxsK8ykdNeQAnfEFjCvYaQNFf9X0X1kOrcYNpuU8S5Rbw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nVIzGnTKehTMkke1bsrAIln9glab-A6TrgxOInnqCTA&oe=6A11C2EE"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
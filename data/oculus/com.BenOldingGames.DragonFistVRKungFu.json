02377252837958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GXdYyccmvkQ7kNvwHA0fyj&_nc_oc=Adr2o91FVCer54pImYdaxVVOzhQjSF7spPTKMVf3g2bdhid0bjqDxgw_vgm-2QA1PU4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkMWrxlYCyHPyIRxh__IJF9u1wdi28uvZwM_JlzPMsBg&oe=6B08527A"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z929M5es89YQ7kNvwHC3WWw&_nc_oc=AdoH05RlT4s6g3rEFcKfLmoprjGvXdx4hsV6JE1gYuGRdR2ji52K2NZjQw0M9ioJEok&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXyUU7dhU0MZ1Qlgif3v8fioSK2MJZPPuKg8jOUWEQfA&oe=6B086F14"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTClNmsqmw8Q7kNvwFPkSwt&_nc_oc=AdpSphxnrm5hNHOpnkLB_8Q2t7nGiQQVBqGE8VaRZVbYHUmY25q1TuHDB39tBT1wp4s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjitTGDy0bem5FnNW1IFae4j7xhbkaZogEFNP9t2pE4A&oe=6B086653"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u_zmJrs-xkQ7kNvwGQOlIn&_nc_oc=Ado4XUoPb1FSf7NWk9-dokyEuniBwrTpWVAyrDFY6mYtLBPOb6B2RqYQB2cpaNvqMdY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdskheRXI1IwsDiyyJrSREu6FfsM-wWobP2HRL7srDiA&oe=6B084776"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggM7gfODTzwQ7kNvwFBXo0J&_nc_oc=AdrrlSY09oH9WqsQm5nNEqJFsEoSulqzPnP3kJQpFo4eHQDlkaEkIxXz0D6kAG7ldv4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJParb5gfhCTQXOfUMCJ-ZvLMNiZHwYLQCM-jfLQkHOw&oe=6B084B6E"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
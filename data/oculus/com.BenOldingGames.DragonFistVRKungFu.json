998428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHnqIuYCF0QQ7kNvwE4CoUp&_nc_oc=AdkDZtXBCug5reOgQ3BFRJrxm9IBcIXGpibXH7Fa1vQmLES9XQvDuuLbsXd20ax43yU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afviiu1DEUWLgir2F7lt2dAl2s1Ni2O80SEn2r3zaIw75A&oe=699EFA85"}, {"file_name": "1.png", "id": "691900473696934", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499326349_691900477030267_8034961341760562964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJhrxWlhvicQ7kNvwFYp63v&_nc_oc=AdnuoY6bT-v-vRRTN0Ia2S_kekXS8bbrAtD3-4nAxLXt3w-q5lff1mt9T26B1r6TmW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvRsIeYjRsUYFUdLehcm6yv_6w1SKRRqVRdW8nIfP8rVQ&oe=699F065D"}, {"file_name": "2.png", "id": "701610639047065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499311591_701610642380398_6712854599056515091_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlfYJDMLJC4Q7kNvwFxfujk&_nc_oc=AdmW5LuOsBdx__HsH6LvEmGqvB7tFJe1gdNARq-V8H7hPYsWIg9_Ug-51VTgznwbmtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftnRuDw2RZytpfUJZP483mm0ZeZ7OFgeKpoODlXVDXZNA&oe=699EE052"}, {"file_name": "3.png", "id": "1448057773232210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499318571_1448057776565543_7678358617141313131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC3LYvcCAbIQ7kNvwGt2iBo&_nc_oc=Adlz7fVKm2DdfRFxPPG1T6XxJ4MgtdZeFg-rE12mWgWRB_8zCq8TzQm33bJWHqmktMA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZju2r-p3TPeEQajmCl9iY4rx_w78Oiz-jfBJiDOAvIw&oe=699EF45C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DF_MA_META_HEADER_COVERLAND_TRAILERCOVER.png", "id": "1646731639656721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831792_1646731642990054_4019563495684792553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXCvPzNcok8Q7kNvwHvxxL2&_nc_oc=AdnnSwslm_5Ft7vE9PdIOIlmMfbyd06gQTQJN7AegFD04Ryrtd96lszIt-0g_IJWvKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsXz1_kE1yT5a6odDroSUCWwje0kvVjA21zuMIYKkzenw&oe=699EDAD7"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "kungfu", "physics", "boxing", "simulator"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove\u2014and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie\u2014you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...\n\n=========================\n\n# New DLC: Midnight Alley\n\nTake the fight to the streets! Midnight Alley contains a new environment for single and multiplayer modes, and 3 new characters.\n\n- **New Environment - The Alley:** A narrow streetside area lit by lanterns, windows and the moon. Features breakable doors that allow you to enter side buildings.\n- **3 New Characters:** Play as The Landlady, The Centipede, and White Eagle, each with their own perks, weaknesses, and special moves.", "short_description": "Step into your own Kung Fu Movie! This first-person Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive singleplayer campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms
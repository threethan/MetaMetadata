-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjBbJWuXizQBF1FJF1S_86sznq8KBEdXUsX4uMtdVtAg&oe=6B103C92"}, {"file_name": "Dungeon.png", "id": "1420498710057658", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312263_1420498713390991_6225333002451362743_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxgqOcfNxmUQ7kNvwFt3aWw&_nc_oc=AdoSB9VUwHvtSsNty-mSIR-LsG08ZUtlHYxZ2fQsrmkiztlfF41vETTu4lCeTv4k5VM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxFkIXbHZV4hNy7uSlizxF9feCC9c5idNQOMxF6VWtew&oe=6B10350C"}, {"file_name": "3.png", "id": "1448057773232210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499318571_1448057776565543_7678358617141313131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnhqbUT9HAMQ7kNvwGMPtv6&_nc_oc=AdpY07fc7avawkPNDvyH75QgrG4xkU9LAUZuMMYMdxpRL41fa9O2iiKNHarcpPpfsYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvts2ZG6hGuHJ_bZattfBcZW1xXCSIeyJQJIT1VeERcw&oe=6B10509C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V2 Sumo Arena Landscape Cover.png", "id": "1704718927721176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842284_1704718931054509_2760194052715140965_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yazKs1FOdbsQ7kNvwFcH5od&_nc_oc=AdrJqRMOzrdfMZQWH0JMgm1ed_rtl7rI70wZHXHI9tHQGf9CtM7yI2pS82xgKOrzefE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjb13iWMuTcyi-eoUFBwjqkYHeLXYll808gjwQ1HhrmA&oe=6B104B28"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "physics", "boxing", "kungfu", "blade"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie, you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{1057677706737759}\n# **Forge Your Fighter**\nCreate and customize your fighter with an abundance of customization options. Select your appearance, record custom moves, select your strength and weakness, and more.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...", "short_description": "Step into your own Kung Fu Movie! This Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive single player campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": "http://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.dragonfistvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", 
998428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHnqIuYCF0QQ7kNvwEAQgoX&_nc_oc=AdleBgP-4WJxLMJw4_UPraTtOa6TKw6QV9sqMZMZfTCwi59HT1nV69toyGg8Dpm_mUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsyjGkaYCfpvdUtWGfGwY0Z3SrFIjazo5MDmw-daesLVw&oe=69A04C05"}, {"file_name": "1.png", "id": "691900473696934", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499326349_691900477030267_8034961341760562964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJhrxWlhvicQ7kNvwHBIGA6&_nc_oc=AdkcPZIXe8LswOTyncalph7EanEnyUAGFdIlqArwVle1YncuRB1KV2sVAAHQ_koNei0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvTX7bJah-i43JI6qRegXomdA0hMBnlr2Ayez_Adtis5Q&oe=69A057DD"}, {"file_name": "2.png", "id": "701610639047065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311591_701610642380398_6712854599056515091_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-eaH_dWp8sQ7kNvwFlvjEQ&_nc_oc=AdmwJjZmM1aJ7CUjMAYbiT7h-6E0xNGNAn9zmTnK4tFvd9C5UljpeyaTEtzlvddt1lw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUTodQsQu2zt4miBVUKhp62fdNb-IRbDGQex3IH0b5lA&oe=69A031D2"}, {"file_name": "3.png", "id": "1448057773232210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499318571_1448057776565543_7678358617141313131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X6VhGT4Al0Q7kNvwE6zztM&_nc_oc=AdmgimPn-jbcgNj7dd1suvPKPMHOspksM92NDpCnM4M7IXIAt49IEXROmQAkVwEAXNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvT7AghIiQ5GXZRH9Uj5xONnF1V9AktD0iAXu0ESIPLng&oe=69A045DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DF_MA_META_HEADER_COVERLAND_TRAILERCOVER.png", "id": "1646731639656721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831792_1646731642990054_4019563495684792553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXCvPzNcok8Q7kNvwGuYCHm&_nc_oc=Adlj3SDk_duBwvUxRGiZnFRsTkYAEPRGr-rUrDg8xrlCfraLJxyEQJudWnGgKT7P1jE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-5im5cornoGpNO6kWLl1IZHazDiPTm5aucmq-Xj-vOg&oe=69A02C57"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "kungfu", "physics", "boxing", "simulator"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove\u2014and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie\u2014you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...\n\n=========================\n\n# New DLC: Midnight Alley\n\nTake the fight to the streets! Midnight Alley contains a new environment for single and multiplayer modes, and 3 new characters.\n\n- **New Environment - The Alley:** A narrow streetside area lit by lanterns, windows and the moon. Features breakable doors that allow you to enter side buildings.\n- **3 New Characters:** Play as The Landlady, The Centipede, and White Eagle, each with their own perks, weaknesses, and special moves.", "short_description": "Step into your own Kung Fu Movie! This first-person Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive singleplayer campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms
02377252837958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VJ9qbZ-u1wQ7kNvwFVJBTq&_nc_oc=AdrM8ODo0rBAaZlCoOlXUJKSbjYjqwf9BrO0votYpL8vKrvN_kuyvDq_o3hRjN7HuNI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQj3iBPcVxBODNXgcs67stvwYJWK_9SuhvyStvt86KXoA&oe=6B0B2DBA"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajlNPS6rGS0Q7kNvwFJLSOn&_nc_oc=Adpw6XYhTN4qbuMjV3sceTbWVxtLaZmsuRlZcPyDtp5kIe9d3NEynrT7VnHxjppiGmc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREB0X8U9D83Huma7Vo1aj00HOI5S-bFAs6Y-URgYFZLQ&oe=6B0B1214"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWZtv-QKb6IQ7kNvwGDYir9&_nc_oc=AdqJEIy58r0WcJ47Ya3rzv0iZDEMYRjs-BtX03LOAp0poGZ5UzcMdso10BI6-BoA1_k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaijQBmgtB3KRYLa8sGBo-KSN_MHxcdkrK2CA1OBFt8Q&oe=6B0B4193"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx-jlVfwIZoQ7kNvwE7uRMc&_nc_oc=AdqSTTwJh1Ws8Ck30ogseBbsVrjE1Oj48etqYVn2ndx6_PgZJJvD6z67hJM9ah8yDfU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6WUjmnXJwGGeikTE9zazPEgKEhHRlq2aZSatiPs0KVQ&oe=6B0B22B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i86-oZLXYc4Q7kNvwGUg5et&_nc_oc=AdoJCcMnTbzwoogiflbCQkK-rpXLUX8_2dPk5frf9CZZWXyqGstEpoTYVRwouvvY5R4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRo-JNTei2ydHrobZ79iSJ5dGEj6tvA7AmS7x-4HOZ0xw&oe=6B0B26AE"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
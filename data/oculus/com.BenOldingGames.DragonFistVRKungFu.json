WV5f9FqA&oe=6AEB2E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "1032117189865803", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303606_1032117193199136_2387524720588074971_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM8zvjs3q3wQ7kNvwHQFHjJ&_nc_oc=AdpES4N1mbklgvpm6SfKhsxiIN1W8bxYFrp90Wv-LwzxkHohB3PQszzr8Wiphd3d1do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTrWW1lHKrh_i5VareQFvZT6E5jBYGs8zsCUMFd2SFlQ&oe=6AEB39F9"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "physics", "boxing", "kungfu", "blade"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie, you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{1057677706737759}\n# **Forge Your Fighter**\nCreate and customize your fighter with an abundance of customization options. Select your appearance, record custom moves, select your strength and weakness, and more.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...", "short_description": "Step into your own Kung Fu Movie! This Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like 
9y3S-vaQro4Cw7mHugHEEqYW-pKW7rcvBgiB-EILg&oe=6A146CFA"}, {"file_name": "aplb - ss1.png", "id": "288797220100520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031486_288797223433853_2396487777045212145_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVUfAPz0-xwQ7kNvwGt3Cjv&_nc_oc=AdpARVjA0B1mxMtRHHbPS0g7a4KCTmB79ApE3i2UpfE6wHVx2eniat8zHDLSjJOhuzE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YnA_c2ru9Y9svI1aq1bSrel2a8jPrmUyYQFqJu-PqjQ&oe=6A145154"}, {"file_name": "aplb - ss5.png", "id": "1450180905413928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035331_1450180908747261_2060207280339599727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2b-gkdiKicQ7kNvwH8G2vB&_nc_oc=AdrICBRq5_0MbKfGeepTNIc5nLkONRSqdEedBh6HanhS_71qj-Lck7vWqKPCmdQ-RZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Cq1Ya_eMiqd-3T5uNIxejDw7sAVWjSbtEqMEi1unffQ&oe=6A144893"}, {"file_name": "aplb - ss2.png", "id": "521091429664417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974593_521091432997750_8207741959667719255_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gysPGnyMNTkQ7kNvwGNI1fE&_nc_oc=AdpoSLPT-523ye7DSaJj09OkutSJFrIfIm1HpSvodLYfH86gIkAqluTJgz7J50PwbFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DDo59OLf2N82C3w_ovMqNg86kxU4XFfJRqvyOUVtXOA&oe=6A1461F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - cover land.png", "id": "3206338996273601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_3206339009606933_3068407365452566861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8dbaTd6WO4Q7kNvwGTOrBM&_nc_oc=AdoI4PrQyQaVU0mAfrJHlzOmcOfY15SfpPuJVsByg7zmt0606wp8RuJwC92yf_hrItw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BEfpGk8NF5r4GX1sDy9XiANL8uXdlrYddYc-BJj5pUw&oe=6A1465EE"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": [], "long_description": "Step into your own kung fu movie with colourful characters inspired by Chinese and Hong Kong martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nBlock attacks with your hands or forearms, or bob and weave, push their arms out the way, or move about, how you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.\n\n40 different characters that have various colourful costumes and have their own special moves to learn and use. Each character has their own fighting style to fight against as well as a perk and a weakness.", "short_description": "First person VR Kung Fu combat against a variety of different opponents, with a variety of different fighting styles, special moves and back stories. Unlock over 40 different characters, multiple stages, and take on the masters! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": "http://www.benoldinggames.co.uk/Contact-Me.htm", "website_url": "http://clique.games/dragonfist", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
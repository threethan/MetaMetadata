4QuRFw&oe=6A69EA94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DF Landscape.png", "id": "962034739612303", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_962034742945636_3346748041246155813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QsnuvSRHNgQ7kNvwGdxpiQ&_nc_oc=AdpQQeyQtbvYGDenPf-tCKs1e7_-tsuYlFgZ8VDLzKUFhWeC0DhLQYIcNqLc20nYVLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7RNJK_vQ_ixjruJcEjs7OcLwG0DX8U9U2gkEon2Hi2g&oe=6A69EB5C"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "physics", "boxing", "mma", "martial"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove\u2014and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie, you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...\n\n{852856241231915}\n# **Japanese Garden Is Out Now!**\nA garden once known for tranquility has lost its peace as 3 new fighters enter the combat along with a new map, and 14 new additions to the fighter forge.\n\n**Fighters**\n- Fudou No Taki\n- Ayuna Fujiwara\n- Travis Decker\n\n**Map**\n- Japanese Garden\n\n**Fighter Forge Additions**\n- 3 New Special Moves\n- 1 New Perk\n- 11 New Clothing Options", "short_description": "Step into your own Kung Fu Movie! This first-person Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive singleplayer campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": "http://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.dragonfistvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "es_MX", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27678952328458741"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307451_1491024139438482_8739313399028090254_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiQJLw4kbrsQ7kNvwGcoGNa&_nc_oc=AdrrAls595cgnpZqSoYRRKleFTxcEO_01hoJyZ02QNuE3j4GZx-mNX2oJOqrHLkHY0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqowAxjABClQCswG9bKewliFmUYM2-XT6cL8RUpRa8zg&oe=6A69F495"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dragon Fist: VR Kung Fu", "platform": "
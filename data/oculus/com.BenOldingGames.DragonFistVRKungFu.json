998428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahUu0Jxw5x8Q7kNvwE0pBVi&_nc_oc=AdnPlxyn1xGGp6MQpZ3BFzqNTkv4DUAr64uqLAE8jxCtWF-HCYLujw5bgx9ptYYbcok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftdzujcEzBv30UCn1ooTzB3VACLY7yXClbRBoYkYxhEVA&oe=69A44085"}, {"file_name": "1.png", "id": "691900473696934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499326349_691900477030267_8034961341760562964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ib7HivSQYKwQ7kNvwEZEdbp&_nc_oc=AdnapcuJs5BBC7GVWolwJ030HbqhpUqKqeyu0LPnVPVuG3J5V6x__VPIplyuYm-kjyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsmDoVESZMS5WCMABSmvXHDJn3_B6Av_jsh8x6038gtjw&oe=69A44C5D"}, {"file_name": "2.png", "id": "701610639047065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311591_701610642380398_6712854599056515091_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14WJsGQk4AIQ7kNvwHQx9F0&_nc_oc=AdnS6NxMglvVEZ95i0RQtE075yx2L06dWVMpVVavGhsFBV0qAhoxvqYXkH3gMqA8L9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvmosmbxR9clmccXEbzSBX0u40TRC5WUaKk3ub6iFkl6g&oe=69A42652"}, {"file_name": "3.png", "id": "1448057773232210", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499318571_1448057776565543_7678358617141313131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fITJDQop3PgQ7kNvwGTYmaw&_nc_oc=Adk22BV5v-bXmuIYSXK7sp-I8lAjeKxyl2adVodKvPiuo-n7V-vmXjKW1yBU3IQm5xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afssgr4IJZmpB3TIZv3eI9yYlYFdl9jk6Rozfc2f5CqTlw&oe=69A43A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DF_MA_META_HEADER_COVERLAND_TRAILERCOVER.png", "id": "1646731639656721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831792_1646731642990054_4019563495684792553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juNzy8d809gQ7kNvwGV4QM-&_nc_oc=Adl5GDY9Cp3onZ4hURhyeshB8EHn8NHYcf0K16NNm-Ud4yEuCiNCi9NaDRpH4fk2Eik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvcK0LUymKRByJAve0gSvC0bOkrXG2iRZXeSqdiZfpkZw&oe=69A420D7"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "kungfu", "physics", "boxing", "simulator"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove\u2014and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie\u2014you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...\n\n=========================\n\n# New DLC: Midnight Alley\n\nTake the fight to the streets! Midnight Alley contains a new environment for single and multiplayer modes, and 3 new characters.\n\n- **New Environment - The Alley:** A narrow streetside area lit by lanterns, windows and the moon. Features breakable doors that allow you to enter side buildings.\n- **3 New Characters:** Play as The Landlady, The Centipede, and White Eagle, each with their own perks, weaknesses, and special moves.", "short_description": "Step into your own Kung Fu Movie! This first-person Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive singleplayer campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms
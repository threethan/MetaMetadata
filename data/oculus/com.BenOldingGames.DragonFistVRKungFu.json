: {"file_name": "DD_WW_Meta_Header (1).png", "id": "1427762186029954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1427762189363287_1722455219447556271_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzECkgBhIcsQ7kNvwFONJq-&_nc_oc=Adra31jOOLKf5gM3EDtWGs-RwSxOuSm0YSCntxUOMQS69jVZEuJ2VXLnpG0oN6oUTME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pMLTmSXXVVVOT1wDJJRRsUNPejNPcpFtICB8r1NwMIA&oe=69E38166"}, "display_name": "Dragon Fist: VR Kung Fu", "keywords": ["fighting", "physics", "boxing", "simulator", "fitness"], "long_description": "#                                                                                                                                                                                                      \n{1194756028402406}\n# **The Legend Begins...**\nA ruthless master rises. Vengeful emperors scheme. Peasants sharpen their blades. They all have something to prove\u2014and only one path forward: **Kung Fu.**\n\n{1903052986827168}\n# **Step Into Your Own Kung Fu Movie**\nYou\u2019re not watching a Kung Fu movie\u2014you\u2019re in it. Dragon Fist delivers fast-paced melee combat powered by physics and real martial arts.\n\n{808577998151364}\n# **Hone in Your Skills**\nPractice strikes, blocks, dodges, and combos. There is an endless amount of combat to explore.\n\n{354077967776881}\n# **Play Your Way**\n- Campaign\n- Multiplayer (up to 8)\n- Co-op Campaign\n- Training\n- and More...\n\n=========================\n\n# New Fighter Forge Expansion Pack: Western Warriors\n\nShow off your wild style in Fighter Forge! The Western Warriors expansion pack adds 30 new clothing items and hairstyles for your custom characters, and can be used in both single and multiplayer modes. As with all other items in Fighter Forge, these can be colored to your liking.\n\nThe following items are included in the Western Warriors expansion pack:\n\n- **Hairstyles:** Mullets, Mohawks\n- **Hats:** Cowboy Hats, Top Hat, Bowler Hat, Bandana\n- **Accessories:** MMA Gloves, Eye Patch Monocle, Necklaces, Face Mask, Aviator Sunglasses\n- **Pants:** Jeans, USA and Golden Style Karate Pants\n- **Shoes:** Cowboy Boots\n\n{856144624148813}", "short_description": "Step into your own Kung Fu Movie! This first-person Kung Fu fighter with stylized graphics, physics-based combat, and multiplayer pays homage to the golden era of martial arts films. Play with up to 8 friends in multiplayer modes like Co-Op, PvP, Challenges, or take on an expansive singleplayer campaign. "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": "http://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.dragonfistvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "es_MX", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26352193187801335"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_945894197882578_8415755667934260250_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6weG4T0KA8Q7kNvwFG7Rr9&_nc_oc=Adrnyhy76bCZNAcN6LQN6RBK-cu2AqcEBRtxFgpaGYl
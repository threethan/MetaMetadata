4_8830527676489269045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5BU5hR7bCUQ7kNvwEM4dwT&_nc_oc=Ado25uUZl0ToVEI9X8-_kLtN87EawXYmRkrDGL76T-IPz4F7_lnRxGIjUsyhRRL3Qco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJQNJaZem8Wjka_sOrVeirQzBVD7F_JVsIz2ciHCZoiQ&oe=6A490284"}]}, "id": "1177894466609809", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "2017178288800647", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_2017178292133980_8065475897024876305_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3bK16g-LXYQ7kNvwHymIDr&_nc_oc=AdrTq_m6ewd0wz5vmuH53SpGsC2u7fRAn73Np5y4UaylBr9Bi188S4N7qgQtw1oYsWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAqb8E3znCo064vKYKuJR5ovem-OnZ9-s6kZLee-mHgw&oe=6A49079F"}, {"file_name": "screen2.png", "id": "1059997772202487", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974796_1059997775535820_8939742875257313433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZnO2mAo8ksQ7kNvwHqTXr2&_nc_oc=AdpgGrl-Q9nwzk3f7RJlmHtRjxbH-OG_YCqAnz_m_HKHHuftGxLP0aux4PRMsEHg5Ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpAXh3HxIjHxqa1Ku6ljglNjyWKn-7xEUV9bDpJkQojQ&oe=6A490D6A"}, {"file_name": "screen3.png", "id": "926773679274252", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982638_926773682607585_6386672243534466423_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqSUwyuX2sEQ7kNvwEbrmAm&_nc_oc=AdqkqLJhXSnfi3FD1kyhZbIqy-xuqC_pHYlSGfOxDuqfhUQIJcN6fZ2V62LCUoPxL7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjv6GpQ0eGjjwNRKRFMn2jZ6cOhwM7pfGHQLkIi_uOqg&oe=6A49127C"}, {"file_name": "screen4.png", "id": "1587028465215784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003273_1587028468549117_2130771912564351873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-oaDZvKsxIQ7kNvwGTncnn&_nc_oc=Adrb-odFHr3R-i6mBpWnkOzSiZTEuHYg587pbZ4fa_pxpxmL0g77jU4UKjJ9Ml7LB9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeU4p0KcoMlI5PzT1tFA2tbQPXKFWSgzL2K2avgbUGLw&oe=6A492D9F"}, {"file_name": "screen5.png", "id": "1255660122127711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575346_1255660125461044_8082840014684946814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ghh1eOCwTL8Q7kNvwFr1Xwc&_nc_oc=Ado0gYRWSMYGP3GBCRJZrmUpEdFw54KSmpwpLk0S9DMFoxKDFI7QxEmjWcQAtPMt4RY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjxtDAVOaGo2G4qDsLMAE_WVmZqg06hyBx67iWiOr5Lw&oe=6A492431"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London River Cruise like a Tourist \u2013 VR Travel", "keywords": ["london", "travel", "sightseeing", "boat", "tourist"], "long_description": "Take a spontaneous virtual day trip to London and experience the city like never before on a classic Thames boat tour. In this immersive VR experience, you\u2019ll ride a large tourist boat, surrounded by fellow travelers, enjoying panoramic views of London\u2019s iconic landmarks from the water.\n\nYour journey starts at Westminster Pier with stunning views of Big Ben and the London Eye. The boat crosses the Thames, stopping at the London Eye to pick up more passengers. Continuing downstream, you\u2019ll pass under iconic bridges like the Millennium Bridge as London\u2019s skyline unfolds. On one side, see the Tate Modern; on the other, modern skyscrapers like The Shard, the Walkie-Talkie, and the Leadenhall Building.\n\nThe tour\u2019s highlight is stopping at Tower Pier, right before the iconic Tower Bridge. Here, you can marvel at the bridge\u2019s towers and busy river traffic. After disembarking, explore the vibrant area around the historic Tower of London, watching tourists and boats.\n\nOn your return to Westminster, enjoy more breathtaking views of London\u2019s sights. This 2-hour VR experience lets you escape daily routine and dive into London\u2019s rich history and culture from a first-person perspective. Whether seeking a brief escape or a virtual adventure, this Thames boat tour offers the perfect opportunity to relax and experience London without travel hassles. #london #boat #travel", "short_description": "Experience a 2-hour boat tour along the Thames in immersive VR, where you see London from a tourist\u2019s perspective. Sail from Westminster Pier, passing iconic sights like Big Ben, the London Eye, the Tower Bridge, the Tower of London, the Millennium Bridge, and modern skyscrapers like The Shard and the Walkie-Talkie. This first-person VR experience lets you take a quick virtual day trip, escape your daily routine, and immerse yourself in London\u2019s vibrant atmosphere \u2013 all without the crowds. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/London-River-Cruise-like-a-Tourist", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27187962754152104"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1426487575905200"}, {"status": "PUBLISHED", "id": "3410227182475610"}, {"status": "PUBLISHED", "id": "2147511096080941"}, {"status": "PUBLISHED", "id": "1595776248118952"}, {"status": "PUBLISHED", "id": "1891419091584085"}, {"status": "PUBLISHED", "id": "1582952629546393"}
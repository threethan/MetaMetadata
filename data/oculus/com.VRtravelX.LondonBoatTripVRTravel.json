4_8830527676489269045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGeFaG5LUwwQ7kNvwGTYRri&_nc_oc=Adq7f1A-t4JZvGujwol-H-SjDt3L2JnNNM5MeAArNoc_37-NzgwVyAIp94O2mAhBTg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6JKJejeVKb3L2N2E_EBRzTphjOkTwQlCSzcBF_583CA&oe=69CD1584"}]}, "id": "1177894466609809", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "2017178288800647", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_2017178292133980_8065475897024876305_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4g8zMkBPugQ7kNvwGjgjtD&_nc_oc=AdoOAnbmTaOYxjCk_FcXW0bGmhKxUDouDWhag4fdMA4HkPcrCl037FsaO_1IAsZD8T0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygYxTal-ctcgxQRUCZCCoqpNvqwIL2gD-y_En-jAg7Iw&oe=69CD1A9F"}, {"file_name": "screen2.png", "id": "1059997772202487", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974796_1059997775535820_8939742875257313433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rej0DWFU9cQQ7kNvwHR4Erw&_nc_oc=Adr8UWxHbXNxIcOESGiA7KJnq7hAAZKjeYi7ADg4STX5boD5hrnE6iLCnpGXSJjrfCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx32sA-LpXcnbj5R5x3k2SInNBB6XG9LNuWRTarPy8Eng&oe=69CD206A"}, {"file_name": "screen3.png", "id": "926773679274252", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982638_926773682607585_6386672243534466423_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjsF9ED270gQ7kNvwFTM-e6&_nc_oc=Ado83kvalMn9wjRd7KVXeD7cH3bGVadzovdd5dn8JZJNWQ1kJ5gAi-5tTcHB-uOC6Kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7ILwsBe0kawWTHfkVLblc3qQIgK8wuEjqzp_Ezl3Fqw&oe=69CD257C"}, {"file_name": "screen4.png", "id": "1587028465215784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003273_1587028468549117_2130771912564351873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFxEWrT7_fwQ7kNvwFMfaj6&_nc_oc=AdqzYqEJqcQjwVsyA-IK5LkomMMpw94muS-SV4LvzyQFM5xNWbZGIoyhMt3lPUt6MEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afypfr3SSOle-Ffp1B6sfNIVZwotoLk7Dfis2Lk3zXbUGw&oe=69CD085F"}, {"file_name": "screen5.png", "id": "1255660122127711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575346_1255660125461044_8082840014684946814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvxwU-1YLv4Q7kNvwEEXBne&_nc_oc=AdoWpCzr34a-K2S-3R01iSEtZrd_P6VprfZCTh59g6H5ovJY8WJZbUKkhrzkMwLXcYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcFJWeQWEZHSgkxDSUCSa3wh3RIXWHE-BSVlzPdLng9A&oe=69CCFEF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London River Cruise like a Tourist \u2013 VR Travel", "keywords": ["london", "travel", "sightseeing", "boat", "tourist"], "long_description": "Take a spontaneous virtual day trip to London and experience the city like never before on a classic Thames boat tour. In this immersive VR experience, you\u2019ll ride a large tourist boat, surrounded by fellow travelers, enjoying panoramic views of London\u2019s iconic landmarks from the water.\n\nYour journey starts at Westminster Pier with stunning views of Big Ben and the London Eye. The boat crosses the Thames, stopping at the London Eye to pick up more passengers. Continuing downstream, you\u2019ll pass under iconic bridges like the Millennium Bridge as London\u2019s skyline unfolds. On one side, see the Tate Modern; on the other, modern skyscrapers like The Shard, the Walkie-Talkie, and the Leadenhall Building.\n\nThe tour\u2019s highlight is stopping at Tower Pier, right before the iconic Tower Bridge. Here, you can marvel at the bridge\u2019s towers and busy river traffic. After disembarking, explore the vibrant area around the historic Tower of London, watching tourists and boats.\n\nOn your return to Westminster, enjoy more breathtaking views of London\u2019s sights. This 2-hour VR experience lets you escape daily routine and dive into London\u2019s rich history and culture from a first-person perspective. Whether seeking a brief escape or a virtual adventure, this Thames boat tour offers the perfect opportunity to relax and experience London without travel hassles. #london #boat #travel", "short_description": "Experience a 2-hour boat tour along the Thames in immersive VR, where you see London from a tourist\u2019s perspective. Sail from Westminster Pier, passing iconic sights like Big Ben, the London Eye, the Tower Bridge, the Tower of London, the Millennium Bridge, and modern skyscrapers like The Shard and the Walkie-Talkie. This first-person VR experience lets you take a quick virtual day trip, escape your daily routine, and immerse yourself in London\u2019s vibrant atmosphere \u2013 all without the crowds. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/London-River-Cruise-like-a-Tourist", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27187962754152104"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2147511096080941"}, {"status": "PUBLISHED", "id": "1595776248118952"}, {"status": "PUBLISHED", "id": "1891419091584085"}, {"status": "PUBLISHED", "id": "1582952629546393"}, {"status": "PUBLISHED", "id": "1538480887597579"}, {"status": "PUBLISHED", "id": "1174208891189953"}
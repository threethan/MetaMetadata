4_8830527676489269045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G18TexwL2-oQ7kNvwEE412d&_nc_oc=Adoe2d9E97pVbu-6vALf4an9aFK-_g2kiwJdsLeuXDzxOEHc___AgeRo5w18qyi-Fps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC41-kYFXJdmhF5dUIcsqVUgFPAY0KAXIeh_cFKB1B2zg&oe=6A60BD84"}]}, "id": "1177894466609809", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "2017178288800647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_2017178292133980_8065475897024876305_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8Xof2a2JEEQ7kNvwGWgkXS&_nc_oc=AdrxSA_rl-IbyNgQUR3MZEvY0cHIsScpaCwu2wUmBcEgXcrxgd0NG5HugAnAEtliQaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjk5BqEdReENKl71TUExExblxge-kTiVmVEq0LIv-72g&oe=6A60C29F"}, {"file_name": "screen2.png", "id": "1059997772202487", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974796_1059997775535820_8939742875257313433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa3S4nIit_gQ7kNvwFJy3hv&_nc_oc=AdoGOhX-NK2JyMU4MjU8zKHAwNJd8Elu8JnMLdp0wagCIsJOZ3mRi_WPAciN5AVwqaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxXp0tlmisFRv7bf_wQc7BTQP8IOe25KNvLYn3gx19qQ&oe=6A60C86A"}, {"file_name": "screen3.png", "id": "926773679274252", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982638_926773682607585_6386672243534466423_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7JN87Nm9IwQ7kNvwFDcCbI&_nc_oc=AdqSUI1HBC8BnUb3WESoKg-oalOiSFoUXLAkxvxqUU9arL7nVUSfCGTDxzIo1oRQDlI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAocXnR7wrRU97d4S3i5pg5nQWNlAmM3M9BfOcvEbaFRQ&oe=6A60CD7C"}, {"file_name": "screen4.png", "id": "1587028465215784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003273_1587028468549117_2130771912564351873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Du0Xju7wGo4Q7kNvwFbrwfw&_nc_oc=AdoitDv1DGztW29yW_16uMp0p2w8E2tFyQ0DyeOa0isbJQl4ioejP1CayOOV1kupklQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGmRRowR6tovI93a7g1sr87VR2ajr_59gIlYxBlTFlnQ&oe=6A60B05F"}, {"file_name": "screen5.png", "id": "1255660122127711", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575346_1255660125461044_8082840014684946814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAQXSWzefXAQ7kNvwGJbXol&_nc_oc=AdqZYeLiwL0_w-BSAiynYI47v_jJEGNLv-Hy10TOwVnA3VzglnNLnl6VOsfDQXFzjf0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpnIMXi8KJVrNdZnhoZtTJK31IZZqG4yHwfYoIQIPCWQ&oe=6A60A6F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London River Cruise like a Tourist \u2013 VR Travel", "keywords": ["london", "travel", "sightseeing", "boat", "tourist"], "long_description": "Take a spontaneous virtual day trip to London and experience the city like never before on a classic Thames boat tour. In this immersive VR experience, you\u2019ll ride a large tourist boat, surrounded by fellow travelers, enjoying panoramic views of London\u2019s iconic landmarks from the water.\n\nYour journey starts at Westminster Pier with stunning views of Big Ben and the London Eye. The boat crosses the Thames, stopping at the London Eye to pick up more passengers. Continuing downstream, you\u2019ll pass under iconic bridges like the Millennium Bridge as London\u2019s skyline unfolds. On one side, see the Tate Modern; on the other, modern skyscrapers like The Shard, the Walkie-Talkie, and the Leadenhall Building.\n\nThe tour\u2019s highlight is stopping at Tower Pier, right before the iconic Tower Bridge. Here, you can marvel at the bridge\u2019s towers and busy river traffic. After disembarking, explore the vibrant area around the historic Tower of London, watching tourists and boats.\n\nOn your return to Westminster, enjoy more breathtaking views of London\u2019s sights. This 2-hour VR experience lets you escape daily routine and dive into London\u2019s rich history and culture from a first-person perspective. Whether seeking a brief escape or a virtual adventure, this Thames boat tour offers the perfect opportunity to relax and experience London without travel hassles. #london #boat #travel", "short_description": "Experience a 2-hour boat tour along the Thames in immersive VR, where you see London from a tourist\u2019s perspective. Sail from Westminster Pier, passing iconic sights like Big Ben, the London Eye, the Tower Bridge, the Tower of London, the Millennium Bridge, and modern skyscrapers like The Shard and the Walkie-Talkie. This first-person VR experience lets you take a quick virtual day trip, escape your daily routine, and immerse yourself in London\u2019s vibrant atmosphere \u2013 all without the crowds. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/London-River-Cruise-like-a-Tourist", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27187962754152104"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1426487575905200"}, {"status": "PUBLISHED", "id": "3410227182475610"}, {"status": "PUBLISHED", "id": "2147511096080941"}, {"status": "PUBLISHED", "id": "1595776248118952"}, {"status": "PUBLISHED", "id": "1891419091584085"}, {"status": "PUBLISHED", "id": "1582952629546393"}
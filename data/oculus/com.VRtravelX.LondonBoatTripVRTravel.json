4_8830527676489269045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y0gmSnQDOwQ7kNvwEQ0oay&_nc_oc=AdppGC4YoTrqcZRqPDj3zKXB_gAs7nwwealrSDV8DJW-qXDXfAsvcO7ZmJcc6RALnpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZCo_6EXRAC73r9eHFxQZIJM8NBpJJThY1ltlg_bdOPQ&oe=69F74584"}]}, "id": "1177894466609809", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "2017178288800647", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_2017178292133980_8065475897024876305_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r_aWXehjzIQ7kNvwGlX5-0&_nc_oc=AdrESTMFlhBAVHxpzO4tpsrrBZy3TGqRZKWhCx_79gB9J-_eWdygDBQFTw9EVZdhsoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18i0rpPRtGAQUf55GfEOiBFU5KW3eIkp9PW8I6vzhMWg&oe=69F74A9F"}, {"file_name": "screen2.png", "id": "1059997772202487", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974796_1059997775535820_8939742875257313433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMELc3D5DDkQ7kNvwG-sZHG&_nc_oc=AdqxOrB_rlkYCwc-PY6uwcgFsb906OLXteQFfxm9xGy3dMaSnh88qxcuhaunTOJZqY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MrBIsrRQye2cJB8Z_B6GqoLnIXhRTnwnblKkzmMmfQw&oe=69F7506A"}, {"file_name": "screen3.png", "id": "926773679274252", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982638_926773682607585_6386672243534466423_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDFSDGTwCKYQ7kNvwGfFJ1K&_nc_oc=AdoZz7I1dn_-b-W_04EEMONtxRagYrtjQC3fGC1wcpVdhlHHpl_w1HWKimGCa1JNfrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YN_cRSeKYg1O133NRYXeXtq7okZQV0N1KCAsTDhTPvA&oe=69F7557C"}, {"file_name": "screen4.png", "id": "1587028465215784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003273_1587028468549117_2130771912564351873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4CF160MyFcQ7kNvwFX4Gr3&_nc_oc=AdoxuWpF98i40uT4mdr8ziQBMz57Mix7RCO0m6-wFn5f9TZ1nauRigaL6DPoH-VIVTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1y5225JcLwhVzOeFK_MtwrDpIEYeKtQAs_497LcY1JPw&oe=69F7385F"}, {"file_name": "screen5.png", "id": "1255660122127711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575346_1255660125461044_8082840014684946814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRyJOWt-PbEQ7kNvwGlp_pY&_nc_oc=Adq994pI-nHlbU5y6Cdo-XR60e4yz7aKPY9WtoUFUwNSoJoqw0sOkZQFGjxTaIT-kbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IeywP90hidfECWHYT3MVHfglfUW3Gdbj_hQCSRGBgeA&oe=69F76731"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London River Cruise like a Tourist \u2013 VR Travel", "keywords": ["london", "travel", "sightseeing", "boat", "tourist"], "long_description": "Take a spontaneous virtual day trip to London and experience the city like never before on a classic Thames boat tour. In this immersive VR experience, you\u2019ll ride a large tourist boat, surrounded by fellow travelers, enjoying panoramic views of London\u2019s iconic landmarks from the water.\n\nYour journey starts at Westminster Pier with stunning views of Big Ben and the London Eye. The boat crosses the Thames, stopping at the London Eye to pick up more passengers. Continuing downstream, you\u2019ll pass under iconic bridges like the Millennium Bridge as London\u2019s skyline unfolds. On one side, see the Tate Modern; on the other, modern skyscrapers like The Shard, the Walkie-Talkie, and the Leadenhall Building.\n\nThe tour\u2019s highlight is stopping at Tower Pier, right before the iconic Tower Bridge. Here, you can marvel at the bridge\u2019s towers and busy river traffic. After disembarking, explore the vibrant area around the historic Tower of London, watching tourists and boats.\n\nOn your return to Westminster, enjoy more breathtaking views of London\u2019s sights. This 2-hour VR experience lets you escape daily routine and dive into London\u2019s rich history and culture from a first-person perspective. Whether seeking a brief escape or a virtual adventure, this Thames boat tour offers the perfect opportunity to relax and experience London without travel hassles. #london #boat #travel", "short_description": "Experience a 2-hour boat tour along the Thames in immersive VR, where you see London from a tourist\u2019s perspective. Sail from Westminster Pier, passing iconic sights like Big Ben, the London Eye, the Tower Bridge, the Tower of London, the Millennium Bridge, and modern skyscrapers like The Shard and the Walkie-Talkie. This first-person VR experience lets you take a quick virtual day trip, escape your daily routine, and immerse yourself in London\u2019s vibrant atmosphere \u2013 all without the crowds. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/London-River-Cruise-like-a-Tourist", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27187962754152104"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2147511096080941"}, {"status": "PUBLISHED", "id": "1595776248118952"}, {"status": "PUBLISHED", "id": "1891419091584085"}, {"status": "PUBLISHED", "id": "1582952629546393"}, {"status": "PUBLISHED", "id": "1538480887597579"}, {"status": "PUBLISHED", "id": "1174208891189953"}
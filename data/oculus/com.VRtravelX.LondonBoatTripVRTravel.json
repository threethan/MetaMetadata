&_nc_oc=AdoS8lBupEt_zm9jzgPRD6glu1H2F6PmzNLcozYQWS4C31WHmR-1moN5kchLbNvEcKI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUK_1G0Nwniz_YdRoM1lAuWxWHMAc_j4F18BiI1WzrEA&oe=6AFC5E7C"}, {"file_name": "screen4.png", "id": "1587028465215784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003273_1587028468549117_2130771912564351873_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbGTtOtGvCEQ7kNvwG4PtPw&_nc_oc=Adp4J678wHNVcD-ci_hkiHwt6QkY8aijoe0KAY6EDRmGqNnraDDdWZimJ7weBG1-wwY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3arphsuYJnuFZSrkVKpCGY2utJ-227rLyQivdiuJDkg&oe=6AFC799F"}, {"file_name": "screen5.png", "id": "1255660122127711", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57575346_1255660125461044_8082840014684946814_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZM36AoFp6sQ7kNvwHxFt5I&_nc_oc=Adp8ST8IcGwE375yCb2ef7LngMr0ZldTxjismgFx4rP9uRRyVW2Y35gBPqthY6NVcHM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnvfy-e7nJug85VbS12yI8M8j00T5gPucyIrenng6X6g&oe=6AFC7031"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London River Cruise like a Tourist \u2013 VR Travel", "keywords": ["london", "travel", "sightseeing", "boat", "tourist"], "long_description": "Take a spontaneous virtual day trip to London and experience the city like never before on a classic Thames boat tour. In this immersive VR experience, you\u2019ll ride a large tourist boat, surrounded by fellow travelers, enjoying panoramic views of London\u2019s iconic landmarks from the water.\n\nYour journey starts at Westminster Pier with stunning views of Big Ben and the London Eye. The boat crosses the Thames, stopping at the London Eye to pick up more passengers. Continuing downstream, you\u2019ll pass under iconic bridges like the Millennium Bridge as London\u2019s skyline unfolds. On one side, see the Tate Modern; on the other, modern skyscrapers like The Shard, the Walkie-Talkie, and the Leadenhall Building.\n\nThe tour\u2019s highlight is stopping at Tower Pier, right before the iconic Tower Bridge. Here, you can marvel at the bridge\u2019s towers and busy river traffic. After disembarking, explore the vibrant area around the historic Tower of London, watching tourists and boats.\n\nOn your return to Westminster, enjoy more breathtaking views of London\u2019s sights. This 2-hour VR experience lets you escape daily routine and dive into London\u2019s rich history and culture from a first-person perspective. Whether seeking a brief escape or a virtual adventure, this Thames boat tour offers the perfect opportunity to relax and experience London without travel hassles. #london #boat #travel", "short_description": "Experience a 2-hour boat tour along the Thames in immersive VR, where you see London from a tourist\u2019s perspective. Sail from Westminster Pier, passing iconic sights like Big Ben, the London Eye, the Tower Bridge, the Tower of London, the Millennium Bridge, and modern skyscrapers like The Shard and the Walkie-Talkie. This first-person VR experience lets you take a quick virtual day trip, escape your daily routine, and immerse yourself in London\u2019s vibrant atmosphere \u2013 all without the crowds. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/London-River-Cruise-like-a-Tourist", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
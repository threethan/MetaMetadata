4_8830527676489269045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XK520Fh65s0Q7kNvwEhiQVA&_nc_oc=Adq9d06y9KJLrgxxS9dP3xAyCVX72ACb5Iz-9KX2q7mhPMA8JdPxWCYkCt9TEYOVl60&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39wAqCmQqwrS2jqjKk4Xt8YILYWPqsxm-_gweJqyWMJg&oe=69E0DC04"}]}, "id": "1177894466609809", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "2017178288800647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982588_2017178292133980_8065475897024876305_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2UuOicV3JwQ7kNvwENbsbb&_nc_oc=AdokCTCXGlc5q7qvJb3GEnTQSv-JsKlTyAj8GK1D2M09RoyPHT-fwquH3oL2vUmiaus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gk92kp5wgTQBwqzWKhflfHUQJuiaJSfColqUDllfe0w&oe=69E0E11F"}, {"file_name": "screen2.png", "id": "1059997772202487", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974796_1059997775535820_8939742875257313433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvBifbvCcUEQ7kNvwFt3cB8&_nc_oc=AdqHeK7vjcQ4L1wHd9mqv40ln-B5ZtFv63MvxoNFb-6FYMX7Zow0D1zZFvw9mhcQ1uE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dm1vB9piVX3x9YWhjhkJhw1FkphffGz1ORP7O4oPawg&oe=69E0E6EA"}, {"file_name": "screen3.png", "id": "926773679274252", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982638_926773682607585_6386672243534466423_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-rJimy1de4Q7kNvwH8C0tI&_nc_oc=AdrNMK5-RWRWd5gdMfwntuWqNU77k3ie_VRa9paFrOsZae8WZA9PY624aWxZDEY60Pg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dUUKpwJiqpXklI14YLt57zLN36pWAE_TBiRdpuvaUTA&oe=69E0EBFC"}, {"file_name": "screen4.png", "id": "1587028465215784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003273_1587028468549117_2130771912564351873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqLQ3GCU6AsQ7kNvwE9vzOd&_nc_oc=AdpMwxUMCpbIQXC9xP4w6wgp669NiFOYA251AOBDqhGHxpa-lKE_Tn3zmDZsc9JkDnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EKEJE5Ghtw0QP1lTd-pZ1KgVLPuQvcv_o3ryfxej5iw&oe=69E0CEDF"}, {"file_name": "screen5.png", "id": "1255660122127711", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575346_1255660125461044_8082840014684946814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyrDAVhFoQ0Q7kNvwFqRQ7B&_nc_oc=AdpySWPhLankkBFOkf9ZA4kYeIW3OS56GCGGfcQgHc9DfOZpde7QTkbJrVL92uhpJog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E5lPS67NxIi_c-Q7CSpgOrkwAqimqRvsL5tKi_R0SGg&oe=69E0FDB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London River Cruise like a Tourist \u2013 VR Travel", "keywords": ["london", "travel", "sightseeing", "boat", "tourist"], "long_description": "Take a spontaneous virtual day trip to London and experience the city like never before on a classic Thames boat tour. In this immersive VR experience, you\u2019ll ride a large tourist boat, surrounded by fellow travelers, enjoying panoramic views of London\u2019s iconic landmarks from the water.\n\nYour journey starts at Westminster Pier with stunning views of Big Ben and the London Eye. The boat crosses the Thames, stopping at the London Eye to pick up more passengers. Continuing downstream, you\u2019ll pass under iconic bridges like the Millennium Bridge as London\u2019s skyline unfolds. On one side, see the Tate Modern; on the other, modern skyscrapers like The Shard, the Walkie-Talkie, and the Leadenhall Building.\n\nThe tour\u2019s highlight is stopping at Tower Pier, right before the iconic Tower Bridge. Here, you can marvel at the bridge\u2019s towers and busy river traffic. After disembarking, explore the vibrant area around the historic Tower of London, watching tourists and boats.\n\nOn your return to Westminster, enjoy more breathtaking views of London\u2019s sights. This 2-hour VR experience lets you escape daily routine and dive into London\u2019s rich history and culture from a first-person perspective. Whether seeking a brief escape or a virtual adventure, this Thames boat tour offers the perfect opportunity to relax and experience London without travel hassles. #london #boat #travel", "short_description": "Experience a 2-hour boat tour along the Thames in immersive VR, where you see London from a tourist\u2019s perspective. Sail from Westminster Pier, passing iconic sights like Big Ben, the London Eye, the Tower Bridge, the Tower of London, the Millennium Bridge, and modern skyscrapers like The Shard and the Walkie-Talkie. This first-person VR experience lets you take a quick virtual day trip, escape your daily routine, and immerse yourself in London\u2019s vibrant atmosphere \u2013 all without the crowds. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/London-River-Cruise-like-a-Tourist", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27187962754152104"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2147511096080941"}, {"status": "PUBLISHED", "id": "1595776248118952"}, {"status": "PUBLISHED", "id": "1891419091584085"}, {"status": "PUBLISHED", "id": "1582952629546393"}, {"status": "PUBLISHED", "id": "1538480887597579"}, {"status": "PUBLISHED", "id": "1174208891189953"}
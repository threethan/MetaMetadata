GlO8Y8&_nc_oc=AdoIvRilKM0vdb5WDcXade_Aj83x9FJY4uwD4-ygKOvwYekL2HiRkznUsP_zASMecxs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZSDiJG6r5k6RtAXvaERj1HPDuVlK4eBoeHR6sGm-m4A&oe=6AAD49BC"}, {"file_name": "MBVR2_ScreenShot01_2560x1440.png", "id": "746994371291654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618264_746994374624987_8003049724450782363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrkPNeE_bTwQ7kNvwFhIHGs&_nc_oc=Adq3I2G0AWjZwjik8tnwz0uZAP_J_uMe3z1TzGKlIr3GTIfoaIAemEGkk_mt-DfmCHo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVQEVNzRVpAft2fAYFe3QEI-ajMDXqSToGHXu4gkp1vg&oe=6AAD2EE3"}, {"file_name": "MBVR2_ScreenShot04_2560x1440.png", "id": "1217046537072124", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619594_1217046540405457_6778283950990961136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSZzADHUcagQ7kNvwEE8AIG&_nc_oc=AdpXLinqcXcoQ3D5Rskt7FH_nbCcdT4_Kx9su5_yiAD5o5phRbhxIrgKb8W2CNa0zrg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy8tqr-8p85nGGV4fgbGoogQTAKGpeIIwLgWW25AOQTw&oe=6AAD4F3B"}, {"file_name": "MBVR2_ScreenShot02_2560x1440.png", "id": "1401838281595210", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_1401838284928543_8734710809350329945_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwZIP3dAnZsQ7kNvwEZkYiF&_nc_oc=AdpB662-xMLm9gclexYf3V2aCmcRW8WRmm1DqWsM6dxYT_jgAcsjUbmkujaDDEzJzYc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiTetY3eOaEqqIqEfD4pX_6lt0iMTfUVz7KJZLO1BqVw&oe=6AAD2C84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30cf\u30b3\u3081\u3044\u308dVR2(Box Maze VR2)", "keywords": [], "long_description": "Summary\nSolve mazes like never before in VR! Hako Meiro VR is a unique puzzle game where the maze is drawn on the surface of a 3D object. Your goal is simple: trace the path and reach the finish line. But there\u2019s a twist\u2014since it\u2019s a solid object, you can\u2019t see the whole path at once!\n\nHow to Play\nRotate and Explore: Grab and rotate the box to see it from every angle. Hidden paths are waiting to be discovered on the back and sides.\n\nTrace the Path: Carefully navigate the 3D surface to find your way to the goal.\n\nUnlock the Surprise: Once you reach the goal, watch as a special CG model pops out from inside the box!\n\nKey Features\nSpatial Puzzle Experience: Enhances your spatial awareness as you manipulate objects in 3D space.\n\nIntuitive Controls: Designed for VR\u2014simply grab, rotate, and trace.\n\nSatisfying Rewards: A fun variety of CG surprises await you at the end of every maze.\n\nCan you find the path to the goal? Spin the box and start the challenge today!", "short_description": "Play the box maze!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mazeboxvr2/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u4e09\u6b21\u5143\u8ff7\u8def\u5de5\u623f", "support_website_url": null, "website_url": "https://sites.google.com/view/mazeboxvr2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25317963134566684"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "831378186393026"}]}, "baseline_offer": {"id": "831378186393026"}, "is_approved": true, "firstOffer": {"nodes": [{"start
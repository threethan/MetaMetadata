creenShot01_2560x1440.png", "id": "746994371291654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_746994374624987_8003049724450782363_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYTyU9xAoqwQ7kNvwESRTgE&_nc_oc=AdpXMRhAvnzhg_97uWmoDU_81tb_nlHsr-6wRB7ALK_9mEumD8hdMvKhi0_0On76PPI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L7RvRIkZBsXDVGr3YjEKNqrf3AlnX8mCNB8y603Mr6Q&oe=6A183563"}, {"file_name": "MBVR2_ScreenShot04_2560x1440.png", "id": "1217046537072124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619594_1217046540405457_6778283950990961136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9iMuZQxZdYQ7kNvwGQWg8y&_nc_oc=AdrMJJkQnVVxX8lCmfsSeFQWgeNhvZBxdfW4P9r2HgzuOlwDnORc16mKNsAjqD-kpgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FcXIMSUPvv-ziQhwruBZaotXFruUJKyuJspovRxntkg&oe=6A1855BB"}, {"file_name": "MBVR2_ScreenShot02_2560x1440.png", "id": "1401838281595210", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_1401838284928543_8734710809350329945_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmB7OhenlAoQ7kNvwGB4n_i&_nc_oc=AdpRz2wGIiArBGqLfi4nhS4dh13c5tYByCALGewGRRG0k09wMECLyJpAw3m4A12kMac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SPO8EuNLVJ5qerpwEiusLuHZm6ZesXpGAjuVbhkmO_g&oe=6A183304"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30cf\u30b3\u3081\u3044\u308dVR2(Box Maze VR2)", "keywords": [], "long_description": "Summary\nSolve mazes like never before in VR! Hako Meiro VR is a unique puzzle game where the maze is drawn on the surface of a 3D object. Your goal is simple: trace the path and reach the finish line. But there\u2019s a twist\u2014since it\u2019s a solid object, you can\u2019t see the whole path at once!\n\nHow to Play\nRotate and Explore: Grab and rotate the box to see it from every angle. Hidden paths are waiting to be discovered on the back and sides.\n\nTrace the Path: Carefully navigate the 3D surface to find your way to the goal.\n\nUnlock the Surprise: Once you reach the goal, watch as a special CG model pops out from inside the box!\n\nKey Features\nSpatial Puzzle Experience: Enhances your spatial awareness as you manipulate objects in 3D space.\n\nIntuitive Controls: Designed for VR\u2014simply grab, rotate, and trace.\n\nSatisfying Rewards: A fun variety of CG surprises await you at the end of every maze.\n\nCan you find the path to the goal? Spin the box and start the challenge today!", "short_description": "Play the box maze!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mazeboxvr2/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u4e09\u6b21\u5143\u8ff7\u8def\u5de5\u623f", "support_website_url": null, "website_url": "https://sites.google.com/view/mazeboxvr2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25317963134566684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618102_878449377897320_4347997139507708816_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqXbTcgnuMcQ7kNvwETEdL4&_nc_oc=AdrotRQhcrs-1o1M5YhQ5RdPBzcTYS8UF3rPaZ08uj6Vp3VOxLbCYyg-fbENsosfMPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tAbvyVHOTWg5vqTNU4kd0WmUhQVoowr_aRK
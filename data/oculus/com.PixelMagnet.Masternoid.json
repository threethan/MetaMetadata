&_nc_ss=7f20f&oh=00_Af4VkNzQsPhnfqHG244_U2vk6XleF-YKqDYJyPLjE0M9pg&oe=6A19ADF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTo35b3Kb9gQ7kNvwHjYwof&_nc_oc=AdrAq0-B_6uaVQFZ8PI9NIXI_EsAJoH-KGr6lUyqtgbNKN1D9VfW6ao0-1q6nN1GIXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tMtehIQYsYvZIrDv95Boe51Di3V6VyW1Ve7Tp2DwWLw&oe=6A19982E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMxaX8Xq2dUQ7kNvwF3JnSy&_nc_oc=Adq-Vpu5L7RkrpYTbRMXALRAewk01dvOdkH2tMOm_-UcDEweRkWc4KwSJsRvwyOuK3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pifyj7_ZCfZYNwDcvdtv_NyvGNKIeWhzf5T5r3bw13g&oe=6A198CA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TugYK0Z8w7IQ7kNvwG-NYo5&_nc_oc=AdqXVKKW_9bShTVLI5ec2jDNjnui8i7sgKGtbTyd_UdqhtsucMCLL_Z9vbE7zgtALco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pQL_84ETe4EpoY8TRbPro3Z2NbVam1QnjfEz1m3Tcew&oe=6A1996F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAnyli1VTEQQ7kNvwFoBu2S&_nc_oc=AdqL0KX3sG1bkeWfA9jRuqhyCD-1uKK-UQKR5ufbaKCZ0VjkOymWzZ25IhAsixtSGM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N6HwkL_lfs9X-KAjj1Mn73rES6vcWufeDFhhJzNo5ug&oe=6A19881F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
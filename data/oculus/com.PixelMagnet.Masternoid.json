&_nc_ss=7f20f&oh=00_Af7osyg_26-lyCtl5qlOuwKUj6avFKMODC5PjAnBw84moA&oe=6A0B2D76"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlPJbUOoGVAQ7kNvwFl0KPa&_nc_oc=AdoqKLgTidbqquZpjNzIATeFOTD8n8joKO49Ek4X-EypfSFm0JWkqcFuQuuBlY9xK5U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O0-lUKgGZ9a9fqH_ahLlqt78LFEi63DjDwS3ViFKtPQ&oe=6A0B17AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd7uwWNnpn4Q7kNvwHkH75K&_nc_oc=AdpMld2F7XF1X9RdbuztDcaUhGi8WhowE5km_9p5A1pwb3M3tacv_mVNmXRhJ7aeTtA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dXub4CXr4C0cYvjmkmQz3VTDbAoAkVao-corpHQSURg&oe=6A0B0C28"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXMulFQkRPwQ7kNvwEJQIhH&_nc_oc=AdpFk3-xWXLy82Yk3BQHkfGdRp0gIc-5cgGchfCHA1QWGN41prQOsf6BkQOrVHsgNrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ye-0V8KZxuMnAyALCsZRbnjYHtdsEEh-4yfEgr2yF5Q&oe=6A0B1675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l8HARlaaHwQ7kNvwFU4jBg&_nc_oc=AdrJI_c9m8cMNcK27N6aSvw4sGmTgYUEn9Jigvzmcq_tv2QlbLakwgtPajBYRAYprCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4njbP-0ZWa1j4chQP87hj2yQnHrVP6zH9uNwcVSYJAxA&oe=6A0B079F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
zCq0y4bFvp-hAK7_CDQLtp2SbptSg&oe=69A96636"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw0E9JhGFHQQ7kNvwGGDKpf&_nc_oc=AdkTBbc7N0NqJyRICcVrRIPR_3WNaqbSP3nhsWq8trcEckCwaeVXRjOGnS4I79_3-Qw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuArJAMwKx1gOwZKptct6-QXl8Z3orb6nfJkKn7QIcJmw&oe=69A988AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLLA6Bsz81YQ7kNvwFFAQmx&_nc_oc=AdlVNnXXlX2ocroVIdYiX_1BQq-EcKVl3VZ5TKWTK4kaRur5MlT8fvBWv6adnD0n0OA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsEkXD0pwl4uRAX82qIqv_bppzFgn-YWJM8Pe4ySd0eng&oe=69A97D28"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf3gtJSH6fAQ7kNvwH4dE26&_nc_oc=Adlfxk0R4XU2Qa7z9HOjD1XshV_cYfX6Gbjy_z6mcMcyxOjK9aHrgvraU2kHZeTmox0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftynZK-w6WclyH8N4Bwcs4jwbyCp2kJQ_0HalmYIBVJvw&oe=69A98775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CufL1tff4-4Q7kNvwFPSfzA&_nc_oc=AdkhXrRH0cjH_EE0T8YA4zaK8eXCIWPliISG_lSPNdhJ3P7GATtZnYbLw9S4cBPZSq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv_8LtqM21Ev38sZSsl-EPokkyhlnTy6vhNoDeKhY--jw&oe=69A9789F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
&_nc_ss=7f20f&oh=00_Af6kQ7xh8MVch1intC05iMGXiU69cwx5-GkoLQqTl7RGpw&oe=6A0F21F6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwNY8KxigQsQ7kNvwFrXwWf&_nc_oc=Ado8MwpQ9yfd8nX5HIT1oYtchYzzTHao-CtbaFpnfDoq4BhCRrI7IS_0O1qjYRbufew&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af501hxBODL2BqcI_5kO7MTqrO6YL35d76UzliCFaeFOjg&oe=6A0F0C2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUgD2GxojLsQ7kNvwFbxSnw&_nc_oc=Adqckea7q9018sCW4F--07K4x0bAsGDtPLwMsZgc3CllhBoFGbu-8IK9lT6ByXfKy0M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X4Zz8Ld1h5L6gUq_pI1Cu0j2VGoJExK_-D2o6S0nYsg&oe=6A0F00A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orpk4SMAmK0Q7kNvwEcFcjW&_nc_oc=AdpXFSMJchSVuvpZ4v7x1a-LKMY-uNTqwtsaKNTPOVyua39u12NdpDaghcbWO0hG044&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VIK-dzjO7p-Sx_IptR3LI0I1TYc1eeSbSGriRE6O_kg&oe=6A0F0AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt1bbOSrjb8Q7kNvwHSO8oJ&_nc_oc=AdrTGl6um4drES7JGo1GwETpwH4t2EeVK179C8JFBsWFseKhcuGEQbNkd2JkcO26nHM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nLU-hcDykFFRN_z0DRS07nTPM5qT66Ho5WX615ckNXg&oe=6A0EFC1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
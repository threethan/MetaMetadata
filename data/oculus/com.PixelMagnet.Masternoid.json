965926654455546", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1yHSMevFrIQ7kNvwHCe2xh&_nc_oc=Adnyu1eJcH6hk--ePRTP49wSc_cPVdho7QjEiY-AvR91m7UE68XawuZpW_egeVTd2Qs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu3gNJDeBMpQ-qUh0tJuVn5uKYcYmsoIXrRsYv6Jq_kEg&oe=699B082E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UyO6O8oKDQQ7kNvwE0sZkx&_nc_oc=AdmfVXG6AKdY4HMnPCwRAHqNvfOCkHk8CfNXFgWQbR5ev9snTOBhs48_l8FH362zNQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft4fzf6UThXlDha5epIEuFWmVrcSVCkqLFlV1fuUXOBcg&oe=699AFCA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dogtvk-fNO8Q7kNvwG78bZQ&_nc_oc=AdkyE1Ig89nT2mc3_GRvXKWmEJAZCaOi9E86bbXpyNEZkzyBYHVKT2bwQyBUwwBu30k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfufxFC8CaaqHl-CrbvURWVPHtrFV8T_2iexFAOIuVNkNg&oe=699B06F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVeXpkhWLLkQ7kNvwEkFmWs&_nc_oc=AdnJTqRMyzKU5FPFIEWAokZZg-iIdY8n4bSGKbNyS7mGSRc2108plcFWBpVXraTaHi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftrD-hmVVl14HxY6VyvbcXs__zxPMov7fUphwst0olcPQ&oe=699AF81F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
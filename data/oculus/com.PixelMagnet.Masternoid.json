&_nc_ss=7f20f&oh=00_Af9C1ISqCWPEyyMi1Ktc7YcOIKRv-8BDFzawj9dc4Gw7jQ&oe=6A301776"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Tgge3M7vxwQ7kNvwGAgU9Z&_nc_oc=Adq8Da7-qOAvxYdaNbDLD8DQ-5JBDDR_zGqZjXEUePg7F1KwNtFoy88VZg7KrzrS0aM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m4ryYRxuEYTCYP1fUDAJ96jvDWaphOaFOdNWIRScOlQ&oe=6A3001AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lN3AsO711oQ7kNvwGy_oY5&_nc_oc=AdpV2UYu2IRnxkYOGGTr29VmTExtxvoikG14_ZlZzCmsxgWoWbtAfb-HZgvL9O5NpEI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81l4oEJb8_3cOvwrDqiMG8gKGura8aA_CKYYNJNNXzDA&oe=6A2FF628"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5FUQJvnJW4Q7kNvwEkW-A-&_nc_oc=AdpLJvL-YzgouaSWqc1TFWJI-r-sAd05XD-hLCCdxc_LXSM8UOlFoWFWtZKPiGxdeDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tKLynFiM739g9D9AxWfPr89_M1mj9Nbn37Wqtr5L9mw&oe=6A300075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=917KKpe8SogQ7kNvwFouQzO&_nc_oc=AdoQvEEkWrYR9iM25TgceXDbuQLGQsLpNtheYEVmdGAaAi-kTj9uDN6rz8RLuvAJ4B0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0exNOVFdqBVC9rrJ1GXkxRMlUa-m92NaQr7uBW3WERg&oe=6A3029DF"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
965926654455546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agqMh6jiaEkQ7kNvwGEZPAZ&_nc_oc=Adm40Aw000vGA7JN4rfvM1JzoSeLksfRhKVP70a1CDhALIg49sB7EDe6UgBi26MbosE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs9wlgHnBnoZjYrNW7cqEp2M5o_MTdySKjA9OQ1xkuPQw&oe=699EFCAE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKf4ualN9bkQ7kNvwHtpi30&_nc_oc=AdlhEDmGwhR8ba0So6I73J2FN015Cj4ZZCWDzuF76eGY6WfkCG7fmzDcI11k-29g1xA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuRehX9zkb75CdAXIgoeeTWCv6D37387AqBZ-Njp8lG9g&oe=699EF128"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKsYcA1o9SoQ7kNvwHCSlxk&_nc_oc=AdlrPdllOulBVzYpv8T7OnY50s-SucsQqYpfFLC1RPZGXVBusVumYCqlwxyyFZg0T4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfugSGcS4_icSRobQn78sMlPALHgUk6sMcuP713MDxlaSw&oe=699EFB75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gHzmlt3GlYQ7kNvwGO6xJG&_nc_oc=AdkSymF2lDeOcvVZUtw-tVEF9YHpnDLMWqzVum_k6vw1eAilQAKuceOz5dltsRN5ppI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvYJBYfDPEooBODcwv8O5oVwifDxYrwIhoO6iuZUI0K0w&oe=699EEC9F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
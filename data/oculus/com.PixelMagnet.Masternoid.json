&_nc_ss=7a30f&oh=00_Af3xJ32cU41P1bPFB9lgp56spluWkpiNkQyUmTYi37VSXw&oe=69EB8976"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tq8F6QmchZwQ7kNvwFKDMd_&_nc_oc=AdqVnXzNwIhyblJPO2-JHkF-tLPtYeYYUcE63tvkjY-yci6vB88ZbEFy9AbwN_aT0rY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35HTuUFO6c-sElx5nNJCZ6YqanCrMUJvW_F9xcOol2nQ&oe=69EB73AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ULyBEPZgXUQ7kNvwH3Hzbk&_nc_oc=AdopKV-8FFA14Vu0JVwhPfafJNlWSvVU7n7oDUq-RLzUJg24lCfbAhZChAntiUhh_qM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uew_DgRPxa_ZwI5QRbGYyPpFHzi_0UCtNtqOp63XliQ&oe=69EB6828"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykfmtX1mwVUQ7kNvwGUsALX&_nc_oc=AdrnDsZ--8PNpA9R1TkCkW65-KgyIHm5ZWTnbJ_OF2FI0AUQcBzrv5nee0uMBQhxXKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tLVH8Sf2tpFAhLrQt7WHFDHAcREEmcv6CX4K9Wkiv_g&oe=69EB7275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RikFQ3U-QLwQ7kNvwEessD7&_nc_oc=AdoHCeD8jWSt7dCHsc3g0TaNr4OtpalAojuRhsGaBQR_mFFK1dEoX8xOzxZ_K4-MixE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AS04m3o4B2ac5IhTNwqZ482sbcXUzMancxOviDDC7oQ&oe=69EB639F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
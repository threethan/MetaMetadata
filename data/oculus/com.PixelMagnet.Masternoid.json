965926654455546", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1yHSMevFrIQ7kNvwElR3B8&_nc_oc=Adkcv9lBAIE47haC3l7vqMM443jf6bURVDEtwdZaenNpyXs_YSld1oblpiEeDmnKN0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvv3bGl40kNFVHIB9GF4mg1E1DJc5z4bR2sz7g4Y6aTNw&oe=699DAB2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKf4ualN9bkQ7kNvwFI5vPp&_nc_oc=AdlXRClW9VU4ez_JImfA9985FZkpUbG9kTeJ6SBa5KR2OAlkwqcrqEWrn5r1qP8yQw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsa7Zcr6Lxq0vYC5ghAmSdbycfKJuTYQNG0pfJ_llczMw&oe=699D9FA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKsYcA1o9SoQ7kNvwHgH_Di&_nc_oc=Adk-Ehajb_MEftu6yNWCbdoLMMjD_TeQfCJ3THdKv07-9I09B6aKbzzsVyQ81bMm_rc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuxv05F-qJJRUepPlTRpQw8NLZ-Qn6BgVUedsB0w0tf1A&oe=699DA9F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gHzmlt3GlYQ7kNvwFdflwl&_nc_oc=Adn7zaG4QzgurJpIahwo3Nx8AzX9QdWr6E81WOu6-kgeiyiQy6gD-ad-ssavE_ujEwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuv8Y3-9juS9Ce88uAMZ5uscmz6Oi9v9Xj67VHTs99OWQ&oe=699D9B1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
&_nc_ss=7f20f&oh=00_Af5nQHVLsMMa3_jgMp6NEGyFtHz7bpPdbYb0ZtOzLo_iLw&oe=6A107376"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-wRTpVwshMQ7kNvwE_TZh0&_nc_oc=Adr3XgRqIYDYKKIHnRuAgPlFAcd0RgYGcVDZhpZEyuczQtTCaOsJKiteBC9As4bGee0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E4L4QW0_dqfoZdwgWnqqKR-_iZbgV_aweDa9rv8Js-g&oe=6A105DAE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI2xQbKPVwsQ7kNvwHlj-O1&_nc_oc=Adp9lJQSM1Tg9RUyVUumMdWH9JmVLF3v3Q4tFpI6VY65KPEFDf6d-MKcAgHHjCmZJwY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VtMK0opdoI8wERGHCATx3cD3_zNtM10BSqui-dy72Xg&oe=6A105228"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLadACOfQJYQ7kNvwEAwFGg&_nc_oc=AdrkyxPV96WD_wxbcpDzzhm1_OqlrXq1gXSIYqMpBzRdTLmxJXBVPpQwLwo2x3nnlB8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66LVFkwF37uN8pCWZ--Jaugn1bFIaffeUWym9zslydVA&oe=6A105C75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On8mEucmnbIQ7kNvwEjrsGD&_nc_oc=Adp1s_xORGXSFEGslQpRR6mRJFHzFapv2OjjtXf0umjq6OnlhyUThz9-Fn-3l9thlB8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M_7hhsVLjGDYTLgt-D-b6Sqotqd16MTB7ex-ZZ_GW9Q&oe=6A104D9F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
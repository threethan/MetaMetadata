&_nc_ss=7f20f&oh=00_Af7Hbap5xq0DFynFEcfG0Ftt1YLSVGBOPy6BK1R3GljOkg&oe=69FB5B76"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y5EfTzGYz0Q7kNvwExAIso&_nc_oc=AdpeQMw8kvxV5RCA844PrdLrKYblrfWZ5rLjb6duRDip-NX3_YwfW5bDypEeEd_dy6s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HOlxGNiFl8UKop3o3kdiWVkldl8TawSjRBBedSt1A1Q&oe=69FB45AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQiuUrrm5BkQ7kNvwHOJB-E&_nc_oc=Adp3kAuJypDJaGJa27GW4cqJGb5eFrtjZpVGID4dwc4FYW_y59rvbuIAzsMGmjJxikg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E-5ZFc-pVGcS1OwOAMQDj94Pa-JWyTmiquVn28SyaOg&oe=69FB3A28"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBSGeEFF8uMQ7kNvwH-8JGu&_nc_oc=AdoygOmR8waDMHvqZtG1yweHhJVqXLoaNxCQOBX833Zwsz6t3VAMUE0Hqsr7r_qGtdM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OsgM_gjPBfv_dpjkTBxrbUC9az8kEuvjSqnAC_rQe7w&oe=69FB4475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fj-va8sYPCsQ7kNvwGkhaMB&_nc_oc=Adqu1RQbRe4VY5CrIaFB-bh4-qG8JUWYS4pr9M-EjnwKgHnFosJWWiPa351uTl9QU_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rvlTAku9YMN0JKOEk-9NeckXoq7_dXfu6XPPwY2biSw&oe=69FB359F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
.com&_nc_ss=7f20f&oh=00_Af4AaOWZpwnykUgYnQ2ZoejCopVcsJdqWBoGRu53g47Rjw&oe=6A11C4F6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-wRTpVwshMQ7kNvwEHOqU9&_nc_oc=AdqIi1WBkQRwtEb2xY-bJIZ5Oqose7Ut8fd4CNASGlP7hP5j7JcfE4QJK3_O2kWH-ws&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qCIadr8CJjt72Fh9N7FcBFZJeneMpRMBA4GK57nNvsA&oe=6A11AF2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI2xQbKPVwsQ7kNvwGUicb-&_nc_oc=Adq3niGzEg9w0fNGurhVfoYFUu1gFUFIp3zsVA614YDm3MNlWO9xn-XpweTZUZzUkBE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gHcSVgg-v71r3CL3sn0Jtw-b4oxZozOgU1bPTbvbH9w&oe=6A11A3A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLadACOfQJYQ7kNvwH9Ss93&_nc_oc=AdqLoHTrIMHCs3kyGNr89KHiSlPB_2dQhykEkR8curIZY8T406c2a_-mWDqjrFa4juQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ywBW9iRyhKqcNE6IWdFEveDvkqYW7lsdDruPPX3qg1w&oe=6A11ADF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On8mEucmnbIQ7kNvwF4Vik0&_nc_oc=AdpfqXqtj17foGidoEZYJOV6OLXPXpbsNlYs0tI-UrmZNB9P-FKO4gD790C_dVZHGeU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OIraI-kZQtRfyEVSNM2-EpNJks7tcYu6kwbKfxozvbw&oe=6A119F1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
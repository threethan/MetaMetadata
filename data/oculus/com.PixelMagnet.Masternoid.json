IVTZH1pj_AJ_xmdeHPjHKR3HvaRzg&oe=69B69536"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_qAI3yTeeAQ7kNvwF8a9D-&_nc_oc=AdmduWVDJJTjy_oC99DLAHQ728ptwqhowYehNzskl72Icon8d6W42XdZszuwg2cUph0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBusZi-B-RgiczaGI8ncJcP0ZeuRqkWl3xL7qxRuziuQ&oe=69B6B7AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV6fUN612GwQ7kNvwGA6jE3&_nc_oc=AdmiECZvIqMtR_iVG_Yvw-867ru3QdfnAlyBoGW3ERUtaCcXnxXRkA-ciN369kuBpyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3VEWE0k-6s9GYVTVxmOfZjnZd5Dx5vUxIq3o7kKjiXw&oe=69B6AC28"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTLg7lDX1I4Q7kNvwGJp_tv&_nc_oc=AdkQC9kTet2uRGhkJpXdayuM3lTCVamp1tJtNZB1VlDX0HVq5XBxmfwOkskrh6tZsqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2amrp2dDr5vvuRkIIv_R3vrYkgaTM1mubFaY0GIxQWQ&oe=69B6B675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ovy2OlPNjj8Q7kNvwHO7j9o&_nc_oc=AdkkbrRj1zwgfpCxiCT4z9BiaZ0hs6YniyhqwWhRVlwY3AnIlrDh9e-v9VaTBsMDlaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRBJ6cW78Ef_rts4k0QAmj2c4CK8LSvbz8AJ3Xg0mCfQ&oe=69B6A79F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
A&oe=69F1E8B6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts3G7TTS3FMQ7kNvwFZ5kH2&_nc_oc=Adro4lDUJ44cP60ROcCXUBKYrHxZB85rrnahTFKHRR5rA4eKc7ulLDx0Xh_YiDTFvYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1eJ3PQ397sBLZsQyOeGO2418V6TqDrzpYGvd8vo0M1rg&oe=69F20B2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHy_JMyWzPwQ7kNvwGUn0CY&_nc_oc=Adok8gB1Ku0Oxr-jzHVP9ktJxeXa0XdGZ3FvGPW75-dAOaWeIRQUlsUer9yNf04nVAs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1ZndSpOKvqQFn5tyUs6dqfdvqX67dDs5QmFIewDDZL8w&oe=69F1FFA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4KuHGecjD4Q7kNvwHEdHEZ&_nc_oc=Ado8Ma6GTEzocOlFOT_sWtMxTuEVXEWlqcE6i1e8lztR4Bdw9erPx2uTnqNawkoxXtA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3cgEPEugsi9Vsyt8pjFyGL5s1dKvoqO4K-fNiC0uDcWw&oe=69F209F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBa3s1WM0_8Q7kNvwHLa9Nq&_nc_oc=Adq0xRwsg5B83w1nf5c4fyuh6ngbLz11L60lWpEaMsiKxLrP-ljDvOUufLxbhEvHGtA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3UF6HyF7NhLK7jOUyjN2uUTLZQZioRbxuFGqA3t8wOGg&oe=69F1FB1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING",
iTGg4r17paeOby_YzjNylORsVNMOA&oe=69B93836"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_qAI3yTeeAQ7kNvwGd2Rxx&_nc_oc=Adn2DXRng-rUO_wTC5wX_GclEAiCGTUEiZoJWsY-LEy2jZEg2yHg8eY6huIJ-A0uIYo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNf7teNR9kj0f7Z5QPKqujQMN32vP_WlZxZgTNsO2yNQ&oe=69B95AAE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0fMbHQvgT4Q7kNvwF7WlRz&_nc_oc=AdmIBL1fW-FDPMVcdsRz6sJav2EaP-zVCRh-vZTKx9h05ZlE04xSJL-qLOaoqiVOgUY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfySs6HtlJHR6HfMvCWQg51ChnzLwRbIb5kllk6w6d0t8g&oe=69B94F28"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MPcp02XP64Q7kNvwFe2yPA&_nc_oc=AdljihLDCRCr75-CAuJrmhDmuKcAepxzigtiJhyL7bX1AhkLHrAhGoU8shnSdC2oTzU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHIS-X_5-1BYci1SvGD6zi1kde_BSbfSr42O-FOPpSsg&oe=69B95975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQaAlpCp-XgQ7kNvwE9rS0l&_nc_oc=AdkEJOgcVjjpAtRt-MX9WI1jBJSxwEb47O6th3R4BYAKkmKjAUaTNdfBN-PwPp48d_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWLKGccHzJL21xu-Ou51vfQFc1JhPkND_1QcvHq3Am2w&oe=69B94A9F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
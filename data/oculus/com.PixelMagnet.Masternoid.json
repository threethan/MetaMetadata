&_nc_ss=7a30f&oh=00_Af0PMGdne6oH9vSQehfQ74Spke3D17KFhZDUjMmxxX44Aw&oe=69E8AE36"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf3eSvwDQYgQ7kNvwGdr90M&_nc_oc=AdqwfiU30QBlxjPNHeDwYAXKJxBkY2jkZWaJ7HQZmaXvIY149jhCHfeZvoYXDginOII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AvgmTUqvRNLK3WXpDg2zQr-mFuhFaP77bkjzKJbS82Q&oe=69E8D0AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ULyBEPZgXUQ7kNvwEvL2z7&_nc_oc=Adqo5Nu_lLy7wm5VECYLub4NTf-MOtXsoLozKs3Ts5sMjJ7fdGvTaptF_4fvCF8vbvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29a-4GsdPSxhwDN_LBG0OpukStO6BUSYHvpNo_vn-lyA&oe=69E8C528"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykfmtX1mwVUQ7kNvwGhCwRW&_nc_oc=AdrzqqvATkeOcTA_Wn0bXwiVMsZcvqPnXIhhkv5CWE181rtfPc4KX0HUAsCXjiDDqN0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38BqaOmVA03W53twYx4mlZPEycgwOO4Z3e3GZ2K0dKoA&oe=69E8CF75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RikFQ3U-QLwQ7kNvwEBDkFT&_nc_oc=AdrreRQ_Ndsw7C9Oj3Fp5tWVrPlOHN0hDmTdAngrkRN1om5pi2tEscaNqnHmDF1ayFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JtKNPThqyQbnnQcbeAis-Iqt7xrHOxc4PwOlJJfeZ_g&oe=69E8C09F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
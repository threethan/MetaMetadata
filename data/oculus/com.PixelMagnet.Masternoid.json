&_nc_ss=7f20f&oh=00_Af7YkGLyTD-13TqxswHqNQXOiMgK1a_4qwit70MfyzlDeg&oe=6A15B976"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grIn2nAUZ8cQ7kNvwET6F_t&_nc_oc=Adp-cFWfIVI7030FlGNFsbZ8H8bgjJb-SNussU8Efiqm0MoZK_dnLCbAKhwHRJXsw3E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xAsaKT8zRMs-jwAugwn0GTpAq8i9xnt2oJMD5vhu6UA&oe=6A15A3AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG548QCOzU0Q7kNvwEjIuol&_nc_oc=AdriqzKCFw68DSZBWBW42ju7qoVYMxql9YXxyfvVycPZcFKHq7wjFAHRA4m-EhsV9M4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lUamxFWfsTqxUGgnfhL7-Qdl80b_tyQt1theWEuc9xg&oe=6A159828"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcfX9e4YEb0Q7kNvwGpvK-8&_nc_oc=AdqPbYvdbLza52q2tum9JwC4GlQXVaVcP3wJ2ZtMj2t-yW9CuR02eKd9Dhs6BpJT-8g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gvTX12vEKezKzbHaiSiEJKreMtk508Y7yNnCE5u7GrA&oe=6A15A275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHXqwky_X84Q7kNvwFKjJZQ&_nc_oc=Adp-a_xdRrFdYl0Y0mWR-zq_5k6Z3Hj8lMUEgMdXthc9ogC8DIBBSl7fCIptmw7LdbA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u3E0_pL-vato4CbpURJ5iZxDOM6eYfH3DOV9BLuGlBQ&oe=6A15939F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
uDbS8s8isxXKe6HzQ3UDUJAYUPUFg&oe=69AC0936"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_K3UzGZqSgQ7kNvwFPBuSf&_nc_oc=AdnXxTzlURBCsfjN0NPlOSpZA3IPPmkX_W1OmnNaPIvlmfWHgsq1r51byEshlrekTV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx2h2dn2_eledva4kpbW6b28ybckiZFuAetxDlpWU1i-Q&oe=69AC2BAE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLLA6Bsz81YQ7kNvwFkhf-F&_nc_oc=Adk8P7X0cd8XnQ3kr_2b7_-QBnSE2rs5HfGE3M91VSiyBXt_KksvgBgE8_L6_PHpQiE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfybuENfL6zyNKwX9SuO7K12FeDzMA6eyyepYmiR3-Ym0A&oe=69AC2028"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf3gtJSH6fAQ7kNvwGo3AL0&_nc_oc=Adn3eRvkUTQmeP2jgwxA75xJ80rmpziTwXZijloklkOA7NUJnodB4yVCUaqBuTynKEo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzuz936Zf4U6Tfel7RQOFVmVyUUjLUd5qmqSmhj9GRGqg&oe=69AC2A75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CufL1tff4-4Q7kNvwFvvQmm&_nc_oc=AdnBcybb2AkgI_9vQYQBkuuPmucQssyrHwcFs4IoL1EWSZQW6XxO4RSFIx1F1aVMGw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0rlPhZDvYtAYXNdtazaTr-W7f8HU8kPxbrVOeCmS6CA&oe=69AC1B9F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
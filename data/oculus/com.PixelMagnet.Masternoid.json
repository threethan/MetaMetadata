&_nc_ss=7f20f&oh=00_Af__DmzukPGymaZbm-MYkvcOpUSOpp9bg3jDG5QCITjlDA&oe=6A26DCF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23AHCDZ3MsMQ7kNvwGFJssn&_nc_oc=AdrzAv7eGNnEIAlUaBQzJBiixobgLpIsI2obW-6A0VP2ZE_20UbjB07R8sXfJcz6tG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WRob0cJiqR-1waHXWdI4zrpPvlI_UaqTut-QIbNhjrA&oe=6A26C72E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSJ1_7hvZFEQ7kNvwGRxwFM&_nc_oc=AdqWUKvyebHsNIGSrFey8yGz9ax-trm_Sf2JLlkUbELlQmSslqG4s4v9ZO6JSJhgXPQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9av5IjhbJPqRllFVXTo_O2aiI8MUZXP2xzGvEuRwvq2g&oe=6A26BBA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9kY5dlts4sQ7kNvwE78gBl&_nc_oc=Ado2oKIvFqOHbA0oNun5Z5YDTsobl8KeyHRmev164L6u64LAwiu0TosLJhneTSbnk9k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_COqGiBYEa0JOPxON5c86iRKyJqQZiuRCniLNqDYQWrg&oe=6A26C5F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrFhRCOU7IoQ7kNvwE4j6Su&_nc_oc=AdrwozLOj7J7o8Gi0uiQua5muPyK6zYPfs-5eEFqhhhgBGkQ8StSZXd_Oon3K9I0JV8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E4Hn0-WR35OEukIQNuP1d8xnst6oaUR5nWhkCUjpzFg&oe=6A26EF5F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
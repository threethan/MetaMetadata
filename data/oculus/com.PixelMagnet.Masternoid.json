&_nc_ss=7f20f&oh=00_Af7xDXcR2NFESK_WNOCByiR11QaOX0xa4r-6Xe3Fgx43EQ&oe=6A0DD076"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwNY8KxigQsQ7kNvwG9Vb0O&_nc_oc=AdopOUbyAN0ZjAj2Vgn3EmzhpBrEc4NQA5-kjAYTBvbzuW_igNE2MKMUjta0LK9EhNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sFyK6LNcZa97EeJbmnJsQQt19OvDomz7A48i1JAkx8w&oe=6A0DBAAE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUgD2GxojLsQ7kNvwFdJJlw&_nc_oc=Adr3tsqXI2Mj9-s3uSpTKYXpKkHxMtIg8WKfLdZBXiMs19NLVUmvBSqYpl7OZTG9So4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VoXJtVj6gKpnvjVhsCgLv8yhg81LpNp2FZVQ_VOOdkg&oe=6A0DAF28"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orpk4SMAmK0Q7kNvwG9GGve&_nc_oc=AdozdTw_FAB-8iDr8iStYe2kFbmlcCMglGfo4rIuoZH_yTa2rwsFLOBVoS5w47D74vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PJRbPEZy3EwrXO-ABK1URjMytrWbcKpe8qbd757qOWQ&oe=6A0DB975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt1bbOSrjb8Q7kNvwEkSHkf&_nc_oc=AdqOjoQGIC6HxySa9mEdJkkoGDjSGlOjKCejXBaQnBdFfE82rcXe6W47FnxS7cj7m8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aBPRvMMXFtPUbFc-nhYqQJFndfRAbZBX-CeP-7KjI2Q&oe=6A0DAA9F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
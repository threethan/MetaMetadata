&_nc_ss=7f20f&oh=00_Af2D0AhYDSFiINn_jCqT7Ld8_4TPH1rn970tRGc8NPnmZA&oe=69F61576"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Paxl8Ups7j0Q7kNvwGh15E8&_nc_oc=AdpaVDEuc7uIQwHWGGplSY00bjETjdQS9-SReCeQTHcRgt_uYt69-L_b8GZQnYttozk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3g4k7WOaP_ay8qsvAMeLD-o2cNBcNf5hEdixPTwHyUXg&oe=69F5FFAE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efkepESIWzwQ7kNvwHLmtDW&_nc_oc=Adq2IlFbZHcUQrtK3m6fViNb9cw0EGfTlGeqtbhb4GdRu-Pe3otPK2mjWtZiLxRWBso&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NksPh3ROk88N18Jsb8mUkqGlg_ZaVqX5PUXh_LLfPsw&oe=69F5F428"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EnExH9RtJcQ7kNvwHdFAG8&_nc_oc=Adpwt43OtiN_VPGX-3g9575Dc_xuuqrS0a-ppY2cZUnS6gABywzMiz5Odc5Gamcn1eE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xzghCeUDw7y87uEEqs29jj7JvJRlEpDxezgTOD22wUQ&oe=69F5FE75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4reep8fmDrAQ7kNvwFPRjpS&_nc_oc=AdpX68hcEOgSJZsambIjZ88TgguorLgRjpw64jQIw9d3iAPQMWv2V_z1JT3soc7BLxI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30Ea2FeKbaThPY1qZWddoGZU9DSL6T5YMj9pddHg5mPQ&oe=69F5EF9F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
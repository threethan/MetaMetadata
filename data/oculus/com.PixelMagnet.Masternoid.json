4824_515696533404825_1528446457997843684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir54H2j8xtsQ7kNvwGDPko_&_nc_oc=Ado8eLlrBdFfPSavgWz0C2E1fdMhIok8kjKMNduXMpNZEWlu9lZLt-Jb2Yxpt-ybvdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMzla2yLXUEeiyUMpPYCqmRbXXLSuCrMmlgevHu0llgA&oe=6ABE8AE2"}, {"file_name": "Screenshot4Store.png", "id": "714944692850983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031599_714944696184316_682281266916949772_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqIUCrLQe-4Q7kNvwH_4YYd&_nc_oc=AdqDfJ4HS84iaZCXGAICngTW-7s0K-YX1YdB6Uf1T3cqiG4CysWooycyrhZ7pINZ5sY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-CEQHLpftGW6NYSRw6B_3saNmRrxfTarFrW1864d4nA&oe=6ABE574F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoLayeredFullRes.png", "id": "717938162539078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_717938165872411_4984458671277444646_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhaT14nKDUkQ7kNvwFTgAgW&_nc_oc=AdoLwgQrtmYKMriBMs_0VMjvHErfoCYh-oHbh9MMq1qUQSBY6C8le2HtmiYLOVaiVs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_TQv041PinhJeJgXGR4-dwlyUe_fwmZkMhhzEaBJA2w&oe=6ABE6C9D"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of
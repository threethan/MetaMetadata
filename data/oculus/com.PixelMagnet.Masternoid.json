_nc_ss=7a30f&oh=00_Af2TiWZ_oD6KiIJ87l8Tf1HN-lu6zyTd7SXlTpC5swz_tg&oe=69D78AB6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aqVB8804gAQ7kNvwGwF2n9&_nc_oc=AdoIllVdLffEO0ew1jHPyQYqjzIZGNdRRcHYzAXxUxY28w0Mud8VzNkhccF-PsNeIjw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ITHQdTdkL3bPo89IMGaJW5orZMyvWtVlYvxQvorUMwA&oe=69D7AD2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYH6T54wo9MQ7kNvwGlc1DI&_nc_oc=AdotfTx9VFKzVGRud-uvlpOd6RvGi-epjC80EqthU77hyBbNRsC-vBxCKLmHBo4jgsM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af157luIbsJ63ziTWxwzFiOkbqVh80RewveATPiTpLLiOg&oe=69D7A1A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCT7BTDBTngQ7kNvwGww61y&_nc_oc=AdrTzWfP67NbB45EtNF3Ye7T8X-r1am7ItkrI5mvZ5kXL6dvuauOASshR0dyg-AGyvU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1voQZbXKG4QGjbxABuRC7mHlxO6Nj0nJ0tiwuXhNp44g&oe=69D7ABF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjjTojhkldsQ7kNvwFjG9uT&_nc_oc=Adoz22ttQ1-T5Ymx6YKzV0M1y4egMeEaEoXiJTno-J_q_EnZafT7rNDyepZnr6xdvm0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20ZcBEW2O1CWrZfbSC0DIb5noGB-LlBd7kjlSHqzJPkw&oe=69D79D1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
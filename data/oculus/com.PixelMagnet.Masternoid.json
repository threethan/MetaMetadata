&_nc_ss=7f20f&oh=00_Af6SzdV5YYZOG64gIswvZ5uhZ_lzqAOl16DgjzPwUhwLwA&oe=6A170AF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grIn2nAUZ8cQ7kNvwHrQ5Ey&_nc_oc=Ado9e0tQliqizWLio-lrXK6md8CVE9MXshQ9L5ykZkngNH-jfXiF-a-K4GnWyFtfVBw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aEPXSOWXSGZ8tuaUrj1tgUXGh7KDtbiDtGcIV0dJYYQ&oe=6A16F52E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG548QCOzU0Q7kNvwHM1JPR&_nc_oc=AdpF0O-9TaAkaMOFcFewo7l1gHrEyGRjVsudNPRFwFUTY27YWKF3TObR8Hk3aWl51Qs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DhIPmpeUix7QC_WyWjgaZ_8us_nx-k1TgM4gYrkRbhw&oe=6A16E9A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcfX9e4YEb0Q7kNvwEXFT4o&_nc_oc=AdouH91i2F5K4HjmfK6ys09YMFXGP_LTM5017Kza7-I0olRAbhqUn175ZoAyHkKfwWg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Po0vmHBpoFuTS3o5pPLivZWpUdEcMz21nRNcmZCg_YA&oe=6A16F3F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHXqwky_X84Q7kNvwHaGCs-&_nc_oc=AdqdsBLbxQaEWaqqKycPq8hkUIjGcxVGYPDCktdYyes3UAV-fNh8V8QPxgFXIWmBNiM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D41QbUH-RXLgVT2kD-lJ_K_smBDoB9cxc6v6mG4O19Q&oe=6A16E51F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
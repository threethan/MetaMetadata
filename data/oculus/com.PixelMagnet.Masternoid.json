&_nc_ss=7f20f&oh=00_Af8vc_e7jGWK5E6v-oGOKYX8_8E5FbEP1zW0b4xM594UYA&oe=6A2C22F6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk3IEAoCP9EQ7kNvwE8t59e&_nc_oc=AdpB0P7dC_yBpEv21oYw-aVa9AqH62616fCNwRG5QO1SNrg2rsPFkRMQ4Z2LZ1WpMrE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pei_gv3KSyAxtdffdFpVQkFPE-rkGIDwniL5DBB9Gsw&oe=6A2C0D2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6Bu8Tcsf9kQ7kNvwECuxRE&_nc_oc=AdqTkp8aqSy7Ze6DbzYch_6ZhksgB_S7Q_eanb-JmRXawOCr3Ohe-w8RD_OE7XMAtgE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_aNe_42oFHcACExnyvfQEhQsQb_8tbNl9nSL6FqKF3g&oe=6A2C01A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SAdWj5hgpcQ7kNvwELaps7&_nc_oc=AdoSfk5LM7_vNpOus1O9g7ruv8bTUvXcpqtxfO_d_IR9SuEiA5sgxxEMT0VZZy4hH_U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gEEdrZjoisBOpf2xQa-2NhwvMjbIM-C90xh4tONUmhw&oe=6A2C0BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d50SHGxjy9IQ7kNvwG_FBbh&_nc_oc=Adp5U_hbmb9BtqtoU1M-igj_qRKlv0SJ-tVTZfILTVF26apa_0tR0vmvdhjWHqHCHEQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4PGIPEipCZn58QwN0k8A1vrfhtWR5ImpnqNQIv2MnDA&oe=6A2C355F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
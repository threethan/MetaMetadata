wTZHxWutRvG-g&oe=6AB5292E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-Wl_IDplfsQ7kNvwEmVJp2&_nc_oc=AdoGTC70Vi1QZvXWs7ys8l6uC5NP8cAkEDP-iug0j0hgGKczBf4V2IZ7OAkee_reHC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWuAR7y_UnqfidNITs8jtFmu5toptm_BdtbQ4IMcrYAg&oe=6AB51DA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4abT1PXig4Q7kNvwHJMOTe&_nc_oc=AdrctF56ZpxcCwckApUZyJPOxyc5Ih3Rw78C8FrEDB05mL9NMUf0hIrGWBoghaZD7Yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJUJ510Vkh4KReUng2BUlwE8IO9X11O0NBvW_uP1hDyQ&oe=6AB527F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKfTPsHK8pAQ7kNvwH_aE_-&_nc_oc=AdoNedaBkfCBOJay7fPpHoaEh0h58c3nK3fYGdmzk8bCX0vktptI8Y91Z8z0KBIp9n8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbW6uJZKG2THRypShtvVFOp_jvY_OZid9XsyJpxZUyKA&oe=6AB5191F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36206740455638925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031384_957167355544112_6462924691106208595_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=
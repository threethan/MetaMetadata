Ekl7A_DNZNVKqEz_0JiRqwULSZCRpmd6w&oe=69AAB7B6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_K3UzGZqSgQ7kNvwHgHCnP&_nc_oc=Adld1z-YJYDqNV7YILiKWKdCtgYnq1ILXfEPCb7Uh81kXX32iEQPjGJvoXOwP2FVEKg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqW1GP70i2YvESd1nEZPb1fozV1B_wobzEtr3ORotWBg&oe=69AADA2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLLA6Bsz81YQ7kNvwHP-SGG&_nc_oc=AdmfTwtRlsUmxsgz_VIRXpzrwtPjzSf9ssKvXsdOHnS7f9iGckMTSYYneY6Fr3UnlvA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAcFQsHd6iFy0zIaxwRRliUrYoJSs-fEkh5P1zQazzdg&oe=69AACEA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf3gtJSH6fAQ7kNvwHTfJXR&_nc_oc=AdnNYhnkQnjCGm0d7eOA9Sg-e74X6EkOicxdJCdvmu_7mYdicGCytSVW27YW5519mII&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyqcUGQBy7eflFsTtYApmS61KEXjcXQSGghk20u81tD3Q&oe=69AAD8F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CufL1tff4-4Q7kNvwEzYJTh&_nc_oc=Adk46tLirsDcSQr8wdWXuG6YKClS7W1Y1wRl9oZ_Oy1cehzHk0OnlUtV5DrctEALraI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbAOdgLj8al-tQtjsb1CpeNnGrIX3RzJJFHypgNylnGw&oe=69AACA1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
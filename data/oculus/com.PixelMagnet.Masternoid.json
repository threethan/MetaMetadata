&_nc_ss=7f20f&oh=00_Af_NkJngkhu6cvE0_QRAP-l0KSYOvn7IPlm5ky34mCZsTg&oe=6A2196F6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJTd2PVOr-kQ7kNvwG0yU_i&_nc_oc=AdoYVL5oinFX615Aixm1zJkT2yMmN6TXlUX5fCN0tXW7Kx6QDOTPoDvD1poNZQEP9UM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rc3HAah6-E8NduSN1EskA-5qk2_0d0HnLEUn5lTXGOA&oe=6A21812E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQwiYZcFNAQQ7kNvwG5xVRy&_nc_oc=AdrOUYL5wez59qjcEjVy5uY3_pzAaU-28b0KC3y4ba0UQXIZBAVjL7ANPo9wyJnFXZQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EYw5ysxF8Re_RLwWJlFnd_gIYcE5TeC0ya73SA6YfVg&oe=6A2175A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioou_az19R8Q7kNvwH8Dh1P&_nc_oc=Adq7WGtZEAV_MaG7B2n-0x91DZxTfwejeMOfRDDh1Jj0Co8DVnS-ZRkmGGY11UN2zkk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LWGg0XlCnawGAZvjS-23JxZFwXLy4f5efkmKzFqkyJA&oe=6A217FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PEw5zP94K8Q7kNvwGbVIGf&_nc_oc=AdpnPxUmBIjoBBfSwlqmPYW33G-zBagoXvqIzUCzW6eno2kRadsGZ0Se9HjSpKayhp4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oyMEkjY1TAQriP-2h4BOLS-sXYj1KSVruFEa8VPuJjQ&oe=6A21711F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
&_nc_ss=7f20f&oh=00_Af7Qw2_ueX3Iklkrl5SJ8YnTVGA_hO0SU1u5-YjEbUQfAw&oe=6A05E776"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qtusm_JR4sQ7kNvwE51DiG&_nc_oc=Adr11WuJO_moOLG8Mw0AbTk7WqGdI5WEZ356emS6w8A9eDb9wG0Qrrs8p3YaaXJoNtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p93uBOkh3U2arBvOL2rmjaUWgFL6KRAEVOoX-pDb0ig&oe=6A05D1AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=834WBXomsvcQ7kNvwFeaoEP&_nc_oc=AdrMzphiqggrxZsB4iudkEae-et_vck0chpmi88wY2mSeiSttBcSB1yXoB3J1K1xO_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AavvlCcaSkOswX3R2oM1o3Go9TazjqLM2KjvVxlYLig&oe=6A05C628"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TgDawDFx3gQ7kNvwGqSDNa&_nc_oc=AdoTRtsuUcKpvO27U5UkhthMXQlkd7DWVrW5TlqZgo5bHvaqmScuGrOagz2fpAosa9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4roUDkfrA-OY1X6TmQA20iI-O8tGCuB8rMnEygwME6Ew&oe=6A05D075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo6TR_3Ap8UQ7kNvwEO-69Z&_nc_oc=AdqSYjKnGnDbmZlgRUrxHq14DH3K2BaEuKLEhlA9BWVOFIu7FRn6dhS7a1CgdG3PV7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53_mM6rjEsns7yIc38yjSmwZyPbQ2TklnVk7C1LB4mqQ&oe=6A05C19F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
er4TwhbFMxzGFdvhhVzLP7yzoJMxQ&oe=69AD5AB6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_K3UzGZqSgQ7kNvwGQVkD9&_nc_oc=AdnfbUy9sHL5kkiSd8pRlygARqdfwpWRa9xJpQCxrT-bRn3XQoP2IbGxQcSncMDGDMA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzp7VkCKuZinlBxTXs7Nm--O_hFkNYXSUTWUJ3Se_BJ9g&oe=69AD7D2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iez-6Kofn2sQ7kNvwG1xbSA&_nc_oc=AdneRMu8Trqw7retribqEkjTGFfcsNNPGRf3-2j1nfO18ZsZ1kvcpXesZBTrxaZ0Ve0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwld3Hqx-oiPTdSvojKUPgqzFpw6KBG-Uup25VEj5qxAQ&oe=69AD71A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex0G74bHZQUQ7kNvwEY6wRb&_nc_oc=AdlFl2chaqUpYkyyTJsDQch5zNfcKQxj8KTY_WCE5BLWlS5fm7xd4mVwdC2NI0Mu5dk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrmNIZKXwLBS1LYmZYkWA61pMbsYE7viy-A7QAv3Rpcw&oe=69AD7BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6bE8qfFumYQ7kNvwE4qyQX&_nc_oc=Adkom7RVe0HrRaC1_zW6UKGZrx4zMe33v4_jRtGbtIibfoUb8Krmqh5nJ9l9eeMqOAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmMpLL8g8ppW5lOvZQGPYo4l1YMMCn66kTmPAU3o7PAQ&oe=69AD6D1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
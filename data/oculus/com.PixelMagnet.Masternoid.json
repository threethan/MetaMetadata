4824_515696533404825_1528446457997843684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99s1jhT7STMQ7kNvwFDf_oS&_nc_oc=AdoypVayLS0N3sxePb3K3MRFv7vWG-x5xfxB5yblvVYJo-hh3PuTDHKuC5Z_KS7ODyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrI6LLGNcQ5SJb4snU5XklzAIlCmwPtt1c7zJDv5IQ0A&oe=6A5E1522"}, {"file_name": "Screenshot4Store.png", "id": "714944692850983", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031599_714944696184316_682281266916949772_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_e9BTaA9gwQ7kNvwF85afz&_nc_oc=AdrMeeKQq2NfPALKc8MGtM42PvohLyQmOIi4ULT5Lj3M19bCkTyyrKPrGjZWmpmv1aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy4796Dp3oeP1h9SD-yI1rz24vTa9uodLJzoUtbt8Xfg&oe=6A5E19CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoLayeredFullRes.png", "id": "717938162539078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974798_717938165872411_4984458671277444646_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up_blNycXScQ7kNvwEmKPh8&_nc_oc=AdpifeQU5ubBWoF01A5TKI1gW26cIxDyYUyDHeowb5x4wjheR_5aUafUTRSLh2UDFa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrvGdet3xKKQ2B5wTIGK5oIMx8U8IHYBbc76oDcEULRA&oe=6A5E2F1D"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of
&_nc_ss=7a30f&oh=00_Af26g2C2hegd_wVbsYhC3xgqnkCZycVHEPvJ6Vny0ReTtg&oe=69E75CB6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf3eSvwDQYgQ7kNvwFaTQ6C&_nc_oc=AdrD1meYL6XFFMTiu6iG_ZsoAPAQwuswRLbZzlGSqSdZXexYRJP3NYtUWKbbLv2kHb8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g0ERpB98zg4dIZzKEagh0ZY4aZs7wsg1E4SVuFST0mA&oe=69E77F2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FyFHJ2TTL4Q7kNvwHKNxMQ&_nc_oc=AdplkecsGA6w23P_zBwKPsOzXiGTmGbZMSduitKYoj5Mr9X46P2TmstxcoLBqaj7sy0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YxSUplDNmLrDu5RNgh1ufAx7dq07lOU5O37eCHNefbw&oe=69E773A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-B-M-IrKxMQ7kNvwHOFhR6&_nc_oc=AdpmuCEaK_GdQqTb63WL0_SlF1Uv887UfcDHN7FxEZqX5_-xflx-3xfHlGrKjdMEISM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f31NNHC0CVxAtRw0hkLxIBsLWFXItizuIX9iJGvxfow&oe=69E77DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG432ACWZA4Q7kNvwG_t8Jh&_nc_oc=AdopD7jFTpjFmGnHAL-YwJvCNO_01-xoGC6XTNDw84EXC6ybBXTI7tB-rLtYhbEhYmU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VXmb9WeD8FvW16pk1r7y-ozg5k2kNWLAhk0aPkSJPQQ&oe=69E76F1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
&_nc_ss=7f20f&oh=00_Af6Tdw4KEL2LWns0UszSLkwBzlS2zCl-y89YkqR_Vacx5w&oe=6A0C7EF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwNY8KxigQsQ7kNvwHCn99M&_nc_oc=Adr0lhVuTgyCIpx3YRFJPLCB9FyCudGWKlKQ1YVyncbsjrTi5DUg8Wg2xQNrQWkh8o0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XBxyL8oCugH_rOfY1pwLEGD2_-J4RYM5bKRkTY75DLA&oe=6A0C692E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUgD2GxojLsQ7kNvwHbePlx&_nc_oc=AdrV1qfy-bU4PqczuQrvXlfK7e5cSkFpMn1SFXyQuk0GXNxHZmTiEX0XHQHB2TPAIRo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l8kGjvm_Fu6fBC15H-emXMhH1E5ubl3vLsf63T_wUDA&oe=6A0C5DA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orpk4SMAmK0Q7kNvwF7kDC6&_nc_oc=AdrfdkJE93XZDiAceRcXbtZLTAvilMFoniWh62Y4bzP1wuQMNosPJvYIaeq8v3rYUgQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VTVdKNU5K1g70laK5kdaSGJzJV8-ohPhNQkh7gE1mfg&oe=6A0C67F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt1bbOSrjb8Q7kNvwFJEO64&_nc_oc=AdpyScGWMXg9ABFzQ8KH4vxRJRO1lN1U4hj-s5M7G_wGBbJYe3xV-npzCHaBN2JyLWU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rwWcClAHR4ndeNVWDW6ze8ZIRnah5ezySYwlgLHnGIg&oe=6A0C591F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
4824_515696533404825_1528446457997843684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIfkJju72-oQ7kNvwGBb9j4&_nc_oc=Adqx26txqbAaFpWJAuygKAcwm1FI-7PoU-vvRLv3Ns72V7M1U5Z6Rhdl0WXVPKCxyHM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UsAQodEOZ6S875Xn_ZaBqSzguWL6QkrQpvwhCg1d-VQ&oe=6A3293A2"}, {"file_name": "Screenshot4Store.png", "id": "714944692850983", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031599_714944696184316_682281266916949772_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGgiGGMkaJ0Q7kNvwHvctWL&_nc_oc=AdpTuc7a2YoWhfPRUTXfHpMGlmhtgVPooj1ta_y4_7K7zT03WLKN9uAwITDgqbamD9s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z9GHE0u-8eMXS95t9Ajr1IfDHtzSFUdXnOyb-o1aFcQ&oe=6A32984F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoLayeredFullRes.png", "id": "717938162539078", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974798_717938165872411_4984458671277444646_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXBA9ZIXmqUQ7kNvwFGtrE1&_nc_oc=Adqel8IZY9zncZgy2AeuNtK935E-2n1Ghzri4S8ZPeUNu8ggRUjA5rtiR0j18fHjEtU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qPuW38KGK9kY0shmJx8EJv2iinl_xyTNN1OajfKF9yA&oe=6A32AD9D"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of
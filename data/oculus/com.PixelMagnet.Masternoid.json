&_nc_ss=7f20f&oh=00_Af4bJPAWbGrMVjAJClImsLPtP-h0NwzvTKAwcqvWKUOQWA&oe=6A0495F6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8-Xsa62IhEQ7kNvwERr2Vc&_nc_oc=AdqtGojX9bWITExCOcyPm0QyZCBE0Hf2TuSvmtEd1o7GhW9cApFWZ7ieByCmkOrHs_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BEnc4tpbXLTl3AvqytbI-JjOltN_0SL6K9aieAU0Brw&oe=6A04802E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=834WBXomsvcQ7kNvwF7lLUX&_nc_oc=Adon8TugypLEJ5gfANquNMw9lWbsLUcd0UCZ16uWmGAfOjRStYtlHFeuZJxu6Gkj_ZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4brG07fVqrJjyZG0jQLXpD2FO1L-2o3kkNBUHrUt01ew&oe=6A0474A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TgDawDFx3gQ7kNvwGSUJTh&_nc_oc=AdoJJu4zW9tYgsn854-vOUQ0-ItjEE3BSrmO-K6jMHFcS-8cZqwxDKEJnyp5KItJmC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Azaxyl-I5aeFMY4JSYL-4UmQHBgPRne5O5JIW_xLajQ&oe=6A047EF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo6TR_3Ap8UQ7kNvwERcTJ_&_nc_oc=AdrPbgPn7SkvIP0kYeYv0A44wEfxsgK12Kp3KBuZt1b988MQkErEtKTYJkYX23fQlLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dHHCOEaiZMV-V3iU_n18skNL9GTX9S0tjscA__1ooMw&oe=6A04701F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
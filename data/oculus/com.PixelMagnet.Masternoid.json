&_nc_ss=7f20f&oh=00_Af5dR106MIsXlA6NvAvbzCQ5n-9-HH2lhObqrj1I65-sMA&oe=6A09DBF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlPJbUOoGVAQ7kNvwEyMGtw&_nc_oc=AdpQTWFkZZzoMpxHLGLS_CzVJcfStgImHgZUW7oMUcE4uAe1fi2uPDxNoimyjujti6A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wAVFxhU1-2zfV6otBcZ0AHcb9ozaAqerYSZ0dyYGAsQ&oe=6A09C62E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd7uwWNnpn4Q7kNvwG7SZHn&_nc_oc=AdraXgjl5AgbGZdx2bQYknP9dSMEgQzagTFKr0lDzK7Zq9bJDr_0k3Kf2tJLSgNgm50&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68Cv8rT9fKt3UeII3MJycwqa2klOB0H-p0iJ3k_f2P7w&oe=6A09BAA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXMulFQkRPwQ7kNvwGUu6wS&_nc_oc=AdrjifUAE4oh-CN2EuvmP0C728-YFBF1cz6QDSErZDXJgrZYTM9B0qCzl-mDS1qdHFQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6evOE1AIW_vSRUKzE___qDe-ZbEJUqsxKTzRKy4vjXbg&oe=6A09C4F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l8HARlaaHwQ7kNvwGuGktW&_nc_oc=AdqFRe2YZ1xYARiePR58A7y3MHM-OMNoe3zuiN7tffgP0DAmUpYfbNl6pUjl5AHVHs8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V6X8-4Vl-YovV26u4rjrHvncadGOHNC5k54_LVplyTw&oe=6A09B61F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
&_nc_ss=7f20f&oh=00_Af74gY67QjAwdeZ3NBurmA_9ycEcBbAG_cUa92im106sNg&oe=69FF4FF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLq0TUZ6toAQ7kNvwEt3Mt3&_nc_oc=Ado9ZVAJI8oCtpzplupyjKfBci8MVxOMrrNKfBY0ZwjIsnJavm7dZWot9QkyXglfMJk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FlTWTwo5km2e4eonFYJT7QrGBvgtp5qZn26KE9sj54Q&oe=69FF3A2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGgEuKB9yFwQ7kNvwETk3fB&_nc_oc=AdoSx2GEVZCMyTvjOuPjxJvGKGOfBkSz91FtUAQ22PPT9DzmDfKh3xg8W7aYWOgMyYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ucfQW3UnhYtCtYaO_LWxiO0WPwk6mnenfK7Urox0JtA&oe=69FF2EA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKekKRjLknYQ7kNvwH1hq4z&_nc_oc=AdoFcz6_y6WJ__nJdh7LcpeA-312AjS2-HkjMAPPPAzs-5k1obQsNs1xsBYjxMkhKJk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f6iiGZ5UL0ZtnECRXYegW9l1HjvCnyjtQE4yRNN-D_A&oe=69FF38F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGMh_TCpvmYQ7kNvwFE_Y2s&_nc_oc=AdrWCtGr6AQp1Wd5b5k5Man5XuKCMAMHDau7u-NN4kY4NEKqFoNdxET1LVPMO5JRdZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iyqfuM5r-l4LOd3Uzftx7WzQ2gLpyHwZ4XxqLJtpF4Q&oe=69FF2A1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
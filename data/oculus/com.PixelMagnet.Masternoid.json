&_nc_ss=7f20f&oh=00_Af7TVXk9vYDBE8iGzWrOco_rdmzbYkPIy4t_ojQnPs3NKQ&oe=69FCACF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLq0TUZ6toAQ7kNvwEJkP4W&_nc_oc=AdoRDo6tRKXxx7b3WEjONbkonOwMQz_6HS428o46VrjeJ8TIVNLwbzkuIJwWOC3w4Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vbWB7Hw0qxJZJcXXoXoLMF4M58ZWRFffN-p1Se022aQ&oe=69FC972E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGgEuKB9yFwQ7kNvwHBzzMC&_nc_oc=AdpIzqr-MjIkLtAYq5Wp0jAVBlVvKX6yWOAUwDl9YYDuXNC0jwowRmHMHN-fdCxZnJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43saQuu-_1-uBM3IUKzWsO1FFr_nP4pbEzhaF-gg7fbQ&oe=69FC8BA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKekKRjLknYQ7kNvwH2j-vG&_nc_oc=AdpkCXckCWZxWREMUMrOwPmqRz3Soqyobw_5pFUgPk0VKQYEfE0VFLwIfngFdpJY2aA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GHTXBoqjHpZHSLj1zwFeK8tLOH_6Bdvn1lLFUYNQSKg&oe=69FC95F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGMh_TCpvmYQ7kNvwEFaJYU&_nc_oc=AdrPrt5zo2ljJuK1eFINo_FCmQ6dq-gA1LL79e1VF74JAsaMqz3etXpm7QgAIohLTyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LpmLH8D9nPZklS2WHknLTFxcd4XIl97_g3MR6wbJz8g&oe=69FC871F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
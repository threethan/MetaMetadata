&_nc_ss=7f20f&oh=00_Af2sO_X_xl1NJSXcpTSX7TyaLxwg01ZbvOoL-XWXFAcu9A&oe=69EF7DF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7QLXlK2d5AQ7kNvwFHDpAW&_nc_oc=Adp2J6qKsuakTsrmSVhZf2pCzJ1LWtgyZIVuP8SYobLpvQ6Dx-ZWvWxyAhO4YmlgieY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3skH-P3og-c_tuyKnhRlHOiqw4typYqTKbhYsFSwudYA&oe=69EF682E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fFpvs477OoQ7kNvwEaLH7U&_nc_oc=Adp_qnIfGFcWe0Yo4sENmGdDPRJ9JxS8UM4AQnmhXlU1qGajsf1ehatIojDdVUcQZcY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KVTw4Ov0OELhwRbp81RfPm96wOKakl8XU6XsQamMATg&oe=69EF5CA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrhKMMUYwI0Q7kNvwHrn4bV&_nc_oc=AdqTubaiRR_dmCJ2_Xxk4GgCYlNFSoaQKNBht_T-ZeQW3g4-V8D4IZ-YDxbS9eK-QAE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BKd0GHTptVEKyAGtKDsHq-cMFlngzseTUZ7LAca86VA&oe=69EF66F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJRroCksZOAQ7kNvwFE-lfp&_nc_oc=AdoWkuYN_4hYEZgz2_pVG5K0VrQaSlSlZC8FISSZhG_3htxMgKsDrQ2gTZb4qpT_LY4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HRYyVXerOhyv_1m5k87RrUSYZfm8NYTx-R6beGvUbnA&oe=69EF581F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
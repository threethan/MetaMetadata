965926654455546", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEWU3_XNSVMQ7kNvwHcONfr&_nc_oc=AdmjIpepGO3pgFa7rjpYiADQ9Vqtx2t7SUQLdcij8t5tsp_lKRZuf8NcovpUkswTVsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0BzA5kib5pYZV5lJQCNK7gNwXPvDLtlOi0d9IfFEW3Q&oe=69A2F12E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uaqe3PHTI6kQ7kNvwHwrPQp&_nc_oc=AdlW6JjBVrgAgbigO8xVgPfpQQxGgy3Cm1W23VY3flro0algLMn_E5pcyAgE5arydok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftzGusXdwVQhOyN30_-dLwVu21mbwzItxNwt3pGR_kNrg&oe=69A2E5A8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFLvEx5SZdsQ7kNvwFFtrUT&_nc_oc=AdmEngApeBGQjJtMmgWo6L4-3nswrYBdv65331owK_XSjezf7rbyB_fNrVEAozMqDAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuueTmm8qUVu2zXptq717Ix-i6VBRKFYrfAVW6Xx1PMtw&oe=69A2EFF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWEx6UM_aEYQ7kNvwEtas4W&_nc_oc=Adn-w0cEaJ28TB6vy488WCbhb1O-Yb6SLEqRYC117P1y0yCh3ucyKOAJYKIKwpZaKmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvTB2vUf2YPOvYmZjtqsAK9pQBtAvhIQ-WycIeAsnjzKA&oe=69A2E11F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
&_nc_ss=7f20f&oh=00_Af6FX0T0bBoBTfhWzqvSMK0Fn6sWol62BA52K-Znb8dayQ&oe=6A1AFF76"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTo35b3Kb9gQ7kNvwFaECY8&_nc_oc=AdrXWcHwwvAowctb34MAJCwQ_wHvL7e0VI2IqzH5BeqnO_JXBu9bfGg4sMMfv8APfBA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OmINW6wYyIE6Tc26E7thBrIF_ImrnpOL1vMTgr4uY6Q&oe=6A1AE9AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMxaX8Xq2dUQ7kNvwEbOKBd&_nc_oc=Adp7cCLqYI0YbVr_w-Vxk-RZ94QX9mX6UI96nDec0CfizLKC1dTOqpCOmq7NJ3mhKnw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zumFejg_gmBDq40yuYAXpFkZJXHrzRuddRhsmGGkQEg&oe=6A1ADE28"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TugYK0Z8w7IQ7kNvwEJZFdQ&_nc_oc=AdoisJ2_7TaDbEaMptFVivQ2BzqJUjsNaLxxImd07XbXWYWcUIso9PLH852rfNjeHAw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zbqwS2HrE16m1TomDqRKV5N3ydQmKkifeit7mMw0aqw&oe=6A1AE875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAnyli1VTEQQ7kNvwFuGdya&_nc_oc=AdoVaQP7UlvZsEaMar3kOh042UHXaEY1bvxA1IomBmmr7wbrPjTfzuSWwPjCmnp8yjA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cDSHE3LEaxSsienSBd6kBqFxHQ7hcYCqK1YVkWob6pQ&oe=6A1AD99F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
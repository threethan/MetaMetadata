&_nc_ss=7f20f&oh=00_Af4dxlNRhgTPH8GEUOyGsuloOuy-nXxiE0rZtU_75BWvWQ&oe=6A1DA276"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaBzuUPdx1AQ7kNvwHrC9BD&_nc_oc=Adrnv0Mj5yYb3WQ-W5Q4WKSx9ltDBinu09-m0oel_1_pNaWzgZJtE-pPnkSmxQmcTmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bC4DPTjTXxIlD6YOT4jUFwVvvq1fjGGvUY2thMO06hg&oe=6A1D8CAE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phCGi_3n9EoQ7kNvwGHIFVX&_nc_oc=AdociidCZNZCyDSzHuEFog36QXHPHVZqtMnAroSSQ1T1IeR1y9ccSeFD_IDc7atOMUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HXUI-M71p7KnulSsW0ZosmvJaVUzfkCZh6NxrEFDtww&oe=6A1D8128"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYj3y1YfQ-AQ7kNvwGQgoTZ&_nc_oc=Adqm2z_yaSko0_k053qgp4vhpVItYZttBSibGJc_l_W0gQmH4j2kmKE6FrW-uEmS94A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ptOOA1ci3xtip67En2lwVTRqKGaZrs3eemvU2_DE8ow&oe=6A1D8B75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69DvUlSau9QQ7kNvwFWdAPP&_nc_oc=AdohV-nStq6SHJhKZ30MD3JWcdQem9AhNazXO73NXsSA6-_TnGU5wMJuwDbbRQTGbzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af698gIvUB1vLKxOxqT1SGeRR6MiEVSx0IfB8Myvllk_EQ&oe=6A1D7C9F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
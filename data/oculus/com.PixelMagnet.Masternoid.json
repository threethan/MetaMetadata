.com&_nc_ss=7f20f&oh=00_Af_qx4ry404tKvFVubZq2BiS2vjyrtUPCTQ6d41cUr3oEw&oe=6A22E876"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJTd2PVOr-kQ7kNvwFg0xF7&_nc_oc=AdoHIm-gS4uhYJSFP4fEWTk6htHEZkicSsLd00OkN_O_OCdHwPer1izbNOHwFK_mWRg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G2h6HMDQBHWnrSOldAn6CnUu3cVx6KcjuB9Je46z7NA&oe=6A22D2AE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQwiYZcFNAQQ7kNvwFfxUgv&_nc_oc=Adr-i6wE6Pt8ZuMwnSxpWAGynu7pggt53VcBvh4ymKkW5wDvByHk769qoFCAsrrFYYM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cvyNrpaT6-4GIT8U9PC5HAjV872j06U_6R-toynEMjw&oe=6A22FF68"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioou_az19R8Q7kNvwFcbF1-&_nc_oc=AdoigjMvWMnnORC0Yzn17JlRzvuKH5UJ027ymscY77UNFv_2CGSUhyEzBfWsDFZrcuo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pt6xCWowkFc82Z5wbSmNJONUlhf7WaWjOZ4yjsTG5ZA&oe=6A22D175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PEw5zP94K8Q7kNvwHOriBu&_nc_oc=AdrmwdtNtpeh2I5MoHwAaBop5SsrlXvzasmFP1owKs4EBisk79oAu2FH04EfCG_lolA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8byR7y9A0lPt_E5KkYuj2c6xrAxSSmIViJ7gjOspVGFw&oe=6A22FADF"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
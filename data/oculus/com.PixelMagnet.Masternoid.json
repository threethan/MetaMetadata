4824_515696533404825_1528446457997843684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mfRqViet9MQ7kNvwHw2JJZ&_nc_oc=Adr27KlDTp-ymFkrPagtYNY5mBrfxIKYB1X0YI7qPeUWdCzfHPRMLbcBmGb4WIC1y_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXI7740-p_PjrmdlsFEjQjeFnAgL8kl79bQNqxuWJ6oQ&oe=6AEB5DE2"}, {"file_name": "Screenshot4Store.png", "id": "714944692850983", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031599_714944696184316_682281266916949772_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVb1NCpSrJIQ7kNvwEf8_Gy&_nc_oc=AdoopwfjjqPTF0xQprO4dBdpw1jc6Hw_Gn7Jx0Bv5O2uhx3y_8kFu1rJYlXcqfLTrvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRdR57U3qXf_32Mqua74_jonnNV2z5k0NsNQwwyQDDxg&oe=6AEB628F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoLayeredFullRes.png", "id": "717938162539078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974798_717938165872411_4984458671277444646_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OueFIkhArJ0Q7kNvwGz1HNe&_nc_oc=Adqo1ubSDpfKiQgCKmj8m_IsdJZW0OsTHmMlCSxOtKKx3Mq6VSJrRq6PQfqRbI2hO0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXx_JJang0OwF-80Smmu2wBgF8qW49e5oPGynOO44ORQ&oe=6AEB3F9D"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of the leaderboards like a true arcade legend.\n\nYou can enjoy the game seated or standing, as minimal physical effort and space is required to play.\n\nYou only need one controller - right or left hand it is up to you - and one button to shoot and re-bounce the ball. ", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colorful world, embrace the meditative power of destruction and ascend to the top of
&_nc_ss=7f20f&oh=00_Af8jFE7pPz1gnv8gNMS9m46iXAgskL8DoyK_qW4z_X5g4w&oe=6A297FF6"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A93Kz9zm5MQ7kNvwFhMGSc&_nc_oc=Adq-19TDfFS-SKn7KZzjbTluYVwTwuu9-rVbQoVXHGUV1Ft9uDuSoOAq9HwXE6RXs8U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PW-NR6ismE6O9hUpXYZ_6aMERAqUcn1O_dS1LbaPSTA&oe=6A296A2E"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=920c4KROuoAQ7kNvwHZVNbY&_nc_oc=AdqpSH6h4mTV4Wy4ve4STb_Dhw-Iwnz7rrkaZqP79w0O7u_oW-MojnD_Z54LENsnzZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RwmumgYp1efkJWLgMufJ8OGYKPddYs5xz-Bi8OHTW5Q&oe=6A295EA8"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noLuMG02aYYQ7kNvwFAKZyV&_nc_oc=AdrQFWUWUGG6pkmmJbmFCydAjMdCMTcSic6mlJq4TyIpcKKgxMIyiji_XXkeVR81-H0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MLGX3Ge3edKMSXsmV8rmYafZBycVR1ZpoynI7pwnElQ&oe=6A2968F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqc6FxANQooQ7kNvwGRsIr1&_nc_oc=Adq3wOut3TkMumJOTqNd9up1S9H2XSjXeY2SsriyXoETeuPtVJnrYw-PlF0UUTgNro4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IFOrFrMTgg1729ueMj_bC5XZnzpFaRwmdz3r5VqSLWw&oe=6A295A1F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
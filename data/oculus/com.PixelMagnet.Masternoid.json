&_nc_ss=7f20f&oh=00_Af5SxfAC29H_KqR4jJfdajEVPORa40LIi305udtv03_aag&oe=6A204576"}, {"file_name": "03_1440.png", "id": "965926654455546", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982523_965926657788879_4357426596010336527_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJTd2PVOr-kQ7kNvwEIaOVb&_nc_oc=AdrR6kp1uztWgnSubNQ0w32Fp8EpkLYdW7k3Ie-mGd-kpvM3UqMoN7psD_pMyzGzK2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rwjX6KAtlCHW1iFe5vT0oAf420OA2vxO2ImMm3rn45Q&oe=6A202FAE"}, {"file_name": "04_1440.png", "id": "783955733361415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001680_783955740028081_7373359893076668593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQwiYZcFNAQQ7kNvwGAH7Mc&_nc_oc=AdoQSx9wMjEUOkOR6Sl0poBcSxE5Jd9acbLH0KTZgEBCaB8BrLN75E1u1DGSRQObLNY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IUEpdGs0otGSoHYVRzhSX2OXAdwJ1Soz0S-ieI7PZtg&oe=6A202428"}, {"file_name": "05_1440.png", "id": "6278120392269968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984466_6278120405603300_6768471527037336311_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioou_az19R8Q7kNvwHXyC8z&_nc_oc=AdpDypmLI0C7VnmFJ2aJYXixfJPeGvp91TXm223u-ECySD6HtB5eAf2P5FGgwwUFIl8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H3S6R0Cln5i5brZe_CzAqiS5FPm-OvSx3xrYnZFtq8w&oe=6A202E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Masternoid_CoverArt_3840x2160_Resized.png", "id": "696935008935394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036615_696935015602060_6147907796215355231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PEw5zP94K8Q7kNvwEusW_4&_nc_oc=AdqWCfohyuosOVtpHqZlHfDkp9L8eBAzZ2TQDGls0Gk480nm0hdUhuicIfjpLJ98pyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qZoTsqTtxEk8kt03Qen0hzZGBm5H0coju5NuCrB2oxw&oe=6A201F9F"}, "display_name": "Masternoid", "keywords": [], "long_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nMaster the art of destruction, in a place where your trusted energy wave blaster from the future is your only friend. Use it to telekinetically juggle multiple ultrasonic balls with great finesse and precision.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. \n\nPlay seated or standing, as minimal physical effort and space is expected. Just a single controller is required to play, right or left is up to you.", "short_description": "Masternoid is a pure arcade brick breaker, reimagined for the age of VR.\n\nImmerse yourself in a bright and colourful world and embrace the meditative power of coordinated voxel explosions. Followed by the sounds of an original soundtrack that adapts to gameplay and will keep you in your flow zone.\n\nBlast your way through 50 handcrafted levels of voxel goodness, and ascend to the top of the leaderboards like a true arcade legend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.masternoid.com/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Pixel Magnet", "support_website_url": null, "website_url": "https://masternoid.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
dH7CtpV5xFxJNgh29vfqFWvp8RAVydaOfTMQ&oe=6ABBCDD0"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9lZwemRNuYQ7kNvwENsoPt&_nc_oc=AdpzAvJJJwuatZgb1_Or2AaSYTnhiXxCA99_IvNj3XzilfCAnRgSHjKxnUDB2DBtj1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVlUu0Pxl0EJl8EIBvvNUA049Jg9in9IlgH8xN8uXPlw&oe=6ABBD366"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oGzj63KlgoQ7kNvwELqcW5&_nc_oc=AdqlC_-NrYq93cmshgbWTTlxd1mzmX4Is59tBhIJKEh9YStZ_ix-swB3-882aN933BI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXvmUroADbsqRaD0XOUD-i2eoDbqe19ACYeT70KJx6FQ&oe=6ABBB8C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY7aj_vQB_oQ7kNvwF6Gt_-&_nc_oc=Adpj11d9aoqDMDVOZ7dZzt7f1KNvAp8SCET8Z4TJbOsOopKMtSbntm9AVNMSOpC1UDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMGQ-43xsgTx4tNbc8rlg8ayL4YSm6uUy3we16j2q1ag&oe=6ABBB962"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout on Oculus Quest.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and our VR dance editor to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- VR Dance Editor\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- New futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout on Oculus Quest.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres, a VR dance editor to create your own moves and our hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/terms", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "345962100711073"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1818089436017861"}, {"status": "PUBLISHED", "id": "1046020444957466"}, {"status": "PUBLISHED", "id": "2204674600072803"}, {"status": "PUBLISHED", "id": "26413182848324032"}, {"status": "PUBLISHED", "id": "1401024441480582"}, {"status": "PUBLISHED", "id": "26
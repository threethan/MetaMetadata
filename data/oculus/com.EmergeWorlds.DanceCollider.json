6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lIcoOedugQQ7kNvwEOUylI&_nc_oc=Adq8A-XFZGHyDwpR0GWKLmwA0KAcL5Ho4FHHi-ciEUWVtMxOoXMaOeo6hs_Of48JDF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiL78K8YHY2kpUAzocncOBflRGNEl1mQBU9ObhXZvn5g&oe=6AFDC689"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuU6pugv0fsQ7kNvwGR8tpX&_nc_oc=AdqFOcLkwxpH7nFHfNbmcq-dhNP6ypJH34SedW-B0lkA2pHztc5fu2vr6sFUveNnRxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtbjhdnQPd1vUH6vxZQuPWcfQq-0kvfylprtzNU0Lwnw&oe=6AFDB8D0"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYcFnaa92_EQ7kNvwH_R_vM&_nc_oc=AdpN32QdGBi4ZxgVrSDc8lzH4GErhLnpba6dd-Fd0t9feB0x2nkDKxIeftTg_Q4cMrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7ovLEIR1T3ZsdU3gxhHpQaYW4-BWhpYMv45VkE3vLsQ&oe=6AFDBE66"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoXNJF5OJqUQ7kNvwFixD3H&_nc_oc=Adr_TUDkwsr7tWp67ihemOECQbVaR906HUqP5j9AfAgY5Zps812FTscd2RmeZ7hwsb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkcxWKNmJSbAR0ANdyz4aX2xcGdTUG5AxCFdeVKEx8Sw&oe=6AFDDC09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiZsU2ddJNoQ7kNvwFii5Rj&_nc_oc=AdpwYqTOx6FB48heLx2KoXix3R65Wwf0IsvMTne3ajkCB2kNuvtyrdauFjEcvXf0lkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoEqzDA5_m8RHgl3zUgWRaE5SLapGx-Ouji9Vh5yHSsw&oe=6AFDDCA2"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
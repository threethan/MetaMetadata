1_9XItg8r81MrghvtWT0CdeSCkBaG3KkRGw&oe=69D4ECC9"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0vWwY5LBYgQ7kNvwHXwQdO&_nc_oc=AdqADZxTzAphL-SCsnsrSjpSaktckNyJ4VODiC2dIgN2nsRdwBOBWzUWbrvtsd2XFcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11eOiiirFp5IlTltvNsUsN4n7L5GDlw5BjGU8E36sWVA&oe=69D51750"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ4TW4HYw94Q7kNvwHLNvO6&_nc_oc=AdqU_RM88tvZsbT1Y3xIHVbCei8Xp432N5OWLkEcuSL8FulUmfZbiYcXCtUpA87U9-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06i9htieLnf4uFlybl14PS-AMv4IewB2w_RatjU3I_TQ&oe=69D4E4A6"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siTczKsQYbAQ7kNvwFIW6w4&_nc_oc=Ado6iSasYgdtHtXUZHQzhUHGqt4792PPCUcv37-KJShqVZf-kqPTcgSawRj0tTxMUTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TnR1eItez8DKOCue-C4X-WKohQaB8RtIkF49WNuv0AA&oe=69D50249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOqZBQntq28Q7kNvwHbI7uX&_nc_oc=AdrA_LNWOyi5ZHkcGdWz7Q1I39nNhWBgBkkWCkbg2jwylcMppNrOWiT6H497pLeHk10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IKxm0YOOQgmFmyiJ09mhdjpe9-7NreEgkrJF4ruvqyg&oe=69D502E2"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
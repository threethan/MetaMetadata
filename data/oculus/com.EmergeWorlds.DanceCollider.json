bLFbEC8S8qI546hW2xmkQikI_iMdPrJ-FOQ&oe=6A9021C9"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOU2whf91G8Q7kNvwHgVWxT&_nc_oc=AdqqTlolJLwnq9sT7WGswkC-ST1A_sL0OCf4ie1Ln7kYYqt6qzkYXp259gN-PisY3tc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1DS-rZEH22_eFNLysr4Ss_zOyL2J68iW-Hk3n8zkI_g&oe=6A901410"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=087lagBSmNkQ7kNvwG983WL&_nc_oc=Adru6oAJ6PdlWJHh4krkrCRCBOIgyz5VGWb3VJsocduPlhR9-Yv4qXD6Xn0UZ60vQYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbq7fHda-uNRFGPQCyi5QS4HvZP6zv9uh8A_nQ0AB9SQ&oe=6A9019A6"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65D9_TgcRPgQ7kNvwHnSsEu&_nc_oc=AdqMB5D9xujn7O0I03pE1W1sOoNJw88U4tkUGy4EzheBvCLzhje9NsxO1k7OkXSyZ3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe0M06rhglN5nB6nhjPp8wyKcA0G5y_B-rhSnjgyKfpA&oe=6A903749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPL2pqX1_1cQ7kNvwFZLjPV&_nc_oc=AdphOYMTYDiKKkbjlr6Mz1AfGO7GxGkOo2uFbb2_RYHbvtwGahsf_G6AvyqIgXtfh8E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrDhC6cNNECBzID-BwYlpYA8fPgnSgX1R_fFKBUC1Gnw&oe=6A9037E2"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
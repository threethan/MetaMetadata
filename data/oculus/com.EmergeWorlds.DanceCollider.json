95-zjxYmYG8xKVirvvSZwwFvdLz1YnjKPKPO2jYYJviqjJVL4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftLYcRV9ESfXJDBQWgDyGA9vtJc2XIIe2vejeycferI8Q&oe=69A17A26"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNWbaQP7eycQ7kNvwGKudTg&_nc_oc=AdlyfhGeQvW87bKrhCxz1vYeCinT-yr2xP-OP_xz1sJvVRyPATPVueJ9d_URraHXN8k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftMmrzgkdut3xg9mzBstw71TiWjeuMnjE2vgxdaRtCpeQ&oe=69A197C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTWLPVl3P48Q7kNvwF9lzSt&_nc_oc=AdlGYfhLJsUqO0AxevEAQwLwa0jJeKgdtW4RV53C8IwXuGym--19WCkdC9dbhenR1J0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftGU-0Kkv5DFzwmDwdfr_qKMfm1Ec3l_M2QKGSvQmMUdg&oe=69A19862"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout on Oculus Quest.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and our VR dance editor to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- VR Dance Editor\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- New futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout on Oculus Quest.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres, a VR dance editor to create your own moves and our hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/terms", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "345962100711073"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1401024441480582"}, {"status": "PUBLISHED", "id": "2696868387343859"}, {"status": "PUBLISHED", "id": "859635206426093"}, {"status": "PUBLISHED", "id": "3321790424656234"}, {"status": "PUBLISHED", "id": "2623324078007477"}, {"status": "PUBLISHED", "id": "1750553768907135"}, {"status": "PENDING", "id": "718301457232170"}, {"status": "PUBLISHED", "id": "1220802003073218"}, {"status": "PUBLISHED", "id": "970862617942541"}, {"status": "PUBLISHED", "id": "2247032142342556"}, {"status": "PUBLISHED", "id": "1599560273981933"}, {"status": "PUBLISHED", "id": "1188798202202399"}, {"status": "PUBLISHED", "id": "19
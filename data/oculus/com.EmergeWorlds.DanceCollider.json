6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dix5JfaSg0cQ7kNvwEstv-o&_nc_oc=AdoDg0yUcJv3ibjpG2-c0-STIRkWyVluvZDS_L30YhOlVZCpAq89QqWl2-whcG7yyx4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRecoakNhjZGYKFmbf5uJwKr9tCaZBG1b9vN9lc0Pl3hg&oe=6B085289"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MnaRmiYa-0Q7kNvwELtkVj&_nc_oc=AdpUkKqWxuHdFkeDJQACU-8KJOjqFltrc33GQbKUT-BIyOrpwwUqf49Ufwj6R91tKrw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWyW1VOfT0F26qkocOZCl99k57H_bNyrc7MUUxB5htSw&oe=6B0844D0"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMXhFFtKnqoQ7kNvwGENcNz&_nc_oc=AdojJFzyhJZyOLOyyuexnqq1_zeK0Xz7cMemXGA8PkZlqgBbmdZ5KMPWB4O1pusfkhI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf-7JXitzSDSbit60QY9JBJqQOqtB2iVJ3fa50pKodCQ&oe=6B084A66"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPxceBmzRcEQ7kNvwGzRIvQ&_nc_oc=AdqCV5KCjUdTnE1HeA_hLfm0thitTQnDSNtIGrEdLCqAxsHQT89hbIlqvqiXJFmZJ10&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZjezOkgod-0gmjCNnuK2KlMsLYuhVwE1kzesWKocYDw&oe=6B086809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2L6HblosqIQ7kNvwFC18GD&_nc_oc=AdrXGqBocbElcoEdKhAisTbxzez9YBZNndgxdk9rvqhKWgqe3HcjHknS09_4s5DKnMI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwiGtxD2IJCooyBHgq2xFQ6crU0LrNNiRdXrQX8C1Rig&oe=6B0868A2"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
qQRHImKkYvy-CWLskFV9NAW_vbJiiAIje6w&oe=69F61A89"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BG84m6YD7UQ7kNvwEOA0no&_nc_oc=Adq3bAhb6_OdVJ77BX_owah47w7izO0hQtAPnF-gV4TBSHHcJv__Tk5P4RCk-372oJA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ug1faL_Ow0qz3huU7QiOf0RrKYM0uSLfyzEoGveX0tw&oe=69F60CD0"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HX-gw7z4uoQ7kNvwEegQ8W&_nc_oc=Ado0Jyxc6fI64PIKzcOXT_j-erFnprg8JlJgp__kSYTEJK-1tFPJZjLwo7T0PJaIYSI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0F2L_5YJX_sAE96bXJI262cbuwRe07PV16_C9l9TPOpw&oe=69F61266"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0igWaCrO0ykQ7kNvwGV3ly9&_nc_oc=AdqxT5TOXD6bvlQw_4I2T-5SPUigC2VaIYeegkNL64srJ9QZSun8Ymgj-V15iwPYEvA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PXu42BXWXHBAyJV_Pei7-jZemlMXI47FAe0Zvkrud5g&oe=69F5F7C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnpjPwYF3vUQ7kNvwH4y7_8&_nc_oc=AdpRWvgrUYgq1jIfgNKHXSS9mn4U-Fa8gcCW_n9c9ioI2hCO2Rf4Nv1VECsPoR97gi8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FKmkQ_dpIRqSD4FBfIiwyJkpd2KonJ36ub_2o8SfVxQ&oe=69F5F862"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRqRNbazVVcQ7kNvwHfrP-P&_nc_oc=AdrinPUknYu4CpDKumoxeXX8q3Icmh-5AbiL7K2ycrRE0R7aZjNl_RS5FsQsFBelKpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpAno5-2YU3zH2YGSVCI6w4SjUbrb0S84v88rlmEIQUQ&oe=6B0F2249"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZYPiHX5rnkQ7kNvwEtkzuD&_nc_oc=AdoenutBAcYibC_okimHcNXB_2K6-2atR-DtUov_260stoFI6KmQtsPYvwa8FTRtHqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXyg294VDY3oycnTZHKoOhzsba7gZPLN9NoDf1vMQe-w&oe=6B0F1490"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84dfOf8GZdkQ7kNvwHeZ6RD&_nc_oc=AdqBKjPI5uazNFy5HjuUO2ZNZfahlewAt9xPVA2egBNJELTrDNZryBc5o-cRqnLDPTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6lLVr5GKqbPPitBsgN7erah801NE_n7-vbHFTIJoxVg&oe=6B0F1A26"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nujMb-1j_z0Q7kNvwE8znUU&_nc_oc=Adp4_6LlC-VcK9jNI3vsEDESH0Sjgqro3hnAHRowQyTLvUK67kETXDJgMrpyiM7JqBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUUqJMG2y0vv-74A9-jYD099HcouSSlK-Xm2mpKYXwp6Q&oe=6B0EFF89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CCUhn1Q7xEQ7kNvwGT1Ffh&_nc_oc=Adpb1dWdrI3Gr9nTROgFnvyD_QikFKRRnrnbqTxnrhFZtRDFvltmGX7WkPvSlMV5Hlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUP-WGZ_B_Lbl7ESQdYVVwT06SRmDZmOtw6_Yxed-Hc2g&oe=6B0F0022"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
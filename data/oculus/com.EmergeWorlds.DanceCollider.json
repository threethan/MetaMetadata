6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dix5JfaSg0cQ7kNvwHkum_1&_nc_oc=Adp-Y4RzOoDTEaQaGzsyXuNpGnXiBDskHxAeZXUHAFQNYUyaY0lvYHT6ERsIrf7bSoo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnUI-hTfB2C37SUp4-Qkh1aq1buUTrre-uc1rG5WLC7A&oe=6B0B2DC9"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MnaRmiYa-0Q7kNvwGtUB_Q&_nc_oc=Adqb3SvXca4RcmKH-oqOiUDMzgijK8HMw_e6udQX6kKvm4JNJ6wcJUofDDZIxGllWZE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQReM35RGPHPxyxamVnbxKfgOCvNt4JaRxo_D2z8B5W0kw&oe=6B0B2010"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QWBKu24GXgQ7kNvwHEyUcv&_nc_oc=AdrfrcPew8oBCCzLL-c0JluPhB1mYChRBsskeITWRZfuS9E72ChJhzzcp1Po8CTrcDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKDblbXoHgsTgYSK_nOs31i9M0Gofi1BmAaxdPpSJzrg&oe=6B0B25A6"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cxn4dqF_dIQ7kNvwFkoqpQ&_nc_oc=Adp6dLJP4yNSfmfcnTr6puH4Xm6b4jbaruf1Y7A4fF4pT_I4_FFajzoMYmAba3OX9TA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS686IK5jf3aUzNwIIoGdiX4s1gk-I_zCuwrzajYjC9Sw&oe=6B0B4349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gow5qg6pjCYQ7kNvwGYFzSY&_nc_oc=AdqyyY87pXKzPbDmJvUBC1YDOj1gZUq6hLnl1gK8J-bTxbxpAwSgA2vnHRGYnemlEEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShoE1pkQyuyAcAp1-Pi0uLNWURHpYf73pDi0YxGm1ceA&oe=6B0B43E2"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
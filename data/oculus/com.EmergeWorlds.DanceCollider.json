6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_eHagkCHH0Q7kNvwHsK0sp&_nc_oc=AdodhQWDd41_BxaCi_SFPjSmAVNdkz_JcRMy1rL7iS4snpArVUC5sLbf30oPuuC5o-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKGzEzLcPBoiBnegMrJXITMKieT9o3fydiK1Posfxtdw&oe=6B030C89"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNCUUEZ8gEsQ7kNvwHx2vyh&_nc_oc=AdoFlyG0zEq67D8lOt8Du5Ly88bOaCD5Kh3eiMkd1UGzqVP1wg6OVY6lLuZAFqcZUac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaVzVNvAmuqlZ3LtrfyZRdQ6VmwoKWfq-9rEYi8lD3hQ&oe=6B033710"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj5XPM7Qj3YQ7kNvwHQsDj-&_nc_oc=Adr5VwHCRuaX81yLvotiE4LeR0rvG9bQNrWzQvf0EqMyVQ9Y7nq0TY2bzr8bgPl58tg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwVr8jXMEGea2gYV4J2v8gRqNNN1pjhXxq2R4otEyFEg&oe=6B030466"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixj5PpjhOTgQ7kNvwGaHah3&_nc_oc=Ado265aWpXCkJqRGLUdM1bUoWyhD6JL0tGs8AKhaf-bY4apMan7u6K_d4eAJc_lCol4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOLeKI-y0CH5Yknu-gxTWMBnymgpnJijPrQqDJpTYJ9Q&oe=6B032209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHDcaEqIe-AQ7kNvwFz2vhC&_nc_oc=AdqbBHqYHwRPVPqKN9U0A4pKEKJejipARYcfYUN3XI23ybtE5hPZlTqqFHYViqMT-1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVZPwNT5kWNv8YmLmW4dVrfPyfYLxVRrMSUFFNj1dw8Q&oe=6B0322A2"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
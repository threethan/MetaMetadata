lKGJNGPbS4byrtFZGYwWYxrEkdL0yItH1dw&oe=69E8B349"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhJsbBiax7kQ7kNvwHnWcsK&_nc_oc=AdpUa4J1UYlz9mF0lqSmzcma8yZgkjrb_wcOOz4leaZEjuBW5kM1OIA9D6Ta-eeKFN8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RplejJU8zkJigTlRKv5IlZzLXSyqrAZzmvPpAnkQNsg&oe=69E8DDD0"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO_gNdUy-OIQ7kNvwGWF22F&_nc_oc=Adqk2Oi-YS3U8fmwgIXX4SqUqwsMJG7Ejv0YtDpAFKn_UQ04MOhuQ-P1yAytDRauLS8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23zntcMWqAQZRaPXgbDsFXhw_9Gr8MIwKImP4SlJxRjA&oe=69E8AB26"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sraErasV1tgQ7kNvwHSVmfg&_nc_oc=AdpE6_hjZUHvGI56IZTKh9rDtGD8zH8ksjB4CQwfewjEIJ9c9NuUI4uoeFVHPf-obNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EMXheqBai4zBUp2qLSgJiacYFYNSjz5y0jrt3pelCug&oe=69E8C8C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4LIZwhQm7YQ7kNvwHDAyP-&_nc_oc=AdpP35Ti4vE-aGxq_dch9twrO5MRUHjMFsaddrkpIy-JgeylzGvUmG1vQXEz4Ur_PYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V6bcMAbrYloBla4QvT43QuI-4cWMLmJ2FSU-wtDqHkQ&oe=69E8C962"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
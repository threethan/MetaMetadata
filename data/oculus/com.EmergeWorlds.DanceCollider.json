WOEq_55Cq-80y2rHFSYJj3FEBMS6cDt7PTQ&oe=6AB93889"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gylTjpeoVnEQ7kNvwEMtJRZ&_nc_oc=AdreUiBh-C6cYLzArYBPJ4aCBBOyW9dH7ndP8JXtcpQTSHmAoecsNsS_BE_8qOHYIXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsjcDUYTtxxJxeA_toxeWdW3JpeqQ0QgIsSpiL2yrBZA&oe=6AB92AD0"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40vts-C0QVUQ7kNvwHyET1B&_nc_oc=AdpF_DE2gTbg6J_gM5EHs8OUS0InOlFLjRqJ9HQ4BG5seIavcURiUyi9n3TYYARbrmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_BtwKowafQQ8zjrktX26XlC0TkAw5z4lR_A2QYPQwSA&oe=6AB93066"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxfgVWk0nNsQ7kNvwFwZrCu&_nc_oc=AdqfLRJvGXXGx2nB_P_0welug3DcUI1IR2MJ3fSjmCRNX23teqiM2MS3HkdXV3kZcCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNEycuqnEdRxWfhlL6_ZkNcaxkVVSecc2qfEdC-Yw76w&oe=6AB915C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_Wc6V-5rggQ7kNvwEVNYHv&_nc_oc=AdrQKor7_pIRfYVkbLwvPapkzBWdwQrKeCO6lewlFJGVEbbbqfnpwV8KevbopKCLCwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2l9iFjKcHZPyExZPgtoBqPxs_mCZvhtbnjtlqjHF3aQ&oe=6AB91662"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
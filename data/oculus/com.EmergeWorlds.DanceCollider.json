d_8i-wqHsA-ZCLPZVFN7BSMjCHY2iD-NHHQ&oe=6A131B89"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMiQb9FJI3kQ7kNvwEANZty&_nc_oc=AdoUWoYKv8vPvIlHXnYMgqToJ_Gh01W12PlD0Bl6COWTz5nq4emfrfynttVDg8XZcZ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43h9wrk2OB27BK5Qq-5wh5WXRrAQfGxL2XVfHC6N4QcA&oe=6A130DD0"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8E0XJgAeh0Q7kNvwELaBvM&_nc_oc=AdoCA9A7_C5hdG_IUzrL0_yi56EP8Rp0HNJwGsUSOYVxlWbpqVhuqw1dP6GbOViq-TY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bc1ANSdAV4ah6YtoF6YPKSkprKoAXNNnspW_uYT8Ckg&oe=6A131366"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzxdvN2JWMEQ7kNvwGkJuBq&_nc_oc=AdrF2TiNGqRXkANR5O99m6q7SMPgGTGCi_TjfHUKZB5jFHgbmQ7hs6-yLyX44Gm_cd0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V-eaxZAcYIGtfdh0y6Cqd2k5pUC-EbIEUrG-dDlD6Zg&oe=6A12F8C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtTPVoaud24Q7kNvwEPitPP&_nc_oc=AdoCFAEDl9zwvhxxeVGOy_kN89rc_5dy2mIcmOWSSxwaXG3LfLStjti3W_BbrULtTxg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YOdtPr3RfHNkez2xt7EPiDF9SxtU4-INqsy0zyNS5Gw&oe=6A12F962"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
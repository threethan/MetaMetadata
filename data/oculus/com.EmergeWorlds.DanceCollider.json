6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRqRNbazVVcQ7kNvwH3nhxm&_nc_oc=AdpHA4Bgs7Lr00IYQUXOZJSG54582cDYBGxDRp3DZ3ybIatgeXU15o_KdAZ3N8ESH6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRmTeotoQTxHCZ-wDuSJc1rrqd92JQBF-QZXq82cSVC1w&oe=6B0DD0C9"}, {"file_name": "DCQuest_03.png", "id": "785169528786357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469631_785169532119690_5723761729304081463_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZYPiHX5rnkQ7kNvwH4BR9e&_nc_oc=AdoK6AL4UYQzeUChikSuE_89UZpDcdBmfu_KojHAW-8taYzIhep6cf-FPkcypOqkEmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtcyWCizuNmY3S2pzr9wpAHxwlveHIcOBvnOaPoD0RGw&oe=6B0DC310"}, {"file_name": "DCQuest_04.png", "id": "264475521812456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_264475525145789_7635179620426081442_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84dfOf8GZdkQ7kNvwGD155O&_nc_oc=AdqmA5M5bd6Sh4UACttyMcGhoaO5tsGjr3ICaDZl6mlgIFiwPEhb_hx6iiG6GPizjOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUYVpJbjlozop-Ill3xSH3K3FrLoQSB83xcuanrVZhow&oe=6B0DC8A6"}, {"file_name": "DCQuest_05.png", "id": "356050808992825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295892_356050812326158_6185993198349557241_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nujMb-1j_z0Q7kNvwEHnhue&_nc_oc=AdogxhEAuxtHAm2YXDJo1l4zWuCSe5IKqpOsf_uKDF1rOcL8hda8-eFhDpZJHhDnkTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9FBtpRFaRQi5TnFGOrO_0RnSvWgZG3TIAzFIT4y2kLw&oe=6B0DAE09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DanceCollider_TrailerCover_Quest.png", "id": "1422429241440537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236138_1422429244773870_4796738977918569534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gow5qg6pjCYQ7kNvwF8cYDg&_nc_oc=Ado0cmEGbIfxxcDCRwP6NJwtTc2S9bUol-Th1amvuwxWd4qQ_lxyxVfOpG2cLvSqxQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvdD25h-3btAv_yg8ocWM6LXakkMOpdlZHLEetybzjUQ&oe=6B0DAEA2"}, "display_name": "Dance Collider", "keywords": [], "long_description": "Experience the ultimate dance workout.\n\nEnter a futuristic world where dancers battle in secret underground competitions. Take on 9 characters from around the globe. They\u2019re going to throw down some crazy dance moves so be ready! Harness all your power to rise to the top of the leaderboards. With 45 songs by f-777 and custom songs to master, it\u2019s now time to level up. \n\nFEATURES\n- 45 original songs by f-777\n- 9 Characters from around the world including a new boss character\n- Local and global leaderboards so you can compete with friends at home and worldwide\n- Futuristic arenas\n- Easy, Normal, Pro and Extreme difficulties to challenge even the most hardcore players", "short_description": "Experience the ultimate dance workout.\n\nIt's your time to become a dance master and take down Uriel! Battle 9 of the best dancers from around the world and compete on global leaderboards. \n\nFeaturing 45 songs by legendary electronic artist f-777 that cross all EDM genres and a hardcore mode to challenge the very best players. Dance Collider is the ultimate rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dancecollider.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "emergeWorlds", "support_website_url": null, "website_url": "https://www.dancecollider.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
92105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2y-BbuDy_cQ7kNvwG3riSU&_nc_oc=Ado6-wVlFCcTsMUZSxJq2ly75dZpIsV8dG0dinR1Cfr_LVh_9L0qHhbVs6VAR0Z_K8A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3obGZXf1b8ZiBfv3feq5-aAXgNju7RfC2C4Jr6ZNJAUw&oe=69F4B44E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkZJ42xdTi8Q7kNvwEMrDkE&_nc_oc=AdrwtXt829mzCxhLKpUaFRHtPMqaZWwlUGmBLbf4uLo5sDZpOgTm95aai6TJdPYkWnk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YzP9sIy-Y8_oifuAeQ2uOJSQf6jdBt9wxqbym5Le4fA&oe=69F4A8C1"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hih2y-74-GcQ7kNvwFaDN3P&_nc_oc=Adpfh1piB0hQimr7ZhXirVx7pKGniLWIXEdwZoGQYRXWQalfVassCbLluWT30m6nw4w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FObUYEACV86ib56j6J8dVJ4ZxPNgafXdMQ_D8cWLTQw&oe=69F4A3C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfvnj7LoAQoQ7kNvwF3mdRR&_nc_oc=Adoap4-xp-HyGC0_78zZCxxQXoqsaRQ2Kb36CjN-IxApPMcm1-tctSBn_sLpV6Kzves&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oGQJ4y5WHKVDIpPQ7yPsjXwjhFSMN0lN9Ne9PKUj2_Q&oe=69F49AAF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
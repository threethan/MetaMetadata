GI1U68t_zQ1Ca2RI24liwMNUfeVFae38icp2WBC2dkOuzyZrbd0raNNhhMp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy2_txgiuoUh9LOjW4aHfmQnxDdCXErCWmCUkKw00uTQ&oe=6AFC6B0E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YISMv3s7zEIQ7kNvwFOa_EY&_nc_oc=AdrnN6PGEIr0t-JNVMoMPBIhlHO6H0mZbWF9JH0PQcSG5cGG_QRAtdKXPLMhBLo-l0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT84_JWAVC_qAD5w06HiQlLhFVr8QEAgdcO24UA_qWipw&oe=6AFC604E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWWcdM8hNskQ7kNvwEjqebQ&_nc_oc=AdrOPFa352ZaPk6x2XVAt8ghJXH9Qfl5VzgjjPfZcBE3lrEKh_54eycTOrNuo4MYPqs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo314rYAvuv_j85w_9sVC9ITLgl27Ss0oHsXGR4ZcbHA&oe=6AFC8D01"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCMR4nCZYTcQ7kNvwFuPxT2&_nc_oc=AdoWE-Uiudxap6GBXIkTAM6NYR12eTm88gpYikp1-q_DbvMnFIPLz_wlQ3p7pSkIfqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9mtexzPGgTxgZzBsPto2tYFEt5fcNhKGhCfPSS5CAvg&oe=6AFC8807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMjh6v_nmXMQ7kNvwGrQvF9&_nc_oc=Adp5JeK99kWkYHzyDkzgf-eBqjac71M9oJe46dLzaMAYutYNA94h5iBOqBYAfJyxCD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSztW-pLudGLMAcATk9EfrGVeJt5WYlJudr5YZNy6lSOA&oe=6AFC7EEF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external
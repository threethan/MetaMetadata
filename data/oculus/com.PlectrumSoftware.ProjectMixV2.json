uWeijKXZIZqd9woJ5LYyFd9XNUa_XTA0VLMjD8I2i12rrVQnYmfm5E5HkmkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1uHa8Fa9xlHJWUUqM8LYyDJ3hIS4b7-rsZCUg-xYqFw&oe=6B0DC6CE"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezQE10xSbWEQ7kNvwFzAfM1&_nc_oc=Adr1seuIEfqnp8VBMBeJjHCRv6LgHIVFgF-nRTv9svVtV97W2ZuJJwwkbt5Dz3O0YFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThMVknm6NLsLfANanlF_PwduW8tsYdZ49iUScvuiT0Sw&oe=6B0DBC0E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiEYa2Vp4FMQ7kNvwH7ivU2&_nc_oc=AdqRSoBAwpUgN7PkDL6NvpL9Zzh6Pd-TdM5oSJgh3mtrvdnqt-cNCL55izzXy7GZspg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSz6I_AxAZjf1Nvxo0btH8Kwaj6JzO9pVLwECT0gaJljg&oe=6B0DB081"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXiIWvSvr1UQ7kNvwH4sw4k&_nc_oc=Adq-um8eqAwmCoP76tblvTlWPHc6vBBvh6XMD16kf94rmS9tmMA73FQuLYLclG6JcNQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRoCflwRsVa3OSGgI8hF9yjZVqBw6zYzqHuQcDek5H-Vg&oe=6B0DAB87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU1tNDyOnPUQ7kNvwFQDqck&_nc_oc=Adqu8nCsPiAAXOPj7N1rMibRsyXD8yL1j8caEcVWz0SqxdNvAUSDnZQeIEZaAs-LQZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsZxdxhdjkRzOOlCoqHSkvm54f8ZiZFUpYdHMlZaL1Fg&oe=6B0DA26F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external
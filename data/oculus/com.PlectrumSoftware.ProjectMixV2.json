92105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLCbG_hkcREQ7kNvwHokNdf&_nc_oc=Adpk9itIwSP4dU8k2t3Vy9G5UPjDVk26uojtw2eBKI29RrNCLmmztCPNAwK7lHZkfJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjZoynVKOkAQwgFbL7nZCdvnAnDqDpVuHicBJqIPh6CA&oe=69CFCA4E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqgYnLoL5ZEQ7kNvwEZpd0b&_nc_oc=Adpdxa0QGari_tiAnVQfZAQs3ovY6VVlAS2evsaSxWZeARr2LpYoioamETGYoIBdqUw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWqP0pHvPABHrI2UxYuOoq25z7dlj_-RA9CV3g8xd19g&oe=69CFBEC1"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kb0hfk0P7FsQ7kNvwGZpH9s&_nc_oc=AdqCE2OybTpQxZV5X92Q1GUkYAMSbYWvDzsHFzE9lAD07m32RycFtvs0p4hs0U7A4qM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwz6zfIR0YsBUyezPy8XcdQD9X7pXmpEtRo0O6xJb7B9g&oe=69CFB9C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ3lnW-cWwwQ7kNvwFrpRJA&_nc_oc=AdrBMBpca01q6X5PeWlwqcTCKrHqNBj6MsaHtd0f1SXFKkT7zE62nqvoefucpUvFH3Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx19EmCc8JZsNdCMKhNxlR7bSMZl-4cChQztVctoQuhOg&oe=69CFB0AF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
om&_nc_ss=7f20f&oh=00_AQRG1qho4N4zHcB7g-2IyywZFFo6YyxIM45hjUep6y7f-w&oe=6B01E94E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhD7xjUnafMQ7kNvwGsKtj6&_nc_oc=Adq-KSwyijr0zi9YLoXo4934ulggd8KYp5tVV5Z-8jSZFScEs-FaTfP8ffIEisQjmiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKuwv4wdGNuBAfmomy28g7DDdPmGnDSxZ4R1vZhD5jNg&oe=6B01DE8E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GaEPRlNp24Q7kNvwHgqySz&_nc_oc=AdrUfLHbI8qlRG3xRFOELywt8RJdyeP7F4AyZEuMk8MKUHajHOlNeg-LSZX-9T4Lnpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ18kgM7m6p5KtV_J-fjBnmRf4UpcnnXpX5SJ2jazWEcw&oe=6B01D301"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU-2NtU94l4Q7kNvwE7YxA5&_nc_oc=AdpCGxvrDSktSckgQXexNCNZS7Qf3QOEprVgKb46xHiN710gsJDwP6hRxhJG8cTYUjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT10yj1eySj3JJJvPR6_2UHLQAY1qk9fD5obSlLw_KRIg&oe=6B01CE07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNPt1BIzh3AQ7kNvwGzRDC1&_nc_oc=AdpCzyEXWlvwFLJfauiSZGFLOHwJDtG1QWi9czdVLSrojeFum83ybigz3TnubCttIiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdQ_MAcaW-bdbh491MjxW032Xv_ccd87eINLGZ4i-x4Q&oe=6B01C4EF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
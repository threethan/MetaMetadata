om&_nc_ss=7f30f&oh=00_AQQbtR9yLNMAt-eWeIWzAZIfMtryLFBH5Vi6nPeSmUiC7w&oe=6B0C754E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaBsEZjdLYAQ7kNvwGrxkX4&_nc_oc=AdqG8Xu0-xX6Gzjr1ESBqR7B3VplrBv6iECsqOQgV5wsXTHIhmZ5F0HtgR1odzqcZ1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMs3UKUol3J2DaPNbcTPNLPqOM_7X8FTb6BHiXeJbNgg&oe=6B0C6A8E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiEYa2Vp4FMQ7kNvwHo6uyy&_nc_oc=AdrxnCQDFzHoRnnjLr3-wfIetF7nTxeMSwzROzm9CQHy3tdaD3NgdisI6odvG09sDwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQK0BHmOB1LHxnXxmx9Y4egRbx4Ng9MZlDPUO5WtvTnVw&oe=6B0C5F01"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXiIWvSvr1UQ7kNvwGO6wCT&_nc_oc=AdrIs5e2itPXl3l2vbXh1EKh6mqjjLwRWjuz4jT3pMzwXhlcrr_LCaXhHa2V_HUKIe4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1KYSozZizfb8BUgYEt9rotB-0UOvxpw8NX4xhoImQYQ&oe=6B0C5A07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGNwwtImQYYQ7kNvwHnnuBG&_nc_oc=Adr6UHfz-LbVvoph-Ry2_tx-gWuPp0iUx-ONmfKHXHQ9TIwbEMwdihoQjf-gL4spSb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRy1Qn4U4bmr8oQ4z2CQxCuwtDQeXrj4X-7rnHUzzZXbQ&oe=6B0C50EF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
ofIO4TR0d7LCAvKxx-GGnkOcXhVyR_hxiOaWgYwS9BYOnsFijll5PZZOQVWg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHpSRIjW8z1NMNOXNP47fbAYLTkTmvst1yYve0k0aZlA&oe=6B09D24E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaBsEZjdLYAQ7kNvwFwqfDu&_nc_oc=Adopz-TbUwcSCVQBj8bop_t11EgiTS0R1CkXuqoCoL6SZEEsN8iZPveRzKr1x72fwKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjVpv7VyM4c_KyDudxABJZ6wNQkIDMbhH16Gqv7exPTA&oe=6B09C78E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3U7kXsg1k8Q7kNvwFgfQeB&_nc_oc=AdptoR9o2UH2SVILl3xnwwLfbYh939MDl8DyL0T2ZAk6aRrZ4FOkpCJ45CzUvfG8tVs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbI60BupXkWZshiNM6F8vIg2wqfe2dojxM_BZB9eJRgQ&oe=6B09BC01"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYGv6jlQIkIQ7kNvwE5Qly2&_nc_oc=AdoAkb0PJ0NneOZARmvBxNnViszmUqxQDGkMa4ECTJqCWiuzB55ttLpVcgQWV-KT5ps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWp357EaKrmRZ_3yjflrfwPxTwvUBXGmgKY_YWlOxcwA&oe=6B09B707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGNwwtImQYYQ7kNvwHL15g2&_nc_oc=Adq6cf3kPi1p8OTeYFbN2kuUks52gJw9kVjt3uV08cH85Wuay3rWqGE086xlds-LRbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU3Fsp0mxDezR1zqb9K-Y079IZYPww7pvy1EcLYW1f1g&oe=6B09ADEF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external
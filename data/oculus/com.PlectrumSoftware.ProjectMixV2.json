92105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4hpy4Hpy6sQ7kNvwHYWYWX&_nc_oc=AdrZW36ATVr4Mc2Kgvp2e_UkU0xRBI-A6TGhnCpkAgUEwPuW0YrzV6PpUbyktZfRHEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jkfDlxkoRNeKEsUzmcc3Ub1-Oq5oXSZhK2vziG3bBvQ&oe=69F9FA4E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57QWS-PxEXMQ7kNvwFiJWT3&_nc_oc=Ado_txcVrdsoF5cJuWAdWQL5Dwpwufb-dDXUB-3i7Eq9wz_zHWUzy5KfqY46LFd_egA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jydNTiWNmDC6_EyqF2O28kybv6KMu48uFAP5zybWTiA&oe=69F9EEC1"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPCGvCIKopEQ7kNvwEjqx9l&_nc_oc=AdpAfYAWzdF50_4s_MIUwJ1-jy8C0da-oEvp6RYW8UW5KyAW2DwD0C73Z1xiVgECHU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jqMxoxinN0NTckx5n4PiNbyENtiUXzTJGCn10KS1L9A&oe=69F9E9C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOpwdhOxXM4Q7kNvwHtNnJL&_nc_oc=Adr9t6ombhZh8BX1xU1ulRHqGsUu8_JXskbGv4LgjHNtewsg5ZUOE09tjNrDqLSgRsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mYCW72M-0tHOYSzknatfGRa7DwoL44gd26CJjjEDtSg&oe=69F9E0AF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
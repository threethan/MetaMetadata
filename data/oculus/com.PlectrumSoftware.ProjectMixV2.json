92105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tizx-4GC_x8Q7kNvwGcMV4b&_nc_oc=AdqrvR3SFsAWSDzOI3NB1-WGwaz4ODxcZe1OTSn_u_aZt00CqugSSc3X5i8OLKHphdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rFQQg_x4hgGYi1fgVto-gXdjh6snyRTZznayYEWEtKQ&oe=6A47C2CE"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTpDHwkGS64Q7kNvwFwC_Zn&_nc_oc=AdrLUyx5lK5mB_-20INvJvm0uypzfg2mhkTMGgoh3o5Fxa5h5wd_yvowbz26DLblKW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sYWuVgRyF6cy1SYFz-K_h135AwnxZBgOFrdk_OAqnHQ&oe=6A47B741"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG_VPi79aDkQ7kNvwFcwkEl&_nc_oc=AdqN2vdHyo7qtU1CDGBO4cEMzjqEesieqNnmCQr7oy7YLyBWp4-uHgYOPFC8RBGzMQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_relSpz_sLUVFFrkpX-a0U9mYwpAoqnx0Z6eF-1hePWQ&oe=6A47B247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK0-jiCi2IAQ7kNvwEcDV_Z&_nc_oc=AdoUlGJ1KSF0aATiMwYzvXO4vP39sJ02SZ9G42VwtTQ7IVSuu-xh53WrZ59nbigp74g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uVEUQIRAbLpl5QbtGJRLqyO0t6KhAjhb0wFeUC0_L7Q&oe=6A47E16F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
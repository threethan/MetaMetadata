7kNvwFhFmvt&_nc_oc=AdlkdrddA7mpcT9NG_hQhsORlT-ENdohuRPrZKwWT_R6cSu2epJDnVDHz-3V9gV7nHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvqFd_-wSg9j54GyFFhSjUMYMtRzRZvYgqAex-ufdOegw&oe=699B0E4E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qQIKxnL2NQQ7kNvwGMOr9B&_nc_oc=Adkm2ceBr1fYeXmuzY_oG5AF_dq1d5pDtCsx_FU2itrlkqMRA8LFsj8cEfacsDIfdaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuSFId3t5Jt7Iqb76uLzSivPspKT7ahFGY2eTuUkadn5Q&oe=699B02C1"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFKzmJH6SSIQ7kNvwGTWECx&_nc_oc=AdmG7LVcXz8y85YrCpaepVhdOIzKBlv21ETgQZchj8vOvwORrRVzCY9xi0M9eF_WBec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsZ_aQnfQmlH0uIvCjP2QvxxSYqj5KCki0laNa_1vTsFw&oe=699AFDC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq6uR810o2kQ7kNvwHISpZs&_nc_oc=AdkzERGZGP60tLD8qhUYFfz4sKA6GLr5cYog5PgGl4jmalmZqoqn34AQtofFeBXrr90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuq1qZE7lAeZUALZl8YEiYnGamCgR5LXwd6SlBHTfN12w&oe=699AF4AF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491299467231380"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.o
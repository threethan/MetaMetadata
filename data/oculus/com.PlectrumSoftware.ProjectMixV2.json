87472181554", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_575787475514887_1646622721584929772_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLrOPkJmxCkQ7kNvwEPPfVI&_nc_oc=AdnSQECYnvyU1HkTD7msRth5RxCpziuCXsn2vXAWJ5xPkvHLZLqfYZCJjkuq_tfbCYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftymDpH0B-byaen1Q0TrIKL0G6F4HgRWFMeApecG5k67w&oe=69A2E486"}]}, "id": "1190500792535811", "locale": "en_US", "screenshots": [{"file_name": "Katie.png", "id": "464942639944968", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391950_464942643278301_5881837381189955776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODHUC5-XT84Q7kNvwFneHse&_nc_oc=AdlPi6xCz_zw01QmczU4Pombr2Nov_tJUYKeaFf1DEr1XcAvPmIJiPThBTm2W4LcPwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9rij1uyp0ecmpim71vA0_7i6YqvYp5ALu4rq5XHyadA&oe=69A2E626"}, {"file_name": "Smoke2.png", "id": "1717379532547017", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391950_1717379535880350_7240248363106483605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaKodPCXa1kQ7kNvwFcYPHo&_nc_oc=AdlpmL9JVcWTg9LtGCvoJ8e5D4zwIuw0-kV9W2ZsCECxXQvblhyOVe3RxqZlyUznE50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfugttwWW_LBSRaAKn8MixvR4zDM6AEf0jNzlA9Z_aLb1g&oe=69A2C9CE"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv-SOZtyKsIQ7kNvwHDgjVV&_nc_oc=Adnx08CS9UmFBru2s_43gDhTFnPofo0YJUJWEmZpNrYfOxse9bvm-K0f0egE5uGSG0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLxE5TofW3tE6Ll5zAXIEih4yri1TQbPmVY6rP_xGVOQ&oe=69A2F74E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfQeEh7aE1oQ7kNvwGeMe4b&_nc_oc=AdmZ6HlaW9jR_YnDBBuQNEx6TSP01HjgA11IE_mmyuxszYroow1kAq-X1MPIYL2kn8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWVxCMdGOI7GrlMaYCmefj64ZQpwtVe7RtgKAK3R02ug&oe=69A2EBC1"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLuLMy0ZP-IQ7kNvwGkNbTt&_nc_oc=AdmLyEZN_H0YrQsntqb3MZug3AabaACmWL98WINSUshcH_0mV-2znSV7afZXBCtMSp4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvb18BiIlSbnUZIHB01NEM0Zw2gzUruqVatI-TRLVCekA&oe=69A2E6C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOTn-UYsxIAQ7kNvwEY7xMF&_nc_oc=AdkYaCgCUq_qz5e3M4zD3qc-y9ZKXrMGS7M5GYmQFYBhzOR8PZYdEwP1O_9UjZBJc2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6JPkrmT00PJUq5oBdT_uwarHurF2sylsia3-ULgwJUg&oe=69A2DDAF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9655163187938252"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "832318156132828"}]}, "baseline_offer": {"id": "832318156132828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759356000, "status": "PUBLISHED", "id": "832318156132828"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24501775386183788", "version": "1.82"}, "id": "1170203431372059", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prim
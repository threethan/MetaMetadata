7kNvwFoCo2N&_nc_oc=AdlHipn36OVX0PdQmqoagyZfyjdqvkYtrXf9xN88o88Xh_mIOcHJ--UqV9oX1OeRVrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv0NO16sQZWAP3OWxAlz-uRnXQbGSUOjY5ZsRsktWhvLA&oe=69A448CE"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMfT8wSNH6wQ7kNvwEQCm30&_nc_oc=Adm25BIGDZv3n0t8KS8XjUoFCx7gwn-tfq_7_931dyZ1sgjH2NNqlrfftqyqoTfyFFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftu9JPcUipl8Ua0eRE9qwqKnpeCa0Zcggm_ZWGGY9QqQw&oe=69A43D41"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPtN2Txp8BcQ7kNvwHfaRTS&_nc_oc=AdnrY5WvOwurdLK92S_pHB8MpPhXDn8EXw4k_9T9i-Kzb5l8AbeP5bFYDwTZ3z-SGKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsmHp2EsCSwOyVxlMlxJq9Gu9U_BA9boIwQvG4AhNiiVQ&oe=69A43847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOTn-UYsxIAQ7kNvwH8mvm5&_nc_oc=Adl4Rd8X0AKp87yYiaM9ZfNV_LILXH_vBV0hzoiBxJhDWr4LA13-LYTmv3L6jANsr6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftY9SyVJisfqR3RLK6GSr7qnmVRhGRbFgzvFPnH9zHqaQ&oe=69A42F2F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491299467231380"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.o
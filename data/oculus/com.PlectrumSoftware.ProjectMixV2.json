7kNvwF8wzLM&_nc_oc=Adpu5FdXl8jHw_YBLSw4X3IuaFDJopudgNeCcOyz4etB1XqcySh1_ceFXKDKZfQnbVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3D53fxVWhFRYzVlL2N1_BGgnyb3kZV7ONw4qqOtP1HxA&oe=69F0BFCE"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whxY16F8QfoQ7kNvwHcjIck&_nc_oc=Adp9EiP9v37Tj3U5F3k9P-hMu5BYZDB5sQGGS40JqIIrSp288ASMMGo5h-vUtbvDljE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2w3aW_Vp8Az7SMfVzLSBd13HYjtIOD5a2J-oRTFaUPog&oe=69F0B441"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xihiR4XRk_wQ7kNvwHdvKna&_nc_oc=Adpm3Nsp0qHK3w666PbUXxEDphELaQf8qJAQwFBt9VWoJbm53OZVO373_Ua5i1ln5a8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1wgiIUvJCX0MCqkGza-x9JzgOmcRmS8OaFxCBCSYeU9Q&oe=69F0AF47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOuYVT9lmqkQ7kNvwF-k33E&_nc_oc=Adp3gArze6bld2TRTW0mTgVYa9xyXdxWVT11hdZ1VABO_nQmjO6a8LJdHlTnoiRr7A0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0TL5_jYBwWyv4Kp1k5DEMWT5UcdKyPo9Nr0fh6DR-ZpQ&oe=69F0A62F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491299467231380"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.o
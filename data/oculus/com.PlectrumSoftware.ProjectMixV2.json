7kNvwEVPXCK&_nc_oc=AdkW59GfYodaRJgcO9RNA0ZJ8Nce5czOqFcCr_PQFmbgyRkpyQh3AEE4IvUMOvvFcC0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftgVhVVqhuGe0Z9DXAaIXDzfbYLqRNE3BzBEg3_3halCQ&oe=69A1A5CE"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfQeEh7aE1oQ7kNvwHql2wE&_nc_oc=Adm9f8YjPe0Jv9qp6aSHGV6p8SUsGpNxCqkaCa_xqkEvmWKHNEkR82nM9u0-qFYpvGI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftRcw-i28EP1CUhBFi7UVOLQehbyURTm66Qk_BMdPGPXQ&oe=69A19A41"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLuLMy0ZP-IQ7kNvwEIFAii&_nc_oc=Adlt0VZ5WgZW_89w8iDQC_VztIonyGDnpmbw_O43isHnpmSr67Mlpr4hWcuJl8T1jPw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv1RT_HwWCplBp6YKQgvcqZxP_CzK0IDDMquKSRhtKSLw&oe=69A19547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOTn-UYsxIAQ7kNvwHse_a2&_nc_oc=AdlHotL4eMN1_pLn-x-10fz_zyx8m6aifDZ-wxxRJRjLnJQbSQ0lXuJwCE5eXmQcA1k&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afua8A-pt7fi1x473_-1oALONH0FOA-6O6a1wFXrriDb_g&oe=69A18C2F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491299467231380"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.o
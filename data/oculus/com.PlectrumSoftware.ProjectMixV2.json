"1195370098912683", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFL1xSj3AnsQ7kNvwGAqt8k&_nc_oc=AdnDWsBgp1DRuqki0d2N6dE9vy830waheB1kaMeL_ehN4u4IUPM8LDsKw95VUihDRII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjCRRNJ0isZy6yVbTnKT7fwgfpknspYjlxJPiuvpnZCg&oe=69B6B241"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTLvfwIQZvYQ7kNvwEpX9NV&_nc_oc=AdmQPYjp11o6_PHL5n8-gGNmOLRqh4KcE47boZX9iLj0HssROr7dW7RsHjBBHeP4RBE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2RrAi1ZK_vN0jwBFtxnm13l9rvD9RHmU9jjP1WJGv0Q&oe=69B6AD47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luaSfTV4XCAQ7kNvwE0QRR-&_nc_oc=AdkcKXikjRfY9vQktNabnsIfilgEUXR6WuFr-Lm0ScRgIfxjoW9Z5FcKdOdFtnOa42w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxL-dYv-mMjs50S7ZYuduK4FEkxkMpCe4Yp3iamgOrlng&oe=69B6A42F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9655163187938252"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "832318156132828"}]}, "baseline_offer": {"id": "832318156132828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759356000, "status": "PUBLISHED", "id": "832318156132828"}]}, "liveChannel": {"nodes": [{"l
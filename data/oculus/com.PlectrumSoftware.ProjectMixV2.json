7dFDaKXvcHDeDejcBk2vNvGVIdjNmENQN_SBJbsHUkEVmUC7AP2pLaag6CF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_jOjAdzvhIhOwkMv-lONoLoh0rlpKMxwJeJJappzD1w&oe=6B03028E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhD7xjUnafMQ7kNvwGpRJmW&_nc_oc=AdoIFCJUDRLbcI7DMTmrH7_lvvIRjHxWsj3eL_DswvaDrwngTIOhiueyQpL4MbBR2pY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIkQjWXIodGjz2-4Z_YXQPkCR5iVJK9QieI2tDqV85dw&oe=6B03300E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GaEPRlNp24Q7kNvwEVh0UU&_nc_oc=Adp9RssFf8yJfYfXm53YyQpU_9lXjUB40kHBAsoMGinTiMWFrNgiz-T0oXS9ZWMguWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2RzCJcV9413vqYVAA3kdqYnqjtTgSoahupd0vU8KOpg&oe=6B032481"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU-2NtU94l4Q7kNvwHGNV0j&_nc_oc=AdpIIYvmksHZCPBPkgyvVjTEZ0U5dkXjUX9XSnVYACwFCX-b8i9ZHKzBtQZ_xFmZZug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr4uBRb6lRji1oS0AbWUN8piIUGas3MBb51jLvXIjAIg&oe=6B031F87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNPt1BIzh3AQ7kNvwFW9jnk&_nc_oc=AdqLWflcby7EII4fA3eKB2GyBQ-QsN4QLIGFFN5bd5c1g2xp5v8NQssrxxP1PX-PnNY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcYmPXZXbW_fSk5cjq7hZZCcbSVpkTjqDyaxQgTwXQeQ&oe=6B03166F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external
om&_nc_ss=7f20f&oh=00_AQSlrzExhU6TlA4xK_7ojDvWA72AyOc2lXX2ckNjagze4g&oe=6B06F70E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVrWVtnXfzcQ7kNvwHLzCEV&_nc_oc=AdqTm3DnV7l5u8sDb4bzes2e7drTIAJx6SVxmkOe1dqVDm-XFaU5anFABqn-GQ71ZvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAU6tR-zxPQcMctF3Jz7xYAmtyyRQkW1QiGyzGnGzLYQ&oe=6B07248E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZeXxHvsgBkQ7kNvwH_LT3Y&_nc_oc=AdroX6H0ySuRM-oQGVX7-8r1JkAebpy7cu2FzADUxQH8WzLBEmH9gvaIPmVjZlWDwmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToKJK1S_8K1QRuzvzOpOT60JNnZmfjkxkw1mAoCxd-8w&oe=6B071901"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMOR1U_pObMQ7kNvwFxjHyj&_nc_oc=AdqJAOMAQHy3kEYkEDGqvmnn7UlW9Hef4lSZSiTgURnZVS8DXGDjBhblR7E893gW7C0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Up2QB0c4fXd5NKYHWuzv4BRFS5qfk8T8UZgv2mJwgA&oe=6B071407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHp1Bi1jbXkQ7kNvwGAjj13&_nc_oc=Adq_8Vn3mi4dk9lPAcpprSFs3M1m3qYks7iyksw7_TeeR7vouqttiTAEkPutWls1FpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5ymmZ00rJN8JhWd1xdQo16-W3UwR0bYcJ8LWS4bqMHw&oe=6B070AEF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
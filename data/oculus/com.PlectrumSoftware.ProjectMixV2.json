KghBkE4IeLWvEno-3dABtBGoDWBIRUuZkeZQSr2lJ85odWqp1-G1pUM-3JBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJtrg6N5bzkwamDS6xjcpX6rVobGA8Royv8cn3n57yMA&oe=6AFF0E0E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S-WOqci-6UQ7kNvwFrncmp&_nc_oc=Adpz4LLY4Z0iGYFPjMJR66TGdkylGJB_QCQd53W7yoKo9hY44uVU1QjImRAyJtTLtis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS117RqR6DrXbMKFYHppfa8-huMB9Qn-mKLeiYqXV65A&oe=6AFF034E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWWcdM8hNskQ7kNvwGt_1NY&_nc_oc=Adpp5wHOTYEyb6yyoNu_jcoRL3M3vn9iXbWVMJQ04O083kj8cxUXwmALwo5tkC_Qz9Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUzh3Zo8Vp0BbRcA5KsLDaaVX_06lpUe_a6tbLKr_dPg&oe=6AFF3001"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCMR4nCZYTcQ7kNvwHbfmDO&_nc_oc=Adp6LHdTGDPUqTOdYntdUZhnar4FFRQfkfZLnPAIIDBCqMVM_j3nLZR_44-L7FdANvo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCYJmvs6fW3PVSSwt5621roWMYPtjWB-YRTyrOzfJfEA&oe=6AFF2B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmNpSbp_NgAQ7kNvwFVPE_6&_nc_oc=AdqvR4L6LJaPovXF8zgW7e0d8nyE1E7HSVv1t210d8MlfFRiDF8BvSwmqrw5nxO1Q74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThcNYgc9Jd4KhE9PX0pDziF0wX3ZLUjHxIh5optx1JFA&oe=6AFF21EF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external
92105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qhtM9u73C4Q7kNvwE6jAIO&_nc_oc=Adqh3g7HydhkzQD9B4AIzeZRYKcWMhgwN74vjCd1i5uoN15mQ86EyL4SXIKUF12Cua8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uY5p3wlUVD87Hm58a12T2JRrcSU7WPodoaSTcwZ0hug&oe=69FC9D4E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JljLEW4THkMQ7kNvwEBX_T1&_nc_oc=AdpbhJtWIYFAKXll8bWSYTk04qqxAjLhviffyqTFQATc4Nzlr_q1RMvdoiJyxbL2UhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qLuTVVI_4Y0NXXYHbRJjedx_6G5n2kqgwiaRW1zrAhA&oe=69FC91C1"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5rhZyWqjLEQ7kNvwHmgjvX&_nc_oc=Adr8bSdzqaL7Sgv3F7t3u9dfzorUoNgiFfl5rzM6TaqK5z49rKuHlr1dHstZhwbY-hY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RYo7DHxdhXjPSCH1XCaOQ9qSsq0TvDbmDsofzfMkbgw&oe=69FC8CC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaKj3yMka10Q7kNvwGesiaS&_nc_oc=Adp3M4pL28nkCP2D9ojQ_FE7S-ECEEHnR4iGHQhjh30MJYXI2xq4PHyLgNIvC34jJLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l0hixAg7id4IlOr-JWHaO7stP5G0ALAVUeajhWd3Tjw&oe=69FC83AF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
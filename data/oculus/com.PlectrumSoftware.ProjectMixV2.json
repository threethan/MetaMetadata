92105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Je4GmCNEgkQ7kNvwHN82iW&_nc_oc=AdrAQBpROktZap01jf9SoTj05IoMKtPexOmTu-vCrvb0nb2m3qsAHWyWiOOFP6-Hqb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwieJW3pQ8HCeaxOVbZw6LfoA_YJxiqbTTApvonYe4Kw&oe=6A7738CE"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJnBaBfKgW4Q7kNvwH_kglz&_nc_oc=Adq10IAzTLJv58-4AqnOyPid5NmYF9LdrWQj4fMbfSp-Z4ioqHbDxyOzAEHjdeAUoc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe5pcoxRI7HFP_DqARxWtcT0AJOh6fMgPzv_NEKEzD7Q&oe=6A772D41"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuKzAP4mXngQ7kNvwEZfx2u&_nc_oc=AdqtiI0k2zHP6yBBhIwmG_DXtR3HIoY7KN5muCMGtxON42iSrXmgWMzJwS_WPpNn4lk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeQbU0of37_6-vUTeQ0dO3kSGCU3U0LC2avM7WSP2vtA&oe=6A772847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGxuLElt9MkQ7kNvwHdyArb&_nc_oc=Adob38S-aOCO0SW4ZTkpEyhnF_ovbuPEnBt_4KQly6kwq8LLo8230iaTa09wazWzYrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQtDiQvWTkB-5gE36a-kbZVLHkJg3Ep549VVMjfPQTgw&oe=6A771F2F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
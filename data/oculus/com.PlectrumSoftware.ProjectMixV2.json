/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8DbdiizaK8Q7kNvwFZ4mVu&_nc_oc=AdopI0eNIbMfBxTy-Ycwkn9Pkuqe2VLKQlrhFilceb-_Vp-1dkFEt0jdwXmPM0pNgJo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxGZnRnpFY5Ra6bmY-ay4alTrXlgsSD1IWv7XQ3Rh-1w&oe=6AA40BCE"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K6iWpctduQQ7kNvwE9B0cW&_nc_oc=AdqxQrf0BTI3lYclGHLVYRzBHFOJ6lcYBdTQqD8OtvsNxqkgMfyswCaJIQPtnOYXLx0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmiPh9CF_zLGoXBfo-polIf74bemmjIXo9ZEXc0SnU5g&oe=6AA40041"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KohE4fr5pDgQ7kNvwEdGaBC&_nc_oc=AdrMHpOwmHprsWZaiWRqapQ2IYtvIgpEnC_xHumuP1Sj4hfWmWWWZbP1P3UeyWT5FsU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRvW4EzYAuy_1A_-YiNYxeohEETp_VFpzHG07xaUT9vQ&oe=6AA3FB47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dYdjbsgb60Q7kNvwFjh7oC&_nc_oc=AdqdIrZkkfsFrWdM8CHNEf8X2iQYg0Ny-Ji7vpuuxEQSKGRo0sF_k7ZT-DrVyLTb8FI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjUiFR4AEK9JWpJqwTkOUZYAg8KUDHSVsl4FEln7diHw&oe=6AA3F22F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mod
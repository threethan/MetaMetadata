om&_nc_ss=7f30f&oh=00_AQVb8vuM7A5bZ-ThReHB8vBRNQP8qgD-8bLZndkjbxmx9Q&oe=6B1069CE"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezQE10xSbWEQ7kNvwFIi2kL&_nc_oc=AdoW0MV4G72jaNvpfOzAy25P539C9fbyZn7LRygMaauBEJTZj6gd3jM9CT8kkdDai54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWv4V0PtZQ-XTDTFq1WfXItXNQdBhEl8W0lbqmn4K29Aw&oe=6B105F0E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz9QnZ9tZBoQ7kNvwGrkzR2&_nc_oc=Adou_cz_4HNY3j9-s_jntK7pu-Yg8VNMKedVMhIUf90RLWbN2AQxnBwVW4rDVo8wdAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjcjr2bcX3sZmzQhgXtBvZhM4K7xIR0XR2NkGWkBCiwQ&oe=6B105381"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO1AUW6WHpQQ7kNvwFyG40A&_nc_oc=AdqI0cMMEIpnO6y-kwalyV2t7SIEFUp35mw4HDwzvyLLv5T9z3eX9u6KODPm9vX0R48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCi30QTw7_UnUCwtbTcP_jWiuGdJelWToWnE5sS5AveA&oe=6B104E87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU1tNDyOnPUQ7kNvwGjE1uv&_nc_oc=AdqsIqKthbUTiQNIh83hoNLvjbgl73hzZAgzFs3mV--kcc7lpIdAgFZdSYdwcAKYqKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXbrmrrVTQUvJERcwA-6xMTN8GnjeloGpjCZ9nu6QAnw&oe=6B10456F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
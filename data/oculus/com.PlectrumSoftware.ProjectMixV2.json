92105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW2RB9mQEMAQ7kNvwETHfxK&_nc_oc=AdrUly60PDL3bndWWp4K_F2mhN1eqKYkHWnNuaGmL4PJsG9jA1FaHoyFlNsWb9Z4jvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhjnWJGT_0es2G-psHWbgtj8iWHdlQHwsfVOuk4Gqy_w&oe=6AF4774E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFeMigvbWQwQ7kNvwFgSohM&_nc_oc=AdqscmxsLHbfLgx70YqS-owVpgzRTJIxorNh83exYtXl9uaFqTAcbpV6CX000bUTPoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgQF7_N_vi541XdVjAT3TDZnJY2npXUH23P4S-R8RH1g&oe=6AF4A401"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEKuuKrxxy8Q7kNvwHKe1pB&_nc_oc=AdpHkV6mETaWdsaNcLiwrHFH9wWG8UearhD3RzS1m2m4B_SmuMnLkR7m54d1TSLVlMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROFEc5c3jpfcTdo1n4oVfPD3Ps2jtMuAx_A_6l71XlqA&oe=6AF49F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JseuQRkJ4qcQ7kNvwE2Nel0&_nc_oc=Adrj2egjmw7dSZuUzoa3Ub_00i78wNyQVqOuxx-7H3C4hGV_8sFc0VZczW3JvVFqHy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpGrCT9C18aIYyiQCc-8eSfNF-0hTnOGjmP6M9XBwUzQ&oe=6AF495EF"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "cyberpunk", "visualnovel", "project", "mix"], "long_description": "\"PROJECT MIX\" is a VR anime narrative adventure inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
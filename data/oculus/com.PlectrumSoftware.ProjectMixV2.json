87472181554", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_575787475514887_1646622721584929772_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=386S05Ln8kMQ7kNvwEhcYBI&_nc_oc=Adn8OnSpisY-wgAQyOS-zbOE1Tsd_7HLYNBTu4IwFxDmKAIsXzazrG4KEM_nqP8O-yY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_5cJxwQM5F9-hjMN5AAxw5-XEmmordryYqPkBmN09ug&oe=69A6D906"}]}, "id": "1190500792535811", "locale": "en_US", "screenshots": [{"file_name": "Katie.png", "id": "464942639944968", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391950_464942643278301_5881837381189955776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V0Cul-7WmIQ7kNvwEb7yMC&_nc_oc=Adk5SBTmgJ-D8WvwpkUKiv-8hWV_2TwTS8wsr7Ax9NX13aUdmpntRjp0qWMgA5sJB3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsxkAxLU7jObdJzLIQ04e2edFLYRGNoFEUSEYuLNfaXjw&oe=69A6DAA6"}, {"file_name": "Smoke2.png", "id": "1717379532547017", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391950_1717379535880350_7240248363106483605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwSSsJ5DmikQ7kNvwGtuOOr&_nc_oc=Adlx8h3O4ObI2Sv_XcAOrfjJBOeBl7JpvpUdCW3BRw7ctP5OQ6ATahgdzA8_QtEvl8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3qXSDFGlE8K2rQQYGWom5P0Fzy59bGQLupDQk9gBdRg&oe=69A6BE4E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6RWKn9niqsQ7kNvwFrmxAK&_nc_oc=Adl4skiq3YLi9AX1iaqDiusib6GATnrO5VOurzPXQGIqkkt1pk4tnGpcsPSNfKkepg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsu-ZKv-b7g6fylXgC2Ccxr1yM-G_AJAvS2fANdBxNkcw&oe=69A6EBCE"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMfT8wSNH6wQ7kNvwEybwpa&_nc_oc=AdncUXo7LQ9cl4PrtqPcPPa7XDcutR_qYR_5JQpalO5gybs3gS9uU-2fnmcR343h_SQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFOQuOI1I1c8u5ycoznj5T6KUcHrrexaM6JoxEagFKpg&oe=69A6E041"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPtN2Txp8BcQ7kNvwH_pk8v&_nc_oc=AdkPpsdZ5EH8oHnlb2AFVSDIrdk4IGli6boTFbR-dHM6KJZ44Ifp6VatI____nPE3Pw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxrvY4K5K9pAgLyBV32dfqgBjKX4u_LhTkj-Sa7Yirdg&oe=69A6DB47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9__0zFgOfOgQ7kNvwFccf3t&_nc_oc=AdlhrV-qDGjtR2l4l_6hHLFgOUDevvLzzilLdvPMnu8udzNU5h8Pmf3dUebsjpl1eog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvaoqbrmjtZdM1dX6ACSmzw7RAO_0t2VcGkVHZnEoxEBA&oe=69A6D22F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9655163187938252"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "832318156132828"}]}, "baseline_offer": {"id": "832318156132828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759356000, "status": "PUBLISHED", "id": "832318156132828"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24501775386183788", "version": "1.82"}, "id": "1170203431372059", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prim
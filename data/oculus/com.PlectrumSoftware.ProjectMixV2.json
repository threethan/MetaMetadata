r-XVq2Y2e1R8O-wuM6tc_CC6zeBc6Y978xgXqMJ_cU0ywYvWb8Ao06Mg1Poo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ17_FFLJPDGBvu2B7qcNpl2VlgVEbANt6NIJbCplE28w&oe=6AFB198E"}, {"file_name": "ValenciaChug.png", "id": "1405901747068188", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392105_1405901750401521_8218559712133967430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YISMv3s7zEIQ7kNvwGIgzrg&_nc_oc=AdoFShogsEyS5GoPHSFoUXqtqvm0iuYZlvV7eOUz-t3OTAxQ8O2zmQMnZdsp1CuOZD0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUWxSVYl3NNKGrDFMrNvkz5wv4DAK8XVewmFL-WVS-oA&oe=6AFB470E"}, {"file_name": "Ravesh.png", "id": "1195370098912683", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392179_1195370102246016_4269287738608945595_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7_WiXoNiHUQ7kNvwHU6meH&_nc_oc=Adqt3lmD5N1gd8t25HtYkpUCAW5Aqv0q6ekCtoLMLZtttd_p_qRhoJ2sXG5b3T_0zR8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZERt6wYHSUe3ITZs0y5wBrdPlNSG-GKPFeFZTy21wxQ&oe=6AFB3B81"}, {"file_name": "ValenciaSmoking.png", "id": "524655703698749", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392082_524655707032082_6513886097047736981_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJe3rEa1WCkQ7kNvwGIwZxh&_nc_oc=AdpVuGl24vI6A0NUPs4J_X4BDSG-Sab1ZSTAnDOO2EgyRK_K_tJOpCdxo_XoUHFuPo4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZKGBO2I3h5y3iTm26Cl0sbXpi8Wv5ZyUqfJoRBAg_GA&oe=6AFB3687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorbike.png", "id": "585871900463233", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391978_585871903796566_5465572897655342516_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMjh6v_nmXMQ7kNvwFVaDNx&_nc_oc=AdrpCMowpruY-aSy-KuMg4Yq4McayzjclmYJ396ymnnMKfTSwOywtYwU_p22xHpp_UY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTaQXE-5cw6MPChhQ7Kly0LZ9J-WitFgd7fWS78SQKyA&oe=6AFB2D6F"}, "display_name": "PROJECT MIX Demo", "keywords": ["anime", "narrative", "cyberpunk", "visualnovel"], "long_description": "\"PROJECT MIX\" is a VR cyberpunk bartending game inspired by 90s anime and games.\n\nSet in the red light district of Mong Kok, you play as Rone, a young former thug starting a new beginning to try leave behind his life of crime. \nHe unexpectedly becomes a bartender after a chance meeting with Valencia, the eccentric bar owner of Eleventh Heaven.\n \nCan Rone escape the weight of his past, or will it chain him down forever?\n{3870781733251121}\n\n# Key Features\n* Highly interactive visual novel gameplay reimagined for Virtual Reality. \n* Choices matter. The narrative will change according to the decisions you make.\n* A focus on slow moments and mechanics designed for immersion.\n* Explore gorgeous hand-painted anime-style environments inspired by 90s anime and 90s Hong Kong.\n* Fully spatial bartending mechanics designed for fun over realism. However, it's not just a \"bartending job sim\".\n* Interactive character moments and relationship building with detailed romance routes. Meet a variety of characters from all walks of life.\n\n{9254888964631456}\n", "short_description": "PROJECT MIX is a VR anime narrative adventure. What will you do when you've lost everything you once had?"}]}, "developer_name": "PLECTRUM SOFT", "developer_privacy_policy_url": "https://docs.google.com/document/d/185F2WzsXF0eizDyfRGscPwqV6SXRCaGLlHpVYhynGik/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PLECTRUM SOFT", "support_website_url": null, "website_url": "https://www.youtube.com/@plectrumsoft", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}], "external
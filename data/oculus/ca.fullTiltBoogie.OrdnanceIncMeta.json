LJGLNJVndmF-6DnSiD0Xxs8u4NkAiCAoLpiAFzgBwa2LjeCIWMunco2dQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKU4kufH1XnAeBrCz2bpKK6-HhmlmNC4IDZkDlUV3eoQ&oe=69B16BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumbnail.png", "id": "2011011619743737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_2011011623077070_743028246335330547_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27VV-iY_tBoQ7kNvwHt-8g7&_nc_oc=Admu38nGwjT7ubnNP4g5A5KPrX9-0uqpqf1fBIuIruUO7sZMXkiIkyVLNzml4ae16Po&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWC1z37ZJ-r5OsZwE8XFeEBeKvcGQsJ6MCBT3OVnMczw&oe=69B15F3C"}, "display_name": "Ordnance Inc", "keywords": [], "long_description": "Ordnance Inc is a VR throwing game where you blow up old and faulty explosive devices using a variety of questionable grenades, all within a shoe-string budget.\n\nContaining thirty levels of various difficulties combined with immersive audio the game will give you the experience you need to intern at a variety of extremely unsafe companies.\n\nOrdnance Inc - We Feel Safety Is Something To Be Concerned About!", "short_description": "Ordnance Inc is a VR throwing game where you blow up old and faulty explosive devices using a variety of questionable grenades, all within a shoe-string budget."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fulltiltboogie.ca/ordnance-inc-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FullTiltBoogie.ca", "support_website_url": null, "website_url": "https://www.fulltiltboogie.ca/ordnance-inc-a-vr-throwing-game-on-meta/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
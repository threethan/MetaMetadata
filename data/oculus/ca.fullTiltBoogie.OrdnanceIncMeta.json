8RpvQSgtpXVMa-9fAVngTZSUSAlATtaAjhVeCafXyUTP_gT2rRiTSE_nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIQPWb_SFbem-PYQWes7tbfBYaEOeW745CqcA_KxXaBQ&oe=69AEC8EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumbnail.png", "id": "2011011619743737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_2011011623077070_743028246335330547_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWAxDrmoMEIQ7kNvwFhIftB&_nc_oc=Adk9--4R2ajSsDYy5c063l4yW-JgOk7dlIN2BXLtOWO168F3zOfQGf2gy8tiz-CNLHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy59bSux_bAxiW9JxKN4m6ILlb4dt-wdBGtQfDN9JyF2A&oe=69AEBC3C"}, "display_name": "Ordnance Inc", "keywords": [], "long_description": "Ordnance Inc is a VR throwing game where you blow up old and faulty explosive devices using a variety of questionable grenades, all within a shoe-string budget.\n\nContaining thirty levels of various difficulties combined with immersive audio the game will give you the experience you need to intern at a variety of extremely unsafe companies.\n\nOrdnance Inc - We Feel Safety Is Something To Be Concerned About!", "short_description": "Ordnance Inc is a VR throwing game where you blow up old and faulty explosive devices using a variety of questionable grenades, all within a shoe-string budget."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fulltiltboogie.ca/ordnance-inc-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FullTiltBoogie.ca", "support_website_url": null, "website_url": "https://www.fulltiltboogie.ca/ordnance-inc-a-vr-throwing-game-on-meta/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
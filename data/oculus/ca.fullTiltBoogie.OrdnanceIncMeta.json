": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25414451534861888"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1425775549039763"}, {"status": "PUBLISHED", "id": "747345914442423"}, {"status": "PUBLISHED", "id": "846296484583132"}]}, "baseline_offer": {"id": "1425775549039763"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770742620, "status": "PUBLISHED", "id": "1425775549039763"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25941426058831097", "version": "1.0"}, "id": "827284653176128", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25261609536812756", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25941426058831097"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "827284653176128"}]}, "change_log": "update notes for v 1(98)\nEasy mode tuning: Easy mode allows for unlimited budget and also doubles your throwing power. This is for people that may have issues finishing levels but still want to give it a go.\nDollar store mode allows you to use ERBY, BERTY and CHERK in all the non-dollar-store levels. These grenades are all more 'mental' than 'experi' so use with caution. Must have completed level 30 to unlock this mode.\nDoubled particle pool sizes on more intensive levels.\nErby pitch correction fixes.\nRedid 'system pause support' for Meta\nAchievementsManager tuning.\nChainManager extraction.\nCode refactoring.\nFixed grenade velocity spiking.\nSwept warehouse floor.\nBomb particle fixes and tuning.", "created_date": 1768513518, "id": "25941426058831097", "version": "1.0", "version_code": 98, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25261609536812756", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25941426058831097"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "827284653176128"}]}, "change_log": "First release build.", "created_date": 1765303808, "id": "25637906862516353", "version": "1.0", "version_code": 84, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25261609536812756", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25941426058831097"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "827284653176128"}]}, "change_log": "Removed audio permissions. Internal achievements. Throwing fix clamped.", "created_date": 1764954466, "id": "25603895555917484", "version": "1.0", "version_code": 76, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"_
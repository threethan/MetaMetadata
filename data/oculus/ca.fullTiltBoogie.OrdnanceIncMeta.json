es.\nRedid 'system pause support' for Meta\nAchievementsManager tuning.\nChainManager extraction.\nCode refactoring.\nFixed grenade velocity spiking.\nSwept warehouse floor.\nBomb particle fixes and tuning.", "created_date": 1768513518, "id": "25941426058831097", "version": "1.0", "version_code": 98, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25261609536812756", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25941426058831097"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "827284653176128"}]}, "change_log": "First release build.", "created_date": 1765303808, "id": "25637906862516353", "version": "1.0", "version_code": 84, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25261609536812756", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25941426058831097"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "827284653176128"}]}, "change_log": "Removed audio permissions. Internal achievements. Throwing fix clamped.", "created_date": 1764954466, "id": "25603895555917484", "version": "1.0", "version_code": 76, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "
uscdn.com&_nc_ss=7f30f&oh=00_AQU995QJGay3w1i5NMLc2o_c8DendMe-F6PfCLQhPwVDNg&oe=6B103AA8"}, {"file_name": "10_tutti_i_pugili_2560x1440.png", "id": "1442248337876585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1442248341209918_381138505304001569_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jZTQXEKeV4Q7kNvwFA8BBM&_nc_oc=AdrmJnzoZ0SezteylChmhndsAAGH0fe5Uo6QfKdUPJlk79BUhzqd37xZp58Wm0puKXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVp2NDUCl8mGhTgiCQNPXLPkUJdZ3irvjYs5HEcF7p6KA&oe=6B105DD9"}, {"file_name": "11_tutti_gli_stage_2560x1440.png", "id": "1004805125990749", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_1004805129324082_1951447428113993290_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UEuQcxjvJsQ7kNvwHVMw9_&_nc_oc=AdoxRcDZ4V1WpG_IG5lFSzZYT_iLPDpLUrT6St694--IGxwKrLMVBk7jbHkC1PnWIWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlo46ims1QxVolrrXJO46C_RzrC6j_Yw7BsEVpflnUuQ&oe=6B104C7B"}, {"file_name": "13_torneo_finale_arena_2560x1440.png", "id": "29498047276467667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_29498047299800998_3446656919293954480_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75tS7h4AVKIQ7kNvwHsr_Tc&_nc_oc=AdqZie8iLqjkZXFH5SWEVKFxBqAcNk03kEiOmOeGlNdIntKbs-Fnk3S5YQJRnXD_9HY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIsZTZj1cszoMC8vwDrSfCV8YgVg0ryyjDHWrGQQiMgA&oe=6B104251"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_lars_vr_v2_2560x1440.png", "id": "3723427484477813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828087_3723427494477812_693199325325828901_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lcczJAjXc0Q7kNvwHwJspC&_nc_oc=Adpy1zJybHSoDUSQTETyvHph_Wst0fGKIGE7SEE3jW2eKWhq7vSlEOt1rStcPfRQZCU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbwSLhqzxPLQQV0Ic3XHRiTY9XcCUgvSXsv5G5OQ_l-w&oe=6B10500A"}, "display_name": "Home Boxing", "keywords": ["boxe", "boxing", "fighting", "fitness", "passthrough"], "long_description": "Bring the ring home with Home Boxing. Train in the gym and face opponents\nwith different builds and fighting styles in first-person boxing matches.\n\nWork on the heavy bag, speed bag and double-end bag, practice evasions at the\nslip line, and develop your attack and defense with sparring. Choose individual\npunches or combinations and adjust your training speed.\n\nPlay Arcade, Tournament and Tower, or watch matches between computer-controlled\nfighters. Customize difficulty, rounds, duration and rules, with separate\npreferences for each mode.\n\nDiscover 42 fighters and 16 virtual venues, from the gym and arena to a rainy\nforest and a salt desert. The real-room mode uses passthrough and environment\nscanning to fit the ring into the available space.", "short_description": "Step into the ring, train your punches and face different opponents in gyms, arenas and unexpected settings."}, {"images": {"nodes": []}, "id": "1093149783546007", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Home Boxing", "keywords": ["boxe", "pugilato", "picchiaduro", "combattimento", "passthrough"], "long_description": "Porta il ring a casa tua con Home Boxing. Allenati in palestra e affronta\navversari con corporature e stili differenti in incontri di boxe in prima persona.\n\nLavora al sacco, alla pera veloce e al doppio elastico, esercita le schivate\nallo spago e migliora attacco e difesa con lo sparring. Scegli esercizi singoli\no combinazioni di colpi e regola la velocita dell'allenamento.\n\nAffronta Arcade, Torneo e Torre, oppure osserva gli incontri tra avversari\ncontrollati dal gioco. Personalizza difficolta, durata, round e regole con\npreferenze separate per ciascuna modalita.\n\nScopri 42 pugili e 16 stage virtuali: dalla palestra all'arena, dalla foresta\nsotto la pioggia al deserto di sale. La modalita stanza reale usa il passthrough\ne la scansione dell'ambiente per collocare il ring nello spazio disponibile.", "short_description": "Entra nel ring, allena i tuoi colpi e affronta avversari diversi tra palestra, arene e scenari sorprendenti."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oggieunaltropost.github.io/homeboxing-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Oggi Games", "support_website_url": null, "website_url": "https://oggieunaltropost.github.io/homeboxing/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1435872642936464"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2342428279892560"}, {"status": "PUBLISHED", "id": "1777548196788741"}]}, "baseline_offer": {"id": "1777548196788741"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2342428279892560"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1516879401502454", "version": "0.7.5"}, "id": "1585609839468986", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
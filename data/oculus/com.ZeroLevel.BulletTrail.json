=00_AfxN_4GWla-2Ymrjd04LliN9UFLeaRNRzW2q6H2cY432hg&oe=69AEB4C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero.png", "id": "1417988505515590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036639_1417988508848923_574210710029545603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRYzkwaqzMYQ7kNvwHXgDgd&_nc_oc=Adlif-zlmRbEsGBNT60GkLc0lYdU0oQzHp6E_ZjEnkCZdQ1vqeWwIyjEYJNdR3C1bp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKZusAGRnHC5a5otm6xAD6Fey3Fy9HdbWEPHOoF69Vfw&oe=69AEC616"}, "display_name": "Bullet Trail", "keywords": [], "long_description": "Bullet Trail is a brutal free-play shooter whose main feature is gore.\n\nYou've got ready aresenal with kinds of weapons such as pistols, smgs, and shotguns.\n\nThe game contains three types of AI that you'll meet while satisfying your unhealthy, violent urges.\n\n1. Static Dummy - A base dummy AI that'll just stay.\n\n2. Boxer Dummy - A boxer who'll try to kill you with his fists.\n\n3. Armed Dummy - An AI that has a weapon.\n\nFor now, Bullet Trail has 5 unique levels.\n\nHotel Arena, Apartments Arena, Boxing Ring, Sandbox.\n\nThe game is in early access for now, stay tuned for new updates.", "short_description": "Bullet Trail is a brutal free-play shooter whose main feature is gore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13UAcp26fVNVxGUlmnTxDvOEqaTMNDc7XXYcB62H4ouU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zero Level", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCAKPvpAYvXDRVGPnVQzsdaQ", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomme
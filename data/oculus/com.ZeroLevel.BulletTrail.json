file_name": "ss5.png", "id": "2461924867325886", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974848_2461924870659219_8702353066692037012_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP_tEAPNHDoQ7kNvwEbnUh7&_nc_oc=AdpdOmYaSziErdVeGBZ_SnfkOf4_DMsY5zvC6wKmL_pQz6GBNfISQ-CrfPv_tcve7Xc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUApIXaxXRvmTepy4HBr1SzR6q-k8GG15Vjo8X4mVD3og&oe=6B103F00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero.png", "id": "1417988505515590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036639_1417988508848923_574210710029545603_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_eSOeJcDm0Q7kNvwE8VEJ2&_nc_oc=AdpujUjyf_0u-XVeMD20DU_dpNZ3O_KRtOlLbK2vyUSbJfUu-yB54_76hN5_ebYJEi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSEZONizodkwPMqlVmVBCw5Y3iOvi4HKAL7LlK_e295g&oe=6B105056"}, "display_name": "Bullet Trail", "keywords": [], "long_description": "Bullet Trail is a brutal free-play shooter whose main feature is gore.\n\nYou've got ready aresenal with kinds of weapons such as pistols, smgs, and shotguns.\n\nThe game contains three types of AI that you'll meet while satisfying your unhealthy, violent urges.\n\n1. Static Dummy - A base dummy AI that'll just stay.\n\n2. Boxer Dummy - A boxer who'll try to kill you with his fists.\n\n3. Armed Dummy - An AI that has a weapon.\n\nFor now, Bullet Trail has 5 unique levels.\n\nHotel Arena, Apartments Arena, Boxing Ring, Sandbox.\n\nThe game is in early access for now, stay tuned for new updates.", "short_description": "Bullet Trail is a brutal free-play shooter whose main feature is gore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13UAcp26fVNVxGUlmnTxDvOEqaTMNDc7XXYcB62H4ouU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zero Level", "support_website_url": null, "website
d=6e7a0a&_nc_ohc=M2yyVqlTZBgQ7kNvwH1ns80&_nc_oc=AdqZtwaV8GNoXIBXQNKoXL3Pqrs1unmJg1IAIpLIvbrI70dvMEXT4y1Gha2N-i8IMaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7syxIva_SXYNALhl15fek3IKoAbm79hEOrCY8S6pX4w&oe=6AEF3ED6"}, {"file_name": "05_Rooms_2560x1440.png", "id": "1602166725014248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654877283_1602166728347581_1351580651237999024_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwh_v4cDG2IQ7kNvwHFMz-T&_nc_oc=Adrk-N_Z_sGEvVeUhrMt1o-f7fFx5qsE4MTWrcifZqdt93Qb3QHG42WY_1s12K50tuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgcqLZ7FQsAvasZij_UP4-z7oqER5-beIYHCNnzkcJqQ&oe=6AEF5BB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RAW Social", "keywords": ["SocialNetworking", "SocialMedia", "Community", "SocialGames", "VirtualSocial"], "long_description": "Welcome to RAW Social, a social networking platform designed to create a more inclusive, expressive, and engaging digital community.\n\nRAW Social brings people together through social interaction, creativity, entertainment, and meaningful connections. Our mission is to provide an environment where individuals can express themselves authentically while encouraging respectful communication and community participation.\n\n**Explore RAW Social Features**\n\n**Social Feed:** Discover posts, share your thoughts, and connect with community members.\n\n**Photos:** Share visual moments, explore creative content, and discover photography from the community.\n\n**Watch:** Enjoy video content and explore entertainment shared across the platform.\n\n**Rooms:** Join community spaces, participate in discussions, and connect with people who share similar interests.\n\n**Messaging:** Communicate with other members through the platform's messaging features.\n\n**RAW Games:** Explore interactive entertainment, including simulation, fashion, music, card, browser, and retro games. Some games may include advertisements.\n\n**A Community Built Around Inclusion**\n\nRAW Social emphasizes accessibility, neurodivergent inclusion, mental health awareness, and creating a more welcoming online experience.\n\nWhether you're a creator, artist, gamer, entrepreneur, or someone looking for meaningful connections, RAW Social provides opportunities to discover, share, and participate.\n\nVisit https://rawsocial.net to learn more ", "short_description": "RAW Social is a social networking platform built for authentic expression, meaningful connections, and safer online experiences. Explore personalized feeds, photos, videos, messaging, community rooms, and interactive games, with a focus on inclusion, creativity, and digital well-being."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rawsocial.net/privacy", "developer_terms_of_service_url": "https://rawsocial.net/terms", "publisher_name": "Pocahontas Music LLC", "support_website_url": null, "website_url": "https://rawsocial.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1420492724473507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314659_2584514925397473_5698039432775220485_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1twuzzsm2QQ7kNvwHLNm16&_nc_oc=AdohdPPyg503ZtO7UOt6rSoKckhhJ9356yEegELmQlCowPmLvucV
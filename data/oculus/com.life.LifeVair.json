26_3429261202004879698_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPDS3Uj4oawQ7kNvwGAvJnk&_nc_oc=Ado0QAvfWYSw5QoC-6nuYKxaMhMF0JnfYRNVmyvCOkrDG4xdUhQDHkeoXjQ4Dr6fhOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1ESfQKw1CQn4CJbvy25VXh_fREMXAFTjO9VMFaEABimQ&oe=69F0BF01"}, {"file_name": "HighresScreenshot00003 2.png", "id": "1358136499494641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_1358136502827974_9023638638628557428_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbTrC-gXiVAQ7kNvwFK1lZk&_nc_oc=AdqdDOoZyyzwuWvR82uBdh9cQgCV0uE_hTps_1CaM36uFvIJFAlZik-oJ5dCzGQ3OzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af02DU4lyiHL-Ai-PisTk_0_elwnDW-1KE3lu8_7pCC8tg&oe=69F0C84B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Life V-aiR - Serious Game", "keywords": ["AirQuality", "Environment", "SeriousGame", "Puzzle", "cooperation"], "long_description": "# \u26a0\ufe0f READ BEFORE YOU PLAY \u26a0\ufe0f\nThis game is a training tool used by the Life V-aiR project partners to raise decision makers awareness about air quality issues. \nIt is supposed to be played in cooperation with a player outside the headset using a \"Technical Manual\".\nIf you're interested in playing, please contact the developer of the game ! \n# How to play\nIf you already know the concept of the game, please download the Technical Manual on this page : \nhttps://tinyurl.com/LifeVaiRTechnicalManuals\n\n# Project maintainer \nPlease for any informations on how to play or to deploy it on your territory, contact the maintainer of the game here : \nhttps://tinyurl.com/LifeVairContact", "short_description": "Life V-aiR is a serious game developed to raise awareness of people about air quality issues\nA external document is required to play the game as intended."}, {"images": {"nodes": []}, "id": "1210646810742794", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Life V-aiR"
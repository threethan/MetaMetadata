r": null, "video_trailer_thumbnail": {"file_name": "/tmp/C1xhyB", "id": "397817811059688", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974529_397817817726354_5123164521132720128_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVCiz1U3ZowQ7kNvwHu-N1u&_nc_oc=AdotA_cD55l2O63RxSRd7lU4H2XDMx5MAxY5lW5D4TxUfuyG_c1SCAcVQm6yVM4eG3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1hE76bo34_R6b7hUtzWLchkrCTb5gphi8OkdtviYGHg&oe=6AF8AE09"}, "display_name": "Ultrawings", "keywords": ["Ultrawings", "simulation", "aircraft", "flight", "flying"], "long_description": "In Ultrawings, you'll pilot multiple aircraft using your virtual hands to interact with the flight stick and instruments to complete tons of missions while soaring around beautiful islands.\n\nKey Features:\n\n- Pilot 4 distinct aircraft each with their own handling characteristics!\n\n- Soar around 4 unique, beautifully-stylized islands!\n\n- Earn money to buy new airports and new vehicles! Ultrawings is a VR game with REAL progression!\n\n- Tons of gameplay variety! Pop balloons, participate in thrilling air races, fly through score rings, and even perform emergency landings! Ultrawings is the ultimate hobbyist flight game!\n\n- Full VO support guides you through the game!", "short_description": "Use your virtual hands to pilot the Ultralight, rocket-powered Glider, Sport Plane, and Gee Racer to complete a variety of missions across an island-themed world!"}, {"images": {"nodes": []}, "id": "1034412625418141", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings"], "long_description": "Needs text", "short_description": "Needs text"}, {"images": {"nodes": []}, "id": "825006767152947", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings"], "long_description": "Needs text", "short_description"
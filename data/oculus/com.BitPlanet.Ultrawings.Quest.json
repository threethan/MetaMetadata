gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elpAQ9RWIOgQ7kNvwGikA6f&_nc_oc=AdrI2PYy0TcuJ8XvhvVJdlwnK2znrCQ94zc8a8t3--eWseIMiOYTKDk84Z81wUa7VlA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBIi1HrcJON85vqtbPR9lwpp9F3YMaC32qB1c-LHjQog&oe=6AFF0C8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/C1xhyB", "id": "397817811059688", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974529_397817817726354_5123164521132720128_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJRdsiTvrZYQ7kNvwEorn8D&_nc_oc=AdpCMXkIQ9XZYTpHwzZxvCaHuxMTXI2qVVMxFBz02iyWh6SSpVqOEV6rOmP6D6Im7hM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcmdsPkifLq22eeMonhUNljGUSmv-j3NRaFum1l9nsZA&oe=6AFF0D49"}, "display_name": "Ultrawings", "keywords": ["Ultrawings", "simulation", "aircraft", "flight", "flying"], "long_description": "In Ultrawings, you'll pilot multiple aircraft using your virtual hands to interact with the flight stick and instruments to complete tons of missions while soaring around beautiful islands.\n\nKey Features:\n\n- Pilot 4 distinct aircraft each with their own handling characteristics!\n\n- Soar around 4 unique, beautifully-stylized islands!\n\n- Earn money to buy new airports and new vehicles! Ultrawings is a VR game with REAL progression!\n\n- Tons of gameplay variety! Pop balloons, participate in thrilling air races, fly through score rings, and even perform emergency landings! Ultrawings is the ultimate hobbyist flight game!\n\n- Full VO support guides you through the game!", "short_description": "Use your virtual hands to pilot the Ultralight, rocket-powered Glider, Sport Plane, and Gee Racer to complete a variety of missions across an island-themed world!"}, {"images": {"nodes": []}, "id": "1034412625418141", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings"], "long_descript
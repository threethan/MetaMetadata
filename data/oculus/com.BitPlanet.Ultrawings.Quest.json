u65oQ7kNvwHdfLsv&_nc_oc=AdpQo_m0D5SmPNH05O2P1Q95iSDFQvzqZ7y90nIVyGpL_ybDer8cC8rrj1d_dR9H_dM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCeYBFIe6ifKSM3eVlNo4PigQiU5pa5OurBaL7_syfDQ&oe=6A897F89"}, "display_name": "Ultrawings", "keywords": ["Ultrawings", "simulation", "aircraft", "flight", "flying"], "long_description": "In Ultrawings, you'll pilot multiple aircraft using your virtual hands to interact with the flight stick and instruments to complete tons of missions while soaring around beautiful islands.\n\nKey Features:\n\n- Pilot 4 distinct aircraft each with their own handling characteristics!\n\n- Soar around 4 unique, beautifully-stylized islands!\n\n- Earn money to buy new airports and new vehicles! Ultrawings is a VR game with REAL progression!\n\n- Tons of gameplay variety! Pop balloons, participate in thrilling air races, fly through score rings, and even perform emergency landings! Ultrawings is the ultimate hobbyist flight game!\n\n- Full VO support guides you through the game!", "short_description": "Use your virtual hands to pilot the Ultralight, rocket-powered Glider, Sport Plane, and Gee Racer to complete a variety of missions across an island-themed world!"}, {"images": {"nodes": []}, "id": "1034412625418141", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings"], "long_description": "Needs text", "short_description": "Needs text"}, {"images": {"nodes": []}, "id": "825006767152947", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings"], "long_description": "Needs text", "short_description": "Needs text"}, {"images": {"nodes": []}, "id": "822340276873928", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrawings", "keywords": ["Ultrawings"], "long_description": "Needs text"
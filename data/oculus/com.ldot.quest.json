pBrVz4FvHHLLjMVzu_yPy5A89KCeP9MdUj3yi5OalJ3jTC-mdNqDiCR9IsqmVa8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvE3WHT3vxiDJuYNgMCiEaG2IYB1ZrXijoiYaiM0WEQA&oe=6AB2A614"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTopRiM2SzgQ7kNvwGvW7Xo&_nc_oc=AdpXKQzF8KRPq6cBwxi6qQho1-KYQh2i5uQRODb3WdrbtN4bwFNlDaoyJ9EpM57UKEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqlz8qXoecg_uQ-Cwf-nqFOSajVP8NTk5-VJXMLXLOEQ&oe=6AB2932A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - FPS Shooting", "keywords": ["shooting", "gun", "fps", "military", "roam"], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Abstron Pvt Limited", "developer_privacy_policy_url": "https://
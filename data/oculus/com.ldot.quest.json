eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bylXUaD-qX8Q7kNvwGpvOxi&_nc_oc=AdqbMdIf_BC0qHrXGiKYzQcqpQtCZElRZ7WmCFPsAKTKxhmTMGFhIyRD3lhwkGzbBSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9p1SadJtIRdMkM1fD40nXZsSmcy5uQrYIaIcRaZyZmmg&oe=6A3A9393"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41ni66CbrUkQ7kNvwHZU4V4&_nc_oc=AdoJ9hOynJMQ1HljDu1Pwe9ROEIQuzjbQ_X4rcYJuVOerbbMaV8kmQoC9lrH5ZDLbd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5XKrISvyICchmrUZTZwzujYJdQIj-GEj1wdpbhmn73g&oe=6A3AA547"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YocBlQDi9a8Q7kNvwFAKU-X&_nc_oc=AdoqIndUwrrSQ1ADvXGwb8llWHXpWy6iRa5BQsiAin1gqdg82MFIndSjBHb2XMEjI4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wx3y0sX0u5w6t67oFukQGf8cyYNTmYgTksin22SjA8Q&oe=6A3AB6E9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDs4lrixCmoQ7kNvwHfDEps&_nc_oc=AdqcOc1K0W8KruqC91ZgpxU7VRnJ59ca6n2YCTodIVZIYZ4_GIef97blE9emblCYk-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-88xRn-Ji_3b9PC6Fe52N76Zi48urt0VSg0SR4Znyv6g&oe=6A3AAD94"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkKAtHfH27oQ7kNvwGEntHa&_nc_oc=AdrGKxddEphnqCDc0FV73hE6mxK2IC0p1vEoSKq8Emr7nQW5o3sfV3G2hTYSE1rN6JI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YM3wBgtjYiFzg-Ga4wEBsQ7kGZN7NkGEsxOUacSyEIg&oe=6A3A9AAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
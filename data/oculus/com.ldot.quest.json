eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL3E7MjGxMEQ7kNvwFqSjGX&_nc_oc=AdpaxKM2Ysn8KXbbtBXFwOkc13QAFW0B1cOTUNArFy3JIGTYROnpv3BEOKyHX7VL5Go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DOH2-58oVF4w1iWD_wMHsQ7ObH59LoRR-5PyD-tqztw&oe=69FF4013"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCqu_HEwxGgQ7kNvwHYeM3o&_nc_oc=AdohZOb58gCro6bXn75UaXsIpW8NXiv68vh3BYN58-GwYTboPYx_Dd_LmnygFVQuBpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Td6Y6iRtUggs2qTHjFsCYobPTHbA6gUmyoiPBa-tIXw&oe=69FF51C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9BLafFhkQ4Q7kNvwGa4ahI&_nc_oc=Adpz5LzcTVqiZs6dU0bi7xXtx8DaICqQYZTaboyMu54yQ3EW1TZAbPD-vH89LhVwyUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43y-Z5QStwC5ZYNw5Jf2cN0trzIBT4W89ORJQS2KSL7w&oe=69FF2B29"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snO2s5vXE9kQ7kNvwEQcTV5&_nc_oc=AdrUhT-7O-4nBgo7K-hebhzEdpu23uHAJgNAgs8Rdveo-T6vhRVdR1hgTQDr2UbhKtk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fctazlu2p4yec2tEMEDGfDVtlfMz0PdbqXdBcTb8u6w&oe=69FF21D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVACE86mQrkQ7kNvwG41BdG&_nc_oc=AdqCgupf-KvBd7f7OqC34p4Jwvjq3Ye6IOtAJUIhCxh4gTaL3lxnY4Q9Hm0xIgxwymw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61KhIKMTNau153o3Tc6NwQ-31CI-GatQnQQf4atBjw1w&oe=69FF472A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
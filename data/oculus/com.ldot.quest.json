eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yMxvPLpMMIQ7kNvwGYLMfn&_nc_oc=Adp1gtBPl4uoZk9v-CAkFeMgh8rPXA33QzDFgxomynn-iS2rRWYZoVa8ot2qoC3-pL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yCOv-BBrxmEN0ZscZzJMM4KtpWwL8jUwwhSVJBWDKiQ&oe=69EE1C93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrKqz6yKr3MQ7kNvwEPkYuT&_nc_oc=AdpFuDEC98sPQBvLogvfwXfj_nY2xUZI_91R_cKM970_Bayij_VPQtVU1W4CVWFrR7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M67HrW1or7lAqa2Muw9K0fFrTYuWdVRgx0IjpGruyAw&oe=69EDF607"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8fFpjZGMcAQ7kNvwFctlww&_nc_oc=Ado0OekZV3znhSd-0feYVhGMwJnyutRy4DKcYSO-DIhHH3oYlrvhRcRoNV-cBNU11Ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-0zprKb17jmLgPRfYVWIMNp1blbcRkztU6627eM95IA&oe=69EE07A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qPT2ffZv4UQ7kNvwG9yrmZ&_nc_oc=Adowf_pHc0xx9Mz7GfD3BUDK6kk9Nnmam4f8GvMfaHOkvO_7bVSAI9eqXQw5zshYxQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24S6Unxp4TSdaZVPVm1qM0wy8QwQZE7o_nRjqGizoDuA&oe=69EDFE54"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L527VVcVa0Q7kNvwEZZZQQ&_nc_oc=Adp_jGfbxXj-IVXKLSz0ME2KKS8nbshTcLHjIl06Mxnuk9E6Xk6L0BYAIeNsIua9Ego&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h-UPbNCFlcCbDU95jVFrIvW9MLIaT_i2M5A4w1kaSeg&oe=69EE23AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
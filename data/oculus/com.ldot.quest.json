eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZeQ76gvT08Q7kNvwHt_fS8&_nc_oc=Adrm_2Z4SVrd_gxeqsX4aCZcjQR_xfJ8q1a8bczJuo3GEwulxLunYxqLgDY_xtG95II&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeHUsNBhzbic83fxSX90_cx35kFaGIUGhF8cQkyBXCxQ&oe=69CBD593"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxZ7im8k2mwQ7kNvwEv5OwD&_nc_oc=Adq0Jl9GKh5TAV8p_dGGltRI8-cwhakr9nnL_5Pl1hpYDQU_VBJR0RzmI0FBYl_oKVw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxZDtS_ai1mj4U5uV1WgYvE7c3z31HQNUmbP300dRSpg&oe=69CBAF07"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWiJwh5Y2w8Q7kNvwEmJVi1&_nc_oc=Adrl8NA08NJJelTcaVazd12434c6gnio97rzXO4JAKYV2YuS4LxpoG5AuPHEPt52xSY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPIikYAljmDQLfCMdoZYNY5QPPY2jI6TwfUryJL0k1kA&oe=69CBC0A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqBjIM0vorMQ7kNvwGUkpnA&_nc_oc=Adq73nGk8KZP_3pAZpEpzDDeFX_AjBH6ANzp1DDCOdA_61-KPZVVihn1bEeZDRYGEyw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyr2DV-bkbreZUsWtLMKBXbnHGjrc8SE4uqlaPq6qH4ow&oe=69CBB754"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJNuzT02k7IQ7kNvwHZlphW&_nc_oc=AdoZICe-gzZWzZMUcIuGgQtag6IQ4pwcS3bTE-JNCcTJMyzt7078M8xFZIYfNghbBQA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaE8wbGNyBw54wFGMsNshrsohKWx6Eg6gS0qhsvpEwJg&oe=69CBDCAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
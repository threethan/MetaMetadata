eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaSNIs3ivpAQ7kNvwFxBGEo&_nc_oc=AdpKcJbGB1M3ZFCrR5rSr2miC7rTf66U_jcDKM8T1W97qDPVmC4P6zi8AERDY84oTIQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20ljC0D_X-5PHCfetdHVt_OZf4FPAi1VsVHKYRZOQUnQ&oe=69E63393"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQIGKz4qNpoQ7kNvwF0QPuo&_nc_oc=Adq5C56O15terEG5S5yzVyDiQGep5SLE9TpSQKVDiweeZDpMQ6RSsu5HIYjblWBin7s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_EnppqyT0U3XZ9uqQSlioO5W09WDSI2fp0znRI4wCRA&oe=69E64547"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0fbgwfdYm4Q7kNvwHYRidF&_nc_oc=AdreDyy2etGcrzrXOeffs0v27zhk7wH_44_jwC7OcuauuM9xdEnMPCI_2NSXdBPyUMU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xX_InFmoBllpJFZ1LB_aWBM_6hHfK9xFCcrDuPrtS4w&oe=69E61EA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnxMK27o8bUQ7kNvwHvlsXa&_nc_oc=Adraq-htXVVwbKXqY9u9oS9yoOCMVbH70-B8eNEodb86bC0oZ0Zt3PqO3NogkisuZJg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jUhj1AZA3w-L4tM_g55ckjBAv7S9r92Lf-SwLTPQMYQ&oe=69E61554"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmNYrW7S52cQ7kNvwEKarFl&_nc_oc=AdojpQKOhL40-KyqiufrmkkfFNEuitfBKk7HUq_6MYRFwIkRBa1E-A4t3QD-fuU7k9k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WACAeyn3M-FsFPIXiZbtNrub3NwLjXVmnMM9hakWT_A&oe=69E63AAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
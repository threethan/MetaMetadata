eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaSNIs3ivpAQ7kNvwHceA9l&_nc_oc=AdrBzBm5YJQTcxYw_8u6BF6CkYsDJF2ox8Sc_x-XTvy-4y1Va104ije31JIYV649uFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m6Cm3UoRzKzWH7A03hmm9lnSWVlW8h3JXX6me6wGPnw&oe=69E4E213"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sstMU0sZfTEQ7kNvwHFFKUA&_nc_oc=AdpeyKv25DYqNavNPAvYO3nt-MivQR4hZebdXgGh4extl0rnY0kN7Cnp7HvcngNWi4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nmYSjWoR3BggrPhUPOvl7kl8OwKmtOelqWZM9FYRkOQ&oe=69E4BB87"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0fbgwfdYm4Q7kNvwGpKtSA&_nc_oc=Adr4mzYFNEIDIsdIDFdVb3OFaspRU2tUZWee3vcTQ6Khw0lW6L4EP1zos3xVHedS-eA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JJMmFUcjTtoBaf0XdZqLPDT4OCJIuhhkpnaH2LytexQ&oe=69E4CD29"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnxMK27o8bUQ7kNvwEeuWor&_nc_oc=AdoG_1-CuFsZDHykurakmUVIosZBM_m3agZ7lxk41oo7ySwpLLOpXKClIR87sYTKQH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DLbzvCc0VvgaBWNmhiDKZ0AvdJx4d9NZ_vYRevNAExg&oe=69E4C3D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBRsZK-CBC0Q7kNvwEpnuoI&_nc_oc=Adou4Duq-K0Jc3ML7J-zMpdzRVPec2avxr3QgoI7mTq0E2FgYC9SXdCTWtqirl3krU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dwhjVmyQW1ATxz6FuMzRKT4ef4yxvTE7Tiq4C0mMSAw&oe=69E4E92A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
1zHxSweE4zHjO4XvDlWrYCmcHELuRPR2aBeJXCvYaDXMClkwlayIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPOMgzK0BJP8tnMFYjaBaND4bc11iO0nGjqGMffW-bww&oe=6999BC93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00KF_cye6OsQ7kNvwGH5FIT&_nc_oc=Admd5txWyi3Blum4LzD8ZfnrrZf3hw-5ARhAV_6O45SHuc3bmZ_Ma318Lk5u2oeIXpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfutRaD1yF-ao2iYE10NSZUVoblpVO4H8beujLZ6X5nkwQ&oe=69999607"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rPx0s5QETsQ7kNvwE_2J7h&_nc_oc=AdkHjKBQd5s0Bc9G6fv_MLyTl7zTbvEfxDFj8OJ7kiZpeiSPpzrkZ3fywEFV46m4MFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsyIyekty1wqDmoNuwEUbZlEQDfGzPdIuH6LvI7oCVjnQ&oe=6999A7A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iS9k2SNokm4Q7kNvwGKqvEK&_nc_oc=AdkfNd_daJhoSNF8HwRh1sIqVKVW6oRvuENnDttIe-2-o__yXco7trTkHEwafkATy_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNqeDFJ9YNelcAwSAu6oYsvwHT7dtFua-Bh60W1zXG2Q&oe=69999E54"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBr9kUiaKHIQ7kNvwHyDXyC&_nc_oc=AdkenNnBhjkhQ1TBMjffdL7hBrUr5UReXiTldihHvV0OqWmRhAY0ANF2rViewGNmUZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afst8V76L7DbDhqsXBT9OUMmWIOFPCXkbFb0jXln6YDIRA&oe=69998B6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user
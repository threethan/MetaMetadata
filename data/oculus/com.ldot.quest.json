eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO8fO7BvascQ7kNvwHv4yn6&_nc_oc=Adq0efgrubzVDK-4Kiat3GkPJvZ5B8Ig2WE-JCPi9N1-a6Jv4Dn8DZaxPxLM6rf8Glk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43Le30ovXJ2grJXL4ldg6xoO5byw-fzyxhU0C4K-r_8w&oe=6A048613"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n5hEU3YxggQ7kNvwHuXOFa&_nc_oc=Adpan0S0YPY3ceWgEugoBx4tPG2MpVXMrY8JQcgRuer6ehG36dlRQQTMNQyfHNcVciI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zlI0Hkr08AjLFH0zFPCKRCBbgB7HjDxsT3-UdUMCKzw&oe=6A0497C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4AeLi3j5TkQ7kNvwE8f8Qh&_nc_oc=AdqP1603pdiU_Onby3iEwCylSYwA81AS0_sYivnPz84eAyuHI-ylPmNEaWnDFz6wS_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bLqJZsWWcbgxgHmB78Qeo0znWxUUGaWGdt4-8DqlC0A&oe=6A047129"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ertmJOp-4WMQ7kNvwFLTi_2&_nc_oc=Adp92Ornl87M5kFWFOCzlxmcefMoGAWP6-EKAJKRcs2juFrdqgrPBWKCv47HsrEGWM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af680EmN4eMwxn-bQp4VEekgn6Z9qdUbtAFHADegHci6Tg&oe=6A0467D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FLe9IDNh-4Q7kNvwESr8UB&_nc_oc=AdrjvxS4bB2kR_lI4LKoYu5qeky3EM_RnnexL53B2ZofEoUlbkDEOV-GlwTiD26klWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PeiuJ_RgTidUr5PBc-kTmiHuvbFWb7qlxVBZFQEjDEA&oe=6A048D2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
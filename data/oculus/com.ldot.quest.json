eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yMxvPLpMMIQ7kNvwHocs_5&_nc_oc=Adr0MQ_oQzut8uToSObE9V0DJ2of48y2BeKTAxj2mddCkdKwtdmv0d2v5F_FzJADjHo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37wEP7LuzzbIfCT6QbYsN9U9KyVuZi6Pef5A3c_NtxDw&oe=69EF6E13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrKqz6yKr3MQ7kNvwE1rcnM&_nc_oc=AdpILVtM3m13mazgqM9IgIDiRcZnJYdZgzMUmgY5NYBCq8YpoQndNH1zSvzd01sLNas&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2co-I--CeLPSSeF0GiodL_uXNqJFLPyuWJvEmKYtmB2Q&oe=69EF7FC7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8fFpjZGMcAQ7kNvwF3cEMM&_nc_oc=Adryt25tuchLBVghLCo4pXQ5yWLlh9Y_nFIbSyv0iAAp1oI4V9Qvdixf7Ig2GKMpJGA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3D-51uapHzw0R-ICIyESjcpCWCssJSdoI86QE4VQRCrA&oe=69EF5929"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qPT2ffZv4UQ7kNvwE9pCUs&_nc_oc=AdqYD1Lug7RbCgQ7oi2jonSe0U8VRSiHY9JJESQXwmnvTH5EaiL8EYDR9IAOQMIhQ40&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af344LCB0SDKQq7-WpvLMnt5ytruqaBm369hvXDWSZFe-A&oe=69EF4FD4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L527VVcVa0Q7kNvwHX1zRn&_nc_oc=AdoyFp8YI6UyQdw7-dzjwJzUzAAJnjxLaDIdpPX272CSNXtUdavM_s0A-aOjKCOx8hI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25Dn33yzvbJ4jX4tP40sQPBGP3u1bYaY-utsofnHl3gQ&oe=69EF752A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
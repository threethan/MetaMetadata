le_name": "02.png", "id": "283204040424008", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cCaxcaUAmkQ7kNvwHQckE0&_nc_oc=AdrHnK03twHKLK7joY38bSGUwYtiXgvtm5rxRdTzHGr68CZco7W8WIdVwWHDSzANlK0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStMIvvat5Bw5Nf2XE-eqH9zVfnuQbKbGtbsCUuEGoYCw&oe=6AFC7A14"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61_4dU6DWswQ7kNvwFrfhvq&_nc_oc=Adp3uGqNcD9t1DXCqj1I5qJaQ4oQun48Vk0a44Iga3mBOdkrAFSm6RZVzWLv9wVi6yI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbZX7eadhSRJ3wLnFXw1QXpfCDUJ3N4cny7zsSqBCF7g&oe=6AFC672A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - FPS Shooting", "keywords": ["shooting", "gun", "fps", "military", "roam"], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Abstron Pvt Limited", "developer_privacy_policy_url": "https://skippyapps.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "http://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27908104832181077"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499311585_974893262274849_4417787176316808846_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj8V12UqwdoQ7kNvwF0jrAa&_nc_oc=Adp-7XytWPXt6Yxefkwx2GlOOWmxvv4pxkCbwl2E6GOSXlg-NUHi5EyfzcDAprq51gI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7KtJIxPHx8kdIZpSdK6t4MIQDPtDl4MGRxUggOBVqeg&oe=6AFC8BB0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Day on Tower - FPS Shooting", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "45
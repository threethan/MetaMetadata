eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBunK1ZxcS0Q7kNvwGSpb7m&_nc_oc=AdrDD-JzcHWsESYw2ja-NZuIH9opThlluJTYhPzrO9HjT5s7Wy3iy5QWxABMxY6n17Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mfMcAZJmPIgYrkPH8OLBNApsA78bjVDsIqI4aZNxmoQ&oe=69D90493"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJxWr5rYtM4Q7kNvwE4XEEM&_nc_oc=AdoLkUL0d5Ph9nNcUYL5QldRM0NoIHiLcGVclzII4EmhttLaybqbUSYjQZQfGt1XxF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wlAZ9rLLR-RZRWSEiE6UsH58F1Kv3X0F6GkUy1JB5rg&oe=69D8DE07"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8svWB8EmQoQ7kNvwHAqyF5&_nc_oc=Adr2GYiViOsuuu0NVhJZLoSVUWzyskjfwXpOVSBqsXHru-FRw1S0q8vMzKnNyUr7FuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EnZ2GQ5cEioXBEXnKrfVaidbZ5Cd9hbjVpj1EiulxxA&oe=69D8EFA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDw-0-9oh_4Q7kNvwGrcI9B&_nc_oc=Adpqg3aHXHlvtVLepKGkklDyi9RelmMDuRq-4Ea7PpAqzbMWyfpN6mY6F6DoJSQmGXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J7aZm9AsfT3S60zsKK_EjXVlU7x_6rQpchpgHUasYgA&oe=69D8E654"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF17l4Zr7LkQ7kNvwG2GScz&_nc_oc=Adoh4I9-DUxoTKLDX33ux1-e5XZw5qGkLJ4af8_6Jvu5i1h_lBn42dsl7gl5x6g4SfQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ivC4VZahMUFpS7ZwYKRGkpEs9QyNWK1KDuXgCbHRukA&oe=69D90BAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
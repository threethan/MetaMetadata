f20f&oh=00_AQE1RjoWSE_9wCxfHdkDJPoo692OjsQldcZ42-K0pyjsqQ&oe=6A7B2D13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b4q9d6EyjgQ7kNvwFGn8d7&_nc_oc=AdrJIHLUrny0CYrY-QmMZToeLL50SP66xN8tNcaiskRm4chJ2vNvorz0gYMiUiwW9aU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHur5Trn7klMtx4OsRwD9xvMzxqRvRXQZcRIOBZkDzlpA&oe=6A7B0687"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLINiJD6OvcQ7kNvwHb541s&_nc_oc=AdoNwwvzGb-Urc4EV9uRsilmUIfTT4RTJUeQuGgM3cbp5peU22rax6Dss8Y-sXxVYPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbH01t9Pgv-BV4J5rAcZmCIZg-ikmf0z_zorWsRkiKEA&oe=6A7B1829"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ne82ykhJmUQ7kNvwEPT_ak&_nc_oc=Adq9a7WIYN7snsTYFzxhiag6GcwoftZoEHCM9Zz7gk8y--jB8vMjqyExNB-_LGXo0Ac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVhKt7l7jb7tg2EdELyEw9LPEeRrvTvw9U5uY9GkO4ew&oe=6A7B0ED4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU-e7MLyraQQ7kNvwELRkIc&_nc_oc=AdrUausbCV4aYrRNSKRpynzjit6MNwuveJt_lLraAlhFGVShJ8FvPGZpQD9OJpwS0Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBMxS-Qy6mJbD37iXAUqZ-HOM0Smqx53QCzCMCXjUJRA&oe=6A7B342A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
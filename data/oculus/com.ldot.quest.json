BXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gJVmj_xlfrA5r1WBJ7qjwid266XoVrrurkUvOpLO1Dw&oe=69EB64A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y0ps9cz5J8Q7kNvwFvfJBI&_nc_oc=Adra5r8rcFC93JP2TmvB7lMG01eaKRZnQQzaMGETPuiI6ON4bA3saTwZgnZW84oSXk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34bdmzb8NWVwzMeH_tFInhMIRigajXeMCrsnGViAzkFw&oe=69EB5B54"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcSVdZquyLIQ7kNvwHo3CLv&_nc_oc=AdrwqXS0F7jMrn-D-ehLM3R7bhkOrTyOJkvRjZ-Jiw_SSb64HY-l5sAWqO8bawhGQmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rxPHAMYCQy0Kjk_p0sBz9s2HppeuGlO1DOG5rv1ap9Q&oe=69EB80AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - FPS Shooting", "keywords": ["shooting", "gun", "fps", "military", "roam"], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Abstron Pvt Limited", "developer_privacy_policy_url": "https://skippyapps.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "http://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9409654695786038"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1527184191525465_2596305196350340176_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiUmMMyMapcQ7kNvwH5UV2L&_nc_oc=AdpOtue8lYFOmNEep3Mvv3zetcsFpfdF2Rd6YeGvYeBQ4QStGmKOdoIFCpsH1FOkSRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14DCbZ1032Qz1hhyzNH_1wmyeYRfWBC9HoZtSlrwMnvg&oe=69EB7739"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Day on Tower - FPS Shooting", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": 
f20f&oh=00_AQFBjuQJLTpaoc3eQc_akhUOSCifEWkqoGA352Q_JcWKDg&oe=6A75E713"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_2Roh-6GiUQ7kNvwG9OS80&_nc_oc=AdoMAbGyzz9HgZ_UovNM55zlDhlgh6LBHuT3I7pYYxSPoW6xj7ZLhVr69DXzBaaswms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDhYLiq7dcexrH81RsZOd89-PgFZQKrIEbg-vZ9g9PLg&oe=6A75F8C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0TyvBj-87wQ7kNvwERnxPD&_nc_oc=AdoOkTJxqyBoP8U0CV7l-d-YRrLxt-8LNvjy33HRLhsej_cb4cW2F8fkFdrCSqNC328&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs-KDsdEDVSpEGNuMd-auYSlPJ2L89EVon3xY07-Si7Q&oe=6A75D229"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIIZiwwMr8IQ7kNvwGFwB11&_nc_oc=AdpY7sOPUJ0adn_OoFewxeKhhIDMG31TqifJ5jXyZqd3aFSE-maejX5oOK8sy5Zedeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH48Y_p-ovMUwnpPR86u-xuXE8SKNUUqeGj9xXczbwoXw&oe=6A75C8D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH1jlZ5Jr0IQ7kNvwEuL5iw&_nc_oc=Adpp1SbfCg-lUGEl0jmgQ5_KvsXzn5aSJHXIQeN6NRu45qmEmcuZqgzaTlD5w093nOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP1tjOmwpUm_eyyE2JUT4l2Qcl4IQtM6AqYfynSQxDUw&oe=6A75EE2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
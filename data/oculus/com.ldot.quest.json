eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDZo0HfL2YUQ7kNvwHB1HV-&_nc_oc=Adof0b3MzSlEfIk7q2mUmcWX92HBmEA-AS9e4aqFCnAmWSd0yGVKc5xG54JUYmCuoL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KKuRBOnnh6PjQhKd4YvNsjrSx0HASnVlcS5IPQPBJZg&oe=6A145813"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JXu_jtSbgMQ7kNvwFgWLps&_nc_oc=Adro8YoH_tGsjEYfFf_CH6vBOHK0GmKoJ5_42wRe5Sj8xt9tKnlM-_aFErIuuUkv5Ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VcOEeAOrxeKhI4o0pBSPdKTTn5ChU6adq2uTbHiRXwQ&oe=6A1469C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Znu4q0gvltkQ7kNvwHlTTii&_nc_oc=AdqCq5sWwJuRrOq_9xksCkzES5OQnDsBul5vdJ9W0pTFarCDMt_TlcsJlJT02TJU3nI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af550IvPbmuscW4owLMT1ZnKltMXI6AmVhnw7xtsHukWbw&oe=6A144329"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk6Ipb8Uf14Q7kNvwGbqX18&_nc_oc=AdqVWl4ysUSi3ZwLzjDmivUL4WTeiMk99p5wH7IMhnJVPsvRR4Elz1dgsCQCs5xDBbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b1lkPgsW2ozyk77ENiQQm5tvsO1Gq1QR1RHel8eiHjQ&oe=6A147214"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h5s4JPkV5EQ7kNvwHos6qL&_nc_oc=Ado4o5g90wzfxzwQQaJehrnBHN1ZQYblNz5mQOPrl3qW36gAfX0qT3tcYjWM186Y-BE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vEylOq-DEI4YvUfgVltObObWLuw7NxZ-80KtaFl4vSw&oe=6A145F2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yznr7pnZ7EsQ7kNvwFRlYTI&_nc_oc=AdpwF3QJT0kUVw3sckYNhFhlx_edmo44yPVf11fjSxs_dQ5lagtDSxT-tPNnQ5IqBPQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v0LFb2Bm14QBpd96OizRRG7hsDjaXFjnFdPco9iNkDQ&oe=6A0C6F13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APtUuwuoG3wQ7kNvwGl_TMd&_nc_oc=Adr4tK1fyo26nr2W4hhU1I1w1zcRoG5V0eK2Xo8gW13x4Hd9Sm6pQHlh4O6M12rnKFM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fbZx4_nDww9zSFe9EHn9ZdVwp1rTD5yuZi5_KWxNT8A&oe=6A0C80C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTXH83Cfd7EQ7kNvwE2WNPY&_nc_oc=AdoRiZ9XhapvWJXP5v9BVUGBvNUAoNFUU1mcgZ6BhW-rX8K8J_0zA9id94dJZcna3OU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4er04MPePzR1_8Tb_qsLtv8y3QpuzEHudyYPReQSR82A&oe=6A0C5A29"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxcQpu5FjNcQ7kNvwEl4lfV&_nc_oc=Adq52B0pegvuP-HiNH97VFnBvnQ5m1AUBXl05HqgO5Esdx3WYvGMLLNFGoBaPH9-HU4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OzMEPGgVeHq5W4YGTQY1IQ8BNTgLoO6-XR7BJ6I5MtA&oe=6A0C8914"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkCP9k8l8zcQ7kNvwF3D5A9&_nc_oc=AdpP6iAeyzcXlzwqFOsQJBNLkNv2CiUA_GcRR7QxO8IqDjO7TQNIMZ5xzU22PR_oQbo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jLXoE2M90J1PStvrypSCcxRWan13CETqak_2uDW4HIg&oe=6A0C762A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
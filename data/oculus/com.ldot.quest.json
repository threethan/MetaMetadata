eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaSNIs3ivpAQ7kNvwFXsxsL&_nc_oc=AdpQSBHvXOZzP2RGd0_dIO1KnzkZrqh2qV-A8x1KgksZipR8vz-Rb-S_YXdyAkolPPc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nlF-e6EwWwvNwbPsNDZBHBM4T_4Oj1XK70O2X5pb5Hw&oe=69E78513"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQIGKz4qNpoQ7kNvwECATtI&_nc_oc=AdrsatMOA6g8kATX0v5i-Hb-hh2LIVWXLGUcelfkWZesfCXDcnfOMlrsx5qRlUleLBA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FxIdmPb_3jXG_plna69W171iXIWRJxCQLECdXBAmPtw&oe=69E75E87"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0fbgwfdYm4Q7kNvwEYYX3-&_nc_oc=AdqKwRB8U7BgKodKxHnAah_a6EZVReBs0YRqQ8ceUb0hg9tQgRiIY7shkFvLtdtkFRM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OvbloMpfI9iF57HriZOof8CEgZL_L42nzgnB7C5Z47w&oe=69E77029"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnxMK27o8bUQ7kNvwFTyPqt&_nc_oc=AdqMXzAvOOOthhQjbR8l854wi9-Q5Es6NKEbSwaBYHhoAy2Xir1894foKMgvrL14uHQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20X5dWZJaJNdJSdXoFRKSc5ObITbrqrHRO0C9fx51xaA&oe=69E766D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmNYrW7S52cQ7kNvwH0DPnC&_nc_oc=AdrFt2rRW9qwUn18Kdp_DV8jMcFnNXSvkurrU5ahO1z1iv4hRk6Ad4TU66BLwnibXc4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jti6T65WvrbWMXrmG6sae4BTl9-G7XsgNfCHNFjmuYQ&oe=69E78C2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
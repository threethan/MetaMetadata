eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpQfRpmKR_QQ7kNvwG0Y313&_nc_oc=Ado891Pfc3WhYIVbXbo9lpj6Ub0jd-yqLHEMYSX8axUQxKJIoJTXp7yLL5hRVQN6LQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mq5nfZ5X2vNsZch3zGDRhzdrgzPIl6JKhIVlJWp5JZw&oe=69D3BE93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njDhan2sxG0Q7kNvwEczi6n&_nc_oc=AdqMYmloaxxux14xbMMfm2wiTUjewiIXMLe0eEJjYMXzgslNbMus4N9icwmF8e9Oxuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OR0lSB9NlbhftEaSLAqsUQ35N7-phuY9y3xUxOHEJTw&oe=69D39807"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbORDTQGXUYQ7kNvwEqBO9d&_nc_oc=Adp9OW3ZiuTx39fUbwrrjekDLVm9EFQLd0JZNuv8-3OsH3wOzNOtrq4dYB8dBMPAtsI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iiCnlzHB1G_3_uRZYfO25uoi1k6z1tj6MPUUULh-Tkw&oe=69D3A9A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb0oyUiWWHAQ7kNvwGFBKmT&_nc_oc=AdrTSnKinyJ78fn5NIloq7JMUppBE9_fU4nXFz-NJ6XhSzDfUNIB4HJG5TPxu6jWnzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZYEW8n2hcajXAFGqc1ZOBFCvEb-ChjYkdAmGIkWI6UQ&oe=69D3A054"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdmIQHL__iEQ7kNvwHJABv9&_nc_oc=Adr7nZVuCnG6zuEXSeb3L8UFv5fANUtThoGrp-IuBfzjZl8hizWDm-uu6DBx-6U7U2o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10PaPJQ1iyqKwsCa6KmvvTzPym2NohZif5XkMh9T_l4A&oe=69D3C5AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
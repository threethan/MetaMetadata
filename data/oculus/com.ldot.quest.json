eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGqX-5f9iSoQ7kNvwG7pMZK&_nc_oc=Adq4uwyYr599_5VaBvpqbFMQrmGXZKuv-ROvqB8xjWGbNW3BVtUzg8XRn9mBghICpRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l5JA8t8K5JC9owgL-ZjeCRB8SEI5BdnVYDBl8EndAFw&oe=6A297013"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HzRc8uEkCYQ7kNvwG7zoVM&_nc_oc=AdrWAVIQz4bJ_zai8gUPsG8rIbDQ8BuvZkNLO8tNXPhtQY8dGYG7Uz32Q0PWm83Kd4s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kVDxT1H4nZQRI8He6zHDLDMoz-U6AyzP0NZ5hB0EH7g&oe=6A2981C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBzZvn84nicQ7kNvwF9d9HI&_nc_oc=Ado3YtcoM3uzZQx1lr4VJ2Qm6K38MjlzEdPLJdnBba5xYWsknxeeXBjy9SmNWxSTWFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rKKs53yuadNuNCc1UAM-ufvQksdvzZvk36AJdtbSVnw&oe=6A295B29"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIDQlbsLCCsQ7kNvwH8PXcW&_nc_oc=AdqZUiyf8WbadtTA1hbihQY3CbkwAIf1q9AnWka_7Re1AYHeiq9hU7JjEUDvJVJAYhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ajQoB7Ix1x8VyDVqmbc_epTxL67QgK17nfPlndnFrlg&oe=6A298A14"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P68On4O0YN0Q7kNvwG9MByA&_nc_oc=Adp-z2DNIhCHFUX6lRy885tyNx-qP1LWXlbZdbMWkT3GPF3-UUPzs58v3pQ2vlB_7PI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IIWSoPIaJVXLVZVu_C8LU66Oa1nzqWQtXoTgSv9gcKA&oe=6A29772A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
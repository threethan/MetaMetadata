eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHhv47qBTbQQ7kNvwH90fBx&_nc_oc=AdqA9d1Q1Spx8wY7SlhVkgPe6xsuGG1887fi7HuqBHC4fkLGvpx-Z0sUfZvrgLPQkQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vrbcGWASXtyCDBCsGaZEv-w6Sb2wtpmSOPxfsC7Uo3A&oe=6A009193"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCqu_HEwxGgQ7kNvwFz0mi_&_nc_oc=Adrj9uiChgE6jSlro-aXGzrzfGHmXi1-lWtmESqrCtv-J1KjUgx0arHeQN4bCDOXeX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78KyDLwKh0DlRPi-4mxDFDYxXxrPIII3GjR5WwdgD4-w&oe=6A00A347"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRw6TH6umRAQ7kNvwEYdgDB&_nc_oc=AdrwCZbNnRsxp4SsMvjKc_sscjfyqBpzQ6HJVITuaWkBF43wU__N7DV1u_3x6RYzj14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u0ULHtvdlvjJVtHlsHkKkgzehQer0HUKws-zvJaX6ow&oe=6A007CA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07mt7lufjrkQ7kNvwFzZV5Y&_nc_oc=AdqXFxmcUXAUUOI-DJDQA3DD4XrEYdvbdjQyG9TTbcq7j2H432zG456_ZYVMKSOt2QA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jUX0-EUYjM5sWgUmG8YnWlGM1fJQwH1hM_sokcsWenA&oe=6A007354"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVACE86mQrkQ7kNvwF4NVzk&_nc_oc=AdpvJP1mI6qoN5c0GY2QBSgHD7FEb2u7627OdmpqH7B5T7258Jm1fil1Mg_AhZt9SU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MBCt6A91BTNuXImsYOriHzD2IOS-ajQNJNlrZE6BsrQ&oe=6A0098AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
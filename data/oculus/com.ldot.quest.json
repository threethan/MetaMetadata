suFxCNUSE8lIAap_aLZrUyW5BT2ucdKmFdME52QHjw9TJvEsMCHyU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvM4r8N3oJnbO5IRKLPiP3nZV60hiXmO6mxh1v1wo-NnQ&oe=69A1A593"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00IyeUdB6_oQ7kNvwGBsWgf&_nc_oc=AdlNBCmcSqcILTn1n4S7H9H_AbXxjliE3LvOkfUk7oihvoZNEbetLAx1THWhUjbU7SE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuTN3e9HcHlzyWHMfTiKiKq_o_ZfwiPv3vrD1lvzywLHA&oe=69A17F07"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9QE74OSdqMQ7kNvwGoQ-tr&_nc_oc=AdnlsYVs74ZV1OCuyoljQIdYYzGT9D_PlPymMzDT1ov738RJkCdkQzp-2Hmtkwnij00&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsu896kumtCzlWX1a8w2ePgrIQqXaZVAWmYX-r2UipbjA&oe=69A190A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTWHxfEnSSkQ7kNvwFZZj0F&_nc_oc=AdlOtiIV-jpFLXACo14JQofOI1fSpnwt_4mmMaCnnQljHjPKP69yTQou1P59C9gZDTw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvel3AHdOiquDfVphGFwFM1NmO0tkcsJjnsxFqhKcwF_A&oe=69A18754"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT_5UVZf7-AQ7kNvwHuCdLJ&_nc_oc=AdmPaEQmdzE4fsGEtwjxn991LdrGyseISLKxqmof0xBPPh7MeSlq6-nyYcvW91zJCL0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftPJazVCaORvFYXref7Emwx4ctnMST5lBkMPyBpN7ejfQ&oe=69A1ACAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user
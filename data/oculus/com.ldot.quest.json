eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgPLUxB26aUQ7kNvwFlB78H&_nc_oc=AdoEwUuVbxLcwA0h5W0UhVQ1Hyo5XrC78ht92UtZHcS0UYF6Hn3CKQeerZjOhEUFURo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2QvXxt9FIole60IWdSKtl_FnQ3oqDaOvzy_0EVysf7Q&oe=69C3EC93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZlp63ZlfmoQ7kNvwHUFtad&_nc_oc=AdqnbBuFgKsx-9Bq6WEeSNSrUkzLlb2Q6Miu8K5v_s0B76QKTSa1CT0s2L7yR28umUc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3v8zA6DUWEhkrasi7gZSLZjRucwI8mvrRhC7IC5aiGw&oe=69C3C607"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfiFeXmCJd8Q7kNvwH3IWZm&_nc_oc=AdqR7TQKQz9xedMwRLsKCJXJB4CBA4fPccz2NG6llIJdd3mH_tJ0YlT0U15LbmF7a74&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzf5lC_Uu5WnuwCHZr_wwdo1R94Ofo5fz5Ie2t-7-vYZQ&oe=69C3D7A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ESA_vGv4EkQ7kNvwFqJxDj&_nc_oc=AdqTAWFwi7jnbgNvdj0u9hBow5lGbZ9tfkN0b0qnrnsKQzhQUe0QmdJ_QIZazZJm_JM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBOSCPd-prZJIqDf9fAHO2J3X4QU9CB5dWXmwRDA8xWA&oe=69C3CE54"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljnqb978cLoQ7kNvwF8Ess7&_nc_oc=AdqUCHWMU4itOrswltwJe-ONclQOfm8d3CPOso7utvkqVK_0aSDNLPpWAUbWziGQvHU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz64k4q7HvwES2pS6NZkXikhxfeVBQGH2i2C0N220aPCw&oe=69C3F3AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
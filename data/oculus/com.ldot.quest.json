eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL3E7MjGxMEQ7kNvwGTa57A&_nc_oc=AdoXBsggUzHxb9FXKzrEQFS5UAQe4cIuuieGqIceDcKOL8KqD34XIWZ0l_tyI18s0LQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vbpGIUPPyhkfIM21WlhYnAO_PByuNCvRdnQzoKW3HBA&oe=69FDEE93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCqu_HEwxGgQ7kNvwGxAB78&_nc_oc=AdoN_dN_jIvt5vmOGqJjkMLzTXl8P-DsXQAxd5BiSKwGVfUo1bttbPtRhtlTZ37WRCE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cAaTR1mshnmYFBWXHAtNyNdQvw31PfI-a_e1uOVJUSQ&oe=69FE0047"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9BLafFhkQ4Q7kNvwGq5XiE&_nc_oc=Adqzrk9bDiqhIoI7kfexBCTr38rJRDjZT-diCWGtMdKghKk-5N0ywcDGW3PwMYJyLKc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U7Eov2MPm7DM2c8_RJeEbyVIp544x7dEnDIYRwTtUTg&oe=69FDD9A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snO2s5vXE9kQ7kNvwEmxDD6&_nc_oc=AdrfHa79JsTRIpU8fm2AynmyTPnFRuXfSFcLWDX2s1PeHWYqo6Jd0W7khD8c_oBu2XI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eTwi33jbfqzNvotPaJu082uzf5uorGizvP0JNpM9e9A&oe=69FDD054"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVACE86mQrkQ7kNvwHLRAT_&_nc_oc=AdomDAY8C2cPSwGcO_JiaNWmam-4e8iHXfdYF97xblz0h7R7ipl6WnF-1hMIB88GLkI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zeCn7U8zxWQs4MFmHFOi2wmQccX6tIk4dsfOrEvolVA&oe=69FDF5AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
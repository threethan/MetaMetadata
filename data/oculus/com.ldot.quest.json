eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpQfRpmKR_QQ7kNvwFoeEAs&_nc_oc=AdpWLKtUzhVoCvntZ79bvFzTXdbiGcx9oeTVX-1kC-qKV98GH7ZERTX1-myt01j6-kY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IxeZSwGsfZs5fnf10QyOxm9AclYPDdYDw4dy_qiOGbQ&oe=69D26D13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njDhan2sxG0Q7kNvwH0nDJX&_nc_oc=Adqqz9wcrjBVIDrpx-9-jB6wYPaKTh7Sv0fNaklssnqxVkC6l0ETVqQAgO8yWrEVbu8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e-17Xx9AgFPH2FwWQs0PxJBn4KSDdvNr14h6kHN3IDQ&oe=69D27EC7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbORDTQGXUYQ7kNvwGVI-Th&_nc_oc=AdoQGjeT4cMXWdPURybQLU0bQhjhcnDd_xVF2pkv7XAATYZF9GJ0tV5f9UekyBgVE_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NJMPg77yCMl8Vue78JM514iy1hnGA7uYWJt4LF4k1LQ&oe=69D25829"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb0oyUiWWHAQ7kNvwGNH9sK&_nc_oc=Adp6tgHeNXYPf8Lv9Rk28nzRiXILCEBq4FN6Lmo3AzXj9LpaXwiygjw9L5DLh8l-Tow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ePCKFwksCQl1i70jEYQBiU35k3yGG5f2F7HIlTdqeng&oe=69D24ED4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdmIQHL__iEQ7kNvwGRsjCG&_nc_oc=AdrApc5CGGvkrDJ4AiqLIhESPugDyFj23vPXaGUwvh-jPVbg1WkDKPNzp9lbhR-_lw0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q-cbAEYAXbbm6dNKo53YOtfdAbUrVQgSCevjBI5YlWg&oe=69D2742A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
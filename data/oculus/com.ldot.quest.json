eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETqM5dsBrDQQ7kNvwHaE-13&_nc_oc=AdpNhjdxvBZWO0oT24xTlKTfHEl9zgKXFhHDRP-RJA2MQI9OOARVJG9nXN8YXbnp6yo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EPWDuIelJoWJ6PkRdf_V68nWy3CeO8y3d76bR1zDnMg&oe=6A26CD13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLxgoVLyJ7AQ7kNvwHY4kcq&_nc_oc=AdoINk57aOK2trf6CfDJCjLT3ZjoH25ozzGdAMcODomT6ZBa35zWFcb4Z_SMmj9F2ho&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nmhryyMoxHB90ztVy_QLNHfHwAVkPEfRrw4Jh9OHnIA&oe=6A26DEC7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzgXjim26iQQ7kNvwGRswmq&_nc_oc=AdrDlCK4_j_aqHiMevnF426BRTkM8iWbs-urLBi8vFAxxQhzZG9BQ-xf4_ohslTmJmQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87ghpDNoyx4z9KHDbpkxvONR5IYK8sapCzuaDvZt2wxg&oe=6A26B829"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Er60xfMEaAQ7kNvwHMf8GP&_nc_oc=AdoEeZh24PhbQHJOvANmg0WCWAH0c1z7xz2DC9iyHjk6TqVggxXTJqXMG06Yppil1-8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U2-lBzu2I-3UL2pkW5H2WZtkrZY5UQVWhQ6XB_UZt9Q&oe=6A26E714"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrn0MvSaruAQ7kNvwFVO8-8&_nc_oc=Adr8KF8DmyaCSFmxXSpGhECowTs_JLk8fQX-7S-0QswRp7-VMmW3fs2V5yyAMBuNLVc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8ik4nnkRemHQxiWqGPEmYM7BlnCIw22R_YI1N5Cf5mg&oe=6A26D42A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
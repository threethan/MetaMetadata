eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZRfieasAP4Q7kNvwFIKBdU&_nc_oc=AdqxEPrgBWXq0YWs1Zxe4yu9CGJAbi2WBXp9X3bRsQL0fofu00u3w3ywBW3yenIrj68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BFdD7x_ilb-yiZUOSd5nESdk6Ccd8otp3-xcKaWpw_Q&oe=69E39093"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sstMU0sZfTEQ7kNvwGx3VkF&_nc_oc=Adq3MqsIouFqAMp5a6sWAO-HwEnvRfC0FpXE5whW11p1-uoAOcvRlz0o4GIRxpTP2aU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zWzAFFqb2muNT_UpS2u8vcbh09ZOBFwTxXGPZJaQMHg&oe=69E36A07"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMjRi3km41EQ7kNvwHBoeBh&_nc_oc=Adr4IzuVYYPgw5Btb_hMDjZ54sUyDIHipWUnjT_mHM1ZaY5awMN4QaK7G3qbSjUXvtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lCbMoarc6ERbEXXxOwUmxtFmlZVvq2hSQ5VLRU3z_yg&oe=69E37BA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH8oywdVyd0Q7kNvwFU5Nee&_nc_oc=AdplcUCqHDkgXfvcgKYFvKPzL0dspwn24FCUpAbk8pbj3d8co8iY5yHIPrCvWPFIu_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pD4FvMFlsXSUPK_psZ5bsdXBUyNylS5vnhe_Pz_5iHQ&oe=69E37254"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBRsZK-CBC0Q7kNvwEu_WY6&_nc_oc=AdrSJHkHn0WL1HgToOcKieGpIpypGeaNQAkxxHo86yE7_BNkDldWLJ-_Hqzy2SU6SHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bX_rIXbBtVJA3-J0tbedkG1YA8BsCt8jLCU7bhETSlQ&oe=69E397AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
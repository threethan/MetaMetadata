eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUNEYPVW-bkQ7kNvwFV7QSd&_nc_oc=Adpd6gWv4YlScqusbfFX4qmNEkNzqw5MKv-trGMlwSY9Cf1VFbal-p3SR5_WuIp4I08&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IaniAXSgXjuHZvOHHHAXBfa8Wtjmoc01hD80vFEtcig&oe=6A106393"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_j0jxV1tWwQ7kNvwE7PV9E&_nc_oc=AdooIxWtzA1U2mRhjfGAmqryzc0dkMi5LoZJmmz_ROZODcUI6jDEt6iR2C8WVzWnmZs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZudSQswwXAmqGRpY3PNyt5fke7bL7-Fi0C3AAqJai5g&oe=6A107547"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pygeGG9_9ZgQ7kNvwHhq_8m&_nc_oc=Adr8DJ13wqYSxzPeRnEP_NTIlF48Am8s4kDtAFfvt9DgfpampYX9cScLGeuv47i4oQ4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EL2Fw_0x251tqWrJQE2l9yBEgWpowjaWtUvhxNt11pQ&oe=6A104EA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpA4oaslxpQQ7kNvwGc0F4u&_nc_oc=Adqf_qo_5P-KXWNsYW7aPsCXRppIquckX3maMIls34BWT9jw57fBVFl0JIAbQXZNNQQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_m2q2ys_WePTLtTYEhgWrStQe2OJJNfZPNwJtEnJF4g&oe=6A107D94"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRifc0yFp60Q7kNvwGCk6ac&_nc_oc=AdpmZ4MDAyMePNWN152q_kGmj2-FglnneQr69U-gN2DKzaHKqmY8w8mAkiboSvLBXms&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IlKnEZ55Ezif0axVwtA43qTVuir-_JIfKYr47zeArEA&oe=6A106AAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
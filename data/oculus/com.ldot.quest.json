eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdCARkD04nEQ7kNvwH7VgdQ&_nc_oc=Adre7sVPmof4Pv0DagksHYY_4PFKDlTnVYqd4RO0U0lewFPNk8nZUl9ZDL0tae0GHfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zdn4tfj_-KGNDjT9jgIVka1hYWjsx0mC7kadBJB4hnw&oe=6A203593"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRBJJ_dOtiYQ7kNvwFfTnlr&_nc_oc=Ado9qV1pnhCFYszQDgkr-T6HgQ70WQ7PfBJ1vAmJBEfnkqSWGegHhxoq_EeLRoINyIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p5Cbj2R5pWd1a3jXkBNxaw0dK08EowlLTglyInZxjiA&oe=6A204747"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXL_7BHltowQ7kNvwEIigDO&_nc_oc=Ado9yMXQQKn_aGVlinSKGjG3VVTy-jEfEl5epBoMdDRZhDgDZKuOVwLACmvJadX5LJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69mkjlgeO0AxwzGsVKstY5CWr3Jn9h3fqzYiecMY1vug&oe=6A2020A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QZ1DEHWzeQQ7kNvwEECnTj&_nc_oc=AdrRv-f5W1Oqe3_ToemoImNZu-u8xkLNxCpcfGzGJ6q25X8YmOSCMetuvUvZZji4mLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lRVLF4BojtwRUAW91HYGuGgVPknmgZms3iq9ktpF0lw&oe=6A204F94"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjKfaAGYAH8Q7kNvwGj5Wao&_nc_oc=AdoKC3wUcgPLHedPdJnLRZ-MvdljzrBpu3IZ5bRBq9BQ1pzoBkFAjjs7EXp8CWflU1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M9swl2EuqxyBkOnpZAS_11SNa6WUPEbi60siXbJs7Aw&oe=6A203CAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
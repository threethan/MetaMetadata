eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUJvh34NsIEQ7kNvwEfAbai&_nc_oc=Adpe_7ALESAaXyVMN9UqTVQeXPTcLZEpOXtfnak17GTt_oVwVSAiRt-1KTLTzK69UOU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rxg2B2JfNA_N32S3EF4ImtjJzToMAzKwMX_XFg8WCPw&oe=6A33FC13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6BoxhgNUwwQ7kNvwGR8ffZ&_nc_oc=AdrnVMWpRvBNHyUOAkduKsLeL6t-hUawwkgNhvIIuzL17z-44Z09NCYk1y9PK7omMTU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80MycyBpk0iawTXnfxqRGmOWENCNfWyI_ZOdfgPqKhOw&oe=6A340DC7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX7WkcES74gQ7kNvwFvlP6I&_nc_oc=AdogFCdVaQMPwo0xaq_ROpzl2Yv8ngNpkZunWb0G9X8dkV8l2Y8f5pMU6EpUci9HLuQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xrWLaiYWHNlrpa6BKuxVjKLjU63-ZstV6aZxRjUwOBA&oe=6A341F69"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CHQXFwp_7EQ7kNvwFLW8cJ&_nc_oc=Adp3rX8kyyBZymMcJLMQnqoqcVP4apgpuaypWP1plED0w1OOybzvKsw-Q0rM3YA8dIo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hpge3Nf2mfiy6XMdPQE17s3cxLSzQWOUwVD7G2g3CIQ&oe=6A341614"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuE4LL3cnksQ7kNvwFufcKr&_nc_oc=AdrLjWNb-FdtlkoIkXbkkUn_x8JR6hTNvIqeXQQIYcLG8rKl1NbEux_rL_1hsk4-yCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ozpPqCFYBJG8poEypJSQ-aurODDQGrHXwsN1VrG7uIw&oe=6A34032A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
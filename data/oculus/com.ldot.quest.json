cb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-PEQk_R6kgQ7kNvwG2tiGi&_nc_oc=AdokQw0HckCmrnt4eZqtOYjjdsC8OWqx9rZ2OC0OFip2MnAtULXaXA-wLuYD-ALKzD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsbdSn_cj5T7YJLj4FH6f54yjEaepiqzppshSLE2c0yA&oe=6A50E829"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6D1CL3wLSMQQ7kNvwH27xmi&_nc_oc=AdqyOiaKgb9_3q8RAGppjYEk3iTsYNdB-WhP41SQFyJADGg9XxSwCNrTsFQNuwVb2Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABLKBPc16ArRqtwk8rFKn6LZY3eMedb8JlPyEfJopSAA&oe=6A511714"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myU15UY04s8Q7kNvwHubuTt&_nc_oc=AdqL7BpFn9f6P0d7cbRqFOgQp0oE7AdfI6Kmm78wGoQyAVyu_AI3iqoEg7xojgrRGdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVCugiirU8_X0GUu-2kWtDfzaqC6K_2mUX5K1f2CfijA&oe=6A51042A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - FPS Shooting", "keywords": ["shooting", "gun", "fps", "military", "roam"], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Abstron Pvt Limited", "developer_privacy_policy_url": "https://skippyapps.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "http://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9409654695786038"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984464_1527184191525465_2596305196350340176_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq0xDEYi4_kQ7kNvwE5oJhf&_nc_oc=Adr0egM3mk0Ox3y7tAkdJ06VXHF_tOmONpZ_SlFL0bfM-xoAbepTe-8m2jApPNLLvLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK4AIdkGlHwf-7Ly7gfdWTrlydOOwN0ITbFau_JbuKvA&oe=6A50FAB9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Day on Tower - FPS Shooting", "platform": "ANDROID_6DOF", "c
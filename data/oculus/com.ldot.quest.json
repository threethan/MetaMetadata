cb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh-C2z_fuXsQ7kNvwHtAhAM&_nc_oc=AdoP7aCrn169PlJieq51TVy0q9E1Q1kBr2MYmbyT-c_uo6Va6aR94njzcxbRSjV5M-k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvYlqEzHjzgwVNtb1QZCY8G5nYuS9zZK-o1imhVVQbUQ&oe=6A660029"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e7Nz0tD7PgQ7kNvwGUqK9t&_nc_oc=AdqeFZxHhUdWgto0zdzFM1CZWcp7Z2SiX1aqSQrkGjHeyB6CNs_V61l3bHqgq7Z5tNs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwTXMpGUeasmUXKA-oMldcPeju220h2qK3YOD19LMXBQ&oe=6A65F6D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FA6jyLqg9QQ7kNvwGrReQG&_nc_oc=AdqRmGKv8YeV5lCeGULHnvhznroiceETnoZuFzhbjO0RBlBlaHda2D8E5BlSeTmwdKE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm9PQJVltPW7L7En_nHHlNbhvhQww5LWVz4hs2GrWN4Q&oe=6A661C2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - FPS Shooting", "keywords": ["shooting", "gun", "fps", "military", "roam"], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Abstron Pvt Limited", "developer_privacy_policy_url": "https://skippyapps.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "http://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9409654695786038"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984464_1527184191525465_2596305196350340176_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXRIXTYh-1QQ7kNvwHo-nGs&_nc_oc=Adr_zN9iPa_C1eB1o94Tb9bYJaxB_C6YiZfF7ioXmSdGklL5_F0oCDeA9Os_bWq-CRk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcMvrG3skFu5xUjx8oBJFasdnPfFjU07_GPXXv8kNgFQ&oe=6A6612B9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Day on Tower - FPS Shooting", "platform": "ANDROID_6DOF", "c
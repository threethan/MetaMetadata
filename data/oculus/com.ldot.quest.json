eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FxhEjkGNYUQ7kNvwEubIp1&_nc_oc=AdrnDaqegOfyIIRlbyIWkXiXzRhtvQeQ2c1B_vL8EwO0TEKmQlK15DJ1zn007nk4NTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IjHY0QSJXArO452Ru4wFFfs23R6GHUSRBxqtwogGdAA&oe=6A2EB613"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWcYvh9N_g8Q7kNvwGE9L1_&_nc_oc=AdqlAazgyGllf7sKZoZ8tsi8AjiQ1O0xw9csAHp4Ofv57XrBuNwIIZKJXBzKV1vWYBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FypIaytBrpuBN0gB5zSUedMtJnTISz03OHY1g7__JgQ&oe=6A2EC7C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVkEpjJH5sIQ7kNvwHnZ8BK&_nc_oc=Adqf1QObNHmpCNSbYt2jLSsZM5eRriPcZk7EmXUKemV1i8-aACnnGLSjVcW4ryiV3ao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hNkCgv6cUfXlxvxSM1Pk_yx5nsd-kN2zgw_TYgwYzfQ&oe=6A2EA129"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Buq-T9aOESwQ7kNvwGygNCq&_nc_oc=Adr-0xTf-1_zoLTNStu-2cg7Pip0tCwC0yVZmAFRI3FRPs_tSgDssT-nLmDFCrTNHHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z-7Kh-ahtNcexEkYdRn-aF_DoEfbdqagabcUgONCzlg&oe=6A2ED014"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvNGQtrjuh0Q7kNvwGGqI3Y&_nc_oc=AdqLcrAS9gPYyjsdz61dh2W1JPWPesdKfJ6_2lUv6Ppsc6dNwPnkwOTR7crVA9h-ngc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7u4x24thDxU1TSVRtowTD1JvyeF-VFA0ih8dOK-Icag&oe=6A2EBD2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
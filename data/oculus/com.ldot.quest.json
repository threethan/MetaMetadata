eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lLXo7Y3VuAQ7kNvwE-SP9P&_nc_oc=Adpkqjx491yHUakZMtufvQEoEp1MQJcJ_mRgAHcjz_lLFLCQb1DBZteiPU2XU2z_9lk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0i_9JXVz-y7INJ5wKH1Hmj0Nb2GeykbjydD_lGjJz9ng&oe=69F4B413"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xVr4_a1nVkQ7kNvwE8Zli9&_nc_oc=Adq2xyODik6IYMJ_kxHICcWDXW0QF_-yz5SYOTM_JPJQUo0wPpR31ORZ7BdcNuQgb-I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-FfC8c0G36u_gwcHny86UuzDaOpAXMMmj0NiC6MKm3w&oe=69F4C5C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wXJzO9jdTcQ7kNvwHKMK4K&_nc_oc=Adoq6HlqkUFWT6uybNf6CKVC2aQzg2NF1ee7gfzfTsVHhoYW-XZX6DlBNkY1DciRBpg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0m2sInSGpZxDl0Pg1sgoi5Sh9uhww7x_MB08uAKTxldQ&oe=69F49F29"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Y4ya7Rj09oQ7kNvwGqIMLd&_nc_oc=Adqp0kVy-8Y7KmcUp59dObCWzTNOu4tNqzxAcVcYe082xvLbeZwTgaTZXXmsTkZgZZM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uSzIXg_x5zBGoAU-iQ3Cm8lSir65Uk86E2ZKdiXGLHQ&oe=69F495D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCRl-KdcF7YQ7kNvwGuGlcA&_nc_oc=AdoAE3y97RNSqgX5TcWJZpQHuqPKpOvgwwdhfEOCDs8E-mcWy8e7Vwd81PrMlxzpdzw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2A23rTc0YFU1uaX72x541xpNFfTMbmdfqfx_yvSoQXSw&oe=69F4BB2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
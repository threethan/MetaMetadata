eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40mOKhVnUzMQ7kNvwFSsVtq&_nc_oc=AdoQKmRMrbGJWpGBIe6VuanLFFOFRRoxY77ynkhHYqD78pNrsaxdyL3TDyg4pobkToo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UW5uY8NFoj5KPwhG5v4Rk_zY6t7Myf04Jqv-uU18Uzw&oe=6A3E8813"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfkbUgru3cEQ7kNvwFFBuqg&_nc_oc=Adq9ZzCIW2uysEz0M--wrbh3VrSQifpGZUxMxDmFSA-2wHrUy4BHD259K8YzpXOTe20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2rA7w72WpcJT6QHnr7I3m_v7yAzFufYwOND0WMilcsQ&oe=6A3E99C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoYJXUBIemIQ7kNvwFcZTwZ&_nc_oc=AdovaBFI7xevhGqMZTCzOX-rZafb0WLBxhYdAp2roojv_D9S6Zo-Q4yhvhIYhALOThU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dU83snR7-rfbaIPyLuyHQ5dWr0edJy_YaJ-74RN029A&oe=6A3EAB69"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPNfud2WMnMQ7kNvwH33zuU&_nc_oc=AdoY2pDAcMspfXonnQOwU6A7TD8wn3aMUAJ2uoXCHxe0Q0Hq1tdla8rnUHxEMzPKyF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sK9LPasCgDQVJLwiPi6dpGo3d2OB5b_0qwNn_ST65mA&oe=6A3EA214"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwUOADOHCHUQ7kNvwHqDryS&_nc_oc=Adof13urVfXHzFNStyC5lbXfYUofD7SnoUIU3NTccKBKnt22jT4Mb9Vqf9NZmthLKcY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RokpveGXhnLIuh1oZYcoi7_8UAsEXnlQXSoZbqQojoA&oe=6A3E8F2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
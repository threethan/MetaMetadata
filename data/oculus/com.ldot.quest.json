eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZRfieasAP4Q7kNvwG4Bn59&_nc_oc=Adr0siKifrViyNj9LO1YMGdQ1V-Yp774PuXaGn3f0ab9NNQXgfNddzhDteXck0MusbI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P0lvwjtPxxljAxfVhE37P2d5xYO6BPyZ98omUfjzGmg&oe=69E23F13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sstMU0sZfTEQ7kNvwEFo-T0&_nc_oc=AdoFX2hvdJGUTDf-9fd0AU0urHUP9gmHilygJQ2PChFAoUAuw34XmslnSsWTxz1eX0c&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Fc0oalPwk6cZJk5YofOsYDzF39F1Cq5_idAM-hj2ctw&oe=69E250C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMjRi3km41EQ7kNvwHREzY9&_nc_oc=AdquzZWY-uw9lUyGfTcFfBNyqzGM3pgc1NAMcqgsJyucVbGiXNzyyGQQjLp8NfX5kyg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r9APlV-2FXKg1Y627l0nS-7KDIi49yQ5A3s_Q9QmmAA&oe=69E22A29"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH8oywdVyd0Q7kNvwGKbg44&_nc_oc=AdoOI1LAdkjL6K8tGrSk8WYLEKo4J_xt1L_pGEECWckWQwzIVDK2InRkTS5S1cUFeDY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mpN7XS-A3gKijhWRBBiRw5w-fVox48BGeRHVL-pLOzg&oe=69E220D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBRsZK-CBC0Q7kNvwFdbv5K&_nc_oc=AdrmcySXv3zZD8ggUYy7JDmTSUMQonC_NCxyOLbF5BCJhJKbl1OHY0TSCHZv_C3WCao&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GUPlA1ziS-NQxfOa5Cil6uSzQBzENJauKbhfsofIsTw&oe=69E2462A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
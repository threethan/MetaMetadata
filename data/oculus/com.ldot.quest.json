eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stayDj53IFMQ7kNvwEfLTwF&_nc_oc=AdoNdUulel91SVRrRg5gsVpy9uhc8vJQaExTGUryhoNxEQUGaQ6HT0pMguPrjAuFoCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_POqPXY_hZyUsCXtecuJUPZoNH4AYlecTT156FE-0iTg&oe=6A3FD993"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfkbUgru3cEQ7kNvwGOZG8p&_nc_oc=AdqPaybUEvG2DVPN53m_Dn22YJix-8qUrOjhnUhkjeCBkj4ob1376wuGsm7wZ_5xvaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V9a5uxFkqR8ZoFCyiurcgTlmYJSSo4FYnHJp6Dez-oQ&oe=6A3FEB47"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKdsddlz_YwQ7kNvwGD139R&_nc_oc=AdrQBAp2Jn45-wx8gmtikRgnR9zWZPtnlAQhZ6HL4xKKiUlNhCnePn8N6cdEWBegxLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qlx4oUcWP77EEoHfWw1SAAZfx5QMfG7yzValxnvFV7A&oe=6A3FC4A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUrApmwhJNYQ7kNvwHfiRBQ&_nc_oc=AdoTLaY9cvnLDVWYmlBOqMJeHetlj3AyUREWXjAg6b480d1Atw5bLG3UFWx8nnlS2y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QhCrjn-kwBhXlT35wICvmQC8R4OsnHO21wDayLNbyhA&oe=6A3FF394"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwUOADOHCHUQ7kNvwF46cxZ&_nc_oc=AdpMk77yjSd-oDYE6gMM_pWCSGMCJvtLCQ-VgZ4piMsqhx_XdWG_EuO2yBRlFf6Fh6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZA5lO7_44WWI751lnpWPJ6BvfDJnk63obM-MPRrRstw&oe=6A3FE0AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
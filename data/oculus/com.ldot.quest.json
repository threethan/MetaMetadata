eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40mOKhVnUzMQ7kNvwGKaJCj&_nc_oc=Adox2HJa7TFv1OxRqe-klwMZrhGZXMytc8tjlGNmmNaW7t0CU5IJowIVoc4R2pz-cZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7EO1wAukVfWGeUPtw-glsQpBEsqVKLDS-SeF6GuxHVg&oe=6A3BE513"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41ni66CbrUkQ7kNvwFVcm5x&_nc_oc=AdpA9B5akLuNNrOzPWAXy71EX-Dlr8nAG9Oh8_LxPejzs3uD8GQbvVVYF1edecf3xyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mL_qWyyR3WuD0dlmBGwWvPjJNDjR9rUT9yYKG5L_8Sg&oe=6A3BF6C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoYJXUBIemIQ7kNvwHg232Q&_nc_oc=AdpjWvGLJekLc6yWzIZGqIt51SNiirt-NcYlYYsbsPoFMTSrbD-dAZqhdU7_JpfBPJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-o5Oxj7hKXaamxcSpyBRVeLsyHDHDS4PMeJHDvdLo3g&oe=6A3BD029"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPNfud2WMnMQ7kNvwHW3AWA&_nc_oc=Ado2ZHS5EKaEvdm53wR0yl0yuFbaUnE7Shjeg2NGpL0P_2KBpIo02iqWDOfeDhCx2f0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZWjfJJ1R3AWS44nn6OirFUGCoQwivz0VYRY4_kApprg&oe=6A3BFF14"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkKAtHfH27oQ7kNvwHEr687&_nc_oc=AdqcTJgvXeGPuF3uFksySvakHgcWK5m7FUgqc4SDLmbkDz2prHXC7SliXzEydnfaDUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_--Mrnv0DdaFMyOIGn9gsRqP_wJofeZZjKJTu1Ydzsqw&oe=6A3BEC2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
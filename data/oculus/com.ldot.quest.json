eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxaCE_E965sQ7kNvwFuR_wm&_nc_oc=Adqcy84Qoy-1CuWOotcxhNS7UMvR1q36kz3oeZ5NzqJpGVatdKrHb7WMLmutXddEllU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_Rrs1nUQsVXon4b0yyRJqfb8ZkKy7Uoc8yN0lYC-0DQ&oe=69EB7993"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTmOKM6TluUQ7kNvwEMhQ26&_nc_oc=AdqxRDwpkDrd1njEDfDcXSV5ImIUEscX5B7GVGPcDxNtGc8V4vJOASPcDLiO69Qp6sg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B6G-rP76Y0cWEvLLoyc0dYfxeXWN-rmKUDY1OqW8auA&oe=69EB8B47"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbYliwSTjpwQ7kNvwHbIrt_&_nc_oc=AdoWew74QgoIZVI-wdxTO5cfICDs5DWmfdQNNpyxIQq5uV8ccD0iAmb2yOBQOwkkBXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gJVmj_xlfrA5r1WBJ7qjwid266XoVrrurkUvOpLO1Dw&oe=69EB64A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y0ps9cz5J8Q7kNvwFvfJBI&_nc_oc=Adra5r8rcFC93JP2TmvB7lMG01eaKRZnQQzaMGETPuiI6ON4bA3saTwZgnZW84oSXk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34bdmzb8NWVwzMeH_tFInhMIRigajXeMCrsnGViAzkFw&oe=69EB5B54"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcSVdZquyLIQ7kNvwHo3CLv&_nc_oc=AdrwqXS0F7jMrn-D-ehLM3R7bhkOrTyOJkvRjZ-Jiw_SSb64HY-l5sAWqO8bawhGQmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rxPHAMYCQy0Kjk_p0sBz9s2HppeuGlO1DOG5rv1ap9Q&oe=69EB80AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
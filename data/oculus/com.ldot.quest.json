eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHhv47qBTbQQ7kNvwHkuIQG&_nc_oc=AdogEk5zbRq9zJ6b9a32hmDY_AFUiZa26E_Mz2BSBFq-1qSXzUNO14EyyKWlXou1EzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pgcFyWgE968kLfF5y9KgOEeHMzVaMEzUjOozF5aVPbQ&oe=6A033493"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n5hEU3YxggQ7kNvwF3TfMv&_nc_oc=Adrk8ugdxY4x8RxFeYfQvCWlGVtCchmXyLA5B4nJ6GE1bGL-gOQG12iXO_s38lo-f4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7npk5aYf4RgPtl3aV_ea9-KSfGOK-8ruJINEZmRr4xBA&oe=6A034647"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRw6TH6umRAQ7kNvwGIS-Zm&_nc_oc=Adp-csdn9p-hN8ZCTS1Dul6VK1D9bVkJvokpUM9phM3Zp7aiZiDE473cwaqmdHVuJCc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JpT26WDlokTDQYPgWEY0gV_IzOeFRat4Ro8fBZPNPzw&oe=6A031FA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07mt7lufjrkQ7kNvwGfnrV6&_nc_oc=AdpVhs9icNQrKiN8fSfrr56_6nfL3bqEyP7rz_BPShla00EizzCa0O0H7_UejRtm6EU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eryLsGQERV1WQNtNXJoiM7i6A9IB2JqBkfznwfXdBew&oe=6A031654"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FLe9IDNh-4Q7kNvwHsdZrH&_nc_oc=AdqWbZMHIULf9FkJ3YEZPrXEtQmNyZVF15UG7cdfNudibDFZeBlMB9q-ipMoHn5xUEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mSqE4AuRXhkri2bJ5_MpskJgAok-GSQqtp0Do3MHrOw&oe=6A033BAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
f20f&oh=00_AQOPLAVWQa0tEJIfKDbj9KHHc7c0DjCnebzCDl0KAS63eg&oe=6AE35393"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dJE1lIJFKAQ7kNvwHQKeFk&_nc_oc=Adp1g8bJQMGfFaeLkc4lb_8iwSXan4X0nYTUoe7fvwuwVru-gbE3EnOUl9eDWDnySJk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOin0suBD0g7Ij8Ltazu3AZnMkIpFG97z76Yubsus0zLw&oe=6AE36547"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rma84pLdXDQQ7kNvwH4V_Bz&_nc_oc=AdqNrknthUhLbGP7jBh6LDkmSE889lCw7HHvyzjWneHG4AemsOlb7-1RFO1rfGnG6D0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo95EW7ALju8YQ71RnzVQIJGDis0JGmSTRUMoGCUF_GQ&oe=6AE33EA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ck13ID4uv4Q7kNvwEVZ3w7&_nc_oc=AdpbzO4RrZZBcM5-EOFtefTVt8MveELLxlZQAphyygLRQX8yNm94StjzZXbY-IAk--I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbCdSFBNq6rwYAAaHmGvDb1Gielobs_vKKs7_fklqnvg&oe=6AE36D94"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfCIcU_QfN0Q7kNvwH1HQ_T&_nc_oc=Adqkr8NVdfZAkqPXPCayTZWd_TM3YSW5lcdfyXuF9yZITx9OUCLZ2yEhJsRRJb_SB84&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjjOkkraNr8pgXvjvndrl-0cU-yf7t_PB5J-Q9y8DmYw&oe=6AE35AAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
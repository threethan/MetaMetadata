eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52z00ZyafXAQ7kNvwGHGZj3&_nc_oc=AdoSnYSRB1Ee7bStWa0voejOvChVi35oPRdzmH1HVklcRcNtVNNoKaZRVkmf4Tt9enw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Hec4kpmyBXfwG_d1pCA7htHQMYyVA05CuuB7elN-rcQ&oe=69DF9C13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuN-OD2BHb0Q7kNvwHuxP4K&_nc_oc=Adp7LIeekiB0jVj-LDA5OoWWNh0MnnEK26LaeF2_2ddYJQlC8QaDD-dBx7Rs-2cT6L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af011JF_avszWJcMhPUJQZcI3sRxImxFcGaFXOaAnnAMSg&oe=69DF7587"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP7frXeVCR4Q7kNvwH_RTyx&_nc_oc=AdphXVWPEVDw9Dl27TxVEVFXmy6xcA_dZkgdA1bDrRjMmIjncTZiCsPwrZOqfp_EGFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G5yfOf4OyMeGKBToDDc0OdWL3shBCvOtsjsy4KQShcQ&oe=69DF8729"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJeNFw8hbO8Q7kNvwFvngWO&_nc_oc=Adpwax-mpb9tUWw6FqYeKcScnyjlQ0S1T-0RufObyuIp7lbGcH-JgOMwpQ4eMZW4Xss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21pa56c6DQifbT5AToH8e2-9EFw9witnVsz2u7cX21xw&oe=69DF7DD4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HohjlFd1-AQ7kNvwHNj6yU&_nc_oc=Adr62ca2SDX1mXX_vaPTxFTvhx1XhVx8qb5qw9xUeTmlrcrbJl__wRGtnm845Ehd4a4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03sX5TzuAQ92vXsUOlzBc_F_2UJjNiU2eTfnKf8nN1-g&oe=69DFA32A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXViOAUCVCkQ7kNvwG2Zkyl&_nc_oc=Adrqoj7z07zM0f1rERGiJ-nAcDbKeWCl3HtPhoe19jNbRTdGJKQCFIvw4D-jzvvCoyA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62tju2veXwd_cbosyZX3Uwtju66H-KfqcH5DXvo42RHQ&oe=6A09CC13"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APtUuwuoG3wQ7kNvwGOlzYN&_nc_oc=Adq2QTpYwTdKvu3KAhnutFmpVaIUYLmvoRQ8NrxPxowyU1fVIbjDYtBvR_c6xjakSsQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46QMFda3j8gcK_f4iBvi98ge25V2aWCQLasv2EKpAsUg&oe=6A09DDC7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fI_LvePDVb4Q7kNvwE8WPyr&_nc_oc=AdqP_asv1tbS0N9Cyto_-t09-5gX5xGXl871t_RWuXpL7lgHjci0XpngoaFMrEk_aF8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Iy-ngoCHKifh6gmmRcnOfIpbY5XEsVI2KUVMKri5mFw&oe=6A09B729"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d0hHY_WGUsQ7kNvwGylRKO&_nc_oc=AdorMb0BOG9uobbqNdKwOBn8Uy-jC0VjeTbbajrK2m9YibjpH0idvT84LqvuVwNTh0c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7daoDvJXrgUW4kqKvYn0LeeJPRtZNCATIV4Yhp8KqEYA&oe=6A09ADD4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkCP9k8l8zcQ7kNvwFXyAhy&_nc_oc=AdqQEGf8JMa464j780j_q8-zl7x21vXAx2hCVsJuvhLXdECkvMcrud7I8QGpEz5ZQfc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C0sIZVvjXgUkEScJa-5eKPCzbzRkuBbMarJZ6Y_oInA&oe=6A09D32A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
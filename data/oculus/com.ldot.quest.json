eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN39Sk8_cJAQ7kNvwFU3a5J&_nc_oc=Adrg9hb60hKAsAeYuxaTMGfQTXvx0G9LwygC0iyHGVoCOB2Y7kQkSaLiB5TE3qlUiDI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iN3bb4Hkx8T5_ljJszQrBymff6lqi1PTV8bzsjpngIw&oe=6A451F93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIqUfzmLC6MQ7kNvwFxF4JK&_nc_oc=AdqpWHr0uS-XmYPcJyU6VSjiRDlFM8t2qsjKQSnKHUyMu5bX0ItpomzwfGXRjeIkN9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WoEgmWjBLraiSSXMMpaX2gMyOcOKf5vqSu2FO2cRfzQ&oe=6A453147"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkIyc9KiIAAQ7kNvwGbsvOB&_nc_oc=AdpVwgePwDMk6gT87_lP9XVmJJyN3gfNx-xKop2GyRGZqL0V4U4fhsfTQqwKLslKBis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oDxk0ldN_Zhxc524sBVlbcnLEhFLpi5BAlx1uPHJvOQ&oe=6A450AA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFZFmBiaV30Q7kNvwGBCPCa&_nc_oc=AdpQ7ppt_02hD-BSMLX1qpNQ9tOmQQlz04e0ZeUTxzymDyElWx2loHjERYBuKA41trA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AVWys5a1xNIxFY0Iv7DP5G1W_jiZUh-_ooVNbXzvmRg&oe=6A450154"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDHti9wAVXQQ7kNvwExmq8_&_nc_oc=AdqcUa3wV2x8zovlm79irKgYjt2ZaYYn5y7QdbYpFjhC7l9eI5MG65ueWP1QPeVP0ps&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xr7I30wev9009FY9NAX7S9E4aZsjzkcUYwdf_ioEf_A&oe=6A4526AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
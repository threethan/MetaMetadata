eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCeQG8mQYUwQ7kNvwGiP236&_nc_oc=Ado7G5npeeFuHF-0URaroOVVTWlV-YO_5eyvy2zpCIwH9fjeNVc37sTgg7UKdScwbFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zpY-u3v21Bo9J6KbyqiO18luCDJCC1SVVPnA1t4hU_g&oe=6A184C93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyqje-bkjM8Q7kNvwFq_OrO&_nc_oc=AdqcPQgfGQyQsALuKNr_ltl9VwPxARWfitjqwNkxWiTAnNnRAsyjLm2XJaaBjtY4wy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EO5SjY_d-6uhjewVDjOaWCsGaiYeVLqt9MxbJMm2Z9w&oe=6A185E47"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry9CymdJ8T0Q7kNvwGZduic&_nc_oc=AdrRr_F9s_dCxE1YdKkkSbeGkgK_o4ppxunXDg3EQ_D6zGZfPYYRpLaCOQ_-RFHWRdY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Kd9OLGnmPGLBL74FB4D7Y_PkOM7eLTJprQ4lW1iNNbg&oe=6A1837A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGQKDmx6_owQ7kNvwF1YaXH&_nc_oc=Ado3hObmU9AD41Ww2RHvpvCniFno8S8JXeMs_ifphn5eXkslqqzizPSynCQYgsgfbGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57Jgu0Dny8XwsNJ0BK2bMmszLktUK6m_P5ONajL2dyrQ&oe=6A186694"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTaJox7gtnoQ7kNvwFMgm92&_nc_oc=Adp5bG8IcJF9l0BZdcoa44v7Lb94X1GjrSxzWJpEZRZo02KBXnj_S2c5Q-EbGv4WQHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57b2IpS4g7H-k1WnbMH-MO-IVwBC47qXfmR3TgHhbsmQ&oe=6A1853AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
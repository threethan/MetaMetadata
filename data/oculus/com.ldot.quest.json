EoL_o48vKLZJydiuhKjf4z9wuX3Wbw1A9ypXmI63X3hbytO_LVdkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvZ5vYqx_E_mMUJT0hEFrrTrNxaajDAgT735e9pgAXPtA&oe=699F0293"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00IyeUdB6_oQ7kNvwH8bQnY&_nc_oc=AdklOzWrQORXPij_dVFL8ODZSG9vaJ5KfyU0yGZ6wfhgpy790-7sCSiAfEm8yWWhQyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftsyT5mR07Nh1-XYXgKyOhHCReQVoGAiORMFe4Z0iAhpQ&oe=699EDC07"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKBGzxRJIpMQ7kNvwFhhvI9&_nc_oc=Adn40cJHHrKYcY8A18qphRiImJskY4O4a1MSncxpc_4xSlkw3DAVqLPo7tE7E4yEpv8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftcl6n_PiA3qZp34B1unymgYj3hgClioMRlHRj4btrIrw&oe=699EEDA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHDIrCAN5S4Q7kNvwHeTPGN&_nc_oc=AdlONcXTzjBDVZTvmKUYkIyo8x2bjosF7PWMbILwl1O4H8w9PhFWfSyRtLSAOBWcIoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvaTOC6GyWpAoQGTw6Te06AZ_e6xTrmnRvcEQRnV7zWwQ&oe=699EE454"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT_5UVZf7-AQ7kNvwGZ0eQd&_nc_oc=AdlH6dVzwFpitM09fPbks-InyMYg2o_TSOoXGlmq2LbHIsERBy1pD4QdFMWW62dES7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuBASISGq2YBlakEsvp6lT7DocBV8_abHMhpHofnvkR9w&oe=699ED16A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user
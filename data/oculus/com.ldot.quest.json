eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCeQG8mQYUwQ7kNvwF8sR5W&_nc_oc=AdoC7kVKVeKCKq9xc3GLXxY_VMq5m-euYHGWMrXgWCwSDbrWIDHUCZqRyKRI3Jh3Yhg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hRFAwW-zyaRPJbvTznCtMnJPQ4X5LXMLWcbkIk35ckA&oe=6A1AEF93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66CtrHmQoqQQ7kNvwF-T8HQ&_nc_oc=AdqX-wU4_pzItfxvlXNcllnZgd6aptGSRYjK3Q1U1wBc7ypd5Gq9aYljy4ED8PjVVl4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af733EoCiWgYuPgSwLzEPtO7eXANHn6fTsT7Fc8iXJK2Ew&oe=6A1B0147"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry9CymdJ8T0Q7kNvwGTpYP4&_nc_oc=AdqzFZcpC7fz8wwNqpd5r3dD8mHzWauallC57BO-L3tjVkVjzemvMJrM7R2t77MVrSs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RRbwUip9FN_P3M5oIfIlUaqHeELG47888YNxcDkQilA&oe=6A1ADAA9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGQKDmx6_owQ7kNvwHDREfJ&_nc_oc=Adr7ZO2jm9enfwyFxuRM4gAFd43x8wBZd7MXlzP7kbN2cvTuyttggCKNzKeWIFvjfmU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LFQSj8SCOwwls58OKNiDxxFK8YQOXmOvw0L8imkdwDQ&oe=6A1B0994"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCNXoPgao5sQ7kNvwGtCVpV&_nc_oc=AdoEHJYo7p7W_pRjG8iJHyNWlqww18tiWlxdX2CFKB1vxYx9XJEpFr75Q2pf9Z9slFE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XiAXfHnvTE9hRy-lfRMM-X7b_vysiefiT-4LQWpmhIg&oe=6A1AF6AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
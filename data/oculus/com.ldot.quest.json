eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUJvh34NsIEQ7kNvwGxYS-u&_nc_oc=AdpgyayWxA_Kc0wEOvwXDo9LFXUiTv7XvDujHg8v5ywjLUjGRQNRgo53gTsQ9REMi54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n2RtV2VAzFKZz4kh1e9GZ8NjprZzQyRMRuQNV3Ypplw&oe=6A354D93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxqQY4zZBt0Q7kNvwHDE93l&_nc_oc=AdqUisFFT5KGvlb2lFoKMz5nQsx60Wj9rtuaBfyVMXLkJMalG0m2kQ85hr-q8iuojdg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8873nuE7qdQcOsYqKDci7H3CtsC9q9dYKTZJB8ABTMAw&oe=6A355F47"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX7WkcES74gQ7kNvwEDgM1Y&_nc_oc=Ado7ANi3NgsuxtiePjpYVSorD9UJa55MnIA9GyqcRJWVaHgRd80cC4p8tcR968AUY7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M1OEeqYm9y1nSJJ5E_7-1Syy6SIELcUxUvRosHRkrgQ&oe=6A3570E9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CHQXFwp_7EQ7kNvwGVCUKX&_nc_oc=Adp4MzMTyDUWXzlEZVq6AjymASPgFNjrXepklKARjKGvUbQEDoFOyfHJcASf7cTLtpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-1xWruiMw1Mws9IQFuIE372FutuOFU8uSOyo5PoJenA&oe=6A356794"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwff44LzsV0Q7kNvwGTjB-9&_nc_oc=AdqU3J5i7zVST16DSB4NNY7KCxXuQLs7LjKN5XjRTRWKg7SSpZhQfg4pOF-a-wRO9WA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jUruwHvY8XSq-GD_bOWcFImZTndUpyBZRRexiqj7Q5Q&oe=6A3554AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
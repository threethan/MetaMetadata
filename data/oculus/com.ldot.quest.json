eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yznr7pnZ7EsQ7kNvwHkAUAC&_nc_oc=AdoCdnqpGPmXvTQGn8toK9baxkwMap2Z4Iq0tshBlh5lJFasYxtviIjneWP5TqBwG14&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o2ug8mMMfIzxYyhCDY-MPuFC63ksRRcObPy42tj1IeQ&oe=6A0F1213"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_j0jxV1tWwQ7kNvwHy0icd&_nc_oc=AdqBlgw4DCMhCW9S_EIW2SX_MeB5LIt-aZjW8veq8oQffZPRghpNwza1jyLWb6pqQWM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-as9tw6wB4RCV_yOHDuDAWZP5I953hRgeVOYmNLcM4g&oe=6A0F23C7"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTXH83Cfd7EQ7kNvwF_PVaQ&_nc_oc=AdrWkeR0Ya8cSWEsjb5J7eM-Qq-1F5RgzHqht7FhrNyuYVFWfEHUQEhRAqkOcm_lV-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vU7YD-c-s642qn7ewc6D_IcAk7Rh1vkh5e4noDk0HGg&oe=6A0EFD29"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxcQpu5FjNcQ7kNvwEPFC8s&_nc_oc=AdoG3W4xWCsD5UwMIHqapAOvacoBfhOY77lBrtWf6oloOY-fllmAF52C8UR16Yc5wBY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rO2SHWmqTCz2xb5PudmehULrU3_lCk5tdMrK2USN-4A&oe=6A0EF3D4"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRifc0yFp60Q7kNvwHT77W3&_nc_oc=AdoMdG0lVzw6h3P8y0WBuznG_wtOTZTJeQwbN2hDZdFIRKx73Kmixd9MpPjmQQrBAc8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75q1JiGf7YSjuXz2nzOHFeEg1W2F4Qz3IXLzey7DihPg&oe=6A0F192A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
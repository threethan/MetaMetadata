eenshots": [{"file_name": "01.png", "id": "508826600818893", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75307249_508826604152226_3147818714932329279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJwJTMCx9AsQ7kNvwHNckEc&_nc_oc=AdoEscK8H0YGopvzBvCbKqg71su-yxaIw5DQgdr5xDP9xV14aGBsz_G6hgfA_28lJMI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l_3oDn46y4ZtAbx5HRBtf1sAbjP1EaIcbDTwSRFFZ8g&oe=6A32AA93"}, {"file_name": "03.png", "id": "2022922147867338", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57570299_2022922151200671_7499634504513790356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6BoxhgNUwwQ7kNvwGPn4EJ&_nc_oc=Adp63YggCHNtkTGg79vZLPPGYOltGa5vSh1qv3Tc5FRdwKU7bDh2uIwQJxMWwmP3zgU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rUZRmV-P7tnu2URXmOj9B8GFcrylohwkM7FNXXiMBrg&oe=6A32BC47"}, {"file_name": "05.png", "id": "531175695092824", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572923_531175698426157_5393319757293900035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_RU4SSmJoYQ7kNvwET7gHS&_nc_oc=AdowtDM0vvMav6GUR4Lt55a8IGKCt6NyaokIk7gsCTbeZBucoQcTtkuG7L6gT74sc9E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q6lBfIAjisZ7svJQgQHCtidT0sjqAoqjmpCYYA5nbLg&oe=6A3295A9"}, {"file_name": "02.png", "id": "283204040424008", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86625128_283204043757341_2055547380262928885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxcsqKpRx5oQ7kNvwHT3zaG&_nc_oc=AdpJb96aE0PXkDJCdwXuSOMCb60sXUn9FJjS7il12z78Ue1P5KbRG2g7sK20bnM4Vj0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99QFKlgR5f6kZ2XqM8BD2PQOOMceeHEg888J1iZkAILw&oe=6A32C494"}, {"file_name": "04.png", "id": "1627786007575809", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75439596_1627786010909142_8922957852248947628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuE4LL3cnksQ7kNvwFZSfX3&_nc_oc=Adpu0Bf3TX9bl_k_kr6onva0-l6kivhhv4KVGXzctMFpiSlU-RiU5HYlvRVcTQNYanQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93S_ePtdvuna4EqzwCjlmYqHjttXoqcaKVnHYnXiooxA&oe=6A32B1AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Day on Tower - Action Shooting Game", "keywords": [], "long_description": "For the first time ever, a game that is both physically and virtually real at the same time. Just seeing is not believing anymore, touching is. Fight through a multi-story security tower moving horizontally and vertically as if you were really physically there.\n\nA VR game designed to be played with a matching exact scale metal platform where you can touch, lean, step, jump, run, sit and hold the real structure around you as you shoot and take cover in a non-stop military action thriller. No more worries about stepping on your VR headset cables, bumping in to your room table, chairs or walls. Just focus and enjoy this unmatched experience that need skills and a brave player.\n\nYour real foot steps with holding a real-like gun, 3D sound, dynamic floor vibration, wireless VR headset and an environment to move and feel around brings VR immersion in a new expansion. Varying difficulty level can amuse everyone from from teens to Ex-military guys.", "short_description": "On an oil rig in the Deep Seas - a deadly war started - which may be the Last Day on Tower for the US Marine soldiers."}]}, "developer_name": "Absomech", "developer_privacy_policy_url": "https://www.lastdayontower.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://www.lastdayontower.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads":
our videos next time \u2014 no need to choose again.\n\u2022 Clearer History tab: History is available to registered users; guests now see a short message instead of an empty list.\n\nImprovements\n\u2022 Downloads retry automatically if the connection drops, and resume at your next sign-in.\n\u2022 Smoother, more reliable video list and playback controls.\n\u2022 Removed the old \"Content Update Available\" prompt \u2014 updates now happen in the background.", "created_date": 1792656141, "id": "1393295670540511", "version": "1.0.1", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1321322857737793", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1393295670540511"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792655959, "id": "1393291663874245", "version": "1.0.0", "version_code": 1, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
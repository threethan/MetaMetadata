531700_4383093444025874684_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38hDAuaUCvUQ7kNvwGxD1OK&_nc_oc=AdriEDdrpC-gNQ5U5RDGAFfP5jdmPByB08CqMRSyq_kXUBdvYeGnzURwN1uNcizezdM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQF975P07Oksd7lhnIOy_k1hGJl5pMskbnK0BN1ZHQZA&oe=6AE8A314"}, {"file_name": "quit_screenshot_2560x1440.png", "id": "1633430445487841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622162_1633430448821174_2475144044156646499_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHddGT0Jw-EQ7kNvwH94--G&_nc_oc=AdrQVLBV3Q9X8UzWrM4zCHf-A_uZe9lEfZ3b4keo8fqoJ2dEUXgX8j7bdyBy1giEKkA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS46qE4HZ8Tc6cRmkxg53312gX0Zj3HquB9LUarKILpyw&oe=6AE8BF18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Divyanubhuti", "keywords": ["VR", "Spiritual", "underwater", "Videos"], "long_description": "Welcome to Divyanubhuti, the premiere Virtual Reality application designed to guide you on a transformative spiritual journey. Divyanubhuti (meaning \"Divine Experience\") leverages the immersive power of VR to transport you to the most serene and sacred spaces, helping you discover inner peace and mindfulness like never before.\n\nKey Features:\n\n- Immersive Sacred Environments: Explore meticulously crafted 3D temples, tranquil nature retreats, and cosmic meditation spaces that feel incredibly real.\n- Guided Meditations: Choose from a variety of expert-led meditation sessions tailored for stress relief, spiritual awakening, and deep relaxation.\n- Spatial Audio: Let the soothing sounds of chanting, nature, and ambient spiritual music wash over you with high-fidelity, 360-degree audio.\n- Interactive Wellness: Engage in breathing exercises and interactive mindfulness activities designed to center your mind and elevate your spirit.\n- Whether you are a seasoned practitioner or a beginner seeking a moment of calm in a chaotic world, Divyanubhuti offers a personal sanctuary. Escape the daily grind, reconnect with your inner self, and experience the divine in a deeply personal and visually stunning way.\n\nDownload Divyanubhuti today and begin your journey toward spiritual realization and profound tranquility. Step out of the ordinary and into the extraordinary.", "short_description": "Experience the ultimate spiritual journey in Virtual Reality with Divyanubhuti. Immerse yourself in breathtaking sacred environments, guided meditations, and peaceful sanctuaries. Discover inner peace, mindfulness, and divine tranquility through stunning 3D visuals and spatial audio designed to elevate your consciousness. Step into a world of serenity and spiritual awakening today."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.divyanubhuti.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Korvex Technologies", "support_website_url": null, "website_url": "https://www.divyanubhuti.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1397894546747290"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593867383_849896504868981_8631793751017818712_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0MMSteRllwQ7kNvwHoKKT7&_nc_oc=Adr4lsU6XVZqMTAmhXtz72iHXbMeMxfd2W-TiadCEmo2s85Dxn4bC64tbyhLEUdBkcg&_nc
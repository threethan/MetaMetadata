_description": "Cette application a pour objectif de former \u00e9lectriciens et non-\u00e9lectriciens \u00e0 la pr\u00e9vention des risques \u00e9lectriques en Basse Tension (BT). L\u2019apprenant \u00e9volue en autonomie dans des situations r\u00e9alistes int\u00e9grant des dangers \u00e9lectriques, tout en respectant les limites de son habilitation. Plusieurs environnements sont propos\u00e9s afin de couvrir des contextes vari\u00e9s : maintenance industrielle, bureaux, habitation, interventions ponctuelles, etc.", "short_description": "Cette application a pour objectif de former \u00e9lectriciens et non-\u00e9lectriciens \u00e0 la pr\u00e9vention des risques \u00e9lectriques en Basse Tension (BT). L\u2019apprenant \u00e9volue en autonomie dans des situations r\u00e9alistes int\u00e9grant des dangers \u00e9lectriques, tout en respectant les limites de son habilitation. Plusieurs environnements sont propos\u00e9s afin de couvrir des contextes vari\u00e9s : maintenance industrielle, bureaux, habitation, interventions ponctuelles, etc."}]}, "developer_name": "DEC Num\u00e9rique", "developer_privacy_policy_url": "https://decgroupe.com/cookie-policy-1", "developer_terms_of_service_url": null, "publisher_name": "DEC", "support_website_url": "https://decgroupe.com/contact/ticket/new/technical", "website_url": "https://decgroupe.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mod
TO_Screenshot_05_2560X1440.png", "id": "516522013998626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031521_516522017331959_8954625613682135326_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_-N7M3NrU0Q7kNvwGWxC8C&_nc_oc=AdomPvk-ywpKibOBBkZKeulYfS5rLnc9yfQe-Sy-rh86Qx3N3aubtrE71OUAWiD3OeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32E0YdD9LDsz5NuE05n2NHm1rfn65yCKkkpkBDKkB5Pg&oe=69EB751D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOTO_Cover_2560X1440.png", "id": "594017779439258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035408_594017782772591_8460809143550529843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snBbH9jiTIcQ7kNvwGnaA_c&_nc_oc=AdpmLRn5ra83li4uM217nwaawyNmNPlP-DJc1XtbokQuKJnaT6QUiPjLVAzU6fv-zc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xGRvV9D4MjeVJTZ82T4rH4aPf5hClFRWrUld0DT-gLQ&oe=69EB8CA3"}, "display_name": "Lock Out Tag Out", "keywords": [], "long_description": "The lock-out-tag-out process (LOTO) is essential in protecting employees from hazardous conditions when servicing and maintaining machines and equipment on a job site.\n\nThis interactive simulation invites participants to explore and practice the steps involved with locking out and tagging out (LOTO) equipment in a safe environment. Based on information available through the Occupational Safety and Health Administration (OSHA) website, this simulation guides participants though a background primer, providing context and identifying various parts used in this process. Next, participants engage in a sort-and-match activity which reinforces their understanding of the components and steps. Finally, participants explore a factory setting and put into practice what they learned by locking out and tagging out several control panels connected to manufacturing machinery.\nThe simulation provides instant feedback with either \"correct\" or \"try again\" responses to encourage participants to reconsider their choices and allows them to revisit any part of the simulation as often as needed.\nEmbedded learning objectives based on Bloom's revised taxonomy include remembering, understanding, and applying.\n\nBenefits include: \n\u2022 Realistic 3D Tools, equipment and environments \n\u2022 Interactive activities \n\u2022 Transferrable skills", "short_description": "The lock-out-tag-out process (LOTO) is essential in protecting employees from hazardous conditions when servicing and maintaining machines and equipment on a job site."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "601282068141079"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24503156992601112", "version": "2.2"}, "id": "711257100545147", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
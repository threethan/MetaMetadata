"id": "585231316819562", "locale": "en_US", "screenshots": [{"file_name": "LOTO_Screenshot_01_2560X1440.png", "id": "221132947036633", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462204_221132950369966_5936826192041134166_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7LbkNuGXEwQ7kNvwFx-yvY&_nc_oc=AdkenBTk1lPMBq-sjHiSUvPxggKFdAJgnOuf8aCGoYPPYeGK5HQj6dqxJE5QprmnNi4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftA4lUul7fO2EdGTWvvBMYORoMvsd8QxjRaOS7m5gweRw&oe=699C5E08"}, {"file_name": "LOTO_Screenshot_02_2560X1440.png", "id": "881318926464662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974624_881318929797995_849819864715738688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drqraxhQSEwQ7kNvwHzAYj4&_nc_oc=AdkzzEuds_1nGo-I7IHCwIm8wWAcoN6Nz6x-sNBsI77_JoLPqMmcmnjT49PlYv-f3bE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuzwctWU6lkZ_atwSvu3Yb64cgMqrfI91RjdFJI_kEATg&oe=699C6153"}, {"file_name": "LOTO_Screenshot_03_2560X1440.png", "id": "573510518129323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575345_573510521462656_27567032063245120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knjTUhaHUBMQ7kNvwE5y6Li&_nc_oc=AdlC2yhYuM7M6lrxiyuO4tlTGH5SuhFB-SCoW_C-w1KSvptz8spenfP81906fhk5sLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afur8LkcG523rtXFnqfisga8QbD67AhC5Jwd6auCq31QGg&oe=699C3807"}, {"file_name": "LOTO_Screenshot_04_2560X1440.png", "id": "1235165104053866", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572942_1235165107387199_2642280569870946819_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1l5cKi6ONQQ7kNvwErtTbu&_nc_oc=AdkY0-6Yq0qf4i379uU21xfldySiIm2y3jgt4R4wPy9t9SOV2FNwVM_1gLcDHEizVSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsRV6I-PTSgQGOKUO69kMOfA-iYbZvwN20Ohi5gv8VkiA&oe=699C64A6"}, {"file_name": "LOTO_Screenshot_05_2560X1440.png", "id": "516522013998626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031521_516522017331959_8954625613682135326_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dvSVrlSYxgQ7kNvwE-9hQ7&_nc_oc=AdmLwlN385JL5XL2rDY6OO0s-xQvuZsplIzZQ14N2aM4uiq8I42ApdKEdc5kKHmQqcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvsb9TQ79XRZvLkiGhudLlhszMzUUcWVRmHo5O3OY2VHg&oe=699C5B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOTO_Cover_2560X1440.png", "id": "594017779439258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035408_594017782772591_8460809143550529843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgIZ_7TrozYQ7kNvwEV3qNR&_nc_oc=Adkot4oW4Q__4GpkMeM4fGXLOQ4Sq49YzGBtReVEOku0aHyGEwCkq0K3w7Jwkfykt14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvTVzMsrRyDEUkrNhA3Bas2JmwQjd77RjHc1YYIiBm1Kw&oe=699C3A63"}, "display_name": "Lock Out Tag Out", "keywords": [], "long_description": "The lock-out-tag-out process (LOTO) is essential in protecting employees from hazardous conditions when servicing and maintaining machines and equipment on a job site.\n\nThis interactive simulation invites participants to explore and practice the steps involved with locking out and tagging out (LOTO) equipment in a safe environment. Based on information available through the Occupational Safety and Health Administration (OSHA) website, this simulation guides participants though a background primer, providing context and identifying various parts used in this process. Next, participants engage in a sort-and-match activity which reinforces their understanding of the components and steps. Finally, participants explore a factory setting and put into practice what they learned by locking out and tagging out several control panels connected to manufacturing machinery.\nThe simulation provides instant feedback with either \"correct\" or \"try again\" responses to encourage participants to reconsider their choices and allows them to revisit any part of the simulation as often as needed.\nEmbedded learning objectives based on Bloom's revised taxonomy include remembering, understanding, and applying.\n\nBenefits include: \n\u2022 Realistic 3D Tools, equipment and environments \n\u2022 Interactive activities \n\u2022 Transferrable skills", "short_description": "The lock-out-tag-out process (LOTO) is essential in protecting employees from hazardous conditions when servicing and maintaining machines and equipment on a job site."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "601282068141079"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24503156992601112", "version": "2.2"}, "id": "711257100545147", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6304515709558518", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24503156992601112"}, "release_status": "RELEASED"}, "binary_rele
TO_Screenshot_05_2560X1440.png", "id": "516522013998626", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031521_516522017331959_8954625613682135326_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVal8pDytg4Q7kNvwFw1u0D&_nc_oc=AdqjJjH3itUlxL0AkbXl6UJUAHmUhDQfrkl3_q1xRACF6j0d8vDPqWu1QgeTnbYGcP8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRY9FU13uC8XWozH-zSDfqlipZFKoSwWHkygGF_qMm6w&oe=6A58E19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOTO_Cover_2560X1440.png", "id": "594017779439258", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035408_594017782772591_8460809143550529843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2OBhyAwyHUQ7kNvwEq856V&_nc_oc=AdrOEyLvHczdit6cFNXNMF3iTWA96VH17tHNsmFNYDs-GQOykwuawimX4x8lASkGiv4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANllJYkGx9qQhDX3HnuXBdn0Tl17kUPdJIF7HWjULs9w&oe=6A58F923"}, "display_name": "Lock Out Tag Out", "keywords": [], "long_description": "The lock-out-tag-out process (LOTO) is essential in protecting employees from hazardous conditions when servicing and maintaining machines and equipment on a job site.\n\nThis interactive simulation invites participants to explore and practice the steps involved with locking out and tagging out (LOTO) equipment in a safe environment. Based on information available through the Occupational Safety and Health Administration (OSHA) website, this simulation guides participants though a background primer, providing context and identifying various parts used in this process. Next, participants engage in a sort-and-match activity which reinforces their understanding of the components and steps. Finally, participants explore a factory setting and put into practice what they learned by locking out and tagging out several control panels connected to manufacturing machinery.\nThe simulation provides instant feedback with either \"correct\" or \"try again\" responses to encourage participants to reconsider their choices and allows them to revisit any part of the simulation as often as needed.\nEmbedded learning objectives based on Bloom's revised taxonomy include remembering, understanding, and applying.\n\nBenefits include: \n\u2022 Realistic 3D Tools, equipment and environments \n\u2022 Interactive activities \n\u2022 Transferrable skills", "short_description": "The lock-out-tag-out process (LOTO) is essential in protecting employees from hazardous conditions when servicing and maintaining machines and equipment on a job site."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "601282068141079"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "692494280413188"}, {"status": "PUBLISHED", "id": "917354569581539"}]}, "baseline_offer": {"id": "692494280413188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743820, "status": "PUBLISHED", "id": "692494280413188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24503156992601112", "version": "2.2"}, "id": "711257100545147", "channel_na
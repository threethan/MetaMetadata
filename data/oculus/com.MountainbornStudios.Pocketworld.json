dn.com/v/t64.5771-25/593858738_1170194818427453_3782561851121064329_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mauk0EC-bIgQ7kNvwE-UWlt&_nc_oc=Adpe9gyQUjqCU8T0OjnbKBKpkvrOQXyC3AdyaKl5c0hVBV9P7zKTBjxz04jnhom2LAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObZWDllYNNcudvx5zWJriM3WODQWhgHfuZ5HbQ26aS3g&oe=6ACBAE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "751438617365324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822817_751438620698657_773197741450089135_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnwGuo-JPLUQ7kNvwG1RyO1&_nc_oc=AdrTR2mAjudLobbmS0KVBmhW-PdJy6DGo0rP5vPoFG6x0jCShyez8-cpL3wAgg6bZ7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO7vjhlrGiX5iLiTNiwtX6dQb6vwlIbqSz0dqKWYpeKQ&oe=6ACBA3AC"}, "display_name": "Pocket Lands", "keywords": ["voxel", "build", "mine", "create", "sandbox"], "long_description": "Build, dig and discover in the Pocket Lands! Open a diorama the size of your lap to the whole living room floor and shape the beautifully stylized world directly with your hands. Or, drop in and immerse yourself fully in the boundless lands waiting to be explored.\n\n**Welcome to Pocket Lands in Early Access!**\n\n{2617199648654907} \n\n{718705657598736}\n\nPocket Lands in Early Access offers a voxel world with a unique visual style that can be discovered and shaped both in diorama and fully immersed.\n\n**Available now:**\n- Beautiful voxel world with various biomes\n- Volumetric world diorama from the size of a paper to your whole living room floor\n- Godly perspective VR diorama\n- First person VR with smooth and gorilla locomotion\n- Day / night cycle\n- Effortlessly place and remove blocks directly with your hands, or with controllers\n- Intuitive tools for quick construction\n\n{1553411572666379}\n\n**Coming soon:**\n\n- Climb the leaderboards in multiplayer build battles\n- Group up in creative multiplayer\n- Cave systems and underground biomes\n- More surface biomes\n- Creatures roaming the lands", "short_description": "Build, dig and discover in the Pocket Lands! Open a diorama the size of your lap to the whole living room floor and shape the beautifully stylized world directly with your hands. Or, drop in and immerse yourself fully in the boundless lands waiting to be explored."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pocket-lands.com/privacy-policy-quest", "developer_terms_of_service_url": null, "publisher_name": "Mountainborn Studios Lda", "support_website_url": null, "website_url": "https://pocket-lands.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "ja", "ko", "pt", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28514179648170007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618069_2048059959310296_2779477667079505304_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC4yVcQeF7UQ7kNvwGXfvLa&_nc_oc=AdoOdzcf-mebCoKeLmZjt8d9T-LAZttAdXlarLSxXMM8-CHCQeaHb4mvV4LcWr7dWHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm7wdOJdX2o4vGE1ctTVHAVQkvA9lOTxjs2zHLnLtz1Q&oe=6ACB8F9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pocket Lands", "platf
}, {"file_name": "shot2.png", "id": "1643175250546021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673536876_1643175253879354_1874946457627633010_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox-EAanZDMsQ7kNvwHC8SKp&_nc_oc=Adp3JDxOlfKBD3jiSmraIXflBHjXSs4O48zmRngwjydlhINBZ1VCHUYXI1BT8Ubxba0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYxm-PQy5cFYZfk7VCo7XbAjLgYVBHqFGC5sXrKqwdiQ&oe=6B0EF3B9"}, {"file_name": "shot3.png", "id": "4450850158559034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673645340_4450850161892367_1876312866596382620_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX7fkmFY-60Q7kNvwGy0FlK&_nc_oc=Ado4L0SbywVZs8c_5oqKRZMk4qB4x8HaqroLi70M85hrodygGngWXTCUib_NLxK3tOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPVBmyhKrAc8BheWA9Tp9s0scvmmuwMbhn4FL5THeGQg&oe=6B0EF9B0"}, {"file_name": "shot4.png", "id": "2891451994567999", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604375581_2891451997901332_8354427640441849409_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_n7e6ChkrAQ7kNvwFxt355&_nc_oc=AdoZsqUzLJQfGWwPQbwjAyrHgHk-zAeIM432Np-P7sIbudvJ7OuKywxei4gYme9p8sA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXs911JPaq7_-ZK2HxJgmePJ1TO3lMIZCjdcPKjpcyhTg&oe=6B0EF72C"}, {"file_name": "shot5.png", "id": "1503433708506240", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585799753_1503433711839573_4622762165870069807_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUwKacuMdPkQ7kNvwFwE-E3&_nc_oc=Adpx0qGHlp5MKl3YWP5z_DGnUnlj_-5n-ASDTXGGhElDurYDUOvYblGzOaH8LgF7w4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAxJovk0CzOAxPrhpPi0tkNyig0tC7QAQ9DiXWXwEWNA&oe=6B0EEC11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SprayMap", "keywords": ["irrigation", "sprinkler", "landscaping", "lawn", "contractor"], "long_description": "SprayMap Quest brings the SprayMap irrigation design tool to Meta Quest as a large, resizable 2D window.\n\n\u2022 Satellite map of any property: draw the property line and zone outlines\n\u2022 Auto design: turn zone outlines into heads, nozzles, valves and pipe, then run a design check\n\u2022 Nozzle catalog with manufacturer charts (Rain Bird, Hunter and more): GPM, radius, arc and precipitation rate\n\u2022 Spray arcs you can see, adjust and aim on the map\n\u2022 Drip zones, pipe routing around the house and hardscape, sleeves\n\u2022 Valve boxes, controllers, backflow and other equipment pins\n\u2022 Watering schedules from local weather (evapotranspiration), soil and grass type\n\u2022 PDF reports and project files to share\n\nControls: point and pull the trigger to tap. The thumbstick zooms and rotates the map, and on-screen buttons zoom, rotate and move it.\n\nPrivacy: no login, no ads, no tracking. Your projects are stored only on your headset in an encrypted database. Satellite maps, address search, weather and soil lookups need an internet connection.\n\n\u2022 All Pro features included: Inspection Mode, inspection reports, Work Order Estimates and your company branding. No in-app purchases.", "short_description": "Design and map sprinkler systems on a big virtual screen. Draw zones on satellite maps, place heads with real manufacturer nozzle data, check spray coverage and precipitation rates, route pipe, and build watering schedules, all in a resizable window. Made for irrigation contractors and serious DIYers. No account needed; your projects stay on your headset."}]}, "developer_name": "Levi Beaird", "developer_privacy_policy_url": "https://sites.google.com/view/spraymap/privacy", "developer_terms_of_service_url": null, "publisher_name": "Levi Beaird", "support_website_url": null, "website_url": "https://sites.google.com/view/spraymap/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1441232085734264"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1461587679186609"}, {"status": "PUBLISHED", "id": "1125846870201276"}]}, "baseline_offer": {"id": "1125846870201276"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793756100, "status": "PUBLISHED", "id": "1461587679186609"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1526866410504164", "version": "1.1.3"}, "id": "1148378247720133", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1441232079067598", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1526866410504164"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1148378247720133"}]}, "change_log": "SprayMap Quest 1.1.3 brings the headset up to date with phone 1.0.78.\r\n\r\nIrrigation Audit is now on Quest: place catch cans on the Simple map, auto-place, pan and zoom, then export a PDF, blank field sheet, or CSV. All-zones reports include every zone with cans, and the volume keypad stays open while you enter readings.\r\n\r\nAlso in this build: acreage, a Head report, chart-based precip and IA run times, Boundary Tools and per-type colors, collapsible Settings, and closer Plan/street zoom (about a foot of yard).\r\n\r\nSatellite stays the sharper Esri retina view with keyless fallback, and joystick zoom and rotate speed sliders are still in Settings under Quest controllers (default 1.5x).", "created_date": 1795748727, "id": "1526866410504164", "version": "1.1.3", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1441232079067598", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1526866410504164"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1148378247720133"}]}, "change_log": "Updated to higher quality maps. ", "created_date": 1793894386, "id": "1483449638179175", "version": "1.1.2", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1441232079067598", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1526866410504164"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1148378247720133"}]}, "change_log": "Update fixes black screen when map fails to load.", "created_date": 1793892823, "id": "1483408498183289", "version": "1.1.1", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1441232079067598", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1526866410504164"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1148378247720133"}]}, "change_log": null, "created_date": 1793675291, "id": "1476674865523319", "version": "1.1.0", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1441232079067598", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1526866410504164"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1148378247720133"}]}, "change_log": "SprayMap 1.0.2\\n\\nNew in this update:\\n- Inspection Mode: walk a property zone by zone and create an inspection report PDF.\\n- Zone info fields for each zone.\\n- Backup and restore your properties.\\n- Improved property system report PDFs (landscape layout, better text wrapping).\\n- Sleeve routing for drip zones and hardscape.\\n- Issue pins now drop where you tap, and you can drag them.\\n- Importing keeps properties that have no location.\\n- Level tags and a flip control.\\n- Thinner property boundary line.\\n- Rebalanced size sliders for heads, pins, labels and pipe width.\\n- Bug fixes and performance improvements.", "created_date": 1792813066, "id": "1450804434777029", "version": "1.0.2-quest", "version_code": 12, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
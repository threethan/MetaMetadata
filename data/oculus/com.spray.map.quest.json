FqOtK91h738sZjjT5IVBHghiRKlt5R2cVAvhF0E0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFQxn--ejvoaVNvcA9ZjH8emB270LVWi4zwQxfs1m8Ww&oe=6AF4992C"}, {"file_name": "shot5.png", "id": "1503433708506240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585799753_1503433711839573_4622762165870069807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw_SNbjbzNIQ7kNvwG2S5CT&_nc_oc=AdpLROQkgY-iZ-H614zxMzlAbTsG_ErnyW9-6UicFeln09g8v3vvZWqBnzwwlfIvr84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLKpUKOzpgLHOcABOkcGiySUdu4nbLn2kb71ymTBvmpA&oe=6AF48E11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SprayMap", "keywords": ["irrigation", "sprinkler", "landscaping", "lawn", "contractor"], "long_description": "SprayMap Quest brings the SprayMap irrigation design tool to Meta Quest as a large, resizable 2D window.\n\n\u2022 Satellite map of any property: draw the property line and zone outlines\n\u2022 Auto design: turn zone outlines into heads, nozzles, valves and pipe, then run a design check\n\u2022 Nozzle catalog with manufacturer charts (Rain Bird, Hunter and more): GPM, radius, arc and precipitation rate\n\u2022 Spray arcs you can see, adjust and aim on the map\n\u2022 Drip zones, pipe routing around the house and hardscape, sleeves\n\u2022 Valve boxes, controllers, backflow and other equipment pins\n\u2022 Watering schedules from local weather (evapotranspiration), soil and grass type\n\u2022 PDF reports and project files to share\n\nControls: point and pull the trigger to tap. The thumbstick zooms and rotates the map, and on-screen buttons zoom, rotate and move it.\n\nPrivacy: no login, no ads, no tracking. Your projects are stored only on your headset in an encrypted database. Satellite maps, address search, weather and soil lookups need an internet connection.\n\n\u2022 All Pro features included: Inspection Mode, inspection reports, Work Order Estimates and your company branding. No in-app purchases.", "short_description": "Design and map sprinkler systems on a big virtual screen. Draw zones on satellite maps, place heads with real manufacturer nozzle data, check spray coverage and precipitation rates, route pipe, and build watering schedules, all in a resizable window. Made for irrigation contractors and serious DIYers. No account needed; your projects stay on your headset."}]}, "developer_name": "Levi Beaird", "developer_privacy_policy_url": "https://sites.google.com/view/spraymap/privacy", "developer_terms_of_service_url": null, "publisher_name": "Levi Beaird", "support_website_url": null, "website_url": "https://sites.google.com/view/spraymap/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1441232085734264"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1776313136936756_3746530432871355611_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fZNFx7jlUwQ7kNvwHKa2Lu&_nc_oc=Adpq33D5bNQYiMWLAmfCnu0yMxUgZxOQoz494JJQ_XKsfs7RfoA0tHHpImyuZLdC4fM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZrsHOmGUJAGLMCbrQWFbPd0bp6v6-64NHKP85p4ASNw&oe=6AF47EC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SprayMap", "platform": "ANDROID_6DOF", "context_category": {"context_cate
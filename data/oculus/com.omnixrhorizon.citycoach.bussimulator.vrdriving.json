culuscdn.com/v/t64.5771-25/499619808_1482091963944905_3641502432306233946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBusjFGXUEMQ7kNvwGL4EwB&_nc_oc=AdryXRnbCGHWUGhusbSxVHJAD7BhFTdS5dX97o8Pm2MOxle-JWct5cpw_65W0H0xq58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqbYD0tXqfxdqdvaueF7YFZCfO2cjcg7jvwz1mNGXTYw&oe=6A788017"}, {"file_name": "GameShot_28-04-2026_11-25-26.png", "id": "26989510814066898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623443_26989510820733564_9153322465955651425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqSOG0sdwm0Q7kNvwH5YvW7&_nc_oc=AdrxYyx62XDZPASmm_Eo9vf9G2PFmPmbXc0XDGTLpWNigUbI_X0ODNfo7h3Z3u6tnsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKGOwimmzNZE55LANVgTCrKTzP6QnNUCCAsZY55LC4uQ&oe=6A788B06"}, {"file_name": "GameShot_24-04-2026_17-44-00.png", "id": "4241795772704779", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314634_4241795776038112_2152481111764210791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjxtZBPhEzAQ7kNvwFfuxJT&_nc_oc=AdrN6uwqmxmNHJaYEzYrvYNxCeegs-zcBCPA-dfB_XtmZOOa4x9gsij-A8HwXSBRaKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm2lho8fmJvknA2N1zp0t9Q8J-tVyjQHh_OiI3I2aI9w&oe=6A788599"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Coach Bus Simulator 3D VR Driving", "keywords": ["citybussimulator", "coachbusdriving", "busdrivingsimulator", "busparkinggame", "citybusdrivinggame"], "long_description": "\ud83d\ude8d City Coach Bus Simulator 3D VR Driving\nStep into the world of professional bus driving with City Coach Bus Simulator 3D VR Driving, a realistic and immersive driving experience where you become a skilled city coach driver. Feel the thrill of navigating through busy city roads, picking up passengers, and completing challenging routes with precision and care.\nThis game offers a highly detailed 3D city environment with realistic traffic, dynamic weather, and smooth controls that make every drive feel authentic. Whether you're driving through narrow streets, highways, or crowded bus stations, every mission will test your driving and parking skills.\nExperience the next level of immersion with VR-style driving gameplay, designed to make you feel like you are truly inside a coach bus. Manage speed, follow traffic rules, and ensure passengers reach their destinations safely on time.\n\ud83d\ude8c Game Features:\n\ud83d\ude8d Realistic City Coach Bus Driving Experience\n\ud83c\udf06 Detailed 3D City Environment\n\ud83c\udfae Smooth and Easy Bus Controls\n\ud83c\udd7f\ufe0f Challenging Parking Missions\n\ud83d\udea6 Real Traffic System with AI Vehicles\n\ud83c\udf26\ufe0f Dynamic Weather Effects\n\ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 Passenger Pickup and Drop System\n\ud83d\udd76\ufe0f Immersive VR Driving Feel\nTest your skills as a professional bus driver and become the king of city roads. Each level brings new challenges, tighter turns, and more complex traffic situations that will push your driving abilities to the limit.\n\ud83d\udc49 Start your journey as a City Coach Bus Driver! \ud83d\ude8d\ud83d\udea6", "short_description": "Drive realistic city coaches in immersive 3D VR. Pick up passengers, navigate busy roads, and master smooth parking in this ultimate bus driving simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/omnixrhorizon/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "OmniXR Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/omnixrhorizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "th", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1209799348872300"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623370_986989997248401_1942750900892432679_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kcoiq_OCuBwQ7kNvwFjoS1-&_nc_oc=AdoFJ3FrXy0xjLHftmaQnP5nv9EQqPZpIwIBS7d8Na75gLNwSecsUUyyq73p2TG3edM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3Ra7WdynUcc0HYCoKgNJu8YZQKz_nFyrbgTccQJOFIQ&oe=6A78617B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "City Coach Bus Simulator 3D VR Driving", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1780569540, "lastRevision": {"nodes": [{"id": "1193758027143099", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1193758007143101", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1312111470269113"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "2560x1440.png", "id": "35707877742192064", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626172_35707877758858729_4595862193024859008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrdwUrXc4b8Q7kNvwHKw6fK&_nc_oc=Adr_vJAE_qiv2aFRdtUVXfdHQmFRafFO9nvF7fI_3R66po879U0KZK96YIEsxBpJpr
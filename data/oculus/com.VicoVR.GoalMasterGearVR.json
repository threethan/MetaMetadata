3_8424178919145472000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bMponYuqhsQ7kNvwHWdbv0&_nc_oc=Adpem9T6Nri58E7pb4v_ruAEKasLHM8ZqqOhm2aNFKvYvu6gnM41cIEBsGfFQg8bBOQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6g-DQk4-bw5Ijs-1zxHp8-1mRwQJ8xctWKzDZKTp7IA&oe=6A3FC36B"}, "display_name": "Goal Master", "keywords": ["soccer", "football", "simulator", "sport", "zombie"], "long_description": "Play this really immersive VR football game, imagine yourself to be one of the greatest. Break the record!\n\nYou can play this VR game using VicoVR Controller if you want full body motion version of the game. Or you can play it like any other cardboard game in any virtual reality headset you like.\n\nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Full body motion VR football simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16ZD3eMt2SHVAfrUDQrQY91Ny5MhDNFVk/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5124804100874866"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162696_501916120174160_4658192804776771584_n.png?st
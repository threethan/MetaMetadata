dn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiOsjs8ZMjAQ7kNvwEglsV7&_nc_oc=AdkcsvxdueAFZpWgqxJ4s-aquLDxjzcQCkwaD_6gbH30w88NcjiabkYpXuPn6xaFhBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcaNHfasyOvcGSuvw7DePkcw_fS1sXCSEm549PfC-c3w&oe=69A04505"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTLDI2myaEMQ7kNvwHeU1uH&_nc_oc=AdlQ_a0jPBa2fH4o3JKKjvyUKe2q1c-vka1nr7Cx6JxJVjCxpU1qZDjMfgrZ8RwJoMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs3mOazr9B-aePqTHtK3CPxeJ2j4UvNgyRlKTl46ImtLw&oe=69A02ADD"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQneOBP3wK0Q7kNvwE-6lnV&_nc_oc=Adk3D6Fg3LIamTmE1UF62EBLBKP-s6iWfGQKMkXkcgjRVsal74RgBVAOTrBWdepQ2dI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvw2-fzcJRKeu1vSGhTXGsF6SnIKNIqWB2VTNGQMLX_8w&oe=69A0463E"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LgKuCBi5hkQ7kNvwH3gpY5&_nc_oc=AdlJr_G_bcGAm7uaNAv-542EI4apjf2QeQbtuE42AGpY5XBwNnDy0r-eFaB_yBCm-Os&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTRcTiYDNiXNHgWNSCaEz_BezY1Ac6IvX9iCiW8Eh7iw&oe=69A0347C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT5KzNOjfa4Q7kNvwGn7vrF&_nc_oc=AdlGPbYhohRNtVwnTCUympWd-CQp37KAnX0OEhly0cvs6SkvLsXihqQHg01f0vWCa2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfszoQQfo6pu92usaXTIMh-hLqd-RKqsyHQLw2wlDYGigw&oe=69A037C9"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection
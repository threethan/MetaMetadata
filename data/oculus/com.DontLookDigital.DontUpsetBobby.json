y_name": "Don't Upset Bobby", "keywords": [], "long_description": "Don't upset Bobby is a atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is a atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
dn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OrMuJQt-joQ7kNvwEndsuH&_nc_oc=AdnuQNw5fnd70iAivdhEYlNp3dZLCCjkVz1778Zc6Ly7Or1itgBJX3nGMUT4cTWZ6ek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv7NL3YvuntZ-ux3Q0iM-C0vRQOXt7x8jaAXDxgh6-ppg&oe=69A43985"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_dCBahXctcQ7kNvwGOdzBA&_nc_oc=AdlqlgTc_Cdf3qWvQE1phkzn-BW2TGH5sqSlVbULvNRuo4Nx4zAjOBKhc8xwoP65zJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvQjuLscDOrQCakYawRjrT3p007YA156wxXgMVCTePntw&oe=69A41F5D"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUmU1hoXUekQ7kNvwEWXB7-&_nc_oc=AdlxIvoMvZVmaQITXUGKV_Gr0zvvWx8q09r9_P3vdD4JC1tUUE8mGnPQLHld2u2Qalg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftAyCu6j1-G9ecAKIzEZIWcIs-RPDs6nXU_s3ebdMf75A&oe=69A43ABE"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nVRZMXOQx0Q7kNvwGgOOwW&_nc_oc=AdlmGkj-9BWe3QNiCIRgSQROS7N861CzcIbnnvGxKicoGzuqv1ThnaYu4J88x7QP8p8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvzjrIK30xOZKJ9C1AdFiPZLmH4SCQ7BTG1Ei78gKCr6Q&oe=69A428FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcTTDIsHPqIQ7kNvwHiLGAP&_nc_oc=Adku4eH3iI_da2FDdaPyFjBq9FqbnJqr4OnKuIDMMWyofn1pfZatSogQn4lHT9nSOcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv-RqzaDX31zq-rwiHmCllVoSSay737WyOPzvZGfA71hA&oe=69A42C49"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection
dn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OrMuJQt-joQ7kNvwFlwRLf&_nc_oc=Adn8_kT3jRGDpH4YsenxABLg-MOxmgjNP-Fc_epCqxH25gjzUvZvLymQRwhcOYjsnWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvP_rqTJW4vxBV6NxZe106KrjfZT90mztiCvpj9c3toFg&oe=69A6DC85"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_dCBahXctcQ7kNvwHbqw7A&_nc_oc=Adl8p1Ov_r7X12_jU_5zWpVzrv-hj9yNtwRJDkfa3leoqbj2D3anh713W4Rrdkh8V3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftyf0zpMhqgTi_-xzOtfU5HzAbq1rui0QN1HJydyukzig&oe=69A6C25D"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-ftAiYyy4EQ7kNvwEERpn9&_nc_oc=AdmsDc9oiIHL0XAv5eFbV4G4HuSKuB0KVHegJCCwjvmUFAomxYxkRkoAViQ0KETB-Yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJ4VVVTm5U6S0SHBvbs6NG3YyHu0PCeMwujLZGxq-GjQ&oe=69A6DDBE"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMQTYmFzTv4Q7kNvwEuK_MY&_nc_oc=Adkj_rRfIdQepJDbqYV04Tax21c-sQcb8HyE0-iSeJPNZ7YexsxNMrqcwTmi9Q8nHcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuTccOSB4f57lMbSyyxJ5Z7t0pJwu_ZkBUwNfOTxfGP4Q&oe=69A6CBFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U73iTmH9A08Q7kNvwHrVUd0&_nc_oc=AdlUmIK90d9OMgcm_8ZI1f2dPd6SKhpCKXmM9Y88FfdtRkCxkZAGtt_uEg4BNv_vDpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCPzeHWYNLdmREzzxnZ1MTLjHLaqAmhTvlG4unpe1JHA&oe=69A6CF49"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection
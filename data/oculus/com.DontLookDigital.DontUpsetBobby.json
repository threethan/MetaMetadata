MXY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaTFJy7To-a1Xa6Oz63Yq6V3u8oBwHhb88_kq1BKxvBA&oe=6AFF1BBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lslVvo5OLGYQ7kNvwE1d6BI&_nc_oc=AdqrWlQ26ryEDziItrbZsMGfGtlrEutL07GxSNlwmunGDKxOUDGcwdCJLme_zib3Zzg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoeu765wJiBjv76TdreGbZq94tSK7Vr7-pA40SJyz4UQ&oe=6AFF1F09"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR
dn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQVpJ_Gn31wQ7kNvwGXnLVI&_nc_oc=AdkKReo54Jog9mG2MudT52KuaiFUD8yJbjKbLHl0SeogdFY2i3i9PnBewe-s15i4O-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuDVldbWf3YkAVkVLaLCVp6vkYgGrysuaT3DnoZr-u5IA&oe=69985C05"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noGTEYLCRKAQ7kNvwEOG-NZ&_nc_oc=Adk-4rJO8EBHvUN-EuLjC8v4DDyjqi_6cFOUFvZiayd7Hk1QkgTEH9VVkPp_GTZwEr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfunuPPPP6XgCriuQHgRJpYoyPOqWEINAL2nP3GSfisI0w&oe=699841DD"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vBqkdhOJmMQ7kNvwHzPkWe&_nc_oc=AdnRgtOXNiGj2FHOuOqSkOl0Yo5mqiP4QvjpxIKD8i3lJHwMBmA_9bmPEeFPWm0yG40&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftWk54IoiisJWRiM8ToSnUKYv-YgWcXnfhlWqAERU_eOA&oe=69985D3E"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCSQD6lod_4Q7kNvwHsqBio&_nc_oc=Adnh4DIMkqlchq6FazzwOBS3Jkakr8Rsx1XSTwlj75wiba83eeT-F9YjypU8HltO4ow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftGWLbyDlcH1djOO610EHQ1yPFA9LOqMgCuL5I1M40h3Q&oe=69984B7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-BjqucqOUAQ7kNvwEPS959&_nc_oc=AdlS_71WWvzYz_CK-GwHAXLXyT_0QpYzucJtaGmaMNxknY8a0nBJM-oJIU_zxVPueMU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftw1kfOi7kHF6_EMBbP2dDOGhEZT8k2NSUH4t43GSL3bA&oe=69984EC9"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection
.png", "id": "3076006989393786", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8h931I24lcQ7kNvwGVx6VR&_nc_oc=Adk8jOxkKV1z6oTZ_HDlfX_DN4oQkpitF79RtFVRR_2OI754X6_8v44tZzSQ-SklfpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftiLuOsp6ZHF2Gie6UeW06e2lgXTGXzhN9tWpLsoDSH4g&oe=69A82E05"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6yN6Y1jEY8Q7kNvwHZ6QzW&_nc_oc=Adnh738XxdBrA7EJKNRklvZjV8ARS9EGRwLZW9YTGJ4Wnxp_T-UkkU4BPp_z2zc298s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsMKN8t5OacUT21jN2UdlztqIBrxMFb7HrdQcBQpNzcYQ&oe=69A813DD"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-ftAiYyy4EQ7kNvwHtuuUi&_nc_oc=AdkjNsmHWBR6eZTu069ErFult6EmdWmV_LPOERUmC_ZtWBZgUX95nolEe9nxQRPsDeU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftIf0ARXXtw6RFDmwXLUu6K1koNVoyQLhGhi8LimDWnbQ&oe=69A82F3E"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMQTYmFzTv4Q7kNvwGTfM6u&_nc_oc=AdlCm394w5Iy94mLLGUxzHcNRHQVg5yRYvd3f7eVe2DTLzWhcoMguuiQyCes_7rwMLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsKf9d5MEJ2FNWNH1XZSwV5pIqZnLnFc7AJhixz7M8hlA&oe=69A81D7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U73iTmH9A08Q7kNvwEWd8A_&_nc_oc=Adl-NEJy5gmVswhAIzwfLw59TxMpofz5kIip1QHRxmBnOmllnk5KIEcgYQidNqU0Bpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsa8UQrytEl7fbK7WxFfnqDjcBKD1Xey9L1iZD5FbMbSg&oe=69A820C9"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subsc
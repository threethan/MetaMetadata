.png", "id": "3076006989393786", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bkLusW-bVkQ7kNvwF7xcTN&_nc_oc=Adn5AdUB9lz9jWaDu39CgkAQNpFuqgfEHiG43bkt5ILJpkLg9Ty74i0TGC3AkJ70wT4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoTPnt0mbCewfBKddYfx4CG01gYzBkygI15ghH6bJgAg&oe=69BD4605"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WZR7xL9_hIQ7kNvwEE1mRU&_nc_oc=Adn46j7YS7ZSEYZqnm3YGPfl095HcTtytszYyQkQLQVymztbba5dLv09OCg3igNuVzA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5T9BIvTqTehDobMO5i2cDMGrlb4OpEDd8ja9jZmT2-Q&oe=69BD2BDD"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llTtdR9GfTwQ7kNvwH6ioIp&_nc_oc=AdlTu6DV7brTvyxBiSifAFnTlOmXqnqDsvtdzq259aePzFtZWxMObzGqBAGplrtKNnA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVyGzxIsqK46PaphDxQngz7GovnbZb2pMG6lTS8Up0-Q&oe=69BD473E"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnN3sdsTGT4Q7kNvwFsQEIh&_nc_oc=AdmDgFpbJ4z7CQpxRrsMRtpElXMVyH1nKppaa_LMa5mIzDzHtSKewTvfg87GfBAQG8w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGRX_LhdReKoAvBwoi7esV54JLBjlWgd6hDmJlGsxlUw&oe=69BD357C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY08SGej8N4Q7kNvwGnNKs2&_nc_oc=AdlPykDXY0dAegPHzX7HP_nyz0Cia_RBJiWW8lD0-d_u7TOHs6HTW0SWW8gPlcDPtCA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQs8sN1l1aNC0Zd-E3QA-dGOWI4aQhzvSU0k4Q6MJVLw&oe=69BD38C9"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subsc
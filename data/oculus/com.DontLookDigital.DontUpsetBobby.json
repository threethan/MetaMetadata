.png", "id": "3076006989393786", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8fhPzHCtVMQ7kNvwGuiLqc&_nc_oc=AdkSaWOWLPw4K5NYwdKhnyc5jANSMm5O2KL8WTA4UaaUCNsCTcJY5uvsVFPTlXcOvns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfypJcQfB1PS7iS-U-1y92UsN_MbicSpINoG-_jrsdRaUQ&oe=69AC2285"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jHEro0Fp4kQ7kNvwE-WTVq&_nc_oc=AdkSI3MI27yprAq9NMMUnzWwUh5aTsUIEtNOsRjW5HitbppogeRnGnysku0oKzYUfAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYCgtndpfIggLaVZ9-peYn1SpLSffP3hGwag28VsH_7g&oe=69AC085D"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdXP5FVN8d8Q7kNvwH2gGrv&_nc_oc=AdkJabiEwzFlPGOSOGHliBtPzuvq-0YPDzQOrP5yEPztM-v4zYqqBr9XrOy3CJe1PLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytZYWN4HNU2aSEeXbHt3f9KzCUBOXjDj6JLeB-KBcdAg&oe=69AC23BE"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnV8FUUfvGEQ7kNvwHWeE5q&_nc_oc=AdkqOYKJSOocpWu8T2OA3q0_n1bdQjPvpg9f632b_QKAT-U4cMvMzf6KRfQObVgYYSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxewPdU1LI-kyW0Z4Dvkm7_TQuTaZh-8F7QMCDzZOrWWQ&oe=69AC11FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZCymYZ5vksQ7kNvwGH-a1j&_nc_oc=Adl61FBi9WCEZmk-R9Kf2grUUgsBiDNJPhdv7VZB0iiWv9D-WWfFbtF6-CNo0XXg_p4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfykigU63uvTDGMYtOCJ7qvl0SXr1rXrxM9kV6s6OzHaBg&oe=69AC1549"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subsc
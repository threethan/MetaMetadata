dn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQVpJ_Gn31wQ7kNvwGnE5zt&_nc_oc=AdnRHQwiNxc79ZmzfBuPoF3BtRNwFrKo0D3yoMzfzl2QkLT6u6Fmwgr2U5yDhozk-KQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftbi-wOGRH3QrCpM2SPusOwze4V4jPOOpERW-hdY3QKsg&oe=699AFF05"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noGTEYLCRKAQ7kNvwFOUGBR&_nc_oc=AdnkmGIP3PtlrZcK57VmMBxoHJ4R09p0oqrHHrb7KwSxwY4TL8Pd2qUMac_yHHxExgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsN7J7Ojqm4rFTsB_hvSRpHJKQ2i6NoAQwyw-SQHPLnnw&oe=699AE4DD"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=norkBO_NjOwQ7kNvwGLPENC&_nc_oc=Adm_PdlBVUZNfTpBVrkfHOBkFS003bcSKJSG3AIUt_J62RZYxH3Cf9JhFvgBBzjQIp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuajTn7RVhHR6JigSKcz0U6sVXvkYzEjVg_SNPNOn0JPg&oe=699B003E"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhiVlc4gdY8Q7kNvwFC9MWf&_nc_oc=AdnCd-DdOCcYTa6kpjBU41SxN52PK17_NyKC-xQfDtmPnBmIp6xPGOm71_58n9UUcYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft_oADUEvgBUFcXvSkodD4GxmN7oDAnf_o-t5nCZno1IA&oe=699AEE7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8nWmKQp9MEQ7kNvwGSWVHb&_nc_oc=Adk7-fkdHYSP66ZaZMu36YGBg9FgNPw1PDL3ZZ-uaDyYXm5kcf-P4qzBzCSAHElHSh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftjF1QnU92m4XH0Z_HsvG5qvvmmv-MxBJAA0f8WYd6cDA&oe=699AF1C9"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection
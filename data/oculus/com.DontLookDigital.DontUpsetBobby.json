dn.com/v/t64.5771-25/38974794_3076006992727119_4400826806301478943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfTB87cp9pEQ7kNvwEGSYFA&_nc_oc=AdqVkl8MoNiX25r6NRD-0BD1_srQ3fUwDsFT0lR44apzb8ZlrlJlEdaHrzobm3xYhlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0qjQGmoTPQanQs-69Xnmsj8L7dkBZr-hzxuxnLLGsjkQ&oe=69F0B085"}, {"file_name": "ApplicationFrameHost_6Qw91WhoVv.png", "id": "498126534779496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031396_498126538112829_1378413552755087477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceJBJznnCMcQ7kNvwH4n0oT&_nc_oc=AdrBv1IT-ALnnvl9uSv6QgYJ73T9ZYxwXjh1TIfoip3b2nRnwkjrMATLYdNmtsyzH4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2ucFM2CyIjX6KuHTKeNzAg8Sf5EzfjyzYLTszLFlhVoQ&oe=69F0CE9D"}, {"file_name": "ApplicationFrameHost_jbMf79zCur.png", "id": "346287257015945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036630_346287260349278_2320292818359807965_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XLleDltw_UQ7kNvwEx9Sd8&_nc_oc=AdqDvfGBrDjtV8kT1fzy1kJLK8UdbK3ytAxeCcKprz-GPLS1pttEx6i76OaH7G1kBSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af14Asc8nsfYX-AeY5_tHquS56ghBz5wXUZlXueWdAdJzg&oe=69F0B1BE"}, {"file_name": "ApplicationFrameHost_CcyLQYsUHZ.png", "id": "293525552457715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031542_293525555791048_290894785772838201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FhnPQQet_IQ7kNvwFVvaiP&_nc_oc=Adp-6BDgR7yy2NNANwoe4mXUGJdlRYbYeYjc_3ERo6c2cWJRm7YzM_3-XOQX_meeVhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0qYIo-iPKsxvLt1Bl1ioHC-rozZdaIz-eY2uA292Z74A&oe=69F09FFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 1440p.png", "id": "512250323371014", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974530_512250326704347_384084029836794533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWuwij4Et1MQ7kNvwFJrtQf&_nc_oc=Adp_XJtBEhsMvjpPwGn9rrY0Xzy8_j47J-nMtNT9fMmt114EaTtUsCP4DU9nAEjnxYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af01bgw5r2c_kBHAmN1SKHsd9Bz5uPUjS3y18R8fuOEj9w&oe=69F0A349"}, "display_name": "Don't Upset Bobby", "keywords": [], "long_description": "Halloween Update is live! Enjoy the spooky decorations and the new puzzle! :D\n\nDon't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting...\n\nDon\u2019t Upset Bobby was birthed from a game jam in 2019 and we\u2019ve decided to polish it up and upload a demo of it for you all to play! We hope you have fun with this small and creative experience!\n\nFeatures:\n-Three fun building block style puzzles that increase in difficulty\n-Fun and stressful gameplay\n-Fully physics based! You can interact with most things!", "short_description": "Don't upset Bobby is an atmospheric puzzle horror game, features three puzzles of varying challenge, and a fun yet spooky environment to interact with. Take on the challenge and compare your scores with your friends to see who can complete the puzzle quickest! Do you dare to take on the challenge? Better not keep Bobby waiting..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e28DSircxgz5TjDWOw_z4T00yAEvEiCEpeUjR4VcdO0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection
, "locale": "en_US", "screenshots": [{"file_name": "Image_4.png", "id": "2393142664487625", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_2393142667820958_7062084591444573963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JgucMid1-cQ7kNvwGNb4bR&_nc_oc=AdoMZ6RMeV_ka9cbShqDmL6CReAOeDnfdUFK44nYn1PGc07UrQjO-YZ9c4fXynoqMUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG83bH5gjkDPN4VJmAzxK-tNg0Qxm6rWDqcNCMZhIhOw&oe=6ACBAB80"}, {"file_name": "Image_5.png", "id": "913260408140399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818849_913260411473732_7937911137740643257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNr7ZyhUQKgQ7kNvwHsq6E9&_nc_oc=Adr9-IJb1o4W9ckDuLVCr7n7KfLkNhu-RoKsPkHaa8oEqGYxejXZ4iB7GfxfjVskBl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZOS4ftlj42Qn021QI8nsuoJyspjiiEJF9Y622yPtUvw&oe=6ACBB558"}, {"file_name": "Image_1.png", "id": "5353900231501083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_5353900234834416_723779727661070189_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZbAlui5YboQ7kNvwFtd3eK&_nc_oc=AdqtfFdb6HMd1sybw6FuOiVd1mjmgC2ljmbJT60cSUlgOu-fTUV4fFRdSy6mnvx_EzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-vXoKj598TK2V6UZ30yxNB2UDWkbVkg3xmhofP95LSA&oe=6ACB8DD1"}, {"file_name": "Image_2.png", "id": "1767007927606206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821702_1767007930939539_4738782023705261456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YgteW2mlSQQ7kNvwFkbDec&_nc_oc=AdoqVChayhnq35_rPbtSUNvwGSwncWKlBacyuOZq3zRJ08LP9cC6-8M1jRR553K6WvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQy0XHYwTx_9y9U8P9hMm2pnyGs0gTe-qbTRRB0qWQog&oe=6ACBB9D5"}, {"file_name": "Image_3.png", "id": "1849343669372504", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1849343672705837_9076201250222671702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvtl0KGFIL4Q7kNvwFnprLr&_nc_oc=Adr7ZLz1D0hJ_XYVILXQ4gIzGHqi6-w2X4rvSBd_clwrDmScX44cY3sAmudbyHZe4-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmTXCfe_Qa9X3nL8_74r4O7X07N3kYSM9txSbBR0BlrQ&oe=6ACBB295"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Couverture Video.png", "id": "1495417992394766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/793139181_1495417995728099_3344448944257670123_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E32g-fyFVwkQ7kNvwGBce_V&_nc_oc=AdoELmygUM_K-XMjte_0Q-Lj5-2F2RAnUX4WIQpNQNHM5ZIkOGCP0N2rnqNTtPC1E3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkHkj3iu2EO1pdFcdimYkBZ5IfwQz6JLWutkqAm_JbcQ&oe=6ACB8FA3"}, "display_name": "VRExplorer", "keywords": ["metavers", "digitaltwin", "education", "science"], "long_description": "VRExplorer is an immersive virtual reality platform for exploring, analyzing and collaborating within large-scale, complex 3D scenes. Teams meet in the same virtual environment to visualize, examine and discuss projects as if they were on site.\n### IMPORTANT: ACCOUNT REQUIRED\nA user account is required to log in, and accounts are currently created by our team. The app cannot be used without one: contact us via https://www.vr2planets.com/vrexplorer/ and we will set up your access. Self-service sign-up is coming in a future release.\n### EXPLORE MASSIVE SCENES\nWalk through vast, detailed environments at real-world scale with high performance: architectural, industrial or territorial projects, terrains and digital twins.\n### IMMERSIVE COLLABORATION\nSeveral users join the same session and interact in real time. Each participant appears as a 3D avatar: you see each other, talk, and go through the same data together. Join from anywhere in the world.\n### ANALYSIS & MEASUREMENT TOOLS\nMeasure, annotate and inspect directly inside the virtual environment (points, lines, polygons, area calculation) to support review and validation.\n### OPEN TO YOUR CONTENT\nImport your content in standard formats (OGC): DEM, orthoimages, 3D Tiles, point clouds, GLB, OBJ.\n### TRUSTED IN THE FIELD\nUsed by geoscience departments across Europe, industry teams, and to train ESA astronauts in immersive planetary environments.\nDeveloped for 10 years by VR2Planets (Nantes, France).\n{1222118069463447}", "short_description": "VRExplorer is a virtual reality platform for exploring, visualizing and sharing massive 3D scenes in full immersion. Built for collaboration: several users meet in the same virtual world, see each other, talk, and analyze complex environments together in real time, wherever they are. Import your own data (LiDAR, photogrammetry, point clouds) and use integrated measurement tools for inspection, project review and decision-making."}]}, "developer_name": "VR2Planets", "developer_privacy_policy_url": "https://www.vr2planets.com/eula-vrexplorer/", "developer_terms_of_service_url": null, "publisher_name": "VR2Planets", "support_website_url": "https://www.vr2planets.com/vrexplorer/", "website_url": "https://www.vr2planets.com/vrexplorer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29204168199168692"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307505_903590228989166_54627986293963957_n.png?stp=d
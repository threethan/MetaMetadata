ps://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPH8JliPXygQ7kNvwFyUBmG&_nc_oc=AdpdlYWRq3-ihy9xlVaalRdgJAPgvxB_QYksl7Ao2-tEDQvsK5drlqiGfNVWvHWTPRc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2J-FIX_lNNQ7RWVL2xwtMsmkdjaKox7xGKDVy9nLoaA&oe=6A859D56"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxW6ZheYCAQQ7kNvwEdr4Fb&_nc_oc=AdqM-egrlHFd5hz8VOuvYe17Mwztq7pgC0tMMOmcyB1kduOHFL85XozpyW6n_O0Dceg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV_NI1AOpVBzxjbSz5H9dXZHCKSmMwqB_dnyeOe3gAGg&oe=6A859C4B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkiaT5Piy5AQ7kNvwHZKmQG&_nc_oc=Adp9e1Fss7WhK_JjEpv0omGQTs-G9rhiU80CViS-AScitblpX-hQSECfuWQ0z2FtiGc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-TBa9SMKT0IXcl5LKhBK8lLh8eeo6stfTqsW49uF_Vw&oe=6A859C82"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etwimvaVh_oQ7kNvwHvBzsh&_nc_oc=AdrD4b1nWWDFwDOXq4pRmys0SEG7pVv-h82qWwFy_HI6_AEh3tIMYOi6Zq3wNLuFh3o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4xhnUTZeunDr6Hg3AGXqEUUaSVlIZNd79P2nShg7wJQ&oe=6A857C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZFBrQhLVHwQ7kNvwENkBFu&_nc_oc=Adrf2f_dqaUadyfFnTqji9pgCEmqJaYFcKHQXp1JCgKRmVz8FFikx6GUUBgGU3RxFtw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFehdgCwGpNy3rUQdjilvI384jdAtMEN1SXaYHrGwZByQ&oe=6A8583B7"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED",
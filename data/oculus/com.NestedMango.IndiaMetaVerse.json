-iad6-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_QnyxLu0gMQ7kNvwGXM0KW&_nc_oc=AdojTLT70A-wAyp-Q4-MeO4NdHef9AQdYtQ9X3629pRyWc7dcdWyxNTgsvcyucEQ7os&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g7uQ0qevMbSfk9oKPZOb6Gh_DcKX2dQSlHDpSXuXq2g&oe=6A3C0196"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJhqpv_wugwQ7kNvwE3hPpw&_nc_oc=Adojj99WBHTXPndFJzgDcIINMjaXWrvjGrgAz_Hml0L6ow6mmB-Yk5g9A9UVkjjUwAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W6lpxZGQxfNk9ST4-Nh_w3vWG79agPS_QSfaqszFxSQ&oe=6A3C008B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DweWPAzINcQ7kNvwF-DTB2&_nc_oc=AdoZHGHLEv790Stx31ROmFhKe9wnADbCAZ2afda5Pzc8YWPZtDYmgMwbsXxeNmtKngE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7sIIHIL-_bJjMuFEtGCXuxGHil2gQdNX98-GI7vZwAw&oe=6A3C00C2"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOJFHtMFS7wQ7kNvwH-NQPx&_nc_oc=AdqIYBQ_jm6aqScSFliFZbuqPHvLvb8mDGfveV5PLxsVLlCCVoFNDzYbTh40qRQ19CM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s-bkG3PxUUWggb2-Qrqq8ZJ7MU10GQaU00DXGpebneQ&oe=6A3BE062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiNmAkecfqEQ7kNvwFSxpQC&_nc_oc=AdpJZKxKYj3vigT51hDRna9NCkRAOKEzBDKr_7xkbXJ1ujjaR9ZetP7Dt12CTcpF2_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_efZ9PDp_0GKGaT5vUdkEnDPQwWX498UdCCyddLFnf6g&oe=6A3BE7F7"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
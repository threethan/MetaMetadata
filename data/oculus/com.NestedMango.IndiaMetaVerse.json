ps://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syOiOOOB_qAQ7kNvwGuBj2s&_nc_oc=AdpJqHGkxf_fhR21KM5DX5aZ5h0RFEwULESXU82wQPwr4_ne_Ouxxl8krCSNHjsM7Uc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeAYY4eDDR7yW6R-EHeyRNsrXJHsoVyc3B-0PSB_xyQQ&oe=6A8ED7D6"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuXrcxfKROYQ7kNvwGu048b&_nc_oc=AdrEXML4Yp8vQ_-EPJZEiwv_aDlqdAB-yY7Y6MYHpik49xbC-PQZZ9Dnqo6TEb7pI1o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmwTE_DH2TBVmZ2PHpb0ujJPKkrxFiPXN9X8BvrO6J9g&oe=6A8ED6CB"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Elo3lMIu1UQ7kNvwFbC11V&_nc_oc=Adr_H759iZxDwENNZjqrZTalUaLkMiadAJTXcqEArU6KAa768lMUELfMBsr4ZZ-rKOM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9YAcDXd2QZkcIQYV-JjLKRD8bGH-gfuBEmOOvmb1OMg&oe=6A8ED702"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoaJMSAOpKIQ7kNvwE4VfZi&_nc_oc=AdrisA0M5GtG2vBQXMbr7WHpGFfL8K6VmVLpOV2DwAHPAYw1ylq3IFLeQ5COYZPGprs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNhKUhVGxy2sewsmMxSj-kOiqA6oCtvpmxFbohMX0JKA&oe=6A8EEEE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrpMGNV1njgQ7kNvwHTmau4&_nc_oc=AdpoJ3LyZKJsoLEt9rgYAP8QnaG3cN5wWpAjzdzhsnO2dvu-YMr57YetzfNw43vJnZs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0Sp1csdioZoQul16AfMAOe6aeoX0DtQ8YDUNdHCnp8Q&oe=6A8EBE37"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED",
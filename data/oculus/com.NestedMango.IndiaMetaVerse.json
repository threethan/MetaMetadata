-iad6-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vMQTTDe4aEQ7kNvwHrhiGi&_nc_oc=Adr4s7roo_zIeup2q2P5kgVVBLicHJl5eEgwZa1DQ6_YWzph6O4zBzj8LERbydqo4E4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_Sbz-nmn1Q2o1Q3Ghf735n1sgjVCtzxOHpUxPryfiuQ&oe=6A4CECD6"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CitNwIclJqsQ7kNvwE-zyVN&_nc_oc=AdoskMK27hyLRuHAP12MKg8HndivW9RQPmtI8TM6twfvwLxIMS6VCrstFp2nILEszJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcSJ4YhS4zlWpNz_BpF-dU2kMO1C9FTj9TxTw_wgV6sA&oe=6A4CEBCB"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N65f3cjZsFUQ7kNvwFVS8NU&_nc_oc=AdqSQzamj8_i7etr-zaq22ZYE2YlpwdDmpVoxkYyXL99kHELD61Ie2_o_7mdXudH_Zw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKzalgoinaMuBRlGbVsVNBYwNhtYAJsuyh0dbdCUzxmQ&oe=6A4CEC02"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmGvuGJ98NgQ7kNvwH2XbMw&_nc_oc=AdrapYQnF3dqHaxp3LQ_TTWCyZBY8Va5yJq02txpz-i1Q8A1x2kDSNJwlVp4VBF_YCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU0QonvPHtCmwSguVdMpXTc74NJXkzbtUZqCjj9mHkiQ&oe=6A4D03E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9a3DXyl-RQQ7kNvwHej5xU&_nc_oc=AdrjZRKtkFx3l89RizMiTQg5eOORM3S7-CZVmZ7TICk4kJp9Gm6fRqLIuIosKKShKoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH2fVmRmJixm010SA5asJgJ0feS4IqH7puqm6KoEji0A&oe=6A4D0B77"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
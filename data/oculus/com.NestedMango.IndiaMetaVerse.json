-ams2-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_QnyxLu0gMQ7kNvwHTtYYi&_nc_oc=Adq3iRFir_eO9IrHA08l_XfeBU4P2xz8HLK-Mcdy7nPXjiyScxXhhF36pw9WReg54JU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98duBqfi1bOAFkqdwyhltR878Sc116gVU5Cv4YAyO0-Q&oe=6A3EA496"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7pEzi2rt_4Q7kNvwGoC-bQ&_nc_oc=AdrNPChxibq0C9-c2YqwpiU2nvj6zr_Du553kEkYEViFmGBz8190FcSk01ud-Hy8e5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y5_vA8Zjg7tbKPEIaRcF1JN24xdhP6UeI5o4DmvpsBQ&oe=6A3EA38B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTCy-9KiSxsQ7kNvwFAmHiV&_nc_oc=AdrV7smDf2f0goMykb6fcOf1yEXfmCg2Idkll871DT2HB6v-q9SeATED4Pn2aJc29pg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HJXW0QEv-RXY9hTLhnjwk39bD3b0XL6_c2YfomkmQKw&oe=6A3EA3C2"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxcq3LR0LSEQ7kNvwGfjalu&_nc_oc=AdoSPT9kL0oo_5UlXXApV4uKNN0fEgfMmjQoWvr2aRG-9dgTJXXRAWxR63VFE5sDlXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9FjUVXKqC_0RfQHTpw8BK-kQwGosUqJnjlolgRqTFxw&oe=6A3E8362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIuLsNlkhYIQ7kNvwEpOquV&_nc_oc=Adr04T77ewXLq5t4n2sDlXHAMCw3xnwJkPVuVBIZKoJA6i6eEUlThTwvbdiGEdM1DJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m6RnqwHRtawjNLQnoun6AEZHTpZs-tdWM2nGbArygcw&oe=6A3E8AF7"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
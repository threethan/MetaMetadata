-ord5-3.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL9ExVt6uE8Q7kNvwE_OGaw&_nc_oc=AdrKpUsTxmV0tYXoTpg6oA7bAPTp1tLpk7txl2C2RLepj0wlW_FZgdI0tYk6hgfJwuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8aDx92XG76rb6JDW3JZaB8NtILGttvdnBlYVai8toRQ&oe=6A43EA96"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB096yAJx_EQ7kNvwEUhORP&_nc_oc=AdrNbeeZSdtiq434-9mp_EUai1nTEGPKSDZHyAMZxcs-16Np8EwPcW6CFF-K8WUIsZs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tpUo6AP8ecKZ-jOHIRWvI2sSyXqQEuQOuvVa6VSoKpg&oe=6A43E98B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nHw5Sv1dqkQ7kNvwEF8byh&_nc_oc=Adpoj5F_6uFptwRXogrd_vuIurZQVDShUwHfNKvmcDen1W0Y2TB4keRW3R1UVJFyCQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BUt3LVJjLih-2ZMZHLaj_CKO2LLKjBMvcTTJqXvQjsw&oe=6A43E9C2"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XZV01xXMVIQ7kNvwEdqRxQ&_nc_oc=AdpZOkVYsH_sncVnzwAa9iocEs3cG6GrBqhwMwV9CeyU1EWy_YEqUzjtNakMKg0KNVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UqyulFTF3ZI4gHbans2e9hbVmX8mDaTukkdRKNCYdhw&oe=6A43C962"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaGfHn7D09kQ7kNvwGzdHa5&_nc_oc=AdqmOfqpR7LrDBqdkA8_hJxfTAECxXjktRbdxU4Ma_YMQUAcK6r-DOgvBg6XneVYbWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q91CnVvXpSI_wZB2zEfgnm8njKQQSGwWMiLF6TAycBA&oe=6A43D0F7"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
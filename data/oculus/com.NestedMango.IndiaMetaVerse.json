-sjc6-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BchrT7Roz_UQ7kNvwFDHsYB&_nc_oc=Adq2U2UDLNlWdS5HOqHtAMXyer_l9mhX2A4giSoReDoghcBbpcgmHtTZMHaVUP3XXl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i-ojkkKbhY3TC5PWIEZvkiQ1R_JyoiU01G56115eV-A&oe=6A429916"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB096yAJx_EQ7kNvwGbeBIH&_nc_oc=Adq_mjQozeKgCHC5Q1sKbvPrr4F0SYLW_VWjRrtJfbLUgMYUmbYG8nKw538QvXFyZw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h096scoLT2FpXQfbHxn6F14vafYPAna6-P7Bp7M9BeA&oe=6A42980B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nHw5Sv1dqkQ7kNvwFrHRzT&_nc_oc=Adob6v-u6SU_YyFxq78Tzk4dwO56koHnVA2u2mMTOroDmK31V4qAQI2CIVjCOqycM6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oMzJ9XjsOdEpOu8gFFDWaUDH1sl1vRdoojJOKw-df8g&oe=6A429842"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XZV01xXMVIQ7kNvwHSxUaN&_nc_oc=Adrio4jDYAUeO8jrq-uq-9xTDfvwAcUnDPD5cc9D7NHW8f3YpuqxlEeMTaHUL26JL7Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5Br7XUsulgeaKrr7c98tJ1GJ9yJzwVCI_-AnXTG0vyw&oe=6A4277E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaGfHn7D09kQ7kNvwEjTArn&_nc_oc=AdrhabViqW57FHkF38qiw06gVdPvjA6269YL5XOyrXUrKqWphU2VDeLDKzJaK3wtREs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AdmgQbyCAYwE47XAIdXq7h3qk0-UQQNlnbpRm9tPcOw&oe=6A427F77"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
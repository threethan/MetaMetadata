-atl3-2.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRzR7k3_ZeIQ7kNvwEx4gH7&_nc_oc=AdrEnhNWXxsrzolInnWspncTvc9vtlIjlzNARXYboqtssYNQyGniw2Z_f_wkipQQv_4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KYYM5wTEBKTc9QVS7hwcPoFDndrFmh4Q7_EjnpRwXaQ&oe=6A302416"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9LfKJ5MMakQ7kNvwGR8aGq&_nc_oc=AdpVCtWTyGpeiHalhLHlwMX4lpfoKc492MpJ-Vsm4HMPCeRS0gp4UblFhErk5g4jYZs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tHPMPtL6At80FvBYqxyBmhn90D8iEfGQhwZ1acKUofA&oe=6A30230B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpxBYynDrpwQ7kNvwE8wTRg&_nc_oc=AdpriHX-sM-ZiYNFoZa1CJ6cKs_C69NHZIp8PqIca4O4-hevlMYuXgBoCYer5FAiUbw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wKn48rSlyN4ovZLBec18tDC4jqD0B_nOk5hxv9yTLaw&oe=6A302342"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSoEQPC2KbwQ7kNvwF_siBD&_nc_oc=AdokOp5DTM9s0xvDrjK1Hk_wjxPTzsinhJ9QXh6cW6Jj6n-QNFHswc9No1qHpt03Dy0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wpdMrQZrjiyWyAd3w8ZAP8rmfJvhDYW84Y5BiEnglAw&oe=6A3002E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIHhNqtjVH8Q7kNvwFCzu8S&_nc_oc=AdpykOksp1jt_BuiYJgjcgyOPKeuISH8xR-nVKYNJtvbAkjf1M3t815gkHsxzzIOd6k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CRr9wxbAStx6oHyQUMmjZ0ksufOJPLu0p0XF86oS8Fw&oe=6A300A77"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
t-iad6-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4m4g_0imi0Q7kNvwEBBA0i&_nc_oc=Adp8yiKbMnxMhzquQrn84NpM0MkcXFF8tFsHKd8dbisJvyZSuaHPlbT1muO17lDdo0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxyTn_jBl46VSs-pmhdEk0ezlaUEU4LKmLmXQYNFgyNw&oe=6A708556"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_WkOXCi-KsQ7kNvwHERMEi&_nc_oc=AdrFhnWjMoNNx8em4yY4hUt_uUilyvPfhec0o3Y3wqywpxCFuRScBCFUSFq2JfA18gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuyoUSxNxN1Qika4bkGFzPTJtnaprdYrlIXo6elDhZuA&oe=6A70844B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGf84BAITZUQ7kNvwGdJD6S&_nc_oc=AdqBywtSgUZibxovUEX5NBVW-iYL5BHrZcvk3nboUlaEyqrxAL9KdEA0HaLGUHQUgiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFswrowe3xWwzffsjnNRw_4PSYTKnFeNgKOs48ue0oG2A&oe=6A708482"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9rn8X5LC9sQ7kNvwE8Q__p&_nc_oc=AdrIpg926lugbSu9sAndUFqJ0SdnjpKhntyrwXI8WO8Ts17W9YGd8NfO32lTxKPPG6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfcGTSR5jSLhG37nCYDYuc4MXEusx8Y3T93Qp0LBTNIQ&oe=6A709C62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw0tHwuXjMkQ7kNvwEsSgsq&_nc_oc=AdoOu9PWhCX3Er_aMR3ucMJK-8macL76mK7-BqnjyOQpwRX4ZtY3SeWGMbNFeGPgAEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErzg4o5TVs7X16LJElXgUWXzgD4Hsh2kE_jzEdLwuv0g&oe=6A70A3F7"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
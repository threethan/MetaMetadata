ps://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syOiOOOB_qAQ7kNvwESNDKs&_nc_oc=AdpTQy0WVTlL1Xguy26vVzr20yh8GN9aB57z40WfZbCPKGbNf-Uufmy66bb8mWP68xg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI9bHgX_hMQgNd2BXJE2eKxBDvH2_e40GrI60wUXrq8A&oe=6A8D8656"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuXrcxfKROYQ7kNvwEW4lEt&_nc_oc=AdqNLX-3IsDI1R5qlhmM9D15X-7vb2BqNiv2_7PwuuHDvtSTkMmpWaTnsyK8NBuMnMI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5Mk--Uw43UQLWlBXZ-HF5wRx3Qc4yxYe1cnLvSO1ONQ&oe=6A8D854B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Elo3lMIu1UQ7kNvwFpNi21&_nc_oc=AdpKTuHft1wBwEWgIp67wU6YA0lQ3ZmEMfFCHKA2RSUEUmaDtlzONHdDGCAwTzKeysk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgewvsF5F_A3rEJbvyxRIU-RVwZ6xPEo2astRUE9NqlQ&oe=6A8D8582"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoaJMSAOpKIQ7kNvwH_YW12&_nc_oc=Adoc3br6qGVmvaRDiIp5qMbj_KCrU6FLT7iIahjWNygjnsQbhM9enyopPC8kiznedp4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeo0YgcZMVJhKW7Ugw3GAmxlpN9ODIN8Xqk83T4ut6Mg&oe=6A8D9D62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrpMGNV1njgQ7kNvwFJHoEd&_nc_oc=AdpurmzMwxTKnfdDcns781oMaxAEVvwchyNSAGHBFjLnADgYhiGS3AhrCl4CqZh0fgc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWBTOFZTid0bytH-TT819s0SzJFsIS5zGtXu9sTv8tpw&oe=6A8D6CB7"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED",
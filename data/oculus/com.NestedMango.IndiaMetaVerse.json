-ord5-3.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1Qt6gtSNSQQ7kNvwEWo3ko&_nc_oc=AdphxbBEhCKxmRerxlgYzet879DYyfyLh-GUXwv7gVs-e9A7TJRKo9F5T9KhmNtosb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf15SMzYMETDF-XTx7AigGBdJS-khU8OlxngfiwN_49g&oe=6A4A8216"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CitNwIclJqsQ7kNvwFkATvw&_nc_oc=AdqAKDIPODHAU8IJsOnGY3mkybjJrx6eAZsuiakccxIoPz8TWEFhNYzb3VS37selqq0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDPNtLO1wGIqyrjjcA_5TxQDOAGwq49fTxG3e7N8x93A&oe=6A4A810B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dovK1j2fm_IQ7kNvwFCkvOH&_nc_oc=Adp_Lk4VxjCoCuqKWWlfT8SWCVRwU_nxkztun6BfN0ByV7K-c0dUExJzH24YTvtND-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfh_Znij5XDHXxCUSbIWIAtzMt6znt42-DL19oFVmSIA&oe=6A4A8142"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmGvuGJ98NgQ7kNvwHQDncB&_nc_oc=Adrd9VvDk_W3jH4YAtW7iFLUA2N9a7cJenFuKoS32IG-Io1iGx-_JPmrI20baWwo9K8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzqXIOUfSrq7vpc0vyinZeM7UbmORivk8R9iInJ0u4gg&oe=6A4A60E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cdq3jcQEdsQ7kNvwErumwr&_nc_oc=AdqCkTtOHBxeWXtBbxAOxg_blbZOKfE0L25zhm7jhIf9wERIk_tfDsfGOvg96_00EC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh-DJl0scSWWwO9a1Agnv_BlM9WZ3NipxnfvMvJAOSzQ&oe=6A4A6877"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
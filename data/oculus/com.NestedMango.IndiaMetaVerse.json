-sjc6-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkkDUhz9yDMQ7kNvwHobEXx&_nc_oc=AdrFgMdjJaVWHNoHbpMM2bmX9SjX6dFXWFjwJEcNVAQ_W11rNETIj3f1y7Y4EQDmVCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ds38W-ZgMoadL8Yg3CJ14Ad2bM3OrOj2c9g5RHZ7Jpg&oe=6A3AB016"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJhqpv_wugwQ7kNvwEpTW7Q&_nc_oc=AdpY79mQTEXdb_Lc368-qECbeEQlEkQdvcM_3cqpxnUzmSk-DxI02FaogmFBWm4WPFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DWF3OBFLQX0mx0BGISEIl77mF9fq4wV5YfiC5fy1eCQ&oe=6A3AAF0B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DweWPAzINcQ7kNvwHWg5i6&_nc_oc=AdpAg_NO07h2BPcl_FMmE2pvlUNeSxK5nwtTZQHOvom9rH18Gx4v_gr0dnsIfPdevCc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WhLiy94Hjo91S5HFCth29ncS_ZA7zEvMs7RKuEyGk9Q&oe=6A3AAF42"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOJFHtMFS7wQ7kNvwFY5I4o&_nc_oc=AdrFMQCK_vTve9oGaQe7JU99V-ZzNZ7YZakKPo_ZuXMAQTvdPcEDF2qT1IntCZqA5T8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dew3MZisotlNN4lvS4HFG9eMUyP_e7CRS7IL6G4b3pg&oe=6A3A8EE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiNmAkecfqEQ7kNvwH___Tk&_nc_oc=AdqiKEb7W_xX2Gi9cgQxJDT8aciH7mZ9J2zbKoY6D0t_NzEO9vrTwEnk75jkcrcmOH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L7Ci9QHFPXM-XNrTtHH7t1T9SjKeqWw0Qll4U90Oh_g&oe=6A3A9677"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
-atl3-1.oculuscdn.com/v/t64.5771-25/491822808_1821311445084583_485949667003291636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BchrT7Roz_UQ7kNvwFykT5Q&_nc_oc=AdpgN6rAtQMN5TAHsrsJ_qA8vJQOG9uhE1JOI1HmoAB0TU1S5hibyWDOtpz_6SFyKTo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92Gx-1_CG1aCz2RLynxom4xro4J9lY1SP2voeHH3mzTA&oe=6A414796"}, {"file_name": "2.png", "id": "1728502371436173", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822505_1728502374769506_3504368675917395813_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7pEzi2rt_4Q7kNvwHcukyn&_nc_oc=Adr5SJbrF7aMmk0oGbVEr1zntEg0TKBF6MvJ-x3O_OuOWDXTabRlNm3aC5h5Cf65PLI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QAoRYkzSX-nMAzp2ClViaQHBWgk_jPTazLy6O9mq0Og&oe=6A41468B"}, {"file_name": "1.png", "id": "1373020890697389", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392034_1373020894030722_7996901804171914087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nHw5Sv1dqkQ7kNvwEvW8qj&_nc_oc=AdrBmc99wvgs-Si8zP5k0foeBS_8wziOiraFopOEUdzJCiTJyyQzp6iLWo6QnHOI4Ok&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-17b7bBUItc9tLBSNobUM4p9JC9qrJLMpHt4RFJASEnA&oe=6A4146C2"}, {"file_name": "6.png", "id": "1369529621044898", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819375_1369529624378231_5935905682631166629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxcq3LR0LSEQ7kNvwHo_5dq&_nc_oc=AdoZ6LNpStyci7obUcK0nhJgyElCH8PX25F4d3ackrovPTnvhpC7hhxHi-XZ3351NIE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iSgdRynBfNntssNqcY074VYuQ4J4688FDBtC0hvvQaw&oe=6A412662"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1822581361926230", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308005_1822581365259563_6406833574819652106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaGfHn7D09kQ7kNvwGVR9ej&_nc_oc=AdqLCF6teMm6cgNW1gJ3vb1DKJM7vKMEeYu-xEetUt18g5VysdhbRPIgDPled1M8V0Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lwhpwF0-NVskkby7mizqsv229ZB55lvNWKgD9v_u_HQ&oe=6A412DF7"}, "display_name": "India Metaverse", "keywords": ["IndiaMetaverse", "VirtualIndia", "IndiaGateVR", "VirtualTour", "Travel"], "long_description": "India Metaverse is your gateway to the rich cultural heritage and majestic landmarks of India. Immerse yourself in a digital world that brings to life the awe-inspiring beauty of India's most famous tourist spots. Begin your journey at a unique combination of an Airport and Railway station before embarking on a virtual tour to India Gate, the Lotus Temple, Ram Mandir in Ayodhya, and the Qutub Minar in Delhi.\n\nOur immersive VR experiences will transport you to these iconic locations, offering a deeper understanding of India's vibrant history, architecture, and spiritual significance. Future updates will include even more destinations and interactive experiences, allowing you to explore India like never before.\n\nStep into the world of India Metaverse, where the spirit of Indian culture and history awaits you. Explore, learn, and engage with the diverse beauty of India through our immersive VR platform.", "short_description": "Explore iconic Indian landmarks and cultural heritage in a stunning Metaverse experience. Visit India Gate, Lotus Temple, Ram Mandir Ayodhaya , Shiva Temple  and Qutub Minar in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nestedmango.com/privacy-policy/india-metaverse", "developer_terms_of_service_url": null, "publisher_name": "Nested Mango", "support_website_url": null, "website_url": "https://www.nestedmango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cwpoZ90gLAQ7kNvwHrHVgg&_nc_oc=AdpIN551Q7bjr1edejAlBZmg0Ur_KYMLnFHqKQdaC4nasZ2PvMwWw3MBIU4wZVIK1KU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs87OWijAWHOF_ksjJdoD8XAk_iMMce_1n_i1DwW6glA&oe=6A5265BA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV37P8uWpLsQ7kNvwHvEsUE&_nc_oc=Adp0pHy9wWy-VkVRlm0BtgQWikX5p7Fm9PE_x53O8bMq6ALhPgcCMX31T6kmT3Y4yyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2945V1VSREAJmGN6tL3ApWZlNsrAKwFdoZb3olYSDAw&oe=6A5267C0"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3bjJjP0sYcQ7kNvwE6q8eW&_nc_oc=AdrzaFZIP-T2r_DF-JQbKw8U3MQdDIHrs8_v5snCDvYgXkkQd8m-JZ8muolrZYXThN4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRKPYiDfqlXHZErIxdQg_WgUqXY61mn3GZ40jriNdQBQ&oe=6A524643"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY8xwyCb9vMQ7kNvwEeifmc&_nc_oc=Ado1swcVM78dmM4R2T4lxhw-CNQ5nyLpA-XT-pkgCoZvje2ACxZPmrS2ilks7PXKvXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjj7pvOeJPZo16803ENUayd0R_PHvnUlxBlH1h0MWwAg&oe=6A525D63"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQYwq6Vrm8cQ7kNvwEuxQN9&_nc_oc=AdraHg-zCZuS19egmzHR2UTC8mW_Le8pMSUCdomxqPm3gVytQCMMZDqbGJTuIFjahsc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNXf0Xi2AjBr6cmParsYI73xk6CbiZ0I29behlwqdQpQ&oe=6A5244E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
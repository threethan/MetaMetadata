1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgJQqD2Wb_wQ7kNvwEbTTdY&_nc_oc=AdocQFunifbEWPj_l6_H4hHE5rp0eciMu5jGuJlVDVUIHhMTpuhAAWgWaT4zlyJiRWU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWHj6NaKHteTZNhHdFEMsat-_3UD9P16fKiTSVvkP6Vw&oe=6A86E97A"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVpElzShZzsQ7kNvwF5Wfdl&_nc_oc=Ado4-XS44rk4vjQcTQAsLKfj2qE8CXhUo_Dch9M9Ngg2E6-J0VpKOg60LpuGUJTG8sE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJdIjhcehCuk_gi5xT0gmI1h5nYOyGzMJFtdUO7UxANw&oe=6A86EB80"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZbFtX0WDjAQ7kNvwEum7oz&_nc_oc=Adr0mjPyQhczw2gbgJINipnz-i0AV_9EgDQQR_WcYcJtB86j5oZSEpELJSbO4exciu8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH2cpP0vt8LSsY4dMjAC6sKFO0_9OS5dWUpToCGbi7kw&oe=6A870243"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Jn4r4qIVWEQ7kNvwFtu7D_&_nc_oc=Adog-RcYsha6vw9HeRsH2KCeMI4JTBe3Z01yoVMmTY5CuzAOfArB81ZcMN0u_TnuDCk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSv5M_dzhTiwGXgJGi5FCuhMfXpv_qD1-MQGbQrrfCmQ&oe=6A86E123"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktlQuUh0MDQQ7kNvwFwZ6RY&_nc_oc=Ado86BVATFnlr7f1QBZrUXCeR__Vit46tmoGVc6MDr0cHiy7cSzkW-vsncK_2a-Jups&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAObFibyYSeK52je0DYZ408NQrOAmlQSgQIKEg7F67kA&oe=6A8700E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
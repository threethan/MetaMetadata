1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jsgdcy_iqf0Q7kNvwF2cUbZ&_nc_oc=AdoeJKUgbCDJVbc6nWNsN8p5qkeqkhSwpMpt8b7fiSdDYeU3gSV0d0_AIgiZP5jwVCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxE4yielZ8m0OnjNk4m06V1LWokJKyzKeYYwYWRv7rsw&oe=69CD05FA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CJydl_EaAwQ7kNvwGppOn2&_nc_oc=Adp14pi3tVAGo7Dw1uj9iLLIZNVUcvRc6ye9rOrOGHsIvQAP5dLECMjk1UU4hlmp0uU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyybpSF6dXY2aOf_vjFWQAAvj4miu6eeDANDlJZfQ2oQg&oe=69CD0800"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wGDg6RtS7gQ7kNvwEcUYAv&_nc_oc=AdrQ47QBDTZyjmMB_HRsnMK6yAEv7dD8SgFfLZZUiy4Y4w6hFkW0bM_JgrCGmM7kK0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsnoEjyaf8T6_C1eaYKIIplapl_rtePI9Po2NrkL7-1Q&oe=69CD1EC3"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOqxsJcdCF4Q7kNvwFcGlfR&_nc_oc=AdqvcQ7487YMHpURou-dRVPic0LcSUdf5xfAzVt0TH4R1x3SZ7o0X_vALkQUdv292oI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrZQP92NBEuuXRwDIULB1qPHBKtXV_5zStI4e6iF2wwg&oe=69CCFDA3"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CYFCn9fP-oQ7kNvwHrY7Ss&_nc_oc=AdqFqMjak5my1vvICR1W_woYgAanwF0JlqS_3IQaDZ3Mt0g3jgWdFxaVfBa9oGzf3ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrNP4xya3bk0GBl9lGYYr1B0rkYTrM7vHzEOXVBZQDVg&oe=69CD1D68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXajcjV3djgQ7kNvwFtRnVP&_nc_oc=AdrFkXLZ9Mt7Qo-d6J5o_BQ1pnJWXEVFJ2XNFgSHT3qc590BuF2_7asV-A93bgHnKBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQmjGb7-hDe8jlZyp0PIkhBME9apm3etIU19xTocq-mw&oe=6AEA023A"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pYNFCzElooQ7kNvwFLlPhK&_nc_oc=Adqj-MhWOWeRHBXjbqW4KfmtdwhVjq1lN8wd4pFlakwYUHjMfMuhUOfWbJ96ajgM444&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi-99KtL_D40pZ_rFbK6n29YUaVMqPaLhU_K1cvfrZRg&oe=6AEA0440"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS1sz1FdUkEQ7kNvwGwN_rM&_nc_oc=AdpzqQOg7akEuMiez5aR5ixugA5slk50ipdwz5UNMpPxMukwJuBWt2foYnZcDSiM6l0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtjnEgBzYf199JIQYokTuBfh8bWQ0YkG-qcrmDtpJkTQ&oe=6AE9E2C3"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niU0Hd_JIkYQ7kNvwFW-Gfv&_nc_oc=Adq1DnD-SE4uPy77_X9PD7Y2iCuK5msmO4nLJmZsTqOeA0LdE6y4sHuvBKs1WyxNPsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpmXoMpjXosMwnTyG6AmKVGIC45JBM1lQyff3cZ258Yw&oe=6AE9F9E3"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIiJGMhI6l0Q7kNvwGchv76&_nc_oc=AdrrNIEFz8_zImlYgUQcsfgOz4MnzQcyqx4XaRLXCIdhRa6WDoNr5R7LoyfC_Oi7ciI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpDzj9Jdls_EswQ8uA3I355Xd8zmWXewsfDab-uwqTQA&oe=6AE9E168"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
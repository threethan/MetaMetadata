1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgJQqD2Wb_wQ7kNvwGHVhzI&_nc_oc=AdqRlcNxpZFagt6ZMwRg-3vJSMRDsxxo-JRkCHll42Cf7tny1dYWpefGCRHHhhjR3HE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7ZUac0ugyMym3ZGian-7V_A368QpWq0b9x9Gwlu0hvw&oe=6A883AFA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVpElzShZzsQ7kNvwGybcvH&_nc_oc=AdoDpPUOWR_PIw4aBLXDAlAntU11ULhx0MF6wnUh2carwhJavSuokXfdsZlXoV8lx24&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERxwgvvgxOhRoPwd_vrJTqj78G2mpN4yXP18MQA2TCpg&oe=6A883D00"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM_kI1s7hXIQ7kNvwFaq61t&_nc_oc=AdrxZCbBLUbaPTBYcjO2dwPk9OxyEUZjKiv2dQqyYC3faufD8_IbTj70M1qI1TwNZ7w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzVAsSvVBVEPM7TzsXoDyE1zMALGmpFdKzV95Ka5AdGw&oe=6A881B83"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Jn4r4qIVWEQ7kNvwHnA4Ub&_nc_oc=AdpSWfOB5n-haNNpzO84Hj4MiPaJsVbBaJWNU_jmQM9EA2-vDFykFWrjU5G-yooGL2g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvlrZgRgB0IZrAtcn10o7emv_2aE4QMlUSIVWSWsp2uw&oe=6A8832A3"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAmFDHZPlx4Q7kNvwEGbh2g&_nc_oc=AdpxiZ5Oe3RaTCfLtFEOgh1U1FfawreoukN5ECLi-1Du3rDUvCkmt1SdNgqAb4WvFBA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfglcwZWmRyhgQpjQlRPOqAK-FuwDnxVWY2EaISxvZWQ&oe=6A885268"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
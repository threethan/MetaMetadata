1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXGTf5iWVYwQ7kNvwHrL4Q5&_nc_oc=Adq7jYsYnh1UhuTbNSxEIVP5odk14_rXzRSR_n3TvbXmch-cp4CIvdpTCseOTDtUGbk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vbjon42P3v64MRzHzkxQECTdZ2YLSvWQ6FrTPXyTdow&oe=6A03137A"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkFNdUnOqHgQ7kNvwEKKJnh&_nc_oc=AdoYIUV-2D1fJUDXC9gvtqMVQ1jpaihUZzjw6jXypdwLNdAR3LBSYoezE0rSob-b7dY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6czgBbNU6umAx-1e7aeJ65lby16iCuHafhtSWQvLpl7g&oe=6A031580"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK3KV0oQeSkQ7kNvwE0uVa3&_nc_oc=AdocTjQx_bD2xye_wmjh0Q1acrOotY6QelUtvIlZYqMaK4D2ScMUSxDhPKJ26FXxceM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KjY7zmAjDvp37JDCLdx7SxjNZ1zWOfDGg7ituZD6NiQ&oe=6A032C43"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zViAHdxIJNgQ7kNvwEzZNPB&_nc_oc=Adpt43w4z5ubkT2TsRZC87eLPwhUQFHaJFNda05778MF0ODn9RhQAuYTlYN9fwyBAvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cf6g7WTBF0pMfGzNQ3Vbzi_etFYtV37quZ3TnyNm3-Q&oe=6A034363"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHvqXnDAYpwQ7kNvwHerGTt&_nc_oc=Adrxz291jfTzgKNQEfBBH9qixX0V5mK4HDRS33x8lIZXDP12qAm4PI9CVPg41UUroQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ct3uK5AfH_fY42rHeBEru3dz6kG5UNJGx4tWSyW65Ng&oe=6A032AE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
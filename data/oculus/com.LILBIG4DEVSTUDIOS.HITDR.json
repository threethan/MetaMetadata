1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSyPKQ3Zr4oQ7kNvwGdHFgW&_nc_oc=AdqVKfeoaaOq4iiSdd40kIX_H33C5Qkabth0WHHkL2uvggWnZez4PjKn84AjQODnFSk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDl_jedbI1PVfz4JQsHyM1Z_cCVihdNAR6Z2Q2wEOVww&oe=6ADCD33A"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scCuYkGxK8kQ7kNvwE8IwWh&_nc_oc=AdpQRgxBcgAhQey4k6ADbCAIUWQ3PEwM4glCPXOFqHGVGDuqN_WS3VIii8KCEkuTZes&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRDNgsDQA7zFU4meTn5iQ0h4QatfSUJXlGuwhJoRMQwQ&oe=6ADCD540"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C_GR9DymskQ7kNvwEw9aqa&_nc_oc=AdpVA03hZaeIMOw-sa6QbLm4-IDazeWsruUkLsdTc7_n80Bkn0qEp0_OxaDuNO4tIf8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_qan4EY-Q0dYWVgQ-QVhHi0KlzMMFo6ffhMrMmlhjqw&oe=6ADCB3C3"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-Vz7Yg-rIgQ7kNvwHIKkB1&_nc_oc=AdqK1vu1Ji8apP1KPc2aHS63XfYVI2yxHt9iU8IT6Jav7vlpvVf0Yc0RKYwq3CKYAuI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQfC_Mpn4G8H8ii9wrlDM0Efy21rwSQGkR27gQskEn9A&oe=6ADCCAE3"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLQ-5O54VK8Q7kNvwH4xycj&_nc_oc=AdolQPSp5W00bYhS2OeIFsrm1hWvWMqSry7KpgMaz4PmWpjelgeha9bVHxB3X9iS5G4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQa7JJXebPrL3nenzm0EK_XA5rB_X0f9Z7AI_5hFfjag&oe=6ADCB268"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
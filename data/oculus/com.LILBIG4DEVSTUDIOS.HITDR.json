011223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMko_gvumWIQ7kNvwEEo8Oc&_nc_oc=AdoHbKlc4Q8Hxe3iK1FCBqwCVxOXq58qkai_7mp99fWeKZTNb-r9yWSGuLbVAyQuQoU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-Yw8Z0RmFwVDAPW6kNxMIPc-F34OdgoISaPEgyU-QQQ&oe=6AAEAEBA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOKBceIRGhkQ7kNvwFTEP72&_nc_oc=AdpE68kH_kGVz59PMpb6FDbymL22TWsjUUYuFgpB7V2vdhzjZ-WrZ9bUedl1veJJrOM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMjT-E_K3BrMa56-bFAof3bWV3_qwXkga-jICRrCcUMA&oe=6AAEB0C0"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5sMyNQ0qKgQ7kNvwFGz-GY&_nc_oc=AdoccoQIF9vM1PJolBdxfXZEEsBrPhqKOYBzGUK4Gai1iVD9kniEeu22uj2-Sdu7rdA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8_MdmwSn0SgdKREzgq8INupJmz6FvX0VAjGhb2dag1g&oe=6AAE8F43"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xduxbXPbYEMQ7kNvwEYAVBU&_nc_oc=AdoBQCTtkfWr21E5NdFDtK-oJGbRiWLc8JPmlF_JHvGUjuAaCjXUMii4yYhJpi8IxQo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUq0tjGLIwNncXy9MsWE4gc11LXIaqtAtB77jh_-Mm4g&oe=6AAEA663"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0SgbLoU794Q7kNvwHrETNu&_nc_oc=AdqQ7LRAK3OID75tVJ-TdZAQXfwkYa7zglFLLlNuHoh0wv8Pd52sDntdlDBw-g5ORDE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyYqOvbucb1mRLN0ZcNhuuUvoGpe2tPfNkTTCyXgh95w&oe=6AAE8DE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26429078533365219"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1184886233808897"}]}, "baseline_offer": {"id": "1184886233808897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770235200, "status": "PUBLISHED", "id": "1184886233808897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26562827219990349", "version": "0.26"}, "id": "4190899867827940", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26429078506698555", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26562827219990349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4190899867827940"}]}, "change_log": null, "created_date": 1771273759, "id": "26562827219990349", "version": "0.26", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__
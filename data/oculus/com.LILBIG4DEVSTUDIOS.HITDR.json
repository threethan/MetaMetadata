1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC4wdkiNBCYQ7kNvwGUrGoy&_nc_oc=AdorukbSXGXkw_KTxZLR6rGL2Ygq2CslxnAL1fSlLFcuxvSWPj_u_aNXbu5PpNIQPMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxO3aT0rf4sCa4d4F1EXxRCcF3SWqVhg42-zNA8ihOWw&oe=6AC669BA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGfJCIBbQN8Q7kNvwGsVZd-&_nc_oc=AdpzsZV4GYM5pv24ZM6qIzzzUMCYbjeiXpdB85ar104SYQ0Nrlt6Ko4sr-R_aEaH0iY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpUptiFx5yq15HeK9_zCItZsVkYny2NK_uwaM0Vbb28Q&oe=6AC66BC0"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSI3yBm4-XgQ7kNvwGFJyf1&_nc_oc=Adpxk3pxf8XqZhyru9oRM3ikuiLNEvchgAyHL9IGR3ll4a0_b-2rVXn8rSDqOUfzHzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhtdh5ai3AZZglcJguqR8TzgCGAQy6Xk6NM48y6cF5OA&oe=6AC64A43"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TWe3vxWKO8Q7kNvwFwNy-T&_nc_oc=AdoUiqPXlJkHe_GKvHdHQTFGsS-Typv2_1GZ9l965Scumf7rtxDTNtjHP9xcs-kYUMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgV8Zz6GCpVVQeaD3LyR7dnCZTOYhUf5B5ebLT0Mvb7Q&oe=6AC66163"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ta0oRq7eQPkQ7kNvwG66qK6&_nc_oc=AdplTeatahwAX5ktGUjC5if5tb8RlB3S12CSrhrQuIG9FTICGqurPer7EEXAmczZu_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEp9V6CvUbUGb9wtS371K3b2HFbgEoAmmjP1t7qpzAlg&oe=6AC648E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
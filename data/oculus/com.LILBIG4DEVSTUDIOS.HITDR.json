1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cwpoZ90gLAQ7kNvwEvKXC3&_nc_oc=AdrL705m9kFbKk1895DG1leJBs6tVfpv9aCAhw6ebZMumfsML6eM97HkTieMaCV_mjo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1_sjkx73O-kq9zEkQP-beaG1jmwX4pY2h4Z9Nfc7h_g&oe=6A537EFA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV37P8uWpLsQ7kNvwFTyfrC&_nc_oc=AdpqiYqwkpeST_4bKb0KskkP6hPwHuOQ_EiVfPY2fqh_r4mT-nR6jFzhNoERXYOVWC0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF65STbzTKj7yiUJb3g8krvbjVPatVKmbsSQBuoHaKHA&oe=6A538100"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3bjJjP0sYcQ7kNvwFG6qt7&_nc_oc=AdptEp0wyvKbHLMeRSBjQpgYmOpqK7M-AwNInKO-0Ck6xxnlYE2JfbEYJC1AKKjBNFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaohMeTOeAKrLmpaG5dM3b_0mFgHy8x_pENk9YC5OSqg&oe=6A5397C3"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY8xwyCb9vMQ7kNvwFusCBR&_nc_oc=AdrBHpGJxNrCYlCi_ys3KuU-30nMxW9moaBRZzbO3qhxJrtTycfpUVF_CWPgJaOPp2k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhXUsRx1tlvaKoIgUYiiYSDaHGB2daNBSM86-BEj8_fQ&oe=6A53AEE3"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQYwq6Vrm8cQ7kNvwFX-OR5&_nc_oc=AdqDKAkFWpj9IpUobtl4jZT8MdeYTzoXgznlmpwPUaaWDe01a-JAdD3a4MbWOUol9KI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3UZhBipbLTrambQdYbML-7GcGQxWhmmf7T8rvZB3lFw&oe=6A539668"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
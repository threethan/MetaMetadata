631_1381011223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmgJuCjd2FcQ7kNvwELaZMa&_nc_oc=AdozsVbuzLDb014lQME0vKiYfuVIoNgXZPfwzEkqzs1oB7yJIj8_jaHn9lPsTe256b8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSJk1G0WZ_22z-mANGaCBGBJLomP03rc72_zXZZmvyqg&oe=6A8D80FA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfcghE4QS8sQ7kNvwFJ83vI&_nc_oc=AdoW0ivAbH7BhbCNet6y1HAF7LqIhk_7H02ZYFA2qixDy_a-5Ev_fgRJUu1PTroPKYg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOFbtsVQFEXqhfEEHeLGGIrWd2V0T4Jvjyjik3RnQ9Vg&oe=6A8D8300"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vz2a4Kf9l0Q7kNvwEPk4Dz&_nc_oc=AdrZje1KZLfMnbh_iYIQGIF1yaC7O8-wyCAspzq1nUGbta7fdMv-A8zVrKhDI3InUGc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQblMRgeziOMy-utmAoQ-cZ0BcA2AZFTETG94a8o8pgw&oe=6A8D99C3"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKzWw-tKxIwQ7kNvwGLoukx&_nc_oc=AdqfQxuUHQI09j-WVWxzG-Sa6Mt2ttN_xJNDPyB2HTol6Kne76H81xQ2hgQhaWtSHkM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPXSuH8PbDDweZA9gfgPcdTzV4uhm3YX0205_eeSWa2g&oe=6A8D78A3"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVcU1a7zyWkQ7kNvwHgdg9N&_nc_oc=AdqQE73hHR0BQAu1P98xMnAC_3Tqb7k03Vm02Tf0JDd73M6gB2Eo_JjH8uKoIazaOyw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzi4N0S0C5CH_IaulFGLGQR7GXYwRFKAk3MUVsbrsGLA&oe=6A8D9868"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-
1223812505872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__vythjTrzIQ7kNvwE5UjAg&_nc_oc=Adq9YhZBWpqNPgDwsOWHUyQqez0dl0X5xLLTlHAmEwBjrGFZFxm8J7uTBrcMhTct46o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01kZF7T4VZY1GOaQwDk76buF3PvUNJNhxt9nkm1LX6JQ&oe=69DCD7FA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCklyF--l3wQ7kNvwEKJLug&_nc_oc=AdoeVidfMcDDJyXHFBhKm3bFq0eNPwjGcFSapNOQ6v4y1FIcKbDDzZN4gDrbGK9kh_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wRSESRf2SZjcdxYeONsjSxPpxJrZ7FPGmrtjr-CVHoA&oe=69DCDA00"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OOurXnruJkQ7kNvwGQ0DpH&_nc_oc=Adr11kjnWQFHyu_lPwmX_9qy8Alvna290OexEAsoxnwh3LeEN9RTI3cZVkaBictMqdw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2URePN7JQiBQBoao2pUVb_r2KU7ETduH8NXgjP-Uihqw&oe=69DCF0C3"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6565E5Kg4TIQ7kNvwFJCxNW&_nc_oc=AdrjTg4_QNUQLmaHIRQcrgFPh2R8Oj38tkWu1cP62R30WMU2pzXkVZL8yQqVb99cC0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1L23RDY1DzySTztIwFgxEgbdJ2XfVEUyogROeoVuQ1RQ&oe=69DCCFA3"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTEuGS2Ynd8Q7kNvwG5t48x&_nc_oc=Adp22r6RoT9fAWMiF6FoGZixm7g_51a4OXnzj7gVQnWEC787MhFVzuUtydc72-eYFZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tTsq6Sd0vbG-dVgoInHe_KnqQOuYJZyBm0ugiIDnkwQ&oe=69DCEF68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-re
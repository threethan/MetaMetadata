qgoZ2M2ZIQ7kNvwGKvT3Q&_nc_oc=Adpp2JRMbk7feTY8L3C7nmOh3aZW0wfj3PZNMzHdgA7NnjPaQMbxt8DMMUF3oEegSa0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KqHZ0my3uLbFzKHbfmVAQ6AHLoHRLYv8e_Z_BU1rRnQ&oe=69F1EFFA"}, {"file_name": "Shot2_imresizer.png", "id": "4223600431231604", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821193_4223600434564937_9003016896581031870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAUzisaWMXwQ7kNvwH1OY2A&_nc_oc=AdrZqaA0-7IbvxdIl7D-ijlbyE_UaJUHdYJe8vUL5zNXXQCo3kDQTjPtQSqjV9o408I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZcBQw8xQPD2AV8-RahbYEwKohNnuL367PSu4EaPmEzA&oe=69F1F200"}, {"file_name": "Shot3_imresizer.png", "id": "1576536446987667", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307326_1576536450321000_7266514675300868627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EJjSZ1Y2TwQ7kNvwFWzcbC&_nc_oc=AdqST7ZlsIzmxZQszoDqWR1dE-Qle54PUW6hoYJsR1gqifIE9gQp9ERWwvzgMqOP0dM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bdm_hUhGKXQh1OK0FMvK8OwKk2nIQnPuSyxLvsrpVAA&oe=69F208C3"}, {"file_name": "Shot4_imresizer.png", "id": "1244290143767043", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307413_1244290147100376_410448805091490030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5HOIfAafoAQ7kNvwGKFSSR&_nc_oc=Adq6dC4y4UBnMOFCih15lH8TkAsNF0KePYkRqdeQO9b1-oJsPzyHlIVCtS6KnLvc9to&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3Y7-ccqWGvSaszA6GCGdKlLknjY02UT52SXJAei7MtRw&oe=69F1E7A3"}, {"file_name": "Shot5_imresizer.png", "id": "1635527367444782", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304938_1635527374111448_3619580122809005742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfxYNaB7vrIQ7kNvwFD4A22&_nc_oc=AdpPKKq6kYwZalcngduSmR1VPMMjvvTh9ur3hrO1AJtTAoJVXqtw5C1wfkYJBtWMDCs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1irdGs1tOkacePqUrvt9zTig_AqIvJZJR8W8aerauZig&oe=69F20768"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark Redux", "keywords": [], "long_description": "Hiding In The Dark Redux is a horror survival experience where fear controls every step you take. Set in a dark, abandoned town, the game challenges you to survive while being hunted by two unique and relentless monsters. The town may look empty, but danger is always nearby, watching and waiting for a mistake.\n\nThe first threat is Monster Pixel, a red, glitch-like creature that feels unnatural and unpredictable. Its pixelated appearance makes it hard to track, and it can appear suddenly when you least expect it. The second monster, Meatman, is a terrifying hunter that roams the town endlessly, driven only by the urge to catch you. Once it senses you, hiding becomes your only chance.\n\nThere are no weapons\u2014only darkness, cover, and your instincts. You must move carefully, listen closely, and learn the town\u2019s layout to survive. Every sound matters, every shadow could be dangerous, and one wrong move can end everything. Hiding In The Dark Redux focuses on tension, atmosphere, and constant pressure, delivering a horror experience where survival is never guaranteed.", "short_description": "Hiding In The Dark Redux is a tense horror survival game set in a quiet town taken over by fear. You must hide, explore, and survive while being hunted by two terrifying monsters. Monster Pixel is a red, distorted pixel creature that stalks the streets, while Meatman is a brutal presence that never stops searching for you. Use stealth and quick thinking to stay alive in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hiding-in-the-dark-redux/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfor
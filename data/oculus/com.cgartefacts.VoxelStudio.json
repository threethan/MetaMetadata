949720036_1149452839314268047_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKNe6YPcsIcQ7kNvwElGih5&_nc_oc=AdrK_yVdgHJjmbwQXqyODiawMNW9Z8RLmbrumdhhs0FaDdxuHBYrkXq_qTzDUFSOkkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUV4PfKBq4c93yX3pQ4V5mw6k9xrKpU7UaF6jeaLzg9A&oe=6B0F077F"}, {"file_name": "ss05.png", "id": "676071165086803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391890_676071168420136_8112905814281474985_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZOOCpbv50wQ7kNvwHD3yAC&_nc_oc=AdrMee0hjSL4DZmsl7Ck8CmIbNktE_ig9w4CWcB6Dpg4aZZMRHwgV6FggotmfG7wnME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_2S96rFvvdacApcc2Ff_z75DaAiEylrWRxFWGwqluHQ&oe=6B0EF79B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "8651890428248575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_8651890434915241_8046765910349529627_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y26SZ2Mk70wQ7kNvwHxieGK&_nc_oc=Adrz21QWQeZPLjP__rGf1BcS4eom4XsPrqcyxQOwyO9_iBmuIu6HmfeiQKlJKRlO774&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVP0_OTU7no1_AKv9w1RJQ3znW8cv3JRR81eg3IpaRh5A&oe=6B0F0645"}, "display_name": "Voxel Studio: 3D Blocks Made Easy", "keywords": ["Voxel", "art", "drawing", "blocks", "sandbox"], "long_description": "# Create. Remix. Share.\nStep into Voxel Studio \ud83c\udfa8, the super easy way to draw in 3D using simple yet powerful VR tools! Create stunning voxel art with intuitive tools, share your masterpieces with the world \ud83c\udf0e, and remix creations from other artists!  Whether you're a seasoned pro or just starting out, this is your playground for voxel creativity.\n# Key Features:\n\ud83d\udd8c\ufe0f Easy-to-use VR voxel drawing tools\n\n\u2728 Publish and share your creations\n\n\ud83d\udd04 Remix and reimagine other artists' work\n\n\ud83d\udcbe Export your voxels for use in other projects\n\n\ud83d\ude80 Future updates: More tools, community features, and shared experiences!\n\n# Become a VR Storyteller! \nUsing the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own.\nSuper Easy, Super Intuitive! We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way.", "short_description": "Step into Voxel Studio \ud83c\udfa8, the super easy way to draw in 3D using simple yet powerful VR tools! Create stunning voxel art with intuitive tools, share your masterpieces with the world \ud83c\udf0e, and remix creations from other artists!  Whether you're a seasoned pro or just starting out, this is your playground for voxel creativity.\nBecome a VR Storyteller!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unfoldvr.com/privacy/privacyPolicy_nodata.html", "developer_terms_of_service_url": null, "publisher_name": "CGArtefacts", "support_website_url": null, "website_url": "https://www.unfoldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
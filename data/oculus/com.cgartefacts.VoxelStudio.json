J3w&oe=69DCF33F"}, {"file_name": "ss05.png", "id": "676071165086803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391890_676071168420136_8112905814281474985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy_p3dn_Sd0Q7kNvwHCc1sf&_nc_oc=Ado9mIBB0U1CK4mcqolJ6-xccKf2BE8XyudQqpHdS-uw7CwWvlPjR0NwzTtHPLskR0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uX94VzQcoqB7b_vaoDmf5ikGmbQncE2u8uwQTDGJRcA&oe=69DCE35B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "8651890428248575", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_8651890434915241_8046765910349529627_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7uRINzNxc0Q7kNvwGMDU1-&_nc_oc=AdrHUYVs5t5DEuqBkrIgayYnDBGWDx-dlObVEU_Yvy0jcBYj2Y63XghVbQ3y2_Yu4Tw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M83RaczFgt8atGuCqqo0GAVTfDijJxu-A5U0dkjQxqA&oe=69DCF205"}, "display_name": "Voxel Studio: 3D Blocks Made Easy", "keywords": ["Voxel", "art", "drawing", "blocks", "sandbox"], "long_description": "# Create. Remix. Share.\nStep into Voxel Studio \ud83c\udfa8, the super easy way to draw in 3D using simple yet powerful VR tools! Create stunning voxel art with intuitive tools, share your masterpieces with the world \ud83c\udf0e, and remix creations from other artists!  Whether you're a seasoned pro or just starting out, this is your playground for voxel creativity.\n# Key Features:\n\ud83d\udd8c\ufe0f Easy-to-use VR voxel drawing tools\n\n\u2728 Publish and share your creations\n\n\ud83d\udd04 Remix and reimagine other artists' work\n\n\ud83d\udcbe Export your voxels for use in other projects\n\n\ud83d\ude80 Future updates: More tools, community features, and shared experiences!\n\n# Become a VR Storyteller! \nUsing the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own.\nSuper Easy, Super Intuitive! We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way.", "short_description": "Step into Voxel Studio \ud83c\udfa8, the super easy way to draw in 3D using simple yet powerful VR tools! Create stunning voxel art with intuitive tools, share your masterpieces with the world \ud83c\udf0e, and remix creations from other artists!  Whether you're a seasoned pro or just starting out, this is your playground for voxel creativity.\nBecome a VR Storyteller!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unfoldvr.com/privacy/privacyPolicy_nodata.html", "developer_terms_of_service_url": null, "publisher_name": "CGArtefacts", "support_website_url": null, "website_url": "https://www.unfoldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "10078971048784935"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "765628906423348"}, {"status": "PUBLISHED", "id": "9424898330900635"}
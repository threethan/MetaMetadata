sSj-a_lU6rIRWeSwj2tX8gD-5bln-K1FcPHcVw&oe=6AC3D94F"}, {"file_name": "SCREEN SHOT 3 copy.png", "id": "1314654440596805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1314654443930138_1158793719364750418_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-EiX3JvChYQ7kNvwF-3tIs&_nc_oc=AdoyaySO8vyTP9seHwastvKzNIeeBiSFS1QaKSY75-7ljicEJwZu8WihB-FwFZPSfjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsqhOmnA2oJaU_rt_dRwj0eb-B7_LaAe3-EgU561_92A&oe=6AC3B136"}, {"file_name": "SCREEN SHOT 4 copy.png", "id": "1685229459292032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1685229462625365_6104574748012950511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfYFZ1c1sGoQ7kNvwGFG8gk&_nc_oc=Adq8yjVtRNMwcdtVfMjyn-SbR4rXvvGbZQOUh-_YeRRgjUnLunQnmU71PCcK_S4YNO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOymYELlr18S77hmh0imOYSu4mVjGtKwhgoR007cb6CnQ&oe=6AC3A738"}, {"file_name": "SCREEN SHOT 5 copy.png", "id": "1681954896331221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617729_1681954899664554_4694197709765758669_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcQ4VbqPkB4Q7kNvwGv7Kp5&_nc_oc=Adpi5aSQhhzcCeG513J66s0tSl3ERQd3x0YiS2nxaQCCdKdpHZdNZlbVBSfBuw84FlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeIbIYyjCakhPsGiN5-iG34d3Y5TS-eoVAnKi7dvRC4A&oe=6AC3A855"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Car Racing VR", "keywords": ["racing", "car", "carracing", "game", "moto"], "long_description": "Ultimate Car Racing: The Definitive VR Speed Experience\nStep into the cockpit and feel the G-force. Ultimate Car Racing is a high-performance VR racing simulator built from the ground up for Meta Horizon OS. Whether you're a seasoned sim-racer or a casual driver looking for an adrenaline rush, our realistic physics and immersive environments deliver the most authentic car racing experience in virtual reality.\n\n\ud83c\udfc1 KEY FEATURES\nTotal Cockpit Immersion: Look around your cabin, check your working side-mirrors, and grab the steering wheel with full Touch Controller support.\n\nRealistic Physics Engine: Experience true-to-life tire grip, weight transfer, and aerodynamics. Every drift and every brake feels responsive and high-stakes.\n\nDiverse Track Selection: Race through sun-drenched highways, tight city circuits, and professional raceways.\n\nElite Car Roster: Unlock and customize a collection of high-performance vehicles, from nimble street tuners to screaming hypercars.\n\n\n\n\ud83d\udc53 DESIGNED FOR COMFORT\nWe know that VR comfort is key to a great race. Ultimate Car Racing includes advanced motion-stabilization tech and customizable comfort vignettes to ensure you can stay on the track for hours without the \"sim-sickness.\"\n\nSupported ", "short_description": "The most immersive car racing simulator on the store. Experience realistic driving, high-speed tracks, and total VR immersion. Buckle up for the ultimate racing challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soniinfo.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Soni Info (RAAL Labs)", "support_website_url": null, "website_url": "https://soniinfo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interacti
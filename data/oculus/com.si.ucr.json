hfwbWdW3PjyC4AF4v0Wlo-RrFbrgEM3fwAmJ6w&oe=6AB27D8F"}, {"file_name": "SCREEN SHOT 3 copy.png", "id": "1314654440596805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1314654443930138_1158793719364750418_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrMxM6pFUEoQ7kNvwFspqoD&_nc_oc=Adq09hAOrqBzjpbELBM0pP7uDlLpNWwMDmJpTZwXHJoiCC8aLhUV9fOESYKxwmLxKBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQuLY621RYyjpRIatx2SWm5E6FsZUwsOaXIDCHOHun7A&oe=6AB28DB6"}, {"file_name": "SCREEN SHOT 4 copy.png", "id": "1685229459292032", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618093_1685229462625365_6104574748012950511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwoWTu79tngQ7kNvwGC_XlP&_nc_oc=AdosY60N5wuI5HGCILBFQ-mZ-ljfS8Nf1AZXr5qpXrxpcu2-SLCKfEp85ElFQV18yxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ268jcvXKPBfJcbZ6qs4IfAXySoub-6_4DdW7i4rUm0g&oe=6AB283B8"}, {"file_name": "SCREEN SHOT 5 copy.png", "id": "1681954896331221", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617729_1681954899664554_4694197709765758669_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNLHSwLUS7IQ7kNvwGZbRtP&_nc_oc=AdrFoBj2_UxLD4mEjgNeoPTgrySgYA7G668kZbodhJU5KGuAC5SO4BQEE9bjRLNzKgM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVBzKWG7MU0ulu77TGzmyTc0uthOzlFcvdQZV0SMkh-Q&oe=6AB284D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Car Racing VR", "keywords": ["racing", "car", "carracing", "game", "moto"], "long_description": "Ultimate Car Racing: The Definitive VR Speed Experience\nStep into the cockpit and feel the G-force. Ultimate Car Racing is a high-performance VR racing simulator built from the ground up for Meta Horizon OS. Whether you're a seasoned sim-racer or a casual driver looking for an adrenaline rush, our realistic physics and immersive environments deliver the most authentic car racing experience in virtual reality.\n\n\ud83c\udfc1 KEY FEATURES\nTotal Cockpit Immersion: Look around your cabin, check your working side-mirrors, and grab the steering wheel with full Touch Controller support.\n\nRealistic Physics Engine: Experience true-to-life tire grip, weight transfer, and aerodynamics. Every drift and every brake feels responsive and high-stakes.\n\nDiverse Track Selection: Race through sun-drenched highways, tight city circuits, and professional raceways.\n\nElite Car Roster: Unlock and customize a collection of high-performance vehicles, from nimble street tuners to screaming hypercars.\n\n\n\n\ud83d\udc53 DESIGNED FOR COMFORT\nWe know that VR comfort is key to a great race. Ultimate Car Racing includes advanced motion-stabilization tech and customizable comfort vignettes to ensure you can stay on the track for hours without the \"sim-sickness.\"\n\nSupported ", "short_description": "The most immersive car racing simulator on the store. Experience realistic driving, high-speed tracks, and total VR immersion. Buckle up for the ultimate racing challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soniinfo.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Soni Info (RAAL Labs)", "support_website_url": null, "website_url": "https://soniinfo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interacti
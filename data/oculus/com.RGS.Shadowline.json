0", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_629132149697503_4253602065929283511_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh47DH2TX0oQ7kNvwHHrCwk&_nc_oc=AdkpOD7v5JxJk6AlU8pMvwP1RGuFchpnKDhsOzlxm8SYh4rpExYzoribXhmyxtEsEjk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJvJRzxtRyNm_uyvVF-m6nFSQPqms2B11_UWpeVyPowg&oe=69B0044D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Base.png", "id": "645995414509845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393328_645995417843178_6506936718238058306_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlvfdbnbX3UQ7kNvwFQQep2&_nc_oc=AdkD797izSamkE4xZXMnk2DkihbBre0jwEV8CoOCFDMvkrpmgmncLlgAtyy53kNOHfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0DuRIV-8_2_ydqwPN03fRhM9SYpL8ykf85UHNFRQoXw&oe=69B01C08"}, "display_name": "Shadowline", "keywords": ["Shadow", "Line", "Shadowline", "Shooter", "Tactical"], "long_description": "Shadowline is a tactical shooter inspired by Wildlands and Gray Zone Warfare. As an Army Ranger, you are deployed into a hostile Vietnam warzone where a local military force has seized control. Your mission: gather critical intelligence, secure vital resources, and navigate the dangers of a volatile battlefield where every decision counts. Engage in strategic combat, adapt to evolving threats, and immerse yourself in a high-stakes operation where survival and success depend on your tactics.\n\nShadowline is developed by a solo developer and is being released initially in early access. Thank you for your support and hope you enjoy Shadowline! ", "short_description": "Shadowline is a tactical shooter inspired by Wildlands and Gray Zone Warfare. As an Army Ranger, you are deployed into a hostile Vietnam warzone where a local military force has seized control. Your mission: gather critical intelligence, secure vital resources, and navigate the dangers of a volatile battlefield where every decision counts. Engage in strategic combat, adapt to evolving threats, and immerse yourself in a high-stakes operation where survival and success depend on your tactics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/51314695-9758-4e27-8972-d539f99ea809", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8666727583428486"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391899_1142686144215624_7836197586753704755_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvWmKenUkrsQ7kNvwF8niWQ&_nc_oc=Adm4dDlqKzHQkL9RgHrLox8ZEACRPU7M3E434-gLIzIL17gF0t1z5lT02CW0YZnf0KQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3z0-WprS_6B16x0ilq8zlTnP3JkjxzErNwKI-G5T5LA&oe=69B0281B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shadowline", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460
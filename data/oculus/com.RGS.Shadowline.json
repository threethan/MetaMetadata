file_name": "sc4.png", "id": "629132146364170", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393589_629132149697503_4253602065929283511_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuA-YceLfvoQ7kNvwHsO2FI&_nc_oc=AdqEgTYUArm8_eYpy4erTwwYcSZbDaK4KBJiq1-cn_s1l-oD8uWJbp7KPnGrS0yMQXM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwUCWMtqiB9TgkRhR66VQZCKkxPZq8WaAozzwsHfRuxQ&oe=6A68964D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Base.png", "id": "645995414509845", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393328_645995417843178_6506936718238058306_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbnmd4FiVh4Q7kNvwEKF303&_nc_oc=AdpR2wM3hAp4xnkeeXQ5R7ZFc05tdSpDgrtOXrmQYG3K9c1UiNAut93MuwMjJky6fdw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA39NCXrnL9_7H-5wv2IGq_LlbxnV0HorLhAO9gQyuUxg&oe=6A68AE08"}, "display_name": "Shadowline", "keywords": ["Shadow", "Line", "Shadowline", "Shooter", "Tactical"], "long_description": "Shadowline is a tactical shooter inspired by Wildlands and Gray Zone Warfare. As an Army Ranger, you are deployed into a hostile Vietnam warzone where a local military force has seized control. Your mission: gather critical intelligence, secure vital resources, and navigate the dangers of a volatile battlefield where every decision counts. Engage in strategic combat, adapt to evolving threats, and immerse yourself in a high-stakes operation where survival and success depend on your tactics.\n\nShadowline is developed by a solo developer and is being released initially in early access. Thank you for your support and hope you enjoy Shadowline! ", "short_description": "Shadowline is a tactical shooter inspired by Wildlands and Gray Zone Warfare. As an Army Ranger, you are deployed into a hostile Vietnam warzone where a local military force has seized control. Your mission: gather critical intelligence, secure vital resources, and navigate the dangers of a volatile battlefield where every decision counts. Engage in strategic combat, adapt to evolving threats, and immerse yourself in a high-stakes operation where survival and success depend on your tactics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/51314695-9758-4e27-8972-d539f99ea809", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8666727583428486"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391899_1142686144215624_7836197586753704755_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2UeBY6O4lAQ7kNvwHwcMij&_nc_oc=AdqXzvOZtg3h1L92bXmVqYwTVRlt4MwqcCYu5Hfc79LdqALsttBYyI0A44rTstreGpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmhDBWLUzY1CUe0KYXZVJBVExy2lqdEDoUfZa8sU-f-A&oe=6A68BA1B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shadowline", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "45978150496
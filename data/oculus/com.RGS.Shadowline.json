-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvyw6GDJhN9JhSjjrbft5gkkNOgb3jYWzi-c4kz-FW1A&oe=6B0F22D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09_Trailer_Cover_2560x1440.png", "id": "2505968699932679", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296127_2505968706599345_2326212821463631702_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1zLGikVXyQQ7kNvwEA-5nr&_nc_oc=Adq-yCuUxVsPAYSWosIWD3SSq0Xoj_S7i5bHty0qGx-VeOPeEFxpi2g-p-FIrthiNPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDh7PnOe5lgqWJW_SxTOPFm9DuCcfSebutianWAHY9_Q&oe=6B0F0E5D"}, "display_name": "Shadowline", "keywords": ["Shadow", "Line", "Shadowline", "Shooter", "Tactical"], "long_description": "**Shadowline** is a tactical extraction shooter where gathering intelligence and finding supplies are key to survival. Enter Ban Sai, a coastal region occupied by the Khao Vang People's Army, and uncover what the outside world cannot see.\n\nDeploy from a secluded base, complete your assignments, and extract with the intel and resources you recover. As you progress through the map, tougher areas put your preparation and tactics to the test.\n\n- **Loot to survive:** Search for supplies and equipment to keep yourself alive and prepare for challenges ahead.\n- **Complete intel tasks:** Obtain intelligence, deliver it to its destination, or take photographs of evidence in the field.\n- **Use your tablet:** View active tasks, photograph intel, check health stats, and navigate with the map in one essential tool.\n- **Explore Ban Sai:** Move through the fishing village, market, garages, and guarded checkpoints as you investigate the occupation.\n- **Face increasing difficulty:** Progress into more challenging areas and adapt your approach as the map becomes harder.\n- **Work with specialist contacts:** Take assignments from Trigger, Pulse, and Freight to earn rewards, build your standing, and access more equipment.\n- **Deploy and extract:** Enter the region by boat and make your way back along the southern coast to complete your operation.\n\nPlan your route, keep track of your health, and balance your objectives with the supplies you need. Get the intel, find what you need, and make it back.", "short_description": "Shadowline is a tactical extraction shooter set in Ban Sai, a coastal region under military occupation. Deploy, loot to survive, and extract with vital intelligence. Retrieve documents, deliver intel, and photograph evidence while taking on increasingly dangerous areas. Use your tablet to track tasks, capture intel photos, monitor your health, and navigate the map. Complete missions for specialist contacts to earn rewards and access more equipment. Gear up, plan your route and make it out alive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/51314695-9758-4e27-8972-d539f99ea809", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28438593842481900"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295481_2179336089601951_2954626201887878961_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_buc
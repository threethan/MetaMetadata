506936718238058306_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVdjz0dyFu8Q7kNvwHAGsfF&_nc_oc=AdmU-hbfjPSqDTElF-NoiG16FauCqViZ0gl7PLs4PECKU50-D7_ZylzC1tczBOnmMiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftP22stSIIaxRO60LIl8M6abTmgNuRJrcz8hxnKB-CkHQ&oe=69A04A08"}, "display_name": "Shadowline", "keywords": ["Shadow", "Line", "Shadowline", "Shooter", "Tactical"], "long_description": "Shadowline is a tactical shooter inspired by Wildlands and Gray Zone Warfare. As an Army Ranger, you are deployed into a hostile Vietnam warzone where a local military force has seized control. Your mission: gather critical intelligence, secure vital resources, and navigate the dangers of a volatile battlefield where every decision counts. Engage in strategic combat, adapt to evolving threats, and immerse yourself in a high-stakes operation where survival and success depend on your tactics.\n\nShadowline is developed by a solo developer and is being released initially in early access. Thank you for your support and hope you enjoy Shadowline! ", "short_description": "Shadowline is a tactical shooter inspired by Wildlands and Gray Zone Warfare. As an Army Ranger, you are deployed into a hostile Vietnam warzone where a local military force has seized control. Your mission: gather critical intelligence, secure vital resources, and navigate the dangers of a volatile battlefield where every decision counts. Engage in strategic combat, adapt to evolving threats, and immerse yourself in a high-stakes operation where survival and success depend on your tactics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/51314695-9758-4e27-8972-d539f99ea809", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
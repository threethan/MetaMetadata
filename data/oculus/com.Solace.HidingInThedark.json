40075595_5339971527670544323_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5RyWFURSWcQ7kNvwFc3I_1&_nc_oc=Ado0TZcZ9RXeEpehEv1WqtMFsinP-cKnZ1wye4h0qw6qi68oydVG0CbsgHeT6MoPMZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2HxaEkcHGocSsiGESxBV0ScTAN8rtArnPwiJtWqPLu-A&oe=69F0CDB7"}, {"file_name": "SampleScene_Custom..._12.08.2025_16-54-30.png", "id": "1802861736936196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822818_1802861740269529_3004107606981546899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcpLklJtM98Q7kNvwH5Dmk5&_nc_oc=AdoZhWUwG832y1ztXQfc7l_xAcQzfeYid3AwHOoZQDtd_oOXKmtXGBW2eaea933-VjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3VyMofyJ0CokVyqevD2UuTcQM2ik4hpGMB-WzWfUNG5g&oe=69F0B162"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape : Revived", "keywords": ["horror"], "long_description": "Lethal Ape: Revived throws you and your fellow monkes into a high-stakes survival nightmare. Locked inside a mysterious research facility, you must navigate dark corridors, sealed chambers, and eerie laboratories while two relentless monsters hunt you down\u2014Ashy, the burning shadow that strikes without warning, and Sand Man, the silent stalker who smothers all hope.\n\n", "short_description": "Survive the chaos in Lethal Ape: Revived. Trapped in a deadly facility, monkes must work together to escape the clutches of two terrifying monsters\u2014Ashy and Sand Man."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/df342ab6-cc4c-4cf3-96da-c95f6f11c715", "developer_terms_of_service_url": null, "publisher_name": "Solace", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1rCvWSnXSLx7S6l5MGDtEUKyF64QrHnNTFy_AwWiJDoE", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "exte
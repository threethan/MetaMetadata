20f&oh=00_AQTUX9evnQHoi0zrx0WPaebPbly33Jvg9Pwpi6NL-XSmLA&oe=6AE9E1BC"}, {"file_name": "SampleScene_Custom..._03.08.2025_10-50-51.png", "id": "600386719597091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304079_600386722930424_399453893370230603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV_5d8WSQeoQ7kNvwEqYUiQ&_nc_oc=AdoOUsCm67YeuJrfwwC_wla8eMKGbQgfm88ueRppneM2wxbBcOESigDnWJrz2n4BRcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR79dkmBlNGDiGcTcvsBs-HKEedR_04Xsn9F_E4J38DZw&oe=6AE9FC24"}, {"file_name": "SampleScene_Custom..._03.08.2025_10-50-46.png", "id": "2142751679580299", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618247_2142751682913632_6731506069996212476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcQ7VFbHS_QQ7kNvwFlH-A5&_nc_oc=AdrZ6g6Nqz5XTFAlfcOcYk6Q5BHYDUMDjQVssfokwqYHZz0Xp5VYyjFhO99VizD4F5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrz-aE1XRVZvHHy56KannJ24gIveZuC6PtkFBhLTXo5g&oe=6AEA12B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hiding In The Dark!", "keywords": ["horror"], "long_description": "Step into the pitch-black corridors of Hiding In The Dark!, a nerve-racking horror experience set in a sprawling, decaying facility. Your goal? Stay alive. But survival won\u2019t come easy with three unique monsters hunting you down.\n\nCrawly slithers through the ventilation system, waiting for the perfect moment to drop down and strike. Slender, a tall, faceless entity, silently stalks the shadows, warping your senses and appearing when you least expect it. And then there\u2019s the Sawrunner, a brutal, chainsaw-wielding maniac who roams the halls with one purpose\u2014eliminate anything that moves.\n\nWork alone or with others as you explore the facility, find hiding spots, solve puzzles, and outwit the creatures that thrive in the dark. Every flickering light and distant sound could be the last thing you ever see or hear.\n\nDo you have what it takes to stay hidden\u2026 and stay alive?", "short_description": "Hiding In The Dark! is a terrifying multiplayer horror game set in a massive abandoned facility. Evade three deadly monsters\u2014Crawly in the vents, Slender lurking in the shadows, and the relentless Sawrunner\u2014as you try to survive the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/11ac04d4-3c17-4c51-9984-1596676f13ad", "developer_terms_of_service_url": null, "publisher_name": "Solace", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1rCvWSnXSLx7S6l5MGDtEUKyF64QrHnNTFy_AwWiJDoE/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24961709080099285"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "982145913943294"}]}, "baseline_offer": {"id": "982145913943294"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754324520, "status": "PUBLISHED", "id": "982145913943294"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25078025791800946", "version": "431"}, "id": "1391516835241559", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_app
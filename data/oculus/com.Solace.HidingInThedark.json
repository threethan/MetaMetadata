g", "id": "1347504536742262", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822737_1347504540075595_5339971527670544323_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j61UL1F36qYQ7kNvwF4j3UL&_nc_oc=AdoTNu1Q4Z2BRLahbsh5McfupihEQaeTFAu-j4HYptfIZknQvUc7i43iQkmelq6mL1c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICuYENX6v2ZXAJWJq1PCJsRC6rUofZfsI8QF-r5KsDSg&oe=6AA95FB7"}, {"file_name": "SampleScene_Custom..._12.08.2025_16-54-30.png", "id": "1802861736936196", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822818_1802861740269529_3004107606981546899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9x1GbdA_wKwQ7kNvwGuMxeC&_nc_oc=AdoGHXvArTp4-3B80Zk6pWQcR-JungiGg2GZHymbps4xcrskFrEKvqTW5Xf3w9IN7Fc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_P3bh8ItEnY_KY3odKQn0M1um1pvuoMRm2veJ3yhelg&oe=6AA94362"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape : Revived", "keywords": ["horror"], "long_description": "Lethal Ape: Revived throws you and your fellow monkes into a high-stakes survival nightmare. Locked inside a mysterious research facility, you must navigate dark corridors, sealed chambers, and eerie laboratories while two relentless monsters hunt you down\u2014Ashy, the burning shadow that strikes without warning, and Sand Man, the silent stalker who smothers all hope.\n\n", "short_description": "Survive the chaos in Lethal Ape: Revived. Trapped in a deadly facility, monkes must work together to escape the clutches of two terrifying monsters\u2014Ashy and Sand Man."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/df342ab6-cc4c-4cf3-96da-c95f6f11c715", "developer_terms_of_service_url": null, "publisher_name": "Solace", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1rCvWSnXSLx7S6l5MGDtEUKyF64QrHnNTFy_AwWiJDoE", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags":
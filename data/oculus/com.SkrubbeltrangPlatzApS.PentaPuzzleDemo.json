ailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Splash.PNG", "id": "106091994779789", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75339311_106091998113122_2602396103099057381_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thuMYd2Lje0Q7kNvwG9RVnp&_nc_oc=Adl5gWT-R8h7E0rCf26CfPZLJPGLieHHc18hu5robRk09hOGxs1QDHXJd5yBbqQbTvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTnYGrnaMCC6I5bmm3H3CoBReisRLV2ym0naeIu74tTA&oe=69BFFED5"}, "display_name": "PentaPuzzle Demo", "keywords": [], "long_description": "PentaPuzzle is an immersive puzzle game for the Oculus Quest VR headset. The game offers simple but beautiful puzzles that range from easy to very hard.\nThe 12 unique PentaPuzzle pieces are all created by the combination of five squares. From this deceptively simple design endless combinations and challenges arise to keep you lingering between annoyance and achievement.\nThe amazing interactive soundtrack develops according to your progress and is composed by Matthew Herbert and Sam Beste.", "short_description": "PentaPuzzle is an immersive puzzle game for the Oculus Quest VR headset. The game offers simple but beautiful puzzles that range from easy to very hard.\nThe 12 unique PentaPuzzle pieces are all created by the combination of five squares. From this deceptively simple design endless combinations and challenges arise to keep you lingering between annoyance and achievement.\nThe amazing interactive soundtrack develops according to your progress and is composed by Matthew Herbert and Sam Beste."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pentapuzzle.com/privacy-policy/", "developer_terms_of_service_url": "https://pentapuzzle.com/terms-of-service/", "publisher_name": "Skrubbeltrang & Platz", "support_website_url": "https://pentapuzzle.com/", "website_url": "https://pentapuzzle.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925
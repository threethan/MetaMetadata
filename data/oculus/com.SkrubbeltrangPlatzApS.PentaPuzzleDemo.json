/scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339311_106091998113122_2602396103099057381_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pQMqGdzlFQQ7kNvwFy7uh6&_nc_oc=AdlQAZzYrgUmwcNWz4LPDQ3DH6k3NRzZGhfLZXKkYAtMo6v7S52-gu5bBTVPh8wiEV0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvy36DW8-fUT5hnr_23mtYue2Z43CdLXR97wJtUvnGrBw&oe=699B14D5"}, "display_name": "PentaPuzzle Demo", "keywords": [], "long_description": "PentaPuzzle is an immersive puzzle game for the Oculus Quest VR headset. The game offers simple but beautiful puzzles that range from easy to very hard.\nThe 12 unique PentaPuzzle pieces are all created by the combination of five squares. From this deceptively simple design endless combinations and challenges arise to keep you lingering between annoyance and achievement.\nThe amazing interactive soundtrack develops according to your progress and is composed by Matthew Herbert and Sam Beste.", "short_description": "PentaPuzzle is an immersive puzzle game for the Oculus Quest VR headset. The game offers simple but beautiful puzzles that range from easy to very hard.\nThe 12 unique PentaPuzzle pieces are all created by the combination of five squares. From this deceptively simple design endless combinations and challenges arise to keep you lingering between annoyance and achievement.\nThe amazing interactive soundtrack develops according to your progress and is composed by Matthew Herbert and Sam Beste."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pentapuzzle.com/privacy-policy/", "developer_terms_of_service_url": "https://pentapuzzle.com/terms-of-service/", "publisher_name": "Skrubbeltrang & Platz", "support_website_url": "https://pentapuzzle.com/", "website_url": "https://pentapuzzle.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED
356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skmm9LaEcLQQ7kNvwGdTm3s&_nc_oc=Adps9sqA8y8DlrZfYEC-N1UOysxNnWYRcMPZCi5u0xAAdGCQIaiM_JrPF8qum3zNnGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VAS8Oy2v8GQ1PCg5NsVL_Ri9LsDxX7uf_hiDTYWKWhg&oe=69D51283"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMypWVerRqMQ7kNvwE1s4Xb&_nc_oc=Adq5zBdkI0TE_kzVpAHryHkgfc40JVDQp1rsOhMAZkgydDaonlKkCMOWuRI3ysJ-wkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ld511jZQK4iPfeWp6z8SICi_Flx7oHNkJEl8F_6pkiQ&oe=69D51189"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H6_-yW2l6AQ7kNvwGb5Ki-&_nc_oc=Adr3autVoptTgmN6-8zerpdJ9Qxzw4PA-XnUIGTXnR3zmN6n1xctmkrjF4SMfAnJEOI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w7UMNpsfCyq0jJStmr30W2teJMDh-wPRsoLtlqK1MvA&oe=69D4F7C7"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIuZ5NwRfMYQ7kNvwFSwCuy&_nc_oc=AdptGPiXdzLhv2N8T7wKprvSWsgsu0xh_TlZX-QKJ6SXcDYDhVdLeZPUtWbw9ahrExw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kBSo7iiLunQ3VeIX92OnwUGuSN_bUSghbm1LOS7bgzg&oe=69D4EF04"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcAfHUVPCFUQ7kNvwGNuRVT&_nc_oc=Adr6tUrKjnp43UsTFPDg-56v5HKWog_767_AsaZHFC29hfz6d0Z-5bVMnaWRnEg1qHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wsQpTjMOv6_DKgXiAFOOlApnH5CX_bOyGH_pOSp4uOQ&oe=69D4F6E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99lxUBj65pYQ7kNvwG9Ai4E&_nc_oc=Adq4yoM0hZlnmBT3XSYNVsgYDiVbUJQS6aM3u2_1QbMGjt0MlEwBZ8HaNtjlM-IeN7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XCLjUEtupsc5otdFtZLR3fAWd4TcVq_8935iLyyzMAA&oe=69D4EA50"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii H
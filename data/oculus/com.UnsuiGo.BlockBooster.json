356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_QNdMLXfSUQ7kNvwGIfR1b&_nc_oc=AdrUyy5p9CqCGL_Jyz1OmRrlVcEz-f8v2rtgNxtZdr7cyIB1gtLY2OOZRB3ZEv14TLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI11xypoppGhhQKJydYoLeYb7dWC-Nwlv2FI2SCA5POg&oe=6ABA7783"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpUzKtf5p2IQ7kNvwEhRBp5&_nc_oc=Adou-RBaAmyXe0IB8HP_N4ZoVAWFZFmlHbAUj9z-ytb--PA7ot09-OmZIOu-hiOAx_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCjhp_IlyOlqQIGTNe9Uro7OsBuh0SMa_ggSUeAvprAg&oe=6ABA7689"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D-TFaj8NS8Q7kNvwEHeEqd&_nc_oc=AdqkE37lsmvZCyTbP38DWdH4SB9ME8PY1AazwBAJRoR_O-gUV-mwTAJB9rm3dAw2R7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUl1bO-dS8SRQmIvu7JoFw0EPSv74THacOlog3gu_axQ&oe=6ABA5CC7"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXZBP-LlxbsQ7kNvwF9xBBs&_nc_oc=AdqVKJMSZAmqjEUjoiWaFY3hSaFFXFfJ75TBO7wdabz2bmG4jP1ypJJ6kTjuyIQ1Tps&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd1lFfjaineBSP92Hr2VI6yJB9ugMsmFi4xomNUbn1fg&oe=6ABA8C44"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jpfh04aAyWsQ7kNvwFLELbt&_nc_oc=AdrW96By3h9bs7YJCWclHV0BP0_nq_FOO98VwCVLtoAjKqf8APMaPdam4k7U7rQiUdg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZBAFOokoZ41USkPQH87Vo57ext6o3QcBAzpOIG23jaQ&oe=6ABA5BE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9ZX1BtxX0wQ7kNvwFkrFyE&_nc_oc=Adou-kkJrhggs4rcFN2XLzJBKL168fP1deLWyIBcfS9F18lTDiTKSLdYg70xH-G9TzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl5Bv8f95UgVmixtpE5joLfVichLKdSKd6shSI6qp4Sg&oe=6ABA8790"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii H
356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mON1LVJaT98Q7kNvwEYDbh4&_nc_oc=Adp1ThYmxRJNoKG6NXEJEvp2Y6Zz4cjbfIluBAZyuLBJGJRwnrWRHvPgmkNMA4HUtB4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hqoJKr3U4BWn_vDTRdHzc63K88suZln0pT5eKQs2CTA&oe=69D7B583"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev0OZgAB9HoQ7kNvwESv5Vz&_nc_oc=AdojCxe-pQODCXZTyRo3yHEo3hy2BtgDNEvCF4vmmsyWm-9co9DfZJzTTU2VgH5_IXk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NHgslK0hzTe8iW3HOymNHuulsN4KoToVOf5KARQQokg&oe=69D7B489"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H6_-yW2l6AQ7kNvwG-T1Vv&_nc_oc=AdryCg0v_evtPGsCBX-jldpxU-hYkm7x_eWjmOWG72hJWToGv8hgeMgS6o9oBiuYEZs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mC13EYpOgbTlzWVgcvfXqHY_ld_kCdQGjcH5Qcn1i2A&oe=69D79AC7"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9qnfY2qCycQ7kNvwFY9Dvf&_nc_oc=Adpu0qgbZJXRwLONiu2slKdu0t0uTVtgaHHirwVHZ7FBXlRTEl3UKbokboLNsH4mIQA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IdS0YpARW1mQ6P-x_60HrjdvpPuGw-GCb-ekCPp_-YQ&oe=69D79204"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeQeUsuqe2AQ7kNvwHeS0qR&_nc_oc=AdoDB9QMBAF_QqvsTHzZWd-dDSgcEheoBAvd06txwuB0xnLg5QB2zMlPCV05C7I356s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ePGa6PgSz7_wsqZt7QN6k-ZNXbvr9nfrhV0cE0oAp8Q&oe=69D799E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6WIhOEzgA4Q7kNvwGaFjNs&_nc_oc=AdpnQw0wDDSOqqzXerb12H7aTF4k_B0teaGrb12GAt-YdoRmfEH1cTzBWzBUhLjfkGg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c9LYMjE1BPYUu_CreXF0_2wsCDBOWsy_1Fs7pCaRkvA&oe=69D78D50"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii Hinchuk", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100090303563530", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6959041550882687"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7703140243139477", "version": "1.3.1V25"}, "id": "385819227458745", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6959041534216022", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7703140243139477"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "385819227458745"}]}, "change_log": "Upgarded colors", "created_date": 1719832258, "id": "7703140243139477", "version": "1.3.1V25", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBina
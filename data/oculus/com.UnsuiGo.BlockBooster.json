356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHd_looQy6kQ7kNvwE_ITSw&_nc_oc=Adqzc7cA9BF_hzlft_SealS8pTlBsB-UcsSKywb5uvBTRzuNP20rrzZywxZ4i68L2BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Kbc1gd5CAd0VHWRIU0qCS1atoho173nDOpv15FA6low&oe=69DBAA03"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSwMA1TOpRYQ7kNvwFUENFy&_nc_oc=AdoRDmqkiR9gJDYFATGr8Xo_DH9LAcYR-tD7Fb_isX4eeylSU79ZSoCsWqZkMTRK78M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YQtAQC_LLT93wyMWHaYu0u_7iXuFgUfdbtvDzG6mQMg&oe=69DBA909"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUGRAskiq1IQ7kNvwEzhTMf&_nc_oc=AdoycINb95MjzvHAUSVXEfYV6ULL7aMclxXqWxEQ534Qv_NMHIoKzbw7pjRYxw6gDog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z9DTNPzOCaHmWz0uy1Y5NG5RVwLOgZs8GR81VDNoUOA&oe=69DB8F47"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7yQybS_tXMQ7kNvwG8wnbs&_nc_oc=Adr_K5R1gZxPOX0IRx52Ah0zTosG-d9Eu_wTNbP46JlRBc3xwEG6Jse3jx76QxoQsCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RsTsH7qyY-CtBay5CjiBwjRWU-zBPZCHdcy_xyT3XOQ&oe=69DB8684"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgamWb_CYJAQ7kNvwFWun9C&_nc_oc=Adry8sAFqRpZmbUlWlPKnJphzrNWIoXPmOXZUl_HKsZBBqV1dzg-LF2cfFWd6SWsEKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DVs3HD4xw6xO1CdqWkVSZCR4un187HrDevyBfSKFQcQ&oe=69DB8E63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoDlIyZFzrcQ7kNvwEM2Bf9&_nc_oc=Adozt1wv51YKh3-QQeZ3_wvoKIZUQ2rPSbDdwbegCAAWxz55dcO8NVP9oK9GP27BRps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_4wZLXf-E57exgOHm54IDOjaMt4mLm6gJi67PpqLm9g&oe=69DB81D0"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii Hinchuk", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100090303563530", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6959041550882687"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7703140243139477", "version": "1.3.1V25"}, "id": "385819227458745", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6959041534216022", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7703140243139477"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "385819227458745"}]}, "change_log": "Upgarded colors", "created_date": 1719832258, "id": "7703140243139477", "version": "1.3.1V25", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBina
356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp3o8VvwiIIQ7kNvwEUNkRi&_nc_oc=AdpV3tNzyrUKzNkAAaj3cw1UkrYbEzM39-Xmsn-g1gu7mXnJDAQj32cOJ_MhGXHAZBs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AbnK_7gq_VJH8F1S7rd2eXJayHxLteHQJL1JyklhgyA&oe=6A19A083"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NPTN1ofMAUQ7kNvwFSbUNQ&_nc_oc=Adp17Ye3IqNE8VqCJfes68hSU-VX8FmgJCKwuCslqnfPjNhWOESo-Wpxyg-H9UHDMbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m4tW0Y3DTgB9yqOuk3KVjAN9cgTxmyuVXlNTxpOKZyw&oe=6A199F89"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcoVDIv77lIQ7kNvwHrR1-3&_nc_oc=Adp87I4ZHQb-RUG-icjRsR3BIz2_l96EnLP0EuEV7KXEDUkDMMhCdyc1u2JSVklGIRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wt6HsG8u3p7cviJB0llgs8H1Skelu0UPTHowuUSmoHA&oe=6A1985C7"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=498PX9ztXpYQ7kNvwEoaktR&_nc_oc=AdptQocffFEcUyZBzbXNlYZE-kUmED32kSK7nu8eTn5KP32K7eBX3sUkFJZZlKKxas4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68PXPH8e15GOlmf9iJZAz1xKlVmvPcmeiSZK3kepFQlA&oe=6A19B544"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srMsnqdKF9wQ7kNvwFn8Ohc&_nc_oc=AdoZxIPLH9XbYhQLjw_S1hO1cy-to7IKmiVovrIwufv-VwitFCZ3TIKYlxZDowlfx1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6doPMwshbu1M9Q2XNTjC45Z0U1IBlpwcoEUJTETTDQjA&oe=6A1984E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBJdhWSEV_AQ7kNvwH0ng8n&_nc_oc=AdqICaHB7v1WGPqwabrdP-yh8UMF4Z-iubp7F4WciR2vr5CW8FsJPwYKy5cBeXYzj-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eFKx5zwIFuHWy0GP8I0bGR4BGFZz3xuwJe0RCgCYZDw&oe=6A19B090"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii H
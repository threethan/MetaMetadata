356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If03ehjs5RYQ7kNvwEkPxXY&_nc_oc=AdozxpQfSbw6v4IsV52lpz1CwEUNtt1qMyumHa5G1WYqDxmKQXSV7BoBdwBCtyMzYpc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKXRc24NuwxqiVr8DyuXSd7F0cHrJEFljSymSN3ve4yw&oe=6ACE3E03"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1mnoMnomIYQ7kNvwGTJNgv&_nc_oc=AdrUDkGhOAbQ8gXr476BEIm3h8478uHDlwGRqtiu24Bh5gcIOsXqAYcxjiq-r7K2k8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvkWDy26neCFEt8c1u_a1HAhaBHr1cwSd_hERnz6S5Cw&oe=6ACE3D09"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbaHIdfbTAUQ7kNvwGxiEFA&_nc_oc=AdrthelGtfWVkOACEL508GJtOxyOVnIWXQQmNaGard9SaMBgZoueZPrBtTKCo7Kdf_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaGa240o-1kIi-tkQKLbTiH-jorNah1o09XcuGw-IevA&oe=6ACE5B87"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eegi_kfN1vwQ7kNvwH2aYL9&_nc_oc=Adq917zsjOxxF98k0-xSzTiDywltP6UdMnoWCL3vjnGtUkFDaEfuVyXG6_OMGOTR9BA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCZfjmG2CorY0rgXxmBK1kHtJ4s_UzmiFr0KMy2UWbiQ&oe=6ACE52C4"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKIvR82M31kQ7kNvwGJWRmj&_nc_oc=AdpsLyMeofMc593KJlEsJgzbuXOKLddmUIAaAwlf8TOegpXMvThKzUKRY-TXDbll8hY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEu4-IxD_GFVbk9tbKjUIl1eUMyTWhncAny6KEwzKSjQ&oe=6ACE5AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8JFtym5o8MQ7kNvwHqlHOa&_nc_oc=AdrEa_h_PmkpDdcXkR7SPEMtFAlrqA1v2iXgZFOnz6IJnRQ3mik6_qg-q7iZQNFhnNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYF39IqISo4px4ZsYCZk7zr1UjU3p-jxMT_MW79t-zzw&oe=6ACE4E10"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii H
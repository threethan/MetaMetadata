356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jb6apw5qHAQ7kNvwE8mEai&_nc_oc=AdovEqQnyYVKaCD-3mjlY9HX_OCfjQHJY_AXUiDC30O7NeabXuUhqG6DQiNhLP_kSV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H8At8fwTxEkHbJfIVP5KOsxNEjgwH5_lL1lJGge8zGA&oe=69EA2A83"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feVGLzGpFPoQ7kNvwFsB2jA&_nc_oc=AdqFOlivOc4Dh1GJ2nJCOI35J_GzEXgbpgw0svXJcsA6GOVPNkvo876G6T3yEtt99nQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12iUneTLUxmSjjn7tVgFWuo4kEKVN0F_Kgwg8CMq3lyA&oe=69EA2989"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-n9qlP2AmYQ7kNvwEaj-o1&_nc_oc=AdpKZR55AsbD7EdhC_cjN0Q0A63FfSXO_NDs_zYnIW0uhCwZOg8TznB_8QCUNhhfdc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MdY1pUFBkPwvzJsJ7fdm8mdz-UG7iJ4P3a4FywMNalw&oe=69EA0FC7"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggiRF9xngToQ7kNvwGQq4gc&_nc_oc=AdpJWBSpZh9Ft9FvxhE2UvJM0Jj48WzqLU4XzVw3E37XQOLLp8eLyPq9TG-Nd1N3dd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27q0IDOfQCjGq82672Hq9wlIjX9vajONKWVKEQomlcAA&oe=69EA0704"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgZ6Hi4BPIMQ7kNvwFBoDJw&_nc_oc=AdoXBcurvE2J9aon5IQToL4weIkGnKIFIAG1hfhq9x4QVK8riihjLBOYJeLdL3ownNE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZCHZjOpa7j2YDRrN_xNiOu1kv3tLyxQyjNpmx2YKEwA&oe=69EA0EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfDpOtkc1mwQ7kNvwHIHLbu&_nc_oc=AdqkhHyyUHfPcsQvR7WvN8EIaA0BbuFHBsmk191f1pvwOgXyR4gZbo_EMNhdldUXSIQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0inKNDuTYy9SBjRdRUjIHgdBgs1I45Lrax98gXWz9P8g&oe=69EA0250"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii H
356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mON1LVJaT98Q7kNvwEUZOq2&_nc_oc=Adp0J6x18M8eUX_c-3gkrZSU3uEnE4rZyM7MCLb92V38lSVfHyaPkJ8VrgPerULZHUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YZr7ZggoWI279Q2Tx_5LORnmXiu-tElr43qj3SDQAng&oe=69DA5883"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSwMA1TOpRYQ7kNvwGBBuQz&_nc_oc=AdqZtLoAgn9kHMZAb8R-uInEjwhiBKfDLI5KDFOo7ew_4TQLukfCLdUGUaSIqwbfXqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j8_3QgVaAXMmHiImK3mAqu6SJVyzT9SqaSklNsCSBXA&oe=69DA5789"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUGRAskiq1IQ7kNvwGVDHYs&_nc_oc=AdrfAEKJ8THm5Mo8ZP_NjMPVkl-PUSIhi9hmJ5puNbrNOUUAsTY_y2NKfNNVF8aZGnI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DOUF_PlVAzBsheJ6npfxZ_KnvjEagLG1p3Cn_h76x3A&oe=69DA3DC7"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7yQybS_tXMQ7kNvwFORM8b&_nc_oc=Adq-ZN_N8B8gvVtNPkYxqC8cgjKQOHzQdr1V5VDeSPgCzr4WZAzmbdyCsQV2NsFDWn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yUQVO3IliEINdkmVQ6i3ujlN2kYrhiAwXCJ95FR7MoA&oe=69DA3504"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeQeUsuqe2AQ7kNvwFfGWmE&_nc_oc=AdqcJlGWCr5zH_tLFRcIXi3MJxzHR4IbFg8YY-Y_77RWQaHS9sx_DCkxOb3dbTA7CYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tALNi6Zr-GfdrsrIBgPG-UEJvcjNzs2meb2IsTg20BA&oe=69DA3CE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6WIhOEzgA4Q7kNvwGqN-Po&_nc_oc=AdpE9St8UMm8W031ntOel5kg2JpENinN5a-6ccStZMxmVNmnaPbtwuxTDLlffwIrcrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZmukqYm1CoYWZHgW1Wfs9mVi8QXczOYEGm_P5vbl9Yw&oe=69DA3050"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii H
356", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "283152794808188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86609237_283152798141521_3228257115945972723_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-dhBC3nndkQ7kNvwHO8MTT&_nc_oc=AdpHdmkWlB9dZtm_XNSWjPwuUjQdRPryvEeb8LRC4JyY_seF3XVFYL-R5AnyTV9UMuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EgTnbCkFbu5v62M83eClKb3Qt9tUBcoCbsrG4HV1u9A&oe=6A257E03"}, {"file_name": "2.png", "id": "382979207780736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_382979211114069_2757336684803951364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZN7895hvUAQ7kNvwGmNrxq&_nc_oc=AdqgUP3kZIMhcqnXLxjr0XavuZgILYEtdRTnMcSiBpVLX1jgZc_b2PWWLV5N7n_lEKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iXpuTT-lk95deJ149ezYUtKqoslpuImvNcHf9abP8cQ&oe=6A257D09"}, {"file_name": "3.png", "id": "256573780844296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241696_256573784177629_2651472623109830482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWIvpHxkJRkQ7kNvwHgiiNz&_nc_oc=AdqV23MmPDMwtDw5q0iX-N7yb5mDzMOPXKT29qggAiFlSzQ58YMXSIzi9pKfPEA_4tU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o1kRldFHzpotYbrh1gc4FOGHVTchwvMzGjA9iYCrmNQ&oe=6A259B87"}, {"file_name": "4.png", "id": "1637552650348356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031363_1637552657015022_1262021425768635274_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtMrNYVzMiUQ7kNvwEGhthE&_nc_oc=AdrzQ8_OQ1aHq5xQ7GXUVsIMp2K3mgugWBdbd0k-EFYgKID4q41qLfHcEixrvRRnIq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BM353B5X_TumHtr17yop-K5AMcwX5QaSlP51XGnN2IQ&oe=6A2592C4"}, {"file_name": "5.png", "id": "362938819976224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035402_362938823309557_6071927339970691865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6UvFFZpwwMQ7kNvwGN7cjb&_nc_oc=AdoNeSVU3C3SFTP3nxvx39OMOt6FCw7qJzGpu1n5y4MMBLQgc3GaUC5fViMhMPG6814&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96cfNl2reE8Hp7pXhyvl4ShQ7RVCT1c5Vsx1TQtdKOcQ&oe=6A259AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANER_2560_1440.png", "id": "955852295933604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031370_955852299266937_2273019522432416745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNBq8x8-ZhUQ7kNvwFz2e0S&_nc_oc=AdqL2sJM9IdPhT2BMwZ6ez2o0y_HI7dVBX4Yrdaal1lugC7y_yGe45zrb6z7rLqpYgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bq4SHQou_JcERVqtx0EU_sS28gI0eRUvUB8Ugssr-8g&oe=6A258E10"}, "display_name": "Block Booster", "keywords": [], "long_description": "Step into a thrilling VR world where every puzzle is an adventure for your brain! Our game isn't just about having fun in virtual reality\u2014it's a cool way to make your brain sharper and faster. Think of it as a gym for your mind, where you twist and turn 3D shapes to fit them together and clear levels.\n\nAs you play, you'll get better at figuring out how to solve these puzzles faster and with fewer moves. It's like training your brain to see things from different angles, and it's a blast! The controls are super easy to get the hang of, so you can start playing and improving your skills right away.\n\nNo matter if you're just looking for a fun game to play after school or you want to give your brain a serious workout, our game has got you covered. It's perfect for when you want to challenge yourself and see how smart you can be in 3D space. Get ready to boost your brain and have tons of fun with our VR puzzle that's all about making you think and move in new ways!", "short_description": "Intellect booster"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1cnNj9q_IG7uStY-L4-XEvup2_WFV10MokfS6n1lgunU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Oleksii Hinchuk", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100090303563530", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6959041550882687"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7703140243139477", "version": "1.3.1V25"}, "id": "385819227458745", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6959041534216022", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7703140243139477"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "385819227458745"}]}, "change_log": "Upgarded colors", "created_date": 1719832258, "id": "7703140243139477", "version": "1.3.1V25", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBina
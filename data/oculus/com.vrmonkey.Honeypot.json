pHNz8LrTwb5zf2yakEuU1druWolVm4cZzpsUjzIL0sw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm9WPmjomFnliyHt6ID2OEuwpXtYqQoeHY1Ken1JKboA&oe=6AAE99E4"}, {"file_name": "Screenshot03.png", "id": "305800255554738", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974591_305800258888071_6161779028639416100_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a-0xwblpLsQ7kNvwFw2zka&_nc_oc=Ado5oKgf6sRkttljtVwm7M2QtSqghHtHW0wIeMi9aYjI55PzLL5Jrq1cGKTGxigrbyc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGM6w8IuQZWbLHDoM9Z5juPu2e5oI6XdCw2fr8Sc7aJQ&oe=6AAE99F0"}, {"file_name": "Screenshot06.png", "id": "1186465599786631", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393491_1186465606453297_5744526721767933925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8vL3idlkMcQ7kNvwHRnIm-&_nc_oc=AdplABFKsGIJV5v6DouUt0a61lUCCSrxJGao3j_WmNz7rBb_vWHCeSwwD-aEbvk0O_M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL3R7tmvy0WlTgop0la5Jt8Apwe4pdISpFdcCqQbjK_A&oe=6AAEA4AC"}, {"file_name": "ScreenshotL\u00e9o.png", "id": "3125081077629055", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982530_3125081080962388_4612342060629949284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug8AOscCc1kQ7kNvwHghP2H&_nc_oc=AdrsaLyAO3_7nO29XWn3nBCZ5XflbPTdWJf6myNA7nsD2sbLx3X4q0k3jCHG6SpUEAE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOTMXfvt5fsfteN9gPeRKvHUqh84uEbBvHOgw7KVK5vA&oe=6AAE8F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HoneyPot_CoverImageSafeAreaTemplateLandscape2.png", "id": "946241920980675", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393567_946241924314008_4012019332895801025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVHyu-31BdcQ7kNvwGythI_&_nc_oc=Adqgf-8KpZQkqy3usg9noJ7mWwg4Tu4lAEtaAhnfk-1SIOoVZ0hRAujC4NR4W5nTsYU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQDeaL5s65PaZ1HZFGm3dFwhJFR7JY2bssEg97UDK2zw&oe=6AAE94F3"}, "display_name": "Honey Pot", "keywords": ["bee", "party", "tower", "coop", "minigame"], "long_description": "\ud83d\uddfa\ufe0f **Campaign Mode \u2013 Defend the Hive, Save the World**\n\nJoin the bee resistance in a full campaign mode where you must protect your floating hive from waves of invading elemental bears!\nBuild turrets, collect honey, and shoot arrows to stop the enemy.\nUnlock new maps, technologies, and story moments as you uncover who's really behind the attack on nature\u2019s harmony.\n\n-Strategic tower placement in real time\n-Intense bear waves with elemental strengths and weaknesses\n-Play solo or in co-op with up to 4 players\n\n{577833301967605}\n\n\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\n\n\ud83c\udf89 **Minigames \u2013 Buzzing Fun with Friends**\n\nTake a break from defending the hive and dive into fast-paced minigames designed for multiplayer chaos and laughs! Whether you're racing through obstacle courses, battling in archery arenas, or collecting honey in frantic competitions, there\u2019s always something fun to do in the hive.\n\n-Accessible fun for all ages\n-Great for casual drop-in multiplayer\n-Perfect way to master flying and shooting mechanics\n-Earn Queen Coins and show off your skills!\n\n\n{1000023288758102}\n\n\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\ud83d\udc1d\n\n\ud83d\udc51 **Skins & Customization \u2013 Bee Yourself**\n\nMake your bee stand out! Earn honey and unlock dozens of stylish skins, accessories, and flair to customize your bee warrior.\n\n- Unlock skins through gameplay and achievements\n- Seasonal and themed outfits\n- Show off your unique look in the Lobby and during missions\n\n{1629923477635235}\n", "short_description": "Honey Pot is a cooperative VR tower defense game where up to 4 players become warrior bees defending their hive from hordes of elemental bears. Fly, build turrets, and shoot arrows to protect the hive. \n\nWith immersive mechanics, strategic gameplay, and a vibrant cartoon world, Honey Pot offers an action-packed experience full of teamwork and fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrmonkey.com.br/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "VRMonkey", "support_website_url": "https://vrmonkey.com.br/", "website_url": "https://vrmonkey.com.br/projects/honeypot/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28905781052403063"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1831591234510517"}, {"status": "CANCELLED", "id": "2247976285951376"}, {"status": "CANCELLED", "id": "1732644991111759"}, {"status": "CANCELLED", "id": "1365941849012356"}, {"status": "CANCELLED", "id": "2008335149888540"}, {"status": "CANCELLED", "id": "1548611333307398"}, {"status": "PUBLISHED", "id": "988778497368089"}, {"status": "PUBLISHED", "id"
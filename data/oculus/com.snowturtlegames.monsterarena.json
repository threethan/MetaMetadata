ame": "Monster Arena VR: Endless Survival", "keywords": ["action", "vrshooter", "quest", "monsterarena", "quest2"], "long_description": "Monster Arena VR: Endless Survival\n\nEnter the ultimate VR monster survival shooter and fight for your life against endless waves of terrifying creatures in Monster Arena VR: Endless Survival. Experience intense virtual reality FPS combat, battle giant boss monsters, unlock powerful weapons, and survive as long as possible in this action-packed VR survival game.\n\nStep into a brutal arena where monsters attack from every direction. Test your reflexes, improve your strategy, and master fast-paced combat as each wave becomes increasingly challenging. Fight through endless monster hordes, defeat powerful creatures, and climb the leaderboards in this immersive arena survival shooter experience.\n\nFeaturing exciting first-person VR gameplay, dynamic combat encounters, and endless replayability, Monster Arena VR: Endless Survival delivers an adrenaline-filled adventure for fans of monster shooters, horde shooters, survival games, and VR FPS action.\n\nFeatures\n\n\u2022 Fight endless waves of monsters and creatures\n\u2022 Experience fast-paced VR survival shooter gameplay\n\u2022 Battle giant boss monsters and challenging enemy hordes\n\u2022 Survive increasingly difficult arena challenges\n\u2022 Compete for high scores and longest survival times\n\u2022 Enjoy immersive first-person virtual reality combat\n\u2022 Experience arcade-style progression and endless gaming \n\nCan you survive the ultimate arena of infinite creature shooting  on both Quest 2 and meta quest 3 . \n\n", "short_description": "Dive into the Monster Arena VR: Endless Survival available on Meta Quest VR\u2014an endless battle arena where dancing monsters await. Test your skills in this thrilling, action-packed experience.\nFight endless waves of monsters in this fast-paced VR survival shooter. Battle creatures, unlock powerful weapons, defeat bosses, and survive the ultimate arena challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/cca3041d-a2b0-49c7-9496-f84d96cf6a6d", "developer_terms_of_service_url": null, "publisher_name": "Aayush Chaurasia", "support_website_url": null, "website_url": "https://snowturtlegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36651386427809742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_2001321401156420_6444804696526914132_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOsx7N6_leIQ7kNvwFkLQIX&_nc_oc=AdrLplz3H_ZNmtNvXYIOGoHYL3-uqMwsDCYt5Tx1ZUu38uXglNyzq01T1CDdsFqukac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdeNZz2kI9C9PHC79sp7c_zloo4Bw-jB5eLWLJq9359Q&oe=6A709039"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monster Arena VR: Endless Survival", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Arcade", "id": "1592192
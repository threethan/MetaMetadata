d=6e7a0a&_nc_ohc=QNqxLyJHKH8Q7kNvwEh-Eam&_nc_oc=Adr6Hw54kjqQLfGu-NtlQJpR0y0mtXXBV4ggrdMTnXAd0In0icLNfkpF_olFrNDx_gY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM79LxllBRqkSOhd3uSMNhajqjXfE25jCSrnwLpQ0qrXw&oe=6AE36A2A"}, {"file_name": "screen5.png", "id": "1280788079813088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391914_1280788083146421_8991532221476690282_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmKt-ODC62IQ7kNvwHSrcLv&_nc_oc=AdqUHC5JvbNosUkMW47N4Fe131NoPJ5_VGfqGmd4nhszB09eGxLPCWVeihDYbyJejEU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqZKyXWvcV5UZrZVvFKlTwRsJTm7usVRNVf9iGiW489g&oe=6AE34535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape.png", "id": "579249211649137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392105_579249214982470_5407786973267239051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rB47JHhtW3kQ7kNvwHa_LaP&_nc_oc=AdoXvuy7jj_MnCe-0NO4OQmYbfLP4El24EdpN9ShQqwx1tUAC8rW0AQEUAgBmudcBEI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqyvxcwZDxSwWVQL6LVpdqebFpEDsmIcJfo8hwlc3WsQ&oe=6AE341F5"}, "display_name": "Lift Shift Drift", "keywords": ["gliding", "flying", "Challenge", "LSD", "highscore"], "long_description": "# The most thrilling and high-speed VR gliding game\n\n\nSpread your arms, glide through narrow gaps between terrains and obstacles to score big!\n\nExplore endless uncharted realms and feel the ultimate freedom and exhilaration of flight.\n\n{1152277559579439}\n# Experience Unmatched VR Immersion\n\n\nTake full control of the gliding by tilting and spreading your arms. Feel every gust of wind!\n{546401181779274}\n# Easy to Learn, Hard to Master\n\n\nSimple arm movements to start, but limitless techniques to perfect!\n{635752632259829}\n\n\n# High Risk, High Return\n\n\nCloser flights to obstacles mean higher scores, more adrenaline, and bigger thrills!\n\n\n{1334180918008308}\n# Endless Content to Keep You Engaged\n\nUnlock new gear with every mission you complete, bringing fresh challenges to every gliding!\n\n{1363203888420717}\n**Lift into the unknown, Shift through danger, Drift across endless horizons.**\n\nBecome a Rifter today and dive into the **ultimate VR gliding adventure!**\n\n", "short_description": "LiftShiftDrift is a standalone VR game for Meta Quest. Experience high-speed gliding, immersive exploration, and thrilling challenges as you create your own adventure in a stunning wireless VR world!"}]}, "developer_name": "KapeHorn", "developer_privacy_policy_url": "https://www.liftshiftdrift.com/privacy-policy", "developer_terms_of_service_url": "https://www.liftshiftdrift.com/terms-of-service-1", "publisher_name": "KapeHorn", "support_website_url": "https://www.liftshiftdrift.com/faq-1", "website_url": "https://www.liftshiftdrift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8416524891795910"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2463104090778469"}]}, "baseline_offer": {"id": "2463104090778469"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783000500, "status": "PUBLISHED", "id": "2463104090778469"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_
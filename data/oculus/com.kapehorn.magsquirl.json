c_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVEez0ugYspbcnm7VlHUoPYonJVZQFdhPgaFYgWcpbAg&oe=6A997DF9"}, "display_name": "RUNuts", "keywords": ["runuts", "flying", "squirrel", "superpower", "shooting"], "long_description": "# Squirrel Battle starts here!\nRUNuts is a FREE social VR game where squirrels fly into battle with guns and Super Powers.\n\nDownload now to become an OG Glider, play with other Gliders, and join our community at discord.gg/runuts\n{4557783987839300}\n# \ud83c\udf96\ufe0f Prove you're the G.O.A.T.\nGrab a gun, dash, and dominate Power Deathmatch.\n{1081770960992027}\n# \ud83e\uddd9\u200d\u2642\ufe0f Unleash your Super Power\nTake flight, then blast a tornado as Wizard, fire a beam as Squirzilla, or smash as Fist.\n{4476953439215617}\n# \ud83d\udc3f\ufe0f Your squirrel. Your style.\nGentleman, DJ, and more, customize your squirrel and make your look your own.\n{991580720222859}\n# Play during Limited Access\nRUNuts is in Limited Access, open every Friday and Saturday for a limited time.\nJoin Discord.gg/runuts for OG cosmetics, other Gliders to play with, and the latest event news.\n", "short_description": "Hey, are you NUTS?\nThen stop looking. This one's fast, crazy, and totally FREE.\nRUNuts is Squirrel Battle, a chaotic VR shooter where squirrels fly into Power Deathmatch with guns and Super Powers. Fly at full speed, snipe your friends with a railgun, then go full Squirzilla and blow everyone away.\nJoin Discord.gg/runuts to become an OG Glider.\nIt's fast. It's nuts. It's FREE. \ud83d\udc3f\ufe0f"}]}, "developer_name": "KapeHorn", "developer_privacy_policy_url": "https://www.runutsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.runutsvr.com/terms-of-service-1", "publisher_name": "KapeHorn", "support_website_url": "https://www.runutsvr.com/", "website_url": "https://www.runutsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332603592553
60194081_8124188537475757265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSd31ge2f4cQ7kNvwGItS3g&_nc_oc=AdpULFoinBLx9TiGU51sMC1RY7DQUb9vaKMY6l7F7cbElENL-uaBgf67lxpOPk8EZpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQck9Of2pYTcTWsh3Ez34s3WTNbfyDsG_MhXioEglcTA&oe=6AE746EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u1112\u1175\u110b\u1165\u1105\u1169\u110b\u1161\u1110\u1173_\u1109\u1161\u1106\u116e\u1105\u1161\u110b\u1175.png", "id": "1093958949768250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619404_1093958956434916_8291092696725296560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5_iAHKIdb4Q7kNvwE4ZBgi&_nc_oc=AdqEwDzGdpsNif1eDF0FIYQXiNEwMzwTEEJCuSsyi0Hyul4GQfpwlMMTPiZOlK56N0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8leh1Jk8naAbptJj4YdMIBVyPfYYkFg9TXj24QAtDMg&oe=6AE75B64"}, "display_name": "RUNuts", "keywords": ["squirrel", "superpower", "shooting", "hero", "brawl"], "long_description": "# Squirrel Battle starts here!\nRUNuts is a FREE social VR hero shooter where every squirrel Champion brings a different way to battle.\n\nDownload now to become an OG Glider, play with other Gliders, and join our community at discord.gg/runuts\n{4342744412658828}\n# \ud83c\udf96\ufe0f Brawl your way to the TOP\nChoose your Champion, take flight, and battle other Gliders in Brawl Mode\n{1802140701239856}\n# \u2694\ufe0f Every Champion plays different\nDash through enemies as Tetsu, blast a massive beam as Squirzilla, or blow up the battlefield with Rocco\u2019s rocket launcher.\n{1116608280887707}\n# \ud83d\udc3f\ufe0f Your squirrel. Your style.\nGentleman, DJ, and more, customize your squirrel and make your look your own.\n{907198575575070}\n# Play during Limited Access\nRUNuts is in Limited Access, open every Friday and Saturday for a limited time.\nJoin Discord.gg/runuts for OG cosmetics, other Gliders to play with, and the latest event news.", "short_description": "Hey, are you NUTS?\nThen stop looking. This one's crazy, chaotic, and totally FREE.\nRUNuts is a Squirrel Battle, a VR hero shooter where every Champion brings a different way to fight. Dash and slash as Samurai, fire a massive beam as Squirzilla, or blow up others as a Crazy Squirrel in Brawl Mode.\nChoose your Champion, take flight, and make the battlefield yours.\nJoin Discord.gg/runuts to become an OG Glider.\nChoose your Champion. Go NUTS. It's FREE. \ud83d\udc3f\ufe0f"}]}, "developer_name": "KapeHorn", "developer_privacy_policy_url": "https://www.runutsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.runutsvr.com/terms-of-service-1", "publisher_name": "KapeHorn", "support_website_url": "https://www.runutsvr.com/", "website_url": "https://www.runutsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28886953000993132"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628449_2116496912270217_3349031947884082635_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjFZWjL5-hYQ7kNvwGdlpoM&_nc_oc=AdqFJxe6D0eiOJ39wzzRNWpAO3RnChWVI9sJ7zKSI2LB6ey4NR1c_Aqw2arhJpUfTIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=
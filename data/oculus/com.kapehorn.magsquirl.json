d=6e7a0a&_nc_ohc=8AfwLgADlfwQ7kNvwFIgVSC&_nc_oc=AdqINCvfGSwsCGSxgstoGYacFv1DArXd7p4fdnqfkDxfOvAcn9K-dclqC_Bx_MbCJLI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_RPDGG2NAILoQ6PjlDgRp9_df_NrNmDxXcKyYeLQecQ&oe=6AC7BAAA"}, {"file_name": "screen5.png", "id": "1280788079813088", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391914_1280788083146421_8991532221476690282_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keML0-f_JRcQ7kNvwG6_vBt&_nc_oc=AdrsGCEizQcsqozSdcj7DoK53vz29aEW1aTvlLBzUtn6wi5mZCzXsjJ2vs1S1T4bqm4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg7YByn2LXkRtGjQ99WAzYdxA-g3gmGyywVtQ0oXiJmw&oe=6AC7CDF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape.png", "id": "579249211649137", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392105_579249214982470_5407786973267239051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y-gvfeGfVgQ7kNvwENB7_r&_nc_oc=AdqgbbByp0jJ9UjlHVP0t4wGvsScFKhgHLZqzDQyzNV-sKFfXuyhvbDkN8L_q5-0Uug&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO7q4IREBAiufhcNOotPlke9kG4Uz20mT1YwDPWAPlKQ&oe=6AC7CAB5"}, "display_name": "Lift Shift Drift", "keywords": ["gliding", "flying", "Challenge", "LSD", "highscore"], "long_description": "# The most thrilling and high-speed VR gliding game\n\n\nSpread your arms, glide through narrow gaps between terrains and obstacles to score big!\n\nExplore endless uncharted realms and feel the ultimate freedom and exhilaration of flight.\n\n{1152277559579439}\n# Experience Unmatched VR Immersion\n\n\nTake full control of the gliding by tilting and spreading your arms. Feel every gust of wind!\n{546401181779274}\n# Easy to Learn, Hard to Master\n\n\nSimple arm movements to start, but limitless techniques to perfect!\n{635752632259829}\n\n\n# High Risk, High Return\n\n\nCloser flights to obstacles mean higher scores, more adrenaline, and bigger thrills!\n\n\n{1334180918008308}\n# Endless Content to Keep You Engaged\n\nUnlock new gear with every mission you complete, bringing fresh challenges to every gliding!\n\n{1363203888420717}\n**Lift into the unknown, Shift through danger, Drift across endless horizons.**\n\nBecome a Rifter today and dive into the **ultimate VR gliding adventure!**\n\n", "short_description": "LiftShiftDrift is a standalone VR game for Meta Quest. Experience high-speed gliding, immersive exploration, and thrilling challenges as you create your own adventure in a stunning wireless VR world!"}]}, "developer_name": "KapeHorn", "developer_privacy_policy_url": "https://www.liftshiftdrift.com/privacy-policy", "developer_terms_of_service_url": "https://www.liftshiftdrift.com/terms-of-service-1", "publisher_name": "KapeHorn", "support_website_url": "https://www.liftshiftdrift.com/faq-1", "website_url": "https://www.liftshiftdrift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8416524891795910"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2463104090778469"}]}, "baseline_offer": {"id": "2463104090778469"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783000500, "status": "PUBLISHED", "id": "2463104090778469"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_
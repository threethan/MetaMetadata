c_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNwciv3Xr8oQ7kNvwEJiWGQ&_nc_oc=AdrIVIXBHICMm2_0nnedNAbV-zl4brgwQm0nTV_hfVo7DZrntlUtIjd5Lyrg2XYfS9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1YngdlUChvekgP0b_kepRxyOD3e9O9pwne8y8SIV4yA&oe=6A986509"}, {"file_name": "\ub2e8\uccb4 \ube44\ud589.png", "id": "1026877053375072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622214_1026877056708405_4109821379134028169_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkKNjAndWxoQ7kNvwHJW1C5&_nc_oc=Adr2vOSIr6I2qaQ5MY7f_H4hr8Z7_24FhXDp0jCl2cUhZpNLfG0OW5J0Lyw21KI8Hzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoabAkn8VCfhvIYPZa288txMib_QZdZUroHC6dt1boQg&oe=6A986722"}, {"file_name": "\ub9c8\ucf13.png", "id": "819439951223812", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622162_819439954557145_5732776498778503615_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frSXuhyQq78Q7kNvwF6hWMy&_nc_oc=AdogSLfKfVHh8cffnXKMgoRKnfc6aRDIlLbrJXtcXtp3KwG1QPCgg-z3cY8-PntQkjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjD_aQdJiCcBoSJgZSXr_dxmty2L-fOFDCJcjAuj8qZA&oe=6A98638A"}, {"file_name": "\uc704\uc790\ub4dc \ucc9c\ub465.png", "id": "1460340435859184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1460340442525850_7905982143895320089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKYhHbEAM6cQ7kNvwF4S0l2&_nc_oc=AdqRos1M8-z-8JiVH6KiixeJj-5YpJWrSRs4iuwrGE3Am2BFXm9NMvUkDzOW7Nhl3ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJengE80sKnsth5Z6LMZpsUZIrpyr83M0kNXqrLLo4VMw&oe=6A984DEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_16:9.png", "id": "1045358175060687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620316_1045358181727353_894890321135346691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI_MTSSHPkAQ7kNvwGHXRw4&_nc_oc=AdqPeAw_I9yLu0a6B8rvDHlSryJudVFHCKQFMVIqvnsmyvpwI2OG8qE0OmrRB2rSKd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9TIbOabKGFpFGAupHOYitM52POl79GwUPtlxk5GRDKw&oe=6A9864B9"}, "display_name": "RUNuts", "keywords": ["runuts", "flying", "squirrel", "superpower", "shooting"], "long_description": "# Squirrel Battle starts here!\nRUNuts is a FREE social VR game where squirrels fly into battle with guns and Super Powers.\n\nDownload now to become an OG Glider, play with other Gliders, and join our community at discord.gg/runuts\n{4557783987839300}\n# \ud83c\udf96\ufe0f Prove you're the G.O.A.T.\nGrab a gun, dash, and dominate Power Deathmatch.\n{1081770960992027}\n# \ud83e\uddd9\u200d\u2642\ufe0f Unleash your Super Power\nTake flight, then blast a tornado as Wizard, fire a beam as Squirzilla, or smash as Fist.\n{4476953439215617}\n# \ud83d\udc3f\ufe0f Your squirrel. Your style.\nGentleman, DJ, and more, customize your squirrel and make your look your own.\n{991580720222859}\n# Play during Limited Access\nRUNuts is in Limited Access, open every Friday and Saturday for a limited time.\nJoin Discord.gg/runuts for OG cosmetics, other Gliders to play with, and the latest event news.\n", "short_description": "Hey, are you NUTS?\nThen stop looking. This one's fast, crazy, and totally FREE.\nRUNuts is Squirrel Battle, a chaotic VR shooter where squirrels fly into Power Deathmatch with guns and Super Powers. Fly at full speed, snipe your friends with a railgun, then go full Squirzilla and blow everyone away.\nJoin Discord.gg/runuts to become an OG Glider.\nIt's fast. It's nuts. It's FREE. \ud83d\udc3f\ufe0f"}]}, "developer_name": "KapeHorn", "developer_privacy_policy_url": "https://www.runutsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.runutsvr.com/terms-of-service-1", "publisher_name": "KapeHorn", "support_website_url": "https://www.runutsvr.com/", "website_url": "https://www.runutsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332603592553
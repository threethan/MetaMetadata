n4.png", "id": "1295593691590907", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392022_1295593694924240_4941961006665643788_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8qx5v6dPaQQ7kNvwFVHg4Y&_nc_oc=AdpU9VQ1FSIS_6lutI-nybwpBkB9zXetaKFAUeL1TqI4pv-wTlTJ7YvoucJP-HJw3zs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrW8zhAxGg5kLzhWc-pS4u184ax1WDBPWCg9KqcsuLwQ&oe=6A85976A"}, {"file_name": "screen5.png", "id": "1280788079813088", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391914_1280788083146421_8991532221476690282_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sZD6kyTv1UQ7kNvwHwx3Ew&_nc_oc=AdrM_h3MUxHG7fgeUXgPXk7ARtg0F4GjZ4etNr9FSUBkxrVrOekI8_-GIYbvjOjcpGE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVYCq2G7Et7VsmXvjEJFBTCIP04vWDdSpMrsfFDv_vUQ&oe=6A85AAB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape.png", "id": "579249211649137", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392105_579249214982470_5407786973267239051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ym4wuQBqPqMQ7kNvwHkzH-r&_nc_oc=Adqj97e0cIPckfM5ZAN3XkUsvLWPj3_yQnSH-6RnhKOA8Hv8jDVBNKQ8NZO5LB5Op6c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9bbavX5aGcEM3YYjo80r2ZXVDKxaERqXtYnRLrBD4zw&oe=6A85A775"}, "display_name": "Lift Shift Drift", "keywords": ["gliding", "flying", "Challenge", "LSD", "highscore"], "long_description": "# The most thrilling and high-speed VR gliding game\n\n\nSpread your arms, glide through narrow gaps between terrains and obstacles to score big!\n\nExplore endless uncharted realms and feel the ultimate freedom and exhilaration of flight.\n\n{1152277559579439}\n# Experience Unmatched VR Immersion\n\n\nTake full control of the gliding by tilting and spreading your arms. Feel every gust of wind!\n{546401181779274}\n# Easy to Learn, Hard to Master\n\n\nSimple arm movements to start, but limitless techniques to perfect!\n{635752632259829}\n\n\n# High Risk, High Return\n\n\nCloser flights to obstacles mean higher scores, more adrenaline, and bigger thrills!\n\n\n{1334180918008308}\n# Endless Content to Keep You Engaged\n\nUnlock new gear with every mission you complete, bringing fresh challenges to every gliding!\n\n{1363203888420717}\n**Lift into the unknown, Shift through danger, Drift across endless horizons.**\n\nBecome a Rifter today and dive into the **ultimate VR gliding adventure!**\n\n", "short_description": "LiftShiftDrift is a standalone VR game for Meta Quest. Experience high-speed gliding, immersive exploration, and thrilling challenges as you create your own adventure in a stunning wireless VR world!"}]}, "developer_name": "KapeHorn", "developer_privacy_policy_url": "https://www.liftshiftdrift.com/privacy-policy", "developer_terms_of_service_url": "https://www.liftshiftdrift.com/terms-of-service-1", "publisher_name": "KapeHorn", "support_website_url": "https://www.liftshiftdrift.com/faq-1", "website_url": "https://www.liftshiftdrift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8416524891795910"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2463104090778469"}]}, "baseline_offer": {"id": "2463104090778469"}, "is_approved": true, "firstOffer": {"node
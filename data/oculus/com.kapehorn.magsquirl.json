c_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNwciv3Xr8oQ7kNvwEGEGxW&_nc_oc=AdqQDu-Z2vQ0deTGoAbNdolU9ry1bcTOs65Y8cpE-std0lO7L0LLZRTpoLgwOJO_KRU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH7LVHhbsIO5LLjyXtpm55UJoW0XiNXcuH68YDrYVzig&oe=6A974BC9"}, {"file_name": "\ub2e8\uccb4 \ube44\ud589.png", "id": "1026877053375072", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499622214_1026877056708405_4109821379134028169_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkKNjAndWxoQ7kNvwF-Ju_e&_nc_oc=AdpT2BHHNTVe875zJVnRqjm9zasIrkH_3AmRu_coIv_1g9fYv7pHOixeDYmKhnJlWqQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzKOqEIamUSjxlAn2e96xWaMN5Y1VgCnMRoAH9YHyeRQ&oe=6A974DE2"}, {"file_name": "\ub9c8\ucf13.png", "id": "819439951223812", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499622162_819439954557145_5732776498778503615_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsYUaNpubysQ7kNvwGdyGt_&_nc_oc=Ado8HdvvCYkKOEWgc4n_SwTd_EMMOc2m1KwSxuWnFZnV7KDi6K87DcPYQ8hfJFniWJM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHNPUJXaDDq450N3BOfzQrCn9rGv_1vJe5ftxdfq4oSQ&oe=6A974A4A"}, {"file_name": "\uc704\uc790\ub4dc \ucc9c\ub465.png", "id": "1460340435859184", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499622334_1460340442525850_7905982143895320089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKYhHbEAM6cQ7kNvwFTm0hb&_nc_oc=AdqMSzenebIewCeO8rZSuP2N4RFiIQT18yi_d_jx0HUzgw5V4IZbFBMrB9hy1VIAzJY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe5rNoUxE_BnEnwAo-CQXtjaBpzjApHJo7DMd3ZWH_cg&oe=6A9734AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_16:9.png", "id": "1045358175060687", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499620316_1045358181727353_894890321135346691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI_MTSSHPkAQ7kNvwEgclkI&_nc_oc=AdryjyHXiMmhSQ0LmiSNPFmEkCpWRMOC5QpQfQIIoOUXgmy6bLQUG7HAWeVm2ThjlA8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgMr8oRz95JoNRnT7FguXLA7WZbzBRVgFeUSiF7hfW2Q&oe=6A974B79"}, "display_name": "RUNuts", "keywords": ["runuts", "flying", "squirrel", "superpower", "shooting"], "long_description": "# Squirrel Battle starts here!\nRUNuts is a FREE social VR game where squirrels fly into battle with guns and Super Powers.\n\nDownload now to become an OG Glider, play with other Gliders, and join our community at discord.gg/runuts\n{4557783987839300}\n# \ud83c\udf96\ufe0f Prove you're the G.O.A.T.\nGrab a gun, dash, and dominate Power Deathmatch.\n{1081770960992027}\n# \ud83e\uddd9\u200d\u2642\ufe0f Unleash your Super Power\nTake flight, then blast a tornado as Wizard, fire a beam as Squirzilla, or smash as Fist.\n{4476953439215617}\n# \ud83d\udc3f\ufe0f Your squirrel. Your style.\nGentleman, DJ, and more, customize your squirrel and make your look your own.\n{991580720222859}\n# Play during Limited Access\nRUNuts is in Limited Access, open every Friday and Saturday for a limited time.\nJoin Discord.gg/runuts for OG cosmetics, other Gliders to play with, and the latest event news.\n", "short_description": "Hey, are you NUTS?\nThen stop looking. This one's fast, crazy, and totally FREE.\nRUNuts is Squirrel Battle, a chaotic VR shooter where squirrels fly into Power Deathmatch with guns and Super Powers. Fly at full speed, snipe your friends with a railgun, then go full Squirzilla and blow everyone away.\nJoin Discord.gg/runuts to become an OG Glider.\nIt's fast. It's nuts. It's FREE. \ud83d\udc3f\ufe0f"}]}, "developer_name": "KapeHorn", "developer_privacy_policy_url": "https://www.runutsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.runutsvr.com/terms-of-service-1", "publisher_name": "KapeHorn", "support_website_url": "https://www.runutsvr.com/", "website_url": "https://www.runutsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332603592553
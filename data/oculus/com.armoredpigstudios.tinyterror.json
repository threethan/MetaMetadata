3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb0kq11oNgH_jN6KI5mX8vx0kA--p3a5wMj7uqYj-G4w&oe=6AC51493"}, {"file_name": "S2.png", "id": "1325755772480565", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507849536_1325755779147231_423279468677185416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC8hAvbT6-cQ7kNvwHovZ-j&_nc_oc=AdpKBm85wEeV2XWThRrvIWUAzC03SB9Zi48y7ogTiuNaIGoz7JsDc3hPJI9yrz7Fwe8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIWD4iIl0n41-p8xj0hb-P-dkKTqSuJNY-OdO6K87IHw&oe=6AC50F8E"}, {"file_name": "S4.png", "id": "2215013775955202", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310720_2215013779288535_1775149802210714050_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bd9gJQafiywQ7kNvwECMz1r&_nc_oc=AdpdhPZctg3YR7V7L1wSoA-c_ARLEeZmH5QzQhO-y3lzInhNVmP_lYxZMgosfZljYjE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpY1w9oI9HEFraeO93cjNSSOsblzioUuudmm-N7TSXug&oe=6AC51B95"}, {"file_name": "S5.png", "id": "1325505029778890", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310646_1325505036445556_2522120010180264878_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eClecVolDSAQ7kNvwGbTRMp&_nc_oc=AdpTBUls1j2cQQgXDwXvib2EaN8KA_RY6I2BlEhBqP1hYqDyK0k-UT0RiGAip92wpAE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbDtOmLVEy2pD1bPr2-JMYnQwlJsLq_5pcbO_wTKsnJw&oe=6AC50F53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiny Terror VR", "keywords": ["funny", "chaos", "baby", "infant"], "long_description": "**You are a baby. They are not ready for you.**\n\nAre you ready for the most unhinged experience on the market? Tiny Terror puts you in the booties of an Infant and sends you into a world that absolutely deserves what's coming to it.\n\n{1003344189112036}\n\n**FEEL EVERY HIT**\n\nEvery punch, every grab, every ragdoll body flying across the room is driven by real physics. Pick up enemies. Throw them. Use one enemy to hit another enemy. \n\n{1580340676988003}\n\n**GUNS. LOTS OF GUNS.**\n\nDual wield. Reload like you mean it. Shoot while holding a dude you're also using as a shield. The gunplay is tight, the enemies bleed, and nobody is checking to see if you have a license for any of this.\n\n{2072134887018579}\n\n**THEY COME IN WAVES. YOU COME IN RAGE.**\n\nZombies didn't expect a baby. That's their fault. Survive endless hordes, watch satisfying ragdoll deaths, and listen to enemies scream things that will make you feel genuinely bad about yourself. \n\n\n**Features**\n\nFull physics-based melee:   grab, throw, swing, and improvise\n\nResponsive gunplay:  reload, recoil, and deeply satisfying headshots\n\nRagdoll enemies with hit reactions, blood, and the dignity of no dignity\n\nZombie horde mode for when you just need to turn your brain off\n\nSandbox carnage.\n\n**No babies were harmed in the making of this game.**", "short_description": "Tiny Terror is a physics-driven VR carnage simulator where you beat, shoot, and ragdoll your way through endless waves of enemies using your bare hands, improvised weapons, and absolutely zero restraint. It's the most fun you'll have being a menace since you were actually a baby."}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
yUI2&_nc_oc=AdpccZl3D-hz1RO-D1lP3klemhuE8yS0CRzRgQR3pI-pe5Nt8ciYcveUXbehmJdb1bA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3VDFEzMVQwzqIIC6Xt6rbYs8nz3BBJ3wS2nOS5aiZeQ&oe=6AB14A54"}, {"file_name": "02-mountain-rest.png", "id": "1380108954106736", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823940_1380108957440069_1300746563056219140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3IZiQwFwlIQ7kNvwHPYCAw&_nc_oc=Adq0YiP5T-5btL8l-_J_XTBH6u10e3cF5oSoRcwDGdCnCc_5INl_BSShNEjvJkk_Jws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_h2U-PM4zcpahnJ26rlfagBUc8CZ4OdIRakQhOQi8UQ&oe=6AB15B43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1391116969181455", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_1391116972514788_7962006792967367819_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THfkvohtLLsQ7kNvwGpQWod&_nc_oc=AdrK2yhSLLvrzfdXO9di8xZ5GeIT49DCeQ3BP6fqTShnrjIDauPWVgtwbVASs2oBKBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFnWAjHUGw9asHWkSNiII2Yo2OLsth_Hz5zi-_9-KBDg&oe=6AB12A10"}, "display_name": "Pranayama & Meditation VR", "keywords": [], "long_description": "Make time for your breath.\n\nPranayama & Meditation VR brings breathing practice, guided meditation, and quiet sitting to Meta Quest 3 and Quest 3S.\n\nBUDDHA SANCTUARY\nSit beside a golden Buddha beneath an open sky. Follow turquoise light on inhale and golden light on exhale, or enjoy quiet sitting and a changing day and night atmosphere.\n\nZEN GARDEN\nFollow visual breathing cues among trees, moss, and patterned sand. Balance stones with physics and play harmonic singing bowls.\n\nSANCTUARY MIXED REALITY\nStay seated in your room with a floating breath orb, light motes, mist, and optional celestial effects. A compatible room scan enables wall and ceiling effects; a floor-only fallback is available.\n\nChoose gentle even breathing, soft exhale, three-part, ocean, humming, and optional structured patterns including alternate-nostril attention, box breathing, and 4\u20137\u20138. Visuals follow preset timing; the app does not measure your breath.\n\nFor entertainment and personal relaxation, not medical advice or treatment. Breathe comfortably without forcing. Stop if uncomfortable or dizzy. Breath holds are optional. Use MR seated in a clear, safe space.", "short_description": "Follow gentle breathing light, settle into meditation, and explore a Buddha sanctuary, an interactive Zen garden, and seated mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pranayama-meditation-vr.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Akindquest3", "support_website_url": "https://pranayama-meditation-vr.vercel.app/support.html", "website_url": "https://pranayama-meditation-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1219308577943497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1554540903020605_2208379796540240403_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_07SerDPfYQ7kNvwGqW_N1&_nc_oc=Adr0VenidbjaKnHPxxkJI7zTzmOXdx_uGnpU0fP7pxO_-7hRnFuJutdgWW6GIP6HgNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK62YEam1mCY_fvAA
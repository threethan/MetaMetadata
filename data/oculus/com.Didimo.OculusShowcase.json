0WbuJ&_nc_oc=Adqd6bkxpY4Bjiayfgz-n0TG1gLgKWAz_qRrjY4gZmn_rlqNTcbvIE71PxQi_zI5OYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjKU4Z2CSCx_rIy44BobN05fnMDleideCVLllthI7wIg&oe=6A4BC519"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kdmUfYQH5IQ7kNvwH46A0r&_nc_oc=Adr-jbyktl8RRWyYrbz1jUy6de8TndDYz1xJpr5JWeCmZ26xuVgcFKgU05CFL_or9P4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjZVaOShbZu3UrRvx8s9omKpOncbq4DyySnOZsgpLh8g&oe=6A4BB8D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC4fT8WYDdsQ7kNvwG826Eg&_nc_oc=AdrrOR7i31_3oYIxqdK5Olr4zmS3zlCQE7iQ7R33OOxTBbC4PB2mNMr88ljaGWDAUSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATXRjoxFsFjzZa_XAZ4BPj1VR3EHT6zdlbN-vNmGuIuA&oe=6A4B9EB5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hbLby53RSIQ7kNvwEOWaBh&_nc_oc=AdqJEYrpgQLm3OMmkpN8y88XBjrq9omyUCDfiWplrpEOqr3BCGtQC6s4xikAdTR2zHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB4hgcT3D-SjDjDGijlTNqNqIqGgNbNj2gZW7MQSDBxQ&oe=6A4BA376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PPYmVDcO0MQ7kNvwHDqP89&_nc_oc=Adr1OX4cmIcj5INTjrE4v-e0rvfm6EE-_K8u63TG7xKuJX1Zo_h2Y0jXsF9Cw1voqsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRP3u8hsASMly7Nr-m6a1Q45khLWvYF9h83CEGAyQq9w&oe=6A4BADBB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
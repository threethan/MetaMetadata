2pERU&_nc_oc=AdoG5Rx-d6N5uXCzhJ7qzndCU4zRuK8toSBZ1iXcwJnc8hoYg53RhmXZZkp0dFuu8KY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gjDtqBpqnJ4mgvbO5VKHc2wG7sCs-qosgebd9sPzh2w&oe=6A3D4499"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9_0ToSmbm0Q7kNvwEzbt9i&_nc_oc=AdouJFhR0DJj2MpWj2sVYV3EEYl8A_jydkTNennJQXyJDvejjUNMN4NEhz9t60kluTc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IxFUVlMlZ3Gk7mnGmlrMrcpVDGX7elfKBjUZGdF2teg&oe=6A3D3859"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkRm1KEBI8YQ7kNvwE7ClLV&_nc_oc=AdrlgKFzUNTqiaaHotngwXDc2Ektmjp9V4gZnldK6plEIc63wsb6yWuBaripAGz4I2c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nHrczKKU8xBn9IYSA4s7tAV60AssD-U07arWiThHjMA&oe=6A3D5675"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlPDgn3vnX0Q7kNvwHHEprT&_nc_oc=Adru12kB0AJX725RvpbDwT5dFzibSNxJpsdgV3h3cOIXdbe38pT4UDFflXhcvpQc6Gw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eq0uTmMfubN-5Nuty2qK5IL0OQkjGV5l19WZmdsbpew&oe=6A3D5B36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4QoqNkJYOwQ7kNvwEdbmiU&_nc_oc=AdrpSP6dHvV7ooyqet_JXFYcg5_kYCY0k0fcEbgr_ptWkPyCHTv05uznYJ2BL0kKSIo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ejU0-X0OQ9099KcShIT3T5ecWDk6toB2MPnFLWi76kA&oe=6A3D2D3B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
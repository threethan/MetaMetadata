jhvyR&_nc_oc=AdpNEfvcVlqzxpu8oKQasFFZo7-0pjLgswo2oVzhoPlXe_24ghH_ympH9JNVlzE-EWE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe0dT1638Lpzue4sO0XfnCWXisMRetn1WioQHVZEcnXw&oe=6A819A59"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0F-7OoEnP0Q7kNvwHC0Ulc&_nc_oc=AdrnPdciSYAnhrxVzXepX48V6YZ_5y8uPis1XXQ6yqqmoTsyZC3xRN43QhP11XwDneE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4-Xh6fXPZgolQmQceeva9fFF2OTa4MdFhWqenCWCIgQ&oe=6A81C659"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKtckEmzLqwQ7kNvwGaTbRt&_nc_oc=AdqqaWmNStnMEwAJN2VqFe7eN40Gxlhfd94_ivyopFZUuO6T0lCmrF-GiXcwcdP5Wqk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr6KDp8q_rK4FYNC_II3qRTdvSyWH1xJKbV9EqcjX8OQ&oe=6A81AC35"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4ycaV6wuwkQ7kNvwGlkeEr&_nc_oc=AdqkcrZqIj8fghQb7TAfZLYi3hWDfPs9gJgf23fSbK8xf6KqetUohH7XNrj-yl_k2W4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ2ZN6TBgopQmKiDtHjrlZZW9NNv97QFqmF_JBtZpPTA&oe=6A81B0F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGP2RXmdsxMQ7kNvwHmnfsK&_nc_oc=AdoBcBJCumqh86I8kXRunt21mD9Sv1oPrprVEhaF5hVlvuBElp-srFsXdLI0_tMsi-Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtREzKCbjs9U-mE-MhW-baOe9CNvcwvRfpsSqdAUNFmA&oe=6A81BB3B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
Z8yox&_nc_oc=AdoiYdB7L_v-qMrxPdXE1xMhLnezOibrMX4d_ncB-z1bbLI2m6ESeFGDanBZIMnoiow&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC753X1BC91BsFI0iPUcnUVnlQaEje2kvKzm-PTZzIhKQ&oe=6A54FF99"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnUd7pkvf1UQ7kNvwHoev8v&_nc_oc=AdppKb_I2x1FzEwnl1OfqnT6bZa_yraGIHpUa0VUG-8kikPwECCFygQ_ZKjbXMEbrA8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZXyC-8cuVGmrAJIezuEA0LDkWgrceR43BaGCCt6F0gA&oe=6A54F359"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mosPrSu1m_cQ7kNvwGwSozn&_nc_oc=AdoFVJ72mpXOMRVW_xfQ5hNHyLeaSneAmRJKo0KOuqLAN-ORrVxHXp3DXMHxCbRzzag&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_tRkCW3o2Y6M2EmVz8CgoPkw2z2wDI1YYkqshsHpaCg&oe=6A54D935"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtxQ05-Jd8MQ7kNvwHJ9u9N&_nc_oc=Adqh7Flv_5ZNVhYz_VUGsIGX_mgSUN45-GgqFc-RPtkmQA0H8KtVOknh2VfNdsmBT8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVp2EuqHCd-WPjBV0-p-paRIwS_e7CkNM1OPtNr_sXqQ&oe=6A54DDF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCv3-BBPPmoQ7kNvwHMA9Ty&_nc_oc=AdrEjYcxL0fXPS5O2R2aBSjOY3KfhnbEAadvxei5-c2RKfhwdY_-mFxgOcaFlMGI1OY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwFrO-VfNznuPBxRt63ypeAjZpRVinnZyo-AvuF7qvxg&oe=6A54E83B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
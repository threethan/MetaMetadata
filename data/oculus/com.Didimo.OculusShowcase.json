kd3gG&_nc_oc=AdrUO4MTYmxFBX4_oMnI7L6HlUNodwvaUx09aZapJzHsNIPumwC2t5SQLXGqQ8XagFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiePE5LRrlYuK1NbspeB0TwMdMIxylTIaCgc6zgJ4EUg&oe=6A9D8219"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULcNJXZoMTIQ7kNvwGyLdz6&_nc_oc=Adocd69a2690f1bgT2I6kDUyEPqghZHfX3AO2S_ainBp7mupBf5_YxVCnnimoReuHt4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEqQzJcI4OdwUT2kMp4Y4bHW5pqLs8dwsQ8o8-7WlxEA&oe=6A9D75D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AntY_zDsM7UQ7kNvwH7gbf3&_nc_oc=AdruDE3rVx2P401kDRqjTExs0xQft5x3eYAX6GaG1uMCkusgJg80gDzyEoeLYgnZ8RA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy0n4zHU2yxftLRV2mBtWl9LULAtiBX8xa4jrWbuc_Gw&oe=6A9D5BB5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hAjGWArlc8Q7kNvwHcKvbW&_nc_oc=AdomlNgHdMkXftyoTGdERtjXAeEd_yR-P3vXEl7nlWIglEhFnz5fSfbqGumUpg39S9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRiLiMx8Z1OG7JeoDRjvB8n-EdQUFenL6g70OldxvS3Q&oe=6A9D6076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwe5NE-6B0wQ7kNvwF4z5Hn&_nc_oc=Adpx1EyyyQUrltw-2VK3MqnGBxbezQkTx33OwfkpJ6q7yPMprNJrDP5jePBKM_nc8oM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJijphbq6NtG6VXlGYxOxwDuuARip5pel-vGYnNZgO_UA&oe=6A9D6ABB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
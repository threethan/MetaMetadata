fEii2&_nc_oc=AdrXKnSoxCNMETyernyUDltBwInYFHLxLQcjvgtYAB0bwK1YX6b2bKT76x6-ABb7yAU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ1EaRpknDJF9xduHVXWButsxVaEJsTi9llOzTjH2X4w&oe=69CBAB59"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwoxoR7anB0Q7kNvwE6roIK&_nc_oc=Adq5ECIpzSFzImRtWp4GwBhOVvC6J1oKrPbJ4GIXOiue1w0CryHM-hECxN9TvY-_na4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTE2fu_7S-06xtrmo8ZfBGe4YoqojpRH618vWziaPwvw&oe=69CBD759"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8V-tM1_jbgQ7kNvwFX6iEb&_nc_oc=AdqHrGXSary1ueLCDBN8ICCBnvGLbGz_ivFS7YV-gO2rMNUs-66IIsDgLF6O40r2dcE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwivD8CfxlgjYy05XkWYCLPlNpzE4sLV0jkrZRhJjRWgQ&oe=69CBBD35"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9i72IT6hAMQ7kNvwFjdK8b&_nc_oc=Adpkuz28bie9foMqJmrdJ8jvLNsCAmh8LHyoOj2BtUUkBcEiIvffWS00DUVRrlEw8Fo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxATOO64Xe0WZ0oyNmrL8cCn9BpHTCFl1iE0i8f2VIRGg&oe=69CBC1F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOM6Pi6lYiAQ7kNvwE9Vfw5&_nc_oc=Adpwu0WblLBwDOLAYe1f2aEAtFGrXJYDZNNc42sNcQx4AG40eBokk_cuKL_5UgtJWZY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgW-akkJHSrTNycBYL-m6zJZGF59gbj3CpAxFPgm6ZEg&oe=69CBCC3B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
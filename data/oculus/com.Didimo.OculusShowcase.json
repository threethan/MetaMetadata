hNScC&_nc_oc=Adog3zo6CGw9RDWdJsPyvVUnaRGydIqQw_H7fduiC4bpBNh_pARyxdJekiaOil5VN8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80iWobVC8Dtv0PFBnpv3aKHASZcuaRzbqvva03bSBe8A&oe=6A301599"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7S9QkbE-lQQ7kNvwGaxwLL&_nc_oc=AdrlmO7g31Ag9px5JUcxGMq5kE6MVEtu0AJso3xMg_gXWSSkaOicI9gtLLhW0RT1VhA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bJ2MfF4oS2k3QQ0-V0iQljBQ1l9Yik42f9h6wtMGa4g&oe=6A300959"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9djpVx8Ym9gQ7kNvwFyu5Gw&_nc_oc=AdouAuUPpmbjnRPLdCvs9VeWOifCDSGrJCMHIZvNa35MHT5OK37vjRw2Cq0qNjtS6ho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QfB_Hd0tAI_OoVBIR2U7HXP38mqi659Uu0jfj1lyCOg&oe=6A302775"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPnJsTXfnjUQ7kNvwEl1DXs&_nc_oc=AdohqWwee1Ps9C26tO36E5I0MBbqfEukEcYXYFRwewLnDoNLtuoIryo52sUW-RuqdpM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89L9kLXxo18gv4y1LbdBctOjcNemMWyZ3rTYorLxSXIQ&oe=6A2FF3F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK2pQ3hD0CoQ7kNvwHEj_Qg&_nc_oc=Adp_N_ucZAQWLFtae1G82nzjmuYhkn4TBrecfP5Zl95EK2OlYzszPoycxZn3qQHkb60&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CFZyL6iwrHQCgkA2ELjsOSWwJ2ZL5ENfoONM7qGxm9w&oe=6A2FFE3B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
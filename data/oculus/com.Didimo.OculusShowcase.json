_EDvN&_nc_oc=AdqwR-hs5Sr-HYA7cpVC_iWs85aUikyePCUsAyfADv9XJqVj4PeXBmI4Pr4WmVfCubg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg5QiR-4Trq3xxG7D7ursGsjHEVatWzOy0k5Lx5n-Ksg&oe=6A983C19"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2DeXTfGPjcQ7kNvwEXBbO1&_nc_oc=Ado-iFDReZe2pQCmZWCpGePrdBEizO9nDl0znSxmNV9Qxgua4BN3oEr_J-Tg0qaSF0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFXV8FTHBDgwlq3bmGcpGpexvvKNuqPB1Ds_ykzVgONg&oe=6A986819"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thvK4Qnt3CQQ7kNvwGwzjpG&_nc_oc=Ado_D-mE3QaaoJv_JJ4Ens-H5vHprQQBxRLtK7Z3BLzyeCTZOfxBXZkeLi_Oxfc8P6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4ct2g_7z9FEjslYkOSkQsZhjdEYVM4MvHgNmEcjY2aQ&oe=6A984DF5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgh0T8bdc9kQ7kNvwG-YYlD&_nc_oc=AdppeEWBIYHJRwgKBCQFhkx0YWf0Cb6F64jrwN1jGRB3TRueo8ea83gyAlw8whkaTy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4JFXE0DL_-bU1IYSpva50DdNE6SHPkYOPS5sEPlZR2g&oe=6A9852B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXQ2dCnAmaEQ7kNvwE6waut&_nc_oc=Adpf2MDZJxvRGLXvWhYsuNjL0he9llZjP_4VLHpU_Gjn100I5EArnWzsXTlSXMX1kxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdzhn2TYO8rYdEFG5P9oBSWn85P-6U16dZpYEKhQY88Q&oe=6A985CFB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
0Ej6e&_nc_oc=AdpRXZmo9BQPPMGQ6TuaIrr0_2Evkski4saq8dhEkx8cTNyLb69D8cpCS-o6l1pkXgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WK9Yb7g95r94TdC_YxCG_ntYngB-bzRtTEP09GnK_MQ&oe=69FB5999"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsWY_dSTGt8Q7kNvwG_vagF&_nc_oc=AdrIZVov4eKBu5v5NkmDa0Y7x9Zy3mVrPhENMntbv9WIdpcWmzUnMgS-CzAnoNs0XoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vB_W5vG3dZZ3jmLiD7UGaI9TZDBlfVzEnevowUaNLjQ&oe=69FB4D59"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBwYj-Kr0ZcQ7kNvwFQ_bfi&_nc_oc=Adpo_joKtkg---wxUzz-J8ZS5D9x7RBU03ihweErDdXPyd58pNye2nda1-C-JWSe9QM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N4dBqv1ifZlJ_jkPm_7SsHX1FTc5CX0f9s0AIkfntbw&oe=69FB3335"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPGyccE-onsQ7kNvwHIKvmP&_nc_oc=AdqkpnyealT_pq_KF_mS-gxuEZ2kb-_gVYQqqQopWROcMAgQnON_XmYQ3EtBgIeOAWM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Prk1pcIMnLJhJUC7C2a9sVNGBV7bm6Qd1eY76vXhRig&oe=69FB37F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdwuNfwRZloQ7kNvwH4qAca&_nc_oc=AdoHt0BqrTnT9_RNMViRihzeaKVpllYDSrFVfK4-jelo_wdnOVYd6QOqUQzRIKn4vDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JFC-rxaVV5ZJTxpM_MkfW5jC_aNjKGb8k3HGcmChqHQ&oe=69FB423B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
JFv6f&_nc_oc=AdrDcOSX6zVcxbe__7IO0keFv_03HcXPPqy0z_HFp6BykiBwAF0OQVxtEgWWG0l61XQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EILBCceM-Ma7VJMghuRq-maSgoAtH91Q8KaLPIR3Ydw&oe=69E36659"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjrPfYDN5AQQ7kNvwFgGg0h&_nc_oc=AdocA4ijoKLyPVB2e-XkOxTKovMTFNMTOIVLgdx3fb3ap80FsM-FdS26Qe3MqAN_Jew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yK0YQDzQtRB0gV_dIi3GBN84gft8Ensj-uHvUtbMtGg&oe=69E39259"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAjxBTpG9bwQ7kNvwFu9-5C&_nc_oc=AdoiEvRPlU7A1qS4wfb_IaMJkAm9Sw-QuI-agGRby368rQIilL1Raa2MaZ7RlEV8OMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OwT-Y47O07R6-uuf01EybB7JxaXb3iPE4mX2L8tByKA&oe=69E37835"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4GlGRt2AhwQ7kNvwGM9FnP&_nc_oc=AdrdLKheZTTdMqqIjo_Ff5eaE56mxhKCayHwsEigL4G3cNxfWulCaYBi4ha5ZP-FuIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IBUuYhmZkmWjyFGQyC7renaIhCfwMSxM47kPJdT2-KQ&oe=69E37CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF11mTGfVsgQ7kNvwFGjRja&_nc_oc=Adonbd9mzwQnGCpuWF24SA-IhifqOr74lgEgMu4kr54zAcf5U-oZ1YsobmYJEGUKJMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MpY2FtB4IjsiEK5xLp2fUwROjmULIO-7q051MbZEKnQ&oe=69E3873B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
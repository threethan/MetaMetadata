sQDkJ&_nc_oc=AdpWGvq3CUUIXIHEvgEokiMUeEqbAQfbBnRYWevY-LAfAJ9CN73b-Si_eJcb5hNCKYM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAU5CznOYQ57fGoT8WTNWJ5pFzbb3PISqG0nj_6SP0MQ&oe=6A9ADF19"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2DeXTfGPjcQ7kNvwE67X5d&_nc_oc=AdqpTF6csjNd1b37UzeV3n2IjMgBs5JVid1x-uQ-tgcvEMhT-QkOyeysif3FOtA185Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxVA7iVBbHSxHMG8MQnBEbQHfQY8ky7_urmb4fMnCFCw&oe=6A9AD2D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thvK4Qnt3CQQ7kNvwE5Joah&_nc_oc=AdpyRUkH0sonwpa8F-tEd6H7WsYhLVJM5pX6egFPRMJXgVJOzvuRbeyQ2bcU1fINuFQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7EaJg4oqAdHQStIUnJGc8lzKVHpoEDa9L1Geph6vyww&oe=6A9AF0F5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgh0T8bdc9kQ7kNvwGc4tob&_nc_oc=Ado9m8F7H9Vl_6ygbBzHzb5UeKp5BFAAeBoGzpjuSZc8jW18tikUMJd9cfz5yeGoZQo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCiFLrzuvWcigcZb34utOU2tX2IcYas86mwOgZUzGisA&oe=6A9AF5B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwe5NE-6B0wQ7kNvwE7bwzS&_nc_oc=AdoUGuYIiSSO8RKT4SS2fFS6AvLkFl7cMcdhMGqVZ8eYFExBijTi7GiaDhb5uqlddEA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhzpr9Riw1RBi639KCfatgdQuKtvAYt_IN0ysgPjsRww&oe=6A9AC7BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
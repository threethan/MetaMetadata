fLxih&_nc_oc=Adrt6efzcdHGK5KFZEAg2wnFisIPjtsup5lo9f6VuGOm1kXPCYl7BX65R_lsll4g_BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oVu0kAwiMSr9pZOVkx-iZE0WsJFd3vF8EUjpEK8S8ow&oe=69EDF259"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qk1CPE6ZhWMQ7kNvwEZG5A5&_nc_oc=AdqI3JliCOzLZsh4pmyJ3DFQ7GQuch5-ynvuptGgd3g_fvXqpQyv_xduhzTd16yDg_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YsP-ROkcw_6ySCnuOgKarGPxZzSgYjktQ796bVHQZeg&oe=69EE1E59"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r3QW4JJNTEQ7kNvwEmTIaQ&_nc_oc=Ador__odcJKDlWS9mnVoAO7ucoscVqdDhQm9ofHTCHA2gAx3LfIbYwdXwerl4PgZv8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P5qWD9Ebh4UpZNZ5CU2mp4GgclmUnaB3KWcupLfBmYQ&oe=69EE0435"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKbjVgl8_FUQ7kNvwFzYKKS&_nc_oc=Ado9p6mJOycaye-TcLPLismqNAX40LIJfHZ-2Mp7iwW8pYGiPeGEewJnVpL5GeirmQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T9sukIEwsyKvCPQ2aBvL3HMXc5xZwMTFEU2-3GCugag&oe=69EE08F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IV_PZK3UU1MQ7kNvwFL6Ed1&_nc_oc=AdoDsm-2U6DFfPhp_3CNZceHmOFxcJmfwjcujP3KnqXN-t2vqrGzmzioKzri5ubPJcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12kIHWxLI1APCWNDxqC8Wv_BZuuYBGAZhxrCa-6ylTsw&oe=69EE133B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
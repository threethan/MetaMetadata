jbTo_&_nc_oc=Ado-kTA-g0-oMa52BGzWcLadWc_1joB1TyfQ1S5as7WCzQsIr4zPksBIbixjgJY-Ph4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylUdIYVR8lAUq4ppI9q4D1kAvO30ueeNe8FzkAdpAQfA&oe=69CF9FD9"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJpTmwyYQd4Q7kNvwE8LV4E&_nc_oc=AdoMPRVcQJ6oWMR4jCD8LBfzCjFZaEEt3SX0ykdrUQoYsCyfH_n7BeNactNhIvuphX8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx27xXHuVXIXW2sU5lRUVs9X6cyeJX5m4VUjesdiVJ3HA&oe=69CFCBD9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPEKwP--PloQ7kNvwHCBCSo&_nc_oc=AdpNLDvC3dlzTZiQM-dhaffTFrEn2OuRHxFuK2RVmGe0RQol3C-uUQLkVYq3miDYHog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRh84R99DuQOtagrSQLXUi8AaC2SD4Dg1ytnwZlNnpXg&oe=69CFB1B5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa300Gl38-AQ7kNvwFmD16m&_nc_oc=AdqGGLsWP8HlRtnEv0NxoZf42cuDkYMfBiWES0Pj-1gwZyzKvbmM9yPxMyOXNkyn2sQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzx62Cq5FpyAp0OgiF-AKUBqwULf0gX6RmoTpLUrZay5A&oe=69CFB676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz1p9nEb8bcQ7kNvwHkGwWr&_nc_oc=Adq0m7k5IDxxXt-h82m76evoFRnnpFawaJ32nIH6o4VYNioJfqwze4mDVEud__z_fE4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzln8wOwJ7HcbevIbM7FHuQvhuc3jdvTW9DgHF9P6glyA&oe=69CFC0BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
scdn.com&_nc_ss=7f20f&oh=00_Af8xf6TF7RhtQkF26rwljA0Oo4WRVGxF7YB59EDEnw7QmA&oe=6A3943D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12TvdHoVyvQQ7kNvwG44gUO&_nc_oc=AdoHkNOGVhhpPSA2JSDT4qz8Zy7khOYjSLvWwf2Cj7kqJnOFiborw0wgKDFfIsCOwpU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pb16oMJzqfwBNmqKCYiJmJDw2SrexbPToUk3WaIG8Mw&oe=6A3961F5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNXuQwx5kX4Q7kNvwHwvsTA&_nc_oc=Adq-DzHk_zP7gsoewSFdPa2XT6XCvs23YZP6Uguf1K0wR6MTX3d30GREqEf00Q45gz0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kV1ToWXeuPh747cahMiqyGGSW04Fa6Ni3NzbfNwzQEA&oe=6A392E76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlKiqrR_BXwQ7kNvwG0cUaJ&_nc_oc=AdpE2iaOxgV5MMi7F-A5ilqSez-7Zahk2VTDa-wez77vi7KXDRzlETjwrV4_oj3tjM4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YazGxB3IzuLXEeiRndXC95rCumAC2SNTYKwvsODWdXg&oe=6A3938BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "717215566374890"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2646473372325342"}]}, "baseline_offer": {"id": "2646473372325342"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1641340800, "status": "PUBLISHED", "id": "2646473372325342"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "48135192
rgZ1u&_nc_oc=Adrtc3l5jRo6LCELM-YMSO6f9eJxgYe-8q5Mk7aUBLlYx2Coj7G97wuhAWFF_SZwRBw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DLqiXiyq3rEcYBsCT7Uheh4Naef46j52CqSng7cDO9A&oe=6A0C7D19"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB_H-j7GKjEQ7kNvwEa5_hN&_nc_oc=AdpTR-enzzD2Y39n-Ipj1w036mJ_wNpmtK1RBWIkAFqWYJ9l7i0IUR2VDywgxZWae8o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WVBk61rtBUOs_ajuebpGGsakb1a1_h7Jad1gHqe-_TQ&oe=6A0C70D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvVdI1wdYqoQ7kNvwFclVUE&_nc_oc=AdqyAP6Yu9EpWSJCioSUflirn3NMmJhRwvisKhKQ-omQb_hhcIZRKR-lCw3WLq3Z7YE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nbRh2q9HHhI55yApPagNYy6bRxzJmToNHvuStBW8Ohw&oe=6A0C56B5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gd_mHLXqAdcQ7kNvwH_lhF9&_nc_oc=AdpdqCQnttslKKTjrfo4E0MiviQVAhEREu1cKLN6oIfgTLD796dgu0vxnMc8gdBkLHs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x3pBDQhcEHuTi2Dxa14QxjK6E0k3O-nN18LtzCuhDew&oe=6A0C5B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxZk5stGFqgQ7kNvwFTYfQx&_nc_oc=Adomw8LWGMBVRCGMsDr5y6QPodpLvKqDzH09L5IBOY6WBxPDZ_U9B0ZOSJxpcQeSICk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5suMIxlWGBXwKtm4DLNqJWm877zEmaQjygnLEEykXO3A&oe=6A0C65BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
0Q-4N&_nc_oc=AdrT8ZdalaVpvZTCIS-anJ5OnRXRTdG-Lgf8PwvKgcqY6j-tpBUUoXdptRKTH_kda4s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fal-sgd9_gogefLBjX7GDRI2OVFun1anX1k1t1l8N7g&oe=6A219519"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiwUz-HAQ-4Q7kNvwGaQoFa&_nc_oc=AdpVXX9WNpOeE3IVpAlh_UmkxI3nwgOVdw7VwcTC6bkUIjFN_OkE0_TJHbGBw2pll8Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9acb3U1WmxtV2kZtPA70_afQbWxx0ZIXBMP_fbvNyGlQ&oe=6A2188D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKjEsObVYgcQ7kNvwFRgQ-a&_nc_oc=AdoJALqWywUlaiKSPCZ_YDaK_NLp2skTF7Otr5oUx9FR0L4R5Z94c5a4DmE6lkGozgQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hRQq6I0P15wbHmHPbU8Bbwkg9dw9dw1dxAGh2VRpAPg&oe=6A21A6F5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQGpEJ8kO_cQ7kNvwHHA3wP&_nc_oc=Adq8Q-rW0jmikunc6beYqxtkC0yA3dgBbWcKrPSixcn-V6xYMtBYId9E8xWPVQxdpwo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cUp_K2GWg9tIojlH2eqJ1ilWsLLrJKTc7UnWXRsyAbw&oe=6A217376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN9XSgNI1NoQ7kNvwEnBIdX&_nc_oc=AdpZo0rTn5kAEC3mkMBXzJdhUY979Cmd9HXfuGV0mYZrknMIFw7alvxrspeNIkrN1KE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7BHelUuetFOfhLdufZDO2oivPl62jjhC69EOQLRlwkg&oe=6A217DBB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
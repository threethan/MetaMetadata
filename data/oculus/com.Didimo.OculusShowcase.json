-Vp9z&_nc_oc=AdrOZBnHIcJjP77KVcHqWeCn2kCZD8dlMgraj23tD9FG1CuDr2zPJRpzw96kTLK22Eo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2w8mFfaLn4gR9T_fMm1evvR3BYzhp2REHAocjrc5IVw&oe=69CCFCD9"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwoxoR7anB0Q7kNvwGmAvkK&_nc_oc=AdotwV3NFAD4t4Q6nXYvBKoRWnQmfcKqdq107W92nHnRbk0cj7X8Cg-VbubFke2b6yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysddBK34Mi2J6vAKtP9Z2GxURnQRflrVHXoQ-ymfEj8g&oe=69CD28D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8V-tM1_jbgQ7kNvwGGepnn&_nc_oc=AdrZ4XD8KWFMVBL4B6SH-2sUQsjZ7OAsa3OOYE9r-cml_JTPxD4gIW7X56HaaxnW9QA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkGE7LyD73MG-CthUNJ27kQ0G5VmHwdJCttUk5-HHTBw&oe=69CD0EB5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9i72IT6hAMQ7kNvwEfFxiU&_nc_oc=AdqJ8PCS6HefDviHe8Bj9EtkA6EHGhlFQlzusnpdhizIHKVQEVp4jcCrfQqUJ_OtlKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzP5X5oCX15ZuAHop2c770zYh00cLvAROg9FGY02jAiw&oe=69CD1376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz1p9nEb8bcQ7kNvwHZKMy_&_nc_oc=AdrBtEeISB3HTZnLknj_jN4BdJ3-B2n-0229NQzPgTuLu9O-WtrUuSHECmzCmOOLVi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI200Bbwkl0cap7zGTfJ-5TMGlyKGc5eEgQuw_h0ahdw&oe=69CD1DBB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
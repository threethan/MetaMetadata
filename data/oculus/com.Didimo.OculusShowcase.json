7PNZH&_nc_oc=Adqi3P8dRT9YatK3yDJecclxZZCvnfZGlh_ydYWqAG9oet80o7i2Uw49dwjOigouQhA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iSusbBFmA4BXJoI7Z6SzLY5Kld2uY3wt_-b0CRdqyPg&oe=6A32B899"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kGbYT2ewcgQ7kNvwH3kvU-&_nc_oc=AdoLiwS8jEXrdX5oZNpc75LfDUxNHn_vQbYRh_0olro2u336AIcUD_95Fcz6aeiwlac&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SF3HkJ23PncfpRgXcHas30W23KW4sbhCUuwZBxDASVQ&oe=6A32AC59"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vERaq_uudgQ7kNvwFIMr9n&_nc_oc=AdovENPHK4LGD_N5RbNZgVBDIkHGcDBjjbW9otygt72oE_Wpm4TFSjrh2WviO-kuZVs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vdx1lflomAl-pMPw6LuO-dEtikaIm4RfS5jXVit7cDg&oe=6A329235"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62B2RSYtyHkQ7kNvwHiuPOf&_nc_oc=AdreAh7XJDI5cy-_sQHS0MFAQtmwGd8lkRVdF0RPektl3skKxEzTPOJgy5HLu4qqjUA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-2iBZmkL8Di0Y6mOxAivKg08Q1aVgP68rb-Y7oRJT0g&oe=6A3296F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK2pQ3hD0CoQ7kNvwHMJRqU&_nc_oc=AdoB9mAI603XFwlGxkhDYqBDzAjkj1pR6Sdb4VtjdwdOH3Gh6_FAycMh0fSX4BzijW0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Jq7UJiQtXujuvcBhPgllgqkP5zp7NbXbN0xm3h1YuEQ&oe=6A32A13B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
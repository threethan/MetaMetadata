G5mci&_nc_oc=AdqSchI1owzizJCe2QsPCxeymrp05VWIHvJ5cJcGli7oMwO6YpmC6zwDTwzCSs64FaY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c8AW6Vtn9NvQjPWNaI4YiakFmbBQcB9vQCCSm1q2e0A&oe=69F4C219"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9X8ua2DjfEQ7kNvwEBQmQ8&_nc_oc=Ado3Z44kmU2pJp466E5_dQh0xlpw80Ks4FInejFangnfYc8lUJL0yhHSID8Ri_vACx8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lpC2BJhdVOBnJrLH0Ogx8tAFsWJsNbZrHyYu5ybY0zA&oe=69F4B5D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOo0Jh_o3n4Q7kNvwFRY-BP&_nc_oc=AdpnlMeLgaN7BCMbAAMHOsYZe2HaLqM4hSQO0MS2JHfygiXdoGmjCS8Nyq__rG2ih1I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-J0J1un_ZJgCzR-REtn7lci85t6c56D9L6zjZaol_Og&oe=69F49BB5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtImpZOxcQMQ7kNvwFydnWh&_nc_oc=Adp_iJielhvWdFIKjwYZwjkvmNThTjmS4BSekbjujATxsLmrTr0tNelF4ObFoUjj3mk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FmCWq8nHcb5i-K7S6efBK6zUsH0-udlSdzMhZuxIfKQ&oe=69F4A076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NHr_5cjEdUQ7kNvwG2suZ-&_nc_oc=Ado-L1h-stwCuDSnMejZ-cFI6bcWZFSx8OFzQu7-htlb9A-LgZJx-nMkIi8auWYKY_4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DI4l2Swy4Iuas_fjxjA8-ygyOZya0vQmOyhYTDEPwIw&oe=69F4AABB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
65RqQ&_nc_oc=AdqAGKZSWyK6WjxXHFaxySyOMMVbXVIm9GMtoCbfvOL8hncYEPpNy57u2obGJZDfWx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqm-fv7sabi4uIf0omCqGn7vKOdipd6fMbVmZKgg10Bg&oe=6A6B6919"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Pda-6FduAQ7kNvwGjKVem&_nc_oc=AdrOLKUjUzZtrM6Ow9G3deDM4Gz2XMs5zGTawJ-P-wONrw9LUHqhHI0gvwO8ZZM1XtY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3CaPoPt3CslqVWT3NbsfwLNnHPE2l0LgiYqug9uxk7A&oe=6A6B5CD9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIurjVJoZo4Q7kNvwEt9Kkn&_nc_oc=AdrVfsXpTaw5jGi6Awuz7_F7D4RlvyfDATndSb6709hj3v3jiXtiCEcVmeRvMokzUdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz4PTSa1icuc3jgHJoMkgC3EXMHGSCeXh1XwYf-T23VA&oe=6A6B42B5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoXd4er-DeoQ7kNvwFIF4gr&_nc_oc=AdoYv_oBqiFYtuTHgiBfrhGabv4O0knKeFeTcUd7qVZ0odVVRXrvWy2QaOwVU5faFXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8GtHUHpg7KPP_Qp-v-64Y5KEaFUdmZ0I3CtaZYaZFcg&oe=6A6B4776"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuEQWcmCpkMQ7kNvwHqF2Sh&_nc_oc=AdpQv4IRJ2fIBAzI_N-6etvjkSf32xXof3Y-iyk0mJ53rCU3w9hkfLQV0TOwBe68N3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_WJ0y-ANA9pPbgXOjDJepcLNey_55HQI6XmaTZ7KH7g&oe=6A6B51BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
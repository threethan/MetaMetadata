R7hMM&_nc_oc=Adq2MngCufA5FsGKPhD0ENGI0Q-G3Fk95Xk2lza9424uQqfHoukan0f7W1SBrsgAI84&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2pULA9fPWR-kMJpVfByxzut58AyKeISVOez8u2pIzNw&oe=6A5A4599"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOPiWH_YiI0Q7kNvwGMsvtY&_nc_oc=AdotcLzXCIRrlYoeuHHA8QEXFfADKB0g7159GfoFAi5k1YIrCrPTtw47YcFJdPniyUs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJVUPv3po1qQWpyWt1NG9dlGjwQ_ghjZ8WaYIzgJOVyw&oe=6A5A3959"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jcPEK0XEgcQ7kNvwGtyCLt&_nc_oc=AdqRQMp2qFUY_1uDWiSnSUdX6z4FwjiXmIrO43guv7Yb2DTdtZAz_c1ZdBe50SFpiDQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYKkvWFsvdpI7nHJ3uwwvcfoukrcNiFg39iXfKXoPDkg&oe=6A5A1F35"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ADlZ5FA3RYQ7kNvwFawUvY&_nc_oc=AdrNGqDgFc7Z-D7bcgj9MIJJD1oHaMqWfUcfy3fSLO5RqMjkCJoO3-LBfvt57bNvW-w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuvdtij6v7QKNvvGcMs6ZevRVvCIIGg7dY4rIwtndPuQ&oe=6A5A23F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCY7BwDOMeYQ7kNvwEjNhO6&_nc_oc=AdokRCbt59IME9Nn5WRda6dsLzxqg9-Jkyk1ZKTxt62do0J1vLf0RkntBRSWkwuyyEM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBBy8tKZcvz1gzNkw5xHVvCsQoOs48KxkJnqP9TM-mBQ&oe=6A5A2E3B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
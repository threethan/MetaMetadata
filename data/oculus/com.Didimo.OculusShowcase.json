8xhUM&_nc_oc=AdpryO2Z5rsckDmCS7-9avrMFCR_NSPnKROQrLQbrBP8pSloVg9RsXupmuZze2UUsho&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYBmTNVHUNKtorjYKJ5D_KQYziV49Nn8L64Vl-K345-g&oe=6AB68E99"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmvG82M_C7YQ7kNvwGU7ps-&_nc_oc=AdrRgKtk72QywVS7cf_N6jSJ2euAvE_EPkAdErsf_BRp96xrbEndv_qglLecJw4psOM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYCYkG6UZ6TYl4LPZW3chZFbso2vAcF4XcWw6Ql10EpA&oe=6AB68259"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRSnWzsSacoQ7kNvwEvgVmL&_nc_oc=AdoteB9JRv-3c4egfhXTMzQyhc1CyKZBWIJC-GptEXaMCiEC-XZ1wATsloH7jNwMlxU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1yLaZ2eatsWJG4iPE6NX_4zDOo8NWbN7XLY11BViVbw&oe=6AB66835"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWUUm2d0kQ0Q7kNvwG-2qNp&_nc_oc=Adr-sX6hpPLtbwNahiKeI9I5uhKPysT9vSiO0sCa19OG48f8Rmtr3j6Zcgal50f0e2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQVIypw-idq2IhG0fr_1jJqr1ipwlIfdCEzJHJThm7uA&oe=6AB66CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clZu8Ac730MQ7kNvwHX2jC-&_nc_oc=AdpSjLyYHTPTYN7dbFdQpV6CrhBGmdZOjmiaTa2IGTum_ngRmoGHSFVSSYlH-lAhejM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoZgEsRpHBwZQ1rnp30KLiaVR4-rNPEwryzZrDOdsqFg&oe=6AB6773B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
rG9Ft&_nc_oc=AdoGOJY-ZPNmogQbjA27DldFxrVPTOh1SDcPq0pdhZbyMaZWQTwTbHu8wplbDGjpggI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QjQjVHwZ9Q3AxsPFyJ_53kZ430zrXEZnBd9B4HicAJQ&oe=6A0B2B99"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB_H-j7GKjEQ7kNvwGZxitM&_nc_oc=AdrbazOY-p7GxQgHtCQOvWZyHWbnVa2_axJmChAVsQdw5EtiA8eWz0t3vP2Az_47Qi4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zdPQScSWgpex6c0Rj-ZawTxMPu_TpxA7dP7q7Rp8-JQ&oe=6A0B1F59"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvVdI1wdYqoQ7kNvwGNTBv3&_nc_oc=Adq1yD5r8kefnTCBGmA4KOdFjh0ucwUKEzO9rJrpyIaiX17esv1ty_ypHGtsuDxRUwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44e2x3yJTuWPBuviDZiZlZLmuE26SoIisw_MFcEwatfQ&oe=6A0B0535"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gd_mHLXqAdcQ7kNvwE0FoMk&_nc_oc=AdqQ8tkJU7n0_jP_Gy0itUfp9Z3sYW8KS9xjhoWo1FOSYIk4qAHAF7AzdP3ZmCFtm10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64x4Gc8IKPVxeOueeSvvgeK7OCuOqPpV4WNtBOnJ92-g&oe=6A0B09F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxfxkrI4SvIQ7kNvwFfe-WQ&_nc_oc=AdpvMv5Oh4RNkXxegzBvaZGHOKpIcue21fjZGVeeqACdR5NM266L_oHjRc7gKZ_ymKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cKJW5-fryF4Vlq1P4ebocI2BMhi9YxaCrOvub0kc6qg&oe=6A0B143B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
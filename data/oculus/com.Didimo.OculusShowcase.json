id1Nz&_nc_oc=Adqfvf4gMAjjc_hDHrHQWFQe36juaidp0fPDHy9itm6shGtpzuc3yjhRszvy0qGh86M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4if3eYqFr_ZtW6rtDrPPbtg2BrmzG1uj6rmdqLd6wLUA&oe=6A0DCE99"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i75OvIp0VRcQ7kNvwFC4im4&_nc_oc=AdqYwMLW2XsdxNlP8DPvjWzFeuDiyXonfPgRaoT60ghz0SDoHefQUNK0-Kd_txdTozo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KO3l2DBqSfE_BH6YtMPILxoPuCsWHsEINgEiu3SLpWg&oe=6A0DC259"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf3hDGbMrHAQ7kNvwEydt81&_nc_oc=AdoZc-u38TI7hWpTt-xJ6jwZ2nOpUJI47sjrd82ZXmfyWWFqZserXZOzr7-D6UlxVH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KFf0yyomQchIgBHC_j1irRth-xh4rZdPwH2ohyZg82Q&oe=6A0DA835"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJv3mNRGkqgQ7kNvwEOPRVD&_nc_oc=AdrNSrP70z-rrNDp9m--Q5-qjGU3RcNpI4aIzwDeytwNvwQBE83qGiz5N3WW1ppPkHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T-1y3Mbx6einYTNBI3ega4XKcGKoNg6tB7bYg8EslyA&oe=6A0DACF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxZk5stGFqgQ7kNvwG0ljXB&_nc_oc=AdrGfm9CNrLczzQWZEtXnrjoFcGAEnF2Op81hxP5jXqjs5jJxGeEh2YCr9E1q5HnhKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lI2m-V_hPiSmyj7YB8ZOifhrB3lQU0XYlRwk6cNhnqw&oe=6A0DB73B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
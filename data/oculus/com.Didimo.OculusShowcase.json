NZUpV&_nc_oc=AdqhuVx-Z6Q9iS3m2xfDrZk0Plts91efKDwTs6jHUMLMZNYhJWu0AYbhQjYOGBF1Jx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AS45HuoEw_LAHIb9QxYghiB1uKD_FPnc9-EBe3V3_3g&oe=6A146619"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3jeqW-1KsoQ7kNvwGSYamo&_nc_oc=AdrF6kYoRactl3DFv1fjWI584QwicrMr8WS4v6DtmW75MxttYEBAEjzD5NgQFKDRk4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Tm4oI7l8_KmSKPpjZVVMToB2ssJClIKigONuYJZqu1Q&oe=6A1459D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsmnpzQO-oYQ7kNvwE8th2V&_nc_oc=AdrywUf1Fkd0ZHCwmc0kWVzTbBlH_zry5rgSPF3aSi8XbvKR10dbp8upQY24B-u5bwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q6Vi-vn5wRvOZgtdmVYz0OzP8BPB1l61NI-WRS8V2dw&oe=6A143FB5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYU10Y-LeGEQ7kNvwFKNMze&_nc_oc=AdqDH4x3RyZrXw4QeHs-dmDpZnfxOeBc2cOVq_7hgn87CQr665Twcjg1-9jvsqVs7jE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TuPGAnzvqquBeJHLTIqNsV6b9LJYzHGqlGsTEpBBYnQ&oe=6A144476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zQkRVsZaPMQ7kNvwHPN-0D&_nc_oc=Adqlmjlv4PoP5LI3N3db0AT1R0Ik0V99GU7qvdWlxtNv5WmTO8e5y7PgWzWJIZa86CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rA8E2uTyUnZLDfHPhgeKDz9DwsVE33LYEcDE7GnJiNA&oe=6A144EBB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
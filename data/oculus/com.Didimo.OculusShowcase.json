yEGYR&_nc_oc=Adq3xoipR5sy1iaOVeiTNrFEAeQ0jxyMbMvwf7u-dDMvZbor7f62uVEWw94TR1U-mYM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXV-QVKS_McMW9i3SiyAOWjL1PoWL8simk6Fja4JVWuA&oe=6A565119"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnUd7pkvf1UQ7kNvwFpD5rB&_nc_oc=AdplMDs1Jmuo7OPpDUG1yoVp3P4HDm4BkssPOwZZxApW-XxboNYfGtY2UsP4pp64_mQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtnQA7UuKKrucXQTtk7sAniUeCYuc-9FvJ2HtTKiAz6Q&oe=6A5644D9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mosPrSu1m_cQ7kNvwG54Mf7&_nc_oc=AdqCnDnvnlfAbbgTSxwdMK9_J276AJtEz-gCDw7BFYi_hhaqaNS3b0iBPHCNWSovpV4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCovjqSOkZMU7QbBnlHIv41BodJDF-sM-EoS25ClIyIGg&oe=6A562AB5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtxQ05-Jd8MQ7kNvwFu7Yo7&_nc_oc=AdqO0rvk_JVJQKx4KvWtHW8Np5NeP_t1wjDZ130_0KnkwycivzCBVfIroWeSZAENrb4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAePIzJTOzrMkXMoUZiW1JIbQUnowORLxse1K0H94-P1g&oe=6A562F76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCv3-BBPPmoQ7kNvwGBspoF&_nc_oc=AdqYRNEakZhqFbTKe0kqWsEdhSTXsvqMWjBLc5XiGAlI3H2pGCAl9-utAJ_64E6Dw8E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkZzsZfaiOsSC2_EaOeuJ9Qh96_G6EPRSpnYp7VE9EIg&oe=6A5639BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
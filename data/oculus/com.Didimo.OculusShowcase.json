KKjVJ&_nc_oc=AdqBRwC562C4oSUoDADgThRak3CB0qOJWB0-Vo3_FdcUwNicl0f9JzjyP8eR_O8Wh4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Unll4tjtiR1pIHJwmF9AOucijT_FHDmkDdXggksi2Fg&oe=6A428A99"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gVd2F5NZjEQ7kNvwHYhZH0&_nc_oc=Adq6W9zLdx4bdQiuVTE4Zn5UcwS8r-2Kh71hOgBxsASys4O2hxigLkggIDd5bSj4atE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lG_TDn_MOpZQITX4a8zuP92P3C3XfGhgZxoFTOZXp5g&oe=6A427E59"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqXg2tnxkLsQ7kNvwH2-Mfy&_nc_oc=AdqapZECKlvBtqtsoBOIZuKN0WaiYgUUSWCMnfnqvhuCKMZfIgwGy668-S5u3u5bqDg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BOW7lQGfNyQF7uZNPgp5TzuvpkZ3elExY6nf43sntvg&oe=6A426435"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe77FUCoTwoQ7kNvwFhdz6w&_nc_oc=AdoO-8DwvVRoAEGPr8xXuFwJonkfkzqJz33MY6BRQcLwcNPjKtJAA7-u6bgOs7cHy8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-fuuzjukWgAiWODaZXG3L6DYxCvbJQBePuDv68noStA&oe=6A4268F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7uJ4kvJcfAQ7kNvwE9bwRB&_nc_oc=Adok9vdBGkk9G6Lao9Xolabk6Tx_txAiKwEcMAsPkyB_jPGUrDY821Sx4SEw2iknXSI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oYJI1ThvciNp9yX7T49mMDHhpwfsZ7Ei30zL4pHPLFQ&oe=6A42733B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
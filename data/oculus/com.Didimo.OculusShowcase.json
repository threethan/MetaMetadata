YqgbU&_nc_oc=AdoeJC2zu-bskYAN4bZymcDgfk-R-9TtAtZJKa2b_SjhAbNiUfjsJ3Lb13zFlay1L-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t4esfsu_o86SLSf3F2a5hcJaqkuEBrJGMDhS0D4kAoA&oe=69D27B19"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6P1ivuOikQQ7kNvwHNXSwC&_nc_oc=Adr53O3uIU-mE-Djs-u0LrFRHmeavmMC0yUVRbHxk0bftwnMVj8Fm2fwjW0VkPyD8Ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KYzxpRzkVegXOayjp_f4yH83iXNPnQYGjAQWvX0iFhg&oe=69D26ED9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGdXC1kanFEQ7kNvwGl8DKt&_nc_oc=AdoOjVaejkCvEYpNStKUNiBf4jzKs8Ok81Ufnc7Vzb4G_16LLSWgNd6CLo2ZsrT_tP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24lqCszxcEhio3-3JWUW4IFFUisX65QI1PPYKI7LRtXA&oe=69D254B5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8JOq11wM7wQ7kNvwHC89T8&_nc_oc=AdrSGvUk8V74qG0vvjpxYAWYioNxuqauuy9eScexXktdDWkv88NdSZcKobbRwez7CBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oaCXagdmKQVd74I1AL137RRer88K_YCOaWcw0xOncrA&oe=69D25976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeSMz6RdHcQQ7kNvwFjGjZ2&_nc_oc=Adq0_Yoz3Sq9WpwqeSsDsDLhc9GbRenPANxHqp3DQ4jiz03o_FQupjOY3io79AVsKUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dcJ9lUdOI3l0jr9fYc6lZCnYg-P77S37Om5LQMYBcJg&oe=69D263BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
30ctd&_nc_oc=Adq-JypI8TbanG3nvTmjvmXAflyaWts-rkS58JGEuRG-lC3xAlui22hx5XRFdIylwQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRb7aDMnFHy7nKtkLQ0jdmpnagWrz_yk4uvrPU_6YXFw&oe=6AA56B19"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoKb9HqYjC0Q7kNvwEXEQJP&_nc_oc=AdoRLdGvhzrLcfc-l4Q4xTrSg0CHLxurEGiFlgAqVwzqdVSkSErvOa8_8fJ8_7l4kjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH5dCbS_ck8fDHmNcE9-0BOHxcLWn47aCBagocN2Rpzg&oe=6AA55ED9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iznIJlvfcvkQ7kNvwHh5tok&_nc_oc=AdqqQe4eBjYCV2FmzEvyHPKaeHGRuHHb2ayxQBQoP-UxaHD6lioR0ok9wJNDVoyDV1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWqpF9lDhaxMp_al8Kt2DL8faO4J2dBvV-Q8SFqIJyHQ&oe=6AA544B5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ww9WyHmcEiIQ7kNvwFUrhv_&_nc_oc=AdrrzGQRMLKAg80JXPgaKbRK8O0rq6niU9oqkNkHLmcb4JgQQi-3jIvNC85xA6AJ2hw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwbifCgWXYJjpM6rVOhAeiQX2o38LDmjUYslDWk3l7wQ&oe=6AA54976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPjmr4LWbDkQ7kNvwG4JZuV&_nc_oc=Adp-xxJ4aeTfuy1RqjJ2NznSRUSwNkXjx3LWjyVpea1XcjA2SJPoG5pRiBGllQ48-cw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpq5BFiqlrklsywiXJNJfoWFiatl65vAD4Yw9SyKuozg&oe=6AA553BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
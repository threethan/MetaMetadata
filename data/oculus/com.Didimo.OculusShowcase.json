TsLPB&_nc_oc=AdrBQRsc2pGQchMH74CTQirSGfbicUJYlH6qYxeigPjAbxP-VIEWtO82H_5SW5LIpfA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYRLFsO8-S9jtLV9iMjctrMZU0Aq7ZBxbkx3as3UqStA&oe=6A9722D9"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7rMCXtCJ4AQ7kNvwGDb9aP&_nc_oc=Adp6DbIomXvLDnkhra2CVy_rIWdwVcJ_Vpzxiin_Gz0pMl1sMzh-8FraK0ikHYn3Vp4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh9eMc7nA__hBBalBIBW1SN97I2K3o8T0WeIVG8eMOnQ&oe=6A974ED9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQr-TlTFRmAQ7kNvwEiIewf&_nc_oc=AdoXQ2PvK5Hwnr-8k5hQgqx5LYNos3UTDHtz8HghWZHhYnMs85ifS-JauBTuGEuwWDc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDvKcszg_QhqQSrxBZ2XbUmmdJOeMtkFeJe2O1LR9UCg&oe=6A9734B5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fyai4XRV5CwQ7kNvwFxJ-F6&_nc_oc=Adr0rllBxkt5SU1S2rt3GHsklaodfDuFUG6lzBP0ivs-zkVnEJHi-hklby6rWYetZ9g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrS1FDncg7DnlD6C0ql1TqVT1Ycrz2vqF75p0S95nJiQ&oe=6A973976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXQ2dCnAmaEQ7kNvwFvyPAe&_nc_oc=Adp-oUpgSozDC83eVAnwumFbLUS6aXUJqmRj09QyvKBXDqJ5fz8Wmys-KxwI9bOVfUs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKV3a7I9dIi1oQPK0bTqnNwpjnoxD9pLky61kWw15VEQ&oe=6A9743BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
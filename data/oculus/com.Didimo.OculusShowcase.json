-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNH6inwUEThpJIDDQjWx23nXNEetO6TTGE_57RYnwmcg&oe=6A8D6B99"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEHagh9YlrMQ7kNvwGONyAm&_nc_oc=AdrVzgeXBMLgDJMIbt9RarqGQCTrQxd5WVF-tF9TBayL2d2oM_bRuyb0qjqFjCbaIYw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4iFUI-cLvunjxo7s5qhkeFCEOn9e_OAIkPny9v9UXBQ&oe=6A8D89B5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=535P1b2xEKoQ7kNvwHtIGIV&_nc_oc=AdrFva-g-3xSS6lCHwJY2WAHQH9PLTfE6BMxy5h9UL1QmzusaEF795n09VDvQr2wpYo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGOzf-u7xmWoJu4A298V2qSZMIKRWB52pjTRzjMFuexw&oe=6A8D8E76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi3XNBn8rJ4Q7kNvwEEtXAY&_nc_oc=AdqKeWpi_IlJMoHZ__Wca65iP2DFWne0ZMcUKaq5zePKzv0zb3PQdYu94vTdyXY9QXo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgUbfpN7aLsBZyGucvCyIXuBDEeVrDm2a7ARmtrPZO_w&oe=6A8D98BB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "717215566374890"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2646473372325342"}]}, "baseline_offer": {"id": "2646473372325342"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1641340800, "status": "PUBLISHED", "id": "2646473372325342"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "
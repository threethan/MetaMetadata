rHnEr&_nc_oc=Adp9syQRucvBKW8puVUF3xI2wC73cAC5UWteyQ4Ya9Esj371cIOh1_oK8FzFz6VD4dA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACBr54MZaGqh6mC73EE1DSvQ73v9QWgi2jb_PjCdjAQA&oe=6A5B5ED9"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOPiWH_YiI0Q7kNvwEeTEbd&_nc_oc=Ado339Lu8SqTlrLbTr4WFLhsixRZ8aar_x_GuBBCrY4sL8-09uPoge5hdRJEIZB1mOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkaoaf-NAsn1vv2NSMw0ifQiiS9jnogfUje1Jjn89t1A&oe=6A5B8AD9"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jcPEK0XEgcQ7kNvwFIInXH&_nc_oc=AdpkTuSXSKfAozrKboxgOJDMEyvg5GUb7-I7kgVv68jEhgywFPIEMLcvfhmuNs_lDdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8F4V5NFFhu8pTOCwLFkC8NDxnA-RP1SZFFAfC6in9Ew&oe=6A5B70B5"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ADlZ5FA3RYQ7kNvwFrKVSV&_nc_oc=Ado93nWdamCqGgcsCQznY31uXCfb0fhPUGt3cNMxR_2TDkHJU3dMCYxutgBngti7Rdg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOTPWCxNtWX4WXMQapcye6CRm2feQrzOMaxZLnDqnFPA&oe=6A5B7576"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0ldLFFYSeUQ7kNvwEO6kXa&_nc_oc=AdqNuEg74jDzdX9LlnfgRapayS4CeCtr4AtoHeCXYc1eHndQPVWAnX7c153_s1LEWNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb1tuInv4xfnf-wAefGsCTxN7M_jQLopWmz1bMrX1Z8w&oe=6A5B7FBB"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
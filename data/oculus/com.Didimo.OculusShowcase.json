a4flI&_nc_oc=AdqYkCf8rK1EoDSlF_CjTS9gQiu5vK-Dc6M8iTJBB1EHD7jYRJEbth7tZk8P2Bspaqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l62MkMHigRgVroGhm3wIAe9ZJX1MaHFZnzrMylyUhdw&oe=6A3FE799"}, {"file_name": "ShowCase_2 (1).png", "id": "578101016960958", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75542964_578101023627624_2685597177941783494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9_0ToSmbm0Q7kNvwHlwmUl&_nc_oc=AdrikiyH5vAP6Zgs_HIQbD7LKzMQQRDAkLh9L7knF-W-u67YuAIk4ZKzX0v8W8x8UJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C8kOuTO_CYRaYG-zYd02IUGgePMd4alIg9uSApz2PPg&oe=6A3FDB59"}, {"file_name": "ShowCase_3 (1).png", "id": "1982660098576145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031517_1982660108576144_4131196602014327107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkRm1KEBI8YQ7kNvwEYZdbH&_nc_oc=AdqCivC84fWhqp6trEWn0g8h4COirBKN188uQYbw4cAz0X14nEY6o-5lR9sWKe32Wx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bkEWjQ6D0yn0QFIfR_bKNK6s-UPOhRg2FGJSJL2R1jw&oe=6A3FC135"}, {"file_name": "ShowCase_4.png", "id": "677346163229857", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_677346166563190_9047926323170431053_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlPDgn3vnX0Q7kNvwGfil5y&_nc_oc=Adr8vc9Q0NN3fIx6bLFl3OSaAomuHaoRHbZQvvsgyyWDke1H9anxu1yWC-anOUNTghc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P1UtMM0PGXUYu_yEKJzF_mjRNRv01cJ9O0IXe5Mxr3g&oe=6A3FC5F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover-Image.png", "id": "875440820035547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_875440823368880_5727388333309500556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7uJ4kvJcfAQ7kNvwHPpyLK&_nc_oc=AdqWF06-49Id2bn7JdpUov05aK2E8sVFuiu0Ni5-ZgQ3WBH4_9Lje00PIUYjLAuioh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zQ-Lnkm7FfKCIrUdSwPjxglEN-I1xH7lx3ef8exB3Ww&oe=6A3FD03B"}, "display_name": "Didimo VR Showcase (BETA)", "keywords": [], "long_description": "Didimo makes user-generated 3D digital humans--fast, high-fidelity, at runtime-- from a 2D selfie in under 2 minutes. Integrate your users\u2019 authentic digital humans into apps, sites, and experiences with ease.\n- Our VR Showcase BETA App demonstrates the quality & features of a didimo that can be created from a single photo.\n- Our cloud-based platform gives businesses and developers the ability to create authentic avatars at speed and volume by integrating our API or using our Unity SDK with your application.\n \nBe sure to check out our Developer Portal to access the comprehensive resources we provide to help you build and transform your experiences with digital humans.", "short_description": "Didimo brings user-generated 3D digital humans to your digital experiences with ease. Our new Oculus app shows the possibilities and features of didimos in VR environments. Easily animate a didimo using ARKit motion capture and leverage lipsync to bring your didimo to life with audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.didimo.co/privacy-policy/", "developer_terms_of_service_url": "https://www.didimo.co/policies", "publisher_name": "Didimo, Inc.", "support_website_url": "https://didimo.readme.io/docs", "website_url": "https://www.didimo.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
w3FFBOQW1JFMKznqh9XTvIr_1g&oe=6B01C1A3"}, "display_name": "Doodle Board \u2014 whiteboard, paint, sketch, draw, and get creative in VR & MR", "keywords": ["whiteboard", "paint", "draw", "sketch", "brainstorm"], "long_description": "Doodle Board is the ultimate whiteboard: Fast, simple, and distraction-free. \n\n- Draw with one click and save with one click\n\n- Collaborate in real time and feel PRESENT with a colleague or friend\n\n- Email yourself your work without fussing with the Quest mobile app\n\n- Leave the zoom fatigue at home ; )\n\nWith infinite ink & zero cleanup, you can let your imagination go wild in Doodle Board -- the perfect environment for dreaming up your next big idea.\n\nDid we mention it\u2019s free? Download it now!", "short_description": "Doodle Board is the ultimate whiteboard: Fast, simple, and distraction-free. \n\nCollaborate in real time and feel PRESENT with a colleague or friend!\nLeave the zoom fatigue at home ; )\n\nLet your imagination go wild in Doodle Board -- the perfect environment for dreaming up your next big idea.\n\nDid we mention it\u2019s free? Download it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mauivr.substack.com/p/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MauiVR", "support_website_url": "https://mauivr.substack.com/about", "website_url": "https://mauivr.substack.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "sup
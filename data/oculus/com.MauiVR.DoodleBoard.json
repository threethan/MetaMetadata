095713234_294370448393271048_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4i5G9yfRDoQ7kNvwE-3wzb&_nc_oc=Adqd1-cGUjdkqylFnLcpGEtCXr-B2U7GR07szC6lqCERpzGAFq5Lt3f4zxEvsMVktW0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdt9erKWFxPVYUWa1H0ftImuj-6bExeO7VqEmd0aQmaA&oe=6A8EE354"}, {"file_name": "DoodleWordsScreenshot.png", "id": "570013131772090", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031447_570013138438756_2157245059469094949_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKux7iT2XT0Q7kNvwGeJF0-&_nc_oc=AdpyspfgIqIP_n40ftZlCawqRjHbUcB0tQ0lHuC442QQrJXGPoQAGXxTvYfeYvKhIZU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhRsRO7PDl18boiOW6-wCBk_7sMtiVv4UF6VmKm7wP_g&oe=6A8EEA79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MauiVR Trailer Cover.png", "id": "772966444056584", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036646_772966450723250_6763369787447709840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlGxbpsDp3YQ7kNvwEEHaQA&_nc_oc=AdqdsJ0YxSdd5tgd2S3MMDzITMmn9aJuZ2G_aflY5wuWJ7DSC1MGoLei6UgtJGfW3eI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd56MmSClvBS4fUHjIMo7VCqkVVwwS5vD4y38pn1PUdQ&oe=6A8ED192"}, "display_name": "Doodle Board", "keywords": [], "long_description": "Doodle Board is the fastest & simplest way to start doodling! Use triggers on both hands to pick a color and brush width. Many users like it best when they cast Doodle Board to a nearby screen so that a friend or relative can watch along, or call out guidance on what to doodle next.\n\nWith intuitive controls and no complicated submenus, Doodle Board is a great way for novice VR users to begin their VR journey. And with infinite ink & zero cleanup, Doodle Board is a great way to let your imagination go wild, or to idly occupy your hands & eyes while you're daydreaming about a fun idea.", "short_description": "The fastest & simplest way to start doodling! Private, safe, and fun : ) "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mauivr.substack.com/p/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MauiVR", "support_website_url": null, "website_url": "https://mauivr.substack.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1665793043854269"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "178386991740144"}]}, "baseline_offer": {"id": "178386991740144"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681407660, "status": "PUBLISHED", "id": "178386991740144"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27661576080210720", "version": "0.423"}, "id": "594005822785466", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5814389492022693", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27661576080210720"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "594005822785466"}]}, "change_log": "Bug fixes", "created_date": 1787190611, "id": "27661576080210720", "version": "0.423", "version_code": 
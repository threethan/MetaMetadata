Ia1q-jnSnNKYiOPAEgwVopMAE5q5w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxZEEtI7FUBj24jRnuw2w_e9981RZKuxfIZhIlGEwaJg&oe=6AFC6899"}, {"file_name": "\u622a\u5c4f2025-12-06 00.36.26.png", "id": "1533689744442675", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619774_1533689747776008_8853950371880090095_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzcSLa_e52gQ7kNvwEET0tQ&_nc_oc=AdqOTWle2hvU7eSafebA-_WFlFe7FojNldvswCZTGfNab1JBNl64dEa9bm6Vg7Cjapk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9bTxS1UwIV7T-Prhx2kxGsguOkJioUr_k_xIx7XmyMw&oe=6AFC6824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u5c4f2025-12-20 23.30.48.png", "id": "1878373919441623", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618937_1878373922774956_5343278532747833205_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fem1T2rgufYQ7kNvwFjJIdO&_nc_oc=AdrcBKBaBAvaSSjASagfIrufTOdXErYdi0WwV2E56AHf7MdjpkMM0ZrP07iTwFoYSNI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXxCm-rrbPzND9VaQydPKI_Pn5gHmmNixJxzx3rhx8BA&oe=6AFC913D"}, "display_name": "Plunger Climber", "keywords": ["climb", "funny", "simulator", "climber", "crowbar"], "long_description": "Plunger Climber is a hilarious VR rage game - you will step onto Plunger Co.\u2019s ultimate reality show stage\u2014compete against global challengers while you're stuck in a toilet seat (life sucks), escape with dual plunger guns: suck your way up the 10-story tower to win the Golden Toilet Trophy and prove you\u2019re no loser!\u200b\n\n**Climb (Suck!) with Dual Plungers\u200b**\n\nMaster this hardcore VR platformer: fire suction cups, yank ropes, swing upward. One perfect suck = bliss\u2014one misstep = plummet. Chaotic, thrilling, unputdownable!\u200b\n\n**Midlife Chaos & Wild Challenges\u200b**\n\nConquer 10 themed levels with absurd hurdles (spinning washers, rubber ducks, laser tubs)\u2014hilarious, brutal tests of your skills. Race global players on leaderboards, beat the midlife slump!\u200b\n\n**Gold Rush & Plunger Collection\u200b**\n\nStrike Gold Rush glory\u2014collect gold, unlock unique plungers (Cyberpunk, Cutesy, Retro, Rubber Ducky) in the shop, customize your gear!\n\u200b\n\n**Viral Fun for YouTubers & TikTokers\u200b**\n\nThis streamer-favorite rage game serves toilet-themed chaos, epic fails, and relatable humor\u2014every misstep is TikTok-worthy viral gold!\n\n\n\u200bPlunge Up or down\u2014master VR sucking, conquer the platformer, win Gold Rush, and prove you\u2019re no loser! Unreasonably hardcore, hilariously fun!", "short_description": "In Plunger Climber, you will step onto Plunger Co.\u2019s ultimate reality show stage\u2014compete against global challengers to conquer the 10-story Plunge Tower and claim the Golden Toilet Trophy! Climb high with dual plunger guns in hand, go through a wild tower loaded with unique challenges, and experience hilarious chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "fr", "fr_CA", "fr_BE", "de", "de_CH", "gsw", "it", "es_AR", "es_
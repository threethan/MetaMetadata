PYmEY98GcCkHcp2V3V5R7hWTA1VnaFutZDeb1LtZD1MbAKg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_36iBTWrpmbs2LFZAZbAbAj4w7WhnVHrnaRt2NZ6maA&oe=6A8598C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "output.lin (15).png", "id": "2351693928603482", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824045_2351693931936815_6926329232915346382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SomUTHw301sQ7kNvwEwg97U&_nc_oc=AdqK1-PlSDAJhdwLV0OF1PR_XfxypTkZ3YKyA9gmcI3e4542ItFdOoYhUWnY01dkExY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOiaLPxzebWuTlvycrzMFFRBbpZe7Q-Rpcj4Jd2MYgCQ&oe=6A858C1C"}, "display_name": "Plunge Up", "keywords": ["climb", "rage", "action", "race", "adventure"], "long_description": "Step onto Plunger Co.\u2019s ultimate reality show stage\u2014compete against global challengers to conquer the 10-story Plunge Tower and claim the Golden Toilet Trophy!\n\n**Climb High with Dual Plunger Guns**\n\nOverweighted and stuck in a toilet seat, your only way up is the dual plunger guns in your hands. Fire suction cups to surfaces, yank elastic ropes to swing upward: one perfect swing feels incredibly satisfying, one wrong move sends you plummeting down. Chaotic, thrilling, and impossible to put down!\n\n{1147547254183252}\n\n**A Wild Tower Loaded with Unique Challenges**\n\nConquer 10 themed levels, each packed with one-of-a-kind hurdles: from spinning washing machines and swinging shower heads to flying rubber ducks and giant hair dryers, plus toilet portals and laser-scanning bathtubs. Go head-to-head with plunger pros worldwide and climb the global leaderboards!\n\n{1945598606042705}\n\n**Viral-Worthy Chaos with Hilarious Themes**\n\nBuilt as a streamer-torturing rage game, Plunge Up is designed for viral moments: absurdly funny toilet-themed elements, disastrous live-show chaos, and nonstop clumsy fails\u2014every misstep is perfect for clipping into your next viral shorts!\n\n{1298122005420966}\n\nPlunge Up, or Plunge Down\u2014can you make it to the top?\n", "short_description": "Step onto Plunger Co.\u2019s ultimate reality show stage\u2014compete against global challengers to conquer the 10-story Plunge Tower and claim the Golden Toilet Trophy! Climb high with dual plunger guns in hand, go through a wild tower loaded with unique challenges, and experience hilarious chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "fr", "fr_CA", "fr_BE", "de", "de_CH", "gsw", "it", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt_BR", "pt", "ru", "ru_UA", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24640348032252754"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1173467888062774"}, {"status": "PUBLISHED", "id": "1626205642029431"}, {"status": "PUBLISHED", "id": "1584773886027862"}, {"status": "PUBLISHED", "id": "1437458227364951"}]}, "baseline_offer": {"id": "1437458227364951"}, "is_approved": true, "firstOffe
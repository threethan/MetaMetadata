3E"}, {"file_name": "migrated_image.png", "id": "223801985477508", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522302_105107990329570_8442602675282903040_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-FzA64_MEoQ7kNvwF0q-OZ&_nc_oc=AdpUeTgizyRZuPOrKDS-VgebFSchS5h059gSE_MVPYlPHVZmx5mi1ZO1BYL-volDeYU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIY5zs4fKWmTeP_BP1d2LpDRzFfq-Q3AghtY8QgJJi8w&oe=6AA4072C"}, {"file_name": "migrated_image.png", "id": "507716336593456", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410355_326404937883864_1549964464885858304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQrW2iMDsu8Q7kNvwHV-syj&_nc_oc=AdqpqTFnzkr7WRGtlVRyDmEQ6moKriC2FGQ-ixwKpJ4mLORCBaCuhven2Xb_LrqFqEQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlqwPgdNj-vFUhJZMMWwcAl8RzR8FUiPdq44JZW5dGCA&oe=6AA406D1"}, {"file_name": "migrated_image.png", "id": "524803164889176", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331069_1620981764645786_2912634043172388864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiy8xV0tAH8Q7kNvwHajLrB&_nc_oc=AdqEOFSg-WzZQgII2QJoR9ziZIgpBqNTbYVHqAzSNXLC38tc7JjmFiHcCCkkaNPeXZE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUcq8sOc_dIQ7AhaIL4F5ulpeKJDGlX3XUH9SAFAscgg&oe=6AA3F773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Viking_Days_Landscape_2560x1440.png", "id": "225440854855882", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12533893_225440858189215_4420520554545545216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmxF-AEQK6YQ7kNvwHx1qmy&_nc_oc=AdrxqPfkLpu3zXmbLxtjGe712bs8n1erYMp6sUQiRLYGA6ZEw4Vxpq6nRMoX_LafDPA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYHBQ4gP2GlUg5LLaG5QdNk5Dt1IHYpTckEWUWOp5VKQ&oe=6AA3FFAB"}, "display_name": "Viking Days", "keywords": ["viking", "minigame", "arcade", "WarioWare", "JobSimulator"], "long_description": "Viking Days puts the \u201creality\u201d in \u201cVirtual Reality\u201d to show, through 10 minigames, the domestic life of the fine upstanding viking. Each mini-game showing clear instructions to the player, and making use of the VR motion controller in different ways for they to interact with the game world.\n\nAt each starting game, a random selection of minigames is sorted for the player. As they progress, more minigames are added to the tier, and the minigames that repeat gets increasingly tougher. After every win, the game will show the player their current winning-streak. The challenge here is to overpass the player\u2019s own high-score. How many days can they survive being a viking?\n\nForge swords, drink lots of mead, throw axes on targets, hunt for dragons, guide viking ships,  cross windy mountains, shield yourself from arrows and more! Live the good old viking days!", "short_description": "You usually see Vikings in epic battles of fury and glory, don't you? \nNow you are about to find out that the Viking daily life is as epic as the raids!\n\nPlay through 10 different minigames, and set high-scores of surviving them, proving to yourself how much of a Viking you truly are! Here you will meet the simple, regular side of the viking days: forge swords, drink jugs and jugs of mead, throw axes on targets, burn enemy ships. \nAnd sometimes, escape from Frost Giants."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://www.vrmonkey.com.br/projects/vikingdays", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
_993767924109925_5873945892762943488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vxfpel7iSIQ7kNvwFg2VH3&_nc_oc=AdnV_JgkqZcQQt_EEKR38K0TLjUKJQ_ZlieRWR4R3iiVKxlXmQXwtZF1PUQeeOFfHAM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvd-mIeyV82nSJSGfMqIpV9znnqWffkxDbYh579Cjg_fA&oe=69A18C70"}, {"file_name": "migrated_image.png", "id": "211495946587332", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12138782_1842106219194667_3208056114427985920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaeZdLusYw8Q7kNvwEHvnbD&_nc_oc=Adnoau0HCcJc0cZSuRQRswm-GU1VJS8sQO0N7jeV8Cp6scVhMrahb6bjGVNqCMhtPeo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afuy_uuAH6Pa_1QokGVqzd73ATx3YjAfzif3cPVwoZ4pCg&oe=69A198E8"}]}, "id": "2591153310995862", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "232886261234058", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12138999_148716649297736_1781082552073715712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXIj6eWAZ44Q7kNvwGXc0XC&_nc_oc=AdktHgDlAlXMpbsrcniKfww2rq0t1_Hc6NfakcZZ4XRhfMS7d7_nx3K_0B6B9XOYQgw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuNDn5z1HnTmNMD96fwL08zXHG1TeOdQuQtmTAMj2YvCw&oe=69A1772B"}, {"file_name": "migrated_image.png", "id": "1120751448285118", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12427574_1402218589879570_7616129411368091648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFB53lGLSyYQ7kNvwGi6hib&_nc_oc=AdmWU0whQa21gwEHFHYqXghr4JoRgNJ1N0NdYMtAnLLt11hfsQ97q9aMZJWR4tcwx5g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuB9Z7I_j73zHZu-gYwZ7GamI2PsoQIBpl7mRf9Jh603w&oe=69A19D3E"}, {"file_name": "migrated_image.png", "id": "223801985477508", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12522302_105107990329570_8442602675282903040_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfvsVA76bnMQ7kNvwFljyv5&_nc_oc=AdlTouK3GZtKvOT6H4FyngBQmq3Z4sm6vv4zm-EBmdBYwtpxWdQKRewD1YNk3RsDAA0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuZOdwOGdsz-NWIZ6Kll_uSho5koEOTCQx25CJnxdweSQ&oe=69A1A12C"}, {"file_name": "migrated_image.png", "id": "507716336593456", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12410355_326404937883864_1549964464885858304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUoN-wpZtTIQ7kNvwEd_kiG&_nc_oc=AdmaVQSwHoqpiDUlm-j2sbOMy3isHXf2Mw7IvhkEqnbLKTZdq4buh2VLoJQE43INnfQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvYt66gltbiQRDd1Aot1gVez9FFfMa2sANP02nshzlb8A&oe=69A1A0D1"}, {"file_name": "migrated_image.png", "id": "524803164889176", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12331069_1620981764645786_2912634043172388864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgV3fgzqPysQ7kNvwEjZ_xA&_nc_oc=AdkELwr29xVLwALtRM0Y0quk-rG8Ge3BHNCNoto1394C-ep263iBAxsoJrj1Hkn6M9o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsVqd2HJ7q3-WMXUVL8N-l8YKCRjoZ5Qk9THF73Ayri2A&oe=69A19173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Viking_Days_Landscape_2560x1440.png", "id": "225440854855882", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12533893_225440858189215_4420520554545545216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHpv4JBAK-wQ7kNvwFD1IpE&_nc_oc=AdngXnoTZ3_h2hCXc-a0XVe6NKx6uZT0PqDNH1czLu5B-IJteG7_wAY75vzV8peYkYY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfulbIeWDJfFh6hFh3AGW1fHBm8bp3yNos0P0IqXYpAzDw&oe=69A199AB"}, "display_name": "Viking Days", "keywords": ["viking", "minigame", "arcade", "WarioWare", "JobSimulator"], "long_description": "Viking Days puts the \u201creality\u201d in \u201cVirtual Reality\u201d to show, through 10 minigames, the domestic life of the fine upstanding viking. Each mini-game showing clear instructions to the player, and making use of the VR motion controller in different ways for they to interact with the game world.\n\nAt each starting game, a random selection of minigames is sorted for the player. As they progress, more minigames are added to the tier, and the minigames that repeat gets increasingly tougher. After every win, the game will show the player their current winning-streak. The challenge here is to overpass the player\u2019s own high-score. How many days can they survive being a viking?\n\nForge swords, drink lots of mead, throw axes on targets, hunt for dragons, guide viking ships,  cross windy mountains, shield yourself from arrows and more! Live the good old viking days!", "short_description": "You usually see Vikings in epic battles of fury and glory, don't you? \nNow you are about to find out that the Viking daily life is as epic as the raids!\n\nPlay through 10 different minigames, and set high-scores of surviving them, proving to yourself how much of a Viking you truly are! Here you will meet the simple, regular side of the viking days: forge swords, drink jugs and jugs of mead, throw axes on targets, burn enemy ships. \nAnd sometimes, escape from Frost Giants."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://www.vrmonkey.com.br/projects/vikingdays", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617344035992080"}}]}, "scheduled_offers": {"count": 46, "nodes": [{"status": "PUBLISHED", "id": "505954790106673"}, {"status": "PUBLISHED", "
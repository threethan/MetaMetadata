file_name": "Thumbs.png", "id": "927619194805632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_927619198138965_8077285034823667998_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXrPQYnlhEQQ7kNvwFp7-hy&_nc_oc=AdpIwIgUgWd_fYi7bEvXPd2ixzqsUORVwfu_uyEmHui20OiH3eD8zMb2ZhUIbq2GEXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSCPmTzGT-mQvV-8vIg1qpB6Za-IKsStuyI9IWij-xKg&oe=6AF71893"}, "display_name": "Viking Days Remaster - Mini Games", "keywords": ["minigames", "viking", "casual", "cheap", "party"], "long_description": "Face the domestic life of the fine upstanding viking in 17 mini challenges!\n\nInvite your newbie friends to compete with you in a EASY TO PLAY, HARD TO MASTER series of mini-games and show them who is the true Viking Master!\n\nViking Days is a game born to show the amazing and easy aspects of nowadays Virtual Reality! After the success of the game for old 3DOF platforms we bring a renew version for 6DOF exploring more of the freedom we have with 2 controllers and being able to move around the space.\n\nWith extra 7 days from the original game (total of 17), you will now be able to go down mountains skiing, enjoy the peace of fishing, compete in a target practice with arrow and bow and climb your way to obstacles and more!\n", "short_description": "How long can you survive the Viking Days?\nCompete in a series of minigames to see who is a true Viking!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrmonkey.com.br/tos.html", "developer_terms_of_service_url": null, "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://vrmonkey.com.br/projects/vikingdays/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED",
d5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNx14V2A7ty2SFk0bZxD9Q5hUEHh5X30DcECbhgaM9rg&oe=6B0DA715"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbs.png", "id": "927619194805632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_927619198138965_8077285034823667998_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_BaQy8JqjsQ7kNvwGD20LC&_nc_oc=Adpm18agWvYX4FJw6Bi8IJ0QW8QPQhef3AxAYDfHXkwsZMWLouD3gCzCCd3dCnadZDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTewJND88WGhM7H9gNArwN9lv_-jkDikoxUMzI0LCu6qw&oe=6B0DBA53"}, "display_name": "Viking Days Remaster", "keywords": [], "long_description": "Face the domestic life of the fine upstanding viking in more than 16 mini challenges!\n\nInvite your newbie friends to compete with you in a EASY TO PLAY, HARD TO MASTER series of mini-games and show them who is the true Viking Master!\n\nViking Days is a game born to show the amazing and easy aspects of nowadays Virtual Reality! After the success of the game for old 3DOF platforms we bring a renew version for 6DOF exploring more of the freedom we have with 2 controllers and being able to move around the space.\n\nWith extra 6 days from the original game (total of 16), you will now be able to go down mountains skiing, enjoy the peace of fishing, compete in a target practice with arrow and bow and climb your way to obstacles and more!\n", "short_description": "How long can you survive the Viking Days?\nCompete in a series of minigames to see who is a true Viking!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrmonkey.com.br/tos.html", "developer_terms_of_service_url": null, "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://vrmonkey.com.br/projects/vikingdays/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "17009
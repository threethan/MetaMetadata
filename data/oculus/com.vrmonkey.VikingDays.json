ler": null, "video_trailer_thumbnail": {"file_name": "Viking_Days_Landscape_2560x1440.png", "id": "225440854855882", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533893_225440858189215_4420520554545545216_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4lUeZSVl-wQ7kNvwGwltB4&_nc_oc=AdojDpndMmnxAqxIM9ufqTxVzt_0Vo3n3KO4KqSE8ZwC245Iq1ZCmZccmANoKTMvxa8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJuUwRfvaYP6XYBIeB2tGJRY-hqldVl5NqbsMUann9Ow&oe=6B09BB6B"}, "display_name": "Viking Days", "keywords": ["viking", "minigame", "arcade", "WarioWare", "JobSimulator"], "long_description": "Viking Days puts the \u201creality\u201d in \u201cVirtual Reality\u201d to show, through 10 minigames, the domestic life of the fine upstanding viking. Each mini-game showing clear instructions to the player, and making use of the VR motion controller in different ways for they to interact with the game world.\n\nAt each starting game, a random selection of minigames is sorted for the player. As they progress, more minigames are added to the tier, and the minigames that repeat gets increasingly tougher. After every win, the game will show the player their current winning-streak. The challenge here is to overpass the player\u2019s own high-score. How many days can they survive being a viking?\n\nForge swords, drink lots of mead, throw axes on targets, hunt for dragons, guide viking ships,  cross windy mountains, shield yourself from arrows and more! Live the good old viking days!", "short_description": "You usually see Vikings in epic battles of fury and glory, don't you? \nNow you are about to find out that the Viking daily life is as epic as the raids!\n\nPlay through 10 different minigames, and set high-scores of surviving them, proving to yourself how much of a Viking you truly are! Here you will meet the simple, regular side of the viking days: forge swords, drink jugs and jugs of mead, throw axes on targets, burn enemy ships. \nAnd sometimes, escape from Frost Giants."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://www.vrmonkey.com.br/projects/vikingdays", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617344035992080"}}]}, "scheduled_offers": {"count": 46, "nodes": [{"status": "PUBLISHED", "id": "505954790106673"}, {"status": "PUBLISHED", "id": "405250080205220"}, {"status": "PUBLISHED", "id": "402803153919513"}, {"status": "PUBLISHED", "id": "622063258148596"}, {"status": "PUBLISHED", "id": "2384722821545470"}, {"status": "PUBLISHED", "id": "2186822031562233"}, {"status": "PUBLISHED", "id": "687594395159005"}, {"status": "PUBLISHED", "id": "201122231156688"}, {"status": "PUBLISHED", "id": "840828059662325"}, {"status": "PUBLISHED", "id": "303711180666869"}, {"status": "PUBLISHED", "id": "319560428716067"}, {"status": "PUBLISHED", "id": "860485197798328"}, {"status": "PUBLISHED", "id": "387031541794950"}, {"status": "PUBLISHED", "id": "2282357428647593"}, {"status": "PUBLISHED", "id": "376858777010237"}, {"status": "PUBLISHED", "id": "913406755673874"}, {"status": "PUBLISHED", "id": "2614554338833919"}, {"status": "PUBLISHED", "id": "1629317133899627"}, {"status": "PUBLISHED", "id": "191456555575864"}, {"status": "PUBLISHED", "id": "301181764186331"}, {"status": "PUBLI
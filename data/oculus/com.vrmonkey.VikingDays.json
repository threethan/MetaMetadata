0_7616129411368091648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaSrMxyLVysQ7kNvwGKRmjz&_nc_oc=Adk5M7uJ1KNtu-b7A4g01s82BJm8LLiBkAL-G6BxuX1A9JfgmZmckfKCmeH4dQdVQgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzefLUqK1USPIGsD9c_H53S-CjUftj08arbcDyDwUSD-g&oe=69B806BE"}, {"file_name": "migrated_image.png", "id": "223801985477508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12522302_105107990329570_8442602675282903040_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPfn81RvxSUQ7kNvwEzX32T&_nc_oc=AdmLX8TMiSEm9TjXdenOeqC_tKwdTsx_KB7UBo51DNcj8eoxQLeKdjkMjB6i-7qHUws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRIVXJH97rwZh6LwsgX4Q6cxTTpS35PL86n5rv5KQQmg&oe=69B80AAC"}, {"file_name": "migrated_image.png", "id": "507716336593456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410355_326404937883864_1549964464885858304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfNurcoLbCwQ7kNvwE9-Sac&_nc_oc=AdmQtLuuxSEKyHAIgnl1cCZ0jmT6adnYBs752pFxD7bw8Le5IE53mDwj0-oXE73JWEM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy57fuFBgjU6WqDJ7qRycSXjidWeL_SeQ4dSzty1TlcBg&oe=69B80A51"}, {"file_name": "migrated_image.png", "id": "524803164889176", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331069_1620981764645786_2912634043172388864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebo0yBkPys8Q7kNvwFAy9Eq&_nc_oc=Adk1imdUsXqQfT56oTJZpESZ-y-Te9Wo7ufMIfxMjKnF--Zo8I1k2A0AuXzZMHbAJEg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyojGvu8yz1FnDZ09RsUms2yPSkb92lF_JetOln7an9Yg&oe=69B7FAF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Viking_Days_Landscape_2560x1440.png", "id": "225440854855882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_225440858189215_4420520554545545216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KhfE1ZNYyUQ7kNvwH7DmZy&_nc_oc=AdklX0JK03BHNDpNMfeGhMOelJo0qpUiIId6GFUKfH0IY3bYWBCbhWBB3a2jD9REG9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyX_PIeiFe-wMlyjyQMZJy7IOlsuEop_fRpUcYukTVAMA&oe=69B8032B"}, "display_name": "Viking Days", "keywords": ["viking", "minigame", "arcade", "WarioWare", "JobSimulator"], "long_description": "Viking Days puts the \u201creality\u201d in \u201cVirtual Reality\u201d to show, through 10 minigames, the domestic life of the fine upstanding viking. Each mini-game showing clear instructions to the player, and making use of the VR motion controller in different ways for they to interact with the game world.\n\nAt each starting game, a random selection of minigames is sorted for the player. As they progress, more minigames are added to the tier, and the minigames that repeat gets increasingly tougher. After every win, the game will show the player their current winning-streak. The challenge here is to overpass the player\u2019s own high-score. How many days can they survive being a viking?\n\nForge swords, drink lots of mead, throw axes on targets, hunt for dragons, guide viking ships,  cross windy mountains, shield yourself from arrows and more! Live the good old viking days!", "short_description": "You usually see Vikings in epic battles of fury and glory, don't you? \nNow you are about to find out that the Viking daily life is as epic as the raids!\n\nPlay through 10 different minigames, and set high-scores of surviving them, proving to yourself how much of a Viking you truly are! Here you will meet the simple, regular side of the viking days: forge swords, drink jugs and jugs of mead, throw axes on targets, burn enemy ships. \nAnd sometimes, escape from Frost Giants."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": "http://www.vrmonkey.com.br/tos.html", "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://www.vrmonkey.com.br/projects/vikingdays", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "
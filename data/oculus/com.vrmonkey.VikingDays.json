d3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReul6d2GjEVnK3p04qPJ9kRLigml1yBq2FMsPbyjtT8w&oe=6B070F95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbs.png", "id": "927619194805632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974655_927619198138965_8077285034823667998_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xmcBQDLQkUQ7kNvwEmrU7i&_nc_oc=AdradZ2x-XUVLQnqSDgVbj7ccauccvUhanppalZBNUQGMXOWk2AT8Lczo-e9mWP9G5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg9l61dXImphFQNI94c_Sjg7zlRJPktX6EeIHrz-COtQ&oe=6B0722D3"}, "display_name": "Viking Days Remaster", "keywords": [], "long_description": "Face the domestic life of the fine upstanding viking in more than 16 mini challenges!\n\nInvite your newbie friends to compete with you in a EASY TO PLAY, HARD TO MASTER series of mini-games and show them who is the true Viking Master!\n\nViking Days is a game born to show the amazing and easy aspects of nowadays Virtual Reality! After the success of the game for old 3DOF platforms we bring a renew version for 6DOF exploring more of the freedom we have with 2 controllers and being able to move around the space.\n\nWith extra 6 days from the original game (total of 16), you will now be able to go down mountains skiing, enjoy the peace of fishing, compete in a target practice with arrow and bow and climb your way to obstacles and more!\n", "short_description": "How long can you survive the Viking Days?\nCompete in a series of minigames to see who is a true Viking!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrmonkey.com.br/tos.html", "developer_terms_of_service_url": null, "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://vrmonkey.com.br/projects/vikingdays/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "17009
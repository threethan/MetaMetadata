0_7616129411368091648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaSrMxyLVysQ7kNvwFLNW7G&_nc_oc=Adldc7KjY034dLd1wj9qjhgzAg60rxS2h9kvcXk-lAQAKWlTbiMUGAApjByfm0moXEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk2pInX8vsIou4Mq09PtpD1ikjMLzcv8uTC3lkzZWhdg&oe=69B6B53E"}, {"file_name": "migrated_image.png", "id": "223801985477508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522302_105107990329570_8442602675282903040_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3FDwVM4YBoQ7kNvwH7wXP6&_nc_oc=Admuu_Xyc0E45jpeJH-jYQG4vTXX9ub4OdHFUfpcAcDMyFmWolEGas7lSNQxYxicfv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZwYTtLzGFUGmCwbosRNJn9-tNz9mGi7eSFoxh2zFY5Q&oe=69B6B92C"}, {"file_name": "migrated_image.png", "id": "507716336593456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410355_326404937883864_1549964464885858304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg0KDjswZeoQ7kNvwHc0XrZ&_nc_oc=AdmAAb8S13LhN6pQ2fOpo7y7PUZEtZM6F8unLwYAra1Z3XLA2I6ek5ywGguYA3H6duA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFureAr_r94MZuqDMMuHsenNvOniAvaJ3b4BexBNjtQA&oe=69B6B8D1"}, {"file_name": "migrated_image.png", "id": "524803164889176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_1620981764645786_2912634043172388864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_pZVWctl9AQ7kNvwGeOwEW&_nc_oc=AdlAZYnJ5HBkoCfBdWbYLpJTcO36Z_xCrOdgYnhqN4E-NIaDnRZ6u8-zLW-pv5L2ZOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwO720urOZcqwoLH3v2LCudWqI9X3XausuMShIoZmF5EA&oe=69B6A973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Viking_Days_Landscape_2560x1440.png", "id": "225440854855882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_225440858189215_4420520554545545216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KhfE1ZNYyUQ7kNvwHJsZzx&_nc_oc=Adme5NsEatuRGesVm7KOtgXdcvjd6TriTqC9xhywlWLTxsMf623RIJYjZVPFV-daLuY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuhFfVCwOtQOgPvkXi_Waz4C9A1odyshaek_oPRS6a6A&oe=69B6B1AB"}, "display_name": "Viking Days", "keywords": ["viking", "minigame", "arcade", "WarioWare", "JobSimulator"], "long_description": "Viking Days puts the \u201creality\u201d in \u201cVirtual Reality\u201d to show, through 10 minigames, the domestic life of the fine upstanding viking. Each mini-game showing clear instructions to the player, and making use of the VR motion controller in different ways for they to interact with the game world.\n\nAt each starting game, a random selection of minigames is sorted for the player. As they progress, more minigames are added to the tier, and the minigames that repeat gets increasingly tougher. After every win, the game will show the player their current winning-streak. The challenge here is to overpass the player\u2019s own high-score. How many days can they survive being a viking?\n\nForge swords, drink lots of mead, throw axes on targets, hunt for dragons, guide viking ships,  cross windy mountains, shield yourself from arrows and more! Live the good old viking days!", "short_description": "You usually see Vikings in epic battles of fury and glory, don't you? \nNow you are about to find out that the Viking daily life is as epic as the raids!\n\nPlay through 10 different minigames, and set high-scores of surviving them, proving to yourself how much of a Viking you truly are! Here you will meet the simple, regular side of the viking days: forge swords, drink jugs and jugs of mead, throw axes on targets, burn enemy ships. \nAnd sometimes, escape from Frost Giants."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": "http://www.vrmonkey.com.br/tos.html", "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://www.vrmonkey.com.br/projects/vikingdays", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "
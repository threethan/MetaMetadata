bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuD6MJEsx64GzPw0eGoT7EO1xQBV4aoNJ5g3nZEVw3Mxw&oe=699DACAC"}, {"file_name": "migrated_image.png", "id": "507716336593456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410355_326404937883864_1549964464885858304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-kZrQqArQIQ7kNvwHPbtNM&_nc_oc=Adn3N5p_IVX_CHWLXt5wujHwJRUGUcvCcZ8OsWPjAowzo9NFoMmZZAwZieg4dCtNgAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuyqqfoQi3B55VhjXkWToBaSRXBXF5frAZkeGmGxykAew&oe=699DAC51"}, {"file_name": "migrated_image.png", "id": "524803164889176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331069_1620981764645786_2912634043172388864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDBPsK985qUQ7kNvwElyxb2&_nc_oc=Adk-e8kQmJsdhheI0kMWabVnogJwZCVboV8Cxaet9uXEl9eU9CtdiVPpQYh9S130Ydw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZVaD99XaZLMsANByTajkQeRb0z9Nl5uhAZdRDAPM5rQ&oe=699D9CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Viking_Days_Landscape_2560x1440.png", "id": "225440854855882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533893_225440858189215_4420520554545545216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIP-lP116zEQ7kNvwFHDR10&_nc_oc=AdlRany8ZXI9FK-iRmVxzytzC6GdHIAJno32mw-NLGVENi7EQPLt4SwE3oieNJL6qWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOSDCbAtignVevr0_pMmVGFsEZOq14dM7KLpyPbLS4OQ&oe=699DA52B"}, "display_name": "Viking Days", "keywords": ["viking", "minigame", "arcade", "WarioWare", "JobSimulator"], "long_description": "Viking Days puts the \u201creality\u201d in \u201cVirtual Reality\u201d to show, through 10 minigames, the domestic life of the fine upstanding viking. Each mini-game showing clear instructions to the player, and making use of the VR motion controller in different ways for they to interact with the game world.\n\nAt each starting game, a random selection of minigames is sorted for the player. As they progress, more minigames are added to the tier, and the minigames that repeat gets increasingly tougher. After every win, the game will show the player their current winning-streak. The challenge here is to overpass the player\u2019s own high-score. How many days can they survive being a viking?\n\nForge swords, drink lots of mead, throw axes on targets, hunt for dragons, guide viking ships,  cross windy mountains, shield yourself from arrows and more! Live the good old viking days!", "short_description": "You usually see Vikings in epic battles of fury and glory, don't you? \nNow you are about to find out that the Viking daily life is as epic as the raids!\n\nPlay through 10 different minigames, and set high-scores of surviving them, proving to yourself how much of a Viking you truly are! Here you will meet the simple, regular side of the viking days: forge swords, drink jugs and jugs of mead, throw axes on targets, burn enemy ships. \nAnd sometimes, escape from Frost Giants."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://www.vrmonkey.com.br/projects/vikingdays", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617344035992080"}}]}, "scheduled_offers": {"count": 46, "nodes": [{"status": "PUBLISHED", "id": "505954790106673"}, {"status": "PUBLISHED", "
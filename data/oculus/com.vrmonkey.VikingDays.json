pU0Ca7F2IwQ7kNvwFdffvP&_nc_oc=AdlH8nCROdroph2EX-52JzTtYVZ0itpZI5vY_u93liuqSo8lTv1NkqvONzK_jaeMK7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftN8B1EQO8sy371pqh0A9PeTwFkMMZgg927l_4cEb5LUw&oe=699862BE"}, {"file_name": "migrated_image.png", "id": "223801985477508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522302_105107990329570_8442602675282903040_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUJyW-TexAwQ7kNvwG-wQJZ&_nc_oc=AdmtgpSuYB4hPc9xE4MmFo3z427hjhKde86VbxkCvfTEbsook58NaCaAeWzj76_7UdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfssOyShv81u53J6_Q1oV-nOJkqO9QS3mtv354g2Cd6NWQ&oe=699866AC"}, {"file_name": "migrated_image.png", "id": "507716336593456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410355_326404937883864_1549964464885858304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWk-6x437rAQ7kNvwHQIh1Z&_nc_oc=Adk1-TYKoBNaqolGOod7WPZw_2eL4RIvkaqzTX9hgo88BQnCL_fS6jhCa8PGjaRTAAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsZ7A37iey8E4WNUuKeWa7G3Y1dt32BkXs9-zbNwtve0A&oe=69986651"}, {"file_name": "migrated_image.png", "id": "524803164889176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331069_1620981764645786_2912634043172388864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf0QvyO2ESsQ7kNvwFlO3-u&_nc_oc=AdnPkjlWfv3FUI4Sh3OvbZZfVexSHSwDLuHQCifF_I5GxJwsHXO1N93WCyTWf8hSJn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afspan_f_0GkDUKkXXuzAEEGHt2YYd_nNwdoMxKUbYMqhg&oe=699856F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Viking_Days_Landscape_2560x1440.png", "id": "225440854855882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_225440858189215_4420520554545545216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVqwhgnuCVMQ7kNvwHDEfSw&_nc_oc=Adkgt9KYIOW8JpR-u7tStdjZqsFDUcRtRQQsYQn0QgrMKegN-42y1M2T3ztieTT6QT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsOaNyZq3X9cb1TjCaCdbUVz2T6X-BUyNog7qihoqHJIg&oe=69985F2B"}, "display_name": "Viking Days", "keywords": ["viking", "minigame", "arcade", "WarioWare", "JobSimulator"], "long_description": "Viking Days puts the \u201creality\u201d in \u201cVirtual Reality\u201d to show, through 10 minigames, the domestic life of the fine upstanding viking. Each mini-game showing clear instructions to the player, and making use of the VR motion controller in different ways for they to interact with the game world.\n\nAt each starting game, a random selection of minigames is sorted for the player. As they progress, more minigames are added to the tier, and the minigames that repeat gets increasingly tougher. After every win, the game will show the player their current winning-streak. The challenge here is to overpass the player\u2019s own high-score. How many days can they survive being a viking?\n\nForge swords, drink lots of mead, throw axes on targets, hunt for dragons, guide viking ships,  cross windy mountains, shield yourself from arrows and more! Live the good old viking days!", "short_description": "You usually see Vikings in epic battles of fury and glory, don't you? \nNow you are about to find out that the Viking daily life is as epic as the raids!\n\nPlay through 10 different minigames, and set high-scores of surviving them, proving to yourself how much of a Viking you truly are! Here you will meet the simple, regular side of the viking days: forge swords, drink jugs and jugs of mead, throw axes on targets, burn enemy ships. \nAnd sometimes, escape from Frost Giants."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": "http://www.vrmonkey.com.br/tos.html", "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://www.vrmonkey.com.br/projects/vikingdays", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "gen
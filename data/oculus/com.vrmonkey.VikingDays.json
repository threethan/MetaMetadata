nc_ohc=Er_PhCUDJgoQ7kNvwFcsDwj&_nc_oc=AdrFSLpVa7pXUbPBFOCI86HskhJSaatI6WJhlSQYL-rKn_3kb5cGYlbh9Eg6iga7DWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReul6d2GjEVnK3p04qPJ9kRLigml1yBq2FMsPbyjtT8w&oe=6B070F95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbs.png", "id": "927619194805632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974655_927619198138965_8077285034823667998_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xmcBQDLQkUQ7kNvwEmrU7i&_nc_oc=AdradZ2x-XUVLQnqSDgVbj7ccauccvUhanppalZBNUQGMXOWk2AT8Lczo-e9mWP9G5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg9l61dXImphFQNI94c_Sjg7zlRJPktX6EeIHrz-COtQ&oe=6B0722D3"}, "display_name": "Viking Days Remaster - Mini Games", "keywords": ["minigames", "viking", "casual", "cheap", "party"], "long_description": "Face the domestic life of the fine upstanding viking in 17 mini challenges!\n\nInvite your newbie friends to compete with you in a EASY TO PLAY, HARD TO MASTER series of mini-games and show them who is the true Viking Master!\n\nViking Days is a game born to show the amazing and easy aspects of nowadays Virtual Reality! After the success of the game for old 3DOF platforms we bring a renew version for 6DOF exploring more of the freedom we have with 2 controllers and being able to move around the space.\n\nWith extra 7 days from the original game (total of 17), you will now be able to go down mountains skiing, enjoy the peace of fishing, compete in a target practice with arrow and bow and climb your way to obstacles and more!\n", "short_description": "How long can you survive the Viking Days?\nCompete in a series of minigames to see who is a true Viking!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrmonkey.com.br/tos.html", "developer_terms_of_service_url": null, "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://vrmonkey.com.br/projects/vikingdays/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25270387729230309"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974875_963584180904144_545446777364198543_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaJAF5JjyS4Q7kNvwG6Oaer&_nc_oc=Adr9V0J6T9ckTRf3DQPEdqdDdrXrsdumxc1UDCcI1zs9Qw2TRt_kmm_Qv1jY9mRYLnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ49GbItcrzaApiyQ1rwhmVYeJCv6MYlbCCvfbxgWeP5Q&oe=6B070EAF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Viking Days Remaster - Mini Games", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Role Playing", "id": "821934236779161"}], "release_date": 1637182122, "lastRevision": {"nodes": [{"id": "4191264177667506", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5058206260875087", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cer
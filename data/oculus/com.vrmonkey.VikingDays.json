_993767924109925_5873945892762943488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDNwbUfDXnEQ7kNvwEY9_lE&_nc_oc=AdqVoubGGCEzpyFOYlNTgxjucEQdZTX9YcfuUOQBpgClI1AVs-dkhDaEs0FCyuOVNYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2M8v6KVfGeTpxUg9PEJfNFm0GSTmzzv2vptZOSmCEDvw&oe=69F0A670"}, {"file_name": "migrated_image.png", "id": "211495946587332", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138782_1842106219194667_3208056114427985920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EstJHduNuJkQ7kNvwE6L0p0&_nc_oc=AdrxMYOydtB8BZZdFN7b4lFCwTGIqpXPB4vQmHXQtr7N5iPSdi4UijD-5-PrVrMn77s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2F-DspOF-mp3zHfxvSp-6TWYKAew6oRuAHR_iAyoe81A&oe=69F0B2E8"}]}, "id": "2591153310995862", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "232886261234058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138999_148716649297736_1781082552073715712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cr7ysmcTMoQ7kNvwFw-vJQ&_nc_oc=AdodlkS5my6B-FmAb2cPqtMlp3HAujcBocgAEjbeQC_XGSNElEs_5H7Al4JtWEUmU-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2CDBH-AR3_NR0IvKOeu8IJIu_OwAyh7gsxK0DobYs3_A&oe=69F0C96B"}, {"file_name": "migrated_image.png", "id": "1120751448285118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427574_1402218589879570_7616129411368091648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMVMjNB4u5UQ7kNvwGiVj31&_nc_oc=Ado1N8MNru2rOBl_sqcbJhtLOAXor7kIV8ccceQFFtTssUVUHCAjEt7Qd7s6-S-7qIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0YX7Mn7BPOptIVzA-L4ySt61GSNTaBdnRUUZuXkqVsBA&oe=69F0B73E"}, {"file_name": "migrated_image.png", "id": "223801985477508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522302_105107990329570_8442602675282903040_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR17z8y2zHkQ7kNvwGax8vO&_nc_oc=AdpW96gqVQw6ZuvEH6UZNnRYSVqTQ3GxpVvM11o8SYC_36N-ENDQdYaXC0ArLAJeufc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1qKp0MDqAo6rlkm9jNBKAbF0i5Un295tyR-OSxJlOKMw&oe=69F0BB2C"}, {"file_name": "migrated_image.png", "id": "507716336593456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410355_326404937883864_1549964464885858304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MWlp14Q4jwQ7kNvwEyh092&_nc_oc=Adq9nemKoxtDHsUxlapztBelJYi57ttCpx3UhPOWPq5jSnIrozYsuFFDnGOyz2Z5YlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3SjcCItGKvLorXPsf6DB2dvJ9uqsDMJwRDuQ_V4z9BFw&oe=69F0BAD1"}, {"file_name": "migrated_image.png", "id": "524803164889176", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_1620981764645786_2912634043172388864_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYXrKe83cwUQ7kNvwGc466R&_nc_oc=AdrDrfu5MCWztctJK75CAs8KYzTaRsRIkTdboNmpgsQAzjR2jAlQSDOlgRgAgeRfV2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0G1LYwh4vKDlJYDHvOvlSUXPqWaOUWaO-iR72EIdSCYg&oe=69F0AB73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Viking_Days_Landscape_2560x1440.png", "id": "225440854855882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_225440858189215_4420520554545545216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz0cs2cThIAQ7kNvwEPdstF&_nc_oc=AdrwT-3iHIW4nxf1O_ooMf9bJWJ7y3dDKpWpw1-ylbTpmwswmm6tDuIzZIOQ1ILnY5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Ura9_ysd25_v7X0UNYZRK1dMb7WLjM-DWETKeJA9-aA&oe=69F0B3AB"}, "display_name": "Viking Days", "keywords": ["viking", "minigame", "arcade", "WarioWare", "JobSimulator"], "long_description": "Viking Days puts the \u201creality\u201d in \u201cVirtual Reality\u201d to show, through 10 minigames, the domestic life of the fine upstanding viking. Each mini-game showing clear instructions to the player, and making use of the VR motion controller in different ways for they to interact with the game world.\n\nAt each starting game, a random selection of minigames is sorted for the player. As they progress, more minigames are added to the tier, and the minigames that repeat gets increasingly tougher. After every win, the game will show the player their current winning-streak. The challenge here is to overpass the player\u2019s own high-score. How many days can they survive being a viking?\n\nForge swords, drink lots of mead, throw axes on targets, hunt for dragons, guide viking ships,  cross windy mountains, shield yourself from arrows and more! Live the good old viking days!", "short_description": "You usually see Vikings in epic battles of fury and glory, don't you? \nNow you are about to find out that the Viking daily life is as epic as the raids!\n\nPlay through 10 different minigames, and set high-scores of surviving them, proving to yourself how much of a Viking you truly are! Here you will meet the simple, regular side of the viking days: forge swords, drink jugs and jugs of mead, throw axes on targets, burn enemy ships. \nAnd sometimes, escape from Frost Giants."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": null, "website_url": "http://www.vrmonkey.com.br/projects/vikingdays", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617344035992080"}}]}, "scheduled_offers": {"count": 46, "nodes": [{"status": "PUBLISHED", "id": "505954790106673"}, {"status": "PUBLISHED", "
shot 2026-09-29 163804.png", "id": "1484399766858538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499621314_1484399770191871_3652179747651053098_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GodioMOcRGUQ7kNvwE9HNkB&_nc_oc=AdoIEM7Ugw22tzSXJjz_t09dwuNBp27jweqd3aHOr0p3SbGCr4gG71DdhPj52_TGQek&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3B9h9s8URm7sKX__X91j3TD8aAmziZrE6pA1Tns6CPw&oe=6AFF2501"}, {"file_name": "Screenshot 2026-09-29 164137.png", "id": "2180086842619460", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628454_2180086845952793_248127985514092714_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHHuCQoHg2AQ7kNvwEh8m6o&_nc_oc=Adol6c1n9-NuU8f2hLZQWJtC3IUkbQNDdGH_L4pcEpWiiPCx0Nl7tYvQHK7w82qpaWo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiXX3oGqxfNBt4GENBZsEGT4OQoQrWBzv1x1E7jTDbRg&oe=6AFF1890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bbaa.png", "id": "1096022503029395", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499626808_1096022509696061_5549746276474249090_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9UFztTqPrsQ7kNvwGDqYVB&_nc_oc=AdoGjjQqSU7L1PWGJZZ0wB7d8KxIb8RXvcTx1pyVD0L42VR3-tG2faBXTCCqI54gwR0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9m6Cymmh2e6KyELaiocQL1RgeBujc0l_aPhVkjtkBzw&oe=6AFF22E6"}, "display_name": "PlayboxVR", "keywords": ["sandbox", "vr", "sandboxgame", "Playbox", "fun"], "long_description": "Playbox VR is a multiplayer sandbox where you can spawn objects, build with friends, and mess around in VR.\nBuild maps together using tools to move, rotate, resize, and freeze objects. Save your builds in Inventions, add Play Circuits to make them do things, and share them with other players in private sandbox rooms.\nHide and Seek puts one seeker against up to nine hiders. The seeker has three minutes and 12 shots. Hiders can place cubes and decoys, then freeze themselves in place to make the seeker guess who\u2019s real.\nYou can also change your fur, wear cosmetics, talk with friends through voice chat, and take photos or record videos with the in-game camera.", "short_description": "Build with friends, play Hide and Seek, customize your character, and create your own fun in Playbox VR, a multiplayer VR sandbox."}]}, "developer_name": "Coolez", "developer_privacy_policy_url": "https://sites.google.com/view/playbox-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Alexander", "support_website_url": null, "website_url": "https://sites.google.com/view/playbox-vr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1620363082971897"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593749142_1795430542590054_8995337270858852105_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOHncE_iODUQ7kNvwFIhLCZ&_nc_oc=Adpd70IYjYYwIqw41ZOhvR6FToX6coejftlGNS4VQMt98j_eThlchlhrwIn5GW5HEug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGOzYlhWCLFsKa8nUw6yOXSSpk8HWYafCmunp3LcomHw&oe=6AFF0585"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PlayboxVR", "platfor
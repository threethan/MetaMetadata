shot 2026-09-29 163804.png", "id": "1484399766858538", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499621314_1484399770191871_3652179747651053098_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lUWQaMCAYYQ7kNvwHCqG6y&_nc_oc=Adp-ptb3DsVV9v1sg7tc8_rXw7fsuMPgKjAmKrNCKOxlot8EPRhVa3_RC20PLDsNJIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4_8viqd5vFlsPtauu_mdKDcR-5yunZeyKAo4fAJeaDw&oe=6B031981"}, {"file_name": "Screenshot 2026-09-29 164137.png", "id": "2180086842619460", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628454_2180086845952793_248127985514092714_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXtaDGtYFhcQ7kNvwEewSMm&_nc_oc=AdrmVyHY8R-pmngtMQM4X0hRGYo3uxCpeash7Yu5clueJpqhm_ZYpw2xoX-6HN7DDAU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXyhW-pgcifW7_M_ucAbmaqeUbYdnO54MJoVy5W-O2kQ&oe=6B030D10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bbaa.png", "id": "1096022503029395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626808_1096022509696061_5549746276474249090_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6rFy3XCxCwQ7kNvwECHi2o&_nc_oc=AdomDRYK8lQ_Tx24iOCaffAckzJVQ26go3CgluidIdEokyJjjLjuLgD5VbgOUvh0hh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzq8-hw437GBXvy6djyzct0vrGp-h1YPrgBAJ79ztgTg&oe=6B031766"}, "display_name": "PlayboxVR", "keywords": ["sandbox", "vr", "sandboxgame", "Playbox", "fun"], "long_description": "Playbox VR is a multiplayer sandbox where you can spawn objects, build with friends, and mess around in VR.\nBuild maps together using tools to move, rotate, resize, and freeze objects. Save your builds in Inventions, add Play Circuits to make them do things, and share them with other players in private sandbox rooms.\nHide and Seek puts one seeker against up to nine hiders. The seeker has three minutes and 12 shots. Hiders can place cubes and decoys, then freeze themselves in place to make the seeker guess who\u2019s real.\nYou can also change your fur, wear cosmetics, talk with friends through voice chat, and take photos or record videos with the in-game camera.", "short_description": "Build with friends, play Hide and Seek, customize your character, and create your own fun in Playbox VR, a multiplayer VR sandbox."}]}, "developer_name": "Coolez", "developer_privacy_policy_url": "https://sites.google.com/view/playbox-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Alexander", "support_website_url": null, "website_url": "https://sites.google.com/view/playbox-vr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1620363082971897"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593749142_1795430542590054_8995337270858852105_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0z7rw8kftUQ7kNvwGK6PzQ&_nc_oc=AdoFrGB5o8rpgru621nSw_HXNsA0NG9QfcYOG-oc97NT6SD21VD83SyLtbDQHyhH5GY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV-viHiS62DcwfK2N850CGG4qWJkA_tk5yS1C4XZibVA&oe=6B033245"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PlayboxVR", "platfor
hc=A7jOWCqVsBQQ7kNvwFdKdIs&_nc_oc=AdqSFY4uJ4tvBS9G6p1uhJsRJNt6-XGEYmecx1H06mVfsHcBRpjM7n8OxW8ZbpIjmIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDTcUW-46-4L4KDkAyw_5yGnt3BqImVBU6i5jwDDDjng&oe=6AF88D81"}, {"file_name": "Screenshot 2026-09-29 164137.png", "id": "2180086842619460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628454_2180086845952793_248127985514092714_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd70KNbdw3AQ7kNvwGnC6j2&_nc_oc=AdrKvqWLrLF6xgvSmoUmwsia5FjjctVJMKuPl_jJ9cenZO7Dtl-Oo3jfgbM0AjjSoOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSeFBv4SNU1m-xnSwdJmCMAYqg83ie2j6IJosxcKBjAQ&oe=6AF88110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bbaa.png", "id": "1096022503029395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626808_1096022509696061_5549746276474249090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fn7CukjGTEQ7kNvwGiDpv3&_nc_oc=Adqit6-0Iwd_7zSoPHRj2HvKIsPEsy0PVeI_CD8hRUOa7Pr5vBRaRec92AqBw-xlIZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT_JjcpRoxepoJrRZEAmOstJr8P5SFj31A3bv62rKfcg&oe=6AF88B66"}, "display_name": "PlayboxVR", "keywords": ["sandbox", "vr", "sandboxgame", "Playbox", "fun"], "long_description": "Playbox VR is a multiplayer sandbox where you can spawn objects, build with friends, and mess around in VR.\nBuild maps together using tools to move, rotate, resize, and freeze objects. Save your builds in Inventions, add Play Circuits to make them do things, and share them with other players in private sandbox rooms.\nHide and Seek puts one seeker against up to nine hiders. The seeker has three minutes and 12 shots. Hiders can place cubes and decoys, then freeze themselves in place to make the seeker guess who\u2019s real.\nYou can also change your fur, wear cosmetics, talk with friends through voice chat, and take photos or record videos with the in-game camera.", "short_description": "Build with friends, play Hide and Seek, customize your character, and create your own fun in Playbox VR, a multiplayer VR sandbox."}]}, "developer_name": "Coolez", "developer_privacy_policy_url": "https://sites.google.com/view/playbox-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Alexander", "support_website_url": null, "website_url": "https://sites.google.com/view/playbox-vr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1620363082971897"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593749142_1795430542590054_8995337270858852105_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPKmxmFXQh0Q7kNvwEGlmDK&_nc_oc=AdqICFMBz1NUjTNdr1Z8nsJEuGi9ZtiBv36evk3ZTlybOfcMAoz3lciqf-aztmVqS5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAMFnzRRvZsWO2AbVjruMkWoVb-z7lOlWSxuPjafeJrg&oe=6AF8A645"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PlayboxVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1791326760, "lastRevision": {"nodes": [{"id": "1614884926853046", "releas
me": "control-panel-back-to-panel.png", "id": "1520524856308040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618102_1520524859641373_6774726673041331582_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwxvJUSCGYQQ7kNvwE9vc_S&_nc_oc=Ado2l7MkaAVARkQ1qi4BhiJvzcVgzGcLfcI_Pkpu85qXjDROjWXYXYZLJRah1_VOR9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm_C5KjCs6wmwUHBgucTC703QuPtU0zrANstiEYnipZQ&oe=6AEB3263"}, {"file_name": "control-panel.png", "id": "2932686836936288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_2932686840269621_2512804701809707552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdsxc1xIysMQ7kNvwEyRzqk&_nc_oc=AdoS8NofFueBshpSLrpb5-Hv_Q6ZY0CDmDkAOtIMSl1WYFRmmNt07U9j9ctJAH-9l8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe12zTbrXU8U5tqgg64iopVia7otWEKmYGgxf2Pf51-w&oe=6AEB3EC4"}, {"file_name": "scene 9 2560 by 1440.jpg.png", "id": "926280673651219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_926280680317885_659177831053008846_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfxIccUopdEQ7kNvwGSpipU&_nc_oc=Adro2MAMtIaYkv5xI9LgyKtoXEtUubyHS8JBozrFYOhp1pogsZL_opLRsr0COJUn1A4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEJFR2BsLZxzURJkNLeklm57NbJ8_EsfWOvt-9H33WLA&oe=6AEB5F0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1464862578526713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620965_1464862581860046_1278782480344194689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyESnKUC8GAQ7kNvwGce1z4&_nc_oc=AdqrHZ6Np5wqKZtNhVqE7ZMaGzUm_lkxv4WDHOKf5DO9cFXteQs5OTvWtKET_H1E-ZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShcG6vR8CTTp8CTb_u9RUazGFI98Za_9O3W9kG7zf3eg&oe=6AEB4791"}, "display_name": "AmblyoTube", "keywords": ["Amblyobia", "Lazyeye", "vision", "training", "coordination"], "long_description": "# Amblyotube \u2013 Immersive Vision Training for Amblyopia\n\n**Amblyotube** is a VR-based vision training app designed to support individuals with **amblyopia (lazy eye)**. Built for platforms like Meta Quest, it uses **dichoptic viewing** to deliver separate visual inputs to each eye, helping the brain improve **binocular vision** and depth perception.\n\nThe app allows users to select their lazy eye and automatically applies a **shader to the dominant eye** (reducing clarity via blur, brightness, or opacity) while enhancing the weaker eye using **AI-driven sharpening**. A unique **flicker stimulation** feature further activates the lazy eye by drawing the brain\u2019s attention to key objects.\n\nAmblyotube integrates **YouTube**, enabling users to watch their favorite content while training\u2014making sessions engaging and consistent compared to traditional methods like patching.AmblyoTube plays video from the internet (including YouTube). A stable internet connection is required. Video is provided by third-party services; availability and terms are controlled by those services and may change.\n\nProduct Explainer: https://www.amblyotube.com/product-explainer/\n\nUnlike full eye patching, Amblyotube promotes both eyes working together, improving coordination and spatial awareness. It is ideal for daily 30\u201340 minute sessions for users aged 13+.\n\n**Note:** Amblyotube is an assistive training tool and does not replace medical treatment. Consult an eye care professional for guidance.", "short_description": "Amblyotube is a virtual reality (VR) vision training and assistive software designed for individuals with lazy eye syndrome (amblyopia). Developed by Seven Sportz, the application runs on the Meta Quest headset and utilizes its dual eyepieces to provide independent visual inputs to each eye while the user watches YouTube videos.\n\nThe tool functions through two primary mechanisms:\n*   Dominant Eye Shader: Shades the dominant eye\n*   Lazy Eye Sharpner:  Sharpens and flickers humans in lazy eye"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amblyotube.com/legal/privacy/", "developer_terms_of_service_url": "https://www.amblyotube.com/legal/terms/", "publisher_name": "Amblyotube", "support_website_url": "https://www.amblyotube.com/contact/", "website_url": "https://www.amblyotube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25906906999005157"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1414550539995645_1281465442959175170_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhPE24xQqaoQ7kNvwGZQ3zM&_nc_oc=Adp0pL-DcM1-okyHS5o6lZ1C_VeV1jc9-gp_cP2xtuW_oA6-WkmCxVYAv-8CNspF8DQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaKCk-9DRCW726utVb-eP7E3OBJIMrbQ25UVqbVB5cAA&oe=6AEB585D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AmblyoTube", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1774709340, "lastRevision": {"nodes": [{"id": "25906907032338487", "release_type": "SCHEDULED", "administration_statu
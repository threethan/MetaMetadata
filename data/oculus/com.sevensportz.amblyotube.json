64.5771-25/499618102_1520524859641373_6774726673041331582_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBcYfVxLTz4Q7kNvwEXHh5e&_nc_oc=AdobAPSe5ep8r6mvDjbz7o54ix1W-sPPyStkRkXQmIVB-jEaCeHJKlXXFSfoexnsuXw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q9IRlmkGSPypRJocXojlxXiTb4yJz146U9yKOEtzhvA&oe=6A33F1E3"}, {"file_name": "control-panel.png", "id": "2932686836936288", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618254_2932686840269621_2512804701809707552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_VYhUH9oLAQ7kNvwGKqWJ1&_nc_oc=AdqyW9zAZ7nludcaqBMjZaqp2Ymv4rLmskDxyeJLjfcAecmvC5Q_3Vr7anZxf9qHjgM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80lbu7kWQETVj_LH6W78F0rIlRn2H0iBMvETooxbdO1g&oe=6A33FE44"}, {"file_name": "scene 9 2560 by 1440.jpg.png", "id": "926280673651219", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618264_926280680317885_659177831053008846_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvgIiLbPKwkQ7kNvwEkW-OX&_nc_oc=AdqAuzn2XqWs0H1vhJy2XM_C5C3Fo3cfsSKx8eeXcHXTNJ-FBEp9_702iHYFjmmk3xM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LEfpz7x0MeqqWRluynAQGQ__sU-iWYF4u2qSW3xzzIQ&oe=6A341E8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1464862578526713", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620965_1464862581860046_1278782480344194689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUysNEy3EVgQ7kNvwGmdbhA&_nc_oc=AdqI6-_JCy3gC1zA9phRPKQW1tWefrMAuMrxA8gLQ7njCMthSfSe775fvp9w6tYbbXU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yRjmm-bJLyQvjT7vdAmQxBP9g3Ynq_rLcKKTJLsdOOg&oe=6A340711"}, "display_name": "AmblyoTube", "keywords": ["Amblyobia", "Lazyeye", "vision", "training", "coordination"], "long_description": "# Amblyotube \u2013 Immersive Vision Training for Amblyopia\n\n**Amblyotube** is a VR-based vision training app designed to support individuals with **amblyopia (lazy eye)**. Built for platforms like Meta Quest, it uses **dichoptic viewing** to deliver separate visual inputs to each eye, helping the brain improve **binocular vision** and depth perception.\n\nThe app allows users to select their lazy eye and automatically applies a **shader to the dominant eye** (reducing clarity via blur, brightness, or opacity) while enhancing the weaker eye using **AI-driven sharpening**. A unique **flicker stimulation** feature further activates the lazy eye by drawing the brain\u2019s attention to key objects.\n\nAmblyotube integrates **YouTube**, enabling users to watch their favorite content while training\u2014making sessions engaging and consistent compared to traditional methods like patching.AmblyoTube plays video from the internet (including YouTube). A stable internet connection is required. Video is provided by third-party services; availability and terms are controlled by those services and may change.\n\nProduct Explainer: https://www.amblyotube.com/product-explainer/\n\nUnlike full eye patching, Amblyotube promotes both eyes working together, improving coordination and spatial awareness. It is ideal for daily 30\u201340 minute sessions for users aged 13+.\n\n**Note:** Amblyotube is an assistive training tool and does not replace medical treatment. Consult an eye care professional for guidance.", "short_description": "Amblyotube is a virtual reality (VR) vision training and assistive software designed for individuals with lazy eye syndrome (amblyopia). Developed by Seven Sportz, the application runs on the Meta Quest headset and utilizes its dual eyepieces to provide independent visual inputs to each eye while the user watches YouTube videos.\n\nThe tool functions through two primary mechanisms:\n*   Dominant Eye Shader: Shades the dominant eye\n*   Lazy Eye Sharpner:  Sharpens and flickers humans in lazy eye"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amblyotube.com/legal/privacy/", "developer_terms_of_service_url": "https://www.amblyotube.com/legal/terms/", "publisher_name": "Amblyotube", "support_website_url": "https://www.amblyotube.com/contact/", "website_url": "https://www.amblyotube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25906906999005157"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1635568977482846"}]}, "baseline_offer": {"id": "1635568977482846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774709340, "status": "PUBLISHED", "id": "1635568977482846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26836139632748551", "version": "1"}, "id": "1277350734590507", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26836139632748551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "A cozier room to watch in \ud83d\udecb\ufe0f\n\nYour therapy room got a complete makeover \u2014 the sofa, armchair, bookcase, coffee table, rug and floor now have warm, natural colors and textures instead of plain grey.\nNew decorations make it feel like a real living room: hanging ceiling lamps, paintings on the walls, cushions on the sofa, a side table with a small plant, and books on the coffee table.\nSoft, warm lighting creates a relaxed evening atmosphere \u2014 like watching TV at home.\nCeiling lamps are placed to the sides so nothing blocks your view of the video screen.\nEvery room is decorated a little differently, but yours will always look the same each time you start the app.\nComing soon: choose between different room styles, like a bedroom or drawing room.", "created_date": 1781071804, "id": "26836139632748551", "version": "1", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26836139632748551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "What\u2019s new in this release\nEasier exit from VR\n\nQuit app on the therapy panel (same style as Reset All).\nQuit app on the wrist menu when you look at your left wrist (below Back to panel).\nUse these if you want to leave the app without using the system menu.", "created_date": 1779171865, "id": "26561499780212539", "version": "1", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26836139632748551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "What\u2019s new \nFocus point for therapy\nYou can turn on a gentle moving spotlight on the video. It helps draw attention to one area at a time. For the eye you\u2019re training, that spot appears in a bright pink\u2011purple so it\u2019s easy to notice. For the other eye, the same area is toned down in a soft, neutral way so the two eyes don\u2019t see the same thing\u2014supporting the kind of two\u2011eyes, different view exercise your clinician may recommend.\n\nLanguages\nThe app\u2019s menus and on\u2011screen messages are now available in several languages, including English, Japanese, Korean, French, and German. You can pick your language in the therapy panel, and the app will remember your choice next time you open it.\n\nAmblyoTube is a therapy aid; always follow your eye care professional\u2019s guidance.", "created_date": 1777434130, "id": "26322322434130276", "version": "1", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26836139632748551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "You can choose your language right in the therapy panel. Each option is shown the way people who speak that language would write it (for example, Japanese and Korean are shown in their own script), so it\u2019s easier to find your language at a glance.\nJapanese and Korean now show proper characters from the start, not empty boxes, even if the rest of the app is still in English.\nThe language choices are clearer and easier to tap, and they match the look of the other small option buttons nearby, so the screen feels more consistent and comfortable to use.", "created_date": 1776871104, "id": "26243379445357909", "version": "1", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26836139632748551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "Therapy panel (Quest / Meta layout)\nLeft column fits the panel \u2014 If there are many therapy controls, the left column scales down so everything (including Reset All) stays on the panel and stays reachable with hands and rays. You should no longer lose buttons because they sit outside the interactive area.", "created_date": 1776365552, "id": "26183982564630931", "version": "1", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
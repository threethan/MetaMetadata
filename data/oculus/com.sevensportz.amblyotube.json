nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz4l-1ZPakO5rNL4uQLbnaHKNz_SuWWsYhGrmx1Pex9Q&oe=6AEB6061"}, {"file_name": "control-panel-back-to-panel.png", "id": "1520524856308040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618102_1520524859641373_6774726673041331582_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwxvJUSCGYQQ7kNvwE9vc_S&_nc_oc=Ado2l7MkaAVARkQ1qi4BhiJvzcVgzGcLfcI_Pkpu85qXjDROjWXYXYZLJRah1_VOR9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm_C5KjCs6wmwUHBgucTC703QuPtU0zrANstiEYnipZQ&oe=6AEB3263"}, {"file_name": "control-panel.png", "id": "2932686836936288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_2932686840269621_2512804701809707552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdsxc1xIysMQ7kNvwEyRzqk&_nc_oc=AdoS8NofFueBshpSLrpb5-Hv_Q6ZY0CDmDkAOtIMSl1WYFRmmNt07U9j9ctJAH-9l8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe12zTbrXU8U5tqgg64iopVia7otWEKmYGgxf2Pf51-w&oe=6AEB3EC4"}, {"file_name": "scene 9 2560 by 1440.jpg.png", "id": "926280673651219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_926280680317885_659177831053008846_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfxIccUopdEQ7kNvwGSpipU&_nc_oc=Adro2MAMtIaYkv5xI9LgyKtoXEtUubyHS8JBozrFYOhp1pogsZL_opLRsr0COJUn1A4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEJFR2BsLZxzURJkNLeklm57NbJ8_EsfWOvt-9H33WLA&oe=6AEB5F0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1464862578526713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620965_1464862581860046_1278782480344194689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyESnKUC8GAQ7kNvwGce1z4&_nc_oc=AdqrHZ6Np5wqKZtNhVqE7ZMaGzUm_lkxv4WDHOKf5DO9cFXteQs5OTvWtKET_H1E-ZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShcG6vR8CTTp8CTb_u9RUazGFI98Za_9O3W9kG7zf3eg&oe=6AEB4791"}, "display_name": "AmblyoTube", "keywords": ["Amblyobia", "Lazyeye", "vision", "training", "coordination"], "long_description": "# Amblyotube \u2013 Immersive Vision Training for Amblyopia\n\n**Amblyotube** is a VR-based vision training app designed to support individuals with **amblyopia (lazy eye)**. Built for platforms like Meta Quest, it uses **dichoptic viewing** to deliver separate visual inputs to each eye, helping the brain improve **binocular vision** and depth perception.\n\nThe app allows users to select their lazy eye and automatically applies a **shader to the dominant eye** (reducing clarity via blur, brightness, or opacity) while enhancing the weaker eye using **AI-driven sharpening**. A unique **flicker stimulation** feature further activates the lazy eye by drawing the brain\u2019s attention to key objects.\n\nAmblyotube integrates **YouTube**, enabling users to watch their favorite content while training\u2014making sessions engaging and consistent compared to traditional methods like patching.AmblyoTube plays video from the internet (including YouTube). A stable internet connection is required. Video is provided by third-party services; availability and terms are controlled by those services and may change.\n\nProduct Explainer: https://www.amblyotube.com/product-explainer/\n\nUnlike full eye patching, Amblyotube promotes both eyes working together, improving coordination and spatial awareness. It is ideal for daily 30\u201340 minute sessions for users aged 13+.\n\n**Note:** Amblyotube is an assistive training tool and does not replace medical treatment. Consult an eye care professional for guidance.", "short_description": "Amblyotube is a virtual reality (VR) vision training and assistive software designed for individuals with lazy eye syndrome (amblyopia). Developed by Seven Sportz, the application runs on the Meta Quest headset and utilizes its dual eyepieces to provide independent visual inputs to each eye while the user watches YouTube videos.\n\nThe tool functions through two primary mechanisms:\n*   Dominant Eye Shader: Shades the dominant eye\n*   Lazy Eye Sharpner:  Sharpens and flickers humans in lazy eye"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amblyotube.com/legal/privacy/", "developer_terms_of_service_url": "https://www.amblyotube.com/legal/terms/", "publisher_name": "Amblyotube", "support_website_url": "https://www.amblyotube.com/contact/", "website_url": "https://www.amblyotube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25906906999005157"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1635568977482846"}]}, "baseline_offer": {"id": "1635568977482846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774709340, "status": "PUBLISHED", "id": "1635568977482846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28585281691167661", "version": "1"}, "id": "1277350734590507", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28585281691167661"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "Upgraded the app to show HD video streams. the app initially shows an SD stream and in parallel downloads HD stream and once it is downloaded it changes to HD stream.", "created_date": 1793285832, "id": "28585281691167661", "version": "1", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28585281691167661"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "What's new in this update\r\n\r\nNew wedge option The therapy panel has a new wedge setting, alongside the existing occlusion options. You can turn it on, adjust it to each eye, and reset it at any time from the same panel \u2014 no other steps needed.\r\n\r\nRoom View You can now switch between the virtual therapy room and your real surroundings. Turn on Room View from the left-side menu and the virtual room fades away so you can see your own room around the video screen and control panel, while everything else keeps working exactly as before. Turn it off to return to the virtual room.\r\n\r\nRoom View is off when the app starts, so nothing changes unless you switch it on. It needs no extra permissions and works on Quest 2, Quest 3 / 3S, and Quest Pro.\r\n\r\nAlso in this update\r\n\r\nThe startup video has been updated to the latest explainer.\r\nGeneral stability improvements.", "created_date": 1792283153, "id": "28428245366871295", "version": "1", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28585281691167661"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791810066, "id": "28349837051378794", "version": "1", "version_code": 19, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28585281691167661"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791632265, "id": "28323091944053305", "version": "1", "version_code": 18, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28585281691167661"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "Vision Check \u2014 New Feature\r\nA new LogMAR visual acuity test is now available from the therapy panel. Look for the \"Vision Check\" button under the Lazy Eye section.\r\n\r\nHow it works:\r\n\r\nTests each eye separately, then both eyes together\r\nLandolt C optotypes appear at 3m \u2014 indicate the gap direction (up/down/left/right) or tap \"Not Visible\"\r\nUp to 30 trials per eye using a clinical staircase algorithm\r\nThe untested eye is fully blacked out so you can focus on one eye at a time\r\nAfter the test:\r\n\r\nYour scores (logMAR) are shown for left eye, right eye, and both eyes\r\nA recommendation appears if the test suggests a different lazy eye side or severity level compared to your current settings\r\nYou can choose \"Apply Changes\" to update your therapy profile, or \"Keep Current\" to retain your existing setup\r\nNotes:\r\n\r\nThis is a screening tool for therapy guidance only \u2014 not a clinical diagnosis\r\nProgress and current logMAR are shown on-screen during the test\r\nFind a quiet, well-lit room and do the test with your glasses on.", "created_date": 1785301706, "id": "27391057110590131", "version": "1", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
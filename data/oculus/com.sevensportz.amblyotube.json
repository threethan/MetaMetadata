oc=Adr5jb6RW53-aFe7gLbDGq7ONmrd-mT0EFxDWleBqc9fUsyqRyvSCWrAdOIJZ9dh-ew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yrrg77wiRJ8GsxM7jff0dlDgeEV6P08iCoNBdRT7xyg&oe=69D65763"}, {"file_name": "control-panel.png", "id": "2932686836936288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_2932686840269621_2512804701809707552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT-CdcKNz-cQ7kNvwGW6A4P&_nc_oc=AdpvmvvoiCwsIpKTh6BsferL5Pdm4pmv_p2p-oYCJ-WS17H0oZ9MQ2DKptFUSbSUSnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ewcrd40ELxqZWQZosi2EkoFum163tdRMqJvBVUJPa-g&oe=69D663C4"}, {"file_name": "scene 9 2560 by 1440.jpg.png", "id": "926280673651219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_926280680317885_659177831053008846_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzGF1koHq8sQ7kNvwFI4NA4&_nc_oc=Adp_zlYCJ1rFtE3U5w92xWbc8GJ8I36Tt0Zab_HdvLXuDsYVaOpVxq3hTP13V--OhoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xSzHu-pIW-h8O0vZSsTPc0nnbSCKYO_PdmKg0Cgel_A&oe=69D64BCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1464862578526713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620965_1464862581860046_1278782480344194689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wHFxCi7jF4Q7kNvwEvrOBZ&_nc_oc=AdqWN-P-V_N0w-0ZnROgHzakNmLOKJ7fMeWmbcus87UBzUuB5C1TFy1opjUftYHhMOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35jkpLuKCO8rq6dAqg65LlzWOPJcuWh0BSH1eSlWr0Hg&oe=69D63451"}, "display_name": "AmblyoTube", "keywords": ["Amblyobia", "Lazyeye", "vision", "training", "coordination"], "long_description": "# Amblyotube \u2013 Immersive Vision Training for Amblyopia\n\n**Amblyotube** is a VR-based vision training app designed to support individuals with **amblyopia (lazy eye)**. Built for platforms like Meta Quest, it uses **dichoptic viewing** to deliver separate visual inputs to each eye, helping the brain improve **binocular vision** and depth perception.\n\nThe app allows users to select their lazy eye and automatically applies a **shader to the dominant eye** (reducing clarity via blur, brightness, or opacity) while enhancing the weaker eye using **AI-driven sharpening**. A unique **flicker stimulation** feature further activates the lazy eye by drawing the brain\u2019s attention to key objects.\n\nAmblyotube integrates **YouTube**, enabling users to watch their favorite content while training\u2014making sessions engaging and consistent compared to traditional methods like patching.AmblyoTube plays video from the internet (including YouTube). A stable internet connection is required. Video is provided by third-party services; availability and terms are controlled by those services and may change.\n\nProduct Explainer: https://www.amblyotube.com/product-explainer/\n\nUnlike full eye patching, Amblyotube promotes both eyes working together, improving coordination and spatial awareness. It is ideal for daily 30\u201340 minute sessions for users aged 13+.\n\n**Note:** Amblyotube is an assistive training tool and does not replace medical treatment. Consult an eye care professional for guidance.", "short_description": "Amblyotube is a virtual reality (VR) vision training and assistive software designed for individuals with lazy eye syndrome (amblyopia). Developed by Seven Sportz, the application runs on the Meta Quest headset and utilizes its dual eyepieces to provide independent visual inputs to each eye while the user watches YouTube videos.\n\nThe tool functions through two primary mechanisms:\n*   Dominant Eye Shader: Shades the dominant eye\n*   Lazy Eye Sharpner:  Sharpens and flickers humans in lazy eye"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amblyotube.com/legal/privacy/", "developer_terms_of_service_url": "https://www.amblyotube.com/legal/terms/", "publisher_name": "Amblyotube", "support_website_url": "https://www.amblyotube.com/contact/", "website_url": "https://www.amblyotube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25906906999005157"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1414550539995645_1281465442959175170_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEY0gggc3y4Q7kNvwG854oh&_nc_oc=Ado-HTMS510FxXw7BFYXicgxTx9ijLtGlWiHst7OcOiiphPF1HNWlOHN7_p1TK_hdDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YdL7xEj6f1kFvtTEQMq-t82sBJFeomK9JUiqVLFbT9g&oe=69D6451D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AmblyoTube", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1774709340, "lastRevision": {"nodes": [{"id": "25906907032338487", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25906906972338493", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "875546532174040"}, "ia
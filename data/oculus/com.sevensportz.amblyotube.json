64.5771-25/499618102_1520524859641373_6774726673041331582_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryA_PrJ2aqoQ7kNvwEd7gnE&_nc_oc=AdpQjsYmm4BFJsCxYddxpQfD1GwrDXb-EMPZ-Qe7a9JMmpZaH39m40it8m-n51XDaTM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j6InWlnkX8y5kduL0h39QYWk_JvwXiMVqwh5Kps-Z-w&oe=6A05CD63"}, {"file_name": "control-panel.png", "id": "2932686836936288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_2932686840269621_2512804701809707552_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNLK6eJg2WcQ7kNvwFZz46R&_nc_oc=AdoF4iFrbPY6v9tgTpaqC25nC-80GsIiF_2rgsp64_LogLQPDR3nZg9UVnpz8A0imII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mg8zwM3_ct3GONd7eZrjWMboU8q5oWnSDeGhOY2XO8g&oe=6A05D9C4"}, {"file_name": "scene 9 2560 by 1440.jpg.png", "id": "926280673651219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_926280680317885_659177831053008846_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYQAi4AI6osQ7kNvwFt6pmX&_nc_oc=Adp3he3jACDhcNEqJtBN186jKMd89UuKbJ7weoMQ7Van4SMUBPEO-g-DTIVs6sIOw1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K7veAdTrVu7AQx3P0K84b84Gc0g3QCHRcE602BKhfUA&oe=6A05C1CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1464862578526713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620965_1464862581860046_1278782480344194689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXfA4J02WIIQ7kNvwHgNw4_&_nc_oc=Adockh9I1GBrht5yHz_kBiX1WeDCMiI4CWG1UfZGDWGs3zlF4gsrVBT0eWW_MVQ90uU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E9wVYpnc3aylNAzDL7PTqWbPG4j22aSO2afrsCOW-nA&oe=6A05E291"}, "display_name": "AmblyoTube", "keywords": ["Amblyobia", "Lazyeye", "vision", "training", "coordination"], "long_description": "# Amblyotube \u2013 Immersive Vision Training for Amblyopia\n\n**Amblyotube** is a VR-based vision training app designed to support individuals with **amblyopia (lazy eye)**. Built for platforms like Meta Quest, it uses **dichoptic viewing** to deliver separate visual inputs to each eye, helping the brain improve **binocular vision** and depth perception.\n\nThe app allows users to select their lazy eye and automatically applies a **shader to the dominant eye** (reducing clarity via blur, brightness, or opacity) while enhancing the weaker eye using **AI-driven sharpening**. A unique **flicker stimulation** feature further activates the lazy eye by drawing the brain\u2019s attention to key objects.\n\nAmblyotube integrates **YouTube**, enabling users to watch their favorite content while training\u2014making sessions engaging and consistent compared to traditional methods like patching.AmblyoTube plays video from the internet (including YouTube). A stable internet connection is required. Video is provided by third-party services; availability and terms are controlled by those services and may change.\n\nProduct Explainer: https://www.amblyotube.com/product-explainer/\n\nUnlike full eye patching, Amblyotube promotes both eyes working together, improving coordination and spatial awareness. It is ideal for daily 30\u201340 minute sessions for users aged 13+.\n\n**Note:** Amblyotube is an assistive training tool and does not replace medical treatment. Consult an eye care professional for guidance.", "short_description": "Amblyotube is a virtual reality (VR) vision training and assistive software designed for individuals with lazy eye syndrome (amblyopia). Developed by Seven Sportz, the application runs on the Meta Quest headset and utilizes its dual eyepieces to provide independent visual inputs to each eye while the user watches YouTube videos.\n\nThe tool functions through two primary mechanisms:\n*   Dominant Eye Shader: Shades the dominant eye\n*   Lazy Eye Sharpner:  Sharpens and flickers humans in lazy eye"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amblyotube.com/legal/privacy/", "developer_terms_of_service_url": "https://www.amblyotube.com/legal/terms/", "publisher_name": "Amblyotube", "support_website_url": "https://www.amblyotube.com/contact/", "website_url": "https://www.amblyotube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25906906999005157"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1635568977482846"}]}, "baseline_offer": {"id": "1635568977482846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774709340, "status": "PUBLISHED", "id": "1635568977482846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26322322434130276", "version": "1"}, "id": "1277350734590507", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26322322434130276"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "What\u2019s new \nFocus point for therapy\nYou can turn on a gentle moving spotlight on the video. It helps draw attention to one area at a time. For the eye you\u2019re training, that spot appears in a bright pink\u2011purple so it\u2019s easy to notice. For the other eye, the same area is toned down in a soft, neutral way so the two eyes don\u2019t see the same thing\u2014supporting the kind of two\u2011eyes, different view exercise your clinician may recommend.\n\nLanguages\nThe app\u2019s menus and on\u2011screen messages are now available in several languages, including English, Japanese, Korean, French, and German. You can pick your language in the therapy panel, and the app will remember your choice next time you open it.\n\nAmblyoTube is a therapy aid; always follow your eye care professional\u2019s guidance.", "created_date": 1777434130, "id": "26322322434130276", "version": "1", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26322322434130276"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "You can choose your language right in the therapy panel. Each option is shown the way people who speak that language would write it (for example, Japanese and Korean are shown in their own script), so it\u2019s easier to find your language at a glance.\nJapanese and Korean now show proper characters from the start, not empty boxes, even if the rest of the app is still in English.\nThe language choices are clearer and easier to tap, and they match the look of the other small option buttons nearby, so the screen feels more consistent and comfortable to use.", "created_date": 1776871104, "id": "26243379445357909", "version": "1", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26322322434130276"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "Therapy panel (Quest / Meta layout)\nLeft column fits the panel \u2014 If there are many therapy controls, the left column scales down so everything (including Reset All) stays on the panel and stays reachable with hands and rays. You should no longer lose buttons because they sit outside the interactive area.", "created_date": 1776365552, "id": "26183982564630931", "version": "1", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26322322434130276"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": "Lazy eye (MFBF) \u2014 new figure accents: highlight, outline, and pulse\nWho this is for\nAnyone using MFBF (\u201clazy eye sharpener\u201d) mode: the app finds the person in the picture (the face/body mask) and applies extra training cues only on that figure on the lazy eye side, while the rest of the video looks normal.\n\nWhat\u2019s new\nYou can add three optional visual aids on that figure:\n\nHighlight \u2014 A soft yellow\u2013green glow on the person so they stand out without turning the whole screen that color.\nOutline \u2014 A red edge along the border of the person (like tracing the silhouette) so the shape is easier to see.\nPulse \u2014 A gentle \u201cbreathing\u201d effect over time: the highlight and/or outline can get stronger and weaker in a steady rhythm, which can help attention without you having to change sliders by hand.\nThese work together with your existing MFBF sharpness and MFBF contrast sliders. The app\u2019s defaults were tuned so contrast on the figure stays light; the new accents do more of the \u201clook here\u201d job.\n\nWhere to find it in the app\nIn the therapy control panel, under \u201cLazy Eye Sharpening (MFBF)\u201d, you\u2019ll see:\n\nControl\tIn simple terms\nFigure accent (lazy eye) \u2014 buttons None, Outline, Pulse, Both\nChooses which of the new effects are active (see below).\nMFBF Highlight\nHow much yellow\u2013green glow is mixed onto the person (0 = off when an accent mode uses highlight; None turns accents off entirely).\nRed outline\nHow strong the red rim around the person is.\nPulse Hz\nHow fast the pulsing rhythm is (beats per second). Lower = slower breathing; higher = quicker flicker.\nPulse depth\nHow strong the pulse is \u2014 from almost flat (subtle) to a very obvious on/off swing.\nReminder: Turn on MFBF (lazy eye sharpener) and use the Human target when you want these effects on people in the video.\n\nWhat each accent mode does\nNone \u2014 No yellow\u2013green highlight, no red outline, no pulsing on those extras. Your sharpness and contrast on the figure can still be on; this only turns off the new accent layer.\nExample: You want a very natural picture and only a little sharpening.\n\nOutline \u2014 Red edge around the person (strength = Red outline slider). The highlight color can still show at a steady level if MFBF Highlight is turned up (no time-based pulse on the highlight in this mode).\nExample: A talk or cartoon where you want a clear \u201ccutout\u201d edge so the lazy eye locks onto the speaker.\n\nPulse \u2014 No red outline. The highlight brightens and dims over time using Pulse Hz and Pulse depth.\nExample: A child who ignores a flat image \u2014 a slow pulse (low Hz, moderate depth) can draw attention to the face without harsh edges.\n\nBoth \u2014 Red outline and highlight pulse together (same rhythm).\nExample: Maximum \u201cnotice the figure\u201d for short drills; try a slow pulse first so it\u2019s comfortable.\n\n", "created_date": 1776354823, "id": "26182318548130666", "version": "1", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906906972338493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26322322434130276"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1277350734590507"}]}, "change_log": null, "created_date": 1775993160, "id": "26138503675845487", "version": "1", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
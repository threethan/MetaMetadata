vwGU-3_q&_nc_oc=AdknPm0yaWz3BTcOrQWZ_2PZrSjVHJilA5U3iW2Kx8d6mlEGFktHmNNCKbaXjDdB2Wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwK4kE6L9i9qhN6Fz2fuNKhhVavvku3GbfYl46JecYoeA&oe=69BFF211"}, {"file_name": "2301747201410_.pic_hd.png", "id": "1762598234671844", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821208_1762598238005177_7200493616907354153_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN0bjBnBwwIQ7kNvwEjwJUp&_nc_oc=AdneXU9FQbM4sE46S0uDIMoUq8CN6sRHzMDtBT9l3Gy7x-_Jj-L_Fqtf1DrBwqqQ5wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyz4N2s6WQa0tiMDWli_cBnyUaYOyXqlFoLAkodF1wieg&oe=69BFD85E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zero2U", "keywords": ["3D\u89c6\u9891", "\u7a7a\u95f4\u89c6\u9891", "\u5143\u5b87\u5b99", "3D\u8f6c\u6362"], "long_description": "\u53d1\u73b0\u5168\u65b0\u7ef4\u5ea6\u7684\u7cbe\u5f69\u4e16\u754c \u2014 Zero2U\uff01\n\n\ud83d\ude80\u4f53\u9a8c\u4e0e\u4f17\u4e0d\u540c\u76843D\u793e\u4ea4\u4e92\u52a8\uff0c\u5171\u4eab\u6c89\u6d78\u5f0f\u5206\u4eab\u4e50\u8da3\uff01\n\n\u5728Zero2U\uff0c\u6211\u4eec\u4e0d\u4ec5\u4ec5\u662f\u5206\u4eab\u7167\u7247\u548c\u89c6\u9891\uff0c\u66f4\u5e26\u6765\u72ec\u7279\u76843D\u89c6\u89c9\u4f53\u9a8c\u3002\u65e0\u8bba\u662f\u8bb0\u5f55\u751f\u6d3b\u70b9\u6ef4\uff0c\u8fd8\u662f\u5206\u4eab\u65c5\u9014\u7cbe\u5f69\uff0cZero2U \u8ba9\u6bcf\u4e00\u523b\u90fd\u66f4\u52a0\u751f\u52a8\u3001\u771f\u5b9e\u518d\u73b0\uff01\n\n\n\u2728 \u6838\u5fc3\u529f\u80fd \u2728\n\ud83d\udd39\u6c89\u6d78\u5f0f3D\u4f53\u9a8c \u2014 \u5148\u8fdb\u7684AI\u6280\u672f\uff0c\u8ba9\u7167\u7247\u548c\u89c6\u9891\u7acb\u4f53\u5448\u73b0\uff0c\u4f53\u9a8c\u66f4\u751f\u52a8\uff01\n\ud83d\udd39\u5168\u65b0\u793e\u4ea4\u4e92\u52a8 \u2014 \u8fde\u63a5\u5168\u56fd\u7528\u6237\uff0c\u5206\u4eab\u521b\u610f\uff0c\u63a2\u7d22\u7cbe\u5f69\u65f6\u523b\uff0c\u7a81\u7834\u5e38\u89c4\u793e\u4ea4\u4f53\u9a8c\uff01\n\ud83d\udd39\u79c1\u5bc6\u5206\u4eab\u6a21\u5f0f \u2014 \u8bbe\u5b9a\u4ec5\u81ea\u5df1\u53ef\u89c1\uff0c\u4fdd\u5b58\u73cd\u8d35\u56de\u5fc6\uff0c\u4fdd\u969c\u60a8\u7684\u9690\u79c1\u5b89\u5168\u3002\n\ud83d\udd39\u667a\u80fd\u4e2a\u6027\u63a8\u8350 \u2014 \u6839\u636e\u5174\u8da3\u7cbe\u51c6\u63a8\u9001\u4f18\u8d28\u5185\u5bb9\uff0c\u53d1\u73b0\u66f4\u591a\u7cbe\u5f69\uff01\n\n\n\ud83d\udca1\u4e3a\u4ec0\u4e48\u9009\u62e9 Zero2U\uff1f\n\u2705\u4e13\u4e1a\u7684 2D\u21923D \u8f6c\u6362\u6280\u672f\uff0c\u8ba9\u666e\u901a\u89c6\u9891\u7115\u7136\u4e00\u65b0\uff0c\u7acb\u4f53\u5448\u73b0\uff01\n\u2705\u7b80\u6d01\u6d41\u7545\u7684\u64cd\u4f5c\u754c\u9762\uff0c\u8f7b\u677e\u4e0a\u624b\uff0c\u4e50\u4eab\u4e92\u52a8\uff01\n\u2705\u9690\u79c1\u4fdd\u62a4\uff0c\u6570\u636e\u52a0\u5bc6\u6280\u672f\u4fdd\u969c\u60a8\u7684\u4fe1\u606f\u5b89\u5168\uff01\n\n\n\ud83d\udd3b\u7acb\u5373\u4e0b\u8f7d Zero2U\uff0c\u548c\u670b\u53cb\u4e00\u8d77\u63a2\u7d223D\u4e16\u754c\uff0c\u5f00\u542f\u5168\u65b0\u4e92\u52a8\u4f53\u9a8c\uff01\ud83d\udd3b", "short_description": "Zero2U - \u8ba93D\u5206\u4eab\u66f4\u7b80\u5355\uff01\n\u8f7b\u677e\u521b\u5efa\u548c\u5206\u4eab3D\u7a7a\u95f4\u89c6\u9891\uff0c\u5728\u5143\u5b87\u5b99\u4e2d\u4e0e\u670b\u53cb\u6c89\u6d78\u4e92\u52a8\uff0c\u63a2\u7d22\u5168\u65b0\u89c6\u89c9\u4f53\u9a8c\uff01"}, {"images": {"nodes": [{"file_name": "Quest_UE.png", "id": "2382984742086575", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827033_2382984745419908_7790504975923156169_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtFZVgtvthYQ7kNvwEd1nmS&_nc_oc=AdmORXXGHCbqV5_hELmyGIzTp5znaO2_J_OnowZ81tExx85vnlstzrMUmvW5R8QU_zk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztstBUoanv6NH1IoawdzCAdLKz3NOhI7POOsqrO_EYZg&oe=69BFD384"}, {"file_name": "9941747377043_.pic.png", "id": "1698527334105623", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499324089_1698527337438956_9050711872880004687_n.png?_nc_cat=102&ccb=1-7&_nc_
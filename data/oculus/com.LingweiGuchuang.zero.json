EZVlRIdNHPHm4cE2u-Be-s1dUh7d1ZNjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG5vLDdvPuKadzxA6nDziKeuZ5xBwjQH6vmHrAxLk1Ig&oe=6AA7F36E"}, {"file_name": "1747722033341.png", "id": "724641620508053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820566_724641623841386_8201753487253305078_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0m1nER3LKMQ7kNvwHAWR6T&_nc_oc=AdrDsqFmAhpA-kC3BZgYgPXFsrJzIfjAM8ddaRipWM0_fEGvbia9a-8ycWTs5isKgi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK1HPkzTEZJPgvHPVcH1qwRYhTg6S8DanY_2Q7un_OeQ&oe=6AA7E776"}, {"file_name": "1747722252618.png", "id": "941626154615597", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_941626161282263_6948129061699868019_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psMZkO-z_dMQ7kNvwE1QCU2&_nc_oc=AdoaB4dtnFerw4wKAWgtWqtzVRxmmjAPAkM0DHr-xt4MPeP0L1XU4ivyqOm0pP3fLrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVzfuyh4nQygucaV4sD3VUzJxxVkhBtkuH1oiTGo6GCw&oe=6AA80FD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zero2U", "keywords": ["3DVideo", "Metaverse", "2Dto3DVideoConversion"], "long_description": "Discover a New Dimension of Wonder \u2014 Zero2U!\n\n\ud83d\ude80 Experience a whole new kind of 3D social interaction and enjoy the fun of immersive sharing!\n\nAt Zero2U, we go beyond just sharing photos and videos \u2014 we deliver a unique 3D visual experience. Whether capturing everyday moments or sharing travel highlights, Zero2U brings every memory to life with vivid realism.\n\n\u2728 Core Features \u2728\n\ud83d\udd39 Immersive 3D Experience \u2014 Cutting-edge AI technology transforms photos and videos into stunning 3D visuals for a more vivid experience.\n\ud83d\udd39 Next-Level Social Interaction \u2014 Connect with users nationwide, share creative content, explore exciting moments, and break free from conventional social norms.\n\ud83d\udd39 Private Sharing Mode \u2014 Set content to \u201conly me\u201d to securely store precious memories and protect your privacy.\n\ud83d\udd39 Smart Personalized Recommendations \u2014 Get high-quality content tailored to your interests and discover more of what you love!", "short_description": "Zero2U \u2013 Simplifying 3D Sharing\nEffortlessly create and share 3D spatial videos. Dive into immersive interactions with friends in the metaverse and discover a whole new world of visual experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zero2u.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "unity", "support_website_url": null, "website_url": "https://www.Zero2U.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8990141231088952"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "726070243131344"}]}, "baseline_offer": {"id": "726070243131344"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748397480, "status": "PUBLISHED", "id": "726070243131344"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27023262530683546", "version": "1.7.6"}, "id": "673816198683845", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary
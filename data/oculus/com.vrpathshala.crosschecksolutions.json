714473090_7219366030145690733_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CjhaMJUaI4Q7kNvwEZFr0Q&_nc_oc=Adq7BrzrcjY9xXArKRDq2hTfiq3tCDhCqUhjd8VIbyk1jgdq-lUiL4ZOT1qOATJnjgY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-GNPXWuhkgIRlBPp74spucueTNzgeo_D6hRIF8EI4zQ&oe=6B01D5F8"}, "display_name": "VRPathshala", "keywords": [], "long_description": "VR Pathshala is a pioneering platform that transports students into immersive virtual laboratories, providing them with the opportunity to conduct experiments as if they were in a real-life setting. This immersive learning approach offers students unparalleled clarity, allowing them to grasp each step comprehensively and learn from their mistakes as they navigate through tasks. The result? A profound understanding of the subject matter and unforgettable learning experiences equip\nstudents to excel in practical laboratory work.", "short_description": "VR Pathshala is a pioneering platform that transports students into immersive virtual laboratories."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crosscheck.solutions/vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crosscheck Solutions Limited", "support_website_url": null, "website_url": "https://crosscheck.solutions/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
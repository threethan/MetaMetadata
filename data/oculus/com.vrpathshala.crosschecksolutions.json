5/39031605_327178303677941_3681901994608248180_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NS2JGLLKyqEQ7kNvwEnOdJj&_nc_oc=AdrbbtOeFJWZ584DjdbX1dlWmNO9h6vES8RG1sQKQN2qjrGloY14uHdDmT15acw2eDE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HN1FQ48puLGrHEPm_u8UpWDzd0ALezysSHoOYj4O01w&oe=69F20B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "445578711139757", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035430_445578714473090_7219366030145690733_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gsqSwZLsBgQ7kNvwGPuGKW&_nc_oc=AdqZ-spcICFt18C51jFILBTFTYGJafZb2spbXWJgDI2SMKEF8KlQlXsteIdVXyuzpmQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3PXNYXygr4Jp1lwqIbHgMcrtpVXnlh4SBdraUYOktq5Q&oe=69F208B8"}, "display_name": "VRPathshala", "keywords": [], "long_description": "VR Pathshala is a pioneering platform that transports students into immersive virtual laboratories, providing them with the opportunity to conduct experiments as if they were in a real-life setting. This immersive learning approach offers students unparalleled clarity, allowing them to grasp each step comprehensively and learn from their mistakes as they navigate through tasks. The result? A profound understanding of the subject matter and unforgettable learning experiences equip\nstudents to excel in practical laboratory work.", "short_description": "VR Pathshala is a pioneering platform that transports students into immersive virtual laboratories."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crosscheck.solutions/vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crosscheck Solutions Limited", "support_website_url": null, "website_url": "https://crosscheck.solutions/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "10431
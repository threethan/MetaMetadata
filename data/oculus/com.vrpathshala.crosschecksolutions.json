338"}, "display_name": "VRPathshala", "keywords": [], "long_description": "VR Pathshala is a pioneering platform that transports students into immersive virtual laboratories, providing them with the opportunity to conduct experiments as if they were in a real-life setting. This immersive learning approach offers students unparalleled clarity, allowing them to grasp each step comprehensively and learn from their mistakes as they navigate through tasks. The result? A profound understanding of the subject matter and unforgettable learning experiences equip\nstudents to excel in practical laboratory work.", "short_description": "VR Pathshala is a pioneering platform that transports students into immersive virtual laboratories."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crosscheck.solutions/vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crosscheck Solutions Limited", "support_website_url": null, "website_url": "https://crosscheck.solutions/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7342643305825391"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974642_748671017016313_4943583472283702270_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVMrXY6v1G4Q7kNvwEXpCgr&_nc_oc=AdrlphdT-OZCCDu
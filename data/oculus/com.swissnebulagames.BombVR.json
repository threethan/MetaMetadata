file_name": "Bomb VR - v0_0.3 gameplay.mp4__8.839252.png", "id": "716900427366346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_716900434033012_6506253791535254195_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BROECPQdoawQ7kNvwHibOr7&_nc_oc=AdpQ4kOWd8mzhJVjQrbO5CzTlGXGZK_neHqjlcMkFYxg0zpLvijKEJYer-HrSHrQzjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA7DQfagAFWuymzS-kH-kuYW6khX9_r5EpJpUPKagNlg&oe=6AE0B636"}, {"file_name": "Bomb VR - v0_0.3 gameplay.mp4__12.613795.png", "id": "1316381019894260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825305_1316381033227592_6219463279931178777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJy-uttfsnYQ7kNvwFoETjM&_nc_oc=AdpuBJ7Lfxzo5gFRy0_ukT91k5cIm3zEpiuv9VKErifBTlaJ-JC3aMBhJRriYuKiTLo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-R_7yUhHsiqihsRC-ghpwmMYudqAJ7RDgtlzQ6LwWjw&oe=6AE0C4CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bomb VR - Library Header BIGger.png", "id": "814160411009422", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_814160417676088_3723361194798567621_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYuMI2jubC0Q7kNvwHlrbeu&_nc_oc=AdqoyXbznX6bnpTSw75gwtNla_TlvHI2DFE5m46m2JG3PGUnwt1Jm3wDD9vpAdnpX30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4eSMgWC5MHzPVvYW45tM0OBEsaJkJa6ofBeA-CCmzbw&oe=6AE0AD62"}, "display_name": "Bomb VR", "keywords": [], "long_description": "Bomb VR is a fast, explosive multiplayer game built for virtual reality.\nThe rules are simple: throw energy bombs to shatter the floor beneath your opponents and make them fall before they do the same to you. Every round is quick, intense, and full of laughter \u2014 perfect for quick sessions with friends.\n\nFeaturing physics-based destruction, smooth locomotion, and instant matchmaking, Bomb VR captures the fun of local party games in a competitive VR arena. You can play with friends online, test your agility in fast duels, and master the art of survival as the ground disappears under your feet.\n\nJoin the chaos, find creative ways to stay alive, and enjoy the thrill of blowing up your friends \u2014 all in immersive virtual reality!", "short_description": "Fast-paced multiplayer arena where you blast the ground under your friends!\nThrow fireballs, destroy platforms, and be the last one standing in this chaotic VR battle of reflexes and destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playbombvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nebula Games GmbH", "support_website_url": null, "website_url": "https://playbombvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28291374087210212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1332597635229280_9208288333284950484_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa1uIGC820sQ7kNvwG-8Lw-&_nc_oc=AdrT3wmYTNeRONwCzjRVfUlKU1-lfFuFpHq5lYgami3ogd4K7qZmM-JgtWkRNQN4JCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_HtlmHvPyiTADSFh7N3n-ifyfIfvFD9ZDgk6JY2J_qw&oe=6AE0AE15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bomb VR", "platform": "ANDROID_6DOF", "context_catego
}, {"file_name": "icon-512.png", "id": "978173178089770", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_978173184756436_2912487390404253297_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTiPU7SlikYQ7kNvwH_lJNJ&_nc_oc=AdpBkg-BgOa1Yq0t3gSVcNGzWWH7t3zRCeJf9n_KpV70PhsITzkJBLAQP2aaRAzh6mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-boJteIk7aOpUzJsEzWnLbrcaGCWoasjTAwBQ_SOQCA&oe=6AE756FF"}]}, "id": "1010704775404946", "locale": "en_US", "screenshots": [{"file_name": "screenshot-01-cat-and-toy.png", "id": "1121101023954056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1121101030620722_519938392403516088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmiicNPIqTIQ7kNvwGnvuDa&_nc_oc=AdpruO_jSmQboLtzOGB0A5HORnaevMGSVpVEE1sET38Zw2WLZy6Vf1eKTQgL-8OvGTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9xuDSCcuMghpM_wTop4el2Npvet-8IG-pa1sFUZ1nPA&oe=6AE74977"}, {"file_name": "screenshot-02-crazy-cats.png", "id": "960733350054374", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_960733353387707_3474475942261568079_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlOZ9ojyDngQ7kNvwEgPzsW&_nc_oc=AdqbZVVEMX9fkXZxlxVVHhIM4YKIu7QbKd7kB4ze2umEzabnVRT3bTrbOra7dVSSPBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaxdAVzKZn7KMoqvzX8-j9zHd6rTfaa29fGHEG3MTybw&oe=6AE74B83"}, {"file_name": "screenshot-03-cat-peeks-at-the-toys.png", "id": "2975639999459372", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_2975640006126038_4538398929050159803_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLR2VIXOL7gQ7kNvwEmQYT6&_nc_oc=AdpYOyBop0z2ptI4HRQFnHF2w7Q8Bhmu7Q-ppp9703qYWhadytvfBwmxC0YSCN6IMiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTacjYaA7vRamYVa2BEeLsP8h2rO1hLB7jUFt3g_taHEQ&oe=6AE75D37"}, {"file_name": "screenshot-04-toy-battle.png", "id": "2141627556483500", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_2141627563150166_8166898668212166825_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVDjDhSgnlsQ7kNvwGmDr90&_nc_oc=AdpbWbki6i95Fl_fUgbpl2qnLorLaa2KwGuJ2PPoqNzn0KUkT6urWGArl1wgbdYNLyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXxxuiBhfQrsheHXyE0L_avWOfDmA7z_xvScqzDgefkg&oe=6AE760B2"}, {"file_name": "screenshot-05-cat-behind-the-tower.png", "id": "1733031048336403", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1733031051669736_1777880598655101554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mG-BKVY-79gQ7kNvwG5HM2Q&_nc_oc=Adp-JU8hagQCFEv5jGbZJbJvfD36ZBZxptzytz9_3T9RoeyqL52Kim3KONSso6giYdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVqPPwtJt4Nyy5LPHskz0YzQ0R_UUOWzGhamCZYamUSg&oe=6AE73BEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bomb VR", "keywords": [], "long_description": "You're a wind-up toy on a tower of toy blocks in a kid's bedroom. Blast the blocks from under the other toys. Last toy standing wins.\n\nShoot the floor and the blocks crack, wobble and drop. Fall off and you wind back up. Three falls and you're out, watching from the toy balloon. Rounds are short, the blocks grow back, and anyone can still win at the end.\n\nThe room fights back:\n\u2022 The cat peeks over the edge and swats a whole row of blocks away.\n\u2022 The kid's hand comes down from the sky and takes a block, and the toy on it.\n\u2022 Lights out: the room goes dark and only the toys' eyes glow.\n\u2022 The toy train rolls across the tower and knocks a whole row of blocks loose.\n\nCrazy Cats mode: cats, and only cats, far more often, and up to three at once.\n\nMade for playing together:\n\u2022 On your own? Bot toys join in after a few seconds, so there's always a round.\n\u2022 Make a room and share its four-letter code. Your friends type it in and they're in.\n\u2022 Grab a gift for a bigger, faster or double blaster.\n\u2022 Wave to say hi, and dress your toy up with hats and helmets.\n\n1\u20138 players online. Free on Meta Quest.", "short_description": "You're a wind-up toy on a tower of toy blocks in a kid's bedroom. Blast the blocks from under the other toys. Last toy standing wins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://playbombvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nebula Games GmbH", "support_website_url": null, "website_url": "https://playbombvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28780681564946126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_2379559079452148_5661029529011196166_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4awaiR9nmGYQ7kNvwEw7DSQ&_nc_oc=Adr0naguIDCYl5PgP2poZIs9q0ez4AouaFO2lDjIXSls4Ds_fShQ-XXcwtc_00D51K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq2glJt81BPKleqpt3kT09bEl1ZYzEOFXrxmYPPnGBNg&oe=6AE74636"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bomb VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1760980620, "lastRevision": {"nodes": [{"id": "24753681074312
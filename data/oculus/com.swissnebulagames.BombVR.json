file_name": "Bomb VR - v0_0.3 gameplay.mp4__8.839252.png", "id": "716900427366346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823286_716900434033012_6506253791535254195_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BROECPQdoawQ7kNvwHG-sf_&_nc_oc=AdpaCa0njqulpEPKrPWBK39HEe0hRokVY9M8mnct32SugAmL60dpyYsqbahfmvX_l74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpgFhMpi2j52hXJZeJdcvEzEAm789P5iFNZCIjJijJMA&oe=6AE207B6"}, {"file_name": "Bomb VR - v0_0.3 gameplay.mp4__12.613795.png", "id": "1316381019894260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_1316381033227592_6219463279931178777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJy-uttfsnYQ7kNvwHYvYsa&_nc_oc=AdrV_kuN0ux8ZhSColYsNVrbIDgP_5JMUFhtEsNH-brNinhQG7UKHYGTFqLsUHpu9uI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMirCgOV_aqeMoa4GJGWNUhcK1sPRgBR4a_MFhrAhrO4A&oe=6AE2164B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bomb VR - Library Header BIGger.png", "id": "814160411009422", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_814160417676088_3723361194798567621_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1OtWAU_07sQ7kNvwEiUv72&_nc_oc=AdrHmOpeYv-3S42aip9IJyP5PR655Z_j2CoO8tEaDC5Cgo9j87DgFZb8YwtUJ0nzjd8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTa7bkTSu8vm-6kdLeM482yap3Waxurn-xnXr8s8w_WQ&oe=6AE1FEE2"}, "display_name": "Bomb VR", "keywords": [], "long_description": "Bomb VR is a fast, explosive multiplayer game built for virtual reality.\nThe rules are simple: throw energy bombs to shatter the floor beneath your opponents and make them fall before they do the same to you. Every round is quick, intense, and full of laughter \u2014 perfect for quick sessions with friends.\n\nFeaturing physics-based destruction, smooth locomotion, and instant matchmaking, Bomb VR captures the fun of local party games in a competitive VR arena. You can play with friends online, test your agility in fast duels, and master the art of survival as the ground disappears under your feet.\n\nJoin the chaos, find creative ways to stay alive, and enjoy the thrill of blowing up your friends \u2014 all in immersive virtual reality!", "short_description": "Fast-paced multiplayer arena where you blast the ground under your friends!\nThrow fireballs, destroy platforms, and be the last one standing in this chaotic VR battle of reflexes and destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playbombvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nebula Games GmbH", "support_website_url": null, "website_url": "https://playbombvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28291374087210212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_1332597635229280_9208288333284950484_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa1uIGC820sQ7kNvwEaYe1B&_nc_oc=AdrpOB_XLj_TMN9k7-YyOgKy-jm4JZLZZ0A6wWgmnXurrI2V_av40quRDOwAVswccZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPanCf4YR-0qZEFDFfMzBaQNemvgZTMO6cWy0m9KVwmlA&oe=6AE1FF95"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bomb VR", "platform": "ANDROID_6DOF", "context_catego
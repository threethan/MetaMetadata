scdn.com/v/t64.5771-25/491823757_814160417676088_3723361194798567621_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jtOHkDqIo8Q7kNvwGa3ACn&_nc_oc=Adpav6isSoW4DK3eW8Nw7kV7C9E1kic3EFCn_k4HeDVASs3UBRDpMEuI8yrGq1wuq60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPQ5oYmU1coAn0SKrLUoFrGyYen3H1bcydsOoAndgvLw&oe=6ABE6662"}, "display_name": "Bomb VR", "keywords": [], "long_description": "Bomb VR is a fast, explosive multiplayer game built for virtual reality.\nThe rules are simple: throw energy bombs to shatter the floor beneath your opponents and make them fall before they do the same to you. Every round is quick, intense, and full of laughter \u2014 perfect for quick sessions with friends.\n\nFeaturing physics-based destruction, smooth locomotion, and instant matchmaking, Bomb VR captures the fun of local party games in a competitive VR arena. You can play with friends online, test your agility in fast duels, and master the art of survival as the ground disappears under your feet.\n\nJoin the chaos, find creative ways to stay alive, and enjoy the thrill of blowing up your friends \u2014 all in immersive virtual reality!", "short_description": "Fast-paced multiplayer arena where you blast the ground under your friends!\nThrow fireballs, destroy platforms, and be the last one standing in this chaotic VR battle of reflexes and destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulagames.systeme.io/privacy", "developer_terms_of_service_url": "https://nebulagames.systeme.io/tos", "publisher_name": "Nebula Games GmbH", "support_website_url": "https://playbombvr.com/", "website_url": "https://playbombvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQ
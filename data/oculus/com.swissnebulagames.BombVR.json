file_name": "Bomb VR - v0_0.3 gameplay.mp4__8.839252.png", "id": "716900427366346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_716900434033012_6506253791535254195_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2dUGvFa2tAQ7kNvwEpmMlh&_nc_oc=AdrfM_6dKqYCEK_T0XWcAgzbZItNB67W-nvUon6lyhk1B6ZQLdURcD04Sy9r4-wmWs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCcPRqZnUJlmvL7zgy4nNyPW3uUAo9Wh0C8Satk1yMIg&oe=6AE4AAB6"}, {"file_name": "Bomb VR - v0_0.3 gameplay.mp4__12.613795.png", "id": "1316381019894260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1316381033227592_6219463279931178777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsSdjhIsOF8Q7kNvwEZuiwv&_nc_oc=AdojnD8CSRjrgNma0Hbd9eAXy6iSYCA4MerdSB-Crz82Zw8iIGgrFpN9lkwCPhCo6Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSS9V2TfME0FpbJqJaYG0-tGRatlvmmsA377hj2mFeLw&oe=6AE4B94B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bomb VR - Library Header BIGger.png", "id": "814160411009422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_814160417676088_3723361194798567621_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1OtWAU_07sQ7kNvwGmdKh2&_nc_oc=Ado38dpXL3wLaq-kexi6_3E6YIiYlYIe4LaEk-gHxV0uqET4Nslc0TL_u3rDiA_MAKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuQos61rjMFXjxQeyuJRe2XVGc__xj9eAXgGz9SmK73Q&oe=6AE4A1E2"}, "display_name": "Bomb VR", "keywords": [], "long_description": "Bomb VR is a fast, explosive multiplayer game built for virtual reality.\nThe rules are simple: throw energy bombs to shatter the floor beneath your opponents and make them fall before they do the same to you. Every round is quick, intense, and full of laughter \u2014 perfect for quick sessions with friends.\n\nFeaturing physics-based destruction, smooth locomotion, and instant matchmaking, Bomb VR captures the fun of local party games in a competitive VR arena. You can play with friends online, test your agility in fast duels, and master the art of survival as the ground disappears under your feet.\n\nJoin the chaos, find creative ways to stay alive, and enjoy the thrill of blowing up your friends \u2014 all in immersive virtual reality!", "short_description": "Fast-paced multiplayer arena where you blast the ground under your friends!\nThrow fireballs, destroy platforms, and be the last one standing in this chaotic VR battle of reflexes and destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playbombvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nebula Games GmbH", "support_website_url": null, "website_url": "https://playbombvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28291374087210212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1332597635229280_9208288333284950484_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok0d3XqDvm4Q7kNvwEPZyYD&_nc_oc=AdrKyB6dI0AcKl7fu8F4uucXQlx4pn8VGEEBkT7SGcGUyj3Cp7w-RrjfFW3L4q7C4c4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4l93rI7yF9PJ8HBPyvdJRIn8hOdrqJPUS5k51zzqMeQ&oe=6AE4A295"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bomb VR", "platform": "ANDROID_6DOF", "context_catego
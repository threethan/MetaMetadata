u6BB5CscA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVWz1yD6Ug5i31B_9ZO9cEQOqKBNH7QgLDi3hX0dowf8w&oe=6B103BB7"}, {"file_name": "screenshot-04-toy-battle.png", "id": "2141627556483500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_2141627563150166_8166898668212166825_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lksgpbsnIDwQ7kNvwHQy4eB&_nc_oc=AdqbGREo-jLSvoJGdhSLrXhH_Gfi7ImHob2VvJbOMbcYzT9IWGcPxutF25kwuwJ4MwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSpdw-H9rGjVRhVkmVWX4Qd52y0iUHQOoWGE5eCX2E3w&oe=6B103F32"}, {"file_name": "screenshot-05-cat-behind-the-tower.png", "id": "1733031048336403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1733031051669736_1777880598655101554_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_RuDPb62KwQ7kNvwEE4vxR&_nc_oc=Adp0icvmif6_aN6kpN9SuO1rcuP8yo2yEAQoZUYrJDl8U-GMH2EKdaNr3CqmTMammNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYB7aUQrfqFQfFxKDgxkLtXjulF0dYiB3N4puLpqMiiA&oe=6B1052AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bomb VR", "keywords": [], "long_description": "You're a wind-up toy on a tower of toy blocks in a kid's bedroom. Blast the blocks from under the other toys. Last toy standing wins.\n\nShoot the floor and the blocks crack, wobble and drop. Fall off and you wind back up. Three falls and you're out, watching from the toy balloon. Rounds are short, the blocks grow back, and anyone can still win at the end.\n\nThe room fights back:\n\u2022 The cat peeks over the edge and swats a whole row of blocks away.\n\u2022 The kid's hand comes down from the sky and takes a block, and the toy on it.\n\u2022 Lights out: the room goes dark and only the toys' eyes glow.\n\u2022 The toy train rolls across the tower and knocks a whole row of blocks loose.\n\nCrazy Cats mode: cats, and only cats, far more often, and up to three at once.\n\nMade for playing together:\n\u2022 On your own? Bot toys join in after a few seconds, so there's always a round.\n\u2022 Make a room and share its four-letter code. Your friends type it in and they're in.\n\u2022 Grab a gift for a bigger, faster or double blaster.\n\u2022 Wave to say hi, and dress your toy up with hats and helmets.\n\n1\u20138 players online. Free on Meta Quest.", "short_description": "You're a wind-up toy on a tower of toy blocks in a kid's bedroom. Blast the blocks from under the other toys. Last toy standing wins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://playbombvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nebula Games GmbH", "support_website_url": null, "website_url": "https://playbombvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28780681564946126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823905_2379559079452148_5661029529011196166_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXh69O05bd4Q7kNvwEL0pF5&_nc_oc=AdoNENjVawqGI7bb5xNJNbgPFqgf1jK84bBDU7D-Ltg3twYto6XR8pg8waWjY1F-zpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWs8rK4Khya9xqmSNOgyjq8XDUhIKlSjgVOHepxjS9gqg&oe=6B105CF6"}, "is_concept": false, "is_test": false, "is_
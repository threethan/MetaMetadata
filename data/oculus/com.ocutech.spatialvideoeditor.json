-store-4-360-sky.png", "id": "1582139397285963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585799753_1582139400619296_4561138665890338953_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uCa7w3Bv2gQ7kNvwFYqO65&_nc_oc=AdoQaBJNuuqVFeANZSzhwdDgu8yDUrq1nVxC-hef4ArFaTl28TbyuN_HSaQnUDW9WIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-4OjTYKnD5UwFBciP06S5NUivxyWSuLeCl4r5Y8CkBg&oe=6B0C7EEB"}, {"file_name": "SpatialClip-screenshot-4-filters.png", "id": "3405051576364428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585819904_3405051579697761_1667566658178896723_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7Zkba87c_AQ7kNvwHOuHeZ&_nc_oc=AdoHANZRR1Bw-XyHoAtB2byc3GJDh2gCZX0xBNd4klrlYLvGGogoNvjYs9A0O_Ove1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTY1oLsvWo1d_Xj_lAZV0Ot1x18lyBCFYlhA0wZFfQPUA&oe=6B0C72CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpatialClip-trailer-cover-room2.png", "id": "1881359156617434", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1881359159950767_7014295862287141131_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lwbsJ66xzQQ7kNvwECYv4U&_nc_oc=Adrt9ikGpyBVQ_EpaWR1YnQG9MpVYPET8TDRx_wBmtRzCmMa3-i53_Hfbz7YlCjD6LY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoh1iendtaQxktNySqXj5dhMoT8_pHYOHgts4tlgsAgA&oe=6B0C7925"}, "display_name": "SpatialClip: 3D Video Editor", "keywords": ["360", "stereoscopic", "edit", "filmmaking", "trim"], "long_description": "**SpatialClip** turns your headset into an editing studio for 2D, 3D, 180\u00b0 and 360\u00b0 VR video, with the windows floating in your room.\n\nJoin the community on Discord for tips, news and feature requests: https://discord.gg/wDVr6SZgUw\n\n{1810387976835725}\n\n### **Every format**\n2D, side-by-side and top-bottom 3D, VR180 and VR360, played as intended and exported with VR metadata for YouTube VR and VR players.\n\n### **Trim, split and arrange**\nDrag clip edges to trim, split at the playhead, reorder, undo. Projects save themselves.\n\n{2086987861937288}\n{1110717118258011}\n\n### **Titles and emoji in 3D**\nTitles, emoji and stickers that float out of the video in real stereo depth.\n\n{1504980048139719}\n\n### **2D to 3D**\nAn AI depth model on your headset turns any flat video into 3D.\n\n{2363078804522288}\n\n### **Look and sound**\n16 filters, your own LUTs, color, speed, transitions, music and voice-over.\n\n{29025969220416738}\n\n### **Export and share**\nUp to 8K, saved to your gallery and shared to YouTube or Google Drive. Controllers or hands, no account needed.\n", "short_description": "SpatialClip: Edit 2D, 3D, 180, 180VR,  360 and 360VR videos right where you watch them. Trim and split, add 3D titles and emoji, music and voice-over, filters and transitions, turn 2D video into 3D, then export or share to YouTube, all inside your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ocutech.dev/spatialclip_privacy.html", "developer_terms_of_service_url": "https://ocutech.dev/spatialclip_terms_of_service.html", "publisher_name": "OcuTech LLC", "support_website_url": "https://discord.gg/wDVr6SZgUw", "website_url": "https://ocutech.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_
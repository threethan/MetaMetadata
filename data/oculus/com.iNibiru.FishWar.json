at20Q7kNvwH-NG3u&_nc_oc=AdoWoEfXNKi2uAzrybGZYqJJTw33fs75EVmyXaockDfDBrR50vtasmLZJ85Q8QuPOew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsxsKVqVEULA_5lZ31wM1Q6WkJmVLY68eWyzjq_Svm3g&oe=6B01E78D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aquarium War VR", "keywords": ["Game", "Active", "Aquarium", "fish", "war"], "long_description": "This game is easy to operate. The player could move his or her head to control the little fish. Eat the same level fish for level-up, dodge the BOSS, strike a mortal blow to the BOSS when you\u2019re leveled up, and win the king position.\nPlenty of tasks are contained in this game, and you can obtain different interests through collecting stars to unlock new fish kinds.", "short_description": "Danger lurks everywhere in the aquarium\u2014sharks swimming around, turtles rampaging recklessly, and the most inconspicuous little fish is under threat. Who will be the king of the aquarium? Come and play!"}]}, "developer_name": "BoxVRGame", "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "Box VR", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1085231675596922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v
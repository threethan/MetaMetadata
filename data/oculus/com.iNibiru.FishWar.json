87_2484494974209490944_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h4ETQ_EfNAQ7kNvwGT7aO1&_nc_oc=Adr7jILqtCw7LRrA_h5gLPUUrJVXTdLDfu_iJLBjqytX_88hpwf8Eskn1lXaL9o-dyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcp5Rvqypa4o03ANBwGnzLGYTHqS1bF_eDOUZPPfe_vA&oe=6AEF3A4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aquarium War VR", "keywords": ["Game", "Active"], "long_description": "This game is easy to operate. The player could move his or her head to control the little fish. Eat the same level fish for level-up, dodge the BOSS, strike a mortal blow to the BOSS when you\u2019re leveled up, and win the king position.\nPlenty of tasks are contained in this game, and you can obtain different interests through collecting stars to unlock new fish kinds.", "short_description": "Danger lurks everywhere in the aquarium\u2014sharks swimming around, turtles rampaging recklessly, and the most inconspicuous little fish is under threat. Who will be the king of the aquarium? Come and play!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "Box VR", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "EXPLORATION", "SOCIAL", "SHOOTER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "467172388364281"}}]}, "scheduled_offers": {"count": 27, "nodes": [{"status": "PUBLISHE
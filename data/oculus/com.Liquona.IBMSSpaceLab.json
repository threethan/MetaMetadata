86032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1380580940119365_3840896116937645294_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDpJqg7Ajf8Q7kNvwFhId3M&_nc_oc=AdpUdCURUMFNOi6V1ge9rpM91ij7oBiHfHuOdRwHdeJbB3I1RNQqv13PxsJbf0EknCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjXNR4GhI2w6pS91SIa5_EIRxIUrBYJDgOZXn12GHukA&oe=6B104BF3"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP7vBbM0hP0Q7kNvwH9fFb0&_nc_oc=AdrZ1pIh2GcTYw7cyCwj9tthQHM53ijpK3yvZyudpeyM3LNyleCPkGq2r2hf2r8kKkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9i3t1SJ4jO3yRjRTf7ZvKP4Ci9GXeIIFZzIws5M8b6w&oe=6B104280"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXsGNidAzOIQ7kNvwFAHK_-&_nc_oc=AdqfidXw19trJPC_nNrbJ8t3-0qhLc6lNJh0ZCTwOFIGkXjozV3qbdEUNcZhIiyqFrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBj17watd84sjSVHWRs1Mrmua1YAQ9YFaiabOXQWZvmg&oe=6B103EF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_262097026398529_4898080207945484262_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugTKobzhvzMQ7kNvwGiM8zH&_nc_oc=AdpzT4Q4ZjssnCUDbUMGkMRUamv7YxT50jWD35ZQ2s15rSpwWKwWPL3-iyTLDPERNUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtUWfQadTZEWWQGlTSlCBHX4HQtOly2pgp0Yu3sUSCbQ&oe=6B103931"}, "is_concept": false, "is_test": false, "is_tr
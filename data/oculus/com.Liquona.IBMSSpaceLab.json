00_AfuTLdhfnlkk7S6EfkJLBB_6e40ZvEuxDhToeawidhJL8Q&oe=699AFB33"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyuSxNHX4rMQ7kNvwEX7NSa&_nc_oc=AdkJcYP9fhkGghmkH1cOqey_2FDfGQGdsnT9do3_rlGYxhtZ3GXobKLr_xgFicezBFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0InjFKwhyOMJf_kUGBQ8EL3I-lQC6RSz4wOy-lL_YlQ&oe=699AF1C0"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53rkf5xf8RQQ7kNvwExmAt2&_nc_oc=AdlJzpDtXfvsgV0V7RFsXmghQnH4LtdD9-BGB-fjayL-_eWVdQzMeVrtkvHFGCVxsXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsdffrV4HopvuiKFyzbcL7Chli5QfPhEJtkJLBos0VKBQ&oe=699AEE33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience 
z49KvtRGSYHY-9EsiUzWE6WC7wFWE-wUt6HkG4SwFXAd_Wo2sefA3A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkW5BmE5pdQ5C-CQFdX5j6DOBnLHgDxs2srLfILOJ_Yg&oe=6AB27933"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBK8DUFRjmEQ7kNvwGmug48&_nc_oc=AdrfKqSmIunLM_6Lz2OtpPE78tT-jIhtzWOF3caLO0thnR5CKkprVndpWf7cDRhBatg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoTFabI4rdNGq7RoaUbFUxQbaT3SjtZKnJ24scixLK2A&oe=6AB2A800"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HIKaDH9IJcQ7kNvwEMmFIm&_nc_oc=Adpq8cNLLR6aGOmo0kNFp8UnKtwdu5wTsRivf5hMHcSzPf0r7wLmLHo1RpNhXvKgNl8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP7vJ9F42J3_1JBSNMbpqAuoFNym4EKlW3M7wqUUhnTw&oe=6AB2A473"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_262097026398529_4898080207945484262_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOKlX4mHDFEQ7kNvwHuL4dd&_nc_oc=AdoKhjSxnCybnKUW4XxhPQpcR8MaH0i6Pax1xDs4vQ0MU6xyypjE2WWE1gCkSDDnMCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-DhoTfW8p5_f295s4dYJtkhtpe2eFUzviNJ_4Javowg&oe=6AB29EB1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "IBMS SpaceLab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1
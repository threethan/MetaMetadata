00_AftYDagMTYrSxK8IJLhiner_c0o6SZyK1Fb48wCL4zhO4w&oe=699D9E33"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq9VIi3GyqwQ7kNvwH_JJG1&_nc_oc=AdnTbqC0q0-IdYG9PueftCyfSIBaGc8oOjb7834LHShqF_r2ZbjsnZFuWqx18kjZ5tM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumSLpE_tBLBmQZX55R_bkf5Es5-H_fOLNBKCD0I8W0kQ&oe=699D94C0"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53rkf5xf8RQQ7kNvwFN5Fhd&_nc_oc=Adn8uyM-fqfqvBc8vsJggn8mx0QdM6u6TICl_qb_Vc2Zu3Aolbszk6VqaGO_w4tmUps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftvp9kz70vHvXu-eQzYTaPwmDoRqWJilbzwBCkPRJG-lA&oe=699D9133"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience 
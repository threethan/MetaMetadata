86032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_1380580940119365_3840896116937645294_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je7y6XUvG-4Q7kNvwEJuVr3&_nc_oc=Adoui8SgIdN1-4tHWvPwaAELNzfPIXqji7iBzGgIYd0mu9NS3QthWggfZLOfMG4mvro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2hb1egRm6bS4LI3WExb0P6z-Fdw3TSK75AjsnIpHf0w&oe=6B0DA8F3"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw1afDC49tcQ7kNvwFTapeT&_nc_oc=Adp4bdaunM_RznkrvxFtJLJMEnYUSZF3O1kKLRgZLos88CeO5OP3piJphNZWeI8Y9-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRr9PEPzjhG2AdN3S7-KMVOP459FBKguKHJn4qkOnnb4Q&oe=6B0D9F80"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRDuai2eGBYQ7kNvwGXIJ9p&_nc_oc=Adopy6Jk5xFsUsnENy1U-Xe_gsKeV4s49QweSKzeXUL6PK-t4ZFYxCyfQ5lPYppa5g0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrENTkD83ELmJe7UjPLPx64whv1JfdH9Zp4U_Ff8Bk4g&oe=6B0D9BF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_262097026398529_4898080207945484262_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6WscEd6p3MQ7kNvwFDfI30&_nc_oc=AdpwbA3yAAj--PW5LGm5WUHZGTGamjU1WEc5Nwi4wHOj5R4N6uGIOZBRLT-rJex72Qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrQ2IfEaEQmCU9uvLh-oenWAPas6dalj_xsBnFqo-bjQ&oe=6B0DCE71"}, "is_concept": false, "is_test": false, "is_tr
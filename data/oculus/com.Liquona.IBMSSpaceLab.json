86032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_1380580940119365_3840896116937645294_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUHdweXTL-EQ7kNvwEAO7Ap&_nc_oc=AdrUyR_AJR4C48KPeTetee9qQHvvU2FWqKAg4W037mqJSJaKcKqmbjYvVu3pin8yUvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWtFMVVVNvUHRHUqeD_ypqWScNVd7vSl_DshO_qNsJGg&oe=6B09B473"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljqzK6UL6TEQ7kNvwHnSDiS&_nc_oc=AdrfTRQMYNyOD4FI20stpB83Up0-SrBNQm9jdNn0X6kjoID2uP4AVh4oVXX0AONzLvs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgOEgG_RN1lrfC3EsLfHwc3_81-HmbdcaidMb49vVO6g&oe=6B09AB00"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfzoHEqrRg8Q7kNvwHUCBh_&_nc_oc=AdoqWMfs3k7bd-vcQ3291-wTjxqiXQYihx78ayvmTiMA9n178I7Y6VMvYoUFPH7dfQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC_S65M7AvTZUZvch38-CyVhdCzU-XjK6P1x6v8xtM2g&oe=6B09A773"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982522_262097026398529_4898080207945484262_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwn358D2Tr8Q7kNvwFCGwEK&_nc_oc=AdrgJoBp54pQe9jsv_pz8BZJfAOfMG4AMdkYAvDdExA8VbgT0C8nCt3Ahy5zGTLn1Rc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOBlG_W9rOWLT0HY17IGlrF-L8a-OGJT9w5NQJlA1hYA&oe=6B09A1B1"}, "is_concept": false, "is_test": false, "is_tr
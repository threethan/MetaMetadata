jjfIAfkMLzlk8JYH47Uki2Y0cCm2wsLZTQ9xcI8dxpZdn2aCuy0v50&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87BAXP0EpBks_bHvvqR81-t8wXtM_EcCYwAhVEzv2zZA&oe=6A2FF4B3"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjZZ0YkUyDgQ7kNvwG9HDMv&_nc_oc=AdpC4NR2-mmaPew3qS8cbr4Q5Zn1lrWEpOYuonMBhor-rFj_bFq8YFgsJzKmChBs--U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IBeJZc7oSJnVVvaO6tGWN6BwBZ4TrXSSs3JCq_7WeXg&oe=6A302380"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skXwLyD4XN0Q7kNvwFWn90g&_nc_oc=AdqNzB4eKjQtzNA6vDRd0qUefA1SGi5gtc3XCAvcqmA0DPxiTcpCaN96rjR4o4R9rkE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s7rRSxV0QwXmkeeJ9ALBmhKZ3fcFt72ycKTtg4N6AWg&oe=6A301FF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_262097026398529_4898080207945484262_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_bwMwNHf_sQ7kNvwEfvJUJ&_nc_oc=AdpjOzAiz3X0m6hZEoUXIyCrgwcOJfQ5lg91EmQMRKfXVsH5S3xJ5ai6R3v2ToHjy8g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8duFFm6oVizWygngVLcy2KYbhA6M5-kFNzfkDYHgRFGg&oe=6A301A31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "IBMS SpaceLab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1
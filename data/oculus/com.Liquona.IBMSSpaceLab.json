=6e7a0a&_nc_ohc=wnDTOwxG4XYQ7kNvwFne4M-&_nc_oc=Adp-ArNw5exsa4_85l4wWp8ZnXrYx6AmTUZcnTHXAoZ2-wXfS5SkqWfEoDfS5PxRoCw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xl47KTTistIHfrSxamnU-1-en75tq-m1Mv8IajjRhtQ&oe=69F4B92D"}, {"file_name": "Capture_01.png", "id": "1380580936786032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_1380580940119365_3840896116937645294_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLKfi2HtaqsQ7kNvwH9Du_o&_nc_oc=AdoNQIpjYYvz7BphyUtbkoboBv2EiX1uiz1yk_RrQkhKXP7TqX-Ziyh4K_Xu_KeJgQs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sDdeQZjAx7aVF7LERX3yTKSWILaFXGUPzqfovMLIxkw&oe=69F4A133"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYDlgHc60coQ7kNvwHjWKkh&_nc_oc=AdrwML3m1MlnDFjF7Qc0QvTNs8qugHywp98ZoLjS8hoLzfHtSjRwg_beDnfwL9i2AT8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Djmq-nmhpPdvi0glma3fUZqFrBctN5ft-voVy_w15EA&oe=69F497C0"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vM0vdkCR0t0Q7kNvwEGvej4&_nc_oc=AdoFkM-3YINPdX17Xgk75cHrFKaplH_ntabD0i2PjoDcucrVkRNgpNdvNyib4F_Q0u0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07bNu68eQglwlr5qEOGon9Aor3rVpLHfJm6-42N6x3eA&oe=69F49433"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1379267976980637"}]}, "baseline_offer": {"id": "1379267976980637"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765212300, "status": "PUBLISHED", "id": "1379267976980637"}]}, "liveChannel": {"nodes": [{"latest_su
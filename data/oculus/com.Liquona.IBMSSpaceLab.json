86032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819854_1380580940119365_3840896116937645294_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUHdweXTL-EQ7kNvwF2Gx0d&_nc_oc=AdrYttBX93gDVCFE-qum9JJICPbVTNWaIgVmddEe7ZapPzfAC6HT7EAeYxDDj-CINww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVITd6zN04viSJVM_OWYYSQDTKAbCxPKz9EyIOXryaEw&oe=6B0B3E33"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljqzK6UL6TEQ7kNvwGuzAqV&_nc_oc=AdqniNb7DwPZKi7K8S7C5Uk1y-bU_FTDpuTpZE1OLt55I4_cwJRkLbjUarw8x8mwrDY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShC9pU41ZaH82ZzHMi9Y3qNiGuY6XEQRFcNgORwbbPow&oe=6B0B34C0"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRDuai2eGBYQ7kNvwFrlnmW&_nc_oc=AdqWb5qNkHYUKhHF_TWVLGrftbi-iwXItAgSKZ9Z9XA9qFPwQqOzNTfbOqmHdCbrbJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaS1X2qcs5TlgcpUfpL1_AyS0Lg8vP5_-aQ6YnDZMO7Q&oe=6B0B3133"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_262097026398529_4898080207945484262_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwn358D2Tr8Q7kNvwGFWs_n&_nc_oc=AdrfLnBWbSM3dQDI98ekpWLUCMQYr59CLWpd4KJ3-YdIqQcAL_64fgGOvRo4MtjXs_0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDVUPicZCAB32iPovs2e3bELns8lwAu0loPqXVmDLWDw&oe=6B0B2B71"}, "is_concept": false, "is_test": false, "is_tr
=6e7a0a&_nc_ohc=yo-QcGYtydAQ7kNvwEzl0F1&_nc_oc=AdpbOXsgj_DYzNqmPyWP37F4_B1JwiJsx7a7OeRhYtYTne03Lj6YQcny0BrMMq7_YLo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ__Qf9k4ydVMSwcnc3_4-SDTrpVTsl8h-j9-G_xr4zyQ&oe=6AEC932D"}, {"file_name": "Capture_01.png", "id": "1380580936786032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819854_1380580940119365_3840896116937645294_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGhAe20s8OQQ7kNvwHTBkle&_nc_oc=Adq8a2KnoOulBXMQMdm9Up7G2KiqUZlbwAR7GPdJ-5bzpE-EVXx2mcnbiaJsgyTd5fw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpUsUMxtJJVYeYnTfftlHn0kW3fQHjPmiZiXcRLw_n2A&oe=6AECB373"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLEJ4eXKipQQ7kNvwFC2HgB&_nc_oc=AdqOemmayPUZqg_pG-2TivG8NqxURDAX7W7Cn8t4jS7cnXDDgB1OKi5QoUzZnPnv0n0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTONqid10-kl2VpmBYU8Q1zhKP5xV2mpbZ-yryEXsOIcA&oe=6AECAA00"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTJn0QdEX5oQ7kNvwFkYQQp&_nc_oc=Ado93r__DE_v1DpUFaZMolAD7q52A_h0GR47E2MAa1CXp8Mc4EL4s513L1b4jZWSwd0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZqflTSwJEcLWzuOBB083QXA04X3aYm3NXzNjG_sdCIA&oe=6AECA673"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1379267976980637"}]}, "baseline_offer": {"id": "1379267976980637"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765212300, "status": "PUBLISHED", "id": "1379267976980637"}]}, "liveChannel": {"nodes": [{"latest_su
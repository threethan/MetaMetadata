=6e7a0a&_nc_ohc=G2lS8CNscwwQ7kNvwHTI0KY&_nc_oc=AdoU5qcudiKUvN-Qq5xiw80D5UVHgQjoEocx2o23MPmAbBikj9U4ntBUVRIzhP-MdQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m2yWlAKVXTZ2HNVmM8hLKXxuXDztPD0YOSHh8gyNYYQ&oe=6A0DC5AD"}, {"file_name": "Capture_01.png", "id": "1380580936786032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_1380580940119365_3840896116937645294_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGHX5ZN7BgkQ7kNvwHXX1R1&_nc_oc=AdrrUrs9Whmm7EmXb_UhjiyRQQplFzzl0vIUqseQWsd4CD-94r-5NU2ZzE8r0Tb4yTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vumy9TkeXCbseqBhRu0Y7f-6VRs2uhnVXrZLwmqwmeA&oe=6A0DADB3"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIUpnl6CccgQ7kNvwHTn0in&_nc_oc=AdoQR-fEBpi2Mev7hUwdR_AI9zNeAEkvec0gRfRS_pXu_lu1gj_xoi-f34CcF3ek3nY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cUHN3miiyhub5Ac7PPkH8x0H29X9eihrnx4j8d93vig&oe=6A0DA440"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU8voVGb-4AQ7kNvwG1Q-nY&_nc_oc=AdpIay6AZ0M1hpCxNu19cNQ3-798RugNghn1mEYZkSD5a5n0V6IWIW-gZkY_zPnpSiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wrn6gEY9SNkhKDyZLjDOGxqPak-P-n9wMd9Dl9MJbyg&oe=6A0DA0B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1379267976980637"}]}, "baseline_offer": {"id": "1379267976980637"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765212300, "status": "PUBLISHED", "id": "1379267976980637"}]}, "liveChannel": {"nodes": [{"latest_su
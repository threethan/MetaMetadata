00_AfsaAqjYXRYR7JxxTsmMaLnjK7I3OHaPdy2xFGbZWW4ZIg&oe=69A435B3"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKnWMZx9gdIQ7kNvwFFJEz5&_nc_oc=Adkl4p9zGEAIYICdtGfnWUIvukkYyt5Qp96aCtmVIDnBzvB7XWSBUfUm1MAYUGP3gME&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afun4Wm6EZE5LKSgoZN276ipRI9Mv9n3F-ZeC79Oj8mU8w&oe=69A42C40"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve8GSqCTEscQ7kNvwExsnQs&_nc_oc=AdnzSHVk5ZhkwbYAQDVWB3wgk297cAHihruSnHZ5a98RPg5FqVAAxaZhqw9IlZSkA50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsW1KdTdpw7y_lm74nS73w_5FfYMMqWHHQ9pHrI7cuw1w&oe=69A428B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience 
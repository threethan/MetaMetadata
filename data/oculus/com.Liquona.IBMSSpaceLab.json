KxxAk-96LxIH35aCGvG160&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzly-uKfhefeOvwVUAKkja5FeixI51g-9e3L0XWafcBiw&oe=69B407B3"}, {"file_name": "Capture_02.png", "id": "1747928665905895", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827646_1747928669239228_4488780029279306093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL_4tdalr9IQ7kNvwFGlldS&_nc_oc=AdmBdRbHcCw9uEq_jD1UQDof9XYSunZs3AdB6NeuRzCgx3fu1LAjG5ScgXMufDRIYQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYV_CyUxEJW-g73XcIq_JSosNvvVt15O1mybVTGGzxUA&oe=69B3FE40"}, {"file_name": "Capture_03.png", "id": "1584938779530401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_1584938782863734_5980503636337916614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsgiUfSAjtUQ7kNvwHhqBST&_nc_oc=AdnOqpJ-VJ8feHzNmvLPEwbQ3MzIb02dCsh--vD_nAtsdrzIbwCPEnpx_Lp91BL23fA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrsO9XGtH-mLnSLeM1pSKu6GQjAxcDv3N7E7HQhhJbgQ&oe=69B3FAB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IBMS SpaceLab", "keywords": [], "long_description": "Set inside a futuristic SpaceLab, users are guided through interactive journeys, taking control of either a simulated urine or blood sample and following it through each stage of testing. From sample collection to result analysis, participants get a close-up look at the complex processes behind diagnosing illness.\n\nThis isn\u2019t just a virtual experience, it\u2019s an invitation to explore what biomedical scientists do and why their work matters. It offers young people the chance to see if a career in biomedical science might be right for them.\n\nAt the end of the journey, participants are asked: \u201cDo you have what it takes to become a biomedical scientist?\u201d\n\nThe IBMS Accredited SpaceLab is designed to spark curiosity, break down barriers, and inspire the next generation of healthcare professionals.", "short_description": "Step into the IBMS Space Lab: a VR journey into biomedical science.\nOur fully immersive VR experience brings biomedical science to life, showcasing the vital role biomedical scientists play in modern healthcare.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liquona.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Liquona", "support_website_url": null, "website_url": "https://liquona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32731777429771105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_262097026398529_4898080207945484262_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_XOgvoOEqQQ7kNvwHCId-v&_nc_oc=Adm13E4Vzn-rrrK6LCHmn87HGKH1O_2vAbX9V7HPCyU7H2fEDIehjz3Kw2m7L6RCbbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKLaDQBKcmTcjOri2mcV38On79BXJbtw7p1NEaQNR0nA&oe=69B3F4F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "IBMS SpaceLab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1765212300, "lastRevision": {"nodes": [{"id": "10
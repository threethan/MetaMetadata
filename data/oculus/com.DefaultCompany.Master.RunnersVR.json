unners!**\n\n# Play Tons of Unique Gamemodes                                                                                                                                                                               \nFrom Time Trials, Sandbox, PVP and more.. we have it ALL!\n{1036040842936039}\n\n# Customize Your Character\nWith over 100 cosmetics, create a style that\u2019s uniquely yours!\n{2886311991701977}\n\n# Meet Players Around the World\nJoin huge servers filled with players from across the globe!\n{982787161203255}\n\n# Survive the Monsters...\nSome adventures might be better with friends.\n{1010775041492095}\n\n# All in MasterRunners!\n**Install today with one click and jump into MasterRunners TODAY!**", "short_description": "Play through worlds of competition, survival, and chaos."}]}, "developer_name": "EMVRGames", "developer_privacy_policy_url": "https://www.masterrunnersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EthanMonke", "support_website_url": null, "website_url": "https://www.masterrunnersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RACING", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "38345147455131927"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_925716710197205_6797505318426454769_n.png?stp=dst-p
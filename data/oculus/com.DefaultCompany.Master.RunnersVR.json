1521830722346429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818916_1521830725679762_1465834721504573858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWK1I0O65gUQ7kNvwFBiznR&_nc_oc=Ado_SjUBcLQcsMFaTMmDpyocZb0mOp-jz-CFIvZO3wDhbV6id6gZROCh2IPtAKN8cQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49ZN_6qlk7CEV4hsK9EIbJVvEwq8OAsqMcx0o0_M2fDg&oe=6A01C2DC"}, {"file_name": "39035397_1205901727152563_7583367210078983654_n.png", "id": "826780613076960", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307413_826780616410293_5266478195837479583_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3b4xyY1lOsQ7kNvwEKUWs-&_nc_oc=AdrZcv_KTIDEgFT6sVHJ6OJIpFdtC-m4D-OBlDaMP62TM4cn-JyOHpgjot0vLk7w6fI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EQYLoLwV5kixJuZ1xnXd4HnO6N-WU2HlQ9nT2zK3LEA&oe=6A01DA4F"}, {"file_name": "Adobe Express - file (21).png", "id": "1368318864501538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392034_1368318867834871_1138933622027331256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJNCDZTeNaUQ7kNvwGDzl_p&_nc_oc=AdpJVnH5nHbLeLxYxEGZKXGsmiASpGkVpZK9wkIzbDmyjhisxqv3E3kgkIyRqXK1gqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sy7nO6HPf5dpRivVOkkcB63nLjNNoP2cvEAzvhlNmxA&oe=6A01F4E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "G3N3SIS Cover.png", "id": "2322699961473584", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_2322699964806917_6979417875942973266_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuzmBJv8mkcQ7kNvwGCuwJT&_nc_oc=AdrEiGHjcniqRFoQncp-C-MZaZ_pU3TpOjU7LvgSWL-3KJAA8waEKuLRTnpCVAhNacg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zDYuwpHS9LLY0KmhWmC74Ch6LxK2BBxpqApYCP4q_5Q&oe=6A01F12B"}, "display_name": "MasterRunners", "keywords": ["runners", "master", "mrvr", "mrvrv2", "masterunner"], "long_description": "# Welcome to the MasterRunners Page.\n\nMasterRunners is a free-to-play, hand-based movement VR multiplayer game packed with fun and variety. It offers a one-of-a-kind experience that stands out in the VR space. Whether you're into fast-paced action or just looking to hang out with friends, MasterRunners has something for everyone.\n\n# What you can do:\n- Play Gamemodes with players across the **WORLD**. MasterRunners can be played worldwide and with our **advanced multiplayer system**, you can enjoy multiplayer & have a very fun time. For the gamemodes, we build special gamemodes that have never been used in others games making us stand out and more fun.\n{1355181399287310}\n- Chill with friends and have a **great time.** With areas such as the \"Main Hub\", you can relax and have a calming time with buddies as you talk to your hearts desire.\n{760051716616133}\n- Shop for new cosmetics at the Master Mart with the in-game currency... Energy! Using energy, you can get all kinds of cosmetics of any type just with one click. This is how you can customize your character!\n{2223357978126342}\n\nAnd more. \n\nThere is lots to do in MasterRunners, so check it out **TODAY!**\n{1421192876087856}", "short_description": "Complete Obstacles, Beat Gamemodes, & Be yourself to show, you can be apart of the MasterRunners."}]}, "developer_name": "EMVRGames", "developer_privacy_policy_url": "https://www.masterrunnersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EthanMonke", "support_website_url": null, "website_url": "https://www.masterrunnersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RACING", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_grap
_A6xnTawGfgbWsU8STAWO-enJPWw&oe=69A2D6DC"}, {"file_name": "39035397_1205901727152563_7583367210078983654_n.png", "id": "826780613076960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307413_826780616410293_5266478195837479583_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5npIxJ-5IhcQ7kNvwGRIWNG&_nc_oc=Adk6hJgH5pqLZ4RuhHrcKaAYYS0XkIBH_voiyPwKJL-ZyAn5r62fAuvfGAjqhhs5D0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmGYM0jmgvvhdAGE8A9YeHmVnfaOSDMRA5TtpEQsWowA&oe=69A2EE4F"}, {"file_name": "Adobe Express - file (21).png", "id": "1368318864501538", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392034_1368318867834871_1138933622027331256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGtjVTgg1FIQ7kNvwFxLWjq&_nc_oc=AdllI3zYMLg79mjJZJ9A_3F1cfR4o1vpr_77yy2kgl248YuCxIKcjIfxTUJjilH628Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNTfwd-wVKXtjaxzkdHyZ0-r5pIabry6vXf0wC75QVlA&oe=69A2D0A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MasterRunners V3 Cover.png", "id": "4271961103074412", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295661_4271961106407745_655363617515116384_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHpJaa8Eaq4Q7kNvwHDgt8D&_nc_oc=Adn9rpBu1eflIQQZWDTMyOpmC_Qc2qHOohcYIIRnR_iHCdu2FjdUcLWpf5Ca95Z5eiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvYF1cEvL63XOICPW21dwnujSUWL6jNoVEbiwDE02T3NQ&oe=69A2DA88"}, "display_name": "MasterRunners", "keywords": ["runners", "master", "mrvr", "mrvrv2", "masterunner"], "long_description": "# Welcome to the MasterRunners Page.\n\nMasterRunners is a free-to-play, hand-based movement VR multiplayer game packed with fun and variety. It offers a one-of-a-kind experience that stands out in the VR space. Whether you're into fast-paced action or just looking to hang out with friends, MasterRunners has something for everyone.\n\n# What you can do:\n- Play Gamemodes with players across the **WORLD**. MasterRunners can be played worldwide and with our **advanced multiplayer system**, you can enjoy multiplayer & have a very fun time. For the gamemodes, we build special gamemodes that have never been used in others games making us stand out and more fun.\n{1355181399287310}\n- Chill with friends and have a **great time.** With areas such as the \"Main Hub\", you can relax and have a calming time with buddies as you talk to your hearts desire.\n{760051716616133}\n- Shop for new cosmetics at the Master Mart with the in-game currency... Energy! Using energy, you can get all kinds of cosmetics of any type just with one click. This is how you can customize your character!\n{2223357978126342}\n\nAnd more. \n\nThere is lots to do in MasterRunners, so check it out **TODAY!**\n{1421192876087856}", "short_description": "Complete Obstacles, Beat Gamemodes, & Be yourself to show, you can be apart of the MasterRunners."}]}, "developer_name": "EMVRGames", "developer_privacy_policy_url": "https://www.masterrunnersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EthanMonke", "support_website_url": null, "website_url": "https://www.masterrunnersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RACING", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33267850972861626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculusc
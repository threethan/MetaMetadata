ntent-sea1-1.oculuscdn.com/v/t64.5771-25/499307413_826780616410293_5266478195837479583_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUdiD5wnGTwQ7kNvwGbBY0b&_nc_oc=AdoZ839FPnlrwTxsUNJYubhdFDcQYMPDF97DgJqsnVaUmGiua3gXjOy3hmjp7WFur0g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58W8uVJUkXDVcIqayxrHrrxfwwAYEyWtufgZLORzN1vg&oe=6A15A0CF"}, {"file_name": "Adobe Express - file (21).png", "id": "1368318864501538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392034_1368318867834871_1138933622027331256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuKIGzz6SSQQ7kNvwEOJPOz&_nc_oc=Adp_mHuDc9VIpzRt81CiblZcDVozh2m8w_SbVbFm8Xch2HkkDoVZYHMTKMf18PVMXYA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Za5SElS_SePRdL5AtpDD3cPmkPDh6Lha2pPxAyADabg&oe=6A15BB62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled980_20260430004242.png", "id": "26827297403620485", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307931_26827297423620483_2099499957883665652_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrXz68Uh1tkQ7kNvwFAO2sp&_nc_oc=AdqqUNNIgVwfDwDCxDeAGkVYJeFO1BTPwq7gjCgbVQlk_B_SLKG99sI4I8ccHSQI9uY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UI5FQLJIHwOmksik2h-H2k9o0EhzeUXDqusjamFXuZw&oe=6A15B6EF"}, "display_name": "MasterRunners", "keywords": ["runners", "master", "mrvr", "mrvrv2", "masterunner"], "long_description": "# Welcome to the MasterRunners Page.\n\nMasterRunners is a free-to-play, hand-based movement VR multiplayer game packed with fun and variety. It offers a one-of-a-kind experience that stands out in the VR space. Whether you're into fast-paced action or just looking to hang out with friends, MasterRunners has something for everyone.\n\n# What you can do:\n- Play Gamemodes with players across the **WORLD**. MasterRunners can be played worldwide and with our **advanced multiplayer system**, you can enjoy multiplayer & have a very fun time. For the gamemodes, we build special gamemodes that have never been used in others games making us stand out and more fun.\n{1355181399287310}\n- Chill with friends and have a **great time.** With areas such as the \"Main Hub\", you can relax and have a calming time with buddies as you talk to your hearts desire.\n{760051716616133}\n- Shop for new cosmetics at the Master Mart with the in-game currency... Energy! Using energy, you can get all kinds of cosmetics of any type just with one click. This is how you can customize your character!\n{2223357978126342}\n\nAnd more. \n\nThere is lots to do in MasterRunners, so check it out **TODAY!**\n{1421192876087856}", "short_description": "Complete Obstacles, Beat Gamemodes, & Be yourself to show, you can be apart of the MasterRunners."}]}, "developer_name": "EMVRGames", "developer_privacy_policy_url": "https://www.masterrunnersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EthanMonke", "support_website_url": null, "website_url": "https://www.masterrunnersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RACING", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35657798680533498"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_992490063287279_3606270823131296799_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1
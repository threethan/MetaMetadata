18916_1521830725679762_1465834721504573858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOIXgl_7Ct4Q7kNvwEZ-G7-&_nc_oc=AdlIbGP89pgluhplTTYS9crrBHScYAqF1Ycqrz9kHz7esruHL_6GIXf8BGI0RZnPKo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc0A_7djKQX7UljlA7y3mtt5I_1m8otNG25uayo0TrDg&oe=69B005DC"}, {"file_name": "39035397_1205901727152563_7583367210078983654_n.png", "id": "826780613076960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307413_826780616410293_5266478195837479583_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n88VFACyGoYQ7kNvwGDuOqT&_nc_oc=AdkB1QBPJFJPoGbJLhvBqSHVVlFmqHmn3LY8T6B9zhYE0pmfmTi7YAHViEvMXfSGA6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOg1wgm0WVh0qV3XPKhGUAK8CdHKLfUnxNrjLw5Mr4Bg&oe=69B01D4F"}, {"file_name": "Adobe Express - file (21).png", "id": "1368318864501538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392034_1368318867834871_1138933622027331256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-6Udg1llh4Q7kNvwFvyptC&_nc_oc=AdmGW1VMCm9sfel4D4QSwYmmqAhA9FEYCy0tIOUduA3HO6nxHwhCKH40gHyZbV-Zubk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJ14Zr8TcmQgBFZYGbkJeAvd1-K5rJzmxoOa-kJMbxBg&oe=69AFFFA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MasterRunners V3 Cover.png", "id": "4271961103074412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295661_4271961106407745_655363617515116384_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q6v0BqRFvgQ7kNvwEc7NRq&_nc_oc=Adl6A3CyzBaMdWO2s9uc0R0z2dct7komSVSuRNSe_-U5rdrUu4GCh_Z8dqkOuQJ2MmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsOvRrG5cpNdXvz9ikoA3DGKL97s4tekMlw9wsaElk-w&oe=69B00988"}, "display_name": "MasterRunners", "keywords": ["runners", "master", "mrvr", "mrvrv2", "masterunner"], "long_description": "# Welcome to the MasterRunners Page.\n\nMasterRunners is a free-to-play, hand-based movement VR multiplayer game packed with fun and variety. It offers a one-of-a-kind experience that stands out in the VR space. Whether you're into fast-paced action or just looking to hang out with friends, MasterRunners has something for everyone.\n\n# What you can do:\n- Play Gamemodes with players across the **WORLD**. MasterRunners can be played worldwide and with our **advanced multiplayer system**, you can enjoy multiplayer & have a very fun time. For the gamemodes, we build special gamemodes that have never been used in others games making us stand out and more fun.\n{1355181399287310}\n- Chill with friends and have a **great time.** With areas such as the \"Main Hub\", you can relax and have a calming time with buddies as you talk to your hearts desire.\n{760051716616133}\n- Shop for new cosmetics at the Master Mart with the in-game currency... Energy! Using energy, you can get all kinds of cosmetics of any type just with one click. This is how you can customize your character!\n{2223357978126342}\n\nAnd more. \n\nThere is lots to do in MasterRunners, so check it out **TODAY!**\n{1421192876087856}", "short_description": "Complete Obstacles, Beat Gamemodes, & Be yourself to show, you can be apart of the MasterRunners."}]}, "developer_name": "EMVRGames", "developer_privacy_policy_url": "https://www.masterrunnersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EthanMonke", "support_website_url": null, "website_url": "https://www.masterrunnersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RACING", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
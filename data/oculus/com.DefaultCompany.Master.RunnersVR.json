1521830722346429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818916_1521830725679762_1465834721504573858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWK1I0O65gUQ7kNvwG0W7u2&_nc_oc=AdqVvQN-lnEuxu2gMCV-PvAKeK2zb8kSduDc2dt6NLDgu8fHY7FksW3SADk2WgjXvH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D02zTuiRrILiCScyKtmoEy6j0pQnMG8LC9aepJwfXBw&oe=6A0465DC"}, {"file_name": "39035397_1205901727152563_7583367210078983654_n.png", "id": "826780613076960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307413_826780616410293_5266478195837479583_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3b4xyY1lOsQ7kNvwHo-UAq&_nc_oc=AdrNJwfZiyP3lqu5S6NgJvOcWLmxcGx2PYUzE4vCwt-tqbidmQAEQOLtXrp8M38HZfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TMtKybFNZ2F_Jr0pN3OW1AYe1NYkAstr4r0I2G59ung&oe=6A047D4F"}, {"file_name": "Adobe Express - file (21).png", "id": "1368318864501538", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392034_1368318867834871_1138933622027331256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtvtAs5r5KAQ7kNvwH31tqp&_nc_oc=Adoqo0hqKa_vUt1oqUhpYJlSlEUcL-MN_9ABgfrmyE1jmjK1aMt0DAW7JCABWQZ4BUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r9mR-Ak7gD6sm_GAqSyywyc-foZqJMk8TloBp7IBT6A&oe=6A0497E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "G3N3SIS Cover.png", "id": "2322699961473584", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_2322699964806917_6979417875942973266_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHV5IGINAGoQ7kNvwFRvt3K&_nc_oc=AdrFpFYkiV-FBll_PbyBoJoFNBV89FWgLeG4NCbzj-QaJ7GUGqlk4w5N1k63xWnBVFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bf35V0Yo9YI4TiuYNLaoWWUm_3Ra_egYfkHiNlfF1cw&oe=6A04942B"}, "display_name": "MasterRunners", "keywords": ["runners", "master", "mrvr", "mrvrv2", "masterunner"], "long_description": "# Welcome to the MasterRunners Page.\n\nMasterRunners is a free-to-play, hand-based movement VR multiplayer game packed with fun and variety. It offers a one-of-a-kind experience that stands out in the VR space. Whether you're into fast-paced action or just looking to hang out with friends, MasterRunners has something for everyone.\n\n# What you can do:\n- Play Gamemodes with players across the **WORLD**. MasterRunners can be played worldwide and with our **advanced multiplayer system**, you can enjoy multiplayer & have a very fun time. For the gamemodes, we build special gamemodes that have never been used in others games making us stand out and more fun.\n{1355181399287310}\n- Chill with friends and have a **great time.** With areas such as the \"Main Hub\", you can relax and have a calming time with buddies as you talk to your hearts desire.\n{760051716616133}\n- Shop for new cosmetics at the Master Mart with the in-game currency... Energy! Using energy, you can get all kinds of cosmetics of any type just with one click. This is how you can customize your character!\n{2223357978126342}\n\nAnd more. \n\nThere is lots to do in MasterRunners, so check it out **TODAY!**\n{1421192876087856}", "short_description": "Complete Obstacles, Beat Gamemodes, & Be yourself to show, you can be apart of the MasterRunners."}]}, "developer_name": "EMVRGames", "developer_privacy_policy_url": "https://www.masterrunnersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EthanMonke", "support_website_url": null, "website_url": "https://www.masterrunnersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RACING", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_grap
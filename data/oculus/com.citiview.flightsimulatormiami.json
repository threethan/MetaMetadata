reenshot_2.png", "id": "1054986554081330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_1054986557414663_1313737306890805053_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjndtiE7xhQQ7kNvwFaG8qZ&_nc_oc=Adprt0ccc3ufLh4GAynrTajV08YvWpG3viXe2hMliTjMBXoZrTEJ9bynq77nkJ9kWMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB9d3dkjEeFTi0sNtzA9pQGcvWJUU3nFFiM9Hh_fLWyA&oe=6AF48D65"}, {"file_name": "screenshot_3.png", "id": "1753849032569352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1753849042569351_1791242352634382949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPL7KV51lwMQ7kNvwFP3eGW&_nc_oc=AdrGhvbDXuGFNUqo-N-ElbooV6IWFqIPbV8BAuexAkPK2uS0AYv4gKnkACjCsm6-0VE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTijwIJe20WB-KPqk29Sd9bOQtUhxMiqOz-KHrPZLzjhQ&oe=6AF48873"}, {"file_name": "screenshot_4.png", "id": "27779761691698229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/789889603_27779761698364895_3767186296282524305_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10JkFm8baYgQ7kNvwEdQuVA&_nc_oc=Adq6xHPyW31J1fhKlXSJyfJT6-h2SWrfDBVVXmXbrira10Zx2_CeSTFctVrhknnr0ME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzPRSKj0Ayt3TRGFVLJ9D1048vEmxCibnX3SVipZ3OJA&oe=6AF4A5D3"}, {"file_name": "screenshot_5.png", "id": "1595032314912543", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596149727_1595032318245876_2658506441046128503_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc9pwlpL3UMQ7kNvwETALiH&_nc_oc=AdpZKO-QzAnGtu-IqaeeRoB_78skEoJmkgkK6bZO32PscUHCrA7mQjQVtECAgdFl6JY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY7UnQ0C9eRdOmFCztf-CLChTvLAmbT9vtZVR2f_H9iQ&oe=6AF49FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1401028048325283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_1401028051658616_186348754398613797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f41-yEz04fsQ7kNvwEnRVvj&_nc_oc=Adpf9wgaJ5WPwgHJskqkzVEA06z7VRhpwi4KYNPVBXKIvxgLuAP3Tnz6bJlAAAEiu5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDWZGfvGviUn8DC6yI_NBACU07ud74G8oVE8v5Vk68KQ&oe=6AF48C54"}, "display_name": "Flight Simulator Miami", "keywords": ["flight", "simulator", "miami", "jet", "pilot"], "long_description": "Flight Simulator Miami puts you in the captain's seat over the real Miami.\n\nTHE REAL MIAMI\nBuilt from real aerial photography and real map data: the turquoise water of Biscayne Bay and the reef, Miami Beach and South Beach, Key Biscayne and the lighthouse, the cruise ships at the Port, the Downtown and Brickell towers, the stadium, the ballpark and the Everglades on the horizon. Five airports: Miami International, Fort Lauderdale, Homestead, Opa-locka and Miami Executive.\n\nYOUR GLASS HANGAR\nEvery flight starts in your own glass hangar on Watson Island, with the skyline across the bay at golden hour. Walk around your aircraft, repaint them, power wash them clean, then choose one and fly.\n\nFOUR AIRCRAFT\nTwo private jets with glass cockpits, side-sticks and cabins you can get up and walk through in flight, a cozy midsize jet with yokes and a club cabin, and a twin-engine supersonic fighter with a bubble canopy.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: landings at Miami and Homestead, a hop up the beaches to Fort Lauderdale, a ring run up Miami Beach, a skyline run along the bayfront, a low pass down the reef, a fighter scramble, a night city run and a Miami tour - or just fly, by day, at sunset or at night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join up on a friend's wing or ride in their aircraft. Voice chat stays off until you turn it on.", "short_description": "Fly the real Miami, built from real aerial photography: Biscayne Bay, South Beach, the cruise ships and the Downtown skyline, with five airports. Start in your own glass hangar on the bay and take out two private jets with walk-through cabins, a cozy midsize jet or a twin-engine fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatormiami/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatormiami/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1365369003322629"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1843483303495708"}]}, "baseline_offer": {"id": "1843483303495708"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791377760, "status": "PUBLISHED", "id": "1843483303495708"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1365411149985081", "version": "1.0.0"}, "id": "3179808922218328", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1365368996655963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1365411149985081"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_n
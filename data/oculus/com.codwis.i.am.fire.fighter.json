6QOZXcLSvg9-UrTIr-yA&oe=6AFC72DE"}, {"file_name": "1.png", "id": "1813553523053136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_1813553526386469_444016605361818127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0M9wLKYANkQ7kNvwHhl5l1&_nc_oc=Adql1-Xi034JDKCVwyfr_gPJoPjtHNHL3Rif5xhcERGDZ6LT5jfwDFoaM7Ps0Li5Tak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSowXjiB33nZAzt6TPFKtzFGdMZxGfAuwecEDTAK2_ijQ&oe=6AFC72FA"}, {"file_name": "5.png", "id": "1452012290197020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673525341_1452012293530353_4192160261938885486_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oadeMMcifgsQ7kNvwGVMFYt&_nc_oc=Adro4kDi73Vf73ejQM6mlxCnE3Mk-Ue1pe7EMt7oFeLZEXkozEmLPEZw8HFRe5Lnp8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3XnHzFwRdtLSewP2dpC-9GsuzUOeAEqXBH3SRj0USLA&oe=6AFC62EE"}, {"file_name": "2.png", "id": "1449156890425149", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830822_1449156893758482_4859785243894567357_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekKDZbqWhy0Q7kNvwH7z4X2&_nc_oc=AdrdLSskzLOHrKCGQZ_ezW15RNM_7kr2n1FhXRgx10T-teC3Q7fXbqFAXyWer8Ntmes&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyi5F4xzuQ1p8pw-0BtkESNR-qwJBdW80cArS5w2XDHA&oe=6AFC68AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Fire Fighter", "keywords": ["Fire", "FireFighter", "FireRescue", "FireFighterSimulator", "Emergency"], "long_description": "Become a fire fighter and answer the call in I Am Fire Fighter, fire rescue, emergency response, and action-packed rescue missions.\n\nStep into dangerous fire emergencies, enter burning locations, fight spreading flames, rescue trapped civilians, and complete challenging fire fighter missions. Use fire fighter tools and firefighting equipment to control each fire, clear obstacles, and reach people in danger.\n\nTake on 15 fire fighter rescue missions with civilian rescue, emergency rescue, first responder objectives, and firefighting challenges. Start with fire fighter training in the tutorial, then face tougher fire emergencies as you progress.\n\nKEY FEATURES\n\u2022 15 fire fighter and fire rescue missions\n\u2022 Immersive fire fighter simulator gameplay\n\u2022 Fire fighter tools and firefighting equipment\n\u2022 Fire rescue and emergency rescue challenges\n\u2022 Civilian rescue and first responder objectives\n\u2022 Fight fire and control spreading flames\n\u2022 Axe-based obstacle interactions\n\u2022 Fire, smoke, sound, and visual effects\n\u2022 Rescue simulator and action simulator gameplay\n\nI Am Fire Fighter is made for players who enjoy fire fighter games, firefighter games, firefighting games, fire rescue games, emergency games, rescue games, fire fighter simulator games, and action simulation.\n\nHear the fire alarm, grab your fire fighter gear, fight the fire, rescue civilians, and prove your skills as a fire fighter simulator.", "short_description": "Become a fire fighter in I Am Fire Fighter, an immersive VR fire fighter simulator packed with fire rescue and emergency action. Take on intense fire fighter missions, fight dangerous fires, rescue civilians, and use fire fighter tools to control spreading flames. Built for fans of fire fighter games, firefighter games, firefighting, fire rescue, emergency rescue, rescue simulators, and VR action games."}]}, "developer_name": "Codwis Studio", "developer_privacy_policy_url": "https://sites.google.com/view/codwisstudio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Codwis Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/codwisstudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529
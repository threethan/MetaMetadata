&oe=6A465DA2"}, {"file_name": "Screenshot2.png", "id": "256216799936785", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaBjoVLvfnwQ7kNvwHHq0XA&_nc_oc=AdqaDBRLiU-439mWzpkiC_Cg3XUM-Tr2wziJlR_jCmqAmTUr3L8f5rDu_8kkUCgto1k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oU9ZV1NJarNLLw0ICTfUel-pfOa0lP5SsKKMDtF3S-Q&oe=6A469037"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tDr4I-xAasQ7kNvwEjMVPG&_nc_oc=AdqQ__Nd3UsEdVpgQk999nkxSxdg22MX2JRsH3nSD02-7kUtF633Oc0DWyXACyoxKB8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ErRncipvHvdjVW4Zl6CWIXden3NwytMhrZhhQah5xAw&oe=6A466807"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9JNi7cM61UQ7kNvwFf3iuY&_nc_oc=AdprayJqSaTOsAq7XLNrJ9-No6Q6ud3OA8lI7_X6PycKgTgpt_79erMLcUq2oJ3X2e8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z05m4zA_nHddVQoJ8UelVM9GQ0jsVX7Gvt_9zHL4oDA&oe=6A46814A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhmdyWert6IQ7kNvwFFzH3N&_nc_oc=AdoYa2GvHwXyUWoyc91WHuRVl_XUcuImrJPWbUYrgy7UtN-8xLXT8PaZ-1HWGVqVW5Q&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1wvKB3BReTRcLzvz_sWJM_9hjxUZSbE9zVlRppDmDXA&oe=6A467535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsAGQLUnOZwQ7kNvwEjHvqH&_nc_oc=AdrTi9w5QvTjcttyJpF_T_cgT-SgjiViqMyQK82nLIekiW_vWFAeANfDGta69HjGtFM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LJjK__zZCkW9gwsG8FaFIS1aM8My7-ohheRpzXRXtDQ&oe=6A4679DA"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscr
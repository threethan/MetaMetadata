nshot2.png", "id": "256216799936785", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8kgz9lbVQcQ7kNvwHlmOJE&_nc_oc=AdqQbbrX_eeQjwP_cIOF58Q5K0x0leCoff9ktkfC49LzGpIBlx611TqqEhgs0BHw3rc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzbj_oKJb-WsOPVU07os59pmmG46twqp3zSeXwfhFKbGA&oe=69C13077"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G23G2B6piVEQ7kNvwHilUid&_nc_oc=Adr_g97yyt3pOzLEYw_E96Xbkp93d_zZO5TdD9HH6DyY1nPpoalW5oX104OSZ6YB4iA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFPJA3Nja8QmJoNmCbRwiFS6uxtOrlGkAAN9VvG-Ke7A&oe=69C14087"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wygn2vxHqg0Q7kNvwFV3HFs&_nc_oc=AdqBhNDXD_b3hU9t0jqv5BZh6rICYC-7hLXJWPkqhY88NoNzkZ-sqru8ISU7rhuJ6Ss&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOw695BAqOtYfRQAg9F2QWzrhxX9fAxq05Byglshn5bw&oe=69C1218A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28_6QQV3e1YQ7kNvwGq9Xpq&_nc_oc=AdqGXiA8iL09uy9I7RUuegzaJYWpOvdHmT76AWhdSjau63Hk1_1KWVX5NrBXORvtfr4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUaZjisISOPAeG64IwQIv3bYZ3ctcl_XTUObOfXRQoxQ&oe=69C14DB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MaEtng1hjcQ7kNvwHERAT0&_nc_oc=AdrffIfy7uMj5qmWrykbxoX6guiRzGfDFazbwqmueNL1xFEX6jDP7PJKuaQjo4m2KxQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMQd0QdDhZsJYxXf_P5Q-SL7aD6YsnNJqf_WmVob9v6w&oe=69C1525A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "
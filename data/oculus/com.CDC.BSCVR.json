&oe=6AAE8422"}, {"file_name": "Screenshot2.png", "id": "256216799936785", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90xyClh9zZgQ7kNvwHXMWNl&_nc_oc=AdoHdAS53EPTnVURmxMZD5DgDjliFZGNjAuZN-UTkzuM0pBHwYGGqej1fQyBnQPbQLw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm7XeBN5lP_p1HFjwJ3jIfZn5EuI8td_1oPmycT0vOxw&oe=6AAE7E77"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTW-qx6-PUoQ7kNvwEVIWww&_nc_oc=Ado5mQbjQRsAR1DzMPcQ4Og5Bh8qhh5glJNoRPX9tF8-b1ePinKa18cbjM3H2mFW9r8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-qAp9fcunmu2CodqG1h-qd0Q5lJgLS4fVJk7sd262TA&oe=6AAE8E87"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7rKIihtUg8Q7kNvwEp_KeH&_nc_oc=AdoM3hoWlF5uQieRA-6gX_7mrPdX1lrwUKUjhu4Iwup3wrGaY3B2nURCU-orEB6TWgg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWMW3F49EwEMgmocqel_ZlWqcom4y9Tyumyu6WBXemSg&oe=6AAEA7CA"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnXB6Zc6lIQQ7kNvwE8s2Yy&_nc_oc=AdqbLm7VpRdV84W1wC9bxOO4r6DfX4v34BE-8-3WJlxbSrEJd4Aw_kdDsnKTH9lTrto&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ7BxghoftB71BQu-VYyyb2G0Bh-OpKpDvsFQE2H3LtQ&oe=6AAE9BB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbIAyebpWnkQ7kNvwHCOw-F&_nc_oc=AdpyL4Q8fUAI9ZrI8X-mtosDUWYm7arIOexzxoXOJv61Q4mMRdmS_FyCssiV8bIGytI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX5eMnVO-P5SfJjfhcCj-ij0BwbmFUAixGde7SkdABaw&oe=6AAEA05A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscr
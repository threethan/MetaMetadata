creenshot2.png", "id": "256216799936785", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5BnqRvThWYQ7kNvwGTsbdl&_nc_oc=AdnIstqHGH0Tu5DncbczhMT7WQFKL9BKj2RK50Hs1YFKm0yUMYkfoQLT1diN-_knUEM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzODPvrq22qBvlhuQHPKG129k77-mrHtW9W8tZXhDAlHw&oe=69AAC6F7"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIUGRovP1E8Q7kNvwGBKfy0&_nc_oc=AdmcD_T1JG176QeELxDObNV2W8cNwYe-9tph53Wscg7FnquW1km36yQn5TSlom167k8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMjwGUfFVBiFAoVe9pQGKwpjHwAcxmuvK7y--9ZAJjZQ&oe=69AAD707"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdocNYDx1WEQ7kNvwG8byHh&_nc_oc=AdkekFgHeiYziynCtTdzapqSPBPcyvfhN9pWn6sTn5b4uI3HQ_UtLkd5PZP7PcXdOss&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzeq9BugJ-cuBfc2IJMDfoDIY3gEY6W5DtqP1OWyet9hQ&oe=69AAB80A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOPkrKbPqx4Q7kNvwHnq5EM&_nc_oc=Adm787Gyo4ogEaUXNMz9Eq4MTkkZiM-dNULTW2NCG5ANA55Vdoodh39x8fhVUqZeql4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhIsZwu-wDkA9wO4a3IPnX2hlK2bAn_cwwP9BeeAo08g&oe=69AAE435"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFnywM7UIucQ7kNvwGA49U8&_nc_oc=Adk5sipj3QqzFddSJCKsaQVJyZjQr6898vcsR20Kw17dfq_omIYK4sI--Okuc50cx68&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJwGQNvLbFXEBGx3rAMGLq9Z4NahMJKWwb-YfN8GzGrw&oe=69AAB09A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONA
nshot2.png", "id": "256216799936785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzde5CaN5DwQ7kNvwHlnbO_&_nc_oc=Admo7fZQMFntHxmbZL1Mbg5Pd3CGDtlnebTIYl5tIN1Z_VVS9nhs1_YIIkoUeday8AQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCaMieQHEm43N1lGEi60lQNwerNWiPu_Ji27b55OdRtA&oe=69B6A477"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALsPxAs9R6IQ7kNvwH2_fse&_nc_oc=AdnLP6CLDenLX0hYt0bDBA0HHaxCPCn_0pVjlIMHAX_oBPXkV3V2J_SNDEshvpP-vXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbSN2Ht9_EMsMWzFYUkNgI0dm0BWhHi__Hkx3oOpGMgQ&oe=69B6B487"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A6UYObjHsIQ7kNvwH1NtS2&_nc_oc=AdlSOUK0Uu4ufSSIJt3WbQ3vW449AIHKC9qDR81-MsfapbmuoZ20h-g4z9nUV8aZ50o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ5Ntn4mbQqxRZOzvH9siDS5GovXA9WZvY2VvUH4eKqw&oe=69B6958A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTNU_PBNcgAQ7kNvwGVYa71&_nc_oc=AdmjW-FdJhCPqvRUS-awdA74QHNEKCFb6V2T9yqjuXXb9xt_-h1zDhyDlQdAfdpUGYc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8kC4k9XDNbQk8fFuzcn2s7uzPKJF-mSBIYyvS9pBAYA&oe=69B6C1B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-spQBZ5CwIQ7kNvwGv6XOa&_nc_oc=AdlOHBXx-G1035C_ysl99923njyJlsa0O3ZXhKyzUse_sP1P88sDUfqc39RauG4FV7Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS226I1kcfWbOCvFDvoiTVIFZJE8b1Yb1snoR2w_1z4A&oe=69B68E1A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "
nshot2.png", "id": "256216799936785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FezLearsDE4Q7kNvwGmCtm9&_nc_oc=AdkZMK10bHcGOUixUx79onTDsrPqXZTek6TMhOBAQ9DocqfPEN8uGInzPx7VKeXTmpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyl_uI-Zs4Ug-URzXM9ybpi5k24-ynW6p78JFUGc9a8GQ&oe=69AD69F7"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xDop8mrnngQ7kNvwF-Ts8k&_nc_oc=AdloJNrOAe_APXM74PIHwg_INTpGCZNT3TMLLnNpbBynIzVYEaNlXD21ZneFOqvTdag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybAAT9iDcIE7c9OWQ8YmZbeQi3QxqRypAHemQPw7XcGw&oe=69AD7A07"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-7fhSGKSlMQ7kNvwGJizIl&_nc_oc=AdkRL_XwEJu3KmiuJMRBCYIeJK0bdV5AzRW04knMiVJ_ZrqVTT1ioDl7rvsvoeI2554&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIseBp1MUD0xS20JN1TN1Clmh6_XaYVCEYsTXX8J-41g&oe=69AD5B0A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLPnua-xJNsQ7kNvwEihVqn&_nc_oc=Adnz5GjDaYVmrjRxy5UofSxcidh4HUTF6zWG95DjagnGnMgF5IX92FYqAUvY4dsJEfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzX0QCyqYdwh4p0S7ADG0-vqXJ3IKouIjoZPaOxIIeYtA&oe=69AD8735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFnywM7UIucQ7kNvwFNFnnO&_nc_oc=Adl27xxQ_AFqkU4hrITF5SfUVmN-58snUvCTxPbKWrVaEnn7_xrok86SwUQkbUJVHYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSToyvRD6iFIhhiNytbdPkWATFxdujCjSRdV6iCxCC1Q&oe=69AD539A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "
nshot2.png", "id": "256216799936785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8iHIXlmQMoQ7kNvwHfvO5S&_nc_oc=AdmEtjv8Oeq405wQaV5yFNUUD6lHvnHfx0RWMhz0Nd2vntsK-mETqaKMhDP_IzGX-Ds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmdYXPej6cArdQyC8DNrJsUhanJLq3el3P3-Mluoj29g&oe=69B94777"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHBhVnakXjkQ7kNvwENxNna&_nc_oc=Adm9NAwFJLl6wG8gDOV6-o-vuK0nkvs3qkn29v2jH00Gnqt8gS8ExOmpBhgXCe_2BaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfWijEVZFGMcymm_2hX-H1I4KZdTECBqSWj0HI88c2rg&oe=69B95787"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oNut7JBujQQ7kNvwFZ-TLw&_nc_oc=AdmCcWmPLdmJDClD7T5_vh74hR7224YipYqN_ojSuALpa8QRqmayM6asH_bL4Hkrzfs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkuUnRwQfYANvyb-QhcDrDOsYVXhYW4kKtfJV80ksjvw&oe=69B9388A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DjW7SRU1PUQ7kNvwFYJms9&_nc_oc=Adlzn7Utlxr7ct1h2WVber1n7Mj9SmIZ_UeFHPNndwkXxogX8udEbIHnyyjMDKtoQ6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2GgsSIxowI3div_GvEhqg8rVCn3etyUweMIKKPR8Z_w&oe=69B964B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-spQBZ5CwIQ7kNvwHy7m-s&_nc_oc=AdmJ6p_72LhWYG6MFRkLzrh2jf4W1FUut90zczQ58ki3zBoFGC3xK5JBVFrwl7vDAzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjIpT5tS6CbNjIP_VjEI-Tq_Cq6Yu2Jc_TBmkHaIAi4Q&oe=69B9311A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "
nshot2.png", "id": "256216799936785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FezLearsDE4Q7kNvwEq17kQ&_nc_oc=AdnyoLzHfLACjvyIvFU9nYNb2Y9I5DkXAfZWHheY-FEs4FxcFvTIDtomIfS6Ya13P2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyrpxqp4xff9ZCSlYLGsbHGuTVIA5ia-d2lTk7amgF4Dw&oe=69AEBB77"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xDop8mrnngQ7kNvwG9hztJ&_nc_oc=AdnOKZRHjZPy1WM5oecK2zoVu_srGalYaXyGrCcGgfCJXepRq9UGAd4Hc1vmLx-DJe4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDUfMmR3CekEu_WE6hjqMSI_fvHQ3xbXOvBI0o2I-nVw&oe=69AECB87"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-7fhSGKSlMQ7kNvwG1GrPf&_nc_oc=AdmQSu7mzB-Fy35UHxqoHAWU3pIApgfD4X_dV3J_FBOoyTPZ2PlUIfoPXbc1L7FbqAM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyM9jn2Q9-SP3GfaDqBGeyLRLQJNOtuYqpdN5yzVfqRKQ&oe=69AEAC8A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLPnua-xJNsQ7kNvwH3BlWH&_nc_oc=AdlANUQpv1M3QyEuJd6jluZnz7NYbCfG_oFTze-Dd--cBxlwGp7Eoo71GMUMGy25JiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqzCQ835mO32oxZ2TzHAOe8HFB3KUijFdebM4PxHsfgQ&oe=69AED8B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RneO48IrtKgQ7kNvwGOxgi_&_nc_oc=Adkt9DkJZyv-oeKlDxPgUtiIJjomZgpDHjOIkDgbz72iMM-FplIVwV1D8PiNpoLjD0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhCrQqQtH5RwoW2sEDzXcJ61kEbxFyTXKs2lszZJKIXQ&oe=69AEA51A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "
png", "id": "256216799936785", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN3uH6VN52kQ7kNvwErIw1n&_nc_oc=AdrJa16UM6WjWaPDFDFq9VbkFDT_Zyabi1sB2dAZJ2fXrElvYhHOSHj7hH-fWyVlO9o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05BgqFQ-z4w_INKZjUU6NLfLuaVzR5efvi_fqR4ZkTRw&oe=69F1F7F7"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3Ic9VgkzxoQ7kNvwE2NCL2&_nc_oc=Adoe81304e3cpED_-MhhS9cFJYoOYc3GBkIyFbi51ijHSPiv4nW4m9QAxxuIYSYv60s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2v2ZqTtr9SzAsbK5ViTX5YqFxbbR_U_cxXlUg6p3V-KQ&oe=69F20807"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egnCPlv4t1cQ7kNvwGbG3Tj&_nc_oc=AdrAWKcM56i72PIcHgsyvnRyWHLJ3ACGA4O5A5vrFy-maQNn7clrWYeQpQverFR1ZmE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af02E4C7-WeVVP3AF8-MHMV9zE_JM52blToLk6oxUBLWOQ&oe=69F1E90A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8DgrycCF8UQ7kNvwE6bLAs&_nc_oc=AdohQlpajKdvwLZ2jP5UrqUDpgqWqp4lCW9V4esoA00ajnx9VQ5YtGR13u6r59kScw0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yiRjJcYR27ebPgD1_OLSrNrC2wuuY2Rk88KspX2QyLg&oe=69F21535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siV7tYFaas0Q7kNvwHTLZFX&_nc_oc=AdpueP9wRyh01k_BWiyRfXE33o1OctxHGpxl83AAoRSpALk0B85iPd2Dsy4jaQheR5E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1tzKYwq-vQh6GwjdXbZoTmAxYSN9-pEefpcbXtY--jzQ&oe=69F219DA"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ad
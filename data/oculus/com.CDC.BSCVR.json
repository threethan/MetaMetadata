&oe=6A392EA2"}, {"file_name": "Screenshot2.png", "id": "256216799936785", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC--qb3FxT4Q7kNvwFrUEuU&_nc_oc=AdolSXRB0y3POIaSzFL3Ykl5qvm2hubBT2fExsHJ2v1NU3OJhzJiQHBRBeDgFL2mtso&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hUU9_8Cj7uwhxk8sNOzmickatoimVQSTvDyyuPVd-zQ&oe=6A396137"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS35St0fEZMQ7kNvwEPpPCx&_nc_oc=AdqtNd8EEaBpJWWukE0vaTfFqrnvpc3iKshNsbFc7mNh2FQeKZXoZ5B2VzM7dflQyAY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tLskMfPLLh1eKty58jtPljNwf7JpG_ewQLJuQeNJpWg&oe=6A393907"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrHyS5r4pnYQ7kNvwEI0Y3z&_nc_oc=Adpkj0eQPNPKJrUPHViNLWOTcxBthA6EFhyEm-GC8j_Jv_UWG7epHoHEgZUoa7pbiJk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WcYjIziyps0wEx9vRm9hPoCoYI7x878EIeiBnTRyDfg&oe=6A39524A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTT7SFVJdvkQ7kNvwFgSSlB&_nc_oc=AdrlGBXcvjN6jPR9W7ynuXrOE15WT-4PJp-OcraroAPyXCDzfKX5ZiUp4CqWn1vGL5E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JNu_ncKG2aJv1rOHz6T87LhSHY3uvrx4I0tkI9GFVYQ&oe=6A394635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2EUiJc72H4Q7kNvwFe2Wy3&_nc_oc=AdoLe8w-nVX5KzBzV-byqmE8L5xdrZ1k_U3AhX209XryvaNjGtcVVw7dtuMk8RZZeiQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8muWFmdzku0xEz-OXwtqYFCaMutIcmnbAC_tPKmT94Xw&oe=6A394ADA"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscr
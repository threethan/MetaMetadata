nshot2.png", "id": "256216799936785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5BnqRvThWYQ7kNvwF-nrIU&_nc_oc=Admt4HdMedrdzgdkCohYSOlQRSZSHvTFXXASEgkJP05VlkKG_GSamd89MVhzBvNklOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs01DrukbPUNaLD3qAdf2O9Yccuyf6Ep_CFM9RhzK8tkQ&oe=69A97577"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIUGRovP1E8Q7kNvwFEfKzA&_nc_oc=AdmOg2I6b2tSAmkp_0Ep1gOrFFM2V0UgI2n7X0b8jmjhP93WJ2u7JQa-etaf_2r22IA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvPARS-s1YB6NMWMBi9Po1iSbdVJTDkHyfcL7alzdMdbQ&oe=69A98587"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdocNYDx1WEQ7kNvwHbB-Zg&_nc_oc=Adm1iLtAlt6FKS4PpQlf4ibN9espWvAVFOf0_JC3QCFZda__DQ61DQ8H0U81-upD3Pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuLIKxxSzSVc77s1AN4swxzF92k3JofQXHbXSmX2jsp7w&oe=69A9668A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOPkrKbPqx4Q7kNvwGpT_q3&_nc_oc=Admi_H6Z4gylBfRysP2Uk-a4V6khRIQ4rfCTjFLxJ3KUXcgyV4tLiymWdChu09ZZehM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuYRY-rsrtw70gCJ3kx1U2k4NgQzYqrY-KYhd_FaXc9ug&oe=69A992B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxIYaFT9jw4Q7kNvwFKac0Y&_nc_oc=Adk4Mt1U_Kxlt9UH-VOUndgOMKVRMKuT8p0JJg_72JkDUHPeUnERR5OTGmha7WnjKug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_nGeMJA4RzeZ8V9bygLZZ115RInITyT02aqdyWsg52Q&oe=69A95F1A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "
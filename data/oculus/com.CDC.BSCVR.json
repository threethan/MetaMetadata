nshot2.png", "id": "256216799936785", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8iHIXlmQMoQ7kNvwEZgqNS&_nc_oc=AdnYU8MOnFesrPz_VUzH28vrIaYLblGtbyWB9vus79qwGbRyuyA4QvknDqS2Fipk_1w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWNJmpilr_rV9hp7vpO7RbTW5Z2NszWWLEIiWykSNZZw&oe=69BA98F7"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHBhVnakXjkQ7kNvwGAiNhd&_nc_oc=AdkrHave1Nh9fnNGoNaIMdbTexBOSXXKgmEsZxFrJ9uZI4fdFolqZTX1oebBfKXcAUU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_4RIyPgkG8ESaaliVeXg6nJamVX5_7dktTs7fMffMVA&oe=69BAA907"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oNut7JBujQQ7kNvwHLqa5k&_nc_oc=AdlzDs8Q41-RzG7-C5HZR4qs6_fWIyIoSN3WMvoqr2Eyo2Y83zmHJtLGg4PQoREGOsk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-aWro1neJsYEZSDBbpCRSqJrkh9mxU7ma5U5Qi5ettA&oe=69BA8A0A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DjW7SRU1PUQ7kNvwExAHJW&_nc_oc=AdkfL9GzdCCoTcDmh6WBP-buMsmUdWCA3yhf_7jSKmxKB-4A3rERdLr66VBjoLwScBM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPabPEJoG-9xWAlvhuvuW_ZsTWD37CKjAURh8VqBdFyA&oe=69BAB635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09idKFDnL4UQ7kNvwHQyL6R&_nc_oc=AdmqD2ycIFrFJjU9UBEd1u8KhW4sUPS4QHF_OXWX3ZAG42nKfnxO4OYYVGYiheaozos&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_RBHX5S01MkhxWuINt__JHvSFnzDuJWqDirYl32mMPA&oe=69BA829A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "
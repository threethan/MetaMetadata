nshot2.png", "id": "256216799936785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_256216803270118_4407286868892353235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5BnqRvThWYQ7kNvwFV3Zmf&_nc_oc=AdlMOMNWW-RAKBtiKG6rgjsy_wotOlPFtOApMXnKTkaCoFfEmBam4Wu9GQJJUg00_VM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfteIuXWMQvp3VKxJ3fhuyrfFVKlCWKL-tpIEnEekjMaLw&oe=69A823F7"}, {"file_name": "Screenshot3.png", "id": "611830990032519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_611830993365852_8129286892222502595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivGbh3bqccMQ7kNvwF_LYFU&_nc_oc=Adn11BwLdZw6w988MbyYxbg_ZIUawovwm6BNxALDf9XXnd7rO7Lo0jtdbHIuZ39PSzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvj9aN_7rGVUHBqh_YXvVw2NPva7Fc8SWcoSS9_EoTUqQ&oe=69A83407"}, {"file_name": "Screenshot5.png", "id": "898116627571706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035393_898116630905039_506864153412416018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdocNYDx1WEQ7kNvwFYOEnq&_nc_oc=AdmV3W4oDfwip6QoL3C7QZNnlr1zlDDWULkcUtTjSKCvwYtvavnVWHRUOlwqdI9VpeQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftddN36fAH5LBXk9kStta49ksx21j1ue2U_QI9uu6AtUg&oe=69A8150A"}, {"file_name": "Screenshot6.png", "id": "382177290175526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_382177293508859_4158422507920947771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JilKSygBQOkQ7kNvwGGORJx&_nc_oc=AdnV-fM7Zo92hw4TFG74tEdH46IegG40obE0xdVv8I9c3_nqe6s1HGGHqjEd_J2V_vM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsf9a6MltcxGhdTQRCxe9lKDpbHfqEiUWm6yUph2nY1Cw&oe=69A808F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "640897637257915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982698_640897640591248_3726570399134143249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxIYaFT9jw4Q7kNvwHkYpKm&_nc_oc=AdnBgUVlf9ZMpe8ej59JPwovc6xBYs3zXb4xJY4dGSFFyBP5LgM1_gChaslRrIi9Vjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvLZKsLAx2iDSt6OOYchO_WIDnC6MvhBTvZSZAXLj2n_w&oe=69A80D9A"}, "display_name": "LabTrainingVR: Biosafety Cabinet Edition", "keywords": [], "long_description": "Step into a virtual laboratory and learn how to work safely in the first-ever Centers for Disease Control and Prevention\u2019s (CDC) virtual reality (VR) laboratory training course. This course enables learners to apply knowledge and practice setting up a biosafety cabinet (also known as a biological safety cabinet, or BSC) in a virtual laboratory in order to identify the major parts, demonstrate how to maintain positive airflow, demonstrate how to prepare for work, apply safe-work practices, demonstrate how to decontaminate and shutdown, and conduct emergency shutdown procedures of a Class II Biosafety Cabinet. This course is developed for laboratory professionals and supplements the existing CDC eLearning course on the same topic found on the CDC LabTraining page.", "short_description": "LabTrainingVR: Biosafety Cabinet Edition course enables learners to apply knowledge and practice setting up and working in a biological safety cabinet (BSC) in a virtual laboratory."}]}, "developer_name": "Centers for Disease Control and Prevention", "developer_privacy_policy_url": "https://www.cdc.gov/lab-training/php/virtual-reality/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centers for Disease Control and Prevention", "support_website_url": null, "website_url": "https://www.cdc.gov/lab-training/php/onelab/index.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "
_6.png", "id": "913955736073738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375766_913955739407071_6008632019843998102_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWDDwBccjHYQ7kNvwGrUQjL&_nc_oc=Adpt7PZWJT5RyLaXPs3GWnaWja_8iAQcBXpErD1XdSjHg7UMVuBvXusGAYNeR8_bADk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPsHk5IeDGuuTzPY0WF7UASJFIpNsrAgrEk28eYEXqkQ&oe=6AFDBD3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HandPhysicsLab_banner_video_2560_1440.png", "id": "357207155483141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974483_357207158816474_1904261332127684456_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvS086BbLvUQ7kNvwHmEp4e&_nc_oc=AdoeHR4Z-XH_mihsrvxnGyuL8o-PughfJNlyjgsiuFMeTO9esSUdsbDo0G8jxtmojsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKCD-Mo9XW5sK2P_cULZ9QysPSUBR6rNiS55lyk3CAxQ&oe=6AFDBC0F"}, "display_name": "Hand Physics Lab", "keywords": ["hand", "tracking", "physics", "puzzle", "lab"], "long_description": "Enjoy VR like never before by having full control of your hands and fingers to interact physically with your environment and many different objects and experiences! \n\nDiscover the unique universe of Hand Physics Lab where you will need to fulfill a variety of tasks and puzzles with nothing but your hands!\n\nYou will go through more than 80 different puzzles and experiences to unlock multiple playgrounds where you will have full freedom to draw, build and play freely!\n\nFrom painting eggs with your fingers, building cube towers, using magnets and telekinesis, shaking hands with your clone, petting a virtual cat, and so much more!\n\nYou will definitely put your hands in action!\n\n**Playable fully with hand tracking and/or touch controllers**", "short_description": "Enjoy VR like never before by having full control of your hands and fingers to interact physically with your environment and many different objects and experiences! "}]}, "developer_name": "Dennys Kuhnert", "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policy", "developer_terms_of_service_url": "https://www.holonautic.com/#contact", "publisher_name": "Holonautic", "support_website_url": "https://www.holonautic.com/privacy-policy", "website_url": "https://www.holonautic.com/hand-physics-lab", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1881608345360448"}}]}, "scheduled_offers": {"count": 52, "nodes": [{"status": "PUBLISHED", "id": "1306045298310098"}, {"status": "PUBLISHED", "id": "1370958951385080"}, {"status": "PUBLISHED", "id": "25789671817326970"}, {"status": "PUBLISHED", "id": "856000647245705"}, {"status": "PUBLISHED", "id": "4342318052655942"}, {"status": "PUBLISHED", "id": "4020995268151054"}, {"status": "PUBLISHED", "id": "2469098353449294"}, {"status": "PUBLISHED", "id": "699440449225567"}, {"status": "PUBLISHED", "id": "595064253272130"}, {"status": "PUBLISHED", "id": "873820877454868"}, {"status": "PUBLISHED", "id": "3236534343253073"}, {"status": "PENDING", "id": "611758883684010"}, {"status": "PENDING", "id": "879629723366812"}, {"status": "PUBLISHED", "id": "844442626431885"}, {"status": "PUBLISHED", "id": "608294711074238"}, {"status": "PENDING", "id": "679273013976727"}, {"stat
105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNW3SXg-T7kQ7kNvwHLN7UN&_nc_oc=AdrOcFN1g_U8v38H9xmtejI4OT7EpC4S619ROJxob8q87b0E5RIfRGC1g-WpI-i6aYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6qwj6LOZ_TL1e8WBgmsQQBMaeRLfjRAwg2H2c6yq_6g&oe=6B00603B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HandPhysicsLab_banner_video_2560_1440.png", "id": "357207155483141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_357207158816474_1904261332127684456_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bmms2P4xGowQ7kNvwGpnTgn&_nc_oc=AdqGZY1A8BX7DQ5cErRyp20R6UxkOGpJhw0e3YtwJyXjoFUROi-WFcOCBL24kiV8PMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0YhTfobZTV7x5s3-fmrTP4arC5Rd-w3q8JDBszNXKoA&oe=6B005F0F"}, "display_name": "Hand Physics Lab", "keywords": ["hand", "tracking", "physics", "puzzle", "lab"], "long_description": "Enjoy VR like never before by having full control of your hands and fingers to interact physically with your environment and many different objects and experiences! \n\nDiscover the unique universe of Hand Physics Lab where you will need to fulfill a variety of tasks and puzzles with nothing but your hands!\n\nYou will go through more than 80 different puzzles and experiences to unlock multiple playgrounds where you will have full freedom to draw, build and play!\n\nFrom painting eggs with your fingers, building cube towers, using magnets and telekinesis, shaking hands with your clone, petting a virtual cat, and so much more!\n\nYou will definitely put your hands in action!\n\n**Fully playable with hand tracking and/or touch controllers**\n\n**IMPORTANT NOTICE**\nThe quality of your experience when using hand tracking will heavily depend on your lighting conditions. Please read the guidelines (in-game) on how to optimize your play space for best hand tracking conditions.", "short_description": "Enjoy VR like never before by having full control of your hands and fingers to interact physically with your environment and many different objects and experiences! "}]}, "developer_name": "Dennys Kuhnert - Holonautic", "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": "https://www.holonautic.com/privacy-policy", "website_url": "https://www.holonautic.com/hand-physics-lab", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8941660915854223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031330_1401574353694495_4566637736836607084_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1DY1f-XcpwQ7kNvwExO07O&_nc_oc=AdpJow-ncRUsehYCI6nea3lH4Uhi0gnCWn4oGw1hYb0IxxyTewS4XEuHi5_i5clbMqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtFTS4ztRrjnXW9shPrwYMZt9Ug38pN_5MZhRAL_yy4g&oe=6B0065B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hand Physics Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1617296381, "lastRevisi
_lPK0aV7zu3GkUrpwrUEV1c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s_eG3n-Y6b2JXhX6uoVSLghECnBbfTMzCHkXzyMS_8Q&oe=69E77127"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlAtPtZPEsMQ7kNvwHXJIhC&_nc_oc=Adp8vl_oChsn3plNXUAnSNWZg3HRcpccx9Cmr2RL-ux_v9GieVFP4WsWG0mqPEvTXSw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zu62XW3GNAqOFEF3BqLLdpWx_yM6cWHcsEa-g18ng6A&oe=69E76B27"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b9MKzE7AKEQ7kNvwF6LIg8&_nc_oc=AdpXJf1vwUonnBfx-Yhe2_BJED8t7w4TO2M0--kvgJX1abHG7oUwuO0AoywMSKCDXoc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0F_aD106F4cV55drMvJ2KiKnmo92nOtYJ5_ydKl_e8-w&oe=69E78AD9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9HUmIieqg0Q7kNvwH-ROQa&_nc_oc=Adqy8ilYQ08ZDE7jRzNJR9_uYFY-593yoGUxZhnHzrnZso_p9jnRVSIB3gs7_5tdkFo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Rr4R_L8LSbZFBQjRLjSHpnkewdi7-d8qKbzCeWSqn4g&oe=69E77D49"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxTqxXg4MWwQ7kNvwE1VAxI&_nc_oc=AdrGUxNVAvroxGo1UCEQr7zHY34xPvTO7wV1CSaz-HI2u2osSrbHQapsBbbT1LX2rqw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25XYGGOY0loP-LmdVFvO4fO06eChEUBBtqm-ig2cBJ8g&oe=69E77BDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
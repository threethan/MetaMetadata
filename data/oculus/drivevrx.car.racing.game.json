QRT4oJCSzNX-QnXiJUYwsVw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af388RMSjdeW6__sQwYo8XUk7-KddIKBnnBoLUsXcs_JnA&oe=69F4A027"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYRS_sl07Z8Q7kNvwFUKKUV&_nc_oc=AdqfkJV21x5gy-bPYDJyFWr-pdySymPe7nes4E3OTJYVjqmUGF2Oa9NY8tXn5rJ7cSs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dcigJ-IEccSBMZd5hi5JlJjoA5HsVqn5A0AnhWeTXUg&oe=69F49A27"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuKI4nTX6msQ7kNvwGiYPct&_nc_oc=AdpCcZqnmZR4BsP5d_X2YrR5Y6Qf_x4m3rEKf0mCQo7nC9bH8VbWtVYS1fBhgqCXdWo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lu8_xj7c4yALMRrre4FjRdiSwlu-hnmoFt8huGBH9cg&oe=69F4B9D9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=495rvWqX9NwQ7kNvwFPe5TT&_nc_oc=AdoES7xLUds1UKwYCB2kBEU6KmUL6u3o-AAmsZE7fwfbXD4gLdimpRBG7w0a9HX4QAE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35CSylfsr6q2hBLxS7ZfCmaqFIWbO4RAPNQGsnY_EM0Q&oe=69F4AC49"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euBW3-ahZmwQ7kNvwFqJ9rr&_nc_oc=AdoMt1PfWLr2FBLYJWvdIvUjzMGh3sW2ZneL-FXwpCpmRZIz4gJ8battAZf_9OSFBdQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fTZvDZ6BGd7hwfUGwmVwAT2IPeXcBn59s6Jc2vAEv1w&oe=69F4AADE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
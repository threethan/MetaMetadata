pxJBJDK42tOaqjhLQikRGzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30wayeRPh2kiu_3Iq-h0EPTpKcPByMcqwAHj9Z-vPheQ&oe=69D3AAA7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FsQFssrW5wQ7kNvwF1fDUX&_nc_oc=Adr8jxy82I7T_s6Xum5RVeUG0AerCiMMFUEWJN2UtgHy7AdcgRlMf5X9PH300ZQ-2BM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FxsbVoQRJrchhigJdoUdinoj3Ke5nBUeOQFp3Ll6p6g&oe=69D3A4A7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvHL8v-k2GkQ7kNvwFJHsOw&_nc_oc=Adqd-Ks5fsYGgfuEHTWZZBE3eOnOInSFGNAfdiMAT1hnqdswGiLV97WpOBQc_fbk3aw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13HmdPJ78sMCr0ElSpO2myIKH0vZA8IhklwV-tDrK8zQ&oe=69D3C459"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCkCzGVPmfwQ7kNvwHZrIO1&_nc_oc=AdrRQyIjiKwEUNjLJgbzF7NhKGl2re8uv6H0psi2j7MkAUbKdnioJMiMsHPnCTfBx0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TyeRLiZ04JFpLLlKAoBtq65QDXDsOfFguBPl3OAQrAQ&oe=69D3B6C9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At7QG2KfINoQ7kNvwFrITU8&_nc_oc=AdonQMy9SpTjqecK31FdIOvdd4ZuFK3TZ6olQlE0Ykh6QrAMIY4s4-x5asMrA6CPbko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VGM-pANWtF9GUcUEEl3jxUj1LQpcSicANsmR75mhs5w&oe=69D3B55E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
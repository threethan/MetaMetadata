sr2HWGkm4o-hknuE2U8RYNydPh_1ClfJw6Mr3xkNk29w&oe=6999A8A7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZOLmFzsAdoQ7kNvwH99C_2&_nc_oc=AdnMpf4IJ1IcobSpJa9uou5DSG8oXhXwBQ7R8SSDg0fD0WTTSTq5eCfXrj65W6_w7N8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftK07oWqCTNph-z3duxwFCPjbbvuL1fNy5BcDAKsmPZdg&oe=6999A2A7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwn5cuKcgsgQ7kNvwEXVlsV&_nc_oc=AdmAUoWiA5n5yPhkv6qgZ4RfpQUGglHszx-3jjchAeM2XG-GK7_ZYbs7ugPkcxhTA2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvJGYFxA_DnH4pR_jzDPXhfDg3nXp4KWbRWtfF4aGKvg&oe=6999C259"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9BFtyqUAHsQ7kNvwF7OhHm&_nc_oc=Admcu_UD4ruy86nmsr9wCYt0Cghv8udP2p8P64-hcYrwNXSNAaL_ur3OIBx7zPs3VfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4--vg_00Q8ix-l-Yu2_9ZqxF0rNyrYI4stpQQSd8vWg&oe=6999B4C9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkMspwahshsQ7kNvwEfnxdC&_nc_oc=AdkSCU77WKWZ6UUpKGmKV9k44Lzx08i1KLF6zA0Q2gVtQSy2UWLxtRf-aEGIDTi4njE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu8hjMZLW13FxegWzoBgSmnaZEumBPAdAMLAKKCtpSZ2Q&oe=6999B35E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
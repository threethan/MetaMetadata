qxk60ZpmcxMtpvcgSG-TeqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P853luptbTP4_mhySFMUxfQyawvtyRXzml4xe6XsJnQ&oe=6A1D7EA7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5UlLViocQ4Q7kNvwEpP9KO&_nc_oc=AdptG3ccSd-Z5aaeJSlK9Q0HzQC8fzh48sIEf6WNkwEHsaUvRDYqGIX3Bi12rNXddJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rvul9Bi6mcUPh-Pgv3k73hVeegJbog69ff4TiGcaSPw&oe=6A1D78A7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUH3ScLDgYEQ7kNvwHBl-0e&_nc_oc=Adq-sDKRGoEARPqg1y4XnQu-yehwL5nhvxzBw1spA_5roIHEhMAX5eHN6j8kanyPXrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TxqyAs9X-5uo78iFWLBrKc75R-2mCTfLWFyJtCIYcNQ&oe=6A1D9859"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af7HFPFUB_UQ7kNvwEjEymf&_nc_oc=AdoFFrCmhUmVGXhVPnKjcXXVvwOMHHB23-BwVVf7auBM8xH4Ux3LGk1M1drfOkyZ7xw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lBQjL4_Tt07X1DY0oK00s_55sG-_-57iRKuJeLeZMhw&oe=6A1D8AC9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_AZuuPxDvkQ7kNvwHhxATC&_nc_oc=AdrzpOV-nWVVwJQTeq6_VWCplFVLmpAi6wztzdVtqF4xgmtDuh9kH-ph93vFJyemAzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Zmfy16-qWSYcCO1GQSOlx5S7aBuYGobKUqq5J13_UHA&oe=6A1D895E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
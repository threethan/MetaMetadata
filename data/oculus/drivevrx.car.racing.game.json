nCgBv8sLzzr8uMlDXPaBmZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60OakAJNylTZe5kGd60eHrnmcaQHR2yxwJVx33wC5CVA&oe=6A05C3A7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-et6mp6dcUkQ7kNvwE3IuFi&_nc_oc=AdopTI0sFMnDYWCXpZMAN5qea3EHpHxRK7LuK_xbfxbOrKLJBbW6PQlZ6sv9wHMJR9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FRel0h6DfgoG4AMVU4CE067km6R8CPt2eyljOhMmG4Q&oe=6A05BDA7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-beihsGHlnMQ7kNvwFpHwPx&_nc_oc=AdobGuaJqscHXzkSOTHb386S2GpwP54z1H9MSBKx-VP14RR5b3eYbsl9V48Jeta0YgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GYCOOaQnSgd1QLWli_UXxfdl9MJ8KzVZoaw1B2zUQHA&oe=6A05DD59"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0jD8CORPzAQ7kNvwGqjRsY&_nc_oc=Adope9CG5blwI5LjGIqMUVlEQLDuhXL2DuiBONYtHH_shHBWtc8TFam2AU6su0Yew_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p80vMp_E8oVJFjUqqIkjPQY09L9JEG9sdjQDKMDbGNA&oe=6A05CFC9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omuHAfv0rFgQ7kNvwHR-Vfq&_nc_oc=AdrzL1IgIrcslJEW8-nw6Pec3SVL6pozOOTPcP88ma9695pBO-iFx19Biy-TmRabexY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fMQrzz7HmoRARFMmiJJFKbZhbNkkBpOjm-icWwwpQWQ&oe=6A05CE5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
gOsC06NwMEImJrDTZAw3B7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysESb1Sod-G8HiBp53qe-jw8foJNTzYS6WfYEIR86NDA&oe=69CA7027"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Zq3x0WTe4QQ7kNvwFZ9xQS&_nc_oc=AdqCLJ2czE2CFyXazoKwNDWY0MBuQUmEFls9R7N8zbNvPtIeEbOhELBVagHxeaxyaS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7s7qTPbo_-Rw3HFLHtGg9jzGqnWs-U85tWtYRsjkxAQ&oe=69CA6A27"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUwmxbiF6dwQ7kNvwHDC0Gg&_nc_oc=AdrM7oagUsbJNIUAA44HpQNcr1pGlBrBfHUQkW2hMXPVWiWm-NKla4Jhawz7vArdGNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyu5AGOvdc92wRLOP3XClw-hX_VXrGoI0PcVdyO4lTGsA&oe=69CA89D9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9HUPToDt4EQ7kNvwFTKBbp&_nc_oc=AdoAwhQrRfvxeN83pxYuRIdpbWAvArv4-WFnFxUSJySawy3rj4xRM_8d2AKPBmX48-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXWK_0IF01DnSr0lZdjTVVwc7N2hHSdF-h71oE3AXC5g&oe=69CA7C49"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoeLhZz9ICIQ7kNvwEZGCNn&_nc_oc=AdrM-XSLIxAwC48196TpOJHKX652TZ7vYnLltZX-Ve4eaGVxd95X22QPI2yVx6Za7Fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEXjAC-2B9DjJQmv-KIIOYJ_tfOxFt5sfO02HZM2LI-A&oe=69CA7ADE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
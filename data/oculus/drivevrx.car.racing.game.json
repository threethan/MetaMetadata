2Di6TIOjbVqIQ8IIT8k7FHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E3R43XOC4X14erHqyj8BKudidel82SygmaMaCRNtIRg&oe=6A198A27"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wy4XBt8sq0Q7kNvwGDSJi0&_nc_oc=AdqFXeadsMWsbblEyPzdrZjq2ZzzcMEwIj3l1nDa2eX_jRjkmiOrPHtJjWtX60HflD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C0CEhaSDLKe8XDVGWA6s_IoCsrSBlP28wesyPRtPpFw&oe=6A19BC67"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6lOkrZquhwQ7kNvwHPDGuR&_nc_oc=Adq92VLY_9t1ixNGIZEnHU_79iy3O3rQxXBfXNj8iODtCeRIdZmfmbNBStACx76IwQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d7bZSTG27gn3JsP_a_dGHiU1T3aUO2FT28K6bGKBItA&oe=6A19A3D9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrGpc5VyAasQ7kNvwHQArP6&_nc_oc=AdpfLOTPAFq0dHHXuMYTdNWagkt-mWIEjno-jZxtorevw6mz1luvTx0vEZ8dROT_pkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a4SaSw7NbrCVrRA6gyhS0168e9uix16tIvGoZU-6sKw&oe=6A199649"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXfGRN8LqDwQ7kNvwG0W84a&_nc_oc=AdrDVVGm4Yij22kyAMUiWur1K0EnOOkn7jLcrQXXfl0NSI0SE6vZhOKDoumFF7NsKSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79I8TSjFvysK2ijTSK7d4gpoAWgZ7W8E7k-xvS_gYsvw&oe=6A1994DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
KAdsT3mWXP4I7a6WkHU79H0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIvfytwv_Rerxv3PIA4Kh46iRa1PiIcQAi3DN2oJi7zg&oe=69CBC1A7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rJeDl1D1tEQ7kNvwErXY0Z&_nc_oc=Adpk-9SD7Vj5ervGjMuytzBB-YhRj4Jimh5qfV_jjStRzl4DPYqNURTpa-_VG8ASJO0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0ym8zzUb78GIX4GyerYDagYBTRJeHeDMUQD7YAvM5GQ&oe=69CBBBA7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQceek6eZDsQ7kNvwH8LSEs&_nc_oc=AdpO39Gr0c5bSgqr-vHPuz-V-S_4gjOlec33haeosEI8gixxepJHdDyRuHYmGLygi2U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyg0eECpQKC375gEV5X2wlMd-0di2w5I9-0ethm_sMUHA&oe=69CBDB59"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9HUPToDt4EQ7kNvwFR_hKl&_nc_oc=Ado0SXjvhV9NhO0Yl8LXda5dSiaBeijbyJ2hAh_b3eH9PXNjghiTuJ3KLBVZbzGIsgQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVkxp_O_bwuuA2t8Vls7MAy80dyQznvhnBLj7fpS9bZQ&oe=69CBCDC9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoeLhZz9ICIQ7kNvwHmHwz-&_nc_oc=AdqsH1LAAmhLZlqOEVOCQ_2GEFu0eVZ2zhvASxVp5cFxw9QsZ8JNbTQCTSP_ylJjlbA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFOUfQ9_YclIcQpWOU1K2AjwzDlcW5r8sQ8jwoLoWvyg&oe=69CBCC5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
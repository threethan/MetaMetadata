IAMJFMhtk6sGoonjr9tSXpc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBvUXYJtTipzQgjhwWJoDx4gclQG-Rt5qV2tMDW7-dbg&oe=69C7CD27"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Zq3x0WTe4QQ7kNvwH170Qq&_nc_oc=AdqD6cam4NR-j2IRltT0EHdm6CFr5iTn0Wbp1ae02Ri2tH-PyqvD9D_WZFHIqNJYpCc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyl6hT86uyOqkAKgBFvj5Nd5mrhfxvRPCS2EIOnDLEIsA&oe=69C7C727"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUwmxbiF6dwQ7kNvwGDh_RH&_nc_oc=AdpgMHKWXefpEnVWj9vL-YC5ax-SrXQbJWW-UJ5jPWFLJR7L68YnIZEnVTnA1kYCSm0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGHA-s2uKa_CpbtjgaNbH678-7dln-hpOPcc6dKp2bpA&oe=69C7E6D9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg3QPYvgs2wQ7kNvwEurRFj&_nc_oc=AdqkLA0p2zXmHpapwCVAfX60DvO8NHwnn8NxMMstYU9s7Arr0fdS0Dyv8pAObuovApE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpPZHZUgnUpE1FKmsv7e60rDmBOiBD4jLrN4S-BfZDXw&oe=69C7D949"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ula72L5S-yoQ7kNvwGxe0xA&_nc_oc=Adotvukp-igoUaS0dG5RHj1cyNY-cC-PEsQcQNefcAgGVfHdaqxivBssVUDbi3-kIHk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz39XW3EqHbkBoYKHL_OzQwJ_SqKhpzTdcy0UAMcvQxYQ&oe=69C7D7DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
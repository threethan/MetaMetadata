1Kpkqm6TCf4dsS3xjhwAqUo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9AP9zy014lFGTpGO0v7qumN73mAmRVEx7J8YI0LFlTw&oe=6A2BFF27"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Az5IuW62JNsQ7kNvwFPaAho&_nc_oc=Adq-AprrRtThiehK9iWxCRz_diEmHeNELlq29vfEtY7Aizz4bi3Hi7kquatWnPXCk-I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q9KLCidc1i95OTckVa4LCHbYaxENKHuOQdouuzfEGxA&oe=6A2C3167"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lub-ylx8aZUQ7kNvwEU3JkV&_nc_oc=AdqCsBE1dsmcOUvhm940h3uM801oIyJZkwkb2dqdfix_mfEad1FZNxOw031TdAovr6Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ydM1XhgBzR_7ibgbmuZQoqGA5b53GockmxEV4k79N5w&oe=6A2C18D9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVpD4w5BkxQQ7kNvwGSjh9e&_nc_oc=Adp1jFjqE5AsgG4KD7pd-4BezLya3cMFJxI1j1abzIu7ZYUB43p2Sot4K9RtKis2USg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rFi0GKDwvSyNNfjlb01MHIig9nWYhrbJP8xuNr6MoxQ&oe=6A2C0B49"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou8Id5Rm-DoQ7kNvwHc6R7I&_nc_oc=AdpapcswhmLTWhncYJpFo5Tx5haX1tACPAZToOsbt1LbMqvwVZsHDk8JWetuukPo1so&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hi8uv09oe62oIkU-Vnijrl1mqWpDCSZZO1l_oyiTx2g&oe=6A2C09DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
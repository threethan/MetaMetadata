xwShs3Md5tj1frutwbDYiZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4YjNOJ-UF1WPyNlSiUN0sCTwtwL46nBOjxq9x87C3Vw&oe=69C28727"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3la6BauVDwQ7kNvwEbqCoh&_nc_oc=AdpXU0CEBDWbIPyNLzBdBAXLOeqRjZULv-0vBOHTwPm12R6tGYQxBV5MOfTdDc5_hfc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiFVW5zrW3FN3m-E-jzkStA6FaAJ2mykNCEg-g1W_CLA&oe=69C28127"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiHR481ZqwwQ7kNvwFKyVJM&_nc_oc=AdpgXgtG-QS4dfp3pa9SbdpJc_ruzgmX_plgg0cZAQGWu4RFw7CF2wzf5aVlqARcXdc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV-sLIXAHOTUKLPV2M6_Dhn-DN8MUoJUXI0AhqZbPJeg&oe=69C2A0D9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKYOKeyFUEIQ7kNvwGZDZm7&_nc_oc=AdpcYlZ_9j8wuvGBinKTgv49ZY2Ja6fTGF-F4mwpGBpg77cH3xTCSeyfD3LA4aEY1yg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJKC6Fjg5cNzLyI0mQbyJPesdAHVEtt5AJ82lCfM4OcQ&oe=69C29349"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E097eTLFZnwQ7kNvwE5cwrZ&_nc_oc=AdrJx4n8OVkjTVgiMv5EtpZTLpfIj6jBI0PLF0ju9BolEgxMIlS6Vm4Kmk1N5lxxU0A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg6dRdgipnMbZh50tLNAwguWiqyhudE4T9wpue6xrLBw&oe=69C291DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
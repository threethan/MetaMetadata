sHSQVzlGtgc19VhAK7C69m6i-8b6v5B5eSck4E7pbs_w&oe=699C4BA7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnJCi9Ag6_kQ7kNvwGB7M8Q&_nc_oc=Adnx2CHWPTTOoWAfBqXntaDjYz0wx2LmqwVR0qMlSUqtsFBjsK8FEBXLuWlDicIhWC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuHCBtUhLWvigYUA-0reDJIqXtmsj-X67HUWt5xzYw15w&oe=699C45A7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU9WrvMLJ_oQ7kNvwFloNvg&_nc_oc=AdmQwak_QLHvib7_i6SUHG7cF6w_0ev7sq7RSFF4b6HjnrnW5ODUU7bTaM337pt_YF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvXJJtdG_yMOgfRsyIXj_BVUlwZDjsZI_D_fJDLO9Pj8g&oe=699C6559"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9BFtyqUAHsQ7kNvwEqnvmW&_nc_oc=AdlKSxL5e9RU04HP7J_w1e-5FWjFmSp4tZYCm5ifhdnfE8wosc6i381Brk69UBRfVFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfurIsPVtm6iw91DZIKpeWGQuHReQpx6Q45yltL-LQwGew&oe=699C57C9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkMspwahshsQ7kNvwEv-cDu&_nc_oc=Adl60IFZ_iAlzHpR1OrbW8Susxnw6yBOdweS5agSWe9XM0ySVxTdRvtCbh3eP4r0wnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsKQaEAJf2bTKjmLKT6LmA2lzRn90gLQAV_uSgaXIJH6Q&oe=699C565E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
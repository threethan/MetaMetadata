yrvyWqZ5HDUwksvc6wvBwUM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ikd25IgBSN1yPUUY0pFmB2S9LMrri0A2Ou-vO6tDA3A&oe=6A12F2A7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbcfYq5NlC8Q7kNvwGgID5I&_nc_oc=AdqeF80izAFXcJeCclZBC9H8f0O53xGjFVw2bMzVnVChAaFn44avboRmh0Qsu_l93OM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7adPRlj40LI2c5Y6LK4h1KWt_Ok7kXL9GiLJvR7c1uIg&oe=6A12ECA7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJSDmSC3QFQQ7kNvwGtB0zx&_nc_oc=Adp8IX2bTxsS_J4iSvpVoEb5hYszgSByyDl9vYpNfq_GmLMywRxRP9GsW798ti6AVnU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UaaHjj0mF3yqQLAeJXTh-9ofxUSCoK-9oMG3BlvoEoQ&oe=6A130C59"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8iuDKiHiUYQ7kNvwFkawo8&_nc_oc=AdqK4RAW8gkNEXlz2qn5hEpJbu-XzTGnxdrPHmrJNS3bevpuT0Fo7K1TjNfz1bpdiH8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A0dIQ5_QNfSWMMdSTO6bYKSlMDHsYOt4Vyz3wzVn2Cw&oe=6A12FEC9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izucZ6UC0uMQ7kNvwErq2N8&_nc_oc=Adoo1kdMLy21x3eLxic3N67F2UAH9nHI5o7iC4FZ7eLT6Vt3GKBm0c_bqex7Oj1NX2M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CdIW2FJDhpZwTq_Jidb7xRFI0R5vS7m94KLbe-qCwcw&oe=6A12FD5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
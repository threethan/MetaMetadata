8iKgfWTTrBYHf6eSHil8HE8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R3iz5esvDY_LfFUsZaeX-C8vc6_S1NfShEgwbcnYZUg&oe=6A3571E7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnMfGAwAtMUQ7kNvwHWEmrt&_nc_oc=AdrN9vTNrL8LSWf-ut5tKvyYJyGd470O9b7Jwm27jtIZImHaj4QuQN1w1Fww3Ivopp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6s3FsxDacuOxufGDdFpjDh5tboC5m2-hHPqdOGMKPiw&oe=6A356BE7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtLqsoo-E5kQ7kNvwGNQTHJ&_nc_oc=AdpAm7kuud2xSihMbTMC_-QXptw-WerkjvzUgsMwrwu1oSZx0V5rbg41sdhtUPdjJMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t6aB0wxo8I2pvvP4FQS3WD89M0TfarXHBFTZlxP9-7w&oe=6A355359"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAZr8-xHT_IQ7kNvwGJ8Lzf&_nc_oc=AdpoMivqaMRJxa0t9BdpV97islhzS8Im1qC1D_1FXAhK8xYxjPZw2Ep2nKC1EB4SE8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YSAbrF4lbZOJEKvyGDK11-5ZDdM3LrvuEkLL5CnwtQA&oe=6A3545C9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxjA-K7MO-MQ7kNvwF1S_hY&_nc_oc=AdpfiJk4K_acxoBoGXtVrFjN63Ll1yuruKnzrHstpfZPpdYFs0WxAG1qS1mqsz86tqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uEFE0kjyc9MetEm1q7EeLoR6wf9WBAUGR_i8axFXBfA&oe=6A35445E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
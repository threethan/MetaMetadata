snic6TK-eW1WtKtrXLz4dtXcHebDkO6zeyt9qeiI3uDA&oe=69A2E327"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvFNW9We16oQ7kNvwHh8Y24&_nc_oc=AdkvnONjip4Xg44eel6kfAd1CxykBEoK5sm4cjMhflD3UB2_uiJdgVGl4rfzPEgXe1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwZSrcPSIzvRKsqxoIlYHCLi_IOe6msw08S2-OWfAJaA&oe=69A2DD27"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfsPwi22SAAQ7kNvwFDMyDp&_nc_oc=AdmZZZgxpGasmQrbWIQySSecBIItqexwBiz2kkFSEkPUVjy5nhpaOdvahXFlXEbx6y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMyyP23DmsvYz0SgKDyl9NjYBAQgEi4JJWNNzwvikeZQ&oe=69A2FCD9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFV48KgIBtkQ7kNvwH4ToJ_&_nc_oc=Adm1eDGCcWZ0a_dPSsTmLRMFXpgUsTiH8ekvENc4LiSt4lSguurE-or41kKS79gXr5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnUzjloWg7S3kEM5XAHLFzaLTXMEOOYwFxtGc_3zsOzg&oe=69A2EF49"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvJOxL5iXa4Q7kNvwGOCyND&_nc_oc=Adn0yeSdkX1WEuEtkb5w26nJC3_h9x8-tix3eWXNgBlt76RDgim6fOXZW2sY-haVo7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftujgQEmvPDqir-KegTkQeDBk8MSWPNKtiv2xVOaA-6bw&oe=69A2EDDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
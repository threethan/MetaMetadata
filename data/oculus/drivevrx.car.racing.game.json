0Swtx5dXcNBkBI2mE04g4nE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42VbeANreERjSuEltBYFhA8ljKC8wgTC84qhmLSlueMQ&oe=6A2021A7"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ip_beT1AeoQ7kNvwEYNwHL&_nc_oc=AdpeiD190SFf9p70W_PtEf-U1X4b45jOvA_tBZoX3TMFtvRGzmnB0DHwh0_6shidKfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54sTzFS3ISCfNU950iPl6VzkJwj5FFs513gd0_4sDxUg&oe=6A201BA7"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec7aRTjPMwIQ7kNvwEiscRi&_nc_oc=Adr-lrgYzjOhXM8pOsxuQGt8VkI3vEWb8YOrr3ErYXl3j5a6fK7N9yab4whLm1CPjis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k5p-YcKnoUuhKODP_dzVVTs9HjGYVB72OtU9rQXiK3g&oe=6A203B59"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvYF-txGTywQ7kNvwFPBgKN&_nc_oc=AdrtR8SPorp7DNeovVDAXIgEIF0XV3xBkvghZaXiZYR8vWWuJ3OFsD7Cp52evSSkaQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y51D3QZMRqQR5OFYlY91g9YgtbfiXrXUjJa2qPFA2Hg&oe=6A202DC9"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFDeRAo6tXQQ7kNvwEyjBMd&_nc_oc=Adr9Q630_nLsRoJZIs3TQ4gRaFSqzhNCJ2uzfbs-tltPZJHucZMi5pyDmvrybCE6juI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NuUMzTjUZP93T3VXisyFZeqyBCOrtpsZxNxNEvAUzpQ&oe=6A202C5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
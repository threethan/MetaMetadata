742Vrn55JAs0rBl8-7unb_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZLDs5Ih6y52XEWoAodze67K8xanTNdoX8zm7jXCEWtg&oe=6A314527"}, {"file_name": "screendhot # 3.png", "id": "2479461342448515", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_2479461349115181_4299400548823806541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH-PmpWqOdQQ7kNvwH9-gDQ&_nc_oc=AdoM5Bgd7gGPhOUA34P9Jz6GS6iT5LJ4JT9KGbeWxG2SDdKcW6YUZWl7eLoGo7KAoIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fsHLN_YrJ0sAZhxjmFuaGkaQdNzBkh8EN162BRntQww&oe=6A317767"}, {"file_name": "screendhot # 1.png", "id": "859428533490799", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827567_859428536824132_8130458654598084689_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb9ymSeXBhgQ7kNvwHv8lpU&_nc_oc=Ado7CZvyoLQ13PndkfFpyLUdA_uPMt8D5cJGkkqiUpuCHJogBVOwSOvakIUXIN8FqUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ILrN3R6BlNLV3IIvp_PFXg4L34lmkGiVs-8WX99j2pQ&oe=6A315ED9"}, {"file_name": "screendhot # 2.png", "id": "864101885977343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_864101892644009_1967053959342632746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwtzH7knHfEQ7kNvwGudwCP&_nc_oc=AdokxTBeq1oH_qAbn6-CDshU9WHdNtCf3xIJd77rCbHGBwWWo950nJJht01xDC1F0UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5nF9zvTMem5uz0c7EY6fYsttnY7pNQ2Ab2DrOjkfCNg&oe=6A315149"}, {"file_name": "screendhot # 5.png", "id": "25351970667828225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_25351970681161557_1896619380290546101_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCe-_n4mTxsQ7kNvwG_ANvC&_nc_oc=AdoKlTAQABnmHb01aJ1bs6543MYcCS1pwK14o9y9tlrevIpk2G4MZChbMVqplafIDHQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2Mjj6_QQGyBS9dvwhiucqY1Jj0cHPEk5ufXa-ChmkcA&oe=6A314FDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Race - Racing & Driving Game", "keywords": ["car", "racing", "driving", "game", "drifting"], "long_description": "Car Race  is a Thrilling virtual reality racing game that will take you on a high-speed journey through some of the world's most challenging and breathtaking race tracks. With its stunning graphics and immersive gameplay, this game will transport you to a world of high-performance vehicles and heart-pounding competition.\nFrom the moment you put on your VR headset, you'll be fully immersed in the world of Car Race And with its realistic physics engine, Car Race delivers a true-to-life racing experience that will leave you breathless.\nBut Car Race isn't just about racing. It's also about customization and strategy. You'll also need to strategize and plan your race, making split-second decisions about when to brake, when to accelerate, and how to navigate through hairpin turns and treacherous obstacles.\n", "short_description": "Car Race  puts you in the driver's seat of high-performance vehicles, allowing you to experience high-speed racing in an interactive and fully realized manner. With stunning graphics and realistic physics, navigate challenging tracks and compete against other racers to experience what it's like to be in the driver's seat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": null, "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
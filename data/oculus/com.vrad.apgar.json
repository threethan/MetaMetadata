t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBoog-8BlScKnBp3gtM6QMHjRahpSVADfIWTwsy_ufCQ&oe=6ADCCA1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEq69-Osko8Q7kNvwHMYP67&_nc_oc=AdqnxVGLysX2bzevbEJCMGoJAXJSbzl-a7UEs2rud9OAUzV5dVm9AkUhO3Euhw6t3bI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwy5Y9zvQ3mK5yU1VsXYk36B7TclWZ14HVFEPq5Ci9ig&oe=6ADCC875"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkCEfW5fBHMQ7kNvwEPQp2C&_nc_oc=AdqNg-wOO6hiUaAwQXZeIncrMSJWwPG7__WkItRTIi-5-uW11sGuhXo4qD5lhh5diFQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzkUqhPpMEHcHfdWL_TVid_JkvHCTVsHwNelxWcuKSxg&oe=6ADCCB36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhfRQB8NUxgQ7kNvwFswpv1&_nc_oc=AdoTtCN77J4ULIV1aR_HOOtLjFUCEqewvAAbhwdsRf9RkM_ulk6dMrgPBBDYuIl5ZBk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEbne2qSNlsIAOeOTyreq4P1bnBcdGi3LKWIBVeNYUIQ&oe=6ADCB3CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IX2GmrhpTF4Q7kNvwFAoheN&_nc_oc=AdpUPUhy-ZkywIX3QqKRfYcEe1xueFJH80ru4W2m4HC7q4WgvH1I5eWtWNTnW-5vusQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz9c2T4S5d7y3iM1U7-9fwMp8k6osWn68LmUKYp5yQLA&oe=6ADCC08A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTTF_hve9dkQ7kNvwFmTwfY&_nc_oc=AdozdXCsoigUSCXkYPOg0Grp20gyMhwmJIPpHlgCmTHDhv1xhZsTSiHjAMPfl3062co&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzUbW4aXycANhPN37zptwXfHYLg0hDDaEg1MopetuTFw&oe=6ADCBA0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZxr-Za4kFoQ7kNvwFfBhXo&_nc_oc=Adpsa3LmhC4cr4KOuxdk0TtEdc7eY2YdQcg4k3VNJueRZu_B_quSGaKUmc3X7js9Ps4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5BDHId7cF8lHxxgtOg_cxprlMsCOemQ010tJ0tu0U4A&oe=6ADCB19E"}, {"file_name
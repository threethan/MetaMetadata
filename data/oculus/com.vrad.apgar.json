t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwMbjm9KZIxzxQ2W-7o1eUirrVfNmYv0tOo-1Zbanmxg&oe=6A4D169E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nvaw7FfXlXMQ7kNvwGain67&_nc_oc=AdrseER5mG6xCZ907dWea6D39CbPphcadMx9BD6SCsWzne6y6u0O3Xyxyot_1_pfX_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa2Wl-f35uVPViYhJWYiKFpb_ZRp5MCdSS_vrvL919Vw&oe=6A4D14F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdGmEbfm2OgQ7kNvwHM6EW8&_nc_oc=AdrKQB22YjQCD8uOGcmLX3x1PgWOmg6o7bO81xJHwnTqD_kPHlSSZhWejHsh2UpQzGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY2hD9PZWJsi9M3VV1rsz02g9uDs2TwyURosubWAl3ng&oe=6A4D17B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZbAEbYPiusQ7kNvwEnd6fo&_nc_oc=Ado7x51k9W0V_KNa2bUYzK29bhj1rzm6z0QdM_GMdL3EnJeTupscn_kqC71lehHEFdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDrFSnanO5qVq9lF1o9_ezWYyqYv9AjshsLXAnntpvug&oe=6A4D004F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAAEOeiAr3gQ7kNvwFVru88&_nc_oc=AdrVzQw583PmjBeUDNglK80D4pz4wbsLYHjB3T_bVDN4i1gOuYhACs5LghB4bTbn0AE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1vgNqwhYBnB9lhAtkr6ghFgb664LeSEjnOXlWi_EwaQ&oe=6A4D0D0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoKQK9ky0KMQ7kNvwE3ROwe&_nc_oc=Adoh3194Kwa0N8lBqqZQTrZ71hH0zFDfhmD6RNnBIHAI-jKxokEE8lMqnYAb_au3zsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsBf3jAcJJwjFoYJiVScKYo6mNWMwOWOHD-aTDjDcTJA&oe=6A4D068B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHWUofMerA8Q7kNvwEGtRXi&_nc_oc=AdoS0YgCmRfFm-Q75n475fdnR5wlC4tlw5e8AoW1H4dogJrU1HmpVngP-8ti0al31Yw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChZOR8QOS-azcDMWcnEFddgw3mptrPVpPV-XwOVQWLLg&oe=6A4CFE1E"}, {"file_name
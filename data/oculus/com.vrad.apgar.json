t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CNyXSza6gcuVCJW-vA8_QZDHh5lFsiyuQGBzGmYCTaA&oe=6A08889E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EcOiq_vwCIQ7kNvwE546sw&_nc_oc=AdrqXt8YBfcYAdrXdNyc9ZwQnJ68oGP96Uew0eNbtEK_NgMtpzq26NRfzqq1dKcu5YA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c3RYzW1PMVDcUOLHY3Cn6fGzU-S47oXy9pORxTTfYLQ&oe=6A0886F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbsLubc3TnEQ7kNvwHlxQBM&_nc_oc=Adqf8YUVE55oYwCxE5MGvi_rk2gbIuTZx9v5fD-3OF7L9Sx7-ZZ3tuf2giyBXoVjsNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76nVY_NO8Rx1EeYx1bsG4Rj6nJ72ZOKftpnI5YUhL9Hg&oe=6A0889B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgwCW8yDSFUQ7kNvwFVT1yX&_nc_oc=AdqggIvjaQKKCVu61WRujNWuSX6vVJariHULwv8yFTIEor6E_2bgxdQsSgun2yF8bBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zHiflkydbacS29jbRYjWdyrdDesLyDpM3_L794wU0mQ&oe=6A08724F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUIzl7ZMLt0Q7kNvwGLoWJY&_nc_oc=AdoTSZK1K9lYvDlbGTDLG6WiTOZARCA95YMgca7AiHaZhPUapMjXHoCtkyt1NzC9TQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iZIhGaQYbcRadnWKaVfyRoy0a8t64-Z3LtRtCTmaYPw&oe=6A087F0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMIBrAvlcL8Q7kNvwF-w8E1&_nc_oc=AdpeTCN8WhEJf3RdUvlKpWnYp7BdzLpiyyeizQkP67T8hxCVQ2Tr7HKb6ewqc7dKsTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ryEZm8cxu-tgjzWTfG2Yf7HXvZHV86A-tcKm5y3d_eQ&oe=6A08788B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu_z-kFDBesQ7kNvwESBpT9&_nc_oc=AdpyLNV7o_8wfNrqfFsEj-f9KmA_W5HHhV8-8b_45b00SEJKTVY2jRXCKE7lvP_aito&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K8ECWOygi_gzkCoahJ0Av8E1ACt7_wP-ukDDkLuM_xQ&oe=6A08701E"}, {"file_name
t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP9BqP8UAKP83ZeTprHmYAft86JLWI91IEFJHFaAcKYg&oe=6AE3619E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypd9zA5fvZkQ7kNvwGBz83b&_nc_oc=Adqa14T8JpqIvNnnS3rRtBlw5HTr7y9MmRBVyPZ6H6Jp_lCcr3Lje8kevJ9QPVQXzy4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO70goM3C6n332KESV5OLJrNVbfbEkNrPUU-Y1r0Cm1tA&oe=6AE35FF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFC98CKypbwQ7kNvwF4jEjk&_nc_oc=AdrCQ_wHUVrBhxkyaQ95VPSFR7dWJkWsLVdgzul8nQXVpAJq1W3prSeQrZJl2jakWe8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8bIKtXne6s2md4pA_WCYyO3EB9RlKSFzgxHVAZQ6_4w&oe=6AE362B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxH-ZvJhwPUQ7kNvwF1s3b2&_nc_oc=AdqFXjHE8Bxcj8XyRl5eKnLfBkQ3t3CnbJkkrkqQDEApwZj1ZB3UE-wmLDxRq-7GBao&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjrqkaCVocTWsfSaa5Xgk3rmxiVZXUHWFK-Wb01QDESA&oe=6AE34B4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBFciJgqApIQ7kNvwHW4Gsf&_nc_oc=AdqDjfQQLSEPkixJUk741153_8swO_QUoPK8PwRPi_-PfV1fhI3q-ab7oo_DIER-qxM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHm9pnDLn6lPZwx2R0bofl4XU3AlKE1kPLmub0DFQU1w&oe=6AE3580A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sK9nDbpKFUQ7kNvwFsLSmP&_nc_oc=AdpXMGfGRrAgZ1d-se9gitFAVHDw2Ovi_Vw72wTTldiusRi7nsmzH98kYA2ww-bGpxU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz_x1R7vtQ_qzn2EIjHhsVYf83__Mnza2Ncj995zlKvw&oe=6AE3518B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LVvlij28FgQ7kNvwGczRI4&_nc_oc=AdqMFYO-xLy-PSOw268PXWu42m4qn8861AVgozfhgiGo5dCFVsexbrphyMNDDqyh1Yo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG5prDzeSAl4uTpIj3GYCvzT_La5bxHwLZp5PsBV7_3Q&oe=6AE3491E"}, {"file_name
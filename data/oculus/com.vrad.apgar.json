t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-cn6XAAOGsrZRzaGpMrASnDHfJEU_GpQX8re6ryv39w&oe=6A66231E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-E_N4TGgD4Q7kNvwFZT7Rr&_nc_oc=Ado8RaNTdHXto1LBSfK4R-S89pbMxzKhAXahonSVkZTY-Oe-o29c4XPcPpzXzjzTibU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-Bzn_zlOwGmn3T_fuBR2xCZYygaX1D3p5k4aXOdtOSw&oe=6A662175"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSKwAfB9VfcQ7kNvwEItaPN&_nc_oc=AdpeRqwXkfAcG1SCNCdBko0jkq79ipX1raGTFXkOKRV301Ct36egDj4qqm7z5sPsGk4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI8hZK-XYlOGuvadfNuHDDxcuaGMXGfaTJxfFlb5FSZg&oe=6A662436"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnE3gP58ipgQ7kNvwFNVHKw&_nc_oc=Ado-Wf9YnJRxvKXUN1s934r2-dElhM3r0FOEIQ_nv5REITjr2xhfLx8vszRcF7_o7wY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqSQo-6W6juzW7AhSrblrG0VyYXKSJOX0Vv1qrQuNXPA&oe=6A660CCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt7MnMkj48UQ7kNvwF__O5J&_nc_oc=AdrL1uBVd3fwxaDiELbmuTR69WtXFgS_ccfO-gZyfM1g569cDyiPiirFNhnxTScRejg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLbCa7Gl3-CRaLasIKGVydrcAoTxOKQGAvHpcrWhMQ7Q&oe=6A66198A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD7BhNTvEhYQ7kNvwEa0_KZ&_nc_oc=AdqLoejyPU9e55X_yIYFLBWwZg-FumCH-ODYYEbBeP3B6zMhcNr1x-hushmMNa95YnI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ92W7tfMZJiOu6zjZ2hlOVa6XWEz875cZAXMkH_pMwg&oe=6A66130B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwjL_Na3KZYQ7kNvwGi7rMt&_nc_oc=AdpAsGab1vqQi5J5GlCtaO_ZqALZrLoLdAQRXjZSpc-XU6Aeo2GUD3NPDLKIYx1jCCU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbozhafqQGPQqgACt2JKNqGizZhv5NA_CFUaZJMbWXIA&oe=6A660A9E"}, {"file_name
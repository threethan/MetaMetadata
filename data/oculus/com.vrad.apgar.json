t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-EmN_7F9MN7A_pCGQ9ehPUFUOax5S6vNQyH-uiSSM4A&oe=6A576A5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23448pOe7YUQ7kNvwHWicE0&_nc_oc=Adr5ZNrZDotajl983rBZF60FtrloMLo309xuau1LEE9v-FSuTHIbwLwDW9NWE8sL17Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxiUMvYqlGjxmIRoc1AwGSxJRdXLSbdbZwEgq09QGKcw&oe=6A5768B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFHq7LDN0YIQ7kNvwGI-SX9&_nc_oc=AdqIFpP2IZqspBWO8_yYFJ70LwE_rZvhskNSTNTZk03w7PIPT8OohYEdHT3Hq-_j4Vk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABZwOYp2Ln7u8efvaTyJb74lYZDycwjbkMNro41TqYgA&oe=6A576B76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT34wtxxsn0Q7kNvwGTMNV4&_nc_oc=AdrIzQQkN7ppIgv1TA5SwcYvPHQWQLfqvPY-F9ZHodcqZP9AfdE0r-bBoM_CcICKncs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmEavXXwQsbKiU9p4AqsfrnTprf8QLOvpd9ekRZAGJXw&oe=6A578C4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMItPqj1qGQQ7kNvwER2fqf&_nc_oc=Adr1fRqk1yoVkeVghnRzdFfphh4CPKukirvcszfvq8PiM58GBFu5W6ye_KFbJE9ejQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVLPEqygFtgy4POqgv7heqtiISNfN42OROWFTSp5Ntkw&oe=6A57990A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcN15qGHqV4Q7kNvwGRHhjy&_nc_oc=AdovbN8KZLiQYceX5bx6mbTj9KoIEYKUJR0J8EtLYKhXmRUC3yXroJZr4MH-AqJwtbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD47iis3uwGuS_BwN7sb3WtLW3rl1I_In9qYvewBdjVQQ&oe=6A57928B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrvOYnGlDBcQ7kNvwE7ODBn&_nc_oc=AdqIPMCrWvDuz6Uhzy5F7k-uiTM1i20W5Fia_FakOb8nACnRtoB_x9-BrvBb_R_MExw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt_Gbd1goAoOzwJaDyv8PaCNBg27oD-Nr1B6c9DvyBzg&oe=6A578A1E"}, {"file_name
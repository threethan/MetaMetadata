t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1naQ1FdA-dSTDtps9Ifs47J_-SO-sMdDXalAtYWKBsQ&oe=6A56511E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23448pOe7YUQ7kNvwFL9f1H&_nc_oc=AdrN1kmLfcosK-FVTKAMmldFPufkBzuAy1RjIjNgJI5SUxdBOD0rHpG0udr69obVkYQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdg_FnBVByt6D4SEiswQIzFdboUHYBa4E2JhQoxd6KJA&oe=6A564F75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFHq7LDN0YIQ7kNvwEo6Xwh&_nc_oc=AdpzRFq4l-w3T0cxBLZU0LV1Up3JfmsZ1PL-2iWxCOolL-s7XAbwQ1LluICF2GjP_8E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAefKTP98Iq4eTQrxg3VYL6a6yA3H_hZX5LzeKtJlfGRQ&oe=6A565236"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT34wtxxsn0Q7kNvwEQewLw&_nc_oc=Adrpy4mDkiihzoBNQw-zaRzcv4fJPk7sPC4uGoQYg4M_Mq1IyG5Pxkh2CXJ_uIpv8kg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_4q-ZWZAYZSinfrDNJJeXI-kB_shCQYgkhUBn8Fvs8w&oe=6A563ACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMItPqj1qGQQ7kNvwGQ0Afj&_nc_oc=AdpzXwEnXJgrAnK42rZaCVjzs90DlAEVBt-oGnGvgyXXpJnRIdXQgCWzAmQS9OVoJWs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr0Fm1TnSw8j37kzs1bVV_vthCwlRCiCqrj_s79UJc-A&oe=6A56478A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCMi6X3-SBYQ7kNvwH38DoR&_nc_oc=AdoO68eQD4XEF7mYcLOMN_wMwq3jkRD74rugEFnmwdW85HourVjLC8W-7NVvjsbiyr8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_KmNF0cKNsAioRHDW8t9ACT7Ty4yh5047qIoBe4WCvQ&oe=6A56410B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1X3yiASl8cQ7kNvwHf3RgH&_nc_oc=AdqZld-NSorY1Xj9SrRY_hZNtQHXf36n6PPQEk_1RcRR_9YqtIhL5dx8edIdSAOjuKU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2IE4WFaiVBQvBG7JVx_RIG3mxg7BLVFD9BKZbUSkaTA&oe=6A56389E"}, {"file_name
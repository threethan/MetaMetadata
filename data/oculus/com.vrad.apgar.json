t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0VB_oE4yEjzPDQkVuHgJOXxh3MqONKwWAnCzYKIUYAw&oe=6A95D15E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZPArxL-n4EQ7kNvwHfzO8M&_nc_oc=AdpPGaLS42XZjvDsg4SIdA7V6zZQROMxSjAB6wyfUoTHxLdeckaWXDFQmAGFHnd-d8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdqOqw3zpLNW7Lgrrlyqzmy_clywRr6oIzB8_6eYhNBQ&oe=6A95CFB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES40Qam7kjMQ7kNvwFJF3Kx&_nc_oc=AdohReTCCVbWKDAjlk7Yzd87qIDPWonQpxm1fSr0IGIy6aO5ohr_CvvIteWAksUfi_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuRPOfDrRJe7W7WFQLp93Guc7CaAXQrlpxbTyM8INhOg&oe=6A95D276"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSzsHiGKk2oQ7kNvwEs_qSq&_nc_oc=AdqbRIrT4skgCSPZIQj8UpnEAj9Q0cIYxTy-VXPTSLutV7rHR0-sPqMPjMU8azVdULY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs6pBBngZSEiK6T39Ve7OKQ6DUAhgN-s-JPGeIRxBWjg&oe=6A95BB0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIRzwN_3uPsQ7kNvwG2_A9c&_nc_oc=Adqz28h6X3qxhVbjw_hTdRwyKymdiLS6P8Ki1XMk219nLt_2v0qQCZiEbAWi85tEgqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHly8MzWBABx_BoftU95Ei0RGZTZe56AvAyzcpT035Q8A&oe=6A95C7CA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmGert_yGXQQ7kNvwEDuEeV&_nc_oc=AdrenSuMGSb45jrJCXjv2M8RBd9bvUo4w3eQx0prkn_B9Le1FirsbMPWoynO4G_-nRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ07OkVPJ18TK9s40iUTRve1lc7jBHbefNPBuX3XCwdw&oe=6A95C14B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU9UDRj48x8Q7kNvwHAkk9q&_nc_oc=Adrf2ofYV0bA07fkP3OA1DHnn31q0fMGEAGop3ba3PUD8n227t2nZCtkpzkvYGBWBsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGQ4B787V1Kc6bYfLDG8gq8uaZ6jvrLr4c73wvkEJ6oA&oe=6A95B8DE"}, {"file_name
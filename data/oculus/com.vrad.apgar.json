t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLVkxYa7lsK8JLBhA70MK_R_v3fdLWcHMLTkJM_Vfmgw&oe=6A7EF75E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1FpI6EudgMQ7kNvwHWQ2nW&_nc_oc=AdrDLejIFRoEnx1MvY4q3lpHXIOl57AUUX-UrkEx45D1AcYlOyO_VytyUJ1z3dcDdfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0SbF_xi_9NbZiUjx6uv_jqW7xfUIDc7WZXVvCer4yzA&oe=6A7EF5B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ckHunU-Dh8Q7kNvwECdi8b&_nc_oc=Adr4k7HlSYLp_9o3_WdtEkxMlZxlOSBAaC7JE5mYKYvc7QpEULDo6dnnwQ1Yx9cCmkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYgbofSu6S0b8xnFsZrNQ3d7MOph1_OaDtMlUN9-kGFg&oe=6A7EF876"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGuZx_cO8tgQ7kNvwFgVuYK&_nc_oc=AdqFZZV9iLqWHs7AhtVnGmjnhSuhw0hPLj6Kzb4chHvX6tRe9ulHBj1TA1nerfJqZ8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEErV_9kLz5sb0pVacVISla4fQejTM0leKGAMgCGj6o8w&oe=6A7F194F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdtak6V1px8Q7kNvwF-uGLb&_nc_oc=AdpKKYz3Ru_xMUoq2T3EACKW50Plq-HAa2gSH_H6mXwwKgB11zMWksq6hqwa9ImzNPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmUBAVqwSDxIZ9cchnmDfcako145fyZZ6rYcdfOwiQ4g&oe=6A7EEDCA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqcB2aEI-EcQ7kNvwHoret8&_nc_oc=AdqRvVYz6OXMYifGXT-uMGZfqxvVj9npt39Br09S24AwXidNMGXMN91GDe5oqQZQM5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5WMYsmXIlorH1kiBn8-NoywvyxGMDGQ3lsTnAm_jPiA&oe=6A7F1F8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzg-YGPykosQ7kNvwGnOAh6&_nc_oc=AdrWeZNOW8eslhdwIrHquKejdkPMxDNcAHpZR2ckp7azcckavvBFXw_u1CMzgwad7fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYCCFYQ97w1kl4Azr1WN-rnZYrqm2QIFX1f68uRqVVJQ&oe=6A7F171E"}, {"file_name
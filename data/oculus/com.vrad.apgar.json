t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6mYIhSCR_wjx1rh0KY9np8n8itWG0p1b7ZzMWEA9DPw&oe=6ACE499E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSK2Le9wpOAQ7kNvwFexSz5&_nc_oc=AdqytE5J-c_9POr8izprW5XFc1sTx5gCaTuv7Irkh8M4uf2sY6zr0p1jnQc-ZCfkstM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIbuixjeid4pV_hSoRDUMvt5yOw9p1EXSEUnvj0snaqg&oe=6ACE47F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GINF8hhd2K4Q7kNvwFvviPK&_nc_oc=AdrDYwQ0-I38c3mNaQi0xm0whcIXnbxZLLd-_GZ0Q9-F-Lxw7beRImg1FMzO1iZVCzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSFOhFU_cE_c2eVNuH5ZJJVtmF-xzGrvLF2bLq4KaHdQ&oe=6ACE4AB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHzAGBkAQG8Q7kNvwELhvzV&_nc_oc=AdoM08dTZ4kpN1mdIKczhc0pltgxdGolebZHkzTU0K0cxntQQ4FlLxIVqQ7lc0NQu-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxEDAJaFa8VqdKdqNyNwmfX5Flzty7QD5Jh6zu8V5S8Q&oe=6ACE334F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP3JcTJNb5oQ7kNvwEdgNse&_nc_oc=Adps_UPewd5XJCZ5gl7uhAHSWuppqSy1oKxNV96YKEJP1DUeXj_r-cx13akEJI2F4yA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkUY-oK_IAXpuyXAm5da3Oy6OWYmwl-h3a0O_kRTRSHw&oe=6ACE400A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRnwKqPvk44Q7kNvwFM8UqS&_nc_oc=AdrabWLLukWaspxTtEnsx7sq_953tLQcWSfhhalk8_u9L5gJdqf96euLeLtxv9FzQWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOICOqOFeNggAzimRQ_qf5kdoqQuG0uFJaGX_YP9u8Vbg&oe=6ACE398B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRLrdnuwEIQQ7kNvwHyl6gY&_nc_oc=Adp3NfpHBI2lz1c5SgI-lnKAx3sbAumYXr7r5Ps7eA4_1JCSkmRMvK6cDs8tVX4d_k0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND5sf1C-afIWNjfAfCR8-5jV1OZHa-Olw2gzZTVdoQBw&oe=6ACE695E"}, {"file_name
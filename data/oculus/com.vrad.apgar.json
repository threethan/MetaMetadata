0_Afwly9lgyUzTKO7HlgMvd4fWbsgJOahd3VmYQLuphqYYdw&oe=69AEAA5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOefV5_lXFoQ7kNvwFLyeCK&_nc_oc=AdmvxhrkfPQJLrv4pomRubDvIrGik-a4KgSEj4VGozW1TmfYM8ZmRR0UIx9oDbq1Y4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwg_HAW1-FxMUQuEIOZffPMuoAgHDadGizi4w1HFQPK_w&oe=69AEA8B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcBdb3Y5RC4Q7kNvwEDA6X-&_nc_oc=AdkcPhT573eGYASgjmIWCnmV_PcCUQhRbcsgpsuZ8yXqlf5hhYl6IsvPwM8lYi_eM_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLtWza-Ud4uhWX5XvG_NkOuPXi72ObVTGR5kaoJ-hpxg&oe=69AEAB76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNCj0LLB4iMQ7kNvwH8NIkz&_nc_oc=AdmBrDQWJYjFfQoVbUne3Ni0sjxIQEdWnxLOPvTL_wbhKufgVwzI6QFFuCpXtDqw9sE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDLr6SUQPUhzcf3iXygXXplXnkY9cOpqZN6_YXsKJnQQ&oe=69AECC4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQjy8SPa0VsQ7kNvwGlawAc&_nc_oc=AdlgX1XGxVykQHCFoKZS0wzxRfaKvQiViWQdwEqiV2GpUV53xQ8uw0x6wfmI0m7FO20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlT-_utiDE2Kqm8wmlIQWxc2hokTuJfEG2SlE4V9UL8Q&oe=69AED90A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx5TtQTSzlcQ7kNvwFzwSEX&_nc_oc=Adm1eRfIKx6GMHqSpDtxhyagSO6yBf9CsHplLe77Fjd2PMAmLkLJI_MdKARr3Trr634&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQIirdTVVk4BgmkntEOh7jRzLhUcMLSPtufIQX8bO5gg&oe=69AED28B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsawHINwE7wQ7kNvwFr5-Tu&_nc_oc=Adn7iR7hDa6uh1qsm8TfsS0KbuJgJhZAHV8i1vZWmM7BhqfsFGKTq9wsdsYWc6UNtzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe-T3WDNJit9UL6_iLrbFRxJf-B37crtJeJ5PYp7MT3g&oe=69AECA1E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
s=8&oh=00_AfxWHs3_pN9ziVGX90Zl6bH_0D1vWBXHcrjpYsqs80tTpw&oe=69AAB5DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57me0dukMEYQ7kNvwH6lCcf&_nc_oc=Adke3Cbn5vsfSucmmfh_2X-U778JK7k5pXTgNOA6ytvs-mA-uw8y2eq-FCftTATMYTY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afx15kS3n7xXSh0iFhFmT73WOMUyWerPNaoYkGZmff7kVQ&oe=69AAB435"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF95Fez1BTUQ7kNvwFAqBBq&_nc_oc=AdnH59KEXloKpKTo2jtgTPInee-uiH3uT7nUhNPoyJ-zpboal4T6BurVGhpflz6vQYE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHt3QgsBnWxUbNkRq2PzN-U_21QCTRtdHn3WaYDf9cFg&oe=69AAB6F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11hvcqEQNagQ7kNvwECObKR&_nc_oc=Adlo8Na1hsi7jpzl7bQJ1Gy5NDMliP1nxNyIYFG2fXzM1NasAnm1W2aGDz_7DNmPolg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQrL7bFnToeKHqGAzlvgVt-HyDl3W3x_vLQMftj5Jstw&oe=69AAD7CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptR3XNa1zM0Q7kNvwEWNEQo&_nc_oc=AdnoQkMpBI7lEzfXQ-SzjNIYCoz0cgHHxQgTbfUwOhTQgZ7A1-b3eJm-rw4YJmWx08M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4EyWSF16u1WeGT_TW6oNiVdGIy91tWncgiiPurMZ-Jw&oe=69AAE48A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7Dq0YGMGeUQ7kNvwFvEzMd&_nc_oc=AdmLD0Yt2bDm5yKH9Oi-8KllRA1A99EuI9zo2xnp1Djfbr5TcVhSOdB6p22yh0vA96o&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKI53MDbYOHccZ1wh2Noj8c_7aEKuKeyOJRIa4VYy4-g&oe=69AADE0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnRMkKYL6p4Q7kNvwHF70wB&_nc_oc=Adl1wIZO7DStL---7tDUJjLaBJHSZ24z7YpX81wNTxJI1EKE_xfMdExW7EaYNI4q42I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxisPxcGDfhDOzepvVNkSxyYkseeJQgkB1KQTw75BLk2w&oe=69AAD59E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "i
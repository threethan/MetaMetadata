t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGlt724X55K7ns7kuptOTN5-TQQQA3mlGXcLpUoJO8DA&oe=6AEF3F1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cByqRMU7jMQ7kNvwGlI8KG&_nc_oc=Adrsy13r4xGBzykKexx57_bgBmefOJQz6c6r8yD9Tv5eKUdDIcNR0_exEyMVfkUg0k4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNihClrDNfK1xaFQIybBN-UJ9Mg8KZ31FTGU6wwnzFig&oe=6AEF3D75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1f8o7YHEdMQ7kNvwFJngV9&_nc_oc=Adr9daRXI1j8EaJKtgn9ktKqudWmAypAEwESxgqC5lySPo8_DJShJHXbFfTGjLFDU-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNFcBibw8hXP6_Mc9HzgOh309b7rZdMFKgEZIsANHCag&oe=6AEF4036"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftj0R7LQLbgQ7kNvwFMStZ0&_nc_oc=Adq1QZse5C23nsGi7UbNPtL_Uu3gF8GYXyDZvb2nX-wQx7exlVzib0dTNbUIoJdV8mw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmYrYTnRFz5huEvo6IKZSFiO2dFKs4pDnuIOfcU9dvpQ&oe=6AEF610F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed3YtG_GxMsQ7kNvwEkYDON&_nc_oc=AdptDWI-2dDYY-fbrR777-ILFv9mbdiFpJaKog94Kp65MU0J4O1PxrUBt3P5S6BVSbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW2SznDSzdetdVpsoLrdzZPgeS-tONVFnUQdVUDk5wcg&oe=6AEF358A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNePrmvaRcYQ7kNvwEXCxBF&_nc_oc=Adoj9hW0mok8cZ1LxH428n1yg6Dq6kt5LPoY19KQRTPe0RdFPFbod02x6u8Omw5AUH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlp9R8KvEVpB4jiXzPJkljdbns293f2dRDVkEcaSy7-Q&oe=6AEF674B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIaJ8CFAg68Q7kNvwFMy3_d&_nc_oc=AdqC6ZWDWyjBNNmwejWLzWDUa2ZQ9Gu6ulLsl3Fqew7_Ct5x7XvoU4r1FQnKcvDEkNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlCKyMSOv7il7BIaXGjJ-0bVNjYkTXpi7ym9kN30fuyA&oe=6AEF5EDE"}, {"file_name
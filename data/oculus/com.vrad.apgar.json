t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjTK8BpLg4BKdODban3XwaWi11WTs39-fXJKsX6JjceQ&oe=6A9ED39E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM3Mld4IkCkQ7kNvwF9z8yG&_nc_oc=Adqzru01NIwK3FpeB2Vi5QfbpToUpABfAsvi6fNJ4FEeUdM0KEyIcUK8K37RC9UCyhY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJx99_mCYrkrzV-VDmwu9s4Nr9mNtzz7Sh2qYdca5r3Q&oe=6A9ED1F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2u6RYkxCNdsQ7kNvwFUn1Pq&_nc_oc=AdpLYR5X3ZMWFESK2WBlrMMDa0JsuVmgOXvaqeQ4fpeVNgtVwU9j4Vm1D6U76dwxA3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvnJQ2enyGM5COO6Nkyc96RDK2k3_syxgQmfzyyUJu1Q&oe=6A9ED4B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJA_uv3a4OcQ7kNvwGXUfnU&_nc_oc=AdrRbIxKmkKXLfrcMjwk07Au5IB3TS_T3fiUXRsnCZdWkxpoGVEURBMDL3HVUfSnbnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTlsoTzOoibVioNSEu5MOBWh3U6Ruz64SRqqe7dD8dMA&oe=6A9EBD4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaCjMezL1sUQ7kNvwFZMPRU&_nc_oc=AdpTegDvfg2Vvl6Ni2Ia-bYkFy8CMdmuxTEs_qUX_DC9NGlQz0JGq2ArilR_6khps7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGQPprKRODRDsa_YOQN2KeKo7fY6T8dQPE1kGkV5UScA&oe=6A9ECA0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4zv-IZgLBoQ7kNvwFlkcww&_nc_oc=Ado6svof7NhWoU4MFQDoWGdh_y3BqN09JBQ8inIEVd_Z-fDJ1G8y-offXjQZE1EGxeE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiMKv8zjo2OzMOzb3B-0ej1tVOmarZLQh_OIiQgCYNsg&oe=6A9EC38B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs4sLWycnJUQ7kNvwHNQu77&_nc_oc=AdpIy4V3O2vXNahJmSNJSfhHadBy9cMykaGfhdFlML_Ykc-2zJYn9mCa624zISJR3vo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlqNIwzvbVEcwwQnu0pJD8ynPxCEs7PO_daTcmskSGLA&oe=6A9EBB1E"}, {"file_name
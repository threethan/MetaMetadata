t-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl-VvbWP2Gk7PIlKewYnJalWYGf62p4Dv3NaH3JrT4ZA&oe=6A9722DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbCf3MO12ygQ7kNvwHGwcKk&_nc_oc=AdrExs_hsDTMyNiKeSVYJUzNa4XtBOGBQDcXTRXHtCDmubtDBxXn1OvI74XPeccyOsk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJgN5vNKHfJEPsjAHOCNn4pT8N5yheRxaqBj9pklw3UA&oe=6A972135"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES40Qam7kjMQ7kNvwHwlpJ1&_nc_oc=AdqW1CCg-rLQk6sqzcffcHrAL09VfncVwNXQt9J0O83AM3cC4UIcsSKSjweLNx17s-Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH82zlqqScidYUwaZmKQ1qvkEszBbU0z1V9iEyXyk-mjg&oe=6A9723F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSzsHiGKk2oQ7kNvwEtlZjQ&_nc_oc=Adrnauc47ZEa3Wc1zp4gb1sIjPsAVortmbaTDNMZwaaN2urxsFVh_8CqDhG9D4zjpAo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFt5No21OOgGfQBiV5eWh_5pPADIjmvO8tnAhTW8SgZA&oe=6A9744CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnNdZwc_M-EQ7kNvwEdmSfj&_nc_oc=Ado97XynAmAwJOdSoOxtzMB0nBimrppwgOJYYrvVTrPTeCyYmPjv5CYfniQaMAit2qo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKDBdGkCtFUIlXurlBZcnW3JDerimhd4gYNlVyoTXreg&oe=6A97518A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYUI-AcEXmkQ7kNvwHS60e8&_nc_oc=AdoEbcYYqek4pq-3XeatuK5ROgh-ifKp_mfRE0uxG44WwzZilvN-qYZ19XKcEyjIKRo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsCKFpJ7bQpcRe9Dc1pYKsmVnribGdDsjLPOm4UrTQmg&oe=6A974B0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU9UDRj48x8Q7kNvwHUXrso&_nc_oc=Adpse1zldZVJoh81EpkKVnau_3S7F--0Ek7rWfgGrq9aakHHMTMijS0kUaqsdDEwaoM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfPCkgKF0L4n-MlOXPCKhxBkRpF_Q6E2nH9SuT2PmeKg&oe=6A97429E"}, {"file_name
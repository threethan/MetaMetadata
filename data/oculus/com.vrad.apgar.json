t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16hBj2noo8yk01yWsl1US1wMoH4Mcwnj9qVTdQ7Iib1g&oe=69F6139E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYQAchARNNEQ7kNvwF-lsDE&_nc_oc=AdoN6IKEl3XZwXCHaWsEqbfR8Y4sCV1J4OCi8U1PZEzP9vGmW4cGs1qoQpPGvRIWIms&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2QEtc5G1fn-LsZO6zA7fWOhrdJOlV9ZY-iBKAO0VdUJA&oe=69F611F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtJWp5QSN_AQ7kNvwE_EZwL&_nc_oc=Adoy8bKvdiltoQN_qeEwX_u1UC_sovJekfbq2DDT4RlE2UK2C-VVfYOfOFVIhV_pxdk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uDjQdNm92dHrpW2E8JhiR7Zy4nlCqP4-5cFZr1mU9Vw&oe=69F614B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHphejYEHmQQ7kNvwGBm6B0&_nc_oc=AdoI0Yk07RA0Et5ll9t47CSgqjSQtiLcoFWR4HD3Po-rID5XGz9Q-kuBjQiiO4AKFqg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fD-0YWm5rcK-dkNS9jZzlnNLCw_A4e0411A_ODNO5aA&oe=69F5FD4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhP81BVUypEQ7kNvwGSUtqw&_nc_oc=AdpjtKxkaFry_zPBlsrSI41SRzMK7-2PPB9si6mbfzDbNNMOHwWnJd4QgkpRLSZAUVk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3e1hYcRThFJCQdf8Xg4E0M3UgZLFNehTBtbQvPndosmg&oe=69F60A0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEDgxnFOHyEQ7kNvwGM-kCG&_nc_oc=AdqOhxTaiVB19pThko4xwDrMY7j8_kwqgim0PBTatFur6637ROc_Qim3Qc1unRUnBBo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OBE-ClkzD8WmxmU__D7sb9ghqM4Wgp5sDkbZ8Ww4vDQ&oe=69F6038B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so1aDPIQKdcQ7kNvwF0dsaD&_nc_oc=AdqftFfR0WCEPN05E5jHbor3PRdTAKsRHFpccyDXy_GYMatYm14fYLJ3PE5ISmN0hpE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ABYdT3Fp0SdrTLBnsBlLmjtCKCqWwB5PcYVhyAns4dQ&oe=69F5FB1E"}, {"file_name
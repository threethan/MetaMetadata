t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yz3nStNVi_2kaL5x5Xa56oxG460mA6y7uVJ5cath_hA&oe=6A0DCE9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZPNbbPdc4AQ7kNvwEsxkLb&_nc_oc=AdqDrzDFLDHBHYyL4SVFJWY0pHJQShCPGYDDH6khWK5TDcLLO4BGbCYMQG4MTs4Vl4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7up2Gh7zSXCOYHtL1xXwIkkajSFwYuPNeUCpht4DCuDw&oe=6A0DCCF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpGfN-1vXp0Q7kNvwEOawo1&_nc_oc=AdqOqKhXdQWEFZCg2IayH1XtjILlIQ2NmX2BRfTS02B1x88i7kuH18GxZvNPO73O8_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48oaTWfLG1V3NdvkzmdbVuBXtEYXgeM-GCaVcR7E6dVw&oe=6A0DCFB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCLcXrcs6I4Q7kNvwF1oohI&_nc_oc=AdoWwfCctRQTNoK6J8A2OakglFHEleagMedZTqR4OxDJAInynBFBGZxodf4mDGy1wPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ANxM512PzTx4aYTb4wt6m-PhfjELPDdv8LNfCHnjpnA&oe=6A0DB84F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ur3Vrhvp86wQ7kNvwGFcboZ&_nc_oc=AdoBKYJJN-8NWudXI9o3PGLJluBNypTmTV7ndF8qzpl2zfQa2hWdMn5dfkfpQxKo7rQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Im6aqQ7_rF-fkiI0rfNGDAVG64uYRyGPG5jzgSD-8GA&oe=6A0DC50A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyWEodhoJ4gQ7kNvwGdgKn4&_nc_oc=AdpYEhQOyxIMZ1Y9QwamELatZrq0RkP6MvG3AkOonjlNjU9EGMuRDCdS9G2CGv3awOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57i9VFf_DWQdq0rigU9qAthJH6Vkq-mZkf7lae5eozEw&oe=6A0DBE8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8-WnKoK_ysQ7kNvwFWdfoD&_nc_oc=AdotR8S9gGVxcFgwx2iIV3uhcpeveMOnPuiRErraXpRgYjZpJrn9CpMd406kIwlEHqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4231R9YZ0F_Mx34rmKAVag8QE3zpomRJWgXVr--IhTeA&oe=6A0DB61E"}, {"file_name
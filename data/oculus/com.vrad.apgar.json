om/v/t64.5771-25/473396958_652591360577849_9079589504140055906_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA23W-orLXYQ7kNvwEejC2D&_nc_oc=Adof7Um1To8zQwBb023GOIy0TZFkT0dA20vWp-59S7D5TduNi0Y_PJ4wflGb5KaJALE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsP4vLwPFVJTcyhvdKZxVVYVYMUdFgKQ3posn9CZxAjg&oe=6B0DC9DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzzULUQwh44Q7kNvwGxTwBq&_nc_oc=AdqoQmODU_REbS5Jt9KsFcudEM_fuPUJVjemU8JQtJZyYRlDHQGHZKvsELEFdSQfgAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIMo4EC-nQeFld9RzEQ3ntEC3-v_iAR2pzu3X7Rry_XQ&oe=6B0DC835"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWVH1HTdZLcQ7kNvwFu4HXr&_nc_oc=AdqP4KWUbQNQ9AaYqxTEgQvGFfChZblfKZK2j1eiL92nNoSb93NJ6w38xio3vb72J90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyfuWFVjCgiOd9UzkiNI1HuVccf6AdZ15tCLFlTOEUOQ&oe=6B0DCAF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mbic7FLjc0Q7kNvwGySFBy&_nc_oc=Adr2OqEC51pe7FQT9yhD1GFskz2XqJGV_BMcuuN-ZkDyBxvdAzo2psIDYXTEbeSLrQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ30xuYPV_qnYdBwP4WvJBFnOw9mwgH3s6vn_9U48FFdQ&oe=6B0DB38F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StWt3m5ek0IQ7kNvwFeE8jB&_nc_oc=Adq4CI8vUpxat_feutgve0z9B5VFJEFoOWx81qbQCiQ5ZA1Dv9m3NaygXUaqYIzb5J8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFWpjzfaKi3I7Ie_x_36rM2T7LGcsg6cirZaJSNvyDPQ&oe=6B0DC04A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5ExeHVJVmAQ7kNvwFLWMA8&_nc_oc=AdrKnrY0zfrz9EyLRktK2fXiNXUaQNa2urHXFClMGrPm9rReYZHyZxNnUrr5bLr2nmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUE3j7fHGcMyFn3D2n3ylskTAjf23ThtiQ-J1mRNjH_w&oe=6B0DB9CB"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
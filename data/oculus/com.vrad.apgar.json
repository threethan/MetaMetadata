t-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NNHsAI2uyG_LR-DykTwmM9l5lfyRSsYWAe2vNdhT5kQ&oe=69E4B7DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlIcw0e-14wQ7kNvwHBNhIG&_nc_oc=Adq2DCAmfviFqxwIseWln6bGxk_8izcGz_zI4-iiOBcCCc9x3sKD8pOI2VeVb5tLnYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DwS6YnfKjXTrlPJIi2akqj3NAV6gtDioruSW8F0bkWg&oe=69E4EE75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVOjiXiH4SIQ7kNvwG5lFds&_nc_oc=Adp_6g8xH6rhgnNI7XGJN-WH69J0PfE59DeaY8rD-avGToSdkC-xDtPMxjXf88L7cQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0330bHa1l95zI2hT8mZDRqUwV_eUWPaRltsxGqUdfjgQ&oe=69E4B8F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc_6VEYkyVAQ7kNvwHgJiA6&_nc_oc=Adp3mZiniQiRtTfXaPPeTktzy14OjdUx0jdsUsOqs1a-oEc67ywAcs4rDeod4MTdEXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Mtt4SYjmeHNUm0DVl5Ki7roeNdW0iHtJSFgFwNt56eg&oe=69E4D9CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEH-1FffS6wQ7kNvwHghVCn&_nc_oc=AdoqUGkvJqCEUzBpKcRO90NDgEkvW87UzpR7sN3Khjlv-CElfPxLBJjJW0zO2H-OkyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IEkBlybW7QQgS-2FWWMsm8zARtz5UwYj31txyq9eOKQ&oe=69E4E68A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFSdvKbptxIQ7kNvwFZt7X8&_nc_oc=AdrQm9UOn_HZtV8c-aYRv9SrFLpCFjY3g_v_yVFT2zgs2wQv5xdRxyTHaxBajmdKSlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RMQM9QJRw5ti9gtqszolIxGgrHe73vci41Ivw3i3l-A&oe=69E4E00B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unY6gFLzvXsQ7kNvwEt1hzv&_nc_oc=AdplJfUN0v8GbE7g91cVbm_aVisi6a4dGSdqjaZRcK48KnZ9q48okneaXzVoSzo4XQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31aYOIGpLA19eJoM0UhmLzQlenzge8SCh7YsGF3_Ii5g&oe=69E4D79E"}, {"file_name
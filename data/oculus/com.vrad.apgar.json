808\ucc28\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "NS-APGAR\ub294 \uc2e0\uc0dd\uc544\uc758 APGAR \uc810\uc218 \uce21\uc815 \uc808\ucc28\ub97c \uac00\uc0c1\ud604\uc2e4 \ud658\uacbd\uc5d0\uc11c \uccb4\uacc4\uc801\uc73c\ub85c \ud559\uc2b5\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub41c VR \uc2dc\ubbac\ub808\uc774\ud130\uc785\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrad.one/bbs/board.php?bo_table=Resources&wr_id=12", "developer_terms_of_service_url": "https://vrad.one/bbs/board.php?bo_table=Resources&wr_id=11", "publisher_name": "VRAD", "support_website_url": null, "website_url": "https://vrad.one/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9247922781919968"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1136643441522266"}]}, "baseline_offer": {"id": "1136643441522266"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741148700, "status": "PUBLISHED", "id": "1136643441522266"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27450916327860669", "version": "1.0.3.0"}, "id": "1004056665118447", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBin
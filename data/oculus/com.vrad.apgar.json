reenshot_C.png", "id": "535893425582061", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6nLCUa7Ix4Q7kNvwHiQUQQ&_nc_oc=AdlpOmLXn6hcSCNFGGE1X2GpCGpcZv_g8BUMSBI4DUB2P3n045g31T6B6bj1e5FGFOU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftgXDvPpZl5_q1q6_hCqxChUU8G3IR1gRze73O7vqFyTQ&oe=69A179B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df8dkcN9HXcQ7kNvwHPpcRx&_nc_oc=AdnfOfCDAEkKcLLYIIuzydzf1tgpgnIRDtlZdKjcTk7onTYj6MioBcJeN7zckP8fWXc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftom3V6AYb_ZWZwE6IEoanoFLmgPWJPx9Q038inHPLgSA&oe=69A17C76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLF2R4lLMRMQ7kNvwElmfVI&_nc_oc=AdnQ_voiNa5tXUObfKWVJLQMtkdVNzGbrp4j0ilQ5sTcDZ9ltLw37AD-nUGVxd1uK3w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsEtexvA4f9K8AiyvGTIGLwLchdhwhkVMfuxfCINi3_tQ&oe=69A19D4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6L0AQVj_3YQ7kNvwE0H13r&_nc_oc=AdlyocqPGw_gXb1_t0rtqSqxOe5Te7E7j4PsTKxiOEkv8G9OsR-klIOyxx0qdzyOJjE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afto31W0ecy44hmpLRmXzEY2El4g0Rl5iRFrxNbLoMQGSw&oe=69A1AA0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mG4yABkVP1AQ7kNvwGYy7qX&_nc_oc=Adl81y433vCVMyhVW_EmtJ1J66xSjusxw8sJGLJ9w4zVYHdINDzj3zBvLTnn1lHah-w&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afu-znGyqttqDXvUwlyQpJOcLOosSn5r5XIA7ceXk7m1sg&oe=69A1A38B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ksvm3GEdthsQ7kNvwF4GyEm&_nc_oc=AdkPG9_kk7k1lUzKog-NfJFBE_UoHlnsnjPCnFakbP-70egwsSEa59tOdil-_Iytkdw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft7cTmQJtehpHkKGSkWii6otcc5ezZR1mo8ZI5A8OuUDg&oe=69A19B1E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393818_1313517856602921_6940534570603940676_n.png?_nc_
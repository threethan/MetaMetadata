reenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_01DluTgRLYQ7kNvwHOcm8p&_nc_oc=AdnW_2HGQNKKoHASjI1tvBWsXBsc6WCoStlUHp6ujQQERs9dJYLFy81h7L2okFVgKMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvz9v_ii-aqfV7BEYwvtvt7itaOyQqJDttlnESQ0GqYKg&oe=69A41CB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FGOFY75fnUQ7kNvwGTnzwz&_nc_oc=AdkhDYUcPLsZ4Z6JBRSUIcITunBE3hC0mDfhuiglkaPcWndQJ9G7hbNzLB6baSiN9o0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfthHId7AZn4LM4Zy4olHkH242a7hkQzYFuWexi5WLN40g&oe=69A41F76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqEceBqXbDgQ7kNvwF9aXjQ&_nc_oc=AdkfVBXQqYXXfo6-83qhaq54CQP_QwI_ureeg0XhENlbxjc6OReafRS8opOeLei-DnE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsHUDlp7KKHGom7oOHZuItqkEVF88oA7rJbDHUVE3dZbQ&oe=69A4404F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBAkdhPKZCwQ7kNvwHTfzdf&_nc_oc=Adk_W9f55O69HQwdI9s8Q-d1rDu49hp7PpL2FYqx9JtBVr343fIOaxayqK46k12xtLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu3x65VauGBUQxq1kOHCosaOJNVUrM2lBmNBEbEov2KXw&oe=69A44D0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mG4yABkVP1AQ7kNvwHeZduU&_nc_oc=Adk0kP_prc2M-XE-tPckSMacaBiVae1SKxYxBH-4nMQxAk269mRtbn9CpmIVw1P9U-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsF6-whoSqGNtkPSNqWEVZVHY3G2iEaAxTnzV4GNSAakA&oe=69A4468B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ksvm3GEdthsQ7kNvwF--Gfx&_nc_oc=Adl97USCvnboklQHxq9WULQTy3KqE9BBrVgdnU67GrpuhgGjlZmngLu1ZylM0rXlGGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftuCTQe3FXbFwfN-g3NBoorKn-EgV8SVNtEsV9IaFdryw&oe=69A43E1E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393818_1313517856602921_6940534570603940676_n.png?_nc_
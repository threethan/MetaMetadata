t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEeCjGoNOF6y-liKTkZ4DHlvP-zuoLCRqmYzy8PqDmWg&oe=6A92BDDE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZFTvvuyRAYQ7kNvwHylLBC&_nc_oc=AdqYu2f9TEKjQ0BewURy7OHJ7Bu2I02IirTkLY7bvtYlV1lxWiGhndWFKbZ2JNNeMCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_9-0H9EZeS0xoitM1Ka_7Pxd9_F6pA8Sl8rnMe2FWEA&oe=6A92BC35"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPFVh1qDk6gQ7kNvwHnfY-2&_nc_oc=Ador-68JQO3es21lTA-8iwYou2lGNxoYSyJj3qECbciDdgaKSBcryo0QxJ9PvbZGk5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB739-fTUvgzGvNTFSLCcPw95TFP6HXu9LhGFqxr0ukA&oe=6A92BEF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVYoMQyvHPUQ7kNvwE0idAW&_nc_oc=AdpP-ULvbhKuuPnq7xpDGHzoAAxTcb4ZK0-6SQJKdflSJjdHZqFWYgIePaZl6yzzNJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvfKyKXupqSb7ZFR7mzXBRiC3J7nhcY_U4kG0F_Y2v_A&oe=6A92DFCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugJYnYwCjWEQ7kNvwFHqGkz&_nc_oc=AdprLWHLimgZZ8MkLK1GfYj0ugANLJdADVfDaREZw_fm0-W2TzXVcLjncY1X6_zbrIg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxRyxhDHE0rIXagR1-YC2-lVYP9kSs8r40PF9GWqOyTA&oe=6A92B44A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmGert_yGXQQ7kNvwE6RIp0&_nc_oc=AdrRhNsq2AAiEDvf-GeKl8j7u4P1OsrWiRSoZ5yzDq356orSA_KN8OZ7sc0VkTWPRrM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk329ObnVvlkF4YVt1vcA73vLxYYfUhiLHIi0wy48p3g&oe=6A92ADCB"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFBBVnQt6koQ7kNvwHBLsD1&_nc_oc=Adq6LcJcersrZtcKQM_pM5Xry_8TvsGL-iEEELvK_Izee_DnCn8nInmal1TSUYpK-ac&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY3EVlKEldIsYANEuFnJ5AjHH_W-49HFh9Xf6lwV3yRw&oe=6A92DD9E"}, {"file_name
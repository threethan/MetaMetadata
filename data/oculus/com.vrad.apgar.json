t-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iPkow9o86qSpG2G72DxcOKiXS_ttDV5pnRfhmC9_YYQ&oe=69D6375E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Lf26dAV35IQ7kNvwE8zSRZ&_nc_oc=AdqWkvX8gA2dOIlfAQgKuYbB0WQV5GFmDBsGVP-pggKd1RkqaW24_C9KDp71gjnldF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KgrJZZESbwUYiOURhUSMAaxuty-f6Fj3vUasPmpCN6w&oe=69D635B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v0wSjRb43cQ7kNvwHmdHaa&_nc_oc=AdoOQRJerlagG0d4shXrmWiBJ-lO_rHY9GFRUbannKdbUgzxcjFshT0nrEbZSWdar_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10ZT-Kt6-7MuXfNRdS-u-QxTyMJkO_1dfh3hj1sUDD_g&oe=69D63876"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoN9f08Ej_0Q7kNvwHZ4z-G&_nc_oc=Adr6KvqEs8zJhhKJttlCYuPkKT7_U3Rvck7b9HX1GyfEcgY-f7hM0rX9TKLoF5v4a9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fCkNkjXNjFObKeLsFipLZo11Ixz3l_uXx-9JzAMGBhQ&oe=69D6594F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHDLuFEA9TAQ7kNvwFIlOwA&_nc_oc=AdooQve2krNb5MPkUArRPN07tvDrJqSlNlBJY_-81Gq8HgffgB5EtU_nBIJhmNIBdOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mJ48Ttff2nnxpe2vXsX37fLHIWd5byZwIY2TROVGdlg&oe=69D6660A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CenI1pKddooQ7kNvwG-xe-K&_nc_oc=AdpHPG_-7x88o_OhyBiukql5QM8-0-vD2WG-ckd2eOK5C2ER7Ky4KAWqtd2I3shHNEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lULySbQET3wironWmKNriTuaDvrz6Dd5uhxvtur_HEA&oe=69D65F8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d0zYJSk7bcQ7kNvwHXx1DD&_nc_oc=AdootEcVwwhgYX8UOksa6GG5IDWNEqm044YU2_BZ19sJslqDMNwABrKvEwmz-7eXizw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AGA0Jhbux-BR2Ev_9V1dXsqiMZARuj-1bhsgrIgGWUg&oe=69D6571E"}, {"file_name
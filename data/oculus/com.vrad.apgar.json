0_AfzQwPVqo_nv2m9wS-w7KJlCw1dGVfREmRTYS-gy51xiaA&oe=69B29EDE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUa4VevUTwUQ7kNvwHt9Gyl&_nc_oc=AdkG3KCNGW9RCsTuv_wBptC_NNl1dPaO_YleFxVwus9we04mdCmC5NGG6z3wDGGLWhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCQlPS1tLNZ4_mPEgh1q-iriuaXNyz-In0UwFafVJMNQ&oe=69B29D35"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OArS3sq_trkQ7kNvwGymel9&_nc_oc=AdlVRHJJSpSMV5ZPDBt3Ej6P-fTq1PdQmWYfqZGE5eomhySMBSqnzw46VXCZc3KeZyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx4CY_Y_kgzO8kOeMgj2BkB-RQygLoo6WKSWajZTCdCEw&oe=69B29FF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=203n3v6Ooh0Q7kNvwFQO6Dh&_nc_oc=AdleQCzZT5xsDYOuJCpCGyn75Z5mVJnYbEfWMd-deeUclb1rd4gsJF9xnSSLZnqNZz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBzsPQmFpWBPr6RgU4l40zfJx2sysF5w2pl1QRZGZlcw&oe=69B2C0CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LlfxQ4sS3sQ7kNvwHCu4oa&_nc_oc=AdlW64p20YOtS5rDr8QJk9UYLdJB6XmSfnXiR4n4pSBygJL16xjntPrlh-6CDTDv9qU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwqafgm93mr2GAgpWhrjUsv6X2Dbz5yxTGItLsT7ALYGw&oe=69B2CD8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40ulAXML7BAQ7kNvwGnhSWU&_nc_oc=Adn4Y30F4JUZpV125VTIvniMKieQPTM3fhd1iCkHt6qjiweOdJncHCE9ZDf5MMorKGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy29ZlProdJHqiMenQgYvEI3ZoZRedv0PhJCvW0KCkmJA&oe=69B2C70B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbn8wou1uJsQ7kNvwHKE94Y&_nc_oc=AdlSWPqOXEFXl1KXJ-2csMY23DeN7TfVNihbVfaXFjfc1zOroU1YyqxxTgQrNvRx27g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIW5bu9ldmNDZNBP4elAeGJwSlW3mvHJZX329aPK1AOA&oe=69B2BE9E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
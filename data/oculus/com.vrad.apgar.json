t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPMuGMe0EiBk1N8KfRgbGk6xWkHKyhgS3GD3Wb_wuoyg&oe=6A9D821E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM3Mld4IkCkQ7kNvwERn4gF&_nc_oc=AdreT8_Pa7vz1FE8GtBqXvySdYXIsDYAzeqm820v7sXU0i6F_j9xCIAUkGrtX717Apg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAkmoYCBPMApwQjP1oG-O0h1-GKBR_1muUrRloTqkxZA&oe=6A9D8075"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2u6RYkxCNdsQ7kNvwFE83mK&_nc_oc=Adr3e4kVEMUQwQilkIKA8vxfmjKqW7otNpAfJ1AD1iJG1kZwBycqjsmOG-1VRzhvXQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuwYs6c7UqMFA-SgWgVU4QaLfKoZutV3gf1jmY6iV5sA&oe=6A9D8336"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJA_uv3a4OcQ7kNvwF1iAwa&_nc_oc=AdqPv2O-GIMtiA-bk8udCKRNIsNsFj5gjGqB2czN-swRIwgZ7F9J7D9HYT8wPU8An6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3y8-2mg6bIyMRyrtLwzNbXC9mV0q4DdIG0ydDEtLm0w&oe=6A9D6BCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iRAdju_SwwQ7kNvwEhoCps&_nc_oc=AdoKBEO3jT8L7tK2x1_ko7QrOKR8p1SFyqB_GdesCFrm49vy5sv6Dv7KL4G_7XfHVUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0A4YjPfdMWd0piYQNDFIAtLh6Lpg5MuOx9ipcHQiqDg&oe=6A9D788A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdUMgsf4n1sQ7kNvwG9-jQU&_nc_oc=AdoWr7WUrlOgFhICIeyhcWbJfXgdZQ5T5N7pKCZXqSjTAkKJleNEx6Y5NjaIUXm4YbA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRbtCeDsFtnn9gc5usw9DQQVSGjOIXzR5dghSgc0wZLA&oe=6A9D720B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM4hf00jG58Q7kNvwFBzjUZ&_nc_oc=Adqxedy--gXMDJBRoFSbh8361a01TT5NsBbDZZGzTt8Qn3xf8LNHPZBKxGkEdudFpyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB1aVEEHD3LfJ25VDhJtlqFob4Mg1eDYO1X4G4xW9ZMw&oe=6A9D699E"}, {"file_name
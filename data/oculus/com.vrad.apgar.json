t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxf5-jypaTmXv9LaaOR3GgPRKFhBMlSQ7_G7IiPRnGHg&oe=6AAD541E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFbSbNtVOK8Q7kNvwHR5O1T&_nc_oc=AdpYta0XUgPy6dv1R78pyZZFqhX4HUuiwvRdwCQyUa9IWMLZ6nDuLzmdIxP_4LEsVHY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtcAX0NlfDV4yj93t775pqyRaVvKxomIPvhXrEye9kiA&oe=6AAD5275"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWSchoLMXgQQ7kNvwETgR8s&_nc_oc=Adp3siHkJhd44DiYLLajr0OqNP5LeUPtpPh9r-FdYs8yTW2Yk_gV4E8rD_B34atbr50&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV_ACI_2t_FU7vMiA_qUwvLFnve6HLUgud7klsvIE5_w&oe=6AAD5536"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mye2M4Xf0AUQ7kNvwGWoHou&_nc_oc=AdrsWh8_Lvg8h4r9mIp63ZRyKUOmsbhWhnvDLePSQC7M5iOnUXBUZ9Fz5tXq3S_KD44&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2e3M3n3jCLuhd7PrG-fdN5eUrrGISGXHVJINGIO_UXw&oe=6AAD3DCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqlmHpdSKPEQ7kNvwHckbDA&_nc_oc=AdqcQiTAia7aWmAJuiwt7CQcCoHZ6Lt6cTdeLWTcmUSyifF-fl5BuvtVSfZ5WFlWpaA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxU3qJWS-ayZVFyOtMAD7siHIKhDK4qfsRZvZyiizW-g&oe=6AAD4A8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hMridaRfh4Q7kNvwFLKzr8&_nc_oc=Adojn_e_yeqs-piq6fzLOUit4vPA9jPIu3n1KhLlvIopWjKQLhT5cXPallEMzJq3ruE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-QIIuwj2nUuNW2ugzHTqVwx1GWfwx1WGZTEYmsf7Kgw&oe=6AAD440B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdoe78VoDKgQ7kNvwEfmrqy&_nc_oc=AdrzX6mfUaseuNvbOgzMacWwYoft9CNC_9wPR90gamSrPK3rCUP7t0gQkGtqATbaxwk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvQpITMdFXKycOK63wYlEr-WV9c7Alaoe3dF_Xi9Wf5w&oe=6AAD3B9E"}, {"file_name
t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyqB5ZgP2B9Zi2E3sNeTZAPD9XL6K0FfMwe6UuIq9aaw&oe=6AB68E9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o-TYe7BQyQQ7kNvwGzPJMn&_nc_oc=Adr8TI0iBM0GSKjIKSIn_7Ohww2cDjcy6YuzUru-Dc-ODYCVBkahxS6LvVnitVwMtf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkWwkQ35EsWZVkwTLc6MguVOFHoOTH191emlAGEWwUgA&oe=6AB68CF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8u8r8iQ77YQ7kNvwGY9pyb&_nc_oc=Ado3bHsp4gqICXNGaQKTk1-1iGP2UXd0Wc6LkYxLOMPWoF_YEHwZyiOMSiNYhrakaO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGFxJWPEwiegWzvTe1L9MNwtAnlZySlCiNuNtGLIuwCA&oe=6AB68FB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F4gl5fh-ucQ7kNvwEYyS4o&_nc_oc=AdrSOmhk8wfPhvzmS5DTPszxzInSU5uQpCADzrHv8qSoh8b4HAnJw_U6qrw55wjSlEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK9gBOBZsbMnUq2AKDJ2ENqDg08JmujorKgK4hWSrJwA&oe=6AB6784F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7RHqUuUx8IQ7kNvwHQZYgJ&_nc_oc=AdqFCIAb7awup0IdwpbLqJ0-ye5i4RynncBtl7ewG8EItO0RMx_3rPY_Ksr8bsInurg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcJWtXpqsAqNHIE6aPHp_T4EI4zlyzWXCPc0Z2TGZIoA&oe=6AB6850A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBLOTj9IjvUQ7kNvwGCWXRl&_nc_oc=AdryR5IVqkBhyJN8OeLSwWHTnQN3zgRe7RQWAeNLuFtnqkAF9xozQJm3UyhxkxdLmR8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR-t2rLM9LvXXvK1ugxYaGf8C-kgZSe5rLCxCypCxbTQ&oe=6AB67E8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxvsuxGkuH8Q7kNvwFWbjY0&_nc_oc=AdrQg0nhMOOavJacSElHcwvT76HnfxvVKbheh0XnFOwsGL-kLqJRDoDAlS6W4NP5LfI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsOcaNsT_3083C81kkVgjASSjW453OYb-mzVrJIA-6Qw&oe=6AB6761E"}, {"file_name
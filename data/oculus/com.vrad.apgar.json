t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOSs4M3DO2K5aayWphJB7DUMYdoR8dVhqJMHQyAUXyRQ&oe=6A72009E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yruuX6rfb5MQ7kNvwEAznJ4&_nc_oc=AdqMHjLnIEj5m8rBhLQAOiKMK7inXCknjGazvKz7S4MXpQqYZRh7VczZLVaZkgk7cOc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxJu_ugl12nLpnUWKuw4hTmmiuHSSuogzvgTNEtHZczQ&oe=6A71FEF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrHGgW9ipcUQ7kNvwG3dblE&_nc_oc=Adq-xetkAQe9A5Zn8amsZQD0DsQYx5yHoFrrQqv6dCQaUryw7YaT6aU1y_6yL1RSgJw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf94tB6UBqVHLsnkHz-cAaQU0N_vhkceEXJucaHzgV6w&oe=6A7201B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5bFQDvbf1oQ7kNvwHedjiQ&_nc_oc=AdpH_IUqJf_nRyvLpp6Qmf35DfSiXd7iaaNTbdS2oA14Kaf7np74oNB7pjxINNLuoCI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgtQlDBoI2IT3VJL24DK4u58AP9Z_DuQ6bc4UwRc_pdQ&oe=6A71EA4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbvuDde00zsQ7kNvwECZhWU&_nc_oc=AdpuHjT_Ygnzo_3cv2f09VbkDk2rqkSj6bmrW9nSUavbtT8T5H41QFiEMEkwBVUqQOU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv-pxvJjTPPhqPa5c_vzsV7-n1z0R-wHhjV0JO8pMgPA&oe=6A71F70A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53bmWResCjwQ7kNvwEzxvAo&_nc_oc=AdpQQu64sYf80ndo0EK7paov41Xb9g0StliH-5KekGA84RgzQw6bOZlAZXa19j3svDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9v4yltIY4psxeHkhkPSM18yu8lLEOxYcvNujtYJsFdQ&oe=6A71F08B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9xVLlulM4UQ7kNvwGE-G0n&_nc_oc=AdpXU0-gQKrxOi0tWycKjgaIyqFKdWqDs98hSkKH2fm4M81vwbWnV4pIaGxTkDyIUQU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOtSfz7-eBBkZZPhb_maO_AfMO_Mj6ynHx_I12Y4pVfA&oe=6A71E81E"}, {"file_name
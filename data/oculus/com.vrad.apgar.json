t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiLn6hEh9vcQJJuuXuesqkdzKEwRdz0K9uBMpQv6aa8w&oe=6AE9F91E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5CqCvwNeIwQ7kNvwF5LIsU&_nc_oc=AdqAvuEKBQNo0ewaxqGKwyMeM-AX4hK9_-cxG6-SAksI6Ykgd-H41CU7KljmWpTNcRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-9pnRlYK818k3rrgJn-rZYIZu9IEQXrcLFA4n0axOgQ&oe=6AE9F775"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlqnOrdJOj0Q7kNvwEvhztD&_nc_oc=Ado74_HXS5CRf1vERU9-EPxsYpy00tHMElRwnhjwtiHL6eNpCrUi_QzEVxnNc7NUwgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS79u3xUU3uW1zMaTROcGDIl68NhDOj5aje0yKJKS9EeA&oe=6AE9FA36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yITStg2okTwQ7kNvwG8BYN4&_nc_oc=Adr9hRBdOCi4BVwO_HTV0w5cixVQyidG3mKYgQ3APWJqLQZPLba-IgPiansjZk0K_IU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq4pOQ8VAFOeC63KsMROkXpwfmDMsgLlvVtpD4SPD7gw&oe=6AE9E2CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXLbd0Tozo8Q7kNvwHjjgqx&_nc_oc=AdpVmXuQs1DOd67SC47fB9rYh2b4fhfq2xXJAHgq5P1tZ3c4EzWALkMBqtlWrve41aE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZr3YHtX0mk-udVUTi3Ob0qTqkxiAwxKVapuMLkD8xkQ&oe=6AE9EF8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKY08Uw_RxkQ7kNvwGB6gd9&_nc_oc=AdoNEBP7n8Z3WoEppNM2MoXI6K1Dvpha63ry8RnsdYygocyBr2Sqb-N5_y7DgbGrM_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Etry5oYKl39Cq-7EgF6qPfZjoP7Rklyux-9JpcRYsw&oe=6AE9E90B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg_1HU9GFikQ7kNvwHTpWNO&_nc_oc=AdptJngp2s3O6lQAvOOTYWQRhk9kCfRxBTPMAFqjtJa6szj58svc7y1awVDbZUYzxpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-oN5Fc1hGjpvvqBgRgOt6rjaUvViKVDnzIOWD1btG3Q&oe=6AE9E09E"}, {"file_name
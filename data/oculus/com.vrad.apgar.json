t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sAl7XHBqzk6zFXi7SOvLc0fwfPlEy-IAvSdOQATw1YQ&oe=6A1DA09E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_bD3N3psFQQ7kNvwF0lptB&_nc_oc=AdqsEXhumd_PDXWVsQNnCUKDY67tOpR88Ckh3BAh8-XbK5PFfO_9zfvi4RC3NUlRJMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7srTG3Ub4tjVAgn1fBVYQSCW93bk0r71OFuMSFoJax0w&oe=6A1D9EF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wQTwiSRSBMQ7kNvwEd9vdp&_nc_oc=AdqkVVe9vJKkS2HaKX5aGJUFg9ttBGwCfGWoIiuz30RIBvSVtznG0AT5chvfOARas8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zNg9rECw48wsbq2PVVXm_pOGg8TiWTSPDFEKJ7YJkJA&oe=6A1DA1B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XflIi8zHcx4Q7kNvwGb6I_5&_nc_oc=AdrKLiPeJcH6z7dWlYVb5t5f4ejqDS7gzCbx8VVrKrB9kzPsRUZ2Q8uOff1A5aAMM7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H7jzTpIsOLqQbcNQayIHl7zqTaamzW1BvoKsxtWeZNQ&oe=6A1D8A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaaxMHBwZ2IQ7kNvwEc4pUq&_nc_oc=AdparxkY9O97u0sqZ7q6gYRCmPI3djnCN4hfAmiZOpIYTSAbQgv-ddpXZRpM5AvRKxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aQnC2X413StaavUsvv8Xfnh1df3-8SyxqbGXQsqebng&oe=6A1D970A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARHCOLiLLC4Q7kNvwGWkg2F&_nc_oc=AdoFZtm26Cdn6P6c0q6Xqf6Ztm_h-C1wooyR8XZoNIR2tFBZa2u1IITNtta3YykmkeU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iN3YmaMszD8fT49Joo9F-Bw5VI8Ngy3UXQ72dRBv1vg&oe=6A1D908B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlG6LRmLwCwQ7kNvwFRN5cO&_nc_oc=Adr08XrgtafJTQ3D9inGfiaZUG65mzvtEcPI7VW6ZuTMeoK5sD3onkJn18MP8TsPRKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Yp1CTcMq-CFqrzrHN2ZzOqvOcbP2vL637r0vbHpCq2g&oe=6A1D881E"}, {"file_name
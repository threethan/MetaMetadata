t-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWahaA4abbuWj8evPyUgWspkDQxNUL1i50gAqLoq8XjA&oe=69CF9FDE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjEYuKghQbIQ7kNvwGwHzIO&_nc_oc=Adq1kVbrdcO0U642-xBT-HvhFyLlmpmYmTpz56VuQ-O0dEPL3f32cC7LcVMqJl5SITU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw16m41ZfUzUeDZF9LB0SIrT0_oKEB3rmNxZvU22zSx9A&oe=69CF9E35"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEwR31jG8pMQ7kNvwHEoztX&_nc_oc=AdqPZYa8EOC471DNOM4s8uGJ52M7XMDxvpWNjxiRA5GeePTzahjwk64Uw-7F7JgkU6I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaKy2I41Xw4eidJl2Uz6dJDIB850kPO-S9VeKnLHzzIw&oe=69CFA0F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZrj8RNaXiQQ7kNvwGJNDN3&_nc_oc=AdrLe_LI9FaiUOpsHN4sRYbhAco-gCqqbVQpxkVoV1JA-svEnURL7PFHLGNuwUFHqHE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyI0AdEotBnikanVPxTliQgCK440_SyeVnbKY3NnYvgvA&oe=69CFC1CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3eE-_YovWQQ7kNvwHXuO_i&_nc_oc=AdoDdj2ftqZBvNXudK3zl-33dD_neurc22q9UMRrFbeSVwJhV5ft4uKHLmxjBhojaUU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwclUkRnM02L2vge68h9g3Ld2nhyWylfGvX8Fv7FTcu3w&oe=69CFCE8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACkMtXdxIhkQ7kNvwGvr5dz&_nc_oc=AdoVl_iSGe_Qxr-5O41zEjcxs7TBpwJ05E4IozAJBoqtnbq9SATjPGJinLuQjhyBsZQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpB5vKIRX61g0GL4Sl35IbADZcRxxmugGTmTk1XKCHGg&oe=69CFC80B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjKBA5SlcGcQ7kNvwFw0B6v&_nc_oc=Ado1XZn1K42aTPEDGI4y5-PamDSo32OyAfr5qgc3eq_TnYyGAm5OgQEfQKZPB7O87rU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbJvTe2oQNZN_Pn2H06Hr3L9cND0a33fGFVs_C14_Lcg&oe=69CFBF9E"}, {"file_name
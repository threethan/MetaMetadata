t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtAxYPGX6CiVw71JhSGz8aWTmuON7ULwjg1gQJKNnF3A&oe=6ABFC91E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSkmresRtj4Q7kNvwEQ7AGf&_nc_oc=AdrweX2kpVWyO5ZgyEN38WdquB2yzgc8-MLAWEcaf1jHH6M_gOcZUcLoRUAb5gxLhgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRnzJTvHaRH71O7CNR9vG2YQ8ZCWpz05kthLHmWZFXlQ&oe=6ABFC775"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ANnZn7kZ10Q7kNvwF_jWfn&_nc_oc=AdoEbWDru7nDPxmCkDZeuWe4J_RkQqrmEWXCCzXKMpyzlcCow7mLN4-0dLQzgrRFyYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzn57ca5EI_t3ZyfdQYhr6c83hr7AQzEJVGFMamnlKhQ&oe=6ABFCA36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyOi28nQF9cQ7kNvwFlbb2S&_nc_oc=AdrKKWC5E4S-aJUl4G4rRxdKHaR_55oUQBCaLwlzOcj_3wFeqyjEc5KobDBQFDpd2_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHJ9KSbYyTV99BqibzF9qFoKlrgGvl59dZLTW46QWF9g&oe=6ABFB2CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t8HtkhbvdsQ7kNvwH5u-9W&_nc_oc=AdrlPejY2oW1QvVVNAYL9Uk43djmTt_E_1kVKvZ9-IL-Uyu6a4RW34gCBipZmm0ZEbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVwP8a6bWRzKwL-2NNRbGgx2Um9jfFAuc7gOScvspU0Q&oe=6ABFBF8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIMwryKrBT8Q7kNvwEBoeu4&_nc_oc=AdpgOziRjqnxE4CiREv0LSg8L-YI2ephsZUVSlEoGaRNo-I8Fwij1eVbN7rHEAgs_oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjyKAEx-uO1luOEOP0VkTuIqkLTayCh240bti3xKG0xQ&oe=6ABFB90B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFVdLI2jfAIQ7kNvwG3VY1J&_nc_oc=AdrQFOxICow_BAnbPLV50OMyNmTFY9_D7lon-X3_hEUj6MArumqKhqGQUgVMNj-PbFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhXB89blmbvq49JZspdsJw6URoe1DY3JvGsI1C1JcrXg&oe=6ABFB09E"}, {"file_name
t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMY3hOUG1AijPw-fayPNuIDB0kFdpwEvOpb7Y7mEfqqdg&oe=6AC9039E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsrAtcGYjM8Q7kNvwHB0fRt&_nc_oc=AdrBLvpF_qVbONCg_Rs5-msdak8X94VA6-ZB70dtCBayqX3upj8EUcLGsLMGv4UvbQY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvsDYzxdXHSoYjD7TswvqR59rsPCCdRM2I111DBPtt3Q&oe=6AC901F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KUhfmuVs7cQ7kNvwHaMECX&_nc_oc=Adq9j-i6hDUWcbRRk5fNcxG9GualhzRu9_frEbIPcaBX3bkmg3leC5omocpw4UCE0lA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAn08NsiXitSODgVYxEexj8MbBkby-oWJn6Qp4YHydGw&oe=6AC904B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTg-rTWuU68Q7kNvwH6zsRt&_nc_oc=AdrVgOKmRz2-2XNEH7pPq8iQ63K2ZAQQVXBV5h7gKN6e7SAYGxkrOoxLHbzOiB-yZ30&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN9TRyHfWYdJBRf42cJ0I9GNEf3wUJ_2u1eWoGHlD1yA&oe=6AC8ED4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ittCYgUdu4Q7kNvwGtOUlB&_nc_oc=AdpvFtTBPwcRFBM1Jcb1Zvh5bIXAAaCcV7zr7PA0fh8M7vuWZex7KykRBFjsqF0uoHc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPorKdZpVssSTWNVN58m16nIczrWFpBgVgpvbT_jAeiaw&oe=6AC8FA0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dklzyn-QpAEQ7kNvwHmKti3&_nc_oc=AdqrJLe4vtaV-aHh0-QF1myjGRduhjHu0pCeP0dwgNvi2Uka96hvbXufQgvJcKnuDks&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4myIM-8acVr0_XyPmjqcWpDVmWUW8qZ0O8VU-1zN5TA&oe=6AC8F38B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zN-QKEpeDZQQ7kNvwGMTiBU&_nc_oc=Adqi0O_p6FwwTgkRNTfyrt0pa5kh3OMabbuAuEd8mA8VYWh7RKvvDtz_tT4i8_LKjVw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYIOFqwjL2btu6OriNkqnr8K3s5pWNd7OpmOfb06aVxA&oe=6AC8EB1E"}, {"file_name
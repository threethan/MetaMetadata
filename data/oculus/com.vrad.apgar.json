om/v/t64.5771-25/473396958_652591360577849_9079589504140055906_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6LClu0mTn8Q7kNvwHdKU4h&_nc_oc=Adong5YIz76J2tb-ApXmbeSmpV6rYIujJjYdhZhzlT4sbCehK0pzag5XcLaB1F8LIwY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTE0MTfcAhPxSWvHT1heNePDfhWAFls44iP87yqpvG8pA&oe=6B0B26DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q5B01p3ZTMQ7kNvwEp2BfC&_nc_oc=AdrlZ49o3houDkOL7Cvwu5FrLRcBK0NDA-AdzFMt94pGtn6povfIdzuA6V9UBBRFMLQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNe3SLJbMJhijMXZou_He0PAuhMHNojcGc3eDmrrILMw&oe=6B0B2535"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWVH1HTdZLcQ7kNvwE-Jivt&_nc_oc=AdpBz_Zg-zF-t1oduwAOfmixaZG5RB0gRCX6jZ5he70od5EsKaeC53d8AfwGZ1X-o_s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR913NvwrIdUqahtLcrmcJdTiefZ9PwCFLsBs6ARhRq2Q&oe=6B0B27F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfsqdATy8sIQ7kNvwGCXSZW&_nc_oc=AdqgvSGzL2Z4hsthAWrqnXceAdGfao0W1lnDSwwwF7-saJU2PA6FzYgmsrmhrhswxWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvzgmk5ou8OQv9XezdZfVF5swbJjfRD5QOYn_1pHZbQg&oe=6B0B108F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diUQHhy1ZtMQ7kNvwFSqYlq&_nc_oc=Adrrbd0xuloeP1ZoavEet9810VVeapFyzUuAvRyw6-QH79a3YLE4fV0A6S3T3jX7z-M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTctuJdGaNmnlzgRpx7DB5yipVpm65BBV-kTryzlVk41w&oe=6B0B1D4A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSCcmQ7Xka4Q7kNvwF855oz&_nc_oc=AdruEufb-0chgXxcTVS2l6KNGGxptOkfx9mqYrISfGm28Z8ai0GmX5IQ4x_tgx-7yIM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSIOpcp0xTz5vLNk2K1YC77sq8MNRGHKwzT4DcnFwOLHQ&oe=6B0B16CB"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIzvNcl5TtVeMgVqDGgeI43PhgGwvpSQiVg7FJzbzQrw&oe=6AAAB11E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqa0TdxkH60Q7kNvwFLdIFS&_nc_oc=Adr2122EZg2_MedPJQqPLbKG777b2qu7cx0x9pZRtDGuWm9-QiSi_8-n2yzpy2kIX4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQNqHvqm0amcGA0PUtQ6ALG51is1p7zwypJwYtAXAMHw&oe=6AAAAF75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5Ct40vdbeIQ7kNvwHmx_KW&_nc_oc=Adpq3GSNwmtLvRmz8WgihQBIBJ3eUkEmuEKmvXVYD3itKvWVBEdj9slXM-HXo7X94EE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO6FPOY-hmzOf3U5k5TufgtK3gdOMoNt2SE7EyIEAy6Q&oe=6AAAB236"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYDmSpsF9doQ7kNvwHoO1g8&_nc_oc=Adru9aSPGx7vErMSs7AEhu-xtaDWoVhF0colvqdeBkhObnGYJ058Q7lRqUX0V28Xqd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4lOySvEdzy-eI8ZPJXWwDXXvKdCTrXeXrIIQLf5ctBw&oe=6AAA9ACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqlmHpdSKPEQ7kNvwG0VDgy&_nc_oc=AdoFFhhAphv0okNleJ5_CeZTDRypi5V6oyGlgmTnrSurHNlK9_QgVLs8-dOmPuwoycs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRGpYbmUgMGp3oe6QgsBXtCBDvMTfY3z6tULZ_7SSBfw&oe=6AAAA78A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hMridaRfh4Q7kNvwGfP5K1&_nc_oc=Ado4XGRw1-5TBVBAP8_mKgC-q4O_n-YBOTejKKp3ts6iuOBc6iiQbGC8mkDjME0R2qY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIVaxFr5RAAS1Xj-ix9zatJq7SALUoDPEgI5QJjN7vnA&oe=6AAAA10B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdoe78VoDKgQ7kNvwGLypM3&_nc_oc=AdoNfJUS9XdFdUrBoF9PJ2KaMOb7wAGgXjO6t9HP2s3YugxzUvyOCRux33UXlaIel-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkyg7yU-e6KOgKkq7P95mjcC4zsKSSJatUQJFww_c6nQ&oe=6AAA989E"}, {"file_name
t-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rIyvfFUPKQs-N2zTpiPvS82KMl44O6lcnKVzMr3WAAQ&oe=6A09DA1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=938Pa1_DIwgQ7kNvwGzq_3U&_nc_oc=AdryQSbhc-52olk5L3aq4cmusFlVVmeMIrYuKMWyh8lprlu3nzUDH9aofIWmnDyd564&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kRvzllfFOWulN32A-uTfKbg9dh_4v6RWerIxlpo7UnA&oe=6A09D875"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFgzwaT44hIQ7kNvwGfbA-n&_nc_oc=AdpYFiR7ArGD43-CvXQTNshQ0znKLn0JC8YIQLGQCPOE926RAV3nMFiZ1DVskBVW-wM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QE2vS2m8_4momqD__RdCSYTcGMXuPb1gZSibC21VdhA&oe=6A09DB36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgwCW8yDSFUQ7kNvwEbCZ3g&_nc_oc=AdpGevahi5i5-g-u4GITkTThXcaFp626NsBA0HdtwgGz5nBSIZkHfM37RqL-tZR2mf0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q30gDjpyqM6rXBPYYINWkrAFXJD8dML36Mt6826O_Hw&oe=6A09C3CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUIzl7ZMLt0Q7kNvwHceACm&_nc_oc=Adp-76iFbRs5QSyruzFEWOzKeGej0VXhQ6d07bR_ol_vStGJFVaQl_-9bHi8qNrAL6g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h_2TIh4n3cXll6a0XP-rEs6GNDznfmuV7D-jAv-8AMQ&oe=6A09D08A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMIBrAvlcL8Q7kNvwFsj4nR&_nc_oc=Adpp0HnO0gw8XdWr9a4eIorsFJX3PQt533JDhK1ev5EOjeqx4Wxy86laIsDduO7qOhQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zH01A1pBnMRege7leHgkF7qMeJnLYRbjyLB7oqnHg-w&oe=6A09CA0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu_z-kFDBesQ7kNvwHSsKkt&_nc_oc=AdrmvZZcwK8qvH6v1OloSkPgKDOHZ5P-uyWjzgdKZwCEBVKGayHqqgdihBDDSTGxnIc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CPadGr3GQbeQ3Wyrhsyt-ZbAVY1pvwG1SvjlM0zkQfg&oe=6A09C19E"}, {"file_name
t-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F9XEyvPxvihYpLPWzsxMFaMI1We4SUY0hxAFbs1v5Mw&oe=69DA2BDE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2eas08zh-EQ7kNvwF77JxH&_nc_oc=AdqouslpbMtu1y29XkGVoxqkJEkk4kdZ9AOPBdxTZC3nF0e2ZMYZfU0slWlt0zr-zFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uVLmDrCz9ZL4IQQ3_4hbjGaUUb1jZg8eKO59NLG4NWw&oe=69DA2A35"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2_i-mQPgeIQ7kNvwGwHhm7&_nc_oc=AdoadccNP51-pfg94EhGJza240DMQ7wVQfla934gOZ3DxGjBKnCIgiSk_pQg-7jWa7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t_CO7gMmZ6Q9okTzyKFpM0lqyvxD_m9ZxiRAeoh5VXg&oe=69DA2CF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwbo7l6LzSwQ7kNvwE2Z0_O&_nc_oc=AdqWzFs0I6Dzcfd3ltOgREutCecN54qEbeV-nlsltKZHU4NTo_ue7LdpjX-gYGCMOHE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-Yn7aIDbdr5iw0dTFpF_7Puf2v7LK_BKtu8-ZQzMOeQ&oe=69DA4DCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjRs0lD3THsQ7kNvwFiqbPE&_nc_oc=Adq5CnjIZ_I14mTUv7jMJd0QoOoC_j0xwK4LIaPKk7ljynzq-ccJ9rn2qcLJvTWuSnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0llf2e2j-AM_bBcwID_bHqheevvnqvHKLbtQXOXySKHA&oe=69DA5A8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZUTFjvC6J0Q7kNvwES1wg1&_nc_oc=AdpjotcExAPIj-6yJqevQDY0xB4qwwJrQsmUdatE3B6aJezRQuv3aLWQVnI73R3aWok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27ehs-e-BD6QgcTuHV1rsUUd6nPKCVDJ2Fc58tk5aUxw&oe=69DA540B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRGT3GTh1mQQ7kNvwHTxi6Z&_nc_oc=AdrIAuPSAqn0EH6e3ob6YWRWnUhqWvZDBCAUNJymAFE2yN_v6dh67XeOlUuO5xOZ3zU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PjtAlKomDQbJ-am8BPjP1sLzzgQko781I0smBh3Q9OQ&oe=69DA4B9E"}, {"file_name
=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElOHt0MBg2ORb3QhtGQU4fmg6VBrKcaumJ6lZ2Vigi9w&oe=6A7DA5DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1FpI6EudgMQ7kNvwEIcMgF&_nc_oc=Adoy_wwc-7ITvfyOh3rKuM285Zh45CH8_ESue5W7ueHz07781Y2j6ejbqOw1EVs2ztk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0GmQmxb3rfg6mvAx7KRikp0MFCZA-j0cgGO7Ksbu3Sg&oe=6A7DA435"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ckHunU-Dh8Q7kNvwE5nH8m&_nc_oc=AdphlVfRinSKhtoTg6Nm5d6WNY3gqhuul5C27IQ4HLF-pHDZqjRFjsIm9sIy5z4brnQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwlWljVEIUoMzgELZQawFr-ButuSCFsVupcWA8vhcx4w&oe=6A7DA6F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGuZx_cO8tgQ7kNvwHR6en1&_nc_oc=AdrwJJV1vgul-7J3Jjp0-xnOfKHpnDXIGehzniNsyE-qZd6n_9J3XQ_Lfi8BpnZLaVI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKFomC7aa1gGR8jSJwlBHzP4p65uFZ3Xcf-CdQ0DZnGw&oe=6A7DC7CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdtak6V1px8Q7kNvwFZJjwN&_nc_oc=AdpOjjuz4uHZzDrh7Zh4LGV2IxMF75Y6qw2Z2HuXGDpC8YKx7uNLbYT5wcEpNNQNnoU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNcFLDavdAU6neo1xxfw_Ds8ZGsUAbc6Ue1UWRhXfb8w&oe=6A7D9C4A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEC4RExtUsEQ7kNvwFDccBn&_nc_oc=AdrFT7Bdp9FiKlv9mMXbYuzM_QW2il0CAemX7Q0QFOItKHVS98NSO0MLAVodHRlJTNE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAhmsisixH7NuDgSWAgUBWclfgF1EN52FIVDwrZsZxHA&oe=6A7DCE0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swmM55AjMZkQ7kNvwHtEQD5&_nc_oc=AdogxbtbKndmqLlbp_3a82NYwbk28ed5xjBxVMqME-UjU0O6vfMfsjNSm1YjE5EkqRg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa36IicPo8eMusbSJVuffV5zVu8y7fSgi31Ym_BkrIMg&oe=6A7DC59E"},
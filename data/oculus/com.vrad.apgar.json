t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32KaeVYPDKFmGfoXQ-fphsMqrITeEH1BsnSNYK1UxXwQ&oe=69EF7C1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwlHFLYmPaoQ7kNvwEXYCdB&_nc_oc=AdrUFwZ2_FP3tHQIMRLEhbmsVTcJirWcAY0wJ0erDdGSbJpTztWWJ2vhGfkYc9zSoRY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2e5SnXK_HwlS9RG_iceqRKnt6duJFg9L9FKECD3zMZPw&oe=69EF7A75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvVqsdadzTQQ7kNvwH1frD1&_nc_oc=AdoproF0Ld5XFZxCEoHM0qqsdd5GG2ZKIKev27U-ZutmTLuhOWCgP4SuNFTTPZxA0AE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31xy3Lb1SGq32I4_AlTpUp76nzPtStIdjaPOKsCmTCOQ&oe=69EF7D36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d7fOHbVPMYQ7kNvwFAwgdL&_nc_oc=Adox7def2sMgJt5i8JYqepAvyfx8UTFGc2wvFSsaBQXWTHUf6VS8WB-PRDUABCUzAI0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FTijZLFNZTYVWb3BNQ2BXYxvFglzhECLPxFkbMDKgJg&oe=69EF65CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlUyBzriFVsQ7kNvwFK_c_2&_nc_oc=AdqeA1acGt45KKy1SFNXIYUSl3Io-yWeNHwvWUlEUhMLJNuIjYzMH8dnhFjAicxyJJU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FKw5UWpvp45A-eX4PNw58uyvmnDpJYHU790CfYnXhFw&oe=69EF728A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfKX8KP6recQ7kNvwFS6lSB&_nc_oc=AdqAO6ypWhK4jwBJvmbXmyS5_dzzfVVi65Dbiekj3yomL4eCW2Hi3Dc9hsLCi-JUPV4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BgBpKLUvVTZY_R1TVM0wlZn-xXqEr96aYvld2f8iCSQ&oe=69EF6C0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YryfWQyPr8MQ7kNvwF34qpd&_nc_oc=AdrKrq5N8MRbNBOZGqWwpEd6mV-ekJEKzSmVNCKMnntBV89yYLxZq8f6YNBpSVrfhow&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MMZ6eiV7OihJCh7S7j2bdlCLA7Q5owGUYWsnuXi9tjw&oe=69EF639E"}, {"file_name
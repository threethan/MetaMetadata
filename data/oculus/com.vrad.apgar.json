t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k-vAZ4yHMO9DAHYuOFT7i0Jveinyy6OdXUBmrzxfRPw&oe=6A32B89E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Nd5cyhYAMoQ7kNvwHTD95R&_nc_oc=AdqEjGs2nsDTZVN8z26dIGFr961vdomIUa40EHs1JZmw9LGMnSmYD-c0cRLfXvj9TUg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZHXrtI6D0PWJCJxZubCBV0zW8jFlrBSnDT5KViA2U4g&oe=6A32B6F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVy6GfHYF9UQ7kNvwH4lHnI&_nc_oc=AdqkXmjokd0YJjW_-8KboVGRLzk4ou3uvw0QLRP2cL3wfhAT4_tILM8cKxa-T6ElOMs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fhlxgvUG3Z2qTTRvcCMKg_kn674rY-2Xuypn11vGnig&oe=6A32B9B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUdq31zxmlcQ7kNvwGbFVSN&_nc_oc=Ado0UyZdcS1UYgy5x5549_y-PQMb967GKYQaA5Kgfo5i4IQ-dhj6SRF84oR9cszby3M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GVUf83Ex0WdX1OADcjjTRnlzNvFfK-vIp-bn07YyaYQ&oe=6A32A24F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAGxYaVZSSsQ7kNvwHXDCfM&_nc_oc=AdpADi1IzdNGqgH6lzec_T3prKFyp4bIQftIZRv-7H_GBDC9RcvmRBktsGnUWnQMi6k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s_Qp66sQ9ewhZ5V6AR2u34VTh_VwDpb-ruJ8yvtm5gg&oe=6A32AF0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wVNwtQ_1oQQ7kNvwH17ubd&_nc_oc=AdpS9h4wqTrCgHBsqbQouxdyPEnmZd7671ziIKlMZNon4cOZs9txXcoxJj-uEN2mbmc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hyWogbV1ym_0Y7kwoo8rlikwRjGT95ae-8zXsV8crKg&oe=6A32A88B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1AczOoUt_sQ7kNvwFx7y3Y&_nc_oc=Adp3orrdmaV1qSp0R3egAK_DTp67kKgvIlNQ71yT7RTVd-4JJ3aFCcHfWvrDRqPbPl4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AR9dGUaJC_K0zax-haujXEpWmENi0JeaID_-veWNLbw&oe=6A32A01E"}, {"file_name
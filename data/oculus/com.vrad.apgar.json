t-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFScJxOLET3uWPBS7pvoxOLIBlGr7tZOn4vwgS6J-pCQ&oe=69C6655E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFF26pj5QYkQ7kNvwHW8Hxh&_nc_oc=Ado2wtwE1PVia2G1OQ3e-1HfXIHyhuyTRlXrT25ObyQtrhs3nvLtWSSB5SbMYrUuXJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzY5ksnnkoWekvwPVuUe2CTTr5HETKLzDWfgjGUM6xRg&oe=69C663B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KX-59iI6jwQ7kNvwFp9_HN&_nc_oc=AdqaH1xLMmPtJxkzmvry44BgCWhXnQ7eeKUNkBFigCiRjq0rmKU0S8bVytkPyccOoVE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCeenUPe7-Tem_j7o3cel6s6e6GGojAhmVDZ2thMjOJA&oe=69C66676"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6YjaWzysWoQ7kNvwGoj4t6&_nc_oc=Adqm5OFVAZRPs21uTNYkhs-LO82VynJeU83gpw-ZrAiv6snnS6BenwuTwF1QM_Zxn2g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFkxUj3Caka9t7OpMDjnDxlKB_-TyruMQvqj7LvS98zA&oe=69C6874F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nihh7nOGVHUQ7kNvwEVLJDA&_nc_oc=Adpo8ohjx9nyJjws_YYlXzZIKFKl8ejhzS4oH5zNC6mhnq9iRGtTx7SPS7HxM2CviwI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypJRIYApcNA4byHlGslAxrsAdIRFgo9PfmKb2W9eBsUA&oe=69C6940A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01QaTOHYdaQQ7kNvwH9ytWQ&_nc_oc=AdpIZJYTJezo-_0fLi7c0ZSh2_8NivicCUzAw-BjF9MTMXeOuwStX6LMB4xw4ogV-eY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGs3KR7XuxsRdZGs0wsMLmsOqAXcuaywnX0fTWOw5KWQ&oe=69C68D8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1KF89U-RjsQ7kNvwFmdjL5&_nc_oc=AdoPdtMEYBVjnmA2ujUXn397JngRS-kB_F3czXnRqt7BR0pGY1nw8nKhN4li0MZVnnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXa8un0zAb2IVL0GOMWH1q3KsNyz7G8CV2szdGfONqrA&oe=69C6851E"}, {"file_name
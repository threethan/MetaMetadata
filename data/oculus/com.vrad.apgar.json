0_AfxdKqHL81VjT2y53gWAKEu2WcRxhxFVCqSkW34A2qkivg&oe=69B7E4DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e535c5MFN78Q7kNvwGFIERk&_nc_oc=Adl4ji7b9nBxuBu-kgUioQGunhrJlqq5uAwClDnkiaejdgQ_utA9slhI0Y_LNsItDsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwM2e8aWH2VbEKidxL7PozF7c0qzhDPFr_jJlyR8ts3mQ&oe=69B7E335"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2FvZCuYARwQ7kNvwG3sf_q&_nc_oc=AdnGMqRbzzPFP5QzbopUzrxbI_dgnyASmIEk-VG8_tDaTnYxho0IpsXOqAgakCfl-hA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwl5GOf1oR8fqtrEaweiCO2J8bjGeznY91_jjY6NGEb4A&oe=69B7E5F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAhnSIEo5GAQ7kNvwFExn7U&_nc_oc=AdnrLKhj6g7WNGAHI0mGfFN-mpEXn331UjVEGVq8NJCJuK4YUUCkERNjN3PIl1BuH2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOXllXp1WxfRfECT4g7DASPRoRoKk561ko-AfkIuRHfw&oe=69B806CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foObdHhSndMQ7kNvwGVwa69&_nc_oc=AdmW4ueeYmfGqVjQFvwPOCwDvCzgeM3K7zne-p9EoKc0dYftE_oLRkrsx6Q4axpPyqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKS0Q6tVyAtTbB61vBQuZzEzjELK3Rcs1nH1B_kTodNA&oe=69B8138A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WghJ6lSGfs8Q7kNvwGphxrF&_nc_oc=AdkTXCQ8MxvBrksFEWreEvsRteF76UiHO4SF538oXAbOiphl4jlBKd4oCZkmdD-05ag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp7JYyZtucBx9O9ZDFo-VkHq_vXH9jVAK6r3kBf_yrfQ&oe=69B80D0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnfKW_Sz_ukQ7kNvwEwdNi1&_nc_oc=Adk2V2O2Qk_pLIUuvuD6mOwIgHO70o-XigC2QbbDl7KQkUhJBBHHDz6iOnpflJm6dpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9CYdcsXJdfPo-jl8wBsoKZFgxDW4LsQMBTnyaepQX8w&oe=69B8049E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
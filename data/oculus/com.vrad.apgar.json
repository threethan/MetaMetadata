t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j6H3_xKvXokOsaEzUGB3Mbv6vKVdPIWpw8Ito2h8-FQ&oe=6A47D09E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7CrXM3wotsQ7kNvwFYhkws&_nc_oc=Ado_fKtSWIbhrNcs9qKJaNnlpDrdJL0j_TyXVrXbSHQ_Da8VWczOteN_E5D3bnNqK-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XuA-tjv2u-do4npf2gqi2sWcOPqx2YUZqTTwiGsoM8A&oe=6A47CEF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVOyL98znBUQ7kNvwFEjDPg&_nc_oc=AdoJI_Vz3pdORTSXpiW8JKCy_dOJHprnYe88KKxSxeeJBdPNt5UCCvoKGdK0irWwYkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y2OXF9sar6k498d5vqbhN0Yhstszk1ulANlKjmYcxhA&oe=6A47D1B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXsSRQm41NcQ7kNvwHGfdo2&_nc_oc=Adomd_ltINPtNMlvzOXBqv54Xw80F5IfciD6_lkpWi9d_5KPVriTbLExys4akhysU3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i9miE_NIuBTAiU2fgW-9O8KsxaFm3baAQm5ev66IlYQ&oe=6A47BA4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CulCfkL1ZbwQ7kNvwFsITPy&_nc_oc=AdroVEGhKAW-aoW4IwdOAbca1yFJbqqAUfeB74Jrm-XlX-wZ7SvxKyxLD5hpnKL1xvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85VrcAnfdQIBjq00Va_L7QTdJve2U0GAyblQ_JFT1EGA&oe=6A47C70A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USgg464kGXAQ7kNvwHUb3Oh&_nc_oc=AdrQbmiDu72A-UzIKEnhbKzAZDqZp4YRNMvqC-SUHatUoP_yClczBX5LeYx9oPdlxpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iVp47MVWGI5PDJq44x2-7L2X7vKqQFQixCL2QJIZQyg&oe=6A47C08B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZVG0mnigvAQ7kNvwE5ThDv&_nc_oc=Adp2rzG8iXe12nhEvOz5QwgGuR2tliADRmUQeAL78jPdWsToKidl4QNrmOChomcMMe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99rheIwbNToD3uhB1E_WcH8l6v8Na-7qLIxvMRgalZtg&oe=6A47B81E"}, {"file_name
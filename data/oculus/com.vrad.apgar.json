t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lFEXVsTxVHmwsdOe3oT4hE6xv_bVkv_idqE0EdVCiCw&oe=69FCAB1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4jcbl7pcbwQ7kNvwG2ektV&_nc_oc=AdqTIgVawmjvNS2sI6BhtrK28oY63tEOhZjAjdhiV4qgaq0Y5HLzvdvBxJXnTWlo76s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wz4jdkWC_uUzGAxs69MI6yRMLIV_IW-qbJjKfKxZCyA&oe=69FCA975"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_KReVBSXwUQ7kNvwFCruE7&_nc_oc=AdqZiYrCVdeA3qkmwfEWK8fcZj6FYYvjh3iUQV5nczvAKImzOU8l9sb2DTtN2IbWjQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iFXSBSBY3bhzgQPbGefrz-89s3vJSe41F9fxnMLTufQ&oe=69FCAC36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4PhNnf5tQoQ7kNvwE2NFBL&_nc_oc=AdpTojOQUFVI3xH1sBYPtCuo-IVUdvLC4UsdXWB1SCBCchnb6ZEtpeyUT8l3kDLGUm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZeMtdrth9OhfsF-voA3Bv0rGEp4yQHHecEgbOb9OspA&oe=69FC94CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BikrM0lm6KMQ7kNvwF09OzC&_nc_oc=AdqwN33bhjXY7WkmLbCCVxu4CihvhgudgFGmuEIV-Z0b5Mb8WUNixFOz4prL6vIKhn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ekwc3EKN6-eEPEUTQNQXLIvjfrie1UFzRub50wBtBKQ&oe=69FCA18A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXxZJlWEpDMQ7kNvwFI4X9H&_nc_oc=Adrh8YURXAesnJJZ0ETaDZ1P6QCJzJ-0XqAvICTvKSGkmgIcH1ft6wY2EkF1H7iA2AQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rzRDHXNnKAE-lLNYaE2MoAbvYqw25ZTUDzqF-mlYJcA&oe=69FC9B0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GSd8hsEX1IQ7kNvwGpAvld&_nc_oc=Adrwz2HgyP4mK8IZdwZCWj-TBITB726D6hRXPNgqL7digfI_zL8tXf1cC4ErkmbXxg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74EMk3pSRjR-Byvs2Vh_4gRLxDTQUl4TCUCaBOOSX1rw&oe=69FC929E"}, {"file_name
t-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCsp2mTRgyKsT2WtyHWqMEUvgStQNlPIuQypVp_1Vftg&oe=69C7B6DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFF26pj5QYkQ7kNvwG4zCtG&_nc_oc=Adqt6nWePq1KyIwKLFWO1hK3FZy2YfycqdaQkh6PlyF766L6T4OA2EvDEzU5NyWca94&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUOSr9HB4Ystwch6KOdKd8BpY9KBFFz5OUL-Sop0BONA&oe=69C7B535"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KX-59iI6jwQ7kNvwF-FgVs&_nc_oc=AdrgtX73PET8vNHAP8LxWRIWJaTbLaKdheHPaEOYxjIMoSSf87R31Ni7ueA0wE6Zg64&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy16BpLh4mVHHsSwTHzWOP5auPHaxi9i8cTtlSZfwwkqA&oe=69C7B7F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZrqxi-456cQ7kNvwEThN6D&_nc_oc=AdpycwaBix-QY1piTqCU3VZ8JBPIaZL0Z0CX5wUb7d7T6Uh7HUIjDhqEGOdJLIqw6fs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJjkCz1on6ziyPN-XrH3jqyXiVt8ceoUMuXc5QqPJlTg&oe=69C7D8CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nihh7nOGVHUQ7kNvwEhKzRq&_nc_oc=AdoIdpej3svgmd0mZgA75O2rN9CCfzSaGO3BDoKbpygvN3qKw6f8aaZ8xPDN8nGfUIs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiEF4cDDt2-R-SAmHd81X6zkAy-L7QDflg1k8wVXW7ow&oe=69C7E58A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01QaTOHYdaQQ7kNvwGd37St&_nc_oc=AdpKrGjlW_GE_KBFE-wifHBfXKZLyxjzhqx2Lk2IcXKkPBPVXxS_tls1jcyZOnBmyRI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdinYW1oi59rC-16ZHyVv3oZPvScbHU5KgKmbl2cIFqw&oe=69C7DF0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1KF89U-RjsQ7kNvwE8bUSJ&_nc_oc=Adq3tCmAzj3lwjytmM-e6h7mcAg46ieJn_ES8XEtKVbnANII8oKpa51LWMXpW64H53A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJR2VaV80cHpPFVekh4kOxMpUET1aIq3qAjkrI2_9PRQ&oe=69C7D69E"}, {"file_name
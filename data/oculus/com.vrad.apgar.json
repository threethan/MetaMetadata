t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7NhDsMmHMbGZL1PUr7iw8FoxX7s8KCSs0DX6lU_jS9Q&oe=6AF0909E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cByqRMU7jMQ7kNvwERIzr2&_nc_oc=AdrWOGcam3mv5q3aMRpTiWnbVsOPzpcA2aDf2rV84h6GnjEVALi9uPGztNt_dHnN9Oc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIV9YI_Pm29-0k0IKXPzcLUfNFYGMvewgT089rtIjRvQ&oe=6AF08EF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1f8o7YHEdMQ7kNvwEVod7w&_nc_oc=AdpV4vb6Hm3_rfHXbKWENoYyF4uaVH0KbYg-LC8FC8uRoaCZFqkl9X-8L6bPK2Nb2rY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6gU_sZvWKeRNuIDj6G70UQ3X-xeuV4d1pRUQKMuwQpA&oe=6AF091B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QSDLKtaj0kQ7kNvwF608Lk&_nc_oc=AdqxGN8CkR7zTpVYXn7RiHuN5ntNGTObAfmAgKyXFSSrWqIacPnOBPMCnvjExHYTABs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRc9jEKy7Qb97TMJasz-EKc1CvxOftx0ko-IHqkOTFlw&oe=6AF0B28F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed3YtG_GxMsQ7kNvwFkyUNK&_nc_oc=Adqocpz-uihN8fLPQ0x4reTBsb5OQdTnik5m_V4y3osrrsyDDw36n81CoLScOWbMGww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFUV_ofoE2rKvHFqcSiQVIX9OwUomjt218c052AiEeEg&oe=6AF0870A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNePrmvaRcYQ7kNvwFQ1WXh&_nc_oc=Adrc0D-0nQozk1OQ00QBiS27dv17pD4vks7vatd_U5WKP1oksp3cXrlO11IEcZz3JBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBEBVY1zFCvl0MJ0FYbdwjZ2Gb0J02HJK3UHEske43dg&oe=6AF0808B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIaJ8CFAg68Q7kNvwEzhHgl&_nc_oc=Ado9EgX43Eyr96HqvgKqaZF0xjxj8S9ZqvHCWkd1lpT-Tvs8NduCzPVLuRytmk4JdX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVuXqgGcGo1pGsB5SRWJm6wRM43PGjFCS5FPNdZxtVbA&oe=6AF0B05E"}, {"file_name
t-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lNVPZx9czTbqWO-vinQyy9kPBphZyaTDhDaxn1AX6-Q&oe=69E75ADE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0oXZdLpuWgQ7kNvwHBwOFc&_nc_oc=AdrBbzKF-Fshzj7oo24O7VBtDay2zfaHMHuTy0F0YZZ7u1Ygc492Kqc2nRFBJXvBl5Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HD4N2ZQooiKuKP5UWOfX0lYCm83iWEuizVyhiAAJ4eA&oe=69E79175"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBca7zClfXYQ7kNvwHiIoo6&_nc_oc=AdpJsnBDI8SPSY47AtMwJjABFrn89mCHCmG0Yc9fModLt1a9plvwYUP5eEDhbIHAt0k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gjo6Uo45qI5H5KvG81Ag_Y89FLXh6pwJpo7b7jc6VXg&oe=69E75BF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkzD-JB7-MQQ7kNvwF3Hu9B&_nc_oc=AdqAObvGSSVzYUqatgmf8uQmV5--1piiAGpew6_F7vDqq-bnlvnh0xgxqhEiRGjSrbo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JsW57ebd5uttijE0KalapRB-g90RzghX3zurG2qAXOA&oe=69E77CCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4urhjaf5of8Q7kNvwFLrLA_&_nc_oc=AdrVNPieGHdX5CH2VPsw0NUkVkyZfH2yvZtUXNAloJei_ApMfUhMq_Lv46mBUE9ABsg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XViQaMwbLwAWoc5WwsdWmex06A60qNN6R1H-d_cVpmQ&oe=69E7898A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFSdvKbptxIQ7kNvwEm4mVM&_nc_oc=AdoZPlEUjvh5jYfWVsLFtKOYi6NEIsBBGsrLKF4x6V9Ca-IFccA6QoBHeF15e8PQj4c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1M7Vpb_QZ29GMK-WpNREK_Ik5Q3SinA-gI9nHNqtx7cA&oe=69E7830B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unY6gFLzvXsQ7kNvwEwJoot&_nc_oc=AdppusU1ksZ3dmpTc7PmnGJraRGsoinIUhCg41L3MnzCukdo4PjYKSr_R8F0fZYBy44&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UA0kmKeeKfOuE39RI-Y0mUJHXf3FT9kKPtdPj_g1YQA&oe=69E77A9E"}, {"file_name
0_AfwWZLZ1r6tt52em01yPWqJga2ynj3iVKYB2FKgT7fpqNg&oe=69B3F05E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUa4VevUTwUQ7kNvwFHIJFL&_nc_oc=AdlqGE4lZpmqp_nzNGC-V165ahQG1EnAlStCG_G8dOouLIw6fpGnXTRW2N7dT7-4NEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyX4KKvXIGbpMXVN5LydM7FBYJdQ6xgJswgsIfnu9BBeA&oe=69B3EEB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OArS3sq_trkQ7kNvwG37g_Q&_nc_oc=Adme47P-q7YDrjNHJueF1ww2cYltdemM7ki96NOAjUaZIkLAf6zJBz-Vnpwg9B2m0Sc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyc-kCrNlvYWMgSWyiWsyQq9PuXjrVYuVEVRMWipFGtdg&oe=69B3F176"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqt4TznaKQsQ7kNvwFPQAHG&_nc_oc=Adn-QCLWkS7AqxjPH_BBXi5F1XG9V5WgClbh__NYTzF0tdbNhOTEYkv1AzrF4sc4uXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwESLo08wdWGR4nzk-i_qU4yCXgtBmHUo41mh8hihS_Mg&oe=69B4124F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LlfxQ4sS3sQ7kNvwFYn1AR&_nc_oc=AdnHOTw0FTJlN9OK2U6mejggIfPRiEoNm8TZbXnhXmYZFhmV7UmFBHKUO0Bs358bH-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyF2DYVnZUlDffryIP4w4c0cKDQ1xhI6fzEuKTDb-sdNw&oe=69B41F0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40ulAXML7BAQ7kNvwE0aRR_&_nc_oc=AdnFGvL3UW8yIg76N8gBkUECO3jOKvNZe9Tkf3MJd0oHJhDx0Xqdm1HgmiifwP_19wA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVn0U511qtsjdJMMxgx-0mvB_cPD-LHGJZC45LdDDMiw&oe=69B4188B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbn8wou1uJsQ7kNvwF2vRNR&_nc_oc=AdkEPLrua2qUDZ0jCm3BkNqaaoReIm7A1PgCV0pn7w3TKlkadDaKF0mYUzaMSeCBcFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxODX4eHvQG996jmlUixVMrnTRNHls7LXUIrpOV8JWZ3A&oe=69B4101E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
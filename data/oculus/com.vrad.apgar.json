t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D3c_NWqs8a9rduSB7RNXcyiCFkqxS2SKSXu1kF7qz3w&oe=6A185A9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wOpjWm2zzMQ7kNvwEup0md&_nc_oc=AdqxbWfodLGZKCUL_-BDh-JsY-LHeXXOmU1qjabo8SGS6LC9lIzMdpwwbDixRBxivto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AUEnF5JpfOYn9BN9x5n2UWVH6xwRmezWGeBlEKRP9lg&oe=6A1858F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvTRbXLyJlIQ7kNvwEXjsjZ&_nc_oc=Adok5BBRynjA5oheTw43_HNDrrRkWknU2crxjGMIcmCKIZ3EQAwIp5aVNOralKzglOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yNNdpYv9lR6VQhuzraxvGWCj4p7bi39BAwlrGrIYdtg&oe=6A185BB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9zpYfkdLDUQ7kNvwEy_qfG&_nc_oc=Adrgs1zDMmQX5uuVJ02gW1bcgx_gkv_VHrtJcJ0kjoOP6NA6ULBF-73AW1DoT2GjOhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jL7v_FTwlnCRxEqqJsphGVsUNkUIz-DJfkq3CAlNzgw&oe=6A18444F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CTio9TBPRcQ7kNvwG3cz6i&_nc_oc=Adrs-psS6hCSuEn9gsZVje3oBqRA-gvXAiK3ujDnkTK88bLb-t-6Z9fKO36WYHLhprQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6st2RmNrqk80c7SoBN1RFNFe7XjsHk5tnoSNA3Q0QcSA&oe=6A18510A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IHGxvE9m3wQ7kNvwF8JZX4&_nc_oc=AdqsKbpSSP834tucxJuwHcH1ZyV04hUuXSoa2ilQsR4FE9hm4JzaCgbFUDY6dzq5vb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7phWB8a02Rdz-Q9B93ExrwO6TSXUFGvcE219FbrnwiYg&oe=6A184A8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABD5s7jTW44Q7kNvwGk3yvW&_nc_oc=AdrG-Tcr80LS_fI0z5FYRP5rEnEC4VtPHL_2enxoUFMB4oBJFx1ryoDmy0JrOsuNhds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55b46oP_7m757uXrht1gB1L-PJorZ4UCFicwkN2jQp0A&oe=6A18421E"}, {"file_name
t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WGeobOJx5q5diidUrPHqm_Ma2Zg37uuUGypVI2G-mkw&oe=69F3709E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4T9bYUaqcoQ7kNvwGoXjlI&_nc_oc=AdqiwBKXvUfQunwG1JWEF_25IFuzcSVOCr3-ZYB7WklxdihSP7QCTJ46V8l-bQVcEXI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04_nYdLbC6luTIGKwe0L4h8FqcMHtDL56S8QeHU5SXzw&oe=69F36EF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgA7g14mtxYQ7kNvwEP7Log&_nc_oc=AdpJEBwa0tIJuhnq4B8PGb06merMuOFgA_Lf1q0rQYWMrgW4gWO-nZgg_NVpS8V57IE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oK7dGu6vIZTEXQEHykrzJ1yrR_kAsW1AQ9tJK8MQb7g&oe=69F371B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHphejYEHmQQ7kNvwFYNMlR&_nc_oc=AdpQBk7lBuvkQbEP06hAPdjIg63nkyz5ReKDLgXOJJG1OBKdR9jZ1PzwmKwc2SRPkOo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fbwF47ubIunpoA14trAlBNwaMHvdqq9vhYpUn_F0XZQ&oe=69F35A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSaW4MNC9R8Q7kNvwH28kdB&_nc_oc=AdolA-4PIAwD50zGAypZ8NPRzsbviWKZvSqLBeKdn8vsdre4D5l22M8SbXT4z4ijoFU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eT3V51XaErFC9FAOe8q69QBg-gURGJ0Of7wLzWPQnOQ&oe=69F3670A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PWriXtIHwEQ7kNvwEa62J5&_nc_oc=AdouONlsv22okGLOYc6HTnASgP6WqYWstCOrlZ7LCwLT0KErTfPxmXM2qkOqjUcLKlE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1x6fIAhMKgP_UJ_XGliF-Ete1ZfZ4i4uwO0ny_vD03Iw&oe=69F3608B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amSsWRM2UCUQ7kNvwEICgir&_nc_oc=Adq19SZ-lceaASsvlao5GZvZJbAvx9Kqtm-83N9cFq8v8vacq4qzYP0BjuQs_lcGZAk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ver0KKysXhwm5aN18y9CNwygV1aECcrd5Id6rghhZww&oe=69F3581E"}, {"file_name
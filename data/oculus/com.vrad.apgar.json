om/v/t64.5771-25/473396958_652591360577849_9079589504140055906_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMVpbmUoXLYQ7kNvwHJ2wRF&_nc_oc=AdorlCOyoaBsx2zMRW-DWUnNd2Zd1S3Vcof-h2JVez6gnH2ajpaEdVsiE68MNyKCUmw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXWeQ5Che615VRYZCxkNP3w6Dexm-ZmIaQAQWsSgUrqg&oe=6AFB1C9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQB12XCRUtIQ7kNvwEhg2XQ&_nc_oc=AdqvLG79qEXjgYCoy-OiB0CyN8W0yTqAjQ82EFso-8QjSvrHphG-RP4NLEAE09fe9hs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwiVYIjYAnV2VJt6pZ8wzwByTvXb3X2VNJxrxLsYBLIQ&oe=6AFB1AF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrX05O19MD0Q7kNvwEpCxQW&_nc_oc=AdrL2a2Z6Y6jx0BRfwCuk5JaWVT7ITYqM_XdneaVyNT2It6BvJ1GpZ4nWMYEI0H3Gxs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWhU5H2z3xLPm7pDmngFgHCVhlDSeHGXCcCLrP4nDebA&oe=6AFB1DB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKHQ5aXCPMYQ7kNvwH81tOA&_nc_oc=Ado-W8-zMcgFnAUDonHH4ucUeHXl7drbDod03n0yTo1kg8oet5jr-zhBzAgoCJNlV1g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTtTSiYBg5dHDNHBs1kVVza8t9JtbZ88Yqx6xrFeSgGQ&oe=6AFB3E8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvpRh9GgT7kQ7kNvwHQf-EG&_nc_oc=AdqX9UqzxxjfNWk5cxB3qP6iogs1lxJxk54FfC_zPAIENbJrdid_46snKob3mngrICk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxTtPO3UQo2CdAAskF2CuVu1ui4or7xpMFjW_5mCE4Gw&oe=6AFB4B4A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Hu4kd2mz4sQ7kNvwGl_jmO&_nc_oc=AdrDbcWZu_n6y_-cgIv6WtcEJw1HcvRssCbDkpZfr6sd6D0bD65o2hjDmee5z3vOV0I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsn_UQB1yaDhLktmVRkPs8OMjug-VKVbF82BWdOsJw4A&oe=6AFB44CB"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
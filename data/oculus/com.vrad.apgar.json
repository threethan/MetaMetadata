3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSJRheSs4hhpy828xakPCWj0C9fknmp1TOhVSiVEfjjw&oe=6A8EC95E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeWYTDtw1agQ7kNvwFtIo1-&_nc_oc=AdqkvQ2dDyBPGhU7N3-S6t3I1_TYwfOb8znUwyCH3KwwG6IR_WcfzqQ2KraiZ_z18P4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVO7PkdMSW73W16u6xhp53_26yQx8h2FE0l79ruqUvXA&oe=6A8EC7B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwm_1GWO0MYQ7kNvwFoW5Wf&_nc_oc=AdrtTgSY_LjBMtIlyKccCfsFm0bzH9NxesaBALGkFpiI4uZyIlg4KEZnRnUWR0CT5jQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUJdwCmXQnkp8bryh3ZP5zd75rRCn8gb_cgeVoiRPlRQ&oe=6A8ECA76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34yDAJt_wygQ7kNvwFOi8WK&_nc_oc=AdqXdg8AZhQXyncNbh5XudNupnCeCI9AffBczlvK-deTLzK5S4zMKg19j9xCCSqqTWM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZWmyCbRMrEMdRAMXLcaUAWXdrhiZHwTwdTOdViAOsdQ&oe=6A8EEB4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGZawYHygAEQ7kNvwEE1PBG&_nc_oc=AdrzDPrg7V4_G08qkhNKAENMVmXMuQpthDr-hOp2An7XoSnXZJtgN4hvAZGxdBgm7so&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4qobngGNxFHpgPP9WAfq6gv2o-0nt8fppJw9VRf381Q&oe=6A8EBFCA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6nkcZ2HGxIQ7kNvwGEuo7B&_nc_oc=AdqDdmxQTJ5PtLWWtiumhZT6ozhUNyEuAMAredAVTf8NwLgeGSJQOS4oDE6KxYDvGUk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpo4sSpCaJA0-8g1Q4QWhuvcUASdEK05qPq2JavL--sg&oe=6A8EF18B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5fOYy7VMwQQ7kNvwGdM-l9&_nc_oc=Adrl6Ct2tch1Q8hvsdpJu_b3iCip8h7uZDG9vtms5bhRKfgyXMsezNsVN7CKG3v-nUk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK0CogywzZBqciaeOWu7W1-1fNBnYWekvKoaPFsI3Tgw&oe=6A8
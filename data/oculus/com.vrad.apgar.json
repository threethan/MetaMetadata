0_AfxiGeccMfHusimEFModMmJtrf0jgfuZ93CAEA68yOXUWg&oe=69C11F5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfhOIkDVD7oQ7kNvwG1-ZQ4&_nc_oc=Adp9_G9RSSMJxyserQjbPdebq7ZWrVw-GBNsczbPpPHOuy2LlsGoYMTfEjZGc6xj0fY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtXHyP0nzIpdvP6CNeAgujdqwkRtIv41TplgLvw6r8BQ&oe=69C11DB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPjKvaF5spQQ7kNvwEWFXt9&_nc_oc=AdoGYX8lUI_UkWPHx9jWrrUxp6wPeUEDQHYd6XJpUIBEfvrsWNFyhDjkX-sRNyHVcCU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUWXXAn0YZwtT7pUfJzi07Xau2EJTs4OnMkw7axUtUVg&oe=69C12076"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nGdQytjPt0Q7kNvwH_0Um2&_nc_oc=Adqg_EDQeIwPz5MMEyHDicBvRP1uMBFNScOR0yWg7rUM0LdARfvz05mY0PTix8q31QQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwiVUNJkotDBbYuTzdVgfVOgXoNVpbBU5wHYZ8ZL_SplQ&oe=69C1414F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo6f1jLqHAEQ7kNvwEhJQD_&_nc_oc=AdqBqPpUJiiAPeXgcqlbTThI5PVBBF3pWYkxfLtzHrVoiv89OWjzcn1MhRK-8lQcOEs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwil6YpDKq2Pqm498iuIR4L01SJnvhFwLNPEtH3Tznbyg&oe=69C14E0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-i14Tm4TNwQ7kNvwExIsoP&_nc_oc=Adq4GO8zPAIKCAlv2Ec5XOS9PFNvkn7BaLD77_Y6u2ARu5X6vMQUVpENhEDDfSUf3AI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYvWKRifPxJCd9HVg_yOD42Fps7LrqZFWaoPji17RwoA&oe=69C1478B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozSqH7EnOkEQ7kNvwFYLIWG&_nc_oc=AdqrNautsjW_xc2_u7fQevcIjnBHiovspunMtu4edEH9W2GPe2jR5ec__TOGF3uQnww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxlR8Ympua5bImrtzxykjkDveQ-qmtoCFQpqtaTzAOB1A&oe=69C13F1E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
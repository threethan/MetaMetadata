t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIhrfyslPxjPsb9G-13e40iYsB-7Oofj3iScspRzsMNQ&oe=6A6CBA9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tukWlwJZYUgQ7kNvwF1vJ9T&_nc_oc=Adr2x9Bx-8XWcUDYsJABr1EQur27cxAC4pxuAgpVqwXVHMtRl_NmwNVtgLc8xAZOOKA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj7a10kEEkRY_899PH-YMMl1np07IggPXQxxXYKaileQ&oe=6A6CB8F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYnEcji7FkgQ7kNvwE3afd4&_nc_oc=Adre_hFXqYPH6agJcb5zENqStCMJA2OKqqhoVvlmLh9eFJjKhfZFUbQ0RRNhL16QwIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI9QxAHZlHxVnfTBXxnDLRg1g7Q555NdkmSn3M83oJfA&oe=6A6CBBB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maG28cz11g4Q7kNvwE-Z3TZ&_nc_oc=AdokYTgr52kttm70LX4x7IXKsS4AtQIMP48AVyeKwSEdnI88Ie0gr5lhJDvtn2w3fsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBINQWVgW807bD4qxrGRzd4E9k_id7TYoO7nY8kAsiDnw&oe=6A6CA44F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fQ0p-IMU9YQ7kNvwFsKXlG&_nc_oc=AdrTuMmzGFAFotQbRB_dbSuNVrU2JNtzzP1MbhcRLj1jP92CAYbgY_oaccKd2yVKSr0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWGg0Jvpbxhgh4_iVAFLztTNwhUYAeZ3QoHhE_vT-PIw&oe=6A6CB10A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHpHh_ZN-D8Q7kNvwEoGf6r&_nc_oc=AdqEsQcm2DslaV5j1Y1LPbj6In7gPNy5V3qnwCukeWXk25zzi1Zk29AFwejPysrSTW0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhV5iwep1mv8h6qq72x5l4cqzPQMqWYHeaad6jxFPWZw&oe=6A6CAA8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjYvXiYJouUQ7kNvwHMfPMm&_nc_oc=AdqJe5Xf8JEQWJZbL35YnLhFp-J2w1Ska0e59swoeCUd3clPHcAopogF7hUxmwqpLnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7uQYc-hiaHiSiZryl9wlQOEmu5XqkPM87UouShSefxw&oe=6A6CA21E"}, {"file_name
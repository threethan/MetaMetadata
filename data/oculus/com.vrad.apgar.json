t-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ccwz7E4HPghBeMVJq88ZA8wXNl4mtYsrlrMhZ6shjSg&oe=69ECA0DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMcx9dFwCakQ7kNvwGhHTFB&_nc_oc=AdpsBusyweXgpanmHdv4BVlbNwu6N9T3JZJ2dPbkR2IOupYOxLq3QN3HCTUliDhNEcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zS3qVXr9X1dWNpsHzPpPGR6cQ7zMdzFEHKRtvq61YGg&oe=69ECD775"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAwI_OMbjzcQ7kNvwHCbnn_&_nc_oc=AdojyqljNiyYTMB4tNxfw5qe2E35a9YyB9uE0pllVGWjSL5tazKPhcL4D9xLpDob_4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29_sjxam8nQXLY8MvOPRiLGPWrFz52Kh2bEFjz1F98EQ&oe=69ECA1F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OWWaOQf8MQQ7kNvwFqGQYm&_nc_oc=AdoAZMFfd00bVjVVJ7fbHcymqlNPG_8mjqpXxMs75SHaD8Uh0tBkFZLZBNdSSyxApEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UCCUF0Bm8RdyOGZhP5xDoTbL81RoJDn76oOrrsiQBuA&oe=69ECC2CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3StVqCiUqLsQ7kNvwGUEcZR&_nc_oc=Adq8DYqGXo7pn5nsOVoVJlC4H1mg07I2rTQvLeLEyGJ4ThTRGmpqpamE4kITuLJHvaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r-6mcD-ZyXa6WaNaGugqffCP2tVPCe9viR6NyrJx1Ow&oe=69ECCF8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfKX8KP6recQ7kNvwE9fNA2&_nc_oc=AdplQczYP4Iastc_J5cuw23F7Dqz7SyVjucslTh8nya1o8ztrs6EDgE277ljd5GVUj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V7d462k0mjX7Z7YaYfeg5itPnNte82ybVCj7i3-kf-Q&oe=69ECC90B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YryfWQyPr8MQ7kNvwFLkJ6i&_nc_oc=AdrMRo7wSx2nc1Lr0WK5d-vSJ84XdyjGGOMbrpl4Mstj0-F1QRrh0OTyg0YrilbHn-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05qWo-wPYSN1llzVMNnlk1njSRCR8Ur-3bnnHjCYfJiQ&oe=69ECC09E"}, {"file_name
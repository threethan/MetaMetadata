t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3U_SNmVb43RBdRImHkeBDCToFe9T21YDXOPAx-asw-0Q&oe=69DF71DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nES7lKOs4bYQ7kNvwGRg18H&_nc_oc=AdqRCR5koo23GQBOKAj1D1VXkPXK1NSsyJSfJ8gESVntmPcEAGvezdXB3N6VcxOVERY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PtJAhF_YUwed0CsYuhQzSCBu5HXL5qqhNGzFAQCk4qg&oe=69DF7035"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWMJFzzufIMQ7kNvwFkdxLi&_nc_oc=Adra2qGRulZa8Fhj-Z3xfg0IKx5q7C6pdL_zCc4dsFpNgKIeao3LpxbEAgcsyd_qeks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37wYRQXAlZMxE-EvYDn-PGpe1mI8AFL_C1eWtXnjQb5g&oe=69DF72F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpXOo8j9BQIQ7kNvwFMVeA6&_nc_oc=Adr9y6HI6A_3zd4-miV3SEoccUUFpwJ412UixuVbL-wslzv918OiPJA75vCmEeIFOFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kahGy-tPBYuc_Ik9u6F3q9-7nCnBesaGRrzq89aSW1g&oe=69DF93CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FakM3lwHde0Q7kNvwFEPnJ_&_nc_oc=AdpOQ3d1YzjhteOj_hKf3u-SilIOBdFVkpLX_yKPkQoSflyQ-4tHQcQyfT28pHR_Jrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Qxhsytz1FpuLyNe97iOb77V2NRjTpcM7coRh56OJPlw&oe=69DFA08A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTS27I7rKi8Q7kNvwGKay3A&_nc_oc=AdrGWFWzpC55X7P_83cPuzvt-oL5Z5XPa3irdVTza9Z99s1xnMUEuwrP75qNxVzhAis&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BLjOh2oElHgIKEd6fhBP-E_eavDFItSmAOOebDKAwVg&oe=69DF9A0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qoc7Xx_owNIQ7kNvwGwwcXX&_nc_oc=AdpbOYPkCNjpkaA-9XW0-YI-HNqxFrFQiRogb3KbIhENN4UB1ss5wXoC2iCtWIeXRGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R00EFPvRO5fVDGdL7NhP2MIfuIuJaNxt4IyCGlrA1lQ&oe=69DF919E"}, {"file_name
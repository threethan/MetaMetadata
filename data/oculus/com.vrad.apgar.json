t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlsCyFlhPvtsIevtMb5cepH8YoCupXFEJMCFdJ7LYbVA&oe=6AF3339E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW6orDM9J6kQ7kNvwH95tY_&_nc_oc=AdqVbTxaiaAP8PODcUrkPr5T7Th8ajh3ktcPxT35cTT73OduXvjQINNs8haLfySTk8M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUYTDqOciVUdUXgKyPOQGaU4y-nK-etuKPM2UYB_r6RA&oe=6AF331F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3T0Z8gDgpoQ7kNvwG4UIPd&_nc_oc=Adod825WnNA92kYeUp2nSnq4R7-Tez_X4erzQ9ujzZwAuFNTM1PRCFQSyJIt0W5xsMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfeDJHqs5BJklArHNc46ubSk23rUaFLO0sAUhhtlDqoA&oe=6AF334B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QSDLKtaj0kQ7kNvwEXgUj0&_nc_oc=AdpbEJm6mcbCXpgZjDDmNpoJcUje_6MN7JSePEAPSYvFCgoLZGnO56yOD4wW9PR0wr8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjLzluPycMxzAV4L4n6rT5wgV73EavswnNLu-RCPFv6A&oe=6AF3558F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbnw8xyXP2gQ7kNvwF4tLXE&_nc_oc=AdrZXcJa5mMHN7GyrDH1JXLCCRZ-Re2Jh5fgoCeHE3LY4gQgk-ePbr84cqV-zozFydo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTITO8458fRoan9YLPCEtzxudQXknp0ywZU0pc-nKyZGg&oe=6AF32A0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kFdtDCIZkQQ7kNvwEGoSoP&_nc_oc=AdrnyvTmryi4mzLFPPzG7lmSFqbzIIvkG-QEFOX2BFte6q9lDwmhmuKvTDm6GLzxnPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBBWLF1fAmPLYjMPcKFEk19PfbqSc1bChmaWiX4-2J9A&oe=6AF3238B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArIQbQ4w0p8Q7kNvwHIdJqb&_nc_oc=Adr2Ugh8ay4BVKDwj0CPsZBzRZkkK-KLY620rZicT_48u5_4Ddmh6OEFVtZY-zcNNyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHMsFnBrMpmneTNZDlpyt-9TfWAPva5oWhz9y7EpKF6Q&oe=6AF3535E"}, {"file_name
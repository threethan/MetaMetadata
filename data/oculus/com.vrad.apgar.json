om/v/t64.5771-25/473396958_652591360577849_9079589504140055906_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA23W-orLXYQ7kNvwG1D_ay&_nc_oc=AdrFIAtcVWB4kb6_vbNSEd7sENh-qcycN79z2ninJKZ78lsjHZew_C1idOyqKOoy14o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZf4raN7F9WUk55nGaGVuyVp9-Riy0G3a948gbh2K7pw&oe=6B0F1B5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzzULUQwh44Q7kNvwH4s4XQ&_nc_oc=Ado1fz6E1Ep21NofeWsTduws4Fx9Oa7qr62c9HJ3mbqiHz9ZxPccjpxD3mDuQh0FvCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLcLd6E6th9-_G0nrFHz2hkYkqWmO6lAslT6k_LIYD7g&oe=6B0F19B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-AM8PculuAQ7kNvwEeqjyh&_nc_oc=AdrCeI5CGK_Hrx9zUE8NL2gnqus3-uxm_lPs9C4sfqTC-LII3svArD7QJ1Ugd0Ujreg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCg4eB0igfv6lTuS_o7k0PmnEaZFPBpLSGn5LWQA_OQQ&oe=6B0F1C76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mbic7FLjc0Q7kNvwGsH_Yw&_nc_oc=Adq9bdYyN_XiWeXlNeb-8lWpCsi8PR-up5uvYBi0gEfPCNCwuypPzzwpvuynuw6BIuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4mjaryWf8SD-U1Z1SDoj-0Mu03F4cbOuwfmERXBjcoQ&oe=6B0F050F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StWt3m5ek0IQ7kNvwHT5ctj&_nc_oc=AdqyVySUQebIzW6ZNO6JV080pZ6ywP7jU7xhap7EKOnseJELtT1klITrabxP6YWd_i4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0kbotPydT5uI0Iu1YRB8TJmbNtbYTcn_MrMV_lt2MYQ&oe=6B0F11CA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5ExeHVJVmAQ7kNvwEfw1yc&_nc_oc=Adr9RnWP_SFBJ7b9DJoWTqNA_QOzzk61g2mz6D_fEFYu37-A0STeA6TbVo3Le4cwEZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdchYO5Ta5eWeN8yXWws0PcuOyQtn3uP5mTv5ilm2Jqw&oe=6B0F0B4B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
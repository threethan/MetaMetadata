t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AL669104quhK5BucxOufmNY1EGjR51oKeiYoBUETXXA&oe=6A2ACF9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyJ6l-fnmkwQ7kNvwH5_Eza&_nc_oc=AdqCW8NTfQsCiD35-95HmSljQ4O7MmJgmfypyBGLuePVqxKuIAik81y3ddHUE7Dr1zw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MgA3zHi01tibnaaHs9wrzrC4KbC3s5GY5ncUmqGvtnA&oe=6A2ACDF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1c7E3YJxygQ7kNvwH3gt5E&_nc_oc=Adri3-s_aXhKUM9YBoLPlISrUlmJiyarU36PLlVvg4Gou9B8DwhcJcMB1o82zetgZ3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rDQSSdJpHPhXc4D40Qu63dhBqCtbWeb_0Y9h1HhmSTQ&oe=6A2AD0B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjFQsQRPsj4Q7kNvwHuBSNQ&_nc_oc=AdpO2C9ielFmIUGhXVL89dNBWnJaGW4i26n_KFzzTSbIlPMfj3tlYBm3CO3YiXJ1Uew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VJaK9N_-gmHf9uIikoke4UNdKq-ElJJtlmrWFps-rEA&oe=6A2AB94F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSztT10B54YQ7kNvwG68hH4&_nc_oc=AdpqAEss461uQo6__OGURre8Sw6uvhX9TbwCh6d2ZSBEJTKaQGegGr6bdm8oeEflO_k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iVUz9wuzv61rkIrqL7lF91VEET3FXvpkWqv_3WN2rWA&oe=6A2AC60A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKYObTLK2BYQ7kNvwE3VcbS&_nc_oc=AdqbL86QCuFOqA_ofQ2-5XJNlGdGBJiHKBLjwU6iEID4DYMwg2lyjp6Q8qTEQCgKRTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IWiDTr4tbvV_zGisqq8TKTv-GymTeAdWAuYNxmTYQtA&oe=6A2ABF8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6oqNXorru8Q7kNvwGgfnIF&_nc_oc=AdrPLP2hBSXeKxHKpYca8MNVIf4o7QKytJr6wuJoHYCsvSNXmJbPpSS8WllYJQPjUOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_glLl-iPMLWlIMKgSuS6FTA5AvLoV78msI1xOqBI6e9g&oe=6A2AB71E"}, {"file_name
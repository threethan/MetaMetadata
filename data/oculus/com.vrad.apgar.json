om/v/t64.5771-25/473396958_652591360577849_9079589504140055906_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6LClu0mTn8Q7kNvwFD2Rle&_nc_oc=AdqEISJAGdrA5TZ7uSOH36kAhky6Vo2-Q_PrGx8ZPjWL_z86tew51864Z3XuzSyavUo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpAdLbdJFxIa_9ASiSbHHvA2flwN0pAaAHs5Nxz3gTwg&oe=6B099D1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q5B01p3ZTMQ7kNvwHSMgjt&_nc_oc=AdrSHBTpWI9q5_xPi8TL9M5SF4D1-YEqPfliuDxZFjY6l2iUh9frLu5vSOeeE6Ayxk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-hphD-bM_3qaW3rRbQPXBxGv78Yvo4_omOJFQIPx9fA&oe=6B099B75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLchZIur9dkQ7kNvwFNYrQ0&_nc_oc=AdozIPuXr6tjRrmIFueXey-mSpkD9ZeSCepHI3OajHrFkFh5TJ55yyvny7LKrH9VM1Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyWLDpT-ILnfpxpJTSIqUgB2adjJ0JarVnPOVwd_k5qw&oe=6B099E36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfsqdATy8sIQ7kNvwEJDTx1&_nc_oc=AdqDe3vdjnvP_poNmd4ChdXVNOFwDqVyAcJsEXe7JsaoDpV4cmwgtEKzMmfuNsbGnKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDCT7oigNujwGDd9ZgA-k3BG-pJdfR8_WrL5ftNM_nLQ&oe=6B09BF0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diUQHhy1ZtMQ7kNvwHkpYrz&_nc_oc=Ado6HRMIrWSPudVldJECak0KN_i2ZmKJzSKQ0PRw2m58vncllbRujs2tkHm5FDInBxM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS256kkx7rBGS6PhTQbsY2yM1bJiHl3n-fxJPPgPAw-NA&oe=6B09CBCA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSCcmQ7Xka4Q7kNvwGg2WVl&_nc_oc=AdqOOsE3lrswJ-WerGaYGcfqJZzwft391KtmMh5pPMKiJAQkUfE34WaO_9dIbiiGe70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnA1F1K0d66li4fs8I0H8MRyl7fepRZEQmfTMS__zZhg&oe=6B09C54B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
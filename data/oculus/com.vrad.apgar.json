om/v/t64.5771-25/473396958_652591360577849_9079589504140055906_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7QHzrVB1GoQ7kNvwHeHZW0&_nc_oc=AdodCNjlNM98J6M_LApa8i0WLQHurZXz9etr5hV2FonwS5dAmY0DTKTpttNxgTbBOS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu0Zpd-X_HDdl27Eb2Nm39atwzoxLqbiFOU84_nchEdw&oe=6B06FA1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHeBK9q-E7IQ7kNvwEE5MNe&_nc_oc=Ado2vqlUddv1lo1SUx3T8Sa1gXSkAVX0XB_EvUSBS6uwbzjr4OGI3063ozLWbfGZCJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1S8MpK7WI_zjKmNtx9es52KPJuPtn3FJnSs59gMetDw&oe=6B06F875"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLchZIur9dkQ7kNvwFOkQjf&_nc_oc=AdqDV_jmQIATFFSNwJXHsfLHDldEXOgo_lU_1KyKtjb3q7KpiSVC-qj7dE-hrB4mw34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4diRN2j0FbM1Ju04aRJRKey6lAmhyTFI3lwkYvjrmQQ&oe=6B06FB36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5duAaIHuKYQ7kNvwHGvvnU&_nc_oc=AdrW9Ty1KItiJu3vmAKGhfknbOvHGUuVqP5hiI1TXJ0LXPjWYx35emp8P_CQJMknO4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8kj1TLuVK4EoawAd94pVLwaCHgdYpDHLvqbj0buOIzg&oe=6B071C0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRzuPmkxwYEQ7kNvwHeSo-Y&_nc_oc=AdpM2rx00ONmwnxCjpTIFPuuXzW6ofFzvLKzM53ENrBmzKCiZeEr-pT6EzUmtHPCWyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiUZfrcJ3bY8u88nZGAF5X7JOYZdHSEb8X8_r0_SyERA&oe=6B0728CA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m14dSzE6QGgQ7kNvwGE-pvU&_nc_oc=Adq2m-VItK1jDXlG-sRINHQO_syxYmCfPutWPRA21R1QHFcfEk2umbNYhfCdxCzM1qU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS4ahV5QVuna2Pvvw1QloUsF_28HyDPrN4l11wjdJd5A&oe=6B07224B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
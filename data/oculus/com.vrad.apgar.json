18, \ud638\ud761 \ub178\ub825, \uadfc\uae34\uc7a5\ub3c4, \ubc18\uc0ac\ubc18\uc751, \ud53c\ubd80\uc0c9)\uc744 \uc2e4\uc2b5\ud558\uba70 \uc808\ucc28\ub97c \uc775\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\nNS-APGAR\ub294 \ud55c\uad6d\uac04\ud638\uad50\uc721\ud3c9\uac00\uc6d0\uc758 \uae30\uc900\uc744 \ubc18\uc601\ud558\uc5ec \uc2e0\uc0dd\uc544\uc758 \ucd08\uae30 \uac74\uac15 \ud3c9\uac00 \uacfc\uc815\uc744 \uccb4\uacc4\uc801\uc73c\ub85c \ud559\uc2b5\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc73c\uba70,\n\uc2e4\uc81c \uc784\uc0c1\uc5d0\uc11c \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 \uc815\ud655\ud558\uace0 \ud45c\uc900\ud654\ub41c \uc808\ucc28\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "NS-APGAR\ub294 \uc2e0\uc0dd\uc544\uc758 APGAR \uc810\uc218 \uce21\uc815 \uc808\ucc28\ub97c \uac00\uc0c1\ud604\uc2e4 \ud658\uacbd\uc5d0\uc11c \uccb4\uacc4\uc801\uc73c\ub85c \ud559\uc2b5\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub41c VR \uc2dc\ubbac\ub808\uc774\ud130\uc785\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrad.one/bbs/board.php?bo_table=Resources&wr_id=12", "developer_terms_of_service_url": "https://vrad.one/bbs/board.php?bo_table=Resources&wr_id=11", "publisher_name": "VRAD", "support_website_url": null, "website_url": "https://vrad.one/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_in
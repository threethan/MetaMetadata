t-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcwn6ZPabzQQKjXZvYMBY46NKff3FkuF7dp8rqdc4r1w&oe=6A940F5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZPArxL-n4EQ7kNvwF5MnfX&_nc_oc=Adp5iZIlhqWitFAx6QttxbDevlkj5JyexWWkH4PCi0wjpBlS_Hjgp4Gsz-RS5nQW9ek&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiZCRqBg9pz5zWms7pO4MRWlClzMO4BklI8J-UBh9E4g&oe=6A940DB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES40Qam7kjMQ7kNvwFHGXJc&_nc_oc=AdqrrZp55ezH2F0603Jzv1pDQonIdaCTYWQ05E2MSF40MCTj9Ovi2jhW2iq5gWU8e_k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbkdUb-yQMIgdBYdcFQFHaJ61yFvIFqlCJlOAv9sNMIw&oe=6A941076"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVYoMQyvHPUQ7kNvwFJZ6eE&_nc_oc=AdrAj9747ZEzolpSNctbS51-8OQYbxAFCB23-mqIj6qPVrdoj81o6eC3VZB1r4_snFM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMFDTxXY3OIH4LKybHMcB4UbWFpupERerPBOZ67RJnUA&oe=6A94314F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIRzwN_3uPsQ7kNvwHO2K7I&_nc_oc=Adq-A93KiLvZKMLoGOUhNCz39YZFCSsQiOZ8gS695iQ_a4SmNAZU1xr1mD7Bjk0mNoY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6gneC3rsaCMOz25BFeq8SSAMZJ-oiaKadyRywT2VZoQ&oe=6A9405CA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmGert_yGXQQ7kNvwEB5rv3&_nc_oc=AdroPLi_7d41ZUwVmKQCF_UHEy_ML6QFRyGuhAdME2hzr6ocsGAjZy6A6J1OiQDDJhI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbdILucj-pUgvhOw4P7xiG86v9zIaTzwSBJNRNF9NYSA&oe=6A93FF4B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFBBVnQt6koQ7kNvwHFdgoH&_nc_oc=AdovGaE3wR5BznOXUm0rEaGj7_osTJWYYHF2zIBy8k5G9IVYQj3kASb_DCub97E2aiw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa1KOwPFehAMgTr08QhlKKAKRQehpJ8nz85UAtFpquCg&oe=6A942F1E"}, {"file_name
t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU7vd0w3cyN99RcK1bh8BI0oEzsuUM8P2aUh_F5wsLxA&oe=6A54FF9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23448pOe7YUQ7kNvwHr9lUX&_nc_oc=AdrQ8S8Pi_rmpXIYcOKb5C_S3eB5TLfgl_FZSoLdcmePe1gkB-Cu0VAJIVULmPbPXg4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmMHK3aZ5Gi9fK4Omb-aykL903CfCeaYtHRoEILc47vQ&oe=6A54FDF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFHq7LDN0YIQ7kNvwGtLQZH&_nc_oc=AdqN6GN3nQgiILnEX1GIeanxUt6o_nVI6n0TBdSP5qLbhEUzLo1B9epOxvztZ2V8hA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLqVHQiBCh_n6g-YPEONJ-OmBJTx9xahWliV8Lm2KYpw&oe=6A5500B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp3yfPpEFq0Q7kNvwH39AhG&_nc_oc=AdqOtTZRGc3nLyNum9fDM78mAN96n9-oKT5BSEYCc6rZaCTbBajfp3tox9MHleJSjFI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsho1RJSjgFUO_ID2GaG4wfSBzKbWnf30C7tiBuHOv8A&oe=6A54E94F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMItPqj1qGQQ7kNvwEXEzaV&_nc_oc=Adq06F6sofvs9097onBbR9-ZA8zjF7NxumvTvE0hNkLf-NwxU8dbMhvYp5Me149pOcU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhZo0L7gRXQPKrGZt-cHC9I9HgKXzJsllf7XhyGkrjBQ&oe=6A54F60A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCMi6X3-SBYQ7kNvwEYl52Z&_nc_oc=AdqoRXe2dYGxh7o24nHnIB4pJe8Te5P0DbCacPIEtmuf0qXBYU4OA394BlhoeYbYiUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH4b3tdDGhbZQ9GdWFUNtvpcMKTeukzQ3dpCwyR4hbrA&oe=6A54EF8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1X3yiASl8cQ7kNvwG9W3pL&_nc_oc=Ado5UtIQ06Mi8wxfPeucD-zepEFj29ZECPDxByd_P-auecEN-gxX8OZQfhu-K_JcD4Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7ST6EXLq2huU_-O1WahCfVwgLPJ-x4mbUbFMta7Mm_A&oe=6A54E71E"}, {"file_name
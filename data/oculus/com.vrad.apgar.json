t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98uQUg-okBtPF85EURWAX8Kd6D9QUndhuPKjrwZd6H6A&oe=6A2C211E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyJ6l-fnmkwQ7kNvwEp9q-T&_nc_oc=AdrKlBh4zESa33Fj19zdlThC-k-xFeW5unmCDyf3Jg8xmK8HcXR8yFJfZMKd2a4Sq1E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sw0Xt4xZJZTsMlfTptef3tL-QgdufvxJMRbbLZ_Ymfg&oe=6A2C1F75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1c7E3YJxygQ7kNvwF-AckE&_nc_oc=AdquXkjQBmgXkujKub2OOcsoLTtkNfx0tExBF1cmp1jA3OiQnu3JjlWyvTkIagpWVMo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kaZ7qXYTAhDchLcwpw6yS1azlgsa4XhL7qSQUHmbTog&oe=6A2C2236"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjFQsQRPsj4Q7kNvwGl91Hp&_nc_oc=Adr6lQ0b0Dx4AMD1HgCN51Y0B7XNP6P_yAcCsJVUpnmWWLL17z-TrkR0G-Cy0hQeH3E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gp63MehmqzAjc4EYSrrOReiwteNgYVXJw-2Qg6kdtTg&oe=6A2C0ACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aFi6Ubvb2IQ7kNvwFiwVsA&_nc_oc=Adpv4HcHDOf2aPyACF9N1w4ROQ1eqypzp5bw-a9WA_ESiUp8MLlT0fbTZdpjbPI8xgM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AIQdBc5QFXmJamswBKN63fPhMC4jKKBxQMoHAeUf5Yg&oe=6A2C178A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XjcK7UdUswQ7kNvwHDVaZX&_nc_oc=AdrHqRlwfXBJqzl5yIQciue2Qy8_iCUtBQ99joUh5F1rhAssIFtEDitAvWjR7k9iXzI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l7jgvLDmgExe4noj9Fkf8Mt8u4iqZzPOeGRWi-6JQiw&oe=6A2C110B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nryrrXjRaUQQ7kNvwFdr1BX&_nc_oc=AdoYPCNHmzztzek5wbyjPptdCfU-BYSRl0IJv-8WFAltsKvk2o8gVEZwZETFbPaJFNQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D4JxmMc1Bek3q_94Y1JEzqzoeM5RS8X9znk9dU5arqw&oe=6A2C089E"}, {"file_name
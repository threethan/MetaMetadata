om/v/t64.5771-25/473396958_652591360577849_9079589504140055906_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6LClu0mTn8Q7kNvwFqC5_2&_nc_oc=AdrIyAM2DqWliMpmpuc3DjJ5kLjvQe5DwEDos1NuEQk7y-fRnKP3ghx6-ksmlG1X7YI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9ev9ZmGUIb6UvsBvAL9QWlmecMd_EmMlNuZBXnaIUNQ&oe=6B084B9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHeBK9q-E7IQ7kNvwETTVT9&_nc_oc=AdrQ_PPc1AHGcEL_X5x0HU_v8DSav8scpsnJq-oSwrSGQUx8ThhbIPZf8Fu7hqMe7zI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9j3BnRqOztjUk2oIUORCVJ2IwoYgSqg-CN3s9runKJw&oe=6B0849F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLchZIur9dkQ7kNvwFPtUqU&_nc_oc=AdqvAKxoAWTLNeBym5Y0XizNcb0MJc0VN1cH8SkOF67X6IRmWX6zKDKyI_csqlwTWu8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWmcSTEL4jXIcITc-4Nw_qBvBF8T6b431cmWyoZYZJnQ&oe=6B084CB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfsqdATy8sIQ7kNvwGdtKRo&_nc_oc=AdrnXcfaS1DG5LQAzkA-IEpEAwdudHtPMBPXZsGYdiHHS-TxDOKYsgE0xML3Qjg17B8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLlOt2pjB56oZnO4G-xoPlWt4cqCNCvn6TQNY74upwIw&oe=6B086D8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRzuPmkxwYEQ7kNvwFKcN4A&_nc_oc=AdrFPTg9bGTcc9U8Zx3hu4u3xYcVSsk-VZhCnapWAZTCvHjxruEk6ceIjcdx4VJ3HMY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3e1gmB9-rIdGgHyWy9o_YzpHTFnSURIT6zhlo3agOOw&oe=6B08420A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m14dSzE6QGgQ7kNvwHozqXG&_nc_oc=AdoV_XSSygXdApr_vUUwqwqJTPbjhsRZuwOMZS8a5HzObd_cQMq4tlodtyd5sGbnV74&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb7m0QxxRRebX5v0R-Q3jdeyk-Gn5UwagQxo_1qzkZsg&oe=6B0873CB"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
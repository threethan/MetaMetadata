t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZot_8agWdtklw4D-sOvP_2xPnWSCUUKm2DMp79fgg7Q&oe=6A86E05E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzVWTgAPbUQQ7kNvwEc-Bsn&_nc_oc=AdrvRZBU63VuACTAC4sjf__8TSGbPpNa4se_FzkDLyaAtVWvP1ilESsRV7ACTzAcKgc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPm7-OOZVY-pyjZb3C1DfDhoxQJlCNC5HoTalEBVX2fg&oe=6A86DEB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu8oiY-e4RsQ7kNvwFjnf7Z&_nc_oc=Adq2XZfgvyTheSFGxA2wJiwqkZhGNDZa_XTO5NNvRnBmfDnUtX7uanX9RWJn-xG80js&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFYqjurmpY_DWhdxD4ckPrutrkeh7_JcshBbj8J4DWYw&oe=6A86E176"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIEZo6QVOWgQ7kNvwGtC47V&_nc_oc=AdrFyZP0Bz82-TlmOjRQrISpu1cDA73Zj_RQlshl5wFc_UEPFRzq1FBgUQgK2XQmyz0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfr2_1cp9-d06zA53ad_d0o0Y0sJWhNntjQ_1I8wj7eA&oe=6A87024F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aGmHhCotgsQ7kNvwGY3Al6&_nc_oc=AdoXDXHbWjv0j9f6wPkZuF1e4ZQNKDvCEgYmuPKym2PsKAv79OeVgwvS9Udl_yeqPgE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMx1D_oD_hnowdvHN66X-n8capbSA1qZkp9x_qdoVwkg&oe=6A86D6CA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBv7kS-fm2wQ7kNvwHwUC6w&_nc_oc=Ado_nV2sHCaSx-pd82xrl0UqsC4DhNT83JpqC67BXQLUcfGZSKI8AYd02rmP_b4wvwI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0v4TTMofIycIPKMqrjrLH1oNk9D7NQB1PzpyoHtQ4lw&oe=6A86D04B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rtyQnEuIOUQ7kNvwG2_woh&_nc_oc=Adrp9iR2-k7QTj_d57ZvzMQqEjrnlpmPZAsWJKzVchIBSfGj2m3fMZMET-fbXPPYub4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh_mvm-PPUtfSuqo_mfcD9LGrFcOpM_SExWw6qq1MsUA&oe=6A87001E"}, {"file_name
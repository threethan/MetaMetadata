t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J1LiR4Fqu-s4ZK1JeKpD6GUMdRfKcqnrerJWNj-IqCg&oe=6A3E961E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EziAXkePx4Q7kNvwFTK_J9&_nc_oc=Adqo4tXQDvEZicJXBuU83xSvL0-WxZXqNbPMbDtcpJLh3Wu47J2zR5yIH63R_y6F3ew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kM3KqZGZ4EC1_UemjFItyqwXif5dRfKBO3gir8LEkvA&oe=6A3E9475"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCgJq4Rn5BQQ7kNvwEE4Lly&_nc_oc=AdrM6PUBLjuLH43ImJ86Ke18VLYevnCubpKQ6Q3rviSsMsLvLPhtusfVf38ZrIDLpj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ITJWzsyn9SCk0uwR-BC5HLH54ZRSNdJSN4Tpyzud9og&oe=6A3E9736"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tv6WrEcWTp4Q7kNvwHugF3F&_nc_oc=Ado7LeKTezs6MicDCAqQvwStD-dYD5QqwHAjugzijL8Y0WwNmiz4DfcZj4yaBx7ey8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-prShbxjESmgP-XNS-REIjyzuwPUWd7cUFdfnIJ4_peg&oe=6A3E7FCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7aLeql2qj8Q7kNvwGnZwc3&_nc_oc=Adr9K_Mecnn5hlUmf-XsocsETGLE22YV0sMxEceJt7w3tYSCP2E4YyLXMwxaRuw6JIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gsb4CNAV2VzVnbN_EXTpOs0zyHfUGIzOlW2lpb0swPA&oe=6A3E8C8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xYC4O8jxR0Q7kNvwF4bp3K&_nc_oc=AdpDuR24yK2k3xpjA82fTjSuokfXTs3wJSNAKFjbz3CBL8GV4QlNOCPRCnJEa-O2Sng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87vve_X72OCI_S6qxq2-e2txbPhn6b7cBBFBuZqejTZg&oe=6A3E860B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkhuiIPjWbgQ7kNvwF3Ijuv&_nc_oc=AdpaR5WnRXks6OMvQrPNgRH-8wCh-7VVYFsyyl76WP8AQ9dW4mZcC47eiXPRm70F3MM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qwj2NDuaPRfZ5IRcJ3kR_E_VDI4olqnWqYX7PpZ95Kw&oe=6A3E7D9E"}, {"file_name
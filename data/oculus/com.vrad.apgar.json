t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_eNw-gNn3KJFwrW1iCmh9QfAVQ7gQNhiiArr3zoopiA&oe=6A19AC1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3hkh2mXaQkQ7kNvwFIXNgY&_nc_oc=AdqMEPlDSL9-_NQ8LvU7rS_xkc2Zt4yu6t_sgpQyk3-4IsU5MDxM1hEGSaax8OkLJxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L5vrGDu9kTqpsFEQCeXIHgtuYFoPzZc3fIuRVlPKfng&oe=6A19AA75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSq5OCXAkWQQ7kNvwFiY_-E&_nc_oc=Adrw2cgVF0EROhCob2KKGw_74O0C0uoBMtSpQp-B3mdhTbeV8AQ2ZNtvzLYkSDTkzHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pBPcc-jGwRFC8rqwGr3Tx--hrde47yMc0Zxn1qKc0IQ&oe=6A19AD36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9zpYfkdLDUQ7kNvwGlkLSf&_nc_oc=AdpcLt2luLOzdMsgABdBw8m-k5yLMeXTVtf7Y9lfEvHBNNv9DE-_3_jzmKM6SAOvDPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uh1nHAkoqtN4n7x_yjXQOPpeJR-4SLVICbNHQ_TwA_g&oe=6A1995CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CTio9TBPRcQ7kNvwHSd8YY&_nc_oc=AdoNk-iWKUY9AHP1y9rCNwfmwxfONnOvRahSTFfle8gMnaBj2ztD2yQwbJ2yKWO-p9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NwRYZEfATb96iktdMgfCoRTjElLZZOAavES8DTwGmig&oe=6A19A28A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IHGxvE9m3wQ7kNvwHxW6pW&_nc_oc=Ado8hlU9yNVA0-DAXd4z_-p9-njpeQlWpqisfDsnxTAsiLnJeC0Pmc9WWKqmTMzVuCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x-YNXFZ3ET9fD-FJ14Tqsjw9FKOMiRpMGpvG9d35xrg&oe=6A199C0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABD5s7jTW44Q7kNvwEhDSeH&_nc_oc=AdpWL-eGVB8wU70ziq982yPQKhSSc96AjgS5bIRpCMr2cVCDaU06PwuoPNxozo26jRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L5nxilLb36fKMezgdOmzbicFIp30LNkm-SrLhdIMqEA&oe=6A19939E"}, {"file_name
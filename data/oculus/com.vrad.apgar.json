t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEZKnyLDP2ei2i0GTm1LrR_k7ueLCwtBFl7AC72eEDDA&oe=6A82EBDE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8THJMDTU0VIQ7kNvwGuDKH4&_nc_oc=Adp1pw8fsl2YXEwzz8uIozSvGpMJJxgcQO8M-3f9ibP2xOJO6OPXoD0SIo__gC9UK50&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnvROzIEKBuxES9WybH8o5WqALiL9b99gnnbfzbCRHkQ&oe=6A82EA35"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1fuefCRLQUQ7kNvwG-KD-E&_nc_oc=Adoyx9O9TN3ml399boKjAsT4xpr2KoLiNdtERvY2Hb9c1VAkzXL5mbI11U6DoR8hqO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtNxaNTE2LeB7KI1Hq15IDIiBRSHoEDj8d5cmNXM_-nA&oe=6A82ECF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iykANgvXH64Q7kNvwE_y8k6&_nc_oc=AdqOo0rDdaC5sFQuw3y1A8ioWbGp7dy4OXVHTXExsu5YrgBZCkaDBTU5d5AMo7JSHR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQFosKMtsjjPY0rflCPjWIIW3J7ItH-RL1foCTlV0vvw&oe=6A830DCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK4WVsvvaxQQ7kNvwGA24RK&_nc_oc=Ado0snox8zhEZvm90H743fEngdVi_JrCMdtXDrhobJ4ZyebVkJlK86qDmk66MwG4_PY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV1z0r2OfyMHySx2HXl3Uikf9zvz6zY_2AOA5PRWiV0A&oe=6A831A8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOApb7U-V4UQ7kNvwHQ6jrZ&_nc_oc=Adrpdf6vwkbLJagW_e45svXow06JNiWWL6eD0DEfnJXNuoERWTiMF1CAoHHkAOTtQJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-ZVgVUFaczrfFRbT16bIj49lmFekBcOOXwUq4JIUycg&oe=6A83140B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgTXMVrOQ4YQ7kNvwEWMQ4n&_nc_oc=AdpSjzuhsACWbIah74r_GXyx9TgEB1mhGdwZPEsawCoKMrjBaWf1P_iXTaY1Qw2HMgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi2ZUQ0oD2tSb6won_tkouRt4gvpX5wGNNy2QKW0Wg1g&oe=6A830B9E"}, {"file_name
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzACw6CxfM9HNlUnDTTQUcDpenzd67G1F1d8Z4roEDfQ&oe=6A79B15E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0T05wM0sHEQ7kNvwHPiyNR&_nc_oc=AdqTGziffXNLoBNAgJIV57aH0xS8tW3AfK14sc8waSQhJneRoI9vQNeP5Fz9zLfFJEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnSal2YhyXn82H07lcd3O5FgDXxVwFrTqnnrZr8aUbuA&oe=6A79E7F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q725zFrAiXIQ7kNvwGtHt8v&_nc_oc=AdoMYYQQXSOy6ilxZnlGqQplxblqZeP3Hin50fnkZMZqZ1zLlqkfyZvI9exjU2VFWE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAjB-ovPvIzmxX0bc-ygGHfmv7Q3IcpUHsjVZBROfSyA&oe=6A79B276"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKKMPMBJWxoQ7kNvwFIgjJG&_nc_oc=AdqPcPo97FYoMEzOU6gUdw3VzW6G9r6V45LiT-9Ku4ZpbFr_wzrT9ZteKC-_XYedvaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG30LjOhwTpGSzK7cLJb_-II7weDkKXhZXV2Bq6uIBblA&oe=6A79D34F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKTZ5Nk7xsEQ7kNvwEnWW1x&_nc_oc=AdpSUFgrVM2hJTyvMDt4kBS-aCgmiF5MQTLq6VKPaajBNBZQ3Qrrp82LpflOgZfhplo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl3D3vlbJjy-9Dwv5kQQZdfV8PnkZNF8ZZSxpbJTAfBw&oe=6A79E00A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LphUbCF18mUQ7kNvwEOzoX7&_nc_oc=AdpnmxpavriR-VBu2cDl6RFcalC3IQETdYfUvktWwPpJoLuPBZLF6z50jydK8b48j-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbjmUJwzdos5fCq5hhzIugacwxa2M5rW5qJih4YLJkRA&oe=6A79D98B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X94ScYgEp8Q7kNvwHCH8vC&_nc_oc=AdoNayqGDiIHSwDsNvgGiOE73aHRp1Wza_45HHJaTP-QZY9FazeepN0gufys1aKyEeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCm5Rxryptbiz5gF1JySXR53gOi9xojbceTBfrHZlQzg&oe=6A79D11E"}, {"file_name
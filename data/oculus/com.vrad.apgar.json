t-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtKfRiaCXpCfTbRysLRVBuE-RgXEQ41PVo_f5B52QStg&oe=69CCFCDE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCj-d4IsmXIQ7kNvwHmrHQl&_nc_oc=AdpUPkGV6dIbHRSGO-EX1a_OIX55QMeZvzWrpV1rbsUSRA3S4h3j87H_dgVOP0uP2rc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNjTwOJTLqs76l09n0UN_3S4oDawnsmaSpABS5S6AwmQ&oe=69CCFB35"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzC-0C3QaOkQ7kNvwFAF-ZV&_nc_oc=AdpAEAd_0UEkFc8Fo4HL9Mg13HStef3kAx_UvJcEBK1zULmnpgI-9QYFvtHMTeP-9xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzashHm4FtH0orPf65np0HZG53yYqNvuYZmZPGKk1rw0g&oe=69CCFDF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er51gHSYKCsQ7kNvwGxlEkO&_nc_oc=AdrxhqtZwiPnkc2TPu55g6rCDHk8fOogHiugoUeq1JJZA-kauqTL2atAFlE7r03QESE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy17tB6N9UnHsfjC-Q2k9sdnQb3Mb6Xldlr2oFVmJIRzQ&oe=69CD1ECF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfVJgOvHDCcQ7kNvwFbylWd&_nc_oc=Adr-cO2v8XsCHh6nPYiWbbiakk_x1Uad0zvSJLkDbka7Fkpt-X7N0fCTX89LAt3bKKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJwuFz6GYECoA2vGlmStw_z2A6yL_9OjTDFqPO78KMMA&oe=69CD2B8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACkMtXdxIhkQ7kNvwFBAFrA&_nc_oc=AdputdbJRlc-thiVT5O1QhG06CoK37YR6h9Vp0viVXyEDG6AQDMUs_o-J4eJuGxz8YU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSEr5oAP8S-qXnsdY5nzZb61ebaHb87ygo0eECBVSwZg&oe=69CD250B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjKBA5SlcGcQ7kNvwFVJcSt&_nc_oc=Adp4DyFcMSzyTdJ0C_3SM5uq8Q-MqztXf7ItXbneoqa-J2mq1OJWbf4sGBZtE4silS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyt3bB4mLjUTVePQM0wGImqpl0OliL1VXXb5qrRkfVtAw&oe=69CD1C9E"}, {"file_name
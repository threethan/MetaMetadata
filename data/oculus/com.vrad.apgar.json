t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FtAf2m1muE_eRAv1iGzYapztNTfeOlZqHwovPrSrceA&oe=6A43DC1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRLJDwIMfPwQ7kNvwH3_Pnj&_nc_oc=Ado2eGkgaioUsuaWk55Syo421whvdzE3TaW9JQecr0sB-ZNYI_3aKRQzm6-PDBvOLjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bu8RKR7lOsjbIPnZ4PGC81s_dYAvWLi-PJAjHhxsedw&oe=6A43DA75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEIu_G51ILUQ7kNvwFU8X3M&_nc_oc=AdoQd3R8eZlhb_MTvDJ5lgeHYSNK3Y7BgcKEl75teYFbgkeQsdjlM7_texR8V14Xrcs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80jX3-mQmOHWSSTFuLiIIj1WbZ_Xnqgl3kjgOvw5CkBA&oe=6A43DD36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHmBH4as42sQ7kNvwEdiUyS&_nc_oc=AdpjJ05JpUEwh3EJCCKBiwBzBsDJbWpp0ScUjLfzqok-5v8sMwgV50QL2KCq9WwgocM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hF6BdGkzX0nAvTd4uaxfb7J9JZYWPIUYD53wyUrqnlQ&oe=6A43C5CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6RE5S7L3YEQ7kNvwF4b6wo&_nc_oc=Adqr7iXjA7kLUE49DWh0TrJhCzUyqLLFVr3rsQnyd9OcK0aG523WI9HwCpNqsSiQQEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U9VZOtuyvbD_COeop7gXLShxPyrgiJnxyN2KSaDDa0Q&oe=6A43D28A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLhiEcznAckQ7kNvwFbZQc0&_nc_oc=AdoLz1iCHSSLyHP87fWPNHc41ICKTbLULg7l1L8PT34TfE2bwyZh19CO_pwXd9C4pr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b5NsdTtT25ct0cEbRqX5ZkE7SNgkAkBfCUCTNLhzS5A&oe=6A43CC0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xOTwZHTYHAQ7kNvwHf_Mw6&_nc_oc=AdocS3uh-w1HqzzrTnq3DPlMIMeBCzoEMx1HubnhQsCkT61OJqc5Y6Jkk1XB-pL9A-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jpjMZ0bYbdmGBmScxcYW4_7zq49PvfMF5ESsr9y7B7g&oe=6A43C39E"}, {"file_name
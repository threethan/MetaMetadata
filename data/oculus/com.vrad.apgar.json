t-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26n3fMmlwgvud_R0C6mfW06UD5MdD1Ece0A-V0sQzPEA&oe=69D788DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Lf26dAV35IQ7kNvwGbESL1&_nc_oc=AdqnXCJM5ghD1zt-idrJoxhsJmC_3elR-QQbLcv9SW8FbRG5b2FtOnGXCMvmzYKF2-I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zu2J-rho2RqV4Q-y8KC85Go0aZnQc6CDHQGXGATLP6Q&oe=69D78735"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v0wSjRb43cQ7kNvwHK-l4u&_nc_oc=Ado4jHkeG19LE-p4moMpZVNHIe0Nnx1yiT33KnWeGTk4xIcA0wydons9ggxr15VmuRw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3479wqJ5w-hoNDl_L52ATIZX55KbSuIohxCUh5TJKi3w&oe=69D789F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwbo7l6LzSwQ7kNvwF9vRGl&_nc_oc=AdrutktgsNviQ6mQP7z8t4U_S0xx6jFFdtlpLxtO7gH_uoGmv8Flh1auoSzdS1Ntf7k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ihlXTCUSblmmWgjVE_4mbHI77PQlJUXi2JEI6PI-51g&oe=69D7AACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHDLuFEA9TAQ7kNvwFnJBKw&_nc_oc=Adpjg8weWjcnjXPVIXNLs-Pa8uejfUAnJf2LX-shb1ifm0w2HqCEcT17tCo1GBz7SRY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bv_MlwPSa4ytZgOn7CgP7IM8XJNEU_iY0Q9V6YGTSPA&oe=69D7B78A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CenI1pKddooQ7kNvwEX6pL0&_nc_oc=AdofANE_NuNtGLvLSUh3kUdqhJhU1mR092yYe574_u3EuHRgKFPyU1fhhZDFzqg-HN8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wi8y5TDdGnZaq8qF3QtkUIsiwJoeT1Ff5OEOUQqFWyA&oe=69D7B10B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d0zYJSk7bcQ7kNvwGvIzJV&_nc_oc=AdptYA3WH8Gesti0katSsc-icQSPuP_2OU6P_nUtBHtgbgeeSe7Eyq7r5d_AHOwGZL8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af355-_4MYpMfFo0u6hFJLe3Pm0MtdTdS1vopwxB5T1TTg&oe=69D7A89E"}, {"file_name
3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjnNsSbOtCnSkCJ6xw_Mlm4svtg6fygKfOXdJ9vhc3vA&oe=6A858EDE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzVWTgAPbUQQ7kNvwGd7HII&_nc_oc=AdpuqKUkF_lqv_wwsgH-qJ8gCETAyH_yA77jt76luorOFfiqvaXc87_SRzTdHQRZq0c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtoyDSFRMj4Lalhc4jSIyomHC61I_IqSc0v421H85ysA&oe=6A858D35"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu8oiY-e4RsQ7kNvwE5_WNH&_nc_oc=AdpQf35c5cETeoISmi2aC4xIgjwnhIPycDyYiuIez2cJEyiX8pgn6GwUU3oq3pPNq8s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMPusxLxL1dQx8ctsmPKlysd89iVhqDPYqwYDhdYpHgw&oe=6A858FF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIEZo6QVOWgQ7kNvwEAdg7i&_nc_oc=AdohKIYHaGu1O5__fjDiqSSyrY1n0DOA6fDsGmf7bVqcu1cLmi2mO3pV-tbBpIEXSiM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkjxn2aDRfHMsMPFcegVB5M45wKJhDxSxqvPL1iBwFKA&oe=6A85788F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aGmHhCotgsQ7kNvwGzbIRg&_nc_oc=Adq6CnRWIg5AnMHcpZ-mMi6KTXGw3g4_SFyldDUVK8ZioVYfeLG38EIXW1YVEIydDU4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJFICHL1WOAYhfjpHmJKVdKuGKaW4_ukc6JBlxIMmXpA&oe=6A85854A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOApb7U-V4UQ7kNvwGVFVhq&_nc_oc=AdqHCDN4Tbmo2blnq1Fx1iIqC6AK-ICCZTjBadoViPFXsZh-6eBaYb_oajP55JXU7j4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX7Qm6MiAWLg9AGJlw9sglPyMH65ZaDW5tOPjzgnTQdw&oe=6A857ECB"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgTXMVrOQ4YQ7kNvwGMWoK_&_nc_oc=AdqtJV8gDg4cesRtY6Of2-ADx9TNZU8JMpfkeoVOcSqN8Uu10HLwEWpcKTBWCEQUbQE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjA2hvzsedjTOiqccFbA3Z6hCd5-Rv1j1Iis7uUxnDYA&oe=6A8
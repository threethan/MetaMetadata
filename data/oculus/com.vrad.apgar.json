t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_afCFNx6PcaWPRTm0WABt0vp9jijamCAQ7URB7sF3ZOw&oe=6A282C9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrzsCistPOAQ7kNvwGJx4gT&_nc_oc=AdoqyNDFeKqmhB58ko5yWgkmRsRQGYU5ao2mES0xqqCUI4qWl5KCxOJ-bk-1RTRh-rg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LTuSiPTvYiokW7oNUCmiAV7Bt9JPJ_Ngk_TlmX8fVmA&oe=6A282AF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdW3gsqmF84Q7kNvwHnJKq0&_nc_oc=AdrHnRw6NErhbFL_-dhkZZpeOm2W8Fld6NbNp8UfqBUMbP1F53xWRPwwgVSW5ChnF8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j3cjHZGPy44p7okShrVJBEI888flQw_jcV3Rhzagmng&oe=6A282DB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj3QbOqdX3AQ7kNvwFpmzbb&_nc_oc=AdqC9nsaFjUGfjfWGpcJlNSoW1XS_JkQFrWq4ButY169lGV2yf6YFTC8mOOFlF580ck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o3cygEfSp7UR1spF1cKX0qSdasyvEqhX3InhbeVpqxw&oe=6A28164F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSztT10B54YQ7kNvwEc1xsh&_nc_oc=AdorkhPEjSspF0vvxg1jvvRKHA7Dks8NGorb81vGs3bYpyP9VVOtqaA4AMR-9iyKKs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w2oTxfz9-vpzP8d66yclDUbtOuemSriCEmaI9ailk9A&oe=6A28230A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKYObTLK2BYQ7kNvwHo_Csn&_nc_oc=AdrWuswjRdW8-eU_TBpNySlneYBechlk9WP3kMWWcSjtZGcmshPslFqxjOEpEqaqdHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BX-PD-yLfmTzAF0PK9C_cJUznWxaCrvIQbhb-ubPwKw&oe=6A281C8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6oqNXorru8Q7kNvwEig4cq&_nc_oc=AdplNgyDo5ePJU6uT9Q3ya4Urzyf5CrWM-PXXF0Xu4BnZXV7xHx6cAWBPGn0nDHY6hM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uqBhaTsfEfva-TPRYlSJgTStwqLXMO4ud84TYT5se-w&oe=6A28141E"}, {"file_name
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFiBcxFqm2MkJv5amqURyKma6ejwjym67LwbmPOpTqJg&oe=6A6B691E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M4EhjM6IJgQ7kNvwE0C4K7&_nc_oc=Ado_SEkdBsKgoPWMTzJMMmVgEDnv-v8lMYPW8iZ9JDN0IPU2H-8VOBUJSRb9Qyw4lq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJAd-ikLHRErTTsji14ChjxdtzA52McPDIE0QhjOLj8A&oe=6A6B6775"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dimu-NJV22wQ7kNvwHpVKkO&_nc_oc=Adpx16Twncuhr3LzKEm6D5s2_m0ACLGBXp_yAxEfbsENCIzacjsG93LDR7mOLONngUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsTwcfknIFq_o2K0Y2yj7DNOWlxVJASCJvEN0TrBZuyw&oe=6A6B6A36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maG28cz11g4Q7kNvwETUxyo&_nc_oc=Adpqzff8JwVePXAqqBrs1HIM9VvVqORRWXbq5JfWCZrKQ3SzUTmftf2hvuzMPzqO1gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0cGntFLR4G2TzUfEuxLaJP63zRt9qcvSLqaSlW2WZJA&oe=6A6B52CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_UwPLokOVoQ7kNvwGXkRZ4&_nc_oc=AdpNZH_2C8U0yuoUot3sxSAXC5dqK2kT4UuNF-XLytT8XTFMqJBe5eGS5-ShvenOgqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1oJ61GkJTUdMqvC6bJBTDL1hYuM2EDy538oNrX5lQEQ&oe=6A6B5F8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHpHh_ZN-D8Q7kNvwEl1Ucm&_nc_oc=Adq76GJu3F4afCkcKNdlnojFjjPqRsp_vJm_HaEvjPrmq_MgeCXhXt3efla4Lswk27o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYfLz95AZw6YXgdkNIiGuaJGyqBZjXoxr-Xid7lI8kVQ&oe=6A6B590B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjYvXiYJouUQ7kNvwGn_UPX&_nc_oc=AdodNJcrFp0967rCcZ-4HaOAg10As2kEcXneU_1mNCjgWLQEuUa3DRrn_foKE86mWwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsS68BaS1Mc-U-MHej9lhUa4MQn3o-6PGv4WiWlx90nw&oe=6A6B509E"}, {"file_name
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ12MttCGIX0fBqLoY9zZqfcm8T5oam6kPLBNUSIxwi4A&oe=6AF4851E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW6orDM9J6kQ7kNvwHYnjXW&_nc_oc=AdoZhC0_2H0n4-uPcN5p_mef1i9uuSu7gahX38z9qUDhThwTZ-wyDzEagd00L8qnMME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP4MsIK9Ze7cSWiDowZkUofYAMuTAjhCRFVUL4jvZCtw&oe=6AF48375"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3T0Z8gDgpoQ7kNvwHr13WO&_nc_oc=AdrFnF4az87iUpWJrXtLf39-Ob16n1QijjZCIaz9vfwmBzdgDM7ZXETtSiQS6sZfSi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTK15wlGdr-VvVbht_10AobrOEK037kyCRuDR4Pf8fBA&oe=6AF48636"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN6yBuV_hcQQ7kNvwFcDNCo&_nc_oc=AdrGW5TAjU722HogOFRtaJlMWDO21KH3WLITo-l8cnuJwAjL2nY52u7JPZhDuzV8q4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8quHKQwWAlFPT1NvBuPeqkj-aFLrRQkcJPgFWJBv3Zw&oe=6AF46ECF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbnw8xyXP2gQ7kNvwELCzQH&_nc_oc=AdqpXmLBUMSHcv8ZVbgLv5NzseZ-GDB_PhHX6bRnkmt8eFu5aB_jubofi0tTHnKHlzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpW7W1iE38X492Ih-nP0QV0V8FHGfrLpB9GsqUkhR1PA&oe=6AF47B8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kFdtDCIZkQQ7kNvwGGpqNc&_nc_oc=AdoubOVv-OwCgNvLPeGxO51DGrAy_jc5eoI4YwYIql3I9zELWnyu7oc-vtCRaOp7fnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3x_ce8uiPMfQ4ji0k4c9ncapslGsIbfoJl0yVltli4Q&oe=6AF4750B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArIQbQ4w0p8Q7kNvwHguxrx&_nc_oc=AdoV_fk9Bp2Y6lyvS56nDDq5TabQbU9oiTnRg4P7gHdQeSW_4u5CFTqV0U5_VvV0qkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpE0LxPQUUwbSatbCoIQPsdh-9qd9jV93gTyLy7vOPQA&oe=6AF4A4DE"}, {"file_name
t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjGd3bSjONhdz3iJnhL6QRKyeDqMZRfq2t5LYi0aFsTA&oe=6A53AE1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seQyidkdP5gQ7kNvwEXkfeV&_nc_oc=AdrU8iIdsguLiJsUH_ij6q6x1iMqTFdmeJoNz1u2-__GWtD-8KHUQe3YwVO0-B4uT9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB__gLpZZ2SYzO-daANrneq2NLlgaj3Afndr6HPegQ37g&oe=6A53AC75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gysC9F4CHMMQ7kNvwEedTLN&_nc_oc=AdoqeDpFag_v0C-MwpWJOffBtI5EXJcOqwZxxXj8G3o8BYwW86k2Xohd-aPcwORscIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHYm9YHQMZauMYOV78ptQEoYsz7YNFlpXfOt0JurNoIg&oe=6A53AF36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp3yfPpEFq0Q7kNvwGgxx4B&_nc_oc=Ado9Fwr6a9Fq0LE0f4STRdmqhnuDObLk_ixeZrXTbKf9fd-pjkDNhRYJnZG2mU7BReU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAinkh7E95iiZs7-nxADr4Ak8vEhF4i4S5V13Ibc0_wPw&oe=6A5397CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-B8pNP-ej4Q7kNvwFygalQ&_nc_oc=AdqbMmJBrYGqH_N7ghS83ldToUikzLyDF65mE0hwNIajSFbnuIilDzOIsgRJnho4HM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkrYuQVlAv-lpIS-kfxZUeJ6ApWe4jGGlIWLO-8emNjw&oe=6A53A48A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCMi6X3-SBYQ7kNvwHD9OVg&_nc_oc=AdoJeRhWxjr_spxt5CrirmR7Rn0JvzdIiXRqCmOx3rgqM6xUy0zxbBEET4ApNgGTQko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ13bmUXkxsAmxzlbb3wyzCS1ssVIY2f5hd34lSVhrRQ&oe=6A539E0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1X3yiASl8cQ7kNvwEHw8Ru&_nc_oc=AdrGWrH4tNXPOqQM0CvOD-T6yxKGjbg-aCh2z1yBFOdTNaP9feDvZTCiAQaMRrkeNMg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvecA5VJGD2pe09bWMXLkkwFFBlYsNJbO5lEV9QIW1Nw&oe=6A53959E"}, {"file_name
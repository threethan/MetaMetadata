t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiDFNSWzVa3Hr1fzT-EkDdk1VsqSOjnTu7Yd3HfXMZ1A&oe=6ACBA69E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSK2Le9wpOAQ7kNvwGAfDAm&_nc_oc=AdpsX06MULgOKcL3QiPcZfghUfcGJIx7YZl2nRGS7eQyJRHAGnC69f7QIB_SG3_xovY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8c2avK-DdxrqMuc7ett0RJTnOIKtvYmw0Jn7OWKmsHg&oe=6ACBA4F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GINF8hhd2K4Q7kNvwHq2Sd2&_nc_oc=AdrA5eIdMV_5U3Q2tJ05JebWCRyCvWNFEtBPjusU8UjDhswE5zOt5ELoFGRuVEQ_hmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhowhnorc2TQh_wGV8pEShM1USn8CY_gt0eRaJ6PQhZQ&oe=6ACBA7B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTg-rTWuU68Q7kNvwFqvaEt&_nc_oc=Adq7LlNGjeC2dpxwGvHOc8KcG40LRsiww43BexRZ1Vfy0vCYiB8rxLYDpolE0fWiVpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGByEHK2hTEc6iHCT-qF-Ku7MKhNdKYLf2t8i9YoH48g&oe=6ACB904F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3nOcTKypFYQ7kNvwE6GsWV&_nc_oc=AdoWQnw_HubdE8TaGCTPzXEAyBHgzII-WERVaZGfrIW1_Ock7_e_xGlP3We7RNqLCjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCfft-bN7ITqUK_aso4NCC_rpwX2HgljjbfGEJ5pyrFw&oe=6ACB9D0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAEJP5ZrQoMQ7kNvwHxhaSm&_nc_oc=Adr9MJM9dnwrdUtzuRRvOVYPjQKIVm6fjNOxht_pz5UOI3lZMInjPzCx-P7QaP41fdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkZ_r0Yyis-R4KGtUedcsSseC5vTP5tO5eXzxerjC3fg&oe=6ACB968B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4yb9ZOJiG0Q7kNvwGf48bd&_nc_oc=AdrkQUISSyzbOmDNQo7bVWqFm-MaTE6ne1L_IPJN7ITx37ioCAz23Y95VsQpbc5Yuv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTNRrEWWU-q8g88Fi49BWltbSbsiLsLn8aIET_sAImqQ&oe=6ACB8E1E"}, {"file_name
t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2OSzlygxVseJU979ChYJBN94J2A2ydPfQk4XxROVzeQ&oe=6A41391E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRLJDwIMfPwQ7kNvwHGLuf9&_nc_oc=AdprbMHpP88u4Q7r0tl4drmPiAr70KiE7ihg7Hr9lSkyMt_7SxkIFjK-43tE8UCw1ME&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rDse4IctsPP5Qh1WqHGJokpRudWv4kdPKxBWro_BaaQ&oe=6A413775"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEIu_G51ILUQ7kNvwE2ooik&_nc_oc=AdpAbOYfZOjJuPuiM9ZjEUBrQm1XDHnzq6ZAjayiEYAkuaHoxwCU--IP_vWLVu4uSCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cw769GPm2n7WC4RU8BXxzrnfHqVzw886K7FzvHo26CA&oe=6A413A36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tv6WrEcWTp4Q7kNvwGJWUdV&_nc_oc=Adqahaxo8UMXOk8M_GNjdakph8CZyHGrEEWdTFbUH28DewdcyVELA3aCuOTlPF1iUEY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-mGkBcZjD8NmE4o6zVJyrMx-h6IsjOk0eVYuNczOl6w&oe=6A4122CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYAQAylRsfMQ7kNvwHhAvyh&_nc_oc=AdrPiSuK4XA6xg92SbcxJJxsi-0txK4ZAClqkxR7jguraiTMGvO_Tyask_ZQQoPx28c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p3NsYaRvGI7L3SYNYQmEebjKOjXLXUw4eTKv35K205A&oe=6A412F8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUGNTxzFnpQQ7kNvwGV1D7L&_nc_oc=AdqJlf7jTxNW946Kn13VQujOH9uRL1R7LMwCBNtSouvV1XXou5m6kK-yXdFKnKKMweI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XEDJr0HcdNnqeDfVA6V1tiTR_DaLD5UV1JndKliTapw&oe=6A41290B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=875hfb4cjcwQ7kNvwHX3WV0&_nc_oc=AdqsVUQFmOYC8WvkGDtzXFd69ShsMt1WLa47gFf2wQ2Mzb7jvlS6PI0NET6IE4gJgNc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vI_KefNuHdx7dO_AFnagKixu8-z749dACi_ZSi904Ag&oe=6A41209E"}, {"file_name
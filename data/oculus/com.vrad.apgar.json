0_AfwGmDNDnChgii47tJbMREsFeLvvnV_mnptN39fy1GnkKA&oe=69BD2ADE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAlNUFBxJnIQ7kNvwGPcxa2&_nc_oc=AdkTdpw3IQt_K_um1QSDuLkI1Yzf4CaFua9HzWAEjViYpt6Hy53w1dd_XBd-ofl42M0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUT071HIE8T1mK5eJwag1h_pgDSgAhQQrU0BdmO81kzg&oe=69BD2935"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt-5fwNKzPgQ7kNvwH5ZPy4&_nc_oc=AdkmTqKTT5OkbK-syL7MVrOg1JtA3y9OATU0xLK4Gtw_NkIRIsvREAHr3Nc9QA648NU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGjAkG4tzyLnnYySCdAFCu5SGZC6xRb8-Vt1iQRNTgCA&oe=69BD2BF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH0KRz0MTtMQ7kNvwG_jT3X&_nc_oc=AdkRf5ZcpuLFzFVUip5r7IL_OTM4WhOAELpgQ8qwLhLeNcbODoUN0ftonaL5HOxFiXw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxX9tLI5cDG-Mkf_pFzAlhtahI-d4xzuI2cjRhLcLDzuQ&oe=69BD4CCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awfTo5UEMvYQ7kNvwHPYj_y&_nc_oc=AdnfpdVNrOk4B3bhB0oADyygOU-KYIcEl-IjAARBq9aIcs_F-wa5ZLjcx9NjyMCGoKM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuPaXHXiEgcUGuwf28wVgBfFJNIIebm8evMEI-tzoKcw&oe=69BD598A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgerPRh5XWAQ7kNvwEI9F6J&_nc_oc=Adk9VCyUCn019scoTcUJ5tRy1TRWi32r625IbwwbP8z2FgCG-uQDveiZf-YiBZJ91Wc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSqQ6EChSdy3zTrQL4exykTWhEQ1QkMUR2rewZ-KMlmg&oe=69BD530B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCc3PYhAsdgQ7kNvwER9v0h&_nc_oc=AdkxqgJIjHSnljjTsWIEK9NcHtigJZ28L1qV_kNz3RAMNFiH2Q8n41III3J_OS8nWHQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaJFm03j5vkAIZjx77QS_OULGox4Dr4gCn63T7cRuNrQ&oe=69BD4A9E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpBif737_JjlPoXwSy8NhtHkE5-P9wzf_1bISWpgRwOA&oe=6AAFF71E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mv0DDNUeY9AQ7kNvwGQKALE&_nc_oc=Adqkl4boqhlKvYtQINk2hUzq9dvAeSrrGEuKLzCb5uIPy7QcHeIyC4qRoTQTEjTu7zA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlWP0Z0tv9SPnUDQM68JnfeDy1sErHzV3QUDEez1FNuA&oe=6AAFF575"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYOn8ihzWzIQ7kNvwGKNwwr&_nc_oc=Adp9kda9LP004soDmguc_pnb1BOUb8yehHJoxDsbRRdHUxHKXEx0qqBRkIgHPj8UPlE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu6etUVE-vIJe04yfOdIOf15GQ7EHBx5JNoaM2BQdq8A&oe=6AAFF836"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mye2M4Xf0AUQ7kNvwEnjtFB&_nc_oc=Adquj1aWjYGhVs5ws_613I25OWi8XcgjuWSF_KqQMzf3cbYxIVReTpuz9jbxIfOpVbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAw8uMjsKuUGheAB7CZgaMWjKK7vDrISzWuX-DeaDTTA&oe=6AAFE0CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8YZZJkJJugQ7kNvwHXWbh3&_nc_oc=Ado8VNKPNpHhr6ovwwOZaaZmhgAb-U29toB5PP_Hr5fzHrZb5Gl7BKH97KFnRyeeoF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwK8X45LblSJ55tU_-PMi-W-Sy2CRsTjxYnh90zlH7Tw&oe=6AAFED8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2JKzeFOLOEQ7kNvwHNE43c&_nc_oc=AdoONKrMFd2O_1i9BveUVH3wpV8D-KPKECCQxZaj5SSXmyr6_m3wobJsvCqYT13Cxhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTLmcMj7KCymAqTiNZ2P-Jix28K8-wUt4v-UeOt7ENdw&oe=6AAFE70B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWBSpFcubB8Q7kNvwFzVhTo&_nc_oc=AdrOd7H6mDfo3Mn3a32Ex9-PmpuPIucX4wY2mSJMtXvO4aFgfIrBxaQDssbuEnKppCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLxThs3bb2MHu11qWuN3YfoVACDnUlIBAo93QtJw-6Hg&oe=6AAFDE9E"}, {"file_name
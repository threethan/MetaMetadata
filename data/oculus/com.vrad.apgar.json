0_Afy5kUPCtA3CmLQXfCPiC_6HiX7mEhyMu5FwDf7MIE67iQ&oe=69BE7C5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfhOIkDVD7oQ7kNvwEknlyU&_nc_oc=Adkutbf5uaebr_leslj4nuhY1Okx0X-O04dimEnZ8rpDY33FIF4I6ufWzfCpzHjJwS8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXBrdZIfUKg6bWG7HvS5lzJtvN8d80biScnUmDSTWBPg&oe=69BE7AB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPjKvaF5spQQ7kNvwHPy3Zw&_nc_oc=AdkVLSEupTp3HwTnT6cxNeTMgReBSc05YE-hGP6F7vI6J2aPeVN_YICosCT6ldzcbOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGWmAkUY6j7d4_BnZtaFwwcxX23vOaRYMfRUmJOXploA&oe=69BE7D76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH0KRz0MTtMQ7kNvwFI95IV&_nc_oc=Adko6BaEqRKVQVk3HvN7eQaAVugzMOIp5iB7OvOs87SgmT4EpdpvLDMp08f3wytcJlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTMa6183SlXxqRBDYL94aOxg1exj2dncWVhqzrAYI_KA&oe=69BE9E4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo6f1jLqHAEQ7kNvwHD1Qxd&_nc_oc=AdmJ22yxBfb_LTP4oU6PwpzOqOEybABlIIF9Ct8ePB2ayaYp7xLN9ncyAr2bhDVkEXQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLg5YR5TMl0fg75WsE9aFZta3LheSDTLoTvJOP7HD38Q&oe=69BEAB0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgerPRh5XWAQ7kNvwGXD7lJ&_nc_oc=AdmD3DnEUtFoez7MYG_V30tEQ0zbi2b34RIUB3UhimP3_k6j8XvYwbeNz8uHIAvGtnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzuOKHXST8JDIXIgEIjWUn78Hs8gTwu6mNcBuDuK50GQ&oe=69BEA48B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCc3PYhAsdgQ7kNvwE5SBG7&_nc_oc=Adm7cfUihz6kTDU2tu8XEwTYlO3t_weaob0cfQ4wLVc8YfOJbr0jPzmx-F1bpISHMMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8tbDfVp1e3kbf-hhQXo-8VlmkBaCpTKYsQjHnuicEZw&oe=69BE9C1E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
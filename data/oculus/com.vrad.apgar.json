t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WufEn-e29LW4Z1fJ2RsIxYXcZDliXU_Zen2TjIW5TXA&oe=69D8DA5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Lf26dAV35IQ7kNvwEo-d74&_nc_oc=Ado94sq9NurDgU8e_l7tW35v55SLEEP25v3Y04kQt1WRMKVZd6mglrdWVz04mz4D2iE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K61X1pf_AXho5LWfnKtxLGGCQ1_umAgTwE0N9YUDFUA&oe=69D8D8B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v0wSjRb43cQ7kNvwEqJ8yI&_nc_oc=AdrSD4mIZFrTDI9viZaqYW7Yo-0jp1wAyRgMFxqpUmAwpfjUiDVrxvMAF4ZAh8NObMM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QpYy9poaO8nb3ix03_DYo2RcKXvyA4wEpkMMi0swrMg&oe=69D8DB76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwbo7l6LzSwQ7kNvwHTnnII&_nc_oc=AdqGpvlYYf3St_1xQXEV_hKDSWpkyqpiA8mfKEoEei_KvY8xlXrsAzaq5-V_XcDxFQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1r_cDFXaILtnSa9bRO_bd1FCrjY49l0IOsWYysYgD9bg&oe=69D8FC4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHDLuFEA9TAQ7kNvwExPBBn&_nc_oc=AdpgukHXvsoGefU00QZBnFDnKz3tF0syKdlnG4gj2m8zIAkJCrFE6gNXYpY52lsKnKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xAEMLFaJH1GQv4aN6yfXw-IkQasuenydO_Iv0cDPo1g&oe=69D9090A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZUTFjvC6J0Q7kNvwEUJvtU&_nc_oc=AdohSia62HJpNITqGwCfe6loT0JSWu1ZOa-bSD40O6PeQrKVLRr-Bd4VT_hoJ9r-SjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RcvssgUb-RKbeimhmWPVhZS5QuR6zjylqyKyLMpRezw&oe=69D9028B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRGT3GTh1mQQ7kNvwGuMLmz&_nc_oc=Adq6JiAYkJ9S_3Et6hl1JCVg6c9gfSiCzZQiLALHsyZS0l1HMS0XiyLSy-kGNrNxS1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jmUGnJQkHUyHmJAUsu-HwzMobDltxg2mZUzIpQxbuxg&oe=69D8FA1E"}, {"file_name
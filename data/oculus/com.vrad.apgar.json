t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QGvKcatJgQN0DLyLTd29RNyae_QdCrLlzbsPPtSEvJQ&oe=6A0B2B9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=938Pa1_DIwgQ7kNvwF7KYJN&_nc_oc=AdoBMq0ZgIzaoyhbcDbuk19juqDKoMvSS4vZPJb0Y9vxeaylvpSzl8OLylkiAOsviw0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WnuuAAWHIjeCsyKUJDMh6dzME3D4SeLOrjKbd0otamA&oe=6A0B29F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFgzwaT44hIQ7kNvwGWoMkv&_nc_oc=AdqLNacLvoF7v3QOJQX7Gricsvu_TRrx7JYgOxF7saHMsRFj08j_uBodxJ8NUlb4l2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43kg29aML4xnbS9L2KXOnj8tf7xnTG5MxusSw7TcxqHw&oe=6A0B2CB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCLcXrcs6I4Q7kNvwGxLsJT&_nc_oc=AdojqpR3c-btVe5U4schENob3VAYuOMp5bD7jdGZTTxlwZcy1S4S4M2Y38RR8DCsTVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pAvI8Ne4yj9OdX1GDnno6Nw2MCpRRzfKdzfX9keKfsg&oe=6A0B154F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUIzl7ZMLt0Q7kNvwGZ-ipv&_nc_oc=AdoHCfHN3ks2u73Vyzi_FSvRWBzVO5As5wQtrjAwhBoSwglFPznMDHuaVIPI8S5YYNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WmZX8nCsbeYSatVaXPbAGxC0ruQn_myOTJ-ouPZBhzA&oe=6A0B220A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMIBrAvlcL8Q7kNvwFE2htO&_nc_oc=AdoiqZlwkSN_AuWksjyK9FoDhZ1G45Yw9h-q5SesVpQag1nMUjIib7sWl_SXkOq9DnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mk9juk_gdXgTsS33DDGov-yAEV4KjJICl9vLPqH7fbw&oe=6A0B1B8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu_z-kFDBesQ7kNvwElAWru&_nc_oc=Adps2nSnlpBHwFyicBN84GszIpcL8mRhP_tOFJ6QRGzFsoGd3yEnNkHHmONd9PtH1Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-5UoAyyBhav46yitXnXhZY9i0tFyPo5XlfmbwwW9-PQ&oe=6A0B131E"}, {"file_name
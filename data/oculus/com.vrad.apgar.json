t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdX4lyauVyAGNwMvbMbfO8tWPBmpEBSR4TCXLE-wzVvA&oe=6AA1769E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMRVTNELv8UQ7kNvwFHq2M-&_nc_oc=AdrinVlwX1UZwvanJ0q5vOYgqc5eKWNp19joS0umz6Hh9ycSKObfB0CKxFX9WYJRC_o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK72mey14EMaemayRcRn-ja89ac_q-aJ_jCwMkXE1_yA&oe=6AA174F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSh3Sxy2-GIQ7kNvwG1Fc0z&_nc_oc=Adro_-Oq945q7QQy4aqhM5G5USxAY1CErr7Rmvx5MXAFZl5zW-QmENi3pCrR5iBEXhk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdl3s8TJWMdVtifM1zleDk6UQgHp87smntpwlxV5i5cw&oe=6AA177B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUmlJTnUaXYQ7kNvwHhL2bC&_nc_oc=Adq3KwLpbhJKPSdpcgDHSF8NIFKztMG1KiW0AD6VpDtBy1J-Gr0O-r-F6vv6bxBHW1U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRM-dJw3WraKyAyzrjqGuThHoY2Zu3Pz98frK3w8wnPg&oe=6AA1604F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaCjMezL1sUQ7kNvwH1dqFS&_nc_oc=Adr_bMPbB89HqlZtk8d1uGPPaJRUWb1r060R2liXAzPTCPK_lXGx6GZWmZ0za7pWriA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfB377jqkssQ6Czas7pomc8Z_QO_0FaJYmBDAN10Hb2g&oe=6AA16D0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4zv-IZgLBoQ7kNvwF-zqyY&_nc_oc=AdpmW7UlY0XDFqmAK13x4ZNFWWJj379haxRMGK_kGyMBmpJ2DcZBtCWX2j_5hAeCEQI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMNg7s_tyEm7qOysCQiXS10e7vWQa8tku2eP3yOJWZjQ&oe=6AA1668B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs4sLWycnJUQ7kNvwECtThD&_nc_oc=AdqaJOrkJ6oUW6GD05beFTyF0q21_QdpUqCUiG0oh4iLCdcfOY0ybFt0AgEmUcWBrM0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh31bAWoGaXHPA5DEymAly2Ww27F4c0KkNav2xz2C7tQ&oe=6AA15E1E"}, {"file_name
t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VL6RGRqiNa5Yn_C98hMEX42Or8KFqyLzNwpxL8C4S2A&oe=6A15B79E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wOpjWm2zzMQ7kNvwH69WhZ&_nc_oc=Adpg6ui3fLkHG2d_tuqUX3k3BxqXOeWggRswyTQQWyWYh0Z3ZjdqmPeV6tE96QxYcn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dHssRx480pMqbL2l09b6lMplcdnpTwpJWVfNcadoLKg&oe=6A15B5F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvTRbXLyJlIQ7kNvwFpDl-_&_nc_oc=Adobtwz8DVehx9mJf3ZQ5Wc2Heo6Du6VUnMjbiwRgCTlPU61lKeRQHdZ4Z2lg1EC7E0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GjMbnWHce179EE_baxiGFn3s5rHRvByDWciIQBKrnAQ&oe=6A15B8B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUWYvxucimUQ7kNvwGwZIgU&_nc_oc=AdoCIO_8eECPo-ucaZ-re5IWon2hhJiAKVb-C6BauYRgHJ4263AZwE7_2jvRDI1gqLg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fntFwA7mT3xawOKficJi0zjjoh3gg7x-GderKnuVJhA&oe=6A15A14F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsJ3peDNSD8Q7kNvwEHYp2-&_nc_oc=Adq7n5uu4oOrG9HEfF4ZOWMA7TTPUSGNh_w6ScHLfjfBlb7w5Nd-CW37Sn9Ae09_bxk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fvYUsAWpD3wQwj_6JcW3JYtwramsJzO1lSC02it7d5A&oe=6A15AE0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQIdhCEsLVIQ7kNvwFqdPnm&_nc_oc=AdoypAGtJP-M8WNH5pweMi9q9f1nZ6SOTOkWdKDPOhD6aSg-H6dpFzCWchWVa1zwLuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VviqO5YSEWRsUN2yfk78KOuObLEo_527Srsm1KM0FhA&oe=6A15A78B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FcDJr3aHx8Q7kNvwHxG5cx&_nc_oc=AdoEbulAdVghCerJJqMMrj-waD8QTipLkc3A-uLBBVFUcuo0LIBRhgLTaHv8kq168T0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JVLu5vyuxJnEGgS3iWttY0QzOwESPO_ZC01tTR8YjMg&oe=6A159F1E"}, {"file_name
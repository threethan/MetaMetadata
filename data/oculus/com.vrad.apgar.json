t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oC03Kb7dAtw-6ijojxNP-NvHoM_EvY3BVSHl8k0iKyA&oe=6A05E59E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EcOiq_vwCIQ7kNvwHl7duT&_nc_oc=AdqwPqTSisAH5uFoZHNKKusCzjr0Xv8V1KGr1UACXn8a2B5BGY4GiNyjcqovcPDFgd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50-nYBsNbmDkC0g3bJHNEtzqcf9V6x4I4iD74g_o33Vg&oe=6A05E3F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbsLubc3TnEQ7kNvwFxZ2St&_nc_oc=Adq1jMMYIxg9k39gSDS8YM61cjfDId02rpDcHCdyFtxPLWxpMI8AD6E04JmKq9ubyhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SXb86I-jUhWDrJE0954eMoAayFC582lDfWDhVcIKCyA&oe=6A05E6B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alj2WvuGc8MQ7kNvwGHwFBw&_nc_oc=AdqADCkgCf13hTZQYaorzdIsE19ipgWFRRLjI0RhsGWLdL0XODX1OBzQM328uutimaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A7IwPKsYAbOosr9ZIrX7Iw7phxjueLDb-myD1tk7xgA&oe=6A05CF4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3myO3LjORSAQ7kNvwHtIMYC&_nc_oc=AdqDsJuOEw4dqopTf8KgZrGA09RsHkL3AjblfkYB43q1Tga44H-gThbZvkovvlA-hKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_jJiuT3L_ZJKMB_H6iwlqqdF3MAsbSDNNaoQ9SdtjzA&oe=6A05DC0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8H9201FnA0Q7kNvwHIKR-k&_nc_oc=AdoXXi-jLQseDjk2WFBjLI6ez_9vYlQQT3Qw_c5sEQR5tlQomgQ6xgCKn5dothQHf-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Kh44BGnctZajbtV-AOYfL2LYXem2fDBFOZZekta7Ncg&oe=6A05D58B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfKru7vkoEUQ7kNvwG7QNgW&_nc_oc=Adp6f_GGgcompos_JQdb1It5JsQYbzX8zDFGZEf7CMM84-MYtehN--SpdnWUi4g3zv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44L2WHwHDSjltLZiAAYMereA6Gl63f8J21vdeAi1cyUw&oe=6A05CD1E"}, {"file_name
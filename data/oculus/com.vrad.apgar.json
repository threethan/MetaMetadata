t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKw7k3t_q65q9N_wckTE4xRsCqIlrSc6WCHMn2TjeJ-A&oe=6AF9CB1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmiBA6kNN98Q7kNvwEkYZo0&_nc_oc=AdppvX4U4fgz5t7QgeDqr_KSG-Rppe599gFlKxpDSX0iW4IRzledg6Dwrn6pcSrleYk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZKqT6o1xhAa-E4Uok_tg_Al_vB-7Wc68Lz3a6K1kZjg&oe=6AF9C975"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_kI8EHep7QQ7kNvwF07nM3&_nc_oc=Adrk-7Mm4fCJiihnSQJe13ZxAMNThP8xdvIL2_rYYz_spG9pVhy_FFG-uZFOeWup77c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVdAXkkjfeueoxtUQHiyXr00nd_pBiMBiHcBGsBepDlA&oe=6AF9CC36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKHQ5aXCPMYQ7kNvwGwqePb&_nc_oc=AdpUXoOATv4rd8ajoKYYy-8cO5QIajhjjFvJppp6176YSYgxWjN-LyEh7dNOGJmwFRY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9tNQmoB23SrCkunX_yJa4024xFot1bomEklcLaIWldw&oe=6AF9ED0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvpRh9GgT7kQ7kNvwHoSvX9&_nc_oc=AdoKGHNR_Fe4Xo3he_iZVorpUtsA6IBGra_0ATR9GA1W2jbEsXoSMZDtXlulcvN7qDQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7cI4qiaCqFjYEDQO7fwVaA20iqeGdUgMLnSqPL4LBYw&oe=6AF9C18A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Hu4kd2mz4sQ7kNvwGkDV3w&_nc_oc=AdrMLHq0Av8FbhEoQ4qkCIQVFhTZB1iGJvbwmaS7IQJNVXOk1XFleZXV39tUK2Yz5RU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7JYxvT0vIFf29v2JbcHCNtkZACtRnyilRc4tLM7BUpA&oe=6AF9BB0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2BVaD6o8OAQ7kNvwE6ZFkU&_nc_oc=AdoOC19rgbRQ-S5x2J_aBOEHwPiK68lpSemocnET9tOiHkXvGQzOfpuJTcZ-69c-v3k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzt1ZRdTN8mzhEHlbC3vZH_RKe7DJr6nO5oCEDgM2VNw&oe=6AF9EADE"}, {"file_name
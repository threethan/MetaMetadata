t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkyyNk-2p-1f7is03iRQ4TK5LSt9AOQk8VVlDXtVsVLw&oe=6A64D19E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-E_N4TGgD4Q7kNvwE5ExG6&_nc_oc=AdrsdZ8i7CMqmpFLeXRKtgKtoy8Yy0pJ5t7XAdNPfspK7paPwELh9X4-7JLCLQWhsTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiqS9FAU7XYhVf8_1XwTIzgPD-P6alwGprrIPx_MQaRA&oe=6A64CFF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSKwAfB9VfcQ7kNvwFos1U3&_nc_oc=AdrNIyB6od13JqUr6dBTJ0EKXaeqLuhiOZRlRnB6-dX7JcQuIFVgowEibpapRZHPN7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdkVyAx8HwiWGk_qz8sI39Y-QNyxvj5MLPNqxsg5Bs4A&oe=6A64D2B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm8TTyD1CDcQ7kNvwFHmi-G&_nc_oc=AdoW2KG1M6VLd4PgD6C7r_6rpiYHmq7k4bHa_MwZRVdWlt7_T1bnVKlfUMoYEH8zZxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7DfSo4komG-QcVENqd4cO6gfCt557GigOqurpSUgH3Q&oe=6A64BB4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt7MnMkj48UQ7kNvwFcGCNo&_nc_oc=AdrHsnkgW0A3HE2jSfb-PPojMEf8946NRRSbuRsz-UKcqmagQEFHBHoVYvVcGIgMaoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuVHvmq8g1B2nhIgfeNHvQHh2BgdwQVBR3Kpa54wuqYA&oe=6A64C80A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD7BhNTvEhYQ7kNvwGQbr5x&_nc_oc=Adoi3p8PrMldAvOyJL3g5Hn7bq9MIJvHWayqnXSzmXbUxUSg8NgNbGk_fDkp5R2FJaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBri4tA6Lg5VJhDnP9HgFu0Ph6dE3lsWI9CdJ4ztUEiWQ&oe=6A64C18B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwjL_Na3KZYQ7kNvwG3n8rI&_nc_oc=Adr7cwZYHJVFyDLA9OZYMBUjFsi7X-CdWFQvxIwFiVaV5oaahmF7BsqRWWfjSlg9X54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOq5TdInzZoiVwNVuH2F8oYAD7n2EfrtNe0F01V-vJkQ&oe=6A64B91E"}, {"file_name
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tMHEt4ApgRHeb5WyPAo8O_YLfwUYgSTgJsIkBGICPmQ&oe=69FA081E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4jcbl7pcbwQ7kNvwGqKXbD&_nc_oc=AdogGQW57WKrw1JnLOGyL4f_TwnTqqZuUD05R0LdZNwmg2y54jBYgYE9ZXKGb68vR-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53KG7ajmBOmA0AiKI0fSSLRafwZ6XoKoPCetH-L78B2Q&oe=69FA0675"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_KReVBSXwUQ7kNvwHPr8As&_nc_oc=Ado5WVqqhhmMZC9qGNfd3qFlNy3w6nBrgxZApXN9fvWFVfIZv7iV4TmgM29A9HbUbLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Te9Q9SOoy1a2obS9SlS23Y0A6-u5CwwoBKFYItC90JQ&oe=69FA0936"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE3VQXRlqMYQ7kNvwFIFw0M&_nc_oc=AdoQiL8c4KwOAiHaOLSEVlKwrhwkXGtIKDumjvZINoGlpU-QbrfwGexbqOT7BdmTCF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K5T7qrj6kE3L-DSl9FqieTjmWsRmDStHaYMc3N8wTug&oe=69F9F1CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BikrM0lm6KMQ7kNvwHguJhR&_nc_oc=AdrQG2asY1NelpcMuPCMukktZ0Wbke9SbQaFNDn3R4OuW9AENEaQkh8B_wBDNUDh6JU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JpYOmf3KvdBQA87F5BBK2-UaCdeM59bJYIFsjpl1Xcw&oe=69F9FE8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPd5YoV3PVcQ7kNvwG13SV2&_nc_oc=Adqz4uW8px3dQ_zljC30uiRVhf-m2QNGCAZsdIkMVlzDR7-AmLSICRnkt2g5Hn8vITo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_wfVVR1cCnkg--4E1ORAyUvAVp9zrv3KYBqfxIM-MWQ&oe=69F9F80B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6opGwFm-O8Q7kNvwE6VXsC&_nc_oc=Adq4Y3ucK55kc_RyVKL9jjDbAessF8gQfWVZdUtvSvhbXForuKNZ9SCpKQEQ-aQeAv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FLvLxAg15y3K4p5Zs1Lgalr5sEi70624H2yb6Kxax1Q&oe=69F9EF9E"}, {"file_name
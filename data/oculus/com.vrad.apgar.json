=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UQKXNXitEJ_d3fPF8wbk-Crb1vWaVoUWrIehxYbycdQ&oe=6A36AD1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-wFtAfV5AAQ7kNvwHAceh_&_nc_oc=AdoCdPgC1cS2R06Ieac21kWYks2NGh1oO_6ySXDOrLGNw7Pj7Qk5vnFIagTZLABGvsk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1b08VsDY4Da9b5KgMzf5nX9ujHULsedLwF4NYlmfJ1Q&oe=6A36AB75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ro8Xd2hYE4Q7kNvwHDQyJj&_nc_oc=AdoiCeMMM0RHEL-bVQ5VZmSTqH2ZsoHXrKXqV3K_QXz9FRmuFFFV2b7phf3iTyTzLVk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wWX6X1pKx1Cml6-XgjhYGPkUCU6ONhhB81dEy5im_dw&oe=6A36AE36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjt99bPP6EUQ7kNvwHAU8iA&_nc_oc=AdpqN7peaneNo1ShIZsLLcgzMx35sSYYw-1c5muruqmDq-mcLlt8CxT-bK8FifFYKQo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-BVhRZxwOd0LiqBpGDCxu2PlnnYKNp_kwbC-nO8yH4A&oe=6A3696CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziaGhDQmLZEQ7kNvwEkyEP3&_nc_oc=Adpw0m7DKW9fFU4-9bWWDTvwnCzBckpf9x_5xdsRNR4_2yyDpUYxq_8gLND35b7mLOo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GbEJp7EuKIqX5x_xrzPMD6oDFHkLnrmJ4qJ4tyvv4QQ&oe=6A36A38A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKpLSTyUwfAQ7kNvwEa-uNw&_nc_oc=Adp05ZFj9nVId0IzqzfHi976DYOe78qzc9_HDPOTFbf932Mnmd3v5GVzmZU-Ty3LCbE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i7oLsB-X3qI4epuc5hi6YHeP4tW2tkFKT_tYYmN9o6g&oe=6A369D0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUe5MkpMZrEQ7kNvwHCrn--&_nc_oc=AdqSKYCTT0j7bFnBIbUGgzAe5vnB6VzrUDBGxkTkf870Bd39DhOKFl9tVd05zGuvQ8Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JfjldAB_FLc390XFHqyGwAuAP0BvYsmNyEdE62o085w&oe=6A36949E"},
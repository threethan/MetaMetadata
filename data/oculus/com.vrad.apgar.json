t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMUrBwZ-DBkQvhQx7TWwF7ZkJXyQahbWgOWLa6JFupQQ&oe=6A7B3B1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0T05wM0sHEQ7kNvwHy9yEN&_nc_oc=Adq-NVtaDwHJ4BHpgBU245Z5otFG3IX-ilomUy_lQvI7BtlwOGfq9a7TZ0hiK5pqywI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjEjb0_k6v6v6-QtEwFhIvGwbGyqqisoFHojogy14zgw&oe=6A7B3975"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q725zFrAiXIQ7kNvwGkO7w-&_nc_oc=Adphv6F28Qyf6kGeE1jvwTn1rm07hROCA4gbNgm9lekWLfMoiMlhSl98uKHCAGJp0o8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV5kfHNg836zvAUtBuJmffHVlMqQGB1ncwq_DYVD25FA&oe=6A7B3C36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKKMPMBJWxoQ7kNvwFPkFfT&_nc_oc=Adon09UiN0vMiE9u0tv-l6Epuq5Op_lGgMoCe7FKa_YGOxbxn_Xro364bWKVBzChXWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHN07xdQoL2O_APqYqJ50k-Oy2-crpEhLbyZpPpbc6VA&oe=6A7B24CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKTZ5Nk7xsEQ7kNvwGt9HUZ&_nc_oc=AdoOaG7vKwuSrOynbspSqQo15LoNK-bSUCnR8NuLzXcNqUWeJmEUF5MHfM1RLRuiuLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUQnOt6sXoa_CUsZcpueMcjZyri4ti426ne50ghFNE3g&oe=6A7B318A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEC4RExtUsEQ7kNvwET-S-C&_nc_oc=AdrLAVkCq1cvqzw9IcD0M_vsygdWPpDkp8wh0ksuZDkJEMkjfpQDhB_ru9heDpf-HnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoHt-cLTKVg560nnmgsXdn5So6FSRYmS_VwJvgXdWfSA&oe=6A7B2B0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swmM55AjMZkQ7kNvwHmdvCa&_nc_oc=Adp4QAIIOCoHgZIF4DMrCoar4Op1hq2utlCEKlTEJalZXsDYPDEt_CI5cD3vLlVkPpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9QvDRw6ikuxg0T-fw6ku8b24xsaCn054NgOXCMAcscw&oe=6A7B229E"}, {"file_name
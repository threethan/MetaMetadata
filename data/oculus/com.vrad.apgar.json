t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-idUBhy32WfKpvHBlqHTze_baI8Am_PPQHWo773NNrw&oe=6A17091E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wOpjWm2zzMQ7kNvwF6ViX1&_nc_oc=AdpVOIsaG3286lHQlRz-m6JRwLsly3xMR8DlQzT9ZZ7GYGxsiqeeoZ7RV9eOEpc0xkA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UWwKMmOOHQ7IhrA9yrMzizGe2OqkAxDM-QWe7B02qHA&oe=6A170775"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvTRbXLyJlIQ7kNvwELV3zP&_nc_oc=AdooizJJY7lblnAlDeF1xL1djoCYw-YN2-DkYhyy42NKBNP-lv6pSSiLewx5ibv7Sfs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jqXNuQP49m67oL9R7YZzZayxsJzClYfaGYj-MOdECgQ&oe=6A170A36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9zpYfkdLDUQ7kNvwH3MYTO&_nc_oc=AdpUYfzYLOT3uYdxlEFgRtgK-h1IAkDmPTRy0Xz2fhTvXkk7VW-XkGeXsBgWunZPqIw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xsJilBYQLJ8kARCKz_wIXpGm3p5yXrmJ_6ByBcT-orw&oe=6A16F2CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsJ3peDNSD8Q7kNvwGXgK02&_nc_oc=AdrRrSrvpfmCSg4dohKyxxFHSPHtiunrTbxcN6X4Moc9QtvS0aWY2_5XW9RfR07e5G4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oIXtxvOD-M8-KMQyxfaqlZqpI2MetZ-A1cfQqOMvnHw&oe=6A16FF8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQIdhCEsLVIQ7kNvwF7XY9J&_nc_oc=AdpDXuquvQf3A7HcpJa1-c6w9LkJ04LT69BD8QwBj8T_mJqiFVhUhdvpF_XoFFTlIk8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pE9tBMx-x7JFa_3Zs4O_uYfDw4XwCL5gf-PzljPeGAA&oe=6A16F90B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FcDJr3aHx8Q7kNvwGcJ1YT&_nc_oc=Adr7vM3bF3vaFU-2Ih6mu9i8hL35FV1cB7JtfJSSC23KYuUnNmhE85uS2yiXbjwcRJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n6cWgBJyasXHC7oNaggjd1GX-Uh-0L98b-ukOf6r7bA&oe=6A16F09E"}, {"file_name
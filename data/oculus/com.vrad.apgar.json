t-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvbVo3y6iWY0ThoM7EAfpiUxb2_v1obycqbz1JKXXrcw&oe=69CBAB5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCj-d4IsmXIQ7kNvwGY-VrC&_nc_oc=AdrWWKpqRWCNRrmHQeo9Pf50JaTT1UlzopluzW7_lTJVAWYF9xNCBYEA5NvrzYpImhg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1c3ZJqRobx1AfgSCcpKJbz3fJILESlu50iytnv9jenA&oe=69CBA9B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzC-0C3QaOkQ7kNvwFOoLSZ&_nc_oc=Adqcnsjd_J_vCStRI9ulsuRgE5s-QoaqKdrPQf2Mb-gVk3-vq5e4kG-lPTk6O5thIOg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_uetNN1B3B_sdwbf152KhRQReFpFeTvQ7KBY40LViJg&oe=69CBAC76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er51gHSYKCsQ7kNvwF3LY9C&_nc_oc=Adpaf1xjx3VdsdfV2xJleFVFVb54z5jftccI4FYqsUDCGhR7Vj7u5FHvk-9HLDNPkcc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXWPeLF5uUu4fMftcHEl2Im_QEqUhR8PrBOHRFKCyTVA&oe=69CBCD4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfVJgOvHDCcQ7kNvwF5biJ_&_nc_oc=Adobf0L5vR9bDg1_GV5Xuag8GXyleggCqhwbXapJUxmHb-uybBHjLt50thO_FgmNgm0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8BFgAF7n_MrTSwuzyGirbgCQ5Zza5qUfstwcah7upbw&oe=69CBDA0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxcu9ZbR0toQ7kNvwE0V8jK&_nc_oc=Adp8AZW1EXaBQ0DASi79vnWcsuAdvTWmSbfA4jfxLw-3GoOmND1Sr17Qt9Aot7uq9ew&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBrwK1c5rwmxvvn7yI3V7qHmDBq29MmU6DavZIYRb6Fg&oe=69CBD38B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX4YozYIlbQQ7kNvwG4FoW3&_nc_oc=AdrJrCS7AqiX17UojsBMRtt9CFfCNMZc5J2g0KDSAX2alWAGbmfqN2G5A7S36ZTXsq8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbdxoFYH7VvxxcNGU4T1gHn5ebutM6hEikdyol_q1VEQ&oe=69CBCB1E"}, {"file_name
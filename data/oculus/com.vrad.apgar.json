t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqfdGjqed08221KqBDsTcsxhbReYyq5zdmIefHHcf6Lg&oe=6ABE779E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHxaFdinjKIQ7kNvwGfx38V&_nc_oc=AdodPwuI7TX2gbAjmIZJ_xoV0zadhCYHagRC-UxaCsSlhuvkBQqEPwsMMGLI2WbY0FA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzxMgmoWFqA2FTiLeh7T8HITNoEdQemsNMagr9qFUFQA&oe=6ABE75F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Cxr__w2ZTEQ7kNvwG-0tv3&_nc_oc=Adr44kMOceFS_tGBYEOvOk1KWLKII00lY3ZoIEYXejUMXApzwuTUufL3OX0TYcgXI6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa0EEWNB4PP1h7ug01c2fWNts8iNuRao-3y8OLj126GQ&oe=6ABE78B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyOi28nQF9cQ7kNvwEtfPv9&_nc_oc=Adp5-Xlu0sYcB1knjhqrkLHDevVhWtParRL7V7cGOlu-HdZhJ9NjyN8sAdGqRS40NVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCLUByNncdKyh4TlLkHBuVjEHQgiBfsykv8laHh4onhA&oe=6ABE614F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t8HtkhbvdsQ7kNvwFJ--oq&_nc_oc=AdqsCWJEOLJkC3TEEJ0oK1ptBG39m44TOC_lrXuWHl8hJoiNfV-nSEhT4pBQecEOM6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPPpvhPOe6iljXrR7rBL_B_poAK2qRBk9gmqkgAD-aOQ&oe=6ABE6E0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIMwryKrBT8Q7kNvwGAsYHd&_nc_oc=Adp5VxOFI5ETQrARXS6zK4vKtu8ZVuaGOrfPo-cwBOXJQ8n9S52aZ5YARFNByRBp5DM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVjwwrvrMVFxZkvGuMkfG29K5g4oehIwooWPVS0Sr2Ww&oe=6ABE678B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFVdLI2jfAIQ7kNvwFtZFgz&_nc_oc=Adqudmm-9gUu1VXgYhWhioGnqNmpfRm54yNn8j0t5K1ECLESt_Lgw62LvgQ6VqMV89k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsDXgR0jLLDRN-_xgc3DSI5i0aVAysB1PngbtMA5bedA&oe=6ABE5F1E"}, {"file_name
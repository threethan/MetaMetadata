t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbjVWemC_gT4SLcqO6NnyhkJZftF3UbIaTWNA4cXhbtA&oe=6A49221E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YMHFjIxUswQ7kNvwHYmSva&_nc_oc=AdpsAr6m-DLjiHd8tl8XnXpU-rwZ8BZ7S0hTAOdJ28Kz6T088eaFJcERf446C52Hs8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYm6kde4tG2a7I9yi1C9ozdYP7vbRnrgq80h7vGX25bg&oe=6A492075"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v21WY_n-oNcQ7kNvwFBywPP&_nc_oc=Adr1KecVqBqN16oCUaseJD4cAvLf4YN33DKejBKbYB4MCq3_yMigIPJ46o-yzYy-MQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuuDYbCfbJ9IbMA7AOZJt6SPnPvDFVDvLXboR2GGq5sw&oe=6A492336"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXsSRQm41NcQ7kNvwFAZX6E&_nc_oc=Adpq-1ZAw9TJNVP1x7y99w4bdpQHL2-hzPnq8TlHi7yCyAGJbxTNe5zop-bhD7spQ1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7_Zmto9pPqKJgH1VmbiBMdLFg_SvyYC0rUtA9OyRk1g&oe=6A490BCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CulCfkL1ZbwQ7kNvwFZeJ_a&_nc_oc=AdoZKxY8KhzhuL4KAS03FVygvR2nSrDHe9BT_XlE4H7OsSG6Cm8LnQDUZ3pVHFWt5uY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkMfijakuyZ3ekd2uVJTblILBxPKzSM_btiiMiGy76vg&oe=6A49188A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USgg464kGXAQ7kNvwF1rvMv&_nc_oc=AdqraMT_txLeN8015qwklDRFAhKkGyWevYvKFDvQM9-kKqEB2qADYQTVEMMo3XAXIy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4VFHuZLwjEtqB9g_jEalkYOKp0kMux4KwL5O2HNKpFQ&oe=6A49120B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZVG0mnigvAQ7kNvwFqHHmD&_nc_oc=AdrzB7NO30lRUxTm01riraEt1FTD99zaDbY7XElLPNkXml5S84WksY615SIuYlyefmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAElo6AaDjbs4gLd2dSjhifPK2UfkJQi6umRWu1yHN0uw&oe=6A49099E"}, {"file_name
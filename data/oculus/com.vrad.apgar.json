t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZBXcWUwWl-NvUrSnVjUVhZHPtiFgHz8gQgL4nEQgoow&oe=6A8048DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8THJMDTU0VIQ7kNvwHU9uDT&_nc_oc=Adqmmen7wgtmL3-V80_gj5goctRnokk1Fjv_LyHfy2THFFd2pMyBR_V0QczSsHeKbHw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDqk0ptRoUxZIm2AbQUl7IKZHO_FbeXpmO13wH0LiIfw&oe=6A804735"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1fuefCRLQUQ7kNvwG1H5_2&_nc_oc=Adr4m5Rb6EW384H7MJaNTkg4iZUO4jAnOi8WHVlQHuuMxIBHf_YhrhP76hGNQfpjCPg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeBz6m0R7PYyb0pivXnKboZ06-OwWfkULcIKJkzHjnmg&oe=6A8049F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGuZx_cO8tgQ7kNvwF-A8-m&_nc_oc=AdoMQEMS8phecuGrG4c2dW5tHqyPPIpbtpeY66iMGxuKmttLAinhu7Y1WffdpZMSK7g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsb2UPIfCSnK2kS_GhUdpyWVbnWexpxfE2raDht9-7Xw&oe=6A806ACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK4WVsvvaxQQ7kNvwEbuiek&_nc_oc=AdqQ2C2xfasJAuylPJCU42MGXeyhUOeIiNz0olxJGBi2ONG62HnzPSHIj6qs-7uki7c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsvoFzqvkYDuho6XSttm96q4BrPJLw2y2jxBLUGqYbQA&oe=6A803F4A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqcB2aEI-EcQ7kNvwG8OANV&_nc_oc=AdoTWw_LO0qMTMsl_-ERgw7SzfBeZcwOeznjwkz7upDrrsSu9fCQ0sj6PbRYkh9Xc38&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi2NJg_q3-OS1X0CsYuT1t1oj5dhB0zvQSA9_-Du_BCQ&oe=6A80710B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzg-YGPykosQ7kNvwG7PUpB&_nc_oc=AdrlT3_0-wu8vw7ccOl5BpaUDsk3Prk9JALWwB_8PiWthQIY_inYnDnFEzhazFPiZHY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuNlcAWqiB5297G3LkEwoMTusxmukg1vsPrqUFHrS0Nw&oe=6A80689E"}, {"file_name
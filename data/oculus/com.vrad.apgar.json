0_AfyA0jk4R262uOQoPdr-NRV2ijBgqcQbpYBoev4MBJn_iA&oe=69B14D5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOefV5_lXFoQ7kNvwHubrsV&_nc_oc=Adkhpu6C9QlyPZVy7QaYSVCQVh_TMWTO5no-eETp160OvV5nEIpMqHOx1UEXVeLagwY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-IuxSVBspLPK3LpfvS1Lr-8fpriN1ur1MtHxCxDnA8g&oe=69B14BB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcBdb3Y5RC4Q7kNvwEcdD9m&_nc_oc=AdnaKS8eY-ZuBmkqfYGoXcB8EsjgV03nMvv4ojfklyAtiCdPs_akyKBPA5D_TyJrF5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afww7UAFmB1017aYak0Mqoi3OotLlxYkhjDIk1sIRSBvVw&oe=69B14E76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=203n3v6Ooh0Q7kNvwHEeIR7&_nc_oc=AdlfFcRMZeR5z3EkmzXGa5lpb7MSqCcuIZS9NRZ_fdUvYqqnywGYtw4RvPU6Xsn0af0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1OHe2wafOyCh1AAUG8S950FZ8AB8v_e7AP1gH5RdsNA&oe=69B16F4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQjy8SPa0VsQ7kNvwEo_3Yf&_nc_oc=Adk-27-g_Wm3j1pRE6Qlkd4Z-iTZgUid6T21sq_qYzyFqfoGi9DlfwxqE2dVnVoWB84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUVNFn53esJKxUv-hudamwmsQLcoS0phQ-1gcHJqwUbA&oe=69B143CA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40ulAXML7BAQ7kNvwEOgckX&_nc_oc=Adl-UmoX4Kad2HhkCH-RavtLj8i0RmxudPee9x-y35X7MGEUyqe0qP7lqVeBvenmFsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC2-c5y9M6OG8tAZkAZ0Hr8XMk-gc4SyE9QFD6GYnOww&oe=69B1758B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbn8wou1uJsQ7kNvwFJ4P-U&_nc_oc=AdnA-MZpxg2MGj7lW8JuuL1WSFBSF9SvJz-90Oatu14HLstyEVWa0T7E1J8DUod797Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMI4AwWEF7-0DJFk7ZHvvOsZ0D4Z0-itIw52uJQjUiAA&oe=69B16D1E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
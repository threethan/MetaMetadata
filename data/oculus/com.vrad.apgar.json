t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7g5MiXoY0n97rhRiSa0bCtQBr9o0qONHgmR_bgEwbtw&oe=6A428A9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRLJDwIMfPwQ7kNvwFmwbeF&_nc_oc=AdriEV640BSjuiMiHbbGO1F4yhtbQfUuVlAxKSw5ZhYYUDwpAuf8k3jgOgr2mQbi-yU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HXmHQ9jMJYYRxIZUkk8jhY5r2lvpUenUST3pJPpCu5g&oe=6A4288F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEIu_G51ILUQ7kNvwGgDfjI&_nc_oc=AdoX9JbBOTSOEvlwYP9tcwDq2aNHjPfnsGISd-fpa0b5SeENPFs2utTzkT33jit2JmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eqhx0H04HUIF-CSUGRosPTKZ1TrW9F13GJEkqEpqUhw&oe=6A428BB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHmBH4as42sQ7kNvwHnbpMQ&_nc_oc=AdpKclNM8XfczEMEbUYq5THv6moZed4EjSaKKdwCR1An_oHEL7o9f0NNrIHkgIll2fQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e4JZF0tHwFs7yN8M3g1zslIA7agWAvYMMSntxRNKmTA&oe=6A42744F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYAQAylRsfMQ7kNvwGmPKX1&_nc_oc=AdqeFCqsm1P0cEdPH9QdAP6EbGx5F6nHb8wh7EiphgZwcPstWHX_4r5smMuSYIegQi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83TfsFLz5fbAJWy4V3Hn9oPt_C1NpeiMhRBY9AxNrcPQ&oe=6A42810A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUGNTxzFnpQQ7kNvwH0mG4i&_nc_oc=AdqgMyaUfV8AZ2tcxq2dhIMQjh05EAhkGeoQoqXMmsICSVYBImuX4X2h9f20Jx2ilxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RrM89dlm1pnClnNDR_e796ZMpKpVsGRXZtpsWA-0zDw&oe=6A427A8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=875hfb4cjcwQ7kNvwHww0fZ&_nc_oc=AdqngZM3yuL5msLhDkiDjpKwxBDAxDw_SVoAPadrSvXUoKWfGqBOpVEEtgLIzpc-El8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kw5viFCSfDHd99EPdE6bGB9zOHE7F672gefsMwb9kPw&oe=6A42721E"}, {"file_name
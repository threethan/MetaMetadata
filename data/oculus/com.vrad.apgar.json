t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pIZUstDBhd8t7gYetKytx94sHyx4WlHEdAKbmNIkTIQ&oe=6A24381E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8wG5oDudpQQ7kNvwEIoXh9&_nc_oc=Adqrz9D2Bi1-k8ZqYoJpMqvyk5MzTi6g6WfPX23PC-2qKX2b8zCIy1-Iyf20JQDNg6Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OClAolgk9UJcx-MCXFo7GK_zTS-h_jrPhcewx29AxMQ&oe=6A243675"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTfACB67YBQQ7kNvwEMHjtt&_nc_oc=Adry9TUONoAs_R8-apMd70f3WAw0Eishr9P2vuiKGj9F1EuOPOGNi-fIHoBo-Q2cJvQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xtUEd4x1eZPMDPuyBcoydXfOTlM2XNv_8GQ32IUA1Rw&oe=6A243936"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfN5VEbl5PcQ7kNvwGw5IkM&_nc_oc=AdqzDHWKZDPFSI1NDbnKyKUU51v_KyVFX1zdtbEDOrkYd7XFvlyP5pgWjNJiUohi55Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iBlhtd4n_DiAaCVUHHxbzCvMzOp9_RIG1vYXGeN8b4g&oe=6A2421CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3RdHQ4XEP0Q7kNvwEbru9z&_nc_oc=AdrEWrqvoLFgVnu8aMzdtY6Wrgo3RQhtRRzPiYueidVwUkk5obldIxYCD23lN_Vn5mc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8svhxNcUfmkqvnnd1lfBzAN_lABiB7zOxARxJiLuZhqA&oe=6A242E8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXT4hgVnDw0Q7kNvwGMMsGh&_nc_oc=Adr--UBQ5_Y98PfJkhHavlkwLtje02Ctd2IjGKkiwQeCTLXmmVr9H65woYd6MhRPXUA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oqzu4BpPtOX-SjDStWIMYeVq7JpcBoXLrozZFI15iqg&oe=6A24280B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gc8hS2XYzUQ7kNvwHvFsFG&_nc_oc=Adr-D9J5AGRck2-4qROXVXM2hrLRleWzIWaRnElQ6wTxHsoj-gMa4uC6N5w_Jx7EA3M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8itJPF9lcBA645uh07gGsbPd3wS3VQ1uORBHrq3xKSvQ&oe=6A241F9E"}, {"file_name
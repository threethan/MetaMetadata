t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQsjZlrMg4qZwC1T3WB6J8zEL8ST-FjVt3njwZ-Vd0VQ&oe=6A843D5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzVWTgAPbUQQ7kNvwFbRn0Q&_nc_oc=Adqv0AfDGdj_wj3TH6-8jg2eGznav80BLtP9FdP3KXFPTJaY98oEBHrpOibNS0EO_so&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVduLmLHoTqc54Vq5zbgCY3p9vrUO4WafiuCI3sLpd5w&oe=6A843BB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu8oiY-e4RsQ7kNvwHvpJns&_nc_oc=AdqwfwkygMGzKyh3McsP-mGw2czKPAVTHmbiP-C3NPhjf_59QLgsgKILNX-Y_XyOUQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmj8EKZ_OGAKUrBky6tomBwY_AawGSdL2mFjWB9wXn6g&oe=6A843E76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iykANgvXH64Q7kNvwG7yqwN&_nc_oc=Adohgwyyv9f5alxzw08sPPJ_Mxd49iEvcx1XiGsd3I-4DyEEQ1OO5_rKokHso8N3aDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgL1N2wZCmMXimsa--bC8mWmXCUZm5bSU-8xC2VLhniA&oe=6A845F4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aGmHhCotgsQ7kNvwH-5ax5&_nc_oc=AdrzM9FZYJH6CJOx4xKWpHZW_-aAgH2_7GjW2mnWsDsB4441Po02VYGCP8CqUiS5-5s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoABozLi9yeWQRaavC6kQ3OosLgxR-oPZ0GKq7zuRreA&oe=6A8433CA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOApb7U-V4UQ7kNvwGZGNo1&_nc_oc=AdqwSxBu2gv4y-RyLY4emIeRLuSZSEuzSgFxPdBw-gAtoa5bpePjJucwhEykBN2dswY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjNy32iJITqz_cEv1O6v1xNN2eg1dl3gUjrgklEX-W8A&oe=6A84658B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgTXMVrOQ4YQ7kNvwGN03rS&_nc_oc=AdpXWOseQ_p8Tp_022vdCcjJFvEa14Q1GMvHh1XqWJhO3kXo3xBId7x7v7zbShEJXz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJvXuIg3Jt8QAHLDTOlozHpYQIr_yVAi_cCv0_RAIjrQ&oe=6A845D1E"}, {"file_name
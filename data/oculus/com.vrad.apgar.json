t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeweCAxbeA-Ch23_ds-epdt8-1MIlsr7ztBeQtP28hGw&oe=6A67749E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-E_N4TGgD4Q7kNvwHzSIDM&_nc_oc=AdrHU6-RBr3LCGURuVvDnQ4TcySOJQKxybnqhhvmxrOIg8LnhUiomuE-unOBUxmrvrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7oZFvagziC50JyScKH9JW7qyuu9qMFKjTwJwrwoW0gg&oe=6A6772F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSKwAfB9VfcQ7kNvwG8kUeB&_nc_oc=AdrB3YISDUWGQVl0-ud5VHCIFxmfzUpHzHtkbA5Tx2wqVtwwl96uayy8ftXT2ldikSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmNAUYeY4ZjTNT3xSOFeRwJRNaul4HUklFPTEO-dGHIg&oe=6A6775B6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnE3gP58ipgQ7kNvwE1Flct&_nc_oc=Ado_vJ40_h-wzumyHcIgoCbnl4K8l4CuO2IqpP-y0K1MLPWmXDI-ZkKBkBhOy9TJhhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAftjTzr_cebveWusMIYe76YpZ3CNHs8c1Dmf6T079V6A&oe=6A675E4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt7MnMkj48UQ7kNvwFukNkd&_nc_oc=AdpATveq0KMKHe4O94IQqGATg6pzJ9aekrnGU8rdYU3iLeykml1_XaUhPbL3kDwmN9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrMAvu4nNjx1NxloeNFBKyaS2flSgHVxxwF3v7v2dk_w&oe=6A676B0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvwJDAn2XJkQ7kNvwE7HVMK&_nc_oc=AdoC24zjTtX3bayssdd1sgcAVoK5tCJqrj2s62Dxo4ytabH_y9S7rDMZkKOHT9OtXTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfVqsaVbIqlGzD9g3A7wCx3IevvWWo2Num2Y7pR2twhA&oe=6A67648B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1n0_PXhHXEYQ7kNvwF0PphC&_nc_oc=AdqpeQwhPaCYpkQgk2D4RDKhM3WbDX-rYEu4L3gZJGbgVcREFZyAW97ECzhcyxxN-t4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdKKIS86WJXWBFgjWBDo2lXbLgCWrjP8orsX_xYDvW8w&oe=6A675C1E"}, {"file_name
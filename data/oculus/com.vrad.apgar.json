0_Afv6nJvxzUe2X0ImoXiy3d3PaOAh8KQbGAsSQocNchqssA&oe=69A9645E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVDRCOGY1pgQ7kNvwGEybEW&_nc_oc=AdndlROyCNVk1om9qRpNjw-v3DeXuugSqDGssf7FAD-BG3E027hHID2DEC8bzMGUbyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvMqb-D6Mr4smvf78y0fgacT_EqHYtktgM7uoKnwjYhAQ&oe=69A962B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfh5pZrUHGcQ7kNvwHLnE4s&_nc_oc=AdkKawVHAiWN68yEIf8_SNO8z0sSYNVwO7dhGGOQJgHoAXJqXXtllDSngYV0WltKYS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsolqFaQof6j5RrTJBdNjvnN5FHyLOjlJ2MnJ8PrvR0uA&oe=69A96576"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11hvcqEQNagQ7kNvwGAjedw&_nc_oc=AdmjRgvA1l65M-YYmjYWAmpMMy7NBBbrv-BjyhYI1eQ1NBF60rGQJKoeO1ILgkdd0fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvh_D3fWF17gqsbJlsfztGzOnap-6OHe2bhhitymDzeqg&oe=69A9864F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5_4c-hIwlwQ7kNvwFRIN9y&_nc_oc=Adm5wNcbzVwTVxuNIHo6FcCAcb5kAw3R7GJoexP9jRPfes8nzA-ELgNtx901Hbz0XiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs9HUb5lsCieVy26ZszD-Afqn7LBtuWqkdfLF9tsuStbg&oe=69A9930A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7Dq0YGMGeUQ7kNvwFeBR8O&_nc_oc=AdnxcgH46XmvSFna6oMcaHyKenCCZ4kvBkmggUykgPSBLlXj_n667fLPRoWXKNMVEwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvydx18mh6EeLCfAABW4C-ANfzYhOcBHT_mKYjBKX-jLA&oe=69A98C8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnRMkKYL6p4Q7kNvwH_M7vH&_nc_oc=AdlP41nNVFA7s4EacpiFCqmlSRVarlJwfg3IvlHeA3yMveg-fLX0DdW-PVahaJviZFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs8Mua-0SIHJm6wVj_3MliFUFNy3qhq_H1z2ou0FFyFLA&oe=69A9841E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
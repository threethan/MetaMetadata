t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h9MbtTzMuVR8_6jvLIO7k3ChX-t1aKVRD60FQb_0xJw&oe=6A0F201E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZPNbbPdc4AQ7kNvwHC5R79&_nc_oc=Ado36Ct7tNnn_-cyloHUuNi4rRU0aCVqNWF_kuz2fWG1cL6lELTxzvETpcB5KY33z4s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MwVW5kz_grK77o3_SJOrTcNuUyYq1Gj8ns5Yy24lVQA&oe=6A0F1E75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpGfN-1vXp0Q7kNvwEsmmes&_nc_oc=Adp12AR06WfltYCOETYbXw8JEBY-KUjo--jCckA73knGHEmu9OTtIXnG83J_qeFSQNs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cQiKY0-V-AfqNrCZItKsCPmK_L3e6Um_UDYgcuEq5gA&oe=6A0F2136"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YVV7NMNfSwQ7kNvwEcZwVi&_nc_oc=AdqzjVRvs87sUaiL8--nwz17FVbUfzdnf7ZlY5Y1xsluOBiEL-vOB0AxSPZoTr8AeLw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aPnN_-jIdgHc3wM-8Dypi6MMu9iUQPsAEq5MGIToX2w&oe=6A0F09CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ur3Vrhvp86wQ7kNvwF2hxzT&_nc_oc=AdoRlErfMpXL8f_cHW1JAlBzfpRlLWXCxoGWJMR8WUTK2S0OU98y6H1EIL9OBv6lR00&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RzEpYF1UcLsMZj2-m9Z39_riV7ABq_0fJw72Yr6-Mng&oe=6A0F168A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyWEodhoJ4gQ7kNvwErP0st&_nc_oc=Ado5yp5n0Qf43FZP5pEwft1XdOqYdEnEHlpV1JxySnNT4In2S6Da8q5eYjnbWlA1pO4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wQYsxXU1ld8bzofOBaZuE4VLld3hMVL7MYmInZn7gxQ&oe=6A0F100B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8-WnKoK_ysQ7kNvwElPHC_&_nc_oc=AdqSdfDCD1-PeyOTnAgn5bV244VzXK4rPgEa0LCja72QZgBmYX9DD1BBZqZ75YeH3pY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L_6KcvA-g7hZeokhq7Z8VFqenQiQG953mDoI_cNBE0Q&oe=6A0F079E"}, {"file_name
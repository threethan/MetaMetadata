t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E7QyPCzE6S4Atww4cx3cLRmH419_dVUbwZhguqs6ODg&oe=69EA361E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMcx9dFwCakQ7kNvwHe9VB3&_nc_oc=Adrg8lcwSpTjNi5mpz8njU-2HO_9n5a7rgnIaufkkdrJpBeWSy4orkKELYbR7Rsvln0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zyYUhRJZBhWF1i8KsfNmbP0dKjVqW3Q6UbWN59_CSNQ&oe=69EA3475"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAwI_OMbjzcQ7kNvwE6sX6K&_nc_oc=AdqQ89sux66BavI4Q3THvOVZqR7SgJ3pE7aQ8ZnOaXmuksB4XV2G6swbxwkQTHuekmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s6pQxGmx3r6RKOUIlRmILkW2TO3ilU0xrN6rpr_U_iw&oe=69EA3736"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkzD-JB7-MQQ7kNvwFDfDj1&_nc_oc=Adr8CXfzvgvLfivKufPL15wnVMQSCmahjounEIqmBQHh79ieS401PCkhZvtZJTigokQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tLO6OHReRq6-YHJEvrckUTKisDVJKcZS94awBd_Qh6Q&oe=69EA1FCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3StVqCiUqLsQ7kNvwG7oIu6&_nc_oc=AdpXg9ncBE0_Jat2NSagZ8szD4IH8pkI73NvKYdqZsZ-Frk6KPwifgllHVaCiiZgm5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Oq7OdFeWfD418fnKFlquR8pV1_CbKDyt5Wl6y5yn3VA&oe=69EA2C8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg9PKAx5__YQ7kNvwE-fiq_&_nc_oc=AdrkXTiXw7SIfmxGzx14-zugcSW4E1X6j-2lIhi0Fiho7FbeC_jgCHNFUTQvkIsE9xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_TCVuZMhIxkxr5s9HaJ19NDEhYIg7zIrGHQhLmYSyMQ&oe=69EA260B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBsieK3texAQ7kNvwEopH6Z&_nc_oc=AdruZw_ppWhAI3MczdSbGudi916-OAjxlydDcWOcNj5EfCiMh3GtPt6c-M5BjGQdSXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rcqQLPUKFEtYcX8LJPm6X8gBmqNqkl9jFCyIWAxfSlQ&oe=69EA1D9E"}, {"file_name
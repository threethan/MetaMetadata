t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGTVZrehkDMJwi_AdNt4txgReIzCAChKzwnXfGrITnyQ&oe=6A69DF5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M4EhjM6IJgQ7kNvwFJ9OeT&_nc_oc=AdpmVXvn3ehCUYzu_qeTVvR7LaGUsDCWp6jI2QItOU-GWtJ5h5YhYXgDM2fVSAjSWx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeeCITD9oqptl6gFT7AlR2yvAYpVjJu8Wcx72pBTxzEA&oe=6A69DDB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dimu-NJV22wQ7kNvwF4yHks&_nc_oc=Adq33d73S2r-fr2wPxzFZb_YJyp2WxwHPnTO26w3OP3QsXVqZmQicNyjCpTldcareVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv8jN52uI15M_z_5wMYRxrGyborKpfwCasKuU4Ikk1iA&oe=6A69E076"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maG28cz11g4Q7kNvwGruk3i&_nc_oc=AdqY8BE05CsB0n3fM7wM6uhdSFxRchZi5Tb3OQrHxCTBRDP2VVzbjfApVbOeNz0nuV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7J5aT7gAc2GsEQ8lke03PLmiCtWCab-qe0fnUeW6Vbw&oe=6A6A014F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_UwPLokOVoQ7kNvwHaMK4R&_nc_oc=AdpdY9hUBS3xOQaS3DzkRIoCY5Pazx_lMkR384FDcv5KYrP8qFjtRcw3ZARpv7oNgBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6F_de8pdQWg5A_gB68KMh9QznAgSTkvWRJ4DCnpJSYQ&oe=6A6A0E0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvwJDAn2XJkQ7kNvwEDX3Qm&_nc_oc=Adp3CRomGe-bvs_05XhZ8iAs9eWfU7vpzxYhYOvpYf_wzmxxwCCsw_f4pP02WMoLcWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFZ3eRSufY_uuxLKHJ0Q_tBFEhernITwlrmaQW1OlQ2w&oe=6A6A078B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1n0_PXhHXEYQ7kNvwFl_uPK&_nc_oc=Adrsa2UThgNYyUj8r221StcKaDSN71SW0bAMhXHj9E1fMYKokJIlzKLLLZiliQ3amMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDibvebY2YwBvUs4bgK86s8B2l1HIO3TiBjgTM4BJvpFw&oe=6A69FF1E"}, {"file_name
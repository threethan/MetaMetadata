t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHL8jPCldjHNPSrPpM_iMqDDNHj_lCa6q-1OfIJvyhoQ&oe=6A5CB05E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZf3JEEGaJoQ7kNvwHV2Rt2&_nc_oc=Adoft0Z8Ny-J82sjKB8ie_uagLtrokmMd8SsQ8dElH7Xjph14nFtNkzjf8G4G1b7Jsw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAduLh5XRtnV-J1-3WQDtBl17eh10tZtqPA5O9vP-RzRA&oe=6A5CE6F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3cMy36PoQoQ7kNvwFTzBFg&_nc_oc=AdrKRmbaKMYl2jjBEnaVOkFURdd9yhUMdOPe5pypx6AC7kVbpb0dnbA5DeveZfxjPyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8h8QbhRPa6HADNPQY2z7dYlFMGrSp_z7v9sWwhUj9cQ&oe=6A5CB176"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-T7eCNj6K8Q7kNvwFaL262&_nc_oc=AdrP96itqoLf7H2PHePK8U18kYHu6z5LMkeeVOpq6njGvlQTfinUBBnAS1jbQHDWj8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHC9pVlMe6pwQsDYOVXZBp66AX71Cxfb6-s4MghR4syQ&oe=6A5CD24F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JHWsHzyMaUQ7kNvwGwQq2S&_nc_oc=Adq8zTdeSu4f0afLX8KOsKhzsDEREKoup2552x1TAJAzQ-uO33yYt72FNBjMVu_pvg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqv0P15zCj_iE_dSQWe0Fe_MTam7dSmpod9WKLFDRWhA&oe=6A5CDF0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9dvfjXaBXoQ7kNvwFuvl9o&_nc_oc=Adr5t9dCd-FjdOLF2Ve2uG11ibs0qealInXwtIXRDkbVrqlXhAUmh-lidT8odSCeeRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxvjNT8MUm5DJ012MtwDeJGJycxdeFaxw5PKafESy4Mg&oe=6A5CD88B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bovIWhkpCD8Q7kNvwEgbqb2&_nc_oc=AdplOrEtohSFg6uoS4R5BpWmfcX8vv2L9xM70SKU46nsAb7vkWfUi51_BgeljaVtF-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ5fjOBuIYn0CjlufXlX69qdXuiMG9KUY0XUD__s6WEw&oe=6A5CD01E"}, {"file_name
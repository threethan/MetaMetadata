t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqjKh6mrziSuZbrV7plU5isnmtvZUK1H3Ufrdv8aix4w&oe=6AB53D1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o-TYe7BQyQQ7kNvwETp4sO&_nc_oc=AdqNujiwogD605BMAQ7XiVJBDM1_XDDdtFF8HKHw7H_1mLhtS4X7HHiTo8c26rx459U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKemCKfFnO433Wku4Az2IKUxIUdX_nvyjK2woj8GHMSQw&oe=6AB53B75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8u8r8iQ77YQ7kNvwH9Q8Xb&_nc_oc=AdoKpT6jUTYwoO3tXsXWW0jy96f-zVEBuTUbB2sER4ednD-BIr7TtdBjyKDsuwRBbt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJN-y-xCIW6yf2I-XuKvzKkNKB2ZkI4RQZjuuR0d_7tg&oe=6AB53E36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F4gl5fh-ucQ7kNvwEa0Sf5&_nc_oc=AdoHvQCIOROjToZtBNQebLP9j-D7fr6DmcOnz8aRTR5GJWas5ljKVrpN99gqvFrsxI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoJT1IlFjzlXjRxqAEIkJ0IyYqG4H7VJi36nV395Dkww&oe=6AB526CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-nCqjgHvZYQ7kNvwGEuoKX&_nc_oc=Adqc6i6Lzbhg_9MCMbhnHYTAx0lSjlg2j4WKhPYml8mJh72_cusB-WdfXV-dATA1uOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISrJLgtml_jpfEe9Hwfh3w-RjI4rbolTex5flgxnw5yw&oe=6AB5338A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvGFFOdSLPQQ7kNvwHMqmtV&_nc_oc=AdpyiOKN2tkgi8iuxnwXgkkLNd22dna0dq57y-IAubGqw0O3qxS3C9K-Qd5vTtpR5VA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_IkjhKIgWxHGVNmTlpXzRqxvi03Mq80yLLeCfy_tjPA&oe=6AB52D0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXH0tc-84RsQ7kNvwGYRXL0&_nc_oc=AdqNOxEZYb7TaKd9vNG02p2-cJquZfLbIzJeim3im8W_AgiWEIwRWbsDEsqhFZwO_Js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2YfU0Gb-I58MWRdkWueVghri0Ng3LoPdlmCO3S2d86w&oe=6AB5249E"}, {"file_name
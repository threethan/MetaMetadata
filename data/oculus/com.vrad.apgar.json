t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWf9NY6YuZ7XqT-f5pt6HyNCYNnVEZWPUOlZzavuHGJg&oe=6AD23E1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrvsxzPFceUQ7kNvwGzNgAI&_nc_oc=Adqn7ZlYrSVDSzO4lm5nOpTTwzWF5SHkirkGrG8x9iS4c6AEMjy9lw9GseKC6FKDAeY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMWUDb0JYMO-2pACwlNo0gIM8QJ7JsrHXZ_3anw0wWRw&oe=6AD23C75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsMJZc7Rz7cQ7kNvwGqRYxw&_nc_oc=AdrqlyHfaTIDMWMQRcoCkIRAWMfsZcv605LymlRsSGRTZ0ORlMQrlkl6qUcM9J5J_CA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhC-3ZUkzOFSQa_k_OskElXEXmBYNB8vxCoYfasMsyVg&oe=6AD23F36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irZt_COkXqEQ7kNvwGWeh1l&_nc_oc=AdqtaiHby1Crjestogj2t64tgxJHPi463HPWupfDniprAPML0bm4yhGj88Y9K4x-b3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfYjME4gNCIbOsH9qBtAPEH8y8VcPG2tnWp-bHBXWlmA&oe=6AD227CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA54VQqO6ZsQ7kNvwHcLZG4&_nc_oc=AdpFlP1wi6SBHQCVEn9elfFFn-90-mAwEWQKsuPo9QEBtrPlzw2MIq7XDqKDi9G-Z0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKU6PBe0U7VZ8w7LVGzWTkOkSmHcD3ZUfuToKmBlsCOw&oe=6AD2348A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zcbd4xAjSUsQ7kNvwEifQj1&_nc_oc=AdrXhbhSOVLsUnAwLGxhOH2iURBb1frCMqZ5p9YRv-XxCc7q63SzAXwq2X9CV4I51XE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWGvX_rkRxMmXdUTnjqrvjWIoOVxDTTBN-E_27TpSr1Q&oe=6AD22E0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-sODTI7fQ4Q7kNvwHPfeAj&_nc_oc=AdpPvKD1NuTNgO7tabJr7_KX6klSHfUmAAseKvJJ5FqgGhvbaA1fov36738BvS9jFKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh5GV-PLe-M7ADGerdYV_d65tHmiDXI9Xd6bHwpdGfrg&oe=6AD2259E"}, {"file_name
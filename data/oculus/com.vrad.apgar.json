t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaVVb95No2DpX9E4I494QdXorfGzbZWvWTG-Mr8YDlAA&oe=6AC50F1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV9VNR1hQj4Q7kNvwFou6W-&_nc_oc=AdqrCTK0TygTXr0roZWZDx99L013nZeRRT90dF2YKaAtS6qzmLcq_vyTVMuiya-PagE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0ovlC6HFtIewV0mLlvl9sQpMgMjsej-MgT9lOtv7dGw&oe=6AC50D75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kke-47vKJqkQ7kNvwFfwhpQ&_nc_oc=Adr4a_aXpHCjVkZdGBEOWbdRyolt7xu_dA-HBwMo4OZr7btNsvTGFwP6U69Eb81iiwc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaBJD0dfQmTzn3R8NZP_3dOouVr8QsHg31uaaClqC6sA&oe=6AC51036"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7qxufLFA9sQ7kNvwFHd0Wv&_nc_oc=AdrgeBXEr8cYN9rKXN2sYpmAZIa-BQkyu12RPZaR9G_zOgz-Jp6X0oO9SBUQH6nT0hY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTUd3KpzCHsX-aaUb_73CvlmRLQ-zGYZzK3GyrrrPHpg&oe=6AC4F8CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slnseF4cXeAQ7kNvwGwOres&_nc_oc=Adppj8fspv-nVqm0nU7o8rbzSD6RVMXVgsFBbtOgzbMM_4RF5rJAQyYB8XwlbXxhX6U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMntVirF2piyO02nTajUgz2SM5Ju90k8VVuluGeLI7Ngg&oe=6AC5058A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RocmPJzWlgUQ7kNvwG5ogEr&_nc_oc=AdoK8zkPts6YzUyqwq9_7CdODqgfq0xXwLm7Fgh98aWBkw6jKSMv3TGrevAXFSsdPmQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4fqrdKwQln4-7pafkH2G54Gpt3Ji4dXt1Jnu-g8TSHA&oe=6AC4FF0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2ngYI3_W9wQ7kNvwHIsIu3&_nc_oc=Adr9O4RdJHwGLmLLgy7e592oITBh2QJFvktOUOYg5kuRaP--_VO5EUSxJFMj95-UA50&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3qdU27oE3em9BPIDhy6Sry0AwNqDv1WKWHzEBlGeWvg&oe=6AC4F69E"}, {"file_name
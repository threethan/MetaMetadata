t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af552PUBtegT83i8zd7loB1MoF-Q_bZqz_BWY2M4s-Imjw&oe=6A04941E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK3SeoHtikIQ7kNvwELm6wQ&_nc_oc=AdqSt_Yv8AAXnCTlzDerEo6dKP90TTLFP2K92iCZXghm8saQRKxqIEoEGO1n8sZlkf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v44GuT1brBo1BheAhZVgnunOmXes88tp2pO_MW2auHA&oe=6A049275"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtlDydTAE9AQ7kNvwGX0fsj&_nc_oc=Adr9tMWa5t3uQLMJHPobtbdZsHECrlg93hzE65dtOcYhMzwWY_BbG2lv3mrxDv2JKUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hOip0xEGLd9gB5Bmz1CYHD7JOtNP7RLXCIKZSx8nQKg&oe=6A049536"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alj2WvuGc8MQ7kNvwH7xyAY&_nc_oc=AdouyqI_iQFjSyCDrOE0sBonJo_KVlgklYsdiNguXbXVsuII4cW2oGLEyDcC7p19cPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OYocGjh2GWpZ8UcJ0h33Wgxhj8XT6JcR7eRYmXBOtRQ&oe=6A047DCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm4ioEWFtb8Q7kNvwH9qs08&_nc_oc=AdrEK476BjvxtvvzN5QylNt24i9hdrnFB0SfZ_m5r7Yk3o6_juhdtV9C9IdqZOij29w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wAYCMuU3FbEr43CQx-n2Huxiyo6eqTpmR7ytfjsbuGA&oe=6A048A8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8H9201FnA0Q7kNvwG3ZGlc&_nc_oc=Adr1rluYFdEivbXYiOeQiSjzEOPwdDtuTriDKAALnJxqTQI1TbbmylEu0_5dKNjXeqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xAkXsQkYRmaUrXWRo4mbOyPO6ZMfe9DhyVPHMihEz_g&oe=6A04840B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfKru7vkoEUQ7kNvwEoxzpy&_nc_oc=AdrJQ-_Bdc8Cvya8GBhQ45Mq-mujVGsrNd9mP3agAPyBvF2vg-hcnZzL-UpeaYPvutc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wgp1IasZa16OV-V1WmTmsxvXzuHt0orBgiCYLQP-j0A&oe=6A047B9E"}, {"file_name
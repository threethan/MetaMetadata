t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86ESuBDrO4vDb24JKESi66jWKipQ7hrf00F9zoKLfGbQ&oe=6A340A1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Nd5cyhYAMoQ7kNvwEoSw-4&_nc_oc=AdqUfjzjrtY-SVyVb-PJglar9rwGbzBpzLHl6SsVh-XpbHrib9QVxuIGXNfN4T_sp20&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ONSkZzQKRKajGfGOTgvjom53kzu605vANkjmzmPeheA&oe=6A340875"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVy6GfHYF9UQ7kNvwGg1w7n&_nc_oc=AdoWm7zYI5ABxbXfls1Z5G0MYVGQo5IkPhykiwjvE1dSjFO3SpGKJ7EspFCdpF82-_s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9c29aOj-s9fqOD1AT1eewyQedDnI1V2eWkOsVL-05eg&oe=6A340B36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUdq31zxmlcQ7kNvwFeY3Ya&_nc_oc=AdqLLJ9GqbJJKEq1UA15IjkcWZ9Zj1tP5noxk78615e86g_qEqKCMOCZx9uDWMzCGKc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9olgu60AZYZGg9bT_BbRCm_sYUYSJF3Zlnk5Ej7_-3kQ&oe=6A33F3CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziaGhDQmLZEQ7kNvwFQyokq&_nc_oc=AdoULVmHEptUPGhEfPnTRMuPKXq6cu2XausKy9-u0Et5igP8he44qtAKWK5pPTvODEQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AKQ6tDVUFutbCfs4TTKAWRs_KdwCal6WnB8bUaVuefw&oe=6A34008A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKpLSTyUwfAQ7kNvwGEvAJm&_nc_oc=AdrV45AmToKbkP9YJCaxPVAktABPJuGSvon6KUK6BiW4-M-plG04bY1Ex05QCvUPKH4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yLXu-gyz1t8NIcOOKxVnvSxyBBGPwwQq73VoaHIzkyg&oe=6A33FA0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUe5MkpMZrEQ7kNvwFHU3Cn&_nc_oc=Adr095iHg59DIWLZ9MZaRTWcyZtyYytIB1yL8cthHACTjVg0iBITRU0o-Sa6dPZnBtA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-azQe4ytLS3K7QWjhsCHrt1BSY4dquHvbPTXdcrejM1Q&oe=6A33F19E"}, {"file_name
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcYDQO-_JSPJ0ov01GMe1Upt3U1kHV3A1u7I3ZvnnTjA&oe=6A78981E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0T05wM0sHEQ7kNvwHDziwO&_nc_oc=AdqD_V8p430qekxfrjsN3541Wx6F3O7GJldA3Y5sIDsh1vvQQUOWR36zwQnOV_fLJn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeP_AB6a3ZLFG_kdI_XzH81-F_4zMtALkqH8GY5FVtdQ&oe=6A789675"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q725zFrAiXIQ7kNvwEzhGGb&_nc_oc=AdobW_r2sRs0fVWSCrvIKPfM86v8NePcfHmI4elRfAY_cFWSLMKY-pPoaeRtRDFHm4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF21jBIylrDj8MSt-zTlxSukONqxpGVqjK5a2Fgf-5p3A&oe=6A789936"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqW1vWhIr3EQ7kNvwGxrYg5&_nc_oc=AdoWk5oXa4aGwZJ7Hikbohhf33KnuZjprFjPnNgOD-BqSgqj7-C35LZPTdOe2mHwlfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAmhMhslbhu2peNTZSHSfpOUPHMPAJkQDpbwQkFM-yRA&oe=6A7881CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKTZ5Nk7xsEQ7kNvwH6oyao&_nc_oc=AdqABpvgZZSvkNNZs6L3dHstGJftPwoyCZCC2ro2bd4MwHeRhAw23tUfFcSIvqyyKBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ81YPNl0ybFbVxHPrDMZlZIk43u5oV3Kx4PZP_ZrjNw&oe=6A788E8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LphUbCF18mUQ7kNvwEOezg6&_nc_oc=Adpzo5sjAF35iW0GCSKz41nnGMOOIFPeYCahdxHmRcY0QouKrolXJ5byUSrmT5M603U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYg6BLUJG0J3qPBrra9wBDFYqn_4Db9RNwerJ7s3T16g&oe=6A78880B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X94ScYgEp8Q7kNvwF8-K0A&_nc_oc=AdolJMODOK2OKqJCvMWywUUi1DGGH7FN48MgXyFZNfE0vUs7e-wNlhd0gWR3zB_JF38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr6dZqN-kZBKhnN5Ki2sukLTJqEPvACmYPCeDzhFK8_g&oe=6A787F9E"}, {"file_name
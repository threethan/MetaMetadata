t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOXws0QSnfQZTV7u8Jbn_u5VP2d3Uic_fc3Z37-XP0Mg&oe=6A75F51E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty8hfPS6QhYQ7kNvwH3LwN5&_nc_oc=Adrxy-7Fpa-AJDf27WdEXF1Gev0xL3ck0vPDMODgIxuvRidQZJOHzfwIiNODkdSdDb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjRySigX2C5o5QGkYDxvajkrRwU_2Dt6gKrEqUB8f5bg&oe=6A75F375"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtqRNOaTvSgQ7kNvwF7TWZH&_nc_oc=AdoDM6oyy8ZahwWLQFLFwPpDUHp0uxBUnwCVcgk7BAO0onLf9Nl1micOnqX3ct5ne_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWhSTXH7iMZClziYkIcy4O8w5Ce_ywUaJBEVNl9Sr-yA&oe=6A75F636"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqW1vWhIr3EQ7kNvwGBClJz&_nc_oc=AdojdGIJLWaM334OGYQ5uX-GZ7QvfzLDx-IG_orRqIysQ0KmGWXwdwbtuidjdLvbAgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHL3gJN5USPJdQiiNah7-tnpG4w_KX4XE2Eg6F21jvxA&oe=6A75DECF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSqJBWI-L68Q7kNvwGEikNd&_nc_oc=Adr0av6foGvfiRNkZiqE9I4NCdmFYahObkaPkxdFcvlEnhRB5bJUYGH_WZTEtTdAum4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIdTi2hUXloXk_-oXGUxUMISWJ-k1L-61Kpb1ciy2iJg&oe=6A75EB8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHL2H4dOX6AQ7kNvwG-TP8F&_nc_oc=AdrTKMcAX89MziCgGfw0qQaUFzlT43-2T3cJ6K0KMnhWa19Np3hLTzVh7y3gTZhv32Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbu2pSnidFw-agCgelxa-wYoLf1-wGep4H0ttBYaYI1Q&oe=6A75E50B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPwjdkMlwQ8Q7kNvwFKtU1i&_nc_oc=AdoEQu5717QCbUj2Nq7MklydpGlJPtu8mS2sSy3CPmVMZbVjFZA0V5oqTLpjIyZ-zao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNf4SMtmNjYf6Z7WtI_tGGpUZQ53PysKkUaB7_lU-iQA&oe=6A75DC9E"}, {"file_name
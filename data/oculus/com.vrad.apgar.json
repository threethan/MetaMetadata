t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFavDPbi5HK1Uz8zVo75l2K30Ga6-ojoG4_JHfwwuYpQ&oe=6A89835E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaVL2oxfPHoQ7kNvwG-0X8p&_nc_oc=AdrBaYrTVBK9Px8iPKqBs8PkpUNpHjSbLALpZFI-efr9D6ItqAuT0IKlwk7uxFR2YFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh4_CHEPKsItoRa-Gu3GIJMOgcisYfGD9VprbSlNfJRg&oe=6A8981B5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DLibW67ty8Q7kNvwFdCd87&_nc_oc=AdoASAgb3UEMGu2QbZ798IdUy2OXUQwXfvGMK-yvi5Sm7klD2LGikcPS8MltcUgE4pU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyn8dmePh0LnOHGhKfJNm4LEJdcw7RCa4qGZn2k3s_RQ&oe=6A898476"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgaMoSuo9aUQ7kNvwFg_v1Z&_nc_oc=Adrt_dNjSbftKbR5X3doLAMf_cU38OfwEFVh-Eebr0-E552RXnNwduZRpnFZfO8XQzI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ-CwPNQbVGPRfHyg3OuXRli-oRo19PbMsFr5vU2BGOQ&oe=6A89A54F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=715XhpyQz1wQ7kNvwGOKaQd&_nc_oc=AdoZj9pHjsT9jMR4fSgdMuc7R3DzTyd6fqzYyeu2LuB_niXqk2PIH92yQlLm6ah8q7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExatwK3dgYvLQ-MHLcvmjAqnfiploNTl7auEeYnlH0qA&oe=6A8979CA"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBv7kS-fm2wQ7kNvwETErFI&_nc_oc=AdpdATpCRXOO2Oq3Ut98L1KMarRE_pKpOIC__pqbn0T2HeDGCHvelrToMy1tlWDZ0P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc1YaSWDkh0sY5JXni2tMIPHYtZ6iYxVGrIY_6OoHcMQ&oe=6A89734B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rtyQnEuIOUQ7kNvwFWrnCv&_nc_oc=AdpnAGlwRnljMEMahGmoAyhoaiPqUe-AjLl6Sp9H3OQGX5h5cerehEw1-PgRNsPGEMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt2tEguL7eLsDdWjaA3UzU1-DJ_jpVW6w3AARCCP3_cQ&oe=6A89A31E"}, {"file_name
t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQUQFvguxwxi6YM_gaKkBMxNRP3PXORNH_FxbhjgzTng&oe=6AA56B1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1Ro5WXW34sQ7kNvwEv39sK&_nc_oc=AdoQfGaP78QGlZrPNcd4vFJt5Nz7PgaMFC1H6gQvxxHMoTSUAr03VwevZaiSJAUQRqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2KWTilMIJIiRUyZ5qEXsXb2nTvfvT3G8ui3s0zEx2Pw&oe=6AA56975"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7Grg7a623kQ7kNvwF6b5wa&_nc_oc=AdqQGl1-2XPa0GE4C0o5Wj-aMyZB_WUDTXj0P8AUSBCAzRedwvLjN0FV5_l5U8gCigk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqavt9R9Q9P4BN0rUQQPsMY2j4aWUfeZX-DKhzEGGhsg&oe=6AA56C36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iyz862V3d1gQ7kNvwH0d7vt&_nc_oc=Adr8fClHuZM3fT1DDbcpYxEK0sHglpIXYFbx_MzhQNhyn0NvS8xgzFFdukjZ1UWfqxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa8hKqc5gLE6vRDzO4Wnh7yBBWSfqp4nfAK68uyfvcTA&oe=6AA554CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB5PeXJNArgQ7kNvwFGI5Bx&_nc_oc=Adq17M9Hbhg1l824rjMv4awIloDoItt2-sCGRGeZUDm5Sev5YL1QoDHw8A43OLNZgQE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgjWwLBl12kyXwMDQARhSXNq5lX_NyCOU1ZBVCf5I9Mg&oe=6AA5618A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vH31wWMLfYsQ7kNvwGnYbGU&_nc_oc=AdoK0PiFOvHqiMPlq7TfFvkioReQ45PWJxU6Klmlsgohyo5_XwL6Rh5n3XdbEUwh4XI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpGQpjxhAdtcC9Gn-kHKMiiIJnKK-AuuQgYeG8zXYecg&oe=6AA55B0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2Zs9kd7l04Q7kNvwGDvd0y&_nc_oc=Ado4T9WZPIEmqd-nLrsZUoAgyen-WLuusvua6Tgtq2gezyAok8rDLH3LvXPO9lmRyJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJdyqy-ufcqvKBM899ZoQ4YnH_M-9yGGxzqc9JJen-OQ&oe=6AA5529E"}, {"file_name
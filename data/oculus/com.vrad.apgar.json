=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Wges_PGl4WbIuf4xL5eosxvqA7csNRh1hvE-JbTSnA&oe=6A11C31E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtYVoDzFPUUQ7kNvwHeYlQQ&_nc_oc=AdqIuim4wGN1rZpMgKVQcvVrpQ6fE_CGwVbrM1VQKGsLtMaOahXPLPIKUfI2JVn-Oxw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u5Aqsg7lvL5vs7-mw-tKpr5DINlH77Ziv43DT20F1yQ&oe=6A11C175"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azotkAbyQ48Q7kNvwHQ4JN-&_nc_oc=Adr_uMLFHRb1O0i0q7Oq2m06PnKc1AnVlLh843Cqgk4Ne56gY7Js5lYyG8W8QPoWSC4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SPBpu4J_Q_9f6tP5wWsJ2w9frQjmphGlOlJXSh_yxXg&oe=6A11C436"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YVV7NMNfSwQ7kNvwGweGha&_nc_oc=AdpaDmm-4V3JxwXayNAczfvUS4R_Lc2iZcSJB5V801de4MkH-bYpfi3JNpspiGtq2Hw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4prvasOjv6-q5R9HUt0FGQZFT2U3A4OuvUubj-JNe3jw&oe=6A11ACCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM2JDBcBbOQQ7kNvwG_0iIW&_nc_oc=AdrOr24-4SH6GKO3KwijXSAe93ZhJU-z7YcOs4nj8jrWXIcrDPTuEmttY2PiO3Cobp4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XaQ6tbr_rLtQIbZN4uSbxwKJv6kqQ0VR_pzhGfzjmmw&oe=6A11B98A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08jrr2wdMYsQ7kNvwHBpqSv&_nc_oc=AdrJjKbI_D5omcmJeaSJ7yhSy1iwvhEJ7FdAHKukN2_aaHHoAweX8KuANF7un2j-XWw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qsrHpe2nR-ORYSdmaPUUi6UyqtP30c7k3ITcInEjypw&oe=6A11B30B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLryGxTI7i8Q7kNvwEIJfqD&_nc_oc=AdoHULQUR8gp8YCQpnV8K-Q2Nh8baUnrnBvoH9TRUSuFdWs2-ElLAcQs2UewvrEHChs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YWsTfvb6z7vBp7A8DSA00bMrEuq_42rSLuuI96p6Cqw&oe=6A11AA9E"},
0_AfxLQ7UP20S1DAiY7qcLrTGxeVMrXq-JbjGxe5b7HNPxXg&oe=69BFCDDE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfhOIkDVD7oQ7kNvwF2rsx6&_nc_oc=AdmaptQid0lyWX67U_KXke2ddIxftPvuT2dH3aREkmOF5pY1AS1O5xZzo_rFiLllZ1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLxNKkae_kJWa1RNE9SjeCDTIn3x2ts1TIGDb4tn7BOw&oe=69BFCC35"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPjKvaF5spQQ7kNvwFvUWVA&_nc_oc=AdmmGmYURZyNvFgmib3Jb9bbKOFyTyjEXeowZaM56IK_MdmpSCewYfHhVBjVToKhaPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzQbbZlhf929GuiQUUxwUoAopaBOUrKvuCxVSQM1NPbA&oe=69BFCEF6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nGdQytjPt0Q7kNvwFbUKoD&_nc_oc=AdkxQmLc5egUFv1c74da5Cd_yMD9RGZ7kTt7Ly9gSYYQdDfAuOuhYYgw5eEUJoWZmI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQUxkBeGa7kwzKDOMmR7uS3naSm_DzE0h_fWqlpgUf6A&oe=69BFEFCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo6f1jLqHAEQ7kNvwHzUCko&_nc_oc=AdleB3mMQsSPjAkYLdoTyouFkCMfiJvhliFDMlBfVU0f-uyWHFy6Td9LfGKhfZMkCTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxisuidaOzahVibB2Rjdc2mgW6zlfX6GQ7eh-mLfjBpVw&oe=69BFFC8A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgerPRh5XWAQ7kNvwFJl9r-&_nc_oc=Admuj1Kx_NHfGx2TC9osyPgFcxPuqscYWOIl4vWPHup8pTg055LXWZpTgik2HqRj4pI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMChCUN-cVbnZcPABsKkKzJdj0qG7Y10NODHOxrQhwnw&oe=69BFF60B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCc3PYhAsdgQ7kNvwGsjrmB&_nc_oc=AdlQRJmbwH4V0KhEu2hOU_WMprtmXbDycIBXSkgU3kAaptkF9RId52mEpMUsn7rgPQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afysv1IDHpOxrPGs-qWjWEXdlKTrFcvoL7HSLazlMfAtBQ&oe=69BFED9E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
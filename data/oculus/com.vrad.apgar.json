t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E_yIL7q0z6t8NgVkr1614alP1ZoxwB5QMWD1OzGaIgw&oe=6A297E1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyJ6l-fnmkwQ7kNvwHpAjPF&_nc_oc=AdpGdw0s6g5Zo4lKIim1W1XOXmiFgDUChi3pWbb2l0PBqK_KKhrJx9tzZI1SKTj1K_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N_2isTbWwrrx85AyJsXiTed3m0EyAx9Oq1XsC5r942g&oe=6A297C75"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1c7E3YJxygQ7kNvwFLzi2p&_nc_oc=Adpvdce36UY5UEkswmYJw-DIrQMik1w7Szi_zCFzHeIHHadjSrOWAK3I7rAhPBlVkWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fI1fEew6YLtwLTw7eU3zcWeqvLF124QQAX8zW-dttzA&oe=6A297F36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj3QbOqdX3AQ7kNvwEjEF2v&_nc_oc=AdrordM4geOWI9Hx-zvGZVl2L9wuL4ltVXPG6HPsnU0Mkdhrqz1Q24ux1ncHLcHfFHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Oz3oFlKMJe5gRroivEpYisUEc6Il7FHoxA-eEI8orBw&oe=6A2967CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSztT10B54YQ7kNvwF2RTO8&_nc_oc=AdqN5SgKxIoVvRx74EpPs9HyfTCR_ouAcgeUPyZb7s7Bn-MpyvD_X7J3G-p_HZlMyGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nWZeX0qp05Mph1p9av2HwQIZwJkqkSyRfJeRX6chvJA&oe=6A29748A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKYObTLK2BYQ7kNvwGjKPzJ&_nc_oc=AdrJnRcQo14qr_YwEb2t4p2XvKXAISrasHCN2OCMmisqLsk1v4LPp0BxwOsrk-ICO78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-Bb-Lr1YkMcAG4-GKeYsmTf_HyMSyoh487Un2OfYJ_Q&oe=6A296E0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6oqNXorru8Q7kNvwEHT_ao&_nc_oc=Ado09HTD7EqWK7uHPFiO266q38xi2dSpP8HpkQiUSy4GK0qVYIlb4zeGxHCb0ACjoUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NmOCRQxpKi7zNwFBAACoYEW5Xxd2Ew2eRF8brbizI0A&oe=6A29659E"}, {"file_name
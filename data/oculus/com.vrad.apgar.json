t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa9oKA0LYX7-5qStw8DWKFpqFtAnEmtI2Z2yIVDlyGMw&oe=6ACF9B1E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrvsxzPFceUQ7kNvwGNuyqe&_nc_oc=AdrI-3eRf1Oswu8ZFiFjgepamSVmqCM-oVVskMCupy7sXSREBGgVAGXQq6RhC0asrs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtTAvhRxYGpH5RQ1iZHjepZJUdjpelUV0_8xhzLXwIag&oe=6ACF9975"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsMJZc7Rz7cQ7kNvwE5Zd0s&_nc_oc=AdqQZ7n7c9nMZrxMKN55AbkGXoRI4FPO0gZnWXhp7dP-CLXte_sOAzu2Bpxtcyq_enk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW0hbST7TFeC3PLRd-sfAwpar1HxzhayKNsD0oAe8L3Q&oe=6ACF9C36"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHzAGBkAQG8Q7kNvwE2khSU&_nc_oc=Adqkixn0YFPXYoJv0fNrpLtEJyqoQGe51ZNm5GPU-tPkmLeY2z4b5rOgjLHChgTve0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcWU66qCNo7ET5xVqPVl3XjcnIMI7YpXwY0JzZGn87sw&oe=6ACF84CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP3JcTJNb5oQ7kNvwHJ-jvI&_nc_oc=Ado60TF1RaDlzOF2wMyg1slFYIQel7e6OX1A4moOhpay7lJ0_I2bz-Yos9ymGQKFNO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3xopFKc2DKfOYk1vZIzjphTWFzz4amdu6tzLAn5ezSA&oe=6ACF918A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRnwKqPvk44Q7kNvwFYVuOK&_nc_oc=Adr-2cdqrTpJKIM1qKM8heXgfCRauhHQTW90A3HnA8rJxNpxPim_lUCtPDBMFE110ig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVrRLTvm52CbTgE-ReKdmwq3G-UntmImwtX4Xjbc-FlQ&oe=6ACF8B0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRLrdnuwEIQQ7kNvwENIjbh&_nc_oc=AdoqsyqxLltKu8tkVWToZlGMLyePc-6k0nzmcvxgtJLzcP88-_Ca2yvZu-tXCHOWjqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsXnzeFsPZxvC-n1n7oMbWhKv4RByFAEiAeEZTXsX6cw&oe=6ACF829E"}, {"file_name
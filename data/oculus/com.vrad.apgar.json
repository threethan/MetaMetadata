t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrLgm-hwt5pNYb5Wsi6yXZX-am4r-oG1JyCqiWM3Goyw&oe=6A73521E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yruuX6rfb5MQ7kNvwFtoBUa&_nc_oc=AdoKspMOptREFwWozbeR1HqSuJUWGpQNHIxWaX0VbNIyFsPPw5hKdKw4nBF3722Q82E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSxUq5nBVZUhWpT5PVxFPR5h0QmMMkeTs6I4mPgBLWGw&oe=6A735075"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrHGgW9ipcUQ7kNvwHJ8Ocf&_nc_oc=AdoIfj2aXzO-miM82VfXz4IOS1yEhHFh6d5HXVWLroZkO4F-VQdmZLjYFV5NN9nQcM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8lzmrPabVThIMy0jD8JYD9UHC2lI7pauwVmIDwsYhww&oe=6A735336"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5bFQDvbf1oQ7kNvwG-DzXU&_nc_oc=AdrmyX7FCrokhXBhz0cZBcyuP8WIWu7i8F5T-Ro3831vpqHavy2p99WuVdEiD6FldfI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4YA5M8lqkhtC41L8VJ1LzwHd2POzXAp2v78Xp7zgxGw&oe=6A733BCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbvuDde00zsQ7kNvwHmGJun&_nc_oc=AdpEGzfCFvU_0bEI87zt9B2ahv_AnZlraipHWvjLJlzZkMlrWFRELo_a-NV-_udQY04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSrHfD-oJIvECxdfLYeDXl_xgbib3AbKIQUQQgFjjW6Q&oe=6A73488A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHL2H4dOX6AQ7kNvwF-SyJv&_nc_oc=AdocvPK6a_j810ynASTxRsEyXGtkGqMcrqoFD2T_fNx_8uktTNrmBF9Pg-oViPMyz7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtQceC8vN1fj7IFrglmrng_MvGLNPQ9Kj-q4OgbfQL3A&oe=6A73420B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPwjdkMlwQ8Q7kNvwGSOhVM&_nc_oc=AdpAhlKR8eed2zYirJZeKWXak3Lb-iEM0cNq37dcCYm_z-DfIM5aiU5QiAP9XG580WU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE8i2hiNe9uGup9qVzu-CBXkDvIDQW9cQdc42F-6jB7g&oe=6A73399E"}, {"file_name
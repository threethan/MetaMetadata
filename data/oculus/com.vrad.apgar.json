t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe9zk7DFsjqbAOrmLOKKyc1kBSkpbv7R4__3L4PiB6Ug&oe=6A770E5E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty8hfPS6QhYQ7kNvwFbTE7d&_nc_oc=AdqCyVtLFw_Sp3d84LZ33rvvjpiZ67G9oaiDz7on5fAgrNC2RWY_h8iiu3L7X83tXEw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP99c8YzbIDqhHGwOiEHOR9YkPeTF7ZxLLLrcmgCq5bg&oe=6A770CB5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtqRNOaTvSgQ7kNvwHR0E35&_nc_oc=AdofhATQfX3oOnCthoHOetllVMcU3NB4q0jnDBGdQFjExQUB6EjqbR-t8_1zwRMy9TY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENqNGM6Mim86rT_gvsXvRjq3E60PbKA6zQznbRCf7tHw&oe=6A770F76"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqW1vWhIr3EQ7kNvwGYs3Ea&_nc_oc=AdoDO1I4EMh1_wlzRx6fK8eFy5dYq12ZgYYiubjFYKED5FRNkV4DAF2YW8BAcE2AwL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG61ynshHw0MCyBRgY1tAp24GI6Dx_u9pLiN3Y4Oah9kQ&oe=6A77304F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSqJBWI-L68Q7kNvwGbyzmc&_nc_oc=AdpnJ5wa4q8999lObwjtDcdDButeKo-suDeDcfgmJV49PF_AYHDCdL2cwrlXijVZoFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmSqM2DpuYHd_l_ZNPEAStmoMPoR_ppdcSTWoH0kr0Kg&oe=6A773D0A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LphUbCF18mUQ7kNvwHWZ_lK&_nc_oc=AdrIo5xmsfoqvtxcUXzKIHNwu3p7LZ01aI61m1VIJjW5lUhjYskytfgMJmBFReWlRnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfkjkOvmCoVNjC75TwSFymK6yXwXjL8uBDmhTlqUk08g&oe=6A77368B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X94ScYgEp8Q7kNvwHEzFZw&_nc_oc=AdryHSt8bcpXpU0P0r53wuD7-Hdy_tkVyDCNCxTjN8yk0r54zP7gi0d6VTXsUtBrIG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh3Se7nIvqsQ6yiUnaCcnGI1byd7wKoekQOWzAZg6j_w&oe=6A772E1E"}, {"file_name
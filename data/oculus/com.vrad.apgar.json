t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6otTcUDKoS271mMeKzVjCrAtBDPkmV0XMMajvyl-JEaQ&oe=6A1AFD9E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3hkh2mXaQkQ7kNvwEg0mgl&_nc_oc=Adq0W9kD5Du891vOjQZ-nAyha99dS3y5suj7KzvsgYXzkB513YxufuJscjBFKpEGo4I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oY4sy_5PcHwTABRai7r-vL_j2-VxC7lzMY2dJEchc-g&oe=6A1AFBF5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSq5OCXAkWQQ7kNvwHEKemy&_nc_oc=Adp-DpEUalgcx00ZrorazUc7o6CWTXDyj_lGGya6rCANX0z9yY4NGlY43di5LONjnmE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vuQ2R90zlyyLYCQfQ5nevM_v1r63u4o8uud8Gs4l3PQ&oe=6A1AFEB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XflIi8zHcx4Q7kNvwHRH91F&_nc_oc=AdrK5F7Nj2bHAevJVj4-0mSvx7qxdgB_SGk5vC9ozeCdwhYXO0uHbgHN5980PToNIF4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B_i41fAiRkrgWbuauluWQUuRwTT257BVVn2SHEv-X6A&oe=6A1AE74F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CTio9TBPRcQ7kNvwEM0R8V&_nc_oc=AdoFGGpnxzP6D-GvTN5YdrkG45-Wle2yu5s-nO9fuoZVd-JrV-Nglv1j2zhR7bOFQuQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PNO7tseHLSwuoBBy_S2x9pDmTOmuHBlQa74AMYY18Aw&oe=6A1AF40A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IHGxvE9m3wQ7kNvwGbaXvp&_nc_oc=AdpC6oH-GOue5k5BwaT3aqrpfSO8eBo6GFk1YMmo8lfBCrJKwtdkezzMerS92bXZXeQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vVgDVVKLFwpDFd-NAcTJxhU9uP0Os7SXC9PwKMHdK-Q&oe=6A1AED8B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABD5s7jTW44Q7kNvwFkVFna&_nc_oc=AdokSiR4GuTXn_qmn3Bk0mYHf4k07F418z_rGTSFJQVxT0nkZYl067tgFFbS1aWIiNU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_nNPAZCNT_iuNpfVcz2lBkGymwSAYB8knYh73juZFQg&oe=6A1AE51E"}, {"file_name
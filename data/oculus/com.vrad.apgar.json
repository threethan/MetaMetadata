0_AfyPxEHl7T2XYgQXM14DuSpnNZLhECX0ix1NfffhI_WlaA&oe=69B541DE"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUa4VevUTwUQ7kNvwFzs39u&_nc_oc=AdmFsoQMg3uN6H1pUZ4RVakBDNB0On04GWkqHiDGd71yEHA7zU-QGdpC6DCPF1RHNyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIBn_pqflRkZKK6MDJZGq0xsyUN9TxpnxpCLPwNT8tRQ&oe=69B54035"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OArS3sq_trkQ7kNvwEfWKgt&_nc_oc=AdnWtKY2RZIKNpt_mLY6LK91fm7lO70cPwS-ohUZX0iGeY9nJKFuncMcr1MJhZZAPHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ111wgB_FTVpKKFKmH7DyjgxYQREsmrY1UVmEKVubnQ&oe=69B542F6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqt4TznaKQsQ7kNvwGv_Ibo&_nc_oc=AdmXWvVQiAG_cPyOiFLMQQjrq7w3sLJag0jrsibbr8K6t4DbRe2Z6QdLNgtfF4wuXwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPdjVwxgRPKtBa0Qh0HMmMSodSGLta_MoU2FJ7PPW3kw&oe=69B563CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LlfxQ4sS3sQ7kNvwHX9wQN&_nc_oc=Adk1cfPQF5TsdHeHDO8O4X63c84zkgV6mTg1lOTZtWNygyh6cg4us8g3OS9tHqUww7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAfJ9rQoLGm9h5wMJNymYS49bdy989gkoAmctkilTPgw&oe=69B5708A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WghJ6lSGfs8Q7kNvwE3maxv&_nc_oc=AdlBZN3Um6zA3QJ8U5-n1jxIwtDu2qCJhK1--4pIO921v5dVEBWtDSAnHk4ZsTkpvzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhhcA8c7d8GYwoqgjQm1SLZG07mkc2XrkmS6mDIPtSqw&oe=69B56A0B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnfKW_Sz_ukQ7kNvwHfi2Em&_nc_oc=Admv0-wRfjKyX0ekl3ZHuOSFYTf3mxORWXAZkjrMuukHy7DO3PBXt7fn2YNxAqqsV4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJHgL-qaNyUjAvKeJU1ntvQcg52XQS5CnZmWfQ62caww&oe=69B5619E"}, {"file_name": "008.NS_A_Mini.png", "id": "1313517853269588", "image_type": 
t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HKuOGwy6JDlDvFl7FujwbBg5xE1wrEogMipVahGaIuA&oe=69FB599E"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "535893425582061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_535893432248727_607968019257830091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4jcbl7pcbwQ7kNvwFfvQEN&_nc_oc=AdofH11Z7a1nx5ulp6HqgnEUO2Z_cZ54ifwvXJoifI7degUe8dRS4Aim2hia9e_HiLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U1p9UARsNELlfUuDAgr9CAcQ7DNEye7V6ITtwnQPD2Q&oe=69FB57F5"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "649841284150626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392058_649841287483959_4265547807872999876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_KReVBSXwUQ7kNvwETUkx8&_nc_oc=AdptBl2fPBdjz6LfDDINCRo-pPpWefpOZlxc92wN03PP163XLzwmpZ37B_XUjCUpFFA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qk01uXIz8tKS1dOXVJWrEkUl4zEFERoH-Sz3a-hQrUw&oe=69FB5AB6"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "652707930551716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396252_652707933885049_1336466288748131486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4PhNnf5tQoQ7kNvwG426K9&_nc_oc=AdpmhbqL6EhyefxNcRPdl5PwSqBfZDKCcptDkC-FeazU_c3sgnkR0hSl-wCsfDdioKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oJZxZUrYcb7Hjd0h-_9NRgIRVvLGX0K6wid-j0Hp6rA&oe=69FB434F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NS-APGAR", "keywords": [], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to address various challenges in neonatal assessment, NS-APGAR enhances the learning experience for both educators and students.\n\nThe simulator guides learners through the five key APGAR assessment criteria\n\u2014heart rate, respiratory effort, muscle tone, reflex response, and skin color\u2014allowing them to practice and internalize the standardized procedures effectively.\n\nNS-APGAR incorporates the standards set by the Korean Accreditation Board of Nursing Education, ensuring a structured and comprehensive approach to neonatal health assessment. \nBy providing accurate and standardized procedures, the simulator prepares students for real-world clinical applications.", "short_description": "NS-APGAR is a VR-based simulator designed to help users systematically understand and practice the APGAR scoring system for assessing neonatal health."}, {"images": {"nodes": [{"file_name": "006.NS_A_Portrait.png", "id": "1769186376974618", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392076_1769186380307951_2523111346601453692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BikrM0lm6KMQ7kNvwFSVTs5&_nc_oc=AdqDA9P36vZBfTh0dQSEojrOT0HC25sxxEoxF1ZMTsBrdJzXw2-QXxbrNtHOOW5WKVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xvBknSg6ujcq91XUXal57Dy4tfyXRmO4MZsZzxn1Umw&oe=69FB500A"}, {"file_name": "007.NS_A_PDP.png", "id": "1687991861790047", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392040_1687991865123380_7775533927646772153_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPd5YoV3PVcQ7kNvwHR8aDZ&_nc_oc=Adpc2jZmCp1dWqbWu2At9GrkrZYdgePQEu-74WR687lpgJiaGtEU2n6tod-5RTIL8Zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CFQBffSAtUEWKKIRzR0AXwSJjJ0E7A8bKT2XqdBtWvg&oe=69FB498B"}, {"file_name": "014.NS_A.png", "id": "1399777421429818", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392004_1399777424763151_6566675078254540540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6opGwFm-O8Q7kNvwG0RiPN&_nc_oc=Adqi2JQJV5MSQ1aPhIg8c_4mcb3yNxYxtpvi0ftWmlx7BRlYYnUTTMP__OV92E47M3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vdnhIjIBbomfNP--E2y7rX3G52RyLJGs5gTJQ6_XkIg&oe=69FB411E"}, {"file_name
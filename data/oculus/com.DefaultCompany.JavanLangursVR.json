_EsQ7kNvwFExBJ6&_nc_oc=Adm1E_fld94iTKShD0TXvt5lIeGVRHyneu0NoWzp10hncq5G-epZ3vXOMt1YQ6Vd0lI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftn5YeFy-AygB8qy-LmP2L3-BrzeCeo9NEUMuoR26RHBQ&oe=699C56F9"}, {"file_name": "Javan LangursVR - SampleScene - Android - Unity 2021.3.21f1 Personal_ _DX11_ 2023-12-04 17_27_00.png", "id": "322666434052064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_322666437385397_3775942969231701529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQZl5zEjEzkQ7kNvwG6qwTP&_nc_oc=AdkjiOHRkVwZv20kTWoKWL4QDvqRdu3aWPtMZcIL-ZXXZF0iwsqpG6SX53Zn8rRHqV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuTUHxze4VlL_v5Z7aTL53eNZlE7thj9R4RGpa7OwNdZg&oe=699C39CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Javan LangursVR", "keywords": [], "long_description": "\nDive into the high-flying, adrenaline-pumping world of \"Javan LangursVR: Branching Runners,\" a captivating and fast-paced game that combines strategic decision-making with lightning-quick reflexes. In this exhilarating adventure, you'll take on the role of a nimble monke, navigating a complex network of branches, obstacles, and challenges in a race against time.\n\nFeatures:\n\nBranching Gameplay: Prepare to swing, leap, and dash through an intricate labyrinth of branches. Your path is not just linear; it's a dynamic and ever-changing network that demands quick thinking and precise execution.\n\nStrategic Decision-Making: Choose your path wisely. Each decision you make could lead to success or result in a tangled fall. Anticipate obstacles, assess risks, and calculate the best route as you aim to bring your monke to the finish line.\n\nSpeed and Agility: Showcase your monke's extraordinary agility as you traverse the branches with fluid movements. Master the art of swinging, jumping, and wall-running to maintain your momentum and secure your victory.\n\nObstacles and Challenges: Face a variety of challenges that will test your skills to the limit. From swinging pendulums and moving platforms to thorny barriers, every level presents new hurdles to overcome.\n\nMultiplayer Race: Join a thrilling multiplayer experience where you can challenge friends or compete against players worldwide. Engage in head-to-head races, where the quickest and most strategic monke emerges as the victor.\n\n", "short_description": "Fun monkey game to play in"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javan-langursvr/startsida", "developer_terms_of_service_url": null, "publisher_name": "Death", "support_website_url": null, "website_url": "https://sites.google.com/view/javanlangursvr/startsida", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6695857657163447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982724_1084456165911096_6704029435739710475_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak0bPvjn3bgQ7kNvwGtOCDn&_nc_oc=AdmldHIokgaIMpyAasAEHkBNBXkS2OIJ2CCFJ0cTnRK342AdVwv90Xoy9utWQcYu9hU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuGnXJxEDN6KJclqtAlHzn8ecCnWlVNi0VLJyEQ7_wxzw&oe=699C413B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Javan LangursVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "c
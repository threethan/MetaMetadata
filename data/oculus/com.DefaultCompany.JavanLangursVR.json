oculuscdn.com/v/t64.5771-25/38982553_283374674194733_7479601195282956281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D574e8e0uS4Q7kNvwF65G4j&_nc_oc=Adp9eq1MVAbh_btpNX0UDKXhPF9syCTQGu6MuZbzCDyqjQ9g6CVX7O4I3Qcul6gCHLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7kSI7Cy2Nr9vnsNflzsy7RafvGsu5K_fO-TES9It4TA&oe=6AE0A7F9"}, {"file_name": "Javan LangursVR - SampleScene - Android - Unity 2021.3.21f1 Personal_ _DX11_ 2023-12-04 17_27_00.png", "id": "322666434052064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_322666437385397_3775942969231701529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-Gnb_kVt7oQ7kNvwGlmovT&_nc_oc=AdqVjgS3LfRKeeja0-yBwqTodFsk9jZRh0-ZQSwPA7NibFXw_KY43wODH7VbdHldr9g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwcDNQqtbLn2qoAfw75znkTnYTEeVrtXi9etXBJtrmyg&oe=6AE0C30D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Javan LangursVR", "keywords": [], "long_description": "\nDive into the high-flying, adrenaline-pumping world of \"Javan LangursVR: Branching Runners,\" a captivating and fast-paced game that combines strategic decision-making with lightning-quick reflexes. In this exhilarating adventure, you'll take on the role of a nimble monke, navigating a complex network of branches, obstacles, and challenges in a race against time.\n\nFeatures:\n\nBranching Gameplay: Prepare to swing, leap, and dash through an intricate labyrinth of branches. Your path is not just linear; it's a dynamic and ever-changing network that demands quick thinking and precise execution.\n\nStrategic Decision-Making: Choose your path wisely. Each decision you make could lead to success or result in a tangled fall. Anticipate obstacles, assess risks, and calculate the best route as you aim to bring your monke to the finish line.\n\nSpeed and Agility: Showcase your monke's extraordinary agility as you traverse the branches with fluid movements. Master the art of swinging, jumping, and wall-running to maintain your momentum and secure your victory.\n\nObstacles and Challenges: Face a variety of challenges that will test your skills to the limit. From swinging pendulums and moving platforms to thorny barriers, every level presents new hurdles to overcome.\n\nMultiplayer Race: Join a thrilling multiplayer experience where you can challenge friends or compete against players worldwide. Engage in head-to-head races, where the quickest and most strategic monke emerges as the victor.\n\n", "short_description": "Fun monkey game to play in"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javan-langursvr/startsida", "developer_terms_of_service_url": null, "publisher_name": "Death", "support_website_url": null, "website_url": "https://sites.google.com/view/javanlangursvr/startsida", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6695857657163447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982724_1084456165911096_6704029435739710475_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmvZ-OGxCeAQ7kNvwGFp4IM&_nc_oc=AdqapdWhXJKsCOPjyG63TdM4MW6a4LPaMEtZF4L1Q_jATVOtTzTc5DFdstWlfLgJ5lA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO15ElliqfgCWHK8JNJnQg5Veo72aYYsdjna0cMTKcRkg&oe=6AE0CA7B"}, "is_concept": false, "is_test": false, "is_
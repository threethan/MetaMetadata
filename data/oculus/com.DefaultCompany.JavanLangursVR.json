oculuscdn.com/v/t64.5771-25/38982553_283374674194733_7479601195282956281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjAv9pinDGUQ7kNvwGAyofA&_nc_oc=AdpEBXy6ipYrT0f6gNXS9iE1_F_G5SDpZJs1jh91X8c2doxwywEYzoOyiNTv7VRni7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp7iiW9nUcmLIANX6v7e40FDHuuSRDcA9Uc5dvex2sTA&oe=6AD22779"}, {"file_name": "Javan LangursVR - SampleScene - Android - Unity 2021.3.21f1 Personal_ _DX11_ 2023-12-04 17_27_00.png", "id": "322666434052064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_322666437385397_3775942969231701529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmyBmbr9j5sQ7kNvwFeDo6N&_nc_oc=AdqkCimWSEQn7dJadIgFzWRr68NfWD2Rrq9McBU9H7CgIv7L1jk1-2oUo_qcXQHEUJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyWbgiRaXbvZ4o_NHOjUA7s2lsev57qbD7tg0GaKnhog&oe=6AD2428D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Javan LangursVR", "keywords": [], "long_description": "\nDive into the high-flying, adrenaline-pumping world of \"Javan LangursVR: Branching Runners,\" a captivating and fast-paced game that combines strategic decision-making with lightning-quick reflexes. In this exhilarating adventure, you'll take on the role of a nimble monke, navigating a complex network of branches, obstacles, and challenges in a race against time.\n\nFeatures:\n\nBranching Gameplay: Prepare to swing, leap, and dash through an intricate labyrinth of branches. Your path is not just linear; it's a dynamic and ever-changing network that demands quick thinking and precise execution.\n\nStrategic Decision-Making: Choose your path wisely. Each decision you make could lead to success or result in a tangled fall. Anticipate obstacles, assess risks, and calculate the best route as you aim to bring your monke to the finish line.\n\nSpeed and Agility: Showcase your monke's extraordinary agility as you traverse the branches with fluid movements. Master the art of swinging, jumping, and wall-running to maintain your momentum and secure your victory.\n\nObstacles and Challenges: Face a variety of challenges that will test your skills to the limit. From swinging pendulums and moving platforms to thorny barriers, every level presents new hurdles to overcome.\n\nMultiplayer Race: Join a thrilling multiplayer experience where you can challenge friends or compete against players worldwide. Engage in head-to-head races, where the quickest and most strategic monke emerges as the victor.\n\n", "short_description": "Fun monkey game to play in"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javan-langursvr/startsida", "developer_terms_of_service_url": null, "publisher_name": "Death", "support_website_url": null, "website_url": "https://sites.google.com/view/javanlangursvr/startsida", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6695857657163447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982724_1084456165911096_6704029435739710475_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kN4qhyxaQeQQ7kNvwHOb0xq&_nc_oc=AdoxJArj-wIbLal1liMG22nQ4v3XGZED1Mp2DGb7kB3f1D9-EegddjC8zikgp6Me4d4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Zm8njGObGpudF9MCC5B-RM6f8MFzDiuyJqJMZDGqPA&oe=6AD249FB"}, "is_concept": false, "is_test": false, "is_
7416507328985_9023770409007651854_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJKE9m7pNzwQ7kNvwFrzaDS&_nc_oc=AdorMhiTjmmb_1wkY-HO6wccdLJe4LKZkCoUMpyJAWzdOx8kBuC06a97hkHR8lXmmAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn_m-j9EkgSBWKwfJBqfA7RHju4u_zbgIdJvK52cyZtA&oe=6AF5D75F"}, {"file_name": "s6.png", "id": "24320771054197657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_24320771057530990_2120611191463787054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOQC6Prya-oQ7kNvwHTE59j&_nc_oc=AdqiRhm9MjsN-5Ge4GIQ2nw3XwOw8PYXErjhkJCI-lQqjJpQN7Fw37nRagchzyXP43g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrCvyV27Ic74VuvPf1uCHD_uA4zP6BqGrQzFS7NCqmIQ&oe=6AF5CE0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Jump VR-Ramp stunt", "keywords": ["carjumpvr", "carstunts", "rampjump", "magaramps", "carracinggames"], "long_description": "Welcome To the car jump ,i am your Car let's jump \nAre you ready to master extreme stunts? Take on the Car Jump VR-Ramp stunt game and embark on an adventure like no other. Gear up, rev your engines, and prepare for a high-flying, heart-stopping experience. The mega ramp car stunt game beckons\u2014the ramps are calling, and the stage is set for you to shine.\n\nKey Features of Mega Ramp Car Game:\n- Diverse selection of luxury racing stunt cars\n- Multiple HD graphics car racing tracks\n- Realistic and smooth controls for the mega ramp car game\n- Authentic sound effects enhancing the racing car game experience\n- Exciting car games simulator challenges with a focus on thrilling stunts\n- Perform daring stunts in the mega ramp racing game\n- Engaging and challenging levels", "short_description": "Are you ready to jump? Take on the Car jump VR-Ramp stunt and embark on an adventure like no other. Gear up, rev your engines, and prepare for a high-flying, heart-stopping experience. The mega ramp car stunt game beckons\u2014the ramps are calling, and the stage is set for you to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Rexxxstudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23881193414913540"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1499887665306158"}, {"status": "PUBLISHED", "id": "1007797444863586"}, {"status": "PUBLISHED", "id": "24609176298677440"}, {"status": "PUBLISHED", "id": "3972801419532955"}, {"status": "PUBLISHED", "id": "1376642090065687"}, {"status": "PUBLISHED", "id": "1080616130674533"}]}, "baseline_offer": {"id": "1007797444863586"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1499887665306158"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23877719431927605", "version": "1.0.0.8"}, "id": "714861667920869", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10071100959682686
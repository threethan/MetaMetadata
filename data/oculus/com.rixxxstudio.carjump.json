0_AQBZbv5ShnwtzzAQLYq9elaic29UXq2YGdrYvzzoC3yqtQ&oe=6A4D175F"}, {"file_name": "s6.png", "id": "24320771054197657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_24320771057530990_2120611191463787054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPSy9AuvdYMQ7kNvwFVy7H3&_nc_oc=AdorLk1SAaDMHHOrsq97ebZsqnRwqvL9FOnjJrj7rpCJIswMQpHuonNAz31ypMlhu7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYcmAsx5_Bg6b_7ZBdL75xkrRi7ToBp7kL1aWtATWKaQ&oe=6A4D0E0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Jump VR-Ramp stunt", "keywords": ["carjumpvr", "carstunts", "rampjump", "magaramps", "carracinggames"], "long_description": "Welcome To the car jump ,i am your Car let's jump \nAre you ready to master extreme stunts? Take on the Car Jump VR-Ramp stunt game and embark on an adventure like no other. Gear up, rev your engines, and prepare for a high-flying, heart-stopping experience. The mega ramp car stunt game beckons\u2014the ramps are calling, and the stage is set for you to shine.\n\nKey Features of Mega Ramp Car Game:\n- Diverse selection of luxury racing stunt cars\n- Multiple HD graphics car racing tracks\n- Realistic and smooth controls for the mega ramp car game\n- Authentic sound effects enhancing the racing car game experience\n- Exciting car games simulator challenges with a focus on thrilling stunts\n- Perform daring stunts in the mega ramp racing game\n- Engaging and challenging levels", "short_description": "Are you ready to jump? Take on the Car jump VR-Ramp stunt and embark on an adventure like no other. Gear up, rev your engines, and prepare for a high-flying, heart-stopping experience. The mega ramp car stunt game beckons\u2014the ramps are calling, and the stage is set for you to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Rexxxst
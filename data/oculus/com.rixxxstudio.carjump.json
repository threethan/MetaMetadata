n.com/v/t64.5771-25/491820585_2846393355750489_913109826810007412_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BP7lIp8VlUQ7kNvwHaaxOW&_nc_oc=AdoJuGfv1Du0sLin7hFx6Q6zZIi_40DV_GEEPS8nJduDB8CPoQ731_-pOx-lzTaXdV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y6yyHevyU6dRiqGrAXyqO0-m6HoCgyVKADVvs4Aifhg&oe=6A2EB088"}, {"file_name": "ss5.png", "id": "1481345246086124", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818925_1481345249419457_6009264897574637598_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xu_zvcH23UkQ7kNvwHNdW4T&_nc_oc=AdrjTCseK6N3tAnuNkocN0OAetNabmKUV0R_Vx5smNwd_qik9keR7HfQcXBwATEZ7NY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M-1oB_S_0Nv0i0QygKL0kDvnwC3PJ6uwXExkA0RdDOw&oe=6A2EC0BE"}, {"file_name": "ss2.png", "id": "1159172932734531", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820652_1159172936067864_1306096728585144087_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aNkMaoWWfgQ7kNvwETsJQ1&_nc_oc=AdrvMgKg5BYL9-kZ-ZqZEsDu40fBGQdOZsC2MsCi8ivcV6IW31nR3G3QgRVFDwIfyXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u3trgm6H8epNHC5xvFJFuVbaSaYkpHJojVJj_tjm2yg&oe=6A2EA99B"}, {"file_name": "sssssssssss5.png", "id": "1336913094623976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_1336913097957309_1226464700268245121_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiqmYfO0e9oQ7kNvwE5J0g0&_nc_oc=AdqvzHsdJ-0V5wXFl0U3TPTrU1vJfa1SqxpcONrQgjj_hudpEC4cq-ZBnUZ1pZKqn5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uETFr_ovcrRAZwdkSya4P4WINs2fo5mJLAmb04u0lxA&oe=6A2EBD00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Jump VR-Ramp stunt", "keywords": ["carjumpvr", "carstunts", "rampjump", "magaramps", "carracinggames"], "long_description": "Welcome To the car jump ,i am your Car let's jump \nAre you ready to master extreme stunts? Take on the Car Jump VR-Ramp stunt game and embark on an adventure like no other. Gear up, rev your engines, and prepare for a high-flying, heart-stopping experience. The mega ramp car stunt game beckons\u2014the ramps are calling, and the stage is set for you to shine.\n\nKey Features of Mega Ramp Car Game:\n- Diverse selection of luxury racing stunt cars\n- Multiple HD graphics car racing tracks\n- Realistic and smooth controls for the mega ramp car game\n- Authentic sound effects enhancing the racing car game experience\n- Exciting car games simulator challenges with a focus on thrilling stunts\n- Perform daring stunts in the mega ramp racing game\n- Engaging and challenging levels", "short_description": "Are you ready to jump? Take on the Car jump VR-Ramp stunt and embark on an adventure like no other. Gear up, rev your engines, and prepare for a high-flying, heart-stopping experience. The mega ramp car stunt game beckons\u2014the ramps are calling, and the stage is set for you to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Rexxxstudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24382370511462492"}, "review_messages": []}]},
luscdn.com/v/t64.5771-25/38982580_814326243412762_5096343985424855819_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5BEpZyv-84Q7kNvwFq4Ybc&_nc_oc=AdlO7d-sTHJPohzWsRr0yE5ZDBjhZWfcuHub4T_QUwAdrK06OF0qKjxp2Jpr0eWirc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftAfcIS2N85qg-7UtDIDWJe17R-9S3Gu_3d4LjBc3jscA&oe=699C584C"}, {"file_name": "Screenshot 2024-05-15 at 1.22.31 AM.png", "id": "751539316844990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974649_751539320178323_572124039746839939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0PyzBjkHG4Q7kNvwGaztGP&_nc_oc=Adnka3ktnNyS0ghsbW8ROj7ZFtwwxT8au6j6KdtnllHVyGNtzTkMZ_qpqw_OYZvgrCs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftvttUqD9ftpjO2lby91sabpcEGi1lXd3sUt4KYaT2lZw&oe=699C37C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-05-10 at 5.36.04 PM.png", "id": "1232238977944138", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982496_1232238981277471_8508068261225973941_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFbl9XScUpsQ7kNvwFNbjnC&_nc_oc=AdnMqNSOooI2AuaDRhlfG6-yo18S7GhqDBCN8u19keZr_Mc7DWL-X_fHX9w7dAeqFN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuxQRGACSILTHT9Z04hOpObDii7GMaMdJE1d5ZDcjmn7w&oe=699C50C9"}, "display_name": "Biblio - reading app for books and comics in VR", "keywords": [], "long_description": "Turn off your controllers and just use your hands :)\n\nBiblio has been made for the pleasure of reading in VR. Now you can:\n1. Read in peace and isolation, without distractions\n2. Read while lying down or any other position you're comfortable in\n3. Sift through pages by just swiping.\n4. Choose the environment you want to read in.\n5. Upload any book you want to read\n6. Choose from 25 free comic books to read, and add more\n7. Drag and resize your reader with your hands", "short_description": "Turn off your controllers and just use your hands :)\n\nBiblio has been made for the pleasure of reading in VR. Now you can:\n1. Read in peace and isolation, without distractions\n2. Read while lying down or any other position you're comfortable in\n3. Sift through pages by just swiping.\n4. Choose the environment you want to read in.\n5. Upload any book you want to read\n6. Choose from 25 free comic books to read, and add more\n7. Drag and resize your reader with your hands"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1m1Z9W-3vAL0fVlY_m5Kbez-wTn6mxyCmrLx-LSAkDtU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dhruv Atreja", "support_website_url": null, "website_url": "https://dhruvatreja.my.canva.site/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7448147778555767"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1632568474239917"}]}, "baseline_offer": {"id": "1632568474239917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715795940, "status": "PUBLISHED", "id": "1632568474239917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7930345623669311", "version": "0.17"}, "id": "800323115393818", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBina
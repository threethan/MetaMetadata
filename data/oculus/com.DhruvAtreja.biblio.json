eenshot 2024-05-10 at 5.35.39 PM.png", "id": "814326240079429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982580_814326243412762_5096343985424855819_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfg-n_tRi3YQ7kNvwEEj6Rt&_nc_oc=Adn72DOKn7LHj-E5NAuFX06z_HRI-VufZGByVvbFlzy6-OITGh_KtZHfIcp2iu07lP4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjoVeshIcVe-lh7sy0oMONjfCLtQtFCwU-kbOmV6vdbw&oe=69BAAACC"}, {"file_name": "Screenshot 2024-05-15 at 1.22.31 AM.png", "id": "751539316844990", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974649_751539320178323_572124039746839939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZXaSQ37q8MQ7kNvwGmi__R&_nc_oc=Adl1NAsO8EtZVi4ky7rej1pCQ_Y3s1jVAoBCXJhlXhv_gy-mIfpcQZiTMBNa7T9a1f8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyNTdbq6mwbjXldoDc3ZW_jgaw_4bghq6qqxzWARF2Ibg&oe=69BA8A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-05-10 at 5.36.04 PM.png", "id": "1232238977944138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982496_1232238981277471_8508068261225973941_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_shG70To6YIQ7kNvwE7e4cK&_nc_oc=AdkYgEluAGciIFt3Pvf9194ShNmtZ6MUcGg0I5TpPOQEynQuMWYOxhFguJ2DEKHEV0o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwG5aUwMNgse95xA2NcmJ2fB1vNjZfQnX2IboIxCufP_w&oe=69BAA349"}, "display_name": "Biblio - reading app for books and comics in VR", "keywords": [], "long_description": "Turn off your controllers and just use your hands :)\n\nBiblio has been made for the pleasure of reading in VR. Now you can:\n1. Read in peace and isolation, without distractions\n2. Read while lying down or any other position you're comfortable in\n3. Sift through pages by just swiping.\n4. Choose the environment you want to read in.\n5. Upload any book you want to read\n6. Choose from 25 free comic books to read, and add more\n7. Drag and resize your reader with your hands", "short_description": "Turn off your controllers and just use your hands :)\n\nBiblio has been made for the pleasure of reading in VR. Now you can:\n1. Read in peace and isolation, without distractions\n2. Read while lying down or any other position you're comfortable in\n3. Sift through pages by just swiping.\n4. Choose the environment you want to read in.\n5. Upload any book you want to read\n6. Choose from 25 free comic books to read, and add more\n7. Drag and resize your reader with your hands"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1m1Z9W-3vAL0fVlY_m5Kbez-wTn6mxyCmrLx-LSAkDtU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dhruv Atreja", "support_website_url": null, "website_url": "https://dhruvatreja.my.canva.site/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7448147778555767"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1632568474239917"}]}, "baseline_offer": {"id": "1632568474239917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715795940, "status": "PUBLISHED", "id": "1632568474239917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7930345623669311", "version": "0.17"}, "id": "80032311539
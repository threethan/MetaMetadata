84909991004528_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ksjm_87ZFEQ7kNvwHVrQMY&_nc_oc=AdrzIrL0tHfhwl8KjJEe9h6Qh3m2CEVab7Z6pDsZ2EDd9ngd4QB7qboS84kDhtw4oZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-R9hK2QqdKW6vYoavcXc4TC1UIm77_d27ZTSLBMEuBw&oe=6B0DC509"}, {"file_name": "04-Tutorial-Cross-Placement.png", "id": "1404873324725396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_1404873328058729_5394084201620018365_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4iD5AFCAicQ7kNvwF9kFoX&_nc_oc=AdpaxuZB8e5z0n9iwsPj8m-tjaADul55AWFL8a31zCmK_upA9gr4v6XX4xTU5pegur4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWgQE4nToMcBOVIUrGehtBue503jpMTwXdbnd0syPEdA&oe=6B0DBF4C"}, {"file_name": "03-Chain-Merge-In-Action.png", "id": "2654543215028874", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_2654543218362207_4339019916801932313_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZAMcPOVMqcQ7kNvwFOum5V&_nc_oc=Adr72ocsL7mxGph0qSDnJe2QLjLuWMi_DjWJE4TgDwYJrmyBDuo5KMb4cBMhuW0uoxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoyfoSGUvx1jYmFFUmQB1yJTB_qK0Til44ayYY7iblvQ&oe=6B0DBA54"}, {"file_name": "01-Classic-Spatial-Board.png", "id": "2508590176218568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_2508590179551901_7193387634851244441_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A3Q9Li9CpkQ7kNvwHbm5ek&_nc_oc=AdpU_eBbfHzgLGM6YP0XpEc9QqvHLowztJMmnoah6pp0hZzVzlIDtk_Zkp32vfl9AtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9ClUSm5xQHg6vpv9A8HK9aqLnuiACEhKDEm8ti7wt7Q&oe=6B0DAB1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blockora", "keywords": ["Merge", "VR", "Puzzle", "Logic", "Block"], "long_description": "Step into Blockora, a colorful VR puzzle game where block placement meets number merging.\n\nGrab shapes with your controllers and place them on the board in front of you. Bring matching numbers together to merge them into bigger values, or complete rows and columns to clear space and earn points.\n\nPlan your placements to trigger chain merges and clear multiple lines at once. Every move is a choice: build a bigger number or make room for your next shape.\n\n\u2022 Combine matching numbers for satisfying merges.\n\u2022 Complete rows and columns for rewarding clears.\n\u2022 Create chain reactions with clever placements.\n\u2022 Work toward score targets in Adventure mode.\n\u2022 Challenge your best score in Classic mode.\n\u2022 Learn the basics through guided, interactive tutorials.\n\nGrab a shape, find its spot, and see how far your next move takes you!", "short_description": "Grab, merge, and blast! Place colorful number blocks, combine matching numbers, and clear rows and columns in a satisfying VR puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playzostudios.github.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PlayzoStudios", "support_website_url": null, "website_url": "https://playzostudios.github.io/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1499418059912748"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1453495853403
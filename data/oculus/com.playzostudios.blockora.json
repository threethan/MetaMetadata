nc_sid=6e7a0a&_nc_ohc=q-Q3u_QYLzEQ7kNvwH7yD4A&_nc_oc=AdppWXdvmY6jgP1CCVimbj9mJdfiIn_FTZ_bq8Qk4GmImHDTgtXX36GB_bKohl0mal4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUYyir_0SE_KPJvXBEJuuWFDCPHP59GXkJsGslA0uYWA&oe=6B0F0175"}, {"file_name": "05-Row-Clear-Burst.png", "id": "2207848610111837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_2207848613445170_5380384909991004528_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ksjm_87ZFEQ7kNvwETJg5H&_nc_oc=AdqYFaoOMoIv-uIhO4Sw6ySWKJaDleTyFuEThi0vgX61eEQLQxNEui7qYP_9h2a7D28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWw2WCxL-ZTY4PmIgWilWU7zCAbogzYe5Mcr__BJ1ciLw&oe=6B0F1689"}, {"file_name": "04-Tutorial-Cross-Placement.png", "id": "1404873324725396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823910_1404873328058729_5394084201620018365_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4iD5AFCAicQ7kNvwHBgCNQ&_nc_oc=AdqeXI3UaCE4r3syGowNVy8QJ3u5BgqfxZ9BQkTAOkKUz73J6IZbl_oPZOutvhcT1WI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBoBNPvXExV0QoupwXc03EtYKz74YE0Mbv6zp7f1so5Q&oe=6B0F10CC"}, {"file_name": "03-Chain-Merge-In-Action.png", "id": "2654543215028874", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_2654543218362207_4339019916801932313_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow2K3wBojsMQ7kNvwG0F-xD&_nc_oc=AdrwPJ4KON13cZTsyjPSRyE1GM4FItqfOi2035wL66AUbczRGZ5gfSE6Nc5zTCKIn4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWeQUBZsvOIFL1dy4ZCdvMRxDWiY7e638FEupb51PZp_g&oe=6B0F0BD4"}, {"file_name": "01-Classic-Spatial-Board.png", "id": "2508590176218568", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_2508590179551901_7193387634851244441_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A3Q9Li9CpkQ7kNvwEi0prP&_nc_oc=AdonqUMqKE05e3Eb8FS1ImOhIWxW9LqJKt_3WyfsuT9qh9OCO6s8Fw0-QRygLmEUUHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUGuUoCGBtaE1TS4FL3W_MohQyLZdlUTvJ_cgVMroK7Eg&oe=6B0EFC9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blockora", "keywords": ["Merge", "VR", "Puzzle", "Logic", "Block"], "long_description": "Step into Blockora, a colorful VR puzzle game where block placement meets number merging.\n\nGrab shapes with your controllers and place them on the board in front of you. Bring matching numbers together to merge them into bigger values, or complete rows and columns to clear space and earn points.\n\nPlan your placements to trigger chain merges and clear multiple lines at once. Every move is a choice: build a bigger number or make room for your next shape.\n\n\u2022 Combine matching numbers for satisfying merges.\n\u2022 Complete rows and columns for rewarding clears.\n\u2022 Create chain reactions with clever placements.\n\u2022 Work toward score targets in Adventure mode.\n\u2022 Challenge your best score in Classic mode.\n\u2022 Learn the basics through guided, interactive tutorials.\n\nGrab a shape, find its spot, and see how far your next move takes you!", "short_description": "Grab, merge, and blast! Place colorful number blocks, combine matching numbers, and clear rows and columns in a satisfying VR puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playzostudios.github.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PlayzoStudios", "support_website_url": null, "website_url": "https://playzostudios.github.io/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended
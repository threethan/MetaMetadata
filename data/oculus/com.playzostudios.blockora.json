nc_sid=6e7a0a&_nc_ohc=1it4gsmZEcIQ7kNvwExm3JD&_nc_oc=AdpXybRXehCQHZ8pTxXQJ9KIjB5d5XejjlEIPR1wrsAsQs80x5iTOTQoKj3bcSylNtw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSx8J22pvk7DqJCWSMjh5Y607Bj1bggO3gOGJNFK8GT7g&oe=6B0C5E75"}, {"file_name": "05-Row-Clear-Burst.png", "id": "2207848610111837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_2207848613445170_5380384909991004528_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ksjm_87ZFEQ7kNvwF2regI&_nc_oc=AdqTriMpFNY5-cnSrBET99aZq7Bh3b1ok19o7VBXOZMDP_HOA3K2MkYv0Wa7vYnxIzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvaHzT9YqDmVvGBY5hNuwUwQgxViF9EflVw2zzTeDZKA&oe=6B0C7389"}, {"file_name": "04-Tutorial-Cross-Placement.png", "id": "1404873324725396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823910_1404873328058729_5394084201620018365_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu0R4MhIeboQ7kNvwElpgdO&_nc_oc=AdoOknYO90zVrvcwqH8Qhm01-Q7lqMwQPdh_TVW8eh4tdtIXR0A24ksiydtw0q_5U-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5yR1S-i_kWRD41wHAgj2PW88tmLSiMsphOeXUTd34GA&oe=6B0C6DCC"}, {"file_name": "03-Chain-Merge-In-Action.png", "id": "2654543215028874", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_2654543218362207_4339019916801932313_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZAMcPOVMqcQ7kNvwEjDFLZ&_nc_oc=Adr11NUOYDstXYaunVxbQG0OvG1xVdU2s7FVg0foLcqUiQYvL9sv_JnytZ1C0jQkzPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRp4K0xGa_fmHzOlDuURqTv8otaVL4dBkY1-gB-ngbWLA&oe=6B0C68D4"}, {"file_name": "01-Classic-Spatial-Board.png", "id": "2508590176218568", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_2508590179551901_7193387634851244441_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8fshod5MsYQ7kNvwHW3dP0&_nc_oc=AdqB7NffMeapji1wKzRCf4JQ_5LRg0SFCpGD80yCR5nVDzjm7k6odPmlR30U3BSeweY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXfs-FH5Uu5l2ttnklm-bAKaF2pN3LYbCS1qdVBkLBWw&oe=6B0C599D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blockora", "keywords": ["Merge", "VR", "Puzzle", "Logic", "Block"], "long_description": "Step into Blockora, a colorful VR puzzle game where block placement meets number merging.\n\nGrab shapes with your controllers and place them on the board in front of you. Bring matching numbers together to merge them into bigger values, or complete rows and columns to clear space and earn points.\n\nPlan your placements to trigger chain merges and clear multiple lines at once. Every move is a choice: build a bigger number or make room for your next shape.\n\n\u2022 Combine matching numbers for satisfying merges.\n\u2022 Complete rows and columns for rewarding clears.\n\u2022 Create chain reactions with clever placements.\n\u2022 Work toward score targets in Adventure mode.\n\u2022 Challenge your best score in Classic mode.\n\u2022 Learn the basics through guided, interactive tutorials.\n\nGrab a shape, find its spot, and see how far your next move takes you!", "short_description": "Grab, merge, and blast! Place colorful number blocks, combine matching numbers, and clear rows and columns in a satisfying VR puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playzostudios.github.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PlayzoStudios", "support_website_url": null, "website_url": "https://playzostudios.github.io/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended
://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75221314_1357763398352746_7690606563002265447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8j5z8sn2p0Q7kNvwH_xd97&_nc_oc=AdrdsDMLkdGH_fPyDLmVysjdqj88dbWciT3sixyEXtXd-TegVjUvptEZ4EVdRIqUcV4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wFVYkVar11zWAlwodwdO6f5NZOIxECDkibk6d6O7dhw&oe=6A395880"}, {"file_name": "ss3.png", "id": "1273854476843760", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/86610708_1273854483510426_3057284611821445687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUkwbKYbmTcQ7kNvwGCEpRF&_nc_oc=Ado0Qyy6lzG5b2MoT2kpCF7bs7PObUSggFuvLaNECSvl7A5kLwl3Jt4P3DjnEfpK_YU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fhRmANUS0Mu22dp7QAbhBrxAiE9Q_8qH4f1QnToS8Cg&oe=6A39434D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1579634055851718", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75392880_1579634059185051_605609078413117334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL2sBIEIamYQ7kNvwHY3Iwe&_nc_oc=Adq3EwUFxQELPakuSuyLkAFQ-VT7MFBJ8d9oyftPTterA_ggkPB6AMkfk0qs_6AOPKE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QqSmYqqlAQqKYkWGLhnJKsLHsFM-HyN4hI--n7MO8sA&oe=6A3948E0"}, "display_name": "Traffic Sign Learning", "keywords": [], "long_description": "In this traffic game developed by Kleinstein Games, you will contribute to your children's learning while testing yourself.\nIn this game, which passes over a road in the city, you will try to choose the correct one from the 5 signs that appear in front of you within 60 seconds, according to the voice that guides you when you start the game. The more correct plates you know, the more points you earn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!", "short_description": "In this game developed by Kleinstein Games, you will learn traffic rules as well as traffic signs. You can also play this game with your children and help them learn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kleinstein.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kleinstein Games", "support_website_url": null, "website_url": "https://kleinstein.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1560936724427806"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8972454786129557", "version": "1"}, "id": "761670638643810", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8971422716232764", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8972454786129557"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "761670638643810"}]}, "change_log": null, "created_date": 1678193631, "id": "8972454786129557", "version": "1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_res
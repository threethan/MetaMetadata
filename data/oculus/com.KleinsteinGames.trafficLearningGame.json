0_1579634059185051_605609078413117334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2mCaeYyVhYQ7kNvwFnTeio&_nc_oc=AdoVoZsup862GqKPGodYGMqCUH_nAesebU4Sk39Dzw-Up3PobWG72CVvHn6NsxhIh5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0Usw4bIGUm0i06KYr70n_NEiPEAKpd8ZSbgA5Sb9VIA&oe=6A8C1F20"}, "display_name": "Traffic Sign Learning", "keywords": [], "long_description": "In this traffic game developed by Kleinstein Games, you will contribute to your children's learning while testing yourself.\nIn this game, which passes over a road in the city, you will try to choose the correct one from the 5 signs that appear in front of you within 60 seconds, according to the voice that guides you when you start the game. The more correct plates you know, the more points you earn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!", "short_description": "In this game developed by Kleinstein Games, you will learn traffic rules as well as traffic signs. You can also play this game with your children and help them learn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kleinstein.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kleinstein Games", "support_website_url": null, "website_url": "https://kleinstein.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
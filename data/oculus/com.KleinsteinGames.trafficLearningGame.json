_hxlKOXxRjVE8zHh_jw&oe=69A2D540"}, {"file_name": "ss3.png", "id": "1273854476843760", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610708_1273854483510426_3057284611821445687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP7x8GTnKV0Q7kNvwFYFCGy&_nc_oc=Admctcr_uh9IwA58YNU_sMAFE7Nv8GByvmjO-ng5zS1X6H27wSjz1xCnz2fqKsLR1Hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJTqk6D2QrtwE5t_zIpTQIM283yGQqfr_lS1IFByaIVQ&oe=69A2F84D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1579634055851718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392880_1579634059185051_605609078413117334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlXFfTpcBWsQ7kNvwEITY-s&_nc_oc=AdnqxfwM8mvu--EkV_2XrfcAOX8KZ9J4RawY9OT04CoCUKw6jSCZwjl9GVs44FFaQEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvPFvfYKVP_n8wJxHiK0XYcCElD7zyGGFDKMXCQJS-Tlw&oe=69A2C5A0"}, "display_name": "Traffic Sign Learning", "keywords": [], "long_description": "In this traffic game developed by Kleinstein Games, you will contribute to your children's learning while testing yourself.\nIn this game, which passes over a road in the city, you will try to choose the correct one from the 5 signs that appear in front of you within 60 seconds, according to the voice that guides you when you start the game. The more correct plates you know, the more points you earn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!", "short_description": "In this game developed by Kleinstein Games, you will learn traffic rules as well as traffic signs. You can also play this game with your children and help them learn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kleinstein.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kleinstein Games", "support_website_url": null, "website_url": "https://kleinstein.games/", "ca
62PPD7-Yg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH4mERZuU19bmcYdAk8_9Gx_9dAQMteWANkg2gC33YBw&oe=6AFDB2CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1579634055851718", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75392880_1579634059185051_605609078413117334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8Nwz87F1g4Q7kNvwHDf8EW&_nc_oc=AdojJSyWZA1qrapapoe3nQZAPzA7BQYtY27yd0XvskNY0uNqTxdNx_jBD6zWPEr5QgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq--RSVl-yb7fgfjeXLpz9GL31zyPOsoaaifV9R3oNqQ&oe=6AFDB860"}, "display_name": "Traffic Sign Learning", "keywords": [], "long_description": "In this traffic game developed by Kleinstein Games, you will contribute to your children's learning while testing yourself.\nIn this game, which passes over a road in the city, you will try to choose the correct one from the 5 signs that appear in front of you within 60 seconds, according to the voice that guides you when you start the game. The more correct plates you know, the more points you earn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!", "short_description": "In this game developed by Kleinstein Games, you will learn traffic rules as well as traffic signs. You can also play this game with your children and help them learn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kleinstein.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kleinstein Games", "support_website_url": null, "website_url": "https://kleinstein.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
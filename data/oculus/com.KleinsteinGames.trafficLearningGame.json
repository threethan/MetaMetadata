f6CYPUa8BpTkNkLY-TQ&oe=699AEC40"}, {"file_name": "ss3.png", "id": "1273854476843760", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610708_1273854483510426_3057284611821445687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyaJ-DY20M0Q7kNvwElaa5r&_nc_oc=Adkxob3QupCWTlYn-3V5_t0YJ0gAOTpKoODyMmYXb7G-qmFkETFx86g05mvNNSMD7AI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuupliiY_1NtWUpxKK6uJIRBoMJUVZq9M8p4c6zSHc5yA&oe=699B0F4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1579634055851718", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392880_1579634059185051_605609078413117334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGeQRXylrEwQ7kNvwGuGJG-&_nc_oc=AdmVWAGdV40RwTEKFzIGia0d7J1MYH4ktIIyZqqPgob5BqwgWVqaeAdQzAPhtbCtpeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftdhHGpQbKnOYe1wLRjjLLFHGjxWrv4InA4oz2DkaYRXw&oe=699B14E0"}, "display_name": "Traffic Sign Learning", "keywords": [], "long_description": "In this traffic game developed by Kleinstein Games, you will contribute to your children's learning while testing yourself.\nIn this game, which passes over a road in the city, you will try to choose the correct one from the 5 signs that appear in front of you within 60 seconds, according to the voice that guides you when you start the game. The more correct plates you know, the more points you earn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!", "short_description": "In this game developed by Kleinstein Games, you will learn traffic rules as well as traffic signs. You can also play this game with your children and help them learn. \n\nLanguage is Turkish but English version coming soon. \nGood luck!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kleinstein.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kleinstein Games", "support_website_url": null, "website_url": "https://kleinstein.games/", "ca
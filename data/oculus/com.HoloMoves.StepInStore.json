": "1897286920971722", "locale": "en_US", "screenshots": [{"file_name": "fullscene.png", "id": "833298189615449", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822327_833298196282115_5639531539804397637_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcDSkuwfF8MQ7kNvwFS-Yw5&_nc_oc=Adp9jgzdKhenTQZcMqHH_FYY1SywALODD2LTEYJpZCVwXqwEbN3Rytj05YQNGsC9J3o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICbpjlPNm_Yikgv2wAcLOIxJcpSf-FJRbmvqJnXlUd2A&oe=6A9AE3FB"}, {"file_name": "checkout.png", "id": "1323736446170030", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820923_1323736449503363_6973489120365990552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YqHjPV103QQ7kNvwFGj4Qj&_nc_oc=AdpWrjpZHMQONz6U51V5CExtxNDZyX3cshGaxUFtfqdvSWxOEB1RPDrbB7vd_Gjxi_k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxJqfr5ysqcXnq0MXEAQVDA2AbDuAJLp8tNTTWLihIlg&oe=6A9AC8B3"}, {"file_name": "list&basket.png", "id": "2803641826635608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_2803641829968941_7502537882827115880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siknIKUrg4YQ7kNvwFkBME5&_nc_oc=AdphiMELJo3Tc6_QXpwX8W9NOdP-LtCFzibKfadSo0lPFR-nrhd7vsRygru7jJaiwa4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZnhw2PTBwwFQ5UwqY37rShsWdCaY8FikbxejmMKRz9A&oe=6A9AC150"}, {"file_name": "shelves&basket.png", "id": "1153226346797119", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825345_1153226350130452_8544578516053865225_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqIWJKJziMkQ7kNvwG8Zd-p&_nc_oc=AdqX_ShZ8TgqyQ7Hq3us6yqBnq2c8c26XLSNUUQak5UpSS-Jtgiz7qbDR0CnTr31Fes&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcujmjbFdspuAn7dY6UY9ELs5Fp1ujZgo30xCvoXacOw&oe=6A9AC688"}, {"file_name": "shelves.png", "id": "2650365845314389", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_2650365848647722_5166426717496549302_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6oqqOKWC1kQ7kNvwHQQBNg&_nc_oc=AdquciUPWFbOzW5vo91S6uQYcId5UxzK827XGTcjlgeYBjUGR2_BL2FKOF3M-Ctz4gY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLN6hwgxriH_i17f3Ppc7kH3xEaSgcdu1I6l7QgFpG6g&oe=6A9AE7AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Step-In-Store", "keywords": ["holomoves", "HoloMoves", "stepinstore", "steppingstore", "store"], "long_description": "Step-In Store is an innovative Mixed Reality game by HoloMoves that allows players to practice everyday activities in a playful and engaging way, with grocery shopping as the central theme. The game consists of three mini-games that together simulate the complete shopping experience.\n\nIn the first mini-game, players receive a shopping list and explore the virtual store to find products and place them in their basket. This encourages active exploration, focus, and goal-oriented movement.\n\nThe second mini-game revolves around self-scanning and paying for groceries, adding elements of coordination, and decision-making.\n\nIn the free-play level, players can choose their own pace and actions, offering additional freedom and engagement.\n\nThe game is inspired by real-life situations, making it recognizable and motivating.\n\n**(!) Step-In-Store is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Step-In Store is an interactive Mixed Reality exergame where players practice everyday grocery shopping. Through three mini-games, allowing them to practice executive functions such as orientation, product selection, self-scanning, and payment. By actively looking around and moving, players fill their shopping basket and complete the shopping process at their own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "nl_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26503447912675611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1573678193806247_7675995558099046839_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTz0niUZqYkQ7kNvwEkhUpo&_nc_oc=Adpz-KWsMAuMXsjnqwbUc008dYPE7WMqjmceMQvooVgUP5Oz4ruvyrX2NaZUuox_f9I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjq1qveJZniM9BkQYNyQVJL0p1BdNTWknOHzVQXLQBDw&oe=6A9AC6C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Step-In-Store", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1772012700, "lastRevision": {"nodes": [{"id": "24830450519975367", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24830450449975374", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1446464343305473"}, "iarc_email": null, "
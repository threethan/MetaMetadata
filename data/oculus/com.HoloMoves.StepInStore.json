-7NdGPRMNRu-CB0PM9t2OUq9lQAsEGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pbRJW_qeTfcC5z_CEE5RhXG5EX4xqy4U7or2TiRfuoQ&oe=69F898D0"}, {"file_name": "shelves&basket.png", "id": "1153226346797119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_1153226350130452_8544578516053865225_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2j7JJuFwGMQ7kNvwHXgdsH&_nc_oc=Adq2DL0Q5aMgzATzKooXB6vb4UTWzmYnX_KrFTU61pSy5Ao4YDmH7q0Rj_ljUbOMbmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Z1v176nOdNQlkEpxq8mfhseOjaD9X50rzcDRZfA4syQ&oe=69F89E08"}, {"file_name": "shelves.png", "id": "2650365845314389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822307_2650365848647722_5166426717496549302_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9-J9LgRBWYQ7kNvwGYIfaB&_nc_oc=AdqLa2LPPNc9Wvd1XbDfHkVVggLW_1MjtXVgChqwhEvEXwoOB1t5uCEwfaWQSrKJw1E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1T0-40SYRWPWY5T-oNSKrum4pyQYvR60_5gnYW6IbXrA&oe=69F8BF2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Step-In-Store", "keywords": ["holomoves", "HoloMoves", "stepinstore", "steppingstore", "store"], "long_description": "Step-In Store is an innovative Mixed Reality game by HoloMoves that allows players to practice everyday activities in a playful and engaging way, with grocery shopping as the central theme. The game consists of three mini-games that together simulate the complete shopping experience.\n\nIn the first mini-game, players receive a shopping list and explore the virtual store to find products and place them in their basket. This encourages active exploration, focus, and goal-oriented movement.\n\nThe second mini-game revolves around self-scanning and paying for groceries, adding elements of coordination, and decision-making.\n\nIn the free-play level, players can choose their own pace and actions, offering additional freedom and engagement.\n\nThe game is inspired by real-life situations, making it recognizable and motivating.\n\n**(!) Step-In-Store is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Step-In Store is an interactive Mixed Reality exergame where players practice everyday grocery shopping. Through three mini-games, allowing them to practice executive functions such as orientation, product selection, self-scanning, and payment. By actively looking around and moving, players fill their shopping basket and complete the shopping process at their own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "nl_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26135359439484462"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4404216639846710"}, {"status": "PUBLISHED", "id": "796605599952461"}]}, "baseline_offer": {"id": "4404216639846710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772528940, "status": "PUBLISHED", "id": "4404216639846710"}]}, "liveChannel": {"nodes": [{"latest_support
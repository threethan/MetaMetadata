UxRxZuPL121_wDyt8NdMIQ&oe=69A574BB"}, {"file_name": "checkout.png", "id": "1323736446170030", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820923_1323736449503363_6973489120365990552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrOA5o0Jzp4Q7kNvwE5_Qwb&_nc_oc=AdmRZO_bHWv4SkB4TrmzwIr-fCR3ieO3yFF3HREHRpHvxHxbkVtb9vGr8Qp36n8Dkvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftLva5orxSqrLYeR6esdNkmRcoAoQ2C3y2fBk-nyjMGeg&oe=69A591B3"}, {"file_name": "list&basket.png", "id": "2803641826635608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_2803641829968941_7502537882827115880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am_RjL6oKKAQ7kNvwH-6aAN&_nc_oc=AdmKdkmJR9jGpb09vmuEwegD2UyBqT5hUYukUqtO-11B4r7BevBLEZXCbifipCqmqvE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvhPda8uZHS3fMptcYtZCJ2L_Csm3VSRQiiQuvgaiFt5w&oe=69A58A50"}, {"file_name": "shelves&basket.png", "id": "1153226346797119", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825345_1153226350130452_8544578516053865225_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqJQJFJYYDQQ7kNvwGHGmFm&_nc_oc=AdkDwXpUtvhOzzkGvJDoMzoSbbLd3CSgk3wvE04ula0Wm3eUufj2TN0plb6KIuxw8KQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs0_tO2Pj5JXSZGSEi8VApbapHUzmz4Wj4rQmV4sVeyYg&oe=69A58F88"}, {"file_name": "shelves.png", "id": "2650365845314389", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_2650365848647722_5166426717496549302_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kri7aRPfVaEQ7kNvwHXY1wb&_nc_oc=AdmA5ILf-p17M6N5HaGMNkmmnYkBsCGsc9gRGW-oIMsNpJRG8Y-ESee6XE22G9T6gTI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftwL9IypmJbLwOZsXd-H8umwhou3I1qzqsykjRaRMzmJw&oe=69A5786F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Step-In-Store", "keywords": ["holomoves", "HoloMoves", "stepinstore", "steppingstore", "store"], "long_description": "Step-In Store is an innovative Mixed Reality game by HoloMoves that allows players to practice everyday activities in a playful and engaging way, with grocery shopping as the central theme. The game consists of three mini-games that together simulate the complete shopping experience.\n\nIn the first mini-game, players receive a shopping list and explore the virtual store to find products and place them in their basket. This encourages active exploration, focus, and goal-oriented movement.\n\nThe second mini-game revolves around self-scanning and paying for groceries, adding elements of coordination, and decision-making.\n\nIn the free-play level, players can choose their own pace and actions, offering additional freedom and engagement.\n\nThe game is inspired by real-life situations, making it recognizable and motivating.\n\n**(!) Step-In-Store is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Step-In Store is an interactive Mixed Reality exergame where players practice everyday grocery shopping. Through three mini-games, allowing them to practice executive functions such as orientation, product selection, self-scanning, and payment. By actively looking around and moving, players fill their shopping basket and complete the shopping process at their own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "nl_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26135359439484462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1573678193806247_7675995558099046839_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjpdXFRrYN0Q7kNvwFlSQFe&_nc_oc=Adk4BREY2OfJYsuiHQTpCqAdpd-aqGt5UNcNmP8LugjZrhQKSptxfxEyNY44Nywhq7U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afthl0DV5tKwDE0MrD1nfpye27-HkCycrbOfHRCl3q3CDg&oe=69A58FC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Step-In-Store", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1772012700, "lastRevision": {"nodes": [{"id": "24830450519975367", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24830450449975374", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1446464343305473"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "square_StepInStore.png", "id": "1573678187139581", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1573678193806247_7675995558099046839_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjpdXFRrYN0Q7kNvwFlSQFe&_nc_oc=Adk4BREY2OfJYsuiHQTpCqAdpd-aqGt5UNcNmP8LugjZrhQKSptxfxEyNY44Nywhq7U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftvD7PD1-ZCNCMTQLsrcSwRORM5nffZCxMs7NsfYooFPw&oe=69A
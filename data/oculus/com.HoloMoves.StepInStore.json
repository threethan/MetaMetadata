.oculuscdn.com&_nc_ss=8&oh=00_AftkatzxhiSADRqg6lmxZLJBZxI-xTj4zhLAXxM8mjpe8Q&oe=69A9693B"}, {"file_name": "checkout.png", "id": "1323736446170030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1323736449503363_6973489120365990552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS6vzTcpJV4Q7kNvwE7bZPO&_nc_oc=AdlcWKPkIb33OavbXH1vnZmGz9jYjYc86-26-fMggelWQjLhVW7S4CceUNJLemexSoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftXsGKIW55zIZJN0PPPzqWQaE81rw1NBuas4_Ysn9wmdg&oe=69A98633"}, {"file_name": "list&basket.png", "id": "2803641826635608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_2803641829968941_7502537882827115880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z38d3i8NUCcQ7kNvwHtpSHm&_nc_oc=Adko8gYvinpedJpjqU9VsnaPSWWKnFuILqKQjRJbyS72U_kN6G8Ma2F7wwwoOX7YT04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsfhI8JC-D61JxhBMlIx17uWlaDnKnu5hLB4ncKZt3X9g&oe=69A97ED0"}, {"file_name": "shelves&basket.png", "id": "1153226346797119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1153226350130452_8544578516053865225_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp2FgV85MaEQ7kNvwGFi8U3&_nc_oc=AdmEe3MOlIf6oj8ASSALAA4TF2tnDtDuwC4y39EiwhlYRTHYjGaynGYbnj_T4H6Di_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_45ECs7q5MPys3CUi-VEMU27sJdCcUZ9yy_0-Ho4QmA&oe=69A98408"}, {"file_name": "shelves.png", "id": "2650365845314389", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_2650365848647722_5166426717496549302_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU_AkkkgtRcQ7kNvwEdE_Yy&_nc_oc=AdlmbsJJEMxdAB90b5TrZgrcmCO4hulMX9RJDgWRTjkzWCyUJNueTR_QLGwBJA6ejpg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuYCtdsFkO9IIOugkKqNu8VlRTIbCccCzKwvDyv8JTUNw&oe=69A96CEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Step-In-Store", "keywords": ["holomoves", "HoloMoves", "stepinstore", "steppingstore", "store"], "long_description": "Step-In Store is an innovative Mixed Reality game by HoloMoves that allows players to practice everyday activities in a playful and engaging way, with grocery shopping as the central theme. The game consists of three mini-games that together simulate the complete shopping experience.\n\nIn the first mini-game, players receive a shopping list and explore the virtual store to find products and place them in their basket. This encourages active exploration, focus, and goal-oriented movement.\n\nThe second mini-game revolves around self-scanning and paying for groceries, adding elements of coordination, and decision-making.\n\nIn the free-play level, players can choose their own pace and actions, offering additional freedom and engagement.\n\nThe game is inspired by real-life situations, making it recognizable and motivating.\n\n**(!) Step-In-Store is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Step-In Store is an interactive Mixed Reality exergame where players practice everyday grocery shopping. Through three mini-games, allowing them to practice executive functions such as orientation, product selection, self-scanning, and payment. By actively looking around and moving, players fill their shopping basket and complete the shopping process at their own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", 
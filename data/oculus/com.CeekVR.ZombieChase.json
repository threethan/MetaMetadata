998416F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Chase Virtual Reality Endless Runner", "keywords": ["zombies", "endlessrunner", "horror", "zombiechase", "templerun"], "long_description": "Game action unfolds in an apocalyptic city and its suburbs. The game is a dynamic first person virtual reality runner. The main character runs away from the insidious monsters who try to attack. \nMonsters are everywhere, running behind you, jumping from the side and above, jumping from buildings and the other surroundings.\n\nYou will encounter various obstacles such as falling rubble, cracked asphalt, holes in the ground, burning cars and much more.  ", "short_description": "The goal of the game is to reach the end of the level. During the game, players can collect various bonuses such as run acceleration, super jumps, lives and coins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ceek.com/privacy-policy", "developer_terms_of_service_url": "https://www.ceek.com/terms", "publisher_name": "CEEK VR INC", "support_website_url": null, "website_url": "http://www.zombiechase.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629407251629365"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139310_957710257695804_4100077670270763008_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcoMJI25wlEQ7kNvwHz3PtC&_nc_oc=AdlNBDrzjg0MEyqs48Edqu
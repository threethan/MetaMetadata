Z9W41g&oe=6B0C7FFE"}, {"file_name": "Sphere_XR_Meta_Store_Sell.png", "id": "939822794424967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393561_939822797758300_1223800738557011710_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaV9_wZzc8EQ7kNvwGBQEZl&_nc_oc=Adq636t_RTR_7cww4lrBZEMcK1peSoV4Xj8nye07W46a_c2rL9eCN_sNnl59kJYhxu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTr4G_74ayBn4Hc6tkSuHmiOXV9IWF_q8Iyf6nyGqjNeA&oe=6B0C72A5"}, {"file_name": "SphereXR_Meta_Store_MediaPanel.png", "id": "903291261132463", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974787_903291264465796_946117444388763031_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TZSnBNKx7UQ7kNvwHKNi-N&_nc_oc=Adp7s38Ku3AZDko3ZgzNppS7A4XVGuk_rlGEFWULU7BdmwSBtFADgMPz-aiq21IDCSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvtUCQV--bu8Er5IFqRr60ImTmNUTDKJZj2cGAl19kQw&oe=6B0C4C08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere, Enterprise Augmented Reality Software", "keywords": [], "long_description": "* Most supported devices and platforms, including AR and VR headsets, monocular devices, mobile devices, and PC\n\n* A single application with turnkey support for five major enterprise XR use cases: spatial collaboration, sales showcasing, remote assistance, workflow guidance and training, and immersive build planning\n\n* Flexible deployment options, including SaaS (standard), private cloud, and on-prem\n\n* Out-of-the-box integration with existing conferencing tools like Teams\n\n* Built-in CMS that enables usage of existing 2D and 3D assets for rapid, no-code content creation\n\n* Integration-ready, with a trusted network of partners to deliver backend systems integrations with PLM, LMS, ERP systems\n", "short_description": "Sphere is the most complete, interoperable, and enterprise-ready XR solution on the market, helping businesses of all siz
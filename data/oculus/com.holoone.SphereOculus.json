rvm-H_3kNSA5M6X8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft4CoC1s82USCC-nx3XFbSRxN1-iViBGLYYIVvdGCT7GA&oe=69A996E5"}, {"file_name": "SphereXR_Meta_Store_MediaPanel.png", "id": "903291261132463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974787_903291264465796_946117444388763031_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wtnLayfMy0Q7kNvwE0Hr58&_nc_oc=AdluOmdvWfenr50T-_-8LwJ6xSNOfa2hRQ8hYHJ8ThHsCoEOTJYbI98158Ue8TweoIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft38WoiR9cD9iJCSJeIohKMkh5uRkYANpFmNcqaWgK2JA&oe=69A97048"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere, Enterprise Augmented Reality Software", "keywords": [], "long_description": "* Most supported devices and platforms, including AR and VR headsets, monocular devices, mobile devices, and PC\n\n* A single application with turnkey support for five major enterprise XR use cases: spatial collaboration, sales showcasing, remote assistance, workflow guidance and training, and immersive build planning\n\n* Flexible deployment options, including SaaS (standard), private cloud, and on-prem\n\n* Out-of-the-box integration with existing conferencing tools like Teams\n\n* Built-in CMS that enables usage of existing 2D and 3D assets for rapid, no-code content creation\n\n* Integration-ready, with a trusted network of partners to deliver backend systems integrations with PLM, LMS, ERP systems\n", "short_description": "Sphere is the most complete, interoperable, and enterprise-ready XR solution on the market, helping businesses of all sizes and around the globe achieve operational efficiencies and cost savings across a variety of job functions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sphere.tech/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sphere XR", "support_website_url": null, "website_url": "https://sphere.tech/", "category": null, "comfort_rating": "NOT_R
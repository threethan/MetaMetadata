XeHu2w&oe=6B05B03E"}, {"file_name": "Sphere_XR_Meta_Store_Sell.png", "id": "939822794424967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393561_939822797758300_1223800738557011710_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXvZqXDYNj0Q7kNvwHDVDr-&_nc_oc=AdpJzHlw6zt8L9ICX_CiIkRwtL18vup-KdyZTLuPCyso27Qn2D2quAXh8FVzGPDvhE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1aIr0bMTOFw0W-qxj2U58s-WVo0PEnmoi4K2CniRMzA&oe=6B05A2E5"}, {"file_name": "SphereXR_Meta_Store_MediaPanel.png", "id": "903291261132463", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974787_903291264465796_946117444388763031_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlWIImuIHV4Q7kNvwGsth3d&_nc_oc=Adp35WRVA5Km0J5VwIkzIY8-KPSSpsnWzAIgJsJ252tVSuyFVnr6seov_Rsk1lBB8nU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSboOTF6P1h7XFQjooMQ6qFSBhgaahMyig1bfnku9WvIg&oe=6B05B488"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere, Enterprise Augmented Reality Software", "keywords": [], "long_description": "* Most supported devices and platforms, including AR and VR headsets, monocular devices, mobile devices, and PC\n\n* A single application with turnkey support for five major enterprise XR use cases: spatial collaboration, sales showcasing, remote assistance, workflow guidance and training, and immersive build planning\n\n* Flexible deployment options, including SaaS (standard), private cloud, and on-prem\n\n* Out-of-the-box integration with existing conferencing tools like Teams\n\n* Built-in CMS that enables usage of existing 2D and 3D assets for rapid, no-code content creation\n\n* Integration-ready, with a trusted network of partners to deliver backend systems integrations with PLM, LMS, ERP systems\n", "short_description": "Sphere is the most complete, interoperable, and enterprise-ready XR solution on the market, helping businesses of all siz
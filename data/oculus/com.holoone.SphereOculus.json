Pn_9Gw&oe=6B0F22FE"}, {"file_name": "Sphere_XR_Meta_Store_Sell.png", "id": "939822794424967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393561_939822797758300_1223800738557011710_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4jUvwZbp1QQ7kNvwFs91jx&_nc_oc=Ador9vjMsehIqoInOPGx9gCBypLMdASIm6paiHLPp5TArW4ocbvoTMjuP0SpYDJpl8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWx0bi84jTspQGXWdpvEfmWq_sZ_oin_9eSegl9DVIvGg&oe=6B0F15A5"}, {"file_name": "SphereXR_Meta_Store_MediaPanel.png", "id": "903291261132463", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974787_903291264465796_946117444388763031_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCEYdmT5MukQ7kNvwFY-8-l&_nc_oc=Adq05dt_rhLgsYvOD9xulg-Bf0V_t51fPFW9UdSA6esC_xFARBOT3sluoBWSicZ-dBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXwv3ix6r8ZPFDz4jcQCMdx6bkODBN0OtRoOnb-Injt2w&oe=6B0EEF08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere, Enterprise Augmented Reality Software", "keywords": [], "long_description": "* Most supported devices and platforms, including AR and VR headsets, monocular devices, mobile devices, and PC\n\n* A single application with turnkey support for five major enterprise XR use cases: spatial collaboration, sales showcasing, remote assistance, workflow guidance and training, and immersive build planning\n\n* Flexible deployment options, including SaaS (standard), private cloud, and on-prem\n\n* Out-of-the-box integration with existing conferencing tools like Teams\n\n* Built-in CMS that enables usage of existing 2D and 3D assets for rapid, no-code content creation\n\n* Integration-ready, with a trusted network of partners to deliver backend systems integrations with PLM, LMS, ERP systems\n", "short_description": "Sphere is the most complete, interoperable, and enterprise-ready XR solution on the market, helping businesses of all sizes and around the globe achieve operational efficiencies and cost savings across a variety of job functions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sphere.tech/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sphere XR", "support_website_url": null, "website_url": "https://sphere.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "pt", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7101330956613323"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "812921344771650"}, {"status": "PUBLISHED", "id": "712055514149434"}]}, "baseline_offer": {"id": "812921344771650"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760353500, "status": "PUBLISHED", "id": "812921344771650"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25826626256990510", "version": "3.3.2"}, "id": "688556156547992", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6827900293956392", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25826626256990510"}, "release_status": "RELEASED"}, "binary_release_channels": {"
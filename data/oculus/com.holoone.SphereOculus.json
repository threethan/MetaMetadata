8iDNisYHoH56LCGP03i04bgxkLiZK7Jn-J4Qq6Cgbbte2_WeKNJ3YH38LHhM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr8_ujT-QMgiTsrK1BdRN1syrl-qo9tIdJ7DaQCRtrPw&oe=6AE8A1E5"}, {"file_name": "SphereXR_Meta_Store_MediaPanel.png", "id": "903291261132463", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974787_903291264465796_946117444388763031_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZDi7aQgmBkQ7kNvwGSi-Xi&_nc_oc=AdopvdSkhxagLum9azPcrjpqd4HZmeCyS-Y0I2kmnnKxb0fS5MkSqMfFQXmqdz8439U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtQP1D4w01XE-6kTJp5TtkMXQ9vT7rtfH37ius3Jfy5A&oe=6AE8B388"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere, Enterprise Augmented Reality Software", "keywords": [], "long_description": "* Most supported devices and platforms, including AR and VR headsets, monocular devices, mobile devices, and PC\n\n* A single application with turnkey support for five major enterprise XR use cases: spatial collaboration, sales showcasing, remote assistance, workflow guidance and training, and immersive build planning\n\n* Flexible deployment options, including SaaS (standard), private cloud, and on-prem\n\n* Out-of-the-box integration with existing conferencing tools like Teams\n\n* Built-in CMS that enables usage of existing 2D and 3D assets for rapid, no-code content creation\n\n* Integration-ready, with a trusted network of partners to deliver backend systems integrations with PLM, LMS, ERP systems\n", "short_description": "Sphere is the most complete, interoperable, and enterprise-ready XR solution on the market, helping businesses of all sizes and around the globe achieve operational efficiencies and cost savings across a variety of job functions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sphere.tech/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sphere XR", "support_website_url": null, "website_url": "https://spher
5432754974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv-wSwHdEyoQ7kNvwHIqbV4&_nc_oc=AdqO5qHGNU-fi68yT1wI0ENz_zHQWRFR9DAN_upFK9Huh2MYbgy6sViRjGBpU3_Z5Ag&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFqOeOoOVZ_KkJVrujWssqsRS_IBiROVD1ycnBQxBYwg&oe=6A858F27"}, {"file_name": "Oculus Gameplay3.png", "id": "2589079338053465", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974446_2589079341386798_5701318462477320192_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hbgTdqFOXQQ7kNvwEbIxSd&_nc_oc=AdqUFxRpq4n276IevTNpSJZ2zEX3g32Bk6X9DE-AWW1WG4MWmmyu_9BrsnxVE2lBoSo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7uM27biLXnG3hM5mu8k4Iwlt2_fF8MeFbBhlGD1FMRw&oe=6A858D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Cover Image.png", "id": "211954467323868", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974446_211954470657201_7154271562105092728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuMA2hypwNcQ7kNvwHdlMwZ&_nc_oc=AdrwWsnNKc5pXrqwZR6-HZVpR-9KsH9nq9prcJ6iE4DEPgK62crySTWIX3m2EfuXsp4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr-fdVEIlu2K0AQwLJmWGzlafxRu9Vgvb73j7mfV8qCA&oe=6A858302"}, "display_name": "Castle Thief ", "keywords": [], "long_description": "When you get to the castle, you'll start in the dungeon. You will only have until morning to escape your cell and bag as much loot as you can find, but if the guards catch you, they'll throw you back in your cell. There's a list of items and the prices you can fence them for. There are rumors the castle is home to rare treasures that are NOT listed, so if you come across anything interesting... bag it. You might be able to get a special price. Only the best of the best get their names on the Blacklist, so don't waste a single second.", "short_description": "Climb, sneak, and steal your way to top thief. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://adugan43.wixsite.c
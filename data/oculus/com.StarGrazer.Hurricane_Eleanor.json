, "id": "211954467323868", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_211954470657201_7154271562105092728_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNL5c1SiylEQ7kNvwG6sD2c&_nc_oc=AdpWTGP4u7K4qndZoB2cY3Wsn6wS42HIJvnBJb5Mss-OKYrBPAcV7IXqHJh0Ch_VKJI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2vXPEJDZK5bjsREtm3x7tNmANn1WXyCADzXF7BXabCQ&oe=6AFB4902"}, "display_name": "Castle Thief ", "keywords": [], "long_description": "When you get to the castle, you'll start in the dungeon. You will only have until morning to escape your cell and bag as much loot as you can find, but if the guards catch you, they'll throw you back in your cell. There's a list of items and the prices you can fence them for. There are rumors the castle is home to rare treasures that are NOT listed, so if you come across anything interesting... bag it. You might be able to get a special price. Only the best of the best get their names on the Blacklist, so don't waste a single second.", "short_description": "Climb, sneak, and steal your way to top thief. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://adugan43.wixsite.com/privacy-profile", "developer_terms_of_service_url": null, "publisher_name": "StarGrazer Studios", "support_website_url": null, "website_url": "https://sidequestvr.com/app/4394/castle-thief", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
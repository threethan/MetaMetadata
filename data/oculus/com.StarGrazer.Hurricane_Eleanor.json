XdzZMzw&oe=69F1E727"}, {"file_name": "Oculus Gameplay3.png", "id": "2589079338053465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974446_2589079341386798_5701318462477320192_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v75QZVUTiPEQ7kNvwHHumvk&_nc_oc=AdoxtdrGsi21eGp-MSqndFEb17I78fhugh3xa3SvdmDu0tVJNb3nYV3zOPCIMFcyssw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0O38Ba9ipx_wD3fLZIxMp3cveXhWP4p53XWZvrHKFbUQ&oe=69F1E54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Cover Image.png", "id": "211954467323868", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_211954470657201_7154271562105092728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndZU04p81gwQ7kNvwErGZ02&_nc_oc=Adq2XFPYkH62s1EEMjZf7WyDd8W5g9DGGj3RlfSydKe72lHQpcFMvAhCOIvokvJdo38&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3abQVA3PlgKISKdWM6gRGlDtmK9Hi373zkBfV_PNOBtw&oe=69F21342"}, "display_name": "Castle Thief ", "keywords": [], "long_description": "When you get to the castle, you'll start in the dungeon. You will only have until morning to escape your cell and bag as much loot as you can find, but if the guards catch you, they'll throw you back in your cell. There's a list of items and the prices you can fence them for. There are rumors the castle is home to rare treasures that are NOT listed, so if you come across anything interesting... bag it. You might be able to get a special price. Only the best of the best get their names on the Blacklist, so don't waste a single second.", "short_description": "Climb, sneak, and steal your way to top thief. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://adugan43.wixsite.com/privacy-profile", "developer_terms_of_service_url": null, "publisher_name": "StarGrazer Studios", "support_website_url": null, "website_url": "https://sidequestvr.com/app/4394/castle-thief", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cate
5432754974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeqkKg2xfJUQ7kNvwGdIbXq&_nc_oc=AdooecY5TZwlZDrwNkvgXZaWBfWHlkBW2x0ao_Peqo2bcfk0rbPLqGHePuj9GNF2GGQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt3B3r4hNHp_8Vo147BpqCEiLa6m2PC_UsphWogJenmg&oe=6A8D7827"}, {"file_name": "Oculus Gameplay3.png", "id": "2589079338053465", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974446_2589079341386798_5701318462477320192_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEP-hCgnrv4Q7kNvwF4rdQq&_nc_oc=Adp-HqE5GLhd8TQ2NWizTYtZHOx3zWJggTmkqH1SmKlZeJWn595-bcqORAIWn19QB60&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSOOzd5avlbBtMVl3sDj4CaG7rlCN_X4cAC1t5mS-yjA&oe=6A8D764F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Cover Image.png", "id": "211954467323868", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974446_211954470657201_7154271562105092728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQbC43749YkQ7kNvwHqtNHb&_nc_oc=AdogvqI1V37rl_btyN57wKaU7dE9c952rzUpJ06rO1lYgj30FPXvnfFv9bWZiwJlEHg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUqp7SGGO5vKssICShnDnJuVHi1Aqr8smrCarzIJpA_g&oe=6A8D6C02"}, "display_name": "Castle Thief ", "keywords": [], "long_description": "When you get to the castle, you'll start in the dungeon. You will only have until morning to escape your cell and bag as much loot as you can find, but if the guards catch you, they'll throw you back in your cell. There's a list of items and the prices you can fence them for. There are rumors the castle is home to rare treasures that are NOT listed, so if you come across anything interesting... bag it. You might be able to get a special price. Only the best of the best get their names on the Blacklist, so don't waste a single second.", "short_description": "Climb, sneak, and steal your way to top thief. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://adugan43.wixsite.c
5432754974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHYGjnHOltUQ7kNvwEIDhcs&_nc_oc=AdoyexJR7UfcvUSgN0b4GYWKzLIYKYj6msQMOAFevT-81Xst79zB656B9q9sIl7FMc0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIzqpsRQg9w1RG_9EBmH-7hTVg8wH6lino6wqnUUp-gw&oe=6A8EC9A7"}, {"file_name": "Oculus Gameplay3.png", "id": "2589079338053465", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974446_2589079341386798_5701318462477320192_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-273bYNwn-cQ7kNvwHb8BsS&_nc_oc=AdprMruVCuwn6EuzYEoiEPQO50j_Mb73WNVLc4jhKfZ7dwJkHdJGrEcjz1eOtqIbHPI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3qk0nmkdkS9sxD4FcN9UQJeVpzJm_vKb4qgLw1OwIMQ&oe=6A8EC7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Cover Image.png", "id": "211954467323868", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974446_211954470657201_7154271562105092728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQbC43749YkQ7kNvwE7Br2V&_nc_oc=AdqI6BvHEkAVnfyQZPWBQp8xiz8XhWZTi2qDFyRAcOiMyjgEowxt9jPQT_Jinp1WvE0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyq36bERNbmCXoRfkYTaacaIb_2pFpObZt3UlA6rL78w&oe=6A8EF5C2"}, "display_name": "Castle Thief ", "keywords": [], "long_description": "When you get to the castle, you'll start in the dungeon. You will only have until morning to escape your cell and bag as much loot as you can find, but if the guards catch you, they'll throw you back in your cell. There's a list of items and the prices you can fence them for. There are rumors the castle is home to rare treasures that are NOT listed, so if you come across anything interesting... bag it. You might be able to get a special price. Only the best of the best get their names on the Blacklist, so don't waste a single second.", "short_description": "Climb, sneak, and steal your way to top thief. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://adugan43.wixsite.c
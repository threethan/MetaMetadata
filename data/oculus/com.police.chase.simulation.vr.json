eYv5OG9MQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-73CrKmddb7zbxnU97l8JHbMKUaKiya4XOLc8eRhGZQ&oe=69CF9E9D"}, {"file_name": "ss1.png", "id": "1134782388126480", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393652_1134782391459813_3118064293112323237_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEPs7YTVcYoQ7kNvwGF3d_g&_nc_oc=AdoUxn876Lpfr1VJ3JGR4iEsr7_B4luhCd8km4_ghR5CxeTVO7FNvXjqvDdm5mRlG7g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDroibHlgv3YwiOQGKbfIi_lIQN1o3YfW6T9694UOnKw&oe=69CFBC41"}, {"file_name": "ss3.png", "id": "1285238732734324", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391978_1285238736067657_6026839217062817599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjaXdWit5LQQ7kNvwFTAZqN&_nc_oc=AdqEM11ZZO_Y98_wTv0zIXl_tY6TOpHUwKBfa506FdsXUEjgWt6_524IUdmZrZKvTOM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMSrSK6WGij2EGhzM1pPqAPK--5j2SujgzouT3N_JAbA&oe=69CFD150"}, {"file_name": "ss5.png", "id": "537992812657349", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392179_537992815990682_1527437521638999386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wh0qVbi1_q0Q7kNvwFBgiun&_nc_oc=AdoPO-18kx1x9p7ULjnx3CbCvQE1_Qus1-Tt_QhtCd3vLcdaaPOiVWMr3h59J87Rcg8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOnqN8ZVp6oANil_awiaDrWjyjhEyimuWvfaJo8teUJg&oe=69CF9F20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Police Chase Simulator VR", "keywords": ["Driving", "Police", "Simulator", "Racing", "Chase"], "long_description": "\ud83d\udea8 Welcome to Police Chase Simulator VR \ud83d\ude94\nStep into the shoes of a law enforcement officer and experience the thrill of high-speed car chases, intense cop action, and adrenaline-pumping crime pursuits in a fully immersive open-world driving simulator. Whether you're chasing down criminals, patrolling the streets, or enforcing the law, this is the ultimate VR experience for fans of car driving games and action-packed simulations.\n\nDrive Realistic Police Cars:\nTake control of a variety of police vehicles, from sleek cruisers to powerful SUVs, and navigate through a dynamic urban environment. Feel the rush of high-speed pursuits as you chase down suspects and bring them to justice.\n\nExplore an Open-World City:\nImmerse yourself in a sprawling open-world city filled with bustling streets, hidden shortcuts, and challenging terrain. Every corner offers a new challenge, whether it's a daring escape or a tense standoff.\n\n\ud83c\udfae Thrilling Missions and Challenges:\nTake on a variety of missions, from car chases and crime busts to emergency responses. Use your skills to outsmart criminals, avoid obstacles, and complete objectives in this action-packed VR simulator.\n\nRealistic car driving physics and controls.\n\nImmersive VR environments and stunning visuals.\n\nPerfect for fans of car driving simulators, police games, and open-world adventures.\n\n\u2b07\ufe0f Download Police Chase Simulator VR now. Whether you're a fan of car driving, police action, or thrilling simulations, this game delivers an unforgettable experience.", "short_description": "\ud83d\ude97 Dive into Police Chase Simulator VR! \ud83d\udea8\n\ud83d\udca8 Experience high-speed car chases, intense cop action, and thrilling crime pursuits in a realistic open-world driving simulator.\n\n\ud83d\ude93 Drive police cars, chase criminals, and enforce the law in immersive VR.\n\n\ud83c\udfae Perfect for fans of car driving games, cops and robbers, and action-packed simulations.\n\n\u2b07\ufe0f Download now and become the ultimate law enforcer! \ud83c\udf1f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xzsol.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XZ Solutions", "support_website_url": null, "website_url": "https://xzsol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "co
n.com/v/t64.5771-25/473391969_994395832594705_400789787348015080_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tja582cCyEUQ7kNvwGOswCo&_nc_oc=AdrEM0amOiY24QgcTOG5_5eTvFTFp5lMxCFunr01Su8VlFAMaB-6H5CGOtk742H10Jk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKULq8VLQZh4DV2p5DXgKjABaiccKKqo4QUDMUeZy8MLQ&oe=6AAEA45D"}, {"file_name": "ss1.png", "id": "1134782388126480", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393652_1134782391459813_3118064293112323237_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJcfo_1qGkAQ7kNvwEDWKPR&_nc_oc=AdpDlsuEGJsvZM3wRL_mKps6XXOBFisK57P8uvF6PXsWvMgtBYS79kLNiLNfQ0d_8Vo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxrCoSX582a38im166k5j_ed4AobDp2DOMz42I6SZoxQ&oe=6AAE89C1"}, {"file_name": "ss3.png", "id": "1285238732734324", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_1285238736067657_6026839217062817599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26Zy_KtMt0MQ7kNvwF2R0yc&_nc_oc=AdqhJYOQgNwkxfpIB9W9n5MEliTgdGXMaE8EFEzO5H-kHDTwfPllqE67yz047MKol5A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW5-3fs4ZPyqW_u2NhLwNLCXx7pvCWSriOcOXMFuA-Tw&oe=6AAE9ED0"}, {"file_name": "ss5.png", "id": "537992812657349", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392179_537992815990682_1527437521638999386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEvmnEfV1w4Q7kNvwEfrbR-&_nc_oc=Adpxmv2XvBiN4YeIC0RRgXfLXseoUpU5SbdeFioBqO_-uF_GdUMa19He7L3tXwMDZ1M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLgrVFDmEYH9V8iFz_2Xrym5aTvbVDkHfhz39OcC6ehw&oe=6AAEA4E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Police Chase Simulator VR", "keywords": ["Driving", "Police", "Simulator", "Racing", "Chase"], "long_description": "\ud83d\udea8 Welcome to Police Chase Simulator VR \ud83d\ude94\nStep into the shoes of a law enforcement officer and experience the thrill of high-speed car chases, intense cop action, and adrenaline-pumping crime pursuits in a fully immersive open-world driving simulator. Whether you're chasing down criminals, patrolling the streets, or enforcing the law, this is the ultimate VR experience for fans of car driving games and action-packed simulations.\n\nDrive Realistic Police Cars:\nTake control of a variety of police vehicles, from sleek cruisers to powerful SUVs, and navigate through a dynamic urban environment. Feel the rush of high-speed pursuits as you chase down suspects and bring them to justice.\n\nExplore an Open-World City:\nImmerse yourself in a sprawling open-world city filled with bustling streets, hidden shortcuts, and challenging terrain. Every corner offers a new challenge, whether it's a daring escape or a tense standoff.\n\n\ud83c\udfae Thrilling Missions and Challenges:\nTake on a variety of missions, from car chases and crime busts to emergency responses. Use your skills to outsmart criminals, avoid obstacles, and complete objectives in this action-packed VR simulator.\n\nRealistic car driving physics and controls.\n\nImmersive VR environments and stunning visuals.\n\nPerfect for fans of car driving simulators, police games, and open-world adventures.\n\n\u2b07\ufe0f Download Police Chase Simulator VR now. Whether you're a fan of car driving, police action, or thrilling simulations, this game delivers an unforgettable experience.", "short_description": "\ud83d\ude97 Dive into Police Chase Simulator VR! \ud83d\udea8\n\ud83d\udca8 Experience high-speed car chases, intense cop action, and thrilling crime pursuits in a realistic open-world driving simulator.\n\n\ud83d\ude93 Drive police cars, chase criminals, and enforce the law in immersive VR.\n\n\ud83c\udfae Perfect for fans of car driving games, cops and robbers, and action-packed simulations.\n\n\u2b07\ufe0f Download now and become the ultimate law enforcer! \ud83c\udf1f"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com
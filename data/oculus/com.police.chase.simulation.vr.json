Q7kNvwHRx1Iv&_nc_oc=Adp-K-ScvA7ObKl1QVbiZj7OdzvQXi15j4hVz5-E4_X7q76wVug1L0ScVo_JqZni2ZQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90Kr4XTc5iJkTNT0qMsa8I79PKWvWCpw0fg0rlokjbLQ&oe=6A36ABDD"}, {"file_name": "ss1.png", "id": "1134782388126480", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393652_1134782391459813_3118064293112323237_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGWH4mEhffYQ7kNvwE54rzt&_nc_oc=Adr0j1LICzoPS5w05HxA11h4txijS8pDKxqWBLANtAKu0jedy13dsrSb_4O7QXJ3HGU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zN8-yrvCND6fxiUZPoSsbizPdiakA8Po1G69ONEktmg&oe=6A369141"}, {"file_name": "ss3.png", "id": "1285238732734324", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_1285238736067657_6026839217062817599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1q5gDrQcdYQ7kNvwECSils&_nc_oc=AdqLwIyKaPJwc0BzLnHLYGbL5EWb5CiiCdP3JC9BKQMPeH9s13MDgzDGUyI21bcOzls&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8orc1kxB_Qaeh3lXwfF6tj9vGBCSqtRA8Pz8L6Ge_GTg&oe=6A36A650"}, {"file_name": "ss5.png", "id": "537992812657349", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392179_537992815990682_1527437521638999386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4ft-iqXIRMQ7kNvwFT7Ype&_nc_oc=AdpDBBx7johNKQtK2kuV7rhL0box4iHiNAgUhCWtWEtykFm2NbStjrpDHcD77WxZJlw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8fLD8UAEQs_eKTFUJEpUMczeELvd0abhlxPz0V6SasQ&oe=6A36AC60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Police Chase Simulator VR", "keywords": ["Driving", "Police", "Simulator", "Racing", "Chase"], "long_description": "\ud83d\udea8 Welcome to Police Chase Simulator VR \ud83d\ude94\nStep into the shoes of a law enforcement officer and experience the thrill of high-speed car chases, intense cop action, and adrenaline-pumping crime pursuits in a fully immersive open-world driving simulator. Whether you're chasing down criminals, patrolling the streets, or enforcing the law, this is the ultimate VR experience for fans of car driving games and action-packed simulations.\n\nDrive Realistic Police Cars:\nTake control of a variety of police vehicles, from sleek cruisers to powerful SUVs, and navigate through a dynamic urban environment. Feel the rush of high-speed pursuits as you chase down suspects and bring them to justice.\n\nExplore an Open-World City:\nImmerse yourself in a sprawling open-world city filled with bustling streets, hidden shortcuts, and challenging terrain. Every corner offers a new challenge, whether it's a daring escape or a tense standoff.\n\n\ud83c\udfae Thrilling Missions and Challenges:\nTake on a variety of missions, from car chases and crime busts to emergency responses. Use your skills to outsmart criminals, avoid obstacles, and complete objectives in this action-packed VR simulator.\n\nRealistic car driving physics and controls.\n\nImmersive VR environments and stunning visuals.\n\nPerfect for fans of car driving simulators, police games, and open-world adventures.\n\n\u2b07\ufe0f Download Police Chase Simulator VR now. Whether you're a fan of car driving, police action, or thrilling simulations, this game delivers an unforgettable experience.", "short_description": "\ud83d\ude97 Dive into Police Chase Simulator VR! \ud83d\udea8\n\ud83d\udca8 Experience high-speed car chases, intense cop action, and thrilling crime pursuits in a realistic open-world driving simulator.\n\n\ud83d\ude93 Drive police cars, chase criminals, and enforce the law in immersive VR.\n\n\ud83c\udfae Perfect for fans of car driving games, cops and robbers, and action-packed simulations.\n\n\u2b07\ufe0f Download now and become the ultimate law enforcer! \ud83c\udf1f"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url"
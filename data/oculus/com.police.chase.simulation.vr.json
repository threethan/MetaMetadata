om&_nc_ss=7f20f&oh=00_AQFHktZTf9JbbFnExr3Q-h5DTuHFdX0dOcvv9wT517wBSw&oe=6A70788B"}, {"file_name": "ss2.png", "id": "994395829261372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_994395832594705_400789787348015080_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nkza1nlm8IQ7kNvwGY2b2z&_nc_oc=AdrMlU3CFSoaCCpa0kmR8x9ZfmAuixyeYUmWMvMGL4YECzFxyVIb0cQSo0IvdOUBxRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgeeMF_OJ7bXNu2uKL-Gf4SHcJd-_X_9H6WJ8dw24tIw&oe=6A70759D"}, {"file_name": "ss1.png", "id": "1134782388126480", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393652_1134782391459813_3118064293112323237_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb8Z0d7eOZIQ7kNvwFy-dls&_nc_oc=AdprQaRGhAvMGIZhR-OWNUPOuutsBtRSkfYpAaMTXKm6Rk47HJWPxX0u43T0V3lj-ZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHHpJDiCJYUUOl8IxnxphZfLQZVQSRmDriCyoVcyc9Gg&oe=6A709341"}, {"file_name": "ss3.png", "id": "1285238732734324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_1285238736067657_6026839217062817599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHLW5I6BTZoQ7kNvwEW13cw&_nc_oc=AdqLApg4I6iWoMbqsOVeGn561j6yEXjCYrtC7UFMXcQmbUnHqNGpZEIfN3wbvx6Kdqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP6xpKTq1fe_6FNijvgfXw9EujE0wbPXIe7GAaw9jecg&oe=6A70A850"}, {"file_name": "ss5.png", "id": "537992812657349", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392179_537992815990682_1527437521638999386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFvEazYvI8IQ7kNvwFDaBjo&_nc_oc=AdrPZ2aqgm8TzwTeZFNRBwVXaePdDpL13b6_xNM_gEDbgC-aNwj5N1WmwSGZaUl_MRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvxYxjJgEx2xds85elB7WH8dWce6ugOWq2cQey5_f9qA&oe=6A707620"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Police Chase Simulator VR", "keywords": ["Driving", "Police", "Simulator", "Racing", "Chase"], "long_description": "\ud83d\udea8 Welcome to Police Chase Simulator VR \ud83d\ude94\nStep into the shoes of a law enforcement officer and experience the thrill of high-speed car chases, intense cop action, and adrenaline-pumping crime pursuits in a fully immersive open-world driving simulator. Whether you're chasing down criminals, patrolling the streets, or enforcing the law, this is the ultimate VR experience for fans of car driving games and action-packed simulations.\n\nDrive Realistic Police Cars:\nTake control of a variety of police vehicles, from sleek cruisers to powerful SUVs, and navigate through a dynamic urban environment. Feel the rush of high-speed pursuits as you chase down suspects and bring them to justice.\n\nExplore an Open-World City:\nImmerse yourself in a sprawling open-world city filled with bustling streets, hidden shortcuts, and challenging terrain. Every corner offers a new challenge, whether it's a daring escape or a tense standoff.\n\n\ud83c\udfae Thrilling Missions and Challenges:\nTake on a variety of missions, from car chases and crime busts to emergency responses. Use your skills to outsmart criminals, avoid obstacles, and complete objectives in this action-packed VR simulator.\n\nRealistic car driving physics and controls.\n\nImmersive VR environments and stunning visuals.\n\nPerfect for fans of car driving simulators, police games, and open-world adventures.\n\n\u2b07\ufe0f Download Police Chase Simulator VR now. Whether you're a fan of car driving, police action, or thrilling simulations, this game delivers an unforgettable experience.", "short_description": "\ud83d\ude97 Dive into Police Chase Simulator VR! \ud83d\udea8\n\ud83d\udca8 Experience high-speed car chases, intense cop action, and thrilling crime pursuits in a realistic open-world driving simulator.\n\n\ud83d\ude93 Drive police cars, chase criminals, and enforce the law in immersive VR.\n\n\ud83c\udfae Perfect for fans of car driving games, cops and robbers, and action-packed simulations.\n\n\u2b07\ufe0f Download now and become the ultimate law enforcer! \ud83c\udf1f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xzsol.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XZ Solutions", "support_website_url": null, "website_url": "https://xzsol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9174891465926250"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "610331491955464"}]}, "baseline_offer": {"id": "610331491955464"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739346840, "status": "PUBLISHED", "id": "610331491955464"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9169228806492516", "version": "1.0.0"}, "id": "657213743543231", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9166017213480342", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9169228806492516"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "657213743543231"}]}, "change_log": null, "c
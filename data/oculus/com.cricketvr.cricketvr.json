t (51).png", "id": "1249450077179488", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499625099_1249450080512821_1203491608632971138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxrS5bTHQ3cQ7kNvwGboA6S&_nc_oc=Adom-CPj3ejlNlYaXh8Yu4wpaDlzZWfcIL1uxntsBE-9sSmV4NdUaBTootMhI8OVBVU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBvG61JGKzN0rWTSGVRMrA_brVsxGpaiaLeuukhuVcRw&oe=6AF9BC5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_for_VR_cricket_game_202605172310 (3).png", "id": "1003358875810891", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622214_1003358882477557_8504866176904849048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9oj7YiwXawQ7kNvwGzBB7t&_nc_oc=Adpffi4UxtUeLHxbvr9y6riePwPS5Nnsf4UjdkFGvt6bdoRLp3NuClSVvbGTSLplri4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMvkv6tWJFmyPWBfT1xheGcH40kgdWmQqs0mKgZEx7gw&oe=6AF9DEAF"}, "display_name": "CRICKET VR", "keywords": ["cricket", "vrcricket", "cricketsimulator", "vrsports", "cricketvr"], "long_description": "Experience Cricket Like Never Before \u2013 In Virtual Reality!\n\nStep onto the pitch, hear the crowd roar, and enjoy an immersive VR cricket experience built for true fans. Whether you're setting a huge total or chasing a challenging target, every shot feels authentic with realistic batting physics and immersive controller haptics.\n\n\ud83c\udfcf Features\n\nRealistic VR batting with precise physics and satisfying haptic feedback.\nDynamic AI bowlers featuring right- and left-arm pace, yorkers, bouncers, swing, and spin deliveries.\nIntelligent fielders with realistic catches, including dramatic caught-and-bowled dismissals.\nBat First Mode: Build a winning score and watch the AI chase your target.\nChase Mode: Hunt down dynamic targets while managing the required run rate.\nCustom Matches: Choose from 5 to 50 overs and adjust difficulty from Beginner to International.\nLive scoreboard displaying runs, wickets, overs, CRR, RRR, boundaries, and batting milestones.\nSpectacular victory celebrations with fireworks, stadium light shows, and team-themed posters.\n\nMaster your timing, read every delivery, and take on the world's fastest bowlers in an authentic VR cricket experience.\n\nDownload now, wear your VR headset, and swing for SIX!", "short_description": "Step into the crease and experience the ultimate VR Cricket simulator! Face dynamic bowlers, smash boundaries with realistic physics and immersive haptics, and lead your team to victory in thrilling match modes. Grab your bat and clear the boundary!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1oNSto_ciG8pbOCRYIzh1UAD1Pmkutm24dEgqdlMk1DU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Paranoma 3D", "support_website_url": null, "website_url": "https://www.facebook.com/paranoma3D", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1357529966521781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825415_1327168906198779_4693598249304961919_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt3MujvnLkcQ7kNvwGP2nTC&_nc_oc=AdooELs74dzhF-ZnU5LV-MrVIyxrGb2kffPmwjPSShUiALClsIpfQvr-URaEbK8qnjE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_
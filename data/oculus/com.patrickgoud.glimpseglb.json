3884734019285481541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLONETAiiBcQ7kNvwFZ0w2t&_nc_oc=AdrNnybOYr011-HzpYC8n_V64qukGyrJm6zFcPIgwVinECKIJ8349tSykUjs8ZwDvwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqbEJNF5vyKe_8OGxIxWkXBdFOv0t-WSXtImnKGDTCeg&oe=6AEDEBB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "931466562541782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820019_931466565875115_4210627984440119330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok_AgN5CjoQQ7kNvwEwGYBO&_nc_oc=AdrgNntwoFxO0Fo8z-8hbEC9YopeXrusocfKNOju7S-9tuVV6J_wKQy-N4LBNGqDIyQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfCWKFlFhb3JW32grB37PLVDreVIkyebna2zuxKOwy_A&oe=6AEDFB66"}, "display_name": "Glimpse GLB", "keywords": ["GLB", "glTF", "Viewer", "Portfolio"], "long_description": "Bring Your 3D Models to Life in VR\nDo you want to view your 3D creations on your Meta Quest headset without the headache? Seek no further\u2014Glimpse 3D is here to help.\n\nBefore this app, getting a 3D model onto the Quest to simply \"look at it\" was surprisingly difficult. Glimpse solves this by focusing on a streamlined, local-first workflow.\n\nThe Gold Standard: GLB\nGlimpse is optimized for GLB. We highly recommend using the .glb format for the best experience. Unlike older formats, GLB is a modern, single-file solution that embeds all your textures, PBR materials, and animations. This means no missing textures and no messy folder structures\u2014it just works.\n\nVersatile Format Support\nWhile GLB is our preferred format, we offer extended support for other industry standards to fit your existing workflow:\n\nFBX: Support for complex rigged animations.\n\nOBJ: Legacy support for static geometry.\n\nSTL: Perfect for quick 3D print previews in VR.\n\nKey Features:\nFull Material Support: Experience your models with PBR (Physically Based Rendering), including Albedo, Metalness, Roughness, and Lightmaps.\n\nAnimation & Morphing: Play back skeletal animations and Morph Targets (Blend Shapes) to see your characters come to life.\n\nLocal Loading: No internet streaming required. Load high-fidelity models instantly from your device storage for a lag-free experience.\n\nImmersive Viewing: Seamlessly switch between a dedicated Virtual Reality environment and Mixed Reality (Passthrough).\n\nHow to use Glim", "short_description": "The easiest way to preview 3D models in VR. Optimized for GLB with new support for FBX, OBJ, and STL. View local files with full PBR materials and animations directly from your Downloads folder."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glimpse-glb.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Patrick Goud", "support_website_url": "https://glimpse-glb.com/support.html", "website_url": "https://glimpse-glb.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26887644660855122"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307326_921898743862642_4796261295035683199_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFcXMPAXLsMQ7kNvwFJ4b04&_nc_oc=AdomY-heWxb7ZeJIGgDTMZ7CyGFec7uFYIwkB93roWIxi8w-T7ab-p_ycX0PFJ358L0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.co
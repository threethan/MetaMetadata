.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liG6xqQc64wQ7kNvwHQ_iSc&_nc_oc=Adp9nNXnP7TukrmvhWZ2XMMLnLOt8Y7OxTzenzr8XM4_31HGaWnSYiomqdcgax-vlxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72Jv8_r0L0GHuYgBj0bW51TYBNg9BOI7AOQi8z1pe-aA&oe=6A05D8BA"}, {"file_name": "GR(5).png", "id": "717867624044548", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308103_717867627377881_8862398991761673943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLiIC9-SnjgQ7kNvwGnP5vE&_nc_oc=Adro9urNsIrka5TkwONJfPh2PLQs_qgkh929petDstYqf4WW2iQQvRgVHqCMahmKQF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r-p_CY1_h7lvIrpf-cN106hHIwDGbKuo6LGwbkss5Bw&oe=6A05D266"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Galactic Repair", "keywords": [], "long_description": "*Galactic Repair requires bHaptics TactGloves, a TactSuit Vest, and a TactVisor for full haptic feedback.\n\nExperience the immersive haptic interaction of bHaptics as you embark on a mission to repair a damaged spaceship in the vastness of space.\nYou were peacefully traveling through the galaxy with your cat when, suddenly, a swarm of asteroids crashes into your ship, causing serious damage.\n \nNow, it\u2019s up to you to fix the broken spaceship with your own hands.\n \nPull out adapters, plug them in, rotate power knobs, and insert energy spheres into power ports \u2014 all through intuitive hand interactions that bring your ship\u2019s systems back to life.\nbHaptics gear enhances every task with immersive tactile feedback.\nFeel cables stretch, dials resist, and electricity jolt through your hands \u2014 each sensation delivered with precision.\nA wide range of haptic effects makes every interaction feel real \u2014 as if you're truly handling physical equipment in space.\nWill you be able to repair the ship and survive?\nWe\u2019re rooting for you. Good luck, astronaut!", "short_description": "Experience the immersive haptic interaction of bHaptics as you embark on a journey to repair a broken spaceship during your space adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/bhaptics/tact-android/wiki/bHaptics-Player-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "bHaptics Inc", "support_website_url": null, "website_url": "https://bhaptics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8571518612956939"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1463250348296089"}, {"status": "PUBLISHED", "id": "3624100724389865"}]}, "baseline_offer": {"id": "1463250348296089"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760080440, "status": "PUBLISHED", "id": "1463250348296089"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25563120733370128", "version": "1.3.7"}, "id": "1112908736558698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8571518606290273", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25563120733370128"}, "release_status": "RELEASED"}, "
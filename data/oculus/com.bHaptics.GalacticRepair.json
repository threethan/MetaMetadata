99949_1410626216849632_5670792071558230285_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ6hwhpEmR4Q7kNvwF5cT4u&_nc_oc=AdkdKOsPTJHXizVP5Dpu1Rd5sd7jXK-pT-nkHz4FkFSgHi2ixe_4X9VKHTkDoC7oKFo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzaiQtG4yXzcNM70oawiuT_dieAQfgULXeV5-Fpp3Qdnw&oe=69B40B80"}]}, "id": "1255096482400296", "locale": "en_US", "screenshots": [{"file_name": "GR(1).png", "id": "1296215399171070", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499311539_1296215402504403_5454878326670920171_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-mqX08UjK4Q7kNvwEqaRra&_nc_oc=AdnSiG3JtkTS4m9KtKrNVP0tXshny7M5CFeGAlGjS4SA00_sj4YpQG0Jwa-wUsMdCTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrcZQ0T7veWgZwh-BJsgOhy84_CqlQsxxBjrd-M8hJww&oe=69B40BDE"}, {"file_name": "GR(2).png", "id": "1229570008832579", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304305_1229570012165912_1688629058966770031_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8VGq70co5sQ7kNvwGBWBUc&_nc_oc=AdlnoAmn8mxyvsPPbZ8CIu4QbEVVUercrxbXLQxn2tdg40zQwjrWs8Ad5V49l3fgOWc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsgjGsqTShDxE0Wya_3fF7Sqv6xmSCUplfD6QQk1srCw&oe=69B40AF3"}, {"file_name": "GR(3).png", "id": "1220249792813153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304147_1220249796146486_4559065946284192182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqC3kmYKhrAQ7kNvwFJiLzb&_nc_oc=Admc2bUYamj3inX5p6g8fq1L1sQoUChgHdI-wKHnVPyekod42mr6bIEQvtmuK0_8D9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxgl_P0YTJMWiF4h2aLIY3uvBR6pOoB8224EcHDrCyzeQ&oe=69B3FE4B"}, {"file_name": "GR(4).png", "id": "1424373735237045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_1424373738570378_3510974857611974017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4bMdfPcpLkQ7kNvwGYFxPA&_nc_oc=Adl-Y6js5GhJ1zN6eSvpOtE86sdWkUoSlaNbJrZ5k3EhZ0qEG8uxPjI5DOBlc3KlX0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxuj_fJalPs1MyGqvXjIxC7C3DJYjXGGNUD7XWQg5RZUA&oe=69B41BBA"}, {"file_name": "GR(5).png", "id": "717867624044548", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308103_717867627377881_8862398991761673943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgv2RxHUyFAQ7kNvwG95bal&_nc_oc=AdmZXw84nD4upUAdJzx6589we9JlfSC9eC-PaZ8sAJz6Ne_mgpFDNGyTh4X9e9ThG54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkjD3DI07_zbWnChNsnb2f5BYqnfbDO-jUisiH_tXe0Q&oe=69B41566"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Galactic Repair", "keywords": [], "long_description": "*Galactic Repair requires bHaptics TactGloves, a TactSuit Vest, and a TactVisor for full haptic feedback.\n\nExperience the immersive haptic interaction of bHaptics as you embark on a mission to repair a damaged spaceship in the vastness of space.\nYou were peacefully traveling through the galaxy with your cat when, suddenly, a swarm of asteroids crashes into your ship, causing serious damage.\n \nNow, it\u2019s up to you to fix the broken spaceship with your own hands.\n \nPull out adapters, plug them in, rotate power knobs, and insert energy spheres into power ports \u2014 all through intuitive hand interactions that bring your ship\u2019s systems back to life.\nbHaptics gear enhances every task with immersive tactile feedback.\nFeel cables stretch, dials resist, and electricity jolt through your hands \u2014 each sensation delivered with precision.\nA wide range of haptic effects makes every interaction feel real \u2014 as if you're truly handling physical equipment in space.\nWill you be able to repair the ship and survive?\nWe\u2019re rooting for you. Good luck, astronaut!", "short_description": "Experience the immersive haptic interaction of bHaptics as you embark on a journey to repair a broken spaceship during your space adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/bhaptics/tact-android/wiki/bHaptics-Player-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "bHaptics Inc", "support_website_url": null, "website_url": "https://bhaptics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8571518612956939"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1463250348296089"}, {"status": "PUBLISHED", "id": "3624100724389865"}]}, "baseline_offer": {"id": "1463250348296089"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760080440, "status": "PUBLISHED", "id": "1463250348296089"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25563120733370128", "version": "1.3.7"}, "id": "1112908736558698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8571518606290273", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25563120733370128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1112908736558698"}]}, "change_log": null, "created_date": 1770694274, "id": "25563120733370128", "version": 
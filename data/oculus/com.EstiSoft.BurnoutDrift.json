, "Simulator", "Drift", "Comfort", "Action"], "long_description": "Step into the driver's seat and ignite your passion for speed in Car Drift, a next-level VR drifting experience built for Meta Quest. Feel the adrenaline as you slide through tight urban corners, sweeping mountain curves, and dynamic tracks designed to test your skills and style. Choose from a range of high-performance cars, each with unique handling, and fine-tune your drifting techniques with intuitive VR controls.\n\nWith realistic physics, responsive handling, and immersive environments, Car Drift delivers a visceral driving sensation. Drift to earn points, unlock new cars and locations, and rise through the global leaderboard. Whether you're a seasoned racer or a newcomer to the drift scene, this game brings intense action, smooth performance, and a sleek visual design right to your headset.\n\nSharpen your reflexes, leave your tire marks behind, and prove you have what it takes to dominate the drift zone!", "short_description": "Get ready to experience the ultimate drifting thrill in Car Drift! Master precision, speed, and control as you drift through city streets and winding roads in stunning VR. Choose your ride, conquer tracks, and unlock new challenges. Realistic physics and immersive visuals make every slide feel real. Can you become the drift king?\n\n"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": 
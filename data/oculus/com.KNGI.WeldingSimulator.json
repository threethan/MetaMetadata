lO1lXrU-1o2ZVdUnDbIkIKIz37Kst5aTGqya5tYOst7Lvjied_NhSzTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFoBNS36I2UkNkp7ad_aCAXDj3xHNRU5pUdJIe11YZ7g&oe=6ACD13E0"}, {"file_name": "Screenshot 05.png", "id": "1106138675713433", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620341_1106138679046766_894236486024830682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O38pgVFHpa8Q7kNvwHVah2E&_nc_oc=Adon_zz-Z5qNcY1kFKLTSvyNhlJqMT8Nefe5B0vFQ4uspW_8QTwAc9D4ysLr020ra5c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNEn2OVGj6Rkx5GzlztEKvEB68-yCI0jJA_ahbAm2R-w&oe=6ACCE6C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KN Welding Simulator", "keywords": ["WeldingTraining"], "long_description": "KN Welding Simulator is an immersive virtual reality training platform designed to provide a practical and interactive environment for MIG welding practice.\n\nThe simulator allows trainees to perform welding exercises in a controlled virtual environment without requiring physical welding equipment during the simulation.\n\nKey features include:\n\n\u2022 Interactive MIG welding simulation\n\u2022 Virtual welding environment\n\u2022 Welding angle evaluation\n\u2022 Travel speed evaluation\n\u2022 Arc distance evaluation\n\u2022 Welding quality scoring\n\u2022 Weld area and checkpoint validation\n\u2022 Overheating detection\n\u2022 Incorrect welding area detection\n\u2022 Hole detection\n\u2022 Training completion tracking\n\u2022 Training session history\n\u2022 Performance scores and results\n\nThe simulator evaluates important welding parameters during training and provides performance feedback based on the configured training criteria.\n\nKN Welding Simulator is designed for welding training, skill development, demonstrations, and educational use. It provides a repeatable virtual environment where trainees can practice techniques and review their performance.\n\nThe application is intended to complement practical welding education and does not replace supervised hands-on welding training, safety instruction, or professional welding certification.\n\nDeveloped by KN Global Innovations Pvt Ltd.", "short_description": "KN Welding Simulator is an immersive VR training platform that lets users practice MIG welding techniques, complete guided welding exercises, and evaluate their performance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://knglobalinnovations.com/welding-api/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "KN Global Innovations Pvt. Ltd.", "support_website_url": null, "website_url": "https://knglobalinnovations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1312083695328875"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831393_2539282103215623_96823403981170472_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFyBVLAMPHEQ7kNvwHw4bm6&_nc_oc=AdooKfm_a0vpXnfq_sgtlmvnb-zHtfz_hqJxmMwzsa24conv5iVGmx9Q6C00so9VV-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvRbSEt2woZvNXt9JylspIoBbNNCpPs4DWF_L19TC2jw&oe=6ACCE435"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "KN Welding Simulator", "platform": "ANDROID_6DOF", "context_category": {"
i": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620341_1838810360870045_8441565420470794011_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pEa8AGxvqAQ7kNvwFxcx9Y&_nc_oc=Adrt5180840CPLaSsjqMuHuY76BjZBEBbHJlWmZEWG5SOmK0nYGtki_nsLM7CM1f35U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj1xJ7LOC4Pq58sOE076xzMXavDcEnwkDbBdQnsiq2tA&oe=6B05A610"}, {"file_name": "screenshot-5.png", "id": "2099445260701886", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623565_2099445264035219_2053369467995900210_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s959SL9l1Y4Q7kNvwGAmxfD&_nc_oc=AdoJ5qIci52CWOL8UQ66i5UFib-pkfUOMPpqF0I96pp_6fzyIVLtF38XSmK84Veo8KA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbaKBrDw-DIYA7R07km4CmDHGAOsPTEJVf5TC7Na0jBg&oe=6B05A128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1689555472874291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620414_1689555476207624_3337515299824651823_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlmaLuSyioAQ7kNvwEewumT&_nc_oc=AdpS5X5aeikSrLtqn3Vq2UliIVZ3628aIiDytg-Ldx-SOHDrCqUhVtFSltzxagEYe1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZW1XzBxOzQiK-VzyDTdUsDd8ip5bd5NDmHzQBA3g0nQ&oe=6B05B447"}, "display_name": "Cello", "keywords": ["cello", "instrument", "music", "mozart", "classical"], "long_description": "Pick a song from the music stand and play along. Each note shows up on the fingerboard as you go, so you can play Canon in D whether you've played for years or never picked up a bow. 49 pieces to choose from, including Bach and Vivaldi.\n\nOr skip the song. Draw the bow across the strings and pick out any tune by ear.\n\nNever played? Pitch assist keeps every note in tune. Already play? Turn it off and find each note yourself, like the real thing.\n\nPlay whatever you like, show your friends, and don't wake the neighbors.", "short_description": "A mixed reality cello. Pick a song and the music stand shows every note on the strings \u2014 or just play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/cello/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3146959882317166"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1473096284751292"}]}, "baseline_offer": {"id": "1473096284751292"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793987520, "status": "PUBLISHED", "id": "1473096284751292"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3163879760625178", "version": "1.7.1"}, "id": "2681596698938629", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3146959872317167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3163879760625178"}, "release_status": "RELEASE
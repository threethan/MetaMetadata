_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiElD2pRs6kQ7kNvwGEErdM&_nc_oc=AdoPvBub6uMvagAkB9zx7vYZ2qCeGjvsEYr1Yve2VZJvGgqQH3qAcXDY4l0l32RbnvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsgqfyqEHlRlD2AhNSTjxqt-tuaNGnNbPjwlwQt8ksKQ&oe=6B0DC750"}, {"file_name": "screenshot-5.png", "id": "2099445260701886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623565_2099445264035219_2053369467995900210_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9mnPP4y5ogQ7kNvwHdcvzQ&_nc_oc=AdpQxRlOxlBdVhhFg99DjI8MxDPLdgVSfMKB2JsQK_HZCBoiZm8Ny1NjNrO7b4A9m1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyErWOaQdXsrJFU_HysGDLeWMKxtPSeK_CCnL3ganwdA&oe=6B0DC268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1689555472874291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620414_1689555476207624_3337515299824651823_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oisecHxUYRoQ7kNvwHqNmET&_nc_oc=AdrOt05XylUbme2aJ4uQBM_2Qdu6hYZC5aiq0GfQqlmShYKovmr0mvPL7Ij_GKEZ9As&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6Xw9TOrPbjWGhESk5sDIJmm5dgBZEw9cOdSsBENh3Dw&oe=6B0D9D47"}, "display_name": "Cello", "keywords": ["cello", "instrument", "music", "mozart", "classical"], "long_description": "A cello, in mixed reality.\n\nDraw the bow across the strings and pick out any tune by ear.\n\nNever played before? Turn pitch assist on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 49 pieces, like the Prelude from Bach's first cello suite, marking every note on the strings as you go. Ten of them are Christmas carols, from Jingle Bells to O Holy Night.", "short_description": "A mixed reality cello for Meta Quest. Draw the bow across the strings and pick out any tune by ear. Never played before? Turn pitch assist on and keep every note in tune. The music stand shows you how to play 49 pieces, like the Prelude from Bach's first cello suite, marking every note as you go. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/cello/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3178274732519014"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622202_1622389236301695_3114059351283330511_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJPMS9RJbYAQ7kNvwH56d2P&_nc_oc=Adr91WytYEX36ZgTdxxIPkblHwXcoEvVuEnI7t4lP0pnUpzm9uNTCqkNAPs1Y87q9fc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPAizbK-jo_H6vpWbGQKLoanWslncjGPQRh0JehfQwlQ&oe=6B0DAD57"}, "is_concept": false, "is_test": false, "is_t
ZcURvSnBPHJ0MsSfeV-5dlV09rYfQ&oe=6B006010"}, {"file_name": "screenshot-5.png", "id": "2099445260701886", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623565_2099445264035219_2053369467995900210_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cVpmxN0aIsQ7kNvwEVBYkd&_nc_oc=Adrm6HcPBYiuhf5L3MianwWdH6jW5dBv83j8cE2TyVO4iInGRaPSPi72-EmMH-_2NDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPPW2yJKF_XCMA_RU4AfM2UDjXa3m_ODGPQJzh0c6rRw&oe=6B005B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1689555472874291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620414_1689555476207624_3337515299824651823_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7UElUD5zb8Q7kNvwHCJv14&_nc_oc=AdpSBYeFAuLAXSMH-umnBbdFoMwjEhO8MzBvQKcun2jS7k7kXSmYA8FSivAipDjgENY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReHfuzgYmxlurCHBMwutUr3W0GhlpGdDI8smGZoyhchg&oe=6B006E47"}, "display_name": "Cello", "keywords": ["cello", "instrument", "music", "mozart", "classical"], "long_description": "A cello, in mixed reality.\n\nDraw the bow across the strings and pick out any tune by ear.\n\nNever played before? Turn pitch assist on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello.\n\nThe music stand shows you how to play 49 pieces, like the Prelude from Bach's first cello suite, marking every note on the strings as you go.", "short_description": "A mixed reality cello for Meta Quest. Draw the bow across the strings and pick out any tune by ear. Never played before? Turn pitch assist on and keep every note in tune. The music stand shows you how to play 49 pieces, like the Prelude from Bach's first cello suite, marking every note on the strings as you go. Play with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/cello/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3153104791702675"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622202_1622389236301695_3114059351283330511_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-MCnZ1Cop4Q7kNvwFdmF_O&_nc_oc=AdpYyYw-d5Um2c8u4kKMYLhTpkpxyIQPpqM9uq2OWlYuplI1mXctgrD08bOLEdILOJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm8-Tr6SbtLi-y0YYEJ9xPYDVoEE8_-GUjPxD6WBQr_A&oe=6B007E57"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cello", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1793987520, "lastRevision": {"nodes": [{"id": "3146959902317164", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": 
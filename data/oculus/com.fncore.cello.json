: "trailer-cover-2560x1440.png", "id": "1689555472874291", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620414_1689555476207624_3337515299824651823_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou5RW8HPB3IQ7kNvwGlOncy&_nc_oc=AdpatuYD0OTAx-zM4zJk8ZNpGeZ-ED2eEbw6UTKyzyHixsikdo9am3wio7HqceQ78vQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX09qpMs7obf2MuOKy6kYZ6gILdARxUBrQbzKsQ2wWtg&oe=6AF9D6C7"}, "display_name": "Cello", "keywords": ["cello", "instrument", "music", "mozart", "classical"], "long_description": "Pick a song from the music stand and play along. Each note shows up on the fingerboard as you go, so you can play Canon in D whether you've played for years or never picked up a bow. 49 pieces to choose from, including Bach and Vivaldi.\n\nOr skip the song. Draw the bow across the strings and pick out any tune by ear.\n\nNever played? Pitch assist keeps every note in tune. Already play? Turn it off and find each note yourself, like the real thing.\n\nPlay whatever you like, show your friends, and don't wake the neighbors.", "short_description": "A mixed reality cello. Pick a song and the music stand shows every note on the strings \u2014 or just play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/cello/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
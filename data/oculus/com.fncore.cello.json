IlkG-PlMjRLZRYtDFoqawxNqZSdzg&oe=6AFDBD10"}, {"file_name": "screenshot-5.png", "id": "2099445260701886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623565_2099445264035219_2053369467995900210_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cVpmxN0aIsQ7kNvwEOiA8M&_nc_oc=AdrCOCh-4OGqCyTG-ROayOp13zd-0aP_dQHUequWPZXfx4g1Gqqu8oo3MR4NMbdHGdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTV2uJJgzwCMgoCXhfb0GUlzf_9n82SPjqvWPluDIlFw&oe=6AFDB828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1689555472874291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620414_1689555476207624_3337515299824651823_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIMv2yokxVUQ7kNvwEYp59S&_nc_oc=AdpPHTFGVQoxhBOhiDNqmhEKQL9Ut1cgCC-n34_jbvRXwU2H2F6A8_zpnpSYjFuTmSY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-FC6uPTll-W1DY4pDTULhmiU0xBNUiU9p9zA-wPY-cQ&oe=6AFDCB47"}, "display_name": "Cello", "keywords": ["cello", "instrument", "music", "mozart", "classical"], "long_description": "A cello, in mixed reality.\n\nDraw the bow across the strings and pick out any tune by ear.\n\nNever played before? Turn pitch assist on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello.\n\nThe music stand shows you how to play 49 pieces, like the Prelude from Bach's first cello suite, marking every note on the strings as you go.", "short_description": "A mixed reality cello for Meta Quest. Draw the bow across the strings and pick out any tune by ear. Never played before? Turn pitch assist on and keep every note in tune. The music stand shows you how to play 49 pieces, like the Prelude from Bach's first cello suite, marking every note on the strings as you go. Play with friends online, whichever Fncore instrument they have: Violinest, Trombo
ach challenge.\n\nPlay all 10 levels from start to finish to maximize your score to get on the leaderboard.\n\nPlay specific levels to practice your skills!\n", "short_description": "Lightning-fast reflexes are needed to collect samples from each planet and upload them to the hovering UFO."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abbynormalproductions.net/privacy-policy-close-encounters", "developer_terms_of_service_url": "https://www.abbynormalproductions.net/terms-of-service", "publisher_name": "Abby Normal Productions, LLC", "support_website_url": null, "website_url": "https://www.abbynormalproductions.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7575351709177309"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "611288825412086"}, {"status": "PUBLISHED", "id": "1231277211243316"}, {"status": "PUBLISHED", "id": "1015474943397064"}, {"status": "PUBLISHED", "id": "784330943465047"}, {"status": "PUBLISHED", "id": "444716008267627"}]}, "baseline_offer": {"id": "1231277211243316"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "611288825412086"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7703267789719033", "version": "1.0.7"}, "id": "1372879856635536", "channel_name
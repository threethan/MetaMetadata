-atl3-3.oculuscdn.com/v/t64.5771-25/39031465_432290769410558_4197845911567483928_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_o1LhUzhvYQ7kNvwFuiASv&_nc_oc=Adqf4UY9TJ3hmgVBiA6UEf9eAYDNK5n_LfhexJQUuxXWsPxWU8iz3Sz7Rs6ji5Js3X4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3J5NjrKykurKwGsZG0X9cuz_2IK_dnTChliCw3Dq3PvA&oe=69F1F934"}, {"file_name": "Eldoria 2560x1440.png", "id": "781496387307207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86683380_781496390640540_6096652695932272831_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx6MjwC3dowQ7kNvwEgNWx-&_nc_oc=AdrbSS2L-OHt3d9ilFYumS8c-2SE5qgNsrMuyzDV2k8GmG8keUvSoFr1kZTEy1HXZSI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ryLcU3RDt4v8NT9lZy-oDeL30UqYfZ8_ekwvBFH3n8A&oe=69F20587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Level - Tilted 2560x1440.png", "id": "465194612743524", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974771_465194616076857_3678342108930056417_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zVxPuyB-1UQ7kNvwEPNlFo&_nc_oc=AdpeNTSrKlxWEqvvHbAZJ_Q-xmDMVvJWJ0MztYMq8500_7rWksyG55q63m25ENJ1caU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Axy7CWSV7pa9TFHlK3YEywi2Kq_duuRQzGW1wkGOSPw&oe=69F1F5EC"}, "display_name": "Close Encounters", "keywords": [], "long_description": "Use your controller thumb sticks to deflect one or more balls to targets for collection.\n\nEach planet presents a challenging array of targets that must be collected to the waiting UFO above.\n\nPower-ups become available to assist in the collection process:\n- Extra Ball = Additional ball added to total balls available\n- Multi-Ball = Additional ball launched at location of power up\n- Power Ball = Blows through targets.  Lasts for 30 seconds.\n- Extra Time = Adds 60 to level timer\n\nBall speed increases and paddle size decreases as you progress through each challenge.\n\nPlay all 10 levels from start to finish to maximize your score to get on the leaderboard.\n\nPlay specific levels to practice your skills!\n", "short_description": "Lightning-fast reflexes are needed to collect samples from each planet and upload them to the hovering UFO."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abbynormalproductions.net/privacy-policy-close-encounters", "developer_terms_of_service_url": "https://www.abbynormalproductions.net/terms-of-service", "publisher_name": "Abby Normal Productions, LLC", "support_website_url": null, "website_url": "https://www.abbynormalproductions.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7575351709177309"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7703267789719033", "version": "1.0.7"}, "id": "1372879856635536", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7575351699177310", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7703267789719033"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel
c_oc=Adpv3PUytU6IuV2P-BksvzOZ-oLAR0ZPD1gxjnr-8q-u2ksDmyh1lbAh9QKG6YEDJM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-qi0noCC9lNgoYEhRLJhoo5761aAeQA6zYnT4Mg0KVg&oe=6B0314AC"}, "display_name": "Close Encounters", "keywords": ["Breakout", "UFO", "Paddle", "Ball", "Space"], "long_description": "VRelity Review: \"25 Best games in VR for Meta Quest 3 and Quest 2 that you have to play.\"\n\nUse your controller thumb sticks to deflect one or more balls to targets for collection.\n\nEach planet presents a challenging array of targets that must be collected to the waiting UFO above.\n\nPower-ups become available to assist in the collection process:\n- Extra Ball = Additional ball added to total balls available\n- Multi-Ball = Additional ball launched at location of power up\n- Power Ball = Blows through targets.  Lasts for 30 seconds.\n- Extra Time = Adds 60 to level timer\n\nBall speed increases and paddle size decreases as you progress through each challenge.\n\nPlay all 10 levels from start to finish to maximize your score to get on the leaderboard.\n\nPlay specific levels to practice your skills!\n", "short_description": "Lightning-fast reflexes are required to collect samples from each world and upload them to the hovering UFO.\n\nVRelity Review: \"25 Best games in VR for Meta Quest 3 and Quest 2 that you have to play.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abbynormalproductions.net/privacy-policy-close-encounters", "developer_terms_of_service_url": "https://www.abbynormalproductions.net/terms-of-service", "publisher_name": "Abby Normal Productions, LLC", "support_website_url": null, "website_url": "https://www.abbynormalproductions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_ap
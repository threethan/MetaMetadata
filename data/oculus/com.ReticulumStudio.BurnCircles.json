252", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974578_1029700171998918_5971325442797188454_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avsuWIi6uUEQ7kNvwHohQPD&_nc_oc=AdrDulyxuO5EHntN8sYNaSfjT17GUzuBR2hDJEawl9EvFfPQwuvNkGKiWgRJ5Yd56As&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTN1qINwrFdd4TMVFMfWFscEcfr9SBCYB6z1yy1HnArQ&oe=6AFB3CDF"}, "display_name": "Burn Circles", "keywords": ["puzzle", "blocks", "block", "360", "cube"], "long_description": "Burn Circles is a new vision of the old school Tetris game. \nBurn Circles is a puzzle game with a new creative idea.\nBurn Circles is interactive and immersive game. Be inside VR.\nBurn Circles is a good choice for those who love puzzles.\n\nUse Bomb & Line boosters! \nBurn as many blocks as you want!\nEnjoy colorful explosion effects! \nUnlock all 5 levels to gain more points!\nTry Burn Circles now! ", "short_description": "Burn Circles is a new vision of the old school Tetris game. \nBurn Circles is a puzzle game with a new creative idea.\nBurn Circles is interactive and immersive game. Be inside VR.\nBurn Circles is a good choice for those who love puzzles.\n\nUse Bomb & Line boosters! \nBurn as many blocks as you want!\nEnjoy colorful explosion effects! \nUnlock all 5 levels to gain more points!\nTry Burn Circles now! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reticulum.studio/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Reticulum Studio", "support_website_url": "https://reticulum.studio/Contacts", "website_url": "https://reticulum.studio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQU
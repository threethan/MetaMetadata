cdn.com&_nc_ss=7f20f&oh=00_AQJA0ZycblsaC45l0qSgrzXX_PciPcDMlk9jcruHFIAHHw&oe=6AA9479F"}, "display_name": "Burn Circles", "keywords": ["puzzle", "blocks", "block", "360", "cube"], "long_description": "Burn Circles is a new vision of the old school Tetris game. \nBurn Circles is a puzzle game with a new creative idea.\nBurn Circles is interactive and immersive game. Be inside VR.\nBurn Circles is a good choice for those who love puzzles.\n\nUse Bomb & Line boosters! \nBurn as many blocks as you want!\nEnjoy colorful explosion effects! \nUnlock all 5 levels to gain more points!\nTry Burn Circles now! ", "short_description": "Burn Circles is a new vision of the old school Tetris game. \nBurn Circles is a puzzle game with a new creative idea.\nBurn Circles is interactive and immersive game. Be inside VR.\nBurn Circles is a good choice for those who love puzzles.\n\nUse Bomb & Line boosters! \nBurn as many blocks as you want!\nEnjoy colorful explosion effects! \nUnlock all 5 levels to gain more points!\nTry Burn Circles now! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reticulum.studio/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Reticulum Studio", "support_website_url": "https://reticulum.studio/Contacts", "website_url": "https://reticulum.studio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction
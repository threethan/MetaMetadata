01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuvtqV7DYf0Q7kNvwFY-jEj&_nc_oc=Adra2LR3gfSFVwm3T681P5sP8i1Sk1-riQ_ExXzgcQsXhg3M_3oiXiy48sCLKVMjpYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y57wCMvcVlOrgIxkuuvDG6Y1SCIUXB8tRxCgUuBgRhQ&oe=6A29628A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umf3OxR2wrsQ7kNvwEx_1tc&_nc_oc=AdqT9MekoU_2IJDCovjvvidBfjOT4Sl7IV-VR3gyFlondsCCL1_swSXjJBPIv7DUBKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KC6TiHDJvf_izsyUQs6sd_ZRZxWSSNe7OVxE0RnTD8w&oe=6A297B29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxnWM-FN5TwQ7kNvwEFMUjS&_nc_oc=AdqJWMdtnN_0svVaxlM_OT0ETMdo7kCD2x503GglsejdfS3Gx0l5o4QneyEwE51dJyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hTe3taCpHZzLQJbwaQ9jWVToruH7JlZYkNTQnBzHNAg&oe=6A29810F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lADKTuXpJx8Q7kNvwGdf_gE&_nc_oc=AdphfM0pwvOrSHnoLeWAsm54QtndpmsyrbNXQgX-wBNRILt2hUYXrjevrrkAIaiP-y8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UR51qzb2fs-0ohj8vSHz0k527vEFpg8UhRpH_ZD7N8g&oe=6A297BCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN68GUYhQeoQ7kNvwFy84b9&_nc_oc=AdoCZszuRfIjIRIY4dQxaEK_PwPjhZHuVVxeUO380v_B8IH7EJRwnTbf4Xv12p-vC88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rEpQ4pkJkHSPO5WHTjRGzsmSC_5OiS-cgjf8h0NV5rA&oe=6A297755"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2BDe20FWakQ7kNvwEUezB6&_nc_oc=AdpvVDGwHU2ukxnlOabdf9W291WUyNEaZ1uYkGuzfWRlOXtMr4zYAKRiBex1bqk8Nu8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbGDtqtlyGx9uv7X3894b8G8nQGsY8JegwWQp_6hmAPQ&oe=6A90378A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbeQaZgT2HoQ7kNvwHhej8u&_nc_oc=AdqMRWuBrxhTDJDgZ-z-aE6ADlO1bnOej2bpuhpc_WesI1eAcA6m9adQj7uSTvzOXas&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxMPjJze9Vb1j1f9MAIog5AhupgpMaWfy-LnBA4jwzug&oe=6A9017E9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1p_ZEVx3_kQ7kNvwEIE3wY&_nc_oc=AdrI6PyFLTjrNl7updJ72y3WxrvwHFet1D_QkmM4qGnZ0EhLbGy0RJIdipTqbW0REyc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExX_9-EzVYSh6tCWzYWUfJBCBXqkaZU26yRMzL6fr3dA&oe=6A901DCF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpCbhtC2aEYQ7kNvwF1TbFw&_nc_oc=Adr6zxP6QHkVmf6sLk1McUGlGaw5qYM69sCrbJFHAeBorbZ99zTNpIWxAb6l8VIU5x0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7cEsRlXJCLpTI1KVnTUcVVSnsb23nIcKOCYCdlTK9sw&oe=6A90188B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXgbhow_WIEQ7kNvwGrmm5q&_nc_oc=AdraZ7cCp1dOb6dc1pzC4jcH_l_Nc3GBiQbTTc8HtaVN56_4WpcUybxJfwXyWFsXA1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP43qBMQwYXgFAfF5ju9h1YAAuSdjcIKmq0G4DDQlPkw&oe=6A901415"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
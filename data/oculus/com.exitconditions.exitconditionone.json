01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt1JKs_ndRQQ7kNvwG_rBtP&_nc_oc=AdqMjgd9XLeQQQDZ5CmKlP68WMegbTY2NB3ZmyUJ2iKdpUKpSwsjyWX4qnRTgv24IpE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YaUWQoIspam-YXiTssYL2qP4OUtMReadb1mg8HQNYTA&oe=69DF8E8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRhiecvdwGsQ7kNvwHv03Fz&_nc_oc=AdrOUCmLOOKyrKGkHJ3KdVP8wUH3AyOjWVpypnLc5BxQmM8IiMrYUjN1Ltp9EXR5hI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZLsxxJzIIBbE4L6aXtZCb_FZLEL3KDvtKvlC1ffqmew&oe=69DF6EE9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b3KYSRIiM4Q7kNvwHT5M_R&_nc_oc=Adq-wXVR9wpIkREigNFmyQmauOMGxaaX5VcAHgmYrXxRJWFZQsKuzCAfo9t1Bfup4e4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uE2t7FDaoAx3OAvWvBY3BCQLGWsgqjC-4pNQ5FLOHTg&oe=69DF74CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH8SzywF-M8Q7kNvwFbEpUP&_nc_oc=AdrZbUuoMmFarhbGWjaabPxW1-IFWBUFCfg2azAX14KoQsxp-eYKgROF5bwYBn15gkw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ct_wB0PLu-HhzQZd2f3wJnvRqOFIBu37M9HldeDxZow&oe=69DF6F8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOZsDZULtz0Q7kNvwHzMZMS&_nc_oc=AdrXjDA35fqTsODWeJAGMItLLBPxC5J2zZEWrgRaUuCYfHFNkdmQepWcdggkgau_0CY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-CnmsW-Fe9X5LAoSHFi2xbBgWVfEGF-N7cCFhPuVJRw&oe=69DFA355"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
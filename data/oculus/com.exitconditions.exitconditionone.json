01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrF1gpAq0KQQ7kNvwGykPlH&_nc_oc=AdrM5u8xcnnEAnc_PyezgASfqqp-YFfEtQPYd1_GK5HfzOPH1tM_InBW5Ei56xRAhDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F47l-M-CB99H8fGLTgoxzX_GbQZ6LvD65S3iLvDTYdw&oe=6A426F0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjSS8jW1kzgQ7kNvwEpLgNM&_nc_oc=AdrewrMStJ-rjeL5YT0-2yK1OiufnvmU1e5TZHE0ae9uxK3AJKmw1BRkwBdVUmdIpl4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xjSPKZL1nuM9Sjzvb8JQWA4vp6rS083zWQPCFjwqbaw&oe=6A4287A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08u3RbsOrIkQ7kNvwEY0nAe&_nc_oc=AdrPvnuTypPMKD68cavkwUfCyr7k4kXyNpstfzygk_ICOFQtQRRu-gBUP32Qxj5gabM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sxd3AwtowbUFII56itIpgj0ciuLBnmZjq8tw5poZyJQ&oe=6A428D8F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6k8oJGR_LYQ7kNvwE0x3UT&_nc_oc=Adpy6G0LF0C9dCEm0Jr7yMw0QoJWJmWLjSrVC3sxDBcts2yP4UIzDtoR_yllDSGrAhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wFcoTkySARNPqow1Qovxuyw2Es-C3gdBSLEIu4-xe-Q&oe=6A42884B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVSLDu8i1ycQ7kNvwEXC0cH&_nc_oc=Adp93E0CB2PKA7Ti6RaWUmATSkd2gNX1hulN3ypVqEiVqQ7X_vDa4ajhju258oIUnsM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yciDmM2OC99BFub40DhXkupVAU_2DinYge6Utjbn3zQ&oe=6A4283D5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
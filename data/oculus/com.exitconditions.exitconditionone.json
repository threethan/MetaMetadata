01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U74sI5AvSoQ7kNvwFTlFVt&_nc_oc=AdquHiMAWtsumWZ8W8wh0Z52zASxKymW7UTFYdsDMNxohhxXvUCWsNHGwbmNTS4h8TA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM6pIHziEEiFLTq6m8qT9xdff5FUHkLiySMk-n-toMCw&oe=69C28D8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGUGNtGGSwEQ7kNvwFBzrgO&_nc_oc=AdrqyuGbyiQYjNplYkd2g8mFsfpPo26-RsTmoU2G3L7At4h2q10OgOafzbe6I3teXv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRxvKhQxQiajYLNwUh4TI-eSC_kWXeIa4Eg8SZHpxCtg&oe=69C26DE9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUIY3y4zzO4Q7kNvwHQlG8B&_nc_oc=AdqQA0NXxBEaCn_BZiAfD_n01kntqLkvNwRSBVKNpc3LRnX9OYSTZuSbHh7vgBg82g0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgKYyMqybg-8zwMrp2UjofZvrQgcC7g6-SuFWmCsE_RQ&oe=69C273CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpZtfJr0HksQ7kNvwHmTyT-&_nc_oc=Adr4olY-fFhfw3gnsLeMNhNCtStoaP1ZHuR2vo-eS5_wSM3KhfyWh4-a8BsXxsR0i_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAeYRiJXmEKLZhdHsyuhR_xCtdnTbPeqPuEQf-ZuKzUg&oe=69C26E8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h6Sd5-DtCIQ7kNvwEGtes_&_nc_oc=Adq8PcRpLrKP4pOBCb3JxPPI7Bwg-o4JmcQh1HTl-7bFr8uVHkS8msaqLLTPK4NSZwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw17FFiJ90na6tGSf0flVXvfN6oXuFmgyzaqwNc0w1Uxw&oe=69C26A15"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2BDe20FWakQ7kNvwHCWBx9&_nc_oc=AdpTz8zZGu6M5zj4-B0l-4GxwjimEm_if0Ssb09rbhcRKEOErtIBaZBKlYsXppZtW8E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPDQKL45B-raeCbxVN6yxc3ijLE8tJH8jztZU9U_zY3g&oe=6A91890A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZGO6EjEPXoQ7kNvwF0BKEn&_nc_oc=Adov592q0Xipe2JuBrS38IL1LbcD3pmJW6vsKRgxlR1hHWjIfY5YqOtXfLisTOqYY2o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyaH8AvZfn06k-1Ig_sgflB99xfLNfedfg0rkStKMHzQ&oe=6A916969"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1p_ZEVx3_kQ7kNvwG14RCH&_nc_oc=Ado7kdYQhoMTjuKqz9njF5Vk8QH4xuowTuCYczRREoefjS2oqsQHgcUuzN-6PdyD9so&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLq7hQGx6DZYHVIvqRW0SpMttvCYE0MzkGMpbrqdvcTg&oe=6A916F4F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpCbhtC2aEYQ7kNvwEanQle&_nc_oc=AdpJI98rdkLoAWgJ4WLLKccIg638qI3fa5Xlv11JFKBkj_SyKun--lwjFEOTKRcE-a8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdOMjlJRbNGqy-__V2baxfIbWcgYFSfY-rIlOx4GvMKQ&oe=6A916A0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHoXAPeJvRMQ7kNvwH6PPtr&_nc_oc=Adqi4SJwAn7FHkQy7dZssqPvHuVH9Tti3_e0juCgEcyI8PHhK7lKZOXmGOiM2pLwJsc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG70hJGITpEcZklmXhLMU_PLqQ1ja59qHbvtJ-1at61pQ&oe=6A916595"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
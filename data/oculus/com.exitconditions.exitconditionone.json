01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26LPwAa8jHYQ7kNvwFPwlVg&_nc_oc=Adp1QTjHt3CFi14uXVccNcP7GRCj-u6qyniRKAFXHF81X90dfcwuX7t2sEc3s-RsrIE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74w1DG1h18o-x6bHk8jHagAy7XOq8ibJOmvJUxR7MXRw&oe=69F9EC8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxK9GGqy06UQ7kNvwEnJBig&_nc_oc=AdqY_RqpPrMAw1wwAAKGNg5G69bGU0Fy0BsfS2CnuCIMOTKz7drdGw-S0zFLftG-18I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77aEQKowqCXM7CdISrJEQI3qHWkOUyfHLHH52xRPlu6Q&oe=69FA0529"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENESZRgBFXsQ7kNvwEzivyW&_nc_oc=AdoDZauiE-qqqmBa_EuBUckekQH-4FFtPl48H0aa9UF0E0SIGhdVZMimc5r9p67DMoI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71GYcigEWr9WJHXhbZHFLlTPYwgjgPHxk2jFDpOi3pqw&oe=69FA0B0F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxeuYrITjEUQ7kNvwET9OVM&_nc_oc=AdqWTc8lqaqid7IgfRjuKnKsGdkv6-9E1Rj2O2RfJXrPV8UkIFj_tDTJR_4I2LWmzi8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dmSNxr7rA5dMBiFBWlqyktkFECi-NZ9yDwoRyqFjBOw&oe=69FA05CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4Qpb_4QvRkQ7kNvwEbGaAd&_nc_oc=AdrUjdVO5drhBvlSF88zchYVLVUkswIbg-80bei1sWVkglN3p1_OrTPrnPAtyCGoRrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ty7qPnizmrEJVjzF7sUOnL7q_l91kk2qwvCbL9fWPiw&oe=69FA0155"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
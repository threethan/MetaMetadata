01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j53p0H9GgTcQ7kNvwGlWmyI&_nc_oc=Adrp9M9O3RGn2HVgdjWbX_ueXwarWJmzwgtqKONilYQzcUlUA1O-f4wBM05_KX_AkJk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MsxAMn6-BI6L0k002kYG6pLHhRjlTWuCFfsTRqFtkSg&oe=6A241C8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk_xW0725qAQ7kNvwEg7Ww-&_nc_oc=Adq1R0XD6Ydi4gFmUEmAWsPdb2IA0CIQfAX6xiNnUXLRDKlPD01JAzVqIS_RBk-tM5Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82T5_ThVQFg9kOD4Of8Ow-ixsVo5-NJCl4Cfu7v5lxTw&oe=6A243529"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9xONQOBmm0Q7kNvwEA8v4J&_nc_oc=Adro0aDBmd4x3vn3ef1bn17Tyqv5U82h4EBBWCTqDMCKUPuuRvAGgjDw4g_Ua4ID5e0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y3K8rlkt1uWY-4dqB2PGZVRgiWnq7GUSw_xPoSYiDdQ&oe=6A243B0F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLi6yapwotwQ7kNvwFppnOP&_nc_oc=AdrPgK9uitYVJLMjbU98568TLwuGjJLagn7Q4xDxBl2_ym1sNnbxRSLKgaSiOU2AzTc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jv7-h0IIszB994mf_V2bcq5liBLeszCtoMFeGVAKwSg&oe=6A2435CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3bkDFp9yrkQ7kNvwGB790z&_nc_oc=AdqRYsFAVfRitbL4l5YzeX4fFuCGN1lfbGC02T6qyXFARg9iguTM76GSs5W7wBnSBYs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e6M-YIcMGHT8QKugCdSKJ8QGKYgaV7KSrGQF8RjNnpg&oe=6A243155"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2-BEJ-dAbwQ7kNvwFaKMsh&_nc_oc=AdoNV_3pju16DaGhF6Xd27p_pgzk06xZPYvpADszDUh1jxfvOjpkX3jsgon8ZJBnj74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKod3hUyRgTFthTFihOQw0FRxG5UiQNe6hb4hmG9Uv3Sw&oe=6A9EB80A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63zVJbIR4AgQ7kNvwEmuZpr&_nc_oc=Adpt0rIU83lnsM0lJZmhDZzMElxmM-F8qKT4PTwt9qJzkeAlDrZLbt5Vw3eOgdAdECU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQK9cxD-pj_DgHg45zriqLg6hcKtNk2yt4LHw5P8w6Aw&oe=6A9ED0A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g59sgaGRIaMQ7kNvwH1V9-6&_nc_oc=AdqxinxA6P9et8TRUwopwegaNRVKif93PorgdLYBP2EQOrC49BBd5gR-IQ3mrPp3Bjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwSEyW0-Fz-vvmlSz6V8ZhZ7i70NA0bgWqL1uVHXqP8A&oe=6A9ED68F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkayiW385G8Q7kNvwH1N9TL&_nc_oc=AdqCEZ82S1HzR0PwJv-LCWgHJOlIbRV8YlaBzy4JlG5jUHD20oqQoOzDUnVfdoXqKoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWWUDDKJ2rz3GZwl1JiGvPI127AhhoXZpuUrpIrwLYIQ&oe=6A9ED14B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek295-wHZrIQ7kNvwF2ILmr&_nc_oc=AdqfAwyHbByMcGeezks3fZZx0UPqgZt6x-F7HcVVPP0JCK8zid6B4kxYliPI9tbUriY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcp0bLD_fICV4B6-Y2Bar907tRCihj_n-1Exj70CeFFA&oe=6A9ECCD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
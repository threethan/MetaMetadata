01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2-BEJ-dAbwQ7kNvwHQnHUm&_nc_oc=AdpFAm-TPJL-2Vbwg1KREJ29GQTses8bsmErbP3_1ZijOQY_YyKfaqepL563DMar_7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuZVPmz2HpxZlZQiv2SUBOAtrhrcgPs_4h77lPxOID5Q&oe=6A9D668A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63zVJbIR4AgQ7kNvwHh3c-1&_nc_oc=AdqRcvR8bU9bxPm-LROX7HS6ylRwVyhGCLivwNUo-pmnhTUonDCR6ett9xnnD6O5nPo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDE8as14sF9gudHTyf9XJuSd4ACYVgOC7jBwXt3Vawbg&oe=6A9D7F29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnwSVzV-dYAQ7kNvwG9AWRc&_nc_oc=AdrF7-cvl39NXq3zeZEbjTiltQ7fVxM53Y71att7zIBgpyVlQhyfMGjrH_28nL-Fq4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX6dH8UvIdhCXIeZnkQ0iS58zzR7XeV1t9V7Pxdheb_g&oe=6A9D850F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Oo5E3Ow6ZUQ7kNvwHVAaY6&_nc_oc=Adrm88vvejkng7u36zBnqbLrnNWDFP6CDdhmY1Y34cs7kBtEH3dWJ0SZlkCCpHPKqFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdbIPHHVEnTU4QnHYI0UY-eN4nyd4Bx8Ct_xvr85-d5w&oe=6A9D7FCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek295-wHZrIQ7kNvwFLqeyo&_nc_oc=AdowG3VUiWRZZUm-M8D8R6U8glEAVT-Avd_GdFw0d1uFYkBYcDEsm0yPPsIbVFrMDFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYrmO3vnDejTBqVuj5qoYnv-MwlZYxRUSZk5LwMVoWVw&oe=6A9D7B55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPv8FmlQnxoQ7kNvwENUDsw&_nc_oc=AdoHdMqyRUgtACIIOrv0QroEcIPjMOvH0MvQriv8qJnv4de8hlC8zyiYjvsHS66f0g0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6McMOVAi63UTCpCJjeQvLWYEEbtV9aBsHuvYeJF6GRw&oe=6A884E8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d65SV62sLEkQ7kNvwFY8lb7&_nc_oc=AdrEaS1iAd0aPhAz7z9ikC3fgFXdmcbi-sRffxp-E4XN1yfxeJUfadRufIf0RV12wAw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyWeEUxcRIIIe7Q4i4sbbPmF7CQIwmtxNBRUCR_mWd1A&oe=6A882EE9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJQsDnjm1GUQ7kNvwEEFsaj&_nc_oc=AdpdGxnBBmjArvDiG5ssfYd5_ZbkL-s294wOrhPXypnqfmIV16XoJuRI7epFdc2GNB0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECRRJ2csUqMx4EDmVn4My6k7UrN4H4PXDtuMrQoFzipw&oe=6A8834CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DljvBeAveHsQ7kNvwFp9PWq&_nc_oc=AdqIQ-2WpSvMQqp9sFe9z9ZO9MhgDSxNccznKJ2xo03YvYCrVoZaLxUFg3-7vb_S908&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiB6sql5FecXiX-60CBp72a_qqpd9C-DElNjkn8GU0Zw&oe=6A882F8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ2QKnFUgwgQ7kNvwHD_ZTl&_nc_oc=AdqcErQuJoDmGYEvF-puWQ93Dv2rL0Ac6m6f9wujyjLUILgg1aw3h9BKAUJNUe78mBQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5cwj2zQ-WqCimoLXjYFTxhVnEQnR8IlNJP7XRFfv20g&oe=6A882B15"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I59SbJCE0QcQ7kNvwGFkeB8&_nc_oc=AdqUjCtVsU2c8rNgq95vptZPlqXeBD5-1csSRVuXy4PNGDh4O0HvW8AGG5iA1qDSVd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR1rn2F8_Nk1rgRJIPvuPZpH9hPbc82vP3-zi3B5fsCw&oe=6A4CFB0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vBwdpJKpucQ7kNvwEWuvC_&_nc_oc=AdrDsF1CO1bo4o9OCsM-3LMoMEUkwop5Tni8JcNDxi1B7qvQH260vOgZ94M83AdFSW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsz55mztVSpPPZVHQbz_CKm3LtU89rA25H9BIuP3Pl9w&oe=6A4D13A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS9VC7smfQ8Q7kNvwHdmCPA&_nc_oc=AdrE8ax9yfmT7XGjgXMxhda86XRL1gnoEZpBgR-sqyLRvAF44O22QOpbCZ_bmRZKLPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg0rSdSnf0CluLIRIoocySwJPc5CGNigYodjyFz8hsqA&oe=6A4D198F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOBIx2AyZ5wQ7kNvwG-oXD_&_nc_oc=Adr94ilLq6b9dD_RJiF296LWqoq9DJCS3nWtfOo0LNjzdgnuQkH8Vu-o39kBnXG6MOQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc79WK-u5tH4M_HjQ9x_rPg6PmaKUzEU_BxrJ-LpRkZA&oe=6A4D144B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-qO-p_GhFcQ7kNvwFJqkMU&_nc_oc=AdohFBVqoTsErLnS2giJJM6hFCyE9OIPodV4txROYISMFRMR5vq-GsrPFOZ7PJEUuJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXRVtTiaAF6UcBNlKrF84YdNcZQGlSz_lgNkkoo0_76g&oe=6A4D0FD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3XUHSZ5v7QQ7kNvwHG8v-I&_nc_oc=AdoKs6HWGhPiAorDfwqylpBpSnxUL0ku_GMSJzj-nfwa7l4yyZD9OjIp0wc4mvjV_Qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lRGJ6yPArDg530OzzqLhedFm_ueoRbpYYePQQ4NDmHA&oe=69F89B0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxK9GGqy06UQ7kNvwGpLi90&_nc_oc=Ado3I_QqUW5PXI3FATX1R7MVqlfEaTWmqP901JWmLjWX84DHgZONGkJWJmfrlg5LCo0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31mClme_JI6iVAOhoaILo_BDd8WRQj69-BKZ2vY1qz9A&oe=69F8B3A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENESZRgBFXsQ7kNvwFmWkW8&_nc_oc=AdoEaZ8M50HytAILvOUpalRo9hyp4T6ocQFulQCBP1p2LYaslpBJEPnJQ62ViIC1V10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bTgF3x09RJQpIq8FXaLzRFJbPX-AHAloGKaDFXO9vcw&oe=69F8B98F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxeuYrITjEUQ7kNvwHgu1MN&_nc_oc=AdrwDMBkGgOPmre0EH_ebICC8S4TGjs-7TwBn9nXnHuyfUIDo2duMfqEATS5IchQGQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gUVGJjsflcxVdiLVjnGdhXa799IndVLHJJnA6zA_P_A&oe=69F8B44B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvV5Y8dwwEEQ7kNvwGp9tLR&_nc_oc=AdqwfHNvLtoR4jRGpbJ7LnNcEqkl9M4HN2vMtVzfc8lgZWP4F7PKLLX2oYxMU_ojC88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2d7qtWLZ-4MMO6B2jB8yN2JxIiG9BAt_x6iTV3RjWerg&oe=69F8AFD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
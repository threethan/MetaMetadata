01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tympp3n2VmQQ7kNvwHxKsty&_nc_oc=AdqnjwgHP5sqeRptLClkCtp0GNZPjui_2R35vTLQXQUn8EoIxry6-DbaqTH0Sv8psVM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i_CVJiZ6yPYSRbEsFNKUO-dt-qjd1XR9xmEVACtWtQQ&oe=6A1C338A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wGLhkq5xlAQ7kNvwEypw9a&_nc_oc=AdoT75eQJ-YH1WJiYSHbuRG7mkQeKLShFiJcVsechqfYCbgsUOsaEM46s8rX_4WGUX8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m6P3Gv_qOuvzaq0nMbrijzgG0CSRUAJwW4hEUzEBkuw&oe=6A1C4C29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pt18NYVfyY8Q7kNvwGigRp6&_nc_oc=AdrQ6s8xvgsaWkYdnbTjdff8WG-oCl22JQUaRRDabrEkH2ofd_UEz1zSH0-R0au1S-4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nM1LCw_3puFZg3v0NFXXxEYs93GvGP__R3iYXFsZDNg&oe=6A1C520F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F30x3CspDcQ7kNvwGEmZt0&_nc_oc=Adoo3wMDFf7YUNqtm6wePctt88SCin90U1YSscj6V7-rLA2a5GmdiwX2IouCNUdO1ho&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CTf9Mazq1ckiSuntGs082XI7uuuloVglH-IGTMA9Dpw&oe=6A1C4CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDIJrdtjZH4Q7kNvwEEOT19&_nc_oc=Adp3fNybMTg3ovvDeIRPxNUYGeLnhpnHDxlMF3QIa7yjePyEVnSjwb5TYTl5eSkJUyQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bdpmshx4kFXl2F8SzdBKDqncVhHik1B_IxegvzU3NJg&oe=6A1C4855"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
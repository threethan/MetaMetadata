869801012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j53p0H9GgTcQ7kNvwE7Mqk3&_nc_oc=Adp1Hq5AIZmstuxRixzIB_poAOu8kIORuwBCqGwWCvrdcA-vZ_4IdvFgM_4ZYSVO37g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2yGR0AtY1VoufHqaglRHZz1Gx511FSCG3XK5r62YAVg&oe=6A22CB0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk_xW0725qAQ7kNvwF4vMIr&_nc_oc=AdqxCcmE6D2Zge8CUx0rOpTM2iUb-s1zVX69vyjFJFhUAeIiN1ctwg9PZgoqF4LIemM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JmgqTDbvjILucn0bsGBeWE-8qm3XC7y2VLRwR28VwGw&oe=6A22E3A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V00EbgtVWkQ7kNvwHCukGZ&_nc_oc=AdruN1S1oP1S3OV8XIR2CCdKrHqsr_ZxJgjkmL00t8FQkdq4g_mRyDXhYYXBkqNglQw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9x7q3ZibJWpPntnEZM2RmWRyVDSngufOmS1FZdMdfzA&oe=6A22E98F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhQ4pIEAQFYQ7kNvwH6Z-Av&_nc_oc=AdrgtOREA9AOeTbYO4di-9gMjuYMHTrlBC4BXQi34i_a2bF4jhi345x8LNQuFU-uccI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91quqZSivAebRMM9f_C7OoveSPtzLHq4P4P_wLYLISeQ&oe=6A22E44B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3bkDFp9yrkQ7kNvwGjoINo&_nc_oc=AdoL_5Ei9D3ZVmk-y4EikBG7D-7v9yNMr-mdHODePDK1vVnUMrDJjX4PRGy9RUqnvIA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y_0zs_GRQv1ZgrHyJf5sd9eHOR46zsQXcs1R-dKIKCw&oe=6A22DFD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics
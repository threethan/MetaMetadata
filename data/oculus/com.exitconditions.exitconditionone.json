01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzDICuvGIzMQ7kNvwGz4Xou&_nc_oc=AdolDIsBXBBTLFn5k4ri7egdRMUSxhPeMLU1CUrR9LD_Jcp2gu-IKG5LSQ2nvfgD2MM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8nsbOHjDfYV7kJa13XYERERNPvgcgqlx6NqxB6S0_4Q&oe=6A2FFA0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaEDV9DRzLQQ7kNvwFN1A9k&_nc_oc=AdrWWMgMote6q-7KBu3DqVi_2HhXInN6vxeo5OyWj9hPcFxmFUP4Pvo6CpS17Iqf-4E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n1nYUEXBfAkzadXzcUIBLO5PH9Uqz_57aypxz6017Vw&oe=6A3012A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6kN14B6jD8Q7kNvwE2z53s&_nc_oc=AdraqJCTrofKjCrNHYHch50lGXH37S-vHOgW3lNlOadM23rF3nHnfiE0Lg4nr8WMnvI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3XU1NRksh4us8dNK_xJfEvNX3pFwIwmxf9lTs2Hakxw&oe=6A30188F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FGESJc7dT8Q7kNvwGt2KdB&_nc_oc=AdrUC6vlLFLtPY79pA-hLxs_4gOdFn8ixzXszLybc_xiZui2DZwJNHC5KzfMIwO1AdA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S1L7TQvo2c4gORlfcAeGyGUcTyIohlnt34FJJEso31w&oe=6A30134B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGvcDmGzUFYQ7kNvwGVsUSo&_nc_oc=AdoBu7IapRYgUX-QKTk5feW5o7x-1Ozpni5xfq2wbPmnjHeCTSGXAcV0v0b5YteUAfk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CfwMPz8HozR8Dd11eChCDdslHleHrQ0awVaiTlJljHw&oe=6A300ED5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
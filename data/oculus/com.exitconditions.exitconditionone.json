01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T7CrL57Gg0Q7kNvwG2DUZk&_nc_oc=AdrkXKvSsw5r361rRzSK4UocQdksOZriAzu4NXzL5kMpFNvKlGX1BR89Pf-hXgHrEso&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PYyvlWqe5hUYwZQibQIeCC62Kp2WhP1KaX7p4TRU93w&oe=69E7778A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjevQKMo0Y0Q7kNvwHd5r_I&_nc_oc=Adq2yF6w0QdkrHnH5kz1CUNNBRy6Nmzm9fXy-6dxmouJ2I0i_68cIa-AWqjgsQUNSwY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2o4Dcb95B32aKdYxWo17irR-3sSGT1uoWC2ax2qeEcGg&oe=69E79029"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rksaQUN7LUEQ7kNvwHgnZjJ&_nc_oc=AdoqpkugAI-i39GSbyjKxlh2AXMlGMtQHa9lHOU60TX8jsjFkfOnssWVperJJFdNDt4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1noQw8WW_JrtlKnYqMjHPTLtUs7iPJogDMrEYY0lzUtg&oe=69E75DCF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHbGesBDsWMQ7kNvwFlLbI9&_nc_oc=AdoRE4eOYDxJOkjffPFX0qY_8BcPTF2aH7DmDav8FFifRMUNyEoPz4mR5ozm6GIzm9U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rgjxP4YNBoZ-nntkxA33mSzcyIasvMJw35KXF0rhkAQ&oe=69E790CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFoOYWpxCJgQ7kNvwFeoZZX&_nc_oc=AdrXju7n2CMbhc_BkpZ7P9viQ3GzgayHOi9nIu89CCpWgbhter-6WCDYsfj0JncdRl8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jGSkjsr449UCYAvycE6LJwt3hDmg_cOsyqcDyYQ1gSA&oe=69E78C55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
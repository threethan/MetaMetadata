01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjnb-k43ZAAQ7kNvwE0_FqL&_nc_oc=AdqZIiaShmO19sAUhWDTFAZ-kdjWe6YJkRfNgETja5-8BrXXlmYnLf4wPkuzmyXcfHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3djoGc8VrRAdk1_fExo4RvVqHJ3Zbac8XlMOeTSIgwgA&oe=69DA488A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HR85qGS31UsQ7kNvwE6pkDV&_nc_oc=AdrqgbW_eGG58wG7wHFJXmlH4qB2OCZTSq0_z16-9m1f4Ds_aJ-Ic0qWjyCyaKmcWwE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J8DZsneqOfRd3IFLH_ffoDAZkcG40L2FFDLKx_zEzWg&oe=69DA6129"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zHZGhBusrgQ7kNvwHkRvYA&_nc_oc=Adric_zqhv63KEccxtxT8kt-leXCcWoWazdRMw5VeSZV0a53NCg4rX5J1VHtJr8fpQk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mBq-JuJ9KF40Jblr2CymbD7Q_ipIodR6Qm76F1nYrXQ&oe=69DA2ECF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IsYR-IXgaUQ7kNvwFUx8G2&_nc_oc=Adplygx3fSJBL2VJMP0mWxjcZKxgyL-sIBHWGUhQxxJzPzrndF_2VOQOLhhHsy1E7WY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PIWDghk7h0RcUlzlkSH9PO-DDQnte1DDKEvYAug2QbQ&oe=69DA298B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0N56gaxCWeQQ7kNvwHFioao&_nc_oc=Adob1segeppkR3EQWRTkFOV-cUEz6mAwx8CPbyqcQ7HMUYlQeBW6w4w1pPM7zCyZcuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M_Q408IFncjrUqV3fZU6N4t70tWiLjoAxiT9vUkRDGQ&oe=69DA5D55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
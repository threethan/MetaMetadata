_nc_sid=6e7a0a&_nc_ohc=O4_XF1UblP4Q7kNvwEMiRCJ&_nc_oc=Adml1r4b59BooUh7EovBwc0ydo6EhKD1JSC8z0AGfEYpiLclS4qW7zhlERsMKhpR58I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afty6gzkjQ4JmbZHQWBtGq3tRO6cGIAsyZlal_Vw4mOE_g&oe=69A82F8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTXocZFGymQQ7kNvwHn8Xex&_nc_oc=AdlOjputZAqDLHgiEPIkOVd_Nx828wd6qSVNN55xqcFvfdIUX0sg7P2_JuRYp8EMCy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvO24_-FWjPnfP4Ncprk3_xku5dnY8YY7f9TDU5A8_e9w&oe=69A80FE9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oudUaIbRgqsQ7kNvwHzNSRh&_nc_oc=AdlAI6e-8YQQ7AUyVAjgxyjzBNk-N03R2n7nEviV8cKaXbnN0uhw5tqKIiaQCwcvQkA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftkWBNx2TKzmsEpMX9ezHW13nzsh43uvtuS_L3HaeZPpA&oe=69A815CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDfsN-5ogboQ7kNvwFDCLFN&_nc_oc=AdkAWyBt2NQ23QFwGgSviCjeUcVuR6o2T_rV3lAsZqUyyx86naFrf2v2O3uYV8LRnrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftGaIHH3eIB3zw9nx5mRBQMSAusRMVPgVB6h596dgCn6A&oe=69A8108B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZe4mPTDDi4Q7kNvwHZ1A3S&_nc_oc=Adkvk7fE_7gN67wYWXrCe41Egswtqbuqf4sEh3JENxSV23OJ43aUKCmYYTLTUE8UZYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftkSYzCFJ6JYukZ9FyA_ru7LRsTiw3MNQcL9qDOgi4iCA&oe=69A80C15"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
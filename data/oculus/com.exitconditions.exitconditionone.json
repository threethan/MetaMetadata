01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc19-frr6yEQ7kNvwFCLFvl&_nc_oc=AdoiRpN_BJjQQW8Ay3UYehNqJoHFW7Q-raOkIQOq4wkKM5dDkwbtiEn8Cu3GOX2fRsw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tQnywPBVuk2CHs8C5PZa5Pail4Y_n7yoN1hTNSkVkBA&oe=69EF608A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMcp-y6lYGkQ7kNvwEC25BM&_nc_oc=AdpaWVKldO9uxHqZFoMaPbJKUPY8yeJOEsM4i6GulTs0jh2qFuw14bpl49TfvbREaiY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08p5ITKSwCB-kcsgsNi49INJTiyi34fZAOfH2t6HrYQw&oe=69EF7929"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8O1THK6kpwQ7kNvwEcOBqv&_nc_oc=AdoxxdZ87-vwEgq974JAXFN2HVW6K6PXo6Pfa-G3p8JxF7gBaVv1bugPol9yuwbPaFE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3a0ohKTPPopVzsiiHUTOe4BhDHeB-LpYqweb-lShD4uQ&oe=69EF7F0F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OfjzDQGg7AQ7kNvwHZjBAU&_nc_oc=Adrb4Gv5XVRFR1-ZIo_8j4AHKVmkuAYlhFw1yD6KQ7eQ1AH7CLKh1KRzXt5UsaRehgE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3v0KvPEmZpQOhApOelAsiB4HmVArgcKiV6f7pmsWxIkQ&oe=69EF79CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=450nqKmU_zEQ7kNvwGeq3wL&_nc_oc=AdqWnN5zknbuoTypfUDca7qjgG8yR2CNNHEQMxAMWaXJ3cnbaNYBLVkfE9XRP_67wAs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rvOKdXIxLl1HyO59KSi5EBAQzDKlVc6qAWX1DUXfn7Q&oe=69EF7555"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
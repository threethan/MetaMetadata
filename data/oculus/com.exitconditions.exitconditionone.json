01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93B20uloCscQ7kNvwFZwwtN&_nc_oc=AdoKGtaOeiad2ipfG_w3Pq_rAgMbHmI3kS6PyjJUhagsIooqbGRMDRSpC0YI0UzC-WM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoObtpku2yHOPVOFbdO3mQ0IGRev8_ncRyX7jN3_Nk5w&oe=6A56358A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HVQk6QC4bkQ7kNvwF7U6JP&_nc_oc=AdrQpYltuRNPkvZu6cEUlNos4ktrHrlJdCQ_7otGT1NOXPN3vetF2-xW-yOckZxN_F0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7FteGrAQGoCQU2pGcJTW9lYqcomfzzx9N_YNqCXzDag&oe=6A564E29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pgb9M_zPiwIQ7kNvwFeZcDG&_nc_oc=AdpC_cvmrKBI23MaDf7ch7OuweN7iHEO-IwxTka0y-Lj3lKte5A8H2jtSXduoLikwrQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAepPiktnVIl1xmTRAudG-SvEMPNrau18WH3f9LtdtSXw&oe=6A56540F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYeZ1eQCCyUQ7kNvwF-8Ek7&_nc_oc=AdoVhABrfKW0u9Cu__Hcgy3quXCqu2uUgMYTFW4GKupnXAa9wl9cMsLlpVEwUE-YlWs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEb8LsNKIGBMrRLtGqHYp0pMWe5XlXR4qDTZ3u4cVS9A&oe=6A564ECB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVf5TSCpTZgQ7kNvwH8GWTq&_nc_oc=Adoxna10ho5BMgCOpMTQdwv6VNz5abkmNkhI3rjO9YO8RZ8zfX-1MepidushcfqCPWk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG_t_Ou-ccDE1o0FjaXR8_ghJFmcxuGuK5_f91szKFPQ&oe=6A564A55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
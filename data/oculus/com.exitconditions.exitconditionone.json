01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93B20uloCscQ7kNvwFg8RfU&_nc_oc=Adq6nZDhr8bTY3P3oUrtulDTW0edpp2jKcTCkmJe95LNqjTxXBV_Gl9b0B1UDuKIiO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOmN20QyqKvN0lowWJzjPAUso3ldHhIvwHvHzyuLUMmg&oe=6A57870A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HVQk6QC4bkQ7kNvwG8XO-b&_nc_oc=AdrOh2NPfdmu84LMrl_fOmokmnrjgkeNtc3ABEh9rSHNq8HmkEbsADEC9_Dh7VuAbk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPJkylFip4bNpHzVIKIgMmwyy-3UpJfVzC-FcuV-DHog&oe=6A579FA9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgMesX14zo0Q7kNvwGL_aRE&_nc_oc=Adqzzo0rCblre4mDJJKqQuO1SYGde6NTesgF42pTiiwxHXdp0Hgjkvy4XEjlrlhmHFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcU5wO6l7Yh9Uvk4sJV1clJKraMONnmNhze5iWT61Dig&oe=6A576D4F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tDiJjGL5EUQ7kNvwGB2Ze1&_nc_oc=Adpw1GQynUbeeaeJyhXFKhmoxgPv1Q0WN9PZnFjK3V0aZPfzHTZufnfeiKvLFbP_C7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIsq51stW8WFfpm8NQmRAxQoKkBntCSiXbLOj3Z6n6pw&oe=6A57A04B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVf5TSCpTZgQ7kNvwGRjaIs&_nc_oc=Ado742etsUhxuso7b9vV2Kvvqf4BI8aMF78TcwdSOJw9PZgtVsNTyecan8DVQq3xwc4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkj9rmiOPellQFQVHdht96DQvxShVU1FJFLzeCKt3B1g&oe=6A579BD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoegwPcjfHIQ7kNvwHeuqtP&_nc_oc=AdqHP1pvC20RYjBZO0YsBrsuhvQR7ovQkVZrSnSVx7wLDGIrSkqXPOvz2feUmIrFD_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO7rbF8UUNroiQXrgNtDIzS80z3K0DRgZkl7WYXuRGDA&oe=6A5E1E8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwJvOxLdUnYQ7kNvwEuzw6d&_nc_oc=Adr5ukxnAl9ZR51DTJvknPFqZYNDWDS-8-Ah4kZz9piAyCtEWxtnKckewhC5mgZAa3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC50bEBXI8HJbWlf05wjie6LRXzRHpGj9Mrk_FiTZfF1Q&oe=6A5E3729"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUKjVlguElsQ7kNvwHrLxDS&_nc_oc=Adqn_X2OpRRxRqp2XgKASVkAwkGXhkxK8qk122mhNtNQ5RdNGG-HxgSWxHtxjN-_naw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ6vz7-SQWsa3he3B8HBo_ZSuD-dAx7MCYc4UagbDKdQ&oe=6A5E04CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OQBbHQfIQ8Q7kNvwHCNwmU&_nc_oc=AdoyLelS0uppVTS8O0i1gM03U3vsFzfclBKxd_0ppnKlCBV_Uhd9UGZy3B5sRDWLyS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWfzWfl94r30b64C05WA5XCobwCzvwVO6H-RG5Hrr5AA&oe=6A5E37CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es_C854ftBsQ7kNvwFNhdkI&_nc_oc=AdqQfo8Ll8BsHK8ZBu9-Aqj-q7FElKi2M5PiRCc4OYhYBCLxCh-z2OrHYKkof2jpAXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_IhEWf1-iiMhOQvVKOjwUGCadlCn91FIRO7pe60EYUg&oe=6A5E3355"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
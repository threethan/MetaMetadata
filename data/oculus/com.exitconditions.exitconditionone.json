01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs4YzKK_IJsQ7kNvwFSnxXP&_nc_oc=AdquCWXu9XkkEqU79PUkvPppAw04250sR25o5GtY2ZAoNR44vR-oTpN5cz38Em72j_0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwq9NQShDhsSaeBUQxH9bcmjAuRUz7QcMqWt6Qa9vEfng&oe=69C6820A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVBSOw6UFCIQ7kNvwFX0x_J&_nc_oc=AdqBuZTkSvwbxJP-rPWpx-NuUIoTSK1zwBSgJnoakgpJn9IRfs6JpwbTCal7_g5dzSU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvGvNNaHvmj4cphEYgup0u52t2U7kBKGEbyrgdcUaUQw&oe=69C66269"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MO0do2DECzEQ7kNvwFp-rjc&_nc_oc=AdrYavaks8M38Z5va9y47eNzLWEd-jsFpajL449qJHNIKiPcuegvceLL4Aj3Nq9Qc4g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWPIr-bY7TK4HkUI_YIA-gnPWypJeJDIJeDc5KnklUSA&oe=69C6684F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysSyYd3F60gQ7kNvwFrYeL4&_nc_oc=AdpC0tN2zCnsn1gdTM0FYCY7vcJypT9s86k8U31uqBRFR7Lc6ainAEa0pWHGm4gAdpk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxacv2AjY__DE6OdFPehyA1toAZQsIJOz8jHwX0la5eeg&oe=69C6630B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWu42Wi2g9IQ7kNvwGnVH6l&_nc_oc=Adoz7KvcFBFvA2-xOEpcWMYRgd0EHV68IWE_iCtZ2wOI980-WkKd93P12tWOvOOHg1Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwT7VsrUkNEl61JimGJc2YD_6aZ0w7El4qSieTl6ppbrg&oe=69C696D5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
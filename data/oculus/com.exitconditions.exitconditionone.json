"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovlDBSDcAtwQ7kNvwEsMlUJ&_nc_oc=AdrmYe4BpufP7NEg-f2Jqm-Ts4byEZy8fQqWjEAk3lBZmjSC3cDYoHOVOvWspg98ylc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkovNN2dU-WX0nmNIpyt6Bn0CTG2oikWpyTikwXHm59g&oe=6A7EF469"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbZBIKQFBRIQ7kNvwEdf_n1&_nc_oc=Adpp_18xq4yJIa39tQGrbdYSPjlsLP8R0mMwQ1t_KXER0WK8CvCUsyBKsmqcrIxRDuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8i_PAm1acbWhYQ7geItOv-KwFMyYGvWLMSylMKeRrRA&oe=6A7EFA4F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWqbE468p20Q7kNvwE2-myC&_nc_oc=AdqxrwVfczxVE00glqOG_H0BILJulb2dN0OHZbuDDxm-SOteLzdGFAl69MiaCtOgmcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFFSm9GqUuOf8Ra2KwE-yfCMe3R-YWn0_iNZVG4qfCBA&oe=6A7EF50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3_urNdisF0Q7kNvwG3Lty1&_nc_oc=Ado4V8QkaipkSUW0YecmcLAzeFmnD7SDuUWa9HbGzXhh0IplVxAvU6cM-gbBnClWYY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeoAXw_6fOEoYRDGwtihT19yPenB4mwfMX1NTjAb8zkw&oe=6A7EF095"}, "display_name": "Exit Condition One", "keywords": [], "long_description": "This is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. There's about an hour of playtime.\n\nCool Features\n- Roomscale walking, locomotion, teleporting, stationary, crouch, stand\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3391716047619440"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "546449526492636"}]}, "baseline_offer": {"id": "546449526492636"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1626983280, "status": "PUBLISHED", "id": "546449526492636
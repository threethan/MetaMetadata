01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12sBQA3mKcMQ7kNvwE7S4W0&_nc_oc=Adqn6IgKDohFQJJnETQPUfQ9OtbTlGgwR3dQD_2EchBY2SziF_gLN5ZT758EmgB6_MU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lEg2d3PrBOkZ-9PPawAlrKnrLaKReijEVwNRuUcivKQ&oe=6A03270A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RxBwJS2gQcQ7kNvwHcWK3S&_nc_oc=Adqj2Yiv3-DiD4TSn2fhhNlOjQLWWa2dkYxcfLMPc7rV-im12-HleZEfQxWvi_I8gig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eQyeHAtKFgLv44XxclVHEtiO6njnpYU4LM4eadEyoKQ&oe=6A033FA9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnczyAjR3jMQ7kNvwFlZAbC&_nc_oc=AdrW9H3V_M7_diYHZnP1lTtPNfjfpE-QxGWFKeln9Dca7V6c6VO0nht_EbaLNyKfTSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ly_1--4IbVO7-dTXFUSxfhtiXK5luQZVEYM3r1vSnyg&oe=6A03458F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzYQyPrUT2sQ7kNvwFVgC9j&_nc_oc=AdoFJKyDr2HF-U4jvmGAyBOUM4Gylt8F-EA8sBzuoK0cw__uKwrE8sB86Nu8bQ5UBxA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qh_duxiLfZjbAUpnhKp5PGaCAyOiQN7HOwZCVGdbgEA&oe=6A03404B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHZqR3N1AZ4Q7kNvwEAcSCz&_nc_oc=AdqlNCmFyU3fSdrirneQoALRYaeWc-l37jqoUrirkKbqyPYK5ntcZ-JibxQ364MsenU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I7E5HN-FZY6gQxzfoaPx9nI8Z-0W3WABO7gwaIQBDig&oe=6A033BD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
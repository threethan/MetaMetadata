01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hc_NUHzCUiMQ7kNvwHrXoIN&_nc_oc=AdqD5ZcRqO8CIDi2IJDe-B0OosUWzgcikJ5GqTi8W3OmOzUYrtV3pCkIXVBBHGO7ONk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIF3K_Xx1IWzntgAl5yGhtvJ74Wsrr1YSaaVxOnD2K3w&oe=6A64B60A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM5eVkdGEgMQ7kNvwF6lcfv&_nc_oc=AdrM30uGXtF3pLIs4C1VHrZ1zdlpXHtZi7tKg0fn_Y0RYJy95QAbI0OXjPZax8APnoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbcjHcSzW82eT23EMrDixbqrWEkrRhx0tDGqQKIu4-3w&oe=6A64CEA9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6kqQTR7PdUQ7kNvwFexYEQ&_nc_oc=Ado30BLQ92yHM-pKHTcdjH_esyFzmBJa6e64zXF_YoBmT8e9sH0M_1badW9iS-G1QYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq_gMCmUabil2d_NukY7MEa74P6DSciQqhXAgsaNzaxA&oe=6A649C4F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fuZdyysEd8Q7kNvwE4sOU5&_nc_oc=Adqk6Ru7Hvtxy0BTyE80eZa5Sa8kcLGM_GreDtcs02RcXA1C0EaABcHOaEFTYEncXC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWiqg_qlQKSEc1rMf_b5iP5phhM58xrWrNAJc0jgc47g&oe=6A64CF4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eblIeQckAtUQ7kNvwEUFliL&_nc_oc=AdqVbnV0AgLz8kk0SrFtX4F8M-RLvyK_Chf8bvB5ubR7gCCM3tKUpLXhAYX3N5w1gFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8jD9iFKDHQkBjInw9HRoKKGhZd7cPxJDcloQI6Sjitg&oe=6A64CAD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
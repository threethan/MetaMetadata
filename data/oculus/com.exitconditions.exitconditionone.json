01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6CW5brSeE4Q7kNvwEFf2hj&_nc_oc=Adq_tFv8vWH-ZW6HjjNRVxsfFqZwIH2Tm_Yl_a-IP-awQ_ZYxGclbObrrSizstUd61A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A4ti5sPX7gz8J-RLKbvzntX9rOAJgCDdyLA53LT6qyQ&oe=6A3BD78A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2ucE7po6GYQ7kNvwHfoISB&_nc_oc=Adpn_jnnoAQRfb5tiTM8oRcbiB8Z6r13UYPFDdnqjubMAi1ut71PtpzmZXxlN1oR0hA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wJDXJco8IQlX4OSbt7uPqMVnj7JCqv02xubyOqMh_gA&oe=6A3BF029"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8wIpUM8d04Q7kNvwHpNI58&_nc_oc=Ado35t4C5Req6ssVUd4xljsp2mh-IfEcAiQ89Ja_Yo9VO2xUdby2aDSckR9RS90NGxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qh7PV_ogkCNWy17Er0PM-ecBRFI0eyAviAU3H12OUIg&oe=6A3BF60F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCb2pkaplEoQ7kNvwGEswW8&_nc_oc=Adr8KlEyJF-3kASx14e0wLbwV_Djkt69hvQ0SLceVhAHJBrKMCEeCMCrkayE3Khx5Rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U_429iQ0ytBhdcPpDTS_KMTxgl2ejT4OBGOYHiP11Eg&oe=6A3BF0CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhw_4aHKS0EQ7kNvwHvcy6S&_nc_oc=AdqnsDQTYejX8_8sRKwscP6h0z-Tr1yqkud-U-WzkC0Lo_JjLRFXxhZOd0yHBrl7nKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q7LGoncNGMCVQrDmhydd25zEmCNRY6KY5WION_r8dmA&oe=6A3BEC55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
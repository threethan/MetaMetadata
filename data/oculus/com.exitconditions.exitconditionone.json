01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYaoNCcqSp4Q7kNvwF0H_pU&_nc_oc=Ado-hDJzzab_LhG-RAzaYWL2V_l5_DACE_PUHce9DfOaTorJZ1N3WtcozfHjja15pTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqVhNbR_QIlSa5dePn7PgxrSIStEaZTxYNjRsIc-7zuw&oe=6A49068A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTHDajRgb60Q7kNvwFdeOGY&_nc_oc=AdoPOftP8Jzx8LkK3scyPsMpkh0fL1-g65W7Ct9hcvDtOmeWjQymgA3BwMcoDYTDlng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbzWcu3TOVm7JaFve_U4uBhDF_Sd8EACktV6Ovk_dDmw&oe=6A491F29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVu2Hlu-h5EQ7kNvwEIIhdB&_nc_oc=AdqqmydohDeeEPsGFqEjfl_2N-ae_NtjNa47MQjFqTj1BzkuQpJ5BtsPVliQWJcRklk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKwV0Jd5Xn6YTkQ9bkm08zqiOthtHwK-6eP0QG8kPmKw&oe=6A49250F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOm7jblOoy0Q7kNvwEdyO2D&_nc_oc=Adp_1DOk_kUt8Yl1XD8E10Tinl9yMolb1TpV28Vs3zVj-stGPveNUHl9MqRu1T8ngBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOiBrQRwF07Tvqa9a_KGVKfJOyOqEp04r_Kel-LdGp7A&oe=6A491FCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCS2z86ErxAQ7kNvwHI6JX2&_nc_oc=AdovH31ePOsXXDOKFLFTS23kaG0b-GWc7sBfhBQucMNuY77ueasrTkJvgCpcwrhGiuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ56SvpzsRBCT_DTn6Mt6sNuvB5xF-keBpMDPHhYC3NQ&oe=6A491B55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
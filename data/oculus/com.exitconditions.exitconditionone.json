01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_ru0L67J58Q7kNvwFS6vzv&_nc_oc=AdqtJN2MZWZVla8IU7jrIyyDtrnP4zAx9Wkw1I-tF-MZRW6H7sdVw7s1k3nxNs3NG7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HJdb4-pYj4u80IRrWI9iRvtoX1irbaLmpOHe_W8BzoA&oe=6A1ED68A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZGG62OYINUQ7kNvwEAL7Lq&_nc_oc=AdoehaWPWluZ4VCPBZ7Hg_Ky8ndcCqiXAA9HNs8J_k9Qvt8yhzTlZuzqeT-YStaYqzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qns9XgQ1qgoxHkcOHHf8RhMHpgqdYzbrkHGRtFjeWnw&oe=6A1EEF29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pt18NYVfyY8Q7kNvwHQnosB&_nc_oc=Adot2Ud8IigpE2C0xpcRVZFyEXtlGpxFfOrPNrL13lF2hjygjrjH_sUhawANca2YTkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MU9gk_UmRQilVWIV0n5C_aC6XNXg4Teb39Bz8_0efGw&oe=6A1EF50F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F30x3CspDcQ7kNvwGypLTE&_nc_oc=AdqYQm4uUCYy8rDjvWpIwy06nUL3xKowEcfQYQdUJNB6fTlPyYQt6jpP0UTVFexRUWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G7FFqwIcUHxx7_x2X5aWIoTPRi8y0rxwSvR4wylewqw&oe=6A1EEFCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QehNDxjPUkQ7kNvwG9APjk&_nc_oc=AdqSWAnkeBqA0vEzzhaU34SK4_v_pn6L0VwIamjeg-XwPYNJNstst7MzEBAk68bJoQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NbCcezgHYaOi35tk-bu0vDFSmIFVt0_GPMEekI3o6Ow&oe=6A1EEB55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
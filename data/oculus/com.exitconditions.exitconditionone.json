01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kwxoGdbKIYQ7kNvwGA4YlY&_nc_oc=AdrXhsuIV2I8Zb3L0QIzCWDYveoAa9MsLbfcNUVh-SRofMJRGFZUbcsoQ55nJIdUGHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs8xvN891JW5xSIxWuWMv6f2SVVs1wRWoKRUJjPEkKcQ&oe=6A63648A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM5eVkdGEgMQ7kNvwHME8vP&_nc_oc=AdpPh84EWdEH4BVNJeqOg_lTP12Nea__IG35Ro0qGlhBNniBeaMR0zJgKw-_LtmNxaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFlMwCgz6_AYqXTL-NaflsliX4RSzQdj63Z1KZUy_bFw&oe=6A637D29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6kqQTR7PdUQ7kNvwHwQxwU&_nc_oc=Adp8ealCkXrvx_BxZWaSwUrAvD3o1rERhEX8Sy2wxv_kz5KHxUiuo4NFpoAm-hr-mUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGUNFyG-BfRXuIMGpaLVQnm0FA-xHq9LOy_bBHUk6cLg&oe=6A63830F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fuZdyysEd8Q7kNvwE4EAHn&_nc_oc=AdpLZwL4N8BDGVyGlQTsLXpi73ym6k-t-eikhc2RrxzUzVHuODu4c4d7ilX2yfwPrK4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh54zRNDBRwZKP4XqNKgq6XBjFLtFx_LZOZ0BKCO35Iw&oe=6A637DCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvGZUGqjebcQ7kNvwFlafRH&_nc_oc=AdoYD5dAoli3ifmJq79U6pHMhaOY5uVb-kc1UVgIJil8F5CI5tpncjUJvXI94le2Dxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZDBjX7R_r8THqh8bD_Q9ybY4gSbC0FvAMOPWGnC_wIQ&oe=6A637955"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
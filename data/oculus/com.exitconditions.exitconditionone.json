01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A42bDAY1NxYQ7kNvwEIbR5K&_nc_oc=AdqnUVqbW4QXsvrLs8dv3qa4bkXkLnrIVXPb7o3d0r_-FN8JwXhWxFtThF_zQREaNI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEahwuk-XIYUUM0ZxmvBuZj6ldEs3bigX3q5jLehuHoGQ&oe=6A7C710A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBASnaOOU1QQ7kNvwFyQjd0&_nc_oc=AdokfkIq4zra1sSp1-Gy2VnSlnodeWfhsJH8IqHI8jka3wqIxAbCxn1FuKino5qqyoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZycszbUORMxbd1O7XonnJyhlSkGTxkOiFtXg0lnoFcg&oe=6A7C5169"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7ILP-s0DfsQ7kNvwHLIk5N&_nc_oc=AdqP9S-Z75SyS5UfuHMI35VVKPcvk1EB74CR-wrG3aArYdStvpRJmVWekEgTbnHZMO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOhiGFE2gsZ43XlytsSQBa9kGf14k7VxTj737iTXKe8w&oe=6A7C574F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXfDfRcK3ZIQ7kNvwEFSEaQ&_nc_oc=AdotcY7U4aeJ6YuvzUa7f2j744KzQaSvIVt9vA8iKNXEM9Xcei0leCZekSh-rewaOb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEINERTiBDaEGYLsHc23wmieVoo5LMvKPBPSGE4gz982Q&oe=6A7C520B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPusDdViqLkQ7kNvwFUC2mo&_nc_oc=AdoLtH6x9dZBNMWXV5ue1w_YpzqtO4xmDbs1e7VRYluFJ89ik3__iyVD1yFi0YoOVXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwb-kzFiCsk2haQRa0zHqVMs8IvlNvYgqFdNuY8vlw_Q&oe=6A7C4D95"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
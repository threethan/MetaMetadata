_nc_sid=6e7a0a&_nc_ohc=tQ1i1grvOHQQ7kNvwH8LX6a&_nc_oc=AdkTdRRy8qT8eXfgBXicmHVzf5qDg8Au5kl4ulocp-zETfdS9E8Cld18WjkUwni9xlo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzWQiFX_su21frCJgXL_S6mB_2IWO4Z-xIQMe2NEfYGQA&oe=69BBF60A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XR5wkXvp_YEQ7kNvwGcyqnO&_nc_oc=AdnIAmXW8L9Jb96ZXvRcgqTg3h5iKDim1DxClSwwHNRNRjVYd_MHSyazolk6ioTiJag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBhqDmyCxHq3SYQEXWjlhzzy10cUfO1_LwWcScEzx12A&oe=69BC0EA9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxVXepWqMmsQ7kNvwGMBpNa&_nc_oc=Adl8eQSRuzJ-zpf4j7IaycBbikFdxlaFs2JkGyfJgUGgIcsSBVXT1CpcSLkkTkNF2AQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKxanY_heKVJ0wyXfBMf6TsmLDTjo220G3_rEXj2dMPQ&oe=69BBDC4F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jph2SWpxAIAQ7kNvwFKiPpl&_nc_oc=AdmkRU8G2DxLg_3TGcZ-suGpczH5RYkNJ232PK1UIPWLdj7r4pS0R9PwQeh_GJla8as&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRnXftMS4wMgSlkw9iVjTjMsr9uLxv4oxky3Yuc83DEw&oe=69BBD70B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omgMq-ih-7wQ7kNvwEVt6Ca&_nc_oc=Adnr-e8smPXmzSHlcic1DSY3q9H38JGsDogMWaG_ILWSxHvVbz8kLmGN8szrfV1AV5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCoba6SkMy7rnM0ol_piaf1g9YNX-R42VNHo4aIqc9Pg&oe=69BC0AD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
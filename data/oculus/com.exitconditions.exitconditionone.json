01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TbP-3AjMk0Q7kNvwE20Ksi&_nc_oc=AdpgGimF4-CYgtndrouFnweKYXtrJwqRnqt_TnTNcRGVAyUO6jrk2XYWtdV5-7D0kPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEkJzs6o_RiNqCy7soq8LiViR7TSmR27rlqbsgAy8clA&oe=6A74880A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2NB9UW0ro4Q7kNvwE3uLHa&_nc_oc=AdpqqHajzi6W1FKRdNzTCsbJFkNZHq9itlm3Ii0JRVrYkYvAZut7ikjkfF4sDvxopWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEJxFHXup03L9FrexQxG0W7iKJamrpPlvgP3pusAibXw&oe=6A74A0A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKboc5OWWhEQ7kNvwEmD7i9&_nc_oc=Adp5EQtmAYydW9y4IlooADEH2KJRmPqdsfnwET3QWtEP4vlZ3i4NyiNFbztAnc05cVc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo741b6j6wCX7VsTJjiQYyFTrkau-BBcJN9qFUVnFO9A&oe=6A74A68F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1IDV5YL_wsQ7kNvwGPDfa9&_nc_oc=AdpIQNtg_VjV5dU9Nd4x1Sn_MVijbZVNnTG-6-oCSY3hTBsS63wtqIaulj1CrDDlX3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbSIU_jGYNR6HhJpCcSFb9JZXKCS-Cbm2RhqEDXjjquQ&oe=6A74A14B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC2XlekYAyUQ7kNvwF0PE8E&_nc_oc=AdpVrSzk3ud5psOfOHHC72mw8-gXLCEv1kAizk49KCISL1J5S3_V6gKcOVevH3h4Zo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8YVmkH3D-FVWNfBqjrOsRhDzS6MW3B-rzOYOpMXK-ow&oe=6A749CD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kwxoGdbKIYQ7kNvwEQozF_&_nc_oc=Adpyra8cD2py4a0XNOydm9-tIgJ2SA6D0log8nm25XmmBC02Fv8BEJSPScvSoPth2Ss&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP9gdh8c4UOOepuBfoGrbzj_xTCpAu-6SEwXW4BibmHA&oe=6A60C18A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwJvOxLdUnYQ7kNvwFYk0BP&_nc_oc=AdoNZeVubCIVFnxG8QrFDFfVh9teVVJDDPcCI7pH2JCGm3_7NP6mPMozfnTpxFHz5-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvUwo1jjC9Tzw795R_qIr8AEwP3KBwP-wo_cnEsxx6bQ&oe=6A60DA29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbKSP3U6AaYQ7kNvwGOdYmW&_nc_oc=AdoaBM6VK8-kK4bVK9-pg3nHTlErI1WWrfhJBciFDN8mDRRzRfwdpUHaL-t1elB-QFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcXUHpgt7K7xVDMOkWtnOsKs4DtCGVZFxzYsV316ATnQ&oe=6A60A7CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhhHOVjrWxcQ7kNvwFmXzMf&_nc_oc=AdpbFlOkt_64sEVOvKDJAWEW8oHfSvyf3x7J7AMMrQUj4KhioHeSdQArCc0epAkxI7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuCIgVRFg-U0dEzJ-dY80QxCa1jqcFvVhJ2eCrsHm5LA&oe=6A60DACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvGZUGqjebcQ7kNvwHdcWx3&_nc_oc=AdrfxhZ1KYUQzmLkqn7lEnQYJuid-hmi6Z7j4SjpYYUwGb0LkvNlOa1GpT9d1bNRnE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxi3i29B0wLb4UDenNuWbT4q2qO-41kOy3aYv3u2kHZw&oe=6A60D655"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrF1gpAq0KQQ7kNvwGQzo1o&_nc_oc=AdqL5MFd9kWbvKA6MqDVKjOfnoJK4tIX58h_SWRBjTDkxMSFsPVx_QYs7IEiFw9jdVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Auqh3bIPl0mwtbtxR1tSvd1cPjYldEzFFple2jd1E0A&oe=6A43C08A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjSS8jW1kzgQ7kNvwEQR4Hn&_nc_oc=Ado8ktrtCnfSpQ5SkSlLwCk_nyJ4xtKE5V6yGwZya6rLfpHVI5Je5E9iuDsH0LAAuVY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JHi_x9el6Kp4RrCa8vxrno7M0Qt0XoMtnhwALWic3UQ&oe=6A43D929"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejX2vPb5xj8Q7kNvwHbXHWc&_nc_oc=AdrRSoSyemyIOZgT7nXv_DzcfWH5QX9n809XYqnJYs0nT1nK-zEGZWKi3R19UJ0GUFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Hvy1m-B31Mm0CNwLaPF_65lzhQSYPoJf-ZFa-9332A&oe=6A43DF0F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLRz-MIrH00Q7kNvwG3-goP&_nc_oc=Ado290N41VhjoILwKMtKiwnD5ZXFlxBy_uWPOQDIy8dVYzAJooqHmu5k5lhweykVkJw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97t7SQD9R4iK-AVJ9vNRp6IX0-aZBDD8psc3fIB643mQ&oe=6A43D9CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVSLDu8i1ycQ7kNvwHEpIEB&_nc_oc=Adof48EcVeMOtI8VAFqAmtPPhDrk0-zlb2ijkNgClwdP7LRMdK8k0pYe35HWmtIEFOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mAdgCWerWjP3cJIF4YrPVnO2zaexBa6w7-QbJrwZWSQ&oe=6A43D555"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
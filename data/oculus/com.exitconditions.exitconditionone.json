01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGNIeFGxbA8Q7kNvwFyMscs&_nc_oc=AdqaeJ_NrNZ_zd8izomcAp6T6QGjKg7E5rofWmiX5sPfsyeizuNHfCfYVlQU8vCMTNw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DUO1KXE0TVtomVj_9RxW_kuqOIGOfiWerhZBdEycI2A&oe=6A0C618A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChOaamu_tgIQ7kNvwFz-EEb&_nc_oc=AdoTRV9BZIxihr5AVHBadkWHyVmG7sWfbLlV4yBp7TT96AEDkKrUc001KCesZUbNNsA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZzrUlbo_yuMgwqw-MqEjPBohpVQ9BXrf3V74jO5sHtw&oe=6A0C7A29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKxJ7LndDQsQ7kNvwFU2Ki3&_nc_oc=AdoPNkymJIi7XPUbiOR2VnJqNLa4-iG62yy3SWF9ZH7kQbZWM9xUBXcUkScd4hcFnQg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F9vEsJ2xRbC8aRKGmCNRcj_qj7K5QdQVC4Ool_m9FDw&oe=6A0C800F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hALZTDfMIskQ7kNvwEYZsgG&_nc_oc=Adqzvljr9d9lZYK3VVEhe-2F37Fp3B5NYgjBcFu1pzxFIi_xppoLwONefWmjUNtiOSQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hfcxPM4t8UONd2-zNyNrmGOHZZSFLlMRJDBhg8UscQw&oe=6A0C7ACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7jdpsjPovUQ7kNvwH_YMCc&_nc_oc=AdrXkFVV9tJqE6goxw_8_FOHI4actOu8R5EH4U6BZJXAgOLKBiHTP5SXyX3t1Ny2b8g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66zbIBx9pnywKS9B3LyylIcSqzRun8Z6XDwUTLOJCW2g&oe=6A0C7655"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4BrRO9LR8EQ7kNvwH38fNI&_nc_oc=AdplszUYwgtLfUSNDdhW2CYOmml5uuk5uZQ2ZPxIFdfN5Q2k89fQ1-umV00RNPISjo4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrvdtVPuOj8QorPwDF7CYDMnG_o8JrFFBhFFD7EXjgiA&oe=6A86FD0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d65SV62sLEkQ7kNvwEJvlm_&_nc_oc=Ado7XrSbVHvZJpYDTj2Ebb9BACLUkeScA_I3XXR1k7A4ZEe7ZA1eaFaCzrZzGFvIGCk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz2jdvLAVuJAnbOClCtMScfHJxc2U4TQpdJQvDdHs07g&oe=6A86DD69"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJQsDnjm1GUQ7kNvwHK8nlB&_nc_oc=AdrYx4coJ5okOBmun34Ghlv8qK-u3Nkb8h4PoPXnkEHuYnfDyK0mWfydxliLqqNIer0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd_hH5XQdO1zWHh8x-zwoW1DZeLna2GObpyfFoJoU27g&oe=6A86E34F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DljvBeAveHsQ7kNvwE9KM2U&_nc_oc=Adp8QstLsOZ57cmAIwF03G9atrBeQ_F3pYCBKx5VCLQ0u2dWbxvKkk8hvred4Hy_wfU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnHVV4KHVgcZFJPliCCFc-60-pN4fPqUXn3s5hfnaxAg&oe=6A86DE0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ2QKnFUgwgQ7kNvwEwhgRL&_nc_oc=Ado3LX2HXWB24z7GE37rzixe-ZHyCXVJpg8f_VC1d0LPRfmNkneZv0GB8jPZOBUGgwU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaHFGiYdST0Nb_bpOuZja9taD7FlR6YHDlGf__e7efGg&oe=6A86D995"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
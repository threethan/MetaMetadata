01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u38GfTKy6-MQ7kNvwF2sbJU&_nc_oc=AdrlXMmc7wdLPYZAqFRkrj7_2f57Cra2ZQ3DNOfwzC0bTc-ZKCeGp9GXks05gM6DHKY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66n4JvOPD-IMwTaEyHmQ6QAUUc9OmN9Q8fCWGn0Gn-vQ&oe=6A144A8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYPx6J7b42sQ7kNvwFOh6XH&_nc_oc=AdrIyh5ENdmcMwAQ3vPmF7ZbTXwGwQLz9_lJGEm4ptWWmenU6dZ45QNdMmvZ39XEtbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af776TNdwwOgfFeRtv7trkMl8ITkjnh4lxZrFT4FpQHw5Q&oe=6A146329"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIsprfIRn5EQ7kNvwH4Vjlh&_nc_oc=AdpVPolO1DIzQVyd-5mmnpcZsL2snFac_yQviAHSXd8rgKtJ-Ivaq1uIudhAvdPBUMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q0DJ13-LbYRN9q1MCE67KpgZ8hzwh32G80lwf3gvIaA&oe=6A14690F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dstvDP-1ebEQ7kNvwGhzOsG&_nc_oc=AdqRy5G8CSObJxrvf9lwWmuJ6DTgXHouv04NRsbj352qbue5bPK9Kcc4zzI7SxOvB5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GAzQr_HxvwO3z6XzUJgK6VWsv54-6QlYoOPlS36NB_Q&oe=6A1463CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SXIOmJtJXkQ7kNvwHG5vlH&_nc_oc=AdqYGSzfjHu2sz0dXqJWssrXpGdgtBirv-AzrjC7or1-9EcKgwKv9elPkFGt0Ew06VI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BUEWdpihXk7gBeMo6tX0uJUNlJjeiC58hTNjZP7A1Aw&oe=6A145F55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
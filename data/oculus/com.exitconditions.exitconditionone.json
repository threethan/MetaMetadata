01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuvtqV7DYf0Q7kNvwGEU9vy&_nc_oc=AdrcDmndUS0yP9g4o8YhU0i6EhsK5BROoq4U9s1INQUr2soHYkcf9fOJuzc7zWojzjA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UiH9yg72h2JNIe-bMEKt09qBbslzhV68w0oS7M2nfSw&oe=6A2C058A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TWPy6-Deb8Q7kNvwEYe2sU&_nc_oc=AdogBiiWWvpc3jdp62ceerh6kLqfgaoNgLw0k2L_VzUOl4NMuIp_QqyK5Zr-kbgDaJk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t4BdKzhdg8ugnjABu5SaHzBSxBEGaV_RHeWGXrBaRMg&oe=6A2C1E29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd__GrqeJVcQ7kNvwGH7Q-t&_nc_oc=AdqmwiazcsiuUskbJr5BlG7S4aoNI07q3JvFhjTuM3Jq2wvroU-9OpNUe0xODTuzZ-U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DOuF1z-SmTUAezzKHMs4rg6jbV_j1RXUi4pMk7natEw&oe=6A2C240F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbu-2LQyRv8Q7kNvwHL_tb5&_nc_oc=AdrYcWwWGbGevFHXjqowVwd5v3I7KFqupMTW82l1oahZPPfIR7kyUEXPbxvGLA_07GY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-si-CX5Ob0fhjasdjBegsi0Gw8MuM2VPXKz_EBGkc9Ag&oe=6A2C1ECB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN68GUYhQeoQ7kNvwHJSLSL&_nc_oc=Ado2RWlyUqiq8TlXoA6Q7eDPCiJkdsUmzAGH9AOv5-R25TygafcMBSXz-DszUof7bH0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qR3tYej4_x6iKD3pEzNOBOD1o6VCx5QWjv65HywptLg&oe=6A2C1A55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
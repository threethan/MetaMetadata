01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srURkHG8oUsQ7kNvwHnSHNh&_nc_oc=Adopagp-X2fVYX2n_uxnGGyMbTCH2VbaBg8nWzpEqGBiukyimq0IRZcuaYI5H61fxvA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0w5_SdJl4eeoykRlnbl2yNWRMKX__ox8ZV3MQ8mPAhg&oe=69CE6B0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSAvvq9tMh4Q7kNvwEbRWIR&_nc_oc=AdrWNAzWVGs72x8ljYyiP2ASt2FPtPT8BeYnnRvAVOVGyLwAr8zYHFnTfKtIu90ORlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZbebPeheLLRPrYLzEkgW40eu1DOohlK5vs0yA6Uu8wA&oe=69CE83A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGwF6ErAItcQ7kNvwEbCJuZ&_nc_oc=AdqJL2M0nvMVHevE07hEhVvWkZy2rYhEpaY-pF5Mr53pRR5IaRaF5sGqGNqEjfp0BRo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOxm9TevUVEApY4wJhipGsGfRqFBUga1qD3EhnRgGe0g&oe=69CE514F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW0FSOeLqDIQ7kNvwEkzh9m&_nc_oc=Adom7_Tl7nP6qXtTtG7qTMjJtHo7ywcqsTuBU25F2FWOwJY7-bWXiJ9g-dRHYxJjoMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPkEL5s1bDIrVrspzw9qvgdxdDynC08QebYYYJvYNizg&oe=69CE4C0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41FZTOeSOSgQ7kNvwFgYVpm&_nc_oc=AdoaWMmWebV88XHqAwRmvJFI0aS9J2QKUVxjFpK6o2mP-O2KHlMhVJiifjXCfe-d0oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHyMWPWSjdWAjmYfRvArE-p1r7wIBm00Z_HZqXsbrlfA&oe=69CE7FD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
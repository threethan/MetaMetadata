01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc8Pb0AfEKwQ7kNvwG_7gom&_nc_oc=Adonwev8fxeppt5SqF7aPPcnEmnW-FTOmZCD4BHDrW7DrQG2TYTSXiNf-gsg_CHHZVo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RhrCEAwfm18JXpKD3gjeftlA2cVZcKHGOTI15xqCOLQ&oe=6A45120A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjSS8jW1kzgQ7kNvwGUHMf7&_nc_oc=AdokyOdm2n0sdPl-xX0xgXa_FCJx7eQnJ61_W_DoYdeA4TT4m-O3--6iQJYjb4zSnHA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KpK-xOmOivIdla4XNOpxOluOrtRuFlVIFVadBhDldSA&oe=6A452AA9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejX2vPb5xj8Q7kNvwHj0fjv&_nc_oc=Adr7nTcNHsAHWBQ521olu0YtaNLVvNIuxIpPbbu9Pg5i_09Sk7cRY6Vkf6llNgRYWWU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ExbwWx5US6CYExAylZWDofjiMaMVIsL-z2I2kCwkm_Q&oe=6A45308F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLRz-MIrH00Q7kNvwFmssNV&_nc_oc=Adpxiy2ERNLxJEgJhE-A2aw9A6Vf0YjwgUEerHG1va6FUo9Bq0kHfB5yrZ4gIWvgMMA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RjJB-mN4w-oSLOuBlndftbfBjEhoCSnHQQ_vMu3yEBg&oe=6A452B4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWbXGJyJBNMQ7kNvwG3vCJE&_nc_oc=AdriudhMcp9hDC0nofjSP9VWK6K8Ha5dPiK4f2ywGoJPRG6FrHXQUM_Sx-RiG6Nzk4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-hOzRSGWQ5A4qhximGySWkQ4E09-yhXYwM7olDJ-x6Q&oe=6A4526D5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
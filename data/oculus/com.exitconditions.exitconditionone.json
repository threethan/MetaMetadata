01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XwO8TCgCCcQ7kNvwF_jd0e&_nc_oc=Adpq7rZqbySGdA0pKMLdqCaEqQfe3yelJ2ZMj8eQXCaJhVzi-hsBnL2m5sZULf59B8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmmHppwCaUipEY1VBHRl6JHUwnhfDTLwfWN1gkelyNDw&oe=6A83088A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eMcveMEW3IQ7kNvwFa1AFh&_nc_oc=AdrZksLaJhWmAweO3JZ3VY8gHWOxlyTOSefVGm-YkKVLAF50l4U9NqyOVx8IphkZOT8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDuRWemzPbXWzOUQBKJj95AozEiv_wIxZa6QdwfYObtQ&oe=6A82E8E9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWVWtvLSt74Q7kNvwE7oGGM&_nc_oc=AdotPM7pvO6YjJhJ5oJk4yoiAYUQPgP6foS8xA8rJSlZrGiOcWTUXHOMMta_jeoNu0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJydo-NhDfz9j7llmqskxilHYmoozTQeMB_GKm9fFKng&oe=6A82EECF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lD_pK5YxKkQ7kNvwEea0L3&_nc_oc=Adq0c2F_6fR15Mt8a2kyiPlqD0ThECWr62gl2Yy0BhX6N5a1IxEdGsI5EXMg3ZPboiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfqJJ--QqiI4Q6KiHCC1NDHvIX9fDiPpyNBYVSUgDDNg&oe=6A82E98B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HmhzsgoZtMQ7kNvwHA2Axq&_nc_oc=Adqky9plnHAvnmKGgNa5Ppq5H2kXZyNA8pPp4xJrnxNf7lJ3bpsac0SsSdkZROEEj3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNNeXHXM0sKlBu0AEJpCmHVKRj4DkoIKA3u5SuvpZ3Rg&oe=6A82E515"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-dMrYA5FgUQ7kNvwGC1zZq&_nc_oc=AdpnhLLQj2hPnDAT9DOMQlZhZqq2S8NdohB98CUP49WFK1Ojy7WDTrSJPTYfHLOuAiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A0SYKxQl_1pVYQfCmaSVzlD0ZntwmTUg8prGvatJM2Q&oe=69E3830A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzdjyXpnISMQ7kNvwGU7Ysw&_nc_oc=AdrHs5uRMRI00DLLObC4LCD5POM0ctsVmwa5AFwZ-R02Ml9dlxDaq9hB-31avfFImyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CLIhIhk3exfN6fXrUIndoTcnzuFdpD1ZoJ0vSImejrg&oe=69E39BA9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vazI85Z1McUQ7kNvwHtmUrY&_nc_oc=Adr1TqFYLCGKujfyjbVD1Pfu2RgCcy_2OMUZqrnjfbvQYJ_pJpJPe-7QL5064OqkPD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V75c3EVwHtbUdGIDQZDK5so6elBlUboIfT1iWmOuuqQ&oe=69E3694F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L83Kz8mwqeQQ7kNvwH1cNQV&_nc_oc=Adqh8buHX6m30uH-nJAMk9QZStQ8ewy4oLvHNvd9MF12U3E6M_VM8kSz6oITBefHoko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mgh-5N4Bip6DdIbs50ysMnTSh-sVgnEzeHB6eG9cmaQ&oe=69E3640B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKx1JFsNb9QQ7kNvwFCDEt-&_nc_oc=AdoVccr38dz30_rrHjVTOOGe54wbr9XklK8-pYfItN2sgKlfLVwejoFPpB4vo-LZ5uY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0koU2yggfQvqFeFPmUBgjP8Ri0eWzTbuU8rawHeVmK7Q&oe=69E397D5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
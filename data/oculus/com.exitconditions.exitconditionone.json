869801012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlFf6MyW6FQQ7kNvwFTo2ex&_nc_oc=Adq50Dd4d7vWj8py7DcPy_6l3hsSmGKIQQhzM_x9gpLMGUDqjwtQoQYvfBHncxz_r-8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy7vLx77BW7DCMcwP-TuluzCAiTbBdCQTe7zJus2UBng&oe=6AA3FE0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH2caP0q5EcQ7kNvwE6FP8o&_nc_oc=Ado355fbZSmtXERJb_ItxGemStJA0gslvdfWlu0oVQamVVPqk5MjnEgbVyQM-AtiDV8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrhljqcffhZfchgrVMtqS-f-A2zSqgbAccGG5m4O01OA&oe=6AA416A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2Gvj20jNDgQ7kNvwH53HPr&_nc_oc=Adq851napldPQ6i3LHxpdEi6k1TNbk8N02FyuXWIXrrmSZqT97zm2kR61Ysbmm2ZWlM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUj8jj8IM1i7hepFmaGSIPxLXlt65reyHgqN93jUQiHg&oe=6AA41C8F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyiFbdF4oywQ7kNvwGifjCm&_nc_oc=Ado2AAb4iyUJL7h0E8sMY-vpK_jyjHrgOXhBv-5gRxqzMpOE8Jr558WUknoIt3ccv88&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIks87pIXoFlKPMKSLiiV6bbZkTJatV245zbtoaNk5B4w&oe=6AA4174B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC2_pwow1jMQ7kNvwHQ8Z64&_nc_oc=AdqWmAhqjw2ZEN0Kl6HU0CY5POfnN44MOUIelrX1Sve6chido340LgPqqwQMbhShV7U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWf0Te07MuhCo-wUJZKm0yaB5vkzVH03Z0J_OwJ2bplA&oe=6AA412D5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics
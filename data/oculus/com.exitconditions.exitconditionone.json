01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4BrRO9LR8EQ7kNvwGa0dP7&_nc_oc=AdoBK7ODYOZeORQEAWOtiWqdqL_06U73OXOdF18poNKXar0U2EuKKK7eAFNmLV5usww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY17pOyyTIltaCSTf_13WetFEeJ9gb6EcFF9dAWZsN6A&oe=6A845A0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eMcveMEW3IQ7kNvwFPTrpD&_nc_oc=AdqCQ_0Gygi9nxcho10Rx2RbrnHR3vFFFgtFt98xXgn01Y7zaJYoO0ju-SE6MbhSb-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUZm_MHlANVhDuKFjLquCsBoXrixMyigoH8Qfi5ENgng&oe=6A843A69"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWVWtvLSt74Q7kNvwFH4_Sb&_nc_oc=Adrf2TFFrNDCnO7kcLLiPFFgAZ6B06YSoZIWblI6UgGn3Jy9g4VOi4VmGX1K_Sopybk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1C1-5sMHiSHw-OVLRyiEbuBHTKvyy8zZ4P8l3DqcmgA&oe=6A84404F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lD_pK5YxKkQ7kNvwGfsLsl&_nc_oc=Adqa9yQb7OhAnFFYWPwyuxYdli6vPLrsav79wm1C4DRxRpxLytlQsw_SUBnRtRmwm0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjnJVJdu49TzuEFe12Xa7_PV_SqcpSFFvktOxS-NC4NA&oe=6A843B0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HmhzsgoZtMQ7kNvwE0FiRp&_nc_oc=AdqSZCwSiz2PHJG9C4vE1aoZ4rNcPNpvVtQX6QrqL_ImSWlHiPB1ntPu6iLue1mQ0k8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlPm6l0okkltGOYRAtRYiJcfHiJQc_QuytKXBUWq3xNQ&oe=6A843695"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
_nc_sid=6e7a0a&_nc_ohc=dPXLB6XNAUEQ7kNvwHLr_Lb&_nc_oc=Adk9Jl9Vyj5cCG9MBzRMXB-I2VpDqo5rSCK4NXqrzVZk6X1U-4RvBNCsTaXxsWGXUtk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWY0My627kyd7RLJdbJCIhzJJTyTW-NVhCLeQu7miMgw&oe=69B8018A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu4QT-p8O7IQ7kNvwEKMvbJ&_nc_oc=AdklkJWLBQ4MLLhgJPYENwUSPoHuB2txerO30nJ-p5X7bEtWyZTnOTvBmaGbyC3WmuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzg4B9RhQGXPTDZxz62g8k-kArcJZfSspNSxkruZVJ7sQ&oe=69B7E1E9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STw5MbvqkNoQ7kNvwG87cGO&_nc_oc=AdmEQCytlE6amv5QY22VzWk038Pb3GrsxvDUKShl0wTUBpg8Nx5QNHu8Z2d7YAslFVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxUPzswStDOOPfCia55RpqO7KZ1WOSUJxCFVYvM4fdKoQ&oe=69B7E7CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW3ZvbI1dxUQ7kNvwGiOSfr&_nc_oc=AdmVDjRp2IcfjRX45sukWdHgBaU9ovXafhw4zIkiHL7LRu6IEcPCP-e2zGKoKYuWFRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_ZC6_4MpNqFmBeszeaBOksyyQ-VfIt6iFbVQp-5PvuQ&oe=69B7E28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKYuV3bjDG4Q7kNvwHdNpZd&_nc_oc=AdndrWRWr2OEOCkxoi3PLkeIceLSRRqHJwWz4G6ZF0EFf_0XyOffoIUxiZyMxeQXraM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBENbHh-V-7etJTrZRfPRzsAu_cKPQp0rT_LHzbUfubQ&oe=69B7DE15"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
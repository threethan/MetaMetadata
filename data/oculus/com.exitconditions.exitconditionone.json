01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00MM7XvP2R0Q7kNvwGUZum1&_nc_oc=AdqrHKAAgvaCR9OaJYYI7WSCRiHztyj0nNwCKemYPuU2Tys3gEwUUai7B87oXCFyO4U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk68XAaytjNe_glPO_0DlOqUItSg8zus4k4vsyRUnxPA&oe=6A5A2A0A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2sjiyWaY9gQ7kNvwEG_Pf6&_nc_oc=Adr4hdfjd2W1N3i33PcJRKZ8b90lGTMI4W0pJ8u8DmFAIbyUrn66kvj6C2KiDFrvLWU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOLayym7YowN24-AnxHNJDgy2Id0dUphc9FD9BGD_SqA&oe=6A5A42A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgMesX14zo0Q7kNvwHQm6O4&_nc_oc=Adqr2K1-nWFN0WCeLeHQg2k4AVuhMcA5UKG_vJy5q0CHI5yslOh1hU3vyMebwcfK-9o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuoZ_1okxaxTi0PbTb8ZIIDHEipcmtAXQ2ycNpkF-5FA&oe=6A5A488F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tDiJjGL5EUQ7kNvwHg9idN&_nc_oc=AdrsetCR6dNYOqfS1RxBo3AVDAOw5TtDTa6rccCdDfBWQCAw6rdb409NuQwCl2JAv0w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Aw92_i3cN9bXVLYngJ2qC8pfE4sUTp80anzb_rkg1w&oe=6A5A434B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfU37SmjfkEQ7kNvwFz3P1C&_nc_oc=AdoqNUGLTHsSm3GrqV7rnyHVvbeJDgYMTvZiIHDd5Tu23K-xX69Bc70KQ6QDRLQvxac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNLoMRtBALdWZOocIrM6Wo31Kn8K2gLIbS6dYFS1dhkA&oe=6A5A3ED5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
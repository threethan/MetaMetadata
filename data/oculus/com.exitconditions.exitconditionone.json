wQ7kNvwEsx_ML&_nc_oc=AdrSAImHt20sTJ5AGWPxDiEj_Q0xUkK5gLzEPq1KNQ2qJG74qkAWeqsN5eQaf3Hbi44&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HleZ9LlgAp1CYqI62VFpqMo10MzzzGu7HosgTLdVzBQ&oe=69F2038A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMcp-y6lYGkQ7kNvwFk9gMi&_nc_oc=Ado3qwgI3qr2YoFBWZbBjRkdgclLXPQycaPx61jSPkOBogInzuqugytc_PAg9owlp6w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09dRW-VLP_033bPVtXd7C3TAVnvOsPoieMSCP5ocsnYQ&oe=69F21C29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfdZDCDBXBkQ7kNvwEVh6Hh&_nc_oc=Adq5e2jZoIcOg_N0dtbeHnrlRXOudm__AISsf6Is5mD6o7WnV_eYtvxvW9Weh3EyRas&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MfKw-iugrI0LL5jOY-i2QLG3j_z7fEqDkNSU5vBsBnQ&oe=69F1E9CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSn4Kds5Nn8Q7kNvwHn7Xck&_nc_oc=AdrYaNblKvPSyI51aOkVqbSepnW8nlmmxYzReryvCeZ7MrLSM9a__GGvRk5Njb5A_bk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2kJo3yqPoYfLmSzYa0SBHlXazoNxgITP5hyju6sqz7tQ&oe=69F1E48B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8Dc6vkZYPkQ7kNvwEuI_KP&_nc_oc=Adpb4CA-1OT7K9HheEexDHCET3h2Y9uoFdyO6ELHXpzU7DRi5lb3_Nkb9wLZVPfa_2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af251voyydzvy5SQqNHQvDvDPz2mUvZA3fDFgWXSaTRhQQ&oe=69F21855"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T7CrL57Gg0Q7kNvwEUU7Jq&_nc_oc=AdowEahMn1iJ3gSfH8gtwTYoLKHEu9-41g7YmD-Du-K4Bs2qkft77hUInpzvax2ZJSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26xwDxNY9Q7jkAe-_aKVchb-chboy8-OaCJMwv4oofFw&oe=69E8C90A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjevQKMo0Y0Q7kNvwGM5FkE&_nc_oc=AdqUHuKOhB3GXzvxWlyeiCs1u-jAxhy5crLwHB9T91Xnb93kOmNVqXoojrK-nLZ0ViI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xUOnvF7uqGu4kiu1XGiWG6Yg8qjEp2NO6m1eQYDepyw&oe=69E8E1A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1nKshY-ZT0Q7kNvwEImpi9&_nc_oc=AdrGkpb1SCHF-URIWZKpFYE3vBGqs4w_jlKTyRulGqG-TlfiEzB6_IsZ0XU9gmVd9QE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_ox84DuwL3RbjHWbab4rt54yoC9tkBHrYIYuT9rbaPg&oe=69E8AF4F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8KM7Jqn6ncQ7kNvwFTxmlb&_nc_oc=Adqoz8g6noiFHINTuQUzpMPBxMmbiqI4p5h-qh7bQUJNMB3ZDn0nW2dyDuq4xguCwa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tN1zxJER8DDq_PMBRCyofuDyGE-Eh3Y38rpxcXSUyfA&oe=69E8AA0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFoOYWpxCJgQ7kNvwE2kmmM&_nc_oc=Adr9gQCDPYfmVf_OJPaQVln4-Jyqnix9JkIL40KKPCEAJ_d_Q3DT-8tovEqnrw8oDQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38d7U4mnqSZrQmHpM6TBkPXtdaCcoP2EhVfeVl24BBgw&oe=69E8DDD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
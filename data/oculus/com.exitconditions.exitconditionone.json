01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjNIz6KQW7gQ7kNvwH9xArY&_nc_oc=AdodDXrATlNZhqeOTbSEYdl8TOF48ATIF7KWhuBONkV6NlMQFOvIapZicgWLXt7j4zs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_u5SpBFms62h5FueXh74vJJWHG2GNmD4NzO2alo0Swg&oe=6A26BF8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umf3OxR2wrsQ7kNvwHlFMuS&_nc_oc=AdpgxF3mfnI1EbZBUJGDMHLqeuV21W2AWrS7HXqlsdx2GClw1Ta1PzcDbGzc7IHhZfI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CLFBUSuIDzQFfjn1aVqFRTXqNFwQ5GMYfd_gh3scINA&oe=6A26D829"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9xONQOBmm0Q7kNvwHJNF7K&_nc_oc=Adog5PiM7tt0pThz_zVaDUligdWM2j8X6KjdZaQo9Tmp7CNtW2RyqQDzus7hy9BKQws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sFy6MY0pKcKdvU_QmGe2_QrpscQ7-huAyAtnMV99F1g&oe=6A26DE0F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLi6yapwotwQ7kNvwErGt2-&_nc_oc=AdqF-2so_sWS55dGvj3ScHv6cHuJDux_n5A7GNLg9Xk0pTmVPDRV1hZLYb8zM0oksCw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LCY_6OF1RITJxptkDM3Qrb-gOLrFEpanbGHgvQCZMYQ&oe=6A26D8CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggPasaw3FkoQ7kNvwEUXpzR&_nc_oc=AdrFJe69eHBqRe5kiI6X-921vENvW6PZxhK8caRHijyXUILntsRR2YjFGre7NS1HSGk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-txv2pI4YjyWHGwHQBJryV_m4Wqp_HiQamPqnPFNUKNA&oe=6A26D455"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
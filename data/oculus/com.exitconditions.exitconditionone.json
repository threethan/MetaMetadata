01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4usLyS3qcwQ7kNvwGY264y&_nc_oc=AdqlV6G7aJm_mTk0dWLMzNHd3ehjceKW5izFc5YQIN1A-TU_neOIID7_ETeLjvTElAU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3b5bh68F5wOY24shEiX60G2GWNJQoFEPlEAh7ogZmrbA&oe=69F4A68A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pplY7Y1wCzsQ7kNvwGsReyj&_nc_oc=AdpXqjUdFuBqXIFTHyZnbY3RfyB9AFk5Vf2GnJ_MLtxcX-jO4arRGDcawbyKq32RV-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Uik1js42zibH-KphEY0N3659ZhMP2laKKCtlgj3RDCw&oe=69F4BF29"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z5HnRF6Y6sQ7kNvwH0XR8H&_nc_oc=AdovhxiJRvjlKtE4R1Oq-rxw2WiX2o8n6vmEw8GhMDmWINnzgeI3yNk5gyy_DjfUhBA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jjQU5_HwJUWJHF8AWAxCRoOAXxY3YAWBayTGmvlldnA&oe=69F4C50F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU0j1SoO7P0Q7kNvwFdfOAz&_nc_oc=Ado0dGMhQeU-CYB_WPyZVmqaOV9IabXqhzYly7rRDHlTRTtYJclZLxdik4p0zkAghSs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YPVRSaLec-gUPDJpgCfukXBFCvs6lTkB8NvtHryq07w&oe=69F4BFCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8Dc6vkZYPkQ7kNvwHG0gDH&_nc_oc=AdqMPwythwBuOXUz2msZ2tT5nrxDb4RfGSNZ_chfrsceHKrew-7a9LPFXaORy9nqYRE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0267N7AT7MwX4Y10TbPxN3Dj4B60iTjmuSUAG3hzmtLg&oe=69F4BB55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
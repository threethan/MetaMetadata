01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dgVV5aJ638Q7kNvwHPESGH&_nc_oc=AdrBG9FkE_zLK-u2SjVuHSY2gd2B07sFZgEA7WJJJzJwsxjarM-AlYlLWsHHTyB4XsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5Ql7v8yvujU09CI18YnZU1iZSi9_pBY1O_Nxff_rXhQ&oe=6AA2AC8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH2caP0q5EcQ7kNvwGifg6F&_nc_oc=AdpRRIiS6NwkS5UBbR80B0mQH3VMXAfQZAGPXFdxL779Y4rQlNhmQWRbNoUvUu2hnF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2U1uvnzQZOZykkLvSUnYth-w_VeZHXouZGfOXQEDzMw&oe=6AA2C529"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2Gvj20jNDgQ7kNvwFPX4XK&_nc_oc=AdrJUHC2rKLi6XJjL6sstHZPakwzvvjcsEHJLAxC8LmP5YDRDclxavkfEqCaPEW2zvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4smo2aLsaRJU6fNgMqRrbF2WofmZ-SK-aQznJh7VxEA&oe=6AA2CB0F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyiFbdF4oywQ7kNvwGTlYah&_nc_oc=AdpeI6sZ2QRvC-ayudvCcab-gXBQO6w_FXG5yTfVwx_6f8y-HsNEWBjx2UcJ8j7I71I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVTG4ifEMOoscZNr58E2ZnM303Gn12NwrTJ5yKAVBhsw&oe=6AA2C5CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwYqwf_THIoQ7kNvwEjoyTR&_nc_oc=AdpEJNgRZr7Ztq0nn797BVIRH5AScfxuDHckBp83cwIgzhe-t6dKhUbP8NPSoxwMWqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeesBOWuV_thqH0I5ZAnkhZeggvN0eK44LLUfUkIHiNA&oe=6AA2C155"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
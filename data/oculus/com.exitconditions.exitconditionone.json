01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPh_csxbq5YQ7kNvwFeW-ij&_nc_oc=Adrmc_IXhewvpNm5rr0tgQErL5LHG2U5_Jz05H8BEKkGUdi-12fuqcts6lbzOqmVkpw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxiNsfZkpX6Gowr4ad2eq_KDfiZ4STOCAE8373g9BNWw&oe=6A6F420A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVFQfiCHMZEQ7kNvwHXwT1n&_nc_oc=AdpMmoJKyDWKAh2KTCkCZRHORFMZeTJdRjD_lYjXbP1YRDQcO-DznDiF9_im_9QrPMM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP4n3q2qOlwaBn0HazO_r7rY3upVmMA5CRERHcL5cpMg&oe=6A6F5AA9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXExZjtaJ14Q7kNvwHEOjls&_nc_oc=AdqETirBK9NLRKSo3eScfJII8AJmlr0fIUIKMrarlXWc0DytMciozlIEzRZIkgUdQbA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFs8h5GxG4GfqTcuYMS-xZkDvSu-jOQO3W-hs9blY1Lw&oe=6A6F284F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4omc6kQlEPcQ7kNvwES8ik0&_nc_oc=AdpIPfr_ojifEy9ytWtFW-0nqdft2j-BLpwVAmNn4HrnJPguQd01Ol5iu4Zn0jX6G8o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe8MT8Tw4_g5FswCQPoBgTsJdGUOpTAT3IETIZavrHKw&oe=6A6F5B4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGEduD4TBNYQ7kNvwHxrGeK&_nc_oc=Adrc5I76_bv0cyPbzaM0zRVndAS_T7jVXVjVR2FehsdUVUbTHJi2a6SSu2KkGmLa8jE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1b5JTc9r8M040jOJCIDhM_pmjmZ5ZWvyC52XRpYOjMg&oe=6A6F56D5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
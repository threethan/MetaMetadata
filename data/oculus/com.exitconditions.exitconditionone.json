01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3XUHSZ5v7QQ7kNvwHBMrBV&_nc_oc=AdpSovlOSdg3GQFmXfoyDR9g_AnZMjiies1-ReQb_7ZvIZxraCvKyzTel_YmRKUxBcM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af110dgmu7t7Bw8IXoT7dk52kAHZj9Jg3aiwKAZkrYkcUw&oe=69F5F80A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pplY7Y1wCzsQ7kNvwHfYvIU&_nc_oc=AdpkbResAUCyUBXtZpdhouVXRxILFCvgC3LnmfvgOCC_JZwDTQLhipkyOfHBYl-h01o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09tYa9tbAco35EguBfQU4DadwxiuOhc1nRmUetkp2eZA&oe=69F610A9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z5HnRF6Y6sQ7kNvwGAH-ko&_nc_oc=AdqPLvrhtOpdN0qRzDdvQ_zmEJJrK8HP-3tGurYKxkDKjQ8KhPekdnNfrh17h0OC9Qo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2c8PBRvbNQdissCE-tgEdpPIsLyptFwvfsTehmS33kCg&oe=69F6168F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU0j1SoO7P0Q7kNvwFAJt6K&_nc_oc=AdpTw_1URiEV008bJbuBcOJpluMJHiGZluhUs2abT-cIFr9IzSXma7zENIqrYlLB8i0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JBgPx10_LvLA7fME609Byry-KwsPvoD5afNuel69SUg&oe=69F6114B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvV5Y8dwwEEQ7kNvwERLtKS&_nc_oc=AdrNTnsys0Jyb0bfyRaVLl84P1Qw3GB8i89cuXD06DzOXaVAW1Szq1ZD6EXdctPtxjM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fOGM8UYgNRnDZMC41D4gSA8yE0QDJ7FLickcURB_nDA&oe=69F60CD5"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
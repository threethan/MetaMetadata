776661000869801012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDxNxEXRwiMQ7kNvwGXIKyg&_nc_oc=AdqICT_-y0mtKNQomd4gj4no9XqUUyHvzuj7S7t4wWhuleU2gjLixFItECJ8cu7d8EU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA0mOEmEwLddZosEn7E2bz0GuRVaeYN6AEdfR4lF1iXw&oe=6A8EE60A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbeQaZgT2HoQ7kNvwEQzhsD&_nc_oc=AdqPyH4PzR0_MoQh3OD62JeOI9yW267kX3-sQhRV95nOPxU06fAkZwM9zwiSL8g8FF4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE37Qs_2OgZuFO6EGQ3eCgOFWv3sf72gObOussqZh3IZw&oe=6A8EC669"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1p_ZEVx3_kQ7kNvwHOnVcF&_nc_oc=AdqT4UKLKmtxRMScYL14LWJwC-S5wBGJ91VOzKHFx6d3wZm3YwO2TYVVm1Y7zVYnqdM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg0rQ3N7Ao6FOL9x4r3k9loiTZq84uR6FTARKYkfgeew&oe=6A8ECC4F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpCbhtC2aEYQ7kNvwFKN-HQ&_nc_oc=AdogksIYmtzd-kjwLSOvpARRNztSIMbzj-ISAj3usfCu_LE75jvYQMwPOXPPhHo-G3Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsWcHQ6BGYWzhVklp9h9ri218aGfZXQF7z4sZwUjvO2g&oe=6A8EC70B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXgbhow_WIEQ7kNvwHgcom2&_nc_oc=AdoGj2cj0HC84BAHuBcanAdf2kYzVQsgU-NcyQUJ_XM6zzRaFMR0mIx3DQmllQho8JU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOyyFDo06eX84SqMf9Oyu3xRhPdYGVBcxcRBW97bpj5g&oe=6A8EC295"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
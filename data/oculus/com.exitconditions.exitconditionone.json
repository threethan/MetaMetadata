01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U18KxtloEEUQ7kNvwF7LAoH&_nc_oc=AdquL-LD6RUFIZIUoHxETvwcF38mOlPQsLCAF9q99MDSm8SVMipC2k-i1ZRfQLdmza8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1XlMQGXyfZ0tH0F02KeWmMA9it48SIbPp0UHfBrl72Q&oe=6A9858CA"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExKL-WVl4hcQ7kNvwHX4Eqs&_nc_oc=Adr_QsBkYrO5LrfZg9JdXpEBpNTbIXIfNycutlYzGFuMvvtS0XLxoe36UA1DYNmolv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNq7iniVLSkC2fd96O3xxu4FfORg6baMsbfjRVPdxRVw&oe=6A983929"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0ygreO_NVgQ7kNvwGbF5WJ&_nc_oc=AdqAp4EipmOIEYxUj1pRqhLki5BDmIEmBd7p2IXgmcBZ_BFTCp4x65TxQPTKFlXHcyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVY-T3IEAQwKAhJieY5YIt-X1fU4I_x1ZhVGKn3uFc_A&oe=6A983F0F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq6mlaI7eJ8Q7kNvwEEWsjz&_nc_oc=Ado6XlHmL1PV28OvjoXUIg-eZEDVhs3g2E6hNI7EHzK31BoY13jOvcrseNhyOsLjQP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLglHCxMBTvtVdj7pytwhI_8FOC7b-szSHvc9yKODF1mA&oe=6A9839CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu2qA4jPzawQ7kNvwE_-WNO&_nc_oc=AdqLrFyBM8AlQxPqfUscL2_AqHWeYGqoLYAYyiWzn3GLt9e3Ec_PpKvvgSgCBZER3og&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQH00Z7JFn3wzVS3iA3h3Q5P0X6jraxUEuLtVSMS3_Ww&oe=6A983555"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
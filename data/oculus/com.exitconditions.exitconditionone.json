01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPv8FmlQnxoQ7kNvwGg8Fy2&_nc_oc=AdqU0sNd6cC_vXgwyNyUGQhUoGaHOG3NHaToh3WTvXGXSaVinibacjyONad_er9CRvs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU8zglJPDw9VoRYn_o9fU1wsc6GY5ibwOH-OWWUfeZmA&oe=6A8AF18A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm2U_W_uR34Q7kNvwH4Y5xu&_nc_oc=AdrFUVCNcqUS7gIlnlR4LjCXeCB__41ptt-kLBinrsJAjTipFwFjxsIiRph5xGh5tgs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwynZ1u3jlm-YyTshOC7MoYx-E62bzVsnHT0J2A9Sq0Q&oe=6A8AD1E9"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxXEaW_-DR0Q7kNvwGUiuFG&_nc_oc=AdpcLtzpmrWWHv98ATqCqEQFCGC8jcsRRcksbp0opY_Swz-xYo2kBOnXk-EpBVYxvFk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGejHlQ0PWC3qQlWe7vRLa2pDOZzIKoyYyZOJSmXXcrBQ&oe=6A8AD7CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBJxvC-ahTIQ7kNvwFpuX85&_nc_oc=AdozsVUmS6qSfCcKHRZQRWj5_yhA0-0LN7trl-2hhh6BmqWn4NdtcJKgDpqQvveSLng&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiqgdTlHaoB17z5b1aJP6EGZKcyZjGTML-Tp8K0Xkbrw&oe=6A8AD28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwLKfwjRooIQ7kNvwH9j3my&_nc_oc=Adogp9IsD-KdiPuUTcWoIzzo0VbzBeXxmpsuZcOUUVsYkDqc_FbsX_H_wcxNd4ewSgc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvlg4OcDwE-dWVd0VAlS6wf0rchk3U0Oy_r7a_gdiogA&oe=6A8ACE15"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
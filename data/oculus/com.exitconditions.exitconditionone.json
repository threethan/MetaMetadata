01012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XwO8TCgCCcQ7kNvwEYrS93&_nc_oc=AdqeEyYnnEQQuYVv5wd6Im_Z85OC8tOikHKnUj-I4tJ2oJ3e5yYtaq4EfZfS00ghkZc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFECx6umgPSh-rgt3RB2KHDQvvkZSwCzaBSr8qDZFoONA&oe=6A81B70A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eMcveMEW3IQ7kNvwGbmWAM&_nc_oc=AdotbRvMOSYvwNcTlvKTzFXiAfMyU2VnCHbXtvKtnTrmYnHjQNmJwvFVbDr62xitJ4A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG368wpS7gWVxokI_uz0C8KoQKcNR7G7RiEHzNNV5D8hg&oe=6A819769"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbZBIKQFBRIQ7kNvwEwOZii&_nc_oc=AdoJFzO_sKIS-yWs2fvCdwDJdE9hn6NBsmkMS8zvCR_s-D7t371kjtYUQLIQF3ITxIU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF48cnMVO754Yr_wuwjzTdmC84UEXS75JUsvI6xEFI8Sg&oe=6A819D4F"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWqbE468p20Q7kNvwHxmoLe&_nc_oc=AdqbfVsYJ8euBqJY2WFS41c34IaD6jt11uzYYrvhVwGv_pWjiWGMgo0X_X7ziXj5sWc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvIxQqSkpKuQVUR-udBpPa2IsjK22fYMEHhXCSicHcCA&oe=6A81980B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HmhzsgoZtMQ7kNvwGBtsUh&_nc_oc=Adqz9mkhU-nn-lochpbKh-io0k-IxSfNy12g3-oMNYGMyzs6J1Nljr99oWj_32oi8EI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3fu4PE539Lsgyp4pKnA07Fvn9kX7XPIjYwfCeL32QxA&oe=6A819395"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
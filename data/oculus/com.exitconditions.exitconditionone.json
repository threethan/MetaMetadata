_nc_sid=6e7a0a&_nc_ohc=oc7YQFXXM-wQ7kNvwGJ3yu4&_nc_oc=Adloadftzk1FYVNBNjlzjpCF7i1TG6nXb7hrJqML69mPgro1LGVyH7t7nUphqqPbAZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZQQMLl1dDr4O8cJoJrCxUpwDKC6xvKZ0jzSxDCTJn6w&oe=69BFEA8A"}, {"file_name": "2560x1440 device shot.png", "id": "331809148414815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001721_331809151748148_6567202828240377072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGUGNtGGSwEQ7kNvwH3spgM&_nc_oc=AdncEYNi1qhWnUt_f3gqpo7GVcdjZ5xx-TLQxJej3-rF4HEsNC_a7af_cjCiICVRtMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8J5TPXTqZDvcuSOU3Ykg4abdmDtnF6WNNDI41OaZFgw&oe=69C00329"}, {"file_name": "2560x1440virtual shot.png", "id": "841026373516293", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_841026376849626_3803472195590454326_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4ecbef9o0oQ7kNvwFcL5fZ&_nc_oc=AdkcwbAsKciaMZ0pS_Y9twpngWSQu9mKh0p2zh66rkO0PRxMuw5AkthEeM4jhTt5Ya0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywCt2poaA4t1RhtzKvwhpI5FXFr1ezBNNrdU79iNp2ww&oe=69BFD0CF"}, {"file_name": "2560x1440 fireworks screenshot.png", "id": "275556064370648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001654_275556067703981_4735310609106135896_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6SKGztBQ5gQ7kNvwGoDPbH&_nc_oc=AdlbBhTGAiWFp9PAu56hUGTb80WvJTGLFIdI0sTBf-TQDX483C-J62buIX509nm4xQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiacleHcE3f2zSROQ-3vPvJNBDm8n4QxFZRi2Dvqyu6w&oe=69C003CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "2605676156395631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974608_2605676159728964_9206111280510424647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h6Sd5-DtCIQ7kNvwHzies9&_nc_oc=AdlewB6AYuZG9CWVBS3WlglF1uxyHBvHhetBGaIR1c07ckyPleUDPxmDNWu7Dr3CqKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwHqQvmqk057tZIuvMzlqVS-0C7UfI0x6EwSZWGQEdQA&oe=69BFFF55"}, "display_name": "Exit Condition One Escape Room Demo", "keywords": ["escape"], "long_description": "The full game, in early release, is available here: https://www.oculus.com/experiences/quest/4463936340397965/\n\nThis is a classic escape room game built exclusively for VR using roomscale to give you the experience of really being there. Walking is fully supported. Your hands and all objects act just like in the real world, no \"ghost objects.\" The puzzles are all tightly interwoven into the room and feel more like problems that need to be solved rather than puzzles that need to be figured out. This is the demo of the full game (coming soon). There's about an hour of playtime.\n\nCool Features\n- Roomscale ( walking, locomotion, teleporting, stationary, sitting all supported)\n- In-game visualization of the guardian to align physical and virtual spaces\n- Drone with unique 3D controller\n- Full use of physics\n- VR within VR\n- Fireworks display for finishing\n- Dynamic background music\n- In-game hint system\n- Distance grab assist\n\nThere is a discord here: https://discord.gg/2NfBumhKQD .", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
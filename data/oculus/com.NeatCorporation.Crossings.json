O0zwOp7NZVa3IBq-ZBH-SGWjCK-oOHGbmRbA&oe=6AAAA2FC"}, {"file_name": "3.png", "id": "1033704491630331", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303346_1033704494963664_7797187311561543451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3ounKnRcbcQ7kNvwGkSX7v&_nc_oc=AdrmhQFNj8kEv3xs1qG-JUA5FX61JF5TnczMvXs8Ud4Y6ASvmmhqaXC1F8y97ydAnNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsWpl5Pj84YAWCQExGoMrj6yR-Z5j6N9saA9X1-vQ8LQ&oe=6AAA92E8"}, {"file_name": "4.png", "id": "1259841992415170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303967_1259841995748503_7206542794518160835_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPVgIMoLpZQQ7kNvwG7V00u&_nc_oc=AdoJJQus2ufvaYGs3B63seg_AjN-5jxeK5C1sWyNAfcv5hSJG0_M-00mOEtyzpvv_gA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpakzkfkayJVlDaOaQd3-KyrGS7KUWpBuWx4KFSZqKKA&oe=6AAA887F"}, {"file_name": "5.png", "id": "1023671413271824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300517_1023671416605157_5381542366930377679_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gomg_M18ykQ7kNvwH7aQCk&_nc_oc=AdoOsIY5bLmo9QeOKJACHxdDXgCgcA4zM86rzUJGeTWq8yKNb8DsXhT9yFfYHWGzcjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhYnz70DTcbtDg_R6o6DJhLrRM9WuWspzPzl4ECIegNg&oe=6AAA9B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb.png", "id": "677063438430812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824611_677063441764145_7109076997314994681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W27V_osC3AQ7kNvwFUd827&_nc_oc=Adrkno6mNiuiHKBHikVVQWshsK_NWUZJwTjBOfVqN4yJ4xMOg3qHuxVBQAqwKn6mBZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9pUmLABQAOLw51ERh2urNQtsAv4wVVu_UaCf0ZtkSIw&oe=6AAABDD2"}, "display_name": "Crossings", "keywords": ["Combat", "coop", "fantasy", "swords", "viking"], "long_description": "**Block, dodge** and **strike** down your enemies in this Action-adventure Roguelite through an ever-changing landscape of old Norse myth. Claim mighty spells and new weapons as you make your way further through each run, learning from your past errs. Encounter and join fellow travellers or enter the world with your chosen compatriot in seamless Co-op as you push forward to find answers. \n# Combat\n- Wield blades, clubs, axes, and the Tooth of N\u00f6r\u2014an ancient weapon tied to you by fate\n- Fight, block and dodge Trolls, Draugr, Ghosts and other beings from the tales of old\n- Claim altar-born powers, upgrade your weapons, and craft your own fighting style\n- Cast mighty spells upon your foes through a unique gesture based power system\n- Defeat powerful bosses as you push forward in search of the Nornir\n# Experience\n- Brave forests, ruins, and deep caves, each newly formed every time you enter\n- Encounter other players through Seamless, Ambient Co-op or connect to your chosen travelers \n- Each time you fall, learn from your mistakes as you embark your next run\n- Find hidden stories and rebuild the memory of your lost village, piece by piece\n\nFight alone or stand side-by-side with others. Every crossing leaves a mark\u2014and every choice carries the weight of the world you left behind.\n", "short_description": "Explore and Fight your way through an ever-changing world in a quest for vengeance and survival in an epic Adventure through the Norse afterlife. Meet fellow lost souls in seamless and wordless VR Co-op as you Block, Dodge, Strike and Power your way through Trolls, Draugr and other dark beings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://neatcorporation.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Creature Label", "support_website_url": null, "website_url": "https://neatcorporation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
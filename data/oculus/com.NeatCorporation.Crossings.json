KV8Q7kNvwEdPwBq&_nc_oc=AdrPzo6zVmvegZms0L-qSg0-c3fZeLoLdqf8-p2C5CcmV8UHrco_g7C1JgDX08f16Fc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36GDgpcAY47fQfMnKeHrCnceHGAQDgguiivjEpYX_7RA&oe=69D7A2E8"}, {"file_name": "4.png", "id": "1259841992415170", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303967_1259841995748503_7206542794518160835_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8qcHeAm5oAQ7kNvwEKOuNp&_nc_oc=AdqKswlk7cX2LUs1DH-hpDyIQL-J-RyOLVE0eX2Iqbe85nU1tH5oKIjO8ArF6CNpdxA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WI6gat_2k0wo_tndnrZ9jIwBlWt7f8191yLlWrQO6CQ&oe=69D7987F"}, {"file_name": "5.png", "id": "1023671413271824", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499300517_1023671416605157_5381542366930377679_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qDl_unMYcMQ7kNvwFfyt-V&_nc_oc=Adp8X7gLc2VFu-_XTf8b0XsKEHocm14H3IBlfUhiM2IkdN4DC5DUOAsMv4gTAYfHYWc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l3x0UJ0aFayEsekEMz8SxSud6pPMyWIyjKu9DEc5UAQ&oe=69D7AB57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb.png", "id": "677063438430812", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824611_677063441764145_7109076997314994681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GhF5OOQTzwQ7kNvwH7f381&_nc_oc=AdrGkuyn5kRz8hKx5nTC9y4BIbFf3Es3azytk8eBnIpMh0LeNPThTC0zyBTH2dFwkYE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VGx_I10I4yTyKNzJ2I2IHgdy1TKLhDFiIq-zSqBeN2g&oe=69D79592"}, "display_name": "Crossings", "keywords": ["Combat", "coop", "fantasy", "swords", "viking"], "long_description": "**Block, dodge** and **strike** down your enemies in this Action-adventure Roguelite through an ever-changing landscape of old Norse myth. Claim mighty spells and new weapons as you make your way further through each run, learning from your past errs. Encounter and join fellow travellers or enter the world with your chosen compatriot in seamless Co-op as you push forward to find answers. \n# Combat\n- Wield blades, clubs, axes, and the Tooth of N\u00f6r\u2014an ancient weapon tied to you by fate\n- Fight, block and dodge Trolls, Draugr, Ghosts and other beings from the tales of old\n- Claim altar-born powers, upgrade your weapons, and craft your own fighting style\n- Cast mighty spells upon your foes through a unique gesture based power system\n- Defeat powerful bosses as you push forward in search of the Nornir\n# Experience\n- Brave forests, ruins, and deep caves, each newly formed every time you enter\n- Encounter other players through Seamless, Ambient Co-op or connect to your chosen travelers \n- Each time you fall, learn from your mistakes as you embark your next run\n- Find hidden stories and rebuild the memory of your lost village, piece by piece\n\nFight alone or stand side-by-side with others. Every crossing leaves a mark\u2014and every choice carries the weight of the world you left behind.\n", "short_description": "Explore and Fight your way through an ever-changing world in a quest for vengeance and survival in an epic Adventure through the Norse afterlife. Meet fellow lost souls in seamless and wordless VR Co-op as you Block, Dodge, Strike and Power your way through Trolls, Draugr and other dark beings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://neatcorporation.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Creature Label", "support_website_url": null, "website_url": "https://neatcorporation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVE
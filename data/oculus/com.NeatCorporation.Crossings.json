NkcFVp5xsV3fat4NhRk9chHEhyw29twOqY9t9SiKQ_i5m8gEE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFWCt-hr-169Q34bbMLWYdZQzxLU7IZfKy74gqHl796g&oe=69B7FEE8"}, {"file_name": "4.png", "id": "1259841992415170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303967_1259841995748503_7206542794518160835_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu7InpqC8KYQ7kNvwGmKzsi&_nc_oc=AdnNLO-Nzwm5dqkO6utcXLYnAzbhezMpz2yOxmvk4WvBtMaT_mRKD_FzkARS7ytiZNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpOZydhbjiARAgcEKCa_Cd-g5DMEZCU56NwVt1MlEYVw&oe=69B7F47F"}, {"file_name": "5.png", "id": "1023671413271824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300517_1023671416605157_5381542366930377679_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5jVSpjkMZwQ7kNvwH1sb3q&_nc_oc=AdleWtWraQimu-RA6Y0YSyc7vF2geKomQXs1HFndK9_VE0h5DD3GItwtJPZmSfyeOG4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyHxvwqwlfLi9s-sggudBj1WHJfvx1JZO4EVJSfKf5XKQ&oe=69B80757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb.png", "id": "677063438430812", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824611_677063441764145_7109076997314994681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9x4BY96FoAQ7kNvwGML3Yq&_nc_oc=AdnFScnAPj_OzLITliv56fdck-YGe-ZJpm06vvE6-4rLxQOtKiVlP9HAzvv2ehZOYnw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsgRY59dN1mT1wyGVOEt_lJZ7prf09Twl7WufzoC-jhg&oe=69B7F192"}, "display_name": "Crossings", "keywords": ["Combat", "coop", "fantasy", "swords", "viking"], "long_description": "**Block, dodge** and **strike** down your enemies in this Action-adventure Roguelite through an ever-changing landscape of old Norse myth. Claim mighty spells and new weapons as you make your way further through each run, learning from your past errs. Encounter and join fellow travellers or enter the world with your chosen compatriot in seamless Co-op as you push forward to find answers. \n# Combat\n- Wield blades, clubs, axes, and the Tooth of N\u00f6r\u2014an ancient weapon tied to you by fate\n- Fight, block and dodge Trolls, Draugr, Ghosts and other beings from the tales of old\n- Claim altar-born powers, upgrade your weapons, and craft your own fighting style\n- Cast mighty spells upon your foes through a unique gesture based power system\n- Defeat powerful bosses as you push forward in search of the Nornir\n# Experience\n- Brave forests, ruins, and deep caves, each newly formed every time you enter\n- Encounter other players through Seamless, Ambient Co-op or connect to your chosen travelers \n- Each time you fall, learn from your mistakes as you embark your next run\n- Find hidden stories and rebuild the memory of your lost village, piece by piece\n\nFight alone or stand side-by-side with others. Every crossing leaves a mark\u2014and every choice carries the weight of the world you left behind.\n", "short_description": "Explore and Fight your way through an ever-changing world in a quest for vengeance and survival in an epic Adventure through the Norse afterlife. Meet fellow lost souls in seamless and wordless VR Co-op as you Block, Dodge, Strike and Power your way through Trolls, Draugr and other dark beings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://neatcorporation.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Creature Label", "support_website_url": null, "website_url": "https://neatcorporation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24220124064240149"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1542634620183321"}, {"status": "PUBLISHED", "id": "716403918074619"}, {"status": "PUBLISHED", "id": "1570873080714881"}, {"status": "PUBLISHED", "id": "1282431397029551"}, {"status": "PUBLISHED", "id": "1187635959398034"}, {"status": "PUBLISHED", "id": "1509226263692267"}, {"status": "PUBLISHED", "id": "1013763670914817"}]}, "baseline_offer": {"id": "1570873080714881"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1542634620183321"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26644587545127110", "version": "0.000700"}, "id": "227233183761951", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7631852763493874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26644587545127110"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "227233183761951"}]}, "change_log": "Major changes:\n* More encounter variations in all acts\n* Leveling up stuns nearby enemies instead of killing them\n* Bugfix player XP level 20, used to block your progress\n* Electrified status effect no longer instantly stuns enemies, requires draining their stamina first\n* Acquiring Norn trophy in multiplayer now works\n\nMinor changes:\n* Settings menu tweaks\n* Incorrect lighting in dark areas fixed\n* Moved easter egg\n* Various minor visual fixes\n* Correct arrow visible on bow\n* Fixed rare collision system crash\n* Various minor system bugfixes\n* Ice Spikes no longer apply Pinned status effect\n* Killer Roots increased damage\n* Poison explosion lowered damage\n* Clubs no longer apply knockback on damage combos\n* Spear Troll mouth no longer hollow\n* Ambient Multiplayer stability fixes\n* Friend Connect runestone UX tweaks\n* Can no longer spawn on top of live enemies when ambient connecting\n* Assassin will no longer disturb during boss fights\n* NPC dizzy state can no longer be aborted\n* Random effect on Draugr mushrooms\n* Captain won't fail jump attempts as often\n* Lunatics arena rework\n* Level sometimes generating empty fixed\n* Spear Trolls can throw further away\n* Spear Trolls won't back away when scared\n* Enemies react to being shot with bow, and run towards player\n* Fire and Electric ball no longer only deals fire damage\n* Increased stamina damage on electric elemental damage sources\n* Bosses now have same electrified duration as other enemies\n* Captains are more keen on calling for backup\n* Bosses are more aggressive\n* Tree collider fixes\n* Draugrs heal from poison\n* Revive spot raised\n* Ghost cold effect no longer damages player\n* Cold effect makes lighter weapons feel heavy\n* Enemy falling damage increased, also doubled if cold\n* Elemental arrows no longer hit other players\n* Player collider height slightly shorter\n* Electrified weapons apply stamina damage on every swing\n* Healing potions cure poisoned status", "created_date": 1771926771, "id": "26644587545127110", "version": "0.000700", "version_code": 700, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 2}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7631852763493874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26644587545127110"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771852638, "id": "26636395049279693", "version": "0.000699", "version_code": 699, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 2}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7631852763493874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26644587545127110"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771593886, "id": "26608505608735304", "version": "0.000698", "version_code": 698, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 2}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7631852763493874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26644587545127110"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771505120, "id": "26598813383037860", "version": "0.000697", "version_code": 697, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 2}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7631852763493874", "is_concept": false, "latest
b7AQ7kNvwEKlyXh&_nc_oc=AdodOFeHZhOviK_Jiok8mBsGUCSTnbg5NQaG-8MOaboS67npWDQgO3F4csArOZUYxQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GFrSRmzxTlpajM7x5Y2RzP8S0PRwUhr-h0t6X9FpuZA&oe=6A032468"}, {"file_name": "4.png", "id": "1259841992415170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303967_1259841995748503_7206542794518160835_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa6O1MgKxg8Q7kNvwGdvjlm&_nc_oc=Ado8_BXKDYP_b0ddKqBu3e0lx9sCpJKlHZXepx55OHk-xkaWQKePPqEwqnmC8MY6pZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mlV5q-s5yJNv_CEPxnbskchTewc2-QQ3UcLnB1jnzMA&oe=6A0319FF"}, {"file_name": "5.png", "id": "1023671413271824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300517_1023671416605157_5381542366930377679_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZHisu_lAHMQ7kNvwG-MV1w&_nc_oc=Adr9nIHVjxtNd01OxcTfYUfqxubYXI63JCQdQethLNmXz-mXPxKyMPXYUmu8HB-pB3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KgkESdURyqJypgf0ZVDiSXxiMkZ3yi83mG_EWbTwQYg&oe=6A032CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb.png", "id": "677063438430812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824611_677063441764145_7109076997314994681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aovJm00f1EkQ7kNvwEmyr8I&_nc_oc=AdrAhBFOTbfVSK7PJV9k-bDzIBey6oz4PvGAhtZ4vO0f7tpkliGWCNWlBYyW1lqTB_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76JXPJWgHVyyd5bAP5Qp-EVjYajCuiGjBmYKo8_IbdAA&oe=6A031712"}, "display_name": "Crossings", "keywords": ["Combat", "coop", "fantasy", "swords", "viking"], "long_description": "**Block, dodge** and **strike** down your enemies in this Action-adventure Roguelite through an ever-changing landscape of old Norse myth. Claim mighty spells and new weapons as you make your way further through each run, learning from your past errs. Encounter and join fellow travellers or enter the world with your chosen compatriot in seamless Co-op as you push forward to find answers. \n# Combat\n- Wield blades, clubs, axes, and the Tooth of N\u00f6r\u2014an ancient weapon tied to you by fate\n- Fight, block and dodge Trolls, Draugr, Ghosts and other beings from the tales of old\n- Claim altar-born powers, upgrade your weapons, and craft your own fighting style\n- Cast mighty spells upon your foes through a unique gesture based power system\n- Defeat powerful bosses as you push forward in search of the Nornir\n# Experience\n- Brave forests, ruins, and deep caves, each newly formed every time you enter\n- Encounter other players through Seamless, Ambient Co-op or connect to your chosen travelers \n- Each time you fall, learn from your mistakes as you embark your next run\n- Find hidden stories and rebuild the memory of your lost village, piece by piece\n\nFight alone or stand side-by-side with others. Every crossing leaves a mark\u2014and every choice carries the weight of the world you left behind.\n", "short_description": "Explore and Fight your way through an ever-changing world in a quest for vengeance and survival in an epic Adventure through the Norse afterlife. Meet fellow lost souls in seamless and wordless VR Co-op as you Block, Dodge, Strike and Power your way through Trolls, Draugr and other dark beings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://neatcorporation.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Creature Label", "support_website_url": null, "website_url": "https://neatcorporation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVE
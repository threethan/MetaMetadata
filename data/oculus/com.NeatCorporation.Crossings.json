_04Q7kNvwFI6g8g&_nc_oc=Ado6c_0JoNE8zah1bLGJKr3qQ1q-fBuXuPG7V015Ou0U3HUtfmv0ZY9i2B0UoKJSWTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Row538ql9M5T9CnxPUhn7wURUfhcxJWu3nCM7dCpNqA&oe=69F746E8"}, {"file_name": "4.png", "id": "1259841992415170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303967_1259841995748503_7206542794518160835_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca5RQXvKiT0Q7kNvwHstsIu&_nc_oc=AdpK7DmjcPhn2CrRgiiIdR4935gsqdvGpNQvZwWJNK84CLVdeCAXD6FUHL20Y-x8tro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IwoBi8pBtBU6HlvpDanLfWSP2jjFbQIe8Y0G9uFwEhw&oe=69F73C7F"}, {"file_name": "5.png", "id": "1023671413271824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300517_1023671416605157_5381542366930377679_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qe1eJsa8eoYQ7kNvwEtky_Q&_nc_oc=AdqkWlYbf66Fns-jwtaW3bDSvK_XqF7h9_BSjUhU354WuyYQMrZNMtoo6KGbOYY6HkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0j-mZ5Xj_-RjOWvHexK8ELypVEwR4bEZAG_ojCCG15mQ&oe=69F74F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb.png", "id": "677063438430812", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_677063441764145_7109076997314994681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTutVLpHZfMQ7kNvwFuFuQp&_nc_oc=AdpdWhjiUb44YQgFC1DWewwL40i2lTuagJyDrJk0GSyg1gRlRhnaIpUar063mgynekM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CemxBKKi__qIZAfe6BgMIl3Aar_DAzPPXaTSDai93Ig&oe=69F73992"}, "display_name": "Crossings", "keywords": ["Combat", "coop", "fantasy", "swords", "viking"], "long_description": "**Block, dodge** and **strike** down your enemies in this Action-adventure Roguelite through an ever-changing landscape of old Norse myth. Claim mighty spells and new weapons as you make your way further through each run, learning from your past errs. Encounter and join fellow travellers or enter the world with your chosen compatriot in seamless Co-op as you push forward to find answers. \n# Combat\n- Wield blades, clubs, axes, and the Tooth of N\u00f6r\u2014an ancient weapon tied to you by fate\n- Fight, block and dodge Trolls, Draugr, Ghosts and other beings from the tales of old\n- Claim altar-born powers, upgrade your weapons, and craft your own fighting style\n- Cast mighty spells upon your foes through a unique gesture based power system\n- Defeat powerful bosses as you push forward in search of the Nornir\n# Experience\n- Brave forests, ruins, and deep caves, each newly formed every time you enter\n- Encounter other players through Seamless, Ambient Co-op or connect to your chosen travelers \n- Each time you fall, learn from your mistakes as you embark your next run\n- Find hidden stories and rebuild the memory of your lost village, piece by piece\n\nFight alone or stand side-by-side with others. Every crossing leaves a mark\u2014and every choice carries the weight of the world you left behind.\n", "short_description": "Explore and Fight your way through an ever-changing world in a quest for vengeance and survival in an epic Adventure through the Norse afterlife. Meet fellow lost souls in seamless and wordless VR Co-op as you Block, Dodge, Strike and Power your way through Trolls, Draugr and other dark beings. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://neatcorporation.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Creature Label", "support_website_url": null, "website_url": "https://neatcorporation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVE
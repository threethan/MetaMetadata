.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dCC2_NPkf8Q7kNvwH7dplN&_nc_oc=Adnpahm4R9tk0FuE9Py8nCAlG8XNzqd-c8hC0rIKs1K0sZkK9RY1LBSxsoDHm9Nc59c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZyqYJnYJvM7P56ICYzbKjF6Y8uJk6WOmfxuwJFH5R_A&oe=69A97821"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yvfADeXPisQ7kNvwFzWnxJ&_nc_oc=AdnXyWVqP89yEvhDKPjc5zXyYrnCFY0NsOcDjLZNSf7CfGo9nD4MbDIINAR7UabNTqQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfthtXBIUkMTxwRuKMOiivyndXdCJGypkBcgc4f5gMjHSw&oe=69A963E0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxyY3rSqnNYQ7kNvwFLYTHi&_nc_oc=AdneR68_05AlDn9lb6hs8bOIiUbYH758ZgKjRSeHhAy8_e1HH2JCnGwikEE8QbU5tRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftC3TBdZVg_AWIlZDIF3c3azAPRna0QfSNcEi6sJIogag&oe=69A9703C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R-JV9qP1EQQ7kNvwGDeZbD&_nc_oc=Adn6QkKRfC8_f_FCYwQmrFm8BxBKmWLBeLIRPdALmDWK-rghG1fUq3qw4rxBahK3zW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_nUYO_s305TlB_LYjA0vwssYvp2lUOLydly8gDdCk2Q&oe=69A97D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6skLXZbdyF8Q7kNvwFi0_sH&_nc_oc=AdlTe2JIzp6MfqPkb3ivSKnfC7_Ya3xa7TV10UdGI8gTCO0oThqhRDWRp9Ct6guWcoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft1C2EOg09Dk5p24UAAJ8SQQZ1N2oysEmtZjDzAIj8FuQ&oe=69A97BFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCA
ntent-atl3-3.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH1a68XGaCIQ7kNvwHNxaFU&_nc_oc=Adqr396J_GoxnQrXOSoFrOPpAdcI5pBPW8w3BAM135MWYCouIv7GhVL8YrA_-wc2SRM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSqO3q_nkIvYnhlQNFs1OzJOAbK0nsLdUrkeKaoqCAnQ&oe=69C3D621"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpmn84F6zRkQ7kNvwFDsd7p&_nc_oc=Adq5x1hotrqiY8uWfam74bXkaBIvmHNaWbtfrK9_po3iLZQQxF2dEAcViVd0z_LBGwk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwTHmX998QVQqV7Qk8NaUeZv-H-yaYQ11FgkTGo68cNA&oe=69C3C1E0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGMFfgJe4gwQ7kNvwFXpoHb&_nc_oc=Adp_9wNENxY6w1CGzPKA177HPNYwfWVOBTI3yj9ySk6droWnrHs_g5o3X0Hn8gBKSJ0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGDEKN7vB0GOOCyseYj-A-gTeSj6pmKf48EYuIEY65kw&oe=69C3CE3C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cO9ElnSS2hwQ7kNvwEAxUm1&_nc_oc=AdoMuPdHg3lFv-olk2B8YXkTxpGL5Q0ErljGifn8MPOHFHzxkhXk2MKmiGiieC3fVWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRmyeHWcsD0XsIm27ZSnOvymy1RA-MYyW-q4eGSYKdLQ&oe=69C3DB96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM9-v7UxarEQ7kNvwGxJ9sF&_nc_oc=Adq36gN8MyD70M4oV59HpRBLw5Q2TtvDnQcuFbd9E1qrm7kCubqszsQs4v3yoRYtfEU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZ5wf0CjHRT9wBw7pTviQpyKThx_GbnFMxVcWrBfdQQw&oe=69C3D9FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
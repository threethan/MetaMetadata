=6AB12421"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwfx2KfkzysQ7kNvwGWQqLI&_nc_oc=AdrOnC9HOp3FZnLvwee9IQph07Fgbe3U1np6kgjnpI-K2LEEuqFLtlWVLTa6rXc1gSo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx9R02-5-z7RyzOe6oRzfHELb7SxrOvUsGNJ6IELhPxw&oe=6AB14820"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rISdgSECxD4Q7kNvwEuVZx3&_nc_oc=AdqWQuZ1KGnD7VHGVyuQhQwJm35x4UC2OZ09C3CW6rz8cdKad0p2OrRk2RLc6QkmxR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYx_Jj0VCcRCNzZ05SifOd_Tv7Z3MfH1NI6AXK8X-UOQ&oe=6AB1547C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SHZ1PL4V3MQ7kNvwFw8fRU&_nc_oc=Adpc9pT9NLKQz5yxzNZPIXtLNRkSKjolfJDfrKgriPHd_UNWL4hl5fePYexNv6W1p8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaTbYLUvh9qWaBCDIR2vjmM-TBpt_U5DxY1pJ6xHUeSQ&oe=6AB12996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SblgoeeUvzUQ7kNvwFjfSHu&_nc_oc=Ado5X4nu4LI4xPnT-9bd1d0bXuQLDmjFADTKq3Qon4iBGpKQhXV2ifYXONbcrLoO8Ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmL2_65vXHR0J9K4s-Z9K9W7dZlR7-8_PtiltQWretgQ&oe=6AB127FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "DON'T PANIC!\nEven if this is your first space flight, it's ok, the ship will give you instructions, it's just that they might not apply to a control on the console in front of you. They might be for a control on a teammate's console so you will need to tell them, quickly, and probably loudly.\n \nIf your Spaceteam can complete enough instructions successfully in a sector you will progress to the next, each sector becomes increasingly difficult and as the ship becomes harder to control and eventually, inevitably, you will explode. \n\nThere are 3 ways to play Spaceteam VR:\n\nFULL VR MULTIPLAYER\nUp to 6 players, connected to the internet, in any popular VR headset join in a cooperative game of trying to avoid their binding doom.\n\nFACE TO FACE\nUp to 6 players play locally with at least one VR headset and connected smart devices, this offers an experience much like the original Spaceteam game. \n\nSINGLE PLAYER \nIn Practice Mode you will join 2 of our trusty robots to form a Spaceteam.", "short_description": "A chaotic, cooperative party game on a spaceship! Shout technobabble at your friends. Attempt to follow randomly generated, incorrectly assigned instructions. \nWork together\u2026 as a Spaceteam!"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SOCIAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
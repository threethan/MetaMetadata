ntent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVV6fQSXBigQ7kNvwFTts6a&_nc_oc=AdrnnkJEsRFrmyJz-_IeSGXfyfdqlnwseZRxLqZtA69NdKk2o_F7YraQuasf47NYPCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYpX2dNbwIr7fxVZplJZ6uuWG3z1uI0yBwxk53oOLWnw&oe=6A620A21"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_4JrTzaEPIQ7kNvwFcoASX&_nc_oc=Adp1NflodjhN0XPklZDJUFWeTAYuTmZEAwEj8rxqPRN7Cn5CYCW8XAPxN1eXgNkBso4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQEEIEi7yIX_i-qxZSPtg875peY2Rg2EItzDIaG-un3g&oe=6A622E20"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r3FayDWcpMQ7kNvwEk0wq0&_nc_oc=AdrNaPTr4LyboxLk8QNyjnmSjecz0xs8HOsb7A7TA7ZfkaEpuWcdnZ7ol6q4BNpA_zo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUZAucL4mgMd6u0KACzR-ZxVAcRqHZ700ZwAIPVFJq_w&oe=6A62023C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m63lBn4xidEQ7kNvwFgeN6R&_nc_oc=AdpopHrmjRr8kewAwZtdMiy8lSuKnbMjprx0S2bnuzkVTWe_Xm_kvEk5t_ktXg1fEgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-OF_KEcfuHhoahSOJbcQ25bccbqnaqSImW5WfcWh1Fw&oe=6A620F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jjOPxAesrAQ7kNvwGUYSeZ&_nc_oc=Adoxra5mQS8h50t62yyI_PjSANYPoU4Vqs01efooTmrfebcNNZ06JNuyTSvsRlw0lVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDbQdf_iSRx2C99543_cPorYPrgvH6SJpDRYSHQjyHXg&oe=6A620DFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
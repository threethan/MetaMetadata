_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxKBpBU-Wl4Q7kNvwEN7ZBK&_nc_oc=AdpC3w57t0Z9QTrKJ4z8IzBPlBdELnl6sf5avGt5H_Hs_XStXp5oCtvZftmcnwU1TcM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0avu95Khq1XrcaObc5Gt7E4RPjrCzJNYSvcxmFkik35Q&oe=69F1FAA1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUqrj-zAvSUQ7kNvwEScCec&_nc_oc=AdqZvHZitNbLN1QlvaSRZXI-3Md3RVSArpCaGcpMBCgP-y-ElCdmzvBNtZ4is21JHo0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bGKfpQ2btjVf4dls1P2FTsvYRFgC7We2FawTWh24rrQ&oe=69F1E660"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfLt0pN2um0Q7kNvwGCbQl7&_nc_oc=AdogKugBDa2iBvNJaLdAlURRdaT6cDf1kTE_SLSSRuvYeSPpMP4pRukCYL3qevTEieU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3ZVglDx4tLu0k5SKsYkuPIUbe8Y95qg2lQBP9euX2mgA&oe=69F1F2BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kZUId48794Q7kNvwH1uLNq&_nc_oc=AdoErCi3ny9pMqm2G2FOY-YkSZRkZBkI-9U_GMwOTupQFXMRJUAnwHVbSRWT5FfHMeQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06dw-tjQ-PR341F3K_l4PHqWgZWOB2fKsKbdhs29ArgA&oe=69F20016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-swqq7PxDXkQ7kNvwFoTp0i&_nc_oc=AdpHTLhBS9-qamwDfUwjdRU-28gSrWCFIQH44rTUqDmCIAEe6lLJDBY3aK6lAPdD1_M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1SYpin0C1DU57BSwO2WgP3Pch7haK3OzAeGGs4S-yECg&oe=69F1FE7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPACE_UNIVERSE"], "has_in_app_ads": 
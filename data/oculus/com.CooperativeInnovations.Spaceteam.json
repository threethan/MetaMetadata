ntent-ord5-3.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pesvHEIZyNYQ7kNvwHVx3DM&_nc_oc=AdrXXQZ-iXnkoCPnSao0rWpDWhN_v27vpA8uQz0jHKHB-ZiNf-88coGe62HLu2Fl7SE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af442WYCsEdYiMVM5nuQYiuYDpL81w9prWynOIwSxjhIvQ&oe=6A1D7C21"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6wKiodkCxoQ7kNvwFqSbzz&_nc_oc=AdoDiKQihQZj1FPD3jywIFPzARrjI-BRhF22fCsAPyRbamA0oDaNyBau-bLC2DQbS3Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af623ZZu3OaIUTRjoEzN0VN6gjTjDwxXxj0DqroabNMGuw&oe=6A1DA020"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcUsTuUjuMIQ7kNvwGdqZ7P&_nc_oc=AdptuuOdhSfpM2CyAfu_ekGJXcE8hp5wPwA8XPzPZNW0H1Gx1OPr_gLkmQePmrLd2bA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rfj882PCnFRk3Pz9Mv9H6-ifWm1_ui6WFylxTG8RS4A&oe=6A1DAC7C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aap17-jk6EQ7kNvwE0Zv3r&_nc_oc=AdqObtNu6oRXyK-Uht8ahbgLqs5DrNep9L0yLk3FdNMM5xvZ5E1L0YLkOzyJ6y3oOVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YTtR6rtet0L8eNwHKVuQywGIkoVRBWkdLkZFkwBVuMw&oe=6A1D8196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md5pfbqLFDsQ7kNvwGOdGS-&_nc_oc=AdqEMyz3q8jOTrgWmkQgSQu7v2qveltYUPOBxkm4oOqGzZ5qnJV7_WwANkZIjDASle4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ypOeWbyem2_p5UwEQ-MEzVSDLfeCbTp4VcgUjRFIxXw&oe=6A1D7FFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
ntent-qro3-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mk-ACxu8PkQ7kNvwGNH8Ch&_nc_oc=Adrt9z6vN8HikV5JwuTcJ35uKoOn8JKmYumjykVZw3d_ACDQ56ysFDFQx3DtoZtdPic&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe_rr41RY-aojAQTcrv3ouCvQd_02cn3vRxRPwT3w1rQ&oe=6A942321"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPV-ESZBGBsQ7kNvwHLondQ&_nc_oc=Adq0aATIE4-4LhtSFEUpaaTqeCzidfgwNARlo_DEwxug-WDxjZwHXTJkPt6HvDuTR20&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSXbY5LP3pyyuUvm6iGu5UKVzgWLYZaftGHosVG2dvQQ&oe=6A940EE0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX3ZGwccscsQ7kNvwEThfJy&_nc_oc=Adpw78vpXzwhVacb2tzfr5GbFp3A6Nu2JZi_pAekwiSuHTlXyl14P_kRwb0AZzaKtbw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Pgvb3t6I8uLMOflvA4uyRwXDs5J-VvbG6lm49FCljg&oe=6A941B3C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cKEpJBIx5kQ7kNvwHUNijP&_nc_oc=Adph6_FptyxYGd1zakqyVGo68XkDcbuWeWyOSIztt5W5l361Phk_lRotlABEj8eZd_g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAoONRBOR7S5j-5whAV33JVTOCFZOW_x3gdskwhmH0kA&oe=6A942896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPWBCzk2NlYQ7kNvwGQWa9r&_nc_oc=Adqf-Z3WN7kuvIRLnJWuXEtUCdqsq0d-WW2ELfl3jv2b9x4V6-nWpwBgxDGjLabCvoo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqeSQxh_A3HI4cKnafSXIxF1RJSQ8d95VI_i9G-fnZBg&oe=6A9426FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
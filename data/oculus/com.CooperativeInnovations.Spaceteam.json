ntent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIYkZSMzjIkQ7kNvwEFW7YL&_nc_oc=AdqRIP72Y1YKmUKi139bFBWzQvPoYC6hv0FX0Cv6jGf53AnMHqqFYMY_QNeX7Ysscqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N4Y7JQlsKs1z0XzLjdrJyXwlNR0dEt1agnmnvnz0R7Q&oe=69E8C021"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu8gl9p72yoQ7kNvwEGG6NM&_nc_oc=AdqOgK1VBHLVDrY1OQOqERj9dPHwAmrDLFxKPVf3fDV5yH07mUSbBMtM2Yc3QOz4IhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IFqBtUHI8JTQ5FATFuK-xoy8FRg-OvkMx-plPknoFmA&oe=69E8ABE0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEPsGZJlWU0Q7kNvwHQlIcJ&_nc_oc=Adq1TuovwFuSCGVtvlqov_VEnBsIoz0MrEz5tNBo_fLCf5e8xb7sVeIP1bieYrKYokQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R6lhSmcHrGs0Zvw6IgVohN1UnzYGLvD7h9VEnyuzTuQ&oe=69E8B83C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeD-1USEJ1oQ7kNvwEqisOd&_nc_oc=Adqfp5a6UyYXcb7R33pjuyFOpKVe45a6dvvt-CtLC2bio5678EQjXsaQ1rwiqoQIzpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34IC_nIn7zTOiz3JgihbbfQD_hy7lOk8g72rbcOYg1hA&oe=69E8C596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1U0lLOnnAMQ7kNvwFW7CVI&_nc_oc=AdoA50OoQBiNgAmbqSr1Mif_ROE-2J7uNjbmprkEmbyTLEL2CCA8b_EMmC4-gejsfZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ay8RW-dKim4QwycEYicj6A3pv4E5UCqWMIpODJMbhCw&oe=69E8C3FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
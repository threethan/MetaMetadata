=6A159321"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPsKydZGxT8Q7kNvwFQflfV&_nc_oc=AdoxWFd_sWUYZotzKzPXJlGfBAntamcHe_ZL8qKBB-V__2eyMrTAXCaa5GfrfuWDsks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w6XPMrN57TDdOEYQzYMORhFX5SoHJWYUsTDARPOsG9Q&oe=6A15B720"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8BwAhbPbDEQ7kNvwHPY4aU&_nc_oc=AdqZ80aQDCPluCZjHRmzgOc9PyLoRQ2jdQPCHECAHesa4aScPcgAn3RAZaM8Ybx8y-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42PE1Nzyq0Fxi4VM5yuStZoOm4d0QV53EDU-egRWfjpA&oe=6A15C37C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XImnrOSlJWQQ7kNvwF5cTvY&_nc_oc=AdqqGuuU4kLiLC43zHf5J-Clf4qt8gL7YLyJP1z1CYfRzhUapEcFpn4ymPDKkCtmKIc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QqAE5CIzeENRjhNAP7VV7YiMa-u1OScotbimQr6irwg&oe=6A159896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRPsqSiEp04Q7kNvwF8cgSH&_nc_oc=AdpvQzWFDBY0GVDBkbyDPt_rVR6byxHlKKJ7CrtFNUeLHWBgH5L1nOUTSL8l4qxHJ3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ubd8hE-J3zScLJ57goGSqNPNbw17gk5TboQY8Tv7SXA&oe=6A1596FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "DON'T PANIC!\nEven if this is your first space flight, it's ok, the ship will give you instructions, it's just that they might not apply to a control on the console in front of you. They might be for a control on a teammate's console so you will need to tell them, quickly, and probably loudly.\n \nIf your Spaceteam can complete enough instructions successfully in a sector you will progress to the next, each sector becomes increasingly difficult and as the ship becomes harder to control and eventually, inevitably, you will explode. \n\nThere are 3 ways to play Spaceteam VR:\n\nFULL VR MULTIPLAYER\nUp to 6 players, connected to the internet, in any popular VR headset join in a cooperative game of trying to avoid their binding doom.\n\nFACE TO FACE\nUp to 6 players play locally with at least one VR headset and connected smart devices, this offers an experience much like the original Spaceteam game. \n\nSINGLE PLAYER \nIn Practice Mode you will join 2 of our trusty robots to form a Spaceteam.", "short_description": "A chaotic, cooperative party game on a spaceship! Shout technobabble at your friends. Attempt to follow randomly generated, incorrectly assigned instructions. \nWork together\u2026 as a Spaceteam!"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SOCIAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
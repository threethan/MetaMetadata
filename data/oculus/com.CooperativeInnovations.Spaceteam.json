.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cYyoFEuP5oQ7kNvwFf-mPp&_nc_oc=AdlctVvGmKInbL4GhvabnRMp8bRoUT-uu2ybDJEr_SHeBa3d8i-GgsHCecS4qp8ylNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzjg6aURZANH3btDfLCmWw2EX2w-6pqpdIiNyIDuou7kw&oe=69B00FA1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deK7TrNAVJgQ7kNvwGT-rac&_nc_oc=AdmxV46Rs03Ev4yfAcfrT16OVsFTGTbZ8wxHMI9XRLtDrVgUAwoGn82VNQVPgwsdB9A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_a4BhAYZcZ8W2mOzdRvXVTLC8VBdaFMC6Cnlw6VWRLA&oe=69AFFB60"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJbsoYzYMeIQ7kNvwGA6-1c&_nc_oc=Adn0ohae-BVPDugOFIgjVvKdSypldU5WAqx1gqrkZimxP4_B9ofbZuRVMupC2dlbiS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkeuKpbljmQPiPwdAy9Ld4MWoh5M5LMJ6N1kzKYKfr4g&oe=69B007BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8v2EkWTh5A4Q7kNvwHzOgee&_nc_oc=AdnCJZJB4VoRT4Y55F3Gz_UJZPR408PqkyqQxRpHoCNvub6OdT9Luob0vJrHKTkgV0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9nq1Q9bkfzaG28xy40SMuN6whKtfCaKxPBLnwHkaJtw&oe=69B01516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbbr0Sqqw7cQ7kNvwEMO7QO&_nc_oc=AdkmRDgXH-K8my8LJjSORK1mQsCjr0TCHG-bTezTxP2hLAzOmvfHkhyFg7CePhzSV1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYTgsKLc4ZjX3LmdTdoF-xvGMIw6neBIyD3ry7ixSF5w&oe=69B0137E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCA
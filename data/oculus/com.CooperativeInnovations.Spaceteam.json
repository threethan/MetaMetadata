ntent-ord5-3.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25ydjmX-HB4Q7kNvwEdlWyn&_nc_oc=AdoBapbMIn3jv0cMgGLaIkeSbBuIT2oYRJdvQGH2qHPYUOqyTiNfuYApSXBVDrHhsN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PPmXsusd8oJ7fHMXlmd31D2CaZnZYAaSrrDoa4856qQ&oe=69D4F9A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8lB1LQpNPwQ7kNvwEhYp4P&_nc_oc=Adq0CqB2AQAvsMMFEe8Zws0ZIyEJTwcX2cYMHr-aS_ncfpNJHTkrrgMePecLhBRdIng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mqTCjVaCx9UXbJzykUvJB0p8aLjEfju8FTQ39gMuFNQ&oe=69D4E560"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuruTwV0PIIQ7kNvwGhOUP0&_nc_oc=AdpMQySyQZZ7IXMMg883uAAq5OKsbr9Ne0HXSdAuIJz-gIipMGZ9Qb5Eh0jLmSsLFBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kJ_nI02pwnNEKM1pGl2E-FRayLGRi9Ah-K9dG1s7NTw&oe=69D4F1BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI685LU9naQQ7kNvwGHqyjc&_nc_oc=AdqZ-dwVFC2WABjxc_r7CHU-4WXWbFdYRZWXjqqUjdHhfgF7duyf8H0wAq1PcdBXKrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nNIq96ILtVCe_WRiPJUgryJR-G1uUsQXpDd-9W9HtFw&oe=69D4FF16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qkP7mMqAawQ7kNvwGnaNb6&_nc_oc=Adrimx00U6IQNg9eoBPIkbC7Dp7EdJqrpJne3lNEx2WfNV0-L8A5Qu-SVEmPz7ow_so&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pLAsfql49KxCg8iUa-0GrB6KCFL72cpKLCQn9XjxF9Q&oe=69D4FD7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
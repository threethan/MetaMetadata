ntent-atl3-3.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ugm68zLmIgwQ7kNvwHrSLrG&_nc_oc=AdoyWhASFId06PFEu0xYZP-Z-E-gPlSK7KnAztVCWjBxRvtP7YA9FIwUx1f3TyDQfd0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kdzS0HcEm-tF1RtGZsByLb-bmN5NiNzDZ7kjwhhy6sw&oe=6A2170A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QXLe7iofecQ7kNvwF-QYR6&_nc_oc=Adp2pNNT8GSo2U1OZs74D5S2ZpgDYLD3SOLDRTKcxz8ORVIa_Nv25ZC5_CtMoXhO-hw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B6tMLJXRXb3Lun7hwYdhGanJf0PkuOdbPkJCYubxoCA&oe=6A2194A0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi_QXqIIotIQ7kNvwFW9rqB&_nc_oc=AdpUhdDPg1UB_CChyTT9woOhJBaZXR6aRReYQ7UFjuRQDDCo8z7eRcCFkFXbo6QgMb0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hIIV7fdGI9Q8Scx_oQbQPw7kThQvSlTUBuXKDPO2qBA&oe=6A21A0FC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYeYMUObMGQQ7kNvwH_0vhN&_nc_oc=AdpoipOm_fyuMxpgzpopiGMYbCEdyUr14G3gEFljSmoMR0ycab3jzIasuouw_H9J7ho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3e1W6ycFt6i-f6F4S2Vo2Z-0xHt8NiCG4FDesAAjsiQ&oe=6A217616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol_9iikKS_oQ7kNvwE00BcI&_nc_oc=AdpqxZP85Box4sE2-4XUPKmpnFTPcahzfdb_gW9N8wP0cdJ5nqcY2Jri9-VvxUP0gwk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6UIRgNX5EjC4IT0Bv3M1ZGE_TLbP38iwPgSoq_LeKUg&oe=6A21747E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
=69E8C021"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu8gl9p72yoQ7kNvwEGG6NM&_nc_oc=AdqOgK1VBHLVDrY1OQOqERj9dPHwAmrDLFxKPVf3fDV5yH07mUSbBMtM2Yc3QOz4IhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IFqBtUHI8JTQ5FATFuK-xoy8FRg-OvkMx-plPknoFmA&oe=69E8ABE0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEPsGZJlWU0Q7kNvwHQlIcJ&_nc_oc=Adq1TuovwFuSCGVtvlqov_VEnBsIoz0MrEz5tNBo_fLCf5e8xb7sVeIP1bieYrKYokQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R6lhSmcHrGs0Zvw6IgVohN1UnzYGLvD7h9VEnyuzTuQ&oe=69E8B83C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeD-1USEJ1oQ7kNvwEqisOd&_nc_oc=Adqfp5a6UyYXcb7R33pjuyFOpKVe45a6dvvt-CtLC2bio5678EQjXsaQ1rwiqoQIzpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34IC_nIn7zTOiz3JgihbbfQD_hy7lOk8g72rbcOYg1hA&oe=69E8C596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1U0lLOnnAMQ7kNvwFW7CVI&_nc_oc=AdoA50OoQBiNgAmbqSr1Mif_ROE-2J7uNjbmprkEmbyTLEL2CCA8b_EMmC4-gejsfZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ay8RW-dKim4QwycEYicj6A3pv4E5UCqWMIpODJMbhCw&oe=69E8C3FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "DON'T PANIC!\nEven if this is your first space flight, it's ok, the ship will give you instructions, it's just that they might not apply to a control on the console in front of you. They might be for a control on a teammate's console so you will need to tell them, quickly, and probably loudly.\n \nIf your Spaceteam can complete enough instructions successfully in a sector you will progress to the next, each sector becomes increasingly difficult and as the ship becomes harder to control and eventually, inevitably, you will explode. \n\nThere are 3 ways to play Spaceteam VR:\n\nFULL VR MULTIPLAYER\nUp to 6 players, connected to the internet, in any popular VR headset join in a cooperative game of trying to avoid their binding doom.\n\nFACE TO FACE\nUp to 6 players play locally with at least one VR headset and connected smart devices, this offers an experience much like the original Spaceteam game. \n\nSINGLE PLAYER \nIn Practice Mode you will join 2 of our trusty robots to form a Spaceteam.", "short_description": "A chaotic, cooperative party game on a spaceship! Shout technobabble at your friends. Attempt to follow randomly generated, incorrectly assigned instructions. \nWork together\u2026 as a Spaceteam!"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SOCIAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
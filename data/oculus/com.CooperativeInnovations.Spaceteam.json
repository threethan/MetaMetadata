ntent-ams2-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hbfVdFM1ZsQ7kNvwEZMA8H&_nc_oc=Adr2-qtXD5FQbzAYDX9PdZyN8BbQ2JTjWtGLU8MnGdjvCf6lSBu_whYRxA0LdP6wDOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96Y5--9MHX6Ushwa-qWopo_K13yMhWnbt4UPCnD_qRQA&oe=6A3142A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Un1-fctfm2YQ7kNvwEUKwq8&_nc_oc=Adonk4yXSPNn4BvqgfcLfipNsQKfb6dOySIQpDGg75YRxLT555OuAc-sCJvsZusgmAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95VyevNUjRi4Mi79aT25tbP36juUV51G2klzeEIPM3dw&oe=6A3166A0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvz5WqF3slAQ7kNvwHVEDL1&_nc_oc=AdoItdxYQjB2W6PJkJ3ioDi8aNGjL9RWFe5QYqwLkzDKCH5f5Gb95u0ztRLcPxmx6OE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tklP_PUaTWTAmbidcOec-joUvfEeZTlHTRJqaNWrJTQ&oe=6A3172FC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVFzKew-1bEQ7kNvwFQGz62&_nc_oc=AdpFu0d5iD4A7GoPn5tH_jA1cRdn4r_Y7LZGqLMplTNeUoibkFkTLSVax9dTwIdDfyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yjuWvt3_A3EgpWeR6TfBO_S7K5PpN17Qku-1DOuZXzQ&oe=6A314816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hmRuh4-ClkQ7kNvwEtR1E9&_nc_oc=AdrRrKXq6XlolZ9j8zd4tnV_DoleSQwadi-Rx5apGAONS-fM3d9NvSVnhl60I_gzNBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G26_669vb4_R2jejaxRGUstwBtricv--c_iztcdLm8A&oe=6A31467E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
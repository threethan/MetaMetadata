ps://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sQySdRqM_wQ7kNvwGNTDOo&_nc_oc=AdoIfM32Cpu31qEaKSqSFgcMbEwZcUFLwyEHKSLepNiiCyyofrnGVhfA36pPxjp273g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-GWfDvVXJQ1tpAtcgeuyd1jGWbN_FtOGXcC5qkOsI1A&oe=6AA93B21"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hMXTP0ah98Q7kNvwEfKzxv&_nc_oc=AdouEhau9iH5jH_obtMfaLuQ1YGEQfaDEoLy6lz7vLCRZtYxJ4PhaTfsJh-vACVSO8U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID9gowATHESgWrpoNT855zrgJHmvX5eQ0nbrdLw7pTgg&oe=6AA95F20"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvRUMxU-_ZcQ7kNvwEZA0NG&_nc_oc=AdoM0XGppe03NK17aZ0nnNVzpg4GoKqdIzz8K5gcvoix5vyumfeE0qpUAk2jvqT2qEY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyHZmeIB7fAd78rRZjNePYszGou0kjsludnogoIErcww&oe=6AA9333C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io7_lK2aCdIQ7kNvwE3lnQn&_nc_oc=AdqbIruG-TP-rH5Shew9lVhh5dJ1gIDLYHMkhJwumIfDTsn1faJCPD-WPmWj95mTFww&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOmcV0DiZAY3SXU_ARLxc45fC2iQQwpZ6rxJVHRpvKKQ&oe=6AA94096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWzYlQvD9C4Q7kNvwFB4PT7&_nc_oc=Adqt3baU9ljlXLndqrqx6_1JWriclKH_KG6hETRLHAR9bMmzKrs2kn9pi7UZnCBbjTk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTgPQXA2GRJzO-OQOzdLaf909SzoM_rnzYyKgoJfK9NQ&oe=6AA93EFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], 
ntent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OISFvkjEDmoQ7kNvwGEUhqZ&_nc_oc=Adpg1NDgSnMzwqPV4WaBQygYaE-jKHtGJq9HImpFbDshJ1glUZ9tU5B4ltsxzTR9Pxg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GMIQy_mCzh0MxrU1cfHW-Vf3Ukcos_qxqWxGjBMwLXA&oe=69E228A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wvIdUxGs3UQ7kNvwH5ICl5&_nc_oc=AdokGdUzMpqQlFviwu5fdd9WROrGTDiXfYoKU1mmzwICQpRkRwwUp5VaAhQVIS7oehw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ppnoW7pjIJNsfCOQr48ynq1qg4j8mIJX7JZeYo9hoDA&oe=69E24CA0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2fEbiaF_nMQ7kNvwGAfspV&_nc_oc=AdpjpZwKRnwri4zmXJ1gA_Wlj80otCla4qfUbQ-GRj3C6EE5uoq_yfIyVAU16Gn5cjU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25p-U-Q6AoD-D8eVEZ3Nl8HRfGxYUxrnEc-YG5yNVQrg&oe=69E220BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5plpZuj0TUMQ7kNvwFWryAP&_nc_oc=Adp8r8JOItgWzT-Y1R624qhMfyem4dAOU8eCHS-W9Xbd1ZmQGyXo5h5TyJD4uF7u7K8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UY_DmxwWfVDE_NofHHeEJIeZuCSCuxyN-64dONHGTWg&oe=69E22E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqQCrVOeJAwQ7kNvwHrLkTF&_nc_oc=Adpk6J13NvZfgRZ_7ap4CVzwLQD0nkbntjdnhlB3QbPdBtFUUCLUiYRNFUGm2i1oq1U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1urrh084F-Pbx2hv6JL_k7qXui8L4kOApVlPCvzzVkXw&oe=69E22C7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
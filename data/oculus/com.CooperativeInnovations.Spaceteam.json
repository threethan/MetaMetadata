ntent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxKBpBU-Wl4Q7kNvwFy-6L9&_nc_oc=AdoQmUQM-dcz9J20fTc4eGojlcVm9ToM-cn66LDH7OsdeNk-2Ponf1_Cuewa4Bl1_Jg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SNIIIWlc-HgTBSee3wKSSfZm6B4ltessvAU3D_z03_g&oe=69F34C21"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUqrj-zAvSUQ7kNvwGBDLEH&_nc_oc=AdrB7eyDgMqjSY5qxihrgSO7d1Je3eT03LZMBPm-MXqYLM-I4YelZcsyAp-0Yc4nONQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GiRecdipgyudNqYoT4zB2xPxQK7XsOKWl3UOshqAp-Q&oe=69F37020"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfLt0pN2um0Q7kNvwHYxT1v&_nc_oc=AdommfMvN2xk0Hn7ioMyKA-JNU9kCQlvM_QFNIWevpzPQ8OrBG8mdIwLbyPB4WQaN3k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cD4D-Xk51YYh5Ab0kb9qZPc3PCEJEybsjP4FjFMO7aA&oe=69F3443C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kZUId48794Q7kNvwHhvp7t&_nc_oc=AdoBQncs2fxrPjl_0jkobYlySWfh1ac3Cy0y0AWY7cfdK-TQPSkn827UPv_-Bp_CeVw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3AcABs4UrIWizAzqhg69N6A4aaLtyuE8fvoaM6esAHCQ&oe=69F35196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P296r928MtUQ7kNvwGt2HMi&_nc_oc=AdpsFECBHlcU3QnxpJsahHydleYRa9Gf-CHB8-kTA4IRwNYQzGtwlQVYo8WkzNkYmkk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WIGlXqsETl6Vnf170JzttNFOjhXw_2R_yhrsbO2LYOg&oe=69F34FFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
ntent-fra5-2.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cf_-GQMQ-oQ7kNvwHxux3a&_nc_oc=AdpZT0_CcWuTz6xFfnSRhJTMaxl3tdgUqTv1McldkuT_u_YAhtb1HL46QE1OgR83Skg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ypqaCWCBnqt5RVROA4qzMB4oZ5LmzLUxSOSo7QdopLA&oe=6A1AD921"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVANWRl4ML8Q7kNvwFC4iPa&_nc_oc=Adq2N54vqxh9qjqa8XFTDfIrIUEP0vycvutMkFYDYNqJnrT0Lq7jyk2EWl6i1iWM_AY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VtuRE6DPuk8lWrKw9U0MyVNT8VWFYZC-YZq9gVxp4-Q&oe=6A1AFD20"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucMx-Hu0Mv0Q7kNvwH790Y8&_nc_oc=AdqpCBfnP_3R4kDx3FHsfL_Wg05olFif4MMnUEIHJYjk29NiVK-Q-2F8jZ7anscMJfs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DQRC7NChrO2T5KKNHpMjQRPAEFywe9SGiyrEOZTP2hw&oe=6A1B097C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-urwGWRITP8Q7kNvwEjSVZV&_nc_oc=AdpoPWS_qPiwvBoir0KNCnuDVxtoA7Z9N7vBmpPUiTnnLiwUnDk16SmKTz8bqyiB_Dk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MlwS3i3o76bcl8WVAffhqSPmdin1oz-t_aKPSlNEWwQ&oe=6A1ADE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md5pfbqLFDsQ7kNvwEmr0Q-&_nc_oc=Adpg7Ar34ZULVKSasyU1fRlJYZkw9AU5qmYyx4MXqqzhRpTXtZGs02z0bnGyhExqwA0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PlkHB48kFVZsT8rsfuVQWXRh8fuA_zgdOak_f4_5VOw&oe=6A1ADCFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
ntent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvSnM1bb_5AQ7kNvwF9syQN&_nc_oc=AdrN1SUPvYZazKCx130c7qdNPogJ2YcHsi9xO5ptysLil6QO0lLin4u4mjRYV4RZ9Uo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2l4SckV77AWDddlExM7YuO1aTjNDw9H3ib2gppiY-KNw&oe=69EF57A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjrkPF8HL5kQ7kNvwHDMK1K&_nc_oc=AdpElQFAnaOz3smrTn4whkDHkONNbf8lzgHjK8tYWVBXPQ5Owdx2cQH6Bh5viCGdMdM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mmXuyCjUEhC2Eun8-uuCwXW4a-q_AYyaDd7XUhfC6Eg&oe=69EF7BA0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNO7yXdAgN0Q7kNvwGOLYvn&_nc_oc=AdpYguwmLP1WuRfJlapDwdXpLmJLk1RUFdMktwgFajcpQq149T5Nc0TIreOQ0BLZU5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LHR3I0wwwu1NiUHr9UfZ-hcxfoQ3LCVZcNAIzL05ENQ&oe=69EF4FBC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhoL3skAXCkQ7kNvwG85z0H&_nc_oc=AdqmB1a05tCLliUCFmNYcycntDz5gHw0UaqOto8C3Z9KAaW34qVrm0Mwev9kFuvDi1M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AFhu3FBVDe7d_1k9ffVIjgUI4m13vl-0e1KvHk2woRg&oe=69EF5D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-swqq7PxDXkQ7kNvwHk6LV8&_nc_oc=Adq_jgAP0_9kkxR6Rymod58ojH_WPIzzGxQ-Hr2awT_EsAGpa1m7eWTlrBRXSx0pax0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ce17Qy7osKCi4TZP9M66canQ4sPYyDI8id8P9lUBADg&oe=69EF5B7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
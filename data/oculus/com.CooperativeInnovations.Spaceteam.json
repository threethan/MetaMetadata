.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpCzjE1jBSYQ7kNvwHX_wEz&_nc_oc=AdkZm7pv1PP0uIFA1RxVoo6PEPl8ny_upVCoVVHACXzdjQOwh5eTTNwfgFtL4d2coqM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwufwazYfdy7uMPZ9IGSbOXPUpfvQ-TEgQj1WS-df55bg&oe=69BBED21"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKSJuPmxq4kQ7kNvwGmuAra&_nc_oc=AdmYlE6rqc9_iJM417y771NfzWKShjcBnY4JalPToZXe539F4jHmPGtZapmGY9h41OI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKPE7ADSogeGy28Xf52VhbtU5iiHljw0P3TuRp4nxKKA&oe=69BBD8E0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59K0F3CLCKoQ7kNvwG-rXpd&_nc_oc=AdkQkNemSdBMUHvtTjZ0NWfAgt2oDSSkYhAGqNND1a0Hil7Nu_p03IZlghuE8HHT-hA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwT64utZwevUvkJ0yzF0irN_CMrLmVCy5QRe9g0Mzueyw&oe=69BBE53C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgn1a8iD6g0Q7kNvwG876o1&_nc_oc=Adm47ZKeFIzVzbD7qNMIR7eEqDHl84qaZNlKLEd8KK7VXGie0DtGYYwLWocdNmOzxYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyx3aaHj1XId5x0iGy8i9rTphTSnPkQ90suBeTYJru4BA&oe=69BBF296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJJMbCsSFxcQ7kNvwEbgntI&_nc_oc=Adm24yviXuolQhT3XgVWBQRYurOjNU7nb9PkV7MK83vz7TLYqpUVKmZFgEK6_b3FN54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfznTdR4jSlTlWnvHleLUti0VCsOHzeKWtTyPpSJYAZ4Lg&oe=69BBF0FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCA
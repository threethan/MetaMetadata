ntent-ams2-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVkKY-0aiiMQ7kNvwEBgQyU&_nc_oc=AdqdPrrCu4gg1DgxuedEw6STHUjaAlGbQtWWQ4HDjdMKnJmFrkOzVJiifvLqlQsTpi8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1Mp31aTJg_HbGfUEAynSTLjTsx0Yned2lT7e1Ida1aA&oe=6A9C0C21"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdKu9-zfPfkQ7kNvwEzxhew&_nc_oc=AdrybHVPCg3LoNhKnMa4UsBdDp96PYi5MeP_P644bnW9xsHsNX0Grz3TOlQ7e6g6glM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8dPJkCZFdSZdOCd5MxgJkQLHvSEBhOGG-jEYsrqtinQ&oe=6A9C3020"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GVACL_bcfMQ7kNvwGMxMid&_nc_oc=Ado1sKAJnXEtyMV80aV7vErcvmny1VoU73bPfH8awlxqLKhG1gycY-pJ1GExUw38hPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5VPDwNNyQGjKWb_DLfoJr5N5qf1wzCLVrGgtWOWLqaA&oe=6A9C3C7C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rd4kLclezUQ7kNvwH2tfN5&_nc_oc=AdrI4UohX9D2P8Yq-RUgBeicH1SzBU_CPgR2yfnZkTQhSJ_xQCCVA31B640NIu5Pcjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9uYazurbGNI5h7yGML5dx_aJKO9EGCqxtGxjbMbBdkA&oe=6A9C1196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC-odcI9_dUQ7kNvwFEG-fO&_nc_oc=AdqwcouTGSSxRpdW4AAuxFZb83M5-Hph89dr2KAJWfXJuO99WG2baIkFNwVkEKwM3_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGzCBqj1cVZmgUHbM_6cwkNuszGEzu1nFQQOlphU7ZNA&oe=6A9C0FFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
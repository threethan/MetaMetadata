ntent-iad6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCdEmzplIKEQ7kNvwGIvPqv&_nc_oc=AdoZ6tzJ3DQ1q3yrQ677mU3JIelQsT5QuTMarFRbWEBnyXB6fmlxjdPjw73qMcuhjlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEg_kBY6HSBmRhEMYU3_B9gLF5y4uioHNUiQMYwScAmg&oe=6AA2A3A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eq3hAtcCDwQ7kNvwF_WCK0&_nc_oc=AdpvxuPLVpAg36cTpIDQpCCqN4DXdbYSMPlDr7SfVlZYfM-r6vybVZewKV7WOXth52U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8wGz3o_C3GSoJMSd5xvNazLkoqnsG71SxcLmEJPVHXw&oe=6AA2C7A0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy-sJf2C6PcQ7kNvwG9nTms&_nc_oc=AdrI1I8rBry1sJEqp63K40o854nQzs4IxNPiWMZTyyyAfhKs19z2Ah4VDZEnKHyjvRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo0YCpTiinqTIsgqyMVCrJ2j1wyu4VTcmTOsq6kP_-yQ&oe=6AA2D3FC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CdqU-O5VksQ7kNvwEvue3p&_nc_oc=Adog-nyC2VLQIk2sbE3OmRlvefh1meOnoFE938sbO09ct-gVivzu7owr1PARJ9-088I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfHfCH-xzLdb1eG9qv2KWaXbyH5YyNVgXFOAIXjH3CkQ&oe=6AA2A916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97EBfT-p_9AQ7kNvwHgyx0z&_nc_oc=AdpqIlUv1v7tG1ViMi-Mi_1k7xYSYsK17a8y3UexKwmpHDhu5yw5DrM7V_nh8guannw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiitx3Nzkus0XtpVRwxhOS4jlCafZpj2ZynQJE0DXBAQ&oe=6AA2A77E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
ntent-lga3-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVD_wWXfAHoQ7kNvwFPiwBN&_nc_oc=AdpXZqNdSNVnrmEVZxiJotOuL1cvtyD11MnN7vOz0gIb4vYiYAFlxS5OPncKTlZIt8w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnbKSwe3dycVa03mAS0LJlyifZ4ej9-W1oX9tHEACLqw&oe=6AC7C5E1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsiQnX2vPEEQ7kNvwFW16Mw&_nc_oc=Adq_Wf_rnyvacicbP2yVrfcPFLpXHYTfiKzBHKYNfGpWS-L_KuAjGnhwZJpkK_amzy8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNlsQJt4MCYPnGzsmlhssk0rbWF4y12rqmv7zNcfzQSg&oe=6AC7B1A0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXk8CFnkPkgQ7kNvwHCFFKf&_nc_oc=AdqT1KJDpJWN6J0WjdUjIJFQ9LeJObVi7Ct_db4TH0fLNldIUu-5_T9pV6CWl5MXWos&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIL0VErMWRriy53Gt7OmnzBdtd09GX9Drge1QKTZMQkA&oe=6AC7BDFC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEvUb6XGu0IQ7kNvwE3MMjG&_nc_oc=AdqTmvbGhj8GxeCnXiVj-9aWpDnuRvqnx2Ovk08xPv0sESdk-7ZcpnY-nU1uZOWiA4c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSQDlJJZLU4KX6FP38lIvDy-tTK-vj34h8tnOr43yn0Q&oe=6AC7CB56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes
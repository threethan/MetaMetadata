ps://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av4hW4Z408sQ7kNvwGrP2nM&_nc_oc=Adolieej8U0pFBGX8mApmsLPsI4uJAu6G2W21AAXD7sqoG5VsA_-6zH4_4J_cj7QMZE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMTgn8o0BsyWvATH9_rerkQ6Hk3qFEprKGqsaVbliiTA&oe=6A8D8BA1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mflarYU0vjEQ7kNvwFHU8Dk&_nc_oc=AdrTNAMwU_QW_RpWNGwWvwcF1cQUoiKhNa4u25ZihztlXquoe7Xg6QS_WH0BRaM_OJ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLHktDrOKU1siDg2avcXD9t-nRu2vnucHvc0DP9maZ_g&oe=6A8D7760"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1j_R_Ia8rvQQ7kNvwEzz_FY&_nc_oc=AdoaekLTHc2r7J0CrxPxPcEWKN4Ek6DbxhyBnjjXSdkPmt9KNziY4eyyTh9RdKFnXyU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL0GCneD80bUcboOPAAHxnL_ol4vk243cpDtP8f9pk9Q&oe=6A8D83BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W5CvMZvMF0Q7kNvwH4k7y1&_nc_oc=AdqICatf0M6cOvU3SMIT3zpP4wc2L9RSfbLZF43yUGhWrIvYF5PyoxP33oKEL_TpWRg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJqnOIsOeEtikqzceckIVOrh8H8YfC_YqqbNPPQ6A77g&oe=6A8D9116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSlLtz5GWrQQ7kNvwFALXRD&_nc_oc=Adrz87KKBrUoGspMF2V3iIesBT6LriEMXvbroDi2Y9zwmiH6uR_1Czoy-KKR5fJkhLo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhxElBOZegc77KoDDVMZCpigr10Ls5hb-7Ns3S9ovqAA&oe=6A8D8F7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "170092148073542
=6A4114A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ2DUpoFeg8Q7kNvwHCsI3b&_nc_oc=AdqrjxAZvDPml3uwYmhvljS297blixFGSTRjprhf85kMzxWhUhWs78VH-ZKKff5UKA0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8anxV45sgykHZG9X-8CopE8ADJdFACexht2h71qgDEGQ&oe=6A4138A0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkpQqymgQT4Q7kNvwGOq6dI&_nc_oc=AdpBRuCaeyRwxqn1PSjmyIsddg0OnLw-x_uEYblpJiwhQ1zMOLqHKWRsgefbIKkxbrw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wPZAMaE7SCZVKzY7WE4_9o9WRjKQrywB1IkRHfAgc1A&oe=6A4144FC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdivst3xOKwQ7kNvwENxOS4&_nc_oc=Adrq4YIAeh12sfxQvpX8lYqN-0u-deWSwTIGSFJy7I3itbgjmXLjrbIXKPJHe_dHaKU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gILr9Vn25GOjtEKbM2YhpiRvqQoKcgADimEs5Wuv0uQ&oe=6A411A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHTOBKkM1LAQ7kNvwHpfOek&_nc_oc=AdqUjjQz-mM-7MUx9F52V4XTXuBQNlbo89XPTZQi2X5nqe7k9bpi2xawNMU0z830-X0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ybKMGbv5an0KKZ9mh-yreS-TcjZ-sy6CgDCBPkW5EJw&oe=6A41187E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "DON'T PANIC!\nEven if this is your first space flight, it's ok, the ship will give you instructions, it's just that they might not apply to a control on the console in front of you. They might be for a control on a teammate's console so you will need to tell them, quickly, and probably loudly.\n \nIf your Spaceteam can complete enough instructions successfully in a sector you will progress to the next, each sector becomes increasingly difficult and as the ship becomes harder to control and eventually, inevitably, you will explode. \n\nThere are 3 ways to play Spaceteam VR:\n\nFULL VR MULTIPLAYER\nUp to 6 players, connected to the internet, in any popular VR headset join in a cooperative game of trying to avoid their binding doom.\n\nFACE TO FACE\nUp to 6 players play locally with at least one VR headset and connected smart devices, this offers an experience much like the original Spaceteam game. \n\nSINGLE PLAYER \nIn Practice Mode you will join 2 of our trusty robots to form a Spaceteam.", "short_description": "A chaotic, cooperative party game on a spaceship! Shout technobabble at your friends. Attempt to follow randomly generated, incorrectly assigned instructions. \nWork together\u2026 as a Spaceteam!"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SOCIAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
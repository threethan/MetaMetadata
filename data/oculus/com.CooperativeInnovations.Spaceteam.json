ntent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH1a68XGaCIQ7kNvwH4012M&_nc_oc=AdqrCPtM575EKgiNRV-bPzeAAD7Lf644kXEilx7F-jZ9dt0JZxuCAG0xdQHJhQBqUZo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzomAB9GE4GaqGBNrJq22n9rAZNw3_BIyqtjkXarW0d0g&oe=69C527A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1l06TUHoO7EQ7kNvwFsRO3L&_nc_oc=Adolr8XXFbGb6-iY7faYTpiwwiHvEA5aXzjuhYncgsWo0cBA2P4VDnOlXnbG7Wpd_1k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylV8MZzNvJBCLXDBafMOkoZvCxD71SnJeXmmvflut3Tw&oe=69C51360"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYdVI2AZfWwQ7kNvwFwxmxz&_nc_oc=AdpCue5IxaXlt4IduKYWsJXXx683MBVPlgD89FkRBMF6G5NUCLStzhiayMM66TaEyBY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8aFG2cDeZe_RH6KbY7_NChQg_wtgCu7Nmehj5q-y2Kw&oe=69C51FBC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cO9ElnSS2hwQ7kNvwHFyKyf&_nc_oc=Adqh8zDWn9GXmSW2oALZM8W2mvORJQPxJNV2W7GjqOR2SXM-KqN57q8jPQfNNVWXgKA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH727VCUgirU9lRk9036Smv8yODoJ0xOodRhsvy6UEWQ&oe=69C52D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM9-v7UxarEQ7kNvwHB-kGP&_nc_oc=AdrBZy0pVn_ztxeRdwWKmquUyu5k5dKxPdQNvl9AZbWsF3afYjXzIwTOH0ZtIV0qlWU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnEGuzl44mdRkFE7VGGmupJ-PGYlQ9c_r4z9_gPmHUkw&oe=69C52B7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
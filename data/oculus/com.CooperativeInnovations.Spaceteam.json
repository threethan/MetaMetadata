ntent-sea5-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPuprpFdjp4Q7kNvwF4F7Je&_nc_oc=Adr8nTq-Hw1ALIxyQLWsV0T9kXoBoZkoinuJkOYnTz7RYafis4PkIUEnWbAQ-qSCZyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EXepIGaTeq7Y0n4EYcc7VQj182tArdunqFsruENf4TA&oe=6A159321"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPsKydZGxT8Q7kNvwFQflfV&_nc_oc=AdoxWFd_sWUYZotzKzPXJlGfBAntamcHe_ZL8qKBB-V__2eyMrTAXCaa5GfrfuWDsks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w6XPMrN57TDdOEYQzYMORhFX5SoHJWYUsTDARPOsG9Q&oe=6A15B720"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8BwAhbPbDEQ7kNvwHPY4aU&_nc_oc=AdqZ80aQDCPluCZjHRmzgOc9PyLoRQ2jdQPCHECAHesa4aScPcgAn3RAZaM8Ybx8y-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42PE1Nzyq0Fxi4VM5yuStZoOm4d0QV53EDU-egRWfjpA&oe=6A15C37C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XImnrOSlJWQQ7kNvwF5cTvY&_nc_oc=AdqqGuuU4kLiLC43zHf5J-Clf4qt8gL7YLyJP1z1CYfRzhUapEcFpn4ymPDKkCtmKIc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QqAE5CIzeENRjhNAP7VV7YiMa-u1OScotbimQr6irwg&oe=6A159896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRPsqSiEp04Q7kNvwF8cgSH&_nc_oc=AdpvQzWFDBY0GVDBkbyDPt_rVR6byxHlKKJ7CrtFNUeLHWBgH5L1nOUTSL8l4qxHJ3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ubd8hE-J3zScLJ57goGSqNPNbw17gk5TboQY8Tv7SXA&oe=6A1596FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
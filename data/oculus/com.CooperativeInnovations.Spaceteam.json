om/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnXg3AgXC5MQ7kNvwEBq8aL&_nc_oc=AdkBMkFNEe-qnkWzaUZA19lVmwgEcGW-HIMiDOYvfc5KUFaZk3ruW-0rcosSNd7J6-Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlzZm71VEtZbjNi5kHWObMUDp7CuiCug920Wo2yVJTiw&oe=69AAC9A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yvfADeXPisQ7kNvwFD6Zzu&_nc_oc=AdkDWhZEjHPkx9AWAiOdMhoX3w-abqS0-ZOwrRs9uojS_69uZ_57GLyctTkuxoNCBlE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afxj0gxRVRFTaKmn_xsBqE2SwlFrwun-nbxKpuA-8sJPGQ&oe=69AAB560"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxyY3rSqnNYQ7kNvwGt5OUt&_nc_oc=AdkZ8CBTWoayUIsSqtx7WWXoUfT9hap-ynTglj9Ipqa9rNEeUeq-LljAQlOfAJ_mvRs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1KRYYt_xi3jRNLp0qAasLfVQacUxOabt4dRCMaocrDg&oe=69AAC1BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkC8mgFP5DEQ7kNvwGEUWIZ&_nc_oc=AdnTfvdeAAkZ_Zn4l-zg_Mhzbuz5jgGx8liz1ubPWG_FtB2ZDZHMpLI55_yJ3UKPF8E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afxx9Zwrd4t72esk7eIh6NdEiMhsSpNlewYJDKt2jQRKaQ&oe=69AACF16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6skLXZbdyF8Q7kNvwE1TnM_&_nc_oc=AdnJV8d7TyABElieyepsZtyJl4mZqzoQ2-d9je7EYsO8C7-ZInTpPtVuvwJlI7wmDlM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYlLisSXrlJBKfo17A912GzSifOqPVM-MujslIuMyiQQ&oe=69AACD7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genre
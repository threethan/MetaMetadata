ps://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAuPNSSBjHMQ7kNvwF6fxOZ&_nc_oc=AdojEFX5wR7K0FAs51doghdY9O5CwLYa6FE683NdYks1wrvbaREpd0soYvuKSHa48oQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdWw7flwp3zPPsiP2eY7KdV8ISn4kuo0F74JDhwpj3wQ&oe=6A85A2A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73ZwmhdqSDsQ7kNvwEz1FPv&_nc_oc=AdoAkCayQSBM_KbEIo1I7HZuVlDcFlfhzK8DgH-JUZQHtLAakQQJWm-p3DHHlPM5sKI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLWqgzKI8GCUseUE3-BZtTi-ZBaHE-Vkg578lMEKlMHA&oe=6A858E60"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzQaKym0oZIQ7kNvwFy0cXr&_nc_oc=AdrqWSBCmltCnv6Wk7EPPMgoZOMj_5QAnuwEND36kfRWkqQ3WbqS5TDW6WbJ2ra2Dlc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGskJWXT8mIGxGHXfHlGoVcdTPPDE7nQDTgzYi_QMADyQ&oe=6A859ABC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNQRn1JQ1eEQ7kNvwFV0AUm&_nc_oc=AdoI9OglnY12nQhHMA8BYJsMHGfzxRKVljCCgbSonKOTclfudmPlJD6oVrZrJon4YHo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6TkAV4hdWRH3BecPeGbK0Qt3JtzwIlljISzBfzo9VRQ&oe=6A85A816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc_rEPIQUKMQ7kNvwHH1JIQ&_nc_oc=Adr7A9gSYG2PhYHkuyEkVTUYGAguGblbK2m2hUNxFWTUijdDawUivnQzXep0lYHzCv8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsyuTQlMSWZwatI9aYmOH7K4hV6GzhYf6079vOxRi3WA&oe=6A85A67E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "170092148073542
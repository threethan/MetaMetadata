ps://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxWw2R17a8gQ7kNvwF-qX_w&_nc_oc=Adr0aZ2gYwIwmxyFCxfx7rjd_a5WoqgeqiiVeCZO7S3nvQ1gwkiB8A0HNHVHO3pxd3k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlpgUhHlUzUeB9WDntUCfQ7EIwsFWk0rOTPVbuBcb5EQ&oe=6AA3F521"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eq3hAtcCDwQ7kNvwGt77lD&_nc_oc=AdoV__Xr77OHlVOO0vgPvLfjS2sifXvrscvZXrAVz8v7yFiPBe26Sl5D4RdKDL7GdTY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFQ7LeqS4GluHW0c62TZD-GvYBuSbA7n5ikRQgekjbOg&oe=6AA41920"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy-sJf2C6PcQ7kNvwE1aMVV&_nc_oc=AdqIH8OucWTaID-TT8WyHkSnihQQBx_ooruaCZQdKKltgiOb52TLncZRpnUeFo5q3to&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfOj0MjEV18BWtKddX0EN97kVY3kTFqsA4CrxEbI9QIw&oe=6AA3ED3C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwm-4zQ5t8IQ7kNvwEaTaMo&_nc_oc=AdqMEB7iM_X2WzU5B55wfwWqDGjJgIb20-HAGLW-fTGOxuLpBHfZlSqNjZqH5NhvQcs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7XsJjlk9uJhMQrLSZNI8bK-NyY1zM7MFDRCSkqnMlww&oe=6AA3FA96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97EBfT-p_9AQ7kNvwERAu6J&_nc_oc=AdoToCgE49iEWejwxLQadjsSy7RYG-15vPyyZrihwxQM8lgoQfmkUPi5YEObwZeHCSY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIshDmAA_oeq7Lce5GYgVNwbJJ1da9apLupfoMwgPb0Cg&oe=6AA3F8FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], 
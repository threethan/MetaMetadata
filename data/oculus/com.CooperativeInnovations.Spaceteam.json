ntent-lga3-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc0UW2aDaVsQ7kNvwERJr52&_nc_oc=AdoVge6tbhxXyaUmhSEMx3H7gwkpdd6NmpH0GsExvEebX4GYxDpr1HmOlKWTMqHC0vw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKccld2T5JIOQmvgfCw7aDGnaBxmSmiwNpNVw2_RI7Cg&oe=6AECAFE1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2rWWlzBZyUQ7kNvwHR_Nh3&_nc_oc=AdqOiDcToot4EueSE63Ht6PLvUMnOPEl5siU0_jt6j_efXQGhxVBcOQ-Q1_PVlECHB8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIVnPRCnf2dpo9ZFP9dKBrK9iSQi9MR0MozEuIqMiRxQ&oe=6AEC9BA0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp2uwWuxA4gQ7kNvwHvY1mj&_nc_oc=AdpiaNQnO42MPAVi0P1i9I14M46aOyC2yjgfzYZuo5HnQemPyK6TnN6kIoRxaVyO93s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdRJaNB3Q9uXXaeUniYo6v_W1yLstUQwJxgYJaqFGPbQ&oe=6AECA7FC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIgXCyPDc-gQ7kNvwFfP1Yi&_nc_oc=AdqxRgJxv6sLRbxSrqudIqv6qjKUB3D8vUFO07Yk1LAha7UmRCYmvOdgA2oIOndvkh0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk3uCmsB8rK0G-k7YRi8W2ooKibBCRiAORcdfOofP1Yw&oe=6AECB556"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes
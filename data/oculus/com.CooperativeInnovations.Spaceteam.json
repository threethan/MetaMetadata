ps://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU5u4Ep_IzEQ7kNvwEB_vo1&_nc_oc=Adp7PCPTzwVjCpUrCg5nfZbe2F6ADCnqTj4jZczAZugD8Y_asas2iRHoD9t6aCIrDik&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SvH2OMT0L1LITvLs_3_J0YD0UMfMJyVr7NgCMK8gChA&oe=6A119EA1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcF2XkatiYMQ7kNvwFYdkyX&_nc_oc=AdqRmxhK90ScGVo600PJ38oj1_nDPh24l4ReMdO2ohno8K4jDRvjK6_5KCW25ihVEkg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xPfy3PRluAr5zs9VxYSBPAcIjms_vHw_Iz08s7Qfn9w&oe=6A11C2A0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IDvBrYJx2wQ7kNvwGy4avm&_nc_oc=AdqiYj4sI5V3DlVHTiqiPpKEFxeRZMINOPhJ1KMBneBj-EmpUD_76msglHKrEvzzAiY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F8-kfg9_x-_YTaGjEV9wB7Yy9OHdNQT00nb0rJ20Oqg&oe=6A11CEFC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrDuRxEYBWQQ7kNvwFNq6TN&_nc_oc=Adpo1oPrdKkFG2LO0BiV0z3X9rhVAUYhaICzOVoxPahzffT10arbrOOnO5uTWBPEry0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Glcz85BwSsp9Ser75vZT92kkR9BxUAT1q10znV273zg&oe=6A11A416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihbNKSpRcUwQ7kNvwFwZL_g&_nc_oc=AdozwFPV199LM2NKayoV17GJU_WLjjHo9qozlbnU7bl7pyiUT63xXtikqkHawZwbIxI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W9AiKHMHqmgMvV7VhhVys17GArr_zEJYtd4NKb38dag&oe=6A11A27E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], 
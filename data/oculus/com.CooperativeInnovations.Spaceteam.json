ntent-iad6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhsSciESHrQQ7kNvwEybTMr&_nc_oc=AdpgNwovIyJxJ8veu599F_XmNNo186d--Kbpw-NotmFcaydorGKBl6yKVEUXFmR4dwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sX8k2G_JAVmGCHyHWgoJAj1Esh6R6DyfgUjkT1C1Xkw&oe=6A05C121"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X37Xt1oEPcQ7kNvwGNEa8P&_nc_oc=AdoOKCHMw3d-Jyo1hBnh9xIMX_p1wSWH563M2xzXFPca6t7ngmQzvIq7XUWPmfaA3SU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QswNOd_cAxRL7hsViKOWJZVO5ClsmNNei9HhYG8m9pQ&oe=6A05E520"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVV0eJMeJ3cQ7kNvwFJpLgR&_nc_oc=Adpfu1dIxA6LtyyxwM2zi4DCtTw9hVF6B1dc_BdoAgtVM6iLAm8IYhdjjmsG12XzvKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58qFHYN5CuIHrFU4wwUfMAafKw6n_-Qul1dCMS91g8DQ&oe=6A05B93C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXjDVItp17cQ7kNvwGvKThE&_nc_oc=AdrFoi8hqPh3I-_LI-y5VlIsPZQmhn57Vqw3guC8XMewtpNGsIW5S3hftDceXccPGS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Zl52RStmxgXmYZCS6sP4MLqiFKe6OE53ptTLXHZTDng&oe=6A05C696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4HvOMZhqn8Q7kNvwHUenGe&_nc_oc=AdojEjhrkMpWVxn8xN7c2PZrijRnxsu-pk4SzNwTTMjn3EjCKYsG8VdsWi0rK5rEnPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eigzt1IV7Tq9Ui5yfkx3QOoiEGUoz-oWwDeWEnxJTWw&oe=6A05C4FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
ntent-lga3-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qdp7mvtbekYQ7kNvwFzIozl&_nc_oc=Adqg4yGrwJ87-jdOIU3Z2GqPeUrp3-s_iz8e8Hvp17VK6v_N7wFJBFT7Jr8anOZ4kxc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCOaZsWSi4Nc5EptTQDqYfJVIt4K28VOwi_L8GHiqMeA&oe=6A805CA1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlUKaVElJIYQ7kNvwG_Jbpg&_nc_oc=AdoEtxAEdni33DvUe2y6_HS2vgWjEM6SBWCjuPwJwI1HVDRo3LZuBQzMisgwlyRL3sg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDYSx4WTTaeXflUDmz4-a3QAfEGeDvY4g4XpJjm2wTdg&oe=6A804860"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltTB1XTwRnoQ7kNvwGNEk7H&_nc_oc=AdpAjy1wYu8y1dtw-jXEp2Ishpi76ur4WwvwomIHCABbiSU0_0PiB4vQ2pUnBqQUk_E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9xaawtydcMRBo2xuUQWyPzMm3EbfUkiMlgS7ktGqOQQ&oe=6A8054BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgWPCXL8ZeUQ7kNvwGD3Db9&_nc_oc=AdoQeHSrmOhq4A2uoxP2y0mPicQ-ur8TKbj7cjixzkV_xcHYxbciBI4cMGSyR6qcpVc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH69wElBTBMi-4PPYDnxg6auPaQkg-0A7t-O6yJQa3g-Q&oe=6A806216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHpd90vHUvIQ7kNvwEd-WpA&_nc_oc=AdqwMlv4h59_FsvJFZwN0gtt6QHRDjJ-tyJIflKocsKRBvfAWE5CmXA5YEWGXxc2Z2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOJtGMylIaSmN6cdul1MdDgnCgL2s_QXQTYy99z_Nopg&oe=6A80607E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
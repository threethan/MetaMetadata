ntent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzdeTAkhjo0Q7kNvwFdsVD4&_nc_oc=AdprWeQhOAk6RQtRHnkFfcNTdOD1Q2orDLv_449sUStF90cZh4FGAFu7AaDuy-E5gf8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pu5pTmqVB4zVpQVB1ancGvqukNjBisAFOSEAN9m_TBw&oe=6A26EEE1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYzngQTrkUgQ7kNvwFLQjWO&_nc_oc=Ados6MbbPlYf_pJFWAS42lH1YpT0psFdAL_V_71yohMuM9i53_fhVhLgf-WCpN_Apaw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Eb3dZF1qF65h1h5khSIQQhysFsjtU5k848lOzxj5lNQ&oe=6A26DAA0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLrp9DC4yVwQ7kNvwF0R5m5&_nc_oc=AdpvrXutHbUok4O9ybTmSLAG27jcF1TGFkLTLULNGyn120B9fW4-j6xdP2QAP2iwQnQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91lBKDJLtnuOXkLLCixbfiFJCPpGes_eO_LEKow3-S9A&oe=6A26E6FC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tMjoCp4YGwQ7kNvwHQZ1N0&_nc_oc=AdovnXhwlFEG1YImroHrUn5ZptbcuU-HEq6Z6jY20sj3u2bgEnJMXDW6LhQtUSxGz-Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jeJXwjLhlu2WWyCIexmPk56NyTvWGvD8vJUjFvrQYSQ&oe=6A26BC16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQY7bDmmQbkQ7kNvwHpVTc0&_nc_oc=Adozvl-A7EFSHJNEh5mPQn_Hx8CPTF3LEBgpmHTmTj72dB1SLPlCZ7Vthuy1Jb_jbws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CtM8PKmosjsqSnAsaMETSQ0xogS8CmtHJBWJjodEPlg&oe=6A26BA7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
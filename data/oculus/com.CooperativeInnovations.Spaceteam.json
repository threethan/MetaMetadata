ntent-fra5-2.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxhpPWIM9wMQ7kNvwE4Niq5&_nc_oc=AdpJfWqUwgtkB5pmFg0k_WsDczxxhRrCBNmXt8Wt0SaMrX1uZEYNOF7JArUasD8_kN8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIDf4F2NBp6zsAAq_kE2CgXb1YWvGmb_UBtouoKJFf0w&oe=6A58CFA1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi73QTGh4r8Q7kNvwH4w7lJ&_nc_oc=Adr2oOhFHNbiCQ5ZyQ_kGzz8FuAh9AUzZ_urhq4sx8veaeFSGNUdm4Wf2mwBc4pXsWE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAIk-oyCq_NmThPugrvv8pqaip4xX074Lp6VRuDwdYUw&oe=6A58F3A0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rne3gSQ0f98Q7kNvwFAMuzo&_nc_oc=AdqgfPB18gdGz6WEnarBcJ0j1S3TRLnZq9NAv5wm7A9JKEH2uqz1HSvJETjudyhNwC8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlb5uGIK5uCI0eQ9MTvyPqPG-5Le9X239lEBA6uteAQw&oe=6A58C7BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FLVTxWfll0Q7kNvwGXPkTy&_nc_oc=AdoFB2xhRV9TAHvESCq8YjAMyWu-uyoFv0uozP_lsJEevSOFTvFUcvMiITdrNCfXAnA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUCTYVTZWiegExpnwckFvgKUGxP_AJLSn_HRNmSMFWrg&oe=6A58D516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFHeqSa_E3EQ7kNvwHIJCGA&_nc_oc=Adpug9CMB8hDnN0rhs8eLTxZ6aCfl1euK9fco7yMhZhX4hLqsz4YbR6B_2Y_LcB1FjI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9Fz145mIYcIq2JRO4x_k3mHDcxVmXbMC_DSMKu-8YiQ&oe=6A58D37E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
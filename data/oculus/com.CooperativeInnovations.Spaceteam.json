ntent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptyb7Ee4X88Q7kNvwHRq9gm&_nc_oc=Ado9YdAAUWmSMlMvCqMPPpq1gZag4WxgK_A3y6Nml0EhB67RRzJqIOLVJLhjT6-tn0g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeYVsKkhDlrXNQ9anMY-AYUACQBJPUBdci1i56m3eaEA&oe=6A65FEA1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uI77yNSaiEMQ7kNvwG1eA-o&_nc_oc=AdpkV7zYTrAk05xxQxfPfC6ZSPl1qlREnmL7HRaL839EduqsWCNxvM5_Qr8sODO4BRY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk7biSEDRDtjoQzQumxjo5HwWplTb1uNmngmWLSP-i4A&oe=6A65EA60"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ7EM7tRbvkQ7kNvwGs_Vif&_nc_oc=Adrbbw1-SO4WGr6uBMWH_bJdlFJL0GYQsicyWJGFroIhKen274vyHDzSGeFWsiwjW_o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC0Ggduj8-AnkAJ1_0JfXN6_1U24URUqWL53AdHugGvw&oe=6A65F6BC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nymyILOwIAcQ7kNvwGUVxvc&_nc_oc=AdpijPC1_82WwWhY1mEWurQVH8qH8dSzPZupKdfJmpBU5TJzOURwCm49Q38X4_HPOpw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB59hMg_mwDYc3oLmYFV8iGVcjS6wc7R925nootFEIESQ&oe=6A660416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUlj8euTYa0Q7kNvwG0LAvr&_nc_oc=AdqqfM4T6iaiq1w7OnAuBZBHiM44yEe_gDXcf-QmbL2_jJHcYxC8pWFl1kLIn5T_X10&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZyP3vMQgb6bAqRjIehTE9Fame1e5rWvAhaXZf13bIkA&oe=6A66027E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
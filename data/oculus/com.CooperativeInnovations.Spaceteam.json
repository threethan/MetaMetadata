ntent-ord5-3.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU2fo3mU2LIQ7kNvwFnLl8l&_nc_oc=Adre05PkrxWZJiyg06PSIuI-hWzLPa3xpvoKq8LBTDBhyt_jBlE_yei7NbgGb4aO47s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvs-seVluoe8tJq1hqY_ADw7JPoDifkLN98IzprYKjww&oe=6A4A4F21"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RMALBf1Ws8Q7kNvwGeSWO1&_nc_oc=AdoLsMTM2sGUS9pSXeND5xmdw3kruTWMg7zBSMY_6PpwMS1vzdWfMCtjV90cQ3dL75s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5texM_3LuhNnmYibZWBnCdhAnEPLC8to2gUpOljeZww&oe=6A4A7320"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhECTqniEsoQ7kNvwHKECTz&_nc_oc=Adrch6_MXGwTyiBEyIbjv8yUCzJyItHUZfHNEikc7m3S1Gsv7V-k5x0ZNT9M-7WOKJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtUCVgFnVc9nrqyy9n8CYwKs7m8SZOrx8W1kxQaYt14g&oe=6A4A7F7C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayX2p6PK83wQ7kNvwH9FUub&_nc_oc=AdpDHhr038YSTjwvuy84ZbyeKjimtLZ95vVhSPaFPaSOc8E0xxG-wfzbpybbmB2Ke54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACxDa5huk0i_8pg1LttqyAOMDWEObhW9d1l3PyNWSfFA&oe=6A4A5496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy2M6BqRadkQ7kNvwGWDBHi&_nc_oc=AdpKY1gCQ7y9cAYM7-8BcErO9GjhhJSzMWZx6TEAL9SL_p38rYlWjnT8Eego9tzhBfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3KJmD-rR2B98_L1yfVoyavMlsTFU8Ydyw4u7T7tyFRQ&oe=6A4A52FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
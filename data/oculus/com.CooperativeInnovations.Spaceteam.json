ntent-iad6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xvGSMy3ezAQ7kNvwFqC4iE&_nc_oc=AdpJANBSI8Q1qLhvVaVgs4dNQmn6BxTcUuOoKNNUlUI8NrasqZE-Y4ZTJNNl4hIleTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUyLd33Od2T2QKeyUqLcnETH4MRjQvc247XaEBsWUyXA&oe=6A4F9521"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51cFU0kyeNsQ7kNvwGNGuRM&_nc_oc=AdrRHtEbck1F_qOanOCrC7jY2C4ZI_vZBAfNqtvXFTaF08ZMLj_VLGGR3WxxFVC-PuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFbh-jSIoO7It4cVkpbRxqRpv6K3mnaJx-AYT5uxSOnA&oe=6A4FB920"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4wIe5YNOSoQ7kNvwFWKuHo&_nc_oc=AdqjqklTBzWuoGi02Qh95JJaJusNqWXBAm9YkhR3GFk6GwzjrSs1MPiQQpk7B1ABrV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvxb_WiXnnwEipLkEmO0_aOlaVrae1IWtVKZA_GjFNeA&oe=6A4F8D3C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEI5EoNVv1oQ7kNvwHFAn_T&_nc_oc=Adr9TFefF-0-1rnplk4c4oR0mA3Uw-XQpQlLSS7ZJ0z0Dre1pfOOlZIIjbhX6zmItx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJc1NvuusDaosyPKWhAN-db1iwwLpXvyB7AbQ8YFYsVw&oe=6A4F9A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNlbuAEwYfEQ7kNvwEHLexv&_nc_oc=Adpm6-s929iZFRmUEFkkJdZt4gCOEpOZvqjHtq8OHv0mO9UFcoeEXqhEUmqvKvTqgnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy-K6Fzfewbdj_JcRxqcIsMMbuUfth-1UhlD-rVBvICA&oe=6A4F98FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
ntent-ord5-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxWw2R17a8gQ7kNvwHeNi25&_nc_oc=Adp2xHAsebEfdL_gn_I5D7YK_RnEI5ImtQrQiU93cVAaTtd0aqqNFLUD3NFKjLCEz34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOBCgS5A2K9ZMvUDf7bdfZzGdF6TkXCnkJ_MWcq0JbLA&oe=6AA69821"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hMXTP0ah98Q7kNvwF6CJyW&_nc_oc=Adr1iN3Keb12FtuS465IQ-FBX6xZnIS41yTLc0Fw37Ccbp2_PEa5k96A6iUEzVVxi-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9JBGbwf-B8zQh-soA3vPA8uQX3-kHwuiZPxbrV5j0jQ&oe=6AA6BC20"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvRUMxU-_ZcQ7kNvwEhSd5J&_nc_oc=AdqFOxoKqvoEk8XCEr3JRNZZgiJFMJdX4IuB3A_9KKvgTSXB67l8oJPadokI3LLSxWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbgeVBkGXl5jE4irbkKSAjrKsx7O1DRowhwqy9691JUA&oe=6AA6903C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwm-4zQ5t8IQ7kNvwEOaHcK&_nc_oc=AdpfuWupEfRiw9wkVczElCbCHDjozTUjmaTEPBZ2s_23KfnCMzQlCQH0lN_3sq_mrds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN1zjHz6akkVZ89ilMmNRFt0NiPCe37GdrFJsKTjFHTQ&oe=6AA69D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSKTo7au8IMQ7kNvwHbIPjF&_nc_oc=Ado8GHNy_rDSYu-j9CUP7FyXXmlSxCL6LsKYlgLvnv9OW127rDH4ziztojju-oOzgFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5j3AwhbtUyj3N-iE1zAi34A3CVD8R8hSM2fP2mp9WCA&oe=6AA69BFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
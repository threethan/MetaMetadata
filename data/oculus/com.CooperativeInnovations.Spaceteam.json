ntent-ord5-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrSWz36UUDQQ7kNvwHjVlqB&_nc_oc=AdplTvLYANqUeTF8XaepbRSf_1_7yL-TgvfW1YgfM4F56PnJczPJFHri_aZpMSMEu3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-3apCm9Q9UsqxLEnGpaDDpcOfDMKLNrWnkjybZ2K_Xw&oe=6AB3C721"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kvFOW7PYlAQ7kNvwF29_fI&_nc_oc=AdqVbCMPCg6bEoSLAbKvRNiwsWDi_Wo9DnuYDhu_Zs53gbj4Kp8nfEd-ogfwMnJHJgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmUDe9zFPavjyrANKQ2CpitCws11akmPBnwV4u-XAbKA&oe=6AB3EB20"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V00kHGDrHsAQ7kNvwHPaw3e&_nc_oc=AdrQvL_Uiu9pgWc_ush43hjE1hwetqJfLCKQH3LN1xu42FGkOH7oRL0Wa5EJeNFxSo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNfvu3egnr4CajKVtdiJ9W3JccpllzRQgr0Dc83Pt3ig&oe=6AB3F77C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3Fo64OZbH0Q7kNvwHiT5b8&_nc_oc=AdrRllZmRl9LcEajIuAl__nJN30tiJ6_IZvhvuhxJ3RFh6ZLC4UxqCBae6rkT2h3h44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiL0f4ZAZ3CvgjTURZ9YMZ68NqbhGm-TvpZ8P2pDXSxA&oe=6AB3CC96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SblgoeeUvzUQ7kNvwGfQCYv&_nc_oc=Adrt9xzeqByIs0ldlxtlgUNFrrhHDwGh6RPZ1fjkFEALDEG1OTp9y-Dmt5TpyBC0fsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3yi3GiKvKa4Ljr4Ak1lj0Nb7gpJVaywq1tqLww9yPVw&oe=6AB3CAFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
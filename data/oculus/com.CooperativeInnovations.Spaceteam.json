ntent-iad6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG3kOV3IRUsQ7kNvwEPtYTY&_nc_oc=AdraKNmdPB2SEN5NLA_9pcd0Ui74QeRH5CPkbDGi6IGNWlsSwnVCTS0_VCEA3f7LOdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVM00BmrEAgFueR7rvqM9uVpe-TQX-M9iIVHSd1h3ouA&oe=6A7C6821"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcULmqFQDx0Q7kNvwGjV5Pt&_nc_oc=Ados6efK-s48X269DdEt_HHQvNj0ItKOUwxr1LalrYxXJyvqGacBjPR4442rgonITZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuEn8Namh853euYFCe97sbKlVCqu4SoRxX1YgekOVI0Q&oe=6A7C53E0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tphk_2ZAIa4Q7kNvwG95b1N&_nc_oc=AdqCUAyvdYNLxB7X_I8z3DI2H7Qz1NvimEfKT3KWT_sh3JBS4GQJG5DPWDFGyA8h0aU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpB2pl4FGL3pJvvtx85V6NWd1uPRGmE52faoK9fNsScg&oe=6A7C603C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWxqOjeJVFEQ7kNvwE0IwN4&_nc_oc=AdriCZfzLYSPRoVIHRWIYXUkbEZQnN_9C8vWErFK0uQeNvZDau_4SJCLmBjzARRjfM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPu8A280AUrvBRaXJdFc70X1RRC8khse1nbcKTJfy57g&oe=6A7C6D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBu9HRCkOY8Q7kNvwGPmQx4&_nc_oc=AdpRyjiDYqrpo_QLMhmiNOVt6xm-sah_U4diqKEZbJ-i18YGygsJ1vrMPa8IO1Lc7JU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR3CDa8KPVkeB8Ioz4h187DKlcBvN9xJ3uBy71UFIG4A&oe=6A7C6BFE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
ntent-iad6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVkKY-0aiiMQ7kNvwHdfoSX&_nc_oc=AdoK8Rj0r229AnZFWjBqZCnVicf6gTXVZ_vpEB8ZlcFD78sz95Gndeku16Zq7EA5r5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtGCRPCOdaXnuhKt3Qm3X3_9PE-8txtg7bKWBJ64aAfA&oe=6A9EAF21"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnK6o07-Y-MQ7kNvwHWM9m6&_nc_oc=AdrSAtrLvZvTro_4rNVEdDD4ohqlEjJLhBmo5b4DVdN-gAkZ97TczL0NVQRZ8hpzzZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvwr3kxd6XJi4v7Pir8jYj4rhbELYO6hNBNI9RqsktUg&oe=6A9ED320"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_5pcqo8pPwQ7kNvwHYxwUY&_nc_oc=AdpRhbVc3CcbaQTdS7mgpoUjSNgRR7jIjrd4scQWdUPkG300nQ_yKYg_VpBYuxCKBOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsLLeWHM1dqtskvGXrn8gwAeta47FYkuLUDepOF4BxfA&oe=6A9EDF7C"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rd4kLclezUQ7kNvwH03ydO&_nc_oc=Adrm_8iG111--rzGHjOI1YiN5mLJRfrigYGrxXUL2IPMlxLKyH27DZS_wWPaCjtePBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF-mmalSOqIhi1yT9JBSEHAEnk124WeWmpzElXtM8Qng&oe=6A9EB496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNM8adQ_W8sQ7kNvwFwrLv4&_nc_oc=AdpI3WNVdIEP4TvTs5CROB8TQO8XepxEMwat5HaTvmlhb0VHzcMwGSU1F5_CqRRCRe8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeJORro_Exu7CK5YTFydaMYYb8kRPaIyzIhKvpsvMttA&oe=6A9EB2FE"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
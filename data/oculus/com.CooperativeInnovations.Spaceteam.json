ntent-iad6-1.oculuscdn.com/v/t64.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pesvHEIZyNYQ7kNvwGCDJpx&_nc_oc=AdqcjtShludh3Sf0qaKWOI3CX4-8Wq9bhsNjemceNMGIpu02XR4nTU7IuZh6rz6Ejho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d87ro522HtBG2imro1QRE2XhiDBwEvuo6U0Ig13ajOQ&oe=6A1ECDA1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6wKiodkCxoQ7kNvwHWiW-_&_nc_oc=Adpl7qIly_UYDOLB7riTsim0LPk5dlY0nxB0-tQ9XcYMS4a1lBgEQbDO9ZebDBTeXjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79SLSepEKJ3HYOfvUo8GXF_UUS_YPWf_GPBJRwWMunvg&oe=6A1EF1A0"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcUsTuUjuMIQ7kNvwEohXTE&_nc_oc=AdqQWlb9AGwfxj8d4fyQ0wL15QOcT1dkyPITZDXu8ouYpuRflvZsMv1IIt-wDzAuef8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LnDD2j0V3E90rNXot0D2qPGBziWF_RDKN5cv3_JBNUw&oe=6A1EFDFC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aap17-jk6EQ7kNvwHk_Tbb&_nc_oc=AdoqAPmtQ7hx-cM0ET4mWmAY1B6Gk3H9YQBqnA3LJDbGSZ7OBtYXhBbZ7sdU6zOP22U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TOfPAbpge9b8t0XfTe1cVjlKDHo5B0Q4oLnccT7_O0w&oe=6A1ED316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol_9iikKS_oQ7kNvwGlRcl0&_nc_oc=AdpOK6M7rIPIqbJIonbay-4Qnvo3IoK4oLyG0qUvqE39N3de7dWoQ4hMVAl4uvf0KB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XWCgMCGLe7Oc6hpSPUfp-J48zxu58WCxr84PIfU4yfA&oe=6A1ED17E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_
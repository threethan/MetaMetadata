.5771-25/38974900_266094237876659_1687494914046164992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dCC2_NPkf8Q7kNvwHfS2Xg&_nc_oc=Adl8HLOTLq2oqtiyhmNgYVO3De3s2UMXsmPvBq_hDBnLktyKUBEpU_IRkEITcr7VKOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKTI9l7T2iNgwjP6oRCpWGBcnu4bTcCBGeuTm6jcdIKQ&oe=69A826A1"}, {"file_name": "VV067w.png", "id": "243763273566981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_243763276900314_1006843181469270016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpR2VotedaAQ7kNvwHNXqIi&_nc_oc=AdmyxGOnNuBElqtm-pAF-LExLLx8Ugj0M1-mxKnOgR_Vky6SaAicEdT20kBKstOdfbA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftZBGbpTQMbAC3wO6x-f9sGn_0K5V0Asi1cNj2ktFKB-g&oe=69A81260"}, {"file_name": "RdYPzg.png", "id": "595364544415883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001725_595364547749216_2745485697107361792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW223huRymcQ7kNvwEdLR7q&_nc_oc=AdkzxHGy0UBX3h3NhatWP9XWEO3axWTE-NLH8t7a89Fn1GdDPqZAw4FCn-VlvVxvSEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuG584G12ywC64FSLcNYVu7gTxgx43jhODTC6TIzVMlew&oe=69A81EBC"}, {"file_name": "y6ePOF.png", "id": "557844284929377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974647_557844291596043_6844295750730383360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R-JV9qP1EQQ7kNvwFlRcRC&_nc_oc=Adl3EVfs9AiQRDjn7Kd30HZUytnw9ySAY9MxwW8ikxdsrXVGAyzmJWKHhCMtjQrjYYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTES8hzZp-mr8n6XvuRCvUPoWnVGnK4ASFWXlKjGlgzg&oe=69A82C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/4Rry3o", "id": "562980484651468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615890_562980487984801_1590634747162263552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6skLXZbdyF8Q7kNvwHrsehb&_nc_oc=AdkBGIdRdK5nr9r4_Ujbim0qXRAkFBk6z350SXBjBlHyxlI3HzYxpK6QsqjUPYS2z7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfszAVcZ_dffWx7Nxe7mRFs1EaNZI8gN1PdEt2mxEaWanA&oe=69A82A7E"}, "display_name": "Spaceteam VR", "keywords": ["cooperative", "party", "multiplayer", "team", "space"], "long_description": "A chaotic co-op party shouting game. Things might get heated but always work together as a Spaceteam!\n\nThe ship's computer is out of control, your only chance of surviving longer than one sector is to shout technobabble at your friends!\n\nTry to follow the randomly generated, incorrectly assigned, sometimes impossible to pronounce instructions and steer your ship out of the path of a supernova.\n\nComplete enough instructions successfully and you will progress to the next sector, each more difficult and so the ship becomes harder to control. Dodge asteroids by shaking your maracas, clean up alien goop and disco dance like your life depends on it!\n\nWays to play:\n\nVR MULTIPLAYER\n\nUp to 6 players, in any popular VR headset join in a co-op game trying to avoid their inevitable doom.\n\nFACE TO FACE\n\nUp to 6 players with at least 1 headset and connected smart devices, this feels much like the original Spaceteam game.\n\nSINGLE PLAYER\n\nIn Practice Mode your Spaceteam will be 2 of our trusty robots!", "short_description": "A co-op party game. Work together as a Spaceteam and figure out who should do with that flange!?"}]}, "developer_name": "Cooperative Innovations", "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": "https://www.coopinnovations.co.uk/privacy/", "publisher_name": "Cooperative Innovations", "support_website_url": "http://spaceteamvr.com/", "website_url": "http://spaceteamvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCA
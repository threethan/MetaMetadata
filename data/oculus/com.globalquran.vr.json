: "screenshot-3-2560x1440.png", "id": "1407225281494342", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_1407225284827675_5406894747100631253_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkKNaTW-oF4Q7kNvwELULRH&_nc_oc=AdqkOmc1nBtXK7MIZmYxq0zYusouHqwhhqQPTo196DQ6cga7SIJG3T6cq2GJ5yWomEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkwQgbS6pIHQDvHkqiqpJ9YECyo6EhujHZYt6OZ8EICQ&oe=6B0C6F4B"}, {"file_name": "screenshot-2-2560x1440.png", "id": "1822680352209096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1822680355542429_4847205622399647228_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RXclO-fNoYQ7kNvwElc5w_&_nc_oc=AdrM7hNHJBCdJueyr7xkRBBNLN_nTihc-IsAJVza4JtKbVNcIQ2-sqRdnnOlHPqq8aA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8myazLTUWH_PF6vjjCjcduPiRnGIAgVq1TL1hzSH8FA&oe=6B0C53E9"}, {"file_name": "screenshot-5-2560x1440.png", "id": "2017638255587077", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823910_2017638265587076_73321652008424199_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEwpZzxiMa4Q7kNvwGgsdRQ&_nc_oc=Adp1T0UpDNa0U8eld7meab8iKQf6iOWQxf9PwKRzcFSowHhUjsrRy7ost8ShVNWE98c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9gR4BH7rpVDypZuM-eE07_xEuiOXbgIgeFRdCoxlHvQ&oe=6B0C6CAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Global Quran VR", "keywords": [], "long_description": "Global Quran VR brings the Global Quran reader into your space.\n\nEach verse appears as calm, floating text in your room (or as a book card), in the beautiful Arabic of the mushaf, with your choice of translation and transliteration. Tap to move to the next verse, or switch to Listen mode and let the recitation play while the words arrive one by one.\n\n- Choose any surah and verse\n- Translations in many languages, plus transliteration\n- Tajweed colour coding, with a full colour key\n- Recitation by well-known reciters, and optional spoken translation\n- Day and night looks; mixed-reality passthrough or a plain background\n- Hand tracking or controllers: pinch or tap to turn the verse, play and pause\n- Free of ads, accounts and tracking\n\nGlobal Quran VR does not collect any personal information. The text and audio are streamed from Global Quran servers, so it needs an internet connection.", "short_description": "Read, listen to and understand the Qur'an in your own room. Verses float in mixed reality, with translations, transliteration, tajweed colours and recitation by well-known reciters, all controlled with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quest.globalquran.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Global Quran", "support_website_url": "https://globalquran.com/", "website_url": "https://globalquran.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1483610938159915"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2547460539073954"}]}, "baseline_offer": {"id": "2547460539073954"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794951840, "status": "PUBLISHED", "id": "2547460539073954"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "
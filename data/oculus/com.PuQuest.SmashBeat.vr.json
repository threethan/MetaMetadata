 for a thrilling adventure as you become the ultimate cosmic guardian.", "short_description": "This is the Demo. Cosmic Shooter VR is an intense and immersive virtual reality game that thrusts players into the heart of a galactic battle. for a thrilling adventure as you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.puqueststudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parsa rafiee", "support_website_url": null, "website_url": "https://www.puqueststudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25867691002854245"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031356_839190857957383_6892549243400403352_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp85TvNY6oIQ7kNvwHdnCoN&_nc_oc=Adr8hFHV-ail4nEaPFux0F3Vtw9-WzYXD3Y0PlasZ19xsIVBZzQSwDIHkN6V7d9W5y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QOqhaebq7Kse8oYmbRp_kaLdC9f0oiqHI1APWVqPq0w&oe=6A0DAD77"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Super Stellar Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id":
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZAzZ0DRLAAQ7kNvwHcfVTF&_nc_oc=Adqic3Irg4kdPmlXJ9oGfmZ6EViUD0E6uFsIrT-VdjSKrDbfJOunSgFz_XotkAIbUZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nqeacFMMuYwTzS9pwR7QuR6komA6RnXTMYGvt-7pXMg&oe=6A43E8ED"}, "display_name": "Leaping Monkes", "keywords": [], "long_description": "Leaping Monkes is a horror game. set in a cold, abandoned maze where something terrifying is lurking. The halls are eerily silent, except for the sound of your own movement\u2014and something else in the distance. You\u2019ll have to run, jump, and climb to escape whatever is stalking you. the game keeps you constantly on edge with intense chases, eerie sounds, and the feeling that you\u2019re never truly alone. The deeper you explore, the more unsettling things become. Whether you\u2019re playing alone or with friends, there\u2019s only one rule: keep moving. If you stop for too long, you might not get another chance to run.\n", "short_description": "A Fun Gorilla Horror Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leapingmonkes.neocities.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "LiamChii", "support_website_url": null, "website_url": "https://leapingmonkes.neocities.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10086004044755
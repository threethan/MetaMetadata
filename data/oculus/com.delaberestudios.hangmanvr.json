420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWpNoDEGDMoQ7kNvwEZUREl&_nc_oc=AdkPJLmJCzb_0H8TGTzros5LgEHRpZA7ZTVxc7iitFU3VxdsOl93mhJy7QNjgJOM0Sk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv8S120RelrWQyKF7mZ3yOI9_D7kTiZp43wDPrp--Jww&oe=69BD5DC3"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tREzhtIR9pAQ7kNvwGAXSYc&_nc_oc=AdmAAUwAZnn0Tc05Z3XpdHlx_5jszXga_goJ4W19qIj6vdf4jtQXXsW8P8sqVJUumu8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9HCQKTJUFbo7uqpTO8y13TGOXIo_ld4k3BuoEc-5avA&oe=69BD2C5E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkHF3k_ccbMQ7kNvwEhQA7Y&_nc_oc=AdkTgFNqwfFQVIIOnNp4G9siSfcu11oVA8fL0huyfC2fmf4LtSCU_AcynJ9Cv7JqMjE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtzfEinVI2kl8j6vmpD1OgafKvUeFWsQugDzb9nWCRWw&oe=69BD3F2D"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dj712dOYvUQ7kNvwHQlW1J&_nc_oc=AdlW_GLjHyAStE0yL7HP6lK7DOnSVjTQuNUBIwe5ezxwlBq4wcbznGpBqwiitPiwIr4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyw8EXcOvHlCtFunw0jl31EZm9PW1f-LLt6QA3OPy6Ptg&oe=69BD50DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xwdAoF0Tg0Q7kNvwE0fOI0&_nc_oc=AdkhQeTaOpVzOXWCxMf2cjF5wYRPNLayyQQPQNdjR6rWId29XvMTNoVe2qnPQGpROs4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiSoMnsZnTms0jsF7-JCGqlm39CZEzI9X_--gDTp5_Vg&oe=69BD3020"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
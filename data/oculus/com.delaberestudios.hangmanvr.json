5771-25/491820648_2200285120420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggFU1vq_TDYQ7kNvwHDLIUm&_nc_oc=AdpAerTaB7OSVjowuQdhMR-drnnW3B1DPoWo7H8DDo9aePOo0o07AJ1Zf4ZRKf4j-jA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnJGu_1CKZD93qqpT49xbzBgfVwCNN0WF1NXSE4par_w&oe=6A5A4043"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvKFqiPs88sQ7kNvwG_5xNV&_nc_oc=AdrJXyOr5Ve6dbVREwxh1wg-rFHGOEmSYz0JTCwkL6fccm73-p81QQiWWhUPsRPk5xo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt1_2ZOlywYek0uSzlyiDjJuNolNazST7AyCIHA6g7-w&oe=6A5A471E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_PwC588DTEQ7kNvwEtaTgm&_nc_oc=Adr00pwXiSSxGGuqJXj2B9t9QMzehGneYt1Yo3pUG9gS4eNkmY68QR-h469Bd5_98EM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhWlJLr3KcU0vaoPtCGXgrVqzRdl1k1CsuC3RiGhrPuQ&oe=6A5A21AD"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_Oz1HIqSFQQ7kNvwHy3MOi&_nc_oc=AdrdY5ZkCvF1moi9IjC5vktVVQ1o7ulY4dZ1ioV2zzJDglTRrVPjG2gRGSj3eaZxDpU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2lzkUSLzaICtPP6t21eL4efdHl3xe1fbFWFtz0JyFUg&oe=6A5A335D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_Y4qMIvL3YQ7kNvwF3mSgE&_nc_oc=Adqzbh637fIHZH0Mklcb-8PZ9g0CXStaURiDdueFPW63m42MLa7_3RC9n--4uFRNn5E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz2E7utfsOQ79A6uFvbz1Uo55-2Mzjx_Ag1-T1WyXy9g&oe=6A5A4AE0"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MO
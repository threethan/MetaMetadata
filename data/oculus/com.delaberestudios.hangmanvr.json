420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4keXQ8Lz2Z0Q7kNvwGAVVZn&_nc_oc=AdkGarxR0A5Dzn9V8bQgSzQXq-K2l49NUe_Qjkv_7qq22DtbWt0i3jdmIQhSHYn4FXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHp5Bsq4aVs31ECEHiCjgmQpvZO9db790d1ro5MKTSxg&oe=69BC0C43"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tREzhtIR9pAQ7kNvwFGpE5R&_nc_oc=AdkMRO6FV1yF6KnvaWpqi28h6OCXDlSxTKMyIKA6MS6exOF-vNCdAMKjUOWRdiqiNII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx2nRAf7gZxq8tmniBkE-sQVznO3q_fn_TAfO7brGc9DA&oe=69BBDADE"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=easTWRtim-QQ7kNvwH_lnOU&_nc_oc=AdkLPJoqb8NPg9U-LRLoDvip2B1N4ipIc3GzAJX2WojevwI2-m1_rgT_ibzoGtkSxSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaV7CndIQtbwg9w2RFBDI-fLFZuuE31sw4f4XG-JfwWg&oe=69BBEDAD"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dj712dOYvUQ7kNvwHb1gfJ&_nc_oc=AdnG6F2NAAqLQ0WRIX2rxw24OX2qh-yZwDX0pJi3mUkFrW3vKOX4c5kpDLGvTypfF3U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwad-B9GRj4DiKwjxh-K7YLA0E-nuwgluTD8__vsyA3ag&oe=69BBFF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i4CP060mKsQ7kNvwEy8wDx&_nc_oc=Adl0E14HgRzpg_S4KDp4SoMcOAq-8dgV4z3mF4go2r2n98oL3GDwym9vJ9ov8kmDa24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_uY163VxkCIqP5g_Caw_Ib3c7tnAKxygYfligld5DaQ&oe=69BBDEA0"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
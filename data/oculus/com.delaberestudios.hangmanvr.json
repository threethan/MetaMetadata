CCE250"}, {"file_name": "screenshot_3 (1).png", "id": "2200285117087556", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820648_2200285120420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcrXWPxrdKIQ7kNvwGQRs0A&_nc_oc=Adoic9KBlvAWUoWgnF9svfaeI1cWSmZbJ5kz6NyU-FGRaq1Hv18qSN6ToVO1ecv-3Wo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2m3aR7UgjmeHY5aaO4eWCJyIla-jd4sG22Bgvl750Sw&oe=6ACCF2C3"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcI-ZU-Gd3QQ7kNvwHH_uig&_nc_oc=AdrOT_JnASqfr_uSm-5UTQei73fYoOamtsbxvF6xR85phWFYygoO8bkEVCtQWpEkwcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ9GvjqHS2a12Z40nLZXZgxbfLM_peNG6_Zc_8h3hnTg&oe=6ACCF99E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaFwa6h-HYwQ7kNvwFq2KV1&_nc_oc=Adr1lSneHfccD2ur3K90DVD6PqSqqkX0woU0py7xrbgrxqP9vaOPWKMVF4XEBb-GGAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5NHjmj76vKY7ZCSK2p0C3e2XpdSSMtxpswwp9V-5Rlg&oe=6ACD0C6D"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmPwBa8vGIMQ7kNvwFvAIuI&_nc_oc=Adrwq7I7VadRQSq9A31XPr1Fygout3d9FIXe14PQD6iX20MX1-w5ZpEM5b1tpa1_S1g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5J7J1kYhDklW9Ia1ev9ZUFrb8YlL6nB8vBM5SmDliLA&oe=6ACCE5DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRa4RuJGICIQ7kNvwFG4ibr&_nc_oc=AdqTdW9Uxu0S6Q_o-7UaWZqSSDJtb-NZGMZqr4bS9Zt7_J1JXgt41xcLtQ_STTodgXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1ZUTi3UpMhjQXQ-x4inLFQpCZhLEq5GvgZoBxiaF3pg&oe=6ACCFD60"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscr
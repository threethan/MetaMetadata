46_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOy9etzTCx8Q7kNvwFtkEGV&_nc_oc=AdnvvyegBm5h7fLkoQ87yuAnkEtXZhQ2OHJ1ygkj0-fgwAlDgYrjPUa_cXWc3sLxkPY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNVva1YaRVjI0LJomiaFVKc93oOyxqLHh8L8h6GuQTeg&oe=69AACA2D"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MGCWsYESBgQ7kNvwGvBNs0&_nc_oc=Adkkgo4C7r3LAcIMPPExF66MDh7GQVex2xGiuRryIH0ZxkTsMeKjADHMYnE62m5DVmM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBcFjgCGmLPoNnIvkY9Mu5Rszc0FPZlY3R8IOaZegp5w&oe=69AADBDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHi_l62g9koQ7kNvwFeCygU&_nc_oc=AdlcxsAwJ6REPVskzpALlyBhMU1lws0qN0KbwXfMkRMLDOyPiXWvL5vqazNHmZDENog&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzazRXjHP9AD3_VbTLBndWLr-8R36wjHaPglDl7DM38YQ&oe=69AABB20"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7813050368818941"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1895023044671333"}]}, "baseline_offer": {"id": "1895023044671333"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751559840, "status": "PUBLISHED", "id": "1895023044671333"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8364918240298815", "version": "0.1.2"}, "id": "976329651344226", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "bin
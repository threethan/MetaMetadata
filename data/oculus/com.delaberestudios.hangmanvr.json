7a0a&_nc_ohc=DE4Z3QGXS-4Q7kNvwEsaH6C&_nc_oc=Adpoqa9uATBfC7dVZdTqaX3yOo5LIZObBjeNjpVrSJquaEjG4OpomS1DDFiPT1fb5Zk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0I_Quq-uDtg-1MYVVH-A8gNlxInms184THpvxJos7lxw&oe=69F0C843"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3x17Cc7iVwQ7kNvwHYYDBl&_nc_oc=Adocq8Kc9RmRdRdADD1_7rpFC3bIC0CvZtyk8M87qDP8d4hjwn3ieMtKgkD8fgYZqsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0LWttNMnmJJk-BNxvwhaJxn70hseap8fxfEjAScLA00g&oe=69F0CF1E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmcEL_lzuQsQ7kNvwGYAvRd&_nc_oc=AdovHNlkZBRYEguvEZAZ8GkMDQGUebB5DlHjLyyB6vAAwxRQo2cMiiCNhcTxkj7xY78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2S51tI6Wu1iD9-JzqI44MIKte-6AxJaMYaQou1b0JGMg&oe=69F0A9AD"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpWMnOXjgj0Q7kNvwGqj_qt&_nc_oc=Adqq737fWBxoldolnrwKdLdtaWxymDA9Po-o37vh8jrb-wsnjxwuYuplfSXw4RWWr0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Oc0SPu_9sUyVXv31QhVtVPrvYOQg3xlPC32pSsmQrrQ&oe=69F0BB5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLgHGazGJ1sQ7kNvwGDbX26&_nc_oc=AdqUCxAtRnLE7WvfozD-LewOH3lDJwYZZSY-sgEVnZ1ZLogIhlN1bijBivPW-l3rf_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1HaD_X1uG3dQpjf-ON6VDYLyHr89w0Z0tcBJfgxPt39g&oe=69F0D2E0"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWpNoDEGDMoQ7kNvwGDYsyz&_nc_oc=AdnBmiz2toXfgl6YRsi4y3Wd5geI-GZt1Vuw7mAlnq__9BBkFr77qhq7WtcjJtkde8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy-jYEPjVrtSA_rEa3-ce0oYySQIG0VPfL4XpXs495XGA&oe=69BFC883"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viXwkxfRI80Q7kNvwEVZLNp&_nc_oc=AdnNqcmDIferPxu5oTy4Bv-vZOfyRiN9yRl_WrXU438pCirnccdxPHiPI9XjUoHK4GY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysyBV7fcuxPLlm62XmuTZHYyjm35kPCAC5i7hGXwnrPQ&oe=69BFCF5E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkHF3k_ccbMQ7kNvwGlObso&_nc_oc=AdnGzAdEXcW8HCVYy98-rGeWVQXNR6tAiQaDfY_tlIThV0JkOIo2sFXy8F7Je1HBkqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDj9Xo-zFanzkjCTHxTNRs-UsDbVDgLX8kw4B-YIH4TQ&oe=69BFE22D"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17XU5Xsh-PwQ7kNvwEj-rAh&_nc_oc=AdkYsRu0mgmM-zG1PkaBBmlVLecA0NuWcDBuHbOT7SmQVD6qngE9FLPJvthDm34AG8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwU7Omr08yRTF5XjRC-M8Sbz1lKFr5d2Puqs41z2WYbIQ&oe=69BFF3DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xwdAoF0Tg0Q7kNvwGNnIrY&_nc_oc=AdmtXTOrnuBfs3Gc4y6AsO5feCZR8x7TueCF2k9RJgonL7sPG1p_6mjlbs2QDDh0Dq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzhvl-Lduob0qXDxC1WjHV-xi5tLZ9p2rdKjRy2K2zr8Q&oe=69BFD320"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
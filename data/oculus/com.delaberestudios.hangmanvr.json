7a0a&_nc_ohc=LtlSTdIesc8Q7kNvwHZYtfw&_nc_oc=AdlOcUJIg0lcKjA0-g6uuWMX37vtIL02jd0UUpLemZW0C_QQdbOgbF0tUkq2Lw9We7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftt-5RLO4psU404Uv6ykZeOxN1cpIn04FlvLntevMKAmw&oe=69A02483"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evFqWfLqMFYQ7kNvwFyDJv0&_nc_oc=AdmXV1DDkeCoimNPynEE7xsIqX6e-HqK5e0TugvigXYgQQtYHkqgQpA7lxBZusMty1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsVMh49MRwZppEq3EhhR-EN5VIeWU2xgOhaDnjbAzb7Ww&oe=69A02B5E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jk8SGMYoGewQ7kNvwEPT52Y&_nc_oc=Adlnh9aW4n_8u8_IPgTf9WUVpAne_UUNHheFERK4KJ5CQVbCLBDfuJUVnyGE8LXcFi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsxPRsBtdRYenebYEPXbXYSxJiRTpZhMl3QfsoM75ONQg&oe=69A03E2D"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8N23OnSQekQ7kNvwGTEf1j&_nc_oc=AdlzVBfwisJI1RZDyzcEX_DzfPcc9awgfCRenOLm9mxh06YXz7XA93kX71qb0V2UoMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstLNluvIAdVI717GMJG5QIIYHLEogArX96HV8H1f3rbg&oe=69A04FDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KC1ePc_jtygQ7kNvwHwvWGM&_nc_oc=AdlHBU931H1y2HJKe0-kQnbmHoHVaYBglEOcqXGQcMTWDeytm7nS-rZzcZijdDuApa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsy39ljZuRJntTHrF6rS-TNXTMNg2RX4JSBSWmMzkpIYg&oe=69A02F20"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
7a0a&_nc_ohc=n6WLosXWlm0Q7kNvwFcPuPN&_nc_oc=Adn1ORel3XuclbmpKYwRFn4ef1Ky0RqukFnXAhyDG3Q37NaugDe4rmKh1vhJLkwxrwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuGpRI685Cn_fdGKkJeqZHn4zpiTLQLS5DiRoz93T9HPA&oe=69A41903"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwlBHeUagtsQ7kNvwHIB8Nb&_nc_oc=Adn7kbqxgMjZwmQo7jS73k-zMFiAZ2wjD98XljrmCZg8LuhNPl8lZJiCXIojIFKfJXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu-VMQKkH2eUDAkVXkAG1iu8XStbcV6YT1sroZlJzgxZw&oe=69A41FDE"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvjZsczFd2EQ7kNvwG_5feP&_nc_oc=AdnkHZ-lsHK-1xhyh840Ns2AN14LsihcmB919sW6X79q-fNdS6SSnMnpjCPKdVn670E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuIW1R8lgO28qmaP5GQQpUEz6z5BjH_VaPb3Ohod9pzUA&oe=69A432AD"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjjywBXbTzcQ7kNvwEczC3-&_nc_oc=AdnylswF6nOaQd19ZG3KPg-xcFnAjHgeed93OURJ6FcChlEEOAzEsyPhiN_HUGYkQYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftT2Te3FA4tF4MRgjmVA2TVHrZUBHh4P8WRc14i0jxunw&oe=69A4445D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVS6wnu9OMUQ7kNvwFu0cgs&_nc_oc=AdlAZMTM3SEctXXfJX3TJQV2CtfsDIkC9Lk9Y8DLNftWpIiLPOeTx0cwSigVF8OaC8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuegNOZL9Pb6dh_6k-ea0-M3YMEEjlyW5Etx4hVSuzzog&oe=69A423A0"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
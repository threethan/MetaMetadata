420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KgNuRa_bwgQ7kNvwGrHICH&_nc_oc=Adk0q4K3nhkesqjFsD2Sq0Y5_GYO386aL8T0jrxY4AgNQZNH0wOSFBouy6rQ-zK4oC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUZmqmHBRoSfkwEQTohQkqprUzaFNdRR23jAnPpEqOaA&oe=69AFF683"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZrwhuQphOkQ7kNvwHvjiRu&_nc_oc=AdmL1n6z3BsuTAGSKL_ylg6_MTRz66ylzdhAMDsMJjNGb_4bT49KcGDg1t5yLwUIFwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwdmrua52URJsu1JxBuDTZ6CVpQQkixgjsPICsZHO9e5w&oe=69AFFD5E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2x_sVs8FO8kQ7kNvwESWevJ&_nc_oc=Adns7VC09QgIUxA4MwZRqTpB-C3jglPiHWZXyuSzJwh7_SFFFPX-_tGNkMItbMLYAVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw396nA3xqV9MoB-KqAHJXTpd6sL-6-aVdZKiNXWWbfGg&oe=69B0102D"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE-v4nQR4dwQ7kNvwHTwOL3&_nc_oc=AdlwhZIWpjs36Z8BXa8XoJt8KWmS7F6EAbsNCz7sCDk19lHT6dS8e383wS9uyovGaUI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfypDKMizLBYd7vJxefb5-4d6hJDmUlC8G_aaT7AJe8CUQ&oe=69B021DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoQUw03v6lQQ7kNvwExjlS9&_nc_oc=AdkjI3uShYG45VMImZf2d9JS4SWBKIX_9_Lwf2aXlzOboowEDm_HOc9WbD7mFxY-m90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0T-x4yCo-NKLwQCwoX18N78_S14wNu9OCiA5ZzksQeQ&oe=69B00120"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
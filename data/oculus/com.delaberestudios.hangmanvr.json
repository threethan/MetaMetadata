420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLnopal--jYQ7kNvwFTGTTb&_nc_oc=AdngkhugBRrm28clnnHbin5T5qsjNKr9RsH2iPMZ-9ApQg9JDoVfgGjXhjlZkcF1Wm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzW5weun4aYzrvcrH5tsK4i5WX8WStJJDtlrEwZlJmLng&oe=69B3EB03"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnipZORIxVMQ7kNvwGxA-VO&_nc_oc=AdnFx3iOaXDC97op1l2QGCc0Mmzh9QrnGsENjxIa7PPqbdPTYv9BNbvJXCg0cas_Hlw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwebJcH_pkrPRUwJHaLW4cPSYHPyhGi5ZVFKeLH08Fq9Q&oe=69B3F1DE"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOcbnqHmQXwQ7kNvwHq5dNB&_nc_oc=AdlsQnmbcJBiCmuVtohMiX4aCtSKb3HY2C8FIVenff_fH9HMmUlyzZCk1Xcb0bhANqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbIdNg45npPkAGcvvZLPNGkbphKe-RInlx9mxCTW25mA&oe=69B404AD"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNyAt4obpA8Q7kNvwGVRsOU&_nc_oc=AdnThXg9gOr59dn1LR3M8KEWS0fZxEGKVrN6FZKEvT5VIDSCSri71ADN6KIWxzdl6hQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxPiAFjeb-Wnc8UBmFCXHqY3BJyuSzKICekWoyzAbSwfA&oe=69B4165D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELEcKtsNNaEQ7kNvwGQbyE_&_nc_oc=AdlQASl63S1U2y80Bt3rTuPWP2wJSbJua44ZdKrkLgDYl5PG0UVNGO-q1MF2Vp967rs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyO8LAu4LWg5UCkjpCwBs5RxdUmAK1J_0FkX8OBbUXg1Q&oe=69B3F5A0"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
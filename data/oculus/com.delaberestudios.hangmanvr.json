7003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CHPA7oQ1I8Q7kNvwEgQjpk&_nc_oc=Adrq-hN6hjhkj6bT3sWaqplbp1Mmxfloe0Q7lLxhR4LNcZtq3fsldTEe8wMDGwVB2MI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITH33cyGnvMonlpypeF8uA5wVGkmF8DmI5Czw-nK9f4Q&oe=6ABD2B60"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscr
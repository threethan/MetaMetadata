5771-25/491820648_2200285120420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoNVN3D_AKkQ7kNvwF-7sWA&_nc_oc=Adpmd_KCg9rQkph-jmxno9yJ3QMyS555F3Ljg4iKqCC9wiGgvqNnj7z99PupvR6Z7LA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WxEdZCLbFbg1HXxStAhgyX9V6G3VYrFMMMGlKL8T-OQ&oe=6A15B243"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJtOr3yttZQQ7kNvwEFYrLq&_nc_oc=AdrZocmu7w6xEXR0h-7oLXUQwucU7adyh0X1KWO6s8hBDsbU0H1w1mSbYrKEq4fWo4Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sT3h1H5WowUTta8ptSaPBx5Lze3MfUiF78RJd65jE2A&oe=6A15B91E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DNbwNNZZrMQ7kNvwESYnZ1&_nc_oc=AdqmpvtwmTDWzf9LJjrnvrKarc8DPS7OWgrhh5OJRLwVo-QRfWPQPG6gM0ziGQNBec4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hJE0W1rsytFfzFVLoI-dCSZ3MljzfBzxMSQw4C_Pr5A&oe=6A1593AD"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DPwXZw4QjUQ7kNvwHxg4lj&_nc_oc=AdqA-nqhUUKAUazLcnalDznaKaA81PpZ8a6xcTan0qpUbp42TQCfjV5_1wGEcPTQlXc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55gxYO0b6TQfeulTEwEl05uLR36TwqAImDco022Y3PRA&oe=6A15A55D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpHv9jE6BWsQ7kNvwFtNx_7&_nc_oc=AdoPp3rxmNrelG0PyWeS11p_0bSmHGJ5IAwTAUpRwTbepGGyaeoh7KFfOFItuFjNISU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dksB0Xs7Ov4C2zsxz7oDUoyeszixodBNrp8mwHX4w9w&oe=6A15BCE0"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MO
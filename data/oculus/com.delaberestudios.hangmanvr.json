5771-25/491820648_2200285120420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgrwPUjrX74Q7kNvwGCTHQ8&_nc_oc=AdqkE_IHjs9i_xvxGzb8uhXpqlNMevJYHT6DeNZz8XxB9jrC9l2y8OYmCO6LVgwb-mw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J1FeELPsjQltQEiGsWzeSZLrfwwtIhayN6Cug7Xx3gw&oe=69D3C743"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrQDpI8pl-sQ7kNvwGkzPGv&_nc_oc=Adr54CDBBPvjJh-ErQCJuFP3IGbDG_CE_j8SJkOtdRZr4Bk_6K8S1AYMnFf6BaImFx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39C_eH-kzGz0NCqMugYuDPCxuuKUVwzQGHcr94JcKdAA&oe=69D395DE"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMM4_Wj7VRcQ7kNvwFvhQIX&_nc_oc=Adr9N1SmyOxcpsvxNoROQ2OiYD16_lB3g1nT_30Ut9AO8H7KNBmw2bq6W4Ux8Rg5pqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rN3dwlx7yPgem6BAEkxBru4Aq12XwsW22Y0tzMC--Gg&oe=69D3A8AD"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLZkqwtim2sQ7kNvwFaVivs&_nc_oc=AdrH6C9wPvdr3ZNSfiRAQ1b6G7aP5_PueCaNArf89EZrO2viZPo9CDi8UQDABuM1YC8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rMcTdFY7ulDwVmL8Ryr6fArzukDG0x1Pa-GeiNjARcA&oe=69D3BA5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ec1YYj5FzEQ7kNvwEQBGTI&_nc_oc=AdrngryVI66qERZ6fSADNlvsrBlSv5SbHt-NyBWHfo5rA_TtnACKdhwxyjMbtwdcLD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Pv9R8LXBdVv4NfCxk2awwpTtN_6ckWlXRcvxcZ4kkLA&oe=69D399A0"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MO
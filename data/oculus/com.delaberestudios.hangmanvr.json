m/v/t64.5771-25/491820648_2200285120420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw_A4dT2yKgQ7kNvwGGqLpz&_nc_oc=AdosBGKJPJ6mY8suRNh57S53jJ-qxHpQNDTnqof183jvZKNu1Jlpz6edbHsIT9LWBZQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lNbN9TnLD5c1n3CJmlENGyxLzGoey-uzGg2qoBobdGw&oe=6A394AC3"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBNkobY4SSMQ7kNvwEPau1a&_nc_oc=AdqXWkabW-Wlgbw6VkEG2smbZmAuCaKS7VOQ57q6ER7B0mUeEk8vFoXDqq_WH_hP7UU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QBvywdGg0BrosgZxlI1Fu-WV22dcwxMs9gNTlGAdNqw&oe=6A39519E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh3N5oQEM9UQ7kNvwGkVxi-&_nc_oc=AdqLsy-CtivfzJsrrOCtEUfq9V8OuQyFwl99LNSQhAwNnUP7Vw5QZxFtRI1aUza-ook&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ctTLo2jieA4_vQaldcNK7nEYjScm_tQQct9rS5uH8QA&oe=6A392C2D"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCkqepIokOQQ7kNvwGQ9gLA&_nc_oc=AdqIg3LL8qEoIkWdsqL7XwkjE_G8RA-Ssc_QyMCI20Bi_4rJ9wnLq-edolQW5giYv08&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MkewBD-CmIuI29qq-JFyy8BzPV84xzkS9VNIkBeDyCg&oe=6A393DDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc2-U6MzDNgQ7kNvwF7NSJN&_nc_oc=Adqstq9EIXtrkzgndUHSqLzPEU7h9iMOcuZA1JiNu7MZD-kHUHznFeGIqj8V5pusJJs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XTC_kMKPJMCUCFrawI-Ix2b_vxb_KRxNopsRX4Bwsyg&oe=6A395560"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7813050368818941"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499296397_1880546742799848_1769467322813189381_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X98bQLcH-vMQ7kNvwFZT_xr&_nc_oc=AdoJXUMqpFlTWOcP968iOY7Xwil1sb5l9tosUDm874QDDFs2hNBEizSerMJQRwWYh6c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vray6mO8zNu4U448FVtO0pKgooq0gWr3VbyWKwe0McA&oe=6A396142"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hangman VR - The Gallows", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1751559840, "lastRevision": {"nodes": [{"id": "7813050405485604", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7813050358818942", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1028320959396426"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Hangman VR_2560x1440 (1).png", "id": "9984025561633754", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499311579_9984025564967087_7423959425447207192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ejYWXI-v6cQ7kNvwFVTBVW&_nc_oc=AdqyfzVpqa8uoXsGLuApPanPNlpqpyKfaos85VQey-P1O49xLWy3saZeX84Crf8OK1I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SVt_UDo
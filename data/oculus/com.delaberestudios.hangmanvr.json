EB34D0"}, {"file_name": "screenshot_3 (1).png", "id": "2200285117087556", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820648_2200285120420889_5205110469503252391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE8LPrdPf1wQ7kNvwGl8JXr&_nc_oc=Adokf18j5JtTnggBuCna53ZMsXuJPxXJafx1rDwarwkIN-niDOFhHKbjQJ18TtfDzRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRey4SlBo2RESTeLcGw3gk_lJXvRhCgzhAVudc5kFqQLQ&oe=6AEB4543"}, {"file_name": "screenshot_1751387050220 (1).png", "id": "1623599618334985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_1623599621668318_4742881516908957672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS3W4Sl1EcMQ7kNvwGKK9dr&_nc_oc=Adoab3WYGMuYs78Q_zzgru3wgEYCp7A1MVo33SP9ZpD-rBOi8b1EwgCarPv3lJMLS1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6bgpe6jjfxz--h93QyQH09jFXyy8mAzl6QJEeq4jdew&oe=6AEB4C1E"}, {"file_name": "screenshot_2 (1).png", "id": "1120481056588429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822883_1120481059921762_6924211115125984746_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgZeKvDxmw4Q7kNvwHMlxEv&_nc_oc=Adp4QbYNXc4sblip76trkcLeeX_iAtitu5H0FSMdbhKXcbOEfdGf39CFUJPs-Chr1kk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx7fO3mG4uQmLYikXBp1_czpYMvTkzR6S6t0T9klHdvg&oe=6AEB5EED"}, {"file_name": "screenshot_1 (1).png", "id": "689895913877381", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303303_689895917210714_5968089483835986143_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6naDpRXzrcQ7kNvwFq9Gj7&_nc_oc=Adq_mFG_gzKg-rtO6BXv0BLmwoZN2cM8nR7djPB2KlHX654eocXhd0x_Jl-_Wblagy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaPo9tG2ghuL9GQ4maTXujheJ1BeSrdrYfFBnURfIvkw&oe=6AEB385D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman VR_2560x1440 (1).png", "id": "1127003109449112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_1127003116115778_3379050238488772311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtTVLloFF2QQ7kNvwGegjdQ&_nc_oc=AdqByANT3tMsyagPVgu2FmFnSb1wSnVdO2zYVPWGowEBWPsNPzqudSzfAFBg5VJjHPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDcFZGHQjIG8kWBCGS3HyadGy4hSZ4iHL4nVUG9uZHBg&oe=6AEB4FE0"}, "display_name": "Hangman VR - The Gallows", "keywords": ["Hangman", "Puzzle", "Word", "Horror", "Spooky"], "long_description": "Welcome to Hangman VR \u2013 The Gallows, a grim and immersive reimagining of the classic word puzzle game.\n\nArmed only with a keyboard and your wits, you\u2019ll guess letters to solve hidden words\u2014but every mistake brings you closer to the end. With each failure comes a chilling consequence, as the tension slowly builds toward your final fate.\n\nDeveloped by De la Bere Studios, this VR experience blends spooky visuals, atmospheric music, and interactive gameplay into a haunting, slow-burn thriller.\n\nFeatures:\n\u2022 Over 3000 possible words to test your vocabulary and nerve\n\u2022 Fully interactive VR keyboard\n\u2022 One carefully crafted, atmospheric environment\n\u2022 Multiple difficulty levels and word lengths\n\u2022 Spooky piano-based soundtrack\n\u2022 Hand tracking and controller support\n\u2022 Dire consequences for wrong guesses\n\nThe gallows await. Will you solve the word in time... or join the others who didn\u2019t?", "short_description": "Guess wrong... and you\u2019ll face the consequences. A dark twist on the classic word game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscr
4_1048776793768718_2318084999794971608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKX_lDz0_1AQ7kNvwFpsq_L&_nc_oc=AdndGBLb401qY6RokCn6GKW2oeBB6iNqVEEgwCFIKWEJ5pzIS224Hj7oYuL22Y3ZUw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftnYrYuJ5HJaCwlkD9-0rx7B2vY_ATjtDAEd1g2yULeFA&oe=69A6E026"}, {"file_name": "TOS_CoverImage_Hero.png", "id": "682857431136841", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_682857434470174_8346571327920207039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNjssivkAQYQ7kNvwFAjIBv&_nc_oc=Adkzz39wKtgg_nXFIEwQCFFY-5uHXw6Y6H8kruEin-7sbdMUruODLaH9lspQirmUdgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftnMlz4SRY-Q-aSTLfXnD2fBwMgSIeTwLRvRBViOyc4GQ&oe=69A6D3C6"}]}, "id": "24843091272042167", "locale": "en_US", "screenshots": [{"file_name": "TOS_Preview_0000s_0002_Generative-Fill-3.png", "id": "1126272779608581", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1126272782941914_5858772614245939083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qp7D9BOfcT4Q7kNvwEz9AH-&_nc_oc=AdkYeyVPGP_GVg4y79IRliJacMEON0AmWDRVDur1yvrW2CeaFB29UTOcJuU-wdBV0do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsjiL7Kmycuxd2V9Wsgvds4kcpUzrloTn69DUai_P9OrA&oe=69A6BEB7"}, {"file_name": "TOS_Preview_0000s_0003_Generative-Fill-2.png", "id": "568350333006706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_568350336340039_8845270819364117805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwiK4SbUW24Q7kNvwGIOjNY&_nc_oc=Adkof8Xoc_7T7ShWKhWoym6vWSjM5IyI_fAnZwy_raGDG0b7YQ0PxQkNpNZ_u5p9zF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqmegobJGMArYtJFoJ_d8cWRxr2LWNvlQNf4z0wvHwug&oe=69A6BCF6"}, {"file_name": "TOS_Preview_0000s_0005_fill-in-the-black-area.png", "id": "830633009487908", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsb3oGiof-8Q7kNvwF1i_XS&_nc_oc=AdkqoeM4BgRe_yvKizcjBCRETOg1ohmjoLueM_a_ywinHG4VNoeh3vfswSUFBtEZmbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0WGn8tDp1rc7riST8QU_fVVH4b5c-4T3wPcA6GcV0VA&oe=69A6D2D6"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wulzDE7-xD4Q7kNvwGZ81fV&_nc_oc=AdnIILdrIQOiapuqJss3vUhQZ0d8mGRRbidglZiPFEHeEXVdmd55NBOlWVdYSbMD9SI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjHr684Bw-dDR1BZsMwRy3E3sSPLsI15C7OKjcTgOQzA&oe=69A6C2E8"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OG9iGAEYVzMQ7kNvwHqRw6H&_nc_oc=Adm816QiH8V8E88mghh5xyKmoTIBrT4d157bUVhQnsCd2VtbiXilTPLr4AAhEwzmTgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6y6FN8CoIqj9iiuYddmiGkx8038pNEjMbBd9bhJjYHQ&oe=69A6BFFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRavVc4I_YAQ7kNvwFw84us&_nc_oc=AdmxW7whlATa63KRBIsieaquCB79QqdPUGB5fb5ILosMOpk4N8-y574rTNUiFf17Wnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsz3xC9zHjapSxPxRWUpec_Whx0Jtj4NMA2w0TdYVmcjQ&oe=69A6E1D3"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
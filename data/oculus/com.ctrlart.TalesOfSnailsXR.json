=6HCrV1zxVwQQ7kNvwEmv1aR&_nc_oc=Adq1uYg8U5qfbmfReo9lHhbcMyOIxFGmqrWtLbD6iZPrpbgYaWT10snS6mhgEd24oz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lcEDRDgV7QHCnk4x5KbndEmPzpm2TvpG3gpcrBIoXVg&oe=69D39938"}, {"file_name": "TOS_Screenshot_01.png", "id": "620044834249336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308050_620044837582669_1894285565623121398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCGt0zrdFD8Q7kNvwESo1Qg&_nc_oc=Adozn9mqkoxbqv92cAhTZKylbR9ZZDxWfYyFHp5U5fc_TM-th2xsyIeG3M9EjdGbjxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xdPiHkf-Ghmf_GxWPa2_xmxDzDQkZ6RCUJbioPAoETQ&oe=69D39223"}, {"file_name": "TOS_Screenshot_03.png", "id": "1088837863354626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298291_1088837870021292_3433600990104671402_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF0repONczkQ7kNvwEim-S_&_nc_oc=AdpUERRavX4gD98CJo8BlO70MRW7PmpjKJxEYwr1Nz0g9ggEjlcmf1Tzqcp0QqLF088&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X9CM_CROI17Wd5_LPczF94R0I6MbXLT-MliRySzqIyg&oe=69D3BDEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STA
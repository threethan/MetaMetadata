4_1048776793768718_2318084999794971608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mduWFih7V14Q7kNvwHa83Yg&_nc_oc=AdnUJHcbTrk2mPV2F09QAgHpIO5aZ_nLHE8qOb-2WmnkgJnIVrbS-63iselDyjj4WjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsnIpHzY2SKFWmCN7jncbtsAVzH40RsyNlEe55VQl0T0Q&oe=69A2EBA6"}, {"file_name": "TOS_CoverImage_Hero.png", "id": "682857431136841", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_682857434470174_8346571327920207039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS8Q_wv4ULwQ7kNvwHHi4iT&_nc_oc=Adk1vHjBDxk0r5XsXsjhY_jumPa0LuYYp9MY5ydQm2e3_A-xcDwPkn2xMzOiexcgN5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0BsfNFrS6DJyW8LNu7u-WxIVXvp-qFJ_M5QZgf148RA&oe=69A2DF46"}]}, "id": "24843091272042167", "locale": "en_US", "screenshots": [{"file_name": "TOS_Preview_0000s_0002_Generative-Fill-3.png", "id": "1126272779608581", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1126272782941914_5858772614245939083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msHQVQZ1Uh0Q7kNvwHNP4DD&_nc_oc=AdkYigDMftWB-vVlQEl-bAX6zMax7BxsT49iDyFT2kDRvVz9YGys9jAyqQKw5qhzZFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afshx3jOr9vmxH2bW_SInSwVfcvrD0E8qCswx9ZfSMsnMA&oe=69A2CA37"}, {"file_name": "TOS_Preview_0000s_0003_Generative-Fill-2.png", "id": "568350333006706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_568350336340039_8845270819364117805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUDx9pB6OEkQ7kNvwFuEbRG&_nc_oc=AdmMM1imbcZJjPlnrnDZZ3okEbg6MndtD98MTFaXgpTVtgP3JaeCmroiZ3HkhIEvmfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftc6jYgzZLXiLa46qnZWxf2bFWlRVurZYu9WAUgAgi3eg&oe=69A2C876"}, {"file_name": "TOS_Preview_0000s_0005_fill-in-the-black-area.png", "id": "830633009487908", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEeGFy0-rGoQ7kNvwFBr7fq&_nc_oc=AdmT8-DtNBgyNNbmsficpqxfVIO3NXsX76nYuKN_B-kI2npCl2WSTliIhj_PW9dG2q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQLvGw8I5PkdejpmIwYX1oOewirxSBiEDSIE2G3aO62g&oe=69A2DE56"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOi4IqMsadcQ7kNvwGVRPUV&_nc_oc=AdlOF72DcAV-LA-CHQUE7HJsB7mBgQ7ssqTXuELZVUlzhJwBOcDFzJPek_NayYJ0vzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsO996n7kFBtQ7vMlPb2b005Dh5F_VZZpmQYkr_wCruAg&oe=69A2CE68"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19irZvWWAR8Q7kNvwFeBtxZ&_nc_oc=AdlIjHagiL6boJILL7qa07M4ccy4Mrq2kc8COmKgoBYPUihqZxr9-lfWK0CmL-tTcyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudZiXN3JwP6eiqdrqtLRCAlm2KCtZFZH0adQt8e_FBZA&oe=69A2CB7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJoA5jbW5dgQ7kNvwF5cXHv&_nc_oc=Admm-MpT6L5NDFzH8VxSatY33tv23G2ReFTEL0nyuXvFQnlEGQ-La1w1hlw9sKwv7g0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvkOk6GmgWnyJzHV84sJ7OmQhM-KUzM6G8zZKavKXuUtg&oe=69A2ED53"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
4_1048776793768718_2318084999794971608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdL6oC66zk4Q7kNvwEBMitt&_nc_oc=Adm6P-EDDh0G8JdUvsSzG6ut8kIN1HH3su-JCUR_mIInAUmwSp8W3ki2GCzCgpMc90Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfttBez6cZpqMi0nDvlTVAbJGsZj_GWe9zqD3j1ob5DiGg&oe=699B02A6"}, {"file_name": "TOS_CoverImage_Hero.png", "id": "682857431136841", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_682857434470174_8346571327920207039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f1FHs8k7v0Q7kNvwGcrQV8&_nc_oc=AdlomEN0bMLVMet3uFWpIk53VfGWLlCeuddhSFj-h24RB-P5GMDUYd0sGDEYaGUY2lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu9fcZiHTsWFLiUJRcatLa5X9n1OCFo5m-J3Wz9G0HeDQ&oe=699AF646"}]}, "id": "24843091272042167", "locale": "en_US", "screenshots": [{"file_name": "TOS_Preview_0000s_0002_Generative-Fill-3.png", "id": "1126272779608581", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301053_1126272782941914_5858772614245939083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsurbNMn6gIQ7kNvwE3eYFF&_nc_oc=AdlLWeikNqgyJ2zJqRxQwt4nG7kRuhfts8YlRL0fs4mY_5RDUNY0CBR9wa60c_G4jIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfthbJ7hIXZlwWUtUCcSYdxKKAz4fx9K5mleQ_c5TtKcwg&oe=699AE137"}, {"file_name": "TOS_Preview_0000s_0003_Generative-Fill-2.png", "id": "568350333006706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303198_568350336340039_8845270819364117805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bQo_7BycRAQ7kNvwGueqAM&_nc_oc=AdmngbmSgMR7buvqfcLZjWlIaciyxQTrq5KxWEp6JkbnRlBZYWu9WHEMK_Vm2z3FP4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfshhZQl_NBKAoH4Olsl4LeyyZFpS9wE5K8xWfD2FQkCPQ&oe=699ADF76"}, {"file_name": "TOS_Preview_0000s_0005_fill-in-the-black-area.png", "id": "830633009487908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArGEcUw8t0IQ7kNvwGF-MsW&_nc_oc=Adnk7DuQskb9gNCiOQnJNSILH2BeLJKTQElakSHWJRUf8DKVI9uCn0cb0Mdqq89lBPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuRbm8JYrWmIMzG4ZKUFnf_iulXB_n7NXaT4MnTVTpNtg&oe=699AF556"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZFcmd-D1PoQ7kNvwEHMg-A&_nc_oc=Adkv2cuK8BgT1e4NXXN4Nhkt4CSGV0CusikPeeLPSl-beTfR2-UqwSV8DDLelGEJ4ds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvTLOgaTAoOoBY4VVrSS70kTmM6fVMEVuyPilmCjTwKiQ&oe=699AE568"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gY18cydaqOwQ7kNvwHaLIi8&_nc_oc=AdlwOaZGoZ_1jYl6GIpUz6NFIRC5ZUmN3Dj54v6a5GpeIkmYvnb3SdDRZtCniekEHz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft7D2cLyF5Ez43QEly-sortOhw2dtezsGNsqrYbYudr_w&oe=699AE27A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W66k4EgQDjsQ7kNvwH5mYHt&_nc_oc=AdmSB_x4emtnr_DE8fX1qxVUuT6Qe8YfbgdEJ3l5aFByH63l7X9ImNXsXsBpL9msaSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1jjgGjl5e2nZ9eizhk691UQMLP9VIIM8P2UifFrY3Uw&oe=699B0453"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
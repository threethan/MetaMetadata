4_1048776793768718_2318084999794971608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKX_lDz0_1AQ7kNvwEqT1AE&_nc_oc=Adn75yWy_i_X3LPyBpJpRZACKbGSIISk6G5H_bADbnqzZPlvsAhdeT9D5_sLR5BRhJ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuCDUtXGLbfQCCwckXHDkBy3uHqlvrK8GUfrMsEcWazvw&oe=69A58EA6"}, {"file_name": "TOS_CoverImage_Hero.png", "id": "682857431136841", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819982_682857434470174_8346571327920207039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNjssivkAQYQ7kNvwHFr_v9&_nc_oc=AdnGHTCk88ZmP0F_L3mODZIcYCsqfFn1kyXe5R1KuFwtR1jNW0QZ-vTisO0clcTqqJg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv_DzAEQ9_D7GvduOgQ-nzfCgFGUWShwaYQueigXBdMZg&oe=69A58246"}]}, "id": "24843091272042167", "locale": "en_US", "screenshots": [{"file_name": "TOS_Preview_0000s_0002_Generative-Fill-3.png", "id": "1126272779608581", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499301053_1126272782941914_5858772614245939083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msHQVQZ1Uh0Q7kNvwHJYx6V&_nc_oc=AdmuD_1g30kVEKOMLZQduB4C2arnKjPiOPgUCwxLeHCGa0AEJ_5yObMbHGHN8LBixRY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvTPyPUUsBWfdN6EkdTgz_rqy1RMuJxLU9ldcbz6_kJ_A&oe=69A56D37"}, {"file_name": "TOS_Preview_0000s_0003_Generative-Fill-2.png", "id": "568350333006706", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303198_568350336340039_8845270819364117805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUDx9pB6OEkQ7kNvwHVozdl&_nc_oc=AdnsEVyKatiFRXgIoc_njwqJW_ldve8Qo2wr4oPZh8ZyQFcHNurhFNZ0y22Hqd8g1iY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv0CRavOFYv_v_zec_JoFvpan_fcZ_rbYW1Fuf3O7whWQ&oe=69A56B76"}, {"file_name": "TOS_Preview_0000s_0005_fill-in-the-black-area.png", "id": "830633009487908", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsb3oGiof-8Q7kNvwHai_YL&_nc_oc=Adkx-4d3XdN7yMC5AYhwj2UZgp7n9nWR7xlKJBKT6QXvbLEv8s49L1u3InBlct9B8Tc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftoDfRsblOm2subdeQIPgaiH31HcXP63IO7BmS-3B-HNA&oe=69A58156"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wulzDE7-xD4Q7kNvwGDOqpY&_nc_oc=AdmUeezDvcWFB_k2sLgG9ofmiqrgihZXpGwyh0mzN3PZNCriDfAa9wLKwpEuAA0hJsg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftL4CwRa70xVQ2nihMeqY6pUuEgIPUfg7lZxhU5_TMnDQ&oe=69A57168"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OG9iGAEYVzMQ7kNvwHVtMZ1&_nc_oc=AdnV5Kuh6U4GEMY2oWxyS3OwUMy9k6bNDOeqgdzSteTjNA_nEqUbM480lerjs-41cLw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsQMSfZSsbMo93qyBdvBinEubjUeNT722khuAzijFiVEw&oe=69A56E7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRavVc4I_YAQ7kNvwGl_ItF&_nc_oc=AdnuX2HhOfKFxGDgrwAkQ1r1pjfQtdGTHWVpwJv-8GMUW80yP2HBRL1UW1ZXjA6kIMA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsCtK_d3TVdO7wa0rSiUycbkPSiMDPDxbjpXeS37JLiCQ&oe=69A59053"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
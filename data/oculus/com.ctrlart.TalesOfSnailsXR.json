4_1048776793768718_2318084999794971608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lptydo5oiTEQ7kNvwHnGAad&_nc_oc=Adm8VC2elhBwSMutECMrGcWttyyk_Nw1ftiJdVZ3QrSJWBVI-V638ZVYGySJTUBSq0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsluwywLJFg0OgoTnEWUOrfUKeLOZWAxBoSBLPpvKSRAQ&oe=699EF726"}, {"file_name": "TOS_CoverImage_Hero.png", "id": "682857431136841", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_682857434470174_8346571327920207039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrz3SYVj66QQ7kNvwH9-zu5&_nc_oc=AdlY_yRv4oEWi34Sy80JdIAo5hQr74vg__sQcSYyXo41kuXNwxouXdcIOzCzznJgHMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvMSxLJsYt39WFQ055LYKtl3D68nkFWJf5ncZKwhenLqg&oe=699EEAC6"}]}, "id": "24843091272042167", "locale": "en_US", "screenshots": [{"file_name": "TOS_Preview_0000s_0002_Generative-Fill-3.png", "id": "1126272779608581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301053_1126272782941914_5858772614245939083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BliNhZJk08kQ7kNvwExhcSp&_nc_oc=AdmLFeSiGRAV86UTBkdWpsMmdO3Os5oqqiJoSBgTmb4LmQZExFfaONvrHqFMHwiWNe4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftuPwzbm5YQZF49RK9wJR7hxqW1uuD8k0gYbBG-8Beouw&oe=699ED5B7"}, {"file_name": "TOS_Preview_0000s_0003_Generative-Fill-2.png", "id": "568350333006706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303198_568350336340039_8845270819364117805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T4QLX-x5OAQ7kNvwHzD4cg&_nc_oc=AdmgZhaOzjlBwYLLWOmiobdC0lSkbqoQPXH1VXa1N3ljZatWoc6ixymGwo39YLDJQYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsR_dZiTi8JFc2QhJMxjFLDzlWHJeXq1oug-5L3YvlhEA&oe=699ED3F6"}, {"file_name": "TOS_Preview_0000s_0005_fill-in-the-black-area.png", "id": "830633009487908", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEEy_YxLdW4Q7kNvwF1780o&_nc_oc=AdkzajR1iy-pUYYpcEWS91yS9YQ7DnhJQMxET3IHAcPrFwsFKAoZIQtKBsqCAle6JMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvD8kz1j3oX4JuTzmDZ4Ww29f8hGFZquZKLnnL9ursR0g&oe=699EE9D6"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wI00KGIZ7QQ7kNvwEcVd8E&_nc_oc=AdnBjT3tBHGRD3O-HMI5-viV-zvSv-AgV8hJkuKujPTvKoPyL_U7X4CNk4VyVjsAk1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvoig7MKbsV2aqzBl3Xw9OyJjEfRkA2SPbjMPm9sVUNXg&oe=699ED9E8"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I23G15x2-NAQ7kNvwF-F6w4&_nc_oc=AdmyWzemtB8OMHxiyBgj9TkdIduyuoFcN5nBQwOqROWmOyhoHqNjdlAL9LcYkTSc4S8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuDrQ7R9pcAunG7jLo0_qp7x-w9efIDS0gK9JpiqHQm7w&oe=699ED6FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RLNTXFQloEQ7kNvwEXMYlk&_nc_oc=Adk2zHD80RkMgnJDYCGtga7As-dUpSkiNqbdSKQvjFIizcRhDEk9uzTMh--t2-3c8gc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfveqgJnxzWUoTJNalv8QxSvSRDlpdPEs1fhRj4GFXy89A&oe=699EF8D3"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP9uWh_WPSgQ7kNvwFYihhB&_nc_oc=AdoGRjWcKa0rbA9-LaWbqUzpOBBYiQhhbXjy_rmAvu6X6U9d5KmFeO7sZ2IqovPP4ro&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAILEhMQ56QPaT-tEUtjQfk8EBICEZm0P0t8z0iPY5Daw&oe=6A6F5C87"}, {"file_name": "TOS_Screenshot_04.png", "id": "771674398596744", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307339_771674401930077_6494990847401641394_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxxorIMHi8AQ7kNvwHb_4Tg&_nc_oc=Ado474iY1LDDSPYW47BPzCBkyvWctlJjgY6Cnl6n1vStHYo5uRtRGDQGbiSwDZ95AHc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS4qM90oyhkB-A4avAFKpABp614JKDQcqF-BPvtTgRSQ&oe=6A6F4E6D"}, {"file_name": "TOS_Screenshot_05.png", "id": "639157965484019", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304305_639157968817352_7611340970110395869_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV6YjDm1M5AQ7kNvwFxrOW4&_nc_oc=Adp-4aLyUGTXhSiQJqcwFbr3VEX6PzfDvcuAgzrl4FYDakuuRbV6IMEn4F7IznUvvRE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu9O3kUcXwMSS0kFxFAQDoD2mfCocSlfGuAjlZfNNpRQ&oe=6A6F2A38"}, {"file_name": "TOS_Screenshot_01.png", "id": "620044834249336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308050_620044837582669_1894285565623121398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqktId2eTowQ7kNvwEsGTGx&_nc_oc=AdpBwkBUuLKWaOc8fZxoGWPb6WwNPiBak2TmQjEz9HHbHxNcmdourOUnhRodGi5Dn5I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYFCfwNpe3doXtex0myFYLzN2w0dsr5zvZtwnP7kxzWA&oe=6A6F5B63"}, {"file_name": "TOS_Screenshot_03.png", "id": "1088837863354626", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298291_1088837870021292_3433600990104671402_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQO19Z9W6fcQ7kNvwGSJG79&_nc_oc=AdqzZ19OT6nooYtGX_bGG3PyPT0XATYY4tFXaUzTJ_KNCGte1SQCTfDqG_wyQA969eY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSdlvCDAlcIu-omg_yAD-zOc_1k3Mr7dAHgYCceB5PBg&oe=6A6F4EEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29531778183104326"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2580240479045450"}, {"status": "PUBLISHED", "id": "2162223317861515"}, {"status": "CANCELLED", "id": "803030615576459"}, {"status": "PUBLISHED", "id": "1624374468923798"}, {"status": "PUBLISHED", "id": "1855986918392866"}, {"status": "PUBLISHED", "id": "2703525636679596"}, {"status": "PUBLISHED", "id": "1347343993736739"}, {"status": "PUBLISHED", "id": "1353366119680187"}]}, "baseline_offer": {"id": "2162223317861515"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "2580240479045450"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31763217926626996", "version": "0.1.4"}, "id": "2142340689615276", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "_
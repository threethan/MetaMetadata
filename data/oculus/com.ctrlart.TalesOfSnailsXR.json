100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-M5CJ4ACScQ7kNvwGn4UAm&_nc_oc=AdquRF4ATbbdPKoSY6txCfBiMq1lGEwlJdqFkAsBnxmqwTnvlfgvoQCIscI8PxOc7z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEoawymG0kWHPee11XEjhu_SAahf_F0idlbSSnTklnZw&oe=6A843C47"}, {"file_name": "TOS_Screenshot_04.png", "id": "771674398596744", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307339_771674401930077_6494990847401641394_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5kNxbVaqzcQ7kNvwGng6kf&_nc_oc=AdqhPftWbWGMW6GZYOqLlEf5azdtr8-_CF8dovrbKdW7nkjDGNO5JnwR0bBELM0v24o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWC5kqGhGzIXwMZ7_N2TUGxuxMi2-yqUunkpP9QBM_IA&oe=6A84666D"}, {"file_name": "TOS_Screenshot_05.png", "id": "639157965484019", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304305_639157968817352_7611340970110395869_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drZQTdg3MqoQ7kNvwGL157j&_nc_oc=AdrdRx9z864Jibf4nlnbJEqSUj67ehM8Meeq2TuOzaq4qxUe0csrM_Zd5UCDkhGGj0U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRGLGgRT2G5TQFOrR6vrqM2m7dv3f9WkP1js4swyr1lg&oe=6A844238"}, {"file_name": "TOS_Screenshot_01.png", "id": "620044834249336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308050_620044837582669_1894285565623121398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPCIcPaND6QQ7kNvwFitgqg&_nc_oc=AdovO3yC5w1NDAjmJfJb42bCMugIfSZVxTSC-E6eFenTuAezypw8VAtCApmAqzUwbQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYhimYpQIS-DY15NH6u2Tdj-ONrqjoYNlTOvF8o4RrFw&oe=6A843B23"}, {"file_name": "TOS_Screenshot_03.png", "id": "1088837863354626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298291_1088837870021292_3433600990104671402_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PomIdqQLTcEQ7kNvwHmrHhM&_nc_oc=Adrk9i-w0AUwxcAFLi6ygrGP7cv3Y-_VYCJxPLGnMbzaGSv0o5F2ofAwIBy7DLvhVvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC7HaszxmNWN14aXQqhxmthq_b5D2VWpQ2txWU5UU_eg&oe=6A8466EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29531778183104326"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2580240479045450"}, {"status": "PUBLISHED", "id": "2162223317861515"}, {"status": "CANCELLED", "id": "803030615576459"}, {"status": "PUBLISHED", "id": "1624374468923798"}, {"status": "PUBLISHED", "id": "1855986918392866"}, {"status": "PUBLISHED", "id": "2703525636679596"}, {"status": "PUBLISHED", "id": "1347343993736739"}, {"status": "PUBLISHED", "id": "1353366119680187"}]}, "baseline_offer": {"id": "2162223317861515"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "2580240479045450"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31763217926626996", "version": "0.1.4"}, "id": "2142340689615276", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "_
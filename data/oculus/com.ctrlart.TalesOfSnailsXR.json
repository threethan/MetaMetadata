4_1048776793768718_2318084999794971608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mduWFih7V14Q7kNvwGrOzS1&_nc_oc=Adkceh3U8fVusU0fy3krhRwja1Xj5FPAyy5ftpJdVpu040cpLxjlOvyz4Sh08LaP2Go&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvYLqguWhR4RT-THDIdWjWxAT3vTkH_2iShY9iw0PYzkw&oe=69A19A26"}, {"file_name": "TOS_CoverImage_Hero.png", "id": "682857431136841", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491819982_682857434470174_8346571327920207039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS8Q_wv4ULwQ7kNvwHlgbuM&_nc_oc=Adn93w9LVyhzUxT6NEjU8jtmIpmM64xJlrdmCvY84mHNF202IVI4-qFtC6oAqkAB9rk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftmZOVyGmcKaob5suJze5UFiW5LsoldsqncoMJSqvOrvQ&oe=69A18DC6"}]}, "id": "24843091272042167", "locale": "en_US", "screenshots": [{"file_name": "TOS_Preview_0000s_0002_Generative-Fill-3.png", "id": "1126272779608581", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499301053_1126272782941914_5858772614245939083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BliNhZJk08kQ7kNvwENR02g&_nc_oc=AdkSU6eSM9qx0xhVTxDPOBx7VRQN84MunD_mxCHLCBGdf08IBbbKNt5sbO01TbPKcT8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu4KBhvLlQtDvZhik_Fwd9McnV9WP0nh7_Js44kNzxt_w&oe=69A178B7"}, {"file_name": "TOS_Preview_0000s_0003_Generative-Fill-2.png", "id": "568350333006706", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499303198_568350336340039_8845270819364117805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T4QLX-x5OAQ7kNvwEg6WDp&_nc_oc=Admpco-O1XhyFxHWXGBils1YE1aVERGjDl6cStncyhTvkCLN9BenEee2WYceUBYpfqE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuXROR6Q43xITFwcXSwZ5fyZiI_BigaVNQZVnFNAt00ZA&oe=69A176F6"}, {"file_name": "TOS_Preview_0000s_0005_fill-in-the-black-area.png", "id": "830633009487908", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEeGFy0-rGoQ7kNvwGaVNkO&_nc_oc=Adn-12izv9V-TCRUtoF3myfzrAT3WXGKwqztF4Air5vDfgH7zFUTFNeSUY6yBKdNo1Q&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsMfgWFEKuxxd8TQ_Jx5sz5Dj5MMsTKtfQnIsQV_twPYg&oe=69A18CD6"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOi4IqMsadcQ7kNvwHQyI3q&_nc_oc=AdkLhVlT9iFAStGomkWLtRIvCKYXKPQ0_crBBdNI721QXkdLxFQtiw0X1lR1RpMfNqc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftZWXzzEJ4mT4VGqnn1R-R4UD70vLEn85MWzH97mp3xyQ&oe=69A17CE8"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19irZvWWAR8Q7kNvwEJ8MJC&_nc_oc=AdlQdxj0XRZp5amsouOg4UzqsWjGn88p0-Vfy2mE3n3p_goBGkQ3y6MfdpwLYp1rcvA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft9--FN7FD4g_wrJCEijSt4hlwQwnPtupTkIgWk8nlOVA&oe=69A179FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJoA5jbW5dgQ7kNvwEkJAWi&_nc_oc=AdntL6W-20sxtagUn5XFr91Hj4Ziy2n4hnZ6ONeNNktzhAbZ3Qh1tSZmB3uYlhEgMmc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftbdwtioPl_Io66eBDWXDULVPOSR2Su2WKCoAUibzAbqA&oe=69A19BD3"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
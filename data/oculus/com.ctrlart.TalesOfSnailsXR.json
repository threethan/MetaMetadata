4_1048776793768718_2318084999794971608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdL6oC66zk4Q7kNvwFtg9wi&_nc_oc=Adn5XhF2CSFExrb1XewymB4icGXG-BACGhpEtht9-TiXVCe-f1eojf82dCnDfCwX0Gk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv41hhBGv3BfMKnolUnM3MINfMORn_x53J_JqqVcM3Axw&oe=6999B126"}, {"file_name": "TOS_CoverImage_Hero.png", "id": "682857431136841", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_682857434470174_8346571327920207039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f1FHs8k7v0Q7kNvwE2tzzt&_nc_oc=Adnis-QuUOjGSn2e-pLoloVnU5OnKW_31X_xoWQwSgFVfnFfIV64xHUXFoE78NTz4-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcrFjCH3KQlYfDyxQUBCNdx_tkyn7D7xM2YXWBohPH4w&oe=6999A4C6"}]}, "id": "24843091272042167", "locale": "en_US", "screenshots": [{"file_name": "TOS_Preview_0000s_0002_Generative-Fill-3.png", "id": "1126272779608581", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1126272782941914_5858772614245939083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab6w5sxFd7UQ7kNvwGwbvKO&_nc_oc=Adl6xPTA1yupN94ua9e0QiGz5G05urfgymo41_BGfSWMSdmMGSfvBRpcaqzIkWnhWzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1cg7DZANiO9d734PQNp1jWg0FyjeOYxemUu-AHhf3Hg&oe=69998FB7"}, {"file_name": "TOS_Preview_0000s_0003_Generative-Fill-2.png", "id": "568350333006706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_568350336340039_8845270819364117805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OR6nfyhiKEQ7kNvwH4VdOp&_nc_oc=AdnGXFlxof9n_Gckq8F2llq1z1yXe4rF_SgZqcPRLMoBAKuDGokejtu-vJbc6A9aYgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4dg-yijeDTH8W3_MptfI4NjEzUF3653W4B1rStFNL-g&oe=69998DF6"}, {"file_name": "TOS_Preview_0000s_0005_fill-in-the-black-area.png", "id": "830633009487908", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArGEcUw8t0IQ7kNvwHXVQ48&_nc_oc=AdnhDNq4b48IFhdQyih3RjmYK0taugM-_UdQVoSeQ8wd1nck2QcCypMRpJEFd3C6OwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmhKaVE5BNtypiEk6PbJA5XI2dDlQQ1Z-0i5KtgUq0-w&oe=6999A3D6"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZFcmd-D1PoQ7kNvwEFFrZW&_nc_oc=Adn7U09PWifChOBT75T5RFL6rXVCtZAZOT6TQ1SL92ugo4HHLxpHcCR-Ld_NWHUgapQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9W8ASn77K61TtxsqvwzDm6H4n5s-FYDv6IwFzHfB7dQ&oe=699993E8"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gY18cydaqOwQ7kNvwE1Xsuk&_nc_oc=AdlqerUtvfI20wqEaxkEW-4IbpcZiyXgPXpwRtZ4MZMdA2SoKh5UHHznYD5URQ5_pzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftawCEXzKVkuUo88hos9WW5EYvtcTZm-QRomTZOSHSaXQ&oe=699990FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W66k4EgQDjsQ7kNvwE-0uRv&_nc_oc=AdnmbQi7EfArXfP1JHkCYpc_wtRWTAMKgxtYpn6e5yE1zGfwGSK4it8dC17WFVEHOPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucpeZr8sOF0ZuOZ8S51bdYpUByGz7R-BhOT0BgeNK5ig&oe=6999B2D3"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
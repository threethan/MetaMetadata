4_1048776793768718_2318084999794971608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lptydo5oiTEQ7kNvwEWcJkr&_nc_oc=AdlylRpP97qnRUorwHB6sVCynW0wK1v2dTPkVYyE6Wcc2DnIj0fbkjG0a6PXMPVzNnA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfssQVagV2iK4AfqyG-3dVvdQMyxb68oU661GkGMDFDawg&oe=69A048A6"}, {"file_name": "TOS_CoverImage_Hero.png", "id": "682857431136841", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_682857434470174_8346571327920207039_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrz3SYVj66QQ7kNvwFjZvdc&_nc_oc=Adm_A8VRtgkyqDdR3UIdztx52xN8gHjsgfqXMMpvDRRt1wAi3ZILSz-Gn4LWLT0Ivnc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvA8iggM4ZbGDwiJSm3xs26BahBp7hfgfwyFUzFosRJ4A&oe=69A03C46"}]}, "id": "24843091272042167", "locale": "en_US", "screenshots": [{"file_name": "TOS_Preview_0000s_0002_Generative-Fill-3.png", "id": "1126272779608581", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1126272782941914_5858772614245939083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BliNhZJk08kQ7kNvwEqPAAH&_nc_oc=Adml2RoU3yKHX6rru-pzpo8DlLGQ4bkiunU8F6OzT9hUlVw5t-HYPMLk-EQdnfNeMos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9XwdO6jwUKtvxoTQy6-nf680I19Uz28lZepTQNJrqVw&oe=69A02737"}, {"file_name": "TOS_Preview_0000s_0003_Generative-Fill-2.png", "id": "568350333006706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_568350336340039_8845270819364117805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T4QLX-x5OAQ7kNvwFX5lCS&_nc_oc=AdmJj8e8GQeJNzRTxRUohKNAnXT2diTFQAX5aPGWkVhzDwaHBVrxSX40Hl_zq7JOVpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9aa-F29h77Rinc5y_wg7zUDiAXhkgjZVA4f1o5KeEBA&oe=69A02576"}, {"file_name": "TOS_Preview_0000s_0005_fill-in-the-black-area.png", "id": "830633009487908", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEeGFy0-rGoQ7kNvwH_QJkX&_nc_oc=AdkTLdRqRBZPC2pZa7hPfgxdvQwVbkKJwsFI4WuAZKwqhrVHDt1Bf_iwN55rNwfqF-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQDdSchx__V85q5oFnzRc_vEoZZz4eH89KM9LpxttHzg&oe=69A03B56"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOi4IqMsadcQ7kNvwFUN-lV&_nc_oc=AdkE4VQwJ1MFjpgX5s_2-37kNlyaXu6xEgiLP3bk-7YOgs8JACNo3NzVXYecI8z-yQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKTeWTWNFzaOSxqPHeR9WlzP_jxF1FV1KsIovtIWlfPQ&oe=69A02B68"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19irZvWWAR8Q7kNvwEeJE63&_nc_oc=AdnEBOVVliI5qpapH88jBiTQTJIIjeThwpL3Sa4tCtj-CdNbdGeAlSR08b6DDjNf8Ac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftpESx2K8wrynSyYy5C2MASTlA_1YgnAwWJNzJkQmNwiQ&oe=69A0287A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJoA5jbW5dgQ7kNvwG4ZjOq&_nc_oc=AdkofbiujCR8NWnbNOkvinL2HSYYr47Knhz2Vwiicez6-GhoAsBED5dxsCwIHaipUaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs6Vd31H6IEzVjxrSvsmJzpb5oGB0fSeEyhNu8thzY2ew&oe=69A04A53"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
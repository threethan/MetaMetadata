1475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSnm2RSyh4EQ7kNvwENq7VA&_nc_oc=Adk-WRgVmXMokW0jxjN3MK9iW2gd7z9EnoR3lHYPkUS07LjybdWNZ0gNZNuaj2LLqWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz11xJfys8gbfST0bMKI5TZAbGfm9nxN5y2PNCQEtR9Mg&oe=69B55356"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raaBafpAOJ8Q7kNvwHQVIZ-&_nc_oc=AdlXCaSsVtMhRB4ZRVpOpAQ0d1OS0rl6WFhX3qyjHeHm3YavBh-yep9Gxj0FlHY3qYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF7utZ1wYvVHq-YGMqhSO3cRdNl2elt7In-Dgt_UFqQA&oe=69B54368"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksV8H6KZBboQ7kNvwE_gyA3&_nc_oc=AdlcPn2Fmb9uy6ssv4z-IuPpLHzoXQJ0FdE-Db1CyPzILUFPuEyCk2S_2aEPF4dFGZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBhChnBptX9sOln6wQdG5T_3uMAaPlgl5ZHjxPZyXzPw&oe=69B5407A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6WE_MM3rRQQ7kNvwHplNWQ&_nc_oc=AdkkXm9lzsI0CpWEYHHybPsCmfAsP6pkkbjS2fQXuNptnhLTyU3LPq1PwJVtEhFZ49g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUafmNBvhYsWwGxyQOIkzbYRJoFU_CWI_hDwuNHo-4Lg&oe=69B56253"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rati
305050_830633012821241_5342286701475032661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2BgBOG9LxUQ7kNvwEXKa5s&_nc_oc=AdoW3s2OPvkHLTwtOIaIdK1CtymeoyaHm1QpttP4havTBaA2GNMP5R6ynN0T7YA-OCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqWDOn1hCJJ7_18DSxEKSs8iWmAkmOcqZn59NXPyArYA&oe=69CA6B56"}, {"file_name": "TOS_Preview_0000s_0004_Generative-Fill.png", "id": "31511668548481054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303280_31511668585147717_1010634194927384974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKFifsuUreEQ7kNvwGaIZOy&_nc_oc=AdoIYOJwieUFW4IvJGtlkqhGwc1L5iSoIfOopXcH9tl1vRYjVW6Z56BBbHVedW89vlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7gDqdDrLmNw_UGB8oEzpcueU2G5-Z2d5x-J2HzjkCJA&oe=69CA5B68"}, {"file_name": "TOS_Preview_0000s_0001_Generative-Fill-4.png", "id": "1515154286337470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307435_1515154293004136_7468964954275320428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4mB1npeOWIQ7kNvwHdx3j6&_nc_oc=AdqrDRc_2MkD6jDgEvAFoYDBjpNwZL2QNG7BmbBfzWhk1TjmfSJMuBlsGda78quua1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuASCddvSUq2SOCTTvFwAKWBSIa9RwG4Znbc6VBxQtEw&oe=69CA587A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TOS_CoverImage_Landscape.png", "id": "1329485858825692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304019_1329485862159025_1186483380215427335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtk-Hs0K2dsQ7kNvwGvzTNq&_nc_oc=AdqNOHdnWc4Xx8SLo-W6fTdSKkrsGR3L6kYXfpDdSNSSDTxDWry5pDilT_ReyLeFE5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHN6FQyeNNzoqR1P_S3F5moetNpWfJYTEWPu6ipWH0Xw&oe=69CA7A53"}, "display_name": "Tales Of Snails", "keywords": ["TalesofSnails", "TabletopVR", "Arcade", "TimeChallange", "Ctrlart"], "long_description": "Step into the quirky world of Tales of Snails, a tabletop VR adventure set in the shadows of America\u2019s Prohibition era. Hidden beneath the city, an old cellar becomes your stage as you guide a determined snail through a series of time-pressured challenges. Every level is packed with tricky obstacles, clever traps, and a race against the clock as you fight to bring your snail to the rescue.\n\nBlending the charm of a classic board game with the immersion of VR, Tales of Snails offers a unique mix of strategy, reflex, and atmosphere. The prohibition-themed setting adds a layer of mystery and style, with moody underground environments and a playful twist on survival.\n\nWhether you\u2019re chasing the fastest time, exploring every hidden corner, or simply enjoying the unlikely heroism of a snail, this game invites you to think fast, move carefully, and discover how slow can still win the race.\n\nFeatures:\n\n\ud83d\udc0c Tabletop VR adventure \u2013 Guide your snail hero through a miniature underground world.\n\n\u23f1 Race against time \u2013 Beat the clock as you overcome tricky obstacles and traps.\n\n\ud83c\udf78 Prohibition-era cellar \u2013 Explore moody, atmospheric environments inspired by the 1920s.\n\n\ud83c\udfb2 Board game feel in VR \u2013 A unique mix of puzzle strategy and immersive action.\n\n\ud83c\udfc6 Replay & master \u2013 Challenge yourself to rescue faster, smarter, and with style.\n", "short_description": "Tales of Snails is a fast-paced tabletop VR adventure where every second counts. Set in a mysterious underground cellar during the Prohibition era, you\u2019ll guide a determined snail through tricky obstacles, hidden traps, and time-pressured challenges. Race to complete levels, outsmart hazards, and bring your snail to the rescue in this unique blend of tension, charm, and old-time atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "CtrlArt Studio", "support_website_url": null, "website_url": "https://ww
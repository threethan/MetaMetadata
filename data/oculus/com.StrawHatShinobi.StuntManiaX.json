s://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393486_665249709834367_5690436015077876481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMitXFicw0cQ7kNvwENaUIS&_nc_oc=Adp8dbY5QnarMAPgUn45EQcFmpdL25jsUBSdKyfTh_QRYIB9LMxJPmrtWrH3wybHp0I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1Ivmx8hfrJENIkLmYlH10STweHCQphivTf7aDFwoB7w&oe=69C7CE82"}]}, "id": "10093044690739786", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQhDdUos9OYQ7kNvwGh4h46&_nc_oc=AdpvszYtDaaNOFF54QnD-JTZ0Rw7LMC9QAcBADr34iVatHCtFjNpGOcpvbYGCP2R2iY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTTh6Nvi0GXTdm1E4wrJ0mf2wbOWDYIbQr2LqkyETO_Q&oe=69C7C437"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB4YbcbHmrsQ7kNvwFx4BFw&_nc_oc=AdoRO4_Nf_XHfxyWr_NuIDU8e8U5_6qfcCX30lLuv7KIOG3dp5NlfeO5CA-bxK-YWfE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_DsLjORRseAqrjQ2QpN8m2D7bEDwPIm5M5E075A4M9g&oe=69C7D418"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSyhYdpdPOEQ7kNvwH7tFG1&_nc_oc=Adqzz078ysK43Njfj70Kwb4s_tMLhV1myWkJzqPCkKcjLixyLukWMBWupFEt5TNuPe8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydpNF6iqln3Nj1WVTt6kwxWtg9h37ePyCTs-MGeDBb7Q&oe=69C7CFC6"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u08din_dScUQ7kNvwFHzs2n&_nc_oc=Adof4Qn3Fa5RxjTNCblag2FCbFuMEgffBgaH_u4EW0fLCrpBaKLMbm2AqR5lW8ROmCk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz82uRHkAv9VKV-WWPZs9gizKXnhwknx_5_6sKOqvkdMQ&oe=69C7DE45"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2DHj6gdzeEQ7kNvwGfH_tV&_nc_oc=AdqYFFmpfxUCvpJq94AucQ-okoBwuaaTp0cYM3SX7OOSm051p1b__Q6CuYLxPVlbl3M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTVPIxRaoCp9dsNXTqCvNs2J_FKSe-HEAs-k7dVe5fTw&oe=69C7C90F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is4ZkNCEujwQ7kNvwFtMRnU&_nc_oc=AdpsB1vHkjCSJMMYtPS3zwBXe6pDEPQOqlEXgAL84LH28XLReU4azoEobHlHwmTg2rw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhYKr8Y0rTZZV_eAxtOK207akc1FNZJDTrAuOu9diSuQ&oe=69C7CA8E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
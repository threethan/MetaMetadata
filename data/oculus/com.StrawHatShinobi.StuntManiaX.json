81_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU6uMKK2SMsQ7kNvwFWLjec&_nc_oc=AdkRJFriah-RrXNFNYdHqOCggo0sLOnTxn1qRTQGKXzgJldpaPHCVHOH7YQ66Dp4rT8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvzXddcacHf-w6Cig9849y4AdSm_fgvOMAQ9LVAP5roZg&oe=699C4D02"}]}, "id": "10093044690739786", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HA1ta35L3SsQ7kNvwHYslfK&_nc_oc=AdkovLvP9fbFGOh054hPzKxfJWhr6VVPwxm8cx-AHLESR6evGsxsdA3hSUK0qMVIiWM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuKXeTcoUzLryFYBQEBWMucrj5tGaDkIRf3vhDiA3WApA&oe=699C42B7"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QvylOjRKH0Q7kNvwH-IObh&_nc_oc=AdmYO_JlZI9fFSYzxAmAKoQ6GkkgPvvjcvvsAz7eUZ89xyE9Q6K_ys1vJlF5vaW0xok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsml2JBZ7uvQJusQqvuDQzDy6lTqyJ_bzjbHPC7bmym6A&oe=699C5298"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDFluF915RIQ7kNvwHSOv-K&_nc_oc=Adl8Qz14X7WbtNA1g5khVQ_iPdalwq76c8gxnoA-1e6NTx1nnyHoHEY56ibO6L2QJR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuW5ppbuD9yi1kDxBHHYMBagUDirEHIJQSuUIGJGWqp3g&oe=699C4E46"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8Bx6BJAr-oQ7kNvwGdSC4J&_nc_oc=Adlyxuw0QZKkAwWWLpAxLGB0q95yTu0gN9eRY2nRFvfK_YLvfLdhSCBg17US43r2A84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afugo7HeHLBj_D71xFNT5JFNF3IxVOfwohEJiuZTF8EamA&oe=699C5CC5"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54VqgwFjkMoQ7kNvwGD9EOZ&_nc_oc=AdkKLZdzxbP3FgEGGMW_pDDGx0_5PUUTHFqk0iI_1iaYAV5ClTft4Ievn_9UGuANwco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvtQd02XQqcz6s5j8QAXdEtpNPkNVvxwM3UD9KekNwamw&oe=699C478F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtwbqIveeYkQ7kNvwG3MhzT&_nc_oc=AdmjlcS2Ahc4LW43eLw14ITYuKNbeg13jXTDpV79v8lu51Dyndu149py_YLWCGtd5-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsvBs6qKnQRJlyP80vbaje8TcwNJMs82nPElGX_Fl7EBA&oe=699C490E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_m
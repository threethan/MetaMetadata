f&oh=00_AQABT5R_Nvxeq8WoJYLVvg6OxwZEjy-XGd41Bt9HqbSuRg&oe=6A5A4B0C"}, {"file_name": "pp.png", "id": "1000599736081382", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825575_1000599739414715_7955993066935554699_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJ63yMm9-yQQ7kNvwGFYfyg&_nc_oc=AdoizbDcCQqRMYqeVBE7cA0z28ANv6wmTteGM3tjwntaqGRvnG_q-jtWDNByIZ-hQtA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjho_Aa-B_tP3f8CQhsiXu1mcUPHG1Nvgs0Fhts2x6uw&oe=6A5A2656"}]}, "id": "1707956233846061", "locale": "en_US", "screenshots": [{"file_name": "ui room.png", "id": "1712903056614646", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619808_1712903059947979_4340803759016352497_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF4wUFL6bwcQ7kNvwHhmUg0&_nc_oc=Adr-3wLhq-cbPfULxSKegkRixPeYg774LukJQF0PJhks6usWFJf3rFNza987zXf_s54&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJaRH1owvSrYDkCo2BkFfucmWlE1se1wILy-HdtRZuug&oe=6A5A2A7E"}, {"file_name": "com.StrawHatShinobi.StuntManiaX-20260629-210838_upscayl_1x_upscayl-standard-4x.png", "id": "1031014392912089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620504_1031014396245422_5578416037283300293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iocatLiHwIQ7kNvwE1ic2z&_nc_oc=AdpDscCxc4k4a9cwyBggnhYoZn-1suiz4e2QdaU0DM-GrkQpvMul--Qa2OvJ-7xLoEQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6pUxRAaZgBY8paouCrPp7RphM00o-xpZmQvxCi1vPLw&oe=6A5A28D5"}, {"file_name": "1920-C.png", "id": "1563195898570139", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/507894088_1563195905236805_4485795279420815638_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1mNnhPs44UQ7kNvwHgIAFg&_nc_oc=AdpkPoPV4OCSra5EjYno_PiFOZLt0piRwyBeiOyES8hMi9HoVWBWH7bnx8UQ99Cl4sY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-vrB3PP8V5Nci4rQR7SOzmK0wdOcnWtiN1IhwTrS41w&oe=6A5A1A55"}, {"file_name": "1920-E.png", "id": "1068495515503280", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823812_1068495518836613_6378278017046238503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOGgaErOFJwQ7kNvwFh7zCI&_nc_oc=AdqlNQ7BJCHlCD65x8Wua_QydwfCpCU_ZxA4n4In3bdXobZHEtoTWAfTMba9FpycBfI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg5qbBDxlPY1cQzOiIAyzTLYoaJkqKGwIqzv0IJDPvXA&oe=6A5A463B"}, {"file_name": "1920-G (1).png", "id": "27665562543083832", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823837_27665562576417162_8539978051617739066_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koy6QEWYi-oQ7kNvwFSk1we&_nc_oc=AdpOjoS40p76kPoXWBnDuLyRb-DItonCcXt7UlfaVWGTixMIPHk-bziojZRnxaZZVtY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4ILmovAuBVTQxD_QebtQC5VOCGJTwDBa0n_QBE5xt5w&oe=6A5A4246"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverART2560-1440.png", "id": "1614965387297641", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623443_1614965390630974_4511375871821283395_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmGWBCVi7wwQ7kNvwHtscrn&_nc_oc=Adp4iK1oNVZd4VJcSRht505nmNGIOhAHOcw1HIS-N8ldDWYbN6JnoMbAxs-AhPoiXgo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPqZquyJDUnzoQCY1ENwGdDKT5sTpdolexY6nOqVo7Wg&oe=6A5A138B"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and 8 more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 5 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory .\n\n- **Challenges Mode** - Perform stunts to earn points and  other objectives .\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 20 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and Challenges Mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
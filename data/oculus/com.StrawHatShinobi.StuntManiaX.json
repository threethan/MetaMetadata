, "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWI6kVzg5F0Q7kNvwF5shxF&_nc_oc=Adouc6ySH9hKOGvQsojoz7eQz8cPJ8LUyuqQQcZkKRU2GJEvqppoFny5xV2dY7a4TKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__GU5syhKXXiNtT0HwZi5fqMH3z6btjrmbEO5L3O72Vg&oe=6A3EA377"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhIGP2z22NgQ7kNvwGXX6N6&_nc_oc=Ado7j6FaEuOAWTxz8QOgCDJEh24gz656GCCpFsyymixzrsIIEMXVwvNM4C7wPS2qzmc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y8FASIpXooycIyujsFdsSoe83xU-FJUBDALS2YQBDqg&oe=6A3E7B18"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAPkw212KgcQ7kNvwG2eHcw&_nc_oc=AdrmdZdY1uVbUvDE_yHBN5hEUNnD8zmhgDoGRCurr5bbLLP-sJaayjdYmrqO0m5eQo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L-qdvz8sStuh5LA_4-tFuQ47ebncrhWoZe3YndFySqw&oe=6A3EAF06"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CAyXJDnSboQ7kNvwHo8AlL&_nc_oc=AdrhE5d_rF20-r71GPPSHZ-E7l4qCxL7XxrcKG1KP6n0VHSagnwt-t0hV_ACbGijcIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SxQgSwnHS3nY5fmG9n8lV6yke74DmxApLmfGyv0KpOw&oe=6A3E8545"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cWhthScJ-oQ7kNvwGBDVbx&_nc_oc=Adr-hFuZTSizVwlbLD4m0kCbIGoCMRhBs3MkEVeXHi4v7zNdqAfouKZ-i4Hh-FVszfc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5-IxXW6Xf0qeYGRECBfEV5sCro6V057AdEEak5WGfUg&oe=6A3EA84F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1VOxpJ-PRUQ7kNvwEizQYf&_nc_oc=AdpreNX3StmdXgLU7PjfLl9DCLD2q-Xgt9qZO2alXTvEh8jTOrRDtfrZFeBzH6hzyNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bz5prTyLtzSltAFNLFEFni0U8YdF15DkQ9C-llS6k_w&oe=6A3EA9CE"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23894288000165645"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "26290359877308723"}, {"status": "PUBLISHED", "id": "150
s://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393486_665249709834367_5690436015077876481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJAaLOjsnVQQ7kNvwF7YIA9&_nc_oc=AdrpmzVDScZQpY5l7TYORdyXksIue9qZCG0LgHAtEwU6FjIAPgaxlIy_Mk95oT3ES7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sOgD4a_15rbKPPvt8DiE9hIt1ZfcW-xp4g6194R1_qQ&oe=69FB3902"}]}, "id": "10093044690739786", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm93N-c2u0YQ7kNvwEOTQOr&_nc_oc=Adq6JS6hE7ZYpZeZ2KZ8chckAJJfBhxXoYvLN904Q8M18GCGyjF1zWuNWxeHI5fg244&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XF7LkaFqSoJTDT2Yr7JEWcdYyayIE1lTS8jHPIGyq3A&oe=69FB2EB7"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPlqJZQWX-cQ7kNvwFGolCh&_nc_oc=AdpH5MfefZmQM4dAF9QMzFHtsdxTzr58PyUTy4r55tB824pSJoAK_CUWMDaeyXELnGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JeOrcRNwB5RWRhdq6gWrVdnfcO8QNIEEJNBVSfd4eyA&oe=69FB3E98"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3voc6i8O4gQ7kNvwGf5OYB&_nc_oc=Ado6ABeJ4-6pt56KbsUSfGN24DxJBZb-Qy77K9sRj7uMK3Q9Zzse2N9obOSOPFCnn40&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v6smdJB85V8aQ9WLg1oFLxxLVWBZL1M3Fq6UFY2rs1g&oe=69FB3A46"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agjBJpdFsQIQ7kNvwGRg6II&_nc_oc=AdraRzFMcuzUNn8Wx9xMrehSnBm_bpG0YIqXmFFsN1QpKu6bbJPmhRQQ-Rj32kihINw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74t42yh0Hai_6-UZrrTJJFO03JXvRQo-1JoDdPWPkwNA&oe=69FB48C5"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwjciqFIhnMQ7kNvwG_Jo71&_nc_oc=Adrnogfrb6hWyE26lbCiUKZaVw8o-DlG1HOPsi2zuPq281TrxMJz7GYJYtTquiLen_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xWelwfHZ-DFXUbvBjqqN9l84Ek7hFhdceBYS6le-vhA&oe=69FB338F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXIdAF9Nmx0Q7kNvwGyodEl&_nc_oc=AdojbvQlMEVNPQLlla2mFkd6uXD9zRS2hdBopyt1iwbvh-ZBtrCDAfeGb61jcH4W26w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fIQZ_1VOcBA3oyFYo3xxXHLuBArm4TSFfLaDQklG2hw&oe=69FB350E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
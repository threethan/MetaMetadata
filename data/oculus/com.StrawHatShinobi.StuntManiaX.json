n.com/v/t64.5771-25/473393486_665249709834367_5690436015077876481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLKxb8FTPNsQ7kNvwEOBsyQ&_nc_oc=AdnZ2tCx94M3ht6r9RziPeCH88u9920LyJ1zz_uRBXtofYM20ckAzdDEfn46IgOABRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsruHrh6LAzV650UmaAiFKgBEpKA3BsVpg2hb3Db9vOiA&oe=69A82A82"}]}, "id": "10093044690739786", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5hJRq4GqY4Q7kNvwEdARup&_nc_oc=Adm3hcmaSHPlDxv4CzPPiHLi-odvTjP-s11s6S8tUStnZCiOfqeqD0Jdri3aEkNJWHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuvW3af8mlF7NE978mEXj-jUQfTskmX2fK_TN0Ti1FY5A&oe=69A82037"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fzRM4AWFPgQ7kNvwGPBDy1&_nc_oc=AdkWdhP5JSwiNhjJ08-L8MfewxYopc81lwwJ9EtbVp1XDamhtGGHUNLTjiV46CH30FI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu5U474ecd1b7KnRn7zFcYBYYA7aAItwPQWgNa_RqY6yQ&oe=69A83018"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A25Sh72kAO0Q7kNvwEnD4k0&_nc_oc=AdmbSoSY7Z9R-7HsPfqgAQq3qHbXKsgRGtlkJdm25tRd08tCT5Rm4WdvZXIWXbhm-_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsskgPm15-_h1wBcQj2lY9waITgb69qZbGmiD3KEj19EQ&oe=69A82BC6"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJosSQbxEKoQ7kNvwFn9UKR&_nc_oc=AdlQ9EEz50tQ0fh-GE0W9f_KicYPgSV8DyP-JepSpyxFg-f2UNau4sOwOgp3LM2SFus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs7ZEGgk0YvZJtGkny1hYDr6NWSjckbFgUNQJaEzK7ffg&oe=69A83A45"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SN6Rv8IAjisQ7kNvwFwAWJk&_nc_oc=AdkEePCTMjHXOCYqhfARx5AjAVNX54Dz0u0vB_8ZjUB7mnApyIKmco77c18gMobHZA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFQyMweeD8uQmjNfwtvkKJsnu0SMUZpKxmToKqJ1x1og&oe=69A8250F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuvNjk_l0q0Q7kNvwEcxDwp&_nc_oc=Adlx1EJFcq0nDQ5css6_DWVDbQHx_awyfTslbGrB_IZxmq-vrqwZmvc44iDCOBArxzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTZi5Rmd8PAKHqeEJkSFyYg50tNlU5KvMcFTfRTeQ3EQ&oe=69A8268E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
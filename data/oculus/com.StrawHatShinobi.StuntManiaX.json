ntent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsLRpuo19tGUeiulvUk64TfOmf65hNW0zLJ5z53MSOHQ&oe=6A660818"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mu1nESu3iwAQ7kNvwGgE3TI&_nc_oc=Adq7jObCAN2HVdmjNOj-5dqSTaAcBo7j6JnzZCjy2MaHYzFlqcQDpnw67uyMrLfG3E0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2UJPDAn5agK5ms4rxrZ5-bUPwIK2h5IoitTMZA5odbQ&oe=6A6603C6"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBL96VzPlm8Q7kNvwGN0Mao&_nc_oc=Adry_XXTILC68cmgYlb5V1bXYiq3NGGlQXvSaGEy3RBbVC9Nl6Oudz7_DeT5AoyZDzU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi-lKoyRrbYcM9NSj72N1YfjJ0cLpgU9lt-Cj60ZeDpA&oe=6A661245"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP4UOvQ3ilsQ7kNvwE1tZ0T&_nc_oc=AdpkYF4heNRA4xCBPvRG_upvRYIK_Q0RJ9RdYtaB5U6N8V4HcSp7oLNAxKlV3aLdbj0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_dE5pmBciaj8C3Ip4ItdaUXqGXqbl7IQoLYSbyNmBEQ&oe=6A65FD0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz_1pngYhOEQ7kNvwE5w6uy&_nc_oc=AdpI-m9CCsd-nhNoqaSTwqDUxUn9OnMRGh_5IJKFnvBwfvoeNwrtqE4PaMzdmrpy2x4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB-JWb8pguGfRthlQXy-YstOjPUaGVomAxK0QAXbDgKw&oe=6A65FE8E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23894288000165645"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1353160960282528"}, {"status": "PUBLISHED", "id": "1046228114937053"}, {"status": "PUBLISHED", "id": "1347150746840093"}, {"status": "PUBLISHED", "id": "1493847645399951"}, {"status": "PUBLISHED", "id": "26290359877308723"}, {"status": "PUBLISHED", "id": "1509787990230995"}, {"status": "PUBLISHED", "id": "978057017954385"}, {"status": "PUBLISHED", "id": "1296038948769871"}, {"status": "PUBLISHED", "id": "576214801776827"}, {"status": "PUBLISHED", "id": "1044332547263209"}]}, "baseline_offer": {"id": "1493847645399951"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787594400, "status": "PUBLISHED", "id": "1353160960282528"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27889868683940870", "version": "1.0.5"}, "id": "1772888196907579"
s://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393486_665249709834367_5690436015077876481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTSiDvHAGdUQ7kNvwG0NKti&_nc_oc=Adokot3xhN3DwQfWiu_6YoCRwSkm8JVzwshb1MNTrjgRHIICQWWQOSNSZNrU9tzVtuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t1OMi1leMTTxkcA87vbUAwqhQfW0cQf6hefCitUiDwA&oe=6A086802"}]}, "id": "10093044690739786", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RywQeTYkbDsQ7kNvwHghykF&_nc_oc=AdqG8smfD8xXNnj4bwj_hjAQK367aEgDsRsSEzEwCZVzDgjgCGtqo1_C5JGvjmhnHug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HDAOKtfznbzRy4yMWMJT42rme-uuKnj9mfapsMtHwlA&oe=6A0895F7"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr5Ta6ZuoMcQ7kNvwFsM5KE&_nc_oc=AdrkeQZeV6qhH4nubO8EojQOEUTmyOVxRnfuIPJC4RGa8A-CsSMrkZRwrIXzqoy2hRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XzGOw7m0GXdo3V96iRVUiJ9F4zqj2692u6PUgKlCXuQ&oe=6A086D98"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tzZiIkp9XIQ7kNvwGyMBZT&_nc_oc=AdovE801MqCYb7tYukR16Qb85exEhRoLamUlyX0fpYU6U3XFOSeDrVjUN5EVwxZeo-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rWciPP71D1TJtx2aZt7FjfBAp-jY3vfw4OXlC90ywHg&oe=6A086946"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77zDQ_hUhjIQ7kNvwGOWsGP&_nc_oc=AdqGfcnPzJ6Sf1HbMaqPni8xomiKIHgUq9RVv1z2TPMXj89ZMNsyrW-O_ChILG4l9FU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_kRAPVazlGm2GwrbLvEuoavdf7rjo2rYtR4RIXoezHA&oe=6A0877C5"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg2x3laFSV4Q7kNvwEQchTj&_nc_oc=AdpQFG8acRpvKjjrGNmYEIo_IB1r53WLnh3if45YMCgRtq3f-Emw_NbZUQCvRxGs8bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gacI1HHezvtx6KPgGFz4WoZGL9gdrIbssGdZ0E70LmQ&oe=6A08628F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc-M9mqXtzUQ7kNvwHjZX7q&_nc_oc=AdoWXGgYJANHkZLWOQeYp1EWoIsbZzukkMnwCwaWwxpPbrAaHGxMyRHZdNrrvAkBIUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cGIht-LP2Ss3EsGmKZKJQ5yG8STC1ln1-jBKvHn6ojg&oe=6A08640E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
, "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYc8V59MqHkQ7kNvwHOVz8s&_nc_oc=AdrGqhbfvPv0nhhtVwT_3VdMDdz7rTCnEhUr_v_sJWZUNsLqainRr6rrtIyCu0O0If0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mfypFcUCeLf_NpT_5rgvwHMNUWINPUCch2Sy-B5O1NA&oe=6A341777"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_7SAG0BAkkQ7kNvwEP7B2J&_nc_oc=Adq2KD9thNjqEuiUyCN47jigtLc0YIrlIml_hbV83sjMssC3T8k-Eoj5G0hCccFkGmA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fMnJJxqe6Vwdv-7hOXh_1_1vMJtg9KIw5vS3C0PcwBA&oe=6A33EF18"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFtwRK4YgD4Q7kNvwFC_1Po&_nc_oc=AdrjLNf8uy-0BbHGm5O27xKKb0qyLsyrp-TdbQbit-zmANdSTJJz9ZUpSyM2wLmwkog&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1h9mnMEbvrJDFXrbgitvqSb2ztGczNC-XbEAf7kXWxA&oe=6A33EAC6"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hw3D57a_COYQ7kNvwHtETSC&_nc_oc=AdryEIm91QDd1iz5s9FHz1XNXysnsNtfD41odNBU4pvvOhHT6Yrc0D4QIibeZcArHKI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aA_hjL86Iv1IvjoVfgRaZMi1JAcmK1hrNIWFuTLDTGQ&oe=6A33F945"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLeqkCGKYUMQ7kNvwEKzAn2&_nc_oc=Ado1sNn93rD7rEy5Fu1YM2sDXIjolrkiAgTw_LEsLzUdcEDxyk0DD4zhbq9EQbLhb_o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OtCNnMKUa1T1K9n1t8XYt5dHV1MJhUzos0ZyIYZakvA&oe=6A341C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF_h4KkiTY4Q7kNvwHAp2d_&_nc_oc=AdrBwE6S3OclExts79K8MFm2DoVGWQcN0fGy8d1DzUrLOd3MHp1Lq9K0eUGZExErHNQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WmAIjmrd8-QZslVJhcTjf3D0MO_6u8hORjZEKCiXd4w&oe=6A341DCE"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23894288000165645"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "26290359877308723"}, {"status": "PUBLISHED", "id": "150
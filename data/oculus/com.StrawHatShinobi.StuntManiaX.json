, "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAv95pqj9KkQ7kNvwGKD3Jy&_nc_oc=AdqGYyfVDmZcYMpQ2RF8w7y1YDcGL8sn67sthUuoYYZ32oo8FFQJUmPsr2WQmK286rY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-xvgXhekM4Cd7i646bNOOlgm4Z7zi5RL10uBktYHq2g&oe=6A4E3D37"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO4Ny_7A990Q7kNvwHnwi4X&_nc_oc=AdptgCA6bMZ1yM4qNwwnI2eC1p4JOcpeuEFVEeXIzB1CJjYd2U73VK4YK5haBKB0NcQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABozjOyZqJ5dbqtpjcR9mtW82dtiU7t8OnZ7a_O920Eg&oe=6A4E4D18"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTbN4X17xgEQ7kNvwGbhCuB&_nc_oc=Adr_YZJmcImM0_V3M1vjvM6dRO7urQGuqAG0Hstq21TYgWiyODy7zPFOEnqd_sQuPmo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw9j2WCq0M-dPSdxiVd02gVx_3kGt3KLrUfmEvIeBiHA&oe=6A4E48C6"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf3SAcnRlqwQ7kNvwHZiG6I&_nc_oc=AdpIw8ImrMpZU3UnoKLh0Ay50tfN9G6eXT6kSJ-VJRWS6BU825mLdcNPszW_5ac001I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkfGZ1L_o4eqZwiV1JdbVXVEnk4q5tOH6edXQXe7K0Ng&oe=6A4E5745"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czwU2p2Ic8QQ7kNvwGNt1Ms&_nc_oc=AdrMKiLBS604Nx042uJ1WER6Fu6FJ6GxZS0-f5Tw9Tfi0SaSc96chTs70A8g8sjVeFY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzGdS597c3FtdnzYehpRfpyU4agaqQn-MeQctD-u7TGQ&oe=6A4E420F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPPqv4Zs8lQQ7kNvwHsokaL&_nc_oc=AdofeaulKyWCAONlIjzX9o34Qb-xKTCVhaByQniwBt2BAK14fg-e0ddvmnkDpNcBhZw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdrEc8u8xe_LNba58PpvZmWb_8lhc-qdhybS2qSeRPmQ&oe=6A4E438E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23894288000165645"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "26290359877308723"}, {"status": "PUBLISHED", "id": "150
3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrODHhRV2DB7jGUJPSrqY869K4HadIbqZJ0nTh852Jvg&oe=6A7DC318"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_pRjV4IRJUQ7kNvwHIl0dT&_nc_oc=AdoyA2T6oBLJdWu-oZxJYtx_PZREJF_9GutDO_tDUs9UYkuvvx20nhfDaPJaIGTS-hg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr3lbzlQ5P-XdKMlzeK4ciKpGfWB5YZghIU0yh0awhzg&oe=6A7DBEC6"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRZqPYbHnX0Q7kNvwGqX4HY&_nc_oc=Adpb-RZ7Pi0BYJxYIvT3UT8AHMrFvprjdubmU0YrJD3gDP7CTZ86kJD7Q8TZfNJt0mY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWUsqIGmRUpSUJhg9jjeBFYzcRvzoJ0nDPkxunWi0oaQ&oe=6A7DCD45"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYCmV7SyVU0Q7kNvwFa7_5H&_nc_oc=AdourosphXECk0P1S0g7OpK5l_J4_igqYzD5JQu9D20HZgzJ7psh0DaC1Xgb1eEpB2Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyeK9DhXLnyK5r8HKu4sC80XsfqhFj5qhSjTe-bmWHXA&oe=6A7DB80F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utGT_ixAzrgQ7kNvwGasddt&_nc_oc=AdodbadbBqNDpCo99bfRUF3mXrOAMIfmJZYZdEJNSZsLGrIuzggqwUuYwGgBkQbEhiM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7LGBJ5DzNH0gEg6dczc-UHd-qzEVWRGhIWa2A-sMHLA&oe=6A7DB98E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23894288000165645"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1353160960282528"}, {"status": "PUBLISHED", "id": "1046228114937053"}, {"status": "PUBLISHED", "id": "1347150746840093"}, {"status": "PUBLISHED", "id": "1493847645399951"}, {"status": "PUBLISHED", "id": "26290359877308723"}, {"status": "PUBLISHED", "id": "1509787990230995"}, {"status": "PUBLISHED", "id": "978057017954385"}, {"status": "PUBLISHED", "id": "1296038948769871"}, {"status": "PUBLISHED", "id": "576214801776827"}, {"status": "PUBLISHED", "id": "1044332547263209"}]}, "baseline_offer": {"id": "1493847645399951"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787594400, "status": "PUBLISHED", "id": "1353160960282528"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27889868683940870", "version": "1.0.5"}, "id": 
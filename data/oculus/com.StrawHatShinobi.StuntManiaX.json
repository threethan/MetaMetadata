n.com/v/t64.5771-25/473393486_665249709834367_5690436015077876481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3X2rQfSfM0Q7kNvwEOF2jw&_nc_oc=AdmOT5AFoBGeUNcCK67IGhto2rlrMLWUH7N1XYxhQhTsasM0a4TUNt9uM_jE8BNdU9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5LdnZylm4PPmYKzjF2SyA5lLiHjNaJvVo9xVvZ1JhiA&oe=69B7FC82"}]}, "id": "10093044690739786", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv7JDIwb5OEQ7kNvwFyMLmQ&_nc_oc=AdmH-V716LUkZZHnX2DNZoZJwh9jXPclrp_wbv1LkF6j07NIiqz509lLrzQTGQssEG4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxk0yiGr2wSyqU4vx8BXrOFDWMw0QI4kh3ufIpEcBT2dw&oe=69B7F237"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Vy6qMOU3lgQ7kNvwFLJalh&_nc_oc=AdlHuonS-5KEkgSZCh7PpxE5G39R9AKnrn3PsVVH3kmUh-FNDP9pkJ5fMie5IAOoztI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyo3tTNQKvVMJV8s-S_7UNu4l07RpTbq4ff4wdNXRqEFA&oe=69B80218"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bjdEH-Xgh4Q7kNvwHQEpim&_nc_oc=Adm2zJ8sfDzpKQT2WRylhYCmApcE1yiQjAw6KkpDZGIZlvHrR1SFVyg1ErAC3lHv_gw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1WkqvkwaF7rLq3GJrePimi3AxYlHgqkDQDrJhp8ToUQ&oe=69B7FDC6"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1CYcH2VVw4Q7kNvwFVb5Xx&_nc_oc=AdlNh0w6LmY3yU6QVaMc4iB4mbw0_3a4SioQ77mOqcGNGZJPZVHbrtqmn7D_H4G2Nq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEidMlTeB5jvwyGWcVz_G369TwtQKZnjiKK_vBwJKnLg&oe=69B80C45"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1yYCzXyJA4Q7kNvwG_Go9a&_nc_oc=AdkclRF_lSlhd0-JNofluP1EmuAK1SqLGCxOJhcZFxh8hiZ7lUm9DreI2vJ8IXuZaXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeYzV9CWg-yPB34_iLvkIuc4i9HSNEVikXxn25xkzU3g&oe=69B7F70F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt3I1F3EA58Q7kNvwEfL_De&_nc_oc=AdlV3I63YLVlPASnd4GoNekmtvWeGQAPQNkRy_ODn1JLh4_BkOcInHFpxhOiiYl7iDo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwIdTfLfEn7hp2Ux6hr-Wv54gB325LxzmDByYJtjO4geA&oe=69B7F88E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
cCnsaPSdD7e2SdtK4aVi41PpAiWdmlrQs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L0NMXT8S3jfp4iuZNaRaloS1eysLqXJ86LJN_8pGKBQ&oe=6A09C945"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcx6DyPE2bwQ7kNvwFBTpXR&_nc_oc=AdpRH-clurgXaiOYVoSxwATom5d_aK08jwxlw06hB1EJweDd5am3u7ZrrmK8LGoCqiM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mB0293QtIzCm1VXSBaQl-DDytOxFDVVUW3BfaAIwC7Q&oe=6A09B40F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc-M9mqXtzUQ7kNvwHaieY_&_nc_oc=AdpKg3luW3L0BlyS0quyfEX6mbF1VTeVsViTcesbUIV7ey0YqMNYGRGKgPspUj72no4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HVg9ImZijLhpm1Rwj8D7oiqyrh_CWJmp_5UkorOAaUw&oe=6A09B58E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
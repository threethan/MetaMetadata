s://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393486_665249709834367_5690436015077876481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONYJSy6HSWwQ7kNvwEo50GE&_nc_oc=AdoB25vw9IiVXfzFDTxylqGlGqtHZUfTwPPkW9_F2LPs8jVDPVjxhnS37yYnD-q2Ei8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31i9_F5lLxvV_SGlBzb-vqN5lLl-XY5hBwSBuq-bFJ6A&oe=69D25A82"}]}, "id": "10093044690739786", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "994900486129777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392148_994900489463110_5014001089966543788_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbsUfVpmEzkQ7kNvwEZajgC&_nc_oc=Adoee5Mbr_Se9WhQcIi_yy2W_6IzkL3H3oFoOaLjzDJezaDv_qFYWfPuNnoaesBzQ8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06r17LbAz2j1wwMT4N9t75hVqSqdE1bkDs9spB2hDsiw&oe=69D25037"}, {"file_name": "ss2.png", "id": "3027884990726114", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400778_3027884994059447_7630401417387127577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URPVXqYyvg0Q7kNvwEvJBK5&_nc_oc=AdqxSEAIWaah1dkHKKwthQVfQ9UXYbHy7cZJNm9dmTrlFKqkYdUtU8hWjQja1Ki7JCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ass8vxYez08RkV9C0rq-H2GLccLuwXY4WyPavI3VGEw&oe=69D26018"}, {"file_name": "ss3.png", "id": "666132782862870", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391887_666132786196203_3306836798191494038_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW0OG0u0vcwQ7kNvwFC1vEb&_nc_oc=AdoOhJIsOSnaHTL0xWzDyNp_zLpHw7UiXHquISiiwBleK5i362_6qNKPpWFxhZXHwW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34uTfpj9bfBD4kGV3WwzMGQZz7p9UyVh6jnULflyWOBw&oe=69D25BC6"}, {"file_name": "ss4.png", "id": "1060019686034544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393333_1060019689367877_3649349240982617019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxRJfA_H-1AQ7kNvwERn-cc&_nc_oc=Adoe--SVAMs3gmJSYWZE8zqTzLFp8ipzk9WxVAbMNFkVaV9sljFzGOwFaxd7khNQgm8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RhkyaIJ1wDKzXnhuyDK4bmlwuClqQYoKCn_LmD4ZxXw&oe=69D26A45"}, {"file_name": "ss6.png", "id": "1401863104460099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394280_1401863107793432_7555648286168544609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeW5ieAtoswQ7kNvwFR0M_O&_nc_oc=AdrhCUlZlgFCEbtMUa-rwFsduoh-_f8Hjeas478qj5I80kkmHZk8tzvR4p_LV3g8pDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g7qWhgrT2VJPDj8c6-BNaxQ5m3I8RmODBFRXDn-bbzg&oe=69D2550F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1186592132768057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_1186592139434723_4312517559630060959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfbjO28DWEgQ7kNvwEZ18xJ&_nc_oc=AdokmeTUIB7cXO15BiLgu1BYla-J9wxROcUXtcv4l9KX6Dco37cBOawAGaSzvZjb6Tg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WkyYyWnGKqXC8J_xJWUIqgW7ZzsD0FNFCe0xPMbDmAg&oe=69D2568E"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 8 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory among leaderboards! (COMING SOON)\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 8 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and MORE COMING SOON!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
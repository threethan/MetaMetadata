f&oh=00_AQCMBqw2Tyl3EVSeq-cXqCTW7fzm-BHof5mhjygAyXv0aA&oe=6A5F58CC"}, {"file_name": "pp.png", "id": "1000599736081382", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_1000599739414715_7955993066935554699_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zgri9VrdjPUQ7kNvwHEZGBC&_nc_oc=AdpHrLJ62wSxTd5_dV7UrjXpu3JLRz-pLAuydiU1HwP--EWg8_B52tghowJwYGC3Qoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuYiDtl76UT6NaFFY56gLMG4XnElHzB699ERRJ6YhOwA&oe=6A5F6C56"}]}, "id": "1707956233846061", "locale": "en_US", "screenshots": [{"file_name": "ui room.png", "id": "1712903056614646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_1712903059947979_4340803759016352497_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhzTkFrRbf0Q7kNvwEAC-uy&_nc_oc=Adq4m-z7GeNxXfvUbdtsjXfWnxFxPirqb-VRbGwEofHKvvD6TM7yzoFrh-hyJ4s_H1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwZuFYPKThDh079QoUnWHVYpIjvhAMbd_L8EUQ6SVGsg&oe=6A5F707E"}, {"file_name": "com.StrawHatShinobi.StuntManiaX-20260629-210838_upscayl_1x_upscayl-standard-4x.png", "id": "1031014392912089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620504_1031014396245422_5578416037283300293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD8iA5GiG0oQ7kNvwETLkTL&_nc_oc=Adpp4WcmFeflriY-GYUnvYJ8xBef3_9HBlQdqOTIf6E3tHCW4JKV4FN3nAE99AguSYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcnY8e4QymVMI1YEbpcnoYL921tcX8YpnTBjOf20P5fA&oe=6A5F6ED5"}, {"file_name": "1920-C.png", "id": "1563195898570139", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507894088_1563195905236805_4485795279420815638_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99Hcxj9BrAkQ7kNvwHANL8m&_nc_oc=AdrUbqOVYdoa4b8VgGnzMGfw0T8PuCu5M4q7vAAqg-MaZNaVPgyoBIwDzRKr-v_2NBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4_hkU_Oc8R9MOVTLGIZ0YucaE1FbOnOzznlZfl_RHgA&oe=6A5F6055"}, {"file_name": "1920-E.png", "id": "1068495515503280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823812_1068495518836613_6378278017046238503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4VrFIsoi8wQ7kNvwGqB64-&_nc_oc=Adp51l593_8IgXbz12OtsUqrWO9_hEAdFXksmoTJqKoqOxvQfttE20LKUBfL23icgnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjbkksqka56m9RsPr0jlTEZ4np76TY2V5buSEjrmtrKQ&oe=6A5F53FB"}, {"file_name": "1920-G (1).png", "id": "27665562543083832", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_27665562576417162_8539978051617739066_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZqunInP3-AQ7kNvwHh32Qq&_nc_oc=Adr0LIocHmkUe6IQrSXyPexW85yDEWo11lMMPFHfsM5UBWqt50Ap9uZfhhxALHqndEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFLvvCraRHsyXiZyEYPPqzxbXCGVJAx9WIUh1DSzcK4A&oe=6A5F8846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverART2560-1440.png", "id": "1614965387297641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623443_1614965390630974_4511375871821283395_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7NxXi0YHFAQ7kNvwGjBd18&_nc_oc=Adrs-S6YTT3UJdR7KUcuxwXw2AuYm6xYt2dq9oRrg9AIY701v6cjvJK3L0uRarhNYYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVWsVCaWC0prAXBHZrA7WWG_vS9e9fvDkOXEfS9xbq3A&oe=6A5F598B"}, "display_name": "Stunt X Mania (SXM)", "keywords": ["Stunt", "Race", "Sports", "MotoX", "Racing"], "long_description": "# Push the limits, defy gravity, and perform insane stunts!\n\n\ud83c\udfae **Game Overview**: \nStunt X Mania isn't just a game, it's an experience. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! Hone your riding skills and go on a frenzy of stunts, wheelies, endos, 360 flips, and more. Our early access will help you get ready for our exciting next updates\n\n\ud83c\udfc1 **Key Features**\n- Perform 360 flips, Superman, Cliffhanger, Lazy-boy, and Heel-clicker and 8 more stunts!\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics, wheelies, endos, whips, and crazy jumps!\n\n\ud83d\udd79\ufe0f **Game Modes**\n\n- **Free Roam** -  No-holds barred, perform tricks without thinking of running out of time across 5 CRAZY ARENAS!\n\n- **Career Mode** - Perform stunts to earn points and finish the lap before time ends and ride to glory .\n\n- **Challenges Mode** - Perform stunts to earn points and  other objectives .\n\n- **Co-op** - Ride with friends and family, display your skills and become a pro! (COMING SOON)\n\n- **Multiplayer** - Be the Master, champion lobbies, and boast your skills! (COMING SOON)\n\n\ud83c\udfa7 **Immersive Soundtrack**\n\n- **High-energy electronic beats** to enhance your ride. Featuring tracks from our own indie-crew.\n\nThis is not the end! We will bring enhancing updates across the game, more stunts, new arenas, a brand new store, DLCs and more. **Stunt X Mania is the place to be, you can't miss it!**", "short_description": "Stunt X Mania (SXM) is an adrenaline-pumping motocross and stunts game where players perform freestyle tricks, defy physics, and hone their motocross skills across electrifying open arenas. With hyper realistic bike control and high-speed circuits, and crazy stunts, Stunt X Mania is for thrill-seekers. Enjoy 20 arenas, hyper-realistic bike controls, wheelies, endos, 360 flips. You want more? Execute Superman, Lazy Boy, Cliffhangers, Heel Click stunts right now! Career Mode and Challenges Mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
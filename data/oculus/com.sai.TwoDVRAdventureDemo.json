uluscdn.com/v/t64.5771-25/39036642_785020340369336_5472607669293484076_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUtCPxotZZEQ7kNvwHFw7lz&_nc_oc=AdpvuZuVwhuSdDHsKZnksx9KsKrNL1Bpkefdy6P6hGd65uGo8LXJ7FV333tCw_RHwV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgz4T1kErNB4RMNXAvAcJbbnNl4NfOcNlRrsfBZ4affQ&oe=6B0302CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demosamne.png", "id": "212321397503041", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035319_212321400836374_4334920997318129896_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXr0diq94BcQ7kNvwH8kTXr&_nc_oc=AdrRIkBdn_tvAnIBBsPzMO8XLI9s0-qn37_rEVu_r0JuD3AGfwalxk9d2Cdo_gYXTxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMx5PF9GuDA9RrwmCbvbX0wRmtiEWI6TqgHNybpnLLMw&oe=6B033ABE"}, "display_name": "2DLike Adventure Demo", "keywords": ["retro", "Difficult", "Timetrial", "RTA", "\u30ec\u30c8\u30ed"], "long_description": "This game is\nThis is a trial version of \"2DLike Adventure\".\n\nIn the demo version\nYou can play some of the stages.\nIf you like it, please purchase the full version!\n\nThis game is\nUse dash and jump to reach the goal.\nto reach the goal of the stage.\njumping action game.\n\n\nOperation Description\nLStick(Left/Right)     \n-Move\u3000\u3000\n\nLStick(Left/Right) +Hold B\n-Dash\u3000\n\nA Button\n-Jump\n\n------------------------\n\nStory\nThe orb that brings peace to the world has been stolen by an evil dragon!\n\nThe heroes are now\nTo reclaim the orb!", "short_description": "Use your jumping and dashing skills to reach the goal of the stage!\n\nAn old-fashioned\n2D style jumping action game!\n\nThe game features a variety of unique stages, \nincluding beach, Japanese style, and ice world.\n\nThe game is simple, yet deep.\nchallenging stages await you!\n\nLet's go on a journey into the 2D world!"}]}, "developer_name": null, "developer_privacy_policy_ur
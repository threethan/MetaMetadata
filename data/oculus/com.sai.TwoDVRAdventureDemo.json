uluscdn.com/v/t64.5771-25/39036642_785020340369336_5472607669293484076_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQbCEqEeEF0Q7kNvwG0fhd1&_nc_oc=Adrpo-tD4Wok8y82Kxwy_oV_chvUPpFL7fSRDjBw7ZHjLWUwN4TNMyJLNrrXZApKS4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYOzuGTGhv525Cv5OVbF3iWx2FiFTwda0I0JOT9ERYbA&oe=6B04544D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demosamne.png", "id": "212321397503041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035319_212321400836374_4334920997318129896_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXr0diq94BcQ7kNvwGZ3z8c&_nc_oc=AdoKAVb3qe-s0ZKVe-yU12-INTPmROGwdM6GVcO3YvymG_qyz9YAykP_1qWeY2q766c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoDdApb7o7eUTESYEOIw7tCOZJU-7gxxtOiE2f5lwKSg&oe=6B0453FE"}, "display_name": "2DLike Adventure Demo", "keywords": ["retro", "Difficult", "Timetrial", "RTA", "\u30ec\u30c8\u30ed"], "long_description": "This game is\nThis is a trial version of \"2DLike Adventure\".\n\nIn the demo version\nYou can play some of the stages.\nIf you like it, please purchase the full version!\n\nThis game is\nUse dash and jump to reach the goal.\nto reach the goal of the stage.\njumping action game.\n\n\nOperation Description\nLStick(Left/Right)     \n-Move\u3000\u3000\n\nLStick(Left/Right) +Hold B\n-Dash\u3000\n\nA Button\n-Jump\n\n------------------------\n\nStory\nThe orb that brings peace to the world has been stolen by an evil dragon!\n\nThe heroes are now\nTo reclaim the orb!", "short_description": "Use your jumping and dashing skills to reach the goal of the stage!\n\nAn old-fashioned\n2D style jumping action game!\n\nThe game features a variety of unique stages, \nincluding beach, Japanese style, and ice world.\n\nThe game is simple, yet deep.\nchallenging stages await you!\n\nLet's go on a journey into the 2D world!"}]}, "developer_name": null, "developer_privacy_policy_ur
uluscdn.com/v/t64.5771-25/39036642_785020340369336_5472607669293484076_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19t2iNL3_t8Q7kNvwHtyXCD&_nc_oc=AdqFz-87TwdujqimA2LT2Ls_xmB-lDW0byvnCBBVRH9Xkr2KAK9bbu0O6bvBfK02gy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRn9BM__tmNxWGwy15_snTMua23mptcIu9ZjWVx2g57MQ&oe=6B0DC70D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demosamne.png", "id": "212321397503041", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035319_212321400836374_4334920997318129896_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlXsp6DZyYwQ7kNvwENPefW&_nc_oc=AdpwPhfQgxL2R4wHVrqvI91FJL8Ri1SnJVdqzgWP4lISP7x0iulJMjDl4CRm3OKd5SI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMaIgKiEJYdA00QJF9IgoadfpXQ-N0MbGsXrpTLTBDYQ&oe=6B0DC6BE"}, "display_name": "2DLike Adventure Demo", "keywords": ["retro", "Difficult", "Timetrial", "RTA", "\u30ec\u30c8\u30ed"], "long_description": "This game is\nThis is a trial version of \"2DLike Adventure\".\n\nIn the demo version\nYou can play some of the stages.\nIf you like it, please purchase the full version!\n\nThis game is\nUse dash and jump to reach the goal.\nto reach the goal of the stage.\njumping action game.\n\n\nOperation Description\nLStick(Left/Right)     \n-Move\u3000\u3000\n\nLStick(Left/Right) +Hold B\n-Dash\u3000\n\nA Button\n-Jump\n\n------------------------\n\nStory\nThe orb that brings peace to the world has been stolen by an evil dragon!\n\nThe heroes are now\nTo reclaim the orb!", "short_description": "Use your jumping and dashing skills to reach the goal of the stage!\n\nAn old-fashioned\n2D style jumping action game!\n\nThe game features a variety of unique stages, \nincluding beach, Japanese style, and ice world.\n\nThe game is simple, yet deep.\nchallenging stages await you!\n\nLet's go on a journey into the 2D world!"}]}, "developer_name": null, "developer_privacy_policy_ur
Ke_0tiXTDrlhMmc4Wn_Iw4U1k_jutEsA&oe=69D7B541"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zc4P8ppOiKwQ7kNvwFqDw2U&_nc_oc=Adrmd4Xja4F_NMAfE1pz_k-ZnwwBahG9_QbcUulUXWF7alHNVJkL8iKQoLqXoxTQ2qQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s1aSYwRYtL24diVoS5cE8obqGu43xcDmzqbk70JCUmQ&oe=69D7A753"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sJzIoPiGmgQ7kNvwGDZTX4&_nc_oc=AdrNY4JAc4-4oTaNeHZHnb0l0M4775bf3hO4X531m7LlorANAK2RvjuLar21O3Oeu60&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vL6AS4CRdiaxghkn4gfMnKymzHQkaSzioKs_pP6Yn2Q&oe=69D79501"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sJXvMuD4qoQ7kNvwHC7XPJ&_nc_oc=Adoqv_NuJsAD3tmea687E8kqCXD3DcCEjjSwHXlU71xQMw2s3pZzL5yNOX602Xiq8pw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1St1nXViA2QpaIqlWqsDFUF37XeotsOTmeitWPFhdHSQ&oe=69D7941A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzagWqIZ09kQ7kNvwFuFede&_nc_oc=AdqTRPSwnAv_mmfqE2R0Gr86dBYq48KXT9wlLCMZOLpX0TqeywqrSEa5akVf2x9qWUY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Fq9WkaaJ9A-7p-FPufNpIBEbVoki-ChMPZDYTfsnE_w&oe=69D7A6A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
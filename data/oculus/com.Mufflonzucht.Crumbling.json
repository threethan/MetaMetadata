h=00_Af3rBlAQsyw8v5WOBwZrJ-XuUfPi5FNg-k9G4Ov1eKM-Tg&oe=69F37623"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBSVoNFT73MQ7kNvwGqimuJ&_nc_oc=AdroOpA9JWcg1AGrcl30p1MLTLwAp4dxckjQ50ppP9xC5Hpr5tCS4hIqOWx_cUIxezM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_nFSkHP6Is_itOWHzmuGnoQh3nFuyx5d1Rh8Nndns5A&oe=69F37328"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YngH_rBPW0YQ7kNvwH0Zhp_&_nc_oc=Adplm_8lPu1iret5kXun8PQ2sLWUlSapq4r7uoIO4o_6BcN8O2SjiBRXNlJo26jvNV0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nKKS-lHR_TfplsRW6gsp2bYmkFOWThzD-wXCfGb7vaA&oe=69F35E65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af7aSZ8L_X7BYCLjO3ikVnRQK0Tfs877GiEr8jB8FBTf3Q&oe=6A107723"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0APzP_7ctcEQ7kNvwFYDm-p&_nc_oc=Ado7M6CFKFB3CJ57fHSgHRxJ2oueUY-QytEouoVAhiCsMyHjQRyDqpFBh1wa0Hkr5nk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ya3FSbZh95QVdLlxyLbWvtzg-ZX4E25cTxaKso_yxmQ&oe=6A107428"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kUxhn-YjEwQ7kNvwGjfqaV&_nc_oc=AdrX1diYD_VigsWSa7mrr8MTyDj02XMsTk_QG--6PsUekYQ8hKG4eSVfz5FZA0-gPTg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hPJH3ekBekznMXCUrqAbPpB5UnghNcJcvikqbwwpX9g&oe=6A105F65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
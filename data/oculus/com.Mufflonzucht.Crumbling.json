iSLcIxVgAIdVtSNSTPB8Z7fQqE2qcroA&oe=6A1EE641"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_whn22SjqQkQ7kNvwGKCCI7&_nc_oc=AdqJKJWpoPALww1ouFbrwtPd4k-CDXlkdDkZZBlZzbxbsgRxFufdrs81oDQ4_tpjnn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ShXV3jHyy1NGQhnn-XPYRm8QLv9yUgMoWa_HxDwdWgA&oe=6A1ED853"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUT_3nmJkwoQ7kNvwG4Y9pT&_nc_oc=AdoXQ5hX5n85lim8eAZzCsNVx3Mo8ojPjVExkQszq_EbtgNaojR0T0ZB6GV8h3yto3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jwJqOJuwSYOCoHItlPZgi5yZ11RWj5VEsvRig-naYxA&oe=6A1EFE41"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2m1zmo3w-EQ7kNvwGroGmn&_nc_oc=AdpW91hHvTlRisIAMvH5i7Vpd_aSsg_PsRzNpLxHyBzYKWI3t4LFE4l81cNV1A_409Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O4D7Ac_M4AYRSad4x-VIfwJKCS_Eaimf8ahp97jSdTg&oe=6A1EFD5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqPd7hCw6UwQ7kNvwEP2R7W&_nc_oc=AdpEHXkJUC5I-z0zdjKG520KYCyuybRAsVIpapPZa-PUTYbYH_PxUv_hsBRDxjrdku4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aIVYo40A2u2J9TEdDafJm5EL0veJ2qLJePEh5-vy_iA&oe=6A1ED7A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
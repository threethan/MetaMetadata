U-2hUeYcCktMxqmehcCvNo-Gd201vVpw&oe=6AC50341"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AarwDFNiC_8Q7kNvwFukjUb&_nc_oc=AdrfuFKouLuUbWckxx6_PIee9lqe_mmp1CrfbOzR9E_mX_BrMw-9-Cy-Fb2GN8Pqfb8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEdWEYt-REBnhpn7tct3M0L47wHA1V6qOqIs_mpizxQg&oe=6AC4F553"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b64Z63_PDrcQ7kNvwGpY7cn&_nc_oc=Adpf90A11Vsr_8LwmeZlV9LbFQAo57Jox4fHw7E9DNmR1V79afXiIdP9EkIhWs5uWuA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrdIakDwtnGxEkiwlW8EYh6b_DjYAUXjDRQci-brRw3Q&oe=6AC51B41"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkwD3voMOYEQ7kNvwHEgxYf&_nc_oc=AdrUXhkBifujLN_wRpp8rR4NQRkpcgdr3XLDWNeRx8gvXH3Qqlcr-8RoAkctNIlOB_4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBZnCMFdtC0dzjXVw05ZEbx4egOI7L9mYlQk3mAAdCNA&oe=6AC51A5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZzeSNzSEJsQ7kNvwHvGT8o&_nc_oc=AdoJpybrV-rsQkLFyn6wFDm3rNWEOxr83_oAW_WVtF7oZFd-bjnYIWVJs7C_UaWn4cc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiYAf5Pz5ELZcDzcaQepbCuJ4n6P_4g5kfJgOTUrXTaA&oe=6AC4F4A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
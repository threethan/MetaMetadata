h=00_Af1eG4ODrT0wngut5Yqeqgzzm194sJa2xiae7l8bIVG07w&oe=69F4C7A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBSVoNFT73MQ7kNvwFvtnzy&_nc_oc=AdqLH8-xsT21T9FYGvjB6mjnIB5vAFNXiyrLWvd1C0cHM8AYQnnl0rU22qKkn2O3Mns&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AVBHirxnSCE10rsZYfB3KrS05OXLz1Rp4aFjv6EbaoQ&oe=69F4C4A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuNcRHLMBvgQ7kNvwHmW0fu&_nc_oc=Ado_i94pc9-IAhx5YUJxgqC0NrL0W1iDzglRtTIoCd0Pjso-eNKcTsx0ENQVKXPevhY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mQug56rOy4DHR9xYCVEo3ht98NvduWVdzRKOsHzs94g&oe=69F4AFE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af39qavHFqJsJ_Me6YK76cnH0QvXl9edilMpCqPhnMizsQ&oe=69E64723"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUdm9QKJPoIQ7kNvwEuBRUP&_nc_oc=AdpXPnXOikOMH2oi6Vffwu-aIo_NCz3kxfhLVZFz5QJZn-seBbZbgcDVj1J69Q-B_eY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22ctoAW5MnUaMsALRBZ5d-mmLQ1jLTaLljTGjOoMpgbQ&oe=69E64428"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3T4i1S3JF8Q7kNvwH06GzF&_nc_oc=AdrUdPZGSLw90j9EnP-zqFNwo37A7oT0IL75OlfhNUk7Tw4vKEDrZ9Xu81wRrZ7SMlk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dM9GgH1-JJB-wJ19xY9w6lZGvQCowvSJWXfMgBUWHJA&oe=69E62F65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
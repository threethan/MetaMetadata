6Zj0wfuxVf-Si5E6qw2sUK9X4Q3364wA&oe=69F607C1"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kS3OHw_ZqcQ7kNvwEt1F44&_nc_oc=AdrFVK8fosdGVdvzIHkAaKeki0jaP3Ncxy62QpK_ZUEOt4_IF6iMKoUChjvDusZH4G4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0g9eeTvKbrPoVwkYyc3scCu-Zh5wu5SBR8l8xusGGkYA&oe=69F5F9D3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0uf6Gq0VSQQ7kNvwH7Java&_nc_oc=AdpLgwlK9ssZyaNPesoskbWo8oyqX3OSGO9hX1nTVe0NgQv2SCuEokl1UTZEk-YX8wo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jcCpq7PIUST5mk1abL-yMdZEg5vxH9itaKKX0K78Ihg&oe=69F5E781"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAvo0FzB3f8Q7kNvwGlpWD_&_nc_oc=AdqwLi_SsB_xQNeSEh1VrUZubXTnyiUE-wAm4arUaIANIlVLziX4UYjcTu0Z9An_nx8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lO_O5zOqCjfBS2gWFexh88pog7Edl8qfPGu73qq2-QA&oe=69F5E69A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLqX6tASPF8Q7kNvwG6EeQ5&_nc_oc=Adp377wpHjWDdKKu4A_XSfLihmV6t8QNMgHgLk83uY8ItY0mCSWaro-cbFzGpf_zCfc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DHzjOfktE9GHxL-laiU2x5uwGVdbo1cmvmPtcaVDEmQ&oe=69F5F924"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
Elkzb-bgRYhIBgbOoHkh78_NYefBaIfw&oe=69C54041"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeYLplzD2rAQ7kNvwGY2EIV&_nc_oc=Adr9f2M4CFKb9PR9_Sh3CRa2eXEj9JKbL38I8Kl6trlOqoEAD5yRAWm7k5ztBmoW1Qo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwg2ZjGn0DDtL_Bbah1C_EBJnRe13Wu-j207CS_RE7j7Q&oe=69C53253"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAjuXNj5ksQQ7kNvwF1XM8B&_nc_oc=Ado8t9_fo_Ev40mPQsOGc_KOzKghJolP0rH52aAp0o7COxpk6DvB6PRY281jVwniBws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzndmF_4CvrSuMJYXvU9rEPjPlET06H-EVOz_pQeitkPQ&oe=69C52001"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1QYwZA2eUoQ7kNvwFwddtJ&_nc_oc=AdoscmFxdQ2VjG_OiI6GSC581n0U265WiZn2T7mVy-YyMDo8sj9Jrzr4daRRxA1kqKo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afygk2hjt-8Tl4OOj5HKCjncMKYalokTJ909ajtgu_GBtA&oe=69C51F1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCMjWm1IiMcQ7kNvwHyOZa8&_nc_oc=AdrXojRBEquNR9h5bUlwvXlzwoYUnqbXVxAikRc1KBHOKaOM7NqbSN0xxrlVgrGOF3M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdUafdL4hlBoMZ3tSvjqoaTNkvKxZ-5byccfm8tBvydw&oe=69C531A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
h=00_Af3I0EFCujlbj1zX5y7GWBTQkbdzaQbWPukBOyn1gvSgpg&oe=69E4BD63"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ6L65yB500Q7kNvwF3bVGi&_nc_oc=Adr8a_PfvUjfl3VGc5SKhg39mOCNa_wSiwatZUSiwSoXLXPIZSF1PBUpXReYGgQUfss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aERRCjQ8b2mrvoed89SPBL0DvpNQBUSfRah6Kk2Nueg&oe=69E4BA68"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3T4i1S3JF8Q7kNvwGgnzFz&_nc_oc=AdpvyZyCOawaB3cNdYBjWoIVJ_o7Rcteks5vcTtD-4XhRU-_pOWm5jsJld5lxc4tTtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21mnOZiC3IJs4Liaudhfa0VkMN3mUzp_OcUfHgAV3BgQ&oe=69E4DDE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
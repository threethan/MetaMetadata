9DTQbMOTaUUzBAzKKYbuNIIr6yxzfMCA&oe=6A37F2C1"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4rRyDAMJSIQ7kNvwEN8h7Y&_nc_oc=AdruLSmOF-jtronLVGT6BzGhzqX6B1zgnIi_dRDqvVCo-_5dWM7yXMu9HdXck-Y0pv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AgMPh30q4746Tww9odtrGsVX3jMDTrQQKxBgeY54a_g&oe=6A37E4D3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NkASNxjzd8Q7kNvwHDAjWs&_nc_oc=AdrfiZaJIHCJQF6Vh23jFnr-HaLLT9Sc9oAaPUuiDs-XhyWtUPuzKkvne4w5qga1XNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aGKvD4PTTLlbBNoUkEcZlDMYgcrb5HYvA2fpw-NEBQg&oe=6A380AC1"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0V__EtZjtgQ7kNvwGG5XVx&_nc_oc=AdpGPjkiwBB9WXEgDY9I_i1DHkd321tSowkdkbNw_Nk9zae8pJRuaZcvlGI4RDSXeY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w15PYpAGCRfa07HU9EyCpI_LzM0-bxEY44FPGPMkauw&oe=6A3809DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHEgEAK3zHEQ7kNvwGDpgP8&_nc_oc=Adp_WKmlmUZ1wl96NEi1k5I-iikKJi7IPYxSmP8GnrXRYVTozzTTDcc2RxRn3pOLgx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r4F0Wv9cNvnrX19UTPkVGYgoYaGJlSIiXm5xTl7hu_Q&oe=6A37E424"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
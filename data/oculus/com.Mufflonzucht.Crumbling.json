h=00_AQHmCj5ljqeLAY2weia0PSwUqrc7j5OEbubMjxAH_DRKJA&oe=6A95D6E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOOT8Fv_3R0Q7kNvwHVk8_0&_nc_oc=Adp8F0H3ntWuHYi6FfiNwr5qsPJ8IT0MqLhZ1ORiujpdzcOMAvrIHl6HGlAgUbVV4Wk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsa6M5_fiybT5jM_nlzeaD51xDRmPaGkp6oDmwxI9eEw&oe=6A95D3E8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWjybGM740gQ7kNvwHpxkuC&_nc_oc=Adr-asltbgib_bAXUDYOBVO-7HqCcIUm5Q_TVAoL-ayeJ7WfMpsR66FvacC8tylY7dI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdu98Kqds7fVCFuEAHIUM4YytlFwkVDbnVVWK1uqzHdQ&oe=6A95BF25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
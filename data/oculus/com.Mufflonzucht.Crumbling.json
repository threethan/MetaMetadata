h=00_AQFQ7ICuGh_iad-lUp6QrRtAZs9lMBNGw--0IX7xpKWDvA&oe=6A804E63"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U-IKzGkiW4Q7kNvwFmzrJH&_nc_oc=AdqJDBm4dcRgd0yMO7OtxmeTiYPG0H56HOD0YG6dk1S9WjwClX-WHNo8tEV879lXmUk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFUqQJH73EbgjHBIdf4E7SpDasB8iOKIifCyd5gHHBEQ&oe=6A804B68"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpomJpPPP-cQ7kNvwHaQw8k&_nc_oc=AdrUXYC-_3469W4MoP5vqyCUry0fBg9Lhv3U0YM2mx9RQIYubtMiTPeR2UQs7FbPLhk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9rutz_uu9tqxpYT7Ft5tdwZzvSH3Urvv560wz9s65xA&oe=6A806EE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
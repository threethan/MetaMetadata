h=00_Af0YrCq3MXU6gETS0hiQsqAwP9zrsAzsc4lnctGRj_D8jQ&oe=69DA3163"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmBsakOVxNEQ7kNvwGfdw2P&_nc_oc=Adp06W_vib6YzMJ0TNLKvzR6y86yfbcEEsh1QxvG8NUm6YeAhuEHENssV1XhlRvgLI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H2Ic_QmznhsSroi6U05-6xsjV4YQNnqSUBG_RhNFdqw&oe=69DA2E68"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rHOUfN5Q-IQ7kNvwFq8VYm&_nc_oc=Adr1CVGnkNcWoMV-f40ZRexnKuunnzRy-Ktyr4QH8lx0S4ZyfOPcMCTYpWZj97VssRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y95WGadsh7MvBwfvBNS1xjibjr08kHaej2C4lGI1V9g&oe=69DA51E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
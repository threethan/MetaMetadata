h=00_AQA3G0jqorXHFK_ZnGis1ijqOZQ4_U1-9LG1Iu1w_WJBtg&oe=6A5F58E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAIKDy6f_AgQ7kNvwEQgon_&_nc_oc=AdqMYXTHp6_3PE1EbNDy54rCxNzGe5t335s5nepGwZxiFPBVgBUxXPR-wG-Qe1MwodM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYEmly002Bj0DyclCDrYQTk7srnRZS4VihDT2BeQNZbg&oe=6A5F55E8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vi_pPvItigQ7kNvwFmGFxX&_nc_oc=AdqF_FrI1UmlvkA4I1iRA2suZSSVI3UzvjQWUAAHi-9_yViIrqWPE2bLYW5ee4OAZ90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB112cyy8dInQM-yz-LWeULdscRLWTiOakn6Ox6WCx95g&oe=6A5F7965"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af6c-P_ADmrJ2Er5bi9o2a13D-uHrJS0ETy9p2_2dWSrOA&oe=69FB26E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dgj-THAKWygQ7kNvwH95b6B&_nc_oc=AdpYuXXkYcOQ3qi2y2Iyrzxenr37R7g0nJ6LWmke7b3elzQmDiHemktvBHRL-rS61v8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N5GgLKReWBHxjk-XUzbS4fKe65CadQ4rkCN3D-2cStA&oe=69FB5C28"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFZGZ7lBpwcQ7kNvwHFxLUn&_nc_oc=AdpiSYzUsbiQEnfpC0F_CvKCnR3jcGGCBsw9cSWsYgkgSNvzh7Dz_alv5x-WAH_2va4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63_vqgoBp7x-8DCtw9XicZ46dgTSaHjKpYkkrV50U8Yg&oe=69FB4765"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
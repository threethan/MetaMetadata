h=00_AfyQ47diK6TcU_MsNPOR2FHRUMk9nc7LcO89W-Ix7kEYrw&oe=69CBB0E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bmd0Of5bzaYQ7kNvwE8nRyv&_nc_oc=AdqUcSckv9PZiU-cNQvu4J4tzqiMKFkxAHP1MFykZppN3MquSZMWq7sZcOoQ_6zmj78&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzNCv33_kLjkE3Gu6BW1M1wO8OsY-nKfuJXwYeW3B3zw&oe=69CBADE8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V7sIOSNIdIQ7kNvwGw5JZ8&_nc_oc=Ado0O4nWlF3ICn0pcoFxV-bjH8GZO1YO8tFfFFa7VuNhrqcgu3wo9dTvaHIoxVEY_y4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUJKqwm7i_ypBOEGh46nJXk0dU9ORRWPNeBcp7QFmg7w&oe=69CBD165"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af0Cf65y4gBM6dR3oOgKHOnA1my_29ihXqiRz1t3axB5qA&oe=69DF7763"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIp3rbbVYU4Q7kNvwHZmDXh&_nc_oc=AdpjJGv-4lDtz5n5qYYRFkB5pnmv5_f2xmXmJu0phPNbR30jw-0iVgsceIg5PmFSh84&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YBUGjPn29YnhQZ4eoH8AIfO-cwOWG3Iiad2rRu5Fnjg&oe=69DF7468"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-mgp8KXN9oQ7kNvwEvYq-V&_nc_oc=Adp0NSs4uBYM-n2Bp6KDcKfuC85aUVH0yK_7dojTtSWuKtURT1xxUGylOzg2J_4iO9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3INxmy57IaWocB1Nag1lm3G8pQ5TERV87P29Y-7XnmMw&oe=69DF97E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
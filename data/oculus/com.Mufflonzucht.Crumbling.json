sXvP07Oonk38l1gZ1JlFdLB3Z0LQFOmQ&oe=6AA6B0C1"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4tk_45q5agQ7kNvwFmgnHS&_nc_oc=AdpbJGV-xet6vKQQZviaHKeWd7RLe-mlCPWDKbmCmaaDYyprrMD-GHMuB0JunYg3yJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvCyKmd0nVtGa5yDbDJJUZWUsuwxaDTkEvS22u5ljuWQ&oe=6AA6A2D3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb7ZPbcKEh0Q7kNvwEDkXHB&_nc_oc=AdoC6cVjIgtpHxu0y-1zt2Hr077b4J1MSoQ0Mdws67unj576YYzloKewQ1L2wAmwG9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKde2rBzsMEIwSmW4MA-hNA6PNXJtPoLH244odLp12Cew&oe=6AA6C8C1"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0cSCPnwx5UQ7kNvwFpbJLe&_nc_oc=AdrXcd3uG9NO7KQWr_iUEgcWB9HFL4D4tL1WFMlIM8hOd0BivAK6bK9dcaWQ3OwEocI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGszA-xpMyzMQ80ZVV-P-3KZbp6pJ6YlDTSJ5xjodQ-Q&oe=6AA6C7DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jOjxCi2f9wQ7kNvwG59DdR&_nc_oc=AdoYou8Yzs5vGwhcA-aJ981f_LmLcO1Te7anUaPgoX_jJBOoBBTwKQ9EkDSVLsRB2bo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqbsVtWf_HQVtUdlagH0xKZ5AXclc8rHoE39GrGXjm4A&oe=6AA6A224"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
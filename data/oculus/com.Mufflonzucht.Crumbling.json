h=00_Af-zLFKrzyh0abrB_KRoWcuE4AGUAxwkYapaFxTXmrkh_g&oe=6A380423"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POXDdzmEQjYQ7kNvwG0-Y40&_nc_oc=AdrzIvztwbdJpj3iAlbmDn-YXFtqXvhTGl0w02Pgg2k5sVVL6vrJPiBWT0X6C5PWudk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hv2C_KcoMJgb3On7E31vghomDFfOPwuyG4rfEGz7Tvw&oe=6A380128"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmKwZClpC0wQ7kNvwFUcEEG&_nc_oc=Adq2vlqL1J5z-ntiyCm9-mYDXMeC2XIArCpVU1Uv6VmS_C5jRwxcWluEUHdCaDcS4Us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hhT-Mjzn-0Pa59iJ7LLwGOOolZ2fu8BZoYxVJkAGKCQ&oe=6A37EC65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
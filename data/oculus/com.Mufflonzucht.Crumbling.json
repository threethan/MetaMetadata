R1X-qPXPzkKG8fGjq4RR4vYJfmAvPjoQ&oe=6A81C6C1"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5Tyzes5-bEQ7kNvwEbF3Wc&_nc_oc=AdoV7s2Pi9aX1buGRsBAoFtmQlhFhEzpsSZvQf5P4R3gZoeIzZ3LZ5NpiLYXUSM0u24&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8_j56mVaK6ewMDcrJV3JABqxY-jDbQcCVkFjJthf_VQ&oe=6A81B8D3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxWhLtrqqZgQ7kNvwHzaJCi&_nc_oc=AdoO28sd03Kx6c0MH-b8MJ4I8jL3NSjyqZRJJW19fw5ezrlrkFuM7lEfQysPb9LQASQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB37ICjSQD1VYQlCT9vzeo7IKPfOrtv1jQR0uuGoiNNQ&oe=6A81A681"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpMyebBXf-8Q7kNvwGmnxiZ&_nc_oc=AdqNr9mf6Dbwv5dbds9RQPLYrGYG2Bsb_TwYPk9_-MJ4Y148msOFojf-o4L-o9l60xg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwEvU-myxYmaJH29zZr8WslCgsV86KDEwC8Ut3_4nLzQ&oe=6A81A59A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Asn7-I4Z6RYQ7kNvwFesOEX&_nc_oc=Adrjj_S_MWD-J_Fzokxx4fJJp7mpKsjl269tbgIlZUJo7xScWHIHrj2cFBfFZjslQw8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW38jZuBzcDAoa_d9nm9cxg4yVqR_s6HVx8t3OPTPhog&oe=6A81B824"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
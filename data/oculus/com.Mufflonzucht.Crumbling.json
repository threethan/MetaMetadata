ng", "id": "885734758938773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUGwd41406IQ7kNvwFpdpxp&_nc_oc=Adm9W9I0bjfphZOUQd0xGV4PKP6ECY_iEOQQx00uj91jMcgoZlhpio3PEenKSENXfR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwg9m4oNCBWK01WHkh4YNdCDOljAVSn0eNNuKiBKVu7nQ&oe=69BFD068"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n1nzdxMvzQQ7kNvwFHqOfL&_nc_oc=Admz8P2q9fOgm6UvArJj1FcZSgH76oLi9NSK4VESIpuZy_7fNtSz0OJi9YJ8RBVVQJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwctLQYWI_pWuN17-oS_INKXbpqUZGh4WWT84Q6P7fNJg&oe=69BFF3E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "
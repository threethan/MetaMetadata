h=00_Af4_jOvhP1FBKBeLI6kFtX7NH3p1f9OrK_a3rJLfGQQSdw&oe=6A186023"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKuZ-QxuxjcQ7kNvwFMWbxc&_nc_oc=AdosIveDgN6YcmekDLgv0OybQVA58lKTWbe9BBClDsGCiibT3SmVu3osvtecYzs1-kg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bHlM2tMy1muS40KEJ1J4KccTn72h8g8tr4f1PKEAVLA&oe=6A185D28"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOpDTNTE64QQ7kNvwH-0B8O&_nc_oc=AdrYvX81HfqIqoOM1s4p5J6KMPZwu-5pfHt-GMY7dOZUl6MN2TC5yHEcySqqLo69teo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wPDLh-RlCDCB9JiubwP8UbMlsajkdx2O-qOfZZqwkwg&oe=6A184865"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
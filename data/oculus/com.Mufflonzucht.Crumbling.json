P_8gXukEtSCD6DBRG9Q01s-K54clXUVg&oe=6A916081"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWznBlGA_PUQ7kNvwHJTH9P&_nc_oc=Adq8K3Q3j7RxRqIPPcX-qD098RLTsHfte7xld8Paw8ojShMlH1zQpzbW99AOBZvSe4U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj2eoxnrcniGsWGnQSpvk4u5wlmqXxEkRWi7wHjE0W-g&oe=6A918AD3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxQGQZMhLGYQ7kNvwH-KrCt&_nc_oc=Adqt1qJws1Odffmk-gsa9OWrCE63dHQ_PJsbSwZX39-5AX9q6Ckx-XhW-rjPw6aQntg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpnQyyyOTGuzrgPLDqW83laaALF4x-34AR9lM_-3GuOA&oe=6A917881"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4w1uUfb1CkQ7kNvwEnOsgH&_nc_oc=Adq7MI3aNU7m7AtP1EPmlGoo_9tI7JeM9i3IwZOPhXIpCia_DlK1YVMqR7FyFFpdo3U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET2hGK3o2R0fMqvrnBx3_t_kXGQV1GrefHhMp2nBVduQ&oe=6A91779A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VTEmUrD1GYQ7kNvwHDbGoU&_nc_oc=AdqwtaMZaMQ1ToZ9gvWGArHAu_FsoxdY-d70dY9gpH8drjTOemnAgBwEiV_dmKkKajs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJlWM4UprXmKjoXDBQ1DJltNHiZzjWx4ZqeFjHu_goZQ&oe=6A918A24"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
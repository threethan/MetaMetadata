h=00_Af0UMIT5hVfu94_0VbhzDvxppXppaMe1qE0YfFbGOY49eg&oe=69E36BE3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ6L65yB500Q7kNvwFmehNr&_nc_oc=AdqXnUf2QYCY3VHGJgyODHvR9BeeBNyUz216ZJXI-Y4C78gqXuUzhaF9vHsHasaQVLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NPyKmI1WL7R6OAJcpGJv2_9Xfd5I4J8bqz8sdVBurJQ&oe=69E368E8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9b2QPebG_bYQ7kNvwHZQ7i8&_nc_oc=Adp8wR72gFAXlx-cFCoAoE9mcg23pSFvACXNMsciqe8K3x-bEroCL_wstRMh2cYiKso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aU_hfEmCRvO3069WKQiQXt_JWHal2xiSg2ZPfuEZNHA&oe=69E38C65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
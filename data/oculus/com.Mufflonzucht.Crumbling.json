Tuei0bAAIBJ7itUuFiJELLS8dtsQT6Rg&oe=69D26F41"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Hk5XwzTGzAQ7kNvwFGL4cB&_nc_oc=Adq-vFKcrPu119Nf_C3tCszJVUoXqzcI44oHeA8Gu_o_d0Ia0-gNX2KJDa9tnkWdTIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yrEZIQa_qUXYGRkADoSoaYD-ArDI6IKxBnd48c2KL6Q&oe=69D26153"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuHf25Fcp44Q7kNvwGytcD6&_nc_oc=AdoRvFRtwIsr6WB5TIRnk7bxPL1uWOPnkwAEkH-G_QB9ZFL_rOSUGZksokFUfTFSWDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yg9jHnO6u1mgE5UWFN7a5thZslC5s0Vf1Oa3eWEfzwA&oe=69D24F01"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUAhP-NnZfsQ7kNvwGwZJvH&_nc_oc=AdrMAgRJvtIXQDoCRNok7BKqCssWU8gvTTLhXURmgB460TTru36akKosrHJFR9qmOws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mpaPYP5vY8Z6O8flCT2jI1E2A9gK8uXCkIg_lFl-tYg&oe=69D24E1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EcO8x_bj7oQ7kNvwEtWDl2&_nc_oc=AdotIFwW86Bd8NIZ0SgPxV6VupuPK-ICb18JRelBS3yhxsH6loeacHhkSuu3Gp0CsAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1n-elNmff2tpmzWD-eEY_Coeei02rVpScaPi2az4gmbw&oe=69D260A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
h=00_Af-z91C74Vi5gAhZ9l2ozeY1fe89ftVfeIcVq7zXEWhlPw&oe=6A32BE23"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUR0u4CzltcQ7kNvwHlFBSv&_nc_oc=AdrRfK9mIhpg9ZUbz24B1U37gJ64vhSS4fcYM6IAENsYTMFg3rW0QNzXPE5u2VrFjM0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IZW6_MwtzYg1enPEQ8mOJeQzbeY6DWlNYs7MnwhxfrA&oe=6A32BB28"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V14AbpTSPDAQ7kNvwGf1WHS&_nc_oc=Ado-7KUh_BPW58LxF-wFizt9BSjkIZKHGs3Z6UZ9BbMGrR63w_0jMvX7tYovzqbqAGk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aDg4wHBX3s_IGFQSiivUYzTSESNlhDIFJ7TePUct4rA&oe=6A32A665"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
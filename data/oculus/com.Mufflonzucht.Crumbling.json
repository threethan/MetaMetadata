h=00_Af7OhDIgvRM5bqF1TB9P-ASZljSFluYQYgiCR2xYGjT4TA&oe=6A1EF7A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoOWFCXuapQQ7kNvwEDyuWi&_nc_oc=AdrBGCZFtGW8e8GwUhhSJlMSkHJX84Z0UKI0Hrv2miignByfXJUoBbbtd4pt-vAyjRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UGVC7kO6Oemvb21rhuhsv8lNNPM_CaYJnell711aZWQ&oe=6A1EF4A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUpXl_jivBQQ7kNvwFHsOX2&_nc_oc=AdoX33Vo-qSizQdoFCC0oZZanNACr2FEAa7OKdnCwG0IO77u5lfe8m0_j9EUGg1knwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lXZFTqyFyh1fdR6tD1JGy4vWVsnwAmYfzdd0Mmi1S_w&oe=6A1EDFE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Afxc8qPjnqoe1LmuxvW2Q8h3dXO2u-VegpcOcrZZeGWVjw&oe=69C7BC63"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmKWJfk20h0Q7kNvwH54e-b&_nc_oc=AdoeLT2PywRTlN2Ghzh12o5MQU_2VGUOTET1XbENxDuPiJUoIeNyGLXe3m3JLsnEvRk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmfuSC_rWjOJvxReHIpYhnj_DkKwfpdV0SVVq7YwjV5g&oe=69C7B968"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPGh67zRptEQ7kNvwELHT3f&_nc_oc=AdpMgvl3h9YZpk2WOkhUnBEdLuMJjG6OgcU4R4KEEaHNwiCJq6IW4AFtpUJn5FSLifY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwY3-qJ8agnWyHmZgskcTHrRd8bsrwiVa-NUuPmRRB-Lw&oe=69C7DCE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af-QPIsa_P8PL8MfByPFcM4uksoEDOKTVb5sPyVKHmbcDg&oe=6A2AD523"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ28i_eHuRcQ7kNvwGF7KO3&_nc_oc=Adq5cA81iG8TEodl5qdO-judxBCck422B-bK8HA7CkBDVNGyIrYfLOTXw_v2xN94Agc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ndamgWF_8qb5IfrtF6cTxOY23BOxQ3lQB4hZ_vLdLPA&oe=6A2AD228"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzjNE7xTN74Q7kNvwHtJGd1&_nc_oc=AdozdbyUjhkTZXgPthl3wFocBKO12WQYKlR7J5C2bwXKoERedNEr_vVw4K8ZTCydpgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KBbOAKyhUsXQJdxOb2twSAlU6_sOL2dy7vXu6DEvMfQ&oe=6A2ABD65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
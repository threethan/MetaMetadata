iG42n4166Jo2ku5sE8rr6GFX1fzrzMxQ&oe=6AE355C1"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd9ZsEBNRq4Q7kNvwFC5i0R&_nc_oc=AdoGLRQt1YrQu9Y0Ipyvi6K__35Diors4WUO_5RY15P63v_BqxTG6KLbrOK_IwcRQRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJnx_JIuJO_XumzR4OB7PMTXp4Uo0SUzOJBr91IN9YxQ&oe=6AE347D3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if-1MVPNXVgQ7kNvwHAx44q&_nc_oc=AdrJQQuJ-bKuPMyPrerGohpx1476TRXo9S0ciLkW4YEkb-ne47YbzyLxVYnkE7uV4a4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDsPLYP3ku3a9kQeiz6Q4Ymkpe2xjizOeV8gb-Y1UfCg&oe=6AE36DC1"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66NxYkdCQHEQ7kNvwFI0WGZ&_nc_oc=AdqBSXAIgmShfx-hPrtq3L2a_6URbCi2xuzhLaLtBYoesxEeJ8N9sZkk4aHFuK6nPvA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQaIUG8mJ5sZoCUL_n2pO-TGK_Bsv1zoVKGVJQwWPHyg&oe=6AE36CDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-x-c6Q3fQQQ7kNvwGAYaLE&_nc_oc=AdqjPqjG3OnnjBhXqrfNlip_ES7hcADHri6eyaz6yf0-iKPV4V8seY11ZR-TqlJxeek&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvBdmBrsZ34hsgcN1lTMWguRHio60hnGU_CfJ4JmwbBg&oe=6AE34724"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
69B179C1"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv1TbQSo2i4Q7kNvwEC4tIx&_nc_oc=AdnjmE2LF3s3yYNWTi_D4RkZoKH3ue_DonfnMrzEOQb0m7R1jRJiQIzqtmrLPkED6YQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYAdO3gyCMTRnal-pfiveQALvzylr_VTN9FqsD-mQMbw&oe=69B16BD3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QpE38tEOegQ7kNvwHPTrgk&_nc_oc=Adm6CI8FQWN0-xNhaPlBrc3nqGM8KpKO30GsbP82RIG7c84uHEcUExbwQzgE1fvxID0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzB77_7dG1oni-dyk_jJ0Q_Jxt6FNfBd6WthaHjvrQTFQ&oe=69B15981"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ9r-L_6HxMQ7kNvwGQAqUt&_nc_oc=AdlJJl1FO8xL_nYdT6qqRJLlffz3qPunx_zXqQ94P0F9w8C7gjmsI8Z_3OGEps3z8gw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsxXOQwf0hvkAmGc0KeYrTKBrTYg6WRJvFnqFlwPn6Ww&oe=69B1589A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp68PSuEBpEQ7kNvwHCI-rX&_nc_oc=AdkAfjsNyZOKujJCQc1P8bqpDeq3KVTYHPpis-bimo83RpAL_iMYjUzY4Pd6HimOoro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvWVhTLsCXynKHfsgtROzkUJOXHiRl9XL6hXQHsPX00Q&oe=69B16B24"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["H
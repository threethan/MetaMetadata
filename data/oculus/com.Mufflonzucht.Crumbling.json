h=00_AQDDWZxIiJ0k4EXFoPslaml9-3pp182n85eJLQcM2OkpJg&oe=6A61FBE3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zc09n74Xaq8Q7kNvwH759fq&_nc_oc=AdozfZ8axKMZB5BA2O52nIu3MM2UfH7h0_-LAMFRBfHiml5D1nhirQ56mW3AKOyjCZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-u_93Ls0mgxpihFOonzyS8O-WhKdmFnzkmSmk0Kzygw&oe=6A623128"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vi_pPvItigQ7kNvwGNSgcH&_nc_oc=Adp7PllMNtphXpZa9tjh6_arE09J0n5d3iFf3l_0uaQNnWaeC3RKYi12fFWZoucfebg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_q6N01Dup0EnDKEloDR1F4EX50Ntg-GaJ7RF7g9X7ug&oe=6A621C65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
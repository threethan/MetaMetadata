h3QyyLdhvOswpIu42pe9AxmIM2_qoEYg&oe=6AEDE1C1"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CT9Nr4iU-0AQ7kNvwFQVbUT&_nc_oc=Adq3gtCzSF3d4-6NPvONbbvceysE3JJnY210k3uZq1dVb1c8yNi7GrJyaEFdHci2lvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1AJz31MMXbSf3puxc_NoBaR3ftxI0t-_jVHeWkUsrbw&oe=6AEE0C13"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9VTUkRa3QoQ7kNvwGptLn_&_nc_oc=AdpR_ZEzQ7BS84mnw9Tx9nWPhZ9O126xZLtd_2SR5J2UWoEDn95jo_daVaH1xVOuJ4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRotiglpZkICMrDhXgI6XsopP1-ZnYv37pKoSVeYwqc4Q&oe=6AEDF9C1"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_njo4j_S2UQ7kNvwEdIT57&_nc_oc=AdqDI4tvefSP3-Ofsc6XAjdUpKm8lQyanQBNs7C7bvFGArYlWIwoqZ5QnurNGcP2fCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfCA5AUSCM0U8hoeJNGKH7umoyMrk-Tc0P6gkkNPcYQA&oe=6AEDF8DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFx5MjkI9XAQ7kNvwGogyjS&_nc_oc=AdoGnN-U_kW2HyJOHI907zV-c4-IVes6cnTYNVrM2bOjF6t5enXUMyQa5BVR1h-wGdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5nm4FqZKSrwhbGFvUQyaghdWNxEodOAdx8hITaHjBlw&oe=6AEE0B64"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
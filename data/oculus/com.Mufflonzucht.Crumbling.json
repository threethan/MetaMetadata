h=00_AQTq_fGt8Vi1vZfHjXyTRdiJqzNR9rApSJ72x-dQJfigWg&oe=6AF48AA3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThELH3bJlBUQ7kNvwEW1qd4&_nc_oc=AdokeHAoZeWaPhhe9uYJnd9uHOwva-FpebcQgTRgO_4A0_ya6VQD6qlyOD9aN1eb6rc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9xMTegqhdVCuKsMlZQdcnvAPihGMJZjTfzwxdYczxFQ&oe=6AF487A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_urkLI_3Gn8Q7kNvwEDJ2-4&_nc_oc=Ado6zxdgs3KG-CCM-CIWDAoIGEml4aqI1gqr0pi8FKl1CZazeDD6YFnUCKia1VDaDZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4tYwE0Y8N_sY1cD1dQlrjJyiBwbnDE8uMpB-PuSb4AA&oe=6AF472E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
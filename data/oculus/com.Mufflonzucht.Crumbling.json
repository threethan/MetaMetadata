h=00_Af_1yJfG7FS55FTcgATVotuWTPlbKXlDZRQEhBIFT9A6hQ&oe=6A258F23"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr6K2yjfblwQ7kNvwG51fLt&_nc_oc=AdqYIBQJsPIQOYKK0n6PwO_pZRJdQTU_wMoBtH965ihJ8jxISu8ACTxlKfTQcrtoXMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WE7aB7FWPsC1dScHcmASxbcDCbMl0o7xAB4zZR0MVTg&oe=6A258C28"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uM2lP8OY--AQ7kNvwHx5XJA&_nc_oc=AdqU4VjioUn26YYHql4QjTLNLdT8o8yn_dcuBKcnrJw2MrxYegYOOEhhR1b5NDc1WQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H8A_L4FFxXwPi2CR9hg1SolkT0oHpzrvtxVNcfQGhFA&oe=6A257765"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af_qmM3jMjMl7gwrttNPMxMuZa2jBRF6JGNQkHkyFZZD0Q&oe=6A316CA3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUR0u4CzltcQ7kNvwG4_IDT&_nc_oc=AdpO9wgCpPBs1Xh0HBH182ES904W1G52oQ_WUw5RFvqkI9gBV2Tm8SN2AwgobjmSsPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cWyBNsPiJi5tyHMJ6S0J9ScVw22v0pQTvDRGXRVr5yA&oe=6A3169A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V14AbpTSPDAQ7kNvwF9I6LI&_nc_oc=AdrtK4NLeauaz7ICdbvHxmMsgyHC43PGB6LmO9Kkl5kn8B-geBIZ6sQok35iyAmWP-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ti-qGfEo1XN0n-BAOAQApMoTJzEiBTE_TzsHLIist1w&oe=6A3154E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
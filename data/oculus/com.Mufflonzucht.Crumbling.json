h=00_AfygcXpC-mCL9OC7TiFfuGqkfGcksjN9mL5855Ud_t_zyQ&oe=69C27663"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1W96tMViTcQ7kNvwGj5KB9&_nc_oc=AdqCumgnCdJSVWrJaBdnTHayZqiPS1Vp-FgGaP86q1A1XkkMuFadgildIUka54xH3jM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyB2CCemHKjWA3EM2sVbHFA-EKbbi_wYdTgxjYYCWMhyQ&oe=69C27368"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOggU_VC--cQ7kNvwE9w95X&_nc_oc=AdqxoBS2TMxrZGqWxy1OdnQAJtpl8RmJ14fkY5UULQ9Ie0a3fUjfTYmNns1DPXRiglo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-Ef88Cgw2YfEyvSgv3QY6ZIm8hR7UNRiuTw8OVyFr7w&oe=69C296E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
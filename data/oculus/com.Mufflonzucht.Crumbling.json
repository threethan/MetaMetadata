mY3ZkC1ahCl5w0aFW4KFtnjIkfihd8wi13AuWI1yNLzJ--yAPO3Oa1LGdyTI_HRQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNcrmw6OFYfqzd69qVTIcrytD2VzQ3eYxiMH90HZtZGg&oe=699AE668"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpIxjl9NbW4Q7kNvwGA_IPo&_nc_oc=AdkjYaaYdL9EIE-LhFpxk4UzauoKyoIsgnFJpIt7b_8UfUdSG32b48CBrRwy4T47kqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftIQx2qY025hVJa-wIOnZ5NQ11Mot89SQJhJ2YxXX9Xbw&oe=699B09E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mufflonzucht", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categ
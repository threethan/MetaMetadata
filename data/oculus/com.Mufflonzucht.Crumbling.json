h=00_AQLKhAlatdHCM-EeRDtpUmr9xnFef8jQKV3JDLO2argFXQ&oe=6AB14E23"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQ8bG40YaBQQ7kNvwGrafXv&_nc_oc=Adr_NF6RLZ-Fvjjm_QnruhSOAgj1gGW-3vKrMpmaRcfl4RojFud_6C70ugYQ3GM9zOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYSOltOR2R3XbXKhZRjCLB4K4hMKZUwYiD9q5drEbhFQ&oe=6AB14B28"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEjZdsB5ay0Q7kNvwELkkzR&_nc_oc=Adr2CnNg3PAm3iENwfCnaVJa75x7ClBc75N3zLsD6MYyopjFcixoK0rJqy26P6xhPNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlDJBpOG8rybSyfpcMwT-b2-CMkKJYMnAqfLnEK_M5NA&oe=6AB13665"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
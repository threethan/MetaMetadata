h=00_AQBRNFgzRE0zqRxZNLJjPPMiSb5qe3KR4jlWRyD7WrowFA&oe=6A537B63"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXgG0ZTjQMMQ7kNvwGdLvKG&_nc_oc=Adrh-hpvbnMU1DdP1DoV2hpJ5LLJINJVfS3EY1EnJl9FzJfXhQDIXknijtl37nToFy8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU1kk2ba1JOQlZHv8YSdL4G6mQGn5nTLc5XnmF0veF3Q&oe=6A53B0A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fxo3vMI-m1cQ7kNvwHmJrA2&_nc_oc=AdqbMCdy-7ptCZpBZ971rLzjNTrqbDxhQ_ykA5zUYi3XnBb3gfJaYnz4z0NfiH_spDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Xt-DYQvSM98kJj1rn7VTJufiqNuHOBx05plEicIkww&oe=6A539BE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
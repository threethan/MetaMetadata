h=00_AQH2oLYK3kxSzlX8B8fuD0U9DC-NXkO_MRRYODzqiTKm_Q&oe=6A7C59E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7u5cqJiMg8Q7kNvwHyxrM1&_nc_oc=AdpEfXW7_CzR6mTD5T2rFBwFMgq8m2040Wn20ZFovjIMzWfzPkax5J_9e-ZazmWBEaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIxH9R-YXWJ54kEQa6Kt4QngyHK5s_N-d70VtvoD9DxA&oe=6A7C56E8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGJ83K0_JU8Q7kNvwHQEZsR&_nc_oc=AdpnGH6-c-H06yiBlWib4JZ0leM4IVIHbSP0M6BTN99t6_luEHUG0vadxX-lAdvoZoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE24j3V8WXyKy3rmFy6A6IU4pWGBlvCoEd-h6fnmSww6A&oe=6A7C7A65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
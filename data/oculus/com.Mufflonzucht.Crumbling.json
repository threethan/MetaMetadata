h=00_Af_HdM_MK3v56fYNgs-AA_cNZGWAOwfEONfEQTiCaaH7YQ&oe=6A340FA3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUR0u4CzltcQ7kNvwEESW5w&_nc_oc=Ado-BkZOTcuJUOKoT8F3NywYo-ohWW88Qn5Fn7AJdw97zZRQ6UBbW3x82luQrPXw1jQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I3XuXV1_E7LUGQrrOGSu6v039hiGkV3lgKfbxjYd31A&oe=6A340CA8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAT-QBsgDCYQ7kNvwEZjXZL&_nc_oc=AdoFWB8xfOD7VYOfnffu8_gko2mGqHfLnFaQRKr_6G7SL1WBD8mLxXt5xCSeTTpOPYs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e9OwE5oMynvXIdIQrNWbYXkx4rhST_iAT5BejGb7esA&oe=6A33F7E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
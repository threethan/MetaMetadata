h=00_Af39kQe0H0EILsN3BLEPBJUdU63qDMDK8_JN9CD00Z1QdQ&oe=69DCD463"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmBsakOVxNEQ7kNvwEvvftU&_nc_oc=AdrhqfwOKQozQMvm2JB46-OYceNqjO9QZdrprtdPpK2EVFR-sa07enypIzgpHZO5A-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pvBrTkUZismAkzOiz1_t2xHrszzUnyE4Xzjxu_6GiWQ&oe=69DCD168"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-mgp8KXN9oQ7kNvwH7R3VY&_nc_oc=AdrXqLiu2rs_L_mO_uW746LYtKorW9Z48YcPXx7Eft1CbHV8iIwYMhpMpmFm42t04X8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Oxr2gHuACGyPCUSFiWtnVGTFBgcU96LRh7Y4-eTy_gw&oe=69DCF4E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
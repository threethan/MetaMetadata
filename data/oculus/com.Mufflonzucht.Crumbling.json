h=00_AQOky9ma0QaRdBmSGv741NJLd1qnm9g3tw3kQBukrk8xiA&oe=6AC90923"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEkRsRfjVjIQ7kNvwEdMxmh&_nc_oc=Adp2AowSXtUHZ7LCohAmhqeaVdYuNSZ-WEqo_13GGuv4nxMy73BDAYJnpjPXJ5tEU3k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQVOO_Bl52O1kQGd3lpLtLJl7jLfXOChglyr4eXT33UQ&oe=6AC90628"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ3M4GslaPcQ7kNvwF-cgsZ&_nc_oc=AdoAWLeM-GJzD_wie_gmSNiKQeK8RqfF0GHPRSp97RXBJtoT_ssRKqBHH4APg-qoO80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc88BM8woqjqXJHxs0XptKDyap1lKIZdQHjkjlFM8cGg&oe=6AC8F165"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
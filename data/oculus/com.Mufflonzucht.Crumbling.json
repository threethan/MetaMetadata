69BD5741"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OeTVT8D9oAQ7kNvwEFGaSy&_nc_oc=Adk_8uIWPRxsjGQh-7WsR1OEMIaVhs1H06iOGxz_pdyFJ4BNYJa-5owHOy7QdeYG0ME&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIYeGHzmkKdm_cebFxAYRrTS-Gkxbnimym25ibtr5GhA&oe=69BD4953"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2LKepvDBXcQ7kNvwF8XoBN&_nc_oc=Adla6awQFhNOGajYwLaDZ0obhPvKmQ9-2qE6-D9Bfa3K7IoT8rFcQPVXv0Spxic46xs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfziZhTQsvGJQ3TOOF0IDml-fXrpn3utBYGZf6LA7l7AKQ&oe=69BD3701"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Giy2yrHvog4Q7kNvwE4m4kp&_nc_oc=AdnbZK8J9tTbcycju-WkGZk2_dfrPIyrxspvTzkvgsksraAjjOy-Jys3l3iLGWO-eMM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB9rf5-X6UOBWpRDVWwhE_x0G1gd-EkZ1GQRTNt_dZww&oe=69BD361A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1s6C3ujU5AQ7kNvwFUYe1n&_nc_oc=AdnEdmlYnfKl1T6YIxGl2wK5xIM4zvXsJGnZI9cIsOHVKgV3A89gpnE07-oeZsp2Sxo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmrZHNHd6kihpq3QZLZMnfHgYtWkHXwmLTUVTCHQ6qdw&oe=69BD48A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["H
-y35gfv6YcduSyPbt1Oz0XgTK26BQ_Hw&oe=6A95C581"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsQNc40muNEQ7kNvwGv5j2D&_nc_oc=AdqwAzT68fKQMFTTMNSErMI0O6yxqeQIbCb3cUInDSzVf7ShqBtPGCV7aRqcGwpbpYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETyXyUKB3ijQKjOFhEHPUNTX9QWMgBaltseI38eXIV5A&oe=6A95B793"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXf-0x20a0cQ7kNvwHT4tfy&_nc_oc=AdpyFXsZ97aNqoREUAEk3MIFY8kKB6DD4fsiGot_lno-Z71U7Pdm0-vWeQfI5pN-kP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1_PfGaosQ_Y2gGFkHnCs6jXrlJvurYOT93XkAJ73onQ&oe=6A95DD81"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57yCGxz9PpQQ7kNvwGiICfA&_nc_oc=AdrKDxTFkOdqYTvD8ntKAt0A25hHIBXFE9Yk1uHHUzZM4Rpv7cwtIq-cEmujXsrFqpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHnSEUBxCGkNNsgZvQs8nSKJFPeCiD7JWP6pjVQM4G_g&oe=6A95DC9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4LugwBNAQ0Q7kNvwEYAle2&_nc_oc=AdpSGG-tn9iyngC8bXJ_emd6vs9fci43XTcgjak0tUZdhIis4J8tsEXIgCYYs8-LoOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHefRn06ddx7hJzJ5CC0nxQQKLxpXUCELHblZCN0Ig5g&oe=6A95B6E4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
h=00_AQTISJmck4p-Xr0taw9REGjQSqXlQYkvKq7eBhmpfF9JwQ&oe=6AF09623"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=driclOkp6KUQ7kNvwFFhLI6&_nc_oc=AdryGAedV2eOtbRwZTxqciUlFG13Y1pcrHkYUN8V8942d-Sugyrg5F1cPw9Ipbq-l20&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8xnyQH9GjSojEYFWpm8LeCu7J4HhZeFKrmvCaDNii8A&oe=6AF09328"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh9GIsZBCsEQ7kNvwFjU-2c&_nc_oc=Adqhb0zOhrSYL87amGF4t21UWmiu8-Q1MtaaCmiVx3iiq_ChV4ZoD7ALfXF6bmed6sM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQFpxz4fSAgMcL37E7bzU_MVSpAnFwn5hdA-sbbRAWPQ&oe=6AF07E65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
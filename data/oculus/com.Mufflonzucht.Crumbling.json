h=00_AfzyTaY8igJRMYCGVAP4b2mIAnsHIQVZdyd-XHF5Wi3Klw&oe=69C51963"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1W96tMViTcQ7kNvwH_fjy2&_nc_oc=Adp5G-_HzsmKryT7OTlvAFGKcdEbpkXTCtyB9znIEJ7Hq6BR5X31hZIqdhSUB7hEN9c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzknXIMg12pQaxH7fMj8xrO33Oe24M9xEwNj3X1NZZpcw&oe=69C51668"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPGh67zRptEQ7kNvwEhHwt8&_nc_oc=Adp7pSjf23CkJ8jNZmdlL26M6sBSDfWmC_dPEJATtUtTZi-cqiubX2Va-DBczFGsgTk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxWUPKuyD4bRP5yg0t1sHH-Yn4viuo_eGumXWr20qAJw&oe=69C539E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_AQKRJLvaC8pYH_B7r-jLB4K-p9_ZCTM_xS2s7uSw5JoUHQ&oe=6AA02AA3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5lqLXNNXVMQ7kNvwHrZN7s&_nc_oc=Adr3Q7wDJKoyiNSU9nZnkZ_Z9qIKX4NLmI7pxDLV0GuWucjimCNgqtT_OSbCFD3y_Js&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXUZ0a-O9AB8_Wb2LHoj_8cPQ8dIxpemsPyiwFtM0Gww&oe=6AA027A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uh4cQLHH84oQ7kNvwEUqNrI&_nc_oc=Adpv4H1JooiS254cHFFNfpkdoNbouui65fRrVDJ94OGwVv8T5tl5Ey0jO8Fo0G-CLJ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkD4jZxadNvhjQjH8k-xilCJM0hgemqP8hKKZN-B_gyw&oe=6AA012E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
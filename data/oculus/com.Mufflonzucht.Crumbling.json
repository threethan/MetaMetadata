h=00_Af_bAsBCSJLeKUB0LH1V5q3smi8y7LsM9gGM4Oy8J2uoOg&oe=6A43E1A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMXIjk_G60oQ7kNvwHHaS9v&_nc_oc=AdqMafjZ0oqy_5YM6SNz-SyqmylhNgEZff_ICUEFI-TOCTUxwQ0gJN4zhLP7aLIEqWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WRK2WgJpcbfibzLOAYtQADlexjKK9KaLXWhZSVToTAA&oe=6A43DEA8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u97uzrg1sbMQ7kNvwG_z_DC&_nc_oc=AdqPyTUcucq6sGW2f3us8uYjingkLXwtmrZcIMzPYbGnHoSySaFXh2jZ8huQmMOlp5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80IVSNAZ3IvhUbEiDqM-xnI98nJCT5623EHby8Kr6YzA&oe=6A43C9E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
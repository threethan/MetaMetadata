h=00_AQNhbMLFS89toluj7-Te4eUpL_8t20XF_1l1iwH6NBdgXQ&oe=6AE215A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMKhofrQQxYQ7kNvwFTnHxc&_nc_oc=Ado6Oef2x9LyOJb-ZpaT0s5nG2AH_gDveseeLEwfaAikDLnwrtSihT9DFJrgv3hcseA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw0XDsspIitnMobM0YxH_hAnqH0hY2bUwFLNSoBBjY_A&oe=6AE212A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwYl0xFxoJUQ7kNvwGKf9QS&_nc_oc=AdoXeA6_W2ZXJeylScr7sG3961tS60JOrLvSS3VjPHeF5otG_BA6cyps9vc17fFEKsQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNycvofgXsm5ScN5iYHas7IjizxY3nQ8-EMqPP-bU_hPQ&oe=6AE1FDE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
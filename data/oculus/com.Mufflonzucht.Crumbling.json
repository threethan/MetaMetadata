h=00_Af5BTDS0Lch8k54kUYRyO7V8KhGrXmoFxLdeOUBQ4ocwkg&oe=6A0C82A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXsc4O1qLgIQ7kNvwHCKcEC&_nc_oc=Adqwmd29EMaTRZUsrn8yOVsan7d9t8zq0kUou0pWIEd9xdLUXttQRM_hfFMqvraXLXk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n9d2in3KYVudDCpmNiAQjbVSt2F1KKXmOdUASYA1b9g&oe=6A0C7FA8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRvfye-NGlQQ7kNvwGCLDRI&_nc_oc=AdpFf_gHeenO9lscjRKwFKxmXTaha_dKNpPidlR9YF7a3iWCTRR9BA1sAO_DaqJXSjk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rKNyqvkYmb3Q0OBUZoevdJ0f_q3jttuDxUw-LjaHTFw&oe=6A0C6AE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
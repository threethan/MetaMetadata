h=00_AfyQwT48XmR3oVVCUlKPxQAD4nh2vPKG-mlUxL9V_zC8-g&oe=69CFA563"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7SMaj_s4nwQ7kNvwH3gs76&_nc_oc=AdpCM4oJ34Qj4QOnL5_wBg9zEBzeXkRnJ4LlLHBNoIasUjGmLLidKGTO6HCfbqj1VGc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFVxC8nasiZrFeQqfqqSJYB6S0hzTOUA5abmUxgc69Wg&oe=69CFA268"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vvjUswetYcQ7kNvwGOeDnQ&_nc_oc=Adoj_keQp1EPUauGhjCGlJTZspIbZPp6P59chB-bfA0OjF1oeDaxNsUNIDxpa0QRzSQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDceD4RJlG1ofvaRC3N7ZlF_U9uCRSKmZUZcRM-sVYjA&oe=69CFC5E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_AQRsS83er0DAG6BUX5YmxrcmBItnNV-wjc6qYxCH3rdV3Q&oe=6AF33923"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThELH3bJlBUQ7kNvwE-xC_o&_nc_oc=Ado9QatG0Ff8ZRTl3IdpTQHFI55O7i6UA83M_noR0339O592SgSRMsoDroP-tqoZ5PI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7J2BwSGd1YAfu08Pt0mm1wei7D1BgmrWV_9wYJVhiQQ&oe=6AF33628"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_urkLI_3Gn8Q7kNvwFA9utq&_nc_oc=AdoYelDT0BH7exdDaPPyGtt2mX8jipInZdqoEL30Gttsa7wygn5gVXGZY6zs0qeXFAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc6K6wW3GnzlwKSSUI_VmSZDA5YlZvY4spwfdUZluJRQ&oe=6AF359A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
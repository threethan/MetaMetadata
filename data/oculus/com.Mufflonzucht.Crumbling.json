h=00_Af-7UEJ9Sz5_Gp7nLil3EDF5fLFXi1_GsjVWO9xvD70OCg&oe=6A413EA3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMXIjk_G60oQ7kNvwFEoI9g&_nc_oc=AdqvhS3XpEUdMCP5-fvvGvm2Bc0EW4fkpv6nW8JifcjmIb5NNZhs5U1pS6Ypc8aRusM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m53j9OJwBIjWqODJvVvQbuQLkVBTCpuxkeehZiH5M9g&oe=6A413BA8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1rLMTRZHzIQ7kNvwG4eqZr&_nc_oc=AdpzU42tIW8waQm8rX5_X_zPlUKvVdpo0cnGAMcqs1klIabTQU_g2rcNanlFXhTQy1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-boUdgrSTf2FeR2G4nIv2IKaDpUePUMMXVuVBnCqjsHA&oe=6A4126E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
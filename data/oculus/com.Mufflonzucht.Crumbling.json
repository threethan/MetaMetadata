h=00_AQGcVRSqEDUjG5HYFZ8TTnTBK1ew3uBSZOpp7EUZb06QXw&oe=6A707C63"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUkaEtOKZ9MQ7kNvwHnYN-V&_nc_oc=Adq7LxhTMQ1VmWpJ-hiNW72uYhurS-Hx51uhqND9dmbc6IzyetLiGItPzY1zwZrUAjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDtYlf_2hVNPZf_k3gbCVONyGui0s9g8UZ7AKxMog1QQ&oe=6A707968"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhpY3ewKCNwQ7kNvwF6RJpZ&_nc_oc=Adrb8YhRYzcPmvhRAy291n2mTBby_kR7tnz8_f6_NcWCY96DLM-AUHQHdX3n5k2LhXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUFJsdb9qS_Jqxbvme-8T5C6hCbkGjmihTagocHqzJ6Q&oe=6A709CE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
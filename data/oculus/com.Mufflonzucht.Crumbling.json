h=00_AQBnhXnQjm9jCsMcfxgHlwIsw0jUoMMhLMnxneVva4mRyA&oe=6A6385A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zc09n74Xaq8Q7kNvwFES9bw&_nc_oc=Adp3uH5GudpNfcf_yvGC9E9Ndj5c6hrt8zGC2VJ3r6aO4E2NtXagZe4EFz_h09csXgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCovjbWWo7XJL7huIvMwtO-HjsaFTDkdL8XPE2oDx_KGg&oe=6A6382A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WqnhQA5LYUQ7kNvwFklqfN&_nc_oc=AdqPi6LDNDHWuLBYaZOLM4vssLZnGBWYc4y4qgaUN0pyjI2vfQeQZBQamxH64ms8NC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5x1e8F8cr2NI4rUdcTdXdIweJehWVfgYdIeJqV9eQRw&oe=6A636DE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
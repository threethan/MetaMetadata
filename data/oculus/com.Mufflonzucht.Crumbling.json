h=00_Af2g9YZu36CusLdvs8pBl137Gmd9WQ5bpqb2WnZ6DibMuA&oe=69D24863"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hhIxGO6cxYQ7kNvwH2JsYu&_nc_oc=AdrsCgQ6T1vsXHTiSLrQcZTDRPP14GZ9do2t3A48MHD2SAD6NNak1pu6OQ5wBK2gf1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-a-Zj7EcdCGjTFmteopip4IvXYk4v0N9TgFw2C88tpA&oe=69D27DA8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lnlxsZo-AkQ7kNvwEBZgwB&_nc_oc=Adq_L3olwe8QdJutwnMFt3tWENfYnGTQR3Bhq7qCmgcqG5ETs7Cibe5l4hWUts5PQqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aI-07UEWVbt-GaH8HsApEYU6W4txrYzr46crFOYfASg&oe=69D268E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
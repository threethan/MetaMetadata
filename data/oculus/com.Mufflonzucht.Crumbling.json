JOSByABMNq9r2c7K79yKmD7yAQMGpgGQ&oe=6A940381"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWznBlGA_PUQ7kNvwFJbRJq&_nc_oc=Ado4Ru0Ahq_oPf9yfJoBTFt5jQAeO8m4WMTCIedMMSJw-V5xZF3aqkPpG6F7mvvsJBE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF11-LZcg7Ifz9FH2683_x3RVwOXpZZM8EW5p3DcDtRCQ&oe=6A942DD3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxQGQZMhLGYQ7kNvwG2oZ5D&_nc_oc=AdqnxcmXxf0zboZhtWdfq3UANCwjSu0maliifDHNQb0adS-LOQIZeKYoCgTF_IM95mM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwQnppJK0XMk125BV_CkfyEp3CsoZYUpBUtKIPTBUwLg&oe=6A941B81"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57yCGxz9PpQQ7kNvwFQCToc&_nc_oc=AdphxeRq2XCMamV9id8EUbrruYujtK466enX82G_I5jiG4asS2n2awuCoFkYvLI5pP8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_MOdZ4f66uoaJ2sws_u7bM5GSHZheVEqLYkOQMUsrcA&oe=6A941A9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClCJhIQ86bIQ7kNvwG_iVva&_nc_oc=Adoh9Y1Gi6L8vqQS0V2e_vnoE6WWE1yIEfO0Y6Z6R-b7ZMMMaIB1Sc-4m9vuV3P1LSQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHarzdPFQ3wS0bYcUcTozrx8t6_aX3go3wG4V1yfFKZfw&oe=6A942D24"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
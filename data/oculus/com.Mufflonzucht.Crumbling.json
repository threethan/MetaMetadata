h=00_Af3GKFukmSNd1cKAQMQvC0LcSnocHBPqE9e8oBr70Z9jAA&oe=69E0C8E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIp3rbbVYU4Q7kNvwFtmPwP&_nc_oc=AdoBBX6vbtvwcieigkxlCs57exohF8i5Lp4HrDQbn5L5BUIxdPk8yqPM81jN57HP6D4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UOlVy4J43-z9LtvtVgAwgQMA7_bGluXomJzJy9xS5LA&oe=69E0FE28"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9b2QPebG_bYQ7kNvwEGHLbY&_nc_oc=AdoYmdr0PKMJHJewcxive8cgGq7bVucXxnPXDnZXdvYCX_6iklF9f8BjdI7-OoRP28w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QIDsRpZSYOfbKlzzsc9-wQZG43-uNNolZF7TuzU6EvQ&oe=69E0E965"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af7uCMeF-w1JhjAGSCRmY7MqR6Om5r8HQKslIIt8okOq7Q&oe=6A00A523"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8mPYnsBDScQ7kNvwGd2h9b&_nc_oc=AdoOSRwJqbznf4hBuDD6UeuojgU0op4JT1erFfbdDzGxOnNmKN94mryivLSu0mpugLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5arJUFf_flkomVvL-hieXsfROfzL1WQH1dM2CR75nzIw&oe=6A00A228"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRJOtK5LJrMQ7kNvwGHuy9L&_nc_oc=AdrKErFptygoH0FiGv2E8JtKJb_33Iuw7ktcxcRtYZ9MRK3yI3quTBToc-r25sHCHnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SYxkx734c2-IKOrgRhTKftSK-dA6knPWzTFMVhXTTsQ&oe=6A008D65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
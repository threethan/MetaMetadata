h=00_AfyR0X7qiaaWLLOP1k9Yk2WL9mGfZ3XLZsbCSy-3qsqxSw&oe=69C90DE3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmKWJfk20h0Q7kNvwGtf4sa&_nc_oc=AdqYs0VXDSCVl-WlQx0T5q2EtiBf2ZI5-pyGj-7PG2VwQnQcLO-ruYNsGC6jwFODJQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKW7MkfLMGHveUT3CsHpm2JNxRQUXqGe5NMObU0uRTNQ&oe=69C90AE8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V7sIOSNIdIQ7kNvwFLS5zn&_nc_oc=AdrMX9LL-CQBqx0CIBut2VyJYlKSda_DtB-S2J7fMjUFQfcQx2rx3gx_jbp3hTH7jpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSHpRRaPUXDsK0jnpUiBNmwrnTX98U-g6fCSko5CzAMA&oe=69C92E65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
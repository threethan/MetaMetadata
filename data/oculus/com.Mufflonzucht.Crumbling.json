ng", "id": "885734758938773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnyEXV1onTIQ7kNvwEI7vdC&_nc_oc=AdloEuVhTqpRKiNEIrKhSQBTSybi3lV0GwCyG5NdBDjcerfz9aNtrld7atctcH4Qifg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu6qvD6wqGbhJsmM1q7cPH9-ju8SI86uTGC0rBoc4CRmw&oe=69A81568"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STScdlCYTh8Q7kNvwGnmj_u&_nc_oc=AdmODAZ7vD1P2uPVNRkT1MiD7j90kQUx6991C164DdlGOsAZkKx25uc8s65BPbJqmFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs2kkMRkWoCRcma-G-KF3b_hcmVlbI8lZ4WJALHtD0U3A&oe=69A838E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "
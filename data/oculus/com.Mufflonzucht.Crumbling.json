lXhtNRasD3qN84swfraiZwBNEe6KOyZQ&oe=6A831841"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5Tyzes5-bEQ7kNvwESASul&_nc_oc=Adpp1Da6cNnRma6p-2CeX3hFiocNeLW3mJVF3uY1-NZXgbihPvFDH_2E_lL_A8rkyR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8X5XShI7b8dKJib3hkp0uNozOz1hGYKE5VtsYrBvmOw&oe=6A830A53"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxWhLtrqqZgQ7kNvwHT0ZJ2&_nc_oc=Adom6Q1bgrnZ-0av-1zNa0dJEzIppsteWahx6ZVJB1-pusZ4wJFd87MB-XPLKCzIHYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUB5ihqqbFcBxRfXsAPnA1NrMgZ-cVuO9LjsbJmL3USw&oe=6A82F801"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpMyebBXf-8Q7kNvwG3xrxd&_nc_oc=AdqYXMi4eecyTNAjCvIkH72BLfGCil-5kaY7yCwM2vdx6xkIq7J86-6mEddbVZS46Gc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUKMr3Zc-hVTtWjXbhBpzURxLFRpvZue6YoZSAxGy_BA&oe=6A82F71A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrUlnhIo02YQ7kNvwFw7fGf&_nc_oc=Adrckh7yXHN51el3uM3KlUyFJdrATnNaepGigG0jJInz9EwCILiN6M1NvG_08omJEA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEceXQpzrgSH7EjM6X0Ounjf3hp2ZFdzZbTxHAyadDZ0g&oe=6A8309A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
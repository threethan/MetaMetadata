h=00_AQQ5RxAxZjuIFrwrdIUUW0zA1bZnJrpYXC_iMC3bCHBQYg&oe=6AEDF323"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMFFqKGjIzgQ7kNvwFsRvxD&_nc_oc=Adox4gtvuu834u41oz5ayO7gJ5sHzpzIX9Q7N6ZEH5w5HDlS6ULO0DLfWhCeulhLSmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDGtxNoqle8X0JumjWbtKSu2IShGttLgI1MD2U5P7gRg&oe=6AEDF028"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh9GIsZBCsEQ7kNvwFgKIkq&_nc_oc=AdpYjW5UjCuHeTB0qTQy5WenW60FsOYknEUB9GoxG5P0TcKXFXELbKywgeOloUwqaPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQowhxDupzNjcj6jQTNaBsi-X3P92porF8NFLvxzD5BhQ&oe=6AEDDB65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
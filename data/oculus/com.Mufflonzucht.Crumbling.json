69BAB441"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usm-TD-TdeAQ7kNvwHsCAL1&_nc_oc=Admma6XuioIUG3W6XJZ51cosagNLhcbxsVmSWWY4Y2xvvZwba13kBTpAjZBh6fMKFM4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyivK1-ydSSzQD_FBMpgo6PDz-k6w3DYKvymA6oT4Ilsw&oe=69BAA653"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wb4JRE4pyS4Q7kNvwELfO1W&_nc_oc=Adk5vchv18NR7wx1tOpChIEo76L9EDwdb9zHd0cATS1-G6YijEwdveHjaO-bYoTTdPo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYcKFCjrF1wZ97KP2-4H3280j-rwRvh-UcZfY2fEW5Fw&oe=69BA9401"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Giy2yrHvog4Q7kNvwHpcWLs&_nc_oc=AdlR-VwoV0CWF-sB9X0f7au-OV9mIRIonl7nJuGMlbMRKF0fl6gY4LQ9aVRvE4DnUvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxblVTQEKr7o5j-mMgYxq7XpTk0AcbZ5PfM1T6RbXUTnQ&oe=69BA931A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5DOex1cMIsQ7kNvwFaHPIS&_nc_oc=Admi_BU1DaRbIUSB2su0QRefxETVWVt0kv_Vq51Kzgi_I6M8NQDnh198NPbyXOyad4o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5gq2O6oCDhS2VyGpGOuamyyHrfoyqSe_bIHOS7ah30A&oe=69BAA5A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["H
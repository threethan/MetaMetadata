DrX4m1o9mCjwJU0g04qeKoSTTRWBcGdg&oe=6A897781"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOXbp_B1trIQ7kNvwGHVscb&_nc_oc=Adr2Yv2qnSKShi7q0W_9kI9jFwKznlrGmYEpQUY9W2PNEQzn2OAGYXciKfd3DwGcSLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn5mkCxio4pT_S6WR2GFL2KAQM8ezWtejbEZ6SKPrq3Q&oe=6A89A1D3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QSmjf8N_vkQ7kNvwHK3rKa&_nc_oc=AdoL-20Y_a_cFlwQenOdo7KLBgymQcs-hfI31ziMzLj4Ku2cUFJscFO6bgXSh3djOQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjz4gVnemovugrxrsveGTbLFIHxMvz6eVTgwtkbQxiJQ&oe=6A898F81"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1jqqaiySRkQ7kNvwGa58Hq&_nc_oc=AdrbUEuG3MGylOl06JinV7kpznAxyWM_txhMvgz0w3pJ4SeGRmhzJNGNiW7gcuaiZAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcz4ivWn7Q9D3mzcbpGZwe7zlYFOkzlONVD40c_t-zKw&oe=6A898E9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0XHqnEc07wQ7kNvwEUreK1&_nc_oc=AdrYDp-CeJYZRnxVtp6h1f6icstqj6Iwj5vvY4CLusNy7_HiI6ifPNHRJhThTBmLIto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4jrD98zVZkfwZJuxGCgcQiOHlhEwnvGXbtopbuYfoVA&oe=6A89A124"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
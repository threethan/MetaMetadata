h=00_AQNkwFaPf-d7YrvnhnKCEJ2q85Uva7JUbB-LGnwgb6hgDQ&oe=6AD39523"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QtsrNJqejsQ7kNvwH4cN_G&_nc_oc=AdqHmWa3XmvSdRZWS8c1DdqTwdvc1Lpc-cmOQ2-B4mop7oRk_4DwsIewIAtoEfN1ylc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHbq-SpH1uAboVUb4gpspHr7iMGSM7KoHr_TIiHsFkBg&oe=6AD39228"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fm-H-zQlHSIQ7kNvwG2G5uc&_nc_oc=AdqR4ZFjRNpPyHr6sjt95Z4_rcpxs3FfblohO1Y35BIWCDVGeEdQyzjYL3_eWeCZYHQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw7MNetW3fs-eaSEC7rhOTegEZEo-rEOosA1m_H50RtA&oe=6AD3B5A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_AQH-to2eVxoV9W3N_aMXW6vgnE55u9M9Lfix2N26ZJdWQA&oe=6A82F163"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U-IKzGkiW4Q7kNvwG7JVhx&_nc_oc=Ado4yu1F814a36OtEv6EAoL1tANBMboI2CtnYyh_UWhCuguWUa6Hk5c_AVZG7m1fGYc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETAn5XoW4ia9UEnwisDo-yfk1ZSRf2bcsXSu0y3280Iw&oe=6A82EE68"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzPAxIFfRF8Q7kNvwEbTUOQ&_nc_oc=AdrzROCGgI_NbkRujV_CG2RDHsf1da3cwsVmVz78LSdO39UE6KCrKL9GEpNm5FdFrNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF93K8lZqBdJCV6i9jjMbo7ATA0VTSlUarsAMVAIPYQFA&oe=6A8311E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
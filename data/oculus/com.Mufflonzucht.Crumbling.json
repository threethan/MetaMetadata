h=00_AQLGocAmZEBDR6p6fSIcpW0N7WnK83rtk6Ud0UHJfKAz8Q&oe=6A9C3623"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFNFrNjGxAIQ7kNvwHq6otA&_nc_oc=Adq4ym3kA5q-EbuzOUBNKKxVJnsGHrO803EYKVBHgnT--esF4N9e_1O3wH8L9o4dt10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTvo-6GyvNR6ALzpHQFLjy5LhPkcKgZwSHbOMvZY_y3w&oe=6A9C3328"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVoElzi3V6AQ7kNvwGYHv-6&_nc_oc=AdoGd3fhNF2p3-H-IFzfx6BZ35nLt0gmLgQbarWBAKGhR7_xWRwH1f1Q_KuY2aVi-QU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2qMlhEUHw1O1dBkJf8_dCE-_Qx9x0vFlZrehfCI6YKw&oe=6A9C1E65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
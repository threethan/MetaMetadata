h=00_AQJCXVBM8CUEwF82nfnvd0bQTrbpwjsYfMcswhX1mMRHBQ&oe=6ABBDA23"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itgX-w6a2dYQ7kNvwGvQV7W&_nc_oc=AdqUuq9buNCy_CpWs84IOSiSp_xmwBE97tLrSUjVFjr3hNo0ctR63ANdRzWZJsu33NY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJK6ZBcnWID_Rggkvg0YUTvzjZ849KPy1EyncYK8b3KQ&oe=6ABBD728"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX6l7lJlC2IQ7kNvwG5I07J&_nc_oc=AdqDwf1DRt3XHGUWCJIRnxocWCbwGbBjM-c4ALJp1VQMNQzcnLheylY_STpWKKEQ1zw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhpHdTJuQD6469sw_1GpyoPnuRxLUHqhYaUxqYI3CLVQ&oe=6ABBC265"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
RbPQmNok5EEB5DJhn82tWwQ_aBYd5bgQ&oe=69DF9E41"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvrvxSNB-UoQ7kNvwHo74-U&_nc_oc=AdrCG1IoDMWwcZDExioJAEOFyCHem1ZNQLntXTtIXdXn3RmIBnRsl48Kzs2409_kOeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oAqPfhDoFcgL2fhW4MuQax7ah48RwBq-bZWF3VLBTGw&oe=69DF9053"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65aViig7CCcQ7kNvwHSgP2U&_nc_oc=AdqYY7Sk6sfCd0vWK8S_GjEFMZMEFRmrrnbAqN4mSMMAC8GfUzlOGvJacu_yZetNmdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SZjFO9HzByEUiwmtyi5OR8HXJq7s_7ahhHwglBCMPCQ&oe=69DF7E01"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=He_CA2rfa2QQ7kNvwF6__yX&_nc_oc=Adrhy_BgIflaEKUYrhBRPqnMkK5jGvAA39J3Mituq8OTKRuwsjSW0HYtNiA4gw3Xs8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WGCB20ZDfYuRzfR_lUKDTUPWFDZdxDrJZK8xF50oWZA&oe=69DF7D1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSZFvHVm8rQQ7kNvwFyaZLS&_nc_oc=Adr67A-QiN1kfj-IUnfpWlkmAOdnblVvB9pMIZXLF9q_eZTv_cn9DUiFGgGHV4KcBbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mVTcWp6dEPog6h6YswH9ShD3Z2dnK8dHHFDD34dZksQ&oe=69DF8FA4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
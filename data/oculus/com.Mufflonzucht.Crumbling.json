h=00_Af4WWsUMCCyN-nV_VpWLrdjxgwS_sY_Di5LlpQOTzNjKJA&oe=6A1B0323"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLHgPAT0uNMQ7kNvwG1vc8D&_nc_oc=AdqL8I51ryg2GTjyx6JJHAXpoRKaSf38BfrBQpTTtIe5I8VcdgE6Ux3ZZMMNHJP0duc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nFtbrEUdfVqxrpHcsF2gHtp2ADyeZeXBhs8UycSuIWg&oe=6A1B0028"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOpDTNTE64QQ7kNvwHrDex-&_nc_oc=AdpeuQU5q4Q2qe6JPqzyVqBItr3HBG0F-wyuNLiBLRS_K7DnkOQORxq2VXrQBbJeIZg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q3fbfmC2he_mH0Xw4FEhpaAs5eiBErIps2IY6VD7JSw&oe=6A1AEB65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
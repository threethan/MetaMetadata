h=00_Afw1A8e3xMbVe00yDOFP7oX3OAMZmsEng2ZB69m-97Z0rQ&oe=69C3C7E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1W96tMViTcQ7kNvwE3gpiy&_nc_oc=Adp45BHSIsxvkwjlYP0OOOL0jTyBNCl5Mz_gUBbvYxxNJh2AAUnbz7wgzcimsRzcbFY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRM1z8AClcGpd3xpR1DU6GBnBs2OqHFX2opWFr6OJ0hA&oe=69C3C4E8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOggU_VC--cQ7kNvwHU6s_0&_nc_oc=Adpqj82IP1mK4aNTRLE5PvBTbriUv0TYk4z25eD7lGz18X5HDj6T92sFIH0kXq6njM0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpielFqE4j-Br56sCp4yVkf11ZwPFNnxEa5NNfHKkxdA&oe=69C3E865"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
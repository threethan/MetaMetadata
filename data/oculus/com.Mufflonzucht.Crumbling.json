h=00_AQErhCmzja-2RtFwGBzmd5D79Q0JoZ-nWP7jvg7MPWjjtg&oe=6A9171E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soy7zUKGio8Q7kNvwFlK-4B&_nc_oc=Adr3JoUL6dk24dSRQjm_KIxIGRxYgV33FEQLRJhTGP6_tvDiDV3Cga4jFF9VWIzQXLc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrnILhn1Ie-_6dNaY_g0-PXLD3XX3REH_rp8PHFOqLHw&oe=6A916EE8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDRG-qKDW-0Q7kNvwEEYItT&_nc_oc=Ado4Y4x_oNeP3D6boAAQxRtCCmoigE6L2n6X3i_wosHQ_VDE4o6n-glvdmz1MzepWFI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw8jjNls8T2zsbZYKDHjiGh6pM3zcrvD4rl3PyXgMYSQ&oe=6A915A25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
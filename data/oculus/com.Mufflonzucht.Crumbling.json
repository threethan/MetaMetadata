h=00_Af64hhtxA210QuKooWnbmpaR8KRukEUdASgTN9MTYnG-rA&oe=6A19B1A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLHgPAT0uNMQ7kNvwEAMcEG&_nc_oc=Adqbpi1D69SCsvoyT-R94dRaLlGm-1NFew32g13DoUq5jXpobuuQFg8c2Cpv_T94IDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X3iCW9nHq2_9CILXGgf6hnpfkfM2JUtfSl2s5CT1DZw&oe=6A19AEA8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOpDTNTE64QQ7kNvwHlKo_f&_nc_oc=Adr91kly9bOr3uT0oU5I71B8ro5CEc3tQCZ_f2Hse7MD3p967uyMcikk4BmlXFaZlGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49LPi_pFitqZKCF0jpLTIMdjS2g8Og6iIwj7vVprSkIA&oe=6A1999E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
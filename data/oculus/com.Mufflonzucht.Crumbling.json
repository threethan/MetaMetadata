h=00_Af3Kx6T7iAISzNRLtsbM-CS8Ag7RIdk01tKG6eEBX3Gqtw&oe=69D78E63"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZOyr81KlI4Q7kNvwFxn_7F&_nc_oc=Adq0Uqw7pSivSVCcM70SfCFEKPb9vgdX9UhNA6mmwOsDI1gpVvZ-jVYK5_P2qO163Co&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MsdL7izpZ7RlmK34CIzhXIB6fN7_R4RbC2bg4SEus0Q&oe=69D78B68"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xv_HG5xy74Q7kNvwFLt7JS&_nc_oc=AdqorPjDWJlfBK7dg_P2EnzKUi4S5hHbduIiijjWYv2dDfuV-SkbtREKNTRzk3GecGk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32-y8y_zzel4nIm71SXXe5TBsRT1VDf9j7gA0-IcLFHg&oe=69D7AEE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
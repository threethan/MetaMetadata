h=00_AQN8OMbLKwSZ88Zd5prnpaA5ZH4MY4R-Is1MqXkkokJrHA&oe=6ACBAC23"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ar7eVa8x-08Q7kNvwFwTDpk&_nc_oc=AdofObbIDJu9X-RGFcw8Bi2xtARcLIiNUpi45U6siSUnUmCsfcrLgdFRo8I4lrkT1BU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjoGBcwRdMNKvOAFJnhxsG94Agiz94MkRR84GU_2XiTw&oe=6ACBA928"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQnSTeHRQrUQ7kNvwGeFDoL&_nc_oc=Adqv5AOLx6_jxqA0hsPkbXI7GsYHvw4porQNrpohyeinMMjK5G9_p5xTzEksq-Zzg_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-lYpQR9-_qkWSjL72Uivl0Hrb5tLy5n_dKqpMokZSOg&oe=6ACB9465"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af1CeYtjl8BiH5Av6NpSglPX0xRUAXOg-m85qPw7H5FEig&oe=69D4EB63"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hhIxGO6cxYQ7kNvwFJiGHF&_nc_oc=AdpXEDCBhpb2AUo9tcNocAI6St9A2gxt-6If59IerWJjiZf8rtIkMKab6FfPKwzyEjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VAoFYOZCGbQNXSrlU2xXKtCThhRwE5X72NXHkdK8GzA&oe=69D4E868"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xv_HG5xy74Q7kNvwESZaK9&_nc_oc=AdrnoEa2scMH6JmH_bKMs4eTvEMVb79UHIvI7DAYN5APukNi1QqcMsLoNYPaXHYm4Os&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rQ91r7PGvGU4nIe9K3fw8jAuaCYt3iHd29gOwh3S8cQ&oe=69D50BE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_Af7iKRW6UE4EWZAjfzDpQ5giKVwE0rZpt0hGlg6yGb-O_w&oe=6A15BD23"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKuZ-QxuxjcQ7kNvwGajoq7&_nc_oc=Adr9mRiHfGCzhmGZHldE9sTP2Z0S9vh7I7ARU8wRsPApQvsvOy75pBkF9YssS7KjkX0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R4GPT4mc_QDrLUi1j0KERCr-NH92h_ZtoC6Z4KVk26w&oe=6A15BA28"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBmmHLTmkyoQ7kNvwEmwMDE&_nc_oc=AdrnMOuapZuaLOEq3GceOdHx7EIcgwoxKU60fxzehNVTpV2Plf-rWW3AzwWUFK3cR2w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O0JTUb9O3NtShqw53P1lCjmcPkK9TVNxfC4N8hJzjvg&oe=6A15A565"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
h=00_AQKY86EaqRJq592PAzKXMzp2_357XrzZYxyzpNA7Q-Z5yA&oe=6ABD2BA3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itgX-w6a2dYQ7kNvwHphBYP&_nc_oc=AdoLxPy9KRrc6s03ANIpluRENPaTGPXE2QEaiFDgNKjIRMZ2yIF7HA6hhmf7hfyL3Pk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKNvLxf65SB1zCgK_ONy85-wsYv3rFW4JQUEcm9tLUOg&oe=6ABD28A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX6l7lJlC2IQ7kNvwHlp_ns&_nc_oc=AdpNEzuejo-g6bj64jXvoJjmf7dPN-9jG3qGj9K2zidBEAsGO1Johqiplro32KGnct0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyaUL1bpsLRXbocPLM-mJHmTGrUjKtoadhVWLc0sysVg&oe=6ABD13E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
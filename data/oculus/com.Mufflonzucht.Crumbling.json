0qRTJNOVMC_hlIMdfR0exbZFS2yqlokw&oe=6A47C4C1"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0LjNUAYl-8Q7kNvwHG0P0P&_nc_oc=Ado3qJNXS3_hvh3YHE_JXcqC5BnKmIV0TkblRViNmT41THBzq5Dufldt84I5miAG9v0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mRrrGYtV5YVmVwN9zRPInMeeF4VQkxoS86mUZfyJbDQ&oe=6A47B6D3"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zb3jr7sUdi0Q7kNvwEWHgr5&_nc_oc=Ado21aTxrlqLAqB1io6rmpkhGaNOqmgwobonsvk0PxDx9_PP975wnuSXycQH4EIOQuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XJmsUFpq2uELbhyC7TOaOmLC_p0nVQ0CLMXGYzKpZJA&oe=6A47DCC1"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOM7UKolPYYQ7kNvwGnZMcJ&_nc_oc=AdqoJS_lnDk3r3A4_YtRGpGlDNEKW1l02JKutZzhMFPfceoA-8L3zC3v-AiPSwyHEdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mLw6BdTE5IAB3200yqvjdvr7H7ul9z4-Q-3fMkPSACg&oe=6A47DBDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0oLrTU9Fs0Q7kNvwEKFhqr&_nc_oc=Adp-4TgsTzJYkY48U-LN4bBs1BBxxqkRMKk9rZzftUFZPWmJBLHcyWPSog7fLjxDtzM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mt1yz0Asy_ZcZDYrFV29Tmo0wqvYNhuc3nq0ht-g9Aw&oe=6A47B624"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
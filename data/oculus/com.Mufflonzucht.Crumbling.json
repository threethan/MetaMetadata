h=00_AQNj7uJdM46a8cYFN4Z4bb9RjEDCE-xh08Un9hLAovb18A&oe=6AC12023"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNrA7o0YS3cQ7kNvwEvVzN7&_nc_oc=AdovrqSmfIEuJ5QwjUwrB3Motx1BP_9h0Y-_yXcrnwBbo2md-5BiCs10E3836Y5Jkxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx2QBJ0KF7NICpfTqk1BEx1D6AZpiJzyB0HKlGOVPpiA&oe=6AC11D28"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ylOdI67tnIQ7kNvwGVEdgu&_nc_oc=Adp9UTLylt7WcvMECRvlE0n6C5p-nTMUIQqpn6peO5fMjyaRhdZYGIccKKjbygFEhG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6r9LtbrAu5EsJcvLGYdXNlAg12jKv1e9Oc5YIPujvlQ&oe=6AC10865"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
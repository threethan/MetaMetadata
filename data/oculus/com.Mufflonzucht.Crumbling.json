h=00_AfwEWlJ0hqiHFTH5SLaJb90zXdJzxBQ9sxdIUTfItsy3Fw&oe=69C66AE3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmKWJfk20h0Q7kNvwGlP0pr&_nc_oc=AdrKtmpE70FP6ihTmgqtO9Xlm6Bq4b4IF7tv5btaTq-YOWeLYuNwbMBjnhyDlM0v80U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyP69CC_0bHM44OaXVxIYgzihxw71CoIAAC7sm1sqNCvQ&oe=69C667E8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPGh67zRptEQ7kNvwHuWuY_&_nc_oc=AdqzL4D3KqhT1nFyRQbl34DAT5UYbj3LZrwpE0Ccy64sfI7IdPOZC_-bPdcD-75iSUA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD2wjx74lsi5s-baMJxdeAUt4KRxzSh9U0Bi1L9KXZmQ&oe=69C68B65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
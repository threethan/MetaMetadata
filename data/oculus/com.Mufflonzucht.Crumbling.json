h=00_AQIWkBxXhfgks3-9IeMRJhaYLhlQFl9VMBnsfFBzZW4zog&oe=6AAD59A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGgx2hR30dcQ7kNvwFak_6O&_nc_oc=AdpieGPgHo_Px-_jmWYif5klcXLbq1LA9k4G7rOwmzVeSV3xR6nfCrWn4wQz__UNAU8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUruQ4pNOn64atqESODGbVwoU0zrpSdn0MCgclDb1m2w&oe=6AAD56A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU3uwp2yvTQQ7kNvwE07ddi&_nc_oc=AdoeystJpLeaOx_gkpkFjVOOLU0x1JQGyclHinUa4kLw22Qd6Iqf9PO3Kk53Bq0scnU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNp54dssTRD6rvzB07aiChazW10g-Jv4rSKFLUiWimmQ&oe=6AAD41E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
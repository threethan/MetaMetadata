h=00_AQE6OQImtKv8HYDold0kPQuqCJGQ3lL1_0Sp3yun8qbeXg&oe=6A8442E3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECKMK9gJN3EQ7kNvwGRkzcK&_nc_oc=AdqAPyAK3hojdQH6gJLrS18n0Z9Fs17Pf2YlIo4GQb31CMr_j73vtXo_INpAm3jN0kU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeAy9hR5UAW3HojF6vXaoTu-xBvt-77H5NvbNCVQaJpA&oe=6A843FE8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzPAxIFfRF8Q7kNvwE8oKii&_nc_oc=AdqC04E-2JnBg46_R2_kMlN3OcfrEbymGv6-aEQM-dorfKT9bX-3kH_jNYh3KVOHzMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbnu2Ujo254hDtuFj_vgfdWRyYr2WqD9gsbHd0CW_n1Q&oe=6A846365"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
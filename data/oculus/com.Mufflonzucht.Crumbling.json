h=00_AQEsQC-WMJGAjp18j5nA7niNSs9Vt0SmOhBIu4vqHEadLA&oe=6A8C2BE3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1qlGWpJv4MQ7kNvwE6k4GO&_nc_oc=AdqlP1huYfFYSiSL5vEnTgjmBuiBt2ClNyyp3upWNQRY-RwwqaRVqJaZQ30ChD4BEwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp-2v3C1TAIIG3ywYwgnRidTQHxBREJx2FXT154oEgbw&oe=6A8C28E8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E7nAmEibzEQ7kNvwE0WURO&_nc_oc=Ado2SGPwvP8eiKzVdbIo74ulsPV-p_m4x13WuNOehj8b4IYndD35kJe7cJ631gNh6MY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-CWJIgwJZzxWOAMrCAxM99czsrMa9bVLW3_k1eVQKmA&oe=6A8C1425"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
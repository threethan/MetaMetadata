h=00_AQE910PzvwzVqQvEG9lHMhXNsq9pJUCywiY1Eakeljze4Q&oe=6A883763"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voOMKynP2S0Q7kNvwG5o8P2&_nc_oc=Adoex7UO1nDIc10X5k_FUQYHE2RPtRzU0SkejBX1AToEUuJ57csmICUszFviwGmC6NI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxjirqUGfPoYwabrmHXP2g-eOMh5P2OU7SAHvh_d7GSA&oe=6A883468"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uu9MoccaNRMQ7kNvwGvhkBk&_nc_oc=AdrlMe7drp8ZNmH1eH27kXysIeeqNj_sINPq0tZN_Dqv_ephztkXgalnFteaSoFxDJc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErfjP7qRW9onKEswrrPew-mVa_x3GJmuV7g2m0EtZm0w&oe=6A881FA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
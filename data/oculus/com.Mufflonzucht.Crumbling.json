h=00_AfwBKfgSMv9ucmXSq4m427aDyOYZ_XhFeK1HCgMEZfnarw&oe=69CA5F63"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bmd0Of5bzaYQ7kNvwGBM4a_&_nc_oc=AdqNr9HttRy51DHQBYXCAR4AFmyF6mIn320pNj1mW5smo_bt6Sl5eBHBvfF6zPAse5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIm95uQBzC0jzR8bzvFWYhC84RMjsskoI94mxF0bsU0w&oe=69CA5C68"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V7sIOSNIdIQ7kNvwE98TI-&_nc_oc=AdqEBYdnEttu_TXd04aDOaBg9GKVD0JMZwgUzbu7K9ptx_PiUID7U2Kt_8suElvgM7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfhpDRcC3tG6_HSiUZPuEr8n9mi5RSk2bHYNGVMy3FBA&oe=69CA7FE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
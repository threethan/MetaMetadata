h=00_Af7OfZ9knBI27nwJkh-KES7Xngs84643AUDIWR9PiOIG9g&oe=6A204923"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoOWFCXuapQQ7kNvwER4OMv&_nc_oc=AdoDoNBbEg3I2fWIJgSA2x77ysN588UBLlFCWtRVBjOkM5Ki11XDg8x1EbFZV86cbgk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45SQDW5eECkUI_Yb-Hly-qYX8_qrMpygG3ccCileir8A&oe=6A204628"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_FDYRAaJDsQ7kNvwGfDulM&_nc_oc=AdrGZkcfZTw84N_eWDwJsTV7mCFcMyBRx25Ck7D0m-KmZntv9qxL7ZD5-X0EYsoWvvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75HJPV88xjqi0mfK_7cUUoUzFG3lV_KNIrwDXRBtxacQ&oe=6A203165"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
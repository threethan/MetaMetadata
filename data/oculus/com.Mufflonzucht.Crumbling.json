QMtY9mGKr5g0Yl151PVLaja_xGd_EAsg&oe=69E24141"}, {"file_name": "Screenshot_Fight1.png", "id": "459809059154889", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031629_459809062488222_896247959200297444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvrvxSNB-UoQ7kNvwGwPrzo&_nc_oc=AdrpkLXIKtA9kSK_k1NXUH9mG2xATKDteNJGBYEBK7db4LVNjnXD3iPMeBKHtYnvJMM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zf4DgrhJKIJ96_u-d2-wkFePMfC7BNsy4RuxFw0euWw&oe=69E23353"}, {"file_name": "Rewards_2560.png", "id": "778237807302716", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38984474_778237810636049_8168769842856354296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65aViig7CCcQ7kNvwHYEpF5&_nc_oc=AdpnXv9TaETMTtPkwgIg45GmNo0L_3jKnXikFlO0o1dabt-xDyzvEDCE5s43XjmaV-A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Lo48ZLa1ok1OfYqxuLxHHnh1x1QvYON5Pctn9siZKUA&oe=69E22101"}, {"file_name": "Screenshot_ReadComic.png", "id": "337738854928558", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982685_337738858261891_4506688399668725068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPtNDfvHnnUQ7kNvwEVcS1W&_nc_oc=AdpaZk4_FygRK8UXEYhlysUmbL01HdnhVg1OsINYEXAXKJRr_Ozq0z8k6rGjnFk6zTU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oiE--LogLDYMM0BOxXzsW8xv5nm4xW58Mvn2b0_-dlw&oe=69E2201A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1804923969964834", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75222941_1804923973298167_7999747304686780980_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u182YGqiH2YQ7kNvwFKE0Y_&_nc_oc=AdpuissrH0NxxgZc6HGgm3hu4DRKsOGADMdNSxH9hTKhFXAAZKfbMzc42IBN9fpcawc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0384TVICH_Y3iZB36t5cRLR2og9okCSYHuxdvflTKAYA&oe=69E232A4"}, "display_name": "Crumbling Demo", "keywords": [], "long_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure where you control your character as if it was an action figure in your hand. Move it around meticulously hand-crafted dioramas using your touch controller. Or use the native hand-tracking of the Oculus Quest. Fight against an onslaught of plastic monsters in hack'n'slash combat that is all about timing. \n\nDiscover the story of the endearing Mr. and Mrs. Crumble through animated and narrated comic books. Learn how the evil B\u00f6se Corp. stole all their magic in order to make their horrible monster toys come alive. \n\nAre you ready to wield your Crumbling against the evil minions of B\u00f6se Corp. and reclaim the magic?", "short_description": "Whoosh! Bam! Pow! Remember playing with action figures? Unwrap your Crumbling from its blister package and take its fate into your hand - literally. \n\nCrumbling is a VR rogue-like action adventure. You fight plastic monsters that are minions of the evil B\u00f6se Corp. As you progress from one meticulously crafted diorama to the next your Crumbling grows ever stronger!\n\nDiscover the story of the endearing Mr. and Mrs. Crumble and the evil B\u00f6se Corp. through animated and narrated comics."}]}, "developer_name": "Crumbling Games", "developer_privacy_policy_url": "https://crumbling-game.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crumbling Games", "support_website_url": null, "website_url": "https://crumbling-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
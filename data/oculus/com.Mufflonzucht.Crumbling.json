h=00_Af6rZQ80_Fix7ZXYA5GR1Zzv_U3APIM3PngLqdM14XAQdg&oe=6A073CA3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttQIr85kfAEQ7kNvwES0PQ9&_nc_oc=AdrgfCOars2eyaB9l5DdeiHkzLLlhSvuuaUrZJ-kQxeMokBy9W5Fc-6-GvmIuynNe2k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xl15XvD19V7CxF4gALhFkw-eCe3ZkBroFfos5ujGN9Q&oe=6A0739A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQPAT69dRywQ7kNvwEl70Us&_nc_oc=AdprebWPHSor_Kyh7UrZ8E2TWeJD_EfYMLlLZfYcVLpFwN9qPsF1b2OUA0AfBrs1k1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UPcloP3qOcy0-MR-Kd8DWCkLeKaqSEO5zrkY1ccoZYA&oe=6A0724E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
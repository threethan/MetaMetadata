h=00_AQCX-sMUAaVlhJZgbXD22ORRVC6orP4GlkrzMIRwbaoLXw&oe=6A4E6DA3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhoJvAR_WjwQ7kNvwHbWzOW&_nc_oc=AdonNUK86Ff1B1zcoAtT1CF_u5p9SRYydWEXXt8mrZ9I3IBN3x3sTSEOZMfmV9Po4Fg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm5ZhZXWffl-mWRv1S3E465ZGu1z9rxkri7_1vha66Rw&oe=6A4E6AA8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Gp_EO--AXMQ7kNvwFfH16R&_nc_oc=AdrP9rdWTpnjSezet_OebduiOhECLyzlNPFThNcmSUa6lqEpNgLfjiexMU9-IJX3eD4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf2VhjEHu9FIPcqUhPEFZmWzK_j4eLsK_8UlI2Sd-0Cw&oe=6A4E55E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
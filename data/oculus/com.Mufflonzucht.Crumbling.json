h=00_AQBZuRaRs9P42GQ5LsrhXJmJiZJwtPAT-hcImS3YbQsINg&oe=6A5656A3"}, {"file_name": "Screenshot_1.png", "id": "885734758938773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982464_885734762272106_993609447690333919_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cUCZ7D-1REQ7kNvwE-Qu1L&_nc_oc=AdqiAycPx6qRiT9UtEr8YHjkgxMq-6_RrHHiw5fD2zURBUqTVoBoB4sab7I84_TtjX0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHpUzVhkaKfrX79xxC4iER0iyRinUnZY8dxDH8XjIK1A&oe=6A5653A8"}, {"file_name": "Screenshot_2.png", "id": "271532111232490", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75262744_271532117899156_2051566399827067609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fxo3vMI-m1cQ7kNvwFx0JlJ&_nc_oc=Adrr1joAbmP3O7saHgorBgJRl5Sz2d08dPz6DlCkzLZo070TEuMA1f8BdxtAT1eWqf4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG_RAOos57c6r9FDTu_I3ADSgCuOaguglBjFa4KY_4eA&oe=6A563EE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crumbling", "keywords": [], "long_description": "Crumbling is a rogue-like action adventure. You fight plastic monsters that are the minions of B\u00f6se Corp., an evil corporation that kidnaps Crumblings, seals them in blister packages and sells them off as merchandize. As you progress through an onslaught of monsters from one meticulously crafted diorama to the next you grow ever stronger. Ultimately you face the end boss, the B\u00f6sewicht Golem.\n\nThe game is played in third person. You control your character directly with your touch controller, as if it was an action figure in your hand. You can even use the native hand-tracking of the Oculus Quest to use your actual hands instead.", "short_description": "Woosh! Bam! Pow! Remember playing with action figures? Put on your VR headset, grab your favorite Crumbling and fight your way through an onslaught of enemies and epic bosses. Rescue and collect all Crumblings. Their fate is in your hand. Quite literally."}]},
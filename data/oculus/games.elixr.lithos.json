b=1-7&_nc_sid=6e7a0a&_nc_ohc=5-blZM_Y6uAQ7kNvwHUxTmh&_nc_oc=AdqTQ5hlffDwbxXBY0GrjZmYhy0M5mIr8N3Gq4SgGPwOjoyOLsVoEqV0PVUsjomrz_k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY7sgzPgiz5H3GRzyQLY4RPGRzg9QeiRYHqwilkz218Q&oe=6B071DDD"}, {"file_name": "Screenshot 2026-05-04 at 3.17.39\u202fPM 1.png", "id": "2177008513130999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308010_2177008516464332_1260347985144712461_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPoqVvEEu30Q7kNvwFHrSqi&_nc_oc=Adr26vMAKX1ZmfZJIzuAKrSHRjyJ6_9JM0oqLy_3WrTltBJgb8jSpJ3xrJUz1AqcC2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScyuFiTazpGgoxZEpcGAUG8AM6hr3LbRnKp6gG64k6-A&oe=6B06F73A"}, {"file_name": "Screenshot 2026-05-04 at 3.18.33\u202fPM 1.png", "id": "945410294768493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_945410298101826_2578381118045219587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcu7P3jt61gQ7kNvwGHNQbQ&_nc_oc=AdpY4d6UH3se-pZ6uTFRZbJNVzNbyM6irP0KsurdEOzrYvSJrxI9UON01m3cw63T6NY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh2uVKtWjupHNIMpHMnwKE1xVv2X8B-vJ2-obtrteWng&oe=6B071390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-05-04 at 3.15.32\u202fPM 1.png", "id": "1484271389196304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307505_1484271392529637_8987309552821336217_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOTIk0e_uO0Q7kNvwEBeJol&_nc_oc=AdqcpTJzEqguB8WElmLME11LoETuxxElIwxLEudJ6fqPTp_K5KPwLLB5DEAJAIwKp-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdb9dMwWExgkwyhif3dcCSmnxuY-mQaINbN3UYP-8d3Q&oe=6B0721FA"}, "display_name": "Lithos", "keywords": ["puzzle", "blocks", "stacking", "tabletop", "casual"], "long_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and keep stacking before the shaft reaches the top.\n\n**Pieces and the shaft**\n\nPieces fall one at a time into a 5\u00d75\u00d710 vertical shaft. Each layer is colored by depth, so the stack reads at a glance.\n\n**Controllers or hand tracking**\n\n- **Controllers** \u2014 right joystick moves the piece, left joystick rotates it, click either thumbstick to drop.\n- **Hand tracking** \u2014 Quest microgestures: swipe with the right thumb to move, swipe with the left thumb to rotate, tap a thumb to drop.\n\n**Three difficulties**\n\nEasy, Medium, and Hard change the falling speed, the score multiplier, and which pieces show up \u2014 small, simple shapes on Easy; five-cube pentacubes added on Hard.\n\n**Tutorial and leaderboard**\n\nA three-step tutorial covers movement, rotation, and the drop. A global leaderboard tracks top scores between sessions.\n\nDesigned for stationary play. No locomotion, no forced camera moves. A clean, minimal puzzle that fits a quick break or a longer run.", "short_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and chase a higher score. Three difficulties \u2014 Easy, Medium, Hard \u2014 change the falling speed, the score multiplier, and the shape pool. Use Quest controllers or hand tracking. A clean, minimal puzzle for short or long sessions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lithos.elixr.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "EliXR Games", "support_website_url": null, "website_url": "https://lithos.elixr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
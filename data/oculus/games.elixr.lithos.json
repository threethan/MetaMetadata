7&_nc_sid=6e7a0a&_nc_ohc=9Gyj-_9dhxcQ7kNvwHfZE9N&_nc_oc=Adr6nncywNeI6hML6EYhLMfuNlqgjZQrXUwU5-zX57K8F_dJjTkR0VSpxCTRfOAyqvk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99pc3a-uAV8w0abAH0SnRBeHvK0eUiXdSLZtfvRSg3lw&oe=6A368E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-05-04 at 3.15.32\u202fPM 1.png", "id": "1484271389196304", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307505_1484271392529637_8987309552821336217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwuqvhvjiQ4Q7kNvwEG13RX&_nc_oc=AdrzftuKzMmCBD5jGM_cUtzFhpkdJnn1UX8GTYFE9lIluewDyvNn4_0Vwv_iP86XCy4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83kVdX38Z6H-WP9HJoumqF6vlECB9MjfWP4cEram5Z6g&oe=6A369CBA"}, "display_name": "Lithos", "keywords": ["puzzle", "blocks", "stacking", "tabletop", "casual"], "long_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and keep stacking before the shaft reaches the top.\n\n**Pieces and the shaft**\n\nPieces fall one at a time into a 5\u00d75\u00d710 vertical shaft. Each layer is colored by depth, so the stack reads at a glance.\n\n**Controllers or hand tracking**\n\n- **Controllers** \u2014 right joystick moves the piece, left joystick rotates it, click either thumbstick to drop.\n- **Hand tracking** \u2014 Quest microgestures: swipe with the right thumb to move, swipe with the left thumb to rotate, tap a thumb to drop.\n\n**Three difficulties**\n\nEasy, Medium, and Hard change the falling speed, the score multiplier, and which pieces show up \u2014 small, simple shapes on Easy; five-cube pentacubes added on Hard.\n\n**Tutorial and leaderboard**\n\nA three-step tutorial covers movement, rotation, and the drop. A global leaderboard tracks top scores between sessions.\n\nDesigned for stationary play. No locomotion, no forced camera moves. A clean, minimal puzzle that fits a quick break or a longer run.", "short_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and chase a higher score. Three difficulties \u2014 Easy, Medium, Hard \u2014 change the falling speed, the score multiplier, and the shape pool. Use Quest controllers or hand tracking. A clean, minimal puzzle for short or long sessions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lithos.elixr.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "EliXR Games", "support_website_url": null, "website_url": "https://lithos.elixr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27194360746815700"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2214982325937316"}]}, "baseline_offer": {"id": "2214982325937316"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778089380, "status": "PUBLISHED", "id": "2214982325937316"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27202307242687717", "version": "2"}, "id": "1326970075994131", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": 
47985144712461_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zf_2wPvr_MQ7kNvwFV3wQM&_nc_oc=AdrLbwCqGQDjGpgDfmC_gCAX2vl_LBjLMSIyKFhpYjei-hlyRAGO16wrHCysV3iCrg0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgkeG6J0eexJloV-BTCTlsDc-YTcjTRqk5Z8iebme0yA&oe=6AFB19BA"}, {"file_name": "Screenshot 2026-05-04 at 3.18.33\u202fPM 1.png", "id": "945410294768493", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307470_945410298101826_2578381118045219587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0ehRGVVgQUQ7kNvwH5PAWO&_nc_oc=AdohcepoFkVornVkjmMzvui1iLMEeGhreX4c9A1nPGSVDmfrT70EWuFJ6fIH-3OIQuI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR36MKWWt5qjwXIDWqemsBQCnYvhTr_X4_pIZrHybEAMw&oe=6AFB3610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-05-04 at 3.15.32\u202fPM 1.png", "id": "1484271389196304", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307505_1484271392529637_8987309552821336217_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo8-tOvQj_EQ7kNvwGywbB9&_nc_oc=AdqDP5wNhNgCohuPzQrfc9mXA0pxh6qwr5CRZs3--WkZu1kET3l9dp_uC8Q6XgwZq70&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8jrk0-84u5D3VOjkHx1oA2AtONOsgE556A0Ib_UlZEQ&oe=6AFB447A"}, "display_name": "Lithos", "keywords": ["puzzle", "blocks", "stacking", "tabletop", "casual"], "long_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and keep stacking before the shaft reaches the top.\n\n**Pieces and the shaft**\n\nPieces fall one at a time into a 5\u00d75\u00d710 vertical shaft. Each layer is colored by depth, so the stack reads at a glance.\n\n**Controllers or hand tracking**\n\n- **Controllers** \u2014 right joystick moves the piece, left joystick rotates it, click either thumbstick to drop.\n- **Hand tracking** \u2014 Quest microgestures: swipe with the right thumb to move, swipe with the left thumb to rotate, tap a thumb to drop.\n\n**Three difficulties**\n\nEasy, Medium, and Hard change the falling speed, the score multiplier, and which pieces show up \u2014 small, simple shapes on Easy; five-cube pentacubes added on Hard.\n\n**Tutorial and leaderboard**\n\nA three-step tutorial covers movement, rotation, and the drop. A global leaderboard tracks top scores between sessions.\n\nDesigned for stationary play. No locomotion, no forced camera moves. A clean, minimal puzzle that fits a quick break or a longer run.", "short_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and chase a higher score. Three difficulties \u2014 Easy, Medium, Hard \u2014 change the falling speed, the score multiplier, and the shape pool. Use Quest controllers or hand tracking. A clean, minimal puzzle for short or long sessions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lithos.elixr.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "EliXR Games", "support_website_url": null, "website_url": "https://lithos.elixr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27194360746815700"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id
b=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsnyPqnf5SYQ7kNvwFrMGme&_nc_oc=AdpU3a5ITlqTFnfV71UeAjR6jtdzPibJ3S9L1jVQbfBpupfhHhx0plnQ54gcEzOXbhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS86UibOq_ObWfn-_yWktAwbWM14ZZvwYxoDlRnEQ8Dng&oe=6B09C0DD"}, {"file_name": "Screenshot 2026-05-04 at 3.17.39\u202fPM 1.png", "id": "2177008513130999", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499308010_2177008516464332_1260347985144712461_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPoqVvEEu30Q7kNvwHglE3J&_nc_oc=Ado_8ad0gCoA1ctfD3WbqMC-EN6bYv3I26PdfhrSnjqCtv9uyUQ4D7dGiz-IXlx7rkM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRt3TLvwtnw8Ypasex_U1Ve4Or_QTgcc8NaOlCEKuYhg&oe=6B099A3A"}, {"file_name": "Screenshot 2026-05-04 at 3.18.33\u202fPM 1.png", "id": "945410294768493", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307470_945410298101826_2578381118045219587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1QnyAY5s-AQ7kNvwG3g1BF&_nc_oc=Adp_JwSNlfLvOA-RZCEtniUPCUNzSrx4-ztk_6Pzq6_Yyr-yjNZUiIqcgrLOn63lg3Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNRvtc4OEDq4Ikv91o9dlQugB-ntaZC4RXGoiYiBjhng&oe=6B09B690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-05-04 at 3.15.32\u202fPM 1.png", "id": "1484271389196304", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307505_1484271392529637_8987309552821336217_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOTIk0e_uO0Q7kNvwGMIjtk&_nc_oc=AdoZ45wnQNADC3vqw0Of7z1mxPvlaDiG4oW-mLRICYhZVqGWIMmlzSboj0XN5LDgId4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAR6aV7pRsegkDvzntQa-99uz4xP3DNirpTFqFy5vJpA&oe=6B09C4FA"}, "display_name": "Lithos", "keywords": ["puzzle", "blocks", "stacking", "tabletop", "casual"], "long_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and keep stacking before the shaft reaches the top.\n\n**Pieces and the shaft**\n\nPieces fall one at a time into a 5\u00d75\u00d710 vertical shaft. Each layer is colored by depth, so the stack reads at a glance.\n\n**Controllers or hand tracking**\n\n- **Controllers** \u2014 right joystick moves the piece, left joystick rotates it, click either thumbstick to drop.\n- **Hand tracking** \u2014 Quest microgestures: swipe with the right thumb to move, swipe with the left thumb to rotate, tap a thumb to drop.\n\n**Three difficulties**\n\nEasy, Medium, and Hard change the falling speed, the score multiplier, and which pieces show up \u2014 small, simple shapes on Easy; five-cube pentacubes added on Hard.\n\n**Tutorial and leaderboard**\n\nA three-step tutorial covers movement, rotation, and the drop. A global leaderboard tracks top scores between sessions.\n\nDesigned for stationary play. No locomotion, no forced camera moves. A clean, minimal puzzle that fits a quick break or a longer run.", "short_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and chase a higher score. Three difficulties \u2014 Easy, Medium, Hard \u2014 change the falling speed, the score multiplier, and the shape pool. Use Quest controllers or hand tracking. A clean, minimal puzzle for short or long sessions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lithos.elixr.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "EliXR Games", "support_website_url": null, "website_url": "https://lithos.elixr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
YvJ1zG270E0M3dCWIkTrVkh_OoxrpnWGHtA&oe=6A7DC99D"}, {"file_name": "Screenshot 2026-05-04 at 3.17.39\u202fPM 1.png", "id": "2177008513130999", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499308010_2177008516464332_1260347985144712461_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HD4RKElxh4Q7kNvwGWgZsG&_nc_oc=AdoLqE1se_8ZXRm5hO8zCrFUK139TkupMfxdUuodvjE3jbHjPsf5qJWvbPRCweBZRLI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD8VxoONIPcBXWwr9m1zsZg18UcWGi9cdjJyeGUt1dEg&oe=6A7DA2FA"}, {"file_name": "Screenshot 2026-05-04 at 3.18.33\u202fPM 1.png", "id": "945410294768493", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307470_945410298101826_2578381118045219587_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSzyVRlW8TAQ7kNvwH2A9AM&_nc_oc=AdrmbfYPOBdwVsqEcCaJupTHNbCqscTuzs2T5uO9t_qNTDiZ1gA49i1ZUvHCqtz6vUU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4DvSfbJYGD_lgJxld9LxlANJJH-YnPf6cKz7iTBNwCg&oe=6A7DBF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-05-04 at 3.15.32\u202fPM 1.png", "id": "1484271389196304", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307505_1484271392529637_8987309552821336217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXbcNZ8AQL4Q7kNvwG80Fox&_nc_oc=Adqd3sgZgqgscDRz1uEDvQt4Dbf8z_KFQUsM39M67ET0EK_Px3nwOAueBojC4AyR7nc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFacZwpPNd7ERd36-bXBbTWkykCC6bB8n5rMbgz_xJY8w&oe=6A7DCDBA"}, "display_name": "Lithos", "keywords": ["puzzle", "blocks", "stacking", "tabletop", "casual"], "long_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and keep stacking before the shaft reaches the top.\n\n**Pieces and the shaft**\n\nPieces fall one at a time into a 5\u00d75\u00d710 vertical shaft. Each layer is colored by depth, so the stack reads at a glance.\n\n**Controllers or hand tracking**\n\n- **Controllers** \u2014 right joystick moves the piece, left joystick rotates it, click either thumbstick to drop.\n- **Hand tracking** \u2014 Quest microgestures: swipe with the right thumb to move, swipe with the left thumb to rotate, tap a thumb to drop.\n\n**Three difficulties**\n\nEasy, Medium, and Hard change the falling speed, the score multiplier, and which pieces show up \u2014 small, simple shapes on Easy; five-cube pentacubes added on Hard.\n\n**Tutorial and leaderboard**\n\nA three-step tutorial covers movement, rotation, and the drop. A global leaderboard tracks top scores between sessions.\n\nDesigned for stationary play. No locomotion, no forced camera moves. A clean, minimal puzzle that fits a quick break or a longer run.", "short_description": "Drop, rotate, and stack falling 3D blocks into a tabletop shaft. Fill a horizontal layer to clear it and chase a higher score. Three difficulties \u2014 Easy, Medium, Hard \u2014 change the falling speed, the score multiplier, and the shape pool. Use Quest controllers or hand tracking. A clean, minimal puzzle for short or long sessions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lithos.elixr.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "EliXR Games", "support_website_url": null, "website_url": "https://lithos.elixr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking
_600564392391639_7288485845414629543_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIKjE6BzXxwQ7kNvwE_TkE4&_nc_oc=Adm018RUmcJDLNoaUY3OnAJzzxadA1T-AQCNBbkPYHKSvojaL59O2RZePDI09UaiSqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYuO7PHxbOzgGLyxfEu1W0dOnTBQ8nVTRx27iQ6NKQ3Q&oe=69B7FAAB"}, {"file_name": "ScreenShot4.png", "id": "4154069701529765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499318056_4154069704863098_6437066471974187688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zsdv2yVJPUQ7kNvwGFZRBL&_nc_oc=AdlTrzerSExcjSvKQ-npIJeOQdeUuB3ifEai-MqxOCoHc_dyynDq0Cw1dR1T6lsRLCM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzDNBJ6m14il4y9ZlbW9-ND_q6dZ1sxgqLTtzbt17-V0Q&oe=69B80F08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "4526900444203911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_4526900447537244_1593155788570280980_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw74JjbJ5a0Q7kNvwHD8Yk6&_nc_oc=AdkDkitVQcUjXfaQjCNx3A-RxVHy2vEqyFmTNUaCkyu67nacRe_KGnyTmDwaFBsfL84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ4lA2A8rV9y4eitYhWTdQyHCIU2gmQ82uG3SHCuudaA&oe=69B805E6"}, "display_name": "The Historical Art Gallery", "keywords": ["AI", "Gallery", "Art", "Paintings", "History"], "long_description": "The Historical Art Gallery is a collection of famous historical paintings like:\n- The Scream, by Edvard Munch\n- La Promenade, by Pierre-Auguste Renoir\n- The Music Lesson, by Johannes Vermeer\n- Starry Night Over the Rh\u00f4ne, by Vincent van Gogh\n- Four Seasons in One Head, at and by Giuseppe Arcimboldo\n- In the Loge, by Mary Cassatt\n... and more\n\nHere you have a nice gallery environment setup with the statue of a horse in the middle, as an extra you can see how the AI animate the paintings.", "short_description": "The Historical Art Gallery is a collection of famous historical paintings like:\n- The Scream, by Edvard Munch\n- La Promenade, by Pierre-Auguste Renoir\n- The Music Lesson, by Johannes Vermeer\n- Starry Night Over the Rh\u00f4ne, by Vincent van Gogh\n- Four Seasons in One Head, at and by Giuseppe Arcimboldo\n- In the Loge, by Mary Cassatt\n... and more\n\nHere you have a nice gallery environment setup with the statue of a horse in the middle, as an extra you can see how the AI animate the paintings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24369090916107752"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823893_1160737622567292_2994850172936559002_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK-OzCv3j6wQ7kNvwG8x-JH&_nc_oc=AdlEFm1DY2iIOPqtvclquEmS7ednYlzwwDz49gL1Udmq4EHLagbHd9IM32aMQohZfA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyKoq2xlca8pLuffNoPTkQie0bTL18sIWBPqnwirhYZ-A&oe=69B7EA99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
_600564392391639_7288485845414629543_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsLgPegT3L4Q7kNvwFTiFe7&_nc_oc=AdnE4IJJBEeMTYAwpynSjEFdu-EdfdysBnmk2LVm1LWNyCbqR-Bc_3jsD9vOtr0h5f0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzy69715m36ajIZWQtzPmu-Sc9r7Y_bY9QlN5h3B-4f3Q&oe=69BA9DAB"}, {"file_name": "ScreenShot4.png", "id": "4154069701529765", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499318056_4154069704863098_6437066471974187688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zsdv2yVJPUQ7kNvwE_apjv&_nc_oc=Adn0Xoi1wYoMuKipP8H20aJ98Gl8KRVbk2QcA6t5MdnJY0SbAIbS-zga8_IIJ0lBypc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxA-_m7XDRuzuCFKO4ZmDQnotunjNJcs-0FoFpCdpoXFQ&oe=69BAB208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "4526900444203911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830904_4526900447537244_1593155788570280980_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlmrEwIe2mIQ7kNvwGMmx37&_nc_oc=AdnalLryGhwPcxrSkpamxFhtzIKrFLlkQkyyuk20XprxZ-41YpdLSDtXQ3F_lvL0rfA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzyq2dhpKn7gn3m4QtIpvd-t8_gaEYUZdK3Psxq7EN7iA&oe=69BAA8E6"}, "display_name": "The Historical Art Gallery", "keywords": ["AI", "Gallery", "Art", "Paintings", "History"], "long_description": "The Historical Art Gallery is a collection of famous historical paintings like:\n- The Scream, by Edvard Munch\n- La Promenade, by Pierre-Auguste Renoir\n- The Music Lesson, by Johannes Vermeer\n- Starry Night Over the Rh\u00f4ne, by Vincent van Gogh\n- Four Seasons in One Head, at and by Giuseppe Arcimboldo\n- In the Loge, by Mary Cassatt\n... and more\n\nHere you have a nice gallery environment setup with the statue of a horse in the middle, as an extra you can see how the AI animate the paintings.", "short_description": "The Historical Art Gallery is a collection of famous historical paintings like:\n- The Scream, by Edvard Munch\n- La Promenade, by Pierre-Auguste Renoir\n- The Music Lesson, by Johannes Vermeer\n- Starry Night Over the Rh\u00f4ne, by Vincent van Gogh\n- Four Seasons in One Head, at and by Giuseppe Arcimboldo\n- In the Loge, by Mary Cassatt\n... and more\n\nHere you have a nice gallery environment setup with the statue of a horse in the middle, as an extra you can see how the AI animate the paintings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24369090916107752"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823893_1160737622567292_2994850172936559002_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIdfV4NXHUIQ7kNvwEpJWE1&_nc_oc=Adnbd4awoc_IGVJzJZve4X6hw-4crX4AlMUsp721LkeFH0CNOArgEHCAVCoYBYhaJZk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaRzXHZDbiRf0wLl7FvhgZxjmDoQu115qpJcR6br2-PA&oe=69BA8D99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
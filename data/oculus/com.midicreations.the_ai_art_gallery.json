_600564392391639_7288485845414629543_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AO0FIYnNZkQ7kNvwGPZBFu&_nc_oc=AdkcLOMyq9fYeobrp8xuSH6ZiZMg4QPJ78rWpDdo6JGrJfCBy9YdV4D1X28YTxLJwS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5WLn1MlIdkH9lnsxkJ0HApOjn7piT4jRdzWcUnCiEhA&oe=69B011AB"}, {"file_name": "ScreenShot4.png", "id": "4154069701529765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499318056_4154069704863098_6437066471974187688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56k8nioAm_IQ7kNvwGa1RyX&_nc_oc=AdkNibgZ0jkCc1dHyU7gRzixIn0KMXDINU0s5cSB4ZUGo2BVlB2MzK065mb3QOp_u4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaJR8fd-JdPFtiBBkCDCL91fQLiEnPVHiazKS_y0FC4w&oe=69B02608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "4526900444203911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830904_4526900447537244_1593155788570280980_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FKI6ax__tAQ7kNvwEv-Kbx&_nc_oc=AdkgbRGAghcMJ1ifWrfqzhF51aOLc1-SlSO1sL_V8RDdkK8bZdyEPqHT2ZW_e_Un1Kw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9C960lZxgm0sVsqTYkCAUBQjGonCcuwam3CWQ1aN8UA&oe=69B01CE6"}, "display_name": "The Historical Art Gallery", "keywords": ["AI", "Gallery", "Art", "Paintings", "History"], "long_description": "The Historical Art Gallery is a collection of famous historical paintings like:\n- The Scream, by Edvard Munch\n- La Promenade, by Pierre-Auguste Renoir\n- The Music Lesson, by Johannes Vermeer\n- Starry Night Over the Rh\u00f4ne, by Vincent van Gogh\n- Four Seasons in One Head, at and by Giuseppe Arcimboldo\n- In the Loge, by Mary Cassatt\n... and more\n\nHere you have a nice gallery environment setup with the statue of a horse in the middle, as an extra you can see how the AI animate the paintings.", "short_description": "The Historical Art Gallery is a collection of famous historical paintings like:\n- The Scream, by Edvard Munch\n- La Promenade, by Pierre-Auguste Renoir\n- The Music Lesson, by Johannes Vermeer\n- Starry Night Over the Rh\u00f4ne, by Vincent van Gogh\n- Four Seasons in One Head, at and by Giuseppe Arcimboldo\n- In the Loge, by Mary Cassatt\n... and more\n\nHere you have a nice gallery environment setup with the statue of a horse in the middle, as an extra you can see how the AI animate the paintings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24369090916107752"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823893_1160737622567292_2994850172936559002_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHJMQK4HQckQ7kNvwE8wdLD&_nc_oc=Adk6BSOsBovgcloXaZN7mqgXKsQ9PhBfgoci69A9wL4QFWsptinE4EN_skJYIkqhNp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrX3aXK-ZBVe8MY2c5dhAac6A93IBftJA-a2qtiGyolQ&oe=69B00199"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
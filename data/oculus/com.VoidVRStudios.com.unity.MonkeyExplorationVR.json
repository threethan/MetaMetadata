z0GuwT_4EQeyZ2iUp1GLV7HtiRw&oe=699AE955"}, "display_name": "Monkey Exploration", "keywords": [], "long_description": "Monkey Exploration is a multiplayer VR game for Meta Quest 2/3 or pro. There are multiple maps to explore being the main map Forest! The best part is there is a custom username system and custom server system. Explore the map's with friends in this hangout like game! This game is heavily inspired by Gorilla Tag. \n\nThis game is not affiliated with Gorilla Tag or Another Axiom LLC and is not endorsed or otherwise sponsored by Another Axiom or with any other game.", "short_description": "This game has unique locomotion where you play as a monkey and run around with friends or alone. What more would you need other then to be a free monkey in a big open free world!?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/darkvoid60/Monkey-Exploration-Privacy/refs/heads/main/Monkey%20Exploration%20Privacy%20Policy", "developer_terms_of_service_url": null, "publisher_name": "VoidVRStudios", "support_website_url": null, "website_url": "https://www.tiktok.com/@monkeyexploration", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8322210731148638"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982440_552343307669218_7736402954170405622_n.png?s
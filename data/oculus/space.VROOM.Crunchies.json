dn.com&_nc_ss=8&oh=00_Afzozf_3_wthZjqw0Cqfsq_9YZh01p1Iy-SEQQfZU357Kg&oe=69B9605E"}, {"file_name": "Screenshot (3).png", "id": "899000051007330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974572_899000054340663_4009189873311578622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJJkHmzI6lYQ7kNvwG4J1XM&_nc_oc=AdkdH65YXB-W4YJAvbo0oT1rByyQwRz6C5Rifm4CEbG1__px8Oikb8J-3uA7ZEMuEZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXuG9_HFBDNhC0t6J7XrGCznr5-Tpk8xb_PIl8uVHkIA&oe=69B948E7"}, {"file_name": "Screenshot (1).png", "id": "456576609187076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294240_456576612520409_2527700674419884251_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9_n9806kt0Q7kNvwEzA1NV&_nc_oc=Adn306J2HSVdmlxjZH6Ok0zprszpr_UwZE6xVXZ3HPZK1xf13Ob_eWs_EAGg2QRmIOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWExhbhsqvtAsHp9K4UO4UdlqPVMbXqXHYBzAUJAIEdA&oe=69B9527E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt Landscape.png", "id": "974255020135169", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982595_974255023468502_7456919079283731752_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz04KNWvj14Q7kNvwFT5NcP&_nc_oc=AdkJMKht11iAVGk1n1e3NyWvu1nwlqbaVW_mZAMT77JWH7heMpy2qj_hVEm-kAzWwEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzINLb_CR2_6hREKqURPfBUFsbkMdw-v9O1XO-I338nyQ&oe=69B94948"}, "display_name": "Crunchies", "keywords": [], "long_description": "Fight to survive a zombie apocalypse: with a tank!  Experience the action-packed storyline with M4A3 Sherman \"Cherry Bomb\" and her stalwart crew.  Vaporize hordes of enemies with cannon-fire or crush them beneath steel treads!  A colorful cast of characters bring the adventure to life.\n\nCrunchies is an epic action-packed battle for survival aboard a restored Sherman tank as Hank and his crew struggle to survive a zombie apocalypse.\n\nKey Features:\n- Annihilate massive enemy hordes with superior firepower!\n- 16 exciting open environments to explore, chock-full of destructible objects!\n- Simplified controls: thumbstick drives, point to aim, trigger/grip fire cannon/machinegun.\n- Graphics that maximize your Quest's potential, plus tweakable settings for future headsets.\n- 4 levels of difficulty offer great replay value.\n", "short_description": "Fight to survive a zombie apocalypse: with a tank!  Experience the action-packed storyline with M4A3 Sherman \"Cherry Bomb\" and her stalwart crew.  Vaporize hordes of enemies with cannon-fire or crush them beneath steel treads!  A colorful cast of characters bring the adventure to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crunchies.space/crunchies/privacy.aspx", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": "https://crunchies.space/", "website_url": "https://crunchies.space/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "292393016380483"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "950664784097788"}, {"status": "PUBLISHED", "id": "1442062450820741"}, {"status": "PUBLISHED", "id": "1586984699396187"}, {"status": "PUBLISHED", "id": "1275702950992348"}, {"status": "PUBLISHED", "id": "654906760986548"}, {"status": "PUBL
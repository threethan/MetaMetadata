&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afva1pE4RWywyW839L7nz4JLflURNCUCO0CnZQHV5zK2Cg&oe=69A18A51"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F_nljPraEEQ7kNvwEXhGp3&_nc_oc=Adla_bYfjHIb32lXuBWMo2STAXs4ls2E6Fj5Mp0yDt-8dds4WtXrcNvCRgdOKErLDPs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuHZJ2QxxvzCIu1id9LuEhWETRWRkYoJbrYIxkmkiMMjg&oe=69A1832B"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf-AG6VgnosQ7kNvwFG4cZB&_nc_oc=AdmntDmYjt4q9T1vxsahHY9SpK68SAzpvQ5YzhZMMA6Z-rc7NGbwGl6GEAdWak-_uIU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuUfG55uhN9P03xLb-pHUJPMYUBC19k7Lk9NKxPt5F3zQ&oe=69A195E7"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hJOYM07zI0Q7kNvwGWGSw3&_nc_oc=AdkPqV5lW6_qd36pMWUyu7QZGCMCQI-VH8AevWB2ygpvaBqp2ZOoCzqAZCOaq-AoE2g&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu5URFM0LkgCbbO1oJ70OkHOYulv6XrDdo0xAoNAokE4g&oe=69A1816A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UdGTdOn1CwQ7kNvwEEKLaz&_nc_oc=Adlpmi_d5g-smkQV5eDx8an-6TeKxPrR5ZROorvigiQm_yW8S3HeCNyWY6T811vLSag&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvAVsTIb4G258D1MzP7dAEngi3-9dz25fu7tznB9YS07Q&oe=69A19221"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
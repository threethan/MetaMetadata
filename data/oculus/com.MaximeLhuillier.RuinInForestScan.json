&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9oreFxbmF1jP0c3PF5cwOQINW0E6x4V_BMDou-J7lKg&oe=69A6D051"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsPYksx1U1AQ7kNvwEietKD&_nc_oc=AdkqNufx15kZhkPGOnYCuhguvkvwSTi62MiyQv0LZcKeEIuxYrE-3JEuLhk4_nQCdRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvggAG9SLU7AHyPv_A82mHtM6qWoGWEdc6bKUXk4qfsgQ&oe=69A6C92B"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l62a3o-1iSwQ7kNvwF4Azqr&_nc_oc=AdnqrhqCFpFXq2l7Hfecj1pOKf44zSfJpnv6dtgDgenBK2ekQsTbNg94YCQtwklry_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftqJQH7Da3KUV1P7R5zUihuBJpWoQ4y1iFNMvVC7f0vTg&oe=69A6DBE7"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX2ZyRAcCv4Q7kNvwFtegqD&_nc_oc=AdlsR7G21mcYlVeK1INz2fPRKrRrhRM9huN0SBBy_Dc44g3GAft3RfsuVOjEic78ylc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9TyZaUcBHXXg6mNbox-8ZCTlAWSjFXn3IYbjahS6nhw&oe=69A6C76A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5fIdQFT_P4Q7kNvwHfUWIF&_nc_oc=AdkKStEbPbvAyDC1d6-CJj148f3m0JFM9M9y1MY9Ddr9ggfdBUbB-sy5h6KEqHlUdkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuoPAjxnYHII1_3h4VX_PqBspavZRkucZM8mG-56yUNyQ&oe=69A6D821"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
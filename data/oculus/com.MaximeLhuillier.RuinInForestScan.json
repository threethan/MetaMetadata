&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCYsG7c6iaxTKAHFwh9PDsCGwRzgp9Pa7lv19JbgKjDg&oe=6999A151"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCxccXWvhPcQ7kNvwH8Uk6T&_nc_oc=AdkObBeFE7sQCRFJwf-5TUcNJdSvHUwD9Q349nEPkt-PqETcKxYWJFK6l9INjZjDicU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveauunDLlNhnx_ElnTjSK5aulit5ohWeUq4pV5DPsUiA&oe=69999A2B"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e06oF3jdkwUQ7kNvwGMGesz&_nc_oc=AdmUiI9L8dpLR4e3nL-0oZI9NnH9soLkrOwVZPp35Iy4JShO47ci0VmCOpTJfq6h1uE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupTumwfa13JXtuHNAdd4IUEUlK-eThGdUk6HcYGiItpQ&oe=6999ACE7"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5hH8t2awssQ7kNvwFujAE8&_nc_oc=Adm7jl1QKdSthvyFFHiXoLSZInZ8K_Tm6MuOFEMejYCa-jFK3C3Q_N-a6kXWvOLeUy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvNUUTVY-6t4osv7xZiQXjveGgx4FO8ECPiEf6ohee95A&oe=6999986A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98NuzmQ6PtgQ7kNvwG4TMG6&_nc_oc=AdlPOOTr6HW3amvReuyiy-hbgTp_r8_VFGCyYrfLVMY1d3Pl3pLVbN9mzpHrA2YqQV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsTFeCKbspa14pY5I7PTxRvzgyoHnBu3b-3C92_ovAk2Q&oe=6999A921"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
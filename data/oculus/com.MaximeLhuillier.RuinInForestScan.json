1.png", "id": "790462812150344", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_790462815483677_5380930595172148371_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C2FPK5dk8AQ7kNvwGEVrtq&_nc_oc=AdrPAzVerpkRM1smVBBDQDYzYHymyP_-0P38HfwNVuQHKVdtdKkn0FhSGuxUfeqIVxE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTu_NgpPFRXblozM93zor4P1PhD0xiTODNq98FLLR-lA&oe=6A7DB4D1"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMkyr4MOixYQ7kNvwHV8Xsh&_nc_oc=Adrw7dOx1rB6vIPVVsIhPI8MdTGI1hKde0CDOlX9uAxCvJEtowVGnhD4axXKc_IDwZk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4--NlugbHsFuhiYlXQcp72pvaFo9U05CPNcgjGbOxKA&oe=6A7DADAB"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI3aGIUY-5wQ7kNvwGMuP7d&_nc_oc=AdpI_Q-jxEXg3fkQ1MzGpfI5K-LTo5CfLgmnfCTOJ5S0DYKzZJfrjX-Oxsrrr6dM2wY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpPkAZF72TRarSuHSgh1n0zouzBpymiWJp_-sqZcVmpg&oe=6A7DC067"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6YDBsAY37QQ7kNvwF2BYF9&_nc_oc=AdrwCpaF1n2CzfMWWgD3BKRns-pfGKfLR_3-nxc2xPu7bHEWSZBeaCI8tBd-W99HL3A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELqPGDPEMZqsd1zCYQD5zqbvyw0Y9e4KLO9crpCYjZjw&oe=6A7DABEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc4UFiyXL_QQ7kNvwFojR3K&_nc_oc=AdoKX-UjRBgnz1_vAdIvhEHzdYUlfIsdpkLiJ-Dnh1XohP4aM26ijXaE76vkbuhyZRU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOW81PzNhqu75jheOe5rg5A3N-B_uxY4-orwRUhDI8yQ&oe=6A7DBCA1"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
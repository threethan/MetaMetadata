31458_790462815483677_5380930595172148371_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWI3v6omoOcQ7kNvwGDtW7h&_nc_oc=Adn-oxz05ygJV-S4WwR_PZi2j52Jt6zvVx5lnoE62fiC3lhIzfiPF8poBaQBrlKp_qg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvoZ1j5BOD1GSt7mTUki7rqOMS5dtDFluQ35xb3HR0oWQ&oe=69A821D1"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsPYksx1U1AQ7kNvwGxFZl1&_nc_oc=AdmBZ-9Dn43iOoPnrxub3WcunfMXLJ0OznOn62Dbm4M9SIaoye64hnS61TFl0FN1Wvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuyh--gjbGbut7se98FhmCimGLb97BmiIDBigd3iQ1WKQ&oe=69A81AAB"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l62a3o-1iSwQ7kNvwHuwn9d&_nc_oc=AdkSfFSD7v0zBAAlwiGkNCbttAZSCb74E31Ky5MjnhfbXT0EseCGZIY-l86A_1ccFqE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvehRdoxJHdZ1_bgvs_4IXqUdVZ8ZCjBs8Vepnvu3PQ0w&oe=69A82D67"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5I7NdIrxOIQ7kNvwFxFhM_&_nc_oc=AdnLMch0O0VRWJlajIhPqoQPDJ-2kZwloijnMcA8YYjK49_oCxOh3OJ53rgzuA3HDrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuNCCU9IJXRNHLxo12U4njizm87xYHVctXVGP4XElQLEg&oe=69A818EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGuMMZC6z8sQ7kNvwHg74kR&_nc_oc=Adn8oDnm8SX_Q2t0aMnbb7T4og6R2-WpzFChfnO75vg9AQ_qmsVvzKOR1DmV32ceBFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftFQlkuS8a-4maiXNK9fKfsAjjsXzuHUaYr9NRsHwj48Q&oe=69A829A1"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIR
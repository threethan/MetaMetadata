1.png", "id": "790462812150344", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_790462815483677_5380930595172148371_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbdpd0sFG6sQ7kNvwHXD0dr&_nc_oc=AdoFKhqRWRTUv9LkheHlwKtL93hXdTnTyTlXp_PIr2pQTBG9PDfKhsSlR_AUcseqRGw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYebGWzvpdeWgPWK4x-IEhE39F6mut4qp0dkkzcYTntg&oe=6AA93651"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVpsHH-CeiQQ7kNvwFTfB-g&_nc_oc=AdqRujf7h5Sn_JlOnYbtm9OAYBycG0bIJSTgrM8ijCrj0aLxAjWi6-5zpBeQ6VoCYYs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiUYKoj7REypXPRMLlN3GnCrbV8uoCIG8J2fZvN5lkWQ&oe=6AA9676B"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1JCuj_hsmkQ7kNvwHymAzm&_nc_oc=AdplELniE9A5Qa8IrYwQ895UDMsF9EojfPpcpTUhjy82gx1VG7AhqGOpgnKjhieDSJo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9kCG1XDQZtUiTQtGvQ_ZnIbh5RSIpABPPCc1XQRom3Q&oe=6AA941E7"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVbXDN5LOQgQ7kNvwFmZckY&_nc_oc=AdokII1QmuvQzAbJvIAIn1oGvQhA0Sa43XxBc-LBaGA8pMM3H4wjrY7YjhmsIuQ8uW4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGQKfNAH_i0qoT0-A-RFXH9ssTgo7Fky8Qvpmm7EznfA&oe=6AA965AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF5YXwbiv6IQ7kNvwFRCT9y&_nc_oc=Ado1UI9-RS4yTa6M2TiJD9CQ1ULZ_QnR034yu9_FBdNovnK8OvUfqmrGLC5GRzASDwU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU8-sY9Sj6tBhKHnyxxd5O7k4kqq1PkL2fWX-VFos1uw&oe=6AA93E21"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
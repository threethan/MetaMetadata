31458_790462815483677_5380930595172148371_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai6TcTBKJpwQ7kNvwEuqWQQ&_nc_oc=AdnBTiktWZOGzyP8v3fkRoeA1anK6hJqr5MGzscI6Bfua1I-nMz6ltqTR0kOHxe2LJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUHIZP9ATwUZl4qpT8ZeP2cE1P-TQJEGDF495ZRzUQ2A&oe=69AEB951"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db7936VLSZcQ7kNvwHoXtjU&_nc_oc=AdmNckeKMzxX6YMnfu1jui7zPe6tUeHBLrhHWWX07KXN-wBAXJTxg2mE6kRGGlPOH_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afznq4Kw1OOPB62yBeAj_wTc6yAgQauc00TaShjHPZnAEw&oe=69AEB22B"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaldMMtvWBQQ7kNvwHST2AL&_nc_oc=AdmvRVGIcVtftQlz_zESeYmuDeAY85QCfnDTnYeMXOtgbei0tBWT7q0_A112bJqhIb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfweAHxr1pncFw0dFNpUb4hZt1WpL5apKrQ-p0hlwfex8Q&oe=69AEC4E7"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ztdkb9r14MQ7kNvwFq6OER&_nc_oc=Adlz4yRhsUsEb4VaNxYaamryJJJjAtvfKJQ3wpkUzwQP1HJEzJT8ylnF7CWp1WOrx4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsezvQoC4yV-omCzMHyFXJVUHvmewRENsAe79_pusAZg&oe=69AEB06A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx9PN6oPDfQQ7kNvwHqgtVV&_nc_oc=Adloq13D74F6QMorPBtK5gDimbi5obFvzQ7OZmnBEYaok9_ROxBBBUVsdb5YVfRZkBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfweWg5ofhKHEjZeXbIeFGvL1aJWaafnYIJmFwqcEtuQGQ&oe=69AEC121"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIR
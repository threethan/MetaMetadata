1.png", "id": "790462812150344", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_790462815483677_5380930595172148371_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNmN43_At5YQ7kNvwGqsKfP&_nc_oc=AdqKOcXBWbkR_QORJmlYgY6d0CwmUaGdLKdh5WTTctnADcKL2Cur91NhKlu7832LgB8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78rSR6oagE1s-XZLIWN8BbW7elPBYOAI9Bc5TQ9FYq5w&oe=6A1199D1"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H32zbjln7woQ7kNvwH_4_12&_nc_oc=AdqYoN5eTINWjXakJwev2kdtw7ApudkvpsB1jCMi4K7V3HHYO_e4wuzfoBgn8A1Xv40&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TS9Q9jqquLgiNBey5UsOm9VQVX9tsYTUf4-hFOvpyYQ&oe=6A11CAEB"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WG-h_TzuawQ7kNvwEmKUFs&_nc_oc=AdpfXaL9s_datORha4ArMkMwIzJfeNaM8H_SYpMZKbDiLDHw5BfOQlrpxjvIV9gllCE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EjPSHkhK2fU45B05G3ohZPuGpUSPOkgJ74YgQe8qQQg&oe=6A11A567"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10JmSCQKkY4Q7kNvwFunIsh&_nc_oc=AdoCi6whXymyAWXNm0RwnNThoWOmP3ii5_inW_rgNXzWMLak9g1ipLAUBUU1Iodrj7c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4owURzBk5beKbT-Kide_e6ENJvcScgAF3ifAJxEq-Frg&oe=6A11C92A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAsuUbglyrcQ7kNvwH-_NEn&_nc_oc=Adp_reqGvZvaTYeO86PD4BZ75UhGObhIT8ekm2k0kYilgMDz1KEzolXv0KIErkVosqQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Cd7y2AWBWkcUYkJs1IagL8z6O1j10eZzOWiKf9z4mew&oe=6A11A1A1"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
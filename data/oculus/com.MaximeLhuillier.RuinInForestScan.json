31458_790462815483677_5380930595172148371_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai6TcTBKJpwQ7kNvwFouwGP&_nc_oc=Adn7UYjwQWp2Y5F2uhhnVdn0lcodMjGqIfRamxA5DuJsHKRDCQ1Mm4gL8efY7SEH8u4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiJFEJRuu_qDQYybwc4edGU-Y7heLrBMJKBgb5YTsuvQ&oe=69AD67D1"}, {"file_name": "Screenshot2.png", "id": "850077762573200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031634_850077769239866_7313417490599216593_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVz2wf9liqIQ7kNvwE8OX31&_nc_oc=Adk1-7aw-OfjoDcoK63GjEMvIqQlVuAHkYY_KKgMM9GwNKgdLrKs_M5x8x8fr3TNniw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxET5d4aD5m8SoydsWQmXl6fMThm2B5_LXDEQAhhTHVmw&oe=69AD60AB"}, {"file_name": "Screenshot3.png", "id": "1514223109014213", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_1514223119014212_7927654477935769634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLGVWedTW_wQ7kNvwGE1CH8&_nc_oc=AdmsU-c9UICtxdnHmgrP6g9pUr4mm1u7E-3c5qiI3CUG44PMqZvfQANFvCpfuQfGqSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxtjd5GKshGhpCHBV9VRPMTkL3Gfvu81KGCBazYNOOCYw&oe=69AD7367"}, {"file_name": "Screenshot4.png", "id": "1118439258797246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_1118439262130579_1516651612606432838_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ztdkb9r14MQ7kNvwHK1gpp&_nc_oc=AdmFiHDIKet3jG-29IVJUzP0GrCDVytE2owH2LWtijV7nsUeXFjy8Aw7my9J0BCv1m0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDeK6VdWGS4w53G14s00buGAqSfeaOp-GdI636anQGCA&oe=69AD5EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3147257625535224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_3147257628868557_5914689202831265680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx9PN6oPDfQQ7kNvwGmOMsN&_nc_oc=AdnL56XNkEM6m_koWpAxjmH4KfkEfRgdRfKeBLcxXKjl2RhtoMOPx17QBYo62gR8D78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCw4GJqxweM3v5GB4ckAIByMAVRsi8nRUp6NV1Fyiwgw&oe=69AD6FA1"}, "display_name": "3D scan of a ruin in a forest", "keywords": [], "long_description": "Move like a pedestrian in a ruin surrounded by a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 400m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a ruin surrounded by a forest, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 400 meters."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIR
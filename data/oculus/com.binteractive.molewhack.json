//scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620341_2235703933881991_7552852076413509773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0fcesiVCQ8Q7kNvwEuBn-7&_nc_oc=AdoyH4xOlX9QXPDM7eveqmqC99U2OREN8mqpwAoa2t9gHZxJj7ZxE5OEkjFgtlfP9Hs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYzt00pJySN-AcZNjht0yPl3ZDptW75oyOXnTMSqIYvQ&oe=6AF74551"}, {"file_name": "screenshot-3_2560x1440.png", "id": "2003354047030751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593727470_2003354050364084_4342464465803460337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjWOyffS4mkQ7kNvwGpwhEY&_nc_oc=AdrrmoKfkkjpQtdQjzPCizFeQn1D7gkU6DeVVwy58JAkJySYJoDZhokKehO2g1wJveI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTei24OkcW5vh741fqtA-GQtOkyY0a3jS-u-g88VvPNAg&oe=6AF72D54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOLE WHACK", "keywords": ["arcade", "mole", "reflex", "casual", "reaction"], "long_description": "Nine holes in an open field. One mallet. Moles that get faster every second you last.\n\nMOLE WHACK is a physical arcade game built for room-scale swinging. Moles rise out of the grass in front of you and you knock them back down using your actual arm. Build a streak for bonus points, and think twice before swinging at a gold one, because those cost you.\n\nFOUR WAYS TO PLAY\n\nCLASSIC - Sixty seconds. The pace climbs the longer you last, so the final ten seconds are a blur.\n\nSURVIVAL - No clock. Three lives. The moles keep speeding up until you miss three, and you will.\n\nSEQUENCE - Watch the order they pop, then whack it back from memory. Starts easy. Does not stay easy.\n\nPRECISION - Fewer moles, but the window to hit each one keeps shrinking. Hit early for a perfect bonus.\n\n\n\n\n", "short_description": "Moles pop up, you swing. MOLE WHACK is a physical arcade game for room scale play: knock the moles back down , build a streak for bonus points, and think twice before swinging at a gold ones. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mallet-memory-whack.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "B Interactive", "support_website_url": null, "website_url": "https://mallet-memory-whack.vercel.app/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329822426871997"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623131_1901658304545273_1059698771656410011_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsoBxtPFNiQQ7kNvwHcb8OB&_nc_oc=AdpfKACfP23so2XRAyDKqMbUjHpSP3DZWbMXOu2amscw9aZmH5WUYIlAV188MgWwj1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwCkNEmmJFpy9cbtN5gs_KDp4KDqhOCsA6PCZccfTdnA&oe=6AF71B64"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MOLE WHACK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1789885980, "lastRevision": {"nodes": [{"id": "1329822453538661", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id
_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQugxZZUZL5IwS1sde4noRukBa1zWZvTPl1U0TDQTixFg&oe=6AFC79A8"}, {"file_name": "screenshot-2_2560x1440.png", "id": "2235703930548658", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620341_2235703933881991_7552852076413509773_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM9DhqIYuW4Q7kNvwGGVDFt&_nc_oc=Adrpmkg9N7IboYgGUqVxDfzebFLUAKd6Hd-WjQBCb6ouIECAxikGR8G7DDPgI807cPM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKXpSqdl-RD05qoL3RVjeYjPQlL3qEB0GUETX8abyYaw&oe=6AFC8B51"}, {"file_name": "screenshot-3_2560x1440.png", "id": "2003354047030751", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593727470_2003354050364084_4342464465803460337_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewylMPMJrVoQ7kNvwEhSVEI&_nc_oc=Ado3s3I2hKR6R0BiN8uybSB87BMfqPN6i1lsCXd6VetIPUdUcnbIdtNH1lfrrOYfO5U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR0GyeN0jJJ2W0RtAvLuGybpEhLof3Uzc3YUHZMl4wQw&oe=6AFC7354"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOLE WHACK", "keywords": ["arcade", "mole", "reflex", "casual", "reaction"], "long_description": "Nine holes in an open field. One mallet. Moles that get faster every second you last.\n\nMOLE WHACK is a physical arcade game built for room-scale swinging. Moles rise out of the grass in front of you and you knock them back down using your actual arm. Build a streak for bonus points, and think twice before swinging at a gold one, because those cost you.\n\nFOUR WAYS TO PLAY\n\nCLASSIC - Sixty seconds. The pace climbs the longer you last, so the final ten seconds are a blur.\n\nSURVIVAL - No clock. Three lives. The moles keep speeding up until you miss three, and you will.\n\nSEQUENCE - Watch the order they pop, then whack it back from memory. Starts easy. Does not stay easy.\n\nPRECISION - Fewer moles, but the window to hit each one keeps shrinking. Hit early for a perfect bonus.\n\n\n\n\n", "short_description": "Moles pop up, you swing. MOLE WHACK is a physical arcade game for room scale play: knock the moles back down , build a streak for bonus points, and think twice before swinging at a gold ones. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mallet-memory-whack.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "B Interactive", "support_website_url": null, "website_url": "https://mallet-memory-whack.vercel.app/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329822426871997"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1901658304545273_1059698771656410011_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XzQ_Q7j3I0Q7kNvwHYobnL&_nc_oc=AdqHI6viI-ptXB1AIz0r6_rXLkZoi2mIqq3y1QSSqlnrJ1X0Us5JgR6v5al9SYpn4xc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfYOROmBDHh7gYQPR5kLUQDEms1DTW-Tj0_EKb3mKrUQ&oe=6AFC6164"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MOLE WHACK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id"
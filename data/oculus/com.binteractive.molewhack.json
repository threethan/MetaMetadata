tent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSfO4RHP7irnB83imwXtqehhOIi6nISyCkpk9B5tsUwA&oe=6AF33F28"}, {"file_name": "screenshot-2_2560x1440.png", "id": "2235703930548658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620341_2235703933881991_7552852076413509773_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oS4mdZbX63UQ7kNvwGO_inQ&_nc_oc=AdrPurFD_xty4gWggJsdV17Kv4JswKDBwxVILj9xOs756tiBJQ7HlT10C_GhTCVoPow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrI30w10L0eN3rzxAlIsGFcpuucQeTFQEfjOEyZebcRg&oe=6AF350D1"}, {"file_name": "screenshot-3_2560x1440.png", "id": "2003354047030751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593727470_2003354050364084_4342464465803460337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzukvfEibbQQ7kNvwFf0-o2&_nc_oc=Adrjx9pEXVXK3-FFPOpTBRmkxcLERqtyzcqbfiiL81JoG-anX5avAeo_rdxfsQ0LEWo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5fGfsKvymAMcYXOu9AbyvP4rluwNNJS0i96od_IfqdA&oe=6AF338D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOLE WHACK", "keywords": ["arcade", "mole", "reflex", "casual", "reaction"], "long_description": "Nine holes in an open field. One mallet. Moles that get faster every second you last.\n\nMOLE WHACK is a physical arcade game built for room-scale swinging. Moles rise out of the grass in front of you and you knock them back down using your actual arm. Build a streak for bonus points, and think twice before swinging at a gold one, because those cost you.\n\nFOUR WAYS TO PLAY\n\nCLASSIC - Sixty seconds. The pace climbs the longer you last, so the final ten seconds are a blur.\n\nSURVIVAL - No clock. Three lives. The moles keep speeding up until you miss three, and you will.\n\nSEQUENCE - Watch the order they pop, then whack it back from memory. Starts easy. Does not stay easy.\n\nPRECISION - Fewer moles, but the window to hit each one keeps shrinking. Hit early for a perfect bonus.\n\n\n\n\n", "short_description": "Moles pop up, you swing. MOLE WHACK is a physical arcade game for room scale play: knock the moles back down , build a streak for bonus points, and think twice before swinging at a gold ones. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mallet-memory-whack.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "B Interactive", "support_website_url": null, "website_url": "https://mallet-memory-whack.vercel.app/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329822426871997"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "957608330681688"}]}, "baseline_offer": {"id": "957608330681688"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789885980, "status": "PUBLISHED", "id": "957608330681688"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1380195201834719", "version": "1.0"}, "id": "1130564855967882", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1329822386872001", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1380195201834719
nSwsHu1kfFH0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0S_sXwI1IQJHpYtHsnP29nUjrgJ9Jjm6XUX3zriDAaA&oe=6AFB1E5E"}, {"file_name": "Screenshot_5.png", "id": "806769075231799", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312468_806769078565132_6108277719092692767_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pArhoGPP0D8Q7kNvwEyawcV&_nc_oc=AdpQN8wVg6RynXY324XoOUW2sMrt9-rewwZSXm3qJxidg6gnqXQSO6EdlAGkdut6IwA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiJE1UsLeRpWnCQOGk8YFrwszRin3ItKdrr08ULM-niQ&oe=6AFB25A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Little_Critters_Cover_Landscape.png", "id": "1426039428500947", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823943_1426039431834280_883285712082441530_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fy8R1LFccUkQ7kNvwFp8cQf&_nc_oc=Adp6fPSEglVyZs0Og2sJTprPKwD1kpoFFnf-TtoMJ5D7XAQLbns-hkVqLHAkKqMqyhQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWOA7Wx3i1R823Ylo1XHKl8T9C6RQzUrPTPpEvU-d1CA&oe=6AFB1E31"}, "display_name": "Little Critters", "keywords": ["funny", "mixed", "physics", "tactics", "defense"], "long_description": "# \ud83d\udc7eLITTLE CRITTERS ARE COMING!\ud83d\udc7e\n\n**Made for Mixed Reality | Action-Strategy** \n\nUse super smart traps to fortify your room and turn it into a fun critter-smashing zone!\n\n**Key features:**\n\n\ud83d\udc7e Put virtual traps on your real-world furniture or on the ceiling, walls, or floor. Try out new ideas and strategies to win!\n{24655217314130503}\n\n\ud83d\udc7e Hands-on action lets you pick up critters, throw or squash them. Just be careful, they can bite fingers!\n{780013338287405}\n\n\ud83d\udc7e Discover new critter types and unlock new traps and weapons as you navigate through tougher waves of difficulty.\n{1894312964837882}\n\n\ud83d\udc7e Arm yourself with a slingshot to help with your defenses.\n{569182606257134}\n\n\ud83d\udc7e Your high-tech robot buddy guides you through your critter pest-control problem!\n{1499134001287397}\n\n**Little Critters adapts to different room shapes & sizes. For the best experience play with a space of at least 2m x 2m.**", "short_description": "\ud83d\udc7e LITTLE CRITTERS ARE COMING! \ud83d\udc7e\nMade for Mixed Reality | Action-Strategy\n\nUse super smart traps to fortify your room and turn it into a fun critter-smashing zone!\n\nKey features:\n\ud83d\udc7e Put virtual traps on your real-world furniture or on the ceiling, walls, or floor.\n\ud83d\udc7e Hands-on action lets you pick up critters, throw or squash them. Just be careful, they can bite fingers!\n\ud83d\udc7e Discover new critter types and unlock new traps and weapons as you navigate through tougher waves of difficulty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.purpleyonder.com/little-critters-privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "Purple Yonder", "support_website_url": "https://www.purpleyonder.com/#contact", "website_url": "https://www.purpleyonder.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1990104051447093"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24661502966850294"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id
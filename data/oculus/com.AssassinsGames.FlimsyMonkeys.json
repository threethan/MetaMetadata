CJV3Q-So0z2PGOl2zOxPOpg&oe=699B1617"}, {"file_name": "SampleScene_Custom..._16.02.2025_14-01-50.png", "id": "1257236688712273", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1257236692045606_3689956386574996378_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fo0VwyYffGAQ7kNvwE5p6UX&_nc_oc=AdknCUUsGbTNdtlwg2jfBm5r55TdHVIAWppZNdv6JOJ_iE-mSEhO_UTFIjrelUPr9C4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftzOAbSeNgB5ZZvhsJJq_HYeeGVFGbClIP4mb9gVje-rQ&oe=699AE375"}, {"file_name": "SampleScene_Custom..._16.02.2025_14-03-08.png", "id": "546023541824590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393415_546023545157923_206989428593316841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFT_fzOlwA0Q7kNvwH_pWee&_nc_oc=AdmRZTBhhpBFJrVyUBL6QCtUEdQJtsbaoHruiu0RD8N9TlcVYZbuls3uyUXm_qRXy7Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfumPfwTD5kZnVoroCxeWMF5E3UaLsUIid7jRm8WUpNefg&oe=699ADEC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flimsy Monkeys", "keywords": ["Multiplayer"], "long_description": "Flimsy Monkeys is a thrilling VR game where you navigate through dynamic maps using only your hands. In this game there are multiple maps you can play and more maps to come. There are also multiple cosmetics you can get for a certain amount of in game currency. There are also limited cosmetics every holiday. Don't break any rules or the monkeys from the vents will get you! So, what are you waiting for hop into Flimsy Monkeys make friends and have fun!", "short_description": "Welcome to Flimsy Monkeys, in this vr game you are a monkey who can travel different maps, have fun, make new friends, buy cool cosmetics. So, what are you waiting for download Flimsy Monkeys on applab now!"}]}, "developer_name": "Assassin", "developer_privacy_policy_url": "https://www.termsfeed.com/live/f83d9537-8478-45ea-b0de-bdefbafd84f6", "developer_terms_of_service_url": null, "publisher_name": "Assassin", "support_web
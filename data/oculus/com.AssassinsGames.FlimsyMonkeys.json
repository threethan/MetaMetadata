 for hop into Flimsy Monkeys make friends and have fun!", "short_description": "Welcome to Flimsy Monkeys, in this vr game you are a monkey who can travel different maps, have fun, make new friends, buy cool cosmetics. So, what are you waiting for download Flimsy Monkeys on applab now!"}]}, "developer_name": "Assassin", "developer_privacy_policy_url": "https://www.termsfeed.com/live/f83d9537-8478-45ea-b0de-bdefbafd84f6", "developer_terms_of_service_url": null, "publisher_name": "Assassin", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vT2MfwPxVoYsP1_dp98W4OTfh3U0r82mvb0SFmeMBMR-j4ITRHLK8GpBbUmXnlRrbmxaEgmqOqHeFG9/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23990703090530183"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24209878741945949", "version": ".003"}, "id": "1064569178730302", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9517304244963308", "is_conce
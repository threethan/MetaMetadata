 {"file_name": "EA3.png", "id": "404854148481802", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031339_404854151815135_4156022429818070451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWLq8zhGJTkQ7kNvwHLjgTg&_nc_oc=AdmG5ey7IMaOaNY5J5kDORx7B6Gqf7rPxghlG_gybBWXXiowv5fRt7nOkMIdZj834QM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCyDL4k19WK5HVRyLXaQIRea3fTmqC27zfZH5FN_F27g&oe=69B94B28"}, {"file_name": "EA4.png", "id": "648775333277225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75308615_648775336610558_3187600010506862349_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FdIEjLunpIQ7kNvwF-y8WA&_nc_oc=AdkKKRP5WW9A2rvDspM8UL0mzcYypA10wUSyO5_aZtpPn1vc2kotb_3wo_kfUd85Qog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuyI3SXQpyOAu6ASqROI3hO1F2qgAeZESl9bl245Ur6g&oe=69B95566"}, {"file_name": "migrated_image.png", "id": "2847504151984584", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982632_604667453397889_6569113966260256768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFjxmY0jd4cQ7kNvwGt3hwu&_nc_oc=AdlAb_lgKOk1njzKAYp8LixlcD_mMfseBvF6EVip_gxE2C8EoC_KW5n6dtAUNG9OKvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxdn4ueuNBIEF-fEJZ8n_oKtSDTqBPZBB6UPkntVpkRUQ&oe=69B94D97"}, {"file_name": "EA6.png", "id": "7953607638047084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_7953607648047083_3724161981674506504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z14Lltmx4IwQ7kNvwGWWxeP&_nc_oc=AdmsAaRrhqd4_vQyTeHtBOCuH4EaPFrzU5hwqSb_I1U27Ha94_6TdW6whYlqkAcJdec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfybKabZnaiSJOh8tVsjNjQQswmSOvx2b1KSUVgoD6wI-A&oe=69B93095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "24865411063078783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830822_24865411076412115_3807794335604918895_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq4lV8oX9cwQ7kNvwF0il5M&_nc_oc=AdluaQqy33iyy1a8_9amJgFRTOnJ450_aaD71yjLk9NakFikei9bKIKcbkNSbIBDdGc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy1fDrZgJbtrdZN6ckr-BFCnmsfd-c3XC8e9fNgzjb6wQ&oe=69B93943"}, "display_name": "Elven Assassin", "keywords": ["bow", "online", "archery", "rpg", "multiplayer"], "long_description": "Is there anything more epic than slaying hordes of orcs and dragons with a bow in Virtual Reality? When nothing comes to your mind, then you probably should try this. If you thought: \"Of course, slaying them with my friends online in co-op mode!\" then this is a matter of destiny.\n\nBECOME AN ELVEN ASSASSIN.\nTake a bow and kill hundreds of enemies that want to get into the elven town and destroy it. As an elven assassin, you will make spectacular shots like long-distance headshots.\n\nPIECE OF CAKE, THEN?\nNot really. The Orcs are running fast, they break into houses to hide from your arrows, and when they get furious, their massive axe is thrown to splash your head into pieces. \n\nASSASSIN UNITED.\nUp to four assassins may unite to defend the town. Communicate using voice chat, but watch your language. \n\nDisclaimer: \nAny similarity to any other fantasy movie, game, or book is purely coincidental.", "short_description": "Take a bow and kill hordes of orcs in the epic castle defense game. You can play alone or unite with other assassins in online co-op mode. PS. Be careful to avoid massive axes thrown at you by orc warriors."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": "https://www.wenklystudio.com/_files/ugd/957014_bb46a3f320c84dc3ac8a4c15f507bf3a.pdf", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/elven-assassin", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "31655206430794365"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824532_1202971485194195_478990717185665978_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI0-z9v4MMMQ7kNvwH_YUar&_nc_oc=AdlG7ywp0w-vxo3sUOBxYme1-kMAkoVQBBiNWrHKGZblKG_cXnaFdw15Lj3UVe0esEY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTCV7XIpiQk3SrkO2Xuy3sSvvcY956iC0NMkFzUPyheQ&oe=69B95DFA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Elven Assassin", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1567702800, "lastRevision": {"nodes": [{"id": "2212066062350137", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2325731427501921", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1091108477668277"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{
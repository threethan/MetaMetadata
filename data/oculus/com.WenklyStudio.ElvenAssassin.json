4"}, {"file_name": "EA3.png", "id": "404854148481802", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031339_404854151815135_4156022429818070451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMmEyWtwHUsQ7kNvwEwakgj&_nc_oc=AdkrxV1msOCSLMwUV-mMEAbM-fDRBNzcDtBRuyPhEPOiYjINXjDmuMS6Gmd60XpCCDw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afxch3NSgUJ26EskynNCGdnXU2kus4ypM1Jp32G766LxQg&oe=69AACAA8"}, {"file_name": "EA4.png", "id": "648775333277225", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75308615_648775336610558_3187600010506862349_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2FFnEVaJdQQ7kNvwH6hpev&_nc_oc=Adk1sx7gjs4vqyc75OkIEFElbXYjOTNK4IPDe1HvwgQtjlDhHuM36jb9OtcU-DGRnMU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBuUanEBeq2u0a61p_i4iY6ey25RKzGSlpPWqcbKdkjw&oe=69AAD4E6"}, {"file_name": "migrated_image.png", "id": "2847504151984584", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982632_604667453397889_6569113966260256768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyteesSiwecQ7kNvwGtFUTL&_nc_oc=AdkreaVkhM8TSsbYzp6zlk1rklwjoYV3syg2khTKktMJrgbumnf-WjGgOBQlLNHD4yU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyA8kBvOU1SZQOhI99sS2IHOW13QfobCW156Y-E0KAoYg&oe=69AACD17"}, {"file_name": "EA6.png", "id": "7953607638047084", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75210889_7953607648047083_3724161981674506504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNPcRGIEqwIQ7kNvwFs3hg1&_nc_oc=AdkUJVezI0WuEbPVntyYDZDZ3JzZRW4cy3ZUYUq7nh4zFQRK8D5Ua8BhIXAZjybV7h0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6d7Br2vMDieCqIPTdLauGs815koW6hhWM8pUTfaMsDA&oe=69AAE855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "24865411063078783", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830822_24865411076412115_3807794335604918895_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3SEyl4NQ9gQ7kNvwGAfiRU&_nc_oc=Adnl3Vcjhi2VLS3MfZNZ9H-7MiJlh6jAX4Lyh6dUM7zM4CINmmTGYWd6NB9R6AReiFM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKRUCzXrAzQqpCLakcljOmhxUl_9BTuZqWL-cC8JPkIg&oe=69AAB8C3"}, "display_name": "Elven Assassin", "keywords": ["bow", "online", "archery", "rpg", "multiplayer"], "long_description": "Is there anything more epic than slaying hordes of orcs and dragons with a bow in Virtual Reality? When nothing comes to your mind, then you probably should try this. If you thought: \"Of course, slaying them with my friends online in co-op mode!\" then this is a matter of destiny.\n\nBECOME AN ELVEN ASSASSIN.\nTake a bow and kill hundreds of enemies that want to get into the elven town and destroy it. As an elven assassin, you will make spectacular shots like long-distance headshots.\n\nPIECE OF CAKE, THEN?\nNot really. The Orcs are running fast, they break into houses to hide from your arrows, and when they get furious, their massive axe is thrown to splash your head into pieces. \n\nASSASSIN UNITED.\nUp to four assassins may unite to defend the town. Communicate using voice chat, but watch your language. \n\nDisclaimer: \nAny similarity to any other fantasy movie, game, or book is purely coincidental.", "short_description": "Take a bow and kill hordes of orcs in the epic castle defense game. You can play alone or unite with other assassins in online co-op mode. PS. Be careful to avoid massive axes thrown at you by orc warriors."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": "https://www.wenklystudio.com/_files/ugd/957014_bb46a3f320c84dc3ac8a4c15f507bf3a.pdf", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/elven-assassin", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
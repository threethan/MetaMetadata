 {"file_name": "EA3.png", "id": "404854148481802", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031339_404854151815135_4156022429818070451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKYEWGRNq-IQ7kNvwFk1kWf&_nc_oc=Adl3krYB6FDB6IA-_1r6evTJeyae0qkytm0q14ACngNhuopf70UTr5nHnwKuxrcPwVg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxp-1uTLmHWUoScIZpB6scdcLspvIbPRlz-7_z8Z_lBFg&oe=69BA9CA8"}, {"file_name": "EA4.png", "id": "648775333277225", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75308615_648775336610558_3187600010506862349_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FdIEjLunpIQ7kNvwHkVtJH&_nc_oc=AdkAjvJk9QmXESkm03ocAKOpA9L2oxG81unFb01T1qO5lJeS7_QTtx1JyoneWrzGYAY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSUC69O-NspMT_ncGIsG3VHYhp3DGBBIoRL2GhIY0TNQ&oe=69BAA6E6"}, {"file_name": "migrated_image.png", "id": "2847504151984584", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982632_604667453397889_6569113966260256768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFjxmY0jd4cQ7kNvwG-Ighj&_nc_oc=Adl0hTdUOPRvQ8pYeTndre5euvILUWuYoP5Enh6fPWoYqvKrUbJBlCHQFJk1GCgd4I4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxW8IOjXtBE1XU2I9V88CYHTEiCwt8qkCqXIj52Z_3Vxg&oe=69BA9F17"}, {"file_name": "EA6.png", "id": "7953607638047084", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_7953607648047083_3724161981674506504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgyiKu0yZ1sQ7kNvwHjAR5e&_nc_oc=AdmUtU2ElAmS4bunuVOTK_X6e3t6OHGDjfRWBEQ8ctuGbNpAt7WhADh_ZSr1YsIfZJk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1nlv3qC5LSRvJOaVKVXwjxw5wxebS_f1tcUpzD9-AuA&oe=69BA8215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "24865411063078783", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830822_24865411076412115_3807794335604918895_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq4lV8oX9cwQ7kNvwGNhssA&_nc_oc=Adl1G_fw3vX6ywKLsCN7D9CovKPJjlxtjM9lpgNcAaqwfTi4greUyjgKe9KcOAzwJnQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUKe04M_pC3LiUKd5JaFwAuS8s3h0xJSTWR8OmYN6YkA&oe=69BA8AC3"}, "display_name": "Elven Assassin", "keywords": ["bow", "online", "archery", "rpg", "multiplayer"], "long_description": "Is there anything more epic than slaying hordes of orcs and dragons with a bow in Virtual Reality? When nothing comes to your mind, then you probably should try this. If you thought: \"Of course, slaying them with my friends online in co-op mode!\" then this is a matter of destiny.\n\nBECOME AN ELVEN ASSASSIN.\nTake a bow and kill hundreds of enemies that want to get into the elven town and destroy it. As an elven assassin, you will make spectacular shots like long-distance headshots.\n\nPIECE OF CAKE, THEN?\nNot really. The Orcs are running fast, they break into houses to hide from your arrows, and when they get furious, their massive axe is thrown to splash your head into pieces. \n\nASSASSIN UNITED.\nUp to four assassins may unite to defend the town. Communicate using voice chat, but watch your language. \n\nDisclaimer: \nAny similarity to any other fantasy movie, game, or book is purely coincidental.", "short_description": "Take a bow and kill hordes of orcs in the epic castle defense game. You can play alone or unite with other assassins in online co-op mode. PS. Be careful to avoid massive axes thrown at you by orc warriors."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": "https://www.wenklystudio.com/_files/ugd/957014_bb46a3f320c84dc3ac8a4c15f507bf3a.pdf", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/elven-assassin", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "31655206430794365"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824532_1202971485194195_478990717185665978_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUL61TSdGLUQ7kNvwEOHOxV&_nc_oc=AdmzS9EKo7q3TeV155NXNaG4k5PNjIRSgKzh93_hTrucAf_j2MRemf6u3e8B8KWK9LQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwTZQn40HgFYr75SVoiBVzXzkdWp3jR8f09NboNNpJsqA&oe=69BAAF7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Elven Assassin", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1567702800, "lastRevision": {"nodes": [{"id": "2212066062350137", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2325731427501921", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1091108477668277"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{
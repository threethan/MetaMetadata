92_8081264121732923392_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNgtons6szEQ7kNvwH73122&_nc_oc=Adq6e5M4Rs1Y21DWYIVs4YHvuDfxhjUHx_2SweGiNMlOtToJeL-mwoxPdtWa3NMmux4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW0CpC2juHYO1eJHbtqbH6dUc1z4FXqrhPCHaDAsEb-Jg&oe=6B0EEE0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/o0xhtJ", "id": "286722842040584", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974628_286722845373917_7750962539462131712_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE8jsWJWVecQ7kNvwGOfrMb&_nc_oc=AdryNb5posGx0o8GiZ2n6d5j1JztCpyWzkck5pDZ25_DRQbRlvPFgUMAUakiK4h7phQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHM-Zp9wpXRkibmcJOl07Qd3nEUSxudwtmLj-0uj4mBQ&oe=6B0F20E7"}, "display_name": "Elven Assassin", "keywords": ["bow", "online", "archery", "touch", "multiplayer"], "long_description": "Is there anything more epic than slaying hordes of orcs and dragons with a bow in Virtual Reality? When nothing comes to your mind, then you probably should try this. If you thought: \"Of course, slaying them with my friends online in co-op mode!\", then this is the matter of destiny.\n\nBECOME AN ELVEN ASSASSIN.\nTake a bow and kill hundreds of enemies that want to get into the elven town and destroy it. As an elven assassin, you will make spectacular shots like long distant headshots.\n\nPIECE OF CAKE THEN?\nNot really.The Orcs are running fast, they break into houses to hide from your arrows, and when they got furious their massive axe is thrown to splash you head into pieces. \n\nASSASSIN UNITED.\nUp to four assassins may unite to defend the town. Communicate using voice chat, but watch your language. \n\nDisclaimer: \nAny similarity to any other fantasy movie, game or book is purely coincidental.", "short_description": "Take a bow and kill hordes of orcs in the epic castle defense game. You can play alone or unite with other assassins in online co-op mode. PS. Be careful to avoid massive axes thrown at you by orc warriors."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wenklystudio.com/legal/privacypolicy/vrgames/PrivacyPolicy-VR_Games.pdf", "developer_terms_of_service_url": null, "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.elven-assassin.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "245419387741835"}}]}, "scheduled_offers": {"count": 51, "nodes": [{"status": "PUBLISHED", "id": "2570535283428691"}, {"status": "PUBLISHED", "id": "1610838163955044"}, {"status": "PUBLISHED", "id": "1300136565605562"}, {"status": "PUBLISHED", "id": "883024258140481"}, {"status": "PUBLISHED", "id": "951667303884602"}, {"status": "PUBLISHED", "id": "2138482430261171"}, {"status": "PUBLISHED", "id": "1139444068100649"}, {"status": "PUBLISHED", "id": "24607900292239708"}, {"status": "PUBLISHED", "id": "747860551456331"}, {"status": "PUBLISHED", "id": "2022952391565546"}, {"status": "PUBLISHED", "id": "1231322031926290"}, {"status": "PUBLISHED", "id": "469520339368943"}, {"status": "PUBLISHED", "id": "1741775906584945"}, {"status": "PUBLISHED", "id": "1306314687015562"}, {"status": "PUBLISHED", "id": "1031913864931613"}, {"sta
.com/v/t64.5771-25/499622344_2210184516148474_1693875823915767132_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlLFGjs_2cwQ7kNvwFXjG--&_nc_oc=AdqF_IBsjgPqk7oUq0bNrLfM8Oc153c4a7VEgcgmocpQg0N7IWxTVLe5spfUpgB_XSA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmUVe55DZE2HoyD_l0hFClYGI24nZlhSmXyCKVGpbWhg&oe=6B030341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DinoChoppVideoCover.png", "id": "708668538664168", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827277_708668541997501_6434923189631155348_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FWiDtFGM-MQ7kNvwE-o2kS&_nc_oc=AdrnuXCoK-uU4FRR8fWuYVlnsHNtb7X5nZJMvtbYoWkqdzdNiqd0cxIkO9Fulh7UFkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0ehd3vz2-wL5En5BRJf1peueTAEWfRW1wKvRsbTKvXQ&oe=6B030C5B"}, "display_name": "Dino Chopp", "keywords": ["Dinosaur", "Action", "Shooter", "Slice", "Run"], "long_description": "Gear up for some dino-stopping action in Dino Chopp! In this fast-paced arcade game, your mission is to protect the food behind you from waves of hungry, charging dinosaurs. Armed with guns and a razor-sharp blade, switch between shooting and slicing to stop each dino in its tracks before they reach your precious feast.\n\nEasy to pick up but rewarding to master, Dino Chopp keeps the adrenaline pumping with reflex-based gameplay, vibrant visuals, and endless prehistoric challenges. Climb the global leaderboard by racking up high scores, landing perfect shots, and enjoying the satisfying thrill of clean slices as you battle to keep your food safe and stay ahead of players from around the world.\n\nHow long can you hold the line and become the ultimate dino defender?", "short_description": "Defend your food from charging dinos! Shoot or slice them in half in this fast-paced arcade action game by Virtual Grape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raj
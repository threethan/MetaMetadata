.com/v/t64.5771-25/499622344_2210184516148474_1693875823915767132_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NQa4M2U1YkQ7kNvwH-pnDn&_nc_oc=AdqHU-5--0KoTmiYOLUAP5slUVVDWeBldXPckRLvaOg9MuwbOk-c9KSa0vemjqyXmxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg9b1mFRg03nRr_Sr0VkD2_nhDVkMA45y5xogJowDhcA&oe=6AFDBD41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DinoChoppVideoCover.png", "id": "708668538664168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827277_708668541997501_6434923189631155348_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9NtHLHoDEwQ7kNvwHK_sR0&_nc_oc=AdqlkXgDgwThBPdS1onA1RsN1IIZubcZxfTm9Qr1R0KsW5RN8buwMbuDqtK36GPhWh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIUaEdRn4mKkDv0hsQyPuM--RPP-1oGaeJ2itP5Lci5g&oe=6AFDC65B"}, "display_name": "Dino Chopp", "keywords": ["Dinosaur", "Action", "Shooter", "Slice", "Run"], "long_description": "Gear up for some dino-stopping action in Dino Chopp! In this fast-paced arcade game, your mission is to protect the food behind you from waves of hungry, charging dinosaurs. Armed with guns and a razor-sharp blade, switch between shooting and slicing to stop each dino in its tracks before they reach your precious feast.\n\nEasy to pick up but rewarding to master, Dino Chopp keeps the adrenaline pumping with reflex-based gameplay, vibrant visuals, and endless prehistoric challenges. Climb the global leaderboard by racking up high scores, landing perfect shots, and enjoying the satisfying thrill of clean slices as you battle to keep your food safe and stay ahead of players from around the world.\n\nHow long can you hold the line and become the ultimate dino defender?", "short_description": "Defend your food from charging dinos! Shoot or slice them in half in this fast-paced arcade action game by Virtual Grape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raj
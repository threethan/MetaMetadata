.com/v/t64.5771-25/499622344_2210184516148474_1693875823915767132_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7gajF32mGoQ7kNvwF06_iF&_nc_oc=AdpeEwShqGNAMSsKbshfdSMVOe2Td2Eyu9XNWH5xp5ySqe02UvMWToGVP_R7iJ7MaQ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ4M49E25KcY7pSMnBF72w_A-RaD1TMXyGwE1KjnuuNA&oe=6AFB1A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DinoChoppVideoCover.png", "id": "708668538664168", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827277_708668541997501_6434923189631155348_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9NtHLHoDEwQ7kNvwFuD78W&_nc_oc=AdqtuWNoKpyFVSIiw0k71g4oZ9VbQC5CTVa6K5ga8tl1fxJLlcLeAwW9vAxzDcIK06E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTl71vouHB2vNqeF-iy-bsOmIk14ClWyvJvLBB-tBWlw&oe=6AFB235B"}, "display_name": "Dino Chopp", "keywords": ["Dinosaur", "Action", "Shooter", "Slice", "Run"], "long_description": "Gear up for some dino-stopping action in Dino Chopp! In this fast-paced arcade game, your mission is to protect the food behind you from waves of hungry, charging dinosaurs. Armed with guns and a razor-sharp blade, switch between shooting and slicing to stop each dino in its tracks before they reach your precious feast.\n\nEasy to pick up but rewarding to master, Dino Chopp keeps the adrenaline pumping with reflex-based gameplay, vibrant visuals, and endless prehistoric challenges. Climb the global leaderboard by racking up high scores, landing perfect shots, and enjoying the satisfying thrill of clean slices as you battle to keep your food safe and stay ahead of players from around the world.\n\nHow long can you hold the line and become the ultimate dino defender?", "short_description": "Defend your food from charging dinos! Shoot or slice them in half in this fast-paced arcade action game by Virtual Grape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raj
gIW4-SMiFURnRIpe1KR6MLhtyiqbBK4tZDCr3CQ&oe=69D63501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DinoChoppVideoCover.png", "id": "708668538664168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_708668541997501_6434923189631155348_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc0Wf_EL71QQ7kNvwEm8EMK&_nc_oc=AdrxOK2sBgr-W4A5j539TlOvo_NAxJIGwAhYbGWb3QzJGqxbmWiCWLmqDU604aXbmQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18ogkLzQ6_4WVG94K3pcVQII1y6wjU8XWmV6Y4INR-LA&oe=69D63E1B"}, "display_name": "Dino Chopp", "keywords": ["Dinosaur", "Action", "Shooter", "Slice", "Run"], "long_description": "Gear up for some dino-stopping action in Dino Chopp! In this fast-paced arcade game, your mission is to protect the food behind you from waves of hungry, charging dinosaurs. Armed with guns and a razor-sharp blade, switch between shooting and slicing to stop each dino in its tracks before they reach your precious feast.\n\nEasy to pick up but rewarding to master, Dino Chopp keeps the adrenaline pumping with reflex-based gameplay, vibrant visuals, and endless prehistoric challenges. Climb the global leaderboard by racking up high scores, landing perfect shots, and enjoying the satisfying thrill of clean slices as you battle to keep your food safe and stay ahead of players from around the world.\n\nHow long can you hold the line and become the ultimate dino defender?", "short_description": "Defend your food from charging dinos! Shoot or slice them in half in this fast-paced arcade action game by Virtual Grape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rajavelusrivishwanath.blogspot.com/2025/06/privacy-policy-for-dino-chopp.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_categor
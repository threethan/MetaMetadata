.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlbPYVt8X_ahf0Na5pl5K2uCbV136wyoa78VykqN7ojQ&oe=6A5B6133"}, {"file_name": "migrated_image.png", "id": "615662112615629", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974896_2141841855861973_3857809212327329792_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut72qWNy2pIQ7kNvwGsXjw4&_nc_oc=AdrtW3IlGv_O9pmPE0b_cnp4v6wIE2WakYph_SaX4dwSFEouWVK3hlDbtSE5kPqag4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLVDGbIQhdRHii8KPJ18O6tGYTN2y5sK2b1sg1wIQFKg&oe=6A5B8922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Presentation Background.png", "id": "5289619547750966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_5289619551084299_4240360870711227074_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83gjbpMCHYMQ7kNvwEaNYoL&_nc_oc=AdrrjZK0BorepPXTNuSJm_oIQeHrIrA8b_AYimk3-RBVtvW-RAbnUSjYGfoc47-5v1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqQBgHPVkufFu_0pcEXQZ87DFdqq2PUokLyO9EtP6bgA&oe=6A5B673A"}, "display_name": "Human Anatomy VR Complete Edition ", "keywords": ["human", "anatomy", "education", "body", "medical"], "long_description": "-- Quest version now available - search for Human Anatomy VR on AppLab. --\n\nHuman anatomy is essential part of medicine. This app represents a unique approach of learning general anatomy. Thanks to excellent graphics, informative content and innovative features is learning rich and engaging experience. The user works in comfortable and enjoyable setting. \n\nFunctions: - Slice mode - Search mode - Latin nomenclature for each anatomical structure - User friendly and intuitive interface - Dynamic quizess - All subdivisions of skeleton - User can change background \n\n- Female and Male human systems\n\n- Contains skeleton, muscular system, nervous system, cardiovascular system, respiratory system, integumentary system, digestive system, reproductive system, lymphatic system,  connective tissue,  anatomical model of the eye, anatomical model of the ear, cross-section of the tooth, cross-section of the skin.\n\nContact our customer support via email: info@medicinevirtual.com .", "short_description": "-- Quest version now available - search for Human Anatomy VR on AppLab. --\n\nHuman anatomy is essential part of medicine. This app represents a unique approach of learning general anatomy. Thanks to excellent graphics, informative content and innovative features is learning rich and engaging experience."}]}, "developer_name": "Virtual Medicine, ltd.", "developer_privacy_policy_url": "https://www.medicinevirtual.com/data/Licence_VM.pdf", "developer_terms_of_service_url": "https://www.medicinevirtual.com/data/Licence_VM.pdf", "publisher_name": "Virtual Medicine, ltd.", "support_website_url": null, "website_url": "https://www.medicinevirtual.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5653238074727871"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984450_320431765459100_8348317972653146112_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYnAx0YjDVwQ7kNvwGPs-TL&_nc_oc=AdqTBoX7llLMCIX0SAqXM_oRyPMtS538N_a1T02cbwA6HM52jECyKTJ-PkGLboNFBaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_E_nguAU53fHjx3Xj-bmZmzGcypd8hvISfZgpeIXsow&oe=6A5B9107"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
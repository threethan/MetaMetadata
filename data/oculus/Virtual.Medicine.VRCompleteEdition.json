.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKLFiTDg6DwMblldzTomjbdY_utKhpHmh2NLwOpU18IQ&oe=6AE4B573"}, {"file_name": "migrated_image.png", "id": "615662112615629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974896_2141841855861973_3857809212327329792_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyLN9rpNB6cQ7kNvwHYtz6a&_nc_oc=AdqCsC8HoDHAKdzTbScOn1YLOwFHrIGQ78gtuo97CUEW5F_AXNbUFC6LgSJBV8VmYTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrdrD9R_T3w9d-tycf4-wsW0QjrROHTRrbx2MItCtGmA&oe=6AE4A522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Presentation Background.png", "id": "5289619547750966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_5289619551084299_4240360870711227074_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOKEJI3JzecQ7kNvwEcA41F&_nc_oc=AdrXC5lR72zrAinkW1KAqfwEOLWk9L5rLxMaeFnIDiDW0FIcsZZ-5gpClP5NX3cSe8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND1Z1QdmyeJqu2ciBVHGoBkEe4NXCShFHcsi6l03gReg&oe=6AE4BB7A"}, "display_name": "Human Anatomy VR Complete Edition ", "keywords": ["human", "anatomy", "education", "body", "medical"], "long_description": "-- Quest version now available - search for Human Anatomy VR on AppLab. --\n\nHuman anatomy is essential part of medicine. This app represents a unique approach of learning general anatomy. Thanks to excellent graphics, informative content and innovative features is learning rich and engaging experience. The user works in comfortable and enjoyable setting. \n\nFunctions: - Slice mode - Search mode - Latin nomenclature for each anatomical structure - User friendly and intuitive interface - Dynamic quizess - All subdivisions of skeleton - User can change background \n\n- Female and Male human systems\n\n- Contains skeleton, muscular system, nervous system, cardiovascular system, respiratory system, integumentary system, digestive system, reproductive system, lymphatic system,  connective tissue,  anatomical model of the eye, anatomical model of the ear, cross-section of the tooth, cross-section of the skin.\n\nContact our customer support via email: info@medicinevirtual.com .", "short_description": "-- Quest version now available - search for Human Anatomy VR on AppLab. --\n\nHuman anatomy is essential part of medicine. This app represents a unique approach of learning general anatomy. Thanks to excellent graphics, informative content and innovative features is learning rich and engaging experience."}]}, "developer_name": "Virtual Medicine, ltd.", "developer_privacy_policy_url": "https://www.medicinevirtual.com/data/Licence_VM.pdf", "developer_terms_of_service_url": "https://www.medicinevirtual.com/data/Licence_VM.pdf", "publisher_name": "Virtual Medicine, ltd.", "support_website_url": null, "website_url": "https://www.medicinevirtual.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5653238074727871"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984450_320431765459100_8348317972653146112_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ4muQrpRKkQ7kNvwFp5JZd&_nc_oc=AdqoUYWEdA9Jt7Xz-wZDFdtHvhXPcoJUjAXn7VTFk20ZhdEnF-0abXl-DsDJTIXhIE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDgvs1iLM1sU-yc4CPjoh4uibh00GuIOaxdLY7EUV6Yw&oe=6AE4AD07"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIekuRc0i2OLWZkOLw9SmxNjaoNEQsjNQ0gyxBBJ33Cw&oe=6A8985B3"}, {"file_name": "migrated_image.png", "id": "615662112615629", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974896_2141841855861973_3857809212327329792_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMvUK2oKoMQQ7kNvwFmyoLa&_nc_oc=AdqRk-I5BxxbvyFNcpYGLQZg1c2vL68lFrQxuLVTu36BxkxuSmzKUi_pWc1OKODvKd4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA1ILQJkqXiRyCbldUxQC8nePho1hKqykmbFNg8Ja3vg&oe=6A897562"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Presentation Background.png", "id": "5289619547750966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_5289619551084299_4240360870711227074_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB6K7189r6QQ7kNvwH4oZWK&_nc_oc=Ado83m7rIx0erVpy3xl_rOTkQSvHfyMRr-tkD9P0g7DAAC8rFKWRUZ53thCDuSKH9U4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvg_WdL_UyZJdr94nYXkzjQXCe5yB9sUU4PQm7IFO3cw&oe=6A898BBA"}, "display_name": "Human Anatomy VR Complete Edition ", "keywords": ["human", "anatomy", "education", "body", "medical"], "long_description": "-- Quest version now available - search for Human Anatomy VR on AppLab. --\n\nHuman anatomy is essential part of medicine. This app represents a unique approach of learning general anatomy. Thanks to excellent graphics, informative content and innovative features is learning rich and engaging experience. The user works in comfortable and enjoyable setting. \n\nFunctions: - Slice mode - Search mode - Latin nomenclature for each anatomical structure - User friendly and intuitive interface - Dynamic quizess - All subdivisions of skeleton - User can change background \n\n- Female and Male human systems\n\n- Contains skeleton, muscular system, nervous system, cardiovascular system, respiratory system, integumentary system, digestive system, reproductive system, lymphatic system,  connective tissue,  anatomical model of the eye, anatomical model of the ear, cross-section of the tooth, cross-section of the skin.\n\nContact our customer support via email: info@medicinevirtual.com .", "short_description": "-- Quest version now available - search for Human Anatomy VR on AppLab. --\n\nHuman anatomy is essential part of medicine. This app represents a unique approach of learning general anatomy. Thanks to excellent graphics, informative content and innovative features is learning rich and engaging experience."}]}, "developer_name": "Virtual Medicine, ltd.", "developer_privacy_policy_url": "https://www.medicinevirtual.com/data/Licence_VM.pdf", "developer_terms_of_service_url": "https://www.medicinevirtual.com/data/Licence_VM.pdf", "publisher_name": "Virtual Medicine, ltd.", "support_website_url": null, "website_url": "https://www.medicinevirtual.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5653238074727871"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984450_320431765459100_8348317972653146112_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-yfpdtPElwQ7kNvwEIZ3xt&_nc_oc=AdoO4Kyvva9wnzsrR8ZgZOoi64sFXDsDLfnWtLnEJBqL_Lrd6aD-uQ9pijtMj2Hc5Ro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuWRqyxLrASW5r137mpJyoZJvPF0Qr--afN9BSHmuPyw&oe=6A897D47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
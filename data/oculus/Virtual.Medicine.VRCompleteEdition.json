_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSFUgDsZ_3EQ7kNvwE5PvNh&_nc_oc=AdnpM_gQdb-3daa5f4V3iHNX15a7pGWL_cZ4amx7iTtorSMGPMe_IaBA_yJXV9jCn_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuES0SsKzTBU1VktslGjDOouN1z62zhvQ04jUZMUWIeHA&oe=699B0E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Presentation Background.png", "id": "5289619547750966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031339_5289619551084299_4240360870711227074_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqkvgoIenuYQ7kNvwGlXwc4&_nc_oc=Adnt8TBvGz1gMfZ8tmy4XTkuYiWXy-cFtEVWZb_omIpdITEXCkoojnrw2qTbbDx4fmM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuvk9kBh74MniPVTp9vc3yrAkaw7U8faYSuRyCWoLikLw&oe=699AEC3A"}, "display_name": "Human Anatomy VR Complete Edition ", "keywords": ["human", "anatomy", "education", "body", "medical"], "long_description": "-- Quest version now available - search for Human Anatomy VR on AppLab. --\n\nHuman anatomy is essential part of medicine. This app represents a unique approach of learning general anatomy. Thanks to excellent graphics, informative content and innovative features is learning rich and engaging experience. The user works in comfortable and enjoyable setting. \n\nFunctions: - Slice mode - Search mode - Latin nomenclature for each anatomical structure - User friendly and intuitive interface - Dynamic quizess - All subdivisions of skeleton - User can change background \n\n- Female and Male human systems\n\n- Contains skeleton, muscular system, nervous system, cardiovascular system, respiratory system, integumentary system, digestive system, reproductive system, lymphatic system,  connective tissue,  anatomical model of the eye, anatomical model of the ear, cross-section of the tooth, cross-section of the skin.\n\nContact our customer support via email: info@medicinevirtual.com .", "short_description": "-- Quest version now available - search for Human Anatomy VR on AppLab. --\n\nHuman anatomy is essential part of medicine. This app represents a unique approach of learning general anatomy. Thanks to excellent graphics, informative content and innovative features is learning rich and engaging experience."}]}, "developer_name": "Virtual Medicine, ltd.", "developer_privacy_policy_url": "https://www.medicinevirtual.com/data/Licence_VM.pdf", "developer_terms_of_service_url": "https://www.medicinevirtual.com/data/Licence_VM.pdf", "publisher_name": "Virtual Medicine, ltd.", "support_website_url": null, "website_url": "https://www.medicinevirtual.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5653238074727871"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984450_320431765459100_8348317972653146112_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3GIzNfbiBEQ7kNvwFm8JJF&_nc_oc=Adn414lYIuTLTrYUgkD76ctiMHHcVe7ftwuHCpnVMEyKVHm0f-paTpQoAK67A08CO48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu0IdMv70Ta3aBjCmDpTmU1g4uzLP_CSRxsNoGcACyVXw&oe=699B1607"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Human Anatomy VR Complete Edition ", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1531414800, "lastRevision": {"nodes": [{"id": "1992770637632470", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicatio
luscdn.com/v/t64.5771-25/499310667_930899316452029_3792876320906707412_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBU1X1cSUa8Q7kNvwFofxY8&_nc_oc=Adp1qMVl0NZsFXnd8yXrWWZD7Kv-6FyDkFdFLFb1IkrcSVNYOYl6EPpUGOJPY5fxH5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ9Is66T7fyCRigIl5pJkitLfXdfWbFZoH6HzfZ5n5pg&oe=6AE753E0"}, {"file_name": "Render_01.png", "id": "2413798462463790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307505_2413798465797123_1285723494383946455_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_wYVozI3fkQ7kNvwHO_Snd&_nc_oc=Adrrph6Fckkyn9Cdgn16s1bCIj0adcxmOeuMfbGmbzfH5IiUB9LKHhjd3Qq8kO53q9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ77urjW-cDV9DMRw9et46W37we1THq6hDdYCsPyqzXEw&oe=6AE739C7"}, {"file_name": "Render_03.png", "id": "1034378339768018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1034378343101351_4241283141642592065_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV6CpqKpJ_YQ7kNvwFRn4gr&_nc_oc=Ado24hJyFxTbEUn3Y25HvI_-fn1_2DEtuHnAj3sfjgYI_0QjQh2A5QRwcN00L4tmJaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSRA7AOYRx4PN7dWXlBGY9nLsWQeaZAuGcH1BNZnhG1g&oe=6AE769B9"}, {"file_name": "Render_04.png", "id": "1267396035508322", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_1267396038841655_215081805419428701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzcBfaPKfPcQ7kNvwFRvOlg&_nc_oc=AdoC4rQwFZvacqyqU4DeqYuEiiwWDAuWG5UPKpnFLvnzIOnoWxuL8Oe_FFj2j1WTjbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRRTS3F0d5QjpodH-OSIR7WEjKX-_WRhkSr1e4BYoUuA&oe=6AE746A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "4498147490432493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_4498147493765826_780560712297457272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3BGjMXs_DEQ7kNvwG5oEwE&_nc_oc=Adpizn8A-426aWAo4HGcv5_J4PdttGnV1TKXp-FEcCZjMLfn2Q8QORbTNmz1PFQIHFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQauP_EwUeAR0tWNbp2sQPmBeveqAiFLw_mOuf2GhkC3A&oe=6AE7680A"}, "display_name": "RC Trucks", "keywords": ["Simulator", "Truck", "Driving", "Delivery", "Transport"], "long_description": "Step into the world of RC trucking and take command of powerful remote-controlled trucks in a vibrant miniature city built for exploration, cargo transport, and driving mastery.\n\nRC Trucks puts you behind the wheel of a growing fleet of trucks, starting with a small delivery vehicle and working your way up to massive semi-trucks with trailers. Complete missions across a detailed city environment filled with warehouses, gas stations, intersections, industrial zones, and busy streets. Each delivery challenges your driving skills as you navigate tight turns, manage cargo, and reach your destination safely.\n\nEarn Truck Tokens by completing missions and challenges. Use them to unlock new trucks, customize your vehicles, and expand your collection. Choose from different liveries, upgrade your style with new wheels, and equip unique horns to make your truck truly your own.\n\nExplore a variety of gameplay modes. Build your trucking career in Career Mode, where new cities and tougher missions unlock as you progress. Or jump straight into Fun Modes for quick challenges like cargo balance tests, time rush deliveries, and obstacle-filled routes.\n\nThe city is alive with traffic, industrial areas, residential neighborhoods, and scenic routes that create a believable world for your RC trucks to explore. Whether you\u2019re carefully backing a trailer into a tight loading dock or racing across town to complete a delivery, every mission offers a satisfying driving challenge.\n\nRC Trucks combines acc", "short_description": "Take control of powerful RC trucks and explore a lively miniature city full of delivery missions, cargo challenges, and exciting routes. Earn Truck Tokens, unlock new vehicles, customize your trucks with unique liveries, wheels, and horns, and master the art of precision driving. From small delivery trucks to massive semi-trucks with trailers, build your trucking career and conquer every road in this immersive RC driving experience."}]}, "developer_name": "Alternative VR", "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alterantive VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24863964743230949"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1291769576365524"}, {"status": "PUBLISHED", "id": "1746002426753647"}, {"status": "PUBLISHED", "id": "1330819382473059"}, {"status": "PUBLISHED", "id": "4395767440698472"}, {"status": "PUBLISHED", "id": "1735330787635249"}]}, "baseline_offer": {"id": "1330819382473059"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1291769576365524"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26576662865294453", "version": "1.0.1"}, "id": "1536067164304413", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": 
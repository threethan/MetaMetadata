at=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC3aojaZWtcQ7kNvwEv-nHV&_nc_oc=AdqRYX_nG77yEe6Mq3Qj9f7rbZ-0lF-vIsAGvOlceiIPHxcbhdGKEsYOPMhLtGy0Nw8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWPnHiZKNZQyGXH2lW1UrsoJDDzH9Xaj8TK8u5IDoDFw&oe=6B0B0D8A"}, {"file_name": "21.png", "id": "848037201680347", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823940_848037208347013_7084955263469838779_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8JgJR-uYmkQ7kNvwHSgvq8&_nc_oc=AdqhyyVQzbw104s2_PppZNgbVDMPcuMPVZc5StPNbpUqYvBKFKuTzHrgWL_GljY1Xhc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxR3FDbHV4eVM9Vdoz8piqfVPdD_1glmlKFVj_ixasYQ&oe=6B0B2239"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Simulator-Superstore manager", "keywords": [], "long_description": "Step into the world of retail and experience the ultimate supermarket simulation in VR of Supermarket Simulator-Superstore manager!\n\nSuperstore Simulator VR lets you build, manage, and grow your own supermarket from scratch. Start small, stock your shelves, manage inventory, and serve customers efficiently to turn your store into a thriving business empire.\n\n\ud83d\uded2 Run Your Own Store\nManage every aspect of your supermarket\u2014from pricing products to organizing shelves and handling customers.\n\n\ud83d\udce6 Stock & Inventory Management\nOrder products, keep shelves full, and make sure your customers always find what they need.\n\n\ud83d\udcb0 Earn & Expand\nIncrease profits, unlock upgrades, and expand your store into a massive superstore.\n\n\ud83d\udc65 Customer Interaction\nServe customers quickly, handle rush hours, and keep satisfaction high to grow your reputation.\n\n\ud83c\udfea Customize Your Store\nDesign and upgrade your supermarket layout to maximize efficiency and sales.\n\n\ud83c\udfae Immersive VR Experience\nEnjoy realistic store management in a fully interactive VR environment.", "short_description": "Build and manage your dream supermarket in immersive VR. Stock shelves, serve customers, and grow your retail empire from a small shop to a mega store!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/namigamesstudio/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nami Games Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/namigamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26674551378905951"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "28591038280595290"}, {"status": "PUBLISHED", "id": "28101197929553102"}, {"status": "PUBLISHED", "id": "2188232902091618"}, {"status": "PUBLISHED", "id": "1770099647463649"}, {"status": "PUBLISHED", "id": "1577594253819585"}, {"status": "PUBLISHED", "id": "1602609718137703"}, {"status": "PUBLISHED", "id": "1053691887268438"}, {"status": "PUBLISHED", "id": "1656976722050514"}, {"status": "PUBLISHED", "id": "2492330174546383"}, {"status": "PUBLISHED", "id": "1842874873075728"}, {"status": "PUBLISHED", "id": "2170935466798764"}]}, "baseline_offer": {"id": "28591038280595290"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794249360, "status": "PUBLI
.com/v/t64.5771-25/499312236_836262485669122_1698831735889136322_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOyEg7nX7_wQ7kNvwEP02-R&_nc_oc=AdoBMIOHlbnu1b9fXtL4007cn2yuahd5RIzHQA24Fl0-72WtMvMQKbr4ew9SNEHWGeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9w-hXMBvT8hWwP8U8DlxuX-uH4o1RNli-CUa9E2vbzw&oe=6AF717B2"}, {"file_name": "17.png", "id": "825261807308723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819982_825261810642056_4324751530444796268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u71qC4U69hoQ7kNvwEKrcBF&_nc_oc=AdpP7td3DDKJBk_LLG-GjwZ5KfNpRGrF1Ku0aGBZ0gZsHUae25gciFMg04ztpgHN4j0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_pNbcq4IE7RX6mGHs9yuiTCZJjaAa8uTWxqFBAmYeCg&oe=6AF72326"}, {"file_name": "19.png", "id": "26717565867864399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_26717565871197732_5692248045734314980_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udLuUBotc5oQ7kNvwFX7Bsj&_nc_oc=AdqLAKJF5C7qBGrKNH1m8PHmyOd1usVMvIRNdZ0c8780YbQtVwuEHdT6mGa8sF7aafk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi5-2EJeS8B6pTPNTO6z7a_z4DnB9-o2QzlN3E8Kobng&oe=6AF71707"}, {"file_name": "20.png", "id": "1759157088777349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_1759157092110682_8186605572019057826_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhiNXlp6uvMQ7kNvwGS_GHZ&_nc_oc=AdrS269iw190O0aO38LnDdmJ65OEy0UTnyT_PUG8bnkIUvhcrTHLth9Vdf3YhGp5_AQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-qqVxoDR2F9TAENKnpK50Y898XERKGreYRuCG_vXrog&oe=6AF7470A"}, {"file_name": "21.png", "id": "848037201680347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_848037208347013_7084955263469838779_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A22I4r2Dx2wQ7kNvwH3cmfW&_nc_oc=AdoanrHrnz9VzR03AXNjvTHNa3P7_ZN1GWQNzrQdNg2OTxFHhV_P_-2dhGHwdcUvs8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzc5grXQxiwkClS473tG4oamljJlBaZkvPb62VPfFeXw&oe=6AF72379"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Simulator-Superstore manager", "keywords": [], "long_description": "Step into the world of retail and experience the ultimate supermarket simulation in VR of Supermarket Simulator-Superstore manager!\n\nSuperstore Simulator VR lets you build, manage, and grow your own supermarket from scratch. Start small, stock your shelves, manage inventory, and serve customers efficiently to turn your store into a thriving business empire.\n\n\ud83d\uded2 Run Your Own Store\nManage every aspect of your supermarket\u2014from pricing products to organizing shelves and handling customers.\n\n\ud83d\udce6 Stock & Inventory Management\nOrder products, keep shelves full, and make sure your customers always find what they need.\n\n\ud83d\udcb0 Earn & Expand\nIncrease profits, unlock upgrades, and expand your store into a massive superstore.\n\n\ud83d\udc65 Customer Interaction\nServe customers quickly, handle rush hours, and keep satisfaction high to grow your reputation.\n\n\ud83c\udfea Customize Your Store\nDesign and upgrade your supermarket layout to maximize efficiency and sales.\n\n\ud83c\udfae Immersive VR Experience\nEnjoy realistic store management in a fully interactive VR environment.", "short_description": "Build and manage your dream supermarket in immersive VR. Stock shelves, serve customers, and grow your retail empire from a small shop to a mega store!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/namigamesstudio/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nami Games Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/namigamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
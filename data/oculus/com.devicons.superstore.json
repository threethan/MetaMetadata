.com/v/t64.5771-25/499312236_836262485669122_1698831735889136322_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFOl0pdojuUQ7kNvwH-xTaO&_nc_oc=Adq7qwAFv8Rst2H9V03zyNtmYvPxVjNqpQUSTFDLjq6Fk0p6-JnWzmGZoT4CwFr62V8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMpAwYt_R-KxdnWHprNyJKeafzax9Rsn5qL0GHWvS2Rw&oe=6AEF66F2"}, {"file_name": "17.png", "id": "825261807308723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819982_825261810642056_4324751530444796268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmJi7hCRm0sQ7kNvwGKF3br&_nc_oc=AdqaDmSOA-WEx-i6dXQxH9YRN2cdDZzBOx86DwHCb3VywdOpVHG89h04vFQ_ERUnnLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-ZLd8ufzmYd-vNaLCbrxIr9t6yMksswSQKzY0MYNcnQ&oe=6AEF3A26"}, {"file_name": "19.png", "id": "26717565867864399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_26717565871197732_5692248045734314980_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCz7pd-7X_UQ7kNvwE0U03F&_nc_oc=Adq_Z94wDvlG8GaP_DtTmVZgVilJb7mw-cwZI_7pojrkJ-6PYF47ZZdPJrlv83nT4ns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOWWE3u4L05gP6UV5jDIV1u6u3bGE3lj1coIipPtiAKw&oe=6AEF6647"}, {"file_name": "20.png", "id": "1759157088777349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_1759157092110682_8186605572019057826_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2tq4zt75MgQ7kNvwHLI7kH&_nc_oc=AdocKm1v1mbhAMkdVnLejFe_sx_OL4-xExJN4AT4tRSx24r2NgA8Y-2UUS4GYunC4YY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ_f6JC5TO4P-iO8sH4wAbfoMjNVS-xBGpOOP8K7Yd6w&oe=6AEF5E0A"}, {"file_name": "21.png", "id": "848037201680347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_848037208347013_7084955263469838779_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_olS82AESYQ7kNvwGuk_Bx&_nc_oc=Adp_9SYrSet85JM_qivao1tRW9Ak-6imylN_VqVSVAtxFstmhZKSPw2jvy6qj3wu41Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKtP7fl3sY7qjcL8AfolGnRWCAWjL8-0r0FEwVixx79A&oe=6AEF3A79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Simulator-Superstore manager", "keywords": [], "long_description": "Step into the world of retail and experience the ultimate supermarket simulation in VR of Supermarket Simulator-Superstore manager!\n\nSuperstore Simulator VR lets you build, manage, and grow your own supermarket from scratch. Start small, stock your shelves, manage inventory, and serve customers efficiently to turn your store into a thriving business empire.\n\n\ud83d\uded2 Run Your Own Store\nManage every aspect of your supermarket\u2014from pricing products to organizing shelves and handling customers.\n\n\ud83d\udce6 Stock & Inventory Management\nOrder products, keep shelves full, and make sure your customers always find what they need.\n\n\ud83d\udcb0 Earn & Expand\nIncrease profits, unlock upgrades, and expand your store into a massive superstore.\n\n\ud83d\udc65 Customer Interaction\nServe customers quickly, handle rush hours, and keep satisfaction high to grow your reputation.\n\n\ud83c\udfea Customize Your Store\nDesign and upgrade your supermarket layout to maximize efficiency and sales.\n\n\ud83c\udfae Immersive VR Experience\nEnjoy realistic store management in a fully interactive VR environment.", "short_description": "Build and manage your dream supermarket in immersive VR. Stock shelves, serve customers, and grow your retail empire from a small shop to a mega store!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/namigamesstudio/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nami Games Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/namigamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
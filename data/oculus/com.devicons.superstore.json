.com/v/t64.5771-25/499312236_836262485669122_1698831735889136322_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFOl0pdojuUQ7kNvwGkFbpO&_nc_oc=AdpQHl2UYFi07vFX1OZ5zSov5FCAdtv_07_834HBt_FMjBKr4zJkegKs1cS_TFZW0Vs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVR3TnW9ygnxv19RWYfDHWXOiuqzkk4JmjnjcIWrTivg&oe=6AF32332"}, {"file_name": "17.png", "id": "825261807308723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819982_825261810642056_4324751530444796268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Odnlf0pCsoQ7kNvwGi5PQ0&_nc_oc=AdqNH4AIXvycoQzxLq_5xN8Blt8FExDVyf_i3yVeEVogqdJAZ2mU1L61gygLTSyCpIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp735KH-5BSAMvVPer35rS8P6fW5ZCl1l1XuIj7c4KtA&oe=6AF32EA6"}, {"file_name": "19.png", "id": "26717565867864399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_26717565871197732_5692248045734314980_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOxcJxLwwkAQ7kNvwHplnMT&_nc_oc=Adqs1cjg81c-rthM_xFEo_5t2k49CVWJiJeQEZbH1UqRfH61OBNtXNSCOtwdDp2BZ4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Mwz1UfPTpeeFZTOXU9tQhZq8tzSBLrU-q4rpcCbLig&oe=6AF32287"}, {"file_name": "20.png", "id": "1759157088777349", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822327_1759157092110682_8186605572019057826_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG1n6HSWxuwQ7kNvwFESLgp&_nc_oc=AdrOqwu3-94UF5I53svfRz6dHWpLjOYPkg2KN7s9mMQvBenXpjoqspxtGPdAwsqZafg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv-6VzLJEfMtb9GwIg87N9SyocdMHksdhhJ5VMnA2vMw&oe=6AF3528A"}, {"file_name": "21.png", "id": "848037201680347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_848037208347013_7084955263469838779_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDHWJ9RRhRsQ7kNvwEtNtFa&_nc_oc=AdpJUzBzBtU759dP7JGZKkOKsL2Qeet75FQpKX77gy1S4YYSCQAPPlU6OogfvelCGlo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQciaJluCQRonEuanIvK2W8DnxxNXsxgycvSXl1Kad0lg&oe=6AF32EF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Simulator-Superstore manager", "keywords": [], "long_description": "Step into the world of retail and experience the ultimate supermarket simulation in VR of Supermarket Simulator-Superstore manager!\n\nSuperstore Simulator VR lets you build, manage, and grow your own supermarket from scratch. Start small, stock your shelves, manage inventory, and serve customers efficiently to turn your store into a thriving business empire.\n\n\ud83d\uded2 Run Your Own Store\nManage every aspect of your supermarket\u2014from pricing products to organizing shelves and handling customers.\n\n\ud83d\udce6 Stock & Inventory Management\nOrder products, keep shelves full, and make sure your customers always find what they need.\n\n\ud83d\udcb0 Earn & Expand\nIncrease profits, unlock upgrades, and expand your store into a massive superstore.\n\n\ud83d\udc65 Customer Interaction\nServe customers quickly, handle rush hours, and keep satisfaction high to grow your reputation.\n\n\ud83c\udfea Customize Your Store\nDesign and upgrade your supermarket layout to maximize efficiency and sales.\n\n\ud83c\udfae Immersive VR Experience\nEnjoy realistic store management in a fully interactive VR environment.", "short_description": "Build and manage your dream supermarket in immersive VR. Stock shelves, serve customers, and grow your retail empire from a small shop to a mega store!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/namigamesstudio/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nami Games Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/namigamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
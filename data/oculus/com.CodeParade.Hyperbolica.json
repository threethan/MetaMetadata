8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCbSv9NeDjQQ7kNvwEJ9vq9&_nc_oc=AdpT9ffEob-Ug3V8gV9zzaL6U9PcR0KZRy0i3S1D4K_A52qy2iehKzITk7NqDI-Eat0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvDtGrGwPlssA-SdLIRGThXuxyVyw7d6wK1LyKRi_-AQ&oe=6ACD01FE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3DBgrgvYzAQ7kNvwEEc__j&_nc_oc=AdpMXZfAJXR650aVqVeJ9HT742Nd1KXBXPvWe0j9ygmK0OozJ3-nZg2RmxKrzasjj-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNToWbmzqtunFYbpE02o8tfK824W7zlZQ9qZ-GIAGnAmQ&oe=6ACCFF2D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snZLAENedRIQ7kNvwFbb-rh&_nc_oc=Adob04OxP8g1taC8OayN8rb9ZlwPYPDwOsOi0NyEFaHl0CCRHMo91B9BCR8JgEG4-qY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8FY2kb-e0BqvYIbGaWLpMf4KJ8JwWwOTcTwHjmu1cgg&oe=6ACCF5F5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCG6aPOBz7QQ7kNvwFb7zCQ&_nc_oc=AdpO4t8nOlLw-sDHYJ24-CWSfKHkWUu5pToYZxZWEaizFwXmANf2YZD7h_3_CFQTFRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6b6gEMDgzybFaf-njEZDrSDNWFHl6Z2CMBHLiQFJOqQ&oe=6ACD12B5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMm57jVhGS4Q7kNvwGxbbb3&_nc_oc=AdoLF8A9IabsXVjZpDO_SejtzY5ff4rZuGeyIZ2-fUD3hCRoOz0VXnvI__h0Kmzi5XM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfmEUpjfmjIrfy4ClgCafIhc28uOKqg_sUfBL7E4yU0A&oe=6ACCE82C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6c-x9Ev-NoQ7kNvwGCfCLH&_nc_oc=AdqhR8L1U1ptWWcLD97L14W0or8ad7E0GGrLdQMPnaZ5DFGdSJH-0I_AvDfa1FkUaIw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeQNXTkeNRzWkoQ9hAf9C1KE_8pWY6w8rbOGJF_jWaOA&oe=6ACD15F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25d9BaGlPg8Q7kNvwHL_Drf&_nc_oc=Ado0RRO4KUDP3aEVLb9qkK6HJf77ydByq3IaszyuCkVt0urZkPrRYRTAjaugdurSTNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIglGUpQPDi6i55qhpAgeROpkQcLQexTuRU4lv1qPjfg&oe=6ACD1925"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
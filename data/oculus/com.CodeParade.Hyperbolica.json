nc_sid=6e7a0a&_nc_ohc=N-9NvT_aLdkQ7kNvwGZbG6M&_nc_oc=AdoN6P1bVYEVwplpqssOv8rVL_MvbX_T08wMg9PcJwOGWNVKpIx8GRwllMx9CsNrmCk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXmL5xszxXVRwBFtFADDIbtocKM7W0_aRfdtcriUa_og&oe=6A4E4A75"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_JGnf10qTkQ7kNvwGDxeYn&_nc_oc=AdoIRQk-mknAjkGGAK6Ah_YM4Vfb_bEeV7RRq97rYERpZ-NmxVQjykrf3690RlqNhMM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDvDP3mJUO-o31af_wJp7-fjwGiJdgLQAjbDG5k62eWQ&oe=6A4E582C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqXavo10bPoQ7kNvwEKRUe7&_nc_oc=Adpx56Kafa91cJKi2lxabp5JdEU3QsvkgeZHYL4iAUnKC9NqbYmu8GbMl3UU_jB2gtE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFiMkUvNuR_B-jtAjOFwyAfHBai6Mw5wwC5S7Bm8ExNw&oe=6A4E4DB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brBzpA0pbtIQ7kNvwElFBMg&_nc_oc=Ado8s98fiiDk9PgP5Tvwr_2FTjcu5YAOZz3JP7NRR2M0p7PZ5L4OcwFpkQRjPLIWCOs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_eQ4JQFnvrtfTTIu0nKyjixJyuwvwfTPXeXzVwSAltA&oe=6A4E50E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "530600385519685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57568668_2260772697414
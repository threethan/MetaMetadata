8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-EaSnNHhYsQ7kNvwF38T8M&_nc_oc=AdofO5imK1JGWWC9BKbsID8iU2VH0vWZOOQo97z8dLXEo-k1JPAQ6PCpjveV-vFLlQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHugFos0p4SjrAsFP4qWnjhai9bR-yeGOofZbZmBMtrMw&oe=6A7323BE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95xmEY9YZmEQ7kNvwFgwV6B&_nc_oc=AdoXewmfr8Ap4gNmkrylg29Gfbiyc6kIxv0JR5nx9HUyYlbkfE3MNlbIpoZ84HX5NCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESyTYVxbaEE4fcjEMm0fE58qm7Ev96bPddcN718a0gQw&oe=6A7320ED"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dog5EA5WUUQ7kNvwGq54n9&_nc_oc=AdqlO1OuKDOeinP7ueTfkCb0LSX5ZD2MH5dW6yNDEHvWr4zSFEBBVMvkbu-hxfHV8_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLhvxNYhsz9a3QTFL0WV0iHcQnd2q9A3fZTBszRxv1tw&oe=6A734FF5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCtuPZzMPK0Q7kNvwH26X_2&_nc_oc=Adqy7uHtHop4YREGrsltG6Ojvtb8JkO93hPtbA9GEp4gR9SFRSC9KoGNCHTJuQpxXS0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkPixSRyLOGvy35tkIvwfstOPxc14txLZDIR3FXkNdMA&oe=6A733475"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fca3N_1fqioQ7kNvwG6zDtG&_nc_oc=Adq9iIAkdw83IfNxU9fFG0WucdhDBsmHMk1JXo_eZhLPEdu9R2vdnuB5zkpCwpl2qHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzxeNqt2hzUH3tM3w1Zj7ss57dJlOjvWDLpV56P0J0Dg&oe=6A73422C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lf2ShbbkgGkQ7kNvwH4O8-X&_nc_oc=AdpE54kV-Jywud9TUx2m2tvzzaDn-pad0eWLIv_XS5S0fsIRCMkvoU05bYdNlhRYdwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzVxLHHbBOUzGAWWXOiA_-E-mewEaMojAuegDUviOfrQ&oe=6A7337B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEeS-h4ayTgQ7kNvwGWPBio&_nc_oc=AdoZ-cirq03RlaPB9Eq-8v26DXaNi9ONf00H3iIlqf3LDutElRRSQaFK9mK6F3eP21U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd6jXd9idRJCwKysOTCZj_hd0cj3yjAgsBBWt1RlG6XQ&oe=6A733AE5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nL5PYoPqGgQ7kNvwGyWu8W&_nc_oc=AdpnSLyjkJDcbN_IVjpximwD5sULkPqo85kAfPlI_O4zBT3JKoPcHene6ZzN280lRv0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OsStAHan7ItGsZGgC9j2D8VyUMZBeb0MmQbIy_i1yTg&oe=6A0C86FE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4T15Ng7gtgQ7kNvwHu0-Pg&_nc_oc=Adq-6EwG9SuTzHSV4hNW7snGNT3fJs27fWi1V5svGWrPbuDrEpEJnTEAJjBu1KHxnds&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UJ_NGZ9S452hZZRGSmUZ_efASyo0MYvD0yH2LL4zivw&oe=6A0C842D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU0nXppywTIQ7kNvwF-5Xup&_nc_oc=AdrE6FxRcjvTQk2nLE4C8X4Av-cAw7u-SkW3QiP6Ec298leGejU2vuAha0Y_Un070ig&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DsOM95gwA8ixBHtF3By6HGKCLK4dpwrU0xWB87o-eHw&oe=6A0C7AF5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K67EqMwUTAoQ7kNvwFZUza6&_nc_oc=AdoyE9bpMCDrIOGoNQIywO75sxREfaw1qELtnyOa3oZnVxsb1RQJwII_eNQZTXZCD30&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u-zDhR2M7dU-AhxYmz9cqB8ohuzAaxEiHt8ymokxRxQ&oe=6A0C5F75"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2o2nFr3PMMQ7kNvwHlODXx&_nc_oc=Adrdxe_FJ4I7MKTzKSyL0-9l8LTF0L-YDWtmzfpFUSJwQcHp00-2_9JT6JLlRh3ZRh0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71qGaZdakkje51oaa0PP-JyHVUJRBeeai5UyWfIoERaQ&oe=6A0C6D2C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVA9kiknBf8Q7kNvwFn6AI6&_nc_oc=Adr8-bRj35B3i6hB22xqdSssWxn7I166e-oMHLSQy7g5uSBQAJfnCCDEp-LEgaHgEOQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56k8t1TXUFeLP3JdrY-1x0XuRn6FJqeAAoofXJNRcyCA&oe=6A0C62B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sijNzUQm2sQ7kNvwG9Gdvh&_nc_oc=Adr3Tm_qsdpvaw5d-6MlLsupe3jucYXTZ5k9tuKDBcAgWypoanpJv-fLy0G_cjMXlxA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bgXTqcUyrxHp2Qwdhjyh5mIBdonpErI--uB0v14JV4A&oe=6A0C65E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
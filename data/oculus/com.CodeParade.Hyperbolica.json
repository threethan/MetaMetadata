8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-jU_ycAqH0Q7kNvwH8vU1u&_nc_oc=AdrLTmNF1Xxweq26ur0b9qgVgDh9rFqsA9BQ-_uxB3mnKYXX_SyeNmzNKPV2eGLs-so&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyzmO5tH3pl4RR5o4WcZ_N01LQ6lLENyTzLLKLRfpJQg&oe=6A77183E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVVTN5uGiGIQ7kNvwHoJHdh&_nc_oc=AdoC4xujeoVZrG19K6eVK3gAXDV1KJnbuZmoBmQ9VdCanm6gQjPFFYpucvzRSA6G3YE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK8I_qSK4amesFmX15ED62N9t09Jl15wIxjDRc1q0AMw&oe=6A77156D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kprZB0qpE4IQ7kNvwFMBLP2&_nc_oc=Adp_vsmpQYX2CRXlRBr8-MCkTC8mmMBkKF1FiWHUsq12OEf0BNnUXQVv1J4ZZOIVBtI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcaBbJwOboY_6h-z-lxqdBgqy6-w-rxuXCbzmm0B9D4g&oe=6A774475"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weHV9T-uhskQ7kNvwEPmC2Y&_nc_oc=AdrKkxO_rHdFNZvnG3oXcEDz-64qHnNm8qNd4hpdZ3cucW-wKUcILGoufHiIUVnEAWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGte_wxyatElIVG7rB8343iLWAoFGgRkJhLU4axZ_WeUw&oe=6A7728F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw7X93Ea3UcQ7kNvwGyWK9a&_nc_oc=AdoybOy4WZNFhQpWrFi9iyHoH9FCio8CQRjaGAAEsiEVbxPJDJpGuhGKAxLOL9J3ZGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpwC7Vn1kNDsj-OGwIdrROj4R_jWXXwbTXhFhyZfZm2w&oe=6A7736AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uTkdpYRqfMQ7kNvwHPUNJx&_nc_oc=AdoYSUoNBSQtU-HDdMZ5PHVwPut4KXpXp8cqu8UdrwAG1v-gcZxFmp6TktuRKkb4f0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIEhrKv42X6WA0Vj17xl5AL_vSGfwWAu6mqCOzwSyUzg&oe=6A772C36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP-jj2rfQB0Q7kNvwHia42_&_nc_oc=Adpr-pJYf-CMvsmVixzWDalMCV9nQslCPrSKKffhbpA_AJpbN4Il21-E_zxCA6VSKsw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7NOYQ4bdzZ1T5eIDaPdZqrbUMvYwtde9ghaJJmTCZaw&oe=6A772F65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
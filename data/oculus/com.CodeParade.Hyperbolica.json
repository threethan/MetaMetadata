8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z71BqfI9cQ4Q7kNvwEFJ71M&_nc_oc=AdpHm1kSIYhEdLfgE4jpDmZTfuf1SiMPY_XG4wN3BipoV44s3hVIHxa3B8TX3ivW1n8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pAjck5cRmSeeFQGeiwN7_hM85ByVIdeFarXMiEJuGRw&oe=69E6133E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJH5Y7jCIywQ7kNvwEKQasi&_nc_oc=AdrEhYyYL83CifDksopDr6VWfrzlsRK62TqbbXr6k11YXRoFcZ_0mT_yzL8jnF6WnbI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tCXQeSd4dkowNvxQCVR3gafkolPwCj3V6OdVxOmEnOA&oe=69E6106D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAINTLdbi5EQ7kNvwHlQERm&_nc_oc=AdpzQNCRd2crsUg3bEWu0Q0oxy6bcN3zZBnd0MdO8mDizPFPSoDwAnm-ZLC99pK_qCo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nY3rCWiCDiEq9g-a6Pp8fUZ_Yj3vfQDlJSQuIXO1xJA&oe=69E63F75"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWRTpYTU2EYQ7kNvwGhg5ul&_nc_oc=AdquR9vKmYhZWuJqLQ_7X8-0_epYBC3TyvmZPqsnQI0VVpe1YSJh7eGuxkK-b7nAVvk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02sqFmfsYJiTUFh86K5cDb6bUrRnQ1zLLYL7ScqaJggA&oe=69E623F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr3UwYwydNIQ7kNvwE3-cQH&_nc_oc=Adru1K15tv4bfJd1uwfHK74LwcgT1ymM60YyPFF-f9ldrMhAYKz4an4GLmZoXyp7nXw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NcKZelksl6ujozJ65yXFx4ZEtqkkAfu943CXe9FvadQ&oe=69E631AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRR5BbwIYqUQ7kNvwGNc8Dy&_nc_oc=Adq56s0vLmp8uJSsdXiETsvzLUq5tRg9clVXi9oCppRxkBMQlYPJZzelMlAJA8iMwEs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-4n72GVT1Qyd9gZ2FzxCQavtH2UYZ6_ro1dD6kkXtlQ&oe=69E62736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTYzE0vlRT0Q7kNvwFAtbOF&_nc_oc=AdpotHV9UCCUHEW4X9nWQypTTwqTBS3ubVTv81SBdZTtQEu9bYxaYcP3nxUc9BgXd3s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-IcPwKQf4Agiv7BuzV7_NepXH8oaTlX75Q4Tp77NTpw&oe=69E62A65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
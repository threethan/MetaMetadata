8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-EaSnNHhYsQ7kNvwH9R7yB&_nc_oc=AdopDxT_s-sdMF6tshsYSBGWL2euuiBZPAaqE_FfKgkSBSpTq0tHs0auD7db-tk_AXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED4xRt5dyD7oMfEfszH_lBQCR3IWI80cmCZQiyNyWZUQ&oe=6A74753E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVVTN5uGiGIQ7kNvwHbKcCP&_nc_oc=Adqt6gJMAR-GLTYW_nBzB241wCHLCFfS7YPHZ9-etun0bCtZqEDFwqMoRuPu5TLhQOM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA9p9LdR_Lqc7UlkPs8-y2TnCOF2sWuxZYSLQP2lOPLA&oe=6A74726D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dog5EA5WUUQ7kNvwElqX7L&_nc_oc=AdoP_rvf4wTYN_t6rWt8Y3wmkp7nCFwR6yxwIyE85syX66XQ0cpnE1q0HAIwJQ6DOTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxqz2VkQmXW5jYx1oQqXXn1KPLsQV_Ljbkmd72PrnESg&oe=6A74A175"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCtuPZzMPK0Q7kNvwElH_7i&_nc_oc=AdqHBYx6agmO_JoTWVTYljBVQgQzbVMHBhqtF7kZiTM76fyIYTinWwmBTQ28VlPKkGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ_qYXW3kIev2lISap1x12Juzm02BpDBImYJE9m5RUAw&oe=6A7485F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fca3N_1fqioQ7kNvwHFnlOT&_nc_oc=AdqAPc-5TFB-OVhRrR5jtXCSC0n0f3klv3Yhb6ZVsOpCeJfAfST0Ln6F2ZXTUDpLEaA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDt9Pvj9ZqB0sgTEom-9LtGsDQvsDfRS6wjRVr1hTMxw&oe=6A7493AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lf2ShbbkgGkQ7kNvwHE8w5H&_nc_oc=Adrtqbo-6YeRM3EgHoIuT3Sj0NF9GpQ84WFt4p1RbkR3bct5qwkw3P6jLBvlXjIvfdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6Jl5PxDuuAvizm1m42B3pFJ8XxEwAR3V41ebKOBSZ0g&oe=6A748936"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP-jj2rfQB0Q7kNvwHLyckt&_nc_oc=AdrL90HyyA85R5cvo80OLN_pGgQSZKDWehcG-YfGJcE-1xlMahWJGBDLWVA0yl007H8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK_AqU5K--tZGOy7NSE_rcNK02BcZSAcXpgK4SFNyEIA&oe=6A748C65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
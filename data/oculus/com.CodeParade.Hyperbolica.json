8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVMD1s7APgoQ7kNvwFlWHBM&_nc_oc=AdrTHwkHKoZmgy_YySc7O-6yK5ky5TeG62Dn9O_KCMVagLKdbgyGOSEaQ1nsSAcWlJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_MkvWTnyxfzyRoSOJZyg9EitUWrx8iSisC4HTtW5P6w&oe=6A84473E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJXnINEitLMQ7kNvwGdtc14&_nc_oc=AdqPY1ncXybvAw7lg5xURlnb7BtX3rsJ9c9xwdEE4tH4Q7JPD5RnuVugECZVb261g7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwlD3SfOLLnQaVHBaDmMEdpIBSlXtVNqotRIxqUP6PrQ&oe=6A84446D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2hzcutL_3sQ7kNvwE-0VsH&_nc_oc=AdrCoaAlmKpsK4fYUfW6BDmtuTK2pz6XzhxjGi51ZHU9vc6ZBeWvIfQpBvYeDgQRuPA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzue5eL9SG24UFUaocTTKZAh4Lb8kHzyeJXQJ7KlETGQ&oe=6A843B35"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrqiUknz3BEQ7kNvwFXab3D&_nc_oc=AdoGHWqOcKwCu36c3xXyzdZU0AzThL7nx2bjll19EPsqo0A5hv0vzg-BxDz4oNXWuWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg0e0mD9IQ5yGK1MlZ1UsGN0IPREbVZDMHHo9p1Sk4vg&oe=6A8457F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyMXf3mJG-oQ7kNvwEa9Ylc&_nc_oc=AdoKw98IwKf-JUMPxC4LzQNWqM7W3A2IalEVF2zGeikY96if_To6eaZpb3UV5OOPEP8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwr47akIrg6su7DtlQqi7QJFv6LfwoaMB1Az_WGvgZRQ&oe=6A8465AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br8vhj37FTsQ7kNvwG6MTh7&_nc_oc=AdoO1NNpi7QHIOcWJXTGafAUX7VMG78joytBZINBOiuHdfAuAlg018uiHqG6d2jLIrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMDR7iI2-gACHb0m5zF9KT94Vo1bth4ZriIeaXP2s7Xg&oe=6A845B36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IJjcVcHfUkQ7kNvwETTQ9h&_nc_oc=Adr9ibnklsEPUZknqI0TzyrQLs2ObwoNXEnosCtjmTAUve0t9TpWso5E21WCwHZPJks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOW6JEUR5f9IY0RFXI_SfU8B3qdeq_AkhMKjLrLxeTxA&oe=6A845E65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJEiX01MSE0Q7kNvwHdb0zR&_nc_oc=AdrHghBky6eum-e_DP2E3SMiaNlLAYWbqMnfXX9w8ppz_72OfUKTixwVJ3mZxD3Ujvc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK94B3Ov4MnXNmQor4kxz8aGn7OmuzQjhSDEgK0DCUPQ&oe=6A54D13E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr3oolhbwl4Q7kNvwH43M6S&_nc_oc=Adplawny3KIOLqlYprXGwPLQxuatXvmH_Z2UdO5vEbm60cfvKyijpURmPshaCSdPgJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMpeiZIV2k9VIeQemTc27OI_LAkxhIINwUk0U2IX2hrA&oe=6A5506AD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a365VTUYBL8Q7kNvwHfThBB&_nc_oc=AdqJ26WN9LZXfpZkWbr_0i8PsVoARRcHSxnsuaQD-tUIqPpcw9KhoXJcAuSagFzq0EM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKK-_0QB9EWIJyIurgpzicGIgWw_H7RihkpX3WP6aUAw&oe=6A54FD75"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQkQXd6LLzwQ7kNvwHa2eSa&_nc_oc=AdpygJI3e5Rp0goWf8o22TziV4nta8DYcf9lfervFObo5BHT0aaeOew-s9qGAEL4hHI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDCQlOCCsVKy7DSTlVO76o6Unj0BvERczCvm9OC1tXlw&oe=6A54E1F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6eKP8m4J5MQ7kNvwGOIsGf&_nc_oc=Adp9w8KDlDUK_CVP0PyF5tfig8S2z7773hBoOz_aSfMXR8z9IDn5JRW0KRYkNNHS_js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1BQLRT2TggNAvEjBR-tJzDrhR58O8HnefRRAmVbef4w&oe=6A54EFAC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JxJk_WLZswQ7kNvwHUEd3I&_nc_oc=AdqcbWxZbcSf99e8zbPPb6ZxRPC75_NKecb42KeOWGXm8L5QVVPafKp0kzw-sItuwmk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsi3VJcze7xjpjrBdVUJNeCM4--CRO4AI-G0L_cYjDuQ&oe=6A54E536"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQgOLNVtcoYQ7kNvwElDoss&_nc_oc=AdptBxwKPsNbaOml1CocLbiQsIGSF7XEH4GL8WVTpFZD-yPw3yMwXdo1bYPQMlCZSm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-YM7G_GM0yLzwrXtpE4zdToEtAyDvkiUdA_pWzh9qNw&oe=6A54E865"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
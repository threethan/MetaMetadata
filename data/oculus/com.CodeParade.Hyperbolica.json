nc_sid=6e7a0a&_nc_ohc=oNgP5lv8AxUQ7kNvwEDd3iU&_nc_oc=AdrXVCLt9wlNa636QOKo7AICuVV4niNzqwUNXvATxgK2twJYKNXZvz-XXfoOaB58twY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDnc_LKi_csiXfPy1YqTEbjBAsJvlYpFXj0qGhtqOYzg&oe=6A9429F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP51s89TUjIQ7kNvwGB0BgF&_nc_oc=AdorHZABhW0dRk0gSkRBhgEeCzY8ci3gXSZxKgajsTAdrypvM2u3QmNlr_ZGUM6wyJM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs6YalaIgzycFPxCRf7Spi17k4nGbN8R8v6MnmWWdQkA&oe=6A93FF6C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN3fBsZWoHYQ7kNvwFf5V66&_nc_oc=AdoX4UZVR9wwXyO9cKCNzWvPfivvV01FaSnzvI0Fpxm49t8qo_zHcYned0_1yAgIoV4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3BIOmDRUQgrUHT6QSRxIxx41pVwaOZDunutFV090-qg&oe=6A942D36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mB2eVLFnwwQ7kNvwFkVRFv&_nc_oc=Adriy6sTB37M9z9Q3_5Hlx6tuznZAwQJuvK7sPnHUus8dueG3FcUVtFqPh-uayIQ9ww&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGne11-jbrAK8DeH3gf_b8nDuFWi8fKQO66js7Y4ZauWw&oe=6A943065"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "530600385519685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57568668_2260772697414
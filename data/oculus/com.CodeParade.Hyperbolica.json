8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-jU_ycAqH0Q7kNvwGuRQko&_nc_oc=AdpMNC9Zji5x6IOtLZFIpsknN1z_lrUbNghi0QA7ZNoL2HR0WA4qGRqSqKVRIvY906s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhPj3bpEv38J_-n5L15MOzNnMVxGp0T7WzH8-JunLJ7w&oe=6A79BB3E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03Wh6L20bXwQ7kNvwE6aEpk&_nc_oc=Ado9A7KnKlwLvHzn4MFWgUFy1Umc9qS6Q1xCM-6z8HXCkFx5W1hSOElkajS6gPfNJaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHUMFlw_gLoMZozHhYxnJKJa8NUc0bzZVHXMPeBY3l1A&oe=6A79B86D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NURfNhht5CUQ7kNvwFiXsDu&_nc_oc=AdrlUcVDaTxGP47BmqCpvKW0DuoMPbzcYC3D4oFYdWFia4dyD5S308zTZqsrwiTATvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-xiHNYgOegDXLgs_LsfrzZPHRSBPikW7UX363T8IBZA&oe=6A79E775"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weHV9T-uhskQ7kNvwEweCPm&_nc_oc=AdqvfaRRdQTSJG-B-tmmmGxhXtEambwf6fGf7LsmRmoHwCvYyn1Jz-Gt5Kq3wZwuSLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbMrIbl8i4w-EoBH2jJvXzLtZd8vfeEmnV-m_BFLsYYw&oe=6A79CBF5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw7X93Ea3UcQ7kNvwENPRD7&_nc_oc=AdqYyVMaYT9w_d-hEdu5mLvOlfgXxDzW4KVbspXxDV-t-W19KUDrZUekQlaVOfZi2xk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9o9C9rTPBAxPoXUC-uYkx0DouxogCrtxfaQ7AO4hiRg&oe=6A79D9AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uTkdpYRqfMQ7kNvwHAA0q_&_nc_oc=Adp2ie2Tp7Xobcd7n9LqJxeMaAac13UQvLS9ffGWQ-2GZymJ5_mosorBPxktWCy5Vk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIc5L8odD7fH4fOW8XdrKdFyzhtPgVXa1b6KHBx8iU7w&oe=6A79CF36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aitDdoQDpE8Q7kNvwE3DZGt&_nc_oc=AdrWagaohSGM1jGknvXDR2U4O7lz4auc7p27rfqLapgAuPKa0PLQaOzax7fZJPCEFqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1ysGGK6ouf3mRWbTpueM7ZzLimuULMb0OW679-vtNEw&oe=6A79D265"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N44JTy8Y45gQ7kNvwEQSwje&_nc_oc=Ado8b6ASMGPRrTAnfklwLAZBMlqhTZwNXJUmdEKVEDrLGBP_2GfREvKjcbU6BnIerKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30wPLvlU1HDe-K3H6FBGnTfoW9-5T7KJP41yGCsTHhmA&oe=69DE2A3E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxYG3fJe5PoQ7kNvwHOhkqG&_nc_oc=Adp-tYMaCr5wW3iIHPOFcrl84pGQsuFFm0ipEMTcoQhKXau0TTnuuOv1sVOa64r_CPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qeEJ5VGEphh5tsqbpfR7pvufxFkNeXoI3Eg7M-QH6FA&oe=69DE276D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-1cc8929HAQ7kNvwFC73H2&_nc_oc=AdpnAmIHIjycX7-TtYoK2bawenGkjXvv2S7t4THSIRe00wt8uGQj-rqtm0-rlic3UBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vgLGdy8_MAHicEbshE3GzAJs5cfXBCrl0yqX9D-Yzzw&oe=69DE1E35"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJDbJd4F96cQ7kNvwE5xGNM&_nc_oc=Adrvnjwm-QauOk40kW0xiwfcxEGegss-eefvHQHk9WQ0M-ULJbgvrcBfbwImQZ224lc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CwetAj-Qa4K4VQpgmmy87iI3BYG9iQQKrE6oynQsvpw&oe=69DE3AF5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoZA6nCJExYQ7kNvwEpHMMT&_nc_oc=Adovu29yNMUsbWKSFyj1mZ9AKTcmtZtuGpJSxdHBMHqRYx-Dml3GP66X8K5aKCrwzdM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Mcxm3XJuDddiBqCvqb-5JoRCnIoCu58_CX7QUYVy1Lw&oe=69DE48AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw2Fhz61kgcQ7kNvwEOxasf&_nc_oc=AdpNk03PX2ndJnXjhpXAkJuZVA5_dRgZpLoMGYZvd_xgCe9dJY2BrYce-KNf7BD4_uY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UdYqULUaDA7x5LN5E0xXL3mDo2vFPWmyjL-19brxXHA&oe=69DE3E36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11XEtLEIXfUQ7kNvwGiyUOP&_nc_oc=AdqP8IbB_zvpKCJ3Oe4SElR4_0W31J5DWrDV9UqIM59bWPxPPmjthP_cIhblnUAAdKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J3lo9V_mUvSDFR4Zk9Js6znJNR4I2VPII-AQLGjxrKQ&oe=69DE4165"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
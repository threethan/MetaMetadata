8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OiEqG0Kax4Q7kNvwHMKHmr&_nc_oc=Adpsomk2KeXlU6Z2FrhE2Ykxu2btZfeh8geGZ4uN5cXtYPc1dZV1LapdiuWtU3UIm8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ACIjV9ci5A5KGByt9q7QaYMSR11BpXB8el4uP1KVixQ&oe=6A47DA7E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGMmRyDn1IMQ7kNvwE-btuh&_nc_oc=AdqWCw7wmg0ode4PTfoy9hOnXRy_Je39gaZq-Kibl5y1b4NpvCr9LmJ2NQtPUvC8Ebo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lx4sVcx-auWUT7b5FupaMPADDaNT4nIH8R5eOqPkylQ&oe=6A47D7AD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWk1P9oNsFwQ7kNvwHtUCpV&_nc_oc=AdrxZ4hKQOnyTCakRb6Qg1_y_tZ7z0_6za8jjOqWmtw8iTL82ZPB5UOL5G70EWh0zI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UjaZR38fdgrJYJ4nvGXzuqIJ6ao8nzhgExhn3AuMslA&oe=6A47CE75"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Da5CTUKxEQ7kNvwFieYIe&_nc_oc=Adorix4HTW5eXSPCHtsb6AImNaQCox8WuzoXQUIUEWfWT0AS6LJ2Byjt5VwvX6hUiNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KIUB0xoerKhleX7YaJPJQ-j2c73h8W2VK41p0bFTjsQ&oe=6A47B2F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAYolMBFXlkQ7kNvwH89FAX&_nc_oc=AdpKCxNYoXcXGJfwPdsG045xskhy8YwP3Bj6h6qGBD5fpjT2XTt0_G0j043ABJ2Fltk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B2Uvu-KKJax5mXKky6p_pI24dCw-IOucLds7LuHwkkg&oe=6A47C0AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddfR8UzmLr4Q7kNvwH8vA_p&_nc_oc=AdorxIkebv19K65vvduQ5SqoemxWOcMfpv53WDw3uwxyN_L6WIupvpeT5APt3hxUu24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ahl__IWNASef58Ew_kStNrHZG49wqCt0maCd3Zv4lkw&oe=6A47B636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwra4QB1UPUQ7kNvwEBK9D4&_nc_oc=Adog0Lhn039MUwt5FnE3zOzeIRn3i2JO96lVAz2m8HUQ6ClHfPghT5GwuiL_glco02s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HxyhO9sh8l94Eutk9ph-gUSMa8lOOJf0GR5Ol73EEeg&oe=6A47B965"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gClAP7jdZeAQ7kNvwH2LK7J&_nc_oc=AdqSH-_msprAKe8plB_NvnF76ThsLF5lGxEAlCq7hNSA_RTamCHL-Mci_OjrI_vWv2A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CiUB_Aa4luXo_wMpfYFCi1bN4Hf_bVqQLi_84UQz6OQ&oe=6A107B7E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPqCN9LBhikQ7kNvwFGOmlw&_nc_oc=AdpM-EP0WfW5257rcKVgBcjCaB3RZnOeTl_-u8-avFuZ7Vh8OF_6kpGkREidh5V0WwE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PnxagHrLF_F9ahrcYRROKfiVuOTJLEPhyB3ffwYtLnw&oe=6A1078AD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLsnQFys8uwQ7kNvwGemGZP&_nc_oc=AdrKK869eDyJOjglMEUVEBAtYH6bWikXENn2PC_5o0uN06ROzoaGXFqygoPsmKw9ZdI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rzN1DG7okl5ZzbZ42wXospaN7KDYroXMhfxXNqoGqiw&oe=6A106F75"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1L0D6kAJ74Q7kNvwHbFMsG&_nc_oc=AdoowfefBVaMdt4j2fXVMyYEocYfbyzlCDaFuyMdrWfuSoGut8yML5zC2sIoBu1Lgvo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gy9KI-63NO2R5o5UNK8Nq7fnyKfS-nKQRW1A-MODFcQ&oe=6A1053F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHcmeNkfWZcQ7kNvwGS5lsW&_nc_oc=AdqkTq9Y4xDaTUevb33LSNd9ciX1oEDO_atXhScP3ZscEuk5slxJ1WHBmEKDl3ILMNA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71kEzEBOjTFrnrP42i59UjH3SyzU6WXcr_Mf3gabI_EA&oe=6A1061AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANi713ncnQ8Q7kNvwENVT_B&_nc_oc=AdqTNH4PSddO4XhdZdgDfjGde9xN4SIIuKnmcKr5nLtfMCKRsdoySbvE158LxID0sLo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tDO9MQy4VSImws7LMliFy4Actzi31n5v4rcfSVwc8Dg&oe=6A105736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3iSMu2jcK8Q7kNvwGf1qIn&_nc_oc=AdqwEHkiNcSTWGq87fZ5SyiRBg59zKr8rmm-Lc13uNwYpkGokCgu3VbFeaQhoCumeoY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74R1HY72df3bZnuI-6UgvXZK9Mu23b_VEWfu5XrH1ACQ&oe=6A105A65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
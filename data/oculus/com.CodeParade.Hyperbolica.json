8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krM-nR-NoxYQ7kNvwH0KHBB&_nc_oc=AdowNTrgkYBwSrKv8x49wF6lWXpXk0NN6GoLkeU8ypRmj-U0FN4YD4KSmpH2xuURzXo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-FznlAqJ04HycxFja28zF9OKv2_Nx1h50J-HTXL_tgg&oe=69C3CC3E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuRrbBKDaIIQ7kNvwEmx0I1&_nc_oc=AdqtCq26WPlpmqG2U3YHKWcf9NsLQmTAdJsAEWL3YhW9tNNK5WW5GoC4VeaQAvGw6NM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGPZdrHeblv8DLYn1sFzQkn4SuDqHMJg1ZogWZsGMS9Q&oe=69C3C96D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnUTEEAznMAQ7kNvwGqkpYz&_nc_oc=AdpyyKF8l0e22U7RgTwmVduhqeywPGvlxv8LCvHjMJS3PJcrrXyDjbfdTgHKWUyP2I0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVXjYAfOSnH2adrFMgUFJ4GeYCN81_2FxOrUo3nq7Ueg&oe=69C3C035"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BHKixLkb0IQ7kNvwGXc0k8&_nc_oc=AdqDVRDU0McgcQ79oNl48TuTQ3RQyts7JsLudoiwmA5_rp7psn4cypLuoPbs6uw_hIg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvgNS_cV3Tn0-e-YYqGlZa6T85mCkzSbdRLfwhYD1THQ&oe=69C3DCF5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cppvd63JFl4Q7kNvwFU1mwl&_nc_oc=AdoNc5OTLkFka9ADuyC536JB3SNV6vlfg-SlBh6VabisaJQbXtlm0m0k6cP5Z-uMyKA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy7akk3jTOxpxwr9nI3PLORC3N6e2srQsnobWOckX0WA&oe=69C3EAAC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMOO4wtMtpAQ7kNvwEbabxr&_nc_oc=AdpuZYH--6FYYrsjG-qaaY1zldwN2L14EX6jHUrTOCtoStEFJqyVQo3rx_LBGBpC2EQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwrklr6QsGWR4IDrbxiYlGJZuMjPzcgeODKx1EYNkYNJA&oe=69C3E036"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBDPpx9hk1sQ7kNvwG1XWdd&_nc_oc=AdreebK29F5OdlsDpOg4l8uJ5ZYcJn5oYzbaf-N3vrrijduPpiuBVx0-b0sM9bwAcVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3RYLMnj2InK-EnBQT-J7XkqsSmDjwiuWiPRyncMpLaA&oe=69C3E365"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
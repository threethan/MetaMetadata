8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2EH0oLUNnkQ7kNvwHlboO-&_nc_oc=AdqCmJWW0p0Dzq5ehv-Iex6Ryd8K2fixFWLEAfKgcjusujGxbrMmUU5PJQIY0G2BbRA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7dQKhGA2znTxuQ_VGmqpGIrm4Tj2ufvsvRRix8unQiA&oe=69CBB53E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n8aFKmJa1EQ7kNvwFRaznS&_nc_oc=AdpI6OF_HOOB5LxL-68IPhewEbT2SEK5bHDGmJUrvgcXBA2X5tQEI1FNwX2CRPSePFk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-2VjDQMvU_zj6k5iV3cSpxzg3elE1-69PZenrAfwGZg&oe=69CBB26D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9mWq9O-sM0Q7kNvwFMZWcN&_nc_oc=AdoMbc9Kcbqkc8iqQDpdynuFasYzIWPCfpJ16U84g_beF_XR94ia85ZFGv4B5gS7tUk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNpTane0nowULb16GTmuEEeef6Lpf6O6KRVlKk2v2NpQ&oe=69CBA935"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxVrQIqgni4Q7kNvwE7lQaB&_nc_oc=AdrCBc89EZv6HSz4NIl53QZRwahITq8MsexbkqdIX68Zy2UCTzlQJXB-0IX25C4e_1Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXN1d4N6NmvZ8xIfO9E2EEt2JqVDQKJneroEMj6tNgdw&oe=69CBC5F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4JMobsH7IgQ7kNvwHsMmc4&_nc_oc=AdoTNKBjb9q3sT-cDE9qadY3hS1x5vdyfakQHB2AsPiKAYjuRgjTfBw3KNpogbds0N4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztX1WeDhrEoQbH8m8vyfOOTOTBVe34-AsQL6cq9BzpnA&oe=69CBD3AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zhd3mwaDRKYQ7kNvwE_jWEx&_nc_oc=Adqz1LLkZ7wQEUXP4ospd6tLAXT1RxhIugutuuFUa_LxR9fJPlTTI1G-a2_j48IOHYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyBSw_3ukLxLZr2k1qxjYoanX33mvhUzY3iJQLJv8jsA&oe=69CBC936"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQU8Wnuz2p0Q7kNvwG8by8v&_nc_oc=Adrn2-3sybd_vMowLOEsdHAcG03VcOck3o49vZIIdfBOGOX96NbSyZM7dwdpYJA1-jU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdCddvaBadlhxEtruCc7HX7YpuxshDQFasFnLP4WsaKA&oe=69CBCC65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
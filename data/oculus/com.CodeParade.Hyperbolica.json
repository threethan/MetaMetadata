nc_sid=6e7a0a&_nc_ohc=OOMyKEYIeLUQ7kNvwEhImpy&_nc_oc=AdoWaiSd_kxuXlqcrV5qlEaTOw4Avej8mCKyqSwa8GiWjuTVFoDaYZPoGyBDXUcko7g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVq6_K8RvJ6tGKvseyJq-ZuNksd8efdC5FiH1zXFHv6A&oe=6A58D675"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcShT4342ewQ7kNvwH6NHI3&_nc_oc=Adr7qnJxeGLE43xSXDNMqAALWXM4HrvYNCcPT8XqVuWutgY4xOMgl5Fq7cQ2OEV2eqs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWqRX98kcrHtsMJS5VuG0v0bXd4TCmfR-I2VjxdNSKnQ&oe=6A58E42C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIqk9Yo08IUQ7kNvwHEEvPo&_nc_oc=AdocLZweeyWXl_6_bYXzZwHnCPgFVBI6Cb2s6NgyISvz3ZEfA8fHbD8raQusNNKhvCg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC_LRgRenYh2T__g5S_s0m4gw585Z_2-qLj-sr4su-tg&oe=6A58D9B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV8yGb-tHAQQ7kNvwG_Xax-&_nc_oc=AdqGyf1wReUnyjG6KguMMBseUT5-44ARDtwZ_WnhMGOK7ZGvoPUmNn96Rim167pJU3w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA4TaQa4ndidCHQYuvOLeMdNz1tmwMVBzHLPZ0K3n57w&oe=6A58DCE5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "530600385519685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57568668_2260772697414
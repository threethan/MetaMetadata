8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfukZaN1RkQQ7kNvwFQED2M&_nc_oc=AdpGQbhhvS1DBnJ61YLeuw4uMHzKsyHR1nTQBiy46LKp5s-nhem1fynLEheUMfst5oU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wPfcuYA9BWzeG3Yr3Ka-NdAWa9sPP5TzLKsUQteRbpQ&oe=6A3E9FFE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMmgYcVJKoEQ7kNvwEH04ae&_nc_oc=AdpB3HSCbBFUJEarS5K2LJLpcSZHh48vR2q3KRGj8YtuLKdUioQ-SsifiP4QPCiLRxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LR2DwpqxdVRJE33BsrkeUerDJLGr6FLbR4OqQOA9I3A&oe=6A3E9D2D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g3kaY8lO6oQ7kNvwEM-7eG&_nc_oc=AdpJ6Hi93j-wtqzBBbSX3p6_nCvV2rtIPFL2d79tw4hknsmE3qshyZe815djy-954WU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TgWzqugbnXEedblRwjx4USfYw1pMy4_TKBTXr588vvA&oe=6A3E93F5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9mPRWaKICkQ7kNvwHEagod&_nc_oc=AdrWuFckVhjMx9RbBPJd-FAoIu04XFxiwJe0i9fqqPEwzn1SLMiak7meULYi5H63Ac0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DHBifcl5IB0yGXuWwoU5cyR6yEWVKISwI6-5ZeiTN0w&oe=6A3EB0B5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HciXLInfqigQ7kNvwFM-Ug3&_nc_oc=AdpGkjSIU8mHD-CASJh7gYCCStW6wgEUGYz_IEFp51gM_UobgYnlj0x0ATcorJ2aHdc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FU71BUEbVp7XV2B_uuiJ1IjyI7iYi0oKi7OGBMUM-rA&oe=6A3E862C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d3tJRzBhqsQ7kNvwG_BaxY&_nc_oc=AdpzHT-C0rgsRV4DAhpanZMpXSa-FMTbpd4iRRmh3Rjvn-eoMjaXLGLPj5qlVywrxkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ekfbym-uBkjNVVmCdJjVhs2K3DWUKi7akkEBgi5a5Vg&oe=6A3E7BB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QHiIAzhEgUQ7kNvwEWlSHt&_nc_oc=AdrO_gLMk_jWj4FPMNSH-s2rbkodn-Efzmubob4A3CHUFhXL5MEUH6NSKcnS2qY0Ge4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--UoMJVMD-flaQtstrbi3SqbkTesok5eztQIO6686Slg&oe=6A3E7EE5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
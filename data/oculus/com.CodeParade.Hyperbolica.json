8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gClAP7jdZeAQ7kNvwGMa8GR&_nc_oc=AdoEFYeXDNKNL0rDB3KHyPn1t3Z1uyBZqPdGMPIKJbKh1dVuBo4F19XB3wLJVIrc6x8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JpZMHck25fmm86H1bCT-q2z3Vih9brAy6Fb5YxsetJg&oe=6A131E7E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=398w5kIJgrcQ7kNvwE_SSNP&_nc_oc=AdrsBZdEK55vzhP8UDQ3LYcw2Qtt7duzkqW6no8MZHLve1Tzi48-OStyTs4PMVRMHIk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D0qWB3b4RRXRffhSnySyS6lXpA4uUUEWLFHznFHQeog&oe=6A131BAD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrIPoIpgU1QQ7kNvwHs7JUA&_nc_oc=AdqUsjTWiV1_GFnOozUuY44HW5ONtOa_9Qda-MknVXBmQ7XIqGw3S-zpJqL17bzVdRE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nbRD3A6pR4dY_TA6WGbcUGePSU6JhHt7tDZOErCnH9Q&oe=6A131275"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1L0D6kAJ74Q7kNvwHE5xAU&_nc_oc=Adq7KncN2twjDGc2ItdSYB4LSJdk1ww-UNu0u9So8ezc6pAFbGe51FAiwqTi43unPLo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j4-lHpk1K1il8cdQVhaqR8Zkx8mPwT_fBMkLaB3juAg&oe=6A12F6F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHcmeNkfWZcQ7kNvwES0vKs&_nc_oc=Adrkjuv3iQcgl9giXjii9vFJ9nKx4d6fCoIJbZnuy1-pZqmhWgc6U4ns7EodD8S8vi0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5slDw2g9e1NJ7c1q1hhqVETyhezp02tMyLRVpFwg3aCw&oe=6A1304AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJijjFlBn1oQ7kNvwFrUlZi&_nc_oc=AdqY4lXJSJM9Ac6N7m0e_j6qprrwY4j6zC-oaUTVXy_MOGkfZKikNd5fYGkJbEdZ13Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kYVDeWtMPdD_YlTCvZNnEydXTZ7r_u9v_ymgtp_lG7g&oe=6A12FA36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vInANgxgfcQQ7kNvwEa_UKw&_nc_oc=AdrPnrOZqMEVn4eiJ_Y-wme0qvMIT_4y-HdGK2HMWIRQ_jEdOWjVcDnSlqeoOcP0Rbc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I4f5Zd_YUsn3Y4IRcTEbKfbsjFYcMuXeLIT6f7dpTEg&oe=6A12FD65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
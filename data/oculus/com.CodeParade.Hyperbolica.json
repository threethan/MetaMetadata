8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjV21WaN6TUQ7kNvwFjBRoh&_nc_oc=Adpya-A_MndGfzerJIdbc1THwrWWcksFRcn-jjMrwa2gdOVdTEcYgJ0eRp4hJuqW3YE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGAqS5_7JjA-eLXeLvTcHccnCpZjNe2gA85RnMlXaTgw&oe=6AF9D4FE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWovaoEE5MAQ7kNvwFdAXsE&_nc_oc=Adq4-c8RjEgrG3ZvVZv3aEnDTFJPmc2XHgECuW8-jGk8VkN4WqaaxIR7GH54JVXHyfE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHVVzMj_XBK4C_NAGPI1v8kdPhr4lu3ErcwVDh5JZcHQ&oe=6AF9D22D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5NM-u9FI68Q7kNvwHx7g8R&_nc_oc=Adrg2K6K0215RAf3it9nGBdEtivn7lnwvneOrY99IgKhCmF5Ufnx7PxCynPH5YYMBvY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzte8YF_FS56T3R9FkMGcuPp80H25qvgZvMhOAhc3K2w&oe=6AF9C8F5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMfEO7SNWo8Q7kNvwFa22je&_nc_oc=AdpHU3d4g_VCNlQixo02Wx49Y363K0RKHQdhxSZX3BkXoul6cC-DKLTOZ4KO4Y3quXQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZf_FHP44KAfKhS2HQFCmZSC1T9veGkT5cV0jDDJRXyw&oe=6AF9E5B5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyfT1RNahlgQ7kNvwHYOwLD&_nc_oc=AdqRpdllk6Hwor_aWWnYdgrDW2gE_NGy-sqmBLxeZ971xwR8WzFWZnpHO1wG_LTqfdQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZLfGU08myv_-LQ9ok10LN79VRifi8z62-oq81t6haUQ&oe=6AF9BB2C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ5OfiamwnoQ7kNvwG5xeog&_nc_oc=Adp1WuGHrmALfofZz15n0qp79O_GQNOpWkTPfnZStOGrq2nquBnN7vCX5RE0AGAPMBw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzH-52yTpx7dll6kFmuHRSX8upq28gCFJOpx8mZMX-Jw&oe=6AF9E8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpYaI9biEAQQ7kNvwGOIofN&_nc_oc=AdooMKk6V-_bQqUkf5kgS4MFopTFTmZSIP4d2SAPLDP00KqdJ3vmyGZyA7y9xRFOcqI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVa_9cXIEVqLKo2Yv5rWcTYsKmCQB68zkxXb0faZiGYg&oe=6AF9EC25"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
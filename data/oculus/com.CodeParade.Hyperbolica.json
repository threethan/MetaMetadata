8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJr6HKKqv90Q7kNvwExL4P-&_nc_oc=AdqIK6L5UuCcsdhEpbb_1KKVMysWS9LFbu4psm5PyzBB5N9wel85te-HlGf-xg4k0GE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOfleOLRAala9N316vsqRR3lhj-6FZvhzUUO6hvrBP9A&oe=69D0FB3E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w3b76eDMicQ7kNvwHFMuZZ&_nc_oc=Adreyy0uoyEBzwaDOYtObLQEhyg8uDMvEY-xmTjNyJYMFBZZs_Lp51HI4U2MGGP49Dc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdNiG-DoL2PnTI-SQX1GKz4l5X8spHKVBOpuh6SfI-6A&oe=69D0F86D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYGFBqtWY3cQ7kNvwET1R2c&_nc_oc=AdoxNveOtV22HuGHyP4EQh9cqzm69C0AIyR1kY7-q8bo5eS7Fi6_3RnP01qs5CxLyHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoqVDoTinjnwLO2h8itKoZcxnN5HgQ1A-6bnk9NFHNPQ&oe=69D0EF35"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g1eWUvc9JgQ7kNvwEU3dmF&_nc_oc=AdoM78wKGcaRDl8s04X5z5qZE5du4717Z2AI0Jajr7SSoigPUoCi9LMQyK3h02S5Bro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvNYXx5WL-UaO7huSql8FLKc5RMTDg7N33gHxTy5Defg&oe=69D10BF5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em8scXKpwBoQ7kNvwG8d0jy&_nc_oc=AdqR4jZy-Hom0zWz6RgwMUuoeb204bunlbtA_fa2wraDM_BeoTwaQOe0SUYOoOTPT-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-C6AQasdFdpoVcGEgXwPAR7r5zI0I-TGoBo-YlOyuAA&oe=69D119AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKcnbDoq1aEQ7kNvwEnEmz6&_nc_oc=Adqt0saOSO9FnCxl3qqIy78H7aO3cyfjDTvI3z2uZwXpe6BVmHT1LDCHgau5bbHVqko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxD3VQiIhjiMqfdPULVLG6I6BTxNe48NRgzlCa0aDwoQ&oe=69D10F36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZDq0qMNqcsQ7kNvwEvsSzi&_nc_oc=Adr-gtabxOZSgg_1RVuVbr448wV-caT5ZEz-7ytF3riH3D0Em0tk-XKo3PVGElMebEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyE9KbUWUepgIUYbrwmm1M22d_tpkMkKrd1t-99mx1rKg&oe=69D11265"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
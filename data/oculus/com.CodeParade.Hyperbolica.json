8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEU4zJQctP8Q7kNvwHgIXBm&_nc_oc=AdouT7K7D88qQHEK1btEWQH-uQSW8Q-8z6md4a0tNdkgMNwgJksuX1T9LaboC0EyFew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM0mFRjZQhmRa4YWvYS8DRwUq9KraOMxlWNP-McUu9_Q&oe=6ABBDE7E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxENs2h55rwQ7kNvwHbqh-a&_nc_oc=AdrRCLqV3ECJK65jyD1OpZt4uCAPiKFW7o0CTdefnnuwxev2_c-RTuZHMVQdZSLlQQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItIpjjvGQLji4yPrBDscDYRICFNAHUeEftOLyhsNq_Jg&oe=6ABBDBAD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msi4s81Fu9kQ7kNvwEnYqTO&_nc_oc=AdrQMemFrFbBh3eSIIlaU9fvNLn1zJKEocw5zAotT-hTcaTxkCX9rDN85v0SUeZsMGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCpqrAQ6S3qOk05TxkiBi0Zk9p3txQ_qePNJxUZw4Evw&oe=6ABBD275"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2VhSCnsFPYQ7kNvwEonKUO&_nc_oc=AdoicxKMlOZDKxAxCbcBGh_n2AewnWrpqWXFqG0LYS1rDPmeMCHKomVQGFUomkIXsZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZhT9T8Hqwb02raDCcut7zYH5vfBOdmjf-qjs-kTFNkA&oe=6ABBB6F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciE9D3xZfaYQ7kNvwFC72EG&_nc_oc=AdrgpbvxAo30eEaIv4pBB-bBOdeVo9Ng810xLrHTH-F4CVzYfhzbA1sCiOrknVd6Wn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgypyMHTRhykSYlLDQlwu02UF1VZlOfF6pdZIHtJYxWA&oe=6ABBC4AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JLzRmWC_nYQ7kNvwEzU9Gx&_nc_oc=AdoPkOIjsWG0Rd2lDrZ0E4jaFncTagFxWvoojSBaitayH1FUfs3ULiO1svP2sXZkXfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKJUIt6sAwK56oGyAnVDjbO8OwBKlzESleJqOJYJrFaw&oe=6ABBBA36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_FciZcS5p8Q7kNvwGJGU4W&_nc_oc=Adp9T4BFQC2c03Z3_gUojhPgITaI79lLZO9yEoUnahG50WrSvl4Wvdt7QlMRbiThtbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_lQdT9yLxdHNzMn1cky9xn4G0a7IuFwLJAByRsL5vSQ&oe=6ABBBD65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
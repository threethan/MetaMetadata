scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-hbfwuZbSAQ7kNvwEsQoTh&_nc_oc=AdrtxwbMs91tlwIUNLCphgGW-oe0IFQqTD7l5DSD-svJynIWGv3lVcncMe3s4i7Aiy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgxMZ6LQkP_lXM4fM-mIoF7gvm1Zi4ciA2nokykUwwLQ&oe=6B0DAC35"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpUx2AlnmLEQ7kNvwEGvvji&_nc_oc=AdpRF892CS8iuHiFfC7oo-o1nhZ6OyNeXjMXU9S5UlxJzezRTJ9uGJl4sBHtJSYeHeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTPvSzeCdb8JrglrTKk4EqLjBJAC-6Qrq6lAXgVqMSDw&oe=6B0DB9EC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3fmuF9kOn4Q7kNvwGHAXGZ&_nc_oc=AdrvFyxiYrZMbFlhWTpYQst6uwSVv25fBYib6odvMTzGzJ5esJmgVK5dwBkwArd1jTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLyVAoDWqpmC5oajj3gCHzKu437EbXRx98XtFD88wcOQ&oe=6B0DAF76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFiqN9F_eJEQ7kNvwFv2D5J&_nc_oc=AdpM87Wx4oyCMBR7DtTeKyQikqjlJ7d3d2aC7EXdWw7bQUm-VhISFmgS02326g8wNJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRr_pa-4oFVFbuXVBWwuGWqs5I1WjFH8WRPa6QY6fbDzQ&oe=6B0DB2A5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
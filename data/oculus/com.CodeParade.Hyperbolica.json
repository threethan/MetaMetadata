8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YJ9OztZviQQ7kNvwH9E1L3&_nc_oc=Adp3AerXj6etYCer-ggDWZ2vChdk7uAFN6BVZUreS0zgreOmfo8qG3A92WzmnqujF1w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHSa_WwEO9hTW3oHd9dnsp957j2gTQ2UIbA6zobQNlsw&oe=6AD3997E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3GTFOeV1o8Q7kNvwHd-3mH&_nc_oc=AdqUIHrcbRwdSYK1REaftaSAKj6lI53oO6b13T9gGy790h8vuPKnuaBldBlRQXxCA7g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9i10wOC8-4de3cKQHNI2MiFwNLfWt22UlKlltiZEhIQ&oe=6AD396AD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgIkNUCdIB8Q7kNvwH7Q-PQ&_nc_oc=Adrvhctzc0KVXSqyZm9erJp_L2Q55Q5lcjay3ujF9sGWsnW5Mq126IoMT2c0fSfrqOk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkhcnzzyUidMPAoIat-AgcEEcyjVUpPm46b6NI39nKLQ&oe=6AD38D75"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9XHzCA_OyMQ7kNvwFxqN60&_nc_oc=AdoVIyE1aMAOoWlcf8CiAx9wBzKWPYA5RHCj6hZDR2cEZUnMr5unawSjjVhQezZO0X4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2U-Jo7kzB9CvM4enpzBM5fTbmefBeViTL5Wdn8D_tIg&oe=6AD3AA35"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BFfpNMcnn8Q7kNvwEPxpWR&_nc_oc=AdrSgZdhVYHrter3lHyjVuLAUvPkULs6l_kbBt11w3mfwM0h6df6dgyMjcR93gk-ppA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOStpVS-X4CzRo4BHUj9DBj4yFPu6Wa0jeQJeqgXUcsQ&oe=6AD3B7EC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SHPyGHJsn0Q7kNvwFEDDGc&_nc_oc=AdreqIPsqV3173_XMeNWfvK1eODvxHgXZJkl2G-bsR_4FgrNDWJLRxxY7xnud6BCbPw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2K1VBKbUnLF0RUJwhi-SzTwbX0v6BadI9xwc07o0BKA&oe=6AD3AD76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJw9cyUTXbYQ7kNvwF-xnpm&_nc_oc=AdoMucImks7HRvHQZiXOEqRH58s5Mt5cfZWg67gys5BbMRpdeTCLcCNogaI8s1wAOcY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-wobt5CewQqX1KvI78rshzgwZx8FgxDWMKw9-Li1p8Q&oe=6AD3B0A5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
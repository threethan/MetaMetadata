3145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itLTgzGgfKAQ7kNvwFlAuRh&_nc_oc=Adn_oG4a59RYEv1z6Tmwmdep-1wyaDPmwEfDuZeXt3Hqx5c1c_HedoYMRE9-gdVg21o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvV7KMqyMk3T_4pg1I9P4BRlxJNXZYq7oqXeh84VPmbfw&oe=69A047B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdkweYN-OZUQ7kNvwGcvmRt&_nc_oc=AdkSv-tAoGiDd2iwGJSyisrquUswcIkviGkYcC8zwCcbqQZ4-sH337RX3GvMjHoLbQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvfnFDZeq8TWtvzW7vp6ZXfaKFn9aRNUkk_YHfkw3U2SA&oe=69A04AE5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4873486596022103", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5150110958359664"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1124390368326698"}]}, "change_log": null, "created_da
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIX5sm1AA3AQ7kNvwHYnJe1&_nc_oc=Adqo1aH4TSnNp2VIz7wwLIeyJwSs8AlO4DGQP_ePoeLSdIxP_m5tDrqVVQOBrA2jmlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-W04VTc3JDLImzUBEgIV0-jAi67WQtlf4_9CVlpUyyg&oe=6A3AAB7E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7A9-dk-45UQ7kNvwFntVw1&_nc_oc=Adql3msEJOi4WNX0SYML09lJwoomBPax2Kq6D7-jXpU_AhiBNfZqYXvsfe3LScCXC5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YsKRL_57IxP4IB4w1L_0mw67m5Mm3cjmSEJgJcYSflQ&oe=6A3AA8AD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDR90AQLi48Q7kNvwEcAb6D&_nc_oc=Ado7Rk9cNMRbeQQLYcniBE68wEDa-BOCENnoE5Sw8ewxQMQQvV9ocb9m-PlnJSJm41g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HSKsHAaoa0wwFhw3ACaASofMdYOlvhExld9lyjxFjGg&oe=6A3A9F75"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKoMC6k71M4Q7kNvwHjOHlX&_nc_oc=Ado6NQ41-c4Zyge-56pvcAuHvvI4jG8mXXVHLXbcmtw1YMUaN_c7d1j5TCQAXwD0RV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uxOItRwIUGm9qI9RQhhHyG9nqMwpC0XKT20Dxux3GfQ&oe=6A3ABC35"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYHExrnLzlQQ7kNvwGzZd2I&_nc_oc=Adqr8wHE-t-EWbJIrhidHcus-hlOxJAZyouK_giXqJoSh5IllsRbsKXVBVHNky69eJo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95dGJw_SP8JCEAxt6HsYGp8pFu_kNNRDohkEvqanavkw&oe=6A3A91AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0raIaa84Uj4Q7kNvwHpkXtm&_nc_oc=AdrY0D9J2RvgWh2pT75q-mwE_0h8HQXTusyP2zlg-iO8MT21j-k0e222e6hqK2QN77c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y46a-9kl7zaGnXj_WEKeogE__I3J0Npe8kbmQ030b6A&oe=6A3A8736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kAQijEjewwQ7kNvwF_SBJc&_nc_oc=AdoWolN0EskuHpxr_Lg6W5UwDlK-_32kdysQ4XQBg2_yLado5Pih0J3V3D-RVwdD2K0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9btF7k34jdKP-uCUsSTHsX4pDKAWZMKKv6y_tHOYftPQ&oe=6A3A8A65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
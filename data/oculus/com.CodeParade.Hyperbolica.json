scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CsNcpttP8MQ7kNvwEjpHI1&_nc_oc=Ado4i9fWoSmh_s6h-m2098ya0GVGPZXiZ9KtfmdZoiz4qkmWM-fa7lqykEawhDT4-K4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHwd5YSd8w7leWmDnXe5JhvwDuYCFa2lwVtfLqw5HKnw&oe=6B0B4175"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YNjkLIt9p8Q7kNvwEjZpB7&_nc_oc=AdoEQEHKAQRWFqbsLlwifnV9DU8lDkwdsD3UwcJlAKquuaphSQW3MSOFgwJySB8eUkU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRqQEdcwSfPlHq_tQog9Vyyf3-9U9q5gME_ZXXr8MXdg&oe=6B0B16EC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6uaOauOP1AQ7kNvwFJM-Xz&_nc_oc=AdoVBWoVUzW7bIcDyULlm5KXeCfz7JMOPiHZutouTQsMG5C0a_-XvSa8w9yg2obQ0m4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPjc5m-6xm_064WFkAb5RNgjdh4lmWXwpCp57JMxFCbA&oe=6B0B44B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFiqN9F_eJEQ7kNvwFvAWHd&_nc_oc=AdrzikE9b8TFOlm6A8T68ewyLDF3eqqTkpgsXQyHjC94drZ0wmzsFtEpVLDPUsNTGuE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3Ku19GjkBUIkmrN5SrDQJxsDS4Z4ybTOOTk7cI50b2w&oe=6B0B0FA5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
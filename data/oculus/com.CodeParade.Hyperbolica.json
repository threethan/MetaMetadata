8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lB2gUOiHP8MQ7kNvwHk82ah&_nc_oc=Ado20ugL9fLtiULc6ufSr0XKkLQtDEOIeipyB40w3yZGhdYIVu5vUscATSdGN3bnUSY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1l4Wb_a46LjZ3SM7VrUhzvLhpx0Hz5SCVfVi8UtICOVw&oe=69F5E53E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48vdcfaTdPwQ7kNvwHmPbk2&_nc_oc=AdoHsVG-QohhkqTG0zSh7JHNE400iF5gILGHHO4t7Ux6sT-S2hkTMIMggu36DWDHiXg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23B7DxHrzGyKh-M37jia8KhZ8yA9QIYkqBP3FQiuZ3og&oe=69F61AAD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sws0OAb4booQ7kNvwFxMfAU&_nc_oc=AdpeI7tKquXdNCJaJ1ujSZ8e-nzD9wYXZ18TRhXYSUFKiwxkePRN5HHErCKUiq4XXHc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2P8Fj4M4cpZ97KZ22wu2Dimq63R4HVqZzlqMpOaQe_hw&oe=69F61175"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I1ZgFBvXxkQ7kNvwHB8qA3&_nc_oc=AdqjJaKR-l8uhrpZE3Saq-p7J3inHta1ywx-yYGh8P8xtrH-ziti2hShRFkuo8FE-AY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14CErb5dWUYRg91LF19BeqEsydhcIDHTTIhimZObgPCQ&oe=69F5F5F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdgUMS1fFvUQ7kNvwFinUTm&_nc_oc=AdqkLVfkw1-6nWMQMVuS6BXEeWhaNSy3BNcIIzOd5T7Tgxxcr5WUyK4Gi_hVwS5PG9k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0z1KOGZTFBYXyQb2SkNIB8BPgSCKqAofq8EONcfY0mWw&oe=69F603AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-XI8wcEa14Q7kNvwHgxy--&_nc_oc=AdrmDmOmFXm69-OuKwPafOVNU8-wGh5af0eHNpLdQdcNryXxDcWOjM5aRA62pRfxSJI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xAwCoQbTwZRjFBbuG1gcP9nJSpv7qb-F2xK11LwqdJA&oe=69F5F936"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCCBKhh5rgwQ7kNvwEfQ1Kn&_nc_oc=Adoja5v0xd329ZeKm4Z58LOvCSHN-OoRlW3rby-MXh8BOX-in2UV7iU2UbL9f-vaxSE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32B1j-iYueH2fBt6FxUWcmUjbeMhdiGDKK97O74omMJg&oe=69F5FC65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z71BqfI9cQ4Q7kNvwHWH1Us&_nc_oc=Adrb3OT9aBJxKJ65M_Uyc3A4vSwgBNztUe3uxs6akHsy1uBzriC7BlIUt7xk9GMSqD8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qjILiTN-N280scTytIENSuyDTp5PCC92skZRQ77pc_g&oe=69E764BE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJH5Y7jCIywQ7kNvwGRolAL&_nc_oc=AdrCQcvQR3hY19-6UQuwkFYwOOgk6hp5JBtk3xOLNUaQizyUxGmmOtaDDlPmzpInVaw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nl_PzXyAj8ub9hhn5c5TqSAfMsFYThYTptV8C1-5V8w&oe=69E761ED"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CByWRxoCdFgQ7kNvwEcwZ85&_nc_oc=Ado6ZojYBbR20Hq4btDzL_WSPRMJlSNkL6UMnnOMBU7eiGD-uUSRf8VWThKTCBIrMb8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36B9q7g6j6TEt9hjSgR5XOPZJrK_wGKs-AC40Inupkjg&oe=69E790F5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWRTpYTU2EYQ7kNvwE45pGj&_nc_oc=Ado38pEPucWN124x8BJPp3OUel-uhzFg7GraytRHpymQg_PwS0WQyQbH378WvYruy2o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af373l282H_So58GGsvb34N550fa4SNw9S1_2dvr5_WSgg&oe=69E77575"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr3UwYwydNIQ7kNvwFICqJo&_nc_oc=AdqZMKAGbag8HIrf-0tkULjf4bafXiHIbwCsjPty8AdzHj-fSXPjf9QJ74xz_JncUjM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wvwWMvh80b5pkpAhFYbSGbSEMT4Sm1d1TRisXFfUJ0w&oe=69E7832C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGLluGLhqq8Q7kNvwFTYRPk&_nc_oc=Adqly67AZI9l056KmMysIg8P_WSG296hdhEakg1ThI15ljeFJTOFcsvvozdMcQ7Wlpc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37PdJcF213VEMUMY6ty12xwmrn60iwo5Pj-6Xm8dJy1A&oe=69E778B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTYzE0vlRT0Q7kNvwFVkho5&_nc_oc=AdpIeo8h5GnLh_W5VyaSt4wGqPlUlh7xqylz34OJ4DY5oP3rlQkeSeHkE3VTvlQN2-M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_xrwCDRdp-6ld6qJ84agow0E8j0Q1_tAgADUrPnKyKA&oe=69E77BE5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
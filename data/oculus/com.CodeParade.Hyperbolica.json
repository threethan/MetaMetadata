8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfwQCbaaiHoQ7kNvwGGLwNw&_nc_oc=AdqbCSC8fJ89O_dYnYrOM79cMK1kRVjMhpN157KAcJYLzKzm8YLrvySPatSsQES504c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EkoNAf0t2zWnbROSQvQr0mQp3doeH_pCGZMIvLYJKPw&oe=6A25937E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMkl_Dv-mFAQ7kNvwFHEGAX&_nc_oc=Adpr2jg_-KwutHxqt661faz6afiS9ks9Uvz9xZS4PNXmrmtDSXQkzXZJjs2_qyv-MTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5sZ_8x8T4upPY_kpZrybwVtoWTIr4W85kNpkBzqvm7A&oe=6A2590AD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJk7ro4_4vcQ7kNvwEqa4Nm&_nc_oc=AdpoDqAMlZH-OPmg3MHbc8XD-BQNepLQJT2DoFEvKdJSANcG2GTAgF7xrH4TtZ7yB7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4czi1YIsA-lDZlHXWfrBK3AhasbQDyeA12nZZmV_Sfw&oe=6A258775"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW0ON_kmMlwQ7kNvwGJx4Po&_nc_oc=AdrXMCsBn4nLUmr4GAGd6djO5Hi2vHaheQwLu9r-CQRlKb-cCEXliWId_nEf98Q_1JE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UAq9XIX2EVmYOs_ugWPBE3ln32BtXSPc2AQAUKDE6Ig&oe=6A256BF5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbtLiyD_GlkQ7kNvwFlcYdM&_nc_oc=Adq-0_q_xeLgmuvBIGhJ1eQ89JDFtOmtjXLURtcyO__PBdIcP6-Cq24MFxRRhTXLBLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rKKYx32GJQ3p43zh2IXZjEqXivGIPihj_rftg-R3H-w&oe=6A2579AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh3cJVrMBzsQ7kNvwHC4XMc&_nc_oc=AdpGtyNr7GGgAubaBcF0mAGRV8NueyYhtNCKhlF1zmYDeMQKYhwdmbuDvKthp9k38Ro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zB_9DaedWoDIg3DtVQETii-PC3OLQ81DrCjp55XAY1Q&oe=6A256F36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHXh5O-iMVkQ7kNvwHNUdHv&_nc_oc=Adq4Y_2TN-mpu3lO2aa7waPC3RBUS9qdTGYQ9yHEjRuf29WDkreIVOCCLFxGt10mE2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MeQZNT3O5Xhan7rowCmyUVS6PCkmgaOTIy4JDDGdVLw&oe=6A257265"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
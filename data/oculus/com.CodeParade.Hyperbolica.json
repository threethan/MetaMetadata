scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcMJkBmLrwYQ7kNvwGEr3q1&_nc_oc=AdpGsJF4uEegjISU_05pD5zRys1qsaPl7Ofoamr69cXOZt9GlBsZcsmzKPt5VCoXfB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoKngsDWV6oqmR7hnG7cUZ1CsBbCGFZRTqOH-1ROcGlQ&oe=6AFF2BB5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn0dqouc904Q7kNvwEZojMr&_nc_oc=AdoTG8Ov7olQ3C4-yxodajY-9nmOJOy4zGoL1XcdQJixeIfk_fMS66J_z88NWl5ehUg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIiXt7XSg-a5_auNT8hZ5L30h6e7I9i4xhwyZTvaA6DA&oe=6AFF012C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwCeAU0qymEQ7kNvwEB8Ufs&_nc_oc=Adop_nULIZa3RmrKPVjOBXuUP-5Apqbln0VcfNtVGcaraUpOfCDx6TnlRE1c9i8Ycuk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTbIV9VUoEML5_riSiX9BdqgIMzhnjVajfnq05nt2ZZQ&oe=6AFF2EF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxgGV33fRc0Q7kNvwEzIcjN&_nc_oc=AdqQTPrK90D2e2xqTWI6lsw3LpOLgGPt3S2CBYTuBwbPKX_VhmanFkpIqTZ6GJt3bY0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT_AklpafkEVptMKl2yUzo5sSZhBohe58uinC1S_2veQ&oe=6AFF3225"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cq3TxCO4DAQ7kNvwFRzZ0q&_nc_oc=AdoPefaP0KYmDL4fLFaBD_fuECtgciHwR-0T5nee9_lxCZQhE-Al2A5cmWFdjnCh-nA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiWkXrS1_fEJMsGXsTb0nYM4eDR8GTMgoOMcSqXDluPQ&oe=6AA6C67E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF9k2JVe55wQ7kNvwFTrdC3&_nc_oc=AdpZUEj5rTtORxGGnCixZkjCr_Uigj5hwyiy1ManXGbttKTx6o3zqT-zcpFlw5mhG_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUWSbUv1-1aBYUEayK9iS0czMMRk_Cx09QvfPr0CqWWg&oe=6AA6C3AD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrWtZzTijhsQ7kNvwHLIPoV&_nc_oc=Adr4w9ipLxG2umFAKa5CWOBjeJx9Dc8oY4p41HI_UrQyage_YfoTvG6SEMCjiJ51ku0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEFZswj3zWshenVoP5t-RWimoqYMlQee6KZmaP7IH5yA&oe=6AA6BA75"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp7Nj1aU55kQ7kNvwEz-yeU&_nc_oc=AdqXT7dZFdfFQAj54qRH2DCKdwJ54dGn0aG9ZVbq9ExYX4Lgb7AafbdYBnitJmAMuqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjLuT8KPz1Futv79TZ2-lNsTa6Wj30cmKDy_ynNKJFuQ&oe=6AA69EF5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6Yg3UTORrcQ7kNvwEhogcV&_nc_oc=AdrBgGRozbIsLDRvmyPnhHf6Wd0oOibCgQ6P-93lH_dpTCQyHYBjLWsRhEZVrPO5LSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDuH_LAn855QwuDFHSB1pI849XFd2PT7gw652BLbznsA&oe=6AA6ACAC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IennhkrXRk8Q7kNvwGC-8s2&_nc_oc=AdqHUWdpcOpXVDrvxkhX4jqUQ3UlcwfujTpYWba6HGdAV3xqKhazMSwn68LIpEpOX0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDfKcTGeqytr0YEuDNQLeSgo_j4sw5nq2esMxkg4qbnA&oe=6AA6A236"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqiW6Z0osfMQ7kNvwGIIS74&_nc_oc=AdrwalJ5NgVQCAiIErOy6gBrl3chamFocNOro8EaGHIdDV5Q9TkwLgulufYerVCM2mk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf-H5xLHcNU9pksreS__5KtYgxPb3UQmc3dwnk9nJRZg&oe=6AA6A565"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
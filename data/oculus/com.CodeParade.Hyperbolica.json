8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SILFoIdGgAQ7kNvwFZ8bCX&_nc_oc=AdobedmvHU3yC-azafy3bAxerSj7-X69kCwVSvT6DCPqSj7-y3JE_9LZRiLA7h5wM_M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkmXHWJsvqoJl5VBBh0Usscwhk68We2ZEl4W4qCHg0Iw&oe=6A8052BE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y-agNxRm1QQ7kNvwFIBPxa&_nc_oc=AdrtKYNgpS6WVpmY2uGzXNsAUFuWipzvqcqn35EN3dCPBof3fP02rcDxIF1AGD23qwM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5naRrwEwz5aQhoC_jPgTLiHh_91oPnxicQkS9k3SS-A&oe=6A804FED"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMZfeozYeNIQ7kNvwGW3JyH&_nc_oc=AdrFYfc3fX-a0qV3nLrJlq_NtCMn9VeRDbqehfQOQBNYGcTwEXTMRfDJfMRDCYAEvFU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc3y8oQLDpBd9skxH_54aTUwnxz9bn7h8oni0mhrdb0w&oe=6A8046B5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elS8sK3SxbgQ7kNvwHNOpF_&_nc_oc=Adpv0tIgSuf7rfbiUh--C1qEFx_dJUiGDgQ7Hee8y_X2T00VSrnKbBXAgo0pv9qU284&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU7p21XnJCWmIKrBr8cCb-fe92XaZMLirszg0DlkHXmA&oe=6A806375"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d5B4SVf3CwQ7kNvwE2qqdB&_nc_oc=AdqGv8Z1C-5E8upDcjxxPC2ZXAVh7VxhNUVt0UbUSy-cwF30eIXgH3Rv4LOhD-rcWsk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGcbSkl-ZbW0yawfmv_H1AhyBENa6DNZMcXuI1-MajQA&oe=6A80712C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tcb8XFZ2rOwQ7kNvwHZ3NaU&_nc_oc=Adqxxqgge0Ha332oZpdGqfHZwcETVEqNulAK8zV1lXPvMmg6wRJvV0G_MngfZEUeTjE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPqmLpKbculjmGDD6D0mYxJ9-eWQTF_TXhbyopRXFaSQ&oe=6A8066B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boCdHP_xrgsQ7kNvwGAXkK9&_nc_oc=AdpbOTOjWPEx-rubne5nAQ129reDGzDd33FRVu0wZGS_2ZY2RUtESO6bK6qGtphxAVg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfxpPpJscyX3eQgi3znUpYaRVlBH8euHEc5BIOzMIahQ&oe=6A8069E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
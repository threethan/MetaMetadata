8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nL5PYoPqGgQ7kNvwHakBtq&_nc_oc=AdoDFpvM5EGn7hpvkw5rbGFdrBzbDlBEWQbK35e0EArZhX6RncCCYvULVokC1Inccgs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lBQpb8iBbdWP_nnrnzOWJq-1xH5YcLMlkyCq0KW2Oyg&oe=6A0F29FE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPqCN9LBhikQ7kNvwH_F9-W&_nc_oc=Adrl_dXJGJc2NKFvtJUni4uBXOKMIjyeQyc8xF8TRC_T-cOnLKSEYIv_Ow06DiWFhp4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mU1I6gPiJMl4hKObCnUH3DBpzQg8ZOUqdHbGfwx1VDg&oe=6A0F272D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLsnQFys8uwQ7kNvwGxXKBG&_nc_oc=Adrte56n-bBPi_HxwnddUSZLf16UPi3O9y8MRiDQFk47xVAhU_1zB5Byi65CDD34EO4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NNDqaN9J0FHuxvtFxECaNDXtafIjrAsL4tb1hFKBGqA&oe=6A0F1DF5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K67EqMwUTAoQ7kNvwGYM0Xv&_nc_oc=Adqkmy_WoN3Qu4zoAAdgdKFK605e3FWFJd5o_v87jX0bW1p4Xwb7L6VQJH5R5gTeHEU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4omaMstKEri4Wj49NLTKzQLZkHpNg4IsHgwHramJWi_w&oe=6A0F0275"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2o2nFr3PMMQ7kNvwF7zQ-O&_nc_oc=AdrUa13zLtLsD9mdhLn3lb4K3oOzd93VYcG38dYgciPkECFzn3r7h6NdbsFiwZcHc2U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RWfzC1-7_l0HBcZ1XwbjjM8lnGlecyrgoEnL_MMYWNw&oe=6A0F102C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANi713ncnQ8Q7kNvwF2UNvz&_nc_oc=AdqbJmkeM_XZEeGSdY3zhMCRMET5VgFKnwy3UTdSyHSfzv4QrvSZ-qMLxawbXNSSzXI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SFXL-Jwfq6ndolv0qf6f0IOtisP67SV-6ufS3BpSQKQ&oe=6A0F05B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3iSMu2jcK8Q7kNvwFxWjCx&_nc_oc=AdoJJb-T9cHh4_eIQb-_joVfAQuGIJ3sGwxX9luxNhM6AsuDi7bSTPoal0vaskDC000&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iUZOmQk4ozg8AJBm0yLitLH-W8yu-apA-XG174yQytQ&oe=6A0F08E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
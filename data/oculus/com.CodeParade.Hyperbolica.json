8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxDBPodEId0Q7kNvwERsRJ7&_nc_oc=AdpkeJSSz9vL33zFe5SiS-uyfX0n-XemMYVcg_y5OCTmDuWDRnBxVU6Xn-1RmL6E5M4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SOhmnAvJwQlTsuE7N4eknxXBuyTzc0x27cwbmHRuTMQ&oe=69D792BE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alU1R1jOYJ0Q7kNvwGXlSjd&_nc_oc=AdpEWiEuRzOG1WBqaj2LEI8Y3hWAQRxRjTsJ7NQnI2iCq1R3Uux_PYa3GB4N-8li-Eo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18LImWSX7BmNn4USuG60ffZ7a--cluYeRGSLMIqslzZA&oe=69D78FED"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dm5MYJobZnAQ7kNvwHMDK1R&_nc_oc=AdprWrnhNKQuDaIVZ7tRo47V-ylmPTZWIzAtbcs4Zr1i15gcBcVG2otrXkx0MHAhyjM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JbKzST8LB18uSOuTzzSpfPoBV1vrUat2LMpTfiWpxwQ&oe=69D7BEF5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaPrckCggvwQ7kNvwFSC0Vb&_nc_oc=AdrStclQBl33VwUpkv5bf6pKjOpQe2aJ7kdWv-uT1u1HG9v8rWXroaIuwCCRJgh9-QI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u1zbM3KI4VCHbVu8afiSdHuX2ykrhfoJJ9a6y06fzOQ&oe=69D7A375"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wl2yj4ogn6UQ7kNvwHiqoP-&_nc_oc=AdoGdj7kXi7rAHTLSWpUVStv9WH-JtdQI6Skn-msnmtoEFb2Zh8m33nskrW6CsDZuKU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mVMfiOqO9h83DTqED75LX3F45_6HWoIVEKO5GDSI-XQ&oe=69D7B12C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOVm6e15aRYQ7kNvwHDonl2&_nc_oc=AdrLEYLVETASMUZgQHiFCnNqQrUXpofZkn64f9tzLmcH0iy0x4zVoi8olLbNH5tiL94&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sm_y6NaP4RmT9KWrs4wG-JLkXNdvNDYHP-8WZnQ57hw&oe=69D7A6B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qATZ0wLDnVQQ7kNvwExu0vw&_nc_oc=Ado-Qaycnk0ekCIDQjihfUYHxI4P55Xs8voZ4CGbNF5L2xK8cksNYA9GP10N-AJa870&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xnJBc-uEM8u0F0NWzb5hBItktAc_MOmw_FoQk-bSqiw&oe=69D7A9E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
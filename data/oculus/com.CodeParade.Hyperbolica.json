8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCrexirTd_kQ7kNvwFAx1Ds&_nc_oc=AdoB1kJda_19q3DyWKVGYL2elO23G6qTWry23riY-zk5K6MGFU_75gzLHud9YtQFpuA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AA2GoeH25EAfwrw-LgAI1cIFUI44e_tslprHlwwithA&oe=6A32C27E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRLIES7B8JIQ7kNvwH4Iogt&_nc_oc=Ado2YFWhhE7FDoUDF4I1lZ6b7T-N_qFba-HvqvxXzg1yxgY1Yp_ETpvhiuk4ysN8iNs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_rM3fNp8Gxa2ONW9Fqf37EfkmLAAzpuRm78LR5iB0DA&oe=6A32BFAD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ma1iXvTyMTAQ7kNvwGSdK9e&_nc_oc=AdoQfdXFQ7U8VJ0T_ExJZi0MQUE0tsX874TWgj0jNdW0L2yJ1FLGNDmfWtuNKiGnw2I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aJF4zYgfwYu1IYn8X8zSpfwjdfelJL_Tiy5TqJqPe-g&oe=6A32B675"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaRWoFDavikQ7kNvwGO_Qpx&_nc_oc=AdqMjJVeQu4vz-tJ0wthBrbqZsFkIaSqlCNP0h_gESz-OSkKriJN5sYZmh-LJyRIvGY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-M0gFcZnffnrLwNH0C-Ez0jKpkWgVdn4PtRPp53Ug7w&oe=6A329AF5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pp5gfc2nVaMQ7kNvwHaNHCD&_nc_oc=AdpTzdVtZo-y_5YKXT4QGy_jbFrsjzXZkq4kHHL1DOvSlXwJMBwo5VD4PAlyd0XkI5A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xb1pAxADp-WNtgO4Qe-8bbIfFOAuKJ1aoJq_BfOpIcQ&oe=6A32A8AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnfjMJhi0-MQ7kNvwEhpTYT&_nc_oc=Ado_iA4IksNuQdG1oK7Y3C-Oqk1IiheMrPtVQWMYlVLYBhtbCAcCE0deZNX3Yowehu0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nQEPxOHTQI4Zy700FYDU0hQeF3ePdFmClhpp0-s7vNA&oe=6A329E36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6fk1r2L8EEQ7kNvwHK4MM3&_nc_oc=AdqdnMZbVRZpt4YM0kTWDfEGG9MW4tSgaKW1IioKeTqBJuB-YIAKe8pEhEvV2tVqWSE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IKnMdKBkiNzQb9u_9BQWX1xp-ZF_66wR5a9mKpM7Qkw&oe=6A32A165"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
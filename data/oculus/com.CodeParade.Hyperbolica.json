8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCKrO-iX2PYQ7kNvwGN2_17&_nc_oc=Adq4KBpntx4zXYbj47Z5x3gT5SYKLZpleAr9aZhrbJ6f0fIikjvPxzWvUkQoYjNnnGw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6I7pNXA1vvWACi2-MPItxm9yHFFs_8UcYlY9IAW05rQ&oe=6A972CBE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PsDQvPrbrAQ7kNvwEpU2dP&_nc_oc=AdpAQlaK5OjYEUl2TJG5CQsa0u24UAtZFoi7_qjYIO6Ew3uXIpr3ai48XcnEq_qMQHM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKqD1vdT46556W8WccQ8-5cwV8676niRyfS4x2Vx7_KA&oe=6A9729ED"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjURsaNUJIMQ7kNvwFVjAs4&_nc_oc=Adpd0__Q7koqhVHAN3i6c819_ro9JUbsRBM5zT1akB67MEQrvPfSabD_EmyF_7jDgX0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFljktaVwiJaR8FgMVLyDyvyqvck0I95yRFn3s-HWfjEg&oe=6A9720B5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzhAa1rgCogQ7kNvwHd3WZr&_nc_oc=AdpgLgMt53BqUavjAN35SQaid09oyjHAMaI7sZRJguDA5lykjiLJ6ui0kpZeC_s8dq4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzZcrY7zxNgITP9gSX3A0Ov9EEOG5GbbLEyZWo7J0v8w&oe=6A973D75"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5IZbqJcS0oQ7kNvwH9SYuf&_nc_oc=AdpQKTI6WeeFcTtMu7-YnntEPaC2qdjpsFbslKC3mjH-oBdPRCd8uqADl3tIDHyZhhc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOG5gwMoGfPNtnADLdbB68dIdwLifUMOwxk-zgcambzQ&oe=6A974B2C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Shl68I782UEQ7kNvwG5Dxf0&_nc_oc=Adq5AsvZ6XxyE7hRIsV6-OTNyOz6sBbgYs3OzpxNvs_Rg9xrffKh4uMRa6rePND-qw8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG15mdAkSwj7vQrl6dtoRSOBECmTBhHhKuo3mdLf8aO3w&oe=6A9740B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mB2eVLFnwwQ7kNvwHqy3rp&_nc_oc=AdpvIFeLq77ltQZxA-iE7cCul5L0Vibw0dujRDwg2_pkk-_u3KEL3CI2ewv_o11ypSQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVLrfUanGqorWnjfw9OFL1Rdh49Dyp6d6y4w1a0geePQ&oe=6A9743E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
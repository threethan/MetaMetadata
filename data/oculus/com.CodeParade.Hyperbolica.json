8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu1HntNBRjAQ7kNvwG1BqGx&_nc_oc=Ado5tHl5f55gCGDV5ukDbayBGl5zVELTaDC1wWnRpfTjA57q_rnTgEe2oM0BXRa69t0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSWpADCMMiNMnln14xujSra7fkq8PVKs5D_wC6vPX3xQ&oe=6A9C3A7E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lHMkzMcTj0Q7kNvwEQWuk4&_nc_oc=AdpyxHvY2074BP5v9FMoWw7Xox1q5yLCHqKBVO-mY2qN8dMSSLJADudS9brqTTa1HZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAttZOtNlT7QvyNIVhUaEG_k6vuSuuTnchtD5B9cSepw&oe=6A9C37AD"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsEIRitUGdwQ7kNvwHPwq-b&_nc_oc=AdpFPmZxETwGB827B45W5ba_gLD4Vyj025Vqr4gC3kJyiJQ20sq7MJTll43JfTDDSRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCGYVaOQmGanLi1cucTiUogfIHBLLEx4iRF8iz1HkKTQ&oe=6A9C2E75"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nWqex6WcyUQ7kNvwEmUggz&_nc_oc=Adq0BGw09EG2Y2VcLjeGuHpOrvZWrzR7jzYoCRgDvc62aIbS7NcWmCqUE7M3hdeRItY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3A8A9A8D73o9sgQdUSZiS0IK0IpGkjcMvtalP8i8GJA&oe=6A9C12F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SErxMgdZ_-IQ7kNvwGb7ywc&_nc_oc=Adrk7vK7Jo8IPI3n6fcOlJEIO-mBYJkWGZylS9y_CdbDAzMM3dXI6cpALg4z-1VXZuU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIriaR3G4pYRZh-j7ZDWu5aWbHVc7gW8TmuKBsogqaCMQ&oe=6A9C20AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOPcaXel9_4Q7kNvwFDVYPo&_nc_oc=Adpfmr38m8xNnSUBKlUO2Wl-YWnb0CuW_64Ug4SjiiGksuCSJovuiun0G0fuK6RQUVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS7WG2vv1gxmGtbWWhJUpHnxhjSf13iI9bfNXVEi9Axg&oe=6A9C1636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zziUvHOQTm0Q7kNvwEB-09o&_nc_oc=AdrTCner_zn1lAlcGn8Mg8hxZb0Q6EPmqUF7KhLeRxWsKny6yNb3nfQ5n9kJilw5yWg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk3gUYaD8IzdaShlpqVe9Hgve4QjrIrISetyKkEddMkg&oe=6A9C1965"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
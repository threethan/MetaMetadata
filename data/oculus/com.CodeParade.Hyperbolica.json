nc_sid=6e7a0a&_nc_ohc=VW0ON_kmMlwQ7kNvwEHJcpx&_nc_oc=Adr4d8OPzZyQGORhcOhKhN9qZf1LxcNkzkv_6FdI5H5gzpDvnMCGdQr19VhpDVJsk5E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BMG8APqzXcEKxPB7O2bkW6PzMw-3RFWdcscWOGT7LjQ&oe=6A26BD75"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbtLiyD_GlkQ7kNvwEWV1uM&_nc_oc=Adrk_8wZSF9Bc-ARP3meMkJdGzHqp8CfKk_I5VYzpK975E5GRZlq5_DckWPcsHwQsdk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3JN68rID0Qz9qdez-RNQDC1Wgf4vCzdH5wCzwxl6J7g&oe=6A26CB2C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pybGR_Jk_qYQ7kNvwFaobBG&_nc_oc=AdpqUphxKe-5616lSmw9SipItXFkEuYDeNB3VQQWUoquT4I_vVhFxb9DEZ5ivLTYm4g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JCs4744MpL7TWrGW0fyaTiipC5IEkNDqOyLwQ4W3kXw&oe=6A26C0B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHXh5O-iMVkQ7kNvwE_WLSs&_nc_oc=AdqD-rAamTHkae0TwfyrPYSJ4N9rwudIX6IHadzpZ77E7xcQ2hu6h9rGwwZNhsiHSZ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0VPlmBqSMNcl3d6TamKr2I4Dy-DsBBKykaQBCKvGQfA&oe=6A26C3E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "530600385519685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568668_2260772697414
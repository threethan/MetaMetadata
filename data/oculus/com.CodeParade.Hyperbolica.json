7AGx5q25C9USZISfMMqLaAoQxshYP4RcqXcw&oe=6B05A675"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Z84SmYYUbUQ7kNvwE4YgNc&_nc_oc=AdomRb_71pM1jMwus9H95LB8gONyxbj4xAvpJjUSh1GHbPd-NUYXs_v8WFCIgsZOK-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW4gEGrGJrmNGLfUGdC5KIGbb9YQN2ELWh5neN5D7ANw&oe=6B05C335"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foa43W14fEsQ7kNvwFJlEXq&_nc_oc=AdoS-LkeRqLMDndSaxXq6UEtnu9Nk0q2ANd5R3GVgcux0h-trFHi7RYgCBr_V9AO8NE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO9o3NqL-3mYYjKZGSowgQs38tZ0O3VcRB7ljlwbAnPQ&oe=6B05D0EC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2sS1XRMXrgQ7kNvwF4wWA6&_nc_oc=AdpXTAodQS5I2RGxZpU-z33eh0jNi309AiAnBkuKtbRBZkukWDrSF_5DsnrXA5ZFdzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnxo0Lb-2mlaF2mhOR6E7cplPuMr2Cl3FwP3VpztWP8w&oe=6B05C676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dD4Kt1a0FsQ7kNvwGGfsxZ&_nc_oc=AdqrcaCNKekBs-6vdjzyhBo6ZBPTVg6NdFIzKOlZfx9Nwa8kw7PauVWMbaIyD2z40W4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpZM4JqQZ4IB9zbCYx2Y6acaMJghlylD6lkdG2cuxWrw&oe=6B05C9A5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhLUQhA1d78Q7kNvwGxxTcG&_nc_oc=AdqGFeOcw_g9vmyJLJNwIaCRAIqDRjtGsq-BVSK4iiCD7VHKCrRXLJkxU6rQXQtV7MY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwTDT-cAp_lOLey7phKsBkbuX_F8iDCgsPS4k7AhoCpg&oe=69C7C0BE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8IxOMtu20AQ7kNvwGUdE1q&_nc_oc=AdqME8HkGD3sLrCgx20MqbCb5JldSsGUld5CMmmBCOsJKHq8vER1J0353YncjRlsW0U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzms39QzYTu9N7FfVYGjm-FJz5t10952QgOTnkkE4PXCA&oe=69C7BDED"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9Oh7F_LhvMQ7kNvwFft-lH&_nc_oc=AdoozooSVjCwHsVbov7XwAxDP5IqvwqcdmjL5BYBjf9sbb9FbuLogzgt95LAGKiMrLQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIiSpCR23CTKJTr740nsAzuHXpw5sqcSB6aIE6PkSRVA&oe=69C7B4B5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6k25o5XX78QQ7kNvwHo8U0Z&_nc_oc=Adq7EU25KO5Pgk5X0xh4WAzBiqPhtQgR4f0f9b6xKwolztyLiRivvOq4ldR6Z7jyVuc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5UVZOaJ80ocm1JbagRzcnL4k05D-uLkSurcuvCgMM2w&oe=69C7D175"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_z0hN-9zDjAQ7kNvwEfWjdC&_nc_oc=AdrdRnINch3jMhmoa5mHkZrgMO5aRPcD9k-aR_HZeOH_GbVTdmBaJGqtC_uL2Zg0dC4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn7pfdHTHGKgUqCXn6t9kyzqliAdPhHyRIRXddoF0-Kw&oe=69C7DF2C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2K6_YkeaYEQ7kNvwEpLenJ&_nc_oc=AdoPUdtc8yb27N-kUUUyslBFOuHuNxabmdyPDHDf3M_21_76plZufvpoaGlUBPn0iBw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwrjt19uBqEvobpNKeaCNkv_W1rK58Ovbk0L5Gz6L08VA&oe=69C7D4B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAVBzcSWqcQQ7kNvwGGM_bj&_nc_oc=AdqRPRC_zSVe7c5Fyk3e1TCFEmhlZxSbMOmJIC_rdReIdd4XArhKXvehIW3NnE2O0Mg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN0Qus1_IIVuYNxjoUR6wMxTvbhxVA0jo91Xe5fl08ZA&oe=69C7D7E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
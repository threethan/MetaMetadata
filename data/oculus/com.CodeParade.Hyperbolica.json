8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krM-nR-NoxYQ7kNvwEB6_7z&_nc_oc=Adq1qLm798-Skoc4AoRHS3Blk7_JHCMqmL6Kf2O7UJdAPZmcv7KjKPGnYx7tD3UtaAw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMIvUpavx7Mo9oDsA-LctkwNU1Rgtw6N9DmKdzIAKvuA&oe=69C27ABE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuRrbBKDaIIQ7kNvwGF-BWr&_nc_oc=AdqZiVKHsbEaogs-PtlEOe40IkmRG5oPLOEU3AZIDP9KAQ4WcoRbbZThdxmGdIJBcgI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKbiQV5CbUJRSDIrglEFEvxYO4NGn35Z0N_ITbRLZVrw&oe=69C277ED"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpMOSCTtkicQ7kNvwH61RGn&_nc_oc=AdopPZm_YKdXKtWHcnoqRo0g9aOh2Xt7cBcTFP-7fMM8pLowjcmQ9bw3ve-6_q7IAVE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwvljzt6Q3qKoKlBID43AUEDqT8OhkdkUZgUrPAUpYWlw&oe=69C26EB5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BHKixLkb0IQ7kNvwFQiEYz&_nc_oc=AdrnPmGFhVX_8MwueS-Y-N5AkNopHu5xcSd89ikVy4X9nX1BA4PBEDJ8UnSC0qvor1Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPUohhRM0Gv7LnF0K6tmDQ0RPmBkYzWlj6uRro9vkj2g&oe=69C28B75"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cppvd63JFl4Q7kNvwEq8Ou_&_nc_oc=Adqno5t_VBj_hEWNMT_XGIJEo7ef_T5_XecyuJt_lB6vK13_ZL0ermfSeWTQBAfxfK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyp05rRTI7WF3LpynHT_lPbXkTnlC7CRWamHPXom2x9Bw&oe=69C2992C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMOO4wtMtpAQ7kNvwEXFP2r&_nc_oc=AdpwsahC4p7P003DTIrpOAqWUn31HG707JPobVjD8HKC8KDb_ICes5PN2B4aNSRxoGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7pp3piex_EjbHLfLN1vFh48hts7z9PSRdc5dMlugPow&oe=69C28EB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBDPpx9hk1sQ7kNvwGFpVdw&_nc_oc=AdqasQW9yn9UE5RuPd9O89FnGwhbNHApKLYcpuKC_I8UfLRqj3k3d4Mgv22xG0mmbvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwY3f5cCD2NHiDSb1o1d1WynmKGs5vF8P4sm6sHf-4HFQ&oe=69C291E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
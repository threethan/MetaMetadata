8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWQtCFKTlagQ7kNvwH4YWKI&_nc_oc=AdpLW6axXZKkS-Zo4Ow7wl5o7XUsLdRD2gHIoi3zraf_9RhJ28ZFfzGmxw6u2Y-31sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m8r2MzLIeAASq2tmYhFl_QKP5fNl1fFckarQdLXR4Vw&oe=69DB873E"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_zAY0DkJB4Q7kNvwEpfbCl&_nc_oc=AdojvhWNittqDGhcaddV00p_YeKejd3vs7nz90hPydzv_DxagBAS-cMbjjsRvFDl4d8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07t4ltYvaXsWHvvJgDQzDmiY4oYJsRs7yWFLOr5Y-BMQ&oe=69DB846D"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-1cc8929HAQ7kNvwEKfHUe&_nc_oc=AdrKcbTcB3zhu1Z_Wks3luw_Fn8hkmFN2nEkvCSPPJddQlnszxfsk8XUBCMgpj_DeAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3blMhEUT6oFp3Cnt3qL1aixMRV5-K131-BE3691hE-Eg&oe=69DB7B35"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W35zOED2h8YQ7kNvwHZ54rM&_nc_oc=AdqZkyDZt-NzFoTqRaEbg7ALslOnmF2yFVas8Cjma9CBN_wYEU9_eNaitE7lbXrlSpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1882dfQM_WBiY1Hk7wwU4t0OXJaNA8pyOpeprUGv2yNw&oe=69DB97F5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6-m8zQdXcoQ7kNvwFqehsU&_nc_oc=Adq3ZEbcFx9oNTTDzJEwfsFqZbmPad9tXT-UXvZXN9VnK7GzKUbXmBX1WZMzNjHOxN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Up7caKAn-lXhf-ZksmYm6ZNLs-lOiNSJUR72qa-9brg&oe=69DBA5AC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5VUIB6Ie50Q7kNvwGXnC8q&_nc_oc=Ado13H2qXbF4rpdZlsE0BUFAwu_6Pjy-1FXy8_e4nGRSICPQs5Oav7iHd7XuvIDKAbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DoZSa6YHDE8F9YtjpA7m0X9EOTeUuR-0BmKf7bKfNgw&oe=69DB9B36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FgyXJIVZOAQ7kNvwENY44W&_nc_oc=AdpgemGFxmQQxfuaaPFsayuUPD2q8Jr8Kyi8QolqrpAcOwbCPwS4P1tRVx-9tys37S4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vuCq53dK2JaScLP6pn61WPdEFf2JeU0T18nxNsozGTA&oe=69DB9E65"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
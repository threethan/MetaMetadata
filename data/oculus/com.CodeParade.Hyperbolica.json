NvwEEcuo_&_nc_oc=AdnxnsIbAqT5Yi-V2noEv2WwoT0AC3ibiMfH7mOnb2d9udWAU0yLi9NamC-7khaXV-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRxD5tfFkd2tTOdS5vvUGxihWq7-WLiIzNQ59_pRvJhA&oe=69AD7375"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3XxcYwdbuUQ7kNvwG70_9R&_nc_oc=AdmTW3uunhdYWNdikVyXfO2b8uYcIRBiU_DO9Y98JlbnElsn6iuM6nJhy882z9uJayI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS6wojtMTIqQroBcKl7L_qC3H9DSJwBWudny9cpH6afA&oe=69AD812C"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKiqUQ6E1UUQ7kNvwFM-87M&_nc_oc=Adl-dNqfriGww3a934kUK0hVzbFfUoj7Bnnb04nXUTxDWF3zSTs-Wiy7gtKJNkjq0J8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzroJjn1tErsRj3QhOfmrmLhEy_HA1q_IBwHs45nCxtaQ&oe=69AD76B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XznP2JjBfiAQ7kNvwGu8-ck&_nc_oc=AdkRY42bw-MZFJBfEFQ5aaSda6shpBraAb-K-jrT_O6LlYKL4E8vqx_32uqWRN-QMBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb7D4fiDPZICGj5DyB7UKaTADWrLXkOQOvKDvWJ8A6hg&oe=69AD79E5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "530600385519685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_2260772697414961_7028717707306423322_n.png?stp=dst-png_s360x360&_
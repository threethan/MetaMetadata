NvwHFRAB1&_nc_oc=Adk6d3qiDlEgfrSP5Xq6jD1xsnGUah3CU872mohZf-ygBR78DL1NSHnfYqytSFBjmI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWc9nXGqYpsMm1oL2nKmjAqxaf20zZ0wcFgcw_1rxXog&oe=69B6ADF5"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMX-y2To3LsQ7kNvwHqW5Tx&_nc_oc=Adk4HXlTyH8Z4ITgQJ31YhMEWmYIVmcv7FaTd1R0Bbk6dCHhpQDMlznQpKzCTplw10Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyksSWAc93TXSaR3g8OIUPaE8UEhMML8Fd-r6Q7-5_fWA&oe=69B6BBAC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKTaEQZshEAQ7kNvwEK9WMq&_nc_oc=AdmgehTkRxYG9gkRLnPDUUhtq-cD61jVlujwUeYjW-YGM1HI3WShvCart8gLz7Zrafo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7Z3iAQoB7OOWU1A0kxvjawHP0Px_2KZ3c2efU0gqyig&oe=69B6B136"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNqm3mWY4eoQ7kNvwF2nIdR&_nc_oc=Admo_CwqpuBxO90gcTb21VJjoYWsmnEMR9pMgPf34qY3gMzHMhykF6FBJwCvgE92Ogc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afywvbv6G4ES2JfutShaCfUD5Bik6tUBFDqXkYRpSeEWdw&oe=69B6B465"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "530600385519685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568668_2260772697414961_7028717707306423322_n.png?stp=dst-png_s360x360&_
8", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982666_370145421823351_1870195474736876201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSAQ2bHrRsQQ7kNvwEnMSF4&_nc_oc=Adozn5CWdSYZ7uVwSmyn6eJw9cUd2LjMZZ44IJCc5a94VEXVnaYqjh12FdDyxeVl9To&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA_3IGkeQKH3bTGYdHYc4O1tStOrGxvGTgia0JmTOuOA&oe=6A9024BE"}]}, "id": "709923370264540", "locale": "en_US", "screenshots": [{"file_name": "ss1.png", "id": "411398523737720", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_411398527071053_7807896009186154471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyVbwVXuTJsQ7kNvwHXmUjZ&_nc_oc=AdqD75JYt5r-PxbdXYHyOawg0GjS2206csbAKrQvBOYMakH3lQo0kGjHrD_bW4otYuo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUKgbIPS51cuxlMxxWgrc06G6y8vPwZeBKorAUysu9aw&oe=6A9021ED"}, {"file_name": "ss2.png", "id": "987794052099157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_987794055432490_5516199559740785843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zn0_fFuBogQ7kNvwGjjYza&_nc_oc=AdqYktFekM4qNk7RlHOoNCvdtbBqqNQk4n26vfqH3Tnbprr9A-acis6KwmaKPOcNxJ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK3k2rrlxzKdH4l9awZcHDSsIioA7CScS2vIf3yQ5HEg&oe=6A9018B5"}, {"file_name": "ss3.png", "id": "285464453651325", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974602_285464456984658_4529357019254478727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kkc_HWBmHgQ7kNvwFlycQE&_nc_oc=AdqdgZYYrTZlXVuj0xLrnw0jfTyYBSZe9JKlCCYqQNNjmZZGNkhBdinv-C3h2EOz_Pw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ0PtMOpulH9kTcKk10BsT6pK_QDFik0PxCeLunT8WEg&oe=6A903575"}, {"file_name": "ss4.png", "id": "2156761031167407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_2156761034500740_7772996238278220049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8UYzvO8a8AQ7kNvwFVyiQx&_nc_oc=AdrvnzrQwwluKPQsupYywUXu9XBqMxBr_PlpPesgXxbZnFqM0R6SL941iyPUx30ba-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK92yn5I4sUMLBT6Ke2KA5C9-iLyEjQ72ce85sf4pxJA&oe=6A900AEC"}, {"file_name": "ss5.png", "id": "324555489811681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031592_324555493145014_1526553287762062689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydO5_LCGOb0Q7kNvwHwJyVR&_nc_oc=AdobxV-8_IxJuRujGit8RGbMmqQltagw08GhbLNS2ErszuRNJWVW-QY7YPW6lhP45gc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlPWgk3RPSYc__U4tCCThVV3sY9DpbN8Q-Yllij4IYPg&oe=6A9038B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_landscape.png", "id": "4841343985977852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_4841343992644518_5615066345125991756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0SHKVbw0pcQ7kNvwEi3YFu&_nc_oc=Adr-rVjnr6GdffO8t4kd4BC1UGYT9HlW51HD44au9yle7vQEEmIVRur_Q0LD3FY7ITY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjoronmTPp86UZCf0_9GR-o5y6EXpnLjt2hv9bjLsYqA&oe=6A903BE5"}, "display_name": "Hyperbolica", "keywords": [], "long_description": "Travel through Hyperbolica, a true Non-Euclidean curved space like you've never experienced before.\n\nHyperbolic space allows more volume to fit in the same 'space' than you'd expect. This allows you to explore enormous areas while taking very little time to walk anywhere. Building a mental map of your surroundings becomes impossible. Straight lines don't stay parallel. Traversing the map can result in unexpected rotations. And many more strange consequences that make you question reality. You'll also explore spherical space, which has opposite effects. For example, a reverse-perspective: Objects appear larger the farther away they are.\n\nIt's difficult to explain, and first-hand experience is the best way to understand and build intuition about these interesting geometries. Hyperbolica was created specifically for this purpose, to break the mold and to have a fun experience in an alternative universe different from our own.", "short_description": "Hyperbolica is a whimsical Non-Euclidean adventure with mind-bending worlds full of games, puzzles, mazes, and secrets! Immerse yourself in reality-warping geometries where lines can never be parallel, horizons are curved, and space grows exponentially."}]}, "developer_name": "CodeParade", "developer_privacy_policy_url": "http://codeparade.net/hyperbolica/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CodeParade", "support_website_url": null, "website_url": "http://codeparade.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1309568266117079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1062725531050313"}]}, "baseline_offer": {"id": "1062725531050313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657263600, "status": "PUBLISHED", "id": "1062725531050313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150110958359664", "version": "1.2.0"}, "id": "1124390368326698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
ning"], "long_description": "Pre-flight Inspection is an aircraft exterior walk-around for pilots, cabin crew, ground handling crew and any aviation enthusiast. This is a fun way to learn all of the pre-flight responsibilities.\nBefore every flight, there are safety precautions that need to be taken, as it is the last time any irregularities that might have occurred should be spotted and fixed.\nYou will be walking around an A320 in Vilnius Airport and learning how to remove locking devices, secure external openings, ensure that the aircraft has all its necessary equipment, and plenty more.", "short_description": "Pre-flight Inspection is an aircraft exterior walk-around for pilots, cabin crew, ground handling crew and any aviation enthusiast. This is a fun way to learn all of the pre-flight responsibilities."}]}, "developer_name": "BAA Training", "developer_privacy_policy_url": "https://baatyperating.com/privacy-policy/", "developer_terms_of_service_url": "https://baatyperating.com/privacy-policy/", "publisher_name": "BAA Training", "support_website_url": null, "website_url": "https://baatyperating.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "458382532551941"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162791_200507750683999_8346949823705907200_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkKaM71Hs04Q7kNvwGDu_
npWzYmXtN10c2P_atIscDpgOoQ1W_4MG5WML-qzR7HZpo-GgRSMDraYTnIh61Jgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR76g61P9vWYfQDczjXfgp0QZbFjyJ77YRpaxLJqIlb6A&oe=6AE9EA74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab4ImvVB1a8Q7kNvwEntfpP&_nc_oc=AdoEZoMcSQnsdMDhLWkGyIIuwdTuKrZoXtafjOr-yH9Q3ZO1uJx7AlSFmPCqCZ8_J9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG1851SJwGBgUqyAHP9pRz0Qvg1l-roWxIEJ8CCArzFQ&oe=6AE9F272"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvoTiJA0M-4Q7kNvwG7FHZf&_nc_oc=AdpFvUr88D6eWYpio_xLZuRehZb66QyvrBqTuh6O7G-p3FSlp34l8tLYjPydcraBWgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfsfV5EYiXIH2JUjtMjlq-RkYRZdu4L31NRidniJBsxA&oe=6AEA14ED"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikoTDEVAYG4Q7kNvwGfcUh3&_nc_oc=AdowmX300PaKIWc5cpxAMLdqYGr3Wi7o0n8Q5VF_jaPSLNjR1TQdaMTxwvFiM_UEzfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG4cagdQF4GMX0RwFor7PHILSYzmUOVR6TjD3_mQ29iw&oe=6AE9EB83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moohZAB1dG0Q7kNvwGzqgtU&_nc_oc=Adptz8Zw--IXhnIjMiYUfoNe0eUm4WNig-UoS7BxKAWy5Vgfp6J8DTatAIzoFVLjCNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPdM70cs4-mb2z6FsJoewt9CoHqYOvdjPGlQuqjJOCDQ&oe=6AEA02BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
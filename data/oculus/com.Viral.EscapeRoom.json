aGhGRRhtSUCYyXk-0cOMqT59L881y0QJRBJwK7ShQdT9IlDhs6hVpH5pLjMWfpSQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF3OqY09Gdk3hPobsfjHd4ax8w6lEBVSJVuU6pb0a17Q&oe=6A68B774"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGkcuvw2-DoQ7kNvwHFmHpH&_nc_oc=AdoRiqAplMbGnfTk5LWjHLcpW6ZU9IEWZAPm5F5t0UPmvnTMaWAQaJ84Ryd1pAfcip4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1GA0s_KQegqA2D9aACCmbq0WIvnzxR3LkvQ2XSomi0g&oe=6A68BF72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfVuCl4qjwEQ7kNvwFr20fy&_nc_oc=Adq2HWLHvzgBsp6-sKUDTAHuQvP6FfqPwZhoTSoQm0feK2xQWclrLbmNVjtrNpfxOvs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQAfQpymnUj1YZspxOzY6ZCiFuyUQS2VfZJR1Bys1Nyg&oe=6A68A9AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MngV4eHSSUkQ7kNvwEReh4b&_nc_oc=AdollFj3qKRUlRsj1FCE2W_0vyP8tiUr24olc_ZsHkREP0mneFyCiQ5Sr-pVPtwmIU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTyNGE9LDQf-rocbNIsNEaJ3ViZHyGCNhJoSbqhQ7NPg&oe=6A68B883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReUZz6ox-f0Q7kNvwGgwDSy&_nc_oc=AdrUptHY1zEnwcVRH8a-b-YKetQVXn5wrwWkH0yrTSKk4d1B4iL0tL3tiUIIbXXoE70&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAf_wYKw0kSBUZoByOamb0MXLt7og5_SIoi2RvXTBrNw&oe=6A68977F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
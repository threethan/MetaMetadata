Bp2DjjTGpZtrKu7Ly5Lbjt8HvlHf84otv-QjaJWiT2NrFdUya4Bxc65CIxjfFYDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlzYC4eY9iivfPKdo566FXI-Zi9fwRMgvPJ8QyBYGNAg&oe=6AB28B74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW0F8_yFUe4Q7kNvwE8janO&_nc_oc=AdoJtGyqwN8dkF4qmj0wj9zaQsQ0vgZtzKSYyhKAmxPlv6oKvGgLjGVNJoMHwIBJ99g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkGfFSPfSxK8PsbNQ02BgIN3gmIf4i3koRnurStyOUeQ&oe=6AB29372"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-KD8wV4htUQ7kNvwFbfo3w&_nc_oc=AdoiSzBBjBYBUGhSaHAmljnxVABRfeXuhdMUluxHP3sPRssxedA0FJCMipUUdy87K0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNftUs2nHA7q8FIG5zcARxqlyN6oVLpICMbIHhYlQU_A&oe=6AB27DAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5vVLe_CJJIQ7kNvwER4UnI&_nc_oc=Adrls_cBwDWy2qLUGQLlf4B-1vItyskdpsOyfkwyL4opZ8EXqKkHUNKkJ1GHevqBMc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeNWLpuk49BnavSAMnOux-BWwS3wJaj4pOzq_bZjDC5Q&oe=6AB28C83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5UziczsAHEQ7kNvwGjoSwk&_nc_oc=AdqhNUCVQKB4s2vShYs7TcP-XcyL0AKpQtu9AsozLYD15BzfN0qlBkYclJKs9XoDRLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWYmkCO2-lZMjMTM8NmmOqw2GikoVNXUAwZ42mj9OT9w&oe=6AB2A3BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
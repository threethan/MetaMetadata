l3ztWRa376NFlosC4Eh3NKVJQte58MKowcUFm-bAGIA-UUxffKWIwwHAlV243JgQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrMXqB2Qrruf963Ml_J0_BWv9CKLZNwBuD-HgAzHDJ3Q&oe=69CBD4F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XREsMpPwLUQ7kNvwGxDFd6&_nc_oc=AdpgS5-tR0VFzttBTwhMBkENO364PZj0xokXaaVIwkihwwWXMpzJCWtR3S_ywekzNOk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0aXAvH6SQANmuZ_9WUEYf5Xb3ErKZPDr_ANHsNK-aNg&oe=69CBDCF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlWc3JraqYcQ7kNvwGXveVv&_nc_oc=AdpoMORxY85XQ5clWLnBwm2WVXMTZhXknnfrr1u9cztdowLdYS07qhzyUKyPpYZLFrA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFBa8V0OfVnBYTNioY-NQB7UgF101IyYzRjx4Y1vlhUQ&oe=69CBC72D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqxih0e7XnMQ7kNvwHfTUDR&_nc_oc=AdoAIapdsBAT6GNiE6lPJm5dgMhwhTN1dk1-ro4AjoqtHuMUa_qcY2u8o2ovBcpbiac&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5jwpVg-4GaObBjDHDTjvzg0v49JDuMiuju8Zslz5Q4A&oe=69CBD603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yf73mqMd2UYQ7kNvwERKSf0&_nc_oc=AdrEMYuRAQlXfcurlFFTMva7SO2OPJw3LpshjVeV-xEIN1J8tGnq5bwjIxzH9dK2aAU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsbYlpxeGp8jX6BgZfGuCsJ8x1pVURNmM1fkC0fuPyMw&oe=69CBB4FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
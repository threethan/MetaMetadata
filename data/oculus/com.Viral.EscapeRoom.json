DBBkXucG98MNL66rHaRrtW4RgccvaMVqqcYGEkwc7ksodZGU_JZX2r9fRAx_Tps0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGYHI4y96kLFyVGwoBWvBCrzLqVBN4bywRZlMbwFcNfg&oe=6A539F74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzABTZuMZyYQ7kNvwEgOtNX&_nc_oc=AdoYV2e7CA2Me8PJq1xTYj3fRoaA2TmVBYCvnqUjA7744UFCVWfJCZKtwdCNVAEzDkI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCII5w7gFskdz75bJo-nALE_nezAe3zVeWblvDyP_dnjA&oe=6A53A772"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtqvsGfn9GQQ7kNvwHAqFIJ&_nc_oc=Adpat1yQoj6Qbz7MGDifa7Bsxj1Y24YwbZzUWaVo0WKCIXPqqCjI-1gug5jDgYAZyrk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxJEakmsujQGU_Z-4H5w6WQGAX3slp0Un1sXA2KRtKtg&oe=6A5391AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2G1VVh3H_MQ7kNvwFOFfw2&_nc_oc=AdrTD6dFNHyDMzDbxflonGM7Xo15Uw49DjsPRzWmSCN4ISHoFkxmGkO9dugQbzLI8fY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO_vm1nNaHmMMRSzcGBl5qO8orFmz0AxMwBtVmOSMTJw&oe=6A53A083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCFFQcawggwQ7kNvwEcGm7p&_nc_oc=Adr-kaP_WmJcarTeoctRwQfY5xbf0o6MunroHff3GdCHVf-nolvqcXzOouESolwpd_k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDneKp_TTfcjvgnfWDch8nd-_EPRWk32JJ-ySp_KB8Ow&oe=6A537F7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
dn.com&oh=00_AfsIt3PwdcSgysRJctKniZQ0s392yfP5TcU6BsVfQA9yQw&oe=69A05374"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb8_Cn7o8PYQ7kNvwGo_Rrh&_nc_oc=AdnFx_V_3511ujb4vdQtWnbM0BY4kaceNwNXSfTNVFYREVscKC_g6XEqhHv2PZoRFZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsyAdVnm7vEZlwBTG6YLOA7WaDj5yghlAcyR1LT37dilQ&oe=69A05B72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe3U9e7zKhsQ7kNvwGGEloS&_nc_oc=Adnpay1_Go2QYOL1ojCkQXKOb9XH98BwykK8I-hi7nk142NOK1hfe521Xq00tbbcM_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgAHnC8sUBKuZJmF9N-p7nt6rSjpM0Z-YGkHKAxdhf9w&oe=69A045AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlmH-8aKCyQQ7kNvwGLQF8g&_nc_oc=AdmuT_FplT1beTq8ZR4q3fTnliyI1jIh2DKF2Ad8GtYafo8K4smV3gv4LpYWOqIrd-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0I9XZBsdeCqKQpr0CoMheMjpHL5rpyHM7voPOT9WL6Q&oe=69A05483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iNbjS0CIpIQ7kNvwGvnQMw&_nc_oc=AdkARk9Ez7kznnvw6dSlupt_dR7ksZKAULbWm36iP4ksKgSGA2pG8TqEmRp4w61hwvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXeQlQQjz6iQj0TXv4OnW8xDOtB4LtkEEW9DYwemWjkg&oe=69A0337F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommende
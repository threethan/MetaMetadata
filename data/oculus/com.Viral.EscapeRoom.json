GamGN5j1l54_d4Nd48HuzHRK5CjYYFl539WnJNhYHAHKItvbV8Nm2TKrrFFnvALY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWoUHyEpl3TCFHqEIdSPch4pyp7JS4fcgOR7okG9xefg&oe=6AE20174"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2dbm39ieEMQ7kNvwG4TAww&_nc_oc=AdqeYajmuupOIrDo3FHmqQCEUE3oq_owjb4MSHlWayNBYqaPBti4MBdJ8U4XrM1buUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXZ6vQWax5YVV319lS1tCJd-8i9IC78-Iwj8f_9_Zk3A&oe=6AE20972"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv0b7TAFPwoQ7kNvwEGiOvu&_nc_oc=AdoqBIQITjficpvLl3Y_B0n-cdVA4pqv-LZHrTSYyGS7pc-t0-oIR0o6llZBsF2uqVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO68P9lYMxsdWmaqXjlTeE_c34KigWx4icucCsy0U0EHw&oe=6AE1F3AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgMet6egO80Q7kNvwE5QZSo&_nc_oc=AdqH9_tOzce9cDt0CypqGbGjH1wVLeVdo8tt8mo7mTTT3tFL9G2Ah9RNzFH6zv44P1Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNLU3Lua8QT0E0ao-Pk_L7uwPcEU0WG9aDPlWnopSe_Q&oe=6AE20283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gRTauB5THsQ7kNvwH-3Vv9&_nc_oc=Ado7a3m64AY_GGWtsUuiskN0wu6vXhEk3EfCFrtO2rDMOUpGMtCabi4j-lU_urASjI8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHCoZB1dT-gmPY4DyXL3eHKTEGLlIAh_qrkeW6MEi2Gg&oe=6AE219BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
cj0Cqe0ZOhEu82p2hd2sVQmMwWY21mqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvQA0OEfM7_8jtP95kWRKh_Z-I8oTzdMs_nbej15-DmlQ&oe=69A98DF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULvR6mjgs4YQ7kNvwHYuLNF&_nc_oc=AdmmD26ti2a94n7YHu3ajp9h6aXW5jri3Yi50bjMYLIMu46thfwoTV0RH4W8aixaxlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu5-_eIhxrpMxtb0qdm-VsiNRFgknZLDrRdzKSpZlCpuw&oe=69A995F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62xPmd8-hBwQ7kNvwFclcfp&_nc_oc=Adn5W-xPUj-UnQJNGvksDjq9DXwaJhCqXbx1NCwH990h1JCGn3mYdLHOVH5l5UZy3fM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvmmOtbghWhpDLT2kM0HGw0WwOrJpzpa3AyY69w_r_rKg&oe=69A9802D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JL1l0ZSlugEQ7kNvwFzkVe_&_nc_oc=AdkyIN9Si77cxKtTzo89IY8ut70yg-JDm-HdcRWgkCctEwjXcrZrP80_yroSg4uTkWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftnx6Jfj5Ne6VKpFPD7iaR8nMCGqA7iylunQOr0GiE36A&oe=69A98F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da9eYlh7scUQ7kNvwH8TZC7&_nc_oc=Adk-IC6VKO94emPxPmosnipVQgp_D9pJxecGCUcqzpZH1C1yuBfm68uLan4xPzPC0H8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu4dTqEk6PArkWAcwZdHA_Z2d8P4f5sjIsKOExK5MK8yQ&oe=69A96DFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
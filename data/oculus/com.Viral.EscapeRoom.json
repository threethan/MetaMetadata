muTNJs7XOIXSMfvYiBsbLhphAVuSO-eVSl557F1i_zRLaD1UK9lPtxt_6hbw_yhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnbwt8VL15xVu6C2KLlySdRAMKmczhEl_eIEozyTSkTQ&oe=6A8C17B4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnhI4HdLHwMQ7kNvwEg2ijh&_nc_oc=Adoitu2y6_syGEMigs3bOV86m4wnYUgw47TjxoyyWqS7PaqwNK5vZ7YXLEI2Kt63GsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0c35wLOqaPIH3dHQfBzcwlfLexI7BCZeLmU4X_oMPbA&oe=6A8C1FB2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTI28chfyVUQ7kNvwFRM6mx&_nc_oc=Adoj2jW870IcHnVK_hSOAX-myRGiQasLYVtR6pxKwnHqotV7zn0WavdH-lHZbTf2tKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Fc7-2e_9etsvEjQVhBxDXD3AfNFpqXAU0G-0pSFe1w&oe=6A8C422D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev0PBGr1jFMQ7kNvwGfaKJJ&_nc_oc=Adria0mIJr28cONe-ELmVnmn2M0fIu9sDBE9toGTEEa8T8iiZvQi4s8GzQGhZEvEADc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkImHTtife_o8YxKJAkrPyArm9K3qj3fP-tZv6QybKhw&oe=6A8C18C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4P7Leb4VVwkQ7kNvwFmN4Lr&_nc_oc=AdqXLEUEVpMmisMr8RJHnIKGXxyXHBeA1szX4UdKMZLOpeKHjpisCXHCxEZC_2YOL3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF3zQqiBJE1aQEEjdmNqVvP9yxlNZYmPulMcktP9E2KA&oe=6A8C2FFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
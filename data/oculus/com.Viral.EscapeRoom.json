xNpEycuLvEI3sYNFDxPLa3qbuJODE0rU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk4i7x6S0GapKc-sZbDvMm08OVYH7juUNBNLvFDmMHrw&oe=69BFF774"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB69P7zzm-YQ7kNvwFk2Vgi&_nc_oc=AdmB-2RbIsGPppNWYpXf5yexWVYNiOJLYIAhDAHr4opD5XkJCN9Vse6f36HVtywoB_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzuHlEB8eRzK5Bkoasa4CGhcYt3EwypBhjl6cvbQc3Pg&oe=69BFFF72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN5rpKr5_BAQ7kNvwFGicUB&_nc_oc=AdnFOn6QYeoI5HX-rjU2AEFsvXY4Ro88qP-0FQsVEYnCvCVuhoIEX325bvoVeLgYVqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNZ1-jhUiWpF__AdeLUS_657kZXgFhRoXEfEezyBNUvg&oe=69BFE9AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOWVUQSClZkQ7kNvwFcWU0t&_nc_oc=AdkGrWVbl6spUxvVbW9Eq1xDzhlElcG8iR_eBQWPm14F9ZkWhgVYjBcmVymDj6Dsfr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-kByRBxcpJujRscUtBgRrrIcY8uySGZXoJwh8mnm4sw&oe=69BFF883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ6QXTKCQOwQ7kNvwHJnrei&_nc_oc=AdmaPeJSkUam8UHaYl20L-YCBZ0sEKDriVLDqtE19XlFhtWVv4YyJ14TrHVeIw-NtSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiY2HCN91prnkLkfr6KduQUr_MgPP5D5UbezeGadtJ-Q&oe=69BFD77F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
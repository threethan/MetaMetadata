tPxzR0xdhOK3Fn0Sl3pRbmGOcgwqh0r-6yiKNolV1T5BUtEWCi3FkqMAWgjJjTQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a3_qldJUxIs0Ca8cap8RCoIAV25deWEW5TlWkTNj_kg&oe=6A145774"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNkD19ViTlkQ7kNvwFpgp8L&_nc_oc=AdrzsnNxqfv8wvfudEIBglmjoeFwptckK4mJXaszqWD5syB6VmzQUBDJhNMy4aUuVfw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58ZIoPpvBu5uwzpbEjXrMsZaCpOK4_7otB_oeIW2RMcw&oe=6A145F72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9DhknBSnFQQ7kNvwH4pzg4&_nc_oc=Adrr9b7d8zr_KYSOVbd9r4P_D7DtcrMdUa603kx03lclDD8BFspicR358H_68ddtB9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63bJCtZKv-CwXtMVQt6in2uRBJkAhXyhX59XNjkfgShA&oe=6A1449AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa5qAsZyzFEQ7kNvwGXOecF&_nc_oc=Adq3KfTOXlqPlwTd21w3gp-pmwWh0K6G8OqgT-EBaPIO8ISnwCifv66Fff5EyGNwbYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bq1ylvcKiKYFSbW1tLEm-HZkIr2-9nQ6ogvpIug2WQA&oe=6A145883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3-WeMGITm8Q7kNvwFMYYfd&_nc_oc=AdqpHBgswOW2B5Mo7VFFt05djsBMwKdDVij5NTZpC6F9Ji9yVNkvn4wUH-gZb4Pcfqg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C3r3_y0rXgLUgTvM_-w6mq6zFw6rM4yjYbWYXsqlXnQ&oe=6A146FBF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
LWmxkcMNsa9O3bjHtZv6CJXOYIbILIpuGHhKENM9Fc4KbJ2RCKgb5ATuqhcr7oDM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kZgpLv2o5lbLOLhwtmI_yZvWuVbkr06o-kkkLrMtcRw&oe=6A0F1174"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXoKDDxVGLEQ7kNvwFXwLa-&_nc_oc=Adq8eOzxpaIAEC8qlodMd1UMkggyCg7urvLPmYDwngc6btaIogJOryOVhD5yXu00AH8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vps0Ep8skNK64Hc4b7wOwVWfr9TXalK-IGmMDTjVNsA&oe=6A0F1972"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdF3OAOTcr8Q7kNvwGY8mcM&_nc_oc=AdpAvUL9GIa4Vlakt-4KJNtnqE2pPfxXhh8dcw5Ur2Hjr4_uX0lRdlbF3fyykNOQK2M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e4QpdzoM4ojp-dpzG2P1dCWTtMmx5b1iuv1p0EenB3A&oe=6A0F03AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luqn704QWakQ7kNvwFq_UOZ&_nc_oc=AdpDp4ZonBJamSYXOtQf5weYXkrqUTo8v23Pyxs0WlL-UJZr2qVVueSjFZLx4lVuS74&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sXHckSMo6LoWjzS8HyZjyNz2jV7M3vYDggj8kPn5rGw&oe=6A0F1283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_zkwWdIxjoQ7kNvwH8kUr1&_nc_oc=AdoiLI7BHc-oxKjzTZ2ybLHc7Gj68kYefz8YdsjpR5FdZekiPP2jp3cRZ1GrQb6KtNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sdud0O-YblMCRfxXc5iEo7p-nKFZByxJrGgCaudHkNg&oe=6A0F29BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
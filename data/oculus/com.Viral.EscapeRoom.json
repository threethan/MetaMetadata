f5I1NNQ4JZ03ls1NaD7vZR5vVIT-ZykQuO434JILg_vq3qHOC7t2uorhAeKXOaK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74uwFDiZ4-W_lPmn1Ya08cSR1_c-ppBf-HZ7Wvl69BHg&oe=6A199D74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sARFg1C1vj4Q7kNvwGHbDgj&_nc_oc=AdrFM8ucHpaYaTo0WectyWK2GMsScAaa0Bam6GtgTBz2nHdMuV0AtXJnSI2u-8PG69A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o6gaPy_syFlzlpBWqC2FDoGdoiC2N0weEENN0iTHS8w&oe=6A19A572"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNM3JkIVn1sQ7kNvwHh8phG&_nc_oc=AdojajahvYtNF_df_5rAJsZOCm2_W9gTU7_GDsEokPaQpePd1GyRso0TFqlkdw7ctww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R0vloWTbVtjmvXAnH2M0ZzJzv90CBrQMr_xWU9uxbZA&oe=6A198FAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKa2g8zbSEUQ7kNvwFX2wkr&_nc_oc=AdrT13Vpp3rSs8nNQJHat0Cgic4q5-qruk-1DSaVIOKNXtq7TH6j2OTiiosaID_HNKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B_rdMELd9O7tDdvQFKVxoSJDZOzao-y7mUUkI8Anu7w&oe=6A199E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NF8A3XemXIQ7kNvwE_E_PX&_nc_oc=AdqxIG5IW-z35-d8R3B_DASDDuDX0rupHmhsrVi2905BWmWc_7QUfFJvyoGmzpa_ZZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u-uVLgLFDoFObwu-YP8fnmDcPQrssI6pu9yeRsxE0Lw&oe=6A19B5BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
0amo_ev758lctWfu2mi0DYScaSzxd5K0on2ZzFtzm7tk_9FR4doYkVCm5G8eVQp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IGnJvdaunFrNKsu_ipEqn8BgX6QBTYJvPoFdX4L3AFQ&oe=6A47C1F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ8m7r__054Q7kNvwEOzR1G&_nc_oc=AdobGxURZpHsnKSrM8mukHVhnH1Gs9q3-IlJBmqVyX7-Olke-onyNoe4ksCE6AcgBvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vdh2I4QNsrOJ_5I7d3qJ4VW5HTOUaAttmyy18JyQD8Q&oe=6A47C9F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIOGRAukpQMQ7kNvwEtPImK&_nc_oc=AdosEmVv3FEzMWKt1GwGfKIlELt5ATVvRZ_46NKzBeXfwYZDD_CFZSVZqzwaJv6U6GU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9meAhflv3KZK2xVUOlU2IByB5TNyfaZfAyAJIzjA-LOA&oe=6A47B42D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuotM4JiWXwQ7kNvwE995Wo&_nc_oc=AdrO2FXuQhRcpLLqZ_A63HtyLxNArRoVGoibGt1Di4pWCM19mOJfT7sbkQkeAs497Co&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p_ryfvUh2ikd3FqybniyVtklcEmoK17Ljp3RnFRSJUw&oe=6A47C303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is_Q1m383TsQ7kNvwEpaKFR&_nc_oc=AdoO428rKcMkqtCcBCDtelIMXKk3hE7I12X5N6ERfnY8WESs8E6BYtQsDi_Ds7LUhq0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w3mg2Xky2z8DLpH5jLLcFpDOy_YuYFstmQDbBeDoxwA&oe=6A47DA3F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
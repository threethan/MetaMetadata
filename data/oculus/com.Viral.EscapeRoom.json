wOSTKfyXuWWbsTO8b7YIWz2IU9LpVljBKpVBe8mKzeqBZDoQWAmG9mWkb3IId6tw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-dremTXYdCmXdBruHT6un3UUDSxhCOlhShoWVyqohag&oe=6AA2B974"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oVId-73CfIQ7kNvwHVwYZG&_nc_oc=AdqoHNaQqt2WmpM7KpdcwMMcEILfVizXujj5h_Dv1qXZNsYp8_IIrztaJp2qL-1rcok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGO0N0wJ-JIHLVfZK8bu5FA2GFaAm_q44ml0wEfkP4ug&oe=6AA2C172"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8n6U0yPKxUQ7kNvwFlUZem&_nc_oc=AdpbsDuDqxu_BpzGP3Ri47YtBBlzcyUtm6RrgYfjK9sdWvNjGrpu7pcPWE5Ij18uJfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjW_Ixo9nM53IAhkyvVcEOKyp2dNTBsn-HSdM1OzE1LQ&oe=6AA2ABAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLnk2kHxBBAQ7kNvwFw6HKl&_nc_oc=AdqL1O_TWbkxBZKeP6I7qm7O_c6XvXiDBh_z5ZlfOzacqNanJtA1KjxnbzrE21Csn-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX5XCg4jMq2_QOioBwPGZoVGr4wT0r0bfNdbViKoZ4XQ&oe=6AA2BA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etJLWTdbOfAQ7kNvwHVM-B0&_nc_oc=Adq5GVWSyn-jHNvENFTfwOD8snz26I4f3CHw5II-WN-UjxDmlS9Ph0RN2U-luRJUpOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkBdeGaT3G8DsqXhthUsFT2GOsnDfiNsRy7TR2dbhW_A&oe=6AA2D1BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
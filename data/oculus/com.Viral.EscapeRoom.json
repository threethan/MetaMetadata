vpbEkDb1wmk6rl0m7zoJwywHAHdqWkKRAZO1IduUppZTnrPUmngk4rUfXLyXT68E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE53CUtTngksO3GZrSq8dPOB948K0NCL0cIsotVaCU8w&oe=6ACB97F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1POCdZsevLYQ7kNvwGab7oJ&_nc_oc=Adp6P9AnjKHfOPOzzRac4Nnn9sFrr_Grj7JZ2xX4zXZd3Ly3y2Pejjgf-pqFQ39XmJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsj3t5bCYicrLQxp2N1XTaGvGTm5gurtgL6MYSPM5DFg&oe=6ACB9FF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7png_aZPgwQ7kNvwHK3Or9&_nc_oc=AdoA1z-Y45v0aKeQFOcfqoVIeK-KJfagCEpTfzPM-AMWcE_QEPHd2kb47_ekt2QPAyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWYCy-BcXYnKP5RR0ZVfZXGoWj1ETnFIlvfAkhEEtwWQ&oe=6ACBC26D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPhcDW_BI_cQ7kNvwEBhs18&_nc_oc=AdrA0GxZ9frTNBdeFL-7-RArxrEoDIr2_G7TLBHuA7-k9tDrHKpzqzXqukiZNaRlmGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlxgWmD7wfJAyQ5L_3aawpjR3ujb-aGU4dxCuCBRhTxQ&oe=6ACB9903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0-k88_yRqwQ7kNvwFYvhd7&_nc_oc=AdoeLn6bVen8kdcFMPA1gqLtt94HIlFph4w3uPKGkn8tw_Mxr7OE20Cgt5ci4UaZ7hM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd1E-dwvmxZXcYNWqZZ-RlGU36Q_cx07PCp0KfnM0YGA&oe=6ACBB03F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
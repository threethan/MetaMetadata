gnZBnbFOOn2QiryM5uGsTPuBFYrkYO2Ejaqd5vm0iXFFsuq0e0nOClsdv4LJt7WU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL8bYNCnAjb8CaNa1zfeS-EFmLs0XBY8vc7H1dGI7mSw&oe=6AF324F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zts6I_2rPJ4Q7kNvwHyTYU9&_nc_oc=Ado2gP2EQkNVuLnwKkEV17gjyQ9kM3goCG5zMsesRFuCD6a3jAeObnNI12xkCuu2FwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhrHuAh3QxuKyTrV6RG5HExYHoAFE4f9PQMq6b6Jn--g&oe=6AF32CF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIPUXrjZp_UQ7kNvwGqAD9C&_nc_oc=AdppwIjrhHuZKKnF8E_y_4fQ0U7FgPVsG1sQK_Aum15sm0sr5tZ110U_q80QpJCd0fw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTnNJh7JGf1QpSLuxPiiZQpiZJLjUc6GGSB3Cg0q58MQ&oe=6AF34F6D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VPRWFN_NhcQ7kNvwFTlX_x&_nc_oc=Adrt-2-rO2Wy7eWsJFCGlB6OCE0zqMfXwF9Ipv85JEVNkWv4RhkP3QkZPdauLfZhhIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8GrojvzRkdD2UR42BA5YUuFgGBnCOOfCUOkTZVEsD1Q&oe=6AF32603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYUbiBLVunAQ7kNvwGRcjRV&_nc_oc=AdotWUSZm36K0n-bjSGU_l4e2uuVQBl7eDB8FPfX0r1omtYJ9UJqLhVXodyuDsIfMwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAHhjZQubZoQLcvnJue6hUn-wYa-nRx-wQSUTkFUge_Q&oe=6AF33D3F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
Y4DKjVIyYBHWiHERrnSkEYSG8rMl2z6fysh_2JbhAriVEpi6CwMyB8IloRz0dWiI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YZbNZaMWqb5UjCGE4Iwf9B9eNGXbhRbmzyyI5v1PACw&oe=69FF3F74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fV922tiP2QQ7kNvwHLh530&_nc_oc=AdrHPfkgHjM3ZUc_SWybtubEvpr3eV6cdcIZ1j3YB-Il4ah0cXglvn9xK7ZCQGH9XXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AT1NlZkovyJmjGwUmHmr8qTrb6wkUrj6G_cCcoh7Y9Q&oe=69FF4772"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpbGpW060vwQ7kNvwHCKqyv&_nc_oc=AdoJABRRGxO9c_DG0-AQC1lud_kiZmCEfzRWBgkUgapGFYbVEZX8VwXD5DkZ1KbHBmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t5NRiTkHFwiPbtCeipygrpJqiuyOCHh_0jVl14OAj8A&oe=69FF31AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM3pqAysLsAQ7kNvwETuUbL&_nc_oc=AdpVdjKFqrCl3hMnhTotsZdGeq7Gd9nCsvuRdDRhUNmyqbIfpueO6d5xe_sVoXRa_mI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79ATSZsY1_1prXVUALfRB7LUn3-qKKYNVTyW3QtBnmQQ&oe=69FF4083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaOo8weCKqQQ7kNvwHIfaPh&_nc_oc=AdoJwk3_iDH3gurXFCFgcxPjyffHyY0C6qrvrk0aoiy9xozjpTNu-cZY80p2r5glyr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ERJT5Ik26UR-ATgwPE2r3Y9uwXfLRwIY6bpssG4GJOA&oe=69FF1F7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
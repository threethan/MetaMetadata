8pLyDGORLwjbaIfnXJ_3Vt0ObZUk6m84GFUkZ1YuAuDNik98Xu_0u0vexzuyNTa8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER2F-AAlPETUQmN5zXMjSjYMUzvFdZ5AIVnNVnVQLCzQ&oe=6A7C7DF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo6IsoqmjoAQ7kNvwHbX8CJ&_nc_oc=AdqhYtWur1A37nfB1Z-u6kvIPJ3_-S5YKdfzAumP37wN6K9BYrymNlKbFsEgQRQ6pyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxWUoZfbGrNrDH1DoIuIkeWMjc2xNTcWw6ahUNq3SuEw&oe=6A7C4DB2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KF5Z-HxlL0Q7kNvwHFfS3p&_nc_oc=AdpyUO_S1EqNGDYOSBNIE9oBwMS2mbHDrc-YZfI5sKKoLI6gw8JMu431rF77g-Ra2wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWhmeY4cMit8mHtiq2GM2SACZiE83FKljhock_Wpv21w&oe=6A7C702D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtivAmbBAy0Q7kNvwEwPwcA&_nc_oc=AdryxNiR0AhEnrLDgA-RxcOP2Bn2XY_LldmoblB6C5krf7dKEbr1RD53t_G65cnVo74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4pwoK6kJokUR1xsMUQo1IoID1zhF2bvwkH3I40y3F0Q&oe=6A7C46C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8zt7DJprBQQ7kNvwF1o7la&_nc_oc=AdpzHgaJ208_or26fjz6CciKHS4hbsETNF-qB6AbQ2ag55luUQT0Gmk7P1iRGXBDT2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfs_6etWP3k0mtvuELAGtXLTB00IAAQzdw7MUvArLj7w&oe=6A7C5DFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
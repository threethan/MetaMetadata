z5pmXAS0uGsrLEc9sDQ6Q80tNfN_JgLW5ZdBOrw_n9EZ9D1xYlEHguMZSdlWePng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIrJ1sdkyIcHXL4eiF24MU_MCGluLm3BxJ5fO2oSksBA&oe=6A70A074"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqVrtTpV614Q7kNvwG_lVB3&_nc_oc=Adrgj1pYxuO7M9YSUk-kSe-po_bumqRnsplvyxrIKuwblBCL41_jNy-qvb8EYPdcQ0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt0aaQHP08GsLpJrncoBuSpFL88NOoqheJvzTxlI6nAQ&oe=6A70A872"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kNbfyeoRc8Q7kNvwF7bUuG&_nc_oc=AdokLzBfTRBloLN_kCB-EqwzmHbGzHLqgKU5icHNkWMdZ4acN3n9Ofy7va6E304hl9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8WUVduboUGbirpMt8S_4WhiTI4-AkFJFFl-XhU-q0Iw&oe=6A7092AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIyVlYQlagoQ7kNvwFMU-4l&_nc_oc=Adrc9PETG9b-DDPTUSWQhmxBy8xRHAGO1A0LXj9l0G5czENS0gSF7TdRwaSGVPle9RI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9RW_Yr6U02VhtpC_4ZzjpRRvFizYd3R6xBe_Shjhazw&oe=6A70A183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ht49nT3YplwQ7kNvwHgdasD&_nc_oc=AdpL7FU2xfHSvgHSBiGPvqqYmnTnG6W4ncnH_zOpnOhEOlLNngQkOPtb_78E-cqJWkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZKH_5kxS1TGVTTO-30AFxetqIL_A6pRj6KUUXoDcdnQ&oe=6A70807F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
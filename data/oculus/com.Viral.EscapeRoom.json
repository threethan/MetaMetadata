_605eU3aZnJ3Rfb0Eq0FnH0RLNdqTPFk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2M_3xhV6TGZzKLqYiiLHIevzC5ewx_GUKAEUiPaEsQA&oe=69C148F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JsNco4wMVsQ7kNvwFO3CkI&_nc_oc=AdprBrLTj5eLxbxykRII3kmiBy7Voicu8Jhf-8L3LteH-krYs8nKK7kf6CoIvEwzJJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYg2vwakjPAcfd2kpCt6YugOugBwJAQ2ermH7twI8zsA&oe=69C150F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN5rpKr5_BAQ7kNvwEwIdZK&_nc_oc=AdoEQXBGp_GgPWzabZxyYL41PRaM3lnZYPaFvCxHBy1XYd3IFkdB_EnJf2naN3y8y70&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZkUyqP8BnUrAjy7tmlYUrRihOn_bA-orAgdFj-Yr4Jg&oe=69C13B2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hk0bqjrSWyAQ7kNvwFu1oTY&_nc_oc=AdrqODU5TU7PMPZYOA81Ajov8_5IsF8Kf-PNFP4A-Epie6QO34yqUGf8M8MhsvQPZNA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzIYuLoHpv831DZm1Mw-pLeiCf8NXXeiY-mhRnE2luUlg&oe=69C14A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ6QXTKCQOwQ7kNvwHZjfQ7&_nc_oc=AdoRhW2nJJk54koTMZkrdx25uKocMjMd8pmnHq_LHHMzoV8ixX4W-mpVWl-f5KDHQu4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuPlMYwEBqdHKuSTNapOhc7Uq4WkC-UX2566fSZy8Wmw&oe=69C128FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
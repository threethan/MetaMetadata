rwAXT1gMqx2jBtkP-RQuNBYvTPsbpbai9zQ_J5fxYnMRSX0_f90H1pUVoImb8KJ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi9IJ49InvySjXupB7G-_WOuvsvqOAVxu067Pvdr8yNg&oe=6A71F1F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqVrtTpV614Q7kNvwGXob4M&_nc_oc=AdqgtjFi5fBKvT1qExykYro16Z0JpojdngehsyeOvOaNeXpvC0xsUV9GBrg3NwT1lCc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd-CqKsK7vfxzeEaDdgK3qzmtqCr1wF6olCvv4VJ1amg&oe=6A71F9F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDG9rj8mkpsQ7kNvwGnoNrB&_nc_oc=AdoODfhyRtzni0bbdkPItlS-rI5-6P-rx9CfNGgetxmmWTbTfUdopdwGp289ipT1OzQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeBUKhJhKnNEmCEdoPl2X3MonEmJX27JxFaH_FCegjHw&oe=6A71E42D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIyVlYQlagoQ7kNvwHaEoXl&_nc_oc=Adq1kIHNG2-_eBEUniLUT5ULITSfMpvCmP18oSfbUd862U9XEZaqU2E58vxPcYsz73g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzpzghudTdwPxgphVWGWnBziOtb9O6Gy_6xfKKQgmBmQ&oe=6A71F303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve14fAuXbogQ7kNvwHAu9-b&_nc_oc=Adr6rJQd_E2ggxF_debfiuor1-vuPQY59els4jPfXG3oHqmFb750RSmFmPWBXr3qff0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzTBt-N1iwnmh3P0UlYhDuzeuYrTK_YDOjMk9KTjNUqg&oe=6A71D1FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
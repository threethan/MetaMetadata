cHrqGOk677m2bEWCxyGUvzQRRdWfDw4IhZ8qC5NxaAyMTJJvm655OZEAAgnjfGDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qShunUebhwFaJKGzQd1fo6iLJPu_4--w4xcSmjAF0Pw&oe=69ECCA74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4046BWPLOpsQ7kNvwG6Muus&_nc_oc=AdrNXxGX4TGgB6syEbkYTcKRo45LeahCY45P964wTTmynP1sGgjEzDZxUm9ZC54j8iQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j6YuXg_qveIShW2w14q8a5ehqdjl5JaNnlrUBgZ20Dg&oe=69ECD272"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqFlokKSjw8Q7kNvwGMq-ad&_nc_oc=AdrxKflOxeVjKJRP0QPzqPR3Wk2UlSkfkGAXCjF6TYjJOcTVuCsYYsoJvfqxW5y6Y9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23fd1kI6UMymI4Wu_B-pqY6UsjlsSIAwnknfUqox3oRQ&oe=69ECBCAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKofQE4_PiMQ7kNvwENyS6x&_nc_oc=Ado9t2fLVZ8UudIysn3k9EPKJCJayLIjJgmJFaMXJj4A0SX2rndRCktAV8oF42zD-H0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p71okvSzzQcvFMtoyeNbJIEf7ypbDWc7mCyAx7niDAQ&oe=69ECCB83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faxJcY4htxcQ7kNvwEppxN_&_nc_oc=AdqIv1NP8xBQOAXfYvFEHVFv-ksBKnvIFpDoVeMSOWrNJSoyXkn8-AVFVVo56vykg50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oC9YUBxlnaIagZvTX6CXh7yWnh2hQb_fUwlBPMzhO7w&oe=69ECAA7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
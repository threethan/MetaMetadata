oc=Ado22c_7_fmhS9q6mUDfZD3DubAwwV3kvVNrnRUTGM0WGb9gKqcLRIf5rEG1M1nDdqc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FupRznmugqWxwv6s05Y_GqPlvMKD317VchB95TAxPOg&oe=6A394174"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C37M-UACPfYQ7kNvwFJhUVn&_nc_oc=Adro1NCa-ERu0Nls94fvcMh2zn9DqGPvUy7rDo_kshHn3bPIcLeFwPN51rhgs3L-75s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I0fl1p_E47Bo5YQh4yRpeWrjy4_kUqJeGAC5PbJI7yA&oe=6A394972"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zxw0mB05paoQ7kNvwHPBpJ5&_nc_oc=AdoH-aPO4U_CZr1n2p_P-zk3RLzMWamgj6YWbrHiJDpR9WXj-u8aP8Dy6ONhhWxk7j4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VttRYa5KmdwLh0ADRGLoCV_uVVf-FO4CMiNrNH1xdDg&oe=6A3933AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R1Tap85AsoQ7kNvwGkIiwA&_nc_oc=Adph5mWWknfR76PznYXlCZix0H9UkaB7260_meqfbBqE2X-lSJEQo4l3oS3D8twfCRI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81gcJL6Pyf6ztm_qpXoprpgkR8DGXPDY7d8niTL3MKuw&oe=6A394283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM-rEUSYiXoQ7kNvwFZG1Gu&_nc_oc=Adrqkiyp9mhJuY9HIq9Clj1HZoc3Dx16BKLSCrR_uwJHhi5nS8y4z_hRIx0CCHPPCKc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MeDPMHVibS1E5M93LrCruQ28IRK5kQYgI_2KWTMGvgg&oe=6A3959BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscript
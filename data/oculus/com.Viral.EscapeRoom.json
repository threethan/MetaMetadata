W_2tF4dz87fugg91G2MEl8E56V6HAFkcjMqgDC0lGwfyPM8c3DVQqR6hIhQ52BXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zdgLkMeH4fvf2NVOrZIgA_cz5ddQpEbxFSEOY8cCPJw&oe=6A16FA74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNkD19ViTlkQ7kNvwGwI4_M&_nc_oc=AdrIUlOJGebQ5wvWjcNlp9Y4VC5xt0Wo3KZt_j1k4BZDSbqEmrgIWYHGlSDoZ25Zviw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R6rNQo_YYv4z_Pwy4rrTA8qgyh_9k7rx24w4maFwEVQ&oe=6A170272"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNM3JkIVn1sQ7kNvwG-FbWM&_nc_oc=Adr4Q1dhKwq-e0naRkXat3TeLI3tGy8d2aoNV23WzC_P-iKlbhlVrfDxSLaUiF-t8OY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hlGK9xA9EgTWQM1vPpGmlUpBz3yj4EDSGRT2tmoQ4Uw&oe=6A16ECAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa5qAsZyzFEQ7kNvwETERpi&_nc_oc=AdqUbzMLThIbEgUj7LEzP1utb8T5PzF2I-eBujZjon1mRzS17b1MZlEdwQ-Mg7v-1Hg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IGhqv_aS1g9rqljXTVX5InBGP_nA8g39vWZ2bk2jOjQ&oe=6A16FB83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NF8A3XemXIQ7kNvwGISUNw&_nc_oc=AdoycYYX7zBVjghvirc37eMs1D8Q0c05QfT3lB6ela_aE2gLrJCUJe8VWOec938YUWE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_h3j1daKKIVJcTv_yO4OmMMEBDFynxMNSgEgy-Y8Glw&oe=6A1712BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
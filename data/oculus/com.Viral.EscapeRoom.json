YxhThptaICXYEWDz7UGzPLx8H1hFj5GjtgIsYrqBjDyuEGhyefxFuWTSvt2AwvF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPiytoq3NdoAoyGB0j0n8nkz2yO5q_dTXCHuR3NqznUQ&oe=6AAFE874"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OZdfObWMJwQ7kNvwEvPCrY&_nc_oc=AdqPARe9BlGXCY_kSoE8c14PkOq_cOwtf36yORiI7YkbM1qdWjwT25qXapGGNrvlPlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJczA3OXdGY6cEX-HAdrqSwnKDrG4xvWK467Tx9AdhPlw&oe=6AAFF072"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASt2_MjXe34Q7kNvwHeepyq&_nc_oc=Adp28sva2Vm7Uek41t8cm7Jl2gwW-1bV3wVeNtfduMmPtALzpJ5DF6QX26g7jMO9gZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKigUfQSY5l-xxGcMUXA4v2KU1jDjQD3-cgDj28UzURvg&oe=6AAFDAAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Trquf-yNoOQQ7kNvwFnAnVP&_nc_oc=Adokjzcemq5EZ2gC9HYlHycQ6T6TZhiAYrKI0uOfqX0adA_zIEE8zT4AOfQGunZzCJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6JMvUpCud9Q-igkv2xKw1tq-j8T7bmLQTU-gjOtxazA&oe=6AAFE983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt-0t_13y60Q7kNvwFfBEKE&_nc_oc=Ado3mGQbVvv1v_24If256E8Bz4maYRFw7H5UvUamQ6O9go4jF5TCzn-Jz1FY-NCJ7XU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcxbbMcIyl9MFw7y5LNo-KmLk1CDRPwKR1XCqGiEERIw&oe=6AB000BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
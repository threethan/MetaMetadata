36kuwWMADyH1fv3m9G5T5bihKcuiV4WN-h6QHGEVtRXJDngrlPJ5IEOkbeDCLzpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxEUUETkZsCSdz31mI2tAoDXILAN-YG0Dm6jNFJvW5gQ&oe=6A788974"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYDH5nzlj1oQ7kNvwGBTwqg&_nc_oc=AdrC_chzYNtcGVaet4cr12dUg66v-OlBUEI--xUTSLGB6t8swwERTyYp_S4btwB1Qq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnRpPSd-Bm0kJM-voeYjlumVQ2QVr3XwbmlLgHmYIe6Q&oe=6A789172"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yAZQaC6UT4Q7kNvwFJHPPY&_nc_oc=Ado69orjHNTykgx8FLp8NjcOVIxOH4sPrMp35XM6fQr5J9Qk88fEdl9S0-afFTWG40M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBwiGyV6ymD-9J3v8b8FawJOgMsnPpyLMI4NSAtob9Ow&oe=6A787BAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmrk0lq5ROsQ7kNvwHs6SK7&_nc_oc=AdpUQ9JjrOLxoLjk8Z7iDhThm3Jm28jNAwXilTLTiBdtkNh9awQjyoiBj7cBjmLAjJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHURa2UPQfgyvDMBMLwkYPXLzli6SrR0xnoONJUEMaN7Q&oe=6A788A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GCbKMlrSjcQ7kNvwGzv6d7&_nc_oc=AdokLOhB3Zg1YbgHvPw601yZKbZSlJ9MRGksBnj6R3qNnbGeAhTUhzZtUjkPFX5Q6Jk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSV35jDC0CoclvvrXqEpGkZJ-HGwb263lzfGud6dbHrg&oe=6A78697F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
PG1WwIZr6jT_sC3gHLXyskbTi6nbsByxfOt3ap04qb1MN5es-y50oN2LPr_TG-m4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnqsLZNb6CwzdSQLaeba4r9HxNB-QOIh36mkJ7M25JrQ&oe=6A81C3F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRAJWqcja3wQ7kNvwFmKVMf&_nc_oc=AdrN3TrR9UaI4rIKqg4lJOJx0PBXZhOzf6N98cD3-za5-RHQo88Eq_R3AHu58GyzUVY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7AwpYUGfYzh7dXWDV2qwZFPef-6kXJIgkMBCBMA5R6g&oe=6A8193B2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrYPXxLpykEQ7kNvwGATzGp&_nc_oc=AdrDQYM3xNHVkox1w-K3wOa4cE022vT89De1eEKf56QLlm5PECX8JTxZL65Eaw04gV4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvlSsGuRms1tNFEoi0fLaTCpEzp2Ltb7gPCeze1At3Zw&oe=6A81B62D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3VMcEtlOtwQ7kNvwGu4KK1&_nc_oc=AdoNaASwmDTPnYKNFKj_Tsl1mhmN1oe8wb5bV02xMQTc2Kmbu-_GB5wJI12gx-JUP7M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeOr4uIydqG2vcOLAQNL0Le6q0HMlbD7BxBtgQaoVY6A&oe=6A81C503"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTyJCblWcyoQ7kNvwHi5Q-B&_nc_oc=AdoBoG3MUJeK_yRyyz9PsxfAGJR542Qtu7xOtpE0GvUExQVApp9loMHKstwPZuyPBYs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnvOYmKm_NbOcRYKTBOmcltdv9KJBjJgmCL6eBlZLmSA&oe=6A81A3FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
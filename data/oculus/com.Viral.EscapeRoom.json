pU57wSLqSqZ4nMkqJ0IlBXthKsm6AG4OthGr81mH1dTJijTi4re3vnhVgRvRwnsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHq6AcN0FeV8LgDXD7CUUld78VuP7zTv-ERbXP9zLlWw&oe=6A6765F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGkcuvw2-DoQ7kNvwEolcO4&_nc_oc=Adoxy9m7nfk8TJx2Oq24xh8OC_h16PnoY3xLEOm2iKaYsOKWXG11zN7oBX74QhyvuLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5C5-HPb1a4CRVWhbjF3XJ6xBWgVW-cLParUSn0pt9KA&oe=6A676DF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfVuCl4qjwEQ7kNvwGYnmqC&_nc_oc=AdqYgEanQGfdR_0ieW6LT9mlHTssVlHpT0wqzyNzglQ0EdU4qHvT1W6EpPrfbW9hPiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcs8jE002L4-q3V_VyLC8lBVwH0h0DejnFBEU1gx3tyw&oe=6A67582D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MngV4eHSSUkQ7kNvwGug-JL&_nc_oc=Adrsms4qsWNJka-EP3LGRdKuPPrvHsI06ZU2pt7ZKGOV4ga4aMJXjfonw1YEe-zqRro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOBV8mu7qn4hF7yMoz6o0gjJOZeMt5d7FKskKcLT-wDQ&oe=6A676703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReUZz6ox-f0Q7kNvwEagu-k&_nc_oc=AdqVMXTjo1B2EHtl2sT9210C4Hkdwmt0vvwbdCM2vE11kJeB_Kmf4hsiE22CH0_2Ads&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDch5OsK89BWfVVPBYAsm3HzZ3H5QHPPQihJclbDha7QA&oe=6A6745FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
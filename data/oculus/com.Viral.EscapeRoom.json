fbu3ubdlF1-c987zyooyllgIUgnNJKD6EmgVbuYHHNlxPPCpn1C9m7Iy5iIicN5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I88fMRGLxbmNz3mjd21CPHeouMSL9D2rbZHHg07yr1g&oe=6A43CD74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MnwpfvxGRMQ7kNvwGNfkZH&_nc_oc=AdoVirTjLHpIw5ysmyVtRhnInYr53haaePUU4DmPbFJor2ykXJpo25mbMYDu8pXhyVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xqHvDv2YZyMPsntpGUiF1RdsmmrYcAsEuwqP1zCwtNA&oe=6A43D572"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRoLbUjIZzIQ7kNvwFP5C3c&_nc_oc=AdqKRRXGY59DwKzU5dXlK4S7I_sWbS4t8bTTLQIRCulxh5ud3cH8msZgfoaxZQ7iLRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5tWFQ0dAtM8am5JThet4iewagW9Tu3xaNm0xknTSYnA&oe=6A43BFAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjSbm4vAhEYQ7kNvwEJVXSS&_nc_oc=Adp-xoFHCHXuzDjeNOSO4_TLf3KR4siZQmJtgScK50YZpsojwgs7b6jJyBUC4CsmCRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83KVvPI2k8AyrrA3GXSUkYquosiPXA_lBb-LjLbdf3nw&oe=6A43CE83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luxxcgvK0-EQ7kNvwGWjgoA&_nc_oc=AdpVGw1XC_eXJq9tKyH6DwD0NLQ2frJUDAfzUP90MYz5uBw7PTxNK2-ftT2B_7jdIbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v_0BPlAQNAicqvzFwS5tgTQWh3mSArMWh2ZcKLZmq1A&oe=6A43E5BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
Vz28UGnKAQGUES3Kz6Ss1n2QhyrAbGP8cx2CLeWZ4mF-56JT67p2dPjwAojExaEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G96L16xwGWbiuT0uEatxVnw28adRIuMH2Xk0bIKXfIg&oe=6A0090F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4AvuGWg7cIQ7kNvwH424FX&_nc_oc=Adr7KzCgu5TgJzIHODGdaAktNmxjE8oQs_BKpD-XhWekkbmJyJSduqteA6UpgAGBJ9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77X7tKbL1TSYLszfpm9sbfvOzcEwVW8rPQ-85tIR4Ghw&oe=6A0098F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpbGpW060vwQ7kNvwGxDrnS&_nc_oc=AdqFYPfSPU24zeuzzJv8hKHndKCSvJsV80YzBrNGUI32pJIpWuxvQzvRW3UFISc_Oq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q5wpUPleLwUzGTjUHXk7zIXTAJ70S0Q8O_Ed9NgaT2g&oe=6A00832D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu-VjbfO8wMQ7kNvwF_ZcSX&_nc_oc=AdpOW0rasM4zlr5nt_PLB9shJCHusibMgKCJSN1waCyajRwD34lRisTghdoZYCEQlh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VEPZIYhIDe4S55vbSC_Jrr4Zz6NXGB2nenvyiVJAbMQ&oe=6A009203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaOo8weCKqQQ7kNvwHmlPXA&_nc_oc=AdqFJUtCoLVX9XNatxypa6U8fFr9o4zqTM2-q4Zxs_lh_xrZ0YRkVNQPmqEce30XBBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50hAHXTYkoLQjpLeDgGzXSGpZ8VaZkKV6LvC_8wgHpww&oe=6A0070FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
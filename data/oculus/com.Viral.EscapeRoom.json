oc=AdoE6OHbTAMVjv0ADk2PYneUI9NLp_3uNEDbMxvjslJSQgaWjmKzP97lokg0lqVCJOE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A6szQ5YQ_6gHIC-BJG635EqDba9Rfe60SlclSM2FAfw&oe=6A467074"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MnwpfvxGRMQ7kNvwEaT95k&_nc_oc=AdqYJH0Tkf-nCHs3PUwusrFVZFcWpe4oKHSLS_cuYYr1w7JSYyQSRMoosKzFK84v-EQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HHBfqVdffQGIIP3tTum_nuKh7jxR926jyn42cxJA-JQ&oe=6A467872"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIOGRAukpQMQ7kNvwETSZcB&_nc_oc=AdqpqCbGDwb9j-WdLLYuGSBWLDGD2NLbItqY-4X3Fko0GDOTi3MgLLn7_Ksd16j-Nzc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IE4rqLizvk7GpJ6W1sErJ8jsFFJL_Ei7O4kCrA5Tr1g&oe=6A4662AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjSbm4vAhEYQ7kNvwGV1AH_&_nc_oc=AdqJ3dLdnVkkrxX0EQVMnewrHiXdajb_h18vBTGhrubG3LiotpeI-6_c-O3SvxPvHxo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mby4aEzHWJsuT53LYSx16_DowCefXzrtm3tGW801XLQ&oe=6A467183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is_Q1m383TsQ7kNvwF5aWmn&_nc_oc=Adp9wGw7z14zj2gplcQf-gvT7qton-fF9cjs9kupW_wyYwh2HfJsCh6TKHObCMlaGP0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZqwKmUv0vuVtqTeLRZu42pwadDi2d-9GeEmlgmdnI_w&oe=6A4688BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscript
Lv-jnmkKzHXyw5rVnPRUL2382PckqgjSiYYffr1Rv9rms4TfJUZneAWI084vfKkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWzqUq7p8cEdSkl3dRL_7Yw0yPj1-T0rejJsy7HTqgnw&oe=6A5E2B74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z93K3MVXTjoQ7kNvwHefBtI&_nc_oc=Ado87CbNo9XsPsBjK1KPAPHekuLrtzNaTMgYIuJ5izGWIV_bNsUkLDuo4gz1gHIumxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvXRnv9f00-zUzZtWtx2IroWICIqs_8QIfnML39sdiJQ&oe=6A5E3372"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG5FgL5wu4oQ7kNvwHCTcLl&_nc_oc=Ado8YSCGZ9-u5WaoWIXJV01rwDf4JourYMHpTZ7KSEjlUFDw3_1rTrYSSPorMJt3GgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0HInaffuIXNY1mcVLpdbJRNOHRXcbaGtqSgyrP9ft0g&oe=6A5E1DAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZTcQ6QWME4Q7kNvwGt5aaN&_nc_oc=AdohFhFaU8ibmBgDyYZI0wobBH-9bxC069uI6mkNWyVZDJe-HEb8BXVYOUdbLNRn34k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDybDPri4FOyGkMXS0naOJnxqJbo3hsKg7t7-SGvupoYg&oe=6A5E2C83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xV-dPug-tewQ7kNvwF7uukl&_nc_oc=AdokcsW3a1LIafupmI24AFcJLVu6AHEmlJRNrf10sXR8ds3rKUKRBmIF2nGVKJ2bPI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpANr8wzuyVcCOL1IeN2wAFM2zGb5ra2TFUsTeiffxLw&oe=6A5E0B7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
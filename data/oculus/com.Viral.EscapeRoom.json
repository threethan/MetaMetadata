CctKWE7sWipdnts1ELN2DXASlme8PE_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYJcPLLNmNFlHsvjv4H1LjZm8IUHIynkgL3Tbk8q-nwg&oe=69B56B74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTYWALxSSXwQ7kNvwGdlT3E&_nc_oc=AdmRzxwbJAHaVn4cljkItp7GVpbSRvMuvnbugOY7epXRoybjf-0JLdiqJHkl7LislZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9npipRRt4MiOum0IAtQTD6MSo4KD_X72gL0jIV1EinA&oe=69B53B32"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dpiHK-DFP0Q7kNvwGl_iOv&_nc_oc=AdkKbliQQWW6FxPfkL6sZA6nK2WP-s2CIX615B4c7DW2OokrMsIcN5pmHYgyTV_fUz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1bnHQV2tF_wZGiqs7Ah94_CE3Pez6zNPXNOy4osXoew&oe=69B55DAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o6IzzmsWBAQ7kNvwFDbo_u&_nc_oc=AdkGUb852xa-m_cSyl-84yDaW1CtDCqCmrbYfla0zwQffM0vG7WI4aANm0MvZhVQ-JQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrRmpcs2c8MA8C9EsaLe8GqR_O_lHegYzyolmLmG0B5g&oe=69B56C83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSyXaiSmppcQ7kNvwFLgJ0e&_nc_oc=Adn9-gOJoxo79KW48kxhssUhuZtAXuohvsLy0oF-mUMaNHUc8eB8gXoxZYznn-3ukmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6sMhX-H4LFnKpFksEUwFSDDA69y3o1cOe7SvEEmgLIw&oe=69B54B7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
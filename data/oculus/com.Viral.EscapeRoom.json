wAiKxxz3SGkzNg2MMdsPDgTUgRsdAsjtapJjNds4-i1_UsJ1J7NUbCxxJWdbicHY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuRmZmtCL5OXujBudubaEjFfGxblo7DEQxnmu6wgxkCQ&oe=6AD3B934"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1zi6HMoeJEQ7kNvwFooL3p&_nc_oc=Adp3pRh4RSxLUizXA43O2wEVcu5ummBdWarHjPN3SwfItTp4Q42sk5FZOPClqpd2Bgc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5m1Boxq2Fmvcr5BP6pdEIhSEPmJff8fUcg1arTIkZPg&oe=6AD388F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arR1DAuapTkQ7kNvwETKCvX&_nc_oc=Adpf6ljMqNE3CNU42nfAUe5Yf-3gn237Fl5527yFEbXE7RWqgx_i_NJo66xX1uqOYBY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7AD4smA_zed05_a2sLOQezIIGWL83JbmblyrqTBXI3A&oe=6AD3AB6D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxxBq_Wiwc0Q7kNvwEo68o_&_nc_oc=AdoGvxHJeua58QCW91tkaFwAK3qXeSY0em8fX70e1tloqTN3rLlNHWo8ug2uq4ZHudo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX4mbFNrzqrQ1WNc0HPChyr3u3ni4mlDTaumOagr0MUQ&oe=6AD3BA43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExCLM3yLqLIQ7kNvwGxGB2a&_nc_oc=AdrU1LN-Vaf6iuolleB9A2V0iDqcSU3xmuJioRxMYSlkK3_BNQlaAwzv8ZVOtLzy4jI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3H9P6jJv0a20oe3X9N1RmA0o3CHHG9EUIK-eq7YWs0A&oe=6AD3993F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
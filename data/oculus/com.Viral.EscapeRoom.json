AcW1W4r-ZDOcU4AVeXoF1Bz0reHTEQxaDK4T7HfA9subdPdXvKBtoGeYCvMKNNP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM157yEi3bLGPYnomg7vp9ViFVlNlc3rn2RZx6bY1NOrQ&oe=6ABFBA74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C9ET3PXN1UQ7kNvwHS2Fix&_nc_oc=AdoOe4MtUb4cd6xzfURtEOcW9QoANg1o9gpYAyxOZzYeeImEal0NRlVEAPA3t0C1rMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsRkxz-YytnjYCrODyf-TsJcb5TRbAkuHDzANSBe-SSQ&oe=6ABFC272"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUfT8QhE5dwQ7kNvwGQrjj8&_nc_oc=Adqye1zuSRCdLJj6UeVyonGZJODuCFWBeMXdw2KHbihpjE2MdPQ1RbW0XUYClCeAUrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyuxRh-SqVBlvfxJOkPzhSmFZvN44hE-dniWRZHPZnOg&oe=6ABFACAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJT-mio8EdsQ7kNvwGVHz0A&_nc_oc=AdqgwcbCoY6PAh4ysElaPa6T1IoKWMNqJhLcAnOomT3Zj9aG29BWVhVjfaQ9TxOMvP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI9wDxHIPLE7_nyfM-VL6Wk2iKzCxa9SxjH-SKTPYdaA&oe=6ABFBB83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toECbvgXNLAQ7kNvwEDlbXI&_nc_oc=Adp9NPoo9QtkhJJ5Fr3ZnFwV9aHNv4bzd51T-Zesx0pn9ZB3XlxzThfdD5jbu_r6LWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu_FXuARNnloXHi-t0E2WyUSHPjHygqojRJDadHHdNqw&oe=6ABFD2BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
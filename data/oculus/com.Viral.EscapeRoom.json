zdT-ZvQWmsf7ZQ65PFM7AER4DdgGzt3io36vuoAqGvgyW8Y2YpH0RfKUDZtx7rSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9QvopAPjVXOGLZqW-Xn5r5GhY1BxKQ19_L7KgaGQMiQ&oe=6A6CABF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLvzqBd0EE4Q7kNvwGCN-qR&_nc_oc=AdrrcbfE02W7LU-hXpTow6a2scq-icuyIgwUpW7ZVq4NHPFV-t7FE8fiCuwxGXaf-go&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASXQpDu6H5vw-UF3V1ON0OjjVk8k4hGO6O8v2rOJgc1w&oe=6A6CB3F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rotP7i1Ox-sQ7kNvwHXr4_L&_nc_oc=AdoSQqhkWBfCTtx6LzcBMGdXBTx6jp_bdMpmjAPieiCWTDnbC4F0_JE1oCVxD8fuHYQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoTNTG6uc5_byOjL7DwbaEQF4y2uRtBzY7c2pxombJYg&oe=6A6C9E2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRHdHkzBPRYQ7kNvwFEO9fa&_nc_oc=Adr8KCZcGG3eIi5-8Qt9swEBmDrWo6R9ROx0onzkHKIDYrp1_-EqkxYqMJ2ug8hR1hM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8lNn4U9EvnsM5nsQ2h3DHmSnlGwnX2D6EBWmbUHD2FA&oe=6A6CAD03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUEY4IdvbvkQ7kNvwEAwxg2&_nc_oc=Adp3DXONWcLkdyIWUgkPQ2-FQKUzxHmLZqgUAjTwSfBz3a3Z8zSH4eSsWqR-R8EXlYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuLpMBqvJs2eZDScjFw5IUuVECSJebO-se1A2Y5JF9uw&oe=6A6C8BFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
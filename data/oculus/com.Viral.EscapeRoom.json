5H_KvNqwWbLlO1qmrcJvB8XYKh1uTOlD-MAxYOIAJ0WkwZPAqW4TCVIWPr9lXVNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWOkLEywLKbb5B11Jx_dbjQ_H2abycvJmZz12ZGwleXw&oe=6A9865B4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z2IfyERCzIQ7kNvwFvLsbQ&_nc_oc=Adpk27XTY7ZSUsEU2kfS8Jx5XDEligvDDP_BaormIWmFmmk2ZD9RTQHm3dXAq44xL6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFz_gEuKPHB321BRl4LOPnFOkdBYrwnq4XzE5yJ6yI9w&oe=6A983572"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCLORm3K8CAQ7kNvwE_VzM1&_nc_oc=AdrOjo4yZ6HXGvrbiFe7lczJDJdimcj7mJiTbr7q5fjULbfkHEA_lOpw0qw24VFZrss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVw_rBTeHWlDBW_Bh_4qutCq77boh4SnZo3sQB5Ari6A&oe=6A9857ED"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxq9i0vp9HsQ7kNvwH-LMAa&_nc_oc=Adpbj79pvnbcnXvIXi91yUwTq8F2vVnV2jJEnjcC0AZ0DY1NVy7hpvn5lPT2TyMFzco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8PdHGSnGjS62Lh-4MFGmjCFv8XqzoR4q060D_B7TbXQ&oe=6A9866C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il3FoEDivjQQ7kNvwEs2IkI&_nc_oc=AdqA7LE-VkOVLe6F2bcRfjgL3MHf6FjZ6WcExfyrB3ypwfjkgGLwVOY4gCpJydLE6-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpuMwCEAQvDzgh4qG2srd9sFSejlKrzTQKyNNLfrsRuw&oe=6A9845BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
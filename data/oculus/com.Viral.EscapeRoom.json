0sMztUSwCE719OwrBbXUOWTtjwrA3ysum16uF0I2ASjkUFO9yhdYSBgb6gOBYvg8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv5PFYcqULjFzQzgqqmIZFmu2BLVx6ijnmSMikXnkMPw&oe=6A9AD074"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fwh9CPS28oQ7kNvwEZmJrP&_nc_oc=AdpEwOVSvJDCdXtbq76ST_66_z2jNNmu67g9UI82U6qewYKHFayGwbeBX2a4ZgybwBU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfaDW15JumATewHTbMR2wdS5aXKTE0xZXJhxZzrSlkTg&oe=6A9AD872"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H20NCKBJsvMQ7kNvwF5bv_O&_nc_oc=AdqBpXqJADZS4_Tqiq17byxD8WrElSm9x6F4YuQ6AuoaNwRxHFnVJMlGYpDHFQvv2hE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhABmONzT5qkNQJKCb-OvElH6_zbzBYB0N35bRw4ra-g&oe=6A9AC2AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYX8vUuzFGwQ7kNvwEVoCLQ&_nc_oc=AdpZvXAX_kt-H_83rDKLPrqOKczfPZTaK0W4JJlT2qtueOJxSVUUmRsvR1t0WiGgWLU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJR88ZNTR6LnWZUOugo_9AA5piJHBLut6q8pRM9f8kAQ&oe=6A9AD183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ohp8-bQOGCgQ7kNvwHW0kq9&_nc_oc=AdrWYLWw9LVMVKDNHgE-c2_FpqWuk4XzNvAs5-ysKTaX5ylducTstJKMuDD5wrX8E7w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSVAs5mV0pD3t4-QOWgE3WPVWfGkEHS2p17CH0K8KO1g&oe=6A9AE8BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
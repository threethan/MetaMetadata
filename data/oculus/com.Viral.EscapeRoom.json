YjvyG670bCshROwDkeRIkbsXIMo4ipPx3NRaJTnIQKdu-zpnipxxiUfvfwp2eDgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V_1NNxZUVVm9YEzZ-FxQHL4p70CGEyyY756s-tX8i8g&oe=69DE49F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8yzPd2BWP8Q7kNvwHIENTt&_nc_oc=Adpakiu_uO0XPGUpMh4w2PMAEflb3fve2KZfGDAW9rZp3xfmTsxDxxoqrgEfDOMFJkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pbh5tAp-AAtCzhVBPy4FgZTx8jWHkiG5bh_Wds-Cqrw&oe=69DE51F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiSrkuHVh-sQ7kNvwFmhytU&_nc_oc=Adp3k0-aJBLrtlsNe66Zd43m-5sYeqmRDxeQBsS4_h14fRE4a52ZY1SMldjEEbWMKPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3spcDmSThyRUrz-7yk8N-isDzXVU_BtC1yYzntYOS__w&oe=69DE3C2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRJpf-f-a0cQ7kNvwFebWjW&_nc_oc=AdqHBIuRM538MHizqMEIu8AAjNf-772lTzJ9dwIpiaaok4zAWXsmdL1-RRgbLofaX7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16CDnypfRPqHLAgkJC0ifRBBkjH9HbJKg7Ga7arUW1HQ&oe=69DE4B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEpiXOHHOMMQ7kNvwEbmIcv&_nc_oc=Adrp5rMc1cc0eRnS2KABGoVnD8TuygP6cTjnXrFHzC85HMBOsqgs7TwaBGTxvKmRffk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SJopWmV0G6PnvgrNJT9xRU4fTY3_swsEkKMU1BXz2VQ&oe=69DE29FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
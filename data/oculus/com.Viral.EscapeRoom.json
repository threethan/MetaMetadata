ctrZWIydE_OAd5orGg91haPr0KdndydEw_58a-pIwrt34sjYKJ7FXJ2jqTS--zdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ-QffUgPacCp_H--w1F0s3pI4oCDkRo_wYddYRCISFw&oe=6A997EF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z2IfyERCzIQ7kNvwHDQuoS&_nc_oc=Ado_JKwRW1xSX3l3I6mZ8oltRcBeiGS171EEOwB75iJmYNvZmQvLYP7qNYyH4IMPwl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkFKGNLeJkAEYGVK5oGt34DQb65FnNz1lS88_XgvT3Ug&oe=6A9986F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H20NCKBJsvMQ7kNvwGMQ0Qp&_nc_oc=Adq7clkrZkYAB_aFARIKm-EbFA4U1r773ZeeQv0Pcogoo4PVVAUfceEoqfxpfmENi40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuWNTv-nCt7xm595WmK-3d9LmDWU0npSy5H588kNIESg&oe=6A99712D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxq9i0vp9HsQ7kNvwH0Z22J&_nc_oc=AdqXt3AJNDwQOUAX2DFB4OwC2YelOAyDZWEOfXdlyro7tIDbHKWGx0yHTKONFGqn3cc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8Jb7kyUgeAzs-0iU51wmSQCqoBimuKv73PI9vf-ow1w&oe=6A998003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ohp8-bQOGCgQ7kNvwHECekt&_nc_oc=AdovYEOPmHH-hwZSFkg7tR5Cv1tj3KAQ2ACY63t-088EdYw10KiUgji3F2BPox5sM1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDGPwbITHqoLFedXrnx4WCit6gCq8IYRWnmcEWG_Nr0A&oe=6A99973F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
dn.com&oh=00_Af1bNR_7HxIiyr3BnOJrOlLAYJAbWvUe95KZuJFqK3wY1g&oe=69F0BEF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIzxtKjXpWMQ7kNvwHy-WJC&_nc_oc=Ado0XkatkJwXRdnHQvgQZA0RRdG1wifOLwkq0DIq1yb6GjYXU7ICFi7siKwvUP6WO7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af25OMmK8nAOKmSjQGQzlgsP14uZLzPCNe4_XhfpduhCtQ&oe=69F0C6F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrz3u-oF9jIQ7kNvwEtX-3q&_nc_oc=AdoiFDog3J7-g3CEQGe0bmhCw9pzyTUKvX4CSS32KGSHJa3I72u80gCW3lx8KTqft-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2QEWdI36USDqkneNrkRXcU5kfpE25jDf4DdTBZQGN8Zg&oe=69F0B12D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RY0IWK_MKk4Q7kNvwF17H-k&_nc_oc=AdpSUdqlHMhoppAXidcq5WVPzElrMt-e0796COs1AC-jr6BgixRXJPEu2hbrwy099Fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1g38fTY0jF5GTAGy2r9mwWEpVN6u2VQCORpF9EQKUs0w&oe=69F0C003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE-g_7je5H4Q7kNvwF-hVEi&_nc_oc=Adosezkcsv-Aa1dIGmtS6JAdeOAgN8HjgRwLG3UGYT8a-x56corSemzkJhhe1m45n3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2XeW4HE5mjoef8SVe84uVgPrcU4efHqongkSrRimC9ww&oe=69F09EFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommende
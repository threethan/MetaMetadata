IGWMnN3fFKOlGoork72H2mq94aT9XridgrJIHmlcbII_MuenVNJ5hUOaQdqcuAmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OfhXuBu_9Tpst5ecmQKrG-KJC6lAGuozeZWAAWmZn5w&oe=69D50F74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9N11zWYveYQ7kNvwE1Wvw5&_nc_oc=AdqNQSiB4Yf8js8IUxDSTGyv6n1JiM0qvjWsYbzRGykq-OD0FAtVFYIV7w65Ct3yQgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RVx0SmWOdwM3qHxZtflFLnr30RXlfAaWHaYEWPeSiVw&oe=69D51772"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvylzp2bE9oQ7kNvwFB0YWP&_nc_oc=AdqOmfQfAGNmMQ2ESvIbUTSxKM7gxpfn3oLgMEP-9SXlfhlOQzcL4xWi-NCcTS8V4ds&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GcZsYBwg8edTySNp32BiBFJV_Jv6fYN6qC3i53EGLEA&oe=69D501AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZlN7kOTigYQ7kNvwGppde_&_nc_oc=AdpfAhq5fRxuMFEHjfszS9ZldeXWG_YHGaBLpUnylVSTDPsMnqJb2Sjk0PdjZWOWloo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fYOUm-pp4kHWE906JnvDOkcVdX5gSQQHKdCInNl3AUA&oe=69D51083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNt0sCO4ON8Q7kNvwHFpzas&_nc_oc=AdpVWCq4v-uGUzLjBoZbXp6gJvbIZNcs2yiPX6qUH807Yog64BdUD3G9EPlD9I5cDEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rGr_fGILKc2CFUr6QFAOV0Lu_NmoNIRUapzR6MguNRg&oe=69D4EF7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
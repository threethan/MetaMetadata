_juogWRnfAXh7f7o3NNHBM7P7JOwdWFW_JSO1zcEoRcBSj7U-LEKUXB5VlJxEblg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxmETHAuL0M5slsaoonOQ1WM5B_oVFNikKj1eQh_D5cA&oe=6A7494F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAMCr8GIue0Q7kNvwHmh4bx&_nc_oc=Adp6wOyCgadAmj6lmsIN400wOkTES_WBMpsNnmKbiqSzyJDVyia-OajlPn3x9Fplk6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-CqzcV4_JjGQG7y4zWEd5lSPDnBrvf9BrWaj4ZmrE0Q&oe=6A749CF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDG9rj8mkpsQ7kNvwFXfMwb&_nc_oc=AdofwAcg1FtFPnNnCK8DYAzpAHhpjsYnUmh9ot8aERwZ0VtAcjzeTD6nvpOLwvPS8o0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW9f7Id1A6BMfsDZ8QMXOYHSoFqNzdH2s4_XQwDXZKww&oe=6A74872D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsK9IiLOUqkQ7kNvwFkP0G4&_nc_oc=Ado0PJ1NurhOHTUJKA22Pm8LzEmsqP38p5-R7-8nIyapA0I2QScYAAwYtaz-mLszXno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYCSGrOLXa7dyA6LwjIG0ecZJTCvrsHuCMu0ojavMMgQ&oe=6A749603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve14fAuXbogQ7kNvwEZtUCI&_nc_oc=AdrIIadkxoH-uemjg0XAEgptGErzNbKZYcstaGf2DIgl9gFrZtIZvgy6IEIGIo4RUKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3LjkXJ7PMc97f9xGh1humwVSacKtfEEvKU_c8GdUqkw&oe=6A7474FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
wqximPOQUS3SyA_z_8IX_znBysPJ-Mtk59E5MIenya-lkbRLfyp9e2QHN4uPu4O0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR7ze1ij2gL-QH5lkB3KHUcs3Zwu7Ixj7HL-YMNTbKXA&oe=6A4D07F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnmiM3p2xbkQ7kNvwHkjeIv&_nc_oc=AdppuCpYlYcxUyb39N5e8hv8lYHDpPJVnRsxKjWuUwl53grHUo7WJuxNiuIT8SvORlM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDblMzQSaFBq-mvb_KxsElaWdZEq3FLcBbZ9_McS9rm4A&oe=6A4D0FF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXgFjN5kqJgQ7kNvwEcgTVL&_nc_oc=AdpVVmGX4PqQ4xMmP5h39hiMu454AjI1tcd2-MXGbAh9kO8ZDMZJE_2f-QURnCbqBG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA39rZownqX2mb_aI8ZMO_PP78vrIDsynRA9826x625g&oe=6A4CFA2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxuPJrVIe-MQ7kNvwEwXv92&_nc_oc=AdrkilObAun9IfvzFnLY49PTedjqKLPMFeQlZOFSXikDzcR3ZvrNKnDIQ-kDacxVx7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8y8Un7Nb_ku8m5AmGSJjghCR8bClXILZ7-zl-g5zddA&oe=6A4D0903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHH5P-bBAvkQ7kNvwF4RMXB&_nc_oc=AdovZoFfrhgB0QRW1pIHesdqsZfWllu2x55iKbbj2rvtfwD5Y57OI5ZY2CDazP2Nxrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDEM0-xFeG735iNFyPT5VTJDwJ-jm1ZBn3JgLrnPrWkA&oe=6A4CE7FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
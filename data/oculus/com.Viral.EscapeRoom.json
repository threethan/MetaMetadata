3zafOW7oqr_opgXw4LS_y6DkPaeHw1sQVJlPIHGDHxtNlmtnGlUkHLSp61A2YwXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zfO220rSanG8vxDmherGAWAe1C_YjTOIrqaRyP-NpHw&oe=69E0ECF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27wm4rYSM1kQ7kNvwH74U6z&_nc_oc=AdrzGG_4WbPALCvxD0ulr8PfK3eXtS7qoIPlN8akp3IBfhuYOz-CYiSeCxKY3-uMUG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01v1w8xQaK67nfHSfrtAo2YFa2c4ci2Hp0hEUBRzNWsA&oe=69E0F4F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dnrW_e0kboQ7kNvwGPMlG5&_nc_oc=AdoX9KvTtIuIV1jajBy61uPZzBYtKIStY75Rt2lU1lnMIS3f3_o0km_85aZ98BZZI_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2us1PVyzciceADvfDtWGXaJ0wAIAwgzQUnqXIW90hUDw&oe=69E0DF2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZJ8CySTjqYQ7kNvwHstQ2G&_nc_oc=AdpuHj-9bXXHpOl9JXlTyD57crVnH7LHq-Xuj_5R0sAIlZHCnYcEUK_b3W5ATnGAVTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3isKIIIMfuGhZ_PFjOxpY7B-1DmOAzeEWcuOaeMe-iAQ&oe=69E0EE03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mvw_pHlz4OIQ7kNvwGHHPRi&_nc_oc=AdpPw7iuPO8A2xFWNElW1S8VV32PLo8YenEmXfHCcuuB0aCSKAmQG1WF7l85So9v5M8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v5UNeIi8vA3UIKeR9OcYJRjrhxsaicKTKJJSjiL3VUA&oe=69E0CCFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
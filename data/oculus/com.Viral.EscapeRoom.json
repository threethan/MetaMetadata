qO3h9mTPJuR-AcxdN5NQ1LGkb1A1jQKFxudWJ9xao8RUcWFjrNgILRFWmb0DQGCk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hcNkCJ1a1xk9DMw4tScEt1_cVPy8PyIEFxoYie1a-1A&oe=6A1C4074"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWPBZ4KG-ukQ7kNvwH14kDT&_nc_oc=AdrfJJtSBObVjW1D-JPdQ363z1xsaZPedGFm_MuiMetOUMoZVGu8wd_t9mPn_jXMWdw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dbL-Ph8RhssOI4ZHKNEZuQlFqYHYqItVDGWcau3cjfQ&oe=6A1C4872"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugFQffTK7EwQ7kNvwHwXl9M&_nc_oc=AdpGZYmd4vkuPXi6UkZ-KYyZ7bg_KWrpVAdRNER0Uy09xuZGbRNSYQVYLRbdVAZq7jo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KIrJiDijfRA2borBXR2iv4izklK7lqr0MXWAHjDIUog&oe=6A1C32AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rqco-b26SW4Q7kNvwE8xING&_nc_oc=AdqIfK9ddlTcGJr2jAZleUbg62eygouQLFZsKZywK1IPXqrespYRF-RiHdgAYwTyfCU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67nquOOHN6UBSRKU1dtHilViW1b88zakgUyhD0ujZydw&oe=6A1C4183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egCqi-0by4EQ7kNvwEAU-Hq&_nc_oc=AdpJfJMBURUkM_oMxZy-jrEdutgchSGadbjlZOQpDSI3f2NAyA2Egpd43z_cg9sTnKE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fWMZE742GmkwgauzEjAJepGVhgutPNc8noTfwUUTkSw&oe=6A1C58BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
-MWsVpCPZwrA_BBk698CUoVlY_ibC9zYMw_1G4swCROIfJp1a8e8LcQyIPbOwjGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T2pP2ip0SaSOOYIeH9_TPf9k67z9X-hFMmoDxTbftIA&oe=6A0B1CF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9HYoc8H4FgQ7kNvwHNkr4O&_nc_oc=AdpXdtsBXtw359Zc40YlLlNu4SpK7QgjyjzhT5GU1TaCzYWbQnFG5c_n0Gy9WVWBwvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n4OgkFJoqGLyrBbtIzoNaFE3KIZXwyjEQ-UpHXo3eAg&oe=6A0B24F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG01AQVniEYQ7kNvwFU0Nks&_nc_oc=AdopJ1yXTi6pRJMem7ViPTR2yAUPwnq9zACX3vwMJiYtj8vcV5EKeiFzRehO-s0ltxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HBcIvigcLJ-ADSkqvGBE38N-tH4Ma0KOZ1QaBOm2XZg&oe=6A0B0F2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2ObuGIzG3IQ7kNvwHKrlJN&_nc_oc=AdqkkVgDIHbgnF3ebgTtNPbom0fjWd-toVe7zw8RlxD0hlInMSpXIFldKp1rjMq7a2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y_tDFiTXEoGX-ua7JNcF0DU-ietEDknRKZdAC_BmksQ&oe=6A0B1E03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37hOlioO_TgQ7kNvwHtR89y&_nc_oc=AdoMluFpvL8WHA2g2nMlCtvGACIlg3NLnBpSZLOJXY1VoMxDKL7HakeTKtwSk8TR5Ik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60UYoHUDhNmDQXEiLyoa_NB13OOgT6C0NSGE8fyUESuA&oe=6A0B353F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
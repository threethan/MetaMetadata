8tMUJghYrTeXwdDwns0V1I0NI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cJfA9fwqHz1I07TqIv-8qaVBFBY6Xe-i8H_z0Z8hlxA&oe=69F21074"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIzxtKjXpWMQ7kNvwFAX_X3&_nc_oc=AdotR0pda-jgcDRO2O1tPxKID75f7gpXJO_DKGiH8AtC3ZTckAhdvBNJHcwBbLPQyRo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3E-LukCwbGsReObz-kTqsCphn5SEYqnBoDJmW_g-H1jA&oe=69F21872"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrz3u-oF9jIQ7kNvwGKqb8D&_nc_oc=AdocSypo9HRkvwFvOK9RDVJVM3rZV9ynYZuzl1fw7IEjGwFbVgQaddccUfp9Esvyaps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3K5hqwyIEtsPGkn1ZZ9c8BYAGU_OCIhiJedrV0rb_ryQ&oe=69F202AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RY0IWK_MKk4Q7kNvwELtbyx&_nc_oc=AdrBO87JIri7TY_J-9Ady1zbzWg2Px_AoUhPOT_a8BAaXnl7N7_nov7_mbpkoMlWrm4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3RySN9w9LYitQpkzN5zMNSBtGXLauhtSLumtpCCRfGaA&oe=69F21183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE-g_7je5H4Q7kNvwGKbckw&_nc_oc=AdqfRKpW14SJvuAbTe1Vsa97yAAsT3AYsLzhngLPCYqhVods-D5XLcu2Qy4MI9EtRMw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3i0IIneSlZW5CdAhFLkhF-d3VbHV-Qa6rMO6zbK35CwQ&oe=69F1F07F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "interne
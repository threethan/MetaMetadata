lIAg65oTPVuJMOQQv4_09E7OwZsVcnJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzgkn15HMV_Ss5LVe3oMy_oek7sJXoLGImA7zM1CENP2Q&oe=69B2C874"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCK4JQQFzboQ7kNvwF1NJol&_nc_oc=Adno2khObAIwfmrkFBTWxTDjSWbTntfqj0nHPXCvkVbLL3Rbs6C469E4ULXWG3NppF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJS_D1iCfkxEbU39O-yqxoPkXFi7sXWkCYYx2KK2L_VA&oe=69B2D072"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcXkDokbn6EQ7kNvwG4bLyu&_nc_oc=AdnNQbM4Shtsna2T4VGqlhUk8s8GdBGv91w1p4FbY3an4OyRmQQKBgLWNfEvTpaP32c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzaOfogMWKQMC37KprA6cBEajKgpcHd3__vV0AuLVHeYA&oe=69B2BAAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN3nA4vpEJwQ7kNvwFaQfAR&_nc_oc=Adn4EJCe1PV3ZiXs0VFk1MAABEteWnVm3eGfBjqKwAGy6cPzttY8WTk06CeM_vNuIEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzdGM0hCovgK50af7GV7LRDpf94rOrdItOjRPJ3ovhnaw&oe=69B2C983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNRmXZfq5GcQ7kNvwEZ8FVn&_nc_oc=AdmW99tsrou7T0j7-zywUXbnIOQBVjV0AUyVJjuG-68Ai5viXkCBX65AiRpCflduSO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRqmrDu3YpKV-iuFGdaBsgplguDZZC-pzqg9hmEpuAXw&oe=69B2A87F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
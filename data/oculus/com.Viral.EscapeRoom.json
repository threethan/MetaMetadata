7hA5L4iAqksQtqIjo5jUfHh_OgYMAWQySKbOWfQDyXrGyKlkDoTVx8owgg-Lkfy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB9_hrNHtNr-M5KYaxA237t7XtmBWDe-ybebjvQTiLsA&oe=6AD22F74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1zi6HMoeJEQ7kNvwHa7KVR&_nc_oc=AdrZg-WKch_IqU7m6V_pialzGA8E5HwaswNjcFLDtpOtVjR1_7sYL8vNEJ2Ji2SOQWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWyU126NL3-dAIDaT2UsT5ufrVzo7UA8Ubes8Et3v2eQ&oe=6AD23772"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arR1DAuapTkQ7kNvwFbFF7W&_nc_oc=Ado7WeOKBAhO-ZXSxg5MVgh7u7s8Wg6s93Hborju-93qy7QD3q9t7BJlsQNiV5rZ_qw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfWJTBS9SAicaQplcAGf88AL7N4GB321P5uJgflgfB9w&oe=6AD259ED"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxxBq_Wiwc0Q7kNvwFSkPkA&_nc_oc=Adp9BQds3Kh604wjpcJWaj8Kcs-_t5Fa8OHJVLkyD7uslyY9doqOzDGzQ-V7-4BkVKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7lgmqV92parOSxVxTeukWN1VAjFyQnn5Sa4Qzm8yfCA&oe=6AD23083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExCLM3yLqLIQ7kNvwEIreK7&_nc_oc=Adokny6Km8lnJljaKkrIX4jd60-ia8lXEuFX7PYiNVxQ77AzyfMDdm9EtMfgZoPX2h8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqk0Qo3jdubMaPOxzAkx3paiBTMH03wEg33bqPkrLZuw&oe=6AD247BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
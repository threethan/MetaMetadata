YIxbUsN4LOVk4BqK8hgG8nbT2Kz8o5bo_o_f1zymozIDhL97QY9wzT-RXvG4ZqEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVVIEb2X6_SHMz9pIlkfSAfUAUakEsM3F89Uk2X3fvtA&oe=6A6B5A74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLvzqBd0EE4Q7kNvwG7EdIe&_nc_oc=AdpF3ny6kyG3t-cS0pT6O2j0T414Y1edHinfoR1BMuPH5QLToDH65nRdY7xnap7PHbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl4iZP6ie1yGYMPy3LZb3EzfnF8jC6xaXGm-VPK4OkpQ&oe=6A6B6272"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rotP7i1Ox-sQ7kNvwGv4FMN&_nc_oc=AdpBA6sAd2KtgUP73jF5e32lXL-LJ63SOaYazJNCJMGLuwt8m1BfrVH87UZg3AtgMhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlJMS-JiwYQnd_X4ZjJq2j_OPnJ0uCaeN4C44fvr1LTw&oe=6A6B4CAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRHdHkzBPRYQ7kNvwGtXVrT&_nc_oc=Adq2YzLETJEbGe3b4OHdgVs6f9Xn9WfFRfRAKgZkT4vw3RT9wEG9ncKbb3BffGbbKHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC6vcCwGMQGXdVwedueyXfdMewke2EYychU0IPSPIKew&oe=6A6B5B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUEY4IdvbvkQ7kNvwFwISRu&_nc_oc=Adp_XhpoYoUrA60arrhx3vgwiqXSoKXrGwwFx2iYMi2oLjHbgRbSxsAE-b9PVkjwzNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAysKjYVYbXPzdBt3vsfT2kgGZtxmXZJar-2IbN6_8hcw&oe=6A6B3A7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
5D6r_DtsGVRFLuKRHu9KruCHLYza_jEjNdHGPfeTW-0ar8e8kerAHANIhYpVUySg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RuIgw14aln8P4W9z1qf_AbYNJ-ZFrVX-VuWPu4A-SBw&oe=6A412A74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtoX7iZhw2QQ7kNvwEd39BY&_nc_oc=Adr9GjmIg8fdvBk-5QgkwiS5ENvtRFmcSblCqRMEEOTbFDNTIgwO46r3dBY0yAjh67w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xKmnE01SpcbEArBVX80V_8xZ61SsWj3_i1uAd725oLQ&oe=6A413272"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-heCZAgpmcQ7kNvwE5si2J&_nc_oc=AdrlJq56M0p0qpl9zxo7wbfkQCG3oAby9bTjM8HqObfQ0-nUvcsFzJAZtMVqqaxeS4I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SVN7RNS1b8WFsht7XMHCCMSpB7iZnlkT5Q86G85JL_w&oe=6A411CAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wb-Y2hCY1qcQ7kNvwGZRPSA&_nc_oc=Adqapr3Xkozk8-_5sCQBLJ56PyjXDUBbAsheBMwZ4vhZO5cDIsDSn2hGGdaqkTi3lMI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nVEGsJ_Lq2S5c5r0Iym2prQTomJ9LhKW_WTWQwHAuhg&oe=6A412B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kU4-P6lkwQQ7kNvwFCXlD_&_nc_oc=AdrOQj3MuZKyWTNzBXfSqvKJa2o-dY3-HP_LRo4DIeP9XoKOeEYdQJjdoje4PsnWsFM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_55rezB6K_GSyaJI6Rn1r47X81CZw4SHS1BHzZDqgdtg&oe=6A4142BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
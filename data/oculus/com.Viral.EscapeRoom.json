Elk0LQPdktiD0fcqaSd1cklRNlxbSN_rNWEsHPwEyf1L9odSW1KZnS0XIBRDQrfI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7JqSaiY7ATtEiBvYqoXSlF0Qus7mFe8UxQ1qn76Etpg&oe=6A58E574"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUA-ogoAieoQ7kNvwHJeeD3&_nc_oc=AdpNi6pqIrJrnx5pCGa5yVDDil0Z2wqjSdfLIZADtyEAARm6ORrnW_ZhsMYx_0l7Oa4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeeGdO9SVxeJ9KKrd0ICvJ0514h45lq9FsAEmHmXp25Q&oe=6A58ED72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l76EAJjBD60Q7kNvwHq7Vwp&_nc_oc=Adp-35evT1MxPKhI5-FXROWfIP7O91nRVreb67g-n4WvrlocoXAQHDIBM1ejfCsLkVs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvszgjG6GCd5zV8Feekp4uRBd189dcTOElLwe33DA5vQ&oe=6A58D7AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrhWHgQKK_wQ7kNvwHfX-YR&_nc_oc=AdruxzSZpu99lNoRsf98GK0SeK6F-_p4u5X7_zS_-XkkkkhQ-H8V3GV_QKxhTYdqbBo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwf2KL1K-cIwbX1xZesKW343RppC3cfz92in-1PyJqSw&oe=6A58E683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFT9WA90ZFsQ7kNvwE2uFKv&_nc_oc=AdozJ825F4_c0zmcVBhTG_w2Fx8tXdJO6WbD-W7slgObm_0CPzhFUCm4zrVpnV26S6c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4V8j1nuIsXWATC9IWIPgNSGHp5dYF-1yHx4Rg-7iozQ&oe=6A58C57F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
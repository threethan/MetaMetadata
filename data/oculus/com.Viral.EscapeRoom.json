QH9wjL2LzX4LYkvayfkkBDXOkMTCP4_MEjxDatvuGv0AmrTb6M0z70pmYnXoQCJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H8gBFsTe_yy78Z-OQp71KuR6kKbvwEAFhHahiH5yFMA&oe=6A1EE374"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWPBZ4KG-ukQ7kNvwG19GAt&_nc_oc=Ado_rU8_TU1nO0HxCnhcv3LBMiWTPT8pBvuaUMlDO0eJuvD31TDMQJlTowGPuiYak88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ebm0c9TmluiWeZeA6SQPLaUA7waMGQG3d6bv27xtxUg&oe=6A1EEB72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6iXv7aUPC4Q7kNvwHIQmbd&_nc_oc=Ado3GEZVtZ6VSajRlvxYhkvlTQm_LGwL65i4KB76wmKcXylPrtkKW6dBUufogaJxQWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xD646Dlecg-wfUsCZfyLaMykDLBII0EEGqDBlfb4kWw&oe=6A1ED5AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rqco-b26SW4Q7kNvwEdl9Uw&_nc_oc=AdoMf3f_XmvZDdqMObPWzt75kkBoAvH64kFpvShYgp2p2p2OBNgt1Vhio8Xj2XWV-3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T_TDSIwrlHHL1kv9FR_ovXiSEJ-xkl3tj2JPjkB5Q-g&oe=6A1EE483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckKIUoGLbvEQ7kNvwGsajIK&_nc_oc=Adomm5SjGcbgw1Kpd2zLHu_h75xs05AdK6c8i9tWrCfPpFp0iR8YESCMcs6SC1-aMzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E0stFMI94UE_cAAih7BdlqZPNre94j8q3iaoAaeckXA&oe=6A1EFBBF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
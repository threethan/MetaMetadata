4iKh5I0LhhlR8lFIFgydw2HPgg_y0luQSQnnlV8Glkjn039f71GmCjtm587ZXBdI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af571MsAdTHEvPVaP6FstNUece5mfBsN6527G1fZ-3DqzQ&oe=6A1AEEF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sARFg1C1vj4Q7kNvwEAw7E-&_nc_oc=AdojZ8f1B2cVt4DF6SDtrJbcQrkfe12Q26pz6i3LkSS9YIUBQPXmNmCrRPa3Edlz1AA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NEXEt-LOxlOBsp1vJDaCctNnna9AH_Zw8ds1cJrx-gg&oe=6A1AF6F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugFQffTK7EwQ7kNvwGE4Svx&_nc_oc=Adqg7A6wOAzVBiIU8zBKsc3QvTCon42oNRLGoTcIIHOM90TMYCNmWXF_5uHKZ2DL2QI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af514t3uYWczZZVGWtgOE-ya_f8gGUqWkOCC36ta5ha0Sw&oe=6A1AE12D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKa2g8zbSEUQ7kNvwGgC4ll&_nc_oc=Adpvfm0cn0SwP2NCDHngQj9XEQdxH2Zb5cgiT6uXV9FCxltMEJQVlRpwYI33fdoJjpM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uzxyIV4zbHejrvclcxhGlvxcxOtP1-ZlmQZ3A5rP9rA&oe=6A1AF003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egCqi-0by4EQ7kNvwEyHxRQ&_nc_oc=AdonlRwo1YLFtuuSJzuzfV1jkA-OqN6YJlgTRKOvO5g3SGMLYjb-66L2RABNIzA48QY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P-fL0a1kHwPemvKumlixwqbE2YNfguaI7pzzQHCS9Ew&oe=6A1B073F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
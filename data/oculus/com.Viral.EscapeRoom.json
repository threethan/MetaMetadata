lOhYPW6_vkWNONwUjoBNGLOZv7fiJ8OKDjZomsZ3XTdhir81YGShSfmurZEKhqXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NBKYLz03uVUXcGsOZ4OQjdJqzhfh5-s9Wq9V7ZvgJFA&oe=6A0879F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9HYoc8H4FgQ7kNvwGLEhLK&_nc_oc=Adof_pbIdUqusz5nrAnBQmNvCuuG8rs_xNG1scOKY_036xNmwKHMblkIBcMTge2nSjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A14rQUoOd3VHTVs6p5CTLR2AgbebWfJYGk-J-MgrWZw&oe=6A0881F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxlQ7oXiG_EQ7kNvwFaHHiW&_nc_oc=Adqd_kzyIpzFntgXvSHh_KkSTo-w0lht13bZDuNINT9VwzK-REmL2Dt7UgMcx7-97aI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KnZ0SKK0btht7H0BXrzqL7U-VbYMDM6f_E391nGdy_A&oe=6A086C2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2ObuGIzG3IQ7kNvwFbiJXg&_nc_oc=AdozDzDIyeLIuwYz6tV5fvHHL1ijyY1TPcCss3w-dpzj8cQLlxR9GN0LJSrCc9z29Zk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dGmcRlSMI59jZp3hj3x9DzIJkTME_PiWTn33MIkO8Mg&oe=6A087B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNkDLN30KEcQ7kNvwHs-XOt&_nc_oc=AdpQgEtT0FJSi0bzYb42hpjtSO-lJ2BLDKmV9KEMIrwo9lcPBofgQEsagly3qutRl8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S6DJyulC3QqyuffhCQgRaBmn3PfJFbI2BhBkJA6JEww&oe=6A08923F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
oc=AdoxGpi-i1aWWGQL0P6eONfXDjKmFxr1YWJYANMIb5h455Uqu75Mpve3cJyimZ1sVVk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWPTmvJBXMWhbX_8Hez0zaJmdWa9domVxF_LUEx0Ycaw&oe=6AA40AF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oVId-73CfIQ7kNvwGJllky&_nc_oc=AdoLlA6BqoQoMNxGzEsx86OQE5if2Jlw0MaGL_6-iVBvTmb46w3iYTfa4NVugA0H1TA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6o-xobO8ri5M9jTuS2WV_GXZTjCnu6M5a79kGHKh4qg&oe=6AA412F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8n6U0yPKxUQ7kNvwEXoxfQ&_nc_oc=AdpauGwS6ERi2wZbGZD5zQ3YbR7iUmIVDCLP8LImGRJiBBOFfV4hyltseb8PAcWBQq8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoifxdBn4uzRQQQXZEPyOXZhIgqwI52LHZeb3877pYcg&oe=6AA3FD2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLnk2kHxBBAQ7kNvwFY8rqX&_nc_oc=Adpk7yxmGUxKRf918C0gEUK85va4TRK-kMx6f6ITRy_kTt_P420N2s97odbVq_kLJjw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN7BaJo3pduOCw-eIN2PUXAxFjC-YMfoZSduzOEXMX7A&oe=6AA40C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etJLWTdbOfAQ7kNvwGGTVUv&_nc_oc=AdoeqR7hIIDKL45xJEq0_PdRZhOfebZdTDbJg1X5vjgIP7HwQOeUmgCdiEXBP-oI9Fo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsq-sgXIE4BjQr53TybkxORDwm23HW7pY_4Al-IVQ-hw&oe=6AA4233F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscript
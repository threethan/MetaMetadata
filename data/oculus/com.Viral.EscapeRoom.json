0Yg8He5JQuW7SC-87E01PSnA0uvHBVZww9J_BN2aT9Prm8tR8is4ZXjmOii8364k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv7ksCRUhl3O_GgoBCA378GF03UqR1zZSkOLsRejErRg&oe=6A95C2B4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C1nswokcTYQ7kNvwFcwttF&_nc_oc=AdpcOg4mG3XyWEjKMXKHowTGQ6-mfe6Aumkq4MKJmaoKmQAbB66wqxLU-VzZl5ltTfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOVfOT1ZalKOoGXtOirnOPPNTenyl6zI5QklGzyKCSAw&oe=6A95CAB2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCLORm3K8CAQ7kNvwGWoxzc&_nc_oc=AdqWxMC7mnZwNWEkTTynamZ190wpOwK2iDgWab75N89WUGJ45sUE8F_Aiw5FmCNehS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPTKY21HcIFJtJLGwqMWZRXSTKW-K_6ToU2ip3M6FzAw&oe=6A95B4ED"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phZais_YTCoQ7kNvwHTLyWQ&_nc_oc=AdrDOzFnfzSGZZ6LBhe48lsxIZVMbSKtoWifVnWrHhxUwEDzBjSWe47P_-o2XlwxhdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw3XcTuqn7yhs4nW_fVk4U62KKPZVR_69xLuV148E3gw&oe=6A95C3C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il3FoEDivjQQ7kNvwH3yjj7&_nc_oc=AdqHTRlHuqwZpeXkNQ3ebduaw3n8AFUUIPmd8SbYf0292WPu0kpfW7KIuYFJWicxpjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5k88FqYM2oL_v-X4cp5T8XDZnwqZiJWTQ2-75ud1QhQ&oe=6A95DAFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
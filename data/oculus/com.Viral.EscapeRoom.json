zaiL1dT04IpRhuOFqEKNH4Jy5VPUcDtWoCAARzcoZVmGbMWCnp0gTcmQfvQa0EQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0p7MnhZvn2Nrzx57WfRFyn9xIpVwCsZQlfRVVh7OKuA&oe=6AAAA274"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PhFpAuGKvUQ7kNvwHgpF24&_nc_oc=AdriVdFJmGhGcw_6oquZCz7UGgcnRzhsjnNoiiXFwN_bh7R6tfKerwWqNIyNhZvcedE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxRs20l6bSGgEOYbkEWIxBR75PcVTKRFj1lGtnV_BGuQ&oe=6AAAAA72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ5nRuO2Z6UQ7kNvwHA7Tje&_nc_oc=Adr8LpUZC-Hyzc-IGW9_zPcckIDgWxPoQcUWDnWX2DFLVbNJeDx7GxD9tAJclQuneMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZBfLyQD9LVHUdaOipMBtnmO0b3ItUoliVWyqoIe7gog&oe=6AAA94AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzCDYIC3IpQQ7kNvwFdgAO2&_nc_oc=AdpC6t7t-4n_Y2VUuEW4FkO26VuITkliCRGxz0aXQuP0zBZbc3DzzBRjIJ01iKpHxm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw-2Y8tFOi6tlsMYyemoJ8Dn3oXz1iqBFt1AP2bPLnKQ&oe=6AAAA383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf1pAJIhgZ0Q7kNvwECQqDx&_nc_oc=Adpfv-cAKTPUcrGQfwe-ge668OOoZd0H34gcEnfCzvT2kaRhp1LKUIs5-MCBRakIMNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXyPf7Lf5AK7pG7M3exfsY0RzFdSSnyuFVn9rHVyi4sA&oe=6AAABABF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
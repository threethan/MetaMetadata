oc=AdrsFRDTz-ErCBsMne2uEiPGAuS17UAWpZvg6ZgbVtI6NqhNAPafkTH-7Wp0BMXMiGQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN_nhFcLDUm2nlyxVMWj9rTm5zO14ZxhJYtyEWlE9waA&oe=6A7DCF74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo6IsoqmjoAQ7kNvwG8irDa&_nc_oc=AdogkV1r3JZYbW0TYUoXQ1XI66EuUsPW8Vu-Q6FX1eoIIOnFGgbxGJxoETnGfWK1h2k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhbV1sNDXgaLRVeDCruECtBwshikrTpcIqVZpaVxJ9NQ&oe=6A7D9F32"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHsfV-l0BKAQ7kNvwEvIej-&_nc_oc=Adokmsny0-Eb-TBuubl72WcuXFlpOFvC5vuh_nbFJ-do2FW9shCfKhSuSnZMO4rRBJw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu8OlSqc1EqUCd_uVoVB5fnM4cDdG1toc68o4PT_RPYA&oe=6A7DC1AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtivAmbBAy0Q7kNvwEAVnBW&_nc_oc=Adp4zh5D-Ly3IDHvGHid1aooLqf7caNzdMgDqeDOUkOR6nlDfAyonHV24ylRhpRavJQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb2a7BjPJanA6yHe0hTj-s1DSOhCowWyHZCzlbTNxw5g&oe=6A7D9843"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZH6hpjoQHgQ7kNvwE1TR5M&_nc_oc=AdrqPmeeyag4y3LJP1oFvGXfcAQj6fzblKsSKOtYagBoBdpIQvr6htafOJCAQTtDMZ4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLkkLpXYvxKQ5_exH2W1WuHufzGvLzfpINTZrrdz_6tA&oe=6A7DAF7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscript
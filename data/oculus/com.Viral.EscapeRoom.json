c2WCxp05_06hsH4FGs_2sAi2i2OAwqsw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfykRcCSMskRxf86BIFM2j8g-YXUFDhE_z1j1KJrqqYJhw&oe=69B6BCF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTYWALxSSXwQ7kNvwHfBtG0&_nc_oc=AdkqKbCjz5b9YQSkt4-dxoBW2O5tZsNr1W1-STfCoFFuXbs5fQtbz0y__R4aBr6_wMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGEUQdKoIj-OysWy0vri4bEyg4g39630UwNFFu70jVVg&oe=69B68CB2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dpiHK-DFP0Q7kNvwFQxScu&_nc_oc=Adk46ISy04_-zToDHIDORBn88FVdLRD4t-h9ds6ptGMVvJHNsIX6RNb_l0IoaQUd7KA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzg_ZyzcFk_cTVEfJazMGYCLCT4L8_pLUj5xh6gmd8YZA&oe=69B6AF2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o6IzzmsWBAQ7kNvwHduncp&_nc_oc=AdlJzFt2xYgEuhhGYrQ4ZNjUXHvgxegMcymN4qucY1Y7xM401-CPHBPdkvmmb0B5WEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRw9Gt5FSGO4wlb2NiK39-u1rShU9RPXujkWiuiuZedQ&oe=69B6BE03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSyXaiSmppcQ7kNvwF2tPbl&_nc_oc=AdkmUfHW6ibTSKP9jMQLfFqma74sQ7WmnmhFVFl3SsScxgskbwEsjxTaOYsHF45O6Tc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZEMlOMa04QnCeJ82-B7Af_bps9_C3vfhb3tAruIvzDA&oe=69B69CFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
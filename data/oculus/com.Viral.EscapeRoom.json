dn.com&oh=00_Afuy_jqQLBDrJNY6l6wzmAlYmJqUVgeMzviPEU-dRDV1Bg&oe=69A2F674"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ddk6KXTebJsQ7kNvwEFMSxE&_nc_oc=AdmY4AZmc-HPgRgEQZDmYsTqrSardYTI4UecACT8ZYtC2ZpHzOkf7dKjs-SqtuZ4pQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvOTc6g925HJyGXRAjG3lJrkXQGmNs8zyQA1-_rrJglOQ&oe=69A2FE72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe3U9e7zKhsQ7kNvwGyy0hh&_nc_oc=AdlXs8XWrNu09QJQfz_Ph8BZeYmqXV7ouAe4xbQ6IdoxNSxnGa07mLsYsXoI5_80IF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftIeBPaLLIpaocG2CL_BQ5wDDf8XWP19H0J9JVHnPBd_A&oe=69A2E8AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTKX3ScHBC8Q7kNvwGyc3nv&_nc_oc=AdlOhZ0e1y6DfASDKbSkHUVhW9nY-DWF0PAirLIaoMw4cwebQlXNbl-AIErPh8lDF_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaRaDSZTnj_obY4EM3RGtnfu10Xhzuh0x9248KT56n6w&oe=69A2F783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iNbjS0CIpIQ7kNvwF7VGTp&_nc_oc=AdnSmMwW8-DU5YIK_pq1rLA1xynkoqUsyYvisS8b3evt_WViMKvEWNOK-ti-qF5BZiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvoGjet7fES4eVx20ZiB_puaoy1rrfzqFnNnRtowBzW1A&oe=69A2D67F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommende
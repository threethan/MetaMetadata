k6_1e01E_rUkGzPV89UWhYjAFFnABOdeDmtj1B1knF2CQqzQKRL8fFKsGodoOx8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N-MxzpiI5eLlQss46nLz8uZTKQxbS4R22RqH7Aa-xuQ&oe=69DF9B74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8yzPd2BWP8Q7kNvwFS6CjI&_nc_oc=AdrYYKFKkkgkZdbwYkku9IqHE61597K6pbIVdJ25Ka5HuuOYau-DNW2V6_QOb2yiwF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2skSXQxQl8_nVDJ4KqCgdbKkXTmEZQubnhuwdT-IOGzA&oe=69DFA372"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dnrW_e0kboQ7kNvwGdBifq&_nc_oc=AdogUT30FncIwAEVmHVgsq2dnVRlKO-RSnvLd44ikYDqq7VvoQMYnWHuzXIMGoqLbJs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SU0QUUT89erbfdZdvLKn-adFo7aWA-ox9Z5HR5lAmoA&oe=69DF8DAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRJpf-f-a0cQ7kNvwEfljsM&_nc_oc=Adr1DzwQkojeBwq4fYYCiMiKPUzVJYTVE3Of2DvYOuPLsC2DLDwvpZx7m835PyIwo2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3muw68uuQbcOr056l3g0PmQhtUgzJGtwi3C0UNaEa-Uw&oe=69DF9C83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mvw_pHlz4OIQ7kNvwG5niSq&_nc_oc=Adq5FV4LNQGkJbnhWC11p8mP1rJhPWu0ZvQgSrUh5-MLWxpxTJ1iBE0CQ4OKK3MzNYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03rqxMymaiYHGgtVS4uupnx98XhSGHVzxhxL5bgbsi_g&oe=69DF7B7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
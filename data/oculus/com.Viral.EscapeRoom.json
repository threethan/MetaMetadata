NK8iZsA2rh_m_5XTWKaVekHjsdpAfeFlLU-maYn7xsdICpOADdpNsinm74JBcDlg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tEdJsjS8kQuL2L7nZexD3VsDwOPisLJNhFZyjuJs3Rw&oe=6A218674"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhXIZwwlzUUQ7kNvwGC3c9V&_nc_oc=Adpct3DhQtAfTG6Bm08Fe409mMiWDjv0EVM0zg1hiQbfGGWRw6vujA4VEpKRYq3p268&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c0aQlAAqntHBQsazUokDTSut7JK8QLDla4A6w2i0gcA&oe=6A218E72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6iXv7aUPC4Q7kNvwFj8bXU&_nc_oc=Adr_Dbu5AlSVSNNqHQVppxNdPtqQtfODxwFNG-31_HtoZ8njD1L1imyp6mNh81Ib2Uo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90eemAjxPD4RqNNxHN8XHGOgooDs5xCpvq31qUC6gU8g&oe=6A2178AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8yTcr04cMEQ7kNvwEzQvVG&_nc_oc=Adr-ex60ZhFybjnQTV4-n9e9HD7lnCz-hR4MwkiMrVOH6wxo4ssulm3VN9EbsJASJdE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FcIxUAX_8xwmXIDR8qYUEYfZXmaUBeW1wrd4dsfgD0Q&oe=6A218783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckKIUoGLbvEQ7kNvwHkVLUo&_nc_oc=Adobu5Nr5OyATrruFGVYo_TvSXxVoQwJAuIkmcOGQ6de-qU0w-qhwmBgwZ_fU9lczLo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hkU2BSqSOaC3l7ymcVU4zNOK7OK--Owlq29EnrkRddg&oe=6A219EBF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
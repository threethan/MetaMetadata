mDv17ESpFLxUsYSUZQwLAg3nKhRsId6r6WSCkQsVnwmIQa3vNUCNPCKurH_SAPKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi-Th2JaXOzAfVJszEJBBLjJ3H3LG9c_2B-6Sy0dGx3A&oe=6A79DAF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYDH5nzlj1oQ7kNvwHoGRtH&_nc_oc=Ado2yFRKniqcqPzV4umSqxzRol311Uqc78_mWSf_VSYvTwVdM8BTktQqkTxk-lI7dj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9Av7xIEwBsw6UR2LSgufzl4D3I4FfO7b9Gvc7sCIAIg&oe=6A79E2F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KF5Z-HxlL0Q7kNvwE-q-ne&_nc_oc=Adpune6_PCBZhs8SujQdPq_nJOQ3zGE6uiqHKQZiYh76ye3aOVDY1pcxvliZHsmMl4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKXGTSBfVP7mDqhzP4lV94n6t0EGF8h1KPY6dXhUDXIg&oe=6A79CD2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmrk0lq5ROsQ7kNvwEiqZ9O&_nc_oc=AdrXrad1SAlgr00pU8sPUPmiGGdy_HURnX00KpA2guFOUbxBdKmNqR7NSNl3LEfzxLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3G1pUkrIgUwpQyYC94qQdI-CVS_FVPEiFJU89AyPVhA&oe=6A79DC03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8zt7DJprBQQ7kNvwFCKz48&_nc_oc=AdrI9EuSLBarRWAqo0BM8WATRp3MTZh9KfQB5rFkPWXGK9Xd5NJS7uXLQz34lf49JP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU77IODq-d-5A1JfMKchBwg2G5n-o47r71EIwNfYw38g&oe=6A79BAFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
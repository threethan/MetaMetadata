gjciR5xldncdTAtrec7pQKqIcnimN2y0rq2M_9HusfpZmvoP42Sl5_8YvTYdGfh8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfd26c3GVYMQUmfW8bDg-1StDBfSP0xPqXnplbAosmuA&oe=6A807274"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRAJWqcja3wQ7kNvwFlxTUy&_nc_oc=AdpzP8gnEkeWJse2Ai5Z1cZ8eWFxEC686V8bkWOzmPMXW_z9cZuTJY4_nJYXCeXoDVU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIZyRQ1CjbVX_-dtuRQrEHw4z1llxkBdcWu5tbIhYHUg&oe=6A804232"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHsfV-l0BKAQ7kNvwFSABNc&_nc_oc=AdrLWOzJtzDfcJn9V7jA2wtaWOYKYdIS3ZXfdnrK5t0ErIcpSV41SqZ3GtRmLRQ-qrM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGujMmPhW13uGPd28kzcYZkpXpvWAGqGCGb7pPW7lpnzA&oe=6A8064AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3VMcEtlOtwQ7kNvwE0E0Aj&_nc_oc=AdqD0Qy0HK3-RlWMToWD-Ykx2eamSHp1bK2PUKoQGRrov1W1nmoNCv6kP3E_mZhdKIQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDAIYUMAlHWnMsI9qNIpMr4UC2RidIEAikc54BEVhlSw&oe=6A803B43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZH6hpjoQHgQ7kNvwGkhmlf&_nc_oc=AdpnAQVHVp3b4kqkx0kzzbQrwkpc70G6GvmxHcFpHgaYshLjR-D0bCF36-kSNbToPrI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYoBFfJo7Qk7LX_xn3i9ZNtKTfJKbXdc7LjMvLI64gPw&oe=6A80527F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
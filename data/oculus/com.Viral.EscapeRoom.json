iFqsUPFAtGMtBA7EHotuADPteo5QSg9nkMRJ6ZFIv42dPsc4sgLR1kXSW0ymA3N4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwLTE3LdUk__yCxkAlyPs6UmP6lTsp73GTb70B3M8agg&oe=6AD0DDF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gLAMb-4AhgQ7kNvwHrqBoe&_nc_oc=AdrLV27KGivj_5vEwn2VRRVutjB1p8o3bVud-oqahhYFIBIYKSF4yHqcIcxJVHpxR-4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK4ZaDGjdd7EDLMS2OT2BKtUMftNrn4jH_twaZdu8oEQ&oe=6AD0E5F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arR1DAuapTkQ7kNvwGBlRxm&_nc_oc=AdrYtffmWCsfYaOM8FY2dwogoL-xv7azQD8wDa47oNd5FO4_2-M4BdUgt0R7DPSd6b4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZWf9EP7SM0XStNhl5CX6ZxoETGxCQLNajJhUn0957TQ&oe=6AD0D02D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSINYn_MHu0Q7kNvwFHEEGN&_nc_oc=AdpGLsQ7usDhdfMVqyxndhu_KbZtaQGDWPn9Rr7xHObq4Ze8XsFHlg8kz7Kd3rfOVW4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKOCFlVuXjjl_w9zHxZ_gzKdpsU5GPCCqOP5DjSwmT-A&oe=6AD0DF03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExCLM3yLqLIQ7kNvwGkY0sO&_nc_oc=AdreG5Fjm5d8j2X0X7PNYQS5_sERqyxCdPb9LCgUiwwlDpcTdtMnZiJ1ko9vw8RS9ho&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYPLHfENO2LXQO1quUniCSWTOhu8VVIiU-7q75w8PZoQ&oe=6AD0F63F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
k6YzqvYfjIe4cu0LJg1ldsMva8LD4rxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsNXwvyIXpVl33bAEle4TDWuCcIiwupwh_svMlKKhexw&oe=69AD8274"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_oQxlptms4Q7kNvwGMxbRB&_nc_oc=AdmZXzzkmfbHuYRRt4vYlgTS5o9LRT6X4rTADSyLImA535pK9kAp7zzrisilkTysGoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6fH4JnQcnJxIRz4vlFX4F2TAD2YQEfAw3gspwZb7qmA&oe=69AD5232"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDBMORK4H78Q7kNvwF6h5ns&_nc_oc=Adlkc-G_0DO_EqAljiw7elDsVqZ5x8PlE_SMZVqMbvH9wEFlUHYKhvzPIKGoTuaCUHs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfypYp6x0E7BkUZPn8-42YFn-9J9zYearFrsECCt3LdtDA&oe=69AD74AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2iEfH3FvgYQ7kNvwHvStIM&_nc_oc=AdmSxPr02J4wpdLckKgMkRd0liMvwP066ZsgKT6SVU-JmpbnLJak3ngk5ArmXgbUVCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEWApzOjeoSwFMtPNCnyT5TKhG7eOJUN58tqDQZRLZwA&oe=69AD8383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCSKSCoYpvQQ7kNvwFdDyDU&_nc_oc=AdloN9_VQztjAQWl1Q9Uatj4gQ3VYH25BvBdgVK_aEcEVRoL-qtlejPZL9tXxuiQzRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwd-WGXnQE0CSKVbkuDP1V-fiHo85M2ZpmznUKoThqDDQ&oe=69AD627F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
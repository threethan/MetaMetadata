5F5uYVcTeqUzxzCxxBwtT7hm79_hAUttjTkT8EsW0vWL4iWoaqy-yukYWSX4aWFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlnJCST30x_Nxe03TyiVFECbnSv-3pzLRhawH2t2EaFA&oe=6AF8A334"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYt0pwduLA8Q7kNvwFUFt2l&_nc_oc=Adovid20buzsMT_uXynaZThhsMLLbW6utiTb1A6lGZqd6idYFZ3dLPYsKtBE92B399k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2A13L4cWahhRceZFihZG-4VGLN6nV23Ws_vJlzfXZgA&oe=6AF8AB32"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLzwjzG0flEQ7kNvwGaFwG_&_nc_oc=AdpZKdzWWw4XUm4lSx2yciY3F8Aa2NntQIASy8oGjdivGcWx3UJPmJ6klMN06wcHx4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSntQeFkexx4UfY3wO5DhC0z2q-d3tBXZMicl0VFcYeoA&oe=6AF8956D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91gxhjNKStwQ7kNvwF65hsD&_nc_oc=AdqHe6L1U1q2CeMGVaGPJV-_CLjpPn1de8CTBd8KlXPC4E4ISNLFo6NILxPiXBI7OrE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVAeRMGz98NFarREHjgiJOVYmOmqjN_q2zXOwHszY2AA&oe=6AF8A443"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0qNRTzwwzQQ7kNvwG5jpTb&_nc_oc=AdoGUCtj9xa1lcR0ORDBol0S4LYjmSQv44iSMc-y_0enQRQt0fgdtBrzKLyBWBWAn6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNh9TWsTaKxO6jkZPXMFMH62aEW4kJ8rNSTLolbn7LiA&oe=6AF8833F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
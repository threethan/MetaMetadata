KpzoKRmv9ZSGhr9RNq98_Wt3NKhGGZDYQ4yg-NkK6ChYTGUQUHOZsFUPuDNg9-FI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzOyjRfICa4BM99mfeVnRz57WbJWyUwGsOX23Q7o7_Cg&oe=6A5F7CF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnGagZkIJTsQ7kNvwHnAV6V&_nc_oc=AdonvuHirRpw2uz1KRwbkJ5uGTCLG1lUqx4RSP4VP7Uhy3MSBkp4sKJg1sSrDumBmvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk-gsn-aOMMCZIyjQu37WqZgcM6OJZoiW7EvsvFfOQoQ&oe=6A5F84F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG5FgL5wu4oQ7kNvwHc-a9f&_nc_oc=AdpvJiIeUUeb8t_wyjqfNh3DPbEhcYQjVwkjDnCARJMvKLWJEz6hBl216VSCfvlQyMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-l1ry-5PfUape85ndgjtTUeGcsaBSBFvv2t4bmzLQTQ&oe=6A5F6F2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qMOPnuuZ7sQ7kNvwHbP1kb&_nc_oc=Adrm9CTwZlEr0fjidiFRuGzPftBiZJHOArRWPslPjALe1NwnFVuEpU-6CH6oP_7bkfE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTEXe3SlZNTv1OL4ubmiR5WZ-7TFl0C9cz3Xn6MRjnog&oe=6A5F7E03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xV-dPug-tewQ7kNvwGuy0wl&_nc_oc=AdpfgTDpZb3as0NyvgG242Se0LagYOswgsE5x1uWdI42jUoe049DVhxuT4H7ZCniFDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSMNowaSpORgklnShprCE3qeF7est8cSPhSZgOXBCEMw&oe=6A5F5CFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
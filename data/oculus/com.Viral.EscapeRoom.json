3DJ74xhUVP77U4Htvj8qbY1f6efJLeD_0JsREMecM94E48FFeorN8qECslwoWx6k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr4TpnZ8Zfd-aV0-skedk0LWyWW8_LUTys6OAMBQIm_A&oe=69C53D74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGi_o5me9q0Q7kNvwExAoTq&_nc_oc=AdqAVdy2Zy6a1YO8RMW1rjfUAoJi_QK-CtYrz2InLuPjYwD6U50FBoSFxKM7n_O6W7Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBF_2rYGGMOJCrj6uXYg1jySvvBNl5DcyWUDBpHsPt9g&oe=69C54572"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycJ3s0blHVEQ7kNvwEdo0mW&_nc_oc=Adr0Lj6I7GuZyghlh2yD1Qd_q1P6Q9xPJAjLsYvb8pEuKCbvSnbTECNMgaMRg5VBxH4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVzzQ2TZSYnml4TAWPDy2TJC99xxPe6t7w6UdD_fXfNA&oe=69C52FAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95VxleCGOGAQ7kNvwGgAc9H&_nc_oc=Ado8hSXFqantBV2zsR5l--lbIhcHmAoltL5wZT1XcCRUtfYgxZM_xkvqrBkh-HjVZME&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGWmv3reZcaKkADB0HGuRTXi7yGvfBUdqqiMjQuLtrvw&oe=69C53E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm_CVBOBOoAQ7kNvwGFcpck&_nc_oc=Adq3mHjlX-tqy2aipo3ehOwzFDr6T19fyhgh1lfZ6leX1VTqvGa2MWtw9H0xzByrKWg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXTRdsTQe4fA1VyguFB2Q2LnTTMFGl7btNoduvRyyIiQ&oe=69C51D7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
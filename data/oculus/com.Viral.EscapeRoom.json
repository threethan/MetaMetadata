dn.com&oh=00_AfuF6hTg7fR-08dad7M_4ZNmI03aKJUmWSBs7-nrcaIR-A&oe=699F01F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb8_Cn7o8PYQ7kNvwHNKIoZ&_nc_oc=AdneF8JbOoou-oVqogKpOJ1UYyph8dAMicSONDeupZBrKs7z1Iq9uG_pVpak5fn9KyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft6WJWTLkGBY11S1TVtWI4ynUTmj_bRRtPJ-af59-xISA&oe=699ED1B2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFzwpyYgfvMQ7kNvwFdauvi&_nc_oc=AdlMwrjhS8MxK2krHW9QC3djwlouaY8xqP_Gf0M4iufKYW9yh20VBevtW-RFnZl-N_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv-aKC7DygV7W_6uHwlyPDCIcAL_76kIuZ5lo3cwWJf6g&oe=699EF42D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlmH-8aKCyQQ7kNvwElhfmo&_nc_oc=AdlyFKHhUHjyHVl_9an1MJUSZUYcodsh7KIQga1ZVmhNxBw1SL6PXwKr0x3KJdwCSic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv9xPG7DVMPQHqfUp_--ELMpX3VUAMAc71FvYEECiLSKg&oe=699F0303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSGOCLbpyuEQ7kNvwHq6LXe&_nc_oc=Adlkhxt4k3QDrg_n05oC6VGAom54NhW3bLcj07fVQQ_2Oz7uCkBvKMnwtpEaR5eAYv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuk8SFejJSGQaB-09sE3ha6bFGaPqqiSoNJ8ByFIbzPLw&oe=699EE1FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommende
RtJUYyN6t2i_6O6MVBmIP19KoeUXBDeba4zRCQha0pYidEi4vvyrESgoGMBoVIsY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaaSOHeGOO5Mj-bMKDUUEbkMuCzPlqwETKZV1bconNaw&oe=6A661474"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzMjXsNALToQ7kNvwE86caE&_nc_oc=AdpuLnKUn4ko7gqHyj_y969Yl6Cuqejdh71inDMyYYFawABj3uO-igFtgZuzeNhvpJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCskb6L3AY86_oSgnVWvNYQNkeXHzSRdXjRG6PO1lMEwQ&oe=6A661C72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfVuCl4qjwEQ7kNvwHXewzI&_nc_oc=AdogJSM5HdjQNtvpaLgdHnyOrmWV3cEGiEIEmJZ_Jf-NZHPaQ8ElRgR-VAN4gstMWOY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPcLxgNpuaBMAINp9ZcfQh2aMOoGv74CPLlO1KJo3OYg&oe=6A6606AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPVaWGTfKXYQ7kNvwEE2DXJ&_nc_oc=AdqAnqWxIJa0P8YoNuBuSjFB9zp7eaej5BvWvCVOVV_mjZF3WFcdyoYHR7HvQu64sN0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACVcmmeMoywPDjrdl1hK1XQqDrZHw1ptsMr2Zyn37Mwg&oe=6A661583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReUZz6ox-f0Q7kNvwFOf1zb&_nc_oc=AdoLTKG-K_G5FthiA4eYBN9mwodUmWhEZabYZ3wnwBpd8nZEWV0EnloFoVdmUrjkfqk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ2xpX2wfORvNiqsqXYUuoH44DiWTzYT6MYLcdyXpvIA&oe=6A65F47F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
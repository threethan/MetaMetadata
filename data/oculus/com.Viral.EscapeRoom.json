5DQxVM52TEYr_2XvosbRL0ZypQsB91IA_qvnCL2y39SVYvUgG18QaZtumzsmVQGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0RWuA9n1OvSlcrawDROc3B2_HPY35W87ojwybMemoGA&oe=6AF20BB4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zts6I_2rPJ4Q7kNvwFIl_Zg&_nc_oc=AdrYPlQ4cFgmXciP16BZHvfpqP1fjUk1FlKSZpHKnrS3FDT4zTyD_OdDeO9UnHloa0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb8pREs9oWEQ7Vw8cbN0VVi_Qq2KiG_f7NbnRgs1afNQ&oe=6AF1DB72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIPUXrjZp_UQ7kNvwHrw6IC&_nc_oc=AdpNB9fRuk-DWiuvIGTz2esOiAsDsx3slSOdRIYlABNp_eRJ4dERxLGjmQQsWbFrNW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm9tEt8ZgluF2wCdwRRCxobx9_MJZ0nJfPLhATJ3gnBA&oe=6AF1FDED"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VPRWFN_NhcQ7kNvwHsjvDZ&_nc_oc=Adpn_IN6fhl-oJi3L-es0Yak1u7em_tazTF3ZcoHQY1dbEP344zlj7Y_IM0FR26j4AE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS873EKhJtsOwX15zZNXN1pk4z3QTtbE1tqu0fM2jCezw&oe=6AF1D483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYUbiBLVunAQ7kNvwGLDOPy&_nc_oc=AdreNG2D8H-jpW0c52vE0PH5qPO-9yTzPpojs4qlpiUzPhT547bY2WXzml_FF77cxM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoDZQtS1CLUWUX1ARHTiO8eXoBZpd8M22ddtQ9ie9DAQ&oe=6AF1EBBF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
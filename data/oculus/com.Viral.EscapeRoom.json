bTRNMJZo7ZelXzMh7KggcwPvE7QRb0sbTSsnK5B_cblAiOBR-FFYHamKGj1_uaB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WIFPg3oS-VAFg2_-WnyiyaOeQH2sZcjukHPhP0q0sqA&oe=6A37EFF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C37M-UACPfYQ7kNvwGgAWAz&_nc_oc=Adr1SRDyE4DMnbupwR013_BJmyK_wZy-KjFzHACQFcNmVJlJ7Qv0HWqRE83Vvsh3FG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nlFezax9HFUsPa3vMGVgXqxhseagFHoMB3V9_9IbKcQ&oe=6A37F7F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zxw0mB05paoQ7kNvwEAyBuQ&_nc_oc=AdqLrMDnW3s-lIahGQYBIcBK9FNp6itZU9rzSjbj5fyA9qCuGBSvdkZ4yVfZe3LosBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ulnxSQOIwr5lw4IODqvqgE2PANUxa-AzwN62wLBjQnw&oe=6A37E22D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R1Tap85AsoQ7kNvwFD4k15&_nc_oc=Ado0t3wM79XRHEF6IPlXI1xXic4b6wEQfRxJ071hLtukCx_55fM_L4eemzIUB6prR0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92LS4xExmSFuv2nw2vSnEASsZABKnIbxlLVb79w_fa7g&oe=6A37F103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM-rEUSYiXoQ7kNvwF0HPyx&_nc_oc=AdrKXd_RVr23z2mr47BmzLKSWw2GiPlM-AvIFJ6U7iaAs_4lpHZwIxt2HwaK2Po4wrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_50KVgQWNyy1mY-dj4NjiBlCwXSCC2DR7y6EEy_vJBw&oe=6A38083F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
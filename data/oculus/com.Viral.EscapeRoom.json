e2gwcw0TdWuCC9v0tb8yDGDw3sipp6QCOsEO7XObtwSxfVpEy1S33X4_QlQ5gWpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6LTqZCadB9JzGGT2pK27eGdcNpXjRJnjUtmoBtT9w4g&oe=6A50FC74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQwW52XfcAsQ7kNvwF6TTsU&_nc_oc=Adryfqz5kkWX0bUpye2xf7KqMWiwGTRjwwLgI6euS2FE519_RAQdilX78bFGzLtS9gY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqf2rh91xp_o7KL5SjeEZMGSWYj_Cy0PAOtmdqvYJ1yQ&oe=6A510472"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ar-YaQQes4Q7kNvwE2QBOq&_nc_oc=Ado6Ecic1f69Fa4kBkCx-cNum8CGZ3MM_caZtuyS7Zqd6dAShvHWsSERm9KgDtvllOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmXjONcG9I9eJvMIGuaCfT_PMWLvckrInnYGjdaK7kPw&oe=6A50EEAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9Kg7HB-aHIQ7kNvwEIRGxZ&_nc_oc=AdrXYtIFYc_IwAHPFIVjWFVhFcFA3AjSJotBOIH4Y_QsCDIzzBFD5lnNUCMf9rvpWJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABQkLPJZ3V2R8W3WOC6InStJP2Q_tRW0nz_unhD6tkTw&oe=6A50FD83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5m7bjkgSJQQ7kNvwEU7R8e&_nc_oc=Adr9OWDMj9oZeNBldCcLhJv0aSzJyGsgvVec6WqBKmCHMgDCnDmmXh9qEX4wcyRqn6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARr5A42-l48ty4AXImTM8pToCxv6QD26qj2ZtqjyFOiQ&oe=6A5114BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
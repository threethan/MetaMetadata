a8i_mvmpua-wLU17AufDt1HHu9thOUwY6pFTzn_Y_y2gq5TpgDka1AcEo9ebTbnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvtBRPfWAHGV_tV0XwKh3E3LqqOIRdAobUuPwB4ygDtg&oe=6A60CE74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnGagZkIJTsQ7kNvwGXI8ar&_nc_oc=AdoHYI08G1zZzg7TRV0szZJJsq0sq6r3kcesLH3hPRNxd4zBuw41us4g40WINxOHAuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZhA1FhnxtRd48-nT0OakkrAjAU6x1Rh5vmwkwsgc86A&oe=6A60D672"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG5FgL5wu4oQ7kNvwGDvBb8&_nc_oc=Adpx4ZT6IXCKaiihTj_Wb56S766fqWm451sSi1aTzWJvNPh0kNN9bTqy6qg98XBOmlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqb2ZfFfCFuEig-T65yNN7loeNZ3vMfmwI-3Iml3989A&oe=6A60C0AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qMOPnuuZ7sQ7kNvwEla8rF&_nc_oc=AdoFBoPpQxUQrYt9Ofj8GteX5-w6RUi8ikzsqGVw9-byMgQQiaqj4Qki0HHYSyxRy3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbAIdRTpxYi38CsPTShLHu6ZhTSLt1z3_rFs5n9qD7UA&oe=6A60CF83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xV-dPug-tewQ7kNvwEOLGtx&_nc_oc=AdpGd_mIyKz6-frPyYCkWxV14vggs7mX59lCVaLzRUwUaoxE2ImGF5Ys7wzcPinUFCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNJiJN2BhUPJKO3NrWF1_wzfzzJ1jrtcsejPPwRf1oaQ&oe=6A60AE7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
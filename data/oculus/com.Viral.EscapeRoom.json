dn.com&oh=00_AfsQVt0HtZJ4ms1DB8FN8faMb9Pyscrg3PjJsQHezsybiA&oe=699C5EF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2eJkuv0NtoQ7kNvwGmTFR_&_nc_oc=AdkXyDK9BEfX3Xx2ZZocxnqzEoAEaBiM3Y-PgaVkuTLHyFBZcDEJmFtfo9BDtcdD__c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsu38lx_sT4vfmYNkKmvjDdS66PEhPWb60vaot5DUrq9g&oe=699C66F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFzwpyYgfvMQ7kNvwFEXmjn&_nc_oc=Adnq_UR3fw8ATppvBHcENiUB06X-_rMPaur63txt_3BcQ1wK_flpMZw5eKjTy1OAXFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsD0-fTaihNqGAY07ZZL_h2eGVwDsDewVqaCNhJuarigA&oe=699C512D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIZYXv48geMQ7kNvwGxKsDh&_nc_oc=AdkEwf8t3Rf2a0HWklFi67g4TBm2AlKAdFDaXoWhB52fQEtWJYZhAg7pTt9LhzGzZ50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsUHl_C6vLBUsi8pVPw53hccPz4TixfTcwFWNs2Ou4jdw&oe=699C6003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSGOCLbpyuEQ7kNvwHtvPQ7&_nc_oc=AdnULzc80GKyKeoul2QPCOWqHS3riPR1rw78gQWrAbYGMExN0JAsIadbUrpMOa9SxkY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftidkrhriGMrMT6HqhejRbwlN-8UVnYmaCXj0_mrk6B8w&oe=699C3EFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommende
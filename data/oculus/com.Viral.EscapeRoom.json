CC7VlDlc4U4Y_a1Skh0eufbsGyjg56ap39O3ID5pLi6jroFpVjL4BfR8m1JDUE1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iERk4CXO_stDxek9KccFGrV5lTxBJy54USv7i-XceCQ&oe=69FC9C74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fV922tiP2QQ7kNvwH_QdUD&_nc_oc=Adp2hEsGhC_jkDjYZMgIPqASwbv8ORtCS9NhzB3tJduBuYdh-kGrw8euYR0B4ms-kJE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Jk104DBNFvl4AX2HYZ7Gvms0KOXnK01I49z9gxwmjjA&oe=69FCA472"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg2Yp95jGFcQ7kNvwEa_Y3C&_nc_oc=AdrbzzuczBhWsBJI0KVvY4Wcl4YtX8aq9Yg-Lw_YJYqeXb1P4Q57kB_MUg_URwhRXhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42nPcI0o_G__DcMVHybXuyF-idLGtJWP_DQn_UhxrKmQ&oe=69FC8EAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM3pqAysLsAQ7kNvwEiv4KY&_nc_oc=Adrkay1ez2Hlg6j8Qr01K9Gt4uPcQyP2s6sZmrYF7JpeT-pPHBCg-tik6uwygf0mqPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b8UIeHJ9_BkTrAV0Msddtwn01AsCLJhCVXb61cltdIA&oe=69FC9D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqYgylNrpegQ7kNvwGVUD6w&_nc_oc=AdppyjT-YATgyoGuSdxVEpvwcIKD42DUXm-KxVuERrG2MPuKG3TkafIFkazinplHmf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IPPOMG9r9-TMiiuD3FoY_-OQ81NjViDgdlEQUiQmopg&oe=69FC7C7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
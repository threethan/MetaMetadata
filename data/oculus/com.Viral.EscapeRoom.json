bzk7fZQP6eV4Fb7MyyBbCFTkIqesOp9yuQEEkY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3gLRMGGGCnTBvRJ5MxGj-lFXOWX7djTOS043DRQgjvA&oe=69AADF74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULvR6mjgs4YQ7kNvwG2_h-j&_nc_oc=AdmoF1_lrX1xr2Rftx-R8hIw7qXPmlRbGt1BZSt2W34la1wSDx6z9ZjrgMLqo01TfM0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9eoALf7VC5uRT2XATkzVo_CNdwIrCLzLu63Bp4owywA&oe=69AAE772"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62xPmd8-hBwQ7kNvwGpf0_V&_nc_oc=Adl0BQeFLiFDLHdIynBuvqSmC7KVKvMPBDoPvbCxQvBn0Z8IAjNXsE7c1TnkwXuC6aY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRyPEu3jtkUCTHgLYiUfV_awSWWoSja2HV2mcMfSdE_w&oe=69AAD1AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JL1l0ZSlugEQ7kNvwE8xj7l&_nc_oc=AdkGKz3YrOmPdSlA2GtGdOIjm0uXoB3LKra6F2V8lIOarUiZZZsjCPGIzgbIY1Yel08&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCXVv1TE_CrEkZ0iHTWtgEfToUKfJPUiAB4KKSnWH3Uw&oe=69AAE083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da9eYlh7scUQ7kNvwF7tG6N&_nc_oc=Adn95YCIRnYOY4fLZ9jNg_r2z8JPqwFHhB37lY0fltqaEE9b3VCmKcbbJrZxorJzUVs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFSi2db2ZfZV4_PZcNuHVShYq5BmvySnix101YLn_YJA&oe=69AABF7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"]
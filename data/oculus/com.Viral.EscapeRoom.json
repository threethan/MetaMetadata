i3YEdICTpkM5SHs772MdWqfD1XqSZG6doJ00wwntkJev8tFeHyxghYeAOFPTi4ow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LSPJ8ZYSDwuIAf_CM2d9L414ROyMun-cmeyzzqQ1ZMg&oe=6A451EF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MnwpfvxGRMQ7kNvwFLlCgc&_nc_oc=AdqPWgALf1Z8i2aMVMi6v9e8Sp1cHPc3bxcqyh3c1M06hKXJB5TZprl-xl3548lARG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XOWmhu1xWgj48i80jbv4LN2gh8Uxa_t752xMvHS4b9Q&oe=6A4526F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRoLbUjIZzIQ7kNvwFrQUbe&_nc_oc=AdpQ6fmQcwXiYxLSaziW4QHrtiazp7n_7OgpADjqIQyJq_fZKL0bU4-4He5Ii-gGfSk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mfU8I-mMs89vWYTDgGZ5GdTyKbisjMZq4Vq_v2xebPA&oe=6A45112D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjSbm4vAhEYQ7kNvwHyc7iv&_nc_oc=AdoKNBU-PPKYdmgtSkAMdeV5O_ksdJqVbONmWqZ6-y2aN_4vuLmoHBGu38m6y5A9thY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ePipBw5ZVs29TBQpbaPWik9BR2uUBMHaY5PjhicegQA&oe=6A452003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luxxcgvK0-EQ7kNvwEvYxB7&_nc_oc=AdrOCGhaRIteHD6ZkaQOJlilNcP6k60Uvzg-S8vbFac7dQ_Cdy3BzACmUrEQ1iMFrE4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81l6d0etdoK38hXNFfk88zFcCoB6OtNcV_ynYam3oWYg&oe=6A45373F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
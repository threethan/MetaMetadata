7zOuWwwYr4bMp9K-FVqXNSE-1KEPLfWVG5_mgJiOpwFKv4xJ4DEPrLiMQEZ1k84M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZJL4qCjhaYvmexUOcw-KhOE_3EMqksWnQu23aKANE6Q&oe=6AA6ADF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzZY3AhjRH8Q7kNvwF2E-5T&_nc_oc=Adpu5HzVg40OBJ2b9EwgYXtY5dbjEa20aBQX6BX4KAQfQMYWtvhwwOpwPRPek8ie3AQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU8Ih5wI62F3V-G2-IE_WxUaIUlPy6fwzJ2axenkimbg&oe=6AA6B5F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzLR2GfRT3YQ7kNvwH7lfiw&_nc_oc=Adqqm_WEWctdCl6XR_ZQHe3d6Iql1BSXgl9DaPgzi1kmp4t4B85pvxofNk2D18erusg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEtjIDBvoGyNoeFcs36D5TJYQMWOnF_akDDKEvQu4JJQ&oe=6AA6A02D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMyILSkyvYwQ7kNvwFcgPBg&_nc_oc=AdpYK4YZIcKTyZEeFNoVgLeCOXs8_84Of7GoiW5uOhgOQfGdJHcl2ZB0NeTivrVMUjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX5ykNjXSIDDDzy_374bEq_bWxkUBHxMO_Elk450i0hQ&oe=6AA6AF03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09H-d5s6S-oQ7kNvwHLHUv5&_nc_oc=Adr3KakTTsi--fDAjEToJ_BcP4KB8zoMqZ0W1JSk9Rq4TjN5JGtDjWgOYrmJQBp8Vm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAHF9YB3bdEzMeL52QmhOdqjKK2M3arNn4WwsvJ3YtZw&oe=6AA6C63F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
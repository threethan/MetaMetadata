1f1nQsJn2KJ0V-3hI1xpMviUoJy_miiSBLloq2LXy6W5CwBPt3Q_UrpWm5imH85E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24KCEjx_MzOnM3SqWFTKtf33pT9a00ImWQE-zjXSGd3Q&oe=69F4B374"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOhGWA_2avkQ7kNvwEqMTro&_nc_oc=Adrx01pksNSx_--e4xWsQFxjnPIUm6oCJ27kSuY6D5J5RZ7qBoZnBZY3LDUdpPNUshg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HIzZmBbUrpBbOEXHkagpLG2aKS8ewtWVbxUNuTQjdTw&oe=69F4BB72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgJB0lU3eF0Q7kNvwHCUfBP&_nc_oc=AdrDPnO6UO6tKasXG2RrsNAXLcq-6TUeQmPl2RQ2xsnFPx6uBgniOIpl1wpRiF6bObw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o69l8TkEENc9KYKaou-pmmP0zl8TwojG0C-qoTGhEEA&oe=69F4A5AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_ZiUK_ap8AQ7kNvwFeU74Q&_nc_oc=AdpV_GPAbfVFWwQx9p-bjBLYHTj5yqH0CN1GKJNBnCZOxzQwOXQ0QPM00mw3_2Sv46Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0evDQYD-qdu1CN9ucEHzWW1rYJjMSt4lVQ6UUMiTKuNw&oe=69F4B483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDQUz_YJjMcQ7kNvwEFIWsg&_nc_oc=AdryWiWNsSnB-RCooIG3PBNdWayLzSNdhRPYwqr3K4pB57xa2iEqIL7TGvdB6TBkADY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_sNixzjVxlwTY9W8VovNmPl4UhY8BUhp4ueT34_utLA&oe=69F4937F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
SwHbxFmM9eSvOIYnqByGloL003YPDTgg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8_mpWPIkkXnaWIZ9rHa29gSB-dSyj0e4K-Ihh1ZysbQ&oe=69BD5474"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB69P7zzm-YQ7kNvwHWEbcv&_nc_oc=AdmY3bRiNmllKBzD9t2pGQUOISWLr7u5qBpWhCTQhfNM5cmKQ-6vnGhLKo1po45cib8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAWd7pqgIySERhupiWcb00BQOAekS-4SDljcy5CYsP5w&oe=69BD5C72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwaSOz9NhekQ7kNvwG1h8M4&_nc_oc=AdkTt9FQd8cQX1_aXTXyOOPZOobPt_7CCpuMw62KJKbrbywGOku1FmhjKRhk0WknJNs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyD2fDuhn5xVjxDwKZ5QzYaJwveyoBIhX3Ol11BZGGolw&oe=69BD46AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOWVUQSClZkQ7kNvwE3SA7f&_nc_oc=AdmFl_kHnGMmk_K-IugiMjaI2xembz6-WbMZR5LSv5tOgVH3Fo-jQ5dYNyJcpDRyqG8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzw4o0hPf0mWXiubOLXFuRnVUPxXk33dEwJP81NxZINFg&oe=69BD5583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLAIVISACg0Q7kNvwE0a8ls&_nc_oc=Admcp8uXoJK0R7PDYvRNvZB3B1UGrKAUhkOrU5_Ss2ZkfAmGStH0os9015Z3LbYlfuE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSE6PZ61ggIxxDKSEgFQOM5qCqiYwo6J_3HCftV5Ieuw&oe=69BD347F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
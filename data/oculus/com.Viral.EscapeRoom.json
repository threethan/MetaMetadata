DsKhuUU98CJU1oVkg3Emc8YoO3KxAkh-Eg2ijzkF-8I9Xz763DWULlMW20eQEAk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71P6BUszqx3rOmax3p4aNIVDv2up1WaK78u5SVQekDXA&oe=6A0DBFF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXoKDDxVGLEQ7kNvwGoMiF2&_nc_oc=AdpQRhy2KfpW57cLzrlHkgrLpVK-dLfnaNk-e1oBBzmxNPhC49UZS6_db2SN2Y1O7j0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42-_HvniSJyOEXbV_yxzYqIHxsZcwN63T06xmQQGNQpQ&oe=6A0DC7F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG01AQVniEYQ7kNvwGYWqks&_nc_oc=Ado4ojqDbVzFl1LbUdPVRGUOwGe6Zpu5L3DVbiBKb6C54Uk3A6XLEYocnOJJMAOzdfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-sSXR0Bb1HFzqFk5iB-Nr0zjwFmU6fuIrNSGRw0prVA&oe=6A0DB22D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luqn704QWakQ7kNvwHgDt8v&_nc_oc=AdpDibPxSlcgfSHoIHzDdZbAjjv8HHn913qR_6JhCNOTNkk0eRdj0EK7NClqsa8OyDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MKyP3ij8k4LSuWwnScKSRcMd72z1oOH4Rpkq8TaOj7Q&oe=6A0DC103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37hOlioO_TgQ7kNvwElRFK_&_nc_oc=AdoGNzYfyUs1z8FgqZjJdegTmapx53odQXHj5Ill6MJB6q4D-xyD6udJgQukHG-qhN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wWzVLJOPEoi6azcQSF1cfxr5aV2h6AP-MWNboazExmQ&oe=6A0D9FFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
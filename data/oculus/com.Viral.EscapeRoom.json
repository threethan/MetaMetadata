E6cueWg3xjRbkmu4CJgerBXrdwPUVH90CLjYgecD3AS6F23J8ZjLeNjwb016LpK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkmHKy_liTRYvnaUoeXeyNRe4IV8P76p-WewbX4q8E4Q&oe=6A621FF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnGagZkIJTsQ7kNvwG47xsP&_nc_oc=AdolYG6PrKInU0SRPbEb0aCaQqEDGTieZKYq9y9UOlObkWex_yQNu_fLfG66Qp2Od7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT7k88HA5wWEFWm7s9-agwY9I9Gwsgxux_4_SpLti7LA&oe=6A6227F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBMnfL2Ea60Q7kNvwGyFSeT&_nc_oc=AdqLnOorPyK_I_CKtJBCMFIlTxOy2S5SCL-bHWxJjp1R7Ig0JD7QGqLXccyQHv_FThU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCooQwfNf6aoTeTX89-KG9WSbC2wcXvNbYe0dhTz0ceLw&oe=6A62122D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qMOPnuuZ7sQ7kNvwHHdmbA&_nc_oc=AdqeB61xlsQI8-y_AOAPbXNoXD8tuy5B6wNmdPXAxvGX8pRdDj5fW8BeNXKYJkZRe2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP9yT9l9Jc3Q3tWK2_f0BcS1FHMq-hFbRA07cbiEO8_g&oe=6A622103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUEKPNgNVAUQ7kNvwH9rW6R&_nc_oc=AdriI80NHfU4jh55mM9kW9Q6-L4szYV61YeiahnhIWdJmrLG2W3Err1-LjA47oi5xNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGdjUSBUVJZfj6tDQUXKOBy1syRcrxQtf5kJByTIkNSQ&oe=6A61FFFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
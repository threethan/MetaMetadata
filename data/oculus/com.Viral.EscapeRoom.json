PeRLBTZPEMstUpA41re8y-VB-Ak9zPwabK0ZM_cw3h1hZB0yPAb_SxGE47YbZ10E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObJ-KKQR4GS68kfS9YD8680xe5GVrDV8moCkCOG7Pg-g&oe=6AC10BF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C9ET3PXN1UQ7kNvwG6Ys7y&_nc_oc=AdoleyzH91RsZ1PbYkBsh1SYaJPdF9GAsUUcHaSXnchkKXhiNJh3nM-2AtVRmRfHIx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEOI8mFCKIQP5wbWzHVN8CDPc1pWbZDiJwJtzDYhH6zg&oe=6AC113F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkbBbEXOozsQ7kNvwFDfBlo&_nc_oc=AdrlL4abQny9mVpavjdwyhlSE9ZwLRpwfEb4bdkj6cTYynEoEYKydvnOdG8x_VLsjns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfE6gvv9Cr758gDpBlTwcDsbG80AA93HCvmhuSiwv0tg&oe=6AC0FE2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJT-mio8EdsQ7kNvwHL0cCO&_nc_oc=AdqYdu41i20iYzMMmJtmvR968IrehfOnSqOZ5T84s2RQc9H0lO3AfgqKj-aFLQhh6FQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB87jMRgT36gs1dOdg3OpT32eFGMAcs1Fa-WTOZmAqdg&oe=6AC10D03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wA9BkAICCMAQ7kNvwHMsg6N&_nc_oc=AdpihxMsQpfxd60XX-97G4g5aqEHnPm2NsHap8Zbbl1FXOwcCKBpbWlJLwdc9k1WTuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM25KFDv_g6E_V-UY52Df4iR9HIHD6gGgLWd0VhgmpoNA&oe=6AC1243F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
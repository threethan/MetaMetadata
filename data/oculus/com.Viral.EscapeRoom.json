PTe__26UxJtyzx2G4F7m9ED2rRhglc8RYxxuqbwWK21gjGT8WsVjUXu5dDyQn1Oo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKnHadgFhh5PBX4woEIcopGLCa4iY_zFMlkw0JbYA7Og&oe=6AEC8D74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab4ImvVB1a8Q7kNvwHmMO1V&_nc_oc=AdoTzwKohYC9zTXmXvqXV2GET8Ie9meb-iNnezsJ_BMowOOJ6qpzeHAyRypodHbpplw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO_4v0HmyKOJzbX-W9XWBD27Z0qaWsIXblxtpVAFOwng&oe=6AEC9572"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCqhy42JvQkQ7kNvwFDr3NA&_nc_oc=Adod6REAdfCwc2WcVtjzJSJeDvEZi06bpMHCK_IMwLl_hiqbCoeBLlHlqiv8eIsz-Tg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrmSvaaIhKm-JFpdE83WvCEl4FlYwBNbNk-6SsNt9NBw&oe=6AECB7ED"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikoTDEVAYG4Q7kNvwHFCMyJ&_nc_oc=Adrc6P-bbPQF72KyUloM3mZaRRRCFCa2Gu9uhP3MJUGhHzIAjGaIX_soA-lREZTZLyo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3vDH6JvkYqMuFZHzoUbDGvWlaI_Nr-jtVvrqywjBPsQ&oe=6AEC8E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4GUDpa0m_gQ7kNvwFi7d_9&_nc_oc=AdqWpKvKATcEhwmacgOzFf5hfS8BXkCe7OKgZyg4kEHLK9dfwYWcmB9HoI6yERam_90&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Tp1xMYPpXQ3x-9zEjWEjCwzhXRWJH52da29cOFcMmw&oe=6AECA5BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
sK0_9uWAEervW0c0O04BDxloTXKsImLQymuwgoHb12g0e-APVPyohMnA29lpIjAw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25_r87uTTl1FjhsFEYTrCfSSb8otknp4UsQbvFFr7dOw&oe=69F604F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOhGWA_2avkQ7kNvwGzRSft&_nc_oc=AdpHUEkfN_5qAT2Dv279yLR0TbwQCpTwU8uPFiiDJ-HmfAI-d7X1La8iQj_jqfF4Yfs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OclSA1Ketp37iRM-I02I3j88uOGcmkmK1WvKJU0iy3A&oe=69F60CF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgJB0lU3eF0Q7kNvwF6KoW0&_nc_oc=AdrQEHHlECOjFdji1pAJfNKkpMfibxPQ6TKPZ35JxHmVCwCfetjyZ7UCe8EQxZeWVmk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gbSYSVLwF8uXTutg95lI1NeV682JWqL1R3lEYEkd3fw&oe=69F5F72D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_ZiUK_ap8AQ7kNvwGdWG9V&_nc_oc=AdqfPJKuTRsofVhucUhIqarZHhNeGQjJ6zYz_t5JrVyt1Yw6SbxWdRGHAZ_c9Znym98&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xUFZHycVeIWPA7oWXXAqAVyHBumUL5Fe-IYCjWKdKxw&oe=69F60603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDQUz_YJjMcQ7kNvwFhTDrX&_nc_oc=Adq25iru7hfVP1Ul10-W1HYMmv_0_AFt5-xomnYSWRO_Y2yQlYRNjXaxMoVzTBmc9_Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1687nVhjB8KJ-Onbyc7fm8epzZmV51RRMorJZ_dy416g&oe=69F61D3F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
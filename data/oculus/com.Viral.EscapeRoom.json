dn.com&oh=00_AftDdtyJqs1CGrjgWkCNqCIytctSsMn6-yZHe52jFAG5Dw&oe=69986A74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOmO82gUCOMQ7kNvwGQR9m_&_nc_oc=Admnfia9t_l3v2V6ZzW_O8PwCJ7ZG6Un74b-QMqeZwHl4kivQk3mcHaYuJtAprbNDVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvNo5cmE48n6VDN1jkVIXGr2hPqp8bjIe7GqoGahbROUQ&oe=69987272"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJnvlNjIRDYQ7kNvwEIuJbA&_nc_oc=AdkSIusOjKE-z87LwfNB3rOyjGaqaftB1Q7dMxXQdWuij5xMNnV5WhoDrYFxMuN1fYk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftU_fhc8GLdVFN9dbMMr-ykAYq1QQpEXCJGnN36Bl4RbA&oe=69985CAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFeZpI6faysQ7kNvwHveUnX&_nc_oc=AdmNBCe8sT7hZ_cQhpW2GiZURH5ljcgv-vnLbHLISY_4SaqO5lHlk-aY4kNlojFS80U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftwSNi6BqnWQ7zlhRrkwBv14XPydjJyxSkuRl88snOA8Q&oe=69986B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCb_OknUr7kQ7kNvwGAUnmx&_nc_oc=Adnt90Uimx0m_oRAq5zbSu6fJxPzrhUH2R2083KwyJnDB4L9_3BoKnErGQyCveHigu8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsedAeLvk-Al5YCqVxClpSP65-bWjPaeQA444hSgp2AfQ&oe=69984A7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommende
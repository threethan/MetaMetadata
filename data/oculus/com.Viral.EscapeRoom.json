MjgGBqtDAAmp2PoPZuoy6FPL8xUC3CzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNqQyvHTzI6hCX3c0kNrL-rKISORbyokMq4XtzThPv7w&oe=69B02574"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_oQxlptms4Q7kNvwFVKCQ0&_nc_oc=AdmGvxWSdy1uljkiioo8Ifz_CzmPPocTeFItD0N6G2DDGDr42qIiMMu0V-Owb29oYfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzW8Y58v5emr-Ue7hZzseWuDvCWqN3RfKvLdh_gO8-0WA&oe=69AFF532"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcXkDokbn6EQ7kNvwHfjzEK&_nc_oc=AdlTL49V_fiPU5SjNfFpcROSPzgdzvT78FdRUecS_OrZnSUkBEtawiOdMQ9BJrCijdg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuxC7vKPRfdXh_J4j538ur1VMMeuZdQMGOUOBXVLhLTw&oe=69B017AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2iEfH3FvgYQ7kNvwFkZVBE&_nc_oc=AdmPTuf-2Dxvi-jg4DITv-pOjfIJh3US-dy1FP7Xo64ZtF8ilFjlXqVGrZVyZ2nUyRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxKAorX_CMWQLSNAcsRuRVAY4mcKsdzSSIwpyyOtYTuQ&oe=69B02683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNRmXZfq5GcQ7kNvwEd2YaG&_nc_oc=AdlcWb8MTUrDlsH51c8bU47h0aDrzitaFtJZM7NEN5LbSqAHrjGd4NdOaGK9jcL2h1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu0eu-P2crXSc3R5yjUf1tEtivQOwHR5hkI4G3S8eEdQ&oe=69B0057F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
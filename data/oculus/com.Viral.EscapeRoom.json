i3JSG6gFk4x-JmBwVz_dNanQ4LmZSyMW6IQ5K9feVk1ouj3OokwftsHIfZhXpZDM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OjcSBjKhg6dGDQJUd2S0RF8giDJIlSveOdFLYT8d8_Q&oe=69FDEDF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fV922tiP2QQ7kNvwGKwtCb&_nc_oc=Adod7TRjNoqHjnBPceJ6iX_9kYq_cfRp3YJQhai_1GMpyd65GlnetQuhVr-GfwNfUCI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rWi7gjaatqCOlE-L98Jfk187v4pS2QH-ymWogv6yEoA&oe=69FDF5F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg2Yp95jGFcQ7kNvwEy_YwL&_nc_oc=Ado5acF6ZThqmpTj-yiag3rWpmOu1tUp_Pz9AFjvy8nicm59KWxD6VfxMv5Tpk997mY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gd1nxLXFPgUBXe5c8ac2W3CbHdqZRfbphTfHpX9geOw&oe=69FDE02D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM3pqAysLsAQ7kNvwH6C3_l&_nc_oc=Ador7HiC5fVrFtb_ahftkMFD1LwG2BesdMRIzWo7-fP-lBwQvWcKyd_6KgqpOv6UrCo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72XlQ9FMr92SZnNG2TJlaTVywEJHBbMonTQjiwIFyO_g&oe=69FDEF03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqYgylNrpegQ7kNvwENLUmu&_nc_oc=AdoD1eRRvwK6q9loeOaebFmpWMVHcG5Po0xcwM105MBOR2eCFFgx5yKODcY6a6uaRGs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uIX4dup3s6mbz7BQPCUtvGRr6cSdTl9oo-gt7Rnqp_w&oe=69FDCDFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
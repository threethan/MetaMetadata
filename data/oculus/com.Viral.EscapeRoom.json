bJo1-oPXcUr6YrX8lKhclcG_SFZB5WnMR9nciCCDZ7s6XTpy0fAWyGr1P3CXt9Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fIDmZXa_o0RCbseQCeZx9APZOm-ql25YoYc76jNMctQ&oe=6A072874"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV3-aNa22qYQ7kNvwFzmz9f&_nc_oc=AdqVkiHULaAllLCCD3S0aZLz34AF5Xzi4INBROtR5HZbZ_L7L2pvRXS-JUbP_JiQOoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AkXRl53hr_GBslHw74at8Hn6V-NKamltnhq1_jDEZ4w&oe=6A073072"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxlQ7oXiG_EQ7kNvwGNTEgE&_nc_oc=Adoix-b8BpTYu-A0VN6BoV3hG0RuI_ZQ9Vi_QS7lV_xoQuSvwXmz_MN_BvHJpp55hKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kfQ7o3wYtZmRrlzDxu1fxdeHNhQew_cRT-y3l8RGRpg&oe=6A071AAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UMcmlwza44Q7kNvwFvd4XK&_nc_oc=Adqi_3_P1bmenmG9hMdJhr_ZAHSaMwrW60efFlA8IlyuxKdb3hJ1fzu46jHU9QfUskk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fK-NZ8iW7ee0P0N9f7PILhNUVstj0xWHamZFzV7Iq_w&oe=6A072983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNkDLN30KEcQ7kNvwGnE-b8&_nc_oc=Adr1mPc2g4F33rZYEqOqWUqKH351adZ2wNMCJreO2wFIHPi571C8iJFxexNuGNkz5Zo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tgiJFPbFZYYLFbNi2edXDMjdXbkB_NZDtYWVi1477MA&oe=6A0740BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
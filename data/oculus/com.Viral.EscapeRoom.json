tcX-p2B0_NyBh32zEXVeU1JDYw-qtGIUyZyIQHiHI3qBwB8qjjPSW4C_g5Ol4N6I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zNX6Ni_C6RtbXkYmGvq9fyPm9NR-C7L9phKEq1tIELg&oe=6A09CB74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9HYoc8H4FgQ7kNvwE8qKoq&_nc_oc=AdovBlsWjm6EXS15r4p6bq9_NfsEWv4yRoWkgn9HG1TG0Lj1mzYq873C9XiNn4GUvmA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SDNLQH-MaKNPh3yM_77VU1nR3F_eHwEYInio0oAxkTQ&oe=6A09D372"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxlQ7oXiG_EQ7kNvwGuEMjp&_nc_oc=AdqnKfPIlQANr0jk4px5cmlNxQk6f1l5yarUeuB3OAZg-yBNWAOlpM-zTCZAIQKuzYQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m_B0AQzQNmPtGz4cZe4YUJ19CzfGlbvfonuzecPOP3g&oe=6A09BDAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2ObuGIzG3IQ7kNvwEMjqwX&_nc_oc=AdrteNbn0y93JJtMzW1Hrasx9x3WtYXkNjBPiUR3LeHqw_X3ChEi6iZLpL2mRak1YMk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5piIN1y-BN3B07CfKgMc_IvKA72NxCjOeiCSxCJ3nWUQ&oe=6A09CC83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNkDLN30KEcQ7kNvwHJFXx6&_nc_oc=AdoNc13ahw6vy2iwe8alWIETSWY_RpfNhiFQYCQ59YIILIru1YxPmk9RR0UoDlpUepo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-maOKALyp5n0_nDinG-6RKkBGm514ShD4AbSHz99a7Q&oe=6A09E3BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
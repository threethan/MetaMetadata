98mMqSlHjTL3tPkHa1Ul7ZmcobQhC6XRFhKrxxw4nLeRm3KmPJldWeHK779r-Mho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LODQO5Ba2MDHDjvU1BsQHtFSDG781TOvxSMQ79gpGSA&oe=69F8A7F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjJbi_PhGhkQ7kNvwFfSGII&_nc_oc=Adr0VpNp8LeIl3V9MQx5pa1MVr1okRRToXCjNTXHQVjLl1dbfTl9uZ3Eu81smAcxWW0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kc0oWtkKuQTObqOZa1qAsWWJax2Gf-DsDdf0NJVp2ug&oe=69F8AFF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_diafPxgyE0Q7kNvwELIJC8&_nc_oc=AdqmmA8J58f-GB-tk1deP8SM9e8su7ZOu2Pqh6wekUSpESDpqWjDT4KTeby_PEgM9Nc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09H4G4t6LvwjGoeUPuJkv58AMVj_ZgheE7XZcgxag7_g&oe=69F89A2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyjkEaPfpMQ7kNvwHWFure&_nc_oc=AdqmV-21Gs6c8eOFL_v6DJO0g7XKUwLy-mnkN9YYtzpltFYYpPwwWa7ViN4E2JCqXOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WPkymmBf7IhoewjQVtwg7ep_u2E1IimYpCYgQypgGww&oe=69F8A903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH9dsBJ17-IQ7kNvwEvVT-1&_nc_oc=Ado-dLbMZaF5k9Ce7t7yI4KfgnhddRP8JdXYOEo72oJes_1vfbmkHUarP0JC1e697d0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bAk9h1d5LtfMo3vD4RUB0HzGGJW9bHeF6gJBNBo6tGA&oe=69F887FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
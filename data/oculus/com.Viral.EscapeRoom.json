JyBAj08rfPkcbd5ONw03IVd18CCwwANKT_l4iwxxfDobDTYfbR8i1C5XCBZ_Ow7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mbv8lnavRvGTkxqQ1Ct97ANqi4qlN2bU48PLmQCHTeg&oe=69F9F974"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjJbi_PhGhkQ7kNvwHDXKKg&_nc_oc=AdoeT9CUf_7b_Crb_0p_VFgStLiDEGjMf4GwEe-0VtBrDpY7vI1b_MmF8mGjNMd7lUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EFcfh6mrD4WgU5Ojx0LEfHDmYb-lsjerKTyosolWUBA&oe=69FA0172"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_diafPxgyE0Q7kNvwFe5osU&_nc_oc=AdphlJkx17tOXDCHAzknVBqoDxKaeDBgf-18UE-pavdK8dSTRtyDtHnDy_az9PWpsWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jZiQIemXgs6eFwco1v8JBGtUS4PpOL6DvQhweKpo6Cg&oe=69F9EBAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyjkEaPfpMQ7kNvwHBcVg5&_nc_oc=Ado2E0juOdu6BUxQOM1p4dwM0omEQMm955v_dn6JON1-Dx9TQqRW7Kn2uDawcbq4Z_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Qz1ytbB15s3wUEEfjoCTeB51xBLgKuzuhiWYdgaRgsw&oe=69F9FA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH9dsBJ17-IQ7kNvwHTsWWE&_nc_oc=Adrew4kb_0e0VmfnpsPw-gWyT7DhRPftQV_gbvk2juO2GtSWaRjLcrKIQ1d6HUXST3s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LtycVsnk7bRXOdDXuqAFMAKsa1fIr7pp_HB1KSrVDzg&oe=69FA11BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
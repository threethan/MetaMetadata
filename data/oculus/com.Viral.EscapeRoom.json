RNfX3OFT14hUEkXnNfYM5P9jJYJ1oNmNvEftwlgMdh4kz3jxTLnbchrDlk_4zhwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rEBDrgHpmReXPdBP8p_MTGYxrxO51cJpqXsLoACguNg&oe=6A1D91F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWPBZ4KG-ukQ7kNvwHGBn0u&_nc_oc=AdrkxJ0hDnKveFy3vxYbb9PmhmACLMC6q9rAlunENf7GF_jEzLWoriwP5O4pUTWm2F4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ayP4OrW10-V9B9brv5qzNdP-0nNefCaHz-sJPXchNUA&oe=6A1D99F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugFQffTK7EwQ7kNvwEbZTJy&_nc_oc=AdrAsVwKi9YbECUAQ68K_lCgtKauk7-HLlDjqgRoPCcZCF1-BmTRO6ydpDB8Nc4KXCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xFcnxtx41LaWkN-RZ8HgC0UztVCkEsFR0aXf2Kt1iCA&oe=6A1D842D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rqco-b26SW4Q7kNvwHI2Bi-&_nc_oc=AdrvxR9VyvFMrid8IhgNG6vHwBJalB3XcCcW9w2--zC941ZmeI_Mr5iYVQoNDBerhLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cGLNEdVDcgCHiLP5wIdJtet5s6p92P9Gn52Vq27E1qw&oe=6A1D9303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egCqi-0by4EQ7kNvwH9jpBv&_nc_oc=AdrywRMP_t-TCsqo2zX9pmQAf6eDXa3mBlcPAprccWJo4G8JP04W29D3qSoMUR1orZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mpkzTYLzhYsLYy37FkrME1iBCWuZFx3WnT67R6PlUzg&oe=6A1DAA3F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
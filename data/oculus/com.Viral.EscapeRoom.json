YMfT5ggI_ldnb79UmchINxIi25S82Zv9ySpAJpDd8k86uKHaNoxPisnDjRATOxds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN05qijDkN7bH_nvOtU9hlo5MTUjCz6PvuPe9-YH2ds9A&oe=6ADCBB74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxqxQtGuIVAQ7kNvwG9fAiY&_nc_oc=AdqxJpRjXD8ac02OH-l7nFvFheWTLdBx9QJ6cW9JMZ7Ox-c_JdSktvY5LKHFNjmL66s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpt96h6rGvyoCaLQVqdORD4u-s-10nUL5FhQg2gGgYMg&oe=6ADCC372"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Czw4HjNsqG4Q7kNvwEDceHj&_nc_oc=AdoGfmSRuQsvDwC_gSKrTYJMsBgafVJ7ymHVsTdyyJ-JCQGQTbJ7wY8yacuOYjuTe2k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOpgUzhuQgjW8TZdgo8G40WeZPFZSpjH0Tt0pALHEgcQ&oe=6ADCADAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_2lZL0MazcQ7kNvwEPsV-i&_nc_oc=Adr64pcy4gXx6wA5DvWji-sdme6TD4VNXAsFODw2fFQWBpJZDU33RpJoGkHbrx1ikYA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwVR9LHDN41MAeFOFeZAzt6ZgtJsrB3ZstRgLtEVE8-w&oe=6ADCBC83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3UlcWMCGTcQ7kNvwHww7Ju&_nc_oc=AdrRoLHDGo__7oWfC6l4nNIyCljg94vOM-xjUVGIR-e-o_IZ_KflIpTF6Cdvz9xG-j0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxzcCDNwEY6pBlOh3Fw7yP7riQ00FmUIpOl8H_IdcZqg&oe=6ADCD3BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
nYkFAdmu__jeG7iEh9QUQEzIjt3hCWFzxIhCMtkC5wY9a2DI_EJXC2igB1gfMcSU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B0WZqfAveRs_XTXK8IatpWlhMa2E_W_qby6Us4c59WA&oe=6A3D35F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCEfPaTlerAQ7kNvwGPjiZA&_nc_oc=AdrLxme6cbD-OILdakumdxZ0HgcHA3Fyrft9dkmu1ZLodi-h5CwxEAt1uV9zcNpayiU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ELZSzPh6WOH-fn_EeLfvCWhjyw_t8CBsQ0uzPB2r2yQ&oe=6A3D3DF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmmzIf7g6s8Q7kNvwHOmYrP&_nc_oc=AdpFDVhs39ug51kgERvS5j2ii9YBXDYRMKdYmOi1Gtyp3H0AyzILnUcP6LMwpLRSfJM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eU6ugLe-gUCbjjlvtvVDCgsxTYovPymFo5_WQZmOssQ&oe=6A3D282D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AyqmYR2MRcQ7kNvwGjIxcY&_nc_oc=Ado5at2SyqCTjppRyVbeGsmixgwJMgQLsEjYP1dowY1YtRcKmJcOIenycE_dltQCmA8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yiOlRNw1Hc02YPwOkskRRgJtxiDT_Iss_lyvwA6XPSw&oe=6A3D3703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OYqkqJK6XcQ7kNvwF3tc2f&_nc_oc=AdrW6twljiEquFuuXu9iU5ytQ1iLRkvhaY9vCW89sdxRK-TBbPfrN5EsXirG_V3Mu6U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YjRryPZCJi8jgFAboARqKeOu-8J3t_pch0fmmQd4EMg&oe=6A3D4E3F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
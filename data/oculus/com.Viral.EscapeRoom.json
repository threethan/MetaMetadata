pt2h8HEDUmFFNvy2P_908UmNK5K43lP9BHk8QXi3jrL1TrTZwYEi7q_rfdbI75D8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sead_y_TM0ypp0F2NstJjJgrJ5gRpFq8BKHqGbT3K4Q&oe=6A3A92F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C37M-UACPfYQ7kNvwE2QdYg&_nc_oc=Adp16yE3hCyBSjjXJGKDxcVlo5-b74XuCN3cAsZa9jlrhpJaW8hWhZw9g-F_k0p0NNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JNf8hFQE7kVOR_mUkt8JWuAuHUdLd-9hKQ0UmJxzP1A&oe=6A3A9AF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmmzIf7g6s8Q7kNvwGfrZhm&_nc_oc=Ado-KYYoQz62ewMhqnGXSmC_7xRuFPgLbBTdzSPibvBpMfzyFA2F2GBpINNxV3mJ14Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gWEY9SvJ7h0EaGyox8rxF-QCAFMNRdeGHV8DI5e-BKw&oe=6A3A852D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R1Tap85AsoQ7kNvwEscR57&_nc_oc=Adr8pY8xId5a0X3fUia-weM8fuu3r7urQXEt2rNJGRuA81V7qq7TMI2m1b5imo4Thlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pJ-NENE9wAHNGcSjZqj4j9QwFxSg8N-utzbNnfmZn3Q&oe=6A3A9403"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OYqkqJK6XcQ7kNvwH0SEjQ&_nc_oc=AdraAPdPxJiOzoanFshHmhfZxoLr0iOqXfdgbN-z8xC1N3-EupJ_VPujsF5R_mATazA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XzaL0Nx0g9Znkh_8_EtRMTGolI6sufdlRAMJ-nlvfIw&oe=6A3AAB3F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
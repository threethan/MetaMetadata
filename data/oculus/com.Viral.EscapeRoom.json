CmbGSIah6Fg6cEbB6Cy1xMcj6e8j8yOmAfYLm5Mec9ZoeJhsovldH2SWRD8kRgIE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7u8ydgUrQW8DnPKaOHQKgXFTKW34TgwGguFJPwJ3L9g&oe=69C7E074"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGi_o5me9q0Q7kNvwGrCCww&_nc_oc=Adq2dZAZju22xDVz1KHdGlTyKfm_j1rpI-eP3_UcLYMdJ1oRaUBlLUqnkSkoG0qACMc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxayCttyCM6X2pS16cmcE115tEa4DhkS2Mq_Z51xxkzkA&oe=69C7B032"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zdCNtG6L7oQ7kNvwH7SKbH&_nc_oc=AdrDQQ3QiN6gmUFVONx9bRiTk12cdhm8vEnxUGgSKyKS4iS_btvmDxSo4SyhcEvFaOc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwedWvzwPPRrikxK0qd5uOgRZ69T7OIF9RZG5VMGod-uw&oe=69C7D2AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95VxleCGOGAQ7kNvwG8_qgb&_nc_oc=Adow_wiSsTx4PD9KB9Z7t1KIt696kgi_o5YQ_Z_nqNrxyZ9KzQskABRKMv0clX-C-g0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznC1y1rUUudfT23GyBA7piUAHhuMi6yJ43vzhVhPpKEQ&oe=69C7E183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I-o7lgP0i4Q7kNvwGmiJKK&_nc_oc=Adpp4spaSLLdBRHn1X3LSdTyKyHLjFp4OgqEjpwjLS9fFTKDzP7fS04mlmbHYVJkP6o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFAOBeVtJCjWUoCqgdND7ZCR0JgPB1oyvt9cumeRgFsA&oe=69C7C07F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
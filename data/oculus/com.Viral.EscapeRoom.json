lwb3DDgTPRLrg-8WAOIgQL8j4yWoFO3eT2eQEkrHlVgCT9OLND2QgdQY8q5rywoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12E7-V0CNf9J3wNSPex__wEKZ6f0bpVQhZ1Qo6aTOs-w&oe=69EA2774"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VUmWMYMlTQQ7kNvwF5vgzd&_nc_oc=AdqvK1NGMXXg0MVkL6hIz-UuPtABVVof9Qjfkkc3C4Ss_SWOJIbXNuKNjNEQnJlZ2Qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AAO4PX8JCJlwFKux9qa8Co83ALdPodKSckQRyfN5J2w&oe=69EA2F72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f29LQN6Q4oQ7kNvwFu_gAE&_nc_oc=Adq_vmelpTON5jt5OyL5NV_kA5Pq49jc4ystLAk9lmfxyozuWoIngPR29xRF2U-PboU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2153FHIxWcjTPjpNy-fG3vGDfo1r9PHyyIb9OSxsBUTQ&oe=69EA19AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_rbXyUo7d8Q7kNvwHYJFcN&_nc_oc=AdokDTxVYxn_NbzKETUv-syYBqoDjNNMO-mNroKQBx702xHZGoNdwaDJtQKHtJlEBuk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A5WnAO6l5KqHbC7DS07Djt7EdJvduW6-m2y9WRJGmkw&oe=69EA2883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7FUJP8xJUIQ7kNvwGY_atn&_nc_oc=AdqcF157G92mF2CyBc0c05KqEV16nibzoEj8fmeN-15Kz54Wvk_aT9P-ZaznRE4l6iY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DgnBZtX7ANLS-xBdLGlKH9Lh2hyifWCiaxVJiOs1Ybg&oe=69EA077F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
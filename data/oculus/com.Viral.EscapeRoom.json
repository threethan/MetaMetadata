dn.com&oh=00_Afuhgbiv7mUaKz6Vmi77FVrOM-dM8o3F5INNP1-OkembXA&oe=69A59974"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDNLCOAMbAkQ7kNvwGgN3zQ&_nc_oc=Adnu3ti2LKh8c6UpQIBS4XOJF_AIHiPm9jAA5JbZDU4E1ZdI5YPSLUpbZKXyL8GRqvA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvNPQCxs_TLjeBrVmYHV0OtmTNIrZ-SZIy5fqJ2ALaAIw&oe=69A56932"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh162ns4zlcQ7kNvwEBH1GU&_nc_oc=AdnSOfz9GzGmc-QNgpFHLpPEqlfyjSSrdbmgCwiEibOleW8GO5qDFn4PiD6808Pj2hA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsMi5LgAm3QvU_fQaGfDsM-YFBIfFFZvFqEeRxILfMDZA&oe=69A58BAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4q8S4W6LSgQ7kNvwF7xZmJ&_nc_oc=AdmqzDg6TdMQcxogSwbUxdR_oexlkGJmJRN3L1d_MQCyVqU0zOcFYlqyrrDk7Ipm-Ho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft70f6651i43DmV2gV2p4Ri7NLobzdUgLTcagIyXRgcUg&oe=69A59A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA-ac7reA88Q7kNvwFESUWQ&_nc_oc=AdkHQ4Pp7waZFvtUNJlPrWLXytfW5CseDci1n5Y2SAHLN6pCHiEFBHCzmJm94VTMzVY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afta-Ypvzq8sS3oOBXRNEngIINvFrFUtzaLwEl_7LmadGQ&oe=69A5797F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommende
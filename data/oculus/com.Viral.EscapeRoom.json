ae_QrLyvOK5YRt-R13U3rvAS8TfAiETEy3VE6t24yfD6mR_cB4u5pr-rHdtX8Pmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M5nYQFvoecg2hPc5Z3liw9CK21saWCkMtms8SJqVBfA&oe=6A3BE474"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCEfPaTlerAQ7kNvwEPHL31&_nc_oc=AdrvVzWHNuVD_rSpqMfP9tjw0cibj8eAgcmH94QFtSZZczNZG5C0oXRHV4zwcizr-cA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T0G5buGzKusXFjD8aAPDI3Owf3pVUS3ilF-hIQj8zNA&oe=6A3BEC72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmmzIf7g6s8Q7kNvwH-Gw0e&_nc_oc=Adp-srjbF_iLOle93W8HPpvKUtFAK15EeKlJcquWCoZGzsQk1ZnaNpU0wUIepJRF5m4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YUyR19XlW3P8g_0ZUM1FFvwV3PS68-9JSOTMP3AJynw&oe=6A3BD6AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AyqmYR2MRcQ7kNvwGz3jtG&_nc_oc=AdpFBF-WsoZZnJNIlLT1SHYXEn8pMP68e0Qcrak7gUSrVjlHihlj3yqgsf3LqpMmbPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kjpTGyQ4ceMbAYskKNewRMWJfrYs7PKw8HsQWLWhuBg&oe=6A3BE583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OYqkqJK6XcQ7kNvwH1OjEl&_nc_oc=AdpU-ZTNOiY36QRNoUmIU4cxREg7S_j6rdYosOl6yYj_iVS_Sz1_x0lPgI1jlK7Wg5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mOZCDLzj1KelwbteQWvknSiWGtwtvnBdSEodc7WOWNQ&oe=6A3BFCBF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
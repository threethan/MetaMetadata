8oDv7A1HNobSMNG5h1fr2j8P2rG-z6DoLi8fihXqduOMr5Zp1TM_T4qofws_RAec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQwRl2FGNPytBMlqSPZlZCfDSdmq1v9KWZMiPuD3zTbQ&oe=6AF9BC74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKZcOcV3DqsQ7kNvwEEa529&_nc_oc=AdobsQcOYt3EE7a_SylmkRIBcAMNahL2PwHEMJoAYSQl_g2BF3JPUX_1NBLyRlcy8sI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSproWAT1Pb4IWcrCgHdqiRtDQEf2CkkbR5W58mgjvmgw&oe=6AF9C472"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLzwjzG0flEQ7kNvwEVBmeb&_nc_oc=AdqAkW1j6q_pLyKuWB715xnlnJEe2i3LCyOIRHFoIOrtOVFqGvEJljJmP0pyISKPaUE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVZONQ85RTidMcx1Nt93Zd8rbaXMOO9xw2DqpOFlTZBw&oe=6AF9E6ED"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3Mno3VDP68Q7kNvwHMmC1d&_nc_oc=AdpYeGL3ijdg8b1EWSg1HfXuqezi5Ct8W0oeNSA5NJQfNkDTfnFlU8LTUq-qX33eg6s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj4hBWyn7GdiEGUldzOr3ZNAxaWJWAwGAXB3E5m6A0Sg&oe=6AF9BD83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0qNRTzwwzQQ7kNvwEQEae5&_nc_oc=AdpUz8evz0ARmaPMFPxQjmxxIWXCTgBPgMkhCcfXjlHClh7qWBtx2jltTj_ABgTL7ow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9xAq00d9arPaOdjQY2lKoOSGBp663R_ERNHETME30ig&oe=6AF9D4BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
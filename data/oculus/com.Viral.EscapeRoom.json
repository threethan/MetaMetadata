9Cs-xSc6hH8kxv1s1rmtjYYZQn6AHnk0iL1bOVKRIHAgGKOAMlAX35Li9r3aYpAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E2M8yaT_G9i-MXadh2CaMlCrBK6JFsC5FXbrSMgoiXw&oe=6A01E274"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4AvuGWg7cIQ7kNvwF69lgF&_nc_oc=AdrjACTCtNCp5M-rlVuSjPi7NF3iU7RKyy8Bwkrbrlz-wNIHxc6qtYVvnfrukGLyPZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gBbXtIU4TYoTtzL-JQ_gCuYdieQV1GDgUOWNsCG__8Q&oe=6A01EA72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpbGpW060vwQ7kNvwEIeQKj&_nc_oc=Adr9GeMPw4A3ZCp-7dWh0dlmUqJb0mS6k4PpIutRZH9o7cfWyIAHFwXP7hPH0r69YOc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4njU3aFYftLfKqLaD1KptTFkbOl_CA8ggbJdSIBm8tAA&oe=6A01D4AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu-VjbfO8wMQ7kNvwFEWb3t&_nc_oc=AdpvLIABF1fgWHHPM_z9CEOauPuZsUAJKPO3hEgb-fjklKrbas4-qiS7EqG40XUB9Ks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UV8gK1HtUCVcLOZwdNXq1nxwgretH9aPbuYR_21oe1w&oe=6A01E383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaOo8weCKqQQ7kNvwH7hsu5&_nc_oc=AdoyhfUQ0fVfL51yUfyyx68EeWOtkLaTHHpsjkkBuN1prpyqBo9VjF4X0HCIsyC0oWw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XCJXelk9jOKnmmMuCplZczI8iwhhQZjKYpTDKxd5KZw&oe=6A01C27F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
7q04XvrrMi4G8cHQOhUPdINSb_FKi2cPeBidVlyu4qzg6jC7GRQmPf-hNSJ6f8M0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDq9HSrHLMz7psITuSlFPSlLfVd-AXdktInDoy8_sDgQ&oe=6AB139F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OZdfObWMJwQ7kNvwEq3PDE&_nc_oc=AdrSpnU6b1zKBYxIBMU_lEV96_b3Ogntt4hdMRYZ0cCTdWacMyGUBy3noPu5qw06bls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl2gneA0XZMiiScg1OdSxKsBB_E8UqVTbFlaj5zecO6g&oe=6AB141F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-KD8wV4htUQ7kNvwE9R-Ll&_nc_oc=AdpGZUqRXflNDioq7JH-EAmFuQ5yvE7B6zs8_Mnhs9a6XPV6k_PYtveBd5kBFKvXzr0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7n9e2M3EU9O0tQVBrEdMfZMBo4WmknKXK1wxc4ZMDVg&oe=6AB12C2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Trquf-yNoOQQ7kNvwHxo41_&_nc_oc=AdquSF8OMGaJuP7TaiOiIrbz7KrtDEefrUU-LU6gBqRPtVztPruZsjy3FLAr75IhMMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRl6Ul-FdG-9JoSkcCu7vNFklIiWqJuOOPii0x8pGMvg&oe=6AB13B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5UziczsAHEQ7kNvwHuzqI-&_nc_oc=AdpISSDsCaEEjFXrvSoqiN7RI-Ptovm9fKg5XwuaEomqN4jZcMD4M-MH7lbWzCiafxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD3-uFfeeqh-3mB0FjxgQVU0MfXxolWcwgKoeLLoyvig&oe=6AB1523F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
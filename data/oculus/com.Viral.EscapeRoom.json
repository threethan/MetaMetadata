wXRZ1551qzJO_qEvB_D9ETlcOwBMSunUB-S_Ne-1fCq1APmbSdgGFijOHl1HI198&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjj2NigbApApzTjbPucA7jV2W6uy59lzY8Z1iLwnSNlQ&oe=6ACCE974"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1POCdZsevLYQ7kNvwHzfOh9&_nc_oc=AdqoucJMRk9SyYwAh8yBr46Qu7ePiHanl-5E27PTadyewAaek9xf54b40YFzbQEYhSQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuZDwJvCFm-HweMB_J9jDrNctBfnVBIKMEY3MB93LBhw&oe=6ACCF172"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tnic3UrWlNEQ7kNvwExl2PP&_nc_oc=AdrP39ou692TnX6KFwax0xNEORTU6Bg2qD7hN8R8nbX0mAb-zxPd7XjG2wTjzowXUEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYEw56DAOWD3qtEofUPD9f6m_yt8saPrnGm9CPDVgHAg&oe=6ACD13ED"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPhcDW_BI_cQ7kNvwEebLYo&_nc_oc=AdqLGqBCdO-VxC8uAi-WZNMy5anGl2tQUp7jMwA9F9aUGQVPJBlaz0EGA02F_0po8jo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW3W4aeXjitPE7NWynpT8mMuYnZTLcAJJrBjGSilcZ5w&oe=6ACCEA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUjsHmWyVLkQ7kNvwHrWP7h&_nc_oc=AdogBsHmdFxSO-5V9cYdlU_iImih1zBcpo3DwAcTmVyxqZMBWrfufTGHr4Wnezy-aqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAzWzj4GHhOFwFOyunvx8DTxEJtNOXLgH3gzfQRekA3A&oe=6ACD01BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
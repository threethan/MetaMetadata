jWr9-fmaWjlGK5BDCGK9mMJqEm5myHW_U8fFMwNN1HlrD-sueF6LEd1ghws9mo5Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyT4gsa_vASFKdQXjUolhcsi1uahCvOvyOD-EixRx0SQ&oe=6A86D1B4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm7UNedUFt4Q7kNvwHGVO-r&_nc_oc=AdrpJ2D0umf4QH-BwrwvDZ8NeDmjdcrz8bjN5vn3HjpnJn_wP4sikMgETB96EAQJw8Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE61PsZE-3u1V35Rz0u4Xrws3j4OrjkvON-gPdj4Kcj9A&oe=6A86D9B2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4nv8Fk9Uc4Q7kNvwHusI00&_nc_oc=AdpYOKZBqX-fRK2AT58DbVrB1R8U03AwyxOo2pXasgacy9HN0w6bVB34EoVNECzQv44&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ_R1r5-s2GSc-RZNXKMxulN4ZIjUqA8FbAUbhT4g_PQ&oe=6A86FC2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCUh3TuGti4Q7kNvwH9BmgQ&_nc_oc=AdpY41BdrDY7NG49Id6l73n_oD7hDp2vaU9whxOOEcSoU2-iovplPZ8HXeQkdmjAXb0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYe7Lk5VI7iHLlnZV0xU3FY68difcSbmnRVSUMy36nAQ&oe=6A86D2C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWFzo4Z_j9UQ7kNvwE4AFNA&_nc_oc=AdpNRHEQ_Sptbi-LzFT0fbmuHX--7LKxP58Gf3haHkaozdRF6ePfFKE5drbSj2czKjQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqb7E6S5PAAjtT7Qvz8pDLPVt5WCUv8OcmTVhPPfVS2w&oe=6A86E9FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
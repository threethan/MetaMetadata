ZIBkscPhmwxT1e5AsPHieqFhxzzRLMMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwp0LMrWHRQpa72ft-hXGxBLaWLsVER4UhTEOCuFER6HQ&oe=69B80E74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTYWALxSSXwQ7kNvwG5Nxa6&_nc_oc=AdmBUX33Z8EQ3pd7a0AcG-h1gGn0tl09IJ-AxRjDGeooQu2p0mbsMg3KECfuTSdVpO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVweYYzqqsf66YbbBKmM4c8E8Jk5BzL_iOuYEgF_bbLQ&oe=69B81672"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipUBjr00t_EQ7kNvwE_kmM_&_nc_oc=AdnbdlZEjZblupefP8V1WTZtlOs9Dh7Ck6FyUtvLZr6TW8s-u7vppLm7piQ6Jq-Af24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzu3v75eLIpK3LqcwuL_SSfoICoADLXvpNXJltfqdHRKQ&oe=69B800AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o6IzzmsWBAQ7kNvwGlyFT9&_nc_oc=AdlxIxmMZkLFQa5iU6W-np73BNb2edz_yvE1kPttfwNjA-X3Az0rOLtwRapT6yWinjY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfavPHkHRRsUoWxr_f4IplmXVX4SXzvF70ta98mlrCTw&oe=69B80F83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFqGknPAokMQ7kNvwHieXU9&_nc_oc=Adna1Iv-WxieTzDUZTEAcVQwtuhtc9YVj77nf_HR6_pelDo7puzQ4iHe_ePi_-YmiAs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afya-bJ1UjimvCU_CVd8_G2luI_SRfonBIZyOqIYCTDleQ&oe=69B7EE7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "PUZZLE"], "has_i
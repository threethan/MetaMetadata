bJi7cHrYE7Z5XyjGuiyl7dVEhlD6oxdhk-O5RYoGdoAtIvQSQvVgbj2_u-LD4hlE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38dAF0T3BM2eqN65eE7TejQUkP3j8vImbJxQx1CXu68A&oe=69D26C74"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuPnEWj5jqAQ7kNvwG0Ev5U&_nc_oc=AdqX68uP1Hv3ZE5CWoKjCiVqu9SJfnJ0QqLQs05POxj8b8wiWlTXGzTq0aRPF-i-60M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dPWNBTYvF4C9Yaaeg8oTR_IpJ8LiOUg3XXeQZQahhbQ&oe=69D27472"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqGXMBqcDnQQ7kNvwFyWSuV&_nc_oc=AdoaXs8U-75H7OtbHjeD6hybbdMn7PpY2DMch2KqXI-4F1rHFPviZSh6GjgVqhglVrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PQERg7yJNXUbvwQEO6agTKPrDEYJe1uMOEo--Dlwlyw&oe=69D25EAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxJm8T_0bb0Q7kNvwHLZQgs&_nc_oc=Ado91AP7AjQ9H1AIEpBko0eXHRHAdk_zo36I-o0xvwl7Pk4tS-KDoGEOBynH7U18Fag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NgM2IYaX5iMTi7XTUzYWZebIVVDjgQeIVRdn513o0fA&oe=69D26D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csXlF5EADJYQ7kNvwGQW59S&_nc_oc=AdoMU9E19cjw4k5EN14S1Ln-mg7Y3HVw1reYHCkxo0oAaSY8SAqCbsNvvDBAmU7HSHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39_iDlFtsjbf7b7SIvMOdlUjORALubiilAhU6pE0HtKw&oe=69D24C7F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
ttMJ39-_vH5SRUw0D3dOsGahuytPg0uj8KSnUOPmaDX458HW5ugJbhAy6OJo7ic4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3CJD91SDDuX4GBWOej9TdZICdll005blosLvypS3z_w&oe=6A564274"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzABTZuMZyYQ7kNvwEA2hig&_nc_oc=AdqWZ7yGsNrtWzTcjjpnMpO8677QgBF5HrFZk6U3XKIycMZldO1trGscQqvtJqQzw_8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXcqEV1UTD7OQXED4UyDFLP0Fxi_id31uMhCE0vsUCXA&oe=6A564A72"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l76EAJjBD60Q7kNvwH0GqNk&_nc_oc=AdpswXe4u2S1P8Kt4SohKHzQ4iDO3btDiXosG83Sugkmh7ul5iKZX8PmANhvOXjamOY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCfY9xkUVMtVkyIfJeV05OodEimlNAN_mi1FTsqgCwEg&oe=6A5634AD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2G1VVh3H_MQ7kNvwFVo115&_nc_oc=Adoa8QQF2XK6X4LMKJ3wtIYrtoCRokLVKgQc2yssnFNmulN6mpIERO1_SHrM2jFmcAU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkfzcTfhxsAzsDXG91IxWb8odnReA63Cj5sA2TyB1FOw&oe=6A564383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFT9WA90ZFsQ7kNvwFmK6fI&_nc_oc=Adq6WXB9IxV7Upc-JV0HPY4fIgTEbqunKdGaDhJk-n10KyzFOlHVNpOmPUSxhKFXhAw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC58sk_kfWvCYM-wUCEGlrgPJ_uDigWg6-V0av4uBPByA&oe=6A565ABF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
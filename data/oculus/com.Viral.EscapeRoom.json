0gjE3V9iRt6-eghY-mo-D-kMoz-S0ClC1FV00URClkV5qUZNfCo3hHlQjfX2stDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MnpxKRI8ysZkfP6jyUXBk8mLlpTyWdkK7wD4H7BNFeg&oe=69EB78F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VUmWMYMlTQQ7kNvwEnLDmJ&_nc_oc=AdrOpT34lk3rrB5Hi8oSWtNAw64kNnfnVCwzr5ARSORbYivF-fDF2K2902lA7xkntv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eY0J3y6LZBA9OoahQRiJhtOr8t8FZtOlN9eiOrU2WXw&oe=69EB80F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqFlokKSjw8Q7kNvwHZXnXB&_nc_oc=AdpO0xOsLQ0PyANdeEX7ISTrLyrMM7XLY1wCt6zE82r5hsLa2DkXtbHZ9mfopIQyjJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qZ42-HwXLX0Ti-Ks8xK1xpA9GlSEOZWLLYNKWnLq5eA&oe=69EB6B2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_rbXyUo7d8Q7kNvwFcKkQd&_nc_oc=AdpA_bWa5dvudM-oolxF_rpbMZdTIdbQancUDsv4vGd3CHPx6qJ-wfnF1NYCYpEpeIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mJqZfbhFslS9KFlpKS3-EyiQroHMOGhTHK7MXZLibEA&oe=69EB7A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faxJcY4htxcQ7kNvwGFtKLr&_nc_oc=AdrfIeePIEQAUfxCAfioJD5RJj8CC4w1hNMA4GyQRpgr1q9YnHnRMN0B6mIMbxKEwkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ndCsUqVMVW8tLCrBsdLByqU7SJ1vgWImmmAwJnoM-NA&oe=69EB58FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
7-pQ8guJ-yvim5Gu7X3LPHrRSpZnuEDSMfZX5WoMN3IZFD1dDCUfLPDzN9slaZqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gy_g7OPqTXw5LzvLryLhX62RGpw3EUVJeOMZeE_EvDg&oe=6A315874"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q4txhU5gPgQ7kNvwHBvRwA&_nc_oc=AdoUksqcyAgL3SBz_tWPS0y8u7cOV3UduEClsVTJIkBTm9xuby9YmIm3RucQQXZDzjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vaX1T-cPzPoGqN0eaIkQ5SmVnBrqESPQIT7WLt0az5Q&oe=6A316072"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ts8nqwNquqYQ7kNvwHbRX7N&_nc_oc=AdrG4WvZTEDqqfaHixI2uSHJo7PxqmWUMCoAZx4TpL9uQaNpqtYZwmKNNfYBtcxETMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EfAaXYKZP2aq3OVqD7z1Vex8j7kULI70xr05w9wGkFA&oe=6A314AAD"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWOQgB5P1ucQ7kNvwFPDR_f&_nc_oc=AdqsiHX_v1p8nyhO6kUxr-NQvc5Zkl7TI_J62Ha85dyOYwYl6TO4oglVM7RmIrDEFPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nTpJLDXsseUgqR3gT-tnt8pdohzG4Ta2CS_XSpPD7vw&oe=6A315983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-uGC4aOgn8Q7kNvwEmTjby&_nc_oc=AdptYTZDNO_ryY8rJzn--m21vk3z8iqHydzc3kD7K4o56T3ayk6cH10XH4tsTwlPi3M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5Te4_tVXbymWKzTkiSz_YnEaSuvN094UiDTFnip6uGw&oe=6A3170BF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
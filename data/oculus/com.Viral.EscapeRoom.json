cBvP0_87HVUOWXBA2hhWEpboUvoL4QO_d0EDdD_SCr4T20ppitisl55PIgJp5XLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNC96elnKDck-aIJetIxn6vWKIWx42HvmREPMnCrPKHg&oe=69D11AF4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuPnEWj5jqAQ7kNvwFv4MeF&_nc_oc=Adr1jhyJZv2rE5DlHHUScKbRwGf88wDcUHoUhHUXdezOwE5MWo1RlBem5c3FZnVyyS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz07Ii1Yl4gcELgZ878Qxd3oZlnVcrzHnjsujAFiLgv9g&oe=69D122F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqGXMBqcDnQQ7kNvwEunDRO&_nc_oc=AdrN-l917FZ9txhKbU9u_vJ3NTS-4gNhtdk1sQ25NNTIg91b31yQyI52hU10nIW1WLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAYwWX-QUHoCu89RjT2B_TCEwQDYtYPW6obm6A_b55XA&oe=69D10D2D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxJm8T_0bb0Q7kNvwHU3dWt&_nc_oc=Adp3mF907XTgvSDSNryHi8CV_0e3k_giwWPR29pCLnEbGTeCNSgh4rP9epJXVoFo1GQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdiFCi3iTBiU0bNTG4kzsrLfNdLoN56_9v1N2JOSPUOQ&oe=69D11C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csXlF5EADJYQ7kNvwFWw7j5&_nc_oc=Ado6NYzi5WkShsv1qH24gsdCZfBNv8xHYarGrNce3tb-sJ1Yf7jSljXOZA4NO7IuftI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMjxsn0OyopvBOMpmjRNntDPFlEC8ACi_fxI9VwcAsOQ&oe=69D0FAFF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
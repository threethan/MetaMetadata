44GGZYOOsb2AcwaN1M1dHS7_ri83cnB27J3AaZ1vw1PvlDE8mG7usXdyrHW3jMTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt2Vft-aerKGOQ5ocE8bs1cSuoOhXuY5atSa7vAZvufw&oe=6A5A36F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUA-ogoAieoQ7kNvwGtZv2b&_nc_oc=AdquM3R4wZdB68JlfS5fF5O904bI89tudY2fyrfwmqb6dFIfO2K8a4DY3uiXiRStPck&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMPqD6TNrjHc-bYA_5Y9FFnTe4l6krgn8MEXSJdXIyAA&oe=6A5A3EF2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ISfnUPhwMkQ7kNvwGAqzkD&_nc_oc=AdoTtWrjxfVO4YrKLRYFcmR1vBREHiHR-VRTf5-7_2WET8gkLHdfTLa7fZc6ToPQba8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3pg1MGNO5Ilpgs4qAKjcIPU8ddZxqQO_FYV7HYQ62ww&oe=6A5A292D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrhWHgQKK_wQ7kNvwES2Ug7&_nc_oc=Adqri3xDxR5HI75Te0OpY7aiTEqn7beHonuIMUzE3V6eUm7VBVwgWRzeIegCXDVFIX4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8hoG7h9W-0pIYubsJMXML0uWVoYpv8xHjmfS83PCytw&oe=6A5A3803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfg51Wb6kLQQ7kNvwEbGoWr&_nc_oc=Adq73EPzS0lnkrxCbN93Qe4fGgG3qADXgHpRzZ_C_VplxGbAiNr2Vi3hQhqYwuLkDp4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7kMaS8DmEaSJQ0yYXBlrBRONcN1OhUahWRTWvAV1Vag&oe=6A5A16FF"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
avi4ebJbn5JGux0VHtoXjN08oDcFAdVW0y5ZPaJ5sXi9iISb7PLKfNWmLRsuE78c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EkzYl1UUgAH9u2lhQSW03rBXjyI5TXb4p91g-1B1Trg&oe=6A2AC0F4"}, {"file_name": "migrated_image.png", "id": "886977898440308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1177368252354610_3196528379255848960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou0PLuWkHxgQ7kNvwGqQ4zS&_nc_oc=AdqXs64EF5tI7fChu7wuaAaLRYlQpM1fcGwJ49IHWOvrgxhOyOoJzrB2ny2IMCOz_gA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1JDtqo7RnRQmVld8UIWjc2kbSF72Hi-BqjXOcC33M3w&oe=6A2AC8F2"}, {"file_name": "migrated_image.png", "id": "161681921555626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139483_1002375083174432_993566500_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4u8NGLRqpcQ7kNvwEQ_VM3&_nc_oc=AdoyfKrsoikMQT6UsAJJMoruJAZawJC82PZqifQU81peLdsXCUx323l-Bb3w33C3bTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OcJvdjyMM_ScWR3HGFJtptra0Q_SNho9A3GftgoAQEQ&oe=6A2AB32D"}, {"file_name": "migrated_image.png", "id": "192935268673230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449015_1539227286381422_2089509622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEufqc_EwYEQ7kNvwFNbEbY&_nc_oc=Adp4JRR9CO2qHeeOukmDxi-17seoA7dqN6-RvIrkPaq-kiz5lWAQLWq_K4ClYD2_r48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0CgDykv-BtGMByCqD439dOhJF8KNWQlFwdSdDxwlgrA&oe=6A2AC203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "escaperoomvr_2_2560x1440.png", "id": "1445401442244390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386304_1445401445577723_4444863205113593856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz-ufkqwyCMQ7kNvwHCVhzU&_nc_oc=AdqZwCQs7KP07i2vCYY3kQPxnp6LJVhj0B434WgSMjgRPjZlf3NpcmKp9WSX1ohWXPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tr1Mu2GI-zWk8iumL84hiSIJyZa0L4wlSGp0fWQbtyA&oe=6A2AD93F"}, "display_name": "Escape Room VR", "keywords": ["Escape", "Room", "Riddle", "Puzzle", "adventure"], "long_description": "We are happy to announce that four rooms are now available! You can purchase the newest story for 1,99$. \n\nTry your mental strength in four different predicaments. In the beginning, you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. We all remember those special parties after which you wake up with only a couple questions in your mind. Where am I? How did I get here? This ultimate challenge adds one more to the collection... How do I get out? You can look for answers to those in \"Knowledge & Order\".\n\nAnd now we're adding an extra challenge, a fourth story! As a disrespectful customer, you're being punished by the store employees who left you alone in the closed shop. You have 15 minutes before the alarm goes off and you get in more trouble... Test your wits in \"Salesclerk Revenge\"!\n\nGood luck!", "short_description": "Four rooms are now available! You can now try your mental strength in four different predicaments. In the beginning you have \"Crazy Kidnapper\" where you woke up in a closed room with no memories of how you got there. Then \"Dirty Money\" challenged your quick thinking in order to avoid getting caught by the police. Next there is the party hangover in \"Knowledge & Order\" and finally the newest story in which you find yourself abandoned in the closed store."}]}, "developer_name": null, "developer_privacy_policy_url": "http://escroomvr.com/privacy/", "developer_terms_of_service_url": "http://escroomvr.com/privacy/", "publisher_name": "EvilPort", "support_website_url": null, "website_url": "http://www.escroomvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type
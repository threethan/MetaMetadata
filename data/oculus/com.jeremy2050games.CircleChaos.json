C"}, {"file_name": "Game_Custom..._21.12.2025_22-58-13.png", "id": "1177921561201058", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618093_1177921564534391_7656707429818812415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80rVFd6O7OoQ7kNvwFIwYq6&_nc_oc=AdqPlxaLa1QGmJpDibenCRlDGn6RHfmPfMcqdXUnnchDYYsy86-LiY0U_Pof4mm3h9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lMIcldDUdg5qcUYQrY3cxfvrK4Ha3qHR2wjO6s0Ch5Q&oe=6A087470"}, {"file_name": "Game_Custom..._21.12.2025_22-58-24.png", "id": "755530904223008", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617762_755530910889674_5091547059136661901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjqCUB0I-vQQ7kNvwGWTntp&_nc_oc=Ado5pQe-JzGPJRaZruomzP4I7mjuajzOXWJC_P1HOt9bZT6sunrzxvSWStpyDxbJB-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af775_TNlyz962P7oaF3YCkpH-WCjmZIcXMXjH-7MeqQ2A&oe=6A087440"}, {"file_name": "Game_1440p_29.12.2025_18-30-22.png", "id": "1580580989621334", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619485_1580580992954667_305600405907420549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SayrE2Unb00Q7kNvwEtRCY7&_nc_oc=AdpIt4addEKD4QCvoD3RLS4DW6xqW5XoWNgdzMeI2iyQJsgHFwhIfHBEzGuLspxJ6nI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IHWeWJ9vHB-vgprW2g6G8Q50qbrJv00aCqipYYq95eA&oe=6A088A29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circle Chaos", "keywords": ["horror", "fun", "gorilla", "circle", "fangame"], "long_description": "circle chaos is a fast-paced vr party game inspired by cube runners, built with gtag-style locomotion for full arm-swing chaos.\n\njump, climb, launch yourself, and survive through a bunch of different game modes that all play totally differently. whether you\u2019re messing around with friends or trying to lock in and win, it\u2019s pure movement-based mayhem.\n\ngamemodes: \n- horror \u2013 not super scary, but huge, fun, and tense in all the right ways\n- hangout \u2013 chill on 3 small islands, perfect for messing around and talking\n- maze \u2013 get lost, split up, or race to the end\n- robbery \u2013 currently broken, coming soon ;-;\n- speeding wall \u2013 react fast or get wiped\n- glass bridge \u2013 trust your instincts\u2026 or fall\n\nfeatures:\n- gtag-style locomotion\n- multiplayer chaos with friends\n- inspired by cube runners\n- fast, replayable game modes\n- simple to learn, hard to master\n\nif you like movement-based vr games, chaotic multiplayer, and clutch moments, circle chaos delivers.\n\nrun fast.\ntrust no floor.\nembrace the chaos B)", "short_description": "circle chaos is a fast-paced vr game inspired by cube runners, built with gtag-style locomotion.\n\nswing, climb, jump, and launch yourself through multiple chaotic gamemodes with friends or solo.\n\ngamemodes:\n- horror (fun, big, not too scary)\n- hangout (3 small islands)\n- maze\n- robbery (broken for now)\n- speeding wall\n- glass bridge\n\npure movement, pure chaos B)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/circlechaosvr/home", "developer_terms_of_service_url": null, "publisher_name": "jeremy2050games", "support_website_url": null, "website_url": "https://sites.google.com/view/circlechaosvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tr
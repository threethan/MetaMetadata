_708566238764240_2066311934945181017_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzTPk_h9hsIQ7kNvwHf9sOz&_nc_oc=Adq1exyoUXTP_9c8eIZ8MbkJO0q-nLQAH1Sfld0zvaUUw-TbQT9OUk2wHll9JlxcqAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGTdsxKWvPt4wspA3ggu_885vn_iOovW6OC5U3_kwtXg&oe=6B005B2C"}, {"file_name": "Game_Custom..._21.12.2025_22-58-13.png", "id": "1177921561201058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1177921564534391_7656707429818812415_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b17KbWrYYdAQ7kNvwFqGL5S&_nc_oc=Adpbq3MorPhP6DJ3vpWd4FbpEimbTuM4Kd-WKa1xwAHVbzgyg8KtPfb8nXQFi_PmlC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpgz22LwtlbBW2_hqML09LyE-4BbGDpTw0WLOWaC-mSQ&oe=6B0086B0"}, {"file_name": "Game_Custom..._21.12.2025_22-58-24.png", "id": "755530904223008", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617762_755530910889674_5091547059136661901_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UghhEGBtTRQQ7kNvwFdE-Vq&_nc_oc=AdoOh9QZisNqRaw0_0nY47qbZiwiLuyHPVdxijBF2CEM8DRxxQCojt75MtJvcVWq9ZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS89Dpc5B-_49k5XWNi_w3V6cdh0N-2MaBUd6Tov-kY2Q&oe=6B008680"}, {"file_name": "Game_1440p_29.12.2025_18-30-22.png", "id": "1580580989621334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619485_1580580992954667_305600405907420549_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDlhcBL6Si0Q7kNvwG_gfYk&_nc_oc=Adpyr_132taBA_hz2dr2whmMF9DuVlZY6-jqjPvGhULlnwxSCHvvHgGGtX7dh3xYUjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHhjm6ie7BIFpqu6XuMEz7C0sEZMmrE4NQ1s0-Y7Lrow&oe=6B006429"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circle Chaos", "keywords": ["horror", "fun", "gorilla", "circle", "fangame"], "long_description": "circle chaos is a fast-paced vr party game inspired by cube runners, built with gtag-style locomotion for full arm-swing chaos.\n\njump, climb, launch yourself, and survive through a bunch of different game modes that all play totally differently. whether you\u2019re messing around with friends or trying to lock in and win, it\u2019s pure movement-based mayhem.\n\ngamemodes: \n- horror \u2013 not super scary, but huge, fun, and tense in all the right ways\n- hangout \u2013 chill on 3 small islands, perfect for messing around and talking\n- maze \u2013 get lost, split up, or race to the end\n- robbery \u2013 currently broken, coming soon ;-;\n- speeding wall \u2013 react fast or get wiped\n- glass bridge \u2013 trust your instincts\u2026 or fall\n\nfeatures:\n- gtag-style locomotion\n- multiplayer chaos with friends\n- inspired by cube runners\n- fast, replayable game modes\n- simple to learn, hard to master\n\nif you like movement-based vr games, chaotic multiplayer, and clutch moments, circle chaos delivers.\n\nrun fast.\ntrust no floor.\nembrace the chaos B)", "short_description": "circle chaos is a fast-paced vr game inspired by cube runners, built with gtag-style locomotion.\n\nswing, climb, jump, and launch yourself through multiple chaotic gamemodes with friends or solo.\n\ngamemodes:\n- horror (fun, big, not too scary)\n- hangout (3 small islands)\n- maze\n- robbery (broken for now)\n- speeding wall\n- glass bridge\n\npure movement, pure chaos B)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/circlechaosvr/home", "developer_terms_of_service_url": null, "publisher_name": "jeremy2050games", "support_website_url": null, "website_url": "https://sites.google.com/view/circlechaosvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1700921480735423"}, {"i
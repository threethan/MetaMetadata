hc=eRAxnVUo0V0Q7kNvwFvVhpE&_nc_oc=Adq5ltOfrvT5LtfE-ZYNmKYabZAH6iXAoKnrIyccyQH8iOwPz20v86giAPtSrrUer3Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBJr9OwA6UWWueXkIzBYef0ow-72FrvHIqiN-qxDiQfw&oe=6AFF1B14"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-3.png", "id": "2292782377859066", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827799_2292782381192399_1340486148683666533_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUTNJGjlUPIQ7kNvwGRNLux&_nc_oc=AdqmX8RQ7tgtjpYeBfC9U7MhqZabQx9MSMK2k-DCAY20IHWYonWRX7_SlHYm_9RT0jQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFOdYusaJjvGEAd-_yoFg2-VWq6qEWAizoU7pXbDqKvA&oe=6AFF1C61"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-1.png", "id": "1316023630187577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623555_1316023633520910_969384270837556882_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJzEoevxLqcQ7kNvwFMA56j&_nc_oc=AdpCEgDcEXoHKJ5HD7ULop05jWzBu_p_Evr65cBwzyyQ5-D2Gab27miiIF7N5-wFm0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnI6mRPYrd_2OD19KNneiKPzdm4p1aFby5I-zWgx1kAQ&oe=6AFF0DC9"}, {"file_name": "Screenshot_2560x1440_04.png", "id": "24601797839508616", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303903_24601797849508615_5317927419449763142_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA-SEolV6vAQ7kNvwEeLjQP&_nc_oc=AdpnP6E_5AJnZTKNIqeknVQfWO0yna-QgaEeC39OenU7ziQ8uG_ZAQLFhag48lvH7x8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWZ3ChqbVMMQ1Xu19QaUENSn1MrDZGl_OJ_PQBA9MbKg&oe=6AFF06FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BC-TGT-VR-Assets-Trailer-Cover-Image.png", "id": "1948389922405269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_1948389929071935_2806373752474007181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS3rxoTuCeMQ7kNvwG5xT4L&_nc_oc=AdoPCUZlNRPgiVI1Px-kmflU3tg3nZC1CWfHvHvFn73bWLqezTH-1dv24oZVDG3zcJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSnvvEfz85FUKwWtlJMdIukx2m1bqxY52f2XBh0pjNKw&oe=6AFF155B"}, "display_name": "The Golden Thread", "keywords": ["Meditation", "Spiritual", "Mindfulness", "Musical"], "long_description": "The Golden Thread is an immersive VR musical experience that invites participants on a poetic and contemplative journey of self-discovery, inner alignment, and cosmic connection. Set to the high-frequency harmonies of Beautiful Chorus, the experience unfolds across ethereal landscapes \u2013 gardens, starscapes, and celestial cloud realms \u2013 each reflecting a different stage of transformation and awareness.\n\nGuided by luminous beings of light and elemental energy, participants follow a metaphysical golden thread \u2013 a symbol of intuition and inner guidance \u2013 through three phases: connection to nature, expansion into limitless potential, and arrival into a space of safety, love, and belonging. Each movement is inspired by a song and theme: Dear Moon (energy), Star (possibility), and Goodnight Moonchild (protection).\n\nDesigned as a meditative and emotional journey rather than a traditional narrative, It offers a soulful portal for viewers to reconnect with their essence and feel held within the greater fabric of existence.\n", "short_description": "An immersive VR musical journey with Beautiful Chorus. Travel through realms of light, nature, and cosmos to awaken presence, intuition, and belonging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iwanttoexperience.com/privacy", "developer_terms_of_service_url": "https://iwanttoexperience.com/terms", "publisher_name": "https://iwanttoexperience.com/", "support_website_url": null, "website_url": "https://www.beautifulchorus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922
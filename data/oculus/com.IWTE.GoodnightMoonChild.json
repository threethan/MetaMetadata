hc=IlhTLhb6Z10Q7kNvwHF_P-Y&_nc_oc=Adqvv0HoFXKxwEZFhj_gRVMD0GPqs465QK8IECTptzJVFdzMKdJpt-AHxnVdfwqC-OU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr4ewGrYF5vmbkaOsX-98iyF9VaVQnL3iW72UMJlMTlg&oe=6B085594"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-3.png", "id": "2292782377859066", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827799_2292782381192399_1340486148683666533_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoNOEIP8T7gQ7kNvwGOje7w&_nc_oc=AdoJAdtOSgwBDdwtHgSVuuG1K_vgRo_J0ab7hjs-IW8kemCp3iODKHVO8CxuYmhilfk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuevrEspcNA-bbZEqVRl2ENRqqCbIW9k5qQV28VH5eDQ&oe=6B0856E1"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-1.png", "id": "1316023630187577", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623555_1316023633520910_969384270837556882_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSdZVsw4xC4Q7kNvwFWclQ0&_nc_oc=AdpTu9nwQakFs4wCZ8Wd9H8StXPK4ikDP_Dqe6b79bDODXmv2WYfb0WlybvBXN7zROI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxmrq1i8GYc7MyNnmo855RPvwWWA8MmhPUg48oe3gnzw&oe=6B084849"}, {"file_name": "Screenshot_2560x1440_04.png", "id": "24601797839508616", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303903_24601797849508615_5317927419449763142_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHduimdDB0kQ7kNvwEpizow&_nc_oc=AdoPWzxvyz-LKN2SIZ07Rp1032_2CUEa2KE7MqZRT86mKToGZwDw3GZ0Wu2QXUC9kSA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDx1ZMKl8Wv-R9cGYNByjdj3j0MSJ9lHke5s_5DlICJQ&oe=6B08417A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BC-TGT-VR-Assets-Trailer-Cover-Image.png", "id": "1948389922405269", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618251_1948389929071935_2806373752474007181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DHjUZJTEroQ7kNvwE_yBCr&_nc_oc=AdpFenyxwxqR4svew0sKNcXfYppbjgFOJS6TRTtc1r6y7JDzSsGiEg5UATcMN1SwCBA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkhMd19fxHrbkWCEWi1jVF4SqhKky_9-b8iwAGm3WRSg&oe=6B084FDB"}, "display_name": "The Golden Thread", "keywords": ["Meditation", "Spiritual", "Mindfulness", "Musical"], "long_description": "The Golden Thread is an immersive VR musical experience that invites participants on a poetic and contemplative journey of self-discovery, inner alignment, and cosmic connection. Set to the high-frequency harmonies of Beautiful Chorus, the experience unfolds across ethereal landscapes \u2013 gardens, starscapes, and celestial cloud realms \u2013 each reflecting a different stage of transformation and awareness.\n\nGuided by luminous beings of light and elemental energy, participants follow a metaphysical golden thread \u2013 a symbol of intuition and inner guidance \u2013 through three phases: connection to nature, expansion into limitless potential, and arrival into a space of safety, love, and belonging. Each movement is inspired by a song and theme: Dear Moon (energy), Star (possibility), and Goodnight Moonchild (protection).\n\nDesigned as a meditative and emotional journey rather than a traditional narrative, It offers a soulful portal for viewers to reconnect with their essence and feel held within the greater fabric of existence.\n", "short_description": "An immersive VR musical journey with Beautiful Chorus. Travel through realms of light, nature, and cosmos to awaken presence, intuition, and belonging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iwanttoexperience.com/privacy", "developer_terms_of_service_url": "https://iwanttoexperience.com/terms", "publisher_name": "https://iwanttoexperience.com/", "support_website_url": null, "website_url": "https://www.beautifulchorus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922
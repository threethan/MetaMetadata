hc=q8vmEiSeza0Q7kNvwGG81OF&_nc_oc=AdqwBAAh5kolwp_T89uDtunjY6FO1zOduzzvD2qrwI09OdxMSll57ow18M1tNFXI_YI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDJs-khtklQPeaje6WbLK2C7WRP-pvjPbUDrM992EWSQ&oe=6B103E94"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-3.png", "id": "2292782377859066", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827799_2292782381192399_1340486148683666533_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQirmEwBwbMQ7kNvwFAZ0zU&_nc_oc=AdrOa6w1nqsLSc9LFiwg2oweaQdrAIcqNBBn5Up3yLI55bkH2r6JrN06FGatsCHMM4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEmOSyTms9oKPAp2LhHTXMc2RsQE-1QPZ2YdrzCHku1Q&oe=6B103FE1"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-1.png", "id": "1316023630187577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623555_1316023633520910_969384270837556882_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvcGwU7_r2MQ7kNvwEhut9q&_nc_oc=Adr3NaspA8FyQ1WDGu3gtagQEodhh6n9OMWKOB96gHdwK8g9wt0tNF5GR7IlEfmQmog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5x_j2wNR7e-ReRxgnpyrOF8fP6RdcpcDdbuL-tDsJiw&oe=6B106989"}, {"file_name": "Screenshot_2560x1440_04.png", "id": "24601797839508616", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303903_24601797849508615_5317927419449763142_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdWDKp2xN8YQ7kNvwHAX3Ku&_nc_oc=AdpSY_4G1sK9FkHrIHR3GAhU357K-XOD087cc3WBuylHBrvXA3muLu9v-Qi0-L-IRDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfealSIZqVobfxBJOn-vm4bMhIXBANsrH84RghDct36Q&oe=6B1062BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BC-TGT-VR-Assets-Trailer-Cover-Image.png", "id": "1948389922405269", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_1948389929071935_2806373752474007181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3w01-qhd3QQ7kNvwEWcsQi&_nc_oc=AdoRpwX_CgHUl65THg_mbEtoGrZCrAm4waLMbHMri07QxucflZprqEu39v75FtsgPB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWT3xNmnN3vIY3RmVpC-SH3Uyo7Gm3ApJmijLi6Zj3AkA&oe=6B1038DB"}, "display_name": "The Golden Thread", "keywords": ["Meditation", "Spiritual", "Mindfulness", "Musical"], "long_description": "The Golden Thread is an immersive VR musical experience that invites participants on a poetic and contemplative journey of self-discovery, inner alignment, and cosmic connection. Set to the high-frequency harmonies of Beautiful Chorus, the experience unfolds across ethereal landscapes \u2013 gardens, starscapes, and celestial cloud realms \u2013 each reflecting a different stage of transformation and awareness.\n\nGuided by luminous beings of light and elemental energy, participants follow a metaphysical golden thread \u2013 a symbol of intuition and inner guidance \u2013 through three phases: connection to nature, expansion into limitless potential, and arrival into a space of safety, love, and belonging. Each movement is inspired by a song and theme: Dear Moon (energy), Star (possibility), and Goodnight Moonchild (protection).\n\nDesigned as a meditative and emotional journey rather than a traditional narrative, It offers a soulful portal for viewers to reconnect with their essence and feel held within the greater fabric of existence.\n", "short_description": "An immersive VR musical journey with Beautiful Chorus. Travel through realms of light, nature, and cosmos to awaken presence, intuition, and belonging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iwanttoexperience.com/privacy", "developer_terms_of_service_url": "https://iwanttoexperience.com/terms", "publisher_name": "https://iwanttoexperience.com/", "support_website_url": null, "website_url": "https://www.beautifulchorus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922
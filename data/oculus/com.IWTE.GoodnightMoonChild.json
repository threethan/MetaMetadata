hc=k9q81vLVDrAQ7kNvwFFCkWX&_nc_oc=AdqaTTvWjHZHTCPdDKwPXlHmmfu9h_oCKB19LvE1Gf09qMuhCnfiPBkVm2eHlbHLN3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTixFYgwP-x3sm6jM4VuJwsDwayA0wkP61HI5rZhYvXXg&oe=6B046114"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-3.png", "id": "2292782377859066", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827799_2292782381192399_1340486148683666533_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pYJAnVatp8Q7kNvwFz2KZ7&_nc_oc=AdrG5ZRPcEfUjRWpZ9OFrjIgUxSeUkfIlQdYmc1HPgPCOt-e6DkglmG4KlXL1iLN_2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxvmIWU2U8W4Y0wL0auDmBiiU6zcrelE1HrYdUl6ymmA&oe=6B046261"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-1.png", "id": "1316023630187577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623555_1316023633520910_969384270837556882_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQaNRQot6OEQ7kNvwFJXwCF&_nc_oc=Adp7uhLYOW84xBuPJwvEBQFz0aMCGkZKobgxARup_Vr7Qln3bH9DTaJmk6F3r2ZH_V4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCefbRJKrslJSuKYhIU3bxiUqnGnhZRkMHOWJjSLelcw&oe=6B0453C9"}, {"file_name": "Screenshot_2560x1440_04.png", "id": "24601797839508616", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303903_24601797849508615_5317927419449763142_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxiIDkRVEt8Q7kNvwHkdn3o&_nc_oc=AdrhLFi_OT4YlvytZJ2rmelXyNQ7XaiBi_2jA8SLyCBOIvyAk5asemogYNy3Zo0mxMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0DUfDh8_RziJAvcnMo3p3Pus9XXoL4ZdDVYSmQZ2htg&oe=6B04853A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BC-TGT-VR-Assets-Trailer-Cover-Image.png", "id": "1948389922405269", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_1948389929071935_2806373752474007181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ_F9UFh6osQ7kNvwFb2j9E&_nc_oc=AdrdWk326JEOfsHV8lDaI3a58w9Xs13dUcjMOqB3o1ffCEjdt0cq1Lc2KvLlylNfPzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-h0iY2CccfgD9ab3-wERkc8iYdlmODe9QNEh9Xpg3DQ&oe=6B045B5B"}, "display_name": "The Golden Thread", "keywords": ["Meditation", "Spiritual", "Mindfulness", "Musical"], "long_description": "The Golden Thread is an immersive VR musical experience that invites participants on a poetic and contemplative journey of self-discovery, inner alignment, and cosmic connection. Set to the high-frequency harmonies of Beautiful Chorus, the experience unfolds across ethereal landscapes \u2013 gardens, starscapes, and celestial cloud realms \u2013 each reflecting a different stage of transformation and awareness.\n\nGuided by luminous beings of light and elemental energy, participants follow a metaphysical golden thread \u2013 a symbol of intuition and inner guidance \u2013 through three phases: connection to nature, expansion into limitless potential, and arrival into a space of safety, love, and belonging. Each movement is inspired by a song and theme: Dear Moon (energy), Star (possibility), and Goodnight Moonchild (protection).\n\nDesigned as a meditative and emotional journey rather than a traditional narrative, It offers a soulful portal for viewers to reconnect with their essence and feel held within the greater fabric of existence.\n", "short_description": "An immersive VR musical journey with Beautiful Chorus. Travel through realms of light, nature, and cosmos to awaken presence, intuition, and belonging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iwanttoexperience.com/privacy", "developer_terms_of_service_url": "https://iwanttoexperience.com/terms", "publisher_name": "https://iwanttoexperience.com/", "support_website_url": null, "website_url": "https://www.beautifulchorus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922
hc=q8vmEiSeza0Q7kNvwG23oi7&_nc_oc=AdohfJxH3_m1N4y8tPCveRJJCgxe3fJRpmm5rhPBwWi26iZu9leUaq-lsAwqAqJyLLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDAMtF0M6VmDK1GNKaJEnL4nrrtUVrrvTfGx9ISXqJ4w&oe=6B0EED14"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-3.png", "id": "2292782377859066", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827799_2292782381192399_1340486148683666533_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQirmEwBwbMQ7kNvwFNGwiV&_nc_oc=AdrkMT5jkomDovnKYpyNkCtukEsTeUZnjEKaUG3ID_gX4zRaDja0r_svqupyj7pl59Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW60jQXHiKDHqJd4gaDQx7pWIlsMTk-sIyRGEJD_JlqkQ&oe=6B0EEE61"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-1.png", "id": "1316023630187577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623555_1316023633520910_969384270837556882_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvcGwU7_r2MQ7kNvwFgGHzF&_nc_oc=AdpQ8zacSlwoFJKKKIR31fJ-k5G0r79vbtFXru-5pyu35H4CzRQDhGJ4qidbECcWh7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxcxbKa8-DIOg_0HnG1aqWuIG3hT4SinAN9DB2GSZ9cg&oe=6B0F1809"}, {"file_name": "Screenshot_2560x1440_04.png", "id": "24601797839508616", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303903_24601797849508615_5317927419449763142_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeQJY-SYLT4Q7kNvwFq_CHs&_nc_oc=Adr-zj16cfyY9jGyuEP7E8IlYT6zcHaOsBrHAqMrIq0TIeTcVtwVEPFdd9US1xKxr5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUTkHp5SU7VEqbNrPQLhNjeI46dFiU5YDT7gC6okluUmg&oe=6B0F113A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BC-TGT-VR-Assets-Trailer-Cover-Image.png", "id": "1948389922405269", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_1948389929071935_2806373752474007181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3w01-qhd3QQ7kNvwGaIMWw&_nc_oc=AdriQ69dI6nPYRLekdnyODrLW-MU2QshFFYi-kC_almsKMOT2wFAL_rm6xA42DT5ZuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWc3YX-ysfqH56mD_rSpLUQTY3GxILkTWzhrZzykkDDag&oe=6B0F1F9B"}, "display_name": "The Golden Thread", "keywords": ["Meditation", "Spiritual", "Mindfulness", "Musical"], "long_description": "The Golden Thread is an immersive VR musical experience that invites participants on a poetic and contemplative journey of self-discovery, inner alignment, and cosmic connection. Set to the high-frequency harmonies of Beautiful Chorus, the experience unfolds across ethereal landscapes \u2013 gardens, starscapes, and celestial cloud realms \u2013 each reflecting a different stage of transformation and awareness.\n\nGuided by luminous beings of light and elemental energy, participants follow a metaphysical golden thread \u2013 a symbol of intuition and inner guidance \u2013 through three phases: connection to nature, expansion into limitless potential, and arrival into a space of safety, love, and belonging. Each movement is inspired by a song and theme: Dear Moon (energy), Star (possibility), and Goodnight Moonchild (protection).\n\nDesigned as a meditative and emotional journey rather than a traditional narrative, It offers a soulful portal for viewers to reconnect with their essence and feel held within the greater fabric of existence.\n", "short_description": "An immersive VR musical journey with Beautiful Chorus. Travel through realms of light, nature, and cosmos to awaken presence, intuition, and belonging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iwanttoexperience.com/privacy", "developer_terms_of_service_url": "https://iwanttoexperience.com/terms", "publisher_name": "https://iwanttoexperience.com/", "support_website_url": null, "website_url": "https://www.beautifulchorus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922
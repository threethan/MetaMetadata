nshot-1.png", "id": "1316023630187577", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499623555_1316023633520910_969384270837556882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErHfMHzCC2IQ7kNvwHHi2b-&_nc_oc=AdrTKqUSeUVAZYkT1jBTOZlPQNR3EpkFPX3XyQoHs9In3UCXb-8zJSoLAdBubv5s8bU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vGgj2M5L3dmI4XCzMZEz2F6wZJz_t8ZsowLCKo9hIvw&oe=6A467BC9"}, {"file_name": "Screenshot_2560x1440_04.png", "id": "24601797839508616", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499303903_24601797849508615_5317927419449763142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npB_DOqO9HEQ7kNvwEws9Rn&_nc_oc=Ado5J-BnrdZnNe6XFQQY9dinBrNx7b-pHDRXjHSLoWjqep6rdby6XTlnN4iSg-p4Mkg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MkWz3XrsDMU488VVw6rsfRezrMfKmdJ5JrfQICRtQeA&oe=6A4674FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BC-TGT-VR-Assets-Trailer-Cover-Image.png", "id": "1948389922405269", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499618251_1948389929071935_2806373752474007181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32Lp-cAiOMsQ7kNvwHWRBxr&_nc_oc=AdoK7KxMwao0RtFa3FI7Z_Ekj6Y6VRHwOC4efDSDjO52-0KJ9SZE0FtgqqXj3DYx6G8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o1flnDofJ1O5E3zP3lAMlCTDZaM7LXhkA3WAqnd2CAg&oe=6A46835B"}, "display_name": "The Golden Thread", "keywords": ["Meditation", "Spiritual", "Mindfulness", "Musical"], "long_description": "The Golden Thread is an immersive VR musical experience that invites participants on a poetic and contemplative journey of self-discovery, inner alignment, and cosmic connection. Set to the high-frequency harmonies of Beautiful Chorus, the experience unfolds across ethereal landscapes \u2013 gardens, starscapes, and celestial cloud realms \u2013 each reflecting a different stage of transformation and awareness.\n\nGuided by luminous beings of light and elemental energy, participants follow a metaphysical golden thread \u2013 a symbol of intuition and inner guidance \u2013 through three phases: connection to nature, expansion into limitless potential, and arrival into a space of safety, love, and belonging. Each movement is inspired by a song and theme: Dear Moon (energy), Star (possibility), and Goodnight Moonchild (protection).\n\nDesigned as a meditative and emotional journey rather than a traditional narrative, It offers a soulful portal for viewers to reconnect with their essence and feel held within the greater fabric of existence.\n", "short_description": "An immersive VR musical journey with Beautiful Chorus. Travel through realms of light, nature, and cosmos to awaken presence, intuition, and belonging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iwanttoexperience.com/privacy", "developer_terms_of_service_url": "https://iwanttoexperience.com/terms", "publisher_name": "https://iwanttoexperience.com/", "support_website_url": null, "website_url": "https://www.beautifulchorus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "263611965849093"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "906085362035418"}]}, "baseline_offer": {"id": "906085362035418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771883220, "status": "PUBLISHED", "id": "9060853
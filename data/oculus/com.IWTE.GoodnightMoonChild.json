.png", "id": "2292782377859066", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827799_2292782381192399_1340486148683666533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM5zco6tJkoQ7kNvwFh2TBS&_nc_oc=AdqSpAKDt-StoPZX4ECLBRMMrCMqY5eDZy4ag1Xxiy1eM01dC9Mg4zfEv1fLQV504Sc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3u0aF1VkzTC1gfjFo1Ok6oU0DgHb8yFXgNyeKmxuY2oA&oe=69F1F221"}, {"file_name": "BC-TGT-VR-Assets-Screenshot-1.png", "id": "1316023630187577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623555_1316023633520910_969384270837556882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFndDhwQkukQ7kNvwFm5cbm&_nc_oc=AdoabMwks4IvKV4SfU8g664gSltABXAfSUR6FCdz9kQNkT8kMvKaPhC52-qERnQ2lhA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kvye0xNHR-h5rNEJduagmkzc4gcmGXLJJtjnPXBPTRw&oe=69F21BC9"}, {"file_name": "Screenshot_2560x1440_04.png", "id": "24601797839508616", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303903_24601797849508615_5317927419449763142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9u0bszhCgAQ7kNvwFB1Lfi&_nc_oc=Ado5BM70b4D3OZGGwNlJLRAp9SG8mGQYWuasg3nt0ws_tDc-AHoyWEvaqd-SMpO8dAc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2isPk30Y8aoe2O5g3X0ljbNytgk3Nc-dDEGUpGyA9Slw&oe=69F214FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BC-TGT-VR-Assets-Trailer-Cover-Image.png", "id": "1948389922405269", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_1948389929071935_2806373752474007181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0XeZBBg2vMQ7kNvwFIGh0B&_nc_oc=AdoqWSVVZwCSVgT4mc4uKrH0VzDT4OeaIis4HOt4xhNqTJVHtp0h_PBpUqdR7qFD69Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sjf8nGoq4GwmgjZntqJxaYfvkCOYg1mPzpX_lLitGuw&oe=69F1EB1B"}, "display_name": "The Golden Thread", "keywords": ["Meditation", "Spiritual", "Mindfulness", "Musical"], "long_description": "The Golden Thread is an immersive VR musical experience that invites participants on a poetic and contemplative journey of self-discovery, inner alignment, and cosmic connection. Set to the high-frequency harmonies of Beautiful Chorus, the experience unfolds across ethereal landscapes \u2013 gardens, starscapes, and celestial cloud realms \u2013 each reflecting a different stage of transformation and awareness.\n\nGuided by luminous beings of light and elemental energy, participants follow a metaphysical golden thread \u2013 a symbol of intuition and inner guidance \u2013 through three phases: connection to nature, expansion into limitless potential, and arrival into a space of safety, love, and belonging. Each movement is inspired by a song and theme: Dear Moon (energy), Star (possibility), and Goodnight Moonchild (protection).\n\nDesigned as a meditative and emotional journey rather than a traditional narrative, It offers a soulful portal for viewers to reconnect with their essence and feel held within the greater fabric of existence.\n", "short_description": "An immersive VR musical journey with Beautiful Chorus. Travel through realms of light, nature, and cosmos to awaken presence, intuition, and belonging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iwanttoexperience.com/privacy", "developer_terms_of_service_url": "https://iwanttoexperience.com/terms", "publisher_name": "https://iwanttoexperience.com/", "support_website_url": null, "website_url": "https://www.beautifulchorus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
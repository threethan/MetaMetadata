6ACE60F3"}, {"file_name": "desktop-20261002-170803-258-02ccda.png", "id": "1629675642188434", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622153_1629675648855100_8852441450986835876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzfgDH-sMqkQ7kNvwEK7lZ7&_nc_oc=AdosewKpaU8RCKpOXw1bC5YPjV4KxOokhI1Y2BpKP1B2joTj_0qpvoL1ZGTkB1pM-vA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhN21cvuDuxDzVVhwHFY8fXZex8p4dHKjrseQ-c_boVw&oe=6ACE5CA5"}, {"file_name": "desktop-20261002-172402-320-85b130.png", "id": "1755408269051444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623585_1755408272384777_5038566507924852378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hoVeBn43IoQ7kNvwHWEMJF&_nc_oc=AdocPmPJ5vNz5PGDf37_isBpHbpS6Qi0XelhvcTlEZwAZ0KN8VFuUoKbqhhiCLFuEAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHH0hr6tuKYgcyCwvltuV1UKvQMkiaFjVTVWmeNWfBqg&oe=6ACE5F6F"}, {"file_name": "desktop-20261002-172854-659-a802ab.png", "id": "1134811979489779", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620341_1134811982823112_7051818996349015140_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuQ6sssv-U4Q7kNvwFiTZIQ&_nc_oc=Adrm4L1_-t9fI-j-orLC5buAhV7coGzHkzn-f5OA_bJL03LmCPRvM4uPLqZrYFCOWsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ4TWVVMHpUTvTvCAUeAGMn1c-uERwzKc9QdBRfDmz9g&oe=6ACE33D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01_\u6a2a\u578b\u30ab\u30d0\u30fc_2560x1440.png", "id": "2086016238945313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628092_2086016242278646_6858239196156180558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LurEusel8GcQ7kNvwEvZfdy&_nc_oc=AdpSHpZdk2cpOwo8DeG2LGIrUaKvtmoqKEWLLReKq8N6Slt-6-jIUCHCS7zrZrGMiI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHHeMQsxQCjx4KRtc3PAxrXfF4Vr8oYIws_1GvF2w24w&oe=6ACE5033"}, "display_name": "Stargazing VR", "keywords": ["stargazing", "astronomy", "constellations", "telescope", "stars"], "long_description": "Stargazing VR lets you look up and discover stars and constellations, much as you would when observing the real night sky. It combines the joy of stargazing with convenient features made possible by VR.\n\nChoose your observation location and date to explore the sky from different places and seasons. Advance time to watch the stars move, or observe the sky as it changes through daytime, twilight and night.\n\nSwitch between starfield, celestial name, constellation line and constellation illustration views to find objects that catch your interest. Point at a celestial object or constellation to display information on your handheld tablet. Look through the handheld telescope to view images and detailed images of supported targets.\n\nYou can also remove the effects of sunlight or moonlight to make stars easier to find. Reveal stars normally hidden by a bright sky to explore their positions and constellation patterns. The app indicates when this setting differs from real observing conditions.\n\nSupported device: Meta Quest 3", "short_description": "Look up and enjoy stargazing in VR. Choose your location and time, then explore the sky with celestial names, constellation lines and illustrations. Point at objects for information, or look through the handheld telescope to view images of supported targets."}, {"images": {"nodes": [{"file_name": "02_\u6b63\u65b9\u5f62\u30ab\u30d0\u30fc_1440x1440.png", "id": "2646639572446459", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627477_2646639575779792_1977753439536619819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_47DL5m-TsQ7kNvwH-wE0u&_nc_oc=AdrEkcFo5KCNh0b9SD3hI_fn9lAADlvwAhHuVXnip12gWK3X_ahvoMb08dW2s4B5X9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfJnAGJmAxyTj_LDXuRAkvc9XW5qIAZW5vspTJ69vi0w&oe=6ACE47A2"}, {"file_name": "04_\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc_3000x900.png
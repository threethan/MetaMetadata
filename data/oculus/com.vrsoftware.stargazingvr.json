6ACFB273"}, {"file_name": "desktop-20261002-170803-258-02ccda.png", "id": "1629675642188434", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622153_1629675648855100_8852441450986835876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWQMxC5gaboQ7kNvwFV4Y_4&_nc_oc=AdoQAHbox-jrZRNDZAkBglfabLNpZO-L26tTDZXKcbTjUn8l9mqu4tNjHzAtalzDyEg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiUpcDoQg-sc0tY-3Qa1ffnwUbK-AHNxW0OOrIQbaHrg&oe=6ACFAE25"}, {"file_name": "desktop-20261002-172402-320-85b130.png", "id": "1755408269051444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623585_1755408272384777_5038566507924852378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrByHeWVUtQQ7kNvwF9xA-K&_nc_oc=AdoJ_ad6UEpR5SOWNuDqk5Xfp_dNcuNcrYLbXQeqzj9UEbMqg8rxTmpd2zDadgE3BYQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMML0T2Stwr4r3A1FH_stuqqJdQ9vaUJhX4WWRARlo2dg&oe=6ACFB0EF"}, {"file_name": "desktop-20261002-172854-659-a802ab.png", "id": "1134811979489779", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620341_1134811982823112_7051818996349015140_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXWGCXLPlg4Q7kNvwHjp1Et&_nc_oc=Ado7fCMCuHCE-0pPH48cCNzG2oDdle3YwuewJODYpjDlzA5lj3IRu_6syR0FhJnyVyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK0idBmIVETycg4-IUVvg4Oil8Q5sbMnXYsBszkDIVuA&oe=6ACF8559"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01_\u6a2a\u578b\u30ab\u30d0\u30fc_2560x1440.png", "id": "2086016238945313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628092_2086016242278646_6858239196156180558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn8_e0BkHzkQ7kNvwFaWrF-&_nc_oc=AdqJ78pr3_wzqgl2Fa8_S9FOta4O8UOTUTc5xRYOIgtys1oXePtvOcSsB-2GDkvclfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKpFdh3sWYvIL5hQzPfhms-E2MGkrGJO80oYF_RcP9Rg&oe=6ACFA1B3"}, "display_name": "Stargazing VR", "keywords": ["stargazing", "astronomy", "constellations", "telescope", "stars"], "long_description": "Stargazing VR lets you look up and discover stars and constellations, much as you would when observing the real night sky. It combines the joy of stargazing with convenient features made possible by VR.\n\nChoose your observation location and date to explore the sky from different places and seasons. Advance time to watch the stars move, or observe the sky as it changes through daytime, twilight and night.\n\nSwitch between starfield, celestial name, constellation line and constellation illustration views to find objects that catch your interest. Point at a celestial object or constellation to display information on your handheld tablet. Look through the handheld telescope to view images and detailed images of supported targets.\n\nYou can also remove the effects of sunlight or moonlight to make stars easier to find. Reveal stars normally hidden by a bright sky to explore their positions and constellation patterns. The app indicates when this setting differs from real observing conditions.\n\nSupported device: Meta Quest 3", "short_description": "Look up and enjoy stargazing in VR. Choose your location and time, then explore the sky with celestial names, constellation lines and illustrations. Point at objects for information, or look through the handheld telescope to view images of supported targets."}, {"images": {"nodes": [{"file_name": "02_\u6b63\u65b9\u5f62\u30ab\u30d0\u30fc_1440x1440.png", "id": "2646639572446459", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499627477_2646639575779792_1977753439536619819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_47DL5m-TsQ7kNvwH8K9YE&_nc_oc=AdoGUsLYj-t9aSqU96-Dh-cdAqBVCjrMxV7FnGLlbAbyhxPoYqDzlMSgfRGneMEiUm4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa8RyCfl6jLt8T_W8PGwQa2HqPKA3CFWYncuBxF2BMng&oe=6ACF9922"}, {"file_name": "04_\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc_3000x900.png
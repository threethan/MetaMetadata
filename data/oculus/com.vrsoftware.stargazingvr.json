6AD3A6F3"}, {"file_name": "desktop-20261002-170803-258-02ccda.png", "id": "1629675642188434", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622153_1629675648855100_8852441450986835876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0z4MehwbjQQ7kNvwH13nc6&_nc_oc=AdquhyZaf69OrTNlvYetZy85Mo_EpbkHk1NENvUaa3SSNsIppiBKIkCr3zYBhbHCxHU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTEdFhQGT8V_1gCuIzNpFv6WgLvT10PzDOUnVP-tqghw&oe=6AD3A2A5"}, {"file_name": "desktop-20261002-172402-320-85b130.png", "id": "1755408269051444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623585_1755408272384777_5038566507924852378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e0Mr-6sOD8Q7kNvwGm654U&_nc_oc=Adq0wRn8phF3tGkreLjISwa3y3fMn5hcBBmmxGMcnYptyUshC1nOVmZRNddLUmRZsdc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGjqM253IXIk_5z2sOfz2Un3DCbZtWDgYAzJ_tHvpzrw&oe=6AD3A56F"}, {"file_name": "desktop-20261002-172854-659-a802ab.png", "id": "1134811979489779", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620341_1134811982823112_7051818996349015140_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVtmocSL7fgQ7kNvwG5UT0t&_nc_oc=AdrzhsEJvXIZF1aLGJ7PnG4FFPlVbVKEeqh9IHbjFW1ClDSq0oOGayL5WkhuOV4woxA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ8td-sdmzEudLu-JTAqxyYelTyE-yCdx40bWm6F_vWA&oe=6AD3B219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01_\u6a2a\u578b\u30ab\u30d0\u30fc_2560x1440.png", "id": "2086016238945313", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499628092_2086016242278646_6858239196156180558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-TYuv8K5UYQ7kNvwEyxN5b&_nc_oc=Adr-xxQGzhEyyUuml7oViwYcXlcf1Z-IgRimOtxQeIufA4QfqkU4upC8ThBnQg34RkY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOfEAPwKsVI2KOXw_VoML4Mo9c3drnse7sAQ2dPFW-Gw&oe=6AD39633"}, "display_name": "Stargazing VR", "keywords": ["stargazing", "astronomy", "constellations", "telescope", "stars"], "long_description": "Stargazing VR lets you look up and discover stars and constellations, much as you would when observing the real night sky. It combines the joy of stargazing with convenient features made possible by VR.\n\nChoose your observation location and date to explore the sky from different places and seasons. Advance time to watch the stars move, or observe the sky as it changes through daytime, twilight and night.\n\nSwitch between starfield, celestial name, constellation line and constellation illustration views to find objects that catch your interest. Point at a celestial object or constellation to display information on your handheld tablet. Look through the handheld telescope to view images and detailed images of supported targets.\n\nYou can also remove the effects of sunlight or moonlight to make stars easier to find. Reveal stars normally hidden by a bright sky to explore their positions and constellation patterns. The app indicates when this setting differs from real observing conditions.\n\nSupported device: Meta Quest 3", "short_description": "Look up and enjoy stargazing in VR. Choose your location and time, then explore the sky with celestial names, constellation lines and illustrations. Point at objects for information, or look through the handheld telescope to view images of supported targets."}, {"images": {"nodes": [{"file_name": "02_\u6b63\u65b9\u5f62\u30ab\u30d0\u30fc_1440x1440.png", "id": "2646639572446459", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499627477_2646639575779792_1977753439536619819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qw959b3nH3AQ7kNvwHv7aYw&_nc_oc=AdqSvDXLdqMCqLYsqE0mx_w2h3o0yXdI4rZ35j9KDnMXevUgI0jX8eAT1AaS-Sfr6JE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVHoROacQM6aXqqNFEEoq2dBCIEGyoClkREhyJZrysmg&oe=6AD38DA2"}, {"file_name": "04_\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc_3000x900.png
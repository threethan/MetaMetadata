MwAMx4d9SEWp_7840GUkcYKPcFifrawHkxATA&oe=6AFB299E"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex_GJZryzc4Q7kNvwH_U6M9&_nc_oc=AdqIo05EA3igzKAZzXh8CFAiwnmo_O82x6VmSGw_4qrzH1JJeUpaCgtLKUnKh9ADQxM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCgKjMK4sl7GIXI-cmjFR2nk5CEE5om-N1pD7hJRq7dg&oe=6AFB1A1A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFBHlabCQXoQ7kNvwH35Gu6&_nc_oc=AdpOKSjSGF9ZRTTGPopLgiX7XRg3yBEtjIOZTvqCOCAyuBJH6FyWscwkGIfH52dGFSw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ01dPuv-ZYyHn8j-vUHWlUeTSGZ5rmBkPI3W2xy8-jFA&oe=6AFB41B2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPdyMMAp4b0Q7kNvwHrem7N&_nc_oc=AdoiglYXiXCOv4lbsls1az23i_jeKzkMOWCE9zOuh5oeHLUNkQf9__Zw9nsKUNDvkg0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaK0nrpUPTc0iLr1-itkgqp54C7dqUpy9zn6FsxEiFKg&oe=6AFB363E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=is_KsxGpEsAQ7kNvwGIYC7Y&_nc_oc=AdpTFTBbya9ISoljwcAvUaY3i2OpdNSSQIxwiA3Qo3TJDkDimiZ1SAYOevyDoIGLWQs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdX1tz8zlIX0xMYXFmV4kPYbOnyqKVjpUdzap-Ew-PAg&oe=6AFB3A51"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": "Jim Schein", "developer_privacy_policy_url": "https://jschein925.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://jschein925.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
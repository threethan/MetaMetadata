aY_cSgI7UWat9HyJd4B_hCmSXIbtq767PZwPA&oe=6B0D9E9E"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fGiMDqgVlsQ7kNvwH9kakU&_nc_oc=AdoE3OohnSz7UKOT5e7KrxaCVQVrQW65pxM454T9C6Zdx2JLqXNca7k1aXlu9NJk4IQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRmwVrjIEJSI2b3Qwc99t8ayVsOFO_pwwgYsx62gauLJw&oe=6B0DC75A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYxQ2z7SuMoQ7kNvwEKXnhK&_nc_oc=Ado7PPe3Wpcbup0nlOc86efDa2ebzR4q85-qONnKvL-ZiXUi9nREtEq08ChWE_0vBCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfQGoAY4jd2uRiPMGHsZumg_wORdDHjr-35M3wL64Ehw&oe=6B0DB6B2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKD7G-Nq6SAQ7kNvwH8DsYl&_nc_oc=AdrJpWd6imyPlX7xJUsFNPZPLKnjYTmlJjUJHXADD0roYPiNjT3dY9IaQdo3S8tAE8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSENb206WfgQJbMUsqy1HXOSOtOgO5V_TE7hINMakZshQ&oe=6B0DAB3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4axW7QNic4Q7kNvwGM22YV&_nc_oc=AdrNT3fwh40I9kV4bvYlBtnrYkwUQ50gkf0ro8pPaDnBZMdpdhnPA8u4g1XjvMgMVDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6v-NPhTlvw8ddWZtHCB4Z0IrlWIFpnanDKL0Nr7FOqw&oe=6B0DAF51"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": "Jim Schein", "developer_privacy_policy_url": "https://jschein925.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://jschein925.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
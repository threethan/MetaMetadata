c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFTif6oHPL6PHlJv77_XccGuObXPYvbf2eWd2_4KEH1w&oe=6B03129E"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZzLLOmgIx0Q7kNvwHlESUE&_nc_oc=AdpkpbiLxWvnPIbA9j9aRXks6d2DJx34I67QQ_461_jQ0WQnzjQSJqE9k8SjGd2w4Ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwLvzEUbWYWEsECUM8r1GZZBgNGgl1Xz1mX37raCE6sA&oe=6B03031A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdibpOVxFwEQ7kNvwGd6dfZ&_nc_oc=AdoLJowK7O9Qctj9eV1-MbxHfLPm8LNnMrqnhTmOV0TqBcX-B81FdBrSa6Rd5x1n9HQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIaBsw4xheAk2LwiT_91z029h5OcNFx7Q2o2g13ecq4A&oe=6B032AB2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y09eL3GGI-cQ7kNvwELfRXL&_nc_oc=AdpHI7rKzYlQmb6d6VH_dk50RT13FrmF3WX3Z0ht3Y66JKau_CiAnse6UWsCMkQBPVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLMog0dIjuaM5gSutHRDKNhXQ8DByFFl3eNqhVSaE0dg&oe=6B031F3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJMAPP26nXcQ7kNvwEYrgk2&_nc_oc=AdqCvCqGoAyNOkmwuItWcpE6niBdQq9Tr2bH_d4_aAMn7l2gXd4eSsN7GPe6zScv5l8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRC2hOGj0CRfGGRgCLVbVDQ-4WRoOu3Ag2BG1d9Evltw&oe=6B032351"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
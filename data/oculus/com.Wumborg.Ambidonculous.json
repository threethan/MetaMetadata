25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwvFXh2gJQ4Q7kNvwHzF3vk&_nc_oc=AdpctAmFflRxG1cs4MTcgIfeTl0ZTH1XHM3E_4SZvAXtWOwRwxPxi-yrRq1sBilkd7U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p5JlTY28kB52tBjbvQiPojzbPZW02WJ8I8EHob_BAgA&oe=69E63F1A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO39RyZxs5MQ7kNvwEXO5mO&_nc_oc=AdpudUT3QnBVaLO5jE7L2RSS5ohVa3vvFUF4gyXuoaYulQWk1ke8XQazq9xpACgzGl8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21UOAlnPXtwzS7_3zXwxBq00xS26kixYWudIFEO6HhCQ&oe=69E62E72"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5dB-7Puz0QQ7kNvwEFetqP&_nc_oc=AdrwFdFDoMliHAf0vgI8AL6163X1C-7jghiKIZ8iRbOuguNeG34NBNSlFOb2y_U6eAI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s-vNsA-IwAP0RzNEBdfrVR22cEYB9_HeHEtTc3j_3UA&oe=69E622FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q33zyGWbTsQ7kNvwE07ReW&_nc_oc=Adqzm6FGXdyJhBV2wM4DKGk6_kzb6SkdOsDGUbK8sxaIhhUs9rehBwDySl9Kgi1Q42g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16lVdIiROnAKPMQxYYsk3chkS7q50qbJQjBMeMNehKWQ&oe=69E62711"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1358420084680065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974606_5114352595321785_9
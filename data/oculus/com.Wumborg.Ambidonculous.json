vly&_nc_oc=Adn5PouwFsZTsRTDCb1mwktJjHyR74V_PrscOgmRy3C0jXdkWQnDtGglxVTzD_qTFhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvMEtdCIYrsZBjFVsN7kqMWYUgOhK8W5m9PF5XCbXk4IA&oe=699AE15A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v2wI2Rxh0gQ7kNvwEMUndY&_nc_oc=AdmJyE9yOoso0xuPPG0o9iweCIztlm3kNAD5xgzGab2xFGVkAj_WnSOEqHFXOpPYicU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuoALgfP9xFIm0iktP24XofcpN6nBdpD0KJs6rfwHadlw&oe=699B08F2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq1CpkUtyNIQ7kNvwEazH08&_nc_oc=AdmHtITNtEpkkYDeuTn66eZ97Wym5gnZU6cbH0OSEJ9qE5LI3tcyYBrXawZ4Cc_vZl4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afug4FQuQsjMUnm9CTqmFqhan_A3RDpbcdsECB5LSfWkog&oe=699AFD7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v37ItpB7xW4Q7kNvwH2bCUx&_nc_oc=AdnluW3neeS2saS9U08j1s3FLqGPAytn_wg7rtQkcFyjTIk-SrGqvDfzLm9qtJsrWeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvJn2Wie0ccq1QMNjhajaAyNwbPeWA42AoX5XTYu6Vb-w&oe=699B0191"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1358420084680065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974606_5114352595321785_9055144157166616006_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mdADaFoQY8Q7kNvwFQv1Jf&_nc_oc=AdkeLqgpPCBNdcIND55l-TXCbES1iY747_K1hhpwL3Fq7y2De
c_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT18o-YJlWLf8dz-w6HOuwbpc3rggutXQc06vQN8kgHEQ&oe=6AFDCC9E"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKWZTTp2RLQQ7kNvwGoE0-c&_nc_oc=Adr13eEjH-zef00TXdspoOyNiY8G8pUqKS7LfpB81Ajkc9ARJgZ_DeZgQ1i4WcSLPFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ700Gz-GhumFKlngJh-m0pf-ylSSO0jY1J6rv3YR9toA&oe=6AFDBD1A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFBHlabCQXoQ7kNvwHAKWqV&_nc_oc=AdqQMwUTckD2uztxWraPfht6xSV70RNhhxHKUCrhyCRmdUbuWMI44TBOh77Bs1DocUI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYxXJKsX27iz2mJwQWNJX-EEoXqsk5unDn4pC8kW0K5g&oe=6AFDAC72"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPdyMMAp4b0Q7kNvwFz_PUK&_nc_oc=AdpCXJGYgeYqQiR6PlNEtSzwolpIkT3cQfZVjysbx6dpK6ssy2_FRTF5naB7lZ-7FH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUIXI3BcM_9fz6fxu2MiL9DMllsrjkEqGQNH-dQjXTJA&oe=6AFDD93E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMpfrU35_jEQ7kNvwEXimA3&_nc_oc=Adqu2khLG16Z39vQk_l9r07o-Z5v18b3kMbwfwUsnKLNlwW6uW9ddTRtrVLnZ4xwixM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz53sv1qB3pcnUYK0RP1qzgNvoMHH1WH_Gwp_N53IJlg&oe=6AFDDD51"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
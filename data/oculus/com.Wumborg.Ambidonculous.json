c_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPr9Td_M7zJ-d5Pl5q3UnUXJzY42B4UJHH4oH8dBs6eg&oe=6B07071E"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a4P2ThYC_UQ7kNvwEEaY-e&_nc_oc=AdqoVg78ywItVNbQnjdjZulKJo25rJRk9LLmRExZ4lwl1ByZ3vI-JVhNJw3UxEM_ktA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQelmg0A4t68-wZSzhDUBu8laNI8e3clP7Ylh-A-iIwOA&oe=6B06F79A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QIyg9YkiRcQ7kNvwHthVr4&_nc_oc=Adqk2tWwuExVBc-K1yrH_3J24_wK0NbxCq6kMaYfwPyMivVk3nOWByLJXOtYPZx4iC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcj4NXgrc9DHipKF_McE1XqsLBnKwPTB9Fob0MbY2iXg&oe=6B071F32"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvwNTyVKOsYQ7kNvwHbwu6L&_nc_oc=AdpDlk5Z2MXjqaxyPSWI-oUa6fIc2sK4Y2bDjlJeQ97b9GB5L-Px1Gr2NlbQrsAJfLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeredVTSTu8rUBPF6i6SpvIM6HpArKkauXtzIx_2-YbA&oe=6B0713BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_uAIOZu1z4Q7kNvwEAWHKZ&_nc_oc=AdqAZY6CJ7TTqi5DAN_b_Mkx2PT-oOz7fwSn0_CTDChN1kLAqWC4xMj2RsGtprVBm-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx0i_4ZXYVgazDorX4tufCdM7F1dOBCTMj4wCBHEglqQ&oe=6B0717D1"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
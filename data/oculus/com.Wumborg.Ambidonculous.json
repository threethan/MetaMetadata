25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBP4hTgMl5UQ7kNvwFifq7B&_nc_oc=Adq2ZvGl0LxR-lZkeJUjKbJzYdH7GuWPY3pYgyvt_A3sgfwG6xBKl_qtPPbUvQxvQuQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN85UUY8agJaSyM1FuxvYVLIqzuon2XWPGZiU-zCXcIg&oe=6A92BB5A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZuX7Wp7qAYQ7kNvwEl37mD&_nc_oc=AdqOt6P4FnDPaGQ2RN1snEDt8XH9sNnaaWIc47NBpd4fDqXIyZcplB3bhvz2zfDe5Ic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfbFPozZn4OI-iZtp7_JYo6unEIZwxZ_BVs_-TT_0c3Q&oe=6A92AAB2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUyxTZfS_gAQ7kNvwE1Bifb&_nc_oc=AdoIqQ371VLDVTitxwHFnLPof-MhIHKfe13Eav4YwtKV3oyi7yS1cFAlc8eDbiiSo2c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqTMB979RFruM-ZB4aP15J_xgyN_FAJ3TxnIW1IpWkXw&oe=6A92D77E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zu7BgE6AFkQ7kNvwFmqCYy&_nc_oc=AdrqZlzcihH2yWYtizfr4qG9iKiTk5N5-eu9-mQFDD0TSnH3zEnVsYcYR3N-w7YJc6s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM0FQ62VACT6ZHEqHaVnMaUmBTWqqIaglrc5YlD118zw&oe=6A92DB91"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1358420084680065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974606_5114352595321785_9
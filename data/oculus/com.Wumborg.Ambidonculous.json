8_vHa1hPl80zMa0daPE0fZh56PIKbnNTEY8QA&oe=6B0C4D1E"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fGiMDqgVlsQ7kNvwFhCW3e&_nc_oc=AdqH0pzuSNFIEzWH4rnrsEvMDnemp4GSZvgvKRRg9FSFtl82aHgM-xh-kbKn5eTshpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkJFN83NU-t-laTSD2PAUTopkeI5w_oWqJ0qWJeipmwg&oe=6B0C75DA"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYxQ2z7SuMoQ7kNvwFRS5AA&_nc_oc=AdqUJxpHr9lR99U84XzF_I5o-BZoGU0_MGWDS-ZjUBFvbm9h-7wugyCPsTb7X0lXyqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS6mAjoUIU06jze-8T3dZ7ZjARZiG6E2dbxd6BKvKaWA&oe=6B0C6532"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKD7G-Nq6SAQ7kNvwG16zHi&_nc_oc=AdoUW2PgeMHurHaej__LT6Dmy4FH3Bv56kq9mlI2erYZy4-V5tkFgbXStop80C-3L8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7Wyjtra1KhKpQ8c3ZIB5fbeD_ta5ihaMOnWitjXt58A&oe=6B0C59BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5_iRitDUDUQ7kNvwGaV195&_nc_oc=AdqGZNSEJZNm5mCDAwwKNmK62kmh4ONoHXfIcPZmiHEOeQOE27eMzYbdprVhorw0xeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8mtz6VDEYcWaRvmuThWTVPy06ZM-pmFycqpsJrtSk3w&oe=6B0C5DD1"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": "Jim Schein", "developer_privacy_policy_url": "https://jschein925.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://jschein925.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
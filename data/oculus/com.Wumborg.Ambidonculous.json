_1440.png", "id": "306782221658264", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974505_306782224991597_6774694746320333164_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDoLMWQ0XzQQ7kNvwFUDm6b&_nc_oc=AdnFl-pExwOvkx1JkKx6a0EJu9qW2cgUqRtLUtcCSoRRbsOIWbEN4Ot_5EPe4dTNo84&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyttKzyA_End_gCUFJjfNBCvcfpenvY1SsIqTEZVxNAng&oe=69AAC39B"}]}, "id": "551130736580270", "locale": "en_US", "screenshots": [{"file_name": "faces.png", "id": "393606902683351", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974847_393606906016684_6672187426083805046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezi6QrGvDtQQ7kNvwF87owY&_nc_oc=AdnTVygCTH0_etpE9CtSiEqqJfPy7Ij0V9mNsb2oxUM2X20dnaxMyOhDupXToQpdYYc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwoyGls2TTbLzTLRajqUoHW_mqFZtD4zzE9jS2H-NgWKw&oe=69AAE2E1"}, {"file_name": "stars.png", "id": "1039438813664523", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974726_1039438816997856_3140606797301784532_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdYrQZ7HQwUQ7kNvwFbqzje&_nc_oc=AdmxBLt10Ctd85v_bPCWpWIr6NTLod8SUMW8P_DsOCrRiBRfx4x8GAVFdppMBFqsErs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGB3Lc4Ief5GtEXf46dgcoycn0oo2MFbg9hfbZT8Fktg&oe=69AAC2DE"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPzWWChGpD8Q7kNvwE7rLl9&_nc_oc=AdltUQhNojlBaloPoqz4HkjCftGI2LIvbaFc3O3P6FSzzaWBpU6x3VbfY7Yqohm73-o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxgTzqR4F3qzIwKdYnLuGiHaHJv4nKDOVpjoNfPcozRiw&oe=69AAB35A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmcrcpnhVo8Q7kNvwGdFodh&_nc_oc=AdmOmZUgZxIh5J008eelYkqdLuMFn8pdOd_GnWJ9C1xL4-F4TIvSRGSvt7YD8VTzWXI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-88D_zwG63zlR_Dkb0X4u6Wt3jdxqvQtw81SUlnnJcQ&oe=69AADAF2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxDHYyC7NccQ7kNvwH9U5jO&_nc_oc=Adlllf5zoJlRQr27n9b_V_u3mhplJjMmEwORyWK93pKB7xE8NModnJJZzP1ywSdSxbw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1Ude_hXV8m1obVDibY8QzdowrmvhKDSOpZouz_6inpA&oe=69AACF7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwGC5l11D-gQ7kNvwG9JC19&_nc_oc=AdmTLUV8GTLC2qfH7nG9ldfLQ70S4eqjKBUtGJTba5rqHCavZUWvfAlYcIirIUQ_g_4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxD0M3USLVdr4imJlqXE8oDIDWtbzjY9uXqx6A78qniEw&oe=69AAD391"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": "Jim Schein", "developer_privacy_policy_url": "https://jschein925.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://jschein925.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "543189310866093"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5093048214139335", "version": "1.0029"}, "id": "969377070684167", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4704511419659685", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5093048214
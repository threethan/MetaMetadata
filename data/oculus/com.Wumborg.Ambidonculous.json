ZVn&_nc_oc=Adlmg8f0jRVbVcpZf0ivGWRgUowgit4uHhUYHXPth_e-4R9tFzj1e4KhIi5oih65u0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftOCCcJbDMPafeIPFzmn35kpaKM0rh9Ix0AOTUIwnaP2A&oe=69983E5A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v2wI2Rxh0gQ7kNvwHW1ejp&_nc_oc=Adm4K8FSRBy1N1_2GQyK49qCor-GH4ra8mARx8W-H-udvBaWjQxHxDQ1_dijzZ5eWow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsm4JnSPLNwV6sL2IKqCGjL9X10i1kquVIe2ebKYg_m1g&oe=699865F2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq1CpkUtyNIQ7kNvwGbRd4U&_nc_oc=AdnHmMA9LytPztNSuMX2EfOmaltXTQ_Vcm89YLAlvKzUk0Gr5QT6LPKMpStU5cr5Brs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs8KzKrV_5RgjBLi3D3Ie39WsnGpQW90j9sikddMwH7mg&oe=69985A7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arvrCI641R0Q7kNvwHumaik&_nc_oc=AdnO0w8okzUg99mIHbFXmDZx9ymilgXKXCc7jsBR73iQHZsjtFOcyl5hbxcpNcmr_cg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftkm-fAUqc6nAM2j7O7kQAgRrsRyHcykLtGaAeZuZQ8OQ&oe=69985E91"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1358420084680065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974606_5114352595321785_9055144157166616006_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mdADaFoQY8Q7kNvwHlw-8f&_nc_oc=AdkgiNsZ4AMd2XWt81ppKjRadbFIMP92j-5Lhidn4dG5rR50J
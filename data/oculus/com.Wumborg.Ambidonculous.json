c_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw2TGCPeTh6c6cpBvSlqZzDKi4mXRdCZ4-JAw070J1Zw&oe=6B08589E"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spf-uxvBdggQ7kNvwEzUZAC&_nc_oc=AdqPp171zJj_hY1YQ24I7BFhO6iG3cbiSPFCKsb5VKXaiDON9JNnLr8iPZZMzS7Eh2o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd3sVzPi7EJENlpm8vECCYL0dOhOeaLk-eyBHNNkQOGA&oe=6B08491A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QIyg9YkiRcQ7kNvwEGlnk3&_nc_oc=AdpoIPhiWaEG9qaUMP9t64ikw93LaQeaeQuteEsmkyf4oGCmlAfH0xzOPufAf5ZYQ-0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPGRO0tGt9IFsaCfu5zumMlhQUtyOTHLmycp1B-LeC-g&oe=6B0870B2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvwNTyVKOsYQ7kNvwFPWRTB&_nc_oc=AdrrbTQukd4Esk8mBOkvHLkUefhOz7gMFFPLCo71DGY3mK9h_SsaKTIEbpcc4n2ZbDE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXxi5mPHFtAWYY9Ke1ZP6HD6h-jQ7Do4OUmfYra-jwDA&oe=6B08653E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_uAIOZu1z4Q7kNvwEvHEOo&_nc_oc=Adrzo-mObOBRjQ-azD0pfKU5tJVa85PiEiapKzLcffYyMJx30OTNeTTTY4ECZ2plMQM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy7l-RItGLdwmxM8Eu_h7J_TU2kEHxhI-CZv0NCU1BiQ&oe=6B086951"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s-7TtEaN24Q7kNvwHRA15r&_nc_oc=Adpj5Y9MUUafrei9VG5SeTYvBbmKb78SreUnkPlmV94I_uOfC-MjYQWblU8-zGKpsB8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sYEHEuH4NiuSTBCLiYtSVPTUP55AN6HJmOq4GGiSfxA&oe=6A13121A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNc45mjXgT8Q7kNvwEswOT-&_nc_oc=AdpAbQWbRa0sue8K9bGGDB7W5_U5MVwM8zx72An2By1pYCparO7ELs98MRd-AQOIDjg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JM2F0f7GJ4F6lF9f1z_e8PzM9TmA-hPWB_fq2DdLkfw&oe=6A130172"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpEb8WGW3C4Q7kNvwE_fKk3&_nc_oc=AdrC5wsWzzNKU5KW2V-gByok9UuUCJSbuP3Dha9dNeqVWMCrBEoQjail01aZN1O0Lrg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jnhmBlpXC5yn4nelb200wyJgvbNHDuCf6c3CqOxah8w&oe=6A12F5FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAYlF-A4gGcQ7kNvwFAm1E1&_nc_oc=AdqCT9iaUarpeYRv3YPvNVtbHujhRrgA2lcPJOJfCeJeIIEuOK3U7oynhmxW4_XUtTs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75945XPxiNdjDbHZ6y33muotD8-qxs-CNQGas8NI_CqA&oe=6A12FA11"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1358420084680065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974606_5114352595321785_9
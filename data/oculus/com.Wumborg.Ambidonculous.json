64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzTW_l3i4vcQ7kNvwHV_OdW&_nc_oc=Adqm_f3GX_cjTWycJETDtA5IXwNk3ayOQKfKyhIiEeen-HHYsOFX0aH8m1JL2rb7q88&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q3L0-biW4GdP2Hm9COFEdUJ3IwrI-aS_O74iVekE3bA&oe=6A393CF2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO0kxd7NDC0Q7kNvwHR2kP5&_nc_oc=AdrTw_cs7IZqLqqP3P-53crLUSrVAmtzIWvzqSig5i5tmnLC2Yw-jcuhfmNaqRGa95g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pVGypbSWxTuQ0tSwaEqmCDi6QrNQo7ns9EACqWZItkQ&oe=6A39317E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XD1XL9z6hFkQ7kNvwGLi9tA&_nc_oc=Ado30s2boAA1qpbI5wyiEyNJY3hzg3MJkiw_AHBfIRF1UAw87btuwNsHkmhI0ShEEc8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7C91mha5kD7ahZOFUh5pMAPJz7KX6_J_zJFU9h9mxYw&oe=6A393591"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": "Jim Schein", "developer_privacy_policy_url": "https://jschein925.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://jschein925.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "543189310866093"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5093048214139335", "version": "1.0029"}, "id": "969377070684167", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4704511
c_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSU1QNvglJa-PAiUruG0E9OlKsNMGz9Z1e6TlFyMklkvA&oe=6B0B33DE"}, {"file_name": "clean.png", "id": "717230549428066", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75462203_717230552761399_4800435341615828744_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spf-uxvBdggQ7kNvwFlVc3k&_nc_oc=AdorsPMYmGh2bA_LQsIe0e3ZnOKiCcovU2I_cj6x82uWDKX7dgzh2si2I6UQIo4Mxk4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSG77sISglReS2KJDZFHmOYJNJ609XJLRRGyxo69-aCvw&oe=6B0B245A"}, {"file_name": "pile.png", "id": "5317213261662028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974676_5317213268328694_4561749060402425155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYxQ2z7SuMoQ7kNvwG-5UNP&_nc_oc=AdplWpnvNn7gfI65zQE1HJmhxsUiclp1QiNbZYbWxuzgU1tCWqsv_r4EzPS2xYo6tQU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_TQc4Xoel4jEc_Zi1HoJHpFeXVe9JiPHkXxy55zP78w&oe=6B0B13B2"}, {"file_name": "bottles.png", "id": "5025263217543400", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974526_5025263220876733_3898861206059274155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKD7G-Nq6SAQ7kNvwHWukOr&_nc_oc=Ado4sLiHlaJiwbnKMqGXWhksyfkDjcb7guNl8oTMGRSzft_6l25z7edx-rQ1a6jNrEI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjHF-5dI_5dP7irmPl1lyAM7Rv03TdJUMwHqVN2OYwbg&oe=6B0B407E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clean.png", "id": "1005365183444672", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974562_1005365186778005_2751976707861811572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5_iRitDUDUQ7kNvwHNzf8p&_nc_oc=Adps4f4rbZx2IBzlqPG7GBI5lUq9qQIDaGZ_wt43vT-xwTceI_LPctQ_edCQau6fmA8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSk9z-PyAjYYtfos5CrCAJEK2WFFMSvsYdH2t-8SFmYmA&oe=6B0B4491"}, "display_name": "Hands of Globzop", "keywords": [], "long_description": "You are Globzop.  That's not an insult, that's your name.\n\nYou are a Generator.  You come from a long line of Generators.  You may be an alien, a robot, a mutant....frankly we couldn't decide.  \n\nYou have the ability to generate (hence the name) energy from ordinary objects by creating a conduit between identical structures.  You do this through the use of your hands. \n\nThey are super nifty.\n\nYou will take various assignments throughout the scenarios we could think up, bringing similar objects together.  It's a great job, which is why you don't get paid anything.", "short_description": "The very definition of an \"indie\" game, Hands of Globzop is a VR matching game that takes the player through 56 (and counting) scenarios with different objects and behaviors.  Grab matching objects as they bounce, fly, swim, fall, or float all around you (or, in some cases, rocket right through you).  Beat the timer objective and unlock various rewards* to enhance your game play.  (*Rewards currently limited to new looks for your hands because I haven't come up with any other good ideas I like.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wumborg.wixsite.com/wumborg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wumborg", "support_website_url": null, "website_url": "https://wumborg.wixsite.com/wumborg", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
nc_oc=AdpgBH6b6oovU3gEe2LiU-NVvSJ8w_hIa6U4Lgx_R71QmiM09YX9AsFH2wDPsx8DKE0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCnxpp9Z0S5_z--mHNkg1PuIAQq7i_R_FrvBbdyfzx9g&oe=6A8D7611"}, {"file_name": "3.png", "id": "901016253078145", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499314659_901016256411478_3209245706455659237_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-yg2Jmvj84Q7kNvwE3oba4&_nc_oc=AdpEkaXkzMyqfCfaccJDtTwvP7DO93SdGfdG37XoM6q89oaCh1OQLgCPUDq4JIcDwYI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdeSZrbTVBUDOOVO-eVaHlNpDz9U4x0McImWDhDbeQDw&oe=6A8D86EA"}, {"file_name": "4.png", "id": "1416723327002973", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/593863731_1416723330336306_5214284869064226497_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7ufj1F7tBkQ7kNvwGlxim6&_nc_oc=AdqNaclecBjJww1A7l-vo_T_4oEi7S9B7zMBi4C1fq_P3HwbF63DfbTpuz50odFqJSU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTAugW-qDTZJdx-6dZoO105w18n9WTgPSKYlYfb_-DLQ&oe=6A8D829B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Racer: F1 Car Racing Game", "keywords": ["Racing", "Formula", "Speed", "Driving", "F1"], "long_description": "Get ready to race in Formula Racer: F1 Car Racing Game!\n\nStep into the driver's seat of a powerful F1-style race car and experience the thrill of high-speed Formula racing. Battle rival drivers, attack challenging corners, find the perfect racing line and push your car to the limit as you fight for victory.\n\nRace through fast straights and demanding corners while looking for the perfect opportunity to overtake. Every turn requires precision, every straight gives you a chance to gain ground, and every race puts your driving skills to the test.\n\nSwitch between immersive racing perspectives and experience the action from behind the wheel or from an external racing camera. Stay focused, react quickly and make every move count as you battle your way toward the front of the grid.\n\n### FEATURES\n\n* Fast-paced F1-style racing\n* Intense wheel-to-wheel competition\n* Challenging racing tracks\n* High-speed overtaking battles\n* Immersive first-person cockpit view\n* Multiple racing camera perspectives\n* Smooth and responsive driving controls\n* Competitive races against rival drivers\n* Fast straights and technical corners\n* Exciting Formula racing gameplay\n\nStart your engine, take your position on the grid and race for the finish. Can you become the ultimate Formula Racer?\n", "short_description": "Get behind the wheel of a powerful F1-style race car and compete in intense high-speed races! Master challenging corners, battle rival drivers, make daring overtakes, and push your car to the limit across exciting racing tracks. Experience thrilling wheel-to-wheel competition from the cockpit or chase camera as you fight for position and race toward the finish line. Can you become the ultimate Formula Racer?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
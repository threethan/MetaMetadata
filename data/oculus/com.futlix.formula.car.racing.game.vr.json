h=00_AQE2Z_ytqpzgEJzqvzGmCyr3nffL_SFdLR2WaEf1G4TfwA&oe=6A8D9477"}, {"file_name": "Untitled design (5).png", "id": "762177490157300", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491827703_762177493490633_6451216078633783875_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFaJ49w0JK4Q7kNvwEdo09F&_nc_oc=AdrrABYtEaCEPdvEXh_lYiFX6SdSHeKCl6f-ixHmCm76aXerGSRPaJhyGQrZf-GOapE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1AqW7CERTocbgXEg-xFKI-9yXU5DY6GWyTzJfrow2oQ&oe=6A8D89A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Racer: Track Car Racing Game", "keywords": ["Racing", "Formula", "Speed", "Tracks", "Driving"], "long_description": "Formula Racer: Track Car Racing Game delivers the ultimate Formula racing thrill in VR. Step into the driver\u2019s seat of powerful track cars and experience speed like never before. Every race challenges your reflexes with sharp corners, fast straights, and dynamic circuits designed to keep you on the edge.\n\nThe game brings realistic controls and immersive views that make you feel truly inside the cockpit. Whether you are chasing lap records or battling for first place, the intensity of real racing is always there. With stunning visuals, responsive handling, and an authentic track-side atmosphere, Formula Racer is built for players who love pure high-speed competition.\n\nTake on time trials, practice sessions, or full races as you sharpen your driving skills. Push harder, drive faster, and prove yourself as the ultimate Formula racer. This is not just a game, it is a complete VR racing experience that puts you right at the heart of the action.\n\n**Features:**\n- Realistic VR driving controls and handling\n- Immersive cockpit view with dynamic track environments\n- Challenging circuits with sharp turns and high-speed straights\n- Multiple race modes including time trials and full races\n- Stunning visuals and responsive gameplay designed for VR\n- The true thrill of Formula car racing brought to life", "short_description": "Formula Racer: Track Car Racing Game brings the excitement of Formula racing to VR. Drive powerful track cars, speed through challenging circuits, and master every corner with precision. Experience realistic controls, immersive environments, and high-speed action designed for VR racing fans. Get ready to push your limits and become the ultimate Formula track champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25877307745192759"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1394278726230961"}, {"status": "PUBLISHED", "id": "1995989777716009"}, {"status": "PUBLISHED", "id": "1007582258680829"}, {"status": "PUBLISHED", "id": "1299987832225921"}, {"status": "PUBLISHED", "id": "789112887117174"}, {"status": "PUBLISHED", "id": "1244395120354670"}, {"status": "PUBLISHED", "id": "1414695906848687"}, {"status": "PUBLISHED", "id": "25569429989411220"}, {"status": "PUBLISHED", "id": "2006572540171036"}]}, "baseline_offer": {"id": "2006
bGsD4O9AooGLjBp1LDQ9cYTUizZCA&oe=6A82F9D0"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnq25OfXyH8Q7kNvwFdTtHe&_nc_oc=AdotP2ODRw7xfu2Lyrw0h5yGqn7b9EJyxYtzikZ_Wr1lTjNphjHw87J9afQSC3tz5jQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOCfbK5oAuEn8L-v5m5dFgiXKHlEy20l3mX9dL6adR9w&oe=6A82F4A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anP0a9q3gRkQ7kNvwE-sRZ4&_nc_oc=AdrkOeG5GL6lM2kHj-ux3EySXgSFaLhW2BSPGpgzhqJZ_7sgjec-kctiww4Cg64dh8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDlCwrPCs92jb0-mtDNPGJ2lWWNSWyiZ6UhwNeDj7Oog&oe=6A82E91B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
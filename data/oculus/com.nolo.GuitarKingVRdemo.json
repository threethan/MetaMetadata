Zs-xeV2AuuwKGiP2HxSPPZjQh-3cQ&oe=6AD0FA90"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkNRYd9P2gwQ7kNvwHBsNkZ&_nc_oc=Adpf8utzpQlXzpZLotm07QX-_Dkj9N1TciH5r7ZeMCbtmUOH0VYv-vHpOntOUhkZpBE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi99nlXYtx-yaLA-4aZ3C6ijuixt8bKO1JzLAi4D_HCQ&oe=6AD0F561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpjEpb5rJJIQ7kNvwFKU_V4&_nc_oc=AdptTvWtk3zT_k4RijbfHnVXajL3vs1U9fgxX7pvrfr3eU2xoh4NYvmDMXvjwMf-46U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-He7fUY_ZqOWYjJieQJNtbqLLUMPlDK2c3FByHqL-dw&oe=6AD0E9DB"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
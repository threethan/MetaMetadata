n.com&_nc_ss=7f20f&oh=00_AQHVc0gjWsGapjJZMZxWo79ymlkcx5WvsTW6n-3uYcLMvw&oe=6A8ED750"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cousyFiaJFIQ7kNvwEKfrUJ&_nc_oc=Adr-fetKlokSAoj1NyCId2kjPehbl8Yb7XiyulX3yjjxkvWvz_Qo4DLR4tSH5zfzQr0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGZzs4PsL4sUF2ThI1e4zXhFgsqBR6hYARjHxHcLVlDw&oe=6A8ED221"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz_aQyBGA2kQ7kNvwEOdzGn&_nc_oc=Adrie4myKffItxphAygJFASRbSQQXIjlyASvQTtJB0xuZ9-B7E4I-4oLkt4XJn39Jno&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0XS-l-KIVmFW3jAQM3rqLE4b8VsobrI6Kf0zbVbPxRg&oe=6A8EC69B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": n
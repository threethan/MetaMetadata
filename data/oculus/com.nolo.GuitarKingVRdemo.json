wZbxjH3JjvzsKS08hOoQpLWNyp9zA&oe=6A32C690"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl06fs2O540Q7kNvwEDcsuu&_nc_oc=AdouAjtw5iBOph8T-SDAVSpBMYYGRaGsFcV36WirJ37et6na2GfWG9F3pt-EHBlyzMQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kvNHfKyM8RYtzUkiOCIpRcKnr6IvBnkyEF3Cg7pvVrw&oe=6A32C161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1qJ94JANZYQ7kNvwEkQENK&_nc_oc=Adouv34dr1LA08_7g6AHCj-S5m7XG5VNCC81n8t1fKIlrFMJVOX-VmpIWtJEAh2xR-Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95zTLOku2muGFSJpC-4RTq-Qt97UQV5V-0kY4J7sdZpA&oe=6A32B5DB"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
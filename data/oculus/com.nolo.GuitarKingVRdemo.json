cT2_CEMVJTlN4sXzp5c1BqnJbvzFg&oe=69E222D0"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHTGypc5EfAQ7kNvwGbFqxK&_nc_oc=AdqX_M239CLR5d1r3qKFuhBa8lw_GAHtQ5rScV58kieqbntZ7iIkfLhvQQkdOZIdo0A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RpOluC-UOUdlVGY8qqizcIyFtuUu14YArqDBEa9-mIw&oe=69E21DA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=He5pQSSg3_AQ7kNvwE_oyLk&_nc_oc=AdqrQ1tdzzAUmCUeURc8YLZpE5fxD9IaL9Dap5tsXveVGYMxwpX8DO6JLj1xr5RfxbQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ny4mae_Mf5Pe5P7IW1ATZ0BmmCyLvg37wq_BRSl6yJw&oe=69E24A5B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
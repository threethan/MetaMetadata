2m_fA4dxZBt_SLeKdX1Qwp68LmpqA&oe=6A317510"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4F88xMJePgQ7kNvwFQ8FRT&_nc_oc=Adq5eKeNatovufYXH8Sablyy1lP_zDVsPoeSBn6e6PrQfq894IVtK8wMaCpy7KsnAdE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CkIM8phvQvpunbEUsnKUn18Lf6RoBhiROWBv7wHLWGQ&oe=6A316FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1qJ94JANZYQ7kNvwEs4wgo&_nc_oc=Adr3yawBewZnzdj61KjLy_xkeC3NBPXB2Ub8BoGSiMXrpiy7q3ZyL32o4_W3XrsWmyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rlMHV26BU589ftWIp5j4a84ayyqxy3vUN14W9gF6nng&oe=6A31645B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
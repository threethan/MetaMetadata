": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxaI4cSDVZgQ7kNvwFg6Ohg&_nc_oc=AdlOwFtg9jtCBqrX8gWUR4AxYngxkGa9dc63Ovy03NgwUohWv6ysE6vpDq3pD4yKYN8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKN8oBIeLeI_N0EF3O_ngmxPCyV8Skdq8EqRGUB24SmA&oe=69BD33A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxPz28IQE7gQ7kNvwEEqpEz&_nc_oc=AdkAIGRzM18pL34NWYaE_5TJvMJvoWwd33zdgMDgS5fjB5f-Klfxpeo9wzWxlSNWxi8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlRI35pAd91wo70VK937lm9m1ldrIMxGr_UALAmU8wsg&oe=69BD605B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.com/guitarkingvrdemo/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
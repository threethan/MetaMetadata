": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI9ZYUYiq5gQ7kNvwFcdNo-&_nc_oc=Adm9uIt__ZBu5DbvCVCzy_oy1NZHJ-UEDyZ5lDqN30W5Hf7DzC-WFYam43-7otyFIwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0-vx1YT2K3B2yc3LMUelkWJ-c8P68n-n2EDotW6vWhQ&oe=69B7EDA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAL4KjxX0J8Q7kNvwEXMG8l&_nc_oc=AdmHUes2sneymh9Ecatv5MhPU24X1mWu48eTODPJi-R6lym-dzLIas6m-qgB4gu2W_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-mjnU__1lFaTRCBjIxW29KUavJvAv2yJGCzPcfbQuLA&oe=69B7E21B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.com/guitarkingvrdemo/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
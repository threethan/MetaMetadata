4im8sjq51vXSWFgb9ssJ_jJTZYvvw&oe=6A5E0FD0"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgwo7cEQ68MQ7kNvwF5xf9X&_nc_oc=AdqzXhsuVZZiyKJk_ELTg0X0fLHMY9QK7nB2O9DQ7Chpgdpz3vPZqtoQcN-O_vmAZTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcGN6KxEHqgMaP0yTG5NctT-Mv-6Tj9kPe3t7aXTXCtQ&oe=6A5E0AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB4gVX3V15IQ7kNvwHVOUCV&_nc_oc=AdqQUtx2rv4H4CJEI8iH951FHO0Gk210gN7lny6L1OMXTRqnmEnSLCMIc8OjTlfL9vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlh0udXJG2rCSfFyc50kOdaUxeRa3xfxkOC0V0DyLFkw&oe=6A5E375B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
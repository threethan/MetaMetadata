_K_rW5qTTn1ws1jI9jfIfYa44uiug&oe=69E37450"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x0RwGzUfZ4Q7kNvwFXo586&_nc_oc=Adr4TI525HKJLk2NvfLr0YC4T__xGDQ0LbAYlmjKAImUiynpRS4JQTEB6uUv7sqVV5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ciQM0auBli9ZXYTLzL14KeDDlmBDYyAOeWBW8GV68vA&oe=69E36F21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=He5pQSSg3_AQ7kNvwE_wHGk&_nc_oc=AdrW130LsOlbxlz3ps1dLLVBIwImcc5VB5NeTOGLum1X42zJTL1ZId4IQC0kfVx-FPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EZVwo-FJA0hVbauRsYYfcwjpVD7oe8_nrCdiZ0fMYrA&oe=69E39BDB"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
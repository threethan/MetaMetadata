p1gdmVgH-e6c7tjE2PQg6Lqmplk6g&oe=6A523250"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvFrW22JlmgQ7kNvwEs88Or&_nc_oc=AdofKBpwtjHS_9jBueIlQKYHDfIU_CdKWXZLQHNRsF1KOifEV14ECp-H5ijuRHYaBTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEZwj4JQtX3Esvdjr12g6qKa0Toq6sqgCJlGS0YYYadA&oe=6A526561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZEmH-wautgQ7kNvwHE59gG&_nc_oc=Adre2f85YQ8zu0kMbpzMUxfgL426MHMhexlpdAL2IsVqbCy38AdgDOFZBus1tsm_Lj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRtSTpmYn668omUdnmwhZJMkujSECTEDYEDplD31ROYQ&oe=6A5259DB"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
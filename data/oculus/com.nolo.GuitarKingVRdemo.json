dqOyPtM6RaRuZ6EuAPTk9xXzfn3Dw&oe=69DCDCD0"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P68KGuCNhg8Q7kNvwGq6Rbr&_nc_oc=Adr-Uob2U2tXoBaE8kztCvYAkirhJQxW16y2r_YeXYMWzCYN_aE3AfXBQ3t0rp4ux3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SVlVbvPV6Ax4o222dS2_q6OutKACYzpFC66TPrFK3cw&oe=69DCD7A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xECvqcED4dYQ7kNvwH6dJxs&_nc_oc=Adon5WjcQWepyKj_0jzu0ZUck-Qf65aOGNntpB9n9lrN11EuVNRuIO7szpTcway98Xo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hxB53UOQdqC1py5BsE9TT2KwKmVOAvnkyMRLPYJwk9Q&oe=69DCCC1B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
N-b1vRCOnqpB2oNnvlR4LhkVHEHNA&oe=6A007550"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c639HU-cRsMQ7kNvwEx8uZE&_nc_oc=AdqfX1B6jm0RhYHyhZtcaxXwF-x7hiaHlvevcEJwhKJpHw8t8dQUKBlSu84vG_BzQH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60MTuA0Tqi4a7P4piPu3QavEED_Ln7lZPBG37CGp1U_A&oe=6A007021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ij--LSRXsoQ7kNvwGS_L_S&_nc_oc=Adr8kXKPfflyUwSft_X39rVcXJTT19H11vgRWrMAayuvFfKPZ6vMSbS89bMorEIOi5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ug4t7iLWHXfUO-h7XXYTL3cBBh7p8SOhvI6dtXykqAg&oe=6A009CDB"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
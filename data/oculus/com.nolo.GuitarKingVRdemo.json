MQzaJ1nK2KSgcRDAhYeKBkhfyw_hA&oe=6A9D57D0"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4L9v65qiugQ7kNvwFN9-W9&_nc_oc=AdrYtH0W3gG5PHFeXCF5OYX8bz-0aPn7-KKjbst4iEcnbsJXuroIjTxMcf6iggM0uWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu7TvUR3g1iAGJy67Txwgb0l9vuTraPVFCFCLthQRBzA&oe=6A9D8AE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lCeLh20bHEQ7kNvwFyjsXD&_nc_oc=AdoRoSfRsOlRzn-laAOKc8Z9KcHYaukFYn6NcHD5qFLjTS5dX2yg64Z_o0D_qVS58DQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoksuLM9aNeeC7sCnmVHJYQq48_kX1pLV6UMzowoZU8w&oe=6A9D7F5B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
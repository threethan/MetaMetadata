tBeBTM3F_cY4oPjvy2fG6lM_nkhaA&oe=6AB7EE10"}, {"file_name": "sc2.png", "id": "2011300969063217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974825_2011300972396550_8948445790155951819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbyyMnNcs0sQ7kNvwHyPFFp&_nc_oc=Adrhud_FRulnDkY06TN829DDB79ZxYlZbcCA4aZkpvbFP2Iw4i_aiB6n7DKk8IIQZvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAqYD3zMo5KAOSZcan_0TC1LWt78Y2r7orI3PDAk2j2A&oe=6AB7E8E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumpnail.png", "id": "1276983899808525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974908_1276983906475191_3618985222181112847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKvpZ_ZnQfEQ7kNvwFdMiNd&_nc_oc=AdpVS7vyFoctSW3BJrv_-qJx2H_UqQueIb_IKvo4HgKKCBV7I086IUYXuyHTTdTvH5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY_l4hX0cmb0uMfUwM0NU68HsabmENjQpfYm74F2a13Q&oe=6AB7DD5B"}, "display_name": "GuitarKingVR demo", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": "nolodesign", "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvrdemo/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.co
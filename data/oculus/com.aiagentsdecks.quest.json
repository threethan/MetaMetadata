c_sid=6e7a0a&_nc_ohc=_QvdbE-AR-MQ7kNvwHxwKWA&_nc_oc=AdorTD3ZgJP68TK-uk90BLoLTmdZzud7TuO-0nTPdMKmw6_omGb6u2fpA-ke1bYw2IQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQC55P5dzHQ0Ou1sp4H5UkTZSFTRt9AIMDwnFKSCANRpA&oe=6B0C7F58"}, {"file_name": "screenshot-3-new.png", "id": "2975789419456390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_2975789422789723_5375335450348698181_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VWmYqw7MncQ7kNvwFEajQb&_nc_oc=Adqq_S8HZA9Cnilsfn_rzK5w8EUnLFmqOT1NjHh3O2ecpXk-Ioa6TrgK2EWQXhvokZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR36DZPgGdhyGi7mLYso_qkK-skFUPhCgnmzDFRtu_UUw&oe=6B0C56DA"}, {"file_name": "screenshot-5-connect.png", "id": "1113998991250505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1113998994583838_473691601382447639_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omV20xXzM0cQ7kNvwHy7kE8&_nc_oc=AdqzUUM0IkgYSyeT5MFdYY7xdNDcjDlghDY7B-nx0pvvfbNojsV9AS3jVp56hRWsLxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhj1EL3O409btsyxtjtBtgKU32AcRqAWK_DRn56c775Q&oe=6B0C5B66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AI Agents Decks", "keywords": [], "long_description": "AI Agents Decks turns your Meta Quest into a command deck for AI coding agents.\n\nInstall the free Deck Host on your Mac, Windows PC or Linux machine (one line from aiagentsdecks.com), open AI Agents Decks, pick your computer and type the code it shows.\n\nWHAT YOU GET\n\u2022 The wall \u2014 every agent is a channel with a light: working, needs you, done, error or idle.\n\u2022 Needs-you queue \u2014 permission prompts and finished work wait in one place.\n\u2022 Real terminals \u2014 the agent's actual terminal, drawn sharp by the headset, not streamed as video.\n\u2022 Talk back \u2014 type or dictate with the Quest keyboard; quick keys for Enter, Esc, arrows and Ctrl-C.\n\u2022 Start agents from the headset \u2014 pick a project, Claude Code, Codex or a shell, optionally in its own git worktree.\n\nAI AND YOUR DATA\nAI Agents Decks contains no AI model and calls no AI service. Claude Code and Codex are separate tools you install and sign in to on your own computer; they talk to their providers (Anthropic, OpenAI) under your accounts and terms, exactly as without a headset. We share no Meta account, user or device data with them or anyone else. Terminal text goes only between the headset and your computer on your local network, encrypted. Privacy and data deletion: aiagentsdecks.com/privacy\n\nREQUIREMENTS\n\u2022 Deck Host (free) on macOS, Windows 10/11 or Linux x64, on the same network as the headset.\n\u2022 Claude Code and/or Codex installed and signed in on that computer, if you want to run them.\n\nNot affiliated with Anthropic or OpenAI.", "short_description": "Run Claude Code, Codex and any shell on your Mac, Windows or Linux computer from your Meta Quest. Every agent gets a channel on your deck: one look tells you who's working, who's done and who needs you. Answer permission prompts, read real terminals and start new agents from the headset. No AI model inside and no Meta account data shared: the agents run on your computer under your own accounts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aiagentsdecks.com/privacy", "developer_terms_of_service_url": "https://aiagentsdecks.com/terms", "publisher_name": "AI Agents Decks", "support_website_url": "https://aiagentsdecks.com/#faq", "website_url": "https://aiagentsdecks.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": 
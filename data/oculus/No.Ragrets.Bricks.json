8"}, {"file_name": "Store screenshot D.png", "id": "480971648434463", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001662_480971655101129_6064421927720784354_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVnyjibF-GsQ7kNvwGRDDR9&_nc_oc=AdkQSF8quhUSxVw0nku-775bFhgnX2Oud_mlA9VyMR78vP0-AJJedqkKdfrRV4Qsi2w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs8DDARupd2AljdT3DhES3LwY4u9xhkAd9z41nyt3xk1A&oe=699C59C8"}, {"file_name": "Store screenshot C.png", "id": "1683707145528823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75508956_1683707148862156_8286553196679635241_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUj3QjGh7k0Q7kNvwG-s4y0&_nc_oc=AdmadxjGSiMtD0WQaoRgou-1PCioz4ZafZVJ1OBXF29AzdfXW6aQeiTub-bAFqxV7pQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft2Yh7dqh5uyLgij5hneWOFbGKMEVAO9_vRVsPWyiMrPA&oe=699C4F54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cues Landscape v2.png", "id": "1206096493787337", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75272208_1206096497120670_6286030136535771041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79dXhj3DeXgQ7kNvwHz0nrd&_nc_oc=Adn9WP8iei73Ws0fNWRVTdDzvLSqOUNmA98nEyCXsJAncU0ngDHPJPtBgKj-F2Wocns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftBIKlPUe6N2Spp6Yugw2dYSOn_ajJIUKrqHs20egpnNQ&oe=699C3FFB"}, "display_name": "Cues", "keywords": ["brick", "breaker", "mixed", "hand", "magic"], "long_description": "# [Free for a limited time: get it now, own it forever]\n\nIntroduce your friends and family to the magic of mixed reality with **Cues**.\n\n- \u201cIt looks amazing. One of the coolest looking MR games I\u2019ve seen\u201d \u2013 Matt BMFVR\n\n{557242276938737}\n\nDive into **Cues**, a **hand-tracking** experience where music meets motion. \n\nWield bouncing light orbs to shatter \"cues\" and unravel puzzles, all while crafting a **dynamically evolving symphony** influenced by your every move. Enjoy a relaxed, soothing game that constantly evolves, offering new challenges and surprises.\n\nIdeal for brief, engaging sessions, 'Cues' converts any room into a vibrant arena of musical puzzles.\n", "short_description": "Introduce your friends and family to the magic of mixed reality with Cues.\n\n- \u201cIt looks amazing. One of the coolest looking MR games I\u2019ve seen\u201d \u2013 Matt BMFVR\n\nDive into Cues, a hand-tracking experience where music meets motion. \n\nWield bouncing light orbs to shatter \"cues\" and unravel puzzles, all while crafting a dynamically evolving symphony influenced by your every move. Enjoy a relaxed, soothing game that constantly evolves, offering new challenges and surprises."}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "PotamWorks SAS", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8781092281948442"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1337039211527376"}, {"status": "PUBLISHED", "id": "1546518893242436"}, {"status": "PUBLISHED", "id": "1158045852985998"}, {"status": "PUBLISHED", "id": "4184804641790273"}, {"status": "PU
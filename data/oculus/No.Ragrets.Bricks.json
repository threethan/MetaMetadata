0723", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036703_576173451444056_2815308939854354726_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBpliihEt1QQ7kNvwFogjuv&_nc_oc=AdpqUhKECTQRBwACWTUHqqZqol9XxCn4syZkLkV9zZgUZOgPLJxvbNKyWrpUrcWVuyY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvR2Tm-wyNL8kvQogJfkB3aNEj6W9uqF6rp42pfdebAg&oe=6A8582A8"}, {"file_name": "Store screenshot D.png", "id": "480971648434463", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001662_480971655101129_6064421927720784354_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDGVU1yvP2IQ7kNvwFUDye3&_nc_oc=AdryZNVDLLXsZMtdPydeMHqU4jSKH1lrv4tWx54xuwWDJtsbh90FscgtC9YIiPOSrNY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuJHGImUzSLPElC9e1VA5uIPRMwaLj5LCn1Rlr3qZ5wA&oe=6A857B08"}, {"file_name": "Store screenshot C.png", "id": "1683707145528823", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75508956_1683707148862156_8286553196679635241_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSynWEAjoPcQ7kNvwHZ-TH6&_nc_oc=AdrYKGqXFWsR1Kc_WjcXxgQxqmNVtU_eoL4vEI5gRWdw5MgvsKoNDJakio7lv_kF1SI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEjkSJ4GpTfG3nNyEMLzapMSOzm_05FZ7zrzyUhraYdA&oe=6A85A8D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cues Landscape v2.png", "id": "1206096493787337", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75272208_1206096497120670_6286030136535771041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ehe3gIlV24Q7kNvwHi8jNI&_nc_oc=Adpu5YHuc5ZwkN6yKjNF4fTJPpvS_JLUUxcEKd2NWadQ6w1YF4RBYp2-mnfhleM8zQY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw99rzaR5sg7bsqdVIIicJrnW8DVOwCMXn7vRqrVj--g&oe=6A85997B"}, "display_name": "Cues", "keywords": ["brick", "breaker", "mixed", "hand", "magic"], "long_description": "Introduce your friends and family to the magic of mixed reality with **Cues**. Dive into a **hand-tracking** experience where music meets motion. \n\n**NEW:** Creator mode lets you build anything you want with cubes. From tiny models\u2026 to living-room fortresses.\n\n- \u201cIt looks amazing. One of the coolest looking MR games I\u2019ve seen\u201d \u2013 Matt BMFVR\n\n{557242276938737}\n\n\nWield bouncing light orbs to shatter \"cues\" and unravel puzzles, all while crafting a **dynamically evolving symphony** influenced by your every move. Enjoy a relaxed, soothing game that constantly evolves, offering new challenges and surprises.\n\nIdeal for brief, engaging sessions, 'Cues' converts any room into a vibrant arena of musical puzzles.\n", "short_description": "Introduce your friends and family to the magic of mixed reality with Cues. Dive into a hand-tracking experience where music meets motion. \n\nNEW: Creator mode lets you build anything you want with cubes. From tiny models\u2026 to living-room fortresses.\n\nWield bouncing light orbs to shatter \"cues\" and unravel puzzles, all while crafting a dynamically evolving symphony influenced by your every move. Enjoy a relaxed, soothing game that constantly evolves, offering new challenges and surprises."}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "PotamWorks SAS", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
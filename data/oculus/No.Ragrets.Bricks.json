110723", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39036703_576173451444056_2815308939854354726_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7JLPvx4TqcQ7kNvwE7JmHk&_nc_oc=AdqMj8F4HsVotPQWnKQptyAjtPej5ioi1zSvJcto6Lr2jm4kral2MqY5EK85lCQ33wc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDXXnV-bXjLHWk5oTVuHG34IqFzTRfxgqeoyp4uwNBqg&oe=6AAE9968"}, {"file_name": "Store screenshot D.png", "id": "480971648434463", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001662_480971655101129_6064421927720784354_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuIARTvULmoQ7kNvwGLX4Bk&_nc_oc=AdpfIT4qQLFeN6SnL0GULUN_qa4SD8pa7-Xv-C1FSP46tYOTNvVOK_xfEJkIz8DkcNc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEpTh7jPmzcOKCfdwAhSkYLFgIqnJL29BQj6EpoVFFcg&oe=6AAE91C8"}, {"file_name": "Store screenshot C.png", "id": "1683707145528823", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75508956_1683707148862156_8286553196679635241_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loOlIU_z-nEQ7kNvwHtkHQm&_nc_oc=AdruZT9ure7m_XltA8wHk0_3euHLB1ONad5hRVRmRfe6mQ0RWEZAjtuW-sT-Yqsw3Bg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQyFo5A06UJuY4yC1fLlL-BofZItcZi4HPdGyBgZ1r6g&oe=6AAE8754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cues Landscape v2.png", "id": "1206096493787337", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75272208_1206096497120670_6286030136535771041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBrE93BwHMYQ7kNvwHPM1XY&_nc_oc=AdrNApLL0MplAqNo2QxTBYAqfs9sjUZdVSvmgJvfOfIUC3ML5WN6WqA-1LkgW9qbIFQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1ZpHdyrbtwqA-fWiXqJlcOdubz8r6_YMA5xsYORWTqQ&oe=6AAEB03B"}, "display_name": "Cues", "keywords": ["brick", "breaker", "mixed", "hand", "magic"], "long_description": "Introduce your friends and family to the magic of mixed reality with **Cues**. Dive into a **hand-tracking** experience where music meets motion. \n\n**NEW:** Creator mode lets you build anything you want with cubes. From tiny models\u2026 to living-room fortresses.\n\n- \u201cIt looks amazing. One of the coolest looking MR games I\u2019ve seen\u201d \u2013 Matt BMFVR\n\n{557242276938737}\n\n\nWield bouncing light orbs to shatter \"cues\" and unravel puzzles, all while crafting a **dynamically evolving symphony** influenced by your every move. Enjoy a relaxed, soothing game that constantly evolves, offering new challenges and surprises.\n\nIdeal for brief, engaging sessions, 'Cues' converts any room into a vibrant arena of musical puzzles.\n", "short_description": "Introduce your friends and family to the magic of mixed reality with Cues. Dive into a hand-tracking experience where music meets motion. \n\nNEW: Creator mode lets you build anything you want with cubes. From tiny models\u2026 to living-room fortresses.\n\nWield bouncing light orbs to shatter \"cues\" and unravel puzzles, all while crafting a dynamically evolving symphony influenced by your every move. Enjoy a relaxed, soothing game that constantly evolves, offering new challenges and surprises."}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "PotamWorks SAS", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
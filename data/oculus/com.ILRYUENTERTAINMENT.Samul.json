t=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJqCnKS1xMfOEmz3_YuXSmpDXQlivJZTF-pim2QripUA&oe=6AF08F9A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjaIwZNCxBIQ7kNvwEj-Vv2&_nc_oc=Adqoht1oiJbFoYsOg9bo7PygwWmjtMcBzla1KwsXJUSliWBsrpgjSstRq0lNtQe8Pm0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6-p16ClRgl31P49NNXGas2xk1-yl0N2s_faQcY-vC_g&oe=6AF09764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpn5m2-clVEQ7kNvwEPWQ8B&_nc_oc=Adom8Kayd-sCZEuzJwd4wcz80UNq5i1JZqjbBjFez5rRrLCVQ-qD6FhbC5XoqS3zF7c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs6xVQdCPOJWehRR5mR4I9FcFUWvRd78SUM6GYU7IuQg&oe=6AF098A0"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}, {"images": {"nodes": [{"file_name": "CoverArt2_1440x1440.png", "id": "2177465706167630", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593862973_2177465712834296_5116148648534398662_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boHNajW_cqYQ7kNvwGrP5eg&_nc_oc=Adp_nd1neVIFo74ScX4L0RSpxvOLjgV6iyWGxUac_3W-IfuCLwNeg9zIzclDTHa4j34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4aMDiXwRze4tovFbkOvjLIsBKbZODCCT9os9FDwWTlA&oe=6AF08B9A"}, {"file_name": "CoverArt2_1008x1440.png", "id": "2140165379940150", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627502_2140165383273483_6946379890060387892_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEgKv6NBe5EQ7kNvwH0r9YH&_nc_oc=Ado08Gr3yowYh-9fg4y0TQKfk-6mtzZt5EE4KZcfjYYO0mTgLJQ9JEanLCHJaXWoHdE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQAiwjHSbXdVGg3Ijg7CglHvu-rHEZfz0bNgA8ZdGbMA&oe=6AF085DB"}, {"file_name": "Icon_fore.png", "id": "2135137273734421", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t
uluscdn.com&_nc_ss=7f20f&oh=00_AQRHTY9l3eF0WxeTwj3hBO80Pl7qqUIy1SL3Vg-QZuaJig&oe=6AF1F162"}, {"file_name": "Screenshot5.png", "id": "1065996125906974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628909_1065996129240307_3169985312360989540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiAwEkeMnAgQ7kNvwGsDYdp&_nc_oc=Adqy5QLQaGIHgo7E4NciVEOzmK_OZYUdR1sOMXQ0E6Ww_NiYHbav2jAo3LcCXgla4TU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfWBz_9EvP07wroDZ6rEZnQWRRwvgoarCGMQ5tJnl-OA&oe=6AF1D543"}, {"file_name": "Screenshot4.png", "id": "1075062678256501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620341_1075062681589834_2329271733061046441_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmpcDhn7Ho8Q7kNvwEUOXgF&_nc_oc=AdoUjJCGqGwMBtGUvyPnavnRnvuMRTnWSvCfFO1Fyxk2AOtAc5eVdVL7nBonVVeKOig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVaybU87vYZa3ZLmDDpAOrMO6alagvElOnzuVOtZfIKg&oe=6AF1EEF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28132396763108053"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2605296993280511"}]}, "baseline_offer": {"id": "2605296993280511"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789630200, "status": "PUBLISHED", "id
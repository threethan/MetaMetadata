content-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQeLN1r8OMPzNSDxW9lCUZJ4iNbRv2aYwasiGI9lksMw&oe=6AFDC352"}, {"file_name": "Screenshot3.png", "id": "1629497431935258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593714175_1629497435268591_8866738098595219746_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f9Y7yR_bgQQ7kNvwHYGQ-Q&_nc_oc=AdqpoALnimmB8ZKND9mnuRETLNtVIjGl7iqD390BzgOz87gSwNrUywLdiw8Ft9ebm-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG6nxt942tZRot6OIXSTqqdvbrbTup2cn5D8aKjrMfPw&oe=6AFDE3AB"}, {"file_name": "Screenshot6.png", "id": "2077216732893132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628092_2077216736226465_4551385857667506483_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM8kQWNOyI8Q7kNvwFOg6IZ&_nc_oc=AdoTUIJ1iLZQCmvlZT9nlIfLM8LBYryyP8EaOZijPI1t8a0TXNRYpYto7hRfhutPNYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRrYW77FuJlHcjZE9zMcMayjoS9gP-G6o6UbVrxaTsbw&oe=6AFDCEE2"}, {"file_name": "Screenshot5.png", "id": "1065996125906974", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628909_1065996129240307_3169985312360989540_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NoBcDxPyFQQ7kNvwG_P6bF&_nc_oc=AdoIGmIwwEKOkP091ezwo_PI7XEdAQLPkYbmZpI2F7H4f-DTsuFqmDaNWFRoEFMENws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjqeA0ha0OFUew_oiUG63l145OXhYSM9S8UI9pzhbtBQ&oe=6AFDB2C3"}, {"file_name": "Screenshot4.png", "id": "1075062678256501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620341_1075062681589834_2329271733061046441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIvYKoN7pJgQ7kNvwHnWXv_&_nc_oc=AdoUYIvzZy759uTvz8FMyIeBXFAFEywouexTVVHiyhWAPSOC_2URK3rPqXuBkxiHJko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEEsfFM6MenVWSpTRd2cFUQlAjeKp_Ekpm0s3c5qzIRA&oe=6AFDCC73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYIN
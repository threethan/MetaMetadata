.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AetIkmhlrfMQ7kNvwHXtPL3&_nc_oc=AdrvJbeqmOB0OphvR_GTiQaLGCi_eAQ6cFPPRJVCAREPQ2Dr-S3iCakJn3gS0zp3bjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi91LMVIS0wozQoflPJBdC3juRuieOtrt6nP_-a9hlWg&oe=6AF4A387"}, {"file_name": "Screenshot5.png", "id": "2078560656383742", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593869844_2078560659717075_2494566885727023582_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CYTciS6lx8Q7kNvwHRBNul&_nc_oc=Adr93wGQVxd_srppL8XY-WNp5Z2zNCMsR5zH8loU51NmjrO_ZucHG3sYtn-Q8LuOdQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbHS9orO5pad0as-qh-zBbo9RvjmOXUoIxydVHR6aUfA&oe=6AF489A2"}, {"file_name": "Screenshot4.png", "id": "1389133363419318", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_1389133366752651_3324269032578527917_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKjhKkCagZEQ7kNvwEy-54L&_nc_oc=Adqahr0T9uhTdK7w-kIJZptuBsQjtHsOXpx6iLpAZ71w8E8FZQcuTwxDgHAzdt7rFyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQZgrOD0T63D9t7AoEE9nGTBCm0AyyXzGZvOo6QnCqKw&oe=6AF472A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uc5bc\uc464! : \uc7a5\uad6c \uadf8\ub8e8\ube0c", "keywords": ["\uc7a5\uad6c", "\uc545\uae30", "\ub9ac\ub4ec", "\ub9ac\ub4ec\uac8c\uc784", "\uc74c\uc545"], "long_description": "# 1. \uc2e4\uac10 \ub098\ub294 3D \uc7a5\uad6c \uc5f0\uc8fc\n\n**\uc190\ub05d\uc73c\ub85c \uc804\ud574\uc9c0\ub294 \uad6d\uc545\uc758 \uc6b8\ub9bc**\n\n\uc6b0\ub9ac \uc804\ud1b5 \uc545\uae30 \uc7a5\uad6c\uc758 \uc815\uad50\ud55c \uad6c\uc870\ub97c VR \uacf5\uac04\uc5d0 \uc0dd\uc0dd\ud558\uac8c \uad6c\ud604\ud588\uc2b5\ub2c8\ub2e4. \uc591\uc190\uc5d0 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc950\uace0 \ucc44\ud3b8\uacfc \uad81\ud3b8\uc744 \uc9c1\uc811 \ub450\ub4dc\ub824 \ubcf4\uc138\uc694. \uc2e4\uc81c \uc7a5\uad6c\ub97c \uc5f0\uc8fc\ud558\ub294 \ub4ef\ud55c \ubb35\uc9c1\ud558\uace0 \uc0ac\uc2e4\uc801\uc778 \ud0c0\uaca9\uac10\uc774 \ub2f9\uc2e0\uc758 \uc190\ub05d\uc744 \ud1b5\ud574 \uace0\uc2a4\ub780\ud788 \uc804\ud574\uc9d1\ub2c8\ub2e4. \uac00\uc0c1 \ud604\uc2e4 \uc18d\uc5d0\uc11c \ub2f9\uc2e0\ub9cc\uc758 \uc2e0\uba85 \ub098\ub294 \uc7a5\ub2e8\uc774 \ud3bc\uccd0\uc9d1\ub2c8\ub2e4.\n\n# 2. \ubab0\uc785\uac10 \ub118\uce58\ub294 \uce58\uc720\uc758 \uacf5\uac04\n\n**\uace0\uc988\ub109\ud55c \ud55c\uc625\uc5d0\uc11c \ub9cc\ub098\ub294 \ud790\ub9c1**\n\n\uac00\uc7a5 \ud55c\uad6d\uc801\uc778 \uacf5\uac04, \ud55c\uc625\uc758 \uace0\uc694\ud55c \uc544\ub984\ub2e4\uc6c0\uc744 \uacbd\ud5d8\ud574 \ubcf4\uc138\uc694. \ud3c9\ud654\ub86d\uace0 \ub530\uc2a4\ud55c \ud587\uc0b4\uc774 \ube44\uce58\ub294 \ud55c\uc625 \uc815\uc6d0\uc5d0 \uc549\uc544 \uc7a5\uad6c\ub97c \uc5f0\uc8fc\ud558\ub2e4 \ubcf4\uba74, \uc5b4\ub290\uc0c8 \uc77c\uc0c1 \uc18d \uc9c0\uce5c \ubab8\uacfc \ub9c8\uc74c\uc758 \uc2a4\ud2b8\ub808\uc2a4\uac00 \uc53b\uc740 \ub4ef\uc774 \uce58\uc720\ub418\ub294 \ud3b8\uc548\ud568\uc744 \ub290\ub084 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc74c\uc545\uacfc \uacf5\uac04\uc774 \uc5b4\uc6b0\ub7ec\uc9c4 \uc644\ubcbd\ud55c \ubab0\uc785\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4.\n\n# 3. \ucd08\ubcf4\uc790\ubd80\ud130 \uc219\ub828\uc790\uae4c\uc9c0 \uc990\uae30\ub294 \ub2e4\uc591\ud55c \uac00\ub77d\n\n**\ub3c4\uc804 \uc758\uc2dd\uc744 \uc790\uadf9\ud558\ub294 \uc2e0\uba85\ub098\ub294 \uc6b0\ub9ac \ub9ac\ub4ec**\n\n\uac00\ubccd\uac8c \ubab8\uc744 \ud480\uba70 \uc7a5\uad6c\uc640 \uce5c\ud574\uc9c8 \uc218 \uc788\ub294 \uc26c\uc6b4 \uc7a5\ub2e8\ubd80\ud130, \ubab0\uc544\uce58\ub294 \uc18d\ub3c4\uac10\uc5d0 \uc5b4\uae68\uac00 \ub4e4\uc369\uc774\ub294 \ube60\ub974\uace0 \uc2e0\uba85 \ub098\ub294 \uac00\ub77d\uae4c\uc9c0! \ubaa8\ub4e0 \ub808\ubca8\uc758 \uc720\uc800\ub97c \uc704\ud55c \ub2e4\uc591\ud55c \ub09c\uc774\ub3c4\uc758 \ud2b8\ub799\uc774 \uc900\ube44\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788, \ud55c\uad6d \uc804\ud1b5 \uac00\ub77d \ud2b9\uc720\uc758 \ub3c5\ud2b9\ud55c \ub9ac\ub4ec\uc740 \uc720\uc800\ub4e4\uc758 \uc2b9\ubd80\uc695\uacfc \ub3c4\uc804 \uc2ec\ub9ac\ub97c \ub04a\uc784\uc5c6\uc774 \uc790\uadf9\ud560 \uac83\uc785\ub2c8\ub2e4.", "short_description": "\uc7a5\uad6c\ub97c \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \ub450\ub4dc\ub9ac\uba70 \ud55c\uad6d\uc758 \uc804\ud1b5 \ub9ac\ub4ec\uc744 \ub290\uaef4\ubcf4\uc138\uc694!"}, {"images": {"nodes": [{"file_name": "CoverArt_3000x900.png", "id": "2536086246904225", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622188_2536086250237558_245232128610153041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmHl4_iyCpAQ7kNvwEi0LEK&_nc_oc=Adof2hmRqnIRXoAU7FzHGfusemPYMS5cygp7-cAgMUh4Eh5X_ahJBQ_qEZkr1RNqzdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE0_ReG71JzrlGwZbM4OVZ0h-m2cIwk4xsXFgFfyrWIg&oe=6AF472A2"}, {"file_name": "CoverArt_1008x1440.png", "id": "1755031873292961", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622192_1755031879959627_2273003989182718084_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QluI4jzaU_0Q7kNvwFuKlaK&_nc_oc=AdqnBKygkuRmWvZWMbEQ84ftnxvXMl8xjVnrHc8CXSS1oVpL1UNuk9BkPJf2W9JeSGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcVzl-XU0TwCTaHeGFGkaYQNa4Y5Yp3IhqCx-oVrHwxg&oe=6AF474B4"}, {"file_name": "Icon.png", "id": "1707531250544855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620655_1707531253878188_870020487884309751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTa8wCsVDWcQ7kNvwH9XtD4&_nc_oc=AdoFm-wkOJBtzv-NC9tS7OXzODhA_PdlghOeXkmOXSehLJZouQI3nb6NEMSW2u1cAls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7q2rZl7v1yADJqEXFxKZB9xgSiyKYTbtZAlPn5VgP6g&oe=6AF47EDB"}, {"file_name": "TitleLogo.png", "id": "1378345550394480", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620532_1378345553727813_549368970596305
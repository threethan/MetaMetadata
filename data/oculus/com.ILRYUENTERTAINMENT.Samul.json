c=AdpbNmW7jGxjUkzmm_PeBdX0TFQDuv7EaWCugEctwKor6qLUFfy1wAGK-aLyv8tHmG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtfmNGSUHoyPt4-fIWEAxb1Y-ppubcvHDsOKMojZx7uw&oe=6AF73261"}, {"file_name": "Screenshot3.png", "id": "1763697207999657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624069_1763697211332990_1089881132157114000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg4TCObAW2cQ7kNvwHvluJ7&_nc_oc=AdrYpRzPxbOjpKcag3C4QhYgqtEglB-7-P_Gi8u9CohGYBi6tlkXEdTrTWPwO4pKBLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjDkB22MLSPI_s0mJQ-jcjQeZbARx4AePbNPl6Nqap6g&oe=6AF731DF"}, {"file_name": "Screenshot6.png", "id": "1063125629837079", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620630_1063125633170412_6982419681255657319_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVSi3WyFY5EQ7kNvwEJC_ZV&_nc_oc=AdpfpcRAAVuosL7ZbUl5Uvj3lNwrvtR14up1s9ru77FBBU_r5tYf0YP1aYR8gFkdgBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-mCd-K4khgstjUjJjqgxU8QQLibqd8djgghVjU-7jiw&oe=6AF71731"}, {"file_name": "Screenshot5.png", "id": "1391477766388251", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499627379_1391477769721584_1532814487938229684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKOIhueISqMQ7kNvwGIMBEc&_nc_oc=AdqaoqC6SXVyjXvgDwrGOeF37U4uxXy4WQ2jp12Ab5pIUc-KVdg1ina2H1w6syu28bA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPi2Bktnb12D-HfohfWGEQWnGGo0k1RVzQurhyY9b38A&oe=6AF7271A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhVlTj7WpgAQ7kNvwHqKyy8&_nc_oc=AdoyA94Xk4BtfugZkOAd31tsRNnGbMqx5VOFOkBTGWUWvqpdeSJIeCdBngy2Riq1oJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUfn_56N_0AaJHASBwi-Ig3qJUu7O58l59R-byt-Cmaw&oe=6AF72EE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rCidhS84_4Q7kNvwFV5XvB&_nc_oc=Adocjpi8FlVLUh2ITsN87L_YLZ7W5Cj1VCZtzEMBG37oyYlUBUKL4d394EQDNpwKFvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ75_heUu0B0TkETa5Udm7GcOsPS07q4tGjmAJK1QBwvg&oe=6AF73020"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28989066470774407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593966611_2121447285163858_5679348738960112914_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmVAtbHK_VUQ7kNvwHfdgqc&_nc_oc=AdrfM4prz3K8e-DAi2ZNOZt3ROA0KWqD8je1LF9nnIjO-63S2s2RQxg1Beep_FFy3Bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuBT4FwrR21bXWCxZ1acjUNpKZJsgEyALWCoIAYR5L2A&oe=6AF74311"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EOLSSU! : Groove of the Janggu", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, 
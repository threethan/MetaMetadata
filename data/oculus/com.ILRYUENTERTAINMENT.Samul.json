cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKZjjlfnA1AQ7kNvwEjoylR&_nc_oc=Adpeosb-DC63QcMjm7yoZqDGXcc_zW4NjKL7ujjepdCLU0RlpAm4KoeSXdDAqzQrV70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS738Zoi1aWJSc2_7IKA5c6y_C-rHnXlTQyIdDAgzAHg&oe=6B0C639F"}]}, "id": "1854411812221266", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1420605726673922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593801605_1420605730007255_7352116411094725626_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jejzcVkelQUQ7kNvwH9_ING&_nc_oc=AdoIQ2ugSNE_NCfpAbFPpH1fMD7UzqSByG-FdrP5Lq4StkZE11aWb8DDiMk3Qkm0Nf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRadyQpVIMaC41_r_1PAqogAwkuexxbvUNYCGaJtYigSA&oe=6B0C4A61"}, {"file_name": "Screenshot3.png", "id": "1763697207999657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624069_1763697211332990_1089881132157114000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rF8KjyQsyEQ7kNvwHTDown&_nc_oc=Ado0cgYNFb1Fyo5khH12JWx7qM01Ht8edQay1GDDB0wjfp8E2KVFh5klPFKB5UVbQ7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJd-1tatCyiADbltkrICPcxkzMuG6wmlIhegwy63fo9Q&oe=6B0C49DF"}, {"file_name": "Screenshot6.png", "id": "1063125629837079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620630_1063125633170412_6982419681255657319_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FI3IcMJ918Q7kNvwH7Q4B0&_nc_oc=AdodKSGyshMvecSABnD8XEesThbodXA8qeXbDaUBU_QghZl-IpZZaWxWc_7kcS8uyrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRV1e01lXv9rBxi-tzLSigguwhUTYOXZb4yvCnH1rwu7g&oe=6B0C6771"}, {"file_name": "Screenshot5.png", "id": "1391477766388251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627379_1391477769721584_1532814487938229684_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4CRwYWW51wQ7kNvwFJOWzA&_nc_oc=AdqBox1u_Dn6Cp8Xx7T7dMwj1Giqbuhs8c6Gx15PouWW2TrGtoWnXU07Avw222D3jYw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBCtdPxMHIbENTwKbGeCn0KsodYGpQ9-LIjoMm3Pqbbw&oe=6B0C775A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12SPw-IFX-4Q7kNvwExxaxn&_nc_oc=AdoHxwb5pikmJQHW8_PCTdW1zrhHqACoK7hlLuvQbe88RSGm2h_LwIb6et0yJQnipwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBvQNMf7-g8-UCPelXcMB1zIbBEjOAsWX9BsYXCUCJug&oe=6B0C7F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II3hgUcyyZsQ7kNvwH5fciq&_nc_oc=AdquQbty_-CeCi016c79l9BbPmS9eZRaLQr7JeaPYWx2DA6X2hvH7-TuhxCSyrKiJY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlxrNRSi_j7cMtF0Hoq-daaLETMVRMs9QWoa3iL-0Yzw&oe=6B0C8060"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28989066470774407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593966611_2121447285163858_5679348738960112914_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAyiIFd4Ay0Q7kNvwHUyzz3&_nc_oc=Adq_GaGwW9WMlAX03b_pyA6c2MxEcd4brM2L7KJLFk8zWpm9x3oFVjbDHzeshDslhp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxzwLOS9fEqa6D--mpTafKtNmt_H_THyDzHCHpvxxlTw&oe=6B0C5B11"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EOLSSU! : Groove of the Janggu", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1789630200, "lastRevision": {"nodes": [{"id": "24957082133972881", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24957082080639553", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1138679631641295"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon_fore.png", "id": "2135137273734421", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622186_2135137277067754_907147793296955011_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BD_a9TD5uoQ7kNvwEYx8so&_nc_oc=AdqOdNBcwIGpcCn2zGn_ZuucMBN1a5pEQxeVz6efVwLWczUxJKzgjawu0TVLfPBPRfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfLEXse6c57upKTeILYMTJpdfqK2XV1qVXl57ZZymEJg&oe=6B0C5088"}, {"file_name": "CoverArt_2560x1440.png", "id": "1950115088997805", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626
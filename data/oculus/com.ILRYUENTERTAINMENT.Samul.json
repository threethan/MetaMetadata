c \uad6c\ud604\ud588\uc2b5\ub2c8\ub2e4. \uc591\uc190\uc5d0 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc950\uace0 \ucc44\ud3b8\uacfc \uad81\ud3b8\uc744 \uc9c1\uc811 \ub450\ub4dc\ub824 \ubcf4\uc138\uc694. \uc2e4\uc81c \uc7a5\uad6c\ub97c \uc5f0\uc8fc\ud558\ub294 \ub4ef\ud55c \ubb35\uc9c1\ud558\uace0 \uc0ac\uc2e4\uc801\uc778 \ud0c0\uaca9\uac10\uc774 \ub2f9\uc2e0\uc758 \uc190\ub05d\uc744 \ud1b5\ud574 \uace0\uc2a4\ub780\ud788 \uc804\ud574\uc9d1\ub2c8\ub2e4. \uac00\uc0c1 \ud604\uc2e4 \uc18d\uc5d0\uc11c \ub2f9\uc2e0\ub9cc\uc758 \uc2e0\uba85 \ub098\ub294 \uc7a5\ub2e8\uc774 \ud3bc\uccd0\uc9d1\ub2c8\ub2e4.\n\n# 2. \ubab0\uc785\uac10 \ub118\uce58\ub294 \uce58\uc720\uc758 \uacf5\uac04\n\n**\uace0\uc988\ub109\ud55c \ud55c\uc625\uc5d0\uc11c \ub9cc\ub098\ub294 \ud790\ub9c1**\n\n\uac00\uc7a5 \ud55c\uad6d\uc801\uc778 \uacf5\uac04, \ud55c\uc625\uc758 \uace0\uc694\ud55c \uc544\ub984\ub2e4\uc6c0\uc744 \uacbd\ud5d8\ud574 \ubcf4\uc138\uc694. \ud3c9\ud654\ub86d\uace0 \ub530\uc2a4\ud55c \ud587\uc0b4\uc774 \ube44\uce58\ub294 \ud55c\uc625 \uc815\uc6d0\uc5d0 \uc549\uc544 \uc7a5\uad6c\ub97c \uc5f0\uc8fc\ud558\ub2e4 \ubcf4\uba74, \uc5b4\ub290\uc0c8 \uc77c\uc0c1 \uc18d \uc9c0\uce5c \ubab8\uacfc \ub9c8\uc74c\uc758 \uc2a4\ud2b8\ub808\uc2a4\uac00 \uc53b\uc740 \ub4ef\uc774 \uce58\uc720\ub418\ub294 \ud3b8\uc548\ud568\uc744 \ub290\ub084 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc74c\uc545\uacfc \uacf5\uac04\uc774 \uc5b4\uc6b0\ub7ec\uc9c4 \uc644\ubcbd\ud55c \ubab0\uc785\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4.\n\n# 3. \ucd08\ubcf4\uc790\ubd80\ud130 \uc219\ub828\uc790\uae4c\uc9c0 \uc990\uae30\ub294 \ub2e4\uc591\ud55c \uac00\ub77d\n\n**\ub3c4\uc804 \uc758\uc2dd\uc744 \uc790\uadf9\ud558\ub294 \uc2e0\uba85\ub098\ub294 \uc6b0\ub9ac \ub9ac\ub4ec**\n\n\uac00\ubccd\uac8c \ubab8\uc744 \ud480\uba70 \uc7a5\uad6c\uc640 \uce5c\ud574\uc9c8 \uc218 \uc788\ub294 \uc26c\uc6b4 \uc7a5\ub2e8\ubd80\ud130, \ubab0\uc544\uce58\ub294 \uc18d\ub3c4\uac10\uc5d0 \uc5b4\uae68\uac00 \ub4e4\uc369\uc774\ub294 \ube60\ub974\uace0 \uc2e0\uba85 \ub098\ub294 \uac00\ub77d\uae4c\uc9c0! \ubaa8\ub4e0 \ub808\ubca8\uc758 \uc720\uc800\ub97c \uc704\ud55c \ub2e4\uc591\ud55c \ub09c\uc774\ub3c4\uc758 \ud2b8\ub799\uc774 \uc900\ube44\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788, \ud55c\uad6d \uc804\ud1b5 \uac00\ub77d \ud2b9\uc720\uc758 \ub3c5\ud2b9\ud55c \ub9ac\ub4ec\uc740 \uc720\uc800\ub4e4\uc758 \uc2b9\ubd80\uc695\uacfc \ub3c4\uc804 \uc2ec\ub9ac\ub97c \ub04a\uc784\uc5c6\uc774 \uc790\uadf9\ud560 \uac83\uc785\ub2c8\ub2e4.", "short_description": "\uc7a5\uad6c\ub97c \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \ub450\ub4dc\ub9ac\uba70 \ud55c\uad6d\uc758 \uc804\ud1b5 \ub9ac\ub4ec\uc744 \ub290\uaef4\ubcf4\uc138\uc694!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28915763788104676"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593966611_2121447285163858_5679348738960112914_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSN9VCcC5x8Q7kNvwFZm4qq&_nc_oc=AdruZMpRZFErsnxr2F0yTu0gIvmq_wq20dYmlDSu8YPQuUjYIVFf8AEjzCptSwOG0xk&_nc_zt=3&_nc_ht=scontent-
6EjINFMQ7kNvwFpa9tc&_nc_oc=AdrcogexL-sGceFtpgAffG-Ps73Liz_-9G6oeA-Gl-O3SOPlmlj5xHNBhW6Kbci9tds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDrUmgR0p9hNuFfQNovlzU04ZQz9sHBW1DaVwt_rFiBA&oe=6B04561A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVHSaQbSOqMQ7kNvwEsTuv6&_nc_oc=AdqY504tDxBHmKnAhRMU62DeHSmOY3piYbTc-5XD9TPKDkOWn8ODpoMl6mHXvp4uDBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwlLBFOOZRVRnqxUS6w4IpPFL2QsMXyd518b_nNTgmWg&oe=6B045DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhHuKFE7kuMQ7kNvwHPKjhh&_nc_oc=AdqhmXpCH-loNkKxffU-VYiul8xvljxX0lfIFGAN9ACp7jDNEgkqX5kOuy5gfhvXEHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfyNYMEdIlGyWCA0d26VJfwEicH4C-8MDbUFR6W5w8FA&oe=6B045F20"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28989066470774407"}, "review_messages": [
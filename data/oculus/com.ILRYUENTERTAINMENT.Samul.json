cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doHCU8yLGbEQ7kNvwGIXO1X&_nc_oc=AdpDoGdnyPDgW-jbAheQIbOe9PfN3uc4fle_w9S0JV5u8ABHXF1CHybK-WtLCdlvAOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2f7KnIOcDudNBtKrFcla-JTSZhOSToKegJx94IfSfZg&oe=6B0F069F"}]}, "id": "1854411812221266", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1420605726673922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593801605_1420605730007255_7352116411094725626_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEld7-wb-YoQ7kNvwFA0B1b&_nc_oc=Adr-RpjTbhit4BDkhuX2Jxih1R3RkcJuPs1-WFa9Bx-mecyHxkARCOl5vFpyAHRjMuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjex11NPqi-ZFxcY53-6LCBtMZfuqtP0YrDC1L1-1Elg&oe=6B0EED61"}, {"file_name": "Screenshot3.png", "id": "1763697207999657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624069_1763697211332990_1089881132157114000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rF8KjyQsyEQ7kNvwEGWlXK&_nc_oc=Adqx5T6CJHpJAKB-vCpjVlg6SUWYNTe_HMk1ueFF8mEo2-Fa5o1JMCoQdfkDW94FDtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXixYF0f-oLKcvv_RAuJrc_cJhCvUi2E-hDd3AworC6cA&oe=6B0EECDF"}, {"file_name": "Screenshot6.png", "id": "1063125629837079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620630_1063125633170412_6982419681255657319_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JpxJ7HAxQEQ7kNvwGUiVp8&_nc_oc=Adr4f6vqgV3eUA8HGR0LQSl28569WfjxTsK4638QW2jqEwWK7letihJGqVAJnr6_o6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHNFvOIIVOdkmwwgRvoOnPFtwF2O_RqqS8mcrR001fpA&oe=6B0F0A71"}, {"file_name": "Screenshot5.png", "id": "1391477766388251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627379_1391477769721584_1532814487938229684_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrS--xElD_0Q7kNvwGZrjVT&_nc_oc=Adq1r7JpaEZnCdOBE4pa4VMMpb11lcIFEKl_txNEr1Fyh880cUVeDkcMJQODtOI-X34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgXBv5b6Glqrm7KDTAtGxJygdD1Pmw44jooIqgJHZnVw&oe=6B0F1A5A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKEs-yc2zmAQ7kNvwE5OjXt&_nc_oc=AdqzSnOiW_52ZvshCRrlcHMF5VVC5ub3W-8B7SRFwQmW_bQt6KH_mnV5zB0ZdvLty6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCUb2EiIBlg5RMp-z2pJwCDNLhtnxOlVSfdRhiLQvKCg&oe=6B0F2224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udZ2hL3nGfQQ7kNvwEhBWMT&_nc_oc=AdpIB0rOlN8AcPxu3CqMrvj2TzKOhgO3nYsZq9nPMCZ8NvUzTMnQRHKnZII96ka9BsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_ARSIC8NBO5XU95-Jyo5XmJCA97E7nZ69dt3J19JCfg&oe=6B0F2360"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28989066470774407"}, "review_messages": [
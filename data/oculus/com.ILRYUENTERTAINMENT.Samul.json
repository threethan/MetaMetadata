7I5ySo8Q7kNvwHjF9N5&_nc_oc=Adpqs5FHrqqSqwbVHV2gEiRvqI_7k4_P8wQ-10q9fu-BWAHVGBk10_gPsL5VAq3Uwtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5ku3z9txCvf_OBjEIBFU9sfff6FtmfpdEr5siyRDjkw&oe=6B06F91A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJCcPX8HFmAQ7kNvwGJITRd&_nc_oc=AdpWrnssBm0ExaIg74i2nGpAHfjIQ-G2Zl87_2ZUu-armVdyrDW-ZFgNg7SqaqoUjEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNUQ0W_m-wHV4IqWCthaVsDUX3h8XuD8YQPCz7blEfjg&oe=6B0700E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUlJXew-_N4Q7kNvwF2NAki&_nc_oc=AdpTesF5lqMWnw3jCjN8wlQxGevEN3lIHych5j1N0y8jsXLyOCKO_0ne_kzqwdU3C4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVAXx75bFsibsHxwf0KuR8S1mnd9w6-lpfZ1OATa_j6Q&oe=6B070220"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28989066470774407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593966611_2121447285163858_5679348738960112914_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUIM8SoA_ZMQ7kNvwHx4Pxv&_nc_oc=Adq7sjjUZqxkPQznvu08X98ZDLm1k1A9qDm8uI3DJRi1ic7kRGfSVFua99gWGABlJBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2PSOPuFxuaC1hydJg4kZYrhmqvnkGgwDV4cNc5zITaw&oe=6B071511"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EOLSSU! : Groove of the Janggu", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1789630200, "lastRevision": {"nodes": [{"id": "24957082133972881", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24957082080639553", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1138679631641295"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon_fore.png", "id": "2135137273734421", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622186_2135137277067754_907147793296955011_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYt3i_pUvLAQ7kNvwFE2ToB&_nc_oc=AdphmpFy5cWciqXBVke4xxSgm53PTj3jaA9jd8X5jqbkRkFrU_AqKnPut59eyUxvikc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOCan05kOx3Cghp1Kvt6uV02PC6tvZBP93WrCvXYmNtQ&oe=6B070A88"}, {"file_name": "CoverArt_2560x1440.png", "id": "1950115088997805", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626
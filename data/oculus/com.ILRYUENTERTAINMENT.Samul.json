t=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQufDZTOOGVE69xlore5S4lHp_iXXF6x4lDVM_NUxgylg&oe=6AF4841A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbFOjZOQ6iAQ7kNvwEn5H_8&_nc_oc=AdrI8Ac9L-f__j-0SSo6yxvRHQ4gmcmXkOlW1hBqy5BGX3k3ndAJ--0bbGsmT8M1tGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStF5s6rsyGi2U_14ryPtBZfpaOhdlyR9WkZPO-5agvCQ&oe=6AF48BE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs7LxdCAvaQQ7kNvwHg7Z5C&_nc_oc=AdrY1nkl6Nw46VNCyPczT0Xg6p3wFwqM-5cGr5LK2eOcaJCaLmAJvKZdd0xhDTxp8Tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF03iNDQMB_FXZ5Y0ixl79x6OK8mHwID2R--sGEyAZqA&oe=6AF48D20"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}, {"images": {"nodes": [{"file_name": "CoverArt2_1440x1440.png", "id": "2177465706167630", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593862973_2177465712834296_5116148648534398662_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHidJvUeawwQ7kNvwFPeY2B&_nc_oc=Adru0sBIdqIxdOTtlFzK_WbNx7RZ3AhHhZKGesto__fEuE1x70QZBkckOJa8E67thg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1QMeXLSk_K974SJn1uOK_GHDsOtJfS5zbfvRa4VL5Gg&oe=6AF4801A"}, {"file_name": "CoverArt2_1008x1440.png", "id": "2140165379940150", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627502_2140165383273483_6946379890060387892_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR4-ipBsZP0Q7kNvwFp7Cor&_nc_oc=AdpqzNioLEiANfWE_yTAdNqzSP3qL5AnUEcupJzx5r-UhyAi9GuN9xtFsmqnbpu6vUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc-PuncrteGvzn3CUe8F3GWOMND0bIFrCai4i5gRpB8Q&oe=6AF47A5B"}, {"file_name": "Icon_fore.png", "id": "2135137273734421", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t
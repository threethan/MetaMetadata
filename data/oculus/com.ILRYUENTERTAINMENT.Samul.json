cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfPLq-h4SuEQ7kNvwFb2pV1&_nc_oc=AdqjEwDyzOHmiucg1_BhiGE-9ncrwKrEtrVsHMIAUa9a_5U0-eFPWuCpr9yOIlF5iQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu6wlwsKCfR8oCISvNXm9i9h5vC1HnhxkIAgyMTh2mIw&oe=6B05CC1F"}]}, "id": "1854411812221266", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1420605726673922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593801605_1420605730007255_7352116411094725626_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0ikr4S0Kr0Q7kNvwGHuGbv&_nc_oc=AdpmZSL54w74qIA3vdbDQ460wQ3hssNegREmNlcgXiWMQXLKaWtBG6GAt30_MHeZcS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9WTMC0u30c6EoszI33SJt0vryzzEPp-BG8H8EXbu7vQ&oe=6B05B2E1"}, {"file_name": "Screenshot3.png", "id": "1763697207999657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624069_1763697211332990_1089881132157114000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3VmzNRVSRsQ7kNvwGM2aQj&_nc_oc=AdqMYu1s7wZnqyWIdbevEPBgVP8fPZO96YVXCuGlNmkBJ0dv-OaWkIdwqEUMeNySpM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ6TJXnEJpz2rwO915Rr1BlXIzfP0eRDsD7cHc8BOKJw&oe=6B05B25F"}, {"file_name": "Screenshot6.png", "id": "1063125629837079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620630_1063125633170412_6982419681255657319_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a32nHPQPayQQ7kNvwEQpPPv&_nc_oc=AdpohTtlVAFIRtd6QbC5skGzjkbVDnCXu0NqczQ4s0OM5Fq16ZErc09a_B0xxnwkkAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwpsW3DNrGdg0oJGke4WzOUANYDmQ0SSeElOkAr8tmxw&oe=6B05CFF1"}, {"file_name": "Screenshot5.png", "id": "1391477766388251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627379_1391477769721584_1532814487938229684_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChK17I5ySo8Q7kNvwGpy3mW&_nc_oc=Adq_7UNx1CkrP0kOYWe8HnZs3HP4qbIOcDQEK6YCcpOejpRzKE5PuvyT7uYOEB5UHQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR88cOgTVcNyhNa_0Ypnh1xtWeLS1btkjGQ9tIN2KgDbg&oe=6B05A79A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVHSaQbSOqMQ7kNvwF0wsmK&_nc_oc=AdqsNIHKuwwGeHp1VBacF-3D16Cs-XPjnv-dcT08w-PnQmZDzq7JV-MfxeK9Ig4oa5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKvpv1FZCRPNlEDRfJmls7ReOKQtSLKFChhn7XKyPFjg&oe=6B05AF64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUlJXew-_N4Q7kNvwFm-7vj&_nc_oc=AdorlGEQU-20ygcxO225BJncPb2RiVy5KWUUQT9mjD7AG80ZgzzQ5jtJroJyarWawtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFo5FY87-l6nNv_OaCSWDxIzMkA2V8AYvPChjbc8Ciig&oe=6B05B0A0"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28989066470774407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593966611_2121447285163858_5679348738960112914_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7JFmf1WaaMQ7kNvwEx1Uhy&_nc_oc=AdrxHLQfD8kyM8vsuftiTJbCUft0LKObtqajZ5G2Ed6Ph1ncnCJajsrpV1MeDxjHQAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzbEbdkudzHFuJplEK45PHjKQ_qs5eHyfz64BILffbnw&oe=6B05C391"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EOLSSU! : Groove of the Janggu", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1789630200, "lastRevision": {"nodes": [{"id": "24957082133972881", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24957082080639553", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1138679631641295"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon_fore.png", "id": "2135137273734421", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622186_2135137277067754_907147793296955011_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYt3i_pUvLAQ7kNvwF2Tj2b&_nc_oc=AdpVxLecsCd5i2a-_XM9OrGlbL_4WjWyIn8SN17dLBuhFWQW3nozSPWXd82m3LmhEEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShyqoBQzXL4Dp9pMF5An6DBKR4eUBDPWdAu7FOSA10_A&oe=6B05B908"}, {"file_name": "CoverArt_2560x1440.png", "id": "1950115088997805", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626
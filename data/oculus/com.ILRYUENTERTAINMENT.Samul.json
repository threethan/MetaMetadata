cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m2znTVYJp4Q7kNvwGuL9L9&_nc_oc=AdqdN-1o93DLDFV4iv3eFSaSenicBc4Y8LMfCrJEZR9CVQIfLanVnjdBWjK3N0ijzxM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4pohv0y6N4Fg_fIvvP9n4bNCIr2EAGwWuSTIi7sRzMw&oe=6AFB401F"}]}, "id": "1854411812221266", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1420605726673922", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593801605_1420605730007255_7352116411094725626_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEimPAQa21oQ7kNvwHH0ffE&_nc_oc=Adr3BORT6MlEeCx4bjKcFYGvVXB57Xc5LpK5d6u0ymTjYqdKPLqpeQsB0XZVy6gwoLU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMF3HefmJaKDoy8-Qa45mxuryM64ytS2hh5QKg_BJaCA&oe=6AFB26E1"}, {"file_name": "Screenshot3.png", "id": "1763697207999657", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624069_1763697211332990_1089881132157114000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vUM2ezKX0UQ7kNvwGaqgDY&_nc_oc=Adq6CMyzbmyHOzkiEZyj8fHempnJFmEtQa4qnm1MCfqupoWMNY7DT4_HiB0dLD6wDYE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSJ1A6TbtCMcb-115MSU1CSUcIzN2FcViw6gajhJsgbQ&oe=6AFB265F"}, {"file_name": "Screenshot6.png", "id": "1063125629837079", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620630_1063125633170412_6982419681255657319_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=768ySroPHL8Q7kNvwEAhkJa&_nc_oc=AdrGoPdgX4ayYuifWaGCyIlI_3F7y5-ZmGrMGED-YGWWTSULwbgyiLMc_dBkfK7Zwqo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg-wbGcHgkkIGnXYrbbdae6LdbZbSY1UQv-FB03YVReA&oe=6AFB43F1"}, {"file_name": "Screenshot5.png", "id": "1391477766388251", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499627379_1391477769721584_1532814487938229684_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCxkpfzPqR8Q7kNvwHYF6dy&_nc_oc=AdqTFH1TwTJk4KacCzA2HEXyCT5Hn5nCQ0Yj0RhP3BhGQbSvMiwP4DTR3WW0jypCWNU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYFk-VU1GbcHs2WL7FpmMUqBpcOS6gXZsqR-cntrsqKw&oe=6AFB1B9A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pi_vuWDgKBoQ7kNvwEl0wje&_nc_oc=AdqEnQTk7wYmAEhz0j6ZRkQbAXEqscopq0bMwD5eqqBt2kEo3z8ix5vIPe1j6bAKLEE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCz-mTsxnHJJnTpH_iVsEsAAttfHwdnxk5LItf-Re-MQ&oe=6AFB2364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP2BZ0TPWvMQ7kNvwFF4TDw&_nc_oc=AdqEGbXvw3mEZtDGjg4arVrKtnpRuja9SE4dZ602apt5aEw-g7I_TD8X81cZTG5OLUk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoxtUDvaJuxsWy78m0uRxNcwUJUpBz4pGsCQcQXec4qQ&oe=6AFB24A0"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28989066470774407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593966611_2121447285163858_5679348738960112914_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVqrI3_LdWAQ7kNvwFX_B_n&_nc_oc=Adonub9_Zr42DMByqEZ6hPvrOjHpT7lPkO_7uqI54r6KALhilCi5aqih2PiLUjO95T0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWZY2YNZOv-ZJAZhl63xIhdCHp_18Lx8upwdmPePiEdA&oe=6AFB3791"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EOLSSU! : Groove of the Janggu", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1789630200, "lastRevision": {"nodes": [{"id": "24957082133972881", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24957082080639553", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1138679631641295"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon_fore.png", "id": "2135137273734421", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622186_2135137277067754_907147793296955011_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrfQ9S1I0bkQ7kNvwENiRIR&_nc_oc=AdpwAADqz0O71mg9GelBlYmK-6sMxYlgLYpqPy-MeFAwg3AtKD5tQumnVlW-C4iLiPU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZwhugl0c3iwe9NxCEfNYIQykvQuqwS3tbTQEH9bt1jA&oe=6AFB2D08"}, {"file_name": "CoverArt_2560x1440.png", "id": "1950115088997805", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499626
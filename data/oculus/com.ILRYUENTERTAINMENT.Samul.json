cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q25GA3EKLZ8Q7kNvwEGW-83&_nc_oc=Ado9IS-ysz_nuH1VJ2mzY58sJbvoe2t4__Keul1Kmc3Fsz9PnZgPe-d1anwFbv-tQ_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR00WG_uZoifri4pL3AxUX1AHNqB4oqsCPmYWEt1sL8pA&oe=6B01D79F"}]}, "id": "1854411812221266", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1420605726673922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593801605_1420605730007255_7352116411094725626_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iguzyGhgVA4Q7kNvwH-8VuW&_nc_oc=AdquRRtzymMpm7eZ3m50-YN0uGLRwu9a161OWOZ_L1wcvvm9DkX5Ld-W3TPoMuGZ7-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOc2PP_4hR1czBY93uYtv3JvUrI72MeL0ovhQ2fR8waQ&oe=6B01BE61"}, {"file_name": "Screenshot3.png", "id": "1763697207999657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624069_1763697211332990_1089881132157114000_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtqWYBFzjfgQ7kNvwEclBKg&_nc_oc=AdqwxZkn31xbdLKpTe-A-wWD5MkU5_bO9Z2axiuRLM-5KErB37owTOg0XJKUZzWyjos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSB7btyB_QGMzK77CI9S-58AmD7gKxnDFp8KI5-BArUw&oe=6B01BDDF"}, {"file_name": "Screenshot6.png", "id": "1063125629837079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620630_1063125633170412_6982419681255657319_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psR9MZ33MMAQ7kNvwHcu2eG&_nc_oc=AdqGwDzlLo3Bvus3ShK8KXHdwUHHukAp_JvWyOWCLPLWtKm1n0WJH6_-2znlC6FGCiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgsN-bNopsya2igHhcQD3hXmLF34-Z3hyMK9WPmPVocA&oe=6B01DB71"}, {"file_name": "Screenshot5.png", "id": "1391477766388251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627379_1391477769721584_1532814487938229684_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPwt6EjINFMQ7kNvwGElVpC&_nc_oc=AdrwB9BlQWZF8W4fXV1xUIxbvli54zANcK7fLBJF4TPRfMxslo24gvMBwPbMzO4LiSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrV0aBWlD5ElZGloexecN4p-PbkE4JiD4tI8PW3FlgxQ&oe=6B01EB5A"}, {"file_name": "Screenshot4.png", "id": "2562679807511607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628875_2562679810844940_3921642768694880627_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3w28I_sSTzoQ7kNvwGW0z_M&_nc_oc=AdpuMRwxeJlNnd98ftjd5eFyvaG_oOxb_gLSozN2YjikxzkG99O-auxribFJ3Lm2fO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNyd5lH90f4GlUzfHPzfFtkpSHXCLTIv-80z97HiiYMw&oe=6B01BAE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "2646564502441992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622188_2646564509108658_7085258324127963835_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhHuKFE7kuMQ7kNvwHI7fjC&_nc_oc=AdqL6OnmkiDMC1L6Iy7dGQIb0P8R_OvvhZ8Sf1CLvBU2nz9bgyjmU_SqUOc6ZryHrFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5F37sEou5Qkqo-1s9IPNcgFVP7E1dn0rcchwS_RZQZQ&oe=6B01BC20"}, "display_name": "EOLSSU! : Groove of the Janggu", "keywords": ["rhythm", "music", "instrument", "percussion", "drum"], "long_description": "# 1. Immersive 3D Janggu Performance\n\n**Experience the Resonance of Traditional Korean Music at Your Fingertips**\n\nThe intricate structure of the traditional Korean janggu has been brought to life in a vivid VR environment. Pick up the VR controllers and use them as drumsticks to strike both sides of the janggu. Feel the weight and realistic impact of every strike, creating the sensation of playing a real janggu. Immerse yourself in the excitement and rhythm of traditional Korean music as you create your own dynamic performance in virtual reality.\n\n\n# 2. An Immersive Space for Healing\n\n**Find Healing in a Tranquil Hanok**\n\nExperience the serene beauty of the hanok, one of the most distinctly Korean traditional spaces. Sit in a peaceful hanok garden bathed in warm sunlight and play the janggu at your own pace. As the music fills the space, let the stresses of everyday life melt away and enjoy a sense of calm and relaxation. The harmony of traditional music and tranquil surroundings creates a deeply immersive healing experience.\n\n\n# 3. A Variety of Rhythms for Beginners and Experts\n\n**Feel the Excitement of Traditional Korean Rhythms**\n\nFrom simple rhythms that let beginners warm up and get familiar with the janggu to fast-paced, exhilarating rhythms that will have you moving to the beat, a variety of tracks are available for players of all skill levels. In particular, the uniquely dynamic syncopation of traditional Korean rhythms will constantly fuel your competitive drive and inspire you to push your limits.", "short_description": "Feel the traditional rhythms of Korea as you play the Janggu to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ilryuent.github.io/EOLSSU-Privacy/", "developer_terms_of_service_url": null, "publisher_name": "UNDERLYING", "support_website_url": null, "website_url": "https://underlying.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28989066470774407"}, "review_messages": [
ri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75367594_256439430167774_3238017202037532538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVm7NfDAKVgQ7kNvwEzkFiC&_nc_oc=Adqdh4cKPfRwt4_22OejJC_6-k_U7VjqGjO5clXe4TBJwdnu4AzBUklDku7WJovPCzU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDb9zzZbulI2BP0PGVKsL2WGIFMCj3lpjy6S7VIMmo9Q&oe=6B09CB09"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlGM59WuHHgQ7kNvwGqlnoL&_nc_oc=AdopbnQq__sr3oH4EA8Olm7v813B0J4oyo89LtRwv7jlGTQelk8mghXGEOVGs19fx00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ9fF6N90enn3dhbNPm6t-n3Tul8hOVkrvt4ZzCwKH1Q&oe=6B09A919"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZg99PTx5pYQ7kNvwGLXnSm&_nc_oc=Adqrmquu_AiFuz70YSt0Vr--1PQ9h9XMTzDud-9EljESNJA8s9pheftDqEsAYuqHL3o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTao3MAfa1A-CMHAcpuGN6dxScP7mBYwnWd5qvC3KQ6XA&oe=6B099BC0"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNJGGVNhDPwQ7kNvwE20H3h&_nc_oc=Adq2HU1XU8Jq96nNgJzHV5mFuGRkJvAGrqlHZ7uQuIT_lNekzQknCEsUhh4-rKhPjL4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh1CPQ0gDopAAk0EmZ8KZlRV1bfSbLz23uHr15TBzDmQ&oe=6B09C971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeRNuOaz_10Q7kNvwEdVHgR&_nc_oc=Adrkz8Fwjbyli-WBw2aMpP4zgaWTZQDR_5Gpg6Ip68J2i-HVNLkeh0f-QuShrt02KI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWMg0hAUMal-wo5LomQ1EKbmmknjI-1hUS6BvBjQrwYA&oe=6B09CE6B"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873",
0f&oh=00_Af9I4DXVsvMfXfPJ61u6HtmbSrz6Z1SJN5IL38wN2UHAHA&oe=6A33FFC9"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8tojN7oNlcQ7kNvwFM-YdX&_nc_oc=AdpLHi_U9cNbB6ryfPwRiQMcxCw2xkggEOUFsGSbMZos-ozDQSSCwpxykejeJKgJrA0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3AiIKe21MzI_osSp7T5QtdxMQMfmGu9r5vEllw-IgIA&oe=6A341619"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bMAuleBAz0Q7kNvwGVy40k&_nc_oc=AdougcS26YsYx53Tq0vQv4BhbzShCr_v3XWWWs43kQZkW0f7hUcfEi_FH4vWuZs_Ijg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wSWfxweGKq0PEC7WLkSK0NtAAKI3YI4Xh8GU6Ju15pw&oe=6A3408C0"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNgcVsTv5T4Q7kNvwGsqvUZ&_nc_oc=AdpAoeZMa6kewtZSEosTXQrAX8QwLyX4ZPBIlfz_aH06rDKQ9Eq9fFnkn2BKpLhnJFk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qKgpUuzXd_B7FY2EArJj8cEYNQpwOq7aw6-ym4npf7g&oe=6A33FE31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHbst3YHUKgQ7kNvwGliSb4&_nc_oc=AdrQsw2V28Rl6zZ10ndJ_4R93wnKHtCFmdxJxfNQ1NPWl6EZPpXT61CXk0Fi0tqokQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80zH-4QnU5H6u8fRSmdsXCmnznWslNZa6TVAqBdrQyJQ&oe=6A34032B"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
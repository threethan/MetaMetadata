67594_256439430167774_3238017202037532538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7bZBGFqACAQ7kNvwGGNSqc&_nc_oc=Adp_-IA4pqy6bgAn6GHbLEmNt4YLLIEVkdsANWtpqrfS565XFhfWWZ2cZhFX5qYCQlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF88lsQkVIuRP5enTObd4zUhE7J4940sMPgugtxmQJJA&oe=6B05D689"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUhEvQr-ss8Q7kNvwH6HqSM&_nc_oc=AdrZfoNIwU2NGT0sB1S-AYQtxijF5YxMoyZ58eAUIVxhGUZy5xoLFY6YxxdmXR9Mm4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV_GtKo5ra7ufP1_OA1NIgaYF_nSBDaXCj5jjDFa31vQ&oe=6B05B499"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jWpsSX7S-4Q7kNvwGCx0yA&_nc_oc=AdqJaF_GWLJj-wssxL-brgtwF_JgLfTqxnoTLWGbSPlipPJ9pplHHfYxgTLMm4OgdOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG_B0KgYZXka2LaYnPFlLa-U3DKHRK3XF65XAgKR0nPw&oe=6B05A740"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD1v8Quh5ksQ7kNvwG6tD1v&_nc_oc=AdqNEtLnh3jGwWB-dkwVFwOlNxZ3acjx9ZcH_vTH5J7EqIJKUglLXTstP8lGFoR4dKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF3JJ7sr4jxSfPWV0eHB3Em7aNZa_KUuuumqs5lWJ6FQ&oe=6B05D4F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK_B9mXMi0UQ7kNvwEJi5u4&_nc_oc=Adr84R7Ge7Oe3ZxoPtj4Pwi_gsm3KHiTHY4jPVChB-6tlxJB8FzTW6f_92_8-wvnATI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYlPEg0vS1LHOmlddMP0syj8cGKjemvbK82kmr4mXYjw&oe=6B05D9EB"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://astreaimmersive.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "e
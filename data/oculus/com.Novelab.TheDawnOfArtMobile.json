0f&oh=00_Af1pli_m056eXeYkoo24HwarZIDyQCWqgiGZhyGTP9zIrA&oe=69F4B7C9"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfLN_cosBiAQ7kNvwGMqbGJ&_nc_oc=AdocMDnKMyyMWS9xpVCsqbDijQRje65TzWCq4hmIQt48G6n7cYwHIerU-2MD_3USKKQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RKzb-tpRNw43luIcGfnQTVOWf6E6XOaDEgw2FFL9MyQ&oe=69F495D9"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99IobcuwTLMQ7kNvwEYW1kB&_nc_oc=Adr09kHfHE2nshhzJSwlEYrPr8KgSCFio7l3hfpckeTjTLBBy7uGYSK_iv6_cz6p4Sg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lAHJMVXUbVlG3jRhiUnc8zOv9CgPLW9WUdE-r-73a1A&oe=69F4C0C0"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQKo6VaaYrcQ7kNvwFFNbbD&_nc_oc=AdomTQrvid-yq1hOVtPqmv-fVqCY6xmr0zJqbvdaAirWODljGYnlqcMxN7cd31-8fjI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_R22k9ybkORk8KXsu8iprY0fArjUysV2nGFZRqZWMxw&oe=69F4B631"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoIlbThdc2UQ7kNvwHVN9e6&_nc_oc=AdqO1DoptsjMzUffSwMP0_ZS8mJgj6shCdbuxBVFduHsE3YmbJq3Wq7evxFq4D5g1VE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ujBeK7HLC3CKRDMcfPsUT8Js-wauRvNV6JarCCyGXnQ&oe=69F4BB2B"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
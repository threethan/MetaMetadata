0f&oh=00_Af0d1nqwpRQ8Jb57A-fWtBtbiNKdyNPu0UlDWi07iyl-Gw&oe=69D66549"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuXYYp_4g0YQ7kNvwHk3DBq&_nc_oc=AdrKPt-10tPr3K1vsCQUVZIaRVDPVG2KhfGbY6Y1knAjd9m8Bapd8Ag83-UYyEYlK0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bEdgLACEVzsqF1bHWvHF-g-J6Hx_mr_XCGKuPSfIfyw&oe=69D64359"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWHVch01-54Q7kNvwE876Bl&_nc_oc=Adq0n0IqyiJCfyI4E69jDpGZcCNrT5dejWytso6Pmn_ru9bfi9hD3VkOXDZN2NiRBqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29rPTJlN66ASNQAwbaH-7Ey_X1mUiXeaJRB9iHYu6H9Q&oe=69D63600"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WYumWMDHv0Q7kNvwGBTA_8&_nc_oc=AdpINeS9JPq12c1qcIobsamyQSxCiA5XpnFGqCRWseQNpTTIkgz7kygw62QJ62oETA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gRT6HMsNUkaoZvR_7BLezkRbxvMnPJKSIijvZOMGRIQ&oe=69D663B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCVB-72lS8gQ7kNvwG-jeAs&_nc_oc=Adr9uOfvW-AIGKSPLJvbkxEyqFDTeUG8YcmjvDXN38Mg1FdFTjCrkBkHVd5XK_LOb6s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cj3E0V2w2acdz06NgC752xG6aqzqoQMgkQmzpvjnP8Q&oe=69D668AB"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
ri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367594_256439430167774_3238017202037532538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpkbXFqYWtYQ7kNvwFqWH96&_nc_oc=AdoOLdMYT82AyuVtQfQcMKWsQJVHy1Zch05wnHq6HcH9KYN4_ndb1FCAU4J76IitLZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxd8nd4SC9K9Ifm7MJJdHCJQSNUrOqF_--9oMfav2O-A&oe=6B033389"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0dmAEmhg1cQ7kNvwH0alk2&_nc_oc=AdrFi7bXP39XELrsZTvzB8Gk5Au6_r2GuEZRGWaSDH9lKTPQmDzteYcXZjS5CGOqBqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRXKmDiZDRfaFI_iC7tZpjo5FUrIUTMlX0iWMRCeL5Ng&oe=6B031199"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dm7e9kgfFuMQ7kNvwGUqOMq&_nc_oc=Adpsq6-yaIh6_tHRmkVanQXOkrFL014NWLSbGnNne2sgWgVtN4KbaKzEzxvRPyW54-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjbz6KM1or40ZdOc3rE0XNrj4t5dMRZa6kSuzM0k1KWA&oe=6B030440"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAtPeF8lShYQ7kNvwFVoJwQ&_nc_oc=Adod5y1OXoYYnDyK2NzAA4lH7uf8Alionj5RLo0kJ9UPSek-kW2Kl9162nLf_iLRJfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiod9ymi7vfHWadbmAybbARVAF_IHEE1Cu68OH8WiDcw&oe=6B0331F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsm3PHUqR6YQ7kNvwG4xsmq&_nc_oc=Adrqun8OYxDgjiLjtgXchs68HdFnDkSmpbjsaQcphEOikAFZvfrYUQeNLxYW7f3bP_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8eiBJ0X0oeEfGuGOb70b8duS5AR2R5kiO3Qj2JVJU_Q&oe=6B0336EB"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873",
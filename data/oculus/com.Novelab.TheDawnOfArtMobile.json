ri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75367594_256439430167774_3238017202037532538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpkbXFqYWtYQ7kNvwFurUAW&_nc_oc=AdoVDYRAxypOBENEJCjW-kIBuvd5OWJ7j_RL3GfxsUNsEVtdhM4QiaLwgTjY39o2XFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkptnEMevHwfH9kO7AhAxT1nHoZ2co9O8GX4qkYo26lg&oe=6B005849"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0dmAEmhg1cQ7kNvwGmBjIV&_nc_oc=AdpK-BkMobK0wrhIuZ1KV-39RXtNh2eKT6wQqziAH9M-uWN7rucEwqxCRm4FcsSe4lk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnErcdpf4c4GYjy9da5_2CXWyYe5aor-8YhRtn0VLhJg&oe=6B006E99"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaXqp3WbHWwQ7kNvwFk0A7C&_nc_oc=AdqbXkZQ16SwrQ8YG3rhds2xq9mUSWS0fEwBHfWuMZxMrk7_anuiFsuQNLNLzznHsCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR6fBMcsiXTuXUM1bINgHQc3u0jjoqLtS7DDkNYNIxCA&oe=6B006140"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAtPeF8lShYQ7kNvwEO5mQL&_nc_oc=AdrLK0QENLJXZ-XACVD08LxqphjpUIe3YQKLj70lQzO-2IrEHpkaG4LrIC91ZCR5czs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp56kDDOTlEKTxADiPaGhvB_wJSrg63CqUTWY3dx6Obg&oe=6B0056B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RetCmmGjToQ7kNvwFTySx1&_nc_oc=AdouldsgwnqmBKR0KI-B38FjbWN1AUmjlIeF5OyoGtPuZ1fzU6Qu-Aj2X4Hq7m1RZ0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRubNFlbPbN2AccdlF7IS2CPtfgaKxoEgq5NELNL42V9g&oe=6B005BAB"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873",
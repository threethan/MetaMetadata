0f&oh=00_Af4YJC_OTxxfjZBTkd49pOC6vP940NlWIZ2FjsKMn-VX2w&oe=69F9FDC9"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ghTmHBPOO4Q7kNvwGbOM9o&_nc_oc=AdoIbCfxLNyVFMJyQJFmHs2basivnaaB2_oFzgPcon4NPwFaSzuzVd6FXK1QPwe0w28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CfoTG3Yp9FBVKU4xwHYKiSuX3TWoMdy15LWl-2mTXhA&oe=69F9DBD9"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxxrYaWQxWwQ7kNvwHhmb8O&_nc_oc=AdqVujWK0louS8wUzT7ZR0AP-NPpNRs5Ymty3M-QpJjVb3xBRzUNBxG8OsW4SkII6vs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FuNO5OGJjNmz-JusJcZcQX4B3_9SoAjZsYPYGcsJYfg&oe=69FA06C0"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjipajyCUmQQ7kNvwEPEFSJ&_nc_oc=AdrNZBG12bod0lcOMdbg_4Gr-3Fi5Y4eh2gYx25_EqkhBTVBMFpyeWTsAPNijbRhH4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KQu6aYUwRW2aXS0o96iQV0l85Ibhl1ERsAgH5EA31rg&oe=69F9FC31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHfYHuafCUkQ7kNvwHMcWvX&_nc_oc=AdoUyjgDuLL1aNcCdHt8FDEld2YmZeFcFVuqZvMOfZ_tczyxaSxVaD8yMx2qYeGFK8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56wyKzQFkYIs0fN6CstCV4kxWIWz6uGrdbbp801dPs_A&oe=69FA012B"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
67594_256439430167774_3238017202037532538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7bZBGFqACAQ7kNvwFqNmFk&_nc_oc=AdqElg4iDKUneMl4LOnDFz5k_OvrlbMYmAhNx94lI3l09GcE6c7erB--QbMh_z77iDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjinA6JL8wicFTFrnCFOCQsYinhpo1UGQB3qtjU_MPlA&oe=6B048509"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUhEvQr-ss8Q7kNvwEZDt8r&_nc_oc=Adoc7YEwUv6xZskTpJV8lRVWMNHsAji6W_RSM-MJJ1F8oSRY5wDXuAtJJL6dTES2bGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIMPMMVwYdajaZ4T0XlLBgS0t-Jl99_8vXngRhM5qFNQ&oe=6B046319"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dm7e9kgfFuMQ7kNvwFsnKhE&_nc_oc=Adr5NmwN_k9YLqYH8eKGjS2cjsuIUQhDZ90juSJ4ZgGSt3WcaLpRi_h3poJ2Hbp6JDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3XVvVR-NpCC73xI49aj28j_tQ6wjKoarcB77fyj7hWQ&oe=6B0455C0"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD1v8Quh5ksQ7kNvwE5yNmh&_nc_oc=AdpT4jm-MDtLCJSRND6wQuTKxyCGAa03wD0AFWDjtUnAhz-lZVzBWaKvaRX75Zcj6uQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTplHaJaLL0J-6uBeUjW7qN6dKOHECaxVZmcAHrsURJcw&oe=6B048371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsm3PHUqR6YQ7kNvwFvNdb2&_nc_oc=Adq8y0TPt0JvUIWpl2v46xo3TtZQWt_2JyPHC1NrfBEfAIhK0V2yRk_crIZdlNVYQjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaAUTX5kVebMTkllQoUavXiRTxlD9cN7DpsRAK5pSmZw&oe=6B04886B"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://astreaimmersive.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "e
0f&oh=00_AQCMBYVv3f34sZwHkU58xLfcWs_Vv6ef3TsGAefK2TnWuQ&oe=6A5CDE49"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqIMxbHPLCMQ7kNvwFjt-PU&_nc_oc=Adpr-UZEc_ww-HO0Bicg98Mq-BiaxSWoOpy7SDYb6gIHYCy7efckmFlN7WOMEP4CaaI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0W5BKLb4strovSvVhVHKURS42Ch0myptglNxVEjCDlg&oe=6A5CBC59"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2J_WxgGbBgQQ7kNvwGha_A4&_nc_oc=AdrCyNgUwWw3J3ZtZZ06dGFKZ8pgTkblVeecr-wt-maLwjehNCGPVETk4DQuKsD_-Kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK8XVqs5N16i0UeqbarwUHstcpRenIknGxobh-dpM1wA&oe=6A5CAF00"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnYJCZLkPt0Q7kNvwGsky0j&_nc_oc=Adp3AUvXb773M_f4UwL3PHcaIOpo5Hc6Q44cAOYtTYcsiQIl5zlRFQzMtz2lC56S9A0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8K2cwfGacQe1ca4sIQPt65GvFnY0SWcWHNG1Rj7UU_A&oe=6A5CDCB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8u55Z3xxR4Q7kNvwHtFJOw&_nc_oc=Adqag3Q39xDZA8JptXN6wc7oXM6i-LfMancOY8pgqh1dy1TLKg2Y1c4IE4y4U9r6Sj8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtJpqRENa1kv82iLQs7WkTvGrmnA80rnoPtlXS1rxJ-w&oe=6A5CE1AB"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
67594_256439430167774_3238017202037532538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBxLtx9S82QQ7kNvwGUInVQ&_nc_oc=Adp0ZCwTxmgqrnJlOZej8UZRW4d9gfAOu0IJKD8_DhZvtFLLnYVk2Qz0hy29pzFYlKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX7YWJwC6G_a8N1nSIM3cz_QZ08zRhuzMz3poG29l0fLQ&oe=6B0F1109"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaZl9FXc4_wQ7kNvwG8PG3m&_nc_oc=AdrLeiZA-xzp5eDhiRREMSJ-f-8u10P8XpWJhp0IYVbQZXRU0GTASdarSRxY7jvCmKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSKNUzEorz61jX_iBXoa-zEgsedja5Cv3mCkwxhKmqhg&oe=6B0EEF19"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1kO1prE-PEQ7kNvwGnwwQR&_nc_oc=AdpZpMty2Ss3YKFim1rxjBfi8YEZRjoRXuy4tffhoZ-veAzoy_fXYeGyJhnT4VGm6-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLGTmQqGQ_Vf8aTZ7GhQeb90ht6IEXxEUDqJUu4kTP4Q&oe=6B0F1A00"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HpvcyTRv3QQ7kNvwGwcQZs&_nc_oc=AdqO4wjenYV8BF4UfwsRdicibVYpmuw1XFuZHzyr75Xe82B1y_ilSktXX33OrTYK7kE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhrqTTkxdzOErjv_I5kkz0t0Ev-LrgXANzfXn4OSKZwA&oe=6B0F0F71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cFBLqyf8UsQ7kNvwHQ6UXS&_nc_oc=Adps_plb9bGd7LBsct4q9wwaJ69UYO1rNJBxuiKut-oX450T_jNCj-UgIEudBV0ybSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdVHOqm3LgJCeyR16wxjjbsO89Il-OUrNCh1EKueLwYQ&oe=6B0F146B"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://astreaimmersive.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "e
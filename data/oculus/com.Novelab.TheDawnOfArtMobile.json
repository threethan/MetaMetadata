0f&oh=00_AQAYVFMMofqT3WxfE5U3BeTxGpRRWExzAnvaJsutTxYcTg&oe=6A53A3C9"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fs9HE1FLXwYQ7kNvwFMPjbQ&_nc_oc=AdoqdSuWG2bOFFsurMhlCDZOeCkR-T0ayzCDjUj809mHZ_J6sXkHkbb4nFzCojB4xBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa1ebs4ZcDdiTKyPLPI39UNI-jAQj5-mJMGqCfXdsYUw&oe=6A5381D9"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLVs1WjsPzsQ7kNvwH08W8-&_nc_oc=AdrjYO_L2nXHBhBtI4qJx5e9fsHNlqkneIXZ3W7NwcGUJOEePPSWoZakA2-WBONIQwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcX0eVMY6w3iuiD2DvbFiaE7lUAbXKeRGco5pNHtfqTA&oe=6A53ACC0"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIfoXlHawTEQ7kNvwFNZFEn&_nc_oc=AdpKJtf8-pCwtyk5yl1vExm9xVLYd22ZDMAPbS_qrc8FOUX6oFFUemWcI6ARRYP9fKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByax9Yl2hCK5K5-cGbEJqLN0xyJjfblQ03gXwRphxYyA&oe=6A53A231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4oEJnr1hIcQ7kNvwEbKEj5&_nc_oc=AdqlqK-Mh-wbLts22TsOOYM4V_6EbVYVx8ldSy-nTlVY_dNcTSyCq5FUuC-oAbrbcck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp30dC6aC3cpdwTn-1dBUqQqdhIRhoyb7fW7sPI6r6iw&oe=6A53A72B"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
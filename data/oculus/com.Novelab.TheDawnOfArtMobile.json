ri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75367594_256439430167774_3238017202037532538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWM1Y2I5tlkQ7kNvwHz5Te9&_nc_oc=Adr-cKiyP17iYzL1-wJH6YLUpSbRinKLxQPzeFia2JoNli4MIiiDIhyGRgsUYrMx3rI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcK5mHIY3lixR_7BX11uGYi6R5QAheFU65Ky_1JIBpew&oe=6AFB4A89"}, {"file_name": "screen 3.png", "id": "1267217007558767", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75289719_1267217014225433_4328857744247020392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wm7vlxj_ywQ7kNvwH_A09H&_nc_oc=AdpbxIxT-pirQ9bC7JTIUAMTBCfyQC527ytOCA7BK0uPRjG0XVpDPnZNfafao1hkyNs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-PbTG6vP8U_NczZA7Ytel81S19YQtybkT13RzJoXHVQ&oe=6AFB2899"}, {"file_name": "screen 1.png", "id": "1593746084472568", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375752_1593746087805901_3966148832160661515_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1p8Xm9ZCvEQ7kNvwFYcvNw&_nc_oc=AdpiKRcHWu_cQXjmeNUvNWsIwHkKOKg3JLxqBtg_fo4TjvXoLDajlifDymd9H83ULW8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0JJABBhR5rEok3EVeXIu608fwLzQEnxFo5RzlH7QMlA&oe=6AFB1B40"}, {"file_name": "screen 5.png", "id": "1011288603580372", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982685_1011288606913705_6013956803355452003_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScR8TOtqowUQ7kNvwFZfRwn&_nc_oc=AdoLFSvSPSFkNEdSNKxdIZajOsPzEjeKySiQNpeBrxE744UoIvjLQ2GloY9hJ7m8DwY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScNvMPhKCcMemx5I53Mv-HZhY9ZOhN-3DgufFHKhRC2w&oe=6AFB48F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "245591718024449", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297578_245591724691115_5395467863842225092_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnkTi9hadnYQ7kNvwEM7idO&_nc_oc=AdozcnSPXlWORyYtgcz8Rc6Ru5H7J8DAh8RlrQBy4Hva0_Qzi1nLbFOx9PC6q3lcHS0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiRry4Z2S7wfPpUBfn4ckFev6pDlitrgsiWhLC26ekDg&oe=6AFB4DEB"}, "display_name": "The Dawn of Art", "keywords": [], "long_description": "Let Daisy Ridley guide you in your discovery of the Chauvet Cave, a Unesco World Heritage Site, considered one the greatest scientific breakthroughs of the 20th century. \n\nOur humanity\u2019s first masterpiece was created 36, 000 years ago in Ard\u00e8che, France. Within Chauvet Cave lies thousands of drawings, enclosed forever. The Dawn of Art is a Virtual Reality experience, including both an immersive film and a virtual visit of the cave that invites you to meet your prehistoric ancestors, the first humans who ventured in a deep subterranean world and left their marks preserved on the walls.\n\nBrought to you by The Public Union for the Management of the Chauvet Cave, in coproduction with Auvergne-Rh\u00f4ne-Alpes Cin\u00e9ma, with support of Google Arts & Culture, R\u00e9gion Auvergne-Rh\u00f4ne-Alpes, D\u00e9partement de l'Ard\u00e8che and Minist\u00e8re de la Culture. Line Production: Atlas V / Novelab", "short_description": "Explore the Chauvet Cave 36,000 years ago, with Daisy Ridley\u2019s voice as your guide. It\u2019s in the Ard\u00e8che gorges, in the south of France, that our ancestors drew humanity\u2019s first masterpieces, giving life to their beliefs.\n"}]}, "developer_name": "Atlas V, Novelab, Google Arts & Culture, SMERGC", "developer_privacy_policy_url": "https://www.arianestudios.com/the-dawn-of-art-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873",
I5C6a7APXR99w&oe=6A90167E"}, {"file_name": "4.png", "id": "1082334391118730", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/593776279_1082334394452063_3446728606298895558_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzrgIjwkdnwQ7kNvwFdpv8v&_nc_oc=Adr1Eeqvrlgm_RyBdaKrzysXZdChsAK-Q5giIUkqKVAjm9WaGRravvasDg60NPJDH5s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGENqRE14CRfu-dJEglEau-E2Czx7jS7026z1IgeJXN2A&oe=6A900E45"}, {"file_name": "5.png", "id": "1366868191617195", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593845024_1366868194950528_1061737546919481745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP_5RLQeXw4Q7kNvwHu3PED&_nc_oc=Adp2OW2pdM4ZXVg9SDJOi0O4T3SvlwEEWpZ1yTxD0ftaauVNHlbHoN7IPkQ7ft9nw1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYc0PGv26EcBe5QsajDZwYkDcudzyb_kNkdEQqPSmrtg&oe=6A901FF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ducky Taggers", "keywords": [], "long_description": "Jump into an exciting multiplayer movement experience inspired by the fast-paced fun of Gorilla Tag!\n\nRun, climb, swing, and chase your friends as you explore unique environments designed around free movement and competitive gameplay. Use your arms to move through the world, climb to new heights, escape from opponents, and master your movement skills.\n\nWhether you're looking for a casual game to play with friends or want to become the fastest player in the lobby, there\u2019s always something to do. Explore the maps, discover different routes, practice your movement, and create your own challenges.\n\n**Features:**\n\u2022 Fast-paced VR movement and climbing\n\u2022 Multiplayer gameplay with friends\n\u2022 Unique maps and environments\n\u2022 Competitive and casual gameplay\n\u2022 Skill-based movement system\n\u2022 Regular updates and new content\n\nPut on your headset, jump into the action, and see how good your movement skills can become!", "short_description": "Experience fast-paced, movement-based multiplayer action in this Gorilla Tag-inspired fan game. Run, climb, swing, and chase your friends through unique environments while mastering your movement skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1gTuFIsv7tYXULaGBxGc6mT83W_ogPJ_FtFfjIcP1icA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "wethefakers", "support_website_url": null, "website_url": "https://ducky-taggers.base44.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1264882133377955"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "977450995306295"}]}, "baseline_offer": {"id": "977450995306295"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787099160, "status": "PUBLISHED", "id": "977450995306295"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1264924440040391", "version": "0.1"}, "id": "3071865219681945", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1223662404166595", "is_concept": false, "latest_released_binary": {"__typenam
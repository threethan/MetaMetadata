iIUkqKVAjm9WaGRravvasDg60NPJDH5s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGENqRE14CRfu-dJEglEau-E2Czx7jS7026z1IgeJXN2A&oe=6A900E45"}, {"file_name": "5.png", "id": "1366868191617195", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593845024_1366868194950528_1061737546919481745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP_5RLQeXw4Q7kNvwHu3PED&_nc_oc=Adp2OW2pdM4ZXVg9SDJOi0O4T3SvlwEEWpZ1yTxD0ftaauVNHlbHoN7IPkQ7ft9nw1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYc0PGv26EcBe5QsajDZwYkDcudzyb_kNkdEQqPSmrtg&oe=6A901FF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ducky Taggers", "keywords": [], "long_description": "Jump into an exciting multiplayer movement experience inspired by the fast-paced fun of Gorilla Tag!\n\nRun, climb, swing, and chase your friends as you explore unique environments designed around free movement and competitive gameplay. Use your arms to move through the world, climb to new heights, escape from opponents, and master your movement skills.\n\nWhether you're looking for a casual game to play with friends or want to become the fastest player in the lobby, there\u2019s always something to do. Explore the maps, discover different routes, practice your movement, and create your own challenges.\n\n**Features:**\n\u2022 Fast-paced VR movement and climbing\n\u2022 Multiplayer gameplay with friends\n\u2022 Unique maps and environments\n\u2022 Competitive and casual gameplay\n\u2022 Skill-based movement system\n\u2022 Regular updates and new content\n\nPut on your headset, jump into the action, and see how good your movement skills can become!", "short_description": "Experience fast-paced, movement-based multiplayer action in this Gorilla Tag-inspired fan game. Run, climb, swing, and chase your friends through unique environments while mastering your movement skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/docume
\uc11c \ub9cc\ub4e0 \ubaa8\ub378\uc744 \uc5c5\ub85c\ub4dc\ud558\uba74 \ubcc4\ub3c4 \ubcc0\ud658 \uc791\uc5c5 \uc5c6\uc774 VR\uc5d0\uc11c \ubc14\ub85c \uc5f4\ub9bd\ub2c8\ub2e4.\n\n\ubaa8\ub2c8\ud130 \uc18d \ubaa8\ub378\uacfc \uc2e4\uc81c \uacf5\uac04\uac10\uc740 \ub2e4\ub985\ub2c8\ub2e4. Igloo VR\uc5d0\uc11c\ub294 \uc124\uacc4\uc548\uc744 1:1 \uc2a4\ucf00\uc77c\ub85c \uac78\uc5b4 \ub2e4\ub2c8\uba70 \ucc9c\uc7a5 \ub192\uc774, \uac1c\uad6c\ubd80 \ud06c\uae30, \ub3d9\uc120\uc744 \ubab8\uc73c\ub85c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n#### \ud300\uacfc \ud568\uaed8 \ub9ac\ubdf0\ud558\uc138\uc694\n\n\ud63c\uc790 \ubcf4\ub294 \ub370\uc11c \ub05d\ub098\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud300\uc6d0\uacfc \uac19\uc740 \uacf5\uac04\uc5d0 \ub3d9\uc2dc\uc5d0 \uc811\uc18d\ud574 \uc11c\ub85c\uc758 \uc704\uce58\uc640 \uc2dc\uc120\uc744 \ubcf4\uba70 \ub300\ud654\ud558\uace0, \ub808\uc774\uc800 \ud3ec\uc778\ud130\uc640 \uacf5\uac04 \ub4dc\ub85c\uc789\uc73c\ub85c \uc758\uacac\uc744 \ub098\ub20c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c4\ud589\uc790\uac00 \ucc38\uac00\uc790 \uc804\uc6d0\uc744 \uc6d0\ud558\ub294 \uc704\uce58\ub85c \uc548\ub0b4\ud558\ub294 \uc138\uc158 \uae30\ub2a5\uc740 \uc124\uacc4 \ub9ac\ubdf0\uc640 \uc218\uc5c5, \ud074\ub77c\uc774\uc5b8\ud2b8 \ud504\ub808\uc820\ud14c\uc774\uc158\uc5d0 \uc720\uc6a9\ud569\ub2c8\ub2e4.\n\n#### \ubc1c\uacac\ud55c \ubb38\uc81c\ub294 \uadf8 \uc790\ub9ac\uc5d0\uc11c \uae30\ub85d\ud558\uc138\uc694\n\n3D \uacf5\uac04\uc758 \uc815\ud655\ud55c \uc704\uce58\uc5d0 \uc774\uc288\ub97c \ub0a8\uae30\uba74 \uc6f9\uacfc Rhino \ud50c\ub7ec\uadf8\uc778\uc5d0\uc11c\ub3c4 \uac19\uc740 \uc774\uc288\ub97c \ud655\uc778\ud558\uace0 \ub2f5\uae00\uc744 \ub2ec \uc218 \uc788\uc2b5\ub2c8\ub2e4. VR\uc5d0\uc11c \ubc1c\uacac\ud558\uace0, \ub370\uc2a4\ud06c\uc5d0\uc11c \uc218\uc815\ud558\ub294 \ud750\ub984\uc774 \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc774\uc5b4\uc9d1\ub2c8\ub2e4.\n\n#### \uc8fc\uc694 \uae30\ub2a5\n\n- Rhino(.3dm), SketchUp \ubaa8\ub378 \uc5c5\ub85c\ub4dc \ubc0f VR \ub80c\ub354\ub9c1\n- 1:1 \uc2a4\ucf00\uc77c \uc6cc\ud06c\uc2a4\ub8e8\uc640 \uc790\uc720 \uc774\ub3d9\n- \uc2e4\uc2dc\uac04 \uba40\ud2f0\uc720\uc800 \ub9ac\ubdf0: \uc544\ubc14\ud0c0, \ub808\uc774\uc800 \ud3ec\uc778\ud130, \uacf5\uac04 \ub4dc\ub85c\uc789\n- \uc9c4\ud589\uc790 \uc8fc\ub3c4 \ub77c\uc774\ube0c \uc138\uc158\uacfc \ucc38\uac00\uc790 \uc778\uc194\n- 3D \uc88c\ud45c \uae30\ubc18 \uc774\uc288 \ub4f1\ub85d\uacfc \ub313\uae00, \uc6f9\u00b7Rhino \ud50c\ub7ec\uadf8\uc778 \uc5f0\ub3d9\n- \ubc84\uc804 \uad00\ub9ac: \uc218\uc815\ub41c \ubaa8\ub378\uc744 \uc0c8 \ubc84\uc804\uc73c\ub85c \uc62c\ub9ac\uace0 \ube44\uad50\n- QR \ucf54\ub4dc \uac04\ud3b8 \ub85c\uadf8\uc778\n\n\uc124\uacc4 \uac80\ud1a0\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc2dc\uac04\uc744 \uc904\uc774\uace0, \ub3c4\uba74\uc73c\ub85c\ub294 \uc804\ub2ec\ub418\uc9c0 \uc54a\ub358 \uacf5\uac04\uc758 \ubb38\uc81c\ub97c \uc2dc\uacf5 \uc804\uc5d0 \ucc3e\uc544\ub0b4\uc138\uc694.", "short_description": "\uc2a4\ucf00\uce58\uc5c5, \ub77c\uc774\ub178 \ubaa8\ub378\ub9c1\uc744 \uc2e4\uc81c \uc2a4\ucf00\uc77c\ub85c \uac78\uc5b4\ubcf4\uc138\uc694. Igloo VR\uc740 Rhino\uc640 SketchUp \ubaa8\ub378\uc744 \uc27d\uac8c \ubcc0\ud658\ud558\uc5ec VR\ub85c \ubd88\ub7ec\uc624\ub294 \uc124\uacc4 \ub9ac\ubdf0 \ud50c\ub7ab\ud3fc\uc785\ub2c8\ub2e4. \ud300\uc6d0 \ub610\ub294 \ud074\ub77c\uc774\uc5b8\ud2b8\uc640 \uac19\uc740 \uacf5\uac04\uc5d0 \ub3d9\uc2dc \uc811\uc18d\ud574 \ub808\uc774\uc800 \ud3ec\uc778\ud130\uc640 \uacf5\uac04 \ub4dc\ub85c\uc789 \ub4f1\uc73c\ub85c \uc758\uacac\uc744 \ub098\ub204\uace0, 3D \uacf5\uac04\uc758 \uc815\ud655\ud55c \uc704\uce58\uc5d0 \uc774\uc288\ub85c \uae30\ub85d\ud558\uc138\uc694. VR\uc5d0\uc11c \ub0a8\uae34 \uc774\uc288\ub294 \uc6f9\uacfc Rhino \ud50c\ub7ec\uadf8\uc778. Skethcup \ud50c\ub7ec\uadf8\uc778\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://igloo-vr.com/privacy-policy", "developer_terms_of_se
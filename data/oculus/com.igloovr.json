8\u306e\u4e2d\u3092\u5b9f\u5bf8\u30b9\u30b1\u30fc\u30eb\u3067\u6b69\u304d\u56de\u308a\u3001\u5929\u4e95\u9ad8\u3084\u958b\u53e3\u90e8\u306e\u5927\u304d\u3055\u3001\u52d5\u7dda\u3092\u81ea\u5206\u306e\u4f53\u3067\u78ba\u304b\u3081\u3089\u308c\u307e\u3059\u3002\n\n#### \u30c1\u30fc\u30e0\u3067\u30ec\u30d3\u30e5\u30fc\n\n\u30ec\u30d3\u30e5\u30fc\u306f\u30c1\u30fc\u30e0\u3067\u3002\u540c\u3058\u30e2\u30c7\u30eb\u306b\u540c\u6642\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u4e92\u3044\u306e\u4f4d\u7f6e\u3084\u8996\u7dda\u3092\u898b\u306a\u304c\u3089\u3001\u30ec\u30fc\u30b6\u30fc\u30dd\u30a4\u30f3\u30bf\u30fc\u3084\u7a7a\u9593\u30c9\u30ed\u30fc\u30a4\u30f3\u30b0\u3067\u610f\u898b\u3092\u4ea4\u308f\u305b\u307e\u3059\u3002\u30db\u30b9\u30c8\u304c\u53c2\u52a0\u8005\u5168\u54e1\u3092\u540c\u3058\u5834\u6240\u3078\u6848\u5185\u3067\u304d\u308b\u30bb\u30c3\u30b7\u30e7\u30f3\u6a5f\u80fd\u306f\u3001\u8a2d\u8a08\u30ec\u30d3\u30e5\u30fc\u3084\u6388\u696d\u3001\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u3078\u306e\u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u306b\u6700\u9069\u3067\u3059\u3002\n\n#### \u6c17\u3065\u3044\u305f\u554f\u984c\u306f\u305d\u306e\u5834\u3067\u8a18\u9332\n\n3D\u7a7a\u9593\u306e\u6b63\u78ba\u306a\u4f4d\u7f6e\u306b\u8ab2\u984c\u3092\u6b8b\u305b\u3070\u3001Web\u30d3\u30e5\u30fc\u30a2\u30fc\u3084Rhino\u30d7\u30e9\u30b0\u30a4\u30f3\u3067\u3082\u540c\u3058\u8ab2\u984c\u3092\u78ba\u8a8d\u3057\u3066\u8fd4\u4fe1\u3067\u304d\u307e\u3059\u3002VR\u3067\u898b\u3064\u3051\u3066\u3001\u30c7\u30b9\u30af\u3067\u4fee\u6b63\u3059\u308b\u6d41\u308c\u304c\u81ea\u7136\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\n\n#### \u4e3b\u306a\u6a5f\u80fd\n\n- Rhino(.3dm)\u3001SketchUp\u30e2\u30c7\u30eb\u306e\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3068VR\u8868\u793a\n- \u5b9f\u5bf8\u30b9\u30b1\u30fc\u30eb\u306e\u30a6\u30a9\u30fc\u30af\u30b9\u30eb\u30fc\u3068\u81ea\u7531\u306a\u79fb\u52d5\n- \u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u591a\u4eba\u6570\u30ec\u30d3\u30e5\u30fc:\u30a2\u30d0\u30bf\u30fc\u3001\u30ec\u30fc\u30b6\u30fc\u30dd\u30a4\u30f3\u30bf\u30fc\u3001\u7a7a\u9593\u30c9\u30ed\u30fc\u30a4\u30f3\u30b0\n- \u30db\u30b9\u30c8\u4e3b\u5c0e\u306e\u30e9\u30a4\u30d6\u30bb\u30c3\u30b7\u30e7\u30f3\u3068\u53c2\u52a0\u8005\u306e\u8a98\u5c0e\n- 3D\u5ea7\u6a19\u306b\u7d10\u3065\u304f\u8ab2\u984c\u306e\u767b\u9332\u3068\u8fd4\u4fe1\u3001Web\u30fbRhino\u30d7\u30e9\u30b0\u30a4\u30f3\u3068\u306e\u9023\u643a\n- \u30d0\u30fc\u30b8\u30e7\u30f3\u7ba1\u7406:\u4fee\u6b63\u3057\u305f\u30e2\u30c7\u30eb\u3092\u65b0\u3057\u3044\u30d0\u30fc\u30b8\u30e7\u30f3\u3068\u3057\u3066\u6bd4\u8f03\n- QR\u30b3\u30fc\u30c9\u306b\u3088\u308b\u7c21\u5358\u30ed\u30b0\u30a4\u30f3\n\n\u8a2d\u8a08\u30ec\u30d3\u30e5\u30fc\u306b\u304b\u304b\u308b\u6642\u9593\u3092\u6e1b\u3089\u3057\u3001\u56f3\u9762\u3067\u306f\u4f1d\u308f\u3089\u306a\u3044\u7a7a\u9593\u306e\u554f\u984c\u3092\u7740\u5de5\u524d\u306b\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002", "short_description": "\u5efa\u7bc93D\u30e2\u30c7\u30eb\u306e\u4e2d\u3092\u5b9f\u5bf8\u3067\u6b69\u3044\u3066\u307f\u307e\u3057\u3087\u3046\u3002Igloo VR\u306f\u3001Rhino\u3084SketchUp\u306e\u30e2\u30c7\u30eb\u3092\u5909\u63db\u4f5c\u696d\u306a\u3057\u306bVR\u3067\u958b\u3051\u308b\u8a2d\u8a08\u30ec\u30d3\u30e5\u30fc\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u3059\u3002\u30c1\u30fc\u30e0\u3067\u540c\u3058\u7a7a\u9593\u306b\u540c\u6642\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u30ec\u30fc\u30b6\u30fc\u30dd\u30a4\u30f3\u30bf\u30fc\u3084\u7a7a\u9593\u30c9\u30ed\u30fc\u30a4\u30f3\u30b0\u3067\u610f\u898b\u3092\u4ea4\u308f\u3057\u3001\u6c17\u3065\u3044\u305f\u554f\u984c\u306f3D\u7a7a\u9593\u306e\u6b63\u78ba\u306a\u4f4d\u7f6e\u306b\u8ab2\u984c\u3068\u3057\u3066\u8a18\u9332\u3067\u304d\u307e\u3059\u3002VR\u3067\u6b8b\u3057\u305f\u8ab2\u984c\u306fWeb\u30d3\u30e5\u30fc\u30a2\u30fc\u3084Rhino\u30d7\u30e9\u30b0\u30a4\u30f3\u3068\u540c\u671f\u3055\u308c\u308b\u305f\u3081\u3001\u30ec\u30d3\u30e5\u30fc\u304b\u3089\u4fee\u6b63\u307e\u3067\u306e\u6d41\u308
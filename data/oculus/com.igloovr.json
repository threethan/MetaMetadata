E86x05N7QO0ZM6HW6PKKUC3I5q1ysjr4wMHk6n2pzDzGZnaERfaGiCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5aH73XW6uCVww2-VLTC3_vmV7vX8qf435JMjJvxDROw&oe=6B07039D"}, {"file_name": "igloo-screenshot-4-issue.png", "id": "1716351282960590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1716351286293923_822295218644711639_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0_OrszEcsUQ7kNvwFMZZa4&_nc_oc=Adp1lBn2_UlhEy4eH4E9_T6B3f8ve295MvVNqLj9kNQXYdJGptNpJwVp7v01xNYxQMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1uR0J0xyEJ8YCwIFeEB9OnKQRTe8bwkBOsr8hFgeXYw&oe=6B07261E"}, {"file_name": "igloo-screenshot-5-measure.png", "id": "2319318722139266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_2319318725472599_8124581633368109306_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW4pYb8S7rkQ7kNvwF6HuKb&_nc_oc=AdoebTAewZFVLnjoHyuJhK0TY9HaV3st0qgPCfb0nrk0zX8QQRsqTQ9M-1efpbo-PQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx3Bf4yqCXcB-yoYi1iCPgGSGUOP9riaQKbdc-wX4sPw&oe=6B07252F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_logo_2560x1440.png", "id": "2174875710130754", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593853621_2174875713464087_6139660452388410123_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECPSDxU3-4wQ7kNvwGvWckD&_nc_oc=Ado2H6-PHZTI-p-qcJl1ZTWZgSkURy-ocLZ2TDtJ39gfQsD6sPdAmFREhAsTFIincWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf5ZvBn5UaMijZe7gg0jX5jS7QbRZp2u1b11otLAMAxA&oe=6B06F7AF"}, "display_name": "IGLOO VR", "keywords": ["Architecture", "interior"], "long_description": "**Igloo VR is a 3D model review platform for architecture and design teams.** Upload a model from Rhino or SketchUp and open it in VR, with no manual conversion required.\n\nA model on a monitor never tells you how a space actually feels. In Igloo VR you walk through your design at 1:1 scale and judge ceiling heights, openings, and circulation with your own body.\n\n#### Review together\n\nReview is better as a team. Join the same model with your colleagues, see each other's position and gaze, and talk through the design using laser pointers and spatial drawing. A host can guide every participant to the same spot, which makes live sessions ideal for design reviews, classes, and client presentations.\n\n#### Record problems on the spot\n\nIssues are pinned to exact 3D coordinates and stay in sync with the web viewer and the Rhino plugin, so you can find problems in VR and fix them back at your desk.\n\n#### Key features\n\n- Upload and render Rhino (.3dm) and SketchUp models in VR\n- Full-scale walkthroughs with free movement\n- Real-time multiuser review: avatars, laser pointers, spatial drawing\n- Host-led live sessions with guided navigation\n- Issues pinned to 3D coordinates, with replies synced to web and Rhino\n- Version history: upload revisions and compare them\n- Quick sign-in with a QR code\n\nShorten your design review cycles and catch the spatial problems drawings never show, before construction begins.", "short_description": "Walk through your architectural models at full scale. Igloo VR is a design review platform that brings Rhino and SketchUp models into VR with no manual conversion. Join the same space with your team, share feedback using laser pointers and spatial drawing, and pin issues to exact 3D coordinates. Every issue you leave in VR stays in sync with the web viewer and the Rhino plugin, so review and revision flow together without friction."}, {"images": {"nodes": [{"file_name": "hero_cover_3000x900.png", "id": "2187420345148406", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619602_2187420348481739_2256582171848089909_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UYu2paNsL4Q7kNvwHwondL&_nc_
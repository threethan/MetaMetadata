r": null, "video_trailer_thumbnail": {"file_name": "Raiju_Trailer_Thumb.png", "id": "3362649140532184", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393554_3362649143865517_1570411550536437535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6UD3gQdI8wQ7kNvwHjxlMA&_nc_oc=AdpWk5Fk4XGJ4-dIH7lhZxLuVIHGTOuRLC0mpmpbp-UHyprz6y6DHD_BOKblTurw-dA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lh8igcjRYGBj3k1csd2CE5AEFNJf8i2w1ZCBlCtXAmw&oe=6A395A8E"}, "display_name": "Raiju: Lightning Arena", "keywords": ["Racing", "Raiju", "Arena", "Avatar"], "long_description": "## **Challenge the Ultimate High-Speed Hoverbike Race!**  \n*Raiju: Lightning Arena* combines strategic customization with high-speed VR racing. Take control of your hoverbike and aim to become the **fastest in the world**!  \nRace against other players' custom hoverbikes and six AI-controlled drones. Speed alone won\u2019t secure victory\u2014strategic upgrades will determine the winner.  \n\n## **Racing \u00d7 Build System**  \nThis game features a unique real-time upgrade system.  \n- **Earn points to upgrade:** Points accumulate over time, but you can also earn extra points by attacking enemy players and drones!  \n- **Upgrade in real-time during the race:** Spend your points on speed boosts, acceleration enhancements, attack power upgrades, and more. Gather points early, enhance your equipment, and shave down your race time!  \n\n## **Your Avatar, Your Ride!**  \nThis is a **third-person VR racing game**, where you control a hoverbike ridden by your **Meta avatar**.  \nCompete against enemy players, each controlling their own avatar, in high-intensity, immersive VR races.  \n\n## **About Early Access**  \n*Raiju: Lightning Arena* is currently in **Early Access**!  \nAt this stage, the game features **two hoverbikes and one race track**, with more hoverbikes and tracks planned for future updates. Jump in now and be among the first to experience the evolution of VR racing!  \n\n\ud83d\ude80 **Speed and strategy collide\u2014aim to be the fastest in the world!**  \n", "short_description": "Raiju: Lightning Arena is a VR hoverbike racing game that combines strategic customization with high-speed competition. Players control a hoverbike ridden by their Meta avatar, racing against custom machines from other players and six AI-controlled drones.\n\nThe game features a unique build system, allowing players to purchase upgrade parts using points earned during the race. Points accumulate over time or can be gained by attacking opponents and drones. Strengthening your hoverbike early on is "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hatchpotvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "https://share.hsforms.com/1KkIqo1_ZSie4hbsVtX0Vowccliw", "support_website_url": null, "website_url": "https://raijuarena.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9153123268039824"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1165377418383636"}]}, "baseline_offer": {"id": "1165377418383636"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741961520, "status": "PUBLISHED", "id": "1165377418383636"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23866401092952132",
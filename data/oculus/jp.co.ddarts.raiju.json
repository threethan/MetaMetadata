_1650761969886894499_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNz0KsCc2PUQ7kNvwFOhBRJ&_nc_oc=AdpWrzGdCM_1MXepcd3q6SCMEwKKJVSOC5Xsi-WOf3Bovru_4gsEpd2ZaX0dp920wag&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hDFOZPHV3HWA0p0dkxKXMFzzIWL_z-yQ-PUxezRo5xA&oe=6A396374"}, {"file_name": "jp.co.ddarts.raiju-20250224-011803.png", "id": "612854374710688", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391911_612854378044021_5945160186777249411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji2fURcPMBsQ7kNvwHXMzS8&_nc_oc=AdrFwBflXG7Va9RgOb82tUwPGQBP3AC_uEC9BJIe3zTZrjQadFRVI8iTG-IZ6i2kJ7U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RAPa4TiDestY6RiwrZ1SoGbPAAoj1cpBNrXR4FMnA8Q&oe=6A395A3A"}, {"file_name": "jp.co.ddarts.raiju-20250224-011911.png", "id": "657015976664534", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393372_657015979997867_3394665084632655117_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAmaRwAWBw4Q7kNvwFmsnIy&_nc_oc=AdpbQnkqRBx2t2AbcmReRmsWfWAzGi7FDntzBZuUnhMBnV7pH3fJeJ_HpVcN_NUn-qA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D5YEBx_91zzCYYobenmTq0v6j0jGhYe_fzuLkotQEKw&oe=6A3953F1"}, {"file_name": "jp.co.ddarts.raiju-20250224-020618.png", "id": "1880769179363389", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393531_1880769182696722_2160971526039395291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls_f7vsPKZ4Q7kNvwE1kXaw&_nc_oc=AdqCjp4iTOm2CURNi2D1UGPDIuThB-zO8eASa6-JZFqmc2rlPlgBmGGlAPuYR82sUuM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J8lGIQyjcla7NrC70atKlfGQsJs-kkcvj2fXNTTQIxw&oe=6A393249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Raiju_Trailer_Thumb.png", "id": "3362649140532184", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393554_3362649143865517_1570411550536437535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6UD3gQdI8wQ7kNvwHjxlMA&_nc_oc=AdpWk5Fk4XGJ4-dIH7lhZxLuVIHGTOuRLC0mpmpbp-UHyprz6y6DHD_BOKblTurw-dA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lh8igcjRYGBj3k1csd2CE5AEFNJf8i2w1ZCBlCtXAmw&oe=6A395A8E"}, "display_name": "Raiju: Lightning Arena", "keywords": ["Racing", "Raiju", "Arena", "Avatar"], "long_description": "## **Challenge the Ultimate High-Speed Hoverbike Race!**  \n*Raiju: Lightning Arena* combines strategic customization with high-speed VR racing. Take control of your hoverbike and aim to become the **fastest in the world**!  \nRace against other players' custom hoverbikes and six AI-controlled drones. Speed alone won\u2019t secure victory\u2014strategic upgrades will determine the winner.  \n\n## **Racing \u00d7 Build System**  \nThis game features a unique real-time upgrade system.  \n- **Earn points to upgrade:** Points accumulate over time, but you can also earn extra points by attacking enemy players and drones!  \n- **Upgrade in real-time during the race:** Spend your points on speed boosts, acceleration enhancements, attack power upgrades, and more. Gather points early, enhance your equipment, and shave down your race time!  \n\n## **Your Avatar, Your Ride!**  \nThis is a **third-person VR racing game**, where you control a hoverbike ridden by your **Meta avatar**.  \nCompete against enemy players, each controlling their own avatar, in high-intensity, immersive VR races.  \n\n## **About Early Access**  \n*Raiju: Lightning Arena* is currently in **Early Access**!  \nAt this stage, the game features **two hoverbikes and one race track**, with more hoverbikes and tracks planned for future updates. Jump in now and be among the first to experience the evolution of VR racing!  \n\n\ud83d\ude80 **Speed and strategy collide\u2014aim to be the fastest in the world!**  \n", "short_description": "Raiju: Lightning Arena is a VR hoverbike racing game that combines strategic customization with high-speed competition. Players control a hoverbike ridden by their Meta avatar, racing against custom machines from other players and six AI-controlled drones.\n\nThe game features a unique build system, allowing players to purchase upgrade parts using points earned during the race. Points accumulate over time or can be gained by attacking opponents and drones. Strengthening your hoverbike early on is "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hatchpotvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "https://share.hsforms.com/1KkIqo1_ZSie4hbsVtX0Vowccliw", "support_website_url": null, "website_url": "https://raijuarena.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9153123268039824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392129_1424437125200303_2675695438890440611_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Oc-rdCnJkQ7kNvwHgrE49&_nc_oc=AdoOwdjBh3cCWi4nBc93Jub9ta0IC3EBsQEiYO5ZZ81zq82JAgBqNZdYjR1Uk_7_bk0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90PaurAzvo7yRC550WJAAnRaU5sL3bLZafBQZfj3Q7Tw&oe=6A394B9B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Raiju: Lightning Arena", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}], "release_date": 1741961520, "lastRevision": {"nodes": [{"id": "9153123271373157", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9153123258039825", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "698817705817319"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2383809751959201", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raiju: Lightning Arena", "keywords": ["\u30ec\u30fc\u30b9", "\u30a2\u30d0\u30bf\u30fc", "Raiju", "\u30d3\u30eb\u30c9"], "long_description": "## **\u8d85\u9ad8\u901f\u306e\u30db\u30d0\u30fc\u30d0\u30a4\u30af\u30ec\u30fc\u30b9\u306b\u6311\u3081\uff01**  \n\u300eRaiju: Lightning Arena\u300f\u306f\u3001\u6226\u7565\u7684\u306a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3068\u30cf\u30a4\u30b9\u30d4\u30fc\u30c9\u306a\u30ec\u30fc\u30b9\u304c\u878d\u5408\u3057\u305fVR\u30ec\u30fc\u30b9\u30b2\u30fc\u30e0\u3002\u30db\u30d0\u30fc\u30d0\u30a4\u30af\u3092\u99c6\u308a\u3001**\u4e16\u754c\u6700\u901f**\u3092\u76ee\u6307\u305b\uff01  \n\u30ec\u30fc\u30b9\u306e\u76f8\u624b\u306f\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30ab\u30b9\u30bf\u30e0\u3057\u305f\u30db\u30d0\u30fc\u30d0\u30a4\u30af\u30686\u6a5f\u306e\u30c9\u30ed\u30fc\u30f3\u3002\u30b9\u30d4\u30fc\u30c9\u3060\u3051\u3067\u306a\u304f\u3001\u6226\u7565\u7684\u306a\u5f37\u5316\u304c\u52dd\u6557\u3092\u5206\u3051\u308b\u3002  \n\n## **\u30ec\u30fc\u30b9 \u00d7 \u30d3\u30eb\u30c9\u30b7\u30b9\u30c6\u30e0**  \n\u3053\u306e\u30b2\u30fc\u30e0\u306e\u6700\u5927\u306e\u7279\u5fb4\u306f\u3001\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u3067\u306e\u30d1\u30fc\u30c4\u5f37\u5316\u30b7\u30b9\u30c6\u30e0\u3002  \n- **\u30dd\u30a4\u30f3\u30c8\u3092\u8caf\u3081\u3066\u5f37\u5316:** \u6642\u9593\u7d4c\u904e\u3068\u3068\u3082\u306b\u30dd\u30a4\u30f3\u30c8\u304c\u5897\u52a0\u3002\u3055\u3089\u306b\u3001\u30c9\u30ed\u30fc\u30f3\u3084\u6575\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u653b\u6483\u3059\u308b\u3053\u3068\u3067\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\uff01  \n- **\u30ec\u30fc\u30b9\u4e2d\u306b\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u5f37\u5316:** \u8caf\u3081\u305f\u30dd\u30a4\u30f3\u30c8\u3092\u4f7f\u3044\u3001\u901f\u5ea6\u30a2\u30c3\u30d7\u3001\u52a0\u901f\u6027\u80fd\u5f37\u5316\u3001\u653b\u6483\u529b\u5411\u4e0a\u306a\u3069\u3001\u88c5\u5099\u30d1\u30fc\u30c4\u3092\u8cfc\u5165\u3002\u5e8f\u76e4\u306b\u30dd\u30a4\u30f3\u30c8\u3092\u7a3c\u304e\u3001\u88c5\u5099\u3092\u5145\u5b9f\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u901f\u3044\u30bf\u30a4\u30e0\u3092\u53e9\u304d\u51fa\u305b\u308b\uff01  \n\n## **\u3042\u306a\u305f\u306e\u30a2\u30d0\u30bf\u30fc\u304c\u30e9\u30a4\u30c0\u30fc\u306b\uff01**  \n\u672c\u4f5c\u306f**\u4e09\u4eba\u79f0\u8996\u70b9\u306eVR\u30ec\u30fc\u30b9\u30b2\u30fc\u30e0**\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u81ea\u5206\u306e**Meta\u30a2\u30d0\u30bf\u30fc\u304c\u642d\u4e57\u3059\u308b\u30db\u30d0\u30fc\u30d0\u30a4\u30af\u3092\u64cd\u7e26**\u3057\u3001\u30b9\u30ea\u30ea\u30f3\u30b0\u306a\u30ec\u30fc\u30b9\u306b\u6311\u3080\u3002  \n\u30ec\u30fc\u30b9\u4e2d\u306e\u6575\u30d7\u30ec\u30a4\u30e4\u30fc\u3082\u3001\u305d\u308c\u305e\u308c\u306e\u30a2\u30d0\u30bf\u30fc\u304c\u30d0\u30a4\u30af\u306b\u8de8\u3063\u3066\u304a\u308a\u3001\u81e8\u5834\u611f\u3042\u3075\u308c\u308b\u30ec\u30fc\u30b9\u30d0\u30c8\u30eb\u304c\u697d\u3057\u3081\u308b\u3002  \n\n## **\u30a2\u30fc\u30ea\u30fc\u30a2\u30af\u30bb\u30b9\u306b\u3064\u3044\u3066**  \n\u300eRaiju: Lightning Arena\u300f\u306f\u73fe\u5728**\u30a2\u30fc\u30ea\u30fc\u30a2\u30af\u30bb\u30b9\u7248**\u3068\u3057\u3066\u30ea\u30ea\u30fc\u30b9\u4e2d\uff01  \n\u73fe\u6642\u70b9\u3067\u306f\u3001**\u30db\u30d0\u30fc\u30d0\u30a4\u30af2\u53f0\u3001\u30b3\u30fc\u30b91\u3064**\u3092\u30d7\u30ec\u30a4\u53ef\u80fd\u3002\u4eca\u5f8c\u3001\u3055\u3089\u306a\u308b\u30d0\u30a4\u30af\u3084\u30b3\u30fc\u30b9\u306e\u8ffd\u52a0\u3092\u4e88\u5b9a\u3057\u3066\u3044\u307e\u3059\u3002\u4eca\u3059\u3050\u30d7\u30ec\u30a4\u3057\u3066\u3001\u9032\u5316\u3057\u3066\u3044\u304f\u30ec\u30fc\u30b9\u4f53\u9a13\u3092\u5148\u53d6\u308a\u3057\u3088\u3046\uff01  \n\n\ud83d\ude80 **\u30b9\u30d4\u30fc\u30c9\u3068\u6226\u7565\u304c\u4ea4\u5dee\u3059\u308b\u3053\u306e\u4e16\u754c\u3067\u3001\u4e16\u754c\u6700\u901f\u3092\u76ee\u6307\u305b\uff01**  \n", "short_description": "\u300eRaiju: Lightning Arena\u300f\u306f\u3001\u6226\u7565\u7684\u306a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3068\u9ad8\u901f\u30ec\u30fc\u30b9\u304c\u878d\u5408\u3057\u305fVR\u30db\u30d0\u30fc\u30d0\u30a4\u30af\u30b2\u30fc\u30e0\u3067\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u81ea\u8eab\u306eMeta\u30a2\u30d0\u30bf\u30fc\u304c\u642d\u4e57\u3059\u308b\u30db\u30d0\u30fc\u30d0\u30a4\u30af\u3092\u64cd\u7e26\u3057\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30ab\u30b9\u30bf\u30e0\u30de\u30b7\u30f3\u30846\u6a5f\u306e\u30c9\u30ed\u30fc\u30f3\u3068\u7af6\u3044\u307e\u3059\u3002\n\n\u30ec\u30fc\u30b9\u4e2d\u306b\u7372\u5f97\u3057\u305f\u30dd\u30a4\u30f3\u30c8\u3067\u5f37\u5316\u30d1\u30fc\u30c4\u3092\u8cfc\u5165\u3057\u3001\u30b9\u30d4\u30fc\u30c9\u3084\u653b\u6483\u6027\u80fd\u3092\u5f37\u5316\u3059\u308b\u300c\u30d3\u30eb\u30c9\u30b7\u30b9\u30c6\u30e0\u300d\u304c\u7279\u5fb4\u3002\u6642\u9593\u7d4c\u904e\u3084\u653b\u6483\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u8caf\u3081\u3001\u5e8f\u76e4\u304b\u3089\u88c5\u5099\u3092\u5145\u5b9f\u3055\u305b\u308b\u3053\u3068\u304c\u52dd\u5229\u306e\u9375\u3068\u306a\u308a\u307e\u3059\u3002\n\n\u672c\u4f5c\u306f\u73fe\u5728\u30a2\u30fc\u30ea\u30fc\u30a2\u30af\u30bb\u30b9\u7248\u3068\u3057\u3066\u30ea\u30ea\u30fc\u30b9\u4e2d\u3002\u30db\u30d0\u30fc\u30d0\u30a4\u30af2\u53f0\u3001\u30b3\u30fc\u30b91\u3064\u3092\u30d7\u30ec\u30a4\u53ef\u80fd\u3067\u3001\u4eca\u5f8c\u3055\u3089\u306a\u30
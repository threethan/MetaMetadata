6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGORbZrAgjbQy2wQi1eWzAnz00A9z7JMzB4skJ7EtyB9A&oe=6A8EC202"}, {"file_name": "3b.png", "id": "610278268104384", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57572925_610278271437717_3209690887684815254_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvnIiDmrdcoQ7kNvwFKsEr7&_nc_oc=AdqaCCYUkR-vHsq-RgxFnX5Xgkml4BQYYfolq5-Ak3nIU5uviccw_e91AxRIQS6IQo4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlQ_uT8BSMddJxi4EtnCVEUtLlba-yTbS1ePPuzV0Rhg&oe=6A8EDA96"}, {"file_name": "5c.png", "id": "1142835177276835", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982547_1142835183943501_7246830232271420265_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX5nipkfiVgQ7kNvwEvqnJ8&_nc_oc=Adq4gt4t_S30Nc9DuD7mIV41QXYYfA_yTfihb3bZXV30Jrq5ZAmKvDztGaeBixV0VAo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8m3NSM-SxRbw3RHz15r3eyun_7011sI0xHgnJsjKf0g&oe=6A8EDB4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "561627380079916", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003226_561627386746582_1954839479078721397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W00NVmWFtKAQ7kNvwHDtX51&_nc_oc=AdoeXrQBr9P7Fb5mOV2Krzdxl1Nb7s744aZs17ozFkw-Xeagxvn4a3gp2SytihpT0ec&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRgZ4u8ps1dCfrj5xhu7QNwWSkbLYyo4kVueCU6ghCag&oe=6A8EF31A"}, "display_name": "Walk the Plank", "keywords": ["Plank", "Walk", "experience", "elevator", "Heights"], "long_description": "**Your next gen plank walking simulator**, set high up in New York City, only playable on Quest 3/3S hardware, at the introductory price of just $4.99. It's the perfect experience to show off your new headset!\n{1145915837225515}\n# The Ultimate Welcome To VR\nBring friends and family together for great laughs as everyone\u2019s knees go weak on a thin plank atop the One Astor Plaza skyscraper!\n{1355526585684846}\n# Next Gen Realism\nWe set out to push the limits of what the most realistic plank simulator could be only on next gen Quest 3 and Quest 3S hardware. \n{569899162336154}\n# Plank Variety\n4 plank variations including: Wood Plank, Glass Plank, The Pole, and Red Light Green Light. More to come!\n{3774236396148078}\n# Health and Safety Warning\nAll users must refer to the in-game EULA and Safety Guidelines to limit the risk of injury or harm when walking the virtual plank.", "short_description": "Your next gen plank walking simulator, set high up in New York City, only playable on Quest 3 and 3S hardware, just $4.99. Bring family and friends together for this intense welcome to VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamedigits.co.uk/docs/PrivacyPolicyWalkThePlank.html", "developer_terms_of_service_url": null, "publisher_name": "GameDigits Ltd", "support_website_url": null, "website_url": "https://www.gamedigits.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8981300728637448"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1828493294799052"}, {"status": "PUBLISHED", "id": "1699681051282800"}, {"status": "PUBLISHED", "id": "1786507918980993"}, {"status": "PUBLISHED", "id": "1026470433142613"}, {"status": "PUBLISHED", "id": "1679109519914733"}, {"status": "PUBLISHED", "id": "744824224951
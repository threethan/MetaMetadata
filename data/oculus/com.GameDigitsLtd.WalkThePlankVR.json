_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pP17UY-3NboQ7kNvwGG40OF&_nc_oc=Adpl_7nf0nIBPDOEeUfUl3uznuS1-yc7ezNOhAChcS1vAoGvML2P2JQZ6cwN1L6XpzM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3LPlpgrtVeCoGXPKjzgXgtWJvc8lEbQCp_CrV0R3-qcA&oe=69F1F816"}, {"file_name": "5c.png", "id": "1142835177276835", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982547_1142835183943501_7246830232271420265_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v6ZSjB4ISAQ7kNvwFFDeiK&_nc_oc=Adoi-s-UNONfV4cLDMGJnIamcu2yoRhKpWroJ8PSQ2A0d1DNbJKwkJZLaOMcpRFKgao&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3pUXU_eAXRDwVzyxczIWyXGOL_l1u3rfnvJksud3lQOQ&oe=69F1F8CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "561627380079916", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003226_561627386746582_1954839479078721397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNnu163wUI0Q7kNvwEftFXU&_nc_oc=AdpfDS07sRc74a40gGt1s9YmjWlt5oEsvahLuWfyYGt-ITiavju-HStGJUOin28aigA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3RqOfvrEhJgWTNfcageQTfF7LAWAmGRau-FTKdfP0BUQ&oe=69F2109A"}, "display_name": "Walk the Plank", "keywords": ["Plank", "Walk", "experience", "elevator", "Heights"], "long_description": "**Your next gen plank walking simulator**, set high up in New York City, only playable on Quest 3/3S hardware, at the introductory price of just $4.99. It's the perfect experience to show off your new headset!\n{1145915837225515}\n# The Ultimate Welcome To VR\nBring friends and family together for great laughs as everyone\u2019s knees go weak on a thin plank atop the One Astor Plaza skyscraper!\n{1355526585684846}\n# Next Gen Realism\nWe set out to push the limits of what the most realistic plank simulator could be only on next gen Quest 3 and Quest 3S hardware. \n{569899162336154}\n# Plank Variety\n4 plank variations including: Wood Plank, Glass Plank, The Pole, and Red Light Green Light. More to come!\n{3774236396148078}\n# Health and Safety Warning\nAll users must refer to the in-game EULA and Safety Guidelines to limit the risk of injury or harm when walking the virtual plank.", "short_description": "Your next gen plank walking simulator, set high up in New York City, only playable on Quest 3 and 3S hardware, just $4.99. Bring family and friends together for this intense welcome to VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamedigits.co.uk/docs/PrivacyPolicyWalkThePlank.html", "developer_terms_of_service_url": null, "publisher_name": "GameDigits Ltd", "support_website_url": null, "website_url": "https://www.gamedigits.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8981300728637448"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1679109519914733"}, {"status": "PUBLISHED", "id": "744824224951024"}, {"status": "PUBLISHED", "id": "3805948382875753"}, {"status": "PUBLISHED", "id": "1220565823331156"}, {"status": "PUBLISHED", "id": "906529809131511"}, {"status": "PUBLISHED", "id": "2251209678727264"}, {"status": "PUBLISHED", "id": "1084589986550993"}, {"status": "PUBLISHED", "id": "1028116711986723"}, {"status": "PUBLISHED", "id": "1178352690398579"}, {"status": "CANCELLED", "id": "523106807539586"}, {"status": "PUBLISHED", "id": "1302003124176722"}, {"status": "PUBLISHED", "id": "95233677348654
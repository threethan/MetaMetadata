ile_name": "2.png", "id": "3383865991744699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031354_3383866001744698_714043326971172642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdyYNcTYQiIQ7kNvwHaEN74&_nc_oc=AdqREiXFm6H6VGxMUQjXguPwqGlmcY812N9eOwkKbOVGV-8_ERj_G42d69Zls5psxc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQXAPpoTFz_CrRyfkIGBcxrRlfFWBxqUK-gbhQyLA-xQ&oe=6A82E482"}, {"file_name": "London4.png", "id": "1388194346278267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307309_1388194349611600_3381100320227276132_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3IPrZd0fkcQ7kNvwEOIlxe&_nc_oc=AdogX4dMXixjo-5Np_bAYq31JeOF0km396fgxDB_axNJ6Fez1Pyv-sMB0pFhX83-k1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAwfKISk9CqNda2lolbinp9edDBSLHc6PLMFP1jpbDsw&oe=6A830F45"}, {"file_name": "3c.png", "id": "693688699761016", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391863_693688706427682_4476432013876242881_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpP1pQt8RcgQ7kNvwHRba8E&_nc_oc=AdpBIqyVyzkf-KvdnY2QZacWXPRgsWi_noT7UlXVcW96FzhpwgpW4myx9Kqml6x4brI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzz2Or_LAgPLUPEdXzbKk-zsQZpHLzeGpumTy6t737gg&oe=6A831550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WalkThePlankLondonUpdate - Landscape 2.png", "id": "1884881742419190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618440_1884881745752523_7087372941322728798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4uKshc-PqMQ7kNvwEnyPom&_nc_oc=Ado5ZeDabNnNHCahpDYqsj7iz6WFKAjLtkmWylSnhvBGf4EgE88OUAsbpdXbV8wvi04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvrestXKIpVPq2xSuO2X4pr-ZSnu-CC9mZ_MKaUgY7yQ&oe=6A82EA1E"}, "display_name": "Walk the Plank", "keywords": ["Plank", "Walk", "experience", "elevator", "walktheplank"], "long_description": "# The Ultimate Welcome To VR Experience\n**Your next gen plank walking simulator**, set high up in ultra realistic New York City and now London's Big Ben. It's the perfect first experience to show off your new headset! \n{1145915837225515}\nBring friends and family together for great laughs as everyone\u2019s knees go weak on a thin plank atop the One Astor Plaza skyscraper and Big Ben!\n{1355526585684846}\n# Next Gen Realism\nWe set out to push the limits of what the most realistic plank simulator could be on next gen Quest hardware.\n{569899162336154}\n# Plank Variety\n6 plank variations including: Wood Plank, Glass Plank, Metal Grate, The Pole, Red Light Green Light and Roulette. More to come!\n{3774236396148078}\n# Three Environments Included and Counting!\nWelcome London to the party!\n{2231970060632455}\n# Health and Safety Warning\nAll users must refer to the in-game EULA and Safety Guidelines to limit the risk of injury or harm when walking the virtual plank.", "short_description": "Your next gen plank walking simulator, set high up in ultra realistic New York City and London. Bring family and friends together for this intense welcome to VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamedigits.co.uk/docs/PrivacyPolicyWalkThePlank.html", "developer_terms_of_service_url": null, "publisher_name": "GameDigits Ltd", "support_website_url": null, "website_url": "https://www.gamedigits.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tr
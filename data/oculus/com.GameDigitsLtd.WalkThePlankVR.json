596C1"}, {"file_name": "2.png", "id": "3383865991744699", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031354_3383866001744698_714043326971172642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2mRHAEfHV4Q7kNvwFsaIz6&_nc_oc=AdpB1SEyJvsidVLQjnMPe59lkEMAR50E41_6YGHOfM6nDX17L_CQ0qPuv5ue2CdOV7k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzN5AQaE87vNnMBnHboh2acLdpT-alJCTZLntDdluqtQ&oe=6A858782"}, {"file_name": "London4.png", "id": "1388194346278267", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307309_1388194349611600_3381100320227276132_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yk-BFwf2mUcQ7kNvwGKX_2Z&_nc_oc=AdpwIHpx0GS1dPtMD1qQJfPpxxhivH1obds9wRhwbtrZdWwWTkRSXN0AT8MNBk9pB1I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY0w3PI7QCN6Wb_uvC7grSp7XgS5dcfVl1rq__JIdljg&oe=6A857A05"}, {"file_name": "3c.png", "id": "693688699761016", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391863_693688706427682_4476432013876242881_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjuvbdExZ0gQ7kNvwHMUQEq&_nc_oc=Adp0CtGE0M_ax4Z0eG_Cx3b8oMeYMNN3H3aHQ8aQGz6bZ86OwH8QntKRRvS3faNBk_I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjezX5eO5lLZMijgcktJNWn4KqQQIihs-WLRCKS3pm0A&oe=6A858010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WalkThePlankLondonUpdate - Landscape 2.png", "id": "1884881742419190", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618440_1884881745752523_7087372941322728798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Llqhweba7QUQ7kNvwENramy&_nc_oc=AdrVSdKcb63kzU1iZEk6hlJqIf88sBKkrdAMihJqCHIxYQA0eRB4QTs_QLi3T9au8jU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES80qA5K9oHpZPm-yJYcIkKLJYpHMinSIAWxWkhj92Dg&oe=6A858D1E"}, "display_name": "Walk the Plank", "keywords": ["Plank", "Walk", "experience", "elevator", "walktheplank"], "long_description": "# The Ultimate Welcome To VR Experience\n**Your next gen plank walking simulator**, set high up in ultra realistic New York City and now London's Big Ben. It's the perfect first experience to show off your new headset! \n{1145915837225515}\nBring friends and family together for great laughs as everyone\u2019s knees go weak on a thin plank atop the One Astor Plaza skyscraper and Big Ben!\n{1355526585684846}\n# Next Gen Realism\nWe set out to push the limits of what the most realistic plank simulator could be on next gen Quest hardware.\n{569899162336154}\n# Plank Variety\n6 plank variations including: Wood Plank, Glass Plank, Metal Grate, The Pole, Red Light Green Light and Roulette. More to come!\n{3774236396148078}\n# Three Environments Included and Counting!\nWelcome London to the party!\n{2231970060632455}\n# Health and Safety Warning\nAll users must refer to the in-game EULA and Safety Guidelines to limit the risk of injury or harm when walking the virtual plank.", "short_description": "Your next gen plank walking simulator, set high up in ultra realistic New York City and London. Bring family and friends together for this intense welcome to VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamedigits.co.uk/docs/PrivacyPolicyWalkThePlank.html", "developer_terms_of_service_url": null, "publisher_name": "GameDigits Ltd", "support_website_url": null, "website_url": "https://www.gamedigits.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"
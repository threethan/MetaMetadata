g_m6g-ABtSdlEBWRysqKdnkN6saIqrgS-DQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyOWZnDoa72MgZAWP3UnGKR6mN_3zKCwxDWW-DChCyIQ&oe=6B106CD7"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLvAm1G9UEcQ7kNvwHFO1RM&_nc_oc=Adq-ceMJe8uC93oGBCe5q_ydIVI4Ab_DoaH9xqfQhKE2N8whMfygOgpm4B8_7HAfLKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1lQ81motntsZZdD063Hrm-i0vhqZ5G7NEyATkLh9_Pw&oe=6B106289"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kRnoBDUW60Q7kNvwFCzgOO&_nc_oc=AdoaftJULZH_rP8EGaIT5vAm6Y8eP_HSlQlQP5LUU3wNotj6uhQ89kq1PStHO-ASZTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRGTN9d56KBQJ1BlJUW6eA_Aohqx_lqO7DnTlE0_HNmg&oe=6B105E70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243675947931432"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "966414040193557"}, {"status": "PUBLISHED", "id": "321527201760870"}]}, "baseline_offer": {"id": "966414040193557"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1525195500, "status": "PUBLISHED", "id": "966414040193557"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1772494802828613", "version": "1.06"}, "id": "780213922173588", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1656522077759220", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", 
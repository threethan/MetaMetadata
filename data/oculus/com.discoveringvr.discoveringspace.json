6e7a0a&_nc_ohc=luJ_FtI8IP0Q7kNvwGjYgDD&_nc_oc=AdkDt96R0f8o0sOMnh9pcGIjPXXohgt2lEOPQBd7p_iOQM3PDNquSvF9aE1s2gq78xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrdKR71B2TWwdh3oT_IVY0A0mYagytYoXAZ8dBop9n4w&oe=69A6E775"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxWjPhHY0skQ7kNvwEN7P_V&_nc_oc=AdmrZlOkQwOflkwrQAsJF9gva_b5QcXWelZ6MqU8Ig0NvEnYyBBlFv5GmjlvWpClGXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuX5lZqcuYHJXIXlGmBhqT-tE-fGwJe132bjRGfXxUuWg&oe=69A6C157"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukyhwjoCkdAQ7kNvwFUkG4F&_nc_oc=AdkXyIccedTtkGSO5Cpme0U42bYUaund430kRESBbAUBPtevg42QcHaUcYKaHR2Mul8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudojlLQ7emtWvj7Y7LJZYEJVfxNV9250rxZNFVtMS2mA&oe=69A6EF49"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1czq6JkjyYQ7kNvwEtcvx2&_nc_oc=AdlwjmBFnoF7J8YPgSzvTD9wY9RbGl_xdkOalBUFAYrqtQvV0_jLvkIQZ0W1EmxmK9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsI8RaPbU3H6UJLeJA_v6GO2lJFcQo2BqEpJSKMmjzmig&oe=69A6EB30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243675947931432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427574_557277051313711_2798724625649893376_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QjoM4_i5GIQ7kNvwFcrilO&_nc_oc=AdnM4b5oDYYNVT4cHTIrVRmZag2ULXGz_b3LqGQh3TmUTT9ezwYOvBwke5sttWWXgwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJbHqeeGxu05WTiITFzuZEoMBw4vBwTg3L-q
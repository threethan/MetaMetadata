6e7a0a&_nc_ohc=1rXlJlZ68YUQ7kNvwFGCpQ6&_nc_oc=Adl990xuuLTIHhk71KS_qd2ul7_Q2rKJAZT5E_tfz_ei2hw8hWmoPokU3AHqHPgiPxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPG4XyZ38ilOCv5ZLF3zqkYFSzWzRaxYJ3RPA6iphQTg&oe=6999B875"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-SL-aOeZUcQ7kNvwEGj7Os&_nc_oc=Adm2VNiV7Da8yu7QK4hMzb1kuuc2mkMmOe4_vGF4hWZkFeLMqINx_uvPNWaopwxfDMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXyXz-EP9QCOCkYyxulmXc-uBTf0CbLbvwuVBXq1y63g&oe=69999257"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrKoy9Qq394Q7kNvwH-9oik&_nc_oc=Adlh1F5YP7ifYm7mVToE3nLPOZum7-Ru67wocL5ySFyqQpY9BKCabwvzXkmIORdroME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSyCliHQW9ELcj3_j_A3BITLcleygWVgWUs0z7v5hiyw&oe=6999C049"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjKhRgcQcYgQ7kNvwHeuC7q&_nc_oc=AdnE-kPhNvIcJ1qORjl71XUQQKU9xIWXkPtseVQYNH0sOJN5QDo1kDu5L0XFojWO0JQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlQTnQV9Q3X5eEuqRlSZcM-Tz7clXNhQxTa1Q9fI6wVw&oe=6999BC30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243675947931432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427574_557277051313711_2798724625649893376_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3wAk2z6xM8Q7kNvwH0v-UN&_nc_oc=AdkE3y2ek5V_kGg72SjSjirOIuSX8tmSHgRZHz_F17XUOgAu_lnoezuyPdMOdJMRn2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCirUIfbVg6aatJyczMoff340W7BZ_Mh4mjE
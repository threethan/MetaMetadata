grated_image.png", "id": "576345286298093", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162791_194200944514699_6976310366665965568_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7FrN2wEiS8Q7kNvwHOeDTj&_nc_oc=AdpwxLKUfLfm-W0PeRgnM1LeuS7ylSobpd3a_z_sxarRdOUCFyWuNSlhlOqlsFjzcTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0b8VArXUnLlZwB0ETWLm_J1DyUADFrW1W4lZrlDWTpBQ&oe=69F09F9C"}, {"file_name": "migrated_image.png", "id": "840229886440289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386401_178839952894596_7973465854262116352_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mpc5Arq9HhEQ7kNvwGKCLGz&_nc_oc=AdrWdz1Dj44T4GgKRz76YhSFEBY_itnXrS7VpDGD3S6aLNwq3drasteZUMRKi6sD2DY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af07egXfiBCOJd-92ndr9KdQNuT8shme8X6fjanRQ-YSWQ&oe=69F0BB75"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El0mNddnMycQ7kNvwFFRM6I&_nc_oc=Adq_Ict44SEKaFoeybcENT8DrabF7BSxpFE1xqpMQlwRC24p3dQFU1AIidFlDgLFhHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0PgHCUt50OkIe-Qgp8DeHQhaQiGA3drk-R6toZjLtCdA&oe=69F0CD97"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFS4pF2uGLYQ7kNvwGGRKE9&_nc_oc=AdpxkL08Rz2vo3mPIcv3RdoKJvutfXpXHpx59y10yQ_3k55qXWShYW0jZs8LHxEBUGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3lEBX2-Ng7Yt1fEcmFAU2kzG4HW-cYgviSBWP1NOOMzg&oe=69F0C349"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f56-C2xIxJcQ7kNvwExzgHm&_nc_oc=Adp8bLJV23Ze5na-r9LhOBvWN-6ykP9qJ5T1OUIOIpC9CFwQaLsTNZ_2gULUpFYvMZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2vxscQ2BrHcKFm9wV3L2XrZ7Tc8nOR77Nf-do9Gg4-WA&oe=69F0BF30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
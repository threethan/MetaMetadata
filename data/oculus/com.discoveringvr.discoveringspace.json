6e7a0a&_nc_ohc=jA5joRkI984Q7kNvwGQjLTv&_nc_oc=Adk_09WLNkX56n2XRS7JHAV8R5BxgurKttvBty1WY9V3n9WKCHY4weizOu_THkSdWys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-Q9aesjVjKbksMpOITr-JPi5XtxNLrulOYZ21QBOE6Q&oe=69A04FF5"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdpuGR1Ys2IQ7kNvwHJEupz&_nc_oc=Adm9IJwoZgPZXzzzwxkORnSPfjzxaR2wIaEw9GUaAhf0KBp28VcgPIIRiF3mDOYy3CY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVJAbEuH7pbu9QYKuvm4KwRvaaWTiK3RKTqmGoQZdHCg&oe=69A029D7"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCDVQ324NIgQ7kNvwFttSPT&_nc_oc=AdkcUHaFEa36D-t6hXXGgnIHWMzYeNSsZ3ko3GJtreEQhtWwh8-w9v9BSJSqazhCjOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufQB8DtnFEoloWEbq0cyEix6-F6hNQn0LSm2a2uo3hOA&oe=69A057C9"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbGm18yaiUMQ7kNvwHfFQZ1&_nc_oc=AdmOe1QBl-gUTVPUwVzpmJpd9cktgOT9ZppDYQIGk-_NnQJODbK4JLeeglq0HAoyT7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGAzKHqjV7ssAi0zAGmEDLKpQRKZrXVgdCOn07JbVf1Q&oe=69A053B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243675947931432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427574_557277051313711_2798724625649893376_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-PXM9D2wIUQ7kNvwH7NXVD&_nc_oc=Adl4SrWGmJBkDYO7wD8xCYaH9QmaERQK1dN4yTwB0seVr1NxcgMSg7yblO0wc6aa-WI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvCaySIuVnweaxjT_uVNxaiDia2hVniITTmO
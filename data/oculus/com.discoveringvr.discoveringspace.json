luscdn.com/v/t64.5771-25/12386401_178839952894596_7973465854262116352_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad2RYjmHjmIQ7kNvwHHRO8X&_nc_oc=AdoOyW9kItfebY1FnuKyqJab_u6E4_FINzffk27OobuA2lUrVO4gcdpyXtVuFVwPKK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKX23FkNz0lrZYDZNsflutTjdbFAlvRUNG3cO4Nokd9g&oe=6ABFB6F5"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvN_WBOC2rMQ7kNvwHV3Hrm&_nc_oc=AdpBlrmLjIBf8jghAj_pHFpdxAPzGsk76lJ8surrHBTb2DsppTA4YOZ7NmASDmb8LwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGU0EoVGsNCVxNj19C7DG6ocJHaKGWUJJsyMvsLM0stw&oe=6ABFC917"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrQ-Gs-rxeUQ7kNvwH9sxu2&_nc_oc=AdouY2x_MdIlrkSCvK5qjpaYaVnn2b9i_Hm60FVxNaOMr9260YGJQUaO6Sf3gatJ7qo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZg7DrGK_ODc_5DUDLHdUHPidq8EkmEGenmuUsdTlYwA&oe=6ABFBEC9"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai_jk8rsgX4Q7kNvwFmZqvp&_nc_oc=AdoCm8179cQ0lR_ejQ4-FKx3I7BXd2NbgYFQ_HsvdJUrImgQx65_2iVLbkJijJJ0psc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXjlHucPC2mV1v0RzFPPnNOj6zUs-SEcy2Vu9GHBiETg&oe=6ABFBAB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243675947931432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427574_557277051313711_2798724625649893376_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogSZH6a6C0YQ7kNvwHAhhn5&_nc_oc=Ad
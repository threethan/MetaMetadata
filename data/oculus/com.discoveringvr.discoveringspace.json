1_178839952894596_7973465854262116352_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jcfRfTsWd4Q7kNvwGyiZfa&_nc_oc=Adma_cTk0xfYPKOceZ0j9cqRf2aXAyvKFQJJFJmJqaEXvw9l3cc6v79FdTJ62e_gqFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0sjwHcuIsbRa1dPl2nNSmkFJMk420msbc2tqcgPQ26g&oe=69AC2D75"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Sff9ymjqGwQ7kNvwHH3kBl&_nc_oc=AdmFHeExjO864cVgXJlAisrkLN6FCbGT9k7ppbSvjFc0LGfRSdImFDQRonjSqEDSOzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyDdUOlhD0A-PwQ1Tgfb1XsESy1pfjD7wP-3RDroUeteQ&oe=69AC0757"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI8HVj48PvMQ7kNvwFfbUKA&_nc_oc=AdmuFhsCtpnOMpbillKZbOvztAIcLnO0CvDdpIRptz5-3LBIByIiW-hQHfWVvXBd0zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUi0XDIb2wgfJ3FpnlxYA3ft21NdLFdWGRVDK8tUVh7Q&oe=69AC3549"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DJoCdoVJZQQ7kNvwHTX_Vj&_nc_oc=AdktC1c--Hr9-g-1kQfxN5s-eSeUVul6Dysu1tR5hu6Yuph7_lIhuDUqVFjQBCa0ByQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwyvuF-aueVwMwzZd6BNs-G0lSHx5pHjMdoy9Tq4cQC2g&oe=69AC3130"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243675947931432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427574_557277051313711_2798724625649893376_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqezDJgWKDgQ7kNvwHR5a5g&_nc_oc=AdlNTWtmhtrhaw8cFk458OV3eY7DG8cu-wK5M0O_dwmi7q-d_f
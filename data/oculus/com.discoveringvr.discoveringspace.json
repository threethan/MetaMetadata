=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ-XebpWGmJnqtiugz7luLteq8sh1m7zUplqLBQowKMw&oe=6AFB26DC"}, {"file_name": "migrated_image.png", "id": "840229886440289", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386401_178839952894596_7973465854262116352_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edt4_vS_a-UQ7kNvwFZ32cW&_nc_oc=Adrt3qJAsyiMqXZq-9e1Ri8fyZmF6_FZIqP4tcwTHsXi2KJOD_vqFR-FQtA51YBUUxY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmmnyDf-jqZeJxSfIMjd0l9LrR13tW08igaEu1Rdxq2w&oe=6AFB42B5"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX2sHQIPL90Q7kNvwEP0EZ9&_nc_oc=AdofxUxJh5tgm6DcpwM9gkDtE1UmSAxIfHapCDZkJx4tOd07icq1BUz-g7q9znBU6zg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe64Hqv8WffpY4jPdAt-N5lX77W856gVAV2tVQj9hIHA&oe=6AFB1C97"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZasyyZXD1AQ7kNvwF8c83I&_nc_oc=AdqGW1kQW5ukaM9KA8AFpvtfaoMWelFFM3f92v6ffPFexm8lKO0bhKarad3BVFyZV8U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXf1s4v7KBOvFx-14d1GQm9t5h7P2OfP55eViXPAaHaw&oe=6AFB4A89"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtGIhLz35RcQ7kNvwGMonj5&_nc_oc=AdqcttXbA0vhH-YjO60_rmy13cl1EW8_bha0fdM5jOiBKWBg2cg94h87fTKHziRu-WM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTB8rAxYUoL4tjmYNXOz1so4lDGRsoPYSZdUkBsj-TzQ&oe=6AFB4670"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interact
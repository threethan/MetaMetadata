6e7a0a&_nc_ohc=1rXlJlZ68YUQ7kNvwHyJVwx&_nc_oc=AdmM2dXRvBK3amDnLazL4JI0e5xaIcKQiXkVxe3Qpvgbkw2ISPzBESpU2Miph0oW5EE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvLvtSuVK45WeZaPu3d5LlKzhSy2fRyrmGhfg8-6vybzQ&oe=699866F5"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-SL-aOeZUcQ7kNvwG_XAE7&_nc_oc=Admt3X3gnJ6BrQOUmGxH5XpDnVfA2mY9InSb8K7FsTldwh0qqZZOQ_Fu69cc03UyhkA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv8wmI9vcJfb0eIzaieTn5rz7_X9BkETsjUF4q5-wL6IQ&oe=699840D7"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrKoy9Qq394Q7kNvwFsXx8d&_nc_oc=Adl5MNXIlIIH057C0JBx1F4TAZTf4CSerdOBVO4PVS38t4uiemKtIGl9VmmIP5524Wc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsGCRGp-6nI2c8ZSKPDHYCySPNZz77HkMM8Kcxk-wDlkg&oe=69986EC9"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhgoS___B5YQ7kNvwEiVRnk&_nc_oc=Adk-5_qPeWLE8GSAf7S-UDBPABnC3f0C21x5S0v02nxDDPFOt7VseU2X6uM950DN7tU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft3nra15s5MPEYEhZzgwNsbyjjZ9D42jAd3_vtSsX9cSA&oe=69986AB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243675947931432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_557277051313711_2798724625649893376_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3wAk2z6xM8Q7kNvwGh-SYm&_nc_oc=AdmRsRduvw36c0RJ8U95_0lsIs03RvczKtfOPfINJlxITuFvvcYmCgjYDeBED_MOWvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuEhE1rk84Ei7Q0-m98pTKSz_vhUvIUQjyiTB
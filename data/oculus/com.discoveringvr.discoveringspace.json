6e7a0a&_nc_ohc=2P2VXUPg9X0Q7kNvwEm9IG2&_nc_oc=AdnacfVaExJ7tk3PAbuDrcEwftKsqCUxLhgnbo6Fo6ko86gEWHL9TlLzqwcEBUTj7UU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvce3e-lMEY9vH-VH7dkTG1c8Mjit_eUxOuXS98oWmu9g&oe=699C5B75"}, {"file_name": "migrated_image.png", "id": "240985190371600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/10000000_191517794790710_819105329122902016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0BLBUsu4HIQ7kNvwHe3-za&_nc_oc=Adn5aBtWoW3hO3rY-zihpfGb8G7fOjmKYKNtcFkvCSGq7zr-9hWic-IRF2pBa21cXv0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvpvCxNtwhnV5YFpT0Cu0S5WwwBdFlTDQ58GzPT3ooPDQ&oe=699C3557"}, {"file_name": "migrated_image.png", "id": "202715584292613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139031_863197173880556_8309859727383199744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iud6DnxdCVoQ7kNvwGX1iwF&_nc_oc=AdkPiZw3I8D_dixsXCfu5yhn0_ZAvMYwH_IHcVNjYJKvZShNPpxNX4J8OPdICD26LG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftDqkyDdpOVfy0s-9PjWViXV8HnbJw4G6OYg0cnE0YQcg&oe=699C6349"}, {"file_name": "migrated_image.png", "id": "2643834889078100", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448944_162446487752374_4171312266970398720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjKhRgcQcYgQ7kNvwFcs-_H&_nc_oc=AdlxzwIrZ8DbqIp8h8NjYsdrVZJoeDgsj-agH3358T3lxdfA_Cjs3wsIq8DFCog3sCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsU7jGXdIqFwiz1DFkcQ0ClqKcvg02Z1Q2pp5lkmWMIUA&oe=699C5F30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovering Space", "keywords": ["space", "exploration", "simulation", "solar", "explore"], "long_description": "* Learn the about some of our close neighbours, through an intensely engaging experience.\n\n* Contemplate the awesomeness and remoteness of space.\n\n\u2026 or just simply enjoy the ride.\n\n\nHighlights:\n\nTake a high orbit around the earth, visit the far side of the Moon. Fly in close to Moon\u2019s surface and understand the formation of lunar features.\n\nSee our fragile home, Earth, from a completely new perspective.\n\nVisit Mars and its companion moons. Fly in low and close over some of Mars\u2019 ancient geological features.\n\nGo deeper into the Solar system; graze upon Jupiter\u2019s swirling clouds and swing around some of its fascinating moons.\n\n\nFeatures:\n\n* High quality 3d real-time rendered visuals for truly immersive feel.\n* True to scale planets and moons.\n* Engaging soundtrack and audio.\n* Three tours, between 5 and 10 minutes each.", "short_description": "A breath-taking space discovery experience through a series of guided and narrated tours."}]}, "developer_name": null, "developer_privacy_policy_url": "http://discoveringvr.com/privacy-policy/", "developer_terms_of_service_url": "http://discoveringvr.com/eula/", "publisher_name": "DiscoveringVR", "support_website_url": null, "website_url": "http://discoveringvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243675947931432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427574_557277051313711_2798724625649893376_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pCCdYjVDkAQ7kNvwEG9scf&_nc_oc=AdnwypvPrAEkRGh-6BrZ1gKESqORGmvHEGoOkzwiCL_xUB6aXAgEoSqcnCYID0sag3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuWmkstHa9rnNgN3xU-CMqe4jY2pSJn3Jclvs
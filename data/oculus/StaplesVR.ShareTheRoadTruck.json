e=6A32B164"}, {"file_name": "Truck_Screenshot_2560x1440_5.png", "id": "462260793634551", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982704_462260796967884_3444075812838614238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs3KW_1S81QQ7kNvwHthFT7&_nc_oc=AdqQlqPuZXfCRyaMhkuAoTf_SrbUnBivQfCDF5IOEJrMVrgA2ryD_TOiPcZgUYWB79w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W-sdaii55SMffM5M1jQ_6pjFlxhSv0A52qxwWj5GOvQ&oe=6A32AD2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Share the Road Truck", "keywords": ["Cycling", "Road", "Safety", "CyclingActionNetwork"], "long_description": "Staples VR has partnered with Cycle Action Network to develop a safe driving virtual reality simulator for truck drivers. The simulation shows drivers what it feels like to be incorrectly followed and passed by a large truck when on a bicycle. The experience is designed to change driver behavior. Spend the next 10 minutes exploring three ideas and behaviors that allow these people to share the road and get home safely. These will be ideas and behaviors that you have control over and can do the next time you are in a vehicle and see a person riding.", "short_description": "With the Share the Road Virtual Reality experience explore ideas and behaviors that allow truck drivers to share the road and get home safely through our VR cycle safety simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.staplesvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "StaplesVR", "support_website_url": null, "website_url": "https://www.staplesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
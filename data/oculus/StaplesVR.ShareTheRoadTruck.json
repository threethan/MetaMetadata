0_3.png", "id": "1078283697291611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974719_1078283700624944_2057254766549305170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_48dLOtf3kQ7kNvwGhGedw&_nc_oc=Adr8NkOp8JOlTUz-xXkatwt6o3wNFCAXdgIzayh4P2CPh1jCKJQScwVocNlxndhfw9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ0ztZBsFe61i31XWZUR916QC4MgAqO3O_hhvnmGJdcQ&oe=6A57A00A"}, {"file_name": "Truck_Screenshot_2560x1440_4.png", "id": "1362162244744288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982671_1362162251410954_983024259806635267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ-cDeDkRXsQ7kNvwG_4foY&_nc_oc=AdqJmuKDBRhb3D3vG1Mx8IqULMfjrZQ01NJe7zdQTkgFOP2b7GPZde6Uur9q2D3FpMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC95-CtIFGp9TIXUXKBHgdYqy_iOKeQ_an5eG0kT27-9A&oe=6A579B64"}, {"file_name": "Truck_Screenshot_2560x1440_5.png", "id": "462260793634551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982704_462260796967884_3444075812838614238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fUGXQ75H2cQ7kNvwHqYTNm&_nc_oc=AdrhXWpqJ4Wr0d78ubVB85FzigQ--mhBVnXynbLcGzF9It61EhPYu-8SncoZoqZDPVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRctzBQpO7zAb0rSV54uHRWOs32fdwxMccv6Fnzj97kw&oe=6A57972E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Share the Road Truck", "keywords": ["Cycling", "Road", "Safety", "CyclingActionNetwork"], "long_description": "Staples VR has partnered with Cycle Action Network to develop a safe driving virtual reality simulator for truck drivers. The simulation shows drivers what it feels like to be incorrectly followed and passed by a large truck when on a bicycle. The experience is designed to change driver behavior. Spend the next 10 minutes exploring three ideas and behaviors that allow these people to share the road and get home safely. These will be ideas and behaviors that you have control over and can do the next time you are in a vehicle and see a person riding.", "short_description": "With the Share the Road Virtual Reality experience explore ideas and behaviors that allow truck drivers to share the road and get home safely through our VR cycle safety simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.staplesvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "StaplesVR", "support_website_url": null, "website_url": "https://www.staplesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8692681877465124"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "446651928004852"}]}, "baseline_offer": {"id": "446651928004852"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730139420, "status": "PUBLISHED", "id": "446651928004852"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8692836700782975", "version": "1.2"}, "id": "2057206331382208", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8633425866724059", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8692836700782975"},
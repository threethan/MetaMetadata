obw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvCNQZJAJyT8vmfeDfy55bGcNzSJFpoINeRwEgvwUV1lg&oe=69A2CA4A"}, {"file_name": "Truck_Screenshot_2560x1440_4.png", "id": "1362162244744288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982671_1362162251410954_983024259806635267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMfZ3gu2uUcQ7kNvwEZVRqn&_nc_oc=Admi1hCK5uzGylYQYPCIxA3dhGaXX-ofVsYFrzzsBufyaryBtMdysb9-5inDvh7q-ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuL63fN-5OjtgyvBddS-sKBe-PlkKIvkKjD9Gf2L1GVLg&oe=69A2FDE4"}, {"file_name": "Truck_Screenshot_2560x1440_5.png", "id": "462260793634551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982704_462260796967884_3444075812838614238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yB9E9qfANAUQ7kNvwFKa1s5&_nc_oc=AdnaOG3es6Cg17us0ta5YLwOmG9HlbGICik5Yw5inFnLBXjS0gZSNkkxjOsTPzsRlgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4sqHltAwdTqf6dNC_96bwDroYmqw2OzGeKtRstWTa5w&oe=69A2F9AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Share the Road Truck", "keywords": ["Cycling", "Road", "Safety", "CyclingActionNetwork"], "long_description": "Staples VR has partnered with Cycle Action Network to develop a safe driving virtual reality simulator for truck drivers. The simulation shows drivers what it feels like to be incorrectly followed and passed by a large truck when on a bicycle. The experience is designed to change driver behavior. Spend the next 10 minutes exploring three ideas and behaviors that allow these people to share the road and get home safely. These will be ideas and behaviors that you have control over and can do the next time you are in a vehicle and see a person riding.", "short_description": "With the Share the Road Virtual Reality experience explore ideas and behaviors that allow truck drivers to share the road and get home safely through our VR cycle safety simulator."}]}, "developer_name": null, "developer_privacy_poli
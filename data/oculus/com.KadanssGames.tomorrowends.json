=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ed39sd39b2GFxOqMct2UEhgRr0ssdRt_CzQC-FUsZfQ&oe=6A29821E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "3177011589242000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_3177011592575333_3675512385478922577_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJOK3iwOLMsQ7kNvwF1xlMQ&_nc_oc=AdpnKcXGh54QZ2XUBCoCSGq7g0UTfVlnAHVV_ax_KgoVsItjvCBk0qixyWxxcxGSM7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VKrceQszWZUzwZDYWTREJCZkpuy6yqhlBAyZ-5vO2Ng&oe=6A297C6F"}, "display_name": "Tomorrow Ends", "keywords": [], "long_description": "It's doomsday and only three hours are left to save Arkala town. The clock is ticking, the townsfolk are in distress, the townsfolk are lying. The townsfolk are lying ?\n\nTomorrow ends take you in an old town far away from regular men where different rules apply. In tomorrow ends your main goal is to figure out what happened to that special book that kept the village safe for so many years. You have to stay alert and understand what the townsfolk are saying. You have to figure out who could have possibly done such a horrible act and doom the village. Emerge in this town, become its member and save the town. ", "short_description": "The clock is ticking and only three hours remain until the sun devours Arkala town. It is up to you to put on a cape and save these people. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.1neglakay.com/tomorrowends", "developer_terms_of_service_url": null, "publisher_name": "Kadanss Games", "support_website_url": null, "website_url": "https://www.1neglakay.com/tomorrowends", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_i
ng", "id": "410882427480931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_410882430814264_8382700415548266516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VxnYT8Nt8oQ7kNvwHvm8Fd&_nc_oc=AdnPADrESnNPvYrwsK9CvgjFTWK1ZVtC0ASVEhnVdwEoFjyfeYbhWBq2f4hL4BnsyEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfshjnG1OTg-vFhjNXdlkSOUUgBjKi5JNual1xFuZH9jFA&oe=69A438CE"}, {"file_name": "Screen5.png", "id": "466674915066953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569446_466674918400286_741106180517216986_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1CXEGhebZ4Q7kNvwGI4nps&_nc_oc=AdmwAnBKJErVm0vS2u4URqzAxbjJUKiieAo2ZySSgxRCJBOJ-s7-AhKliQx-JuiMTWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfveF4uIE2HQm33KS_eVwxMsQ0BBHG_Vd-F91TlOUO4Fvw&oe=69A4225E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "3177011589242000", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982439_3177011592575333_3675512385478922577_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9O0HIYZPNIQ7kNvwGGvIRI&_nc_oc=AdmC0pmqUcKRe5MOAH4a2jHecfBLmmG3-heAJ3YpIe40Trs1vMAOM_nomANblE39NqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuV22nAC6VdjkFOiK94m50lL8QZF05YWU2CbG9c1uSm3g&oe=69A41CAF"}, "display_name": "Tomorrow Ends", "keywords": [], "long_description": "It's doomsday and only three hours are left to save Arkala town. The clock is ticking, the townsfolk are in distress, the townsfolk are lying. The townsfolk are lying ?\n\nTomorrow ends take you in an old town far away from regular men where different rules apply. In tomorrow ends your main goal is to figure out what happened to that special book that kept the village safe for so many years. You have to stay alert and understand what the townsfolk are saying. You have to figure out who could have possibly done such a horrible act and doom the village. Emerge in this town, become its member and save the town. ", "short_description": "The clock is ticking and only three hours remain until the sun devours Arkala town. It is up to you to put on a cape and save these people. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.1neglakay.com/tomorrowends", "developer_terms_of_service_url": null, "publisher_name": "Kadanss Games", "support_website_url": null, "website_url": "https://www.1neglakay.com/tomorrowends", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "500276661658227"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974883_638856910759031_6930865527422337670_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObUi4HHv0pEQ7kNvwE0t89S&_nc_oc=AdmBte0q5707UfH3fTwYZ_FxldcJ1lwwHip4T2QXtTX6461XYHZlqZ2hsJ69tuvb458&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsrLELkPul8hvcP_LNslCIt2JhzLFAe2Wv_t94_v5PmNw&oe=69A44626"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tomorrow Ends", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1647662400, "lastRevision": {"nodes": [{"id": "295906192559420", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defa
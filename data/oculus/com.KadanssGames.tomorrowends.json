kNvwGuVu43&_nc_oc=Adpu807s2nA3awMEHfwL6lWASs9gdertwPZRUQI-4q9bsfU9MiMiqg_BK6YpM5cs4eE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8sTd7Q1hxYO14QqISUHyXqE9jme2u14rXSGqCcFVC5Q&oe=6AFC888E"}, {"file_name": "Screen5.png", "id": "466674915066953", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569446_466674918400286_741106180517216986_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLfDwcQnjTwQ7kNvwFK7CtD&_nc_oc=AdoaDwNHgjODoJGjDB3FAgFfkdKzH0J4OO8U1r7xwZYAbW1OaRzBBJrfon15a4FYh7s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5DJXv7HD-pJT6BHARnYNa7OzyT4Bst8yPyBi3d5YMhQ&oe=6AFC721E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "3177011589242000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982439_3177011592575333_3675512385478922577_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x87ZgH07JbUQ7kNvwErYco8&_nc_oc=AdokcGoKFW_AQZ75quzkwQIYZqvWOuZVfyP2oomiRCXhKdJsCntw7nqs3HJSwPmNfT8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaxtEB7WjtS88QJkCU0FnuM_4NWpo_vl-Leb1mun3b3A&oe=6AFC6C6F"}, "display_name": "Tomorrow Ends", "keywords": [], "long_description": "It's doomsday and only three hours are left to save Arkala town. The clock is ticking, the townsfolk are in distress, the townsfolk are lying. The townsfolk are lying ?\n\nTomorrow ends take you in an old town far away from regular men where different rules apply. In tomorrow ends your main goal is to figure out what happened to that special book that kept the village safe for so many years. You have to stay alert and understand what the townsfolk are saying. You have to figure out who could have possibly done such a horrible act and doom the village. Emerge in this town, become its member and save the town. ", "short_description": "The clock is ticking and only three hours remain until the sun devours Arkala town. It is up to you to put on a cape and save these people. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.1neglakay.com/tomorrowends", "developer_terms_of_service_url": null, "publisher_name": "Kadanss Games", "support_website_url": null, "website_url": "https://www.1neglakay.com/tomorrowends", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "500276661658227"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3884221288369622", "version": "1.0"}, "id": "1087711451773182", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3652564348201985", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3884221288369622"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1087711451773182"}]}, "change_log": null, "created_date": 1648179108, "id": "3884221288369622", "version": "1.0", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asse
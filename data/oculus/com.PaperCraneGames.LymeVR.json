107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IhsKYO-JJsQ7kNvwF9M2b4&_nc_oc=AdoJqYJCRGRyphe5BYnMaHicsk3-qjSK1YmWgG5lImg60Ap2_gPjam3Wj_BtQqJ-uUo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TZKUYDdoVQA9wsusQe3kwxldsah-s-PgCjO7Rdvq0MA&oe=6A36BE4D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTktTpwbwjUQ7kNvwGp7lvW&_nc_oc=AdosszmFwTOqH4d2-6PFIBeWqBYe9UsI2PlyCe-f7grVvZ_opYU4nrs1qpgDLjv60vs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V7CLJCSDpdRhAyDxm-62bvIDymEOhi_dHBrCZoKVDjQ&oe=6A3696CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPYtEpGP7lgQ7kNvwE6WtBO&_nc_oc=AdoUvck1R8eQX1rcERkRFjpxOJ_pMrVq7C7CHcT_JenC2saM_JdubMrJrrbUbK0cXGQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GzYLy3D_Tsg_PuNajhcFiEsL7xmiGoSQ2XqKhpOaD-w&oe=6A36A45D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZDLcvEhTRoQ7kNvwFzfiYh&_nc_oc=AdrsBiNF5JTnEwiKdlCz2plXncyLaLc1qlyZICoEIiBphkXp9iJDuaJuCEpxau3SEhY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LxEKPXEWU52l_7NFPi2rjgZVO86LD4heuUBq0ZMgqmw&oe=6A36B403"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvRbD_f152wQ7kNvwEymgHk&_nc_oc=AdqyEaJFPuDJWeLA0h4muPg2_ylt-XuR6MOVEVcKfpuMw7jUSIkFNWEZh40NtPurt
kt5PLFggQ7kNvwH31736&_nc_oc=AdmVf408dGV_6eKQx16xkEtKEbvKTPYSHkRcEor4e6E5T8WkOc7cR_fVOOvyyD0IOvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3vBP55mZ_PKHoAuvVUQU2CvVK6i4vATUzfUNeTiJFZw&oe=69AD6A0D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm0JxVn36wgQ7kNvwGVSfJy&_nc_oc=AdnIQmptDi97GYBGwmrkSJRo6fVxV_5zsA3Csy8SQKlqlltXu_bb3jdbHypDhEA9LAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQiat9eswE0LsCjtga7o9g9Fc9R7OLR30JnUCeYXhhvQ&oe=69AD7ACA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrNL6osjeJYQ7kNvwH0GfXF&_nc_oc=AdlhJShQ-v6Pae3OUAiAahL8kt57HKSayqEmx-GeGiOoa8et9-UofEwY_nPrS_lOhdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkRZXPsKDFTJR6SFpTfSVn-CCzDO9B99bb_dlDE9GvoQ&oe=69AD885D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGqJ9uQd2RMQ7kNvwEkprVY&_nc_oc=AdnxAINYiAMD34PoHCpc-qp08W5StFDFjDROGYCEGMVYG6sbvPjkCC82C-AoZj0sKx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJZ7rY0Lk4wrm5g0JPsY8nOt2eCzxbQTJq7rHEZqP0lA&oe=69AD5FC3"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIaFacXuNuYQ7kNvwHSFnz6&_nc_oc=AdmFWz_ZwufhWuqTwhps5oXcwfqzORf0qTiJIBAaj1x71ij9FlYjcRrvc8yYOdloMjM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_s
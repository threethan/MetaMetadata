pzB6u5WA36hbA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuS9TIUakcloYzXxYmO-ELQ7j67U5vXEwjJReTFLxZUw&oe=6AA9494A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3BX3hgSFFsQ7kNvwG1-_qv&_nc_oc=AdqiCOf8rOJLaOMuM3eK9e1dO5iJwIFRtYf6WP8kmoefFfsqT0KWp5rFEB_ltFXHV40&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmpZm5GLwUV5Ln26DR3t2627X69vB4Gu8XjP8OTzFaRQ&oe=6AA956DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-crrNLsyO4Q7kNvwGWRSP3&_nc_oc=AdoTgvSlslyDvyYY8dXWTp9okKNvSsrvG-p7OnmBsYAgjSMWiQw6ayDRpLATtkZ52eQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIya__lH4td_c9xIS_5lW1qw7Q110pVhzHhpixo71IAXg&oe=6AA96683"}, "display_name": "Please, Believe Me - Tribeca Preview", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\nThis experience is part of Tribeca Festival and is intended as a preview version.", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\nThis experience is part of Tribeca Festival and is intended as a preview version."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "400870745300733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5419006381484787", "version": "3"}, "id": "452879776600253", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5396683103717115", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5419006381484787"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"cha
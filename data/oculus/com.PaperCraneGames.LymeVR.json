Ft6H_OpwONyk0OZAmVA-Q&oe=69BD4CCA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poxx2-M6IrUQ7kNvwH09UNy&_nc_oc=AdkdaLZyWoVqwaWKnyF47LCoJBzLdvNvoG58wZVrH41M8XH0I_HqiBUWXBCuLtAEe2o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLFi2T2OKUgQXBVtUrMKAchOazLFd2F9q6A1IBpHRGaA&oe=69BD5A5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1il3otpzgMQ7kNvwGA5gyR&_nc_oc=AdkFBVXAE97KTaFqBl7nwMv8FUUjNgZm_YrrRmiO6jnqKoJwIxCPei0p0XY0TUfQT1c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8QevOmLB_J2JFhP7OGnXQAvMuuFuzwgzF9PhZDuDT3A&oe=69BD31C3"}, "display_name": "Please, Believe Me - Tribeca Preview", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\nThis experience is part of Tribeca Festival and is intended as a preview version.", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\nT
5SRop4EwQ7kNvwEUA6rf&_nc_oc=AdoSaqIQZUNy7ki7OquAuVLQecYDWAeRmyUXMSoVETccv4Cmw36U9GXJNwUWutfUDT8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6SFt3XrdM95hH9Oev5ut1VIAkHgs8JK4t6c5lzoTz7A&oe=69C1308D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmoE83a9Kf8Q7kNvwG6nUBn&_nc_oc=AdpqtCLg9T0m5oT1LS3qCtYiQ9hD4D_VG0SbD7H6deY5PoDVaoN2mgEQLhUz_UPQccw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxI1afVrKHSMTl9iBefYS81cQhBIiLqLMTNbVU4W87h0A&oe=69C1414A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55ltLdI3C4wQ7kNvwHkSs2S&_nc_oc=AdpsHFlhRipvx8c9nWk4CHa-4mTXHPBpeCuDbtIDDaZWG764Ccaj7qun9aEQH8uICRk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzwtrYkAVw2iuI00KwJ5I6KhEYVlmpSeoQJSjGSGcj5yg&oe=69C14EDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDDCTZlxo8YQ7kNvwFp9YNG&_nc_oc=AdrNw766aHyPCKjII11A-4Dq0uwDhET280TxMXIJKrOi235Yy2Qeuar2D4AoQvqUR5Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGrgOOCL4cMPXDV2FkdZzNaNSM1_05SFftHxkg0hr-Lg&oe=69C12643"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfd3uqq0cWAQ7kNvwGZ5RSn&_nc_oc=AdpEAVXUWwT6Sup-vlyqzsNepK2V6aP_DPQjT2ZfStNqDbmRQL4kgRmIw8st-SyT7cw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_s
T1kSTxUv1axtPz2Riwkhg&oe=69A9864A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GHISnj6ttQQ7kNvwFu1CyH&_nc_oc=Adm6QF9DniYUZLX_7Ex5crqgfYHEjFGoA7oCoIxUIZ8dqfpvqatI0rpWiamgq-Se7Dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvP6yWKaJIePmxROMkos5VUNCMq6x_qZdMVcBBOq3wNJg&oe=69A993DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHgR0Cq5eUYQ7kNvwGj-0pz&_nc_oc=Admzr0OMkWe4tLn7G1VmO0sS4i7WGW-xkpYgANQ7TjJN2lvfTQDIw8qqyzAhReZ0OGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7qk4yxj-kfzBFODbCjhoW9MTDF_jb5Dq1I3xMxGKwhg&oe=69A96B43"}, "display_name": "Please, Believe Me - Tribeca Preview", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\nThis experience is part of Tribeca Festival and is intended as a preview version.", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\nT
NLStJKHfjzo4yHhvvclYQM_kYeQwLxvUJ_5obeEQVeFHy_YkGu3Zw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2j6UNuSs_L9c6y7asz2aZNSQy3Sl08B5_ogLuCnZR08g&oe=69F1F80D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQgZ_I4EVLQQ7kNvwHZuEpx&_nc_oc=Adq_x97hghyhqMwIdubFkcXbNdIB6_E_p7p8QKKdGPIwaQCYQD0mtsF4gG5v4nFC4aE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af092HZwuFfJmMr99z68x6_nE_PhvkQR-23XR7lBzzuHJg&oe=69F208CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZwpwpObuUwQ7kNvwGnjHvD&_nc_oc=Adr3BRC6EsZUheypRpPyzXn9CUkOS7ROg63xxs1x4H5h3nprIYsY9RkExO5G25icAjw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0vHTJ_cP_f93L0bdtJ5kYWTYuK0AhQg-OP433_DtITtw&oe=69F2165D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUTm7d3BYGEQ7kNvwGPYlo7&_nc_oc=AdrCeHpVjo1-Xo3Q6c4DeOQBWRz1JCxXT0HB5GA5hEwdZEFnIgM-Trzue1VKpmW2m_g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27WOMjBrP1ypz7pfMwNelcTJv4bwE7M4OxGdllOAZWLw&oe=69F1EDC3"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb6boGNp8ZsQ7kNvwHi9y1t&_nc_oc=AdrforvC6ZCghfLRF7qYcSr7Xlf-vlII4CbVQjhlQBRCQfmDH_3B5VjQQZbHvFNxRn8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yXjUOstODfo9ph90v1vH0H0sCEWDIAOKFe238M8pIEg&oe=6
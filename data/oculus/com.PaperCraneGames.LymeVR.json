1-7&_nc_sid=6e7a0a&_nc_ohc=i-QZPiHVAu0Q7kNvwFxjPey&_nc_oc=AdkUAubalFIzmffGRFwLLMu8pD_T7owLOQdGFXIWRRwHIES2DW4d8Llm28F2oayy8lE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftdtznWlerQeV2tYJtix4znvzYKTxBlf5wgHvD0NDmuww&oe=69A59F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuAHswZrnfUQ7kNvwH3d3kS&_nc_oc=Adm-CsdGO2935IphBmkHAbG3oF2qX0nbCuk4Q1-r0c6EsgQqUGZAq2ZmW7Aujdhc3ik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftb5uQ3WnLrbwyPq6xzisxZlQj9PMn7j6VpK8xjrsIVKg&oe=69A576C3"}, "display_name": "Please, Believe Me - Tribeca Preview", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\nThis experience is part of Tribeca Festival and is intended as a preview version.", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\nThis experience is part of Tribeca Festival and is intended as a preview version."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_o
gh2Bq6OYQ7kNvwGhTtg1&_nc_oc=AdmJ4JQPDXvJ72A5NcDQ_AemisCT2WsX5uwE_HE6bpdiw0IWhaBZd-v-Jfp6vUs0Yso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfygW65-gqBsRcmHfes1dZ2-NtNQndwBTsk0IuAV6XcZ6g&oe=69BE8D8D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmoE83a9Kf8Q7kNvwF8t59B&_nc_oc=Adm3nwaGkPQlDQY1yMDvBGv1J0xzbuakJGXLqkpxPCmeYAwQZAx-j301_y7pYGX6Ci4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU8T1jScBx28C8u-rNT--Sq-vm_CWFHxN732LKApOZdw&oe=69BE9E4A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poxx2-M6IrUQ7kNvwFzIFM7&_nc_oc=AdmlSGK3vzhVy3Id-MrpG3zCgoYt-8U2MMSYub42dSsIZhhGLWB_k-SyzaALe48kV2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvQ44kP9jny30m8smfKJLhSSY10VcFKu-xWi4nTwY-jw&oe=69BEABDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1il3otpzgMQ7kNvwF5WqZ0&_nc_oc=AdlVhsxWma1yJZ5Sh8dEK7ZIEXHLCJgVbZaCQ7OlmxXcIelVmlvWu-2Vcl96XeAI4a4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNoW7pnDOoiwgkhSVCDBFT8QLm1zc_6q4v0xjJ6iu71g&oe=69BE8343"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfd3uqq0cWAQ7kNvwF2xga8&_nc_oc=AdluRyMmWBYLvEqwLd9yh0KfFj3khjXd81oSrF-Pm160-tdV8-AdW3M2bJz961IwzKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_s
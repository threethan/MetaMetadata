m9-6aNcsQ7kNvwFtxRvo&_nc_oc=AdlEuXm5dtUjvsNRwKalmbXeBZaLXPq_bCPckXMqZ0XB2_bA5GP221Gl99H0oJ4FsFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftSPhdN_4XPcKuB4A0Bp-KJtTTEx0yV-nIj-xw7bG3fxQ&oe=69A9758D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivkSfKIA8psQ7kNvwG4dLu2&_nc_oc=Adn4W1XHbzy_pQHFw6rqvWDV-H1Xe7p9zSdtqUysJxC9NMZ0iCGUKud79v_HxCPBRYw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs1mK3SwS8WaMR5f9EjevvhHT1kSTxUv1axtPz2Riwkhg&oe=69A9864A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GHISnj6ttQQ7kNvwFu1CyH&_nc_oc=Adm6QF9DniYUZLX_7Ex5crqgfYHEjFGoA7oCoIxUIZ8dqfpvqatI0rpWiamgq-Se7Dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvP6yWKaJIePmxROMkos5VUNCMq6x_qZdMVcBBOq3wNJg&oe=69A993DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHgR0Cq5eUYQ7kNvwGj-0pz&_nc_oc=Admzr0OMkWe4tLn7G1VmO0sS4i7WGW-xkpYgANQ7TjJN2lvfTQDIw8qqyzAhReZ0OGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7qk4yxj-kfzBFODbCjhoW9MTDF_jb5Dq1I3xMxGKwhg&oe=69A96B43"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSqnq85_K3IQ7kNvwF7p9Hl&_nc_oc=AdkUyZ4xzzBHKadeTogGRzcaAnYGSEUHu3PjMz3bBFMzwqkSXDYBgS0v4v1KSSw2vy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_s
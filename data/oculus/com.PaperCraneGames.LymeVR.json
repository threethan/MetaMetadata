107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aqWzF7G-mgQ7kNvwEAlXu4&_nc_oc=Adpi8s-H2RyL1lqh9PDZpGQW9XPuSrBx8iA-YxcjefCZ5jGPEXCVKwJZ4mNlX1krsII&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG99FtHdUyEU9ZL83UfhEX61KR_Ig-6pc3obrzG206rjQ&oe=6A7DB70D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IjP6hKSObgQ7kNvwFJu6D3&_nc_oc=Adqqdo-6fDDIncXmZO2GnC4v-gI4i9IJ0IOfiw4-x3q61trPZUo8SdHRBD3l66l_Rvo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmpvFPnkQrTIcgslHzNi__CbakUn8N9MSogtuIntdy_w&oe=6A7DC7CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ3Gx8Xj6r0Q7kNvwFtYnpn&_nc_oc=Adqf4-2HOymzfh3hAoHcexXycR-Jplq2j0DrzI8x0VUjR74SjQxbRjltgp2htO35LOo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQAzQg74B9SjyHUD6oKsbu1feqM-Xo5QjGDYuAHRQJng&oe=6A7D9D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nRSWnw-c4AQ7kNvwGYW8nH&_nc_oc=Ado-aBTUvIVXtUFucWGHjrqUZCxbNTGqXA05M3xyZAwCU_jQbhMx1y-V4KWVoFe3IX4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8k6fncMm6DkOh6BKa4P3cphkOjjqc3gRAAX-1o_ygow&oe=6A7DACC3"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5hF9rlnqk4Q7kNvwHJDWPF&_nc_oc=AdoKMKvXm4JkRZOdFry_3Cx5JNhK8T8ZWC5M4_QS-k-C7juGrpSACgk1jO8oixfMm
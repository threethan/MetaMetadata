7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I167-7wETCYQ7kNvwEMwVad&_nc_oc=AdrVzh_FG5_vznHc1PgeCXD7ljRRNOi2AxTcNKB_wimQlcfbkPC5r8n3Bome6lS63KU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV23RrVKZdJiTC8byjEz_UvkqyDh5_jD8h07AyW6dlsw&oe=6AE7674D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyWFpKdcR4QQ7kNvwF43kuH&_nc_oc=AdpfUxWYv7flT3Y6yB4mHozoHAhmz1_cIxtcdKONHs2yA6nuwEPH6sg7n5OStECwRI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx7t56GrO-P-ADagqyvz4IHibzB-a-z_QQNfv47TXfyw&oe=6AE73FCA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2SubpjmR3gQ7kNvwGY03Rt&_nc_oc=Adqbsztpzpny1ldt2cKGzJy5GzEnJJszn_FBAQ1IauMLQBa_9fsgWJGl72XqefSUO88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgi2bBDDsd3tCDazizbrUrW2ka9_VlRQAvoM_HmMTNrQ&oe=6AE74D5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPFMUD93rygQ7kNvwGB4sbj&_nc_oc=AdrLah4usnNyBBXJpWdAk225WW1rc0TDCCSlsNbx-CzyGsmXnIXgVnkE3HjIVB2g75s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFZRf3mQfAoV7tX81bnyaud2D7FgYsOUNqhbNcFM9efw&oe=6AE770C8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Please, Believe Me", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "P
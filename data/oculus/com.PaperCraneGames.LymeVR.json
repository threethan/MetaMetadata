1-7&_nc_sid=6e7a0a&_nc_ohc=FEy1QeDlldYQ7kNvwEVOrKE&_nc_oc=AdlTSixqM2gFndPSMWVo5KOm4zYnDXNDYgF5TlFnDq4c12G3EDzWEs58UQMFRseqnqQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuqCwwRk0cynfDFKaidJy-65xqyHHaHvDxM5_EOsrRItA&oe=69A44DDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuAHswZrnfUQ7kNvwFO92zM&_nc_oc=AdmR_cPqT7kFch-GKORJCDkh_49NZzyVtCF9BUNEvEPmNazdwZ1L06pO0HqN0owXEwQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfulkTSSEFBmVCvvnpqQvCsBt2EkBnmMhgqEZCQZVwZjFQ&oe=69A42543"}, "display_name": "Please, Believe Me - Tribeca Preview", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\nThis experience is part of Tribeca Festival and is intended as a preview version.", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\nThis experience is part of Tribeca Festival and is intended as a preview version."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_o
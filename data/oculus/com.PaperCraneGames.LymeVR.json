7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjaUlqdNEt0Q7kNvwHfF9RP&_nc_oc=AdpcnhSreiz5YRg48J5uJbwp9dSf_rhlk_lH0TKheGr4wCrayfokpe1Ldwg5QqXIa6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkFQv8hEzyxFjJA7B-ojZmC8or5dtN4xCk7wvLqY0UZw&oe=6AEA0A4D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyWFpKdcR4QQ7kNvwEOXWHi&_nc_oc=Adq-CX48CCs9YyqZ6QXCkN5wjgR-a3cJWWd5MWdwIqHVGRL3hzC0ZN5ujUV9ejyYL2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6SAVr-qvysXMrUQ8w_ok8kYw_2wQ_ve__XGH5KhTijA&oe=6AE9E2CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RL1yYy2nOQAQ7kNvwG5KxPB&_nc_oc=AdrK2WU9-WBbYSZUbr80LAIuKj5Hz9Ww9PZ0GBsYNzzt4Sad4nCTTAfoOs92bVEsmGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMJLkAc3xxHYVVzfCGkOKhQV2axEvJ5kfjIyOjMV7TCA&oe=6AE9F05D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPFMUD93rygQ7kNvwFhlH6X&_nc_oc=AdoXXhXPy9N1gCbzFpe6iaj-x0B_wqP1iwhb2BYYVTbkUtuMDAqLMcqLUGRLgvA6wS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPIO7bKHyY_LaDFObcrlaydYjt7_WzDgXixEknkQuCfQ&oe=6AEA13C8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Please, Believe Me", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "P
m9-6aNcsQ7kNvwF1piiY&_nc_oc=AdlqOIjX35WOzOfZ3QzohqrA86bu5QSJ9rdDFaGCvBiDmeRpDgxHckQh31bqYxA7ptc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwfWJVMVLwUQZ7oje2CrY3cZhFJi6zpFPbRDfTlqMchiA&oe=69AC188D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm0JxVn36wgQ7kNvwFLGvrr&_nc_oc=AdnBDFQgj_PV87g8_DXZdRUMnCKtJPA_afS4M9Og8D9JU4U1RM8EDxep8gjRSlJj0Kg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyvrzoPnLJmhdW48HPe0O4eBD2UzAxIBOKeeg6G8T1bcQ&oe=69AC294A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GHISnj6ttQQ7kNvwHefR0z&_nc_oc=AdnUXQFBKFTSrz1KQTtdAoNGHLlR8Ouv-yXc-fcE8UpZ_kB8ZLCaQ7vqy4wwINYRD8A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfA0ciMm3gszTa6HrakS2VZ7Zc-DEUoUJXhlrwjHpKrg&oe=69AC36DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGqJ9uQd2RMQ7kNvwFkws8F&_nc_oc=Adkxg8zLs25CDlTRk1eVvYKdczMxYO9Vm_5SC3vza3PM5g_r_KqTh9J8lGoOgu0SePs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfytC3ctm3VIysaD8fGut5kfVOdJnoW-TBXDz8Tw8k_cTA&oe=69AC0E43"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIaFacXuNuYQ7kNvwGmFERl&_nc_oc=AdmUdDDi0CsBZAPiMN87u4RkF6e5d_ppF47uvAWOe9kw3gsieDUuOTo8ENDIkKYrr3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_s
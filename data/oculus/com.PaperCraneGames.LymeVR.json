ng?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36SxAf4SHQkQ7kNvwHjoUzu&_nc_oc=AdrTkMN90B02sws40bYx528ZDoGheWQf_FWccJZz1pJwFIO_vO3T152z180NPJvD5jU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3UFoADLs_LsYeKLGqfuPqYRmqqGYc1jF1UwPjbfU-Jw&oe=6A85A00D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SyuSUZl5-QQ7kNvwFNBb1P&_nc_oc=AdqWl2Lb-lKXV6f0ugGdgDkRrOReEJS_OvkvWPxqrr2KjzRqZeOnQjhNJLJsVKeX6Ks&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBl0V9eYz34X4pgs8Gsm9cqkOSxh9J1Ns_552Li5ciFQ&oe=6A85B0CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FqUG4mr5kQQ7kNvwFaDJ0z&_nc_oc=AdrwThudRt1LceGX9Jh3zDzuQVtSh907Fu_02td0UWovzmF0uDh1idY4oCEgtGsDCpI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH91ubKSS5WfAQTOVxjvtjMRYacXhvsrWfSiTcVlvQMAg&oe=6A85861D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtlGK09nv40Q7kNvwHITfzO&_nc_oc=Adr70wV7xTDTnY0bAGSK9pbUtGYyKPaqqcfLd_rX6LPPab4On9ap6So3lRPJPfbRnw0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxgxuyns40YP-y8G2MZBXtS-WI2puMvgVva-XzTW3aWw&oe=6A8595C3"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGAvXTwfweoQ7kNvwFJGf-n&_nc_oc=AdqPn0bS2HWnRPrIxTCew5626YfuvKYdsYNZNh0UeTazkuh4aJJZ
ng?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o58qKWhHrUQ7kNvwGgHIIH&_nc_oc=AdqmCn0Ro5lFPEyBLtFiFggyY4QkDyJ-zH712tIh7CKAsftKg-moSNcfFn7x8fZQUqw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaWhAzzcc2HYynowgNGk5PxLlKm7c5oALJxtnJ-hxxXA&oe=6A8D890D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4akBpGQaAEQ7kNvwGn7j9S&_nc_oc=Adr1UId_zSGFmow04ZaRPWmMJFpujnMXv5VPS-6oKpwyXfUD8iQMK9VMpnNVFVNs6yI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5bzdkOGo_nGSjsuNX_68qoDDNy4wBqWQ1lFaoQmww4A&oe=6A8D99CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbgTadZ6aGEQ7kNvwHLWiFS&_nc_oc=Adp7nvzCpFJDVw8spcPP6D43hBw1YiWF1JmM5uoGNDn6eF2Rd9H9fWbu_WYc4CEk2Uc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG7kzHdsl1dG_DmW7RUxrGKA7aLoYCH6oTNIxQiu7AZA&oe=6A8D6F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBLPMXU_LCMQ7kNvwFc9Jgt&_nc_oc=Adqoichfej5mt34FDva9SQd7z1czJTcy6IDYAWwcMF4e93ZK7JF5zSzc-aTuDtmKDRE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhvx9uhW6csF5aI5Jzb7WzH04upWD82TPCq-MZxyI5Lw&oe=6A8D7EC3"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr7cltUx6jMQ7kNvwGRfJdG&_nc_oc=AdpJaky86EuGhGlYzq2NRrtTKWxUItnrrCzggErqklVIm06JN71p
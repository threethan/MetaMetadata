ng?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg6-Mzo2nB8Q7kNvwHCQIS-&_nc_oc=Adof6CDIHBISaTQJbynrF_ObkQnvwVaSPaXS8NSiMuR6RNZy8As9_cZwPfGGWQld0_Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvMqVn422FEXNFRTF3M3N6PO-zJTuAgdLXgztHdQqZ3w&oe=6A8EDA8D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4akBpGQaAEQ7kNvwHAr3qg&_nc_oc=AdpdpazTawbCCK1MJ2i-dw9VEFqmLLUI1OOgpoKo9OCG4a5cHnURp1QMV2-y1A7HBQ4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFara0CelV16vRXf5QPDsOb6hw8GasxPTbfevDXVp32Dw&oe=6A8EEB4A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oS-2qIQqncQ7kNvwGFoIZs&_nc_oc=AdoW-Qy29-kpsN1g_lIZYJqgUNsWJ05dMWvR8T4F7JUmzVsNTfcBPelCPQ01cdB-9lo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEocfcb9rNrGxPT6d1MqaKIRbkoUZ-8o6cblOsPR51b3w&oe=6A8EC09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBLPMXU_LCMQ7kNvwHAo0Gh&_nc_oc=AdrQ9lsRMk--srRXiu1V2eyPOUSUbAQNBb5OLut3huWuOAgsInYwXk-VfMD0z9YJCII&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYuTvKaMafEX3Gp-q6RFG4DndIFzN6RMZk-7RGtdbB8g&oe=6A8ED043"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr7cltUx6jMQ7kNvwFCrYZp&_nc_oc=AdpZBo36SBgsMC_GX0sWI79id6Uq6TO2H7snxvghhTnzG-HPLfGG
7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3YQF0dvEisQ7kNvwGOL9qU&_nc_oc=AdrA_zpDY5_NbdweaS7KwVsZ00_ZE9SiYGuHPhU_AkDeM5-_zkxbXynRXRcoZswmLT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj82mDX-hjabkvrbGl2Br4rGiC_FE2CwZ4bBg_GEsbIg&oe=6ACD094D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bFdUC18_dkQ7kNvwHflcl1&_nc_oc=AdqA-Q6A42yqIE_W-NYf7HAijydgptvxdBZx_123vdjIO_4-ZFKc7GLqB8SboUxVaNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJXdTD3VJLniMCTmnBpO4x_95lrUwYx5WDfKQT7EUJlw&oe=6ACCE1CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwP55ptssv8Q7kNvwE2KIFV&_nc_oc=AdrfY3v-7v3_dSkBA6Rgje3TvBdIUEPfd5ZtKSN7wedW21w1Zjs0eJKVpx93xa3VEVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAeWGdI6fOOjiWr0Fm25fMseW3cvsJgbp0TyUM2Je6Tw&oe=6ACCEF5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAzM400bN1kQ7kNvwGfIFLo&_nc_oc=AdrlmLUZx755Cic0h3BT7ws-OGuHpGAHD7rT_DYQ-CQdPflNt_oKuyptIGmnSFKDbZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG837t5rb_5XGP6CY9BTRPqu_6YGf9fCwGAg1_gIqSaA&oe=6ACD12C8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Please, Believe Me", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "P
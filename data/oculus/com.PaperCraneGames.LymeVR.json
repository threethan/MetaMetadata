107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyZSTQm7r3kQ7kNvwGUYMVK&_nc_oc=AdpIF322HlYlyjFBQjYDbQuAXwxXV_ve9BdtY19TCLYLBNox70kQUVts7AjcNZslxR4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-w_cOy0TXWACJXt1Nr_85-nbVvp1DcX0wlXi0DNdEdw&oe=6A39614D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RL_7IOqk6MEQ7kNvwFZ49Hv&_nc_oc=AdqGwhvySSh_4SpaZEwBy1AtwcytD7kVKfvGbdFSiU9z42vUrgcTVzviUFbaayCao1k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MLOeKOgt3_xsgQgsgXYKRBYyDpvxGkjjMkH92pWnWng&oe=6A3939CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpFkvmxYduEQ7kNvwH_Avio&_nc_oc=Adp_oDn1XZI2NEe5kz7wesmKT-kcA_UizyU_w4XjyOXLz6V6QkOfWxpRti9IcAjabII&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TH9jtxSFXWil_gs4DJQKGJlu_rvBs9mZLUhMYda5Emw&oe=6A39475D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ohNuTdUfI0Q7kNvwGvDl68&_nc_oc=Adpii42TBCfn6hww0Z7yV2DbfwfdgoVXtuq3FZN27-GsYDN8vW0wmi1yKcdlNMVClts&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xi5efkorupUbfmZwuA2EScHyGqtHvOaQyFt9LLO_I8w&oe=6A395703"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E6AqGGVSn0Q7kNvwGq25Hx&_nc_oc=AdoW2qk-dF3rIops4-jwTXKXgdPzLnKUaOTI6_9vA6d6iOEerv_fP5kX7AjZDnUNz
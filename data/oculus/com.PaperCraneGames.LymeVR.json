_cmPdJ1QdJrsHY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsKEJnYkt1xKcaCiybM0E5CGDGlOmnZG2jUzdNakRJJVA&oe=69A18C8D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rffvbOC2aWIQ7kNvwGd8vwb&_nc_oc=Adk1AcvnvKcgYxDTZEkwCMA7eIb5XtkqgHeUL5rsiPiAW8aaFk1VeFw7CstBdWeJjkA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvry8uCQEPnFqzkpqb_trEua-g3Et9dVue1nkFXKMI3Wg&oe=69A19D4A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEy1QeDlldYQ7kNvwGXIbkh&_nc_oc=AdlWRM6iJvifMIJMEPiOeeFuPmbCXAvq2Wa70U9ukEjjvgcthwZFeaBgIzKM2PxEAMQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftOKSe4Mnhw8kz8fL_MQYBK6FMFgY7f1pjMuZuecz3Ogg&oe=69A1AADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHOzyp5UXvQQ7kNvwHYQstR&_nc_oc=AdkKt-77Z5bgfAbiu6X1I2YO7D6H8NzCwuqG7VX1YrOneicjOgp2tpZfLovwXoxQCe8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afvs0y0VVYcHf1fAp91SB-iftheZ-H412GtGwlmK1wKp_g&oe=69A18243"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujvPAf5Q30UQ7kNvwFoTONy&_nc_oc=Adn56Uc295rJXRakljiDR4C5tT6XRlItrmzBomwYkiC3z2-9vG9EzB3JP0ZNE4oOO3M&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfslAjntxEYsXKJZHeQDVnCHuOiE-1-gRnGpG3rfWI0kYQ&oe=69A19608"}, "is_concept": false, "is_test": false, "is_trial_offer
Fc9R7OLR30JnUCeYXhhvQ&oe=69AD7ACA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrNL6osjeJYQ7kNvwH0GfXF&_nc_oc=AdlhJShQ-v6Pae3OUAiAahL8kt57HKSayqEmx-GeGiOoa8et9-UofEwY_nPrS_lOhdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkRZXPsKDFTJR6SFpTfSVn-CCzDO9B99bb_dlDE9GvoQ&oe=69AD885D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGqJ9uQd2RMQ7kNvwEkprVY&_nc_oc=AdnxAINYiAMD34PoHCpc-qp08W5StFDFjDROGYCEGMVYG6sbvPjkCC82C-AoZj0sKx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJZ7rY0Lk4wrm5g0JPsY8nOt2eCzxbQTJq7rHEZqP0lA&oe=69AD5FC3"}, "display_name": "Please, Believe Me - Tribeca Preview", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\nThis experience is part of Tribeca Festival and is intended as a preview version.", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\nT
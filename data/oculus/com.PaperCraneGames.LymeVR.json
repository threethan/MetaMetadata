6ntXrMGVnNhE3ksSv5bhLkxoh69aZN7wSVQIA&oe=6AFB4D88"}, {"file_name": "Screenshot 1.png", "id": "5231606923586555", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974626_5231606926919888_874756952672654523_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMC-MuhxPBkQ7kNvwGDNtCM&_nc_oc=Ado5_xP7-vEmtC04aQ_BoIB5IRZlvaTgckcVoENwO1cgvNw27cZB-4GJGp66I5Fvfy0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2H0w1NajOc_AuONYw3n5h9zWAzX20rSS96XLmrLnfPw&oe=6AFB2DCD"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgBQXXLzxp0Q7kNvwHK1p41&_nc_oc=AdpC9R2H6qux2txoD0sHF6QjpldJf-Z8AtWqxB5p19lz7QWvPXXrMi7DqBfWbw7BsAE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpd4bzYk4-LPsjcOZACJv3p_dJe00OIqcN8AuHz-pCVA&oe=6AFB3E8A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3aw1pizBNEQ7kNvwHgS2-o&_nc_oc=Adqfc8Gqt9QJuH_jAC8CDKw6hjajZT-OiDToD8CH84p5AoD_7BqozcDZ9fIKCfiz8iQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcfNq9Cm68WJZ2fMWXZ_PtDpd4nGgt3vIuuBi0b6ogdw&oe=6AFB4C1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgI_no1vnKMQ7kNvwFPlYp2&_nc_oc=Adqvwqhxq5YlHvY6LNkZBwaDpeUnNfW5f_626YqbGTP7WHysn20psNJfbNJlCMnBG80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqpZKTrlYiXSB6JecBfaBjQD8c
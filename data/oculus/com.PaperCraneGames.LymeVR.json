107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYjsfiA20AUQ7kNvwEAxeL9&_nc_oc=AdpY0Pv_8SpZ7VaVCxnBqhou1UJR4A07_oc8YhOvqvtXnvui5LrVkd68NAQRNnkZz3Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0hawAm7lGNlqRmiSmrM5Dt_HCXCMpOZIkwsEOI1Bi1Q&oe=6AAE7E8D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJEypgRvRWMQ7kNvwHAXlax&_nc_oc=AdonmoETt5t2XyWE18T_RPP0YLrNqCS-HrhsjygR24b77aCU8F5FPiT-CMAEVCZRQkI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMwR_6s9l77li2oC6vtWCsSP46f4W-nu1hPD4ibZ1AAQ&oe=6AAE8F4A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATqKNTbVvnkQ7kNvwHisg4Q&_nc_oc=AdqcBp-bXJtqmA6vkHk-16_dG8dFlj1C7kPz6lDjFSiYLHD4WM9OSZv_wjmLtqZYfp8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIke_j2KfSqGeY1WIFSriKXaIX6d0uEmlTBqakpTdBsXg&oe=6AAE9CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1cf9xbPwrEQ7kNvwFUhZ5j&_nc_oc=Adp5mCLgFsp5bFU83-6QiMFMCNBlfgFKk_EGPkBDuHjLFcWAI3NoC1KAfljWoOJuNEA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRiNwp8agJ1LlbWLEHFB4p-k3ppZpkB97cbUJD_rgC7Q&oe=6AAEAC83"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0xwwmOuB1oQ7kNvwEsiqzl&_nc_oc=AdotvntoqmsUlf3mrR0bl_oPkgJpBmwiPuD9DAUN3gOKLEr0zUkrXnYz-4tKpZY_i
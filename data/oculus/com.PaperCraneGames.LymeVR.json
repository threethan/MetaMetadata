R1zz0xU1EOlSAoj0Ggv6A&oe=69B9584A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWEI2mb1XTYQ7kNvwGtzDtd&_nc_oc=Adk5AMBPZpcSgJL-AEbLcdyRU1XUvKsSJxKSe61s5C3N7_CoEReJPSGZsvmAtCyhMg4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuEDN49ZmVl4ywkLXVx_5KdEG1BpizCVJ0M2Hmw5jmdg&oe=69B965DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iekbikVlvJ4Q7kNvwETdsLw&_nc_oc=Adl3Vx-zR49D1SVMHF7RwKQ_6dlkN0fMVmb6RW2G9smPM0zYcI31nJVzg-5hlmDkwWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKPplfKxvqZX8lym12S1tZYy2QJpd-I4MVnvWycsQ8wg&oe=69B93D43"}, "display_name": "Please, Believe Me - Tribeca Preview", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\nThis experience is part of Tribeca Festival and is intended as a preview version.", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\nT
5qXtYwv4Q7kNvwEUdv5o&_nc_oc=Adn5Jx3uGoMALXuIpDDA0scJqgr2nzlRZ7dZD-o2eKkwdEIZYH0JGnQHT7Vqby0mCg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyb-T_1UCTlGLele4ewr_SXCxoj7c_JTLI6Wxxi9XyIBg&oe=69B7F60D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJdabCb7ddkQ7kNvwHML3wR&_nc_oc=AdnxRfTsR0gnJhGuWgTaksCiAfhwfz0wfMCiErabefR6qQyG9uixUGLP_nPIS93ks-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyAYEfjc6nmBdzeK2kj1-cRoaK97LGBhI9gGjVEeyrp3w&oe=69B806CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSVr6Y6b1kMQ7kNvwHq6I9E&_nc_oc=Admi3soJIKsqQoAZOCBSyk9VrGphSVfp3gfRuUAjMNHaR-CJAk5GEdlR11koyUl9avI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfmX6qel5vDUcxD-WaehHF8QSAkI1TjtHSjWQHKdXMFQ&oe=69B8145D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iekbikVlvJ4Q7kNvwEOvyxz&_nc_oc=AdmCPdXKA-Hu7Y91T3v3yvQFHifESjUfbX88t6q_eXjvGIE8Ea2eCCmu7WphKq6OeZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXAIoh8XFZcHU-QiFypYMVnsTHN_bfwGmdhsHwL5HPZg&oe=69B7EBC3"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RraV6tUddUYQ7kNvwE_ASdP&_nc_oc=AdmQ2CDgqh_YO8qkdqwGhBtysqGMlG5M6m3l8k_JR4hDIGTIwME2Jrn9VpxC832eeTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_s
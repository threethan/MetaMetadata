1-7&_nc_sid=6e7a0a&_nc_ohc=-9PzCH1F6xMQ7kNvwEq-rrv&_nc_oc=Adka9gupfm5EqVeJwG-GWUOt4QDHX6Lm49jbCLNqABO2a6VaCYHcfdedUfXAKwpxKck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsI6FO1nD35V-82kBdEAMQbx7qBmHV7Q2_Lif7xH0P4OA&oe=6999C1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PA2h0gRdgcQ7kNvwEHiuzG&_nc_oc=Adk_Z6hG2xKOBvRKjVGa4vqMfV3-_11L4Tsq6bP9aWYp8cwhy5PvjSVuIN1k8KGPL7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu2OvcF7vXe2SlZtYIATjX6BYGd0u0zt5WoqqhYubxUbQ&oe=69999943"}, "display_name": "Please, Believe Me - Tribeca Preview", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\nThis experience is part of Tribeca Festival and is intended as a preview version.", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\nThis experience is part of Tribeca Festival and is intended as a preview version."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_o
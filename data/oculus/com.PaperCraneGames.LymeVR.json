jDcUFJKsUe71VHY4NgRPsyTmyKnnOVjQ3cgtQ&oe=6B06F2C8"}, {"file_name": "Screenshot 1.png", "id": "5231606923586555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974626_5231606926919888_874756952672654523_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl9lR4o8YXwQ7kNvwFma1_p&_nc_oc=AdrSFW6CXOZKRbNyyP7BNUPKOoPZbZM1-lHmD5CinYnmjRo9ed7kp8W9VY6nP6Y_z0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMf6Asl2Le_b0jbbsXSjLQYaKJCYNemUkEXOgVxRe1Yw&oe=6B070B4D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KKlT6ueBTcQ7kNvwHTWyov&_nc_oc=Adq7LVMAIbbgIN4MHm_spFtv3nuryUuRoM6-ZwJd8EwNZDoOVGLts1rI53P9E2E9Dm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo9jm3pdP2ISwtKExm-7U6nAnc37PmZXuSQzDaXERNpw&oe=6B071C0A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmk_rhkW3z4Q7kNvwHjyZlZ&_nc_oc=AdrsJ8nW4Mbnw5a4oUIv983w2VcDGkSobsE72DGWz0R-SrTD0nX_lvC0kn37-IbDCog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP5hAvIQK8bi-JN4iW9kOPJ_M9tgtNzug3EJRd25_IKQ&oe=6B07299D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTMWmyhfOuMQ7kNvwFJT78O&_nc_oc=Adpgco11cXJIhO5ImHOT7oPTGiHoecEEAZOGvQSKndpvR6WG-HLnaxeTMwvaIBZF6PM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtuoHzkvcpdy6UgtOxrz8xB9xO
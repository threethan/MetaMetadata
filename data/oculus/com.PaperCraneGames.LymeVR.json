YwsHLtZPhoNbQc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfueM2V889MENhqPc90Na3F0e0K8jTG8s1STgWNde-m2jw&oe=69A5810D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K88zEFnZsyMQ7kNvwFo2WBz&_nc_oc=AdmmvEBpC6tv6g7FFVyA56hEef0L8F2ketGXozr-sKUXN19giLv945A5tbMGikWbMow&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsjUCpHdzN8hzQb8rAMc6sq9RtnIdwdf6qttmiwTq3a-g&oe=69A591CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-QZPiHVAu0Q7kNvwFxjPey&_nc_oc=AdkUAubalFIzmffGRFwLLMu8pD_T7owLOQdGFXIWRRwHIES2DW4d8Llm28F2oayy8lE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftdtznWlerQeV2tYJtix4znvzYKTxBlf5wgHvD0NDmuww&oe=69A59F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuAHswZrnfUQ7kNvwH3d3kS&_nc_oc=Adm-CsdGO2935IphBmkHAbG3oF2qX0nbCuk4Q1-r0c6EsgQqUGZAq2ZmW7Aujdhc3ik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftb5uQ3WnLrbwyPq6xzisxZlQj9PMn7j6VpK8xjrsIVKg&oe=69A576C3"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohkL_euCsYgQ7kNvwG0MzLt&_nc_oc=AdmCBNeFp3CLL1MoFJDM5Szt9fi0g758XNMa5RAok3wavNIj34U39GigaSJW-mrILkw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfveQeq0xoow9myBTsctqLRcRBZOdHcB4gLjKrts5W_L0g&oe=69A58A88"}, "is_concept": false, "is_test": false, "is_trial_offer
MMWICX0rJ2cSJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGJFeLokfQVUODQ-XEfobej8kqhwRxyvHdZDCAQcSWzg&oe=6999A38D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJDRdLAkAPwQ7kNvwFa4Imf&_nc_oc=AdlMOamWC0H3t7mvkLxEYNFP3miN2ymtJqz5_341_IJYlyVJMTslWf3yPPASODGuZ94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudcEK36eoyy0J-wMa_61-wo8tXi5jvO1xOub-dVRfR7A&oe=6999B44A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9PzCH1F6xMQ7kNvwEq-rrv&_nc_oc=Adka9gupfm5EqVeJwG-GWUOt4QDHX6Lm49jbCLNqABO2a6VaCYHcfdedUfXAKwpxKck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsI6FO1nD35V-82kBdEAMQbx7qBmHV7Q2_Lif7xH0P4OA&oe=6999C1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PA2h0gRdgcQ7kNvwEHiuzG&_nc_oc=Adk_Z6hG2xKOBvRKjVGa4vqMfV3-_11L4Tsq6bP9aWYp8cwhy5PvjSVuIN1k8KGPL7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu2OvcF7vXe2SlZtYIATjX6BYGd0u0zt5WoqqhYubxUbQ&oe=69999943"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWz4SJwA7QMQ7kNvwE88LqZ&_nc_oc=AdnpPMD8rLTT3ScK-QYD-Xi3bGsq6RsY7COMpQ5v0f766t_aWf4G0H8RSlKbMIubXeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuKCVwws1wflAxJvXsMQGhpgTesNvnMhLLbIlXiS1qh-w&oe=6999AD08"}, "is_concept": false, "is_test": false, "is_trial_offer
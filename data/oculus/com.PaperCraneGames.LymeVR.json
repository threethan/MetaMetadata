7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMC-MuhxPBkQ7kNvwFYtqi9&_nc_oc=Adq-_XueJS0Ds1Nq5fX5iQwYd8lYc-X50GiwxxRXW6ycBBHM_GIprE3BlGmHJazcLoM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA4zeIJbHKKnMTuGIb04BREcsSHGtRNhLdWFZf4VOfAg&oe=6AF9DC4D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsCeguFrbiEQ7kNvwFyoPqO&_nc_oc=AdrVtm3-osep233ezWGeg6bC5VkU2friuxkye04CJxvRbvxKbXV6o-6s2mKB-w5uCEk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvX4ZFzi67ueca5Rcpqs0H1deXFRD1DgCf7566vJqKlA&oe=6AF9B4CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3aw1pizBNEQ7kNvwEmko_7&_nc_oc=AdpAPpZPpcXrdYUa5jlDuXHxCPhir4-q95pJQe0ieIufVS6aneuw0S6TaGFw3Iz00jA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-wv8dhltsc_StimuJRKtYERvx38o3qg18-k8W4vD8Jw&oe=6AF9C25D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1vhOh90gAcQ7kNvwHt93S2&_nc_oc=Ado7VBBmy_25WD15sgAVm3499ymjaZaVM-O2XzhYm8pz_zvo94RCqJom-6fyXWksgJE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWUX6DFa7PE4e8GCbOOkYwpszwClMIK-yaGCVGUA7K0w&oe=6AF9E5C8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Please, Believe Me", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "P
g3vgedkIgMyAPns_XXpl_oWzU9redNghtYQwA&oe=6AFC66C8"}, {"file_name": "Screenshot 1.png", "id": "5231606923586555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974626_5231606926919888_874756952672654523_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMC-MuhxPBkQ7kNvwFLfO0o&_nc_oc=AdqNosSGejxDDwNLJRBOfg8CmV3PpNkLh2MK_t1CEgerP0q9MslX-yFEgK3Y4o_a1kY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJJARRhv1i58FMsy_aFjIm5NSlLwMpwxJa8fnQhjcK_Q&oe=6AFC7F4D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgBQXXLzxp0Q7kNvwF-Qsu3&_nc_oc=Adof3OOO2CaW5qi8MeJOdQUYhNXf20BGqVaSVaF-N-ObZwcDRveQjZnOHGuTXjUen6o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6uHzPCGj9_aVXxjPLcSfoOyk796949sOZVXanLecuGA&oe=6AFC900A"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3aw1pizBNEQ7kNvwFes2De&_nc_oc=AdqzDVWUNqXi2V-KjvaU0GwACevH10CPUDqFpw1RLPf9GwjcxRFtDiHMmMsTAnPZb5k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT85CJHSAIukKF0riC77GRkhsCtIi6bucjYM4o-J-h3dQ&oe=6AFC655D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgI_no1vnKMQ7kNvwHUn-zM&_nc_oc=AdprgY44eX6SCt_bmB55c8wE406awJTXJggotX6f30p-rHWg9hs4kaEN_XuJYsuDPzg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfoMyIZGwOqFmRdYadK6VOAqlv
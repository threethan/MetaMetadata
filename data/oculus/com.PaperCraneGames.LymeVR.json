7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpqAJvKV9hYQ7kNvwFGLZnP&_nc_oc=AdrXVhA27D1pd4b81JxPWCQayiFn34iR72Hy89iTZiKj1aPUoPnD3_OQQrzSsTqzHMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe3A9gM6JwUc9fQWGJ2lMuspAWV3dg_P-stUd-GQrsaQ&oe=6ADF460D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAnjs0Zs0bIQ7kNvwGxRp0Z&_nc_oc=AdqcCfxiBErlAYPaNSplzPuqAQ6m_enPNYFoFU9h54I14Wv3kioVq1rn0wxs_SQTEoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNpOKnLsXISdmmJ3kPcFwFnmVinI6hv-yo1X-IUeA_eg&oe=6ADF56CA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slHkY-i2hQgQ7kNvwEcu9OU&_nc_oc=AdrjIBFv2PUXwWuSv1KZBndwz3CpY4DJEzKq9Dy45BVwsV3VRdH0xVvfn-58ZJL4z-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmvyfSYu80ID9kYtCCOY_oaIN5HmEUUwK_AbaY3WW_qQ&oe=6ADF645D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWIK6Lgh8YsQ7kNvwGzvDxK&_nc_oc=Ado2xCubDPE3LV7PRxy5I0cr6IUvn0-P8eYcjBDfJi0xexbQ5sr0aN4066ttJ36GpY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBCT5EQfErklUkAfurTWReEsJ9mYmEQf95mLLnXRD1Dw&oe=6ADF4F88"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Please, Believe Me", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "P
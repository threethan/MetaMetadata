gh2Bq6OYQ7kNvwHqTmzO&_nc_oc=AdlTtfcOtVdDGi-riHK323OcHmeFQ7GeuRMl3AR46FEoy1Ed5xF-w2Sv_9aB1C2Ws9g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2jTGuPGFldcL1K7Qm4bkhyfcqUZxUKskfKyh_KiRAIA&oe=69BD3C0D"}, {"file_name": "Screenshot 5.png", "id": "552110256274103", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974466_552110259607436_4344813015277639457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hegOVe49KbkQ7kNvwF1p40O&_nc_oc=AdmjUEzF3kfvbs0LQciH6DK7aBGJEqQ5Pcufw7vlnoS-I8kDgdbzkTkefyvQOKfUhG0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5yGxQ3GeoW7YFN0E7ydVEjFt6H_OpwONyk0OZAmVA-Q&oe=69BD4CCA"}, {"file_name": "Screenshot 4.png", "id": "1225835178160644", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974505_1225835181493977_8102166361459397907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poxx2-M6IrUQ7kNvwH09UNy&_nc_oc=AdkdaLZyWoVqwaWKnyF47LCoJBzLdvNvoG58wZVrH41M8XH0I_HqiBUWXBCuLtAEe2o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLFi2T2OKUgQXBVtUrMKAchOazLFd2F9q6A1IBpHRGaA&oe=69BD5A5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1803661193160701", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036656_1803661196494034_4622632836788716082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1il3otpzgMQ7kNvwGA5gyR&_nc_oc=AdkFBVXAE97KTaFqBl7nwMv8FUUjNgZm_YrrRmiO6jnqKoJwIxCPei0p0XY0TUfQT1c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8QevOmLB_J2JFhP7OGnXQAvMuuFuzwgzF9PhZDuDT3A&oe=69BD31C3"}, "display_name": "Please, Believe Me", "keywords": [], "long_description": "Thirty years ago, Vicki Logan, found herself diagnosed with the recently-identified Lyme Disease. When she didn\u2019t recover after taking antibiotics, one doctor stood by her side while many in the medical establishment turned against any Lyme patient who complained of symptoms after receiving standard treatment. This VR piece investigates Vicki\u2019s tragic case and explores why the scientific community stopped believing patients. Using a variety of new technologies, including interactive mini-games and deep fakes, the experience puts users at the center of the puzzle to uncover what happened. \n\n", "short_description": "Using cutting-edge techniques, this virtual reality project centers the user in an investigation about the tragic case of Vicki Logan to determine why the medical community stopped believing patients who contracted Lyme Disease.\n\n"}]}, "developer_name": "Emblematic Group, Paper Crane Games", "developer_privacy_policy_url": "https://www.dropbox.com/s/l5nlheolc8maqoz/PrivacyPolicyPleaseBelieveMe.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Emblematic Group", "support_website_url": null, "website_url": "https://emblematicgroup.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "732155651347339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974510_697006048255234_7961736631368756683_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxvbOkrOVugQ7kNvwHK3CWv&_nc_oc=AdlebFd0E6475T1z_rGIXiFfYlDuC7P9Xx1Z2f_m8-43CLz_bOUhxQWuTaGZl1wUMQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_s
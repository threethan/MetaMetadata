keywords": [], "long_description": "As you explore this magical realm, you will encounter multiple enemy races and uncover the story. Throughout your journey, you\u2019ll strengthen your army with the gold you earn and develop unique strategies for each enemy.\n\nUnlock a vast array of character, spell, defense, and production cards using your earnings.\n\nPlan your strategy based on your characters\u2019 physical defense, magic resistance, physical attack, magic attack, critical chance, and special abilities.\n\nConquer the enemy castle before yours falls.\n\nWith prolonged battles, expect hours of gameplay!\n\n\n{616229851147453}\nFollow your story\n\n{966713325558179}\nAdjust your card deck as you wish.\n\n{1344980029968532}\nAdjust your strategy based on your enemy's cards.\n\n{896523892416348}\nWAR!", "short_description": "Conquer castles against numerous races!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://www.noneplaygames.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://www.noneplaygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8664152103638995"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1474040107727644"}, {"status": "PUBLISHED",
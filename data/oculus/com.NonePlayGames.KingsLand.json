1l4KiWPGkefjY_8h1lN_8DhiKB5_-V7evd7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUOhtN9ZnFkWsLZLG3cWOFhc3-OHMVzOSqXEUqPY2h9g&oe=69B5701C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main.png", "id": "1232246688376845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303606_1232246691710178_540136499000367977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-muxuuwWVxMQ7kNvwGKUCwA&_nc_oc=AdkkWlz-Utgl7ctxwDnrJ14a01iTCf5KwkXxWX_EaVWeoBH41zibH6ZNdL3u4V7xCXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwItIicyqoLDSb4JZggQ17HVtDMdPzCEGrOYI400Fj7iQ&oe=69B5594B"}, "display_name": "King\u2019s Land - Tower Defence", "keywords": ["tower", "defence", "strategy", "card", "medieval"], "long_description": "# GAME PROPERTIES\n\n**PLAYTIME:**  An average of 18 hours of gameplay to complete all levels\n\n**MAPS:** 17 maps\n\n**RACES:** 5 different races\n\n# SUMMARY\nAs you explore this magical realm, you will encounter multiple enemy races and uncover the story. Throughout your journey, you\u2019ll strengthen your army with the gold you earn and develop unique strategies for each enemy.\n\nUnlock a vast array of character, spell, defense, and production cards using your earnings.\n\nPlan your strategy based on your characters\u2019 physical defense, magic resistance, physical attack, magic attack, critical chance, and special abilities.\n\nConquer the enemy castle before yours falls.\n\nWith prolonged battles, expect hours of gameplay!\n\n\n{616229851147453}\nFollow your story\n\n{966713325558179}\nAdjust your card deck as you wish.\nAdjust your strategy based on your enemy's cards.\n\n**WAR!**", "short_description": "Conquer castles against numerous races!\n"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://n
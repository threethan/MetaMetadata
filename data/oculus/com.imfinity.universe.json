on personas de todo el mundo gracias a la tecnolog\u00eda \nde red en tiempo real. Comparte experiencias, eventos y momentos \n\u00fanicos en el mismo espacio virtual.\n\n\u2728 DISE\u00d1ADO PARA QUEST\nOptimizado para Meta Quest 2, Quest 3 y Quest Pro, aprovechando \nal m\u00e1ximo las capacidades de realidad virtual para una experiencia \nsin precedentes.\n", "short_description": "Universe es un metaverso social donde puedes explorar mundos \nvirtuales, personalizar tu avatar y conectar con otros usuarios \nen tiempo real mediante voz."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imfinityapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imfinity app S.a de C.v", "support_website_url": null, "website_url": "https://imfinityapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1305714609301996"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3491596437668183"}]}, "baseline_offer": {"id": "3491596437668183"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792069920, "status": "PUBLISHED", "id": "3491596437668183"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1313684075171716", "version": "43.1210.
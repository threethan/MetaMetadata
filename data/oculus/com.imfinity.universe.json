content-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAtnOU0ehb-jQzIA9K7MXH4Z4pupTUPvUKBCO4ZB84yw&oe=6AE0BA78"}, {"file_name": "2.png", "id": "2660051167757344", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830822_2660051171090677_8733168190421975725_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPvJwFcZzM0Q7kNvwFWea_L&_nc_oc=AdpRdQuJPDRg0E_n7BvtG_3j04JMYQkfklLQxdbpcUDM-10obstRLkR47Kv1DA9T3qg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWyg4fqQOSRRwHrNnzCSRWwAfsmOi2RqL44ci8gOK1Hw&oe=6AE0A188"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Universe", "keywords": ["metaverse", "universe"], "long_description": "Universe es una plataforma de metaverso social dise\u00f1ada para \nMeta Quest, donde la interacci\u00f3n humana cobra vida en espacios \nvirtuales inmersivos.\n\n\ud83c\udf10 MUNDOS VIRTUALES\nExplora entornos 3D completamente inmersivos junto a otros \nusuarios en tiempo real. Cada espacio est\u00e1 dise\u00f1ado para \nfomentar la conexi\u00f3n social y la colaboraci\u00f3n.\n\n\ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 AVATARES PERSONALIZADOS\nCrea y personaliza tu propio avatar con tecnolog\u00eda Ready Player Me. \nExpresa tu identidad en el mundo virtual con total libertad.\n\n\ud83c\udf99\ufe0f VOZ EN TIEMPO REAL\nComun\u00edcate de forma natural con otros usuarios mediante chat de \nvoz integrado. Las conversaciones fluyen como en la vida real, \nsin retrasos ni complicaciones.\n\n\ud83e\udd1d MULTIJUGADOR EN TIEMPO REAL\nConecta con personas de todo el mundo gracias a la tecnolog\u00eda \nde red en tiempo real. Comparte experiencias, eventos y momentos \n\u00fanicos en el mismo espacio virtual.\n\n\u2728 DISE\u00d1ADO PARA QUEST\nOptimizado para Meta Quest 2, Quest 3 y Quest Pro, aprovechando \nal m\u00e1ximo las capacidades de realidad virtual para una experiencia \nsin precedentes.\n", "short_description": "Universe es un metaverso social donde puedes explorar mundos \nvirtuales, personalizar tu avatar y conectar con otros usuarios \nen tiempo real mediante voz."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imfinityapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Imfinity app S.a de C.v", "support_website_url": null, "website_url": "https://imfinityapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1305714609301996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299093_1597689332090189_5628111826988369442_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bxd0toW7tqMQ7kNvwHUqVrR&_nc_oc=AdoSSugEhN30prLMgKRJKoztkSAyy-zCvSm_2yzZ8WKAA9iuoTMQoLlmOeOWUwRHfR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZmBdX36BFYMuzSQkloLQ4f7wMiMghUpdkSRXN8gOkiQ&oe=6AE0A053"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Universe", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Events", "id": "2687655338230691"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1792069920, "lastRevision": {"nodes": [{"id"
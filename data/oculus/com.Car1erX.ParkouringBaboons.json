Q2s3pPegoSDTblQFXwCDEG5cQBt7QXa7s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qi_aqoDBrrEYpUjUz6XCi6ulHflCmrNyeYcUweJjX8Q&oe=69E24CA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled - 2024-06-26T184645.972.png", "id": "1015538326591180", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75230049_1015538329924513_1096251182326059808_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHdq9ybwPXMQ7kNvwEon2Ic&_nc_oc=Adp7DiUciE12CjXxqN0Mq3pzGrm82yJP6wF8EG6R4mptrfLXlEMxyNfPr1CcCmYuqnI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aSkeIthTpfljk7u_ozK8eDzkYkqSCsiaRCGcLICNJcQ&oe=69E2455C"}, "display_name": "Parkouring Baboons", "keywords": [], "long_description": "Parkouring Baboons is a game with many different adventures. There's the battle mode where you can try to become the best to leave the competition in the dust. The horror mode where you try to get away from monsters while completing the challenge on each level. You have to look good while doing all this so go to the shop to get some cosmetics such as hats. There are also many secrets that are hidden around these maps for you to discover so go find this and more in Parkouring Baboons.", "short_description": "Hop into Parkouring Baboons for whatever experiences you desire. Fight your friends or enemies in the battle mode or maybe run for your life in the horror mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://parkouringbaboons.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Car1erX", "support_website_url": null, "website_url": "https://parkouringbaboons.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
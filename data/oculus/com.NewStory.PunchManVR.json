/57569471_1591405681479023_93209049922791638_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7XgzQHb-eoQ7kNvwHSFbdD&_nc_oc=AdqClLRpgHmHoXoTY9kuRAnftlEp0GRysw4OdaU1pqY1mLKsXC642WjNgo0krUPqXeQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bQ7hB6RdUtFSj8Ywdr43FoE72rQijojc21uUFv2M8ZA&oe=69E0D242"}, {"file_name": "G.png", "id": "558516763491922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974859_558516766825255_7563524487422045670_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vj6K4jCNn4Q7kNvwF52gNZ&_nc_oc=Adofa_FRNpkHh9iphph_J3kmWSJI6p2ne5EKjDwGZoqwVFkpBRCJsiMLX5XOWDzhObs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P0RJFb8ABhZzq-kKHhFqWjMfkKEoY0GzPiISL_OSvpw&oe=69E0DEC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "904113788550762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210885_904113791884095_8787361767416465739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-iaBeHp9NsQ7kNvwH4YQuZ&_nc_oc=AdqwC-a_nYpPeGEJozmaDaDZCeBYPiYdbR4N15qGm0W51PZHylcb9tArmfXCSBI_lok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15xpvNsS0W6-aI7EYGWIVqKtYiXKAm-Em8mNiFf3e5Gw&oe=69E0FEB6"}, "display_name": "Blast Smash", "keywords": ["punch", "action", "knock", "simulator", "adventure"], "long_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! You'll smash bizarre characters with various weapons, aiming to beat your personal best for distance. Earn rewards based on how far you launch them, and use those rewards to upgrade your weapons or unlock new ones, allowing you to achieve even greater distances! But be careful not to overdo it \u2013 things can get pretty wild with those faces!\n\nWhat You Can Do:\n-Smash humans with a variety of unique weapons!: Master a range of weapons such as bats, squeaky hammers, golf clubs, and spiked bats to deliver the ultimate smash!\n-Send quirky characters flying!: A diverse cast of unique human characters await! Experiment with different weapons and smashes based on their characteristics!\n-Collect rewards and upgrade your weapons!: Earn rewards for launching humans! Use these rewards to increase the power and size of your weapons!\n-Enhance your skills and beat your records!: Upgrade various skills such as weapon power and attack area to launch humans even farther!\n", "short_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8895127967270081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974892_616839927463237_4336679162718266100_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-tC78G36C4Q7kNvwEsSZBW&_nc_oc=AdruhEXjNHVeBKX3BTV7Yd4WhnxwKpT3iF_m0uFizXjS_ERHe6JG_1u6SnYzoFqor1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J0mEqRjgYfFs3YmxCfcAz8sQ4ZDUYUqX11JcqJuN_uw&oe=69E0E8FD"}, "is_concept": false
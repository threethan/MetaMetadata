_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7930GwYJGM0mRhwzjgL_WJEi5pmoGvyjIcZB_s3nxmA&oe=6A6F2876"}, "display_name": "Blast Smash", "keywords": ["punch", "action", "knock", "simulator", "adventure"], "long_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! You'll smash bizarre characters with various weapons, aiming to beat your personal best for distance. Earn rewards based on how far you launch them, and use those rewards to upgrade your weapons or unlock new ones, allowing you to achieve even greater distances! But be careful not to overdo it \u2013 things can get pretty wild with those faces!\n\nWhat You Can Do:\n-Smash humans with a variety of unique weapons!: Master a range of weapons such as bats, squeaky hammers, golf clubs, and spiked bats to deliver the ultimate smash!\n-Send quirky characters flying!: A diverse cast of unique human characters await! Experiment with different weapons and smashes based on their characteristics!\n-Collect rewards and upgrade your weapons!: Earn rewards for launching humans! Use these rewards to increase the power and size of your weapons!\n-Enhance your skills and beat your records!: Upgrade various skills such as weapon power and attack area to launch humans even farther!\n", "short_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i